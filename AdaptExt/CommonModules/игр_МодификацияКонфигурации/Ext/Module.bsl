#Область ПрограммныйИнтерфейс

#Область ИнтеграцияСДокументамиУчетнойСистемой

// Переопределяемая процедура, вызываемая из одноименного обработчика события формы.
//
// Параметры:
// 	Форма - форма, из обработчика события которой происходит вызов процедуры.
//	см. справочную информацию по событиям управляемой формы.
//
Процедура ПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка) Экспорт
	
	Если Форма.ИмяФормы = "Справочник.Номенклатура.Форма.ФормаГруппы" Тогда
		ПриСозданииНаСервереНоменклатураФормаГруппы(Форма);
	ИначеЕсли Форма.ИмяФормы = "Справочник.Номенклатура.Форма.ФормаЭлемента" Тогда
		ПриСозданииНаСервереНоменклатура(Форма);
	ИначеЕсли Форма.ИмяФормы = "Справочник.ВидыНоменклатуры.Форма.ФормаЭлемента" Тогда
		ПриСозданииНаСервереВидыНоменклатуры(Форма);
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПриСозданииНаСервереНоменклатура(Форма)
	
	НоваяГруппа	= Форма.Элементы.Добавить("игр_РеквизитыКаспи", Тип("ГруппаФормы"), Форма.Элементы.СтраницыКарточкаНоменклатуры);
	НоваяГруппа.Вид	= ВидГруппыФормы.Страница;
	НоваяГруппа.Заголовок = "Реквизиты Каспи";
	
	НоваяТаблица	= Форма.Элементы.Добавить("игр_ХарактеристикиТовараКаспи", Тип("ТаблицаФормы"), НоваяГруппа);
	НоваяТаблица.ПутьКДанным	= "Объект.ХарактеристикиТовараКаспи";
	НоваяТаблица.УстановитьДействие("ПриИзменении", "игр_ХарактеристикиТовараКаспиПриИзменении");
	
	НовыйЭлементы	= Форма.Элементы.Добавить("игр_Характеристика", Тип("ПолеФормы"), НоваяТаблица);
	НовыйЭлементы.Вид	= ВидПоляФормы.ПолеВвода;
	НовыйЭлементы.ПутьКДанным	= "Объект.ХарактеристикиТовараКаспи.Характеристика";
	
	НовыйЭлементы	= Форма.Элементы.Добавить("игр_Значение", Тип("ПолеФормы"), НоваяТаблица);
	НовыйЭлементы.Вид	= ВидПоляФормы.ПолеВвода;
	НовыйЭлементы.ПутьКДанным	= "Объект.ХарактеристикиТовараКаспи.Значение";
	НовыйЭлементы.КнопкаВыбора	= Истина;
	НовыйЭлементы.УстановитьДействие("НачалоВыбора", "игр_ХарактеристикиТовараКаспиЗначениеНачалоВыбора");
	
	НовыйЭлементы	= Форма.Элементы.Добавить("игр_Обязательный", Тип("ПолеФормы"), НоваяТаблица);
	НовыйЭлементы.Вид	= ВидПоляФормы.ПолеФлажка;
	НовыйЭлементы.ПутьКДанным	= "Объект.ХарактеристикиТовараКаспи.Обязательный";
	
	НовыйЭлементы	= Форма.Элементы.Добавить("игр_Тип", Тип("ПолеФормы"), НоваяТаблица);
	НовыйЭлементы.Вид	= ВидПоляФормы.ПолеВвода;
	НовыйЭлементы.ПутьКДанным	= "Объект.ХарактеристикиТовараКаспи.Тип";
	
	НовыйЭлементы	= Форма.Элементы.Добавить("игр_ХарактеристикаКаспи", Тип("ПолеФормы"), НоваяТаблица);
	НовыйЭлементы.Вид	= ВидПоляФормы.ПолеВвода;
	НовыйЭлементы.ПутьКДанным	= "Объект.ХарактеристикиТовараКаспи.ХарактеристикаКаспи";
	
	НовыйЭлементы	= Форма.Элементы.Добавить("игр_КатегорияТовара", Тип("ПолеФормы"), НоваяГруппа);
	НовыйЭлементы.Вид	= ВидПоляФормы.ПолеВвода;
	НовыйЭлементы.ПутьКДанным	= "Объект.КатегорияТовара";
	НовыйЭлементы.УстановитьДействие("ПриИзменении", "игр_КатегорияТовараПриИзменении");
	
	НовыйЭлементы	= Форма.Элементы.Добавить("игр_ВыгруженНаКаспи", Тип("ПолеФормы"), НоваяГруппа);
	НовыйЭлементы.Вид	= ВидПоляФормы.ПолеФлажка;
	НовыйЭлементы.ПутьКДанным	= "Объект.ВыгруженНаКаспи";

	НовыйЭлементы	= Форма.Элементы.Добавить("игр_ИспользоватьШтрихкодКаспи", Тип("ПолеФормы"), НоваяГруппа);
	НовыйЭлементы.Вид	= ВидПоляФормы.ПолеФлажка;
	НовыйЭлементы.ПутьКДанным	= "Объект.игр_ИспользоватьШтрихкодКаспи";

	НовыйЭлементы	= Форма.Элементы.Добавить("игр_УчитыватьТоварНаВитрине", Тип("ПолеФормы"), НоваяГруппа);
	НовыйЭлементы.Вид	= ВидПоляФормы.ПолеФлажка;
	НовыйЭлементы.ПутьКДанным	= "Объект.игр_УчитыватьТоварНаВитрине";
	
КонецПроцедуры

Процедура ПриСозданииНаСервереНоменклатураФормаГруппы(Форма)
	
	НовыйЭлемент	= Форма.Элементы.Добавить("игр_МенеджерГруппы", Тип("ПолеФормы"), Форма);
	НовыйЭлемент.Вид	= ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.МенеджерГруппы";
	
КонецПроцедуры

Процедура ПриСозданииНаСервереВидыНоменклатуры(Форма)
	
	НовыйЭлемент	= Форма.Элементы.Добавить("игр_КатегорияКаспи", Тип("ПолеФормы"), Форма.Элементы.СтраницаОсновное);
	НовыйЭлемент.Вид	= ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.игр_КатегорияКаспи";
	
КонецПроцедуры

#КонецОбласти