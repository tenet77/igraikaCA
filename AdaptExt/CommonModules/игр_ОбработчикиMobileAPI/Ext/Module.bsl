Функция ТекстЗапросаСохраненнаяНоменклатура() 
	
	ТекстЗапроса	= 
	"ВЫБРАТЬ
	|	игр_ЖурналВходящихДанныхМобильноеПриложение.Данные КАК Данные
	|ИЗ
	|	РегистрСведений.игр_ЖурналВходящихДанныхМобильноеПриложение КАК игр_ЖурналВходящихДанныхМобильноеПриложение
	|ГДЕ
	|	игр_ЖурналВходящихДанныхМобильноеПриложение.Идентификатор = &Идентификатор"
	;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ПредставлениеНоменклатуры(Источник)
	
	Результат	= Новый Соответствие;
	Результат.Вставить("Штрихкод", Источник.Штрихкод);
	Результат.Вставить("Артикул", Источник.Артикул);
	Результат.Вставить("Наименование", Источник.Наименование);
	Результат.Вставить("Характеристика", Источник.Характеристика);
	Результат.Вставить("Изображение", XMLСтрока(Источник.ФайлКартинки));
	Результат.Вставить("Идентификатор", XMLСтрока(Источник.Номенклатура));
	Результат.Вставить("Цена", Источник.Цена);
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаСписокСкладов()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Склады.Ссылка КАК Ссылка,
	|	Склады.Родитель КАК Родитель,
	|	Склады.ЭтоГруппа КАК ЭтоГруппа,
	|	Склады.Наименование КАК Наименование,
	|	Склады.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Справочник.Склады КАК Склады"	
	;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ПредставлениеСклада(Источник)
	
	Результат	= Новый Соответствие;
	Результат.Вставить("Наименование", Источник.Наименование);
	Результат.Вставить("Идентификатор", XMLСтрока(Источник.Ссылка));
