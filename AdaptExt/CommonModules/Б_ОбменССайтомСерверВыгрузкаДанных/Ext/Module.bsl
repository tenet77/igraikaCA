
&ИзменениеИКонтроль("СформироватьВременныеТаблицыПоДокументам")
Функция игр_СформироватьВременныеТаблицыПоДокументам(ПараметрыОбмена, МассивДанных)

	ОбщийЗапрос = Новый Запрос;

	ОбщийЗапрос.УстановитьПараметр("МассивДанных"			, МассивДанных);
	ОбщийЗапрос.УстановитьПараметр("СвойствоИдМетодаОплаты"	, ПараметрыОбмена.СвойствоИдМетодаОплаты);
	ОбщийЗапрос.УстановитьПараметр("СвойствоИдентификаторОтправления", ПараметрыОбмена.СвойствоИдентификаторОтправления);

	лИспользуетсяСтатусЗаказаСостояние 	= Ложь;
	лИспользуетсяСтатусЗаказаСвойство 	= Ложь;
	лСтатусЗаказаСвойство 				= Ложь;

	лНастройкиСтатусовЗаказа = ПланыОбмена.Б_ОбменССайтом.ПолучитьЗначениеКлючаСтруктурыНастроек(ПараметрыОбмена, "НастройкиСтатусовЗаказа");
	Если лНастройкиСтатусовЗаказа <> Неопределено тогда

		Если лНастройкиСтатусовЗаказа.ИсточникСтатусов1С = "СостоянияЗаказов" тогда
			лИспользуетсяСтатусЗаказаСостояние = Истина;
		ИначеЕсли лНастройкиСтатусовЗаказа.ИсточникСтатусов1С = "СвойствоЗаказов" тогда
			лИспользуетсяСтатусЗаказаСвойство = Истина;
			лСтатусЗаказаСвойство = ПараметрыОбмена.НастройкиСтатусовЗаказа.СвойствоЗаказа;
		КонецЕсли;

	КонецЕсли;

	ОбщийЗапрос.УстановитьПараметр("ИспользуетсяСтатусЗаказаСостояние"	, лИспользуетсяСтатусЗаказаСостояние);
	ОбщийЗапрос.УстановитьПараметр("ИспользуетсяСтатусЗаказаСвойство"	, лИспользуетсяСтатусЗаказаСвойство);
	ОбщийЗапрос.УстановитьПараметр("СтатусЗаказаСвойство"				, лСтатусЗаказаСвойство);


	лИспользуетсяСлужбыДоставкиЗаказаСвойство 	= Ложь;
	лИспользуетсяСлужбыДоставкиОтгрузкиСвойство = Ложь;
	лСлужбаДоставкиЗаказСвойство 	= Ложь;
	лСлужбаДоставкиОтгрузкиСвойство = Ложь;

	лНастройкиСлужбДоставкиДокументов = ПланыОбмена.Б_ОбменССайтом.ПолучитьЗначениеКлючаСтруктурыНастроек(ПараметрыОбмена, "НастройкиСлужбДоставкиДокументов");
	Если лНастройкиСлужбДоставкиДокументов <> Неопределено тогда

		лСлужбаДоставкиЗаказСвойство 	= ПараметрыОбмена.НастройкиСлужбДоставкиДокументов.СвойствоЗаказа;
		лСлужбаДоставкиОтгрузкиСвойство = ПараметрыОбмена.НастройкиСлужбДоставкиДокументов.СвойствоОтгрузки;

		Если лНастройкиСлужбДоставкиДокументов.ИсточникСлужбДоставкиЗаказа = "СвойствоЗаказов" И ЗначениеЗаполнено(лСлужбаДоставкиЗаказСвойство) тогда
			лИспользуетсяСлужбыДоставкиЗаказаСвойство = Истина;
		КонецЕсли;

		Если ПараметрыОбмена.ВыгрузкаОтгрузок  И ЗначениеЗаполнено(лСлужбаДоставкиОтгрузкиСвойство)  тогда
			лИспользуетсяСлужбыДоставкиОтгрузкиСвойство = Истина;
		КонецЕсли;

	КонецЕсли;

	ОбщийЗапрос.УстановитьПараметр("ИспользуетсяСлужбыДоставкиЗаказаСвойство"	, лИспользуетсяСлужбыДоставкиЗаказаСвойство);
	ОбщийЗапрос.УстановитьПараметр("ИспользуетсяСлужбыДоставкиОтгрузкиСвойство"	, лИспользуетсяСлужбыДоставкиОтгрузкиСвойство);
	ОбщийЗапрос.УстановитьПараметр("СлужбаДоставкиЗаказСвойство"				, лСлужбаДоставкиЗаказСвойство);
	ОбщийЗапрос.УстановитьПараметр("СлужбаДоставкиОтгрузкиСвойство"				, лСлужбаДоставкиОтгрузкиСвойство);


	ОбщийЗапрос.УстановитьПараметр("ВыгружаемыеОплатыПоОтборам"		, ПараметрыОбмена.ВыгружаемыеОплатыПоОтборам);
	ОбщийЗапрос.УстановитьПараметр("ВыгружаемыеОтгрузкиПоОтборам"	, ПараметрыОбмена.ВыгружаемыеОтгрузкиПоОтборам);

	ОбщийЗапрос.УстановитьПараметр("ИспользоватьОтборПоОплатам"		, ?(ПараметрыОбмена.ВыгружаемыеОплатыПоОтборам = Неопределено, Ложь, Истина));
	ОбщийЗапрос.УстановитьПараметр("ИспользоватьОтборПоОтгрузкам"	, ?(ПараметрыОбмена.ВыгружаемыеОтгрузкиПоОтборам = Неопределено, Ложь, Истина));

	МенеджерВременныхТаблицДокументов 	= Новый МенеджерВременныхТаблиц;
	ОбщийЗапрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблицДокументов;

	ЗапросПоЗаказам = "ВЫБРАТЬ
	|	МассивДанных.Объект КАК Объект
	|ПОМЕСТИТЬ ВремМассивДанных
	|ИЗ
	|	&МассивДанных КАК МассивДанных
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказКлиента.Ссылка КАК Документ,
	|	""Заказ"" КАК ТипДокумента
	|ПОМЕСТИТЬ ВремЗаказы
	|ИЗ
	|	Документ.ЗаказКлиента КАК ЗаказКлиента
	|ГДЕ
	|	ЗаказКлиента.Ссылка В
	|			(ВЫБРАТЬ
	|				ВремМассивДанных.Объект
	|			ИЗ
	|				ВремМассивДанных)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказКлиента.Ссылка КАК Заказ,
	|	ЗаказКлиента.Валюта КАК Валюта,
	|	ЗаказКлиента.СуммаДокумента КАК СуммаДокумента,
	|	ЗаказКлиента.Б_Идентификатор КАК Б_Идентификатор,
	|	ЗаказКлиента.Б_НомерВерсии КАК Б_НомерВерсии
	|ПОМЕСТИТЬ ВремВыгружаемыеЗаказы
	|ИЗ
	|	Документ.ЗаказКлиента КАК ЗаказКлиента
	|ГДЕ
	|	ЗаказКлиента.Ссылка В
	|			(ВЫБРАТЬ
	|				ВремЗаказы.Документ
	|			ИЗ
	|				ВремЗаказы)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВремВыгружаемыеЗаказы.Заказ КАК Заказ,
	|	ВремВыгружаемыеЗаказы.Валюта КАК Валюта,
	|	ВремВыгружаемыеЗаказы.СуммаДокумента - ЕСТЬNULL(СостоянияЗаказовКлиентов.СуммаОплаты, 0) КАК ЗаказКОплатеОстаток,
	|	ВремВыгружаемыеЗаказы.СуммаДокумента - ЕСТЬNULL(СостоянияЗаказовКлиентов.СуммаОтгрузки, 0) КАК ЗаказКОтгрузкеОстаток,
	|	ВремВыгружаемыеЗаказы.Б_Идентификатор КАК Б_Идентификатор,
	|	ВремВыгружаемыеЗаказы.Б_НомерВерсии КАК Б_НомерВерсии,
	#удаление
	|	ОбъектыРасчетов.Ссылка КАК ОбъектРасчетов
	#КонецУдаления
	#Вставка
	|	ВремВыгружаемыеЗаказы.Заказ КАК ОбъектРасчетов
	#КонецВставки
	|ПОМЕСТИТЬ ВремЗаказыСВалютой
	|ИЗ
	|	ВремВыгружаемыеЗаказы КАК ВремВыгружаемыеЗаказы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
	|		ПО (СостоянияЗаказовКлиентов.Заказ = ВремВыгружаемыеЗаказы.Заказ)
	#Удаление
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОбъектыРасчетов КАК ОбъектыРасчетов
	|		ПО ВремВыгружаемыеЗаказы.Заказ = ОбъектыРасчетов.Объект
	#КонецУдаления
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВремВыгружаемыеЗаказы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.Регистратор КАК Отгрузка,
	|	ВложенныйЗапрос.Заказ КАК Заказ,
	|	ВложенныйЗапрос.Регистратор.Дата КАК Дата,
	|	ВложенныйЗапрос.Регистратор.Номер КАК Номер
	|ПОМЕСТИТЬ ВремОтгрузкиЗаказов
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВремЗаказыСВалютой.Валюта КАК Валюта,
	|		ВремЗаказыСВалютой.Заказ КАК Заказ,
	|		МАКСИМУМ(Оформлено.Регистратор) КАК Регистратор
	|	ИЗ
	|		ВремЗаказыСВалютой КАК ВремЗаказыСВалютой
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыКлиентов КАК Оформлено
	|			ПО ВремЗаказыСВалютой.Заказ = Оформлено.ЗаказКлиента
	|				И (Оформлено.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход))
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ВремЗаказыСВалютой.Валюта,
	|		ВремЗаказыСВалютой.Заказ) КАК ВложенныйЗапрос
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////

	|ВЫБРАТЬ
	|	ВложенныйЗапрос.Заказ КАК Заказ,
	|	ВложенныйЗапрос.Регистратор.Дата КАК Дата,
	|	ВложенныйЗапрос.Регистратор.Номер КАК Номер
	|ПОМЕСТИТЬ ВремОплатыЗаказов
	|ИЗ
	|	(ВЫБРАТЬ
	|		МАКСИМУМ(РасчетыСКлиентами.Регистратор) КАК Регистратор,
	|		ВремЗаказыСВалютой.Заказ КАК Заказ
	|	ИЗ
	|		РегистрНакопления.РасчетыСКлиентами КАК РасчетыСКлиентами
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВремЗаказыСВалютой КАК ВремЗаказыСВалютой
	#Удаление
	|			ПО (ВремЗаказыСВалютой.ОбъектРасчетов = РасчетыСКлиентами.ОбъектРасчетов)
	#КонецУдаления
	#Вставка
	|			ПО (ВремЗаказыСВалютой.ОбъектРасчетов = РасчетыСКлиентами.ЗаказКлиента)
	#КонецВставки
	|				И (РасчетыСКлиентами.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход))
	|				И (РасчетыСКлиентами.Регистратор ССЫЛКА Документ.ПриходныйКассовыйОрдер
	|					ИЛИ РасчетыСКлиентами.Регистратор ССЫЛКА Документ.ПоступлениеБезналичныхДенежныхСредств
	|					ИЛИ РасчетыСКлиентами.Регистратор ССЫЛКА Документ.ОперацияПоПлатежнойКарте)
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ВремЗаказыСВалютой.Заказ) КАК ВложенныйЗапрос
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВремЗаказыСВалютой.Заказ КАК Заказ,
	|	ВЫБОР
	|		КОГДА ВремЗаказыСВалютой.Б_Идентификатор = """"
	|			ТОГДА ВремЗаказыСВалютой.Заказ
	|		ИНАЧЕ ВремЗаказыСВалютой.Б_Идентификатор
	|	КОНЕЦ КАК ИдентификаторЗаказа,
	|	ЕСТЬNULL(ВремОплатыЗаказов.Номер, """") КАК ЗаказНомерОплаты,
	|	ЕСТЬNULL(ВремОплатыЗаказов.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК ЗаказДатаОплаты,
	|	ЕСТЬNULL(ВремОтгрузкиЗаказов.Номер, """") КАК ЗаказНомерОтгрузки,
	|	ЕСТЬNULL(ВремОтгрузкиЗаказов.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК ЗаказДатаОтгрузки,
	|	Валюты.Ссылка КАК Валюта,
	|	ЕСТЬNULL(КурсыВалютСрезПоследних.Курс, 1) КАК Курс,
	|	ВремЗаказыСВалютой.ЗаказКОплатеОстаток КАК ЗаказКОплатеОстаток,
	|	ВремЗаказыСВалютой.ЗаказКОтгрузкеОстаток КАК ЗаказКОтгрузкеОстаток
	|ПОМЕСТИТЬ ВремСсылкиДокументов
	|ИЗ
	|	ВремЗаказыСВалютой КАК ВремЗаказыСВалютой
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВремОплатыЗаказов КАК ВремОплатыЗаказов
	|		ПО ВремЗаказыСВалютой.Заказ = ВремОплатыЗаказов.Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВремОтгрузкиЗаказов КАК ВремОтгрузкиЗаказов
	|		ПО ВремЗаказыСВалютой.Заказ = ВремОтгрузкиЗаказов.Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
	|		ПО ВремЗаказыСВалютой.Валюта = Валюты.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(
	|				,
	|				Валюта В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						ВремЗаказыСВалютой.Валюта
	|					ИЗ
	|						ВремЗаказыСВалютой КАК ВремЗаказыСВалютой)) КАК КурсыВалютСрезПоследних
	|		ПО ВремЗаказыСВалютой.Валюта = КурсыВалютСрезПоследних.Валюта
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказКлиентаТовары.Отменено КАК Отменено,
	|	ЗаказКлиентаТовары.Ссылка КАК Заказ
	|ПОМЕСТИТЬ ВремНеОтмененныеСтрокиЗаказов
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|ГДЕ
	|	ЗаказКлиентаТовары.Отменено = ЛОЖЬ
	|	И ЗаказКлиентаТовары.Ссылка В
	|			(ВЫБРАТЬ
	|				ВремЗаказы.Документ
	|			ИЗ
	|				ВремЗаказы)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВремЗаказыСВалютой
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВремОтгрузкиЗаказов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВремОплатыЗаказов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВремСсылкиДокументов.Заказ КАК Объект,
	|	ЗаказКлиента.Ссылка КАК Заказ,
	|	ВремСсылкиДокументов.ИдентификаторЗаказа КАК ИдентификаторДокумента,
	|	ЗаказКлиента.ВерсияДанных КАК ВерсияДанных,
	|	ЗаказКлиента.ПометкаУдаления КАК ПометкаУдаления,
	|	ЗаказКлиента.Номер КАК Номер,
	|	ЗаказКлиента.Дата КАК Дата,
	|	ЗаказКлиента.Проведен КАК Проведен,
	|	ЗаказКлиента.АдресДоставки КАК АдресДоставки,
	|	ВремСсылкиДокументов.Валюта КАК Валюта,
	|	ВремСсылкиДокументов.Курс КАК Курс,
	|	ЗаказКлиента.Контрагент КАК Контрагент,
	|	ЗаказКлиента.Партнер КАК Партнер,
	|	ЗаказКлиента.Склад КАК Склад,
	|	ВЫБОР
	|		КОГДА ЗаказКлиента.Склад.Б_Идентификатор = """"
	|			ТОГДА ЗаказКлиента.Склад
	|		ИНАЧЕ ЗаказКлиента.Склад.Б_Идентификатор
	|	КОНЕЦ КАК ИдентификаторСклада,
	|	ЗаказКлиента.Склад.Наименование КАК НаименованиеСклада,
	|	ЗаказКлиента.Комментарий КАК Комментарий,
	|	ЗаказКлиента.ЦенаВключаетНДС КАК ЦенаВключаетНДС,
	|	ЗаказКлиента.НалогообложениеНДС КАК НалогообложениеНДС,
	|	ЗаказКлиента.Статус КАК Статус,
	|	""Заказ"" КАК ТипДокумента,
	|	ЗаказКлиента.БанковскийСчетКонтрагента КАК БанковскийСчетКонтрагента,
	|	ЗаказКлиента.Б_Идентификатор КАК НомерССайта,
	|	ЗаказКлиента.Б_ДатаДокумента КАК ДатаССайта,
	|	ЗаказКлиента.ПеревозчикПартнер КАК Перевозчик,
	|	ВремСсылкиДокументов.ЗаказНомерОтгрузки КАК НомерДокументаОтгрузки,
	|	ВремСсылкиДокументов.ЗаказДатаОтгрузки КАК ДатаДокументаОтгрузки,
	|	ВремСсылкиДокументов.ЗаказНомерОплаты КАК НомерДокументаОплаты,
	|	ВремСсылкиДокументов.ЗаказДатаОплаты КАК ДатаДокументаОплаты,
	|	ВремСсылкиДокументов.ЗаказКОплатеОстаток КАК КОплатеОстаток,
	|	ВремСсылкиДокументов.ЗаказКОтгрузкеОстаток КАК КОтгрузкеОстаток,
	|	"""" КАК ИдентификаторОснования,
	|	ЗаказКлиента.Валюта.Наименование КАК ВалютаКод,
	|	ЗаказКлиента.СуммаДокумента КАК СуммаДокумента,
	|	ВЫБОР
	|		КОГДА ВремСсылкиДокументов.ЗаказКОплатеОстаток <= 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Оплачен,
	|	ВЫБОР
	|		КОГДА ВремСсылкиДокументов.ЗаказКОтгрузкеОстаток <= 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Отгружен,
	|	ВЫБОР
	|		КОГДА НЕ ВремСсылкиДокументов.Заказ В
	|					(ВЫБРАТЬ
