
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИнициализироватьРеквизиты();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница = Элементы.ГруппаЗагрузка Тогда
		
		ОбновитьДанныеЗагрузки();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКоманд

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	
	Закрыть(СохранитьТаблицуДляЗагрузки(ЭтотОбъект.ВладелецФормы.УникальныйИдентификатор));
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ИнициализироватьРеквизиты()
	
	ДанныеДляЗагрузки.Область("R1C1").Текст 		= "Артикул";
	ДанныеДляЗагрузки.Область("R1C1").ШиринаКолонки = 10;
	
	ДанныеДляЗагрузки.Область("R1C2").Текст 		= "Наименование";
	ДанныеДляЗагрузки.Область("R1C2").ШиринаКолонки = 50;
	
	ДанныеДляЗагрузки.Область("R1C3").Текст 		= "Характеристика";
	ДанныеДляЗагрузки.Область("R1C3").ШиринаКолонки = 50;
	
	ДанныеДляЗагрузки.Область("R1C4").Текст 		= "Цены";
	ДанныеДляЗагрузки.Область("R1C4").ШиринаКолонки = 10;
	
КонецПроцедуры

&НаСервере
Функция СохранитьТаблицуДляЗагрузки(УникальныйИдентификатор)
	
	Таблица	= РеквизитФормыВЗначение("ТаблицаДляЗагрузки");
	
	Возврат ПоместитьВоВременноеХранилище(Таблица, УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Процедура ЗагрузитьДанныеИзТаблицы()
	
	ТаблицаДляЗагрузки.Очистить();
	
	ТипЧисло	= ОбщегоНазначения.ОписаниеТипаЧисло(15, 2);
	
	НПП = 1;
	Пока НПП < ДанныеДляЗагрузки.ВысотаТаблицы Цикл
		
		НПП 	= НПП + 1;
		НППСтр	= Формат(НПП, "ЧГ=");
		
		Артикул			= ДанныеДляЗагрузки.Область("R"+ НППСтр +"C1").Текст;
		Наименование	= СокрЛП(ДанныеДляЗагрузки.Область("R"+ НППСтр +"C2").Текст);
		Характеристика	= ДанныеДляЗагрузки.Область("R"+ НППСтр +"C3").Текст;
		Для Сч = 1 По ТаблицаЦен.Количество() Цикл
			
			Цена = ТипЧисло.ПривестиЗначение(СтрЗаменить(ДанныеДляЗагрузки.Область("R"+ НППСтр + "C" + (3+Сч)).Текст," ",""));
			
			Если ЗначениеЗаполнено(Цена) Тогда
				
				НоваяСтрока	= ТаблицаДляЗагрузки.Добавить();
				
				НоваяСтрока.Артикул	= Артикул;
				НоваяСтрока.НаименованиеСтр		= Наименование;
				НоваяСтрока.ХарактеристикаСтр	= Характеристика;
				НоваяСтрока.ВидЦены				= ТаблицаЦен[Сч-1].ВидЦены;
				НоваяСтрока.Цена				= Цена;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСсылки()
	
	Таблица	= РеквизитФормыВЗначение("ТаблицаДляЗагрузки");
	
	Запрос	= Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Т.Артикул КАК Артикул,
	|	Т.НаименованиеСтр КАК Наименование
	|ПОМЕСТИТЬ ВТ_ПервичныеДанные
	|ИЗ
	|	&Таблица КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	Номенклатура.Артикул КАК Артикул,
	|	Номенклатура.Наименование КАК Наименование,
	|	Номенклатура.ВидНоменклатуры КАК ВидНоменклатуры
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	(Номенклатура.Артикул, Номенклатура.Наименование) В
	|			(ВЫБРАТЬ
	|				ВТ.Артикул,
	|				ВТ.Наименование
	|			ИЗ
	|				ВТ_ПервичныеДанные КАК ВТ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ХарактеристикиНоменклатуры.Ссылка КАК Ссылка,
	|	ХарактеристикиНоменклатуры.Владелец КАК Владелец,
	|	ХарактеристикиНоменклатуры.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры"
	;
	
	Запрос.УстановитьПараметр("Таблица", Таблица);
	
	Результаты	= Запрос.ВыполнитьПакет();
	
	ВыборкаНоменклатура		= Результаты[1].Выгрузить();
	Для Каждого ТекСтрока Из ВыборкаНоменклатура Цикл
		ТекСтрока.Наименование = СокрЛП(ТекСтрока.Наименование);
	КонецЦикла;
	ВыборкаХарактеристики	= Результаты[2].Выгрузить();
	
	Для Каждого ТекСтрока ИЗ ТаблицаДляЗагрузки Цикл
		
		НайденныеСтроки	= ВыборкаНоменклатура.НайтиСтроки(
			Новый Структура("Артикул, Наименование", ТекСтрока.Артикул, ТекСтрока.НаименованиеСтр));
		Если НайденныеСтроки.Количество() = 0 Тогда
			Продолжить;	
		КонецЕсли;
		
		ТекСтрока.Номенклатура	= НайденныеСтроки[0].Ссылка;
		
		Если ЗначениеЗаполнено(ТекСтрока.ХарактеристикаСтр) Тогда
			НайденныеСтрокиХ	= ВыборкаХарактеристики.НайтиСтроки(
				Новый Структура("Владелец, Наименование", НайденныеСтроки[0].ВидНоменклатуры, ТекСтрока.ХарактеристикаСтр));
				
			Если НайденныеСтрокиХ.Количество() = 0 Тогда
				Продолжить;	
			КонецЕсли;
			ТекСтрока.Характеристика	= НайденныеСтрокиХ[0].Ссылка;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеЗагрузки()
	
	ЗагрузитьДанныеИзТаблицы();
	ЗаполнитьСсылки();
	
КонецПроцедуры

#КонецОбласти