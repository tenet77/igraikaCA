
&НаСервере
&После("ПриСозданииНаСервере")
Процедура игр_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	игр_ДобавитьКоманды();
	игр_ДобавитьИзменитьЭлементы();
	
КонецПроцедуры

&НаКлиенте
Процедура игр_КодыМаркировки(Команда)
	
	Элементы["игр_ТаблицаКодыМаркировки"].Видимость = НЕ Элементы["игр_ТаблицаКодыМаркировки"].Видимость;
	
КонецПроцедуры

&НаСервере
Процедура игр_ДобавитьКоманды()
	
	НоваяКоманда	= Команды.Добавить("игр_КодыМаркировки");
	НоваяКоманда.Заголовок	= "Коды маркировки";
	НоваяКоманда.Действие	= "игр_КодыМаркировки";
	
КонецПроцедуры

&НаСервере
Процедура игр_ДобавитьИзменитьЭлементы()
	
	НовыйЭлемент	= Элементы.Добавить("игр_КодыМаркировки", Тип("КнопкаФормы"), Элементы.ОтгружаемыеТоварыКоманднаяПанель);
	НовыйЭлемент.Вид		= ВидКнопкиФормы.КнопкаКоманднойПанели;
	НовыйЭлемент.ИмяКоманды	= "игр_КодыМаркировки";
	
	НоваяТаблица	= Элементы.Добавить("игр_ТаблицаКодыМаркировки", Тип("ТаблицаФормы"), Элементы.ГруппаОтгружаемыеТовары);
	НоваяТаблица.ПутьКДанным	= "Объект.КодыМаркировкиИСМПТК";
	НоваяТаблица.Видимость		= Ложь;
	
	НовыйЭлемент	= Элементы.Добавить("игр_ТаблицаКодыМаркировкиКодМаркировки", Тип("ПолеФормы"), НоваяТаблица);
	НовыйЭлемент.Вид			= ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным	= "Объект.КодыМаркировкиИСМПТК.КодМаркировки";

	НовыйЭлемент	= Элементы.Добавить("игр_ТаблицаКодыМаркировкиНоменклатура", Тип("ПолеФормы"), НоваяТаблица);
	НовыйЭлемент.Вид			= ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным	= "Объект.КодыМаркировкиИСМПТК.Номенклатура";
	
	НовыйЭлемент	= Элементы.Добавить("игр_ТаблицаКодыМаркировкиХарактеристика", Тип("ПолеФормы"), НоваяТаблица);
	НовыйЭлемент.Вид			= ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным	= "Объект.КодыМаркировкиИСМПТК.Характеристика";
	
КонецПроцедуры

&НаКлиенте
&ИзменениеИКонтроль("ОбработатьШтрихкоды")
Процедура игр_ОбработатьШтрихкоды(ДанныеШтрихкодов)
	
	#Вставка
	Если ТипЗнч(ДанныеШтрихкодов) = Тип("Структура") Тогда
		
		ШтрихкодДляПроверки = ДанныеШтрихкодов.Штрихкод;   
		ШтрихкодТовара	= Сред(ШтрихкодДляПроверки, 4, 13);
		
		Если Не РозничноеВыбытиеИСМПТККлиент.ЭтоСтрокаФорматаBase64(ШтрихкодДляПроверки) Тогда
			ШтрихкодДляПроверки = РазборИОбработкаКодовМаркировкиИСМПТКСлужебныйКлиентСервер.ШтрихкодВBase64(ШтрихкодДляПроверки); 
		КонецЕсли;
		
		Если СтрДлина(ШтрихкодДляПроверки) > 13 Тогда

			игр_ДобавитьКодМаркировки(ШтрихкодДляПроверки, ШтрихкодТовара);
			Возврат;
			
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДанныеШтрихкодов) = Тип("Массив") Тогда
		Для Каждого ТекущийШтрихкод Из ДанныеШтрихкодов Цикл
			ШтрихкодДляПроверки = ТекущийШтрихкод.Штрихкод;
			Если Не РозничноеВыбытиеИСМПТККлиент.ЭтоСтрокаФорматаBase64(ШтрихкодДляПроверки) Тогда
				ШтрихкодДляПроверки = РазборИОбработкаКодовМаркировкиИСМПТКСлужебныйКлиентСервер.ШтрихкодВBase64(ШтрихкодДляПроверки); 
			КонецЕсли;
			Если СтрДлина(ШтрихкодДляПроверки) > 13 Тогда
				
				игр_ДобавитьКодМаркировки(ШтрихкодДляПроверки, ШтрихкодТовара);
				Возврат;
				
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	#КонецВставки
	ДействияСДобавленнымиСтроками = Новый Структура;
	ДействияСИзмененнымиСтроками  = Новый Структура;

	Действия = ШтрихкодированиеНоменклатурыКлиент.ПараметрыОбработкиШтрихкодов();

	Действия.Штрихкоды                              = ДанныеШтрихкодов;
	Действия.СтруктураДействийСДобавленнымиСтроками = ДействияСДобавленнымиСтроками;
	Действия.СтруктураДействийСИзмененнымиСтроками  = ДействияСИзмененнымиСтроками;
	Действия.ПараметрыУказанияСерий                 = ПараметрыУказанияСерий.ОтгружаемыеТовары;
	Действия.ИзменятьКоличество                     = Ложь;
	Действия.ТолькоТовары                           = Истина;
	Действия.ИмяТЧ                                  = "ОтгружаемыеТовары";

	ОбработатьШтрихкодыСервер(Действия,КэшированныеЗначения);

	ШтрихкодированиеНоменклатурыКлиент.ОбработатьНеизвестныеШтрихкоды(Действия,КэшированныеЗначения,ЭтаФорма);

	Если ШтрихкодированиеНоменклатурыКлиент.НужноОткрытьФормуУказанияСерийПослеОбработкиШтрихкодов(Действия) Тогда

		ТекущиеДанныеИдентификатор = Действия.МассивСтрокССериями[0];

		ПодключитьОбработчикОжидания("ОткрытьПодборСерийПриСканированииШтрихкодаНоменклатуры",0.1,Истина);

	КонецЕсли;

	УпаковочныеЛистыКлиент.ОбновитьКешированныеЗначенияДляТЧСУпаковочнымиЛистами(Элементы.ОтгружаемыеТовары, КэшированныеЗначения, ПараметрыУказанияСерий.ОтгружаемыеТовары);

КонецПроцедуры

&НаСервере
Процедура игр_ДобавитьКодМаркировки(ШтрихкодДляПроверки, ШтрихкодТовара)
	
	КэшированныеЗначения	= ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	МассивШК	= Новый Массив;
	МассивШК.Добавить(ШтрихкодТовара);
	
	РегистрыСведений.ШтрихкодыНоменклатуры.ПолучитьДанныеПоШтрихкодам(КэшированныеЗначения, МассивШК);

	НоваяСтрока	= Объект.КодыМаркировкиИСМПТК.Добавить();
	НоваяСтрока.КодМаркировки	= ШтрихкодДляПроверки;
	Если КэшированныеЗначения.Штрихкоды[ШтрихкодТовара] <> Неопределено Тогда
		НоваяСтрока.Номенклатура = КэшированныеЗначения.Штрихкоды[ШтрихкодТовара].Номенклатура;
		НоваяСтрока.Характеристика = КэшированныеЗначения.Штрихкоды[ШтрихкодТовара].Характеристика;
	КонецЕсли;
	
КонецПроцедуры