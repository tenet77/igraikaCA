#Область ПрограммныйИнтерфейс

Процедура ЗаписатьДанныеВЖурнал(Идентификатор, Описание, Данные, ОписаниеОтправителя) Экспорт
	
	Попытка
		
		ИдентификаторЗаписи	= Новый УникальныйИдентификатор(Идентификатор);
		
	Исключение
		
		ВызватьИсключение "Неверный идентификатор";
		
	КонецПопытки;
	
	Если ЗначениеЗаполнено(Описание)
		И ЗначениеЗаполнено(Данные)
		И ЗначениеЗаполнено(ОписаниеОтправителя) Тогда
		
		Набор	= РегистрыСведений.игр_ЖурналВходящихДанныхМобильноеПриложение.СоздатьНаборЗаписей();
		Набор.Отбор.Идентификатор.Установить(ИдентификаторЗаписи);
		
		НоваяСтрока	= Набор.Добавить();
		
		НоваяСтрока.Идентификатор	= ИдентификаторЗаписи;
		НоваяСтрока.Описание		= Описание;
		НоваяСтрока.Данные			= Новый ХранилищеЗначения(Данные);
		НоваяСтрока.ДатаПолучения	= ТекущаяДатаСеанса();
		НоваяСтрока.ОписаниеОтправителя	= ОписаниеОтправителя;
		
		Набор.Записать();
		
	Иначе
		ВызватьИсключение "Не достаточно данных для записи";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти