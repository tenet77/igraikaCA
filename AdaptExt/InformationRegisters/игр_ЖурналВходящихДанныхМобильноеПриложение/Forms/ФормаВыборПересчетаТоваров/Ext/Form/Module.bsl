#Область ОбработчикиКоманд

&НаКлиенте
Процедура Выбрать(Команда)
	
	МассивВыбранных = Новый Массив;
	
	Для Каждого Элемент Из Элементы.СписокПолученныхДанных.ВыделенныеСтроки Цикл
		МассивВыбранных.Добавить(Элементы.СписокПолученныхДанных.ДанныеСтроки(Элемент).Идентификатор);
	КонецЦикла;
	
	Адрес	= ВыбратьНаСервере(МассивВыбранных, ВладелецФормы.УникальныйИдентификатор);
	
	Закрыть(Адрес);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ВыбратьНаСервере(МассивИдентификаторов, ИдентификаторФормы)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТаблицаТоваров	= Новый ТаблицаЗначений;
	ТаблицаТоваров.Колонки.Добавить("Штрихкод");
	ТаблицаТоваров.Колонки.Добавить("Количество");
	
	Запрос	= Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	игр_ЖурналВходящихДанныхМобильноеПриложение.Данные КАК Данные
	|ИЗ
	|	РегистрСведений.игр_ЖурналВходящихДанныхМобильноеПриложение КАК игр_ЖурналВходящихДанныхМобильноеПриложение
	|ГДЕ
	|	игр_ЖурналВходящихДанныхМобильноеПриложение.Идентификатор В(&Идентификаторы)";
	
	Запрос.УстановитьПараметр("Идентификаторы", МассивИдентификаторов);
	
	Выборка	= Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Данные	= Выборка.Данные.Получить();
		
		ДанныеОбъект	= КоннекторHTTP.JsonВОбъект(Данные);
		
		Если ЗначениеЗаполнено(ДанныеОбъект["#value"])
			И ЗначениеЗаполнено(ДанныеОбъект["#value"]["Товары"]) Тогда
			
			Для Каждого Элемент Из ДанныеОбъект["#value"]["Товары"] Цикл
				
				Если ЗначениеЗаполнено(Элемент["Штрихкод"]) И ЗначениеЗаполнено(Элемент["Количество"]) Тогда
					
					НоваяСтрока	= ТаблицаТоваров.Добавить();
					
					НоваяСтрока.Штрихкод	= Элемент["Штрихкод"];
					НоваяСтрока.Количество	= Элемент["Количество"];
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаТоваров.Свернуть("Штрихкод", "Количество");
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаТоваров, ИдентификаторФормы);
	
КонецФункции

#КонецОбласти