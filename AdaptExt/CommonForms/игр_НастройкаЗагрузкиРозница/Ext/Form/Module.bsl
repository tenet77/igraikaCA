
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	ПараметрыОбмена	= игр_ОбменДаннымиРозница.ПолучитьНастройки();
	Для Каждого КлючЗначение Из ПараметрыОбмена.СтатьиПКО Цикл
		НоваяСтрока	= ТаблицаСтатьиДДС.Добавить();
		НоваяСтрока.Касса		= КлючЗначение.Ключ;
		НоваяСтрока.СтатьяПКО	= КлючЗначение.Значение;
	КонецЦикла;

	Для Каждого КлючЗначение Из ПараметрыОбмена.СтатьиРКО Цикл
		НоваяСтрока	= ТаблицаСтатьиДДС.Добавить();
		НоваяСтрока.Касса		= КлючЗначение.Ключ;
		НоваяСтрока.СтатьяРКО	= КлючЗначение.Значение;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы


#КонецОбласти

#Область ОбработчикиКоманд

&НаСервере
Процедура ЗаписатьИЗакрытьНаСервере()
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтатьиПКО	= Новый Соответствие;
	СтатьиРКО	= Новый Соответствие;
	Для Каждого Строка Из ТаблицаСтатьиДДС Цикл
		Если ЗначениеЗаполнено(Строка.СтатьяПКО) Тогда
			СтатьиПКО.Вставить(Строка.Касса, Строка.СтатьяПКО);
		КонецЕсли;
		Если ЗначениеЗаполнено(Строка.СтатьяРКО) Тогда
			СтатьиРКО.Вставить(Строка.Касса, Строка.СтатьяРКО);
		КонецЕсли;
	КонецЦикла;
	
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(игр_ОбменДаннымиРозница.КлючНастроекПодключения(), СтатьиПКО, "СтатьиПКО");
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(игр_ОбменДаннымиРозница.КлючНастроекПодключения(), СтатьиРКО, "СтатьиРКО");
		
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	
	ЗаписатьИЗакрытьНаСервере();
	Закрыть();
	
КонецПроцедуры

#КонецОбласти
