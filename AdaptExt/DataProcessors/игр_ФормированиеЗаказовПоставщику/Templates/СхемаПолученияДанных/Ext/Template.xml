		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	Номенклатура.Ссылка КАК Номенклатура,
	ЕСТЬNULL(ВЫРАЗИТЬ(НоменклатураДополнительныеРеквизиты.Значение КАК Справочник.Партнеры), ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)) КАК Поставщик
ПОМЕСТИТЬ ВТ_Номенклатура
ИЗ
	Справочник.Номенклатура КАК Номенклатура
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
		ПО Номенклатура.Ссылка = НоменклатураДополнительныеРеквизиты.Ссылка
ГДЕ
	НоменклатураДополнительныеРеквизиты.Свойство = &amp;Свойство
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
	ЦеныНоменклатурыСрезПоследних.Характеристика КАК Характеристика,
	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена,
	ВТ_Номенклатура.Поставщик КАК Поставщик
ПОМЕСТИТЬ ВТ_НоменклатураСЦеной
ИЗ
	ВТ_Номенклатура КАК ВТ_Номенклатура
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, ВидЦены = &amp;ВидЦены) КАК ЦеныНоменклатурыСрезПоследних
		ПО ВТ_Номенклатура.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_НоменклатураСЦеной.Номенклатура КАК Номенклатура,
	ВТ_НоменклатураСЦеной.Характеристика КАК Характеристика,
	ВТ_НоменклатураСЦеной.Цена КАК Цена,
	СУММА(ЕСТЬNULL(ТоварыНаСкладахОстатки.ВНаличииОстаток, 0)) КАК Остаток,
	ВТ_НоменклатураСЦеной.Поставщик КАК Поставщик
ПОМЕСТИТЬ ВТ_НоменклатураОстатки
ИЗ
	ВТ_НоменклатураСЦеной КАК ВТ_НоменклатураСЦеной
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки(&amp;ДатаОстатков {(&amp;ДатаОстатков)}, ) КАК ТоварыНаСкладахОстатки
		ПО ВТ_НоменклатураСЦеной.Номенклатура = ТоварыНаСкладахОстатки.Номенклатура
			И ВТ_НоменклатураСЦеной.Характеристика = ТоварыНаСкладахОстатки.Характеристика
{ГДЕ
	ТоварыНаСкладахОстатки.Склад.*}

СГРУППИРОВАТЬ ПО
	ВТ_НоменклатураСЦеной.Номенклатура,
	ВТ_НоменклатураСЦеной.Характеристика,
	ВТ_НоменклатураСЦеной.Цена,
	ВТ_НоменклатураСЦеной.Поставщик
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВЫБОР
		КОГДА &amp;РасшифровкаПродаж = 0
			ТОГДА ВыручкаИСебестоимостьПродажОбороты.Подразделение
		ИНАЧЕ ВыручкаИСебестоимостьПродажОбороты.Подразделение.Родитель
	КОНЕЦ КАК Подразделение,
	ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаНоменклатуры.Номенклатура КАК АналитикаУчетаНоменклатурыНоменклатура,
	ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаНоменклатуры.Характеристика КАК АналитикаУчетаНоменклатурыХарактеристика,
	ВыручкаИСебестоимостьПродажОбороты.КоличествоОборот КАК КоличествоОборот
ПОМЕСТИТЬ ВТ_Продажи
ИЗ
	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(
			&amp;ДатаНачалаПродаж {(&amp;ДатаНачалаПродаж)},
			&amp;ДатаОкончанияПродаж {(&amp;ДатаОкончанияПродаж)},
			,
			(АналитикаУчетаНоменклатуры.Номенклатура, АналитикаУчетаНоменклатуры.Характеристика) В
				(ВЫБРАТЬ
					Т.Номенклатура,
					Т.Характеристика
				ИЗ
					ВТ_НоменклатураОстатки КАК Т)) КАК ВыручкаИСебестоимостьПродажОбороты
{ГДЕ
	ВыручкаИСебестоимостьПродажОбороты.Подразделение.*}
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_НоменклатураОстатки.Номенклатура КАК Номенклатура,
	ВТ_НоменклатураОстатки.Характеристика КАК Характеристика,
	МАКСИМУМ(ЕСТЬNULL(ШтрихкодыНоменклатуры.Штрихкод, "")) КАК Штрихкод
ПОМЕСТИТЬ ВТ_ШК
ИЗ
	ВТ_НоменклатураОстатки КАК ВТ_НоменклатураОстатки
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
		ПО ВТ_НоменклатураОстатки.Номенклатура = ШтрихкодыНоменклатуры.Номенклатура
			И ВТ_НоменклатураОстатки.Характеристика = ШтрихкодыНоменклатуры.Характеристика

СГРУППИРОВАТЬ ПО
	ВТ_НоменклатураОстатки.Номенклатура,
	ВТ_НоменклатураОстатки.Характеристика
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_НоменклатураОстатки.Номенклатура КАК Номенклатура,
	ВТ_НоменклатураОстатки.Характеристика КАК Характеристика,
	ВТ_НоменклатураОстатки.Цена КАК Цена,
	ВТ_НоменклатураОстатки.Остаток КАК Доступно,
	ЕСТЬNULL(ВТ_Продажи.КоличествоОборот, 0) КАК Продажи,
	игр_АВСКлассификацияНоменклатурыСрезПоследних.Класс КАК Рейтинг,
	ВТ_Продажи.Подразделение КАК Подразделение,
	ВТ_НоменклатураОстатки.Поставщик КАК Поставщик,
	ВТ_НоменклатураОстатки.Номенклатура.Артикул КАК Артикул,
	ВТ_ШК.Штрихкод КАК Штрихкод
ИЗ
	ВТ_НоменклатураОстатки КАК ВТ_НоменклатураОстатки
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Продажи КАК ВТ_Продажи
		ПО ВТ_НоменклатураОстатки.Номенклатура = ВТ_Продажи.АналитикаУчетаНоменклатурыНоменклатура
			И ВТ_НоменклатураОстатки.Характеристика = ВТ_Продажи.АналитикаУчетаНоменклатурыХарактеристика
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.игр_АВСКлассификацияНоменклатуры.СрезПоследних КАК игр_АВСКлассификацияНоменклатурыСрезПоследних
		ПО ВТ_НоменклатураОстатки.Номенклатура = игр_АВСКлассификацияНоменклатурыСрезПоследних.Номенклатура
			И (игр_АВСКлассификацияНоменклатурыСрезПоследних.Раздел = &amp;Организация)
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ШК КАК ВТ_ШК
		ПО ВТ_НоменклатураОстатки.Номенклатура = ВТ_ШК.Номенклатура
			И ВТ_НоменклатураОстатки.Характеристика = ВТ_ШК.Характеристика</query>
	</dataSet>
	<parameter>
		<name>ДатаОстатков</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Дата остатков</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
