		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	Сегменты.Номенклатура КАК Номенклатура
ПОМЕСТИТЬ ОтборПоСегментуНоменклатуры
ИЗ
	РегистрСведений.НоменклатураСегмента КАК Сегменты
ГДЕ
	Сегменты.Сегмент = &amp;Сегмент

ИНДЕКСИРОВАТЬ ПО
	Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
	ТоварыНаСкладахОстатки.Характеристика КАК Характеристика,
	ТоварыНаСкладахОстатки.Склад КАК Склад,
	ТоварыНаСкладахОстатки.ВНаличииОстаток - ТоварыНаСкладахОстатки.ВРезервеСоСкладаОстаток - ТоварыНаСкладахОстатки.ВРезервеПодЗаказОстаток КАК Доступно,
	0 КАК ВПути
ПОМЕСТИТЬ ВТ_ОстаткиДетально
ИЗ
	РегистрНакопления.СвободныеОстатки.Остатки(&amp;ДатаОстатков {(&amp;ДатаОстатков)}, ) КАК ТоварыНаСкладахОстатки
		ЛЕВОЕ СОЕДИНЕНИЕ ОтборПоСегментуНоменклатуры КАК ОтборПоСегментуНоменклатуры
		ПО ТоварыНаСкладахОстатки.Номенклатура = ОтборПоСегментуНоменклатуры.Номенклатура
ГДЕ
	ВЫБОР
			КОГДА &amp;ИспользуетсяОтборПоСегменту
				ТОГДА НЕ ОтборПоСегментуНоменклатуры.Номенклатура ЕСТЬ NULL
			ИНАЧЕ ИСТИНА
		КОНЕЦ

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ГрафикПоступленияТоваров.Номенклатура,
	ГрафикПоступленияТоваров.Характеристика,
	ГрафикПоступленияТоваров.Склад,
	0,
	ГрафикПоступленияТоваров.КоличествоИзЗаказовОстаток
ИЗ
	РегистрНакопления.ГрафикПоступленияТоваров.Остатки КАК ГрафикПоступленияТоваров
		ЛЕВОЕ СОЕДИНЕНИЕ ОтборПоСегментуНоменклатуры КАК ОтборПоСегментуНоменклатуры
		ПО ГрафикПоступленияТоваров.Номенклатура = ОтборПоСегментуНоменклатуры.Номенклатура
ГДЕ
	ВЫБОР
			КОГДА &amp;ИспользуетсяОтборПоСегменту
				ТОГДА НЕ ОтборПоСегментуНоменклатуры.Номенклатура ЕСТЬ NULL
			ИНАЧЕ ИСТИНА
		КОНЕЦ
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ОстаткиДетально.Номенклатура КАК Номенклатура,
	ВТ_ОстаткиДетально.Характеристика КАК Характеристика,
	ВТ_ОстаткиДетально.Склад КАК Склад,
	СУММА(ВТ_ОстаткиДетально.Доступно) КАК Доступно,
	СУММА(ВТ_ОстаткиДетально.ВПути) КАК ВПути,
	0 КАК Продажи
ПОМЕСТИТЬ ВТ_Остатки
ИЗ
	ВТ_ОстаткиДетально КАК ВТ_ОстаткиДетально

СГРУППИРОВАТЬ ПО
	ВТ_ОстаткиДетально.Номенклатура,
	ВТ_ОстаткиДетально.Характеристика,
	ВТ_ОстаткиДетально.Склад

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаНоменклатуры.Номенклатура,
	ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаНоменклатуры.Характеристика,
	ВыручкаИСебестоимостьПродажОбороты.Склад,
	0,
	0,
	ВыручкаИСебестоимостьПродажОбороты.КоличествоОборот
ИЗ
	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(&amp;ДатаНачалаПродаж {(&amp;ДатаНачалаПродаж)}, &amp;ДатаОкончанияПродаж {(&amp;ДатаОкончанияПродаж)}, Период, ) КАК ВыручкаИСебестоимостьПродажОбороты
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_Остатки.Номенклатура КАК Номенклатура,
	ВТ_Остатки.Характеристика КАК Характеристика,
	ВТ_Остатки.Склад КАК Склад,
	СУММА(ВТ_Остатки.Доступно) КАК Доступно,
	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) КАК Цена,
	СУММА(ВТ_Остатки.ВПути) КАК ВПути,
	МАКСИМУМ(ЕСТЬNULL(игр_АВСКлассификацияСклад.Класс, "")) КАК РейтингСклад,
	МАКСИМУМ(ЕСТЬNULL(игр_АВСКлассификацияОрганизация.Класс, "")) КАК Рейтинг,
	СУММА(ВТ_Остатки.Продажи) КАК Продажи
ИЗ
	ВТ_Остатки КАК ВТ_Остатки
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&amp;ДатаОстатков {(&amp;ДатаОстатков)}, ВидЦены = &amp;ВидЦены) КАК ЦеныНоменклатурыСрезПоследних
		ПО ВТ_Остатки.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура
			И ВТ_Остатки.Характеристика = ЦеныНоменклатурыСрезПоследних.Характеристика
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.игр_АВСКлассификацияНоменклатуры.СрезПоследних(&amp;ДатаОстатков, Раздел = &amp;Организация) КАК игр_АВСКлассификацияОрганизация
		ПО ВТ_Остатки.Номенклатура = игр_АВСКлассификацияОрганизация.Номенклатура
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.игр_АВСКлассификацияНоменклатуры.СрезПоследних(&amp;ДатаОстатков, ) КАК игр_АВСКлассификацияСклад
		ПО ВТ_Остатки.Номенклатура = игр_АВСКлассификацияСклад.Номенклатура
			И ВТ_Остатки.Склад.Подразделение = игр_АВСКлассификацияСклад.Раздел

СГРУППИРОВАТЬ ПО
	ВТ_Остатки.Номенклатура,
	ВТ_Остатки.Характеристика,
	ВТ_Остатки.Склад,
	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0)</query>
	</dataSet>
