#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустой() Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СчетПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(Запись.Счет) Тогда
		ОчисткаСчетаНаКлиенте();
	Иначе
		СчетПриИзмененииНаСервере("Счет");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КорСчетПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(Запись.КорСчет) Тогда
		ОчисткаСчетаНаКлиенте();
	Иначе
		СчетПриИзмененииНаСервере("КорСчет");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	УстановитьПараметрыВыбораСчетовСервер();
	
КонецПроцедуры

&НаСервере
Процедура СчетПриИзмененииНаСервере(ИмяРеквизита)
	
	Счет = Запись[ИмяРеквизита];
	СчетаСНаборомСубконто = ПланыСчетов.Хозрасчетный.СчетаСНаборомСубконто(Счет.ВидыСубконто.Выгрузить().ВыгрузитьКолонку("ВидСубконто"));
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Хозрасчетный.Ссылка
	|ИЗ
	|	ПланСчетов.Хозрасчетный КАК Хозрасчетный
	|ГДЕ
	|	Хозрасчетный.Забалансовый = ЛОЖЬ
	|	И Хозрасчетный.ЗапретитьИспользоватьВПроводках = ЛОЖЬ
	|	И Хозрасчетный.Валютный = &Валютный
	|	И Хозрасчетный.УчетПоПодразделениям = &УчетПоПодразделениям
	|	И Хозрасчетный.НалоговыйУчет = &НалоговыйУчет
	|	И НЕ Хозрасчетный.Ссылка В ИЕРАРХИИ (
	|		ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ОсновноеПроизводство_),
	|		ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПолуфабрикатыСобственногоПроизводства_),
	|		ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ВспомогательныеПроизводства_))
	|	И Хозрасчетный.Вид = &ВидСчета
	|	И Хозрасчетный.Ссылка В(&Ссылка)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Хозрасчетный.Ссылка
	|ИЗ
	|	ПланСчетов.Хозрасчетный КАК Хозрасчетный
	|ГДЕ
	|	Хозрасчетный.Забалансовый = ЛОЖЬ
	|	И Хозрасчетный.ЗапретитьИспользоватьВПроводках = ЛОЖЬ
	|	И Хозрасчетный.Ссылка В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.НезавершенноеПроизводство))
	|	И &Счет В ИЕРАРХИИ (
	|		ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ОсновноеПроизводство_),
	|		ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПолуфабрикатыСобственногоПроизводства_),
	|		ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ВспомогательныеПроизводства_))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Хозрасчетный.Ссылка КАК Ссылка
	|ИЗ
	|	ПланСчетов.Хозрасчетный КАК Хозрасчетный
	|ГДЕ
	|	Хозрасчетный.Забалансовый = ЛОЖЬ
	|	И Хозрасчетный.ЗапретитьИспользоватьВПроводках = ЛОЖЬ
	|	И &СчетДляПроверки В ИЕРАРХИИ (
	|		ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ОсновноеПроизводство_),
	|		ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПолуфабрикатыСобственногоПроизводства_),
	|		ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ВспомогательныеПроизводства_))";
	
	Запрос.УстановитьПараметр("ВидСчета",             ?(Счет.Вид = ВидСчета.Активный, ВидСчета.Пассивный, ВидСчета.Активный));
	Запрос.УстановитьПараметр("Валютный",             Счет.Валютный);
	Запрос.УстановитьПараметр("УчетПоПодразделениям", Счет.УчетПоПодразделениям);
	Запрос.УстановитьПараметр("НалоговыйУчет",        Счет.НалоговыйУчет);
	Запрос.УстановитьПараметр("Ссылка",               СчетаСНаборомСубконто);
	Запрос.УстановитьПараметр("Счет",                 Счет);
	Запрос.УстановитьПараметр("СчетДляПроверки",      Запись.Счет);
	
	Результат = Запрос.ВыполнитьПакет();
	
	Если ИмяРеквизита = "Счет" Тогда
		ЗаполнитьПараметрыВыбора("КорСчет", Результат[0].Выгрузить().ВыгрузитьКолонку("Ссылка"));
		Если Результат[1].Выбрать().Следующий() Тогда
			Элементы.ВозвратСальдо.Доступность = Ложь;
			Запись.ВозвратСальдо = Истина;
		Иначе
			Элементы.ВозвратСальдо.Доступность = Истина;
		КонецЕсли;
	Иначе
		ЗаполнитьПараметрыВыбора("Счет", Результат[0].Выгрузить().ВыгрузитьКолонку("Ссылка"));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметрыВыбора(ИмяРеквизита, МассивСсылок)
	
	МассивОтборов = Новый Массив;
	МассивОтборов.Добавить(Новый ПараметрВыбора("Отбор.Ссылка", МассивСсылок));
	Элементы[ИмяРеквизита].ПараметрыВыбора  = Новый ФиксированныйМассив(МассивОтборов);
	
КонецПроцедуры

&НаКлиенте
Процедура ОчисткаСчетаНаКлиенте()
	
	Запись.Счет    = ПредопределенноеЗначение("ПланСчетов.Хозрасчетный.ПустаяСсылка");
	Запись.КорСчет = ПредопределенноеЗначение("ПланСчетов.Хозрасчетный.ПустаяСсылка");
	
	УстановитьПараметрыВыбораСчетовСервер();
	Элементы.ВозвратСальдо.Доступность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыВыбораСчетовСервер()
	
	Если ЗначениеЗаполнено(Запись.Счет) И
		 ЗначениеЗаполнено(Запись.КорСчет) Тогда
		
		СчетПриИзмененииНаСервере("Счет");
		СчетПриИзмененииНаСервере("КорСчет");
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	Хозрасчетный.Ссылка
		|ИЗ
		|	ПланСчетов.Хозрасчетный КАК Хозрасчетный
		|ГДЕ
		|	Хозрасчетный.Вид <> ЗНАЧЕНИЕ(ВидСчета.АктивноПассивный)
		|	И Хозрасчетный.ЗапретитьИспользоватьВПроводках = ЛОЖЬ
		|	И Хозрасчетный.Забалансовый = ЛОЖЬ";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ЗаполнитьПараметрыВыбора("Счет",  РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка"));
		ЗаполнитьПараметрыВыбора("КорСчет", РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка"));
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти