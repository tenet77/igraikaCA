#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЗаписьРегистра Из ЭтотОбъект Цикл
		
		Если ЗначениеЗаполнено(ЗаписьРегистра.Договор) Тогда		
			
			Если НЕ ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаписьРегистра.Договор, "Подразделение")) Тогда
				СообщениеОбОшибке = НСтр("ru = 'В договоре не заполнен реквизит ""Подразделение"", в связи с чем при заполнении документа ""Отражение зарплаты в финансовом учете"" колонка ""Подразделение-получатель"" будет пустой по данному договорнику.'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОбОшибке);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
	
#КонецЕсли
