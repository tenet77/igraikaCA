#Область ПрограммныйИнтерфейс

Процедура УстановитьСостояние(Знач Заявки, Состояние) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	МассивЗаявок = Новый Массив;
	
	Если ТипЗнч(Заявки) = Тип("Массив") Тогда
		МассивЗаявок = Заявки;
	Иначе
		МассивЗаявок.Добавить(Заявки);
	КонецЕсли; 
	
	НачатьТранзакцию();
	
	Попытка
	
		Для Каждого Элемент Из МассивЗаявок Цикл   
			Набор = РегистрыСведений.ФП_СостоянияЗаявокНаРасходДС.СоздатьНаборЗаписей();
			Набор.Отбор.Заявка.Установить(Элемент);
			НоваяСтрока	= Набор.Добавить();
			НоваяСтрока.Заявка		= Элемент;
			НоваяСтрока.Состояние	= Состояние;
			
			Набор.Записать();
			
			СтатусОбъекта	= Неопределено;
			Если Состояние = Перечисления.ФП_СостоянияЗаявокНаРасходДС.Подготовлена Тогда
				СтатусОбъекта = Перечисления.СтатусыЗаявокНаРасходованиеДенежныхСредств.НеСогласована;
			ИначеЕсли Состояние = Перечисления.ФП_СостоянияЗаявокНаРасходДС.Согласована Тогда
				СтатусОбъекта = Перечисления.СтатусыЗаявокНаРасходованиеДенежныхСредств.Согласована;
			ИначеЕсли Состояние = Перечисления.ФП_СостоянияЗаявокНаРасходДС.КОплате Тогда
				СтатусОбъекта = Перечисления.СтатусыЗаявокНаРасходованиеДенежныхСредств.КОплате;
			ИначеЕсли Состояние = Перечисления.ФП_СостоянияЗаявокНаРасходДС.Оплачена Тогда
				СтатусОбъекта = Перечисления.СтатусыЗаявокНаРасходованиеДенежныхСредств.КОплате;
			ИначеЕсли Состояние = Перечисления.ФП_СостоянияЗаявокНаРасходДС.Отменена Тогда
				СтатусОбъекта = Перечисления.СтатусыЗаявокНаРасходованиеДенежныхСредств.Отклонена;
			КонецЕсли;
			
			ОбъектЗаявка	= Элемент.ПолучитьОбъект();
			Если ОбъектЗаявка.Статус <> СтатусОбъекта Тогда
				ОбъектЗаявка.Статус = СтатусОбъекта;
				Если ОбъектЗаявка.Проведен Тогда
					ОбъектЗаявка.Записать(РежимЗаписиДокумента.Проведение);
				Иначе
					ОбъектЗаявка.Записать(РежимЗаписиДокумента.Запись);
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		
		Информация	= ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации("ФП.Установка состояния заявки", УровеньЖурналаРегистрации.Ошибка,
			,, ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация));
			
	КонецПопытки;
		
КонецПроцедуры

Функция СостояниеЗаявки(Заявка) Экспорт 
	
	Результат	= Неопределено;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Набор	= РегистрыСведений.ФП_СостоянияЗаявокНаРасходДС.СоздатьНаборЗаписей();
	Набор.Отбор.Заявка.Установить(Заявка);
	Набор.Прочитать();
	Если Набор.Количество() > 0 Тогда
		Результат = Набор[0].Состояние;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

