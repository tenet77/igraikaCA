Процедура ИзменитьСтатусы()
	
	ЭКОМ_ОбменСеть      = ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере("ЭКОМ_ОбменСеть"     , Ложь);
	ЭКОМ_ОбменПоставщик = ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере("ЭКОМ_ОбменПоставщик", Ложь);
	ЭКОМ_ОбменЭТРН      = ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере("ЭКОМ_ОбменЭТРН"     , Ложь);
	
	Если ЭКОМ_ОбменПоставщик = Истина  Тогда
		ИзменитьСтатусыДляПоставщика();			
	КонецЕсли;
	
	Если ЭКОМ_ОбменСеть = Истина Тогда
		ИзменитьСтатусыДляСети();		
	КонецЕсли;	
	
	Если ЭКОМ_ОбменЭТРН = Истина Тогда
		ИзменитьСтатусыДляЭТРН();					
	КонецЕсли;			
	
КонецПроцедуры

Функция ПолучитьСтатусЮЗД(ИмяРегистраЦепочки, ТекущаяЗапись)
	
	ВидДокумента      = ТекущаяЗапись.ВидДокумента; 
	НаправлениеОбмена = ТекущаяЗапись.НаправлениеОбмена;
	СтатусЮЗД         = Перечисления.ЭКОМ_Статусы.ПустаяСсылка();
	СчитатьКоличествоКвитанций = ЭтотОбъект.ДополнительныеСвойства.Свойство("ПерваяЗапись"); // Записываем первый раз запись регистра
	ЭтоЮЗД                     = ЭКОМ_ОбщегоНазначения.ОтноситсяКЮЗД(ВидДокумента);
	
	Если ИмяРегистраЦепочки = "ЭКОМ_ЦепочкиДокументовПоставщика" Тогда
		
		ДокФункция = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьФункциюЮЗД(,ТекущаяЗапись.Контрагент)");
		
		Если ЭтоЮЗД = Истина Тогда		
			СчитатьКоличествоКвитанций = Ложь;
			СтатусЮЗД = Перечисления.ЭКОМ_Статусы.Отправлен;
			
		ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_PDPOL_02
			ИЛИ ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_IZVPOL_04
			ИЛИ ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_PDOTPR_03 Тогда
			
			СтатусЮЗД = Перечисления.ЭКОМ_Статусы.ОжиданиеПодтверждения;			
			
		ИначеЕсли (ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_IZVPOL_06 
			ИЛИ ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_PDOTPR_08)  Тогда
			
			Если ДокФункция = "СЧФ" Тогда
				СтатусЮЗД = Перечисления.ЭКОМ_Статусы.ПодписаноПокупателем;
			Иначе
				СтатусЮЗД = Перечисления.ЭКОМ_Статусы.ОжиданиеПодтверждения;
			КонецЕсли;
			
		ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_UVUTOCH_09
			ИЛИ ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_IZVPOL_10
			ИЛИ ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_PDOTPR_13 Тогда
			
			СтатусЮЗД = Перечисления.ЭКОМ_Статусы.Уточнение_Получено;
			
		ИначеЕсли ЭКОМ_ОбщегоНазначения.ЯвляетсяПодписьюЮЗД(ВидДокумента)
			ИЛИ ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_REZRUZAK_Входящий Тогда
			
			СтатусЮЗД = Перечисления.ЭКОМ_Статусы.ПодписаноПокупателем;
			
		ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_PRANNUL_22
			И НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Исходящий Тогда			
			СтатусЮЗД = Перечисления.ЭКОМ_Статусы.ОтправленоАннулирование;
			
		ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_PRANNUL_22
			И НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Входящий Тогда			
			СтатусЮЗД = Перечисления.ЭКОМ_Статусы.ПредложеноАннулирование;
			
		ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_IZVPOL_23 Тогда			
			СтатусЮЗД = Перечисления.ЭКОМ_Статусы.ПринятоАннулирование;
			
		ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_UVUTOCH_24 Тогда		
			СтатусЮЗД = Перечисления.ЭКОМ_Статусы.ОтклоненоАннулирование;
			
		КонецЕсли;
		
	//Docrobot 29.11.21 MOD-1451 [получение статуса ЮЗД по приоритету]
	ИначеЕсли ИмяРегистраЦепочки = "ЭКОМ_ЦепочкиДокументовПокупателя" Тогда	
		
			СчитатьКоличествоКвитанций = Ложь;
	
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
