
Процедура ПриЗаписи(Отказ, Замещение)
	
	ИзменитьСтатусы();
	
КонецПроцедуры

Процедура ИзменитьСтатусыДляПоставщика()
	
	ИмяРегистраЦепочки = "ЭКОМ_ЦепочкиДокументовПоставщика";
	Если НЕ Метаданные.РегистрыСведений.Найти(ИмяРегистраЦепочки) = Неопределено Тогда
		
		//ЮЗД         
		МетаданныеРегистра = Метаданные.РегистрыСведений[ИмяРегистраЦепочки];
		ТипСЧФ = МетаданныеРегистра.Измерения.Найти("СЧФ").Тип;
		
		Для Каждого ТекущаяЗапись Из ЭтотОбъект Цикл
			
			ДанныеОтбора = Новый Структура;
            ДанныеОтбора.Вставить("ORDERDATE"  , ТекущаяЗапись.ЗаказДата);
			ДанныеОтбора.Вставить("ORDERNUMBER", ТекущаяЗапись.ЗаказНомер);
			ДанныеОтбора.Вставить("Организация", ТекущаяЗапись.Организация);
			ДанныеОтбора.Вставить("Контрагент", ТекущаяЗапись.Контрагент);
			
			Если ТипЗнч(ТекущаяЗапись.Документ_Основание) = Тип("ДокументСсылка.ЭКОМ_Документы") Тогда			
				ДанныеОтбора.Вставить("ТочкаДоставки", ТекущаяЗапись.Документ_Основание.ТочкаДоставки);		
			КонецЕсли;
						
			//ORDRSP Исходящий
			Если ТекущаяЗапись.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ORDRSP_Исходящий Тогда
				
				ДанныеРесурсов = Новый Структура;
				ДанныеРесурсов.Вставить("Статус_ORDRSP", ТекущаяЗапись.СтатусЭлектронногоДокумента);
				ДанныеРесурсов.Вставить("ТекстОшибки", ТекущаяЗапись.ТекстОшибки);
				
				Если ТипЗнч(ТекущаяЗапись.Документ_Основание) = Тип("ДокументСсылка.ЭКОМ_Документы")
					И ТекущаяЗапись.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ORDRSP_Исходящий Тогда
					
					Измерение = "ORDER";
				Иначе   
					
					ТипЗаказа 		= МетаданныеРегистра.Измерения.Найти("Заказ").Тип;
					ТипРеализации 	= МетаданныеРегистра.Измерения.Найти("Накладная").Тип;
					Если (ТипЗнч(ТипЗаказа) = Тип("ОписаниеТипов")
						И ТипЗаказа.СодержитТип(ТипЗнч(ТекущаяЗапись.Документ_Основание)))
						ИЛИ ТипЗнч(ТекущаяЗапись.Документ_Основание) = ТипЗаказа Тогда
						Измерение = "Заказ";
					ИначеЕсли (ТипЗнч(ТипРеализации) = Тип("ОписаниеТипов")
						И ТипРеализации.СодержитТип(ТипЗнч(ТекущаяЗапись.Документ_Основание)))
						ИЛИ ТипЗнч(ТекущаяЗапись.Документ_Основание) = ТипРеализации Тогда
						Измерение = "Накладная";
					Иначе                                                          
						ТекстЛогаСобытий = "Не найдено измерение для установки отбора по документу-основанию " + Строка(ТекущаяЗапись.Документ_Основание);
						ЭКОМ_ОбщегоНазначения.ЗаписатьСтрокуЛогаСобытийвРегистрЛогирование(
						ЭКОМ_ОбщегоНазначения.ЗаполненнаяЗаписьЛога(
						ТекстЛогаСобытий,
						Перечисления.ЭКОМ_УровниЛогирования.Ошибка,
						"Добавление/редактирование записи регистра сведений " + ИмяРегистраЦепочки));
						Возврат;
					КонецЕсли;
					
				КонецЕсли;
				
				ЭКОМ_ОбщегоНазначения.ЗаписатьСтатусДокумента(ИмяРегистраЦепочки, Измерение, ТекущаяЗапись.Документ_Основание, ДанныеРесурсов, ДанныеОтбора);
			КонецЕсли;
			
			//DESADV Исходящий
			Если ТекущаяЗапись.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DESADV_Исходящий Тогда
				
				ДанныеРесурсов = Новый Структура;
				ДанныеРесурсов.Вставить("Статус_DESADV", ТекущаяЗапись.СтатусЭлектронногоДокумента);
				ДанныеРесурсов.Вставить("ТекстОшибки", ТекущаяЗапись.ТекстОшибки);
				
				ЭКОМ_ОбщегоНазначения.ЗаписатьСтатусДокумента(ИмяРегистраЦепочки, "Накладная", ТекущаяЗапись.Документ_Основание, ДанныеРесурсов, ДанныеОтбора);
			КонецЕсли;
			
			//RETORD Исходящий //Docrobot 1.21.0 MOD-1648
			Если ТекущаяЗапись.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.RETORD_Исходящий Тогда
				
				ДанныеРесурсов = Новый Структура;
				ДанныеРесурсов.Вставить("Статус_RETORD", ТекущаяЗапись.СтатусЭлектронногоДокумента);
				ДанныеРесурсов.Вставить("ТекстОшибки", ТекущаяЗапись.ТекстОшибки);
				
				ЭКОМ_ОбщегоНазначения.ЗаписатьСтатусДокумента(ИмяРегистраЦепочки, "ORDER", ТекущаяЗапись.Документ_Основание, ДанныеРесурсов, ДанныеОтбора);
			КонецЕсли;
			
			//DESSCC Исходящий
			Если ТекущаяЗапись.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DESSCC_Исходящий Тогда
				
				ДанныеРесурсов = Новый Структура;
				ДанныеРесурсов.Вставить("Статус_DESSCC", ТекущаяЗапись.СтатусЭлектронногоДокумента);
				ДанныеРесурсов.Вставить("ТекстОшибки", ТекущаяЗапись.ТекстОшибки);
				
				ЭКОМ_ОбщегоНазначения.ЗаписатьСтатусДокумента(ИмяРегистраЦепочки, "Накладная", ТекущаяЗапись.Документ_Основание, ДанныеРесурсов, ДанныеОтбора);
			КонецЕсли;
						
			//RETINS Исходящий
			Если ТекущаяЗапись.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.RETINS_Исходящий Тогда
				
				ДанныеРесурсов = Новый Структура;
				ДанныеРесурсов.Вставить("Статус_RETINS", ТекущаяЗапись.СтатусЭлектронногоДокумента);
				ДанныеРесурсов.Вставить("ТекстОшибки", ТекущаяЗапись.ТекстОшибки);
				
				ЭКОМ_ОбщегоНазначения.ЗаписатьСтатусДокумента(ИмяРегистраЦепочки, "ВозвратнаяНакладная", ТекущаяЗапись.Документ_Основание, ДанныеРесурсов, ДанныеОтбора);
			КонецЕсли;
									
			//INVOICE Исходящий
			Если ТекущаяЗапись.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.INVOICE Тогда
				
				ДанныеРесурсов = Новый Структура;
				ДанныеРесурсов.Вставить("Статус_INVOICE", ТекущаяЗапись.СтатусЭлектронногоДокумента);
				ДанныеРесурсов.Вставить("ТекстОшибки", ТекущаяЗапись.ТекстОшибки);
				
				ЭКОМ_ОбщегоНазначения.ЗаписатьСтатусДокумента(ИмяРегистраЦепочки, "Накладная", ТекущаяЗапись.Документ_Основание, ДанныеРесурсов, ДанныеОтбора);
			КонецЕсли;
			
			//STATUS Входящий
			Если ТекущаяЗапись.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.STATUS 
				И ТекущаяЗапись.НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Входящий Тогда
				
				ДанныеРесурсов = Новый Структура;
				ДанныеРесурсов.Вставить("Статус_STATUS", ТекущаяЗапись.СтатусЭлектронногоДокумента);
				ДанныеРесурсов.Вставить("ТекстОшибки", ТекущаяЗапись.ТекстОшибки);
				
				ЭКОМ_ОбщегоНазначения.ЗаписатьСтатусДокумента(ИмяРегистраЦепочки, "ORDER", ТекущаяЗапись.Документ_Основание, ДанныеРесурсов, ДанныеОтбора);
			КонецЕсли;
			
			//DP_REZRUISP Исходящий
			Если ТекущаяЗапись.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_REZRUISP_Исходящий Тогда
				
				ДанныеРесурсов = Новый Структура;
				ДанныеРесурсов.Вставить("Статус_DP_REZRUISP", ТекущаяЗапись.СтатусЭлектронногоДокумента);
				ДанныеРесурсов.Вставить("ТекстОшибки", ТекущаяЗапись.ТекстОшибки);
				
				ЭКОМ_ОбщегоНазначения.ЗаписатьСтатусДокумента(ИмяРегистраЦепочки, "Накладная", ТекущаяЗапись.Документ_Основание, ДанныеРесурсов, ДанныеОтбора);
			КонецЕсли;
			
			//DP_REZRUZAK Входящий
			Если ТекущаяЗапись.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_REZRUZAK_Входящий Тогда
				
				ДанныеРесурсов = Новый Структура;
				ДанныеРесурсов.Вставить("Статус_DP_REZRUZAK", ТекущаяЗапись.СтатусЭлектронногоДокумента);
				ДанныеРесурсов.Вставить("ТекстОшибки", ТекущаяЗапись.ТекстОшибки);
				
				ЭКОМ_ОбщегоНазначения.ЗаписатьСтатусДокумента(ИмяРегистраЦепочки, "Накладная", ТекущаяЗапись.Документ_Основание, ДанныеРесурсов, ДанныеОтбора);
			КонецЕсли;
			
			//RETANN Входящий
			Если ТекущаяЗапись.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.RETANN_Входящий Тогда
				
				ДанныеРесурсов = Новый Структура;
				ДанныеРесурсов.Вставить("Статус_RETANN", ТекущаяЗапись.СтатусЭлектронногоДокумента);
				ДанныеРесурсов.Вставить("ТекстОшибки", ТекущаяЗапись.ТекстОшибки);
				
				ЭКОМ_ОбщегоНазначения.ЗаписатьСтатусДокумента(ИмяРегистраЦепочки, "RETANN", ТекущаяЗапись.Документ_Основание, ДанныеРесурсов, ДанныеОтбора);
			КонецЕсли;
			
			Если ТипСЧФ.СодержитТип(ТипЗнч(ТекущаяЗапись.Документ_Основание)) Тогда	
				
				ВидыДокументовЮЗД = Новый Массив;
				ЭКОМ_ОбщегоНазначения.ПолучитьПервичныеВидыДокументовЮЗД(ВидыДокументовЮЗД);

				ВидыДокументовКоррИспрЮЗД = Новый Массив;
				ЭКОМ_ОбщегоНазначения.ПолучитьКорректировочныеВидыДокументовЮЗД(ВидыДокументовКоррИспрЮЗД);
				ЭКОМ_ОбщегоНазначения.ПолучитьИсправительныеВидыДокументовЮЗД(ВидыДокументовКоррИспрЮЗД);
								
				Результат = ПолучитьСтатусЮЗД(ИмяРегистраЦепочки, ТекущаяЗапись);
				ДанныеРесурсов = Новый Структура;
				ДанныеРесурсов.Вставить("СчитатьКоличествоКвитанций", Результат.СчитатьКоличествоКвитанций); 
				ДанныеРесурсов.Вставить("СтатусЮЗД",                  Результат.СтатусЮЗД);

				Если НЕ ВидыДокументовЮЗД.Найти(ТекущаяЗапись.ВидДокумента) = Неопределено Тогда				
					ДанныеРесурсов.Вставить("ИдентификаторСчФ", ТекущаяЗапись.Идентификатор);
										
				ИначеЕсли НЕ ВидыДокументовКоррИспрЮЗД.Найти(ТекущаяЗапись.ВидДокумента) = Неопределено Тогда				
					ДанныеРесурсов.Вставить("ИдентификаторСчФ_Кор", ТекущаяЗапись.Идентификатор);
					
				КонецЕсли;	
				
				ЭКОМ_ОбщегоНазначения.ЗаписатьСтатусДокумента(ИмяРегистраЦепочки, "СЧФ", ТекущаяЗапись.Документ_Основание, ДанныеРесурсов, ДанныеОтбора);
                ЭКОМ_ОбщегоНазначения.ЗаписатьСтатусДокумента(ИмяРегистраЦепочки, "СЧФ_Кор", ТекущаяЗапись.Документ_Основание, ДанныеРесурсов, ДанныеОтбора);

			КонецЕсли;			
		КонецЦикла;		
	КонецЕсли;
	
КонецПроцедуры

Процедура ИзменитьСтатусыДляСети()
	
	ИмяРегистраЦепочки = "ЭКОМ_ЦепочкиДокументовПокупателя";
	Если НЕ Метаданные.РегистрыСведений.Найти(ИмяРегистраЦепочки) = Неопределено Тогда
		
		//ЮЗД
		Тип_ДокументЭКОМ = Метаданные.РегистрыСведений[ИмяРегистраЦепочки].Измерения.Найти("ЮЗД").Тип;
		
		Для Каждого ТекущаяЗапись Из ЭтотОбъект Цикл
			
			ДанныеОтбора = Новый Структура;
            ДанныеОтбора.Вставить("ORDERDATE"  , ТекущаяЗапись.ЗаказДата);
			ДанныеОтбора.Вставить("ORDERNUMBER", ТекущаяЗапись.ЗаказНомер);
			ДанныеОтбора.Вставить("Организация", ТекущаяЗапись.Организация);
			ДанныеОтбора.Вставить("Контрагент", ТекущаяЗапись.Контрагент);

			//ORDER Исходящий
			Если ТекущаяЗапись.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ORDER_Исходящий Тогда
				
				ДанныеРесурсов = Новый Структура;
				ДанныеРесурсов.Вставить("Статус_ORDER", ТекущаяЗапись.СтатусЭлектронногоДокумента);
				ДанныеРесурсов.Вставить("ТекстОшибки", ТекущаяЗапись.ТекстОшибки);
				
				ЭКОМ_ОбщегоНазначения.ЗаписатьСтатусДокумента(ИмяРегистраЦепочки, "Заказ", ТекущаяЗапись.Документ_Основание, ДанныеРесурсов, ДанныеОтбора);
			КонецЕсли;
				
			//RECADV Исходящий
			Если ТекущаяЗапись.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.RECADV_Исходящий Тогда
				
				ДанныеРесурсов = Новый Структура;
				ДанныеРесурсов.Вставить("Статус_RECADV", ТекущаяЗапись.СтатусЭлектронногоДокумента);
				ДанныеРесурсов.Вставить("ТекстОшибки", ТекущаяЗапись.ТекстОшибки);
				
				ЭКОМ_ОбщегоНазначения.ЗаписатьСтатусДокумента(ИмяРегистраЦепочки, "Накладная", ТекущаяЗапись.Документ_Основание, ДанныеРесурсов, ДанныеОтбора);
			КонецЕсли;
						
			//RETANN Исходящий
			Если ТекущаяЗапись.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.RETANN_Исходящий Тогда
				
				ДанныеРесурсов = Новый Структура;
				ДанныеРесурсов.Вставить("Статус_RETANN", ТекущаяЗапись.СтатусЭлектронногоДокумента);
				ДанныеРесурсов.Вставить("ТекстОшибки", ТекущаяЗапись.ТекстОшибки);
				
				ЭКОМ_ОбщегоНазначения.ЗаписатьСтатусДокумента(ИмяРегистраЦепочки, "ВозвратнаяНакладная", ТекущаяЗапись.Документ_Основание, ДанныеРесурсов, ДанныеОтбора);
			КонецЕсли;
			
			//STATUS Исходящий
			Если ТекущаяЗапись.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.STATUS 
				И ТекущаяЗапись.НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Исходящий Тогда
				
				ДанныеРесурсов = Новый Структура;
				ДанныеРесурсов.Вставить("Статус_STATUS", ТекущаяЗапись.СтатусЭлектронногоДокумента);
				ДанныеРесурсов.Вставить("ТекстОшибки", ТекущаяЗапись.ТекстОшибки);
				
				ЭКОМ_ОбщегоНазначения.ЗаписатьСтатусДокумента(ИмяРегистраЦепочки, "Заказ", ТекущаяЗапись.Документ_Основание, ДанныеРесурсов, ДанныеОтбора);
			КонецЕсли;
			
			//INVOICE Входящий
			Если ТекущаяЗапись.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.INVOICE 
				И ТекущаяЗапись.НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Входящий Тогда
				
				ДанныеРесурсов = Новый Структура;
				ДанныеРесурсов.Вставить("Статус_INVOICE", ТекущаяЗапись.СтатусЭлектронногоДокумента);
				ДанныеРесурсов.Вставить("ТекстОшибки", ТекущаяЗапись.ТекстОшибки);
				
				ЭКОМ_ОбщегоНазначения.ЗаписатьСтатусДокумента(ИмяРегистраЦепочки, "INVOICE", ТекущаяЗапись.Документ_Основание, ДанныеРесурсов, ДанныеОтбора);
			КонецЕсли;
			
			//ЮЗД Входящая  
			Если Тип_ДокументЭКОМ.СодержитТип(ТипЗнч(ТекущаяЗапись.Документ_Основание))
				И ЭКОМ_ОбщегоНазначения.ОтноситсяКЮЗД(ТекущаяЗапись.Документ_Основание.ВидДокумента)     Тогда //Docrobot 29.11.21 MOD-1451 [получение статуса ЮЗД по приоритету]
				
				Результат = ПолучитьСтатусЮЗД(ИмяРегистраЦепочки, ТекущаяЗапись);
				ДанныеРесурсов = Новый Структура;
				ДанныеРесурсов.Вставить("СчитатьКоличествоКвитанций", Результат.СчитатьКоличествоКвитанций); 
				ДанныеРесурсов.Вставить("СтатусЮЗД",                  Результат.СтатусЮЗД);
					
				Если Результат.ЭтоЮЗД = Истина Тогда
				    ДанныеРесурсов.Вставить("ИдентификаторСчФ", ТекущаяЗапись.Идентификатор);						
				КонецЕсли;
								
				ЭКОМ_ОбщегоНазначения.ЗаписатьСтатусДокумента(ИмяРегистраЦепочки, "ЮЗД", ТекущаяЗапись.Документ_Основание, ДанныеРесурсов, ДанныеОтбора);
				
			КонецЕсли;
			
			//RETINS Входящий
			Если ТекущаяЗапись.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.RETINS_Входящий Тогда
				
				ДанныеРесурсов = Новый Структура;
