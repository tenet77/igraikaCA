
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ПолучатьИдентификаторы = ЭКОМ_ОбщегоНазначения.Настройка_Параметр_Прочитать("ЭКОМ_ПолучатьИдентификаторыЦепочек", Ложь);
	Если ПолучатьИдентификаторы Тогда
		Элементы.ИдентификаторЦепочки.Видимость = Истина;
	КонецЕсли;
	
	МенеджерТекущейЗаписи     = РеквизитФормыВЗначение("Запись");
	СтруктураФайлаИзХранилища = МенеджерТекущейЗаписи.СтруктураФайла.Получить();
	
	дзДляЗаполнения = ДанныеФормыВЗначение(дзСтруктураФайла, Тип("ДеревоЗначений"));
	Если НЕ СтруктураФайлаИзХранилища = Неопределено Тогда
		Для Каждого ЭлементСтруктуры Из СтруктураФайлаИзХранилища Цикл
			СтрокаДЗ = дзДляЗаполнения.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДЗ, ЭлементСтруктуры);
			ЗначениеКлюча        = ЭлементСтруктуры.Значение;
			СтрокаДЗ.ТипЗначения = ТипЗнч(ЗначениеКлюча);
			Если ТипЗнч(ЗначениеКлюча) = Тип("Массив") Тогда
				СтрокаДЗ.Значение = СтрокаДЗ.Значение + " из " + Строка(ЗначениеКлюча.Количество()) + " элементов";
				
				Для Каждого ПодчиненнаяСтрокаМассива Из ЗначениеКлюча Цикл
					Для Каждого ЗначениеСтруктурыИзМассива Из ПодчиненнаяСтрокаМассива Цикл
						ПодчиненнаяСтрокаДЗСтруктура = СтрокаДЗ.Строки.Добавить(); 
						ЗаполнитьЗначенияСвойств(ПодчиненнаяСтрокаДЗСтруктура, ЗначениеСтруктурыИзМассива);
						ПодчиненнаяСтрокаДЗСтруктура.ТипЗначения = ТипЗнч(ЗначениеСтруктурыИзМассива.Значение);
					КонецЦикла;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	ЗначениеВДанныеФормы(дзДляЗаполнения, дзСтруктураФайла);
	
КонецПроцедуры
