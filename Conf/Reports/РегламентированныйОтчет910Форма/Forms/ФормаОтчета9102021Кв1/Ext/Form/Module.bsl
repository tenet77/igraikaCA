	Контейнер.Вставить("Форма910_01Страница2", СтруктураДанныхФорма910_01Страница2);
	Контейнер.Вставить("Форма910_01Страница2_ДанныеДопСтрок", ДанныеФормыВЗначение(П0001200002, Тип("ТаблицаЗначений")));
	Контейнер.Вставить("Форма910_01Страница3", СтруктураДанныхФорма910_01Страница3);
	Контейнер.Вставить("Форма910_01Страница3_ДанныеДопСтрок", ДанныеФормыВЗначение(П0001300002, Тип("ТаблицаЗначений")));
	Контейнер.Вставить("Форма910_01Страница4", СтруктураДанныхФорма910_01Страница4);
