                    СуммаП000280000103 = СуммаП000280000103 + РегламентированнаяОтчетностьКлиентСервер.ОкруглитьЧислоПоФормату(Форма, Форма.ТабличныйДокумент.Области["П000280000203_" + Ном].Значение);
                КонецЦикла;                                                                                                                                            
                
                Форма.ТабличныйДокумент.Области.П000280000103.Значение = СуммаП000280000103;
                
