			ИЛИ (ИмяРаздела = "Форма910_01Страница6")
            ИЛИ (ИмяРаздела = "Форма910_02Страница1")
			ИЛИ (ИмяРаздела = "Форма910_02Страница2")
			ИЛИ (ИмяРаздела = "Форма910_02Страница3")
			ИЛИ (ИмяРаздела = "Форма910_02Страница4")
			ИЛИ (ИмяРаздела = "Форма910_02Страница5")
			ИЛИ (ИмяРаздела = "Форма910_02Страница6")
			ИЛИ (ИмяРаздела = "Форма910_02Страница7")
			ИЛИ (ИмяРаздела = "Форма910_02Страница8");
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьКоличествоПодразделовПоРодителю(Родитель)
	
	Если Родитель = "Форма910Страница1" Тогда
		Возврат 4;
	ИначеЕсли Родитель = "Форма910_01Страница1" Тогда
		Возврат 6;
	ИначеЕсли Родитель = "Форма910_02Страница1" Тогда
		Возврат 8;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура СформироватьОтчетныйПериод()
	
	СтрПериодОтчета = ПредставлениеПериода(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета,СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета, "ФП = истина");
    
   	СтруктураРеквизитовФормы.мГод     	= Формат(Год(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета), "ЧГ="); // удаляем разделительный пробел, так как 		
	СтруктураРеквизитовФормы.мПолугодие	= ?(Месяц(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета) < 6, 1, 2); // удаляем разделительный пробел, так как 	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтруктуруЗависимыхЯчеекДляАвторасчета()
	
	СтруктураЗависимыхЯчеекДляАвторасчета = Новый Структура;
	//910Стр1
	СтруктураЗависимыхЯчеекДляАвторасчета.Вставить("ВидДекларации", "Первоначальная;Очередная;Дополнительная;ПоУведомлению;Ликвидационная");
	СтруктураЗависимыхЯчеекДляАвторасчета.Вставить("НаличиеПриложений", "Приложение01;Приложение02");
	СтруктураЗависимыхЯчеекДляАвторасчета.Вставить("КатегорияНалПл", "ДоверительныйУправляющий;Учредитель;ВедетБУ;НеВедетБУ");
	СтруктураЗависимыхЯчеекДляАвторасчета.Вставить("РезидентУчереждение", "Резидент;Нерезидент");
    СтруктураЗависимыхЯчеекДляАвторасчета.Вставить("ТИС", "ТрехкомпонентнаяИС");
    СтруктураЗависимыхЯчеекДляАвторасчета.Вставить("П000010001101", "П000010001201;П000010001301");
    СтруктураЗависимыхЯчеекДляАвторасчета.Вставить("П000010005101", "П000010001101");
