					Приложение03 = Форма.СтруктураДанныхФорма700Страница1.Приложение03;
				КонецЕсли;
				
				Приложение03 = ?(Приложение03 = "Х","","Х");
				
				Форма.СтруктураДанныхФорма700Страница1.Вставить("Приложение03", Приложение03);
