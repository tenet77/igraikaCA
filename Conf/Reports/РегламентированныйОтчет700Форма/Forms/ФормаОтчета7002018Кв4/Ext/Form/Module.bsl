		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("КБК");
		ЭлементОтбора.ПравоеЗначение = ?(ИмяЯчейки = "П000010002201","104309","104302");
		
		ПараметрыФормы = Новый Структура();
