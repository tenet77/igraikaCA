					Форма.ТабличныйДокумент.Области.Приложение03.Значение = Приложение03;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если СтрЧислоВхождений(Форма.СтруктураЗависимыхЯчеекДляАвторасчета.КатегорияНалПл, ОбластьИмя) > 0 Тогда
			
			ЗначениеТекЭлемента = "";
			
			Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Форма700Страница1" Тогда
				ЗначениеТекЭлемента = Форма.ТабличныйДокумент.Области[ОбластьИмя].Значение;
			ИначеЕсли Форма.СтруктураДанныхФорма700Страница1.Свойство(ОбластьИмя) Тогда
				ЗначениеТекЭлемента = Форма.СтруктураДанныхФорма700Страница1[ОбластьИмя];
			КонецЕсли;
			
			ЗначениеТекЭлемента = ?(ЗначениеТекЭлемента = "Х","","Х");
			
			Форма.СтруктураДанныхФорма700Страница1.Вставить("Признак6A", "");
