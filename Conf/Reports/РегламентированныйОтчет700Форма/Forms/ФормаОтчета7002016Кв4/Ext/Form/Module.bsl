Процедура РасчетНаСервере(ИмяСтраницыПанели = "", ОбластьИмя = "",СписокИсключенныхРазделов = Неопределено) Экспорт

	Расчет(ЭтаФорма, ИмяСтраницыПанели, ОбластьИмя, СписокИсключенныхРазделов);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура Расчет(Форма, ИмяСтраницыПанели = "", ОбластьИмя = "",СписокИсключенныхРазделов = Неопределено)
	Перем ТаблицаСтраницРаздела;
	
	Если Форма.СтруктураРеквизитовФормы.мРежимПечати Тогда
		Возврат;
	КонецЕсли;
	
	Если СписокИсключенныхРазделов <> Неопределено Тогда
		Если СтрНайти(СписокИсключенныхРазделов,ИмяСтраницыПанели) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяСтраницыПанели = "Форма700Страница1" Тогда
		
		Если СтрЧислоВхождений(Форма.СтруктураЗависимыхЯчеекДляАвторасчета.ВидДекларации, ОбластьИмя) > 0 Тогда
			
			Первоначальная = "";
			Очередная =      "";
			Дополнительная = "";
			ПоУведомлению =  "";
			Ликвидационная = "";
			
			
			Если ОбластьИмя = "Первоначальная" Тогда
				Первоначальная = "Х";
			ИначеЕсли ОбластьИмя = "Очередная" Тогда
				Очередная = "Х";
			ИначеЕсли ОбластьИмя = "Дополнительная" Тогда
				Дополнительная = "Х";
			ИначеЕсли ОбластьИмя = "ПоУведомлению" Тогда
				ПоУведомлению = "Х";
			ИначеЕсли ОбластьИмя = "Ликвидационная" Тогда
				Ликвидационная = "Х";
			Иначе
				Очередная = "Х";
			КонецЕсли;
			
			Форма.СтруктураДанныхФорма700Страница1.Вставить("Первоначальная", Первоначальная);
			Форма.СтруктураДанныхФорма700Страница1.Вставить("Очередная",           Очередная);
			Форма.СтруктураДанныхФорма700Страница1.Вставить("Дополнительная", Дополнительная);
			Форма.СтруктураДанныхФорма700Страница1.Вставить("ПоУведомлению",   ПоУведомлению);
			Форма.СтруктураДанныхФорма700Страница1.Вставить("Ликвидационная", Ликвидационная);
			Если Не ПоУведомлению = "Х" Тогда
				Форма.СтруктураДанныхФорма700Страница1.Вставить("НомерУведомления", "");
				Форма.СтруктураДанныхФорма700Страница1.Вставить("ДатаУведомления", "");
			КонецЕсли;
			
			Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Форма700Страница1" Тогда
				Форма.ТабличныйДокумент.Области.Первоначальная.Значение = Первоначальная;
				Форма.ТабличныйДокумент.Области.Очередная.Значение = Очередная;
				Форма.ТабличныйДокумент.Области.Дополнительная.Значение = Дополнительная;
				Форма.ТабличныйДокумент.Области.ПоУведомлению.Значение = ПоУведомлению;
				Форма.ТабличныйДокумент.Области.Ликвидационная.Значение = Ликвидационная;
				Если ПоУведомлению = "Х" Тогда
					Форма.ТабличныйДокумент.Области.НомерУведомления.Защита = Ложь;
					Форма.ТабличныйДокумент.Области.ДатаУведомления.Защита = Ложь;
				Иначе
					Форма.ТабличныйДокумент.Области.НомерУведомления.Значение = "";
					Форма.ТабличныйДокумент.Области.ДатаУведомления.Значение = "";
					Форма.ТабличныйДокумент.Области.НомерУведомления.Защита = Истина;
					Форма.ТабличныйДокумент.Области.ДатаУведомления.Защита = Истина;
				КонецЕсли;
					
			КонецЕсли;
			
		КонецЕсли;
		
		Если СтрЧислоВхождений(Форма.СтруктураЗависимыхЯчеекДляАвторасчета.НаличиеПриложений, ОбластьИмя) > 0 Тогда
			
			Приложение01 = "";
			Приложение02 = "";
			
			Если ОбластьИмя = "Приложение01" Тогда
				
				Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Форма700Страница1" Тогда
					Приложение01 = Форма.ТабличныйДокумент.Области.Приложение01.Значение;
				ИначеЕсли Форма.СтруктураДанныхФорма700Страница1.Свойство("Приложение01") Тогда
					Приложение01 = Форма.СтруктураДанныхФорма700Страница1.Приложение01;
				КонецЕсли;
				
				Приложение01 = ?(Приложение01 = "Х","","Х");
				
				Форма.СтруктураДанныхФорма700Страница1.Вставить("Приложение01", Приложение01);
				Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Форма700Страница1" Тогда
					Форма.ТабличныйДокумент.Области.Приложение01.Значение = Приложение01;
				КонецЕсли;
				
			ИначеЕсли ОбластьИмя = "Приложение02" Тогда 
				
				Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Форма700Страница1" Тогда
					Приложение02 = Форма.ТабличныйДокумент.Области.Приложение02.Значение;
				ИначеЕсли Форма.СтруктураДанныхФорма700Страница1.Свойство("Приложение02") Тогда
					Приложение02 = Форма.СтруктураДанныхФорма700Страница1.Приложение02;
				КонецЕсли;
				
				Приложение02 = ?(Приложение02 = "Х","","Х");
				
				Форма.СтруктураДанныхФорма700Страница1.Вставить("Приложение02", Приложение02);
				Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Форма700Страница1" Тогда
					Форма.ТабличныйДокумент.Области.Приложение02.Значение = Приложение02;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если СтрЧислоВхождений(Форма.СтруктураЗависимыхЯчеекДляАвторасчета.КатегорияНалПл, ОбластьИмя) > 0 Тогда
			
			ЗначениеТекЭлемента = "";
			
			Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Форма700Страница1" Тогда
				ЗначениеТекЭлемента = Форма.ТабличныйДокумент.Области[ОбластьИмя].Значение;
			ИначеЕсли Форма.СтруктураДанныхФорма700Страница1.Свойство(ОбластьИмя) Тогда
				ЗначениеТекЭлемента = Форма.СтруктураДанныхФорма700Страница1[ОбластьИмя];
			КонецЕсли;
			
			ЗначениеТекЭлемента = ?(ЗначениеТекЭлемента = "Х","","Х");
			
			Форма.СтруктураДанныхФорма700Страница1.Вставить("Признак6A", "");
			Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Форма700Страница1" Тогда
				Форма.ТабличныйДокумент.Области.Признак6A.Значение = "";
			КонецЕсли;
			
			Форма.СтруктураДанныхФорма700Страница1.Вставить("Признак6B", "");
			Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Форма700Страница1" Тогда
				Форма.ТабличныйДокумент.Области.Признак6B.Значение = "";
			КонецЕсли;
			
			Форма.СтруктураДанныхФорма700Страница1.Вставить("Признак6C", "");
			Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Форма700Страница1" Тогда
				Форма.ТабличныйДокумент.Области.Признак6C.Значение = "";
			КонецЕсли;
			
			Форма.СтруктураДанныхФорма700Страница1.Вставить("Признак6D", "");
			Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Форма700Страница1" Тогда
				Форма.ТабличныйДокумент.Области.Признак6D.Значение = "";
			КонецЕсли;
			
			Форма.СтруктураДанныхФорма700Страница1.Вставить(ОбластьИмя, ЗначениеТекЭлемента);
			Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Форма700Страница1" Тогда
				Форма.ТабличныйДокумент.Области[ОбластьИмя].Значение = ЗначениеТекЭлемента;
			КонецЕсли;
			
			//контракт
			Если Не ОбластьИмя = "Признак6D" ИЛИ ЗначениеТекЭлемента = "" Тогда
				Форма.СтруктураДанныхФорма700Страница1.Вставить("НомерКонтракта", "");
				Форма.СтруктураДанныхФорма700Страница1.Вставить("ДатаКонтракта", "");
			КонецЕсли;
			
			Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Форма700Страница1" Тогда
				Если ОбластьИмя = "Признак6D" И ЗначениеТекЭлемента = "Х" Тогда
					Форма.ТабличныйДокумент.Области.НомерКонтракта.Защита = Ложь;
					Форма.ТабличныйДокумент.Области.ДатаКонтракта.Защита = Ложь;
				Иначе
					Форма.ТабличныйДокумент.Области.НомерКонтракта.Значение = "";
					Форма.ТабличныйДокумент.Области.ДатаКонтракта.Значение = "";
					Форма.ТабличныйДокумент.Области.НомерКонтракта.Защита = Истина;
					Форма.ТабличныйДокумент.Области.ДатаКонтракта.Защита = Истина;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		//700.00.001
		Если НЕ ЗначениеЗаполнено(ОбластьИмя) ИЛИ СтрЧислоВхождений(Форма.СтруктураЗависимыхЯчеекДляАвторасчета.П000010001001, ОбластьИмя) > 0 Тогда
			
			ОкрП000010002001 = 0;
			ОкрП000010003001 = 0;
			
			Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Форма700Страница1" Тогда
				ОкрП000010002001 = РегламентированнаяОтчетностьКлиентСервер.ОкруглитьЧислоПоФормату(Форма, Форма.ТабличныйДокумент.Области.П000010002001.Значение);
			ИначеЕсли Форма.СтруктураДанныхФорма700Страница1.Свойство("П000010002001") Тогда
				ОкрП000010002001 = РегламентированнаяОтчетностьКлиентСервер.ОкруглитьЧислоПоФормату(Форма, Форма.СтруктураДанныхФорма700Страница1.П000010002001);
			КонецЕсли;
			
			Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Форма700Страница1" Тогда
				ОкрП000010003001 = РегламентированнаяОтчетностьКлиентСервер.ОкруглитьЧислоПоФормату(Форма, Форма.ТабличныйДокумент.Области.П000010003001.Значение);
			ИначеЕсли Форма.СтруктураДанныхФорма700Страница1.Свойство("П000010003001") Тогда
				ОкрП000010003001 = РегламентированнаяОтчетностьКлиентСервер.ОкруглитьЧислоПоФормату(Форма, Форма.СтруктураДанныхФорма700Страница1.П000010003001);
			КонецЕсли;
			
			П000010001001 = ОкрП000010002001 + ОкрП000010003001;
			
			Форма.СтруктураДанныхФорма700Страница1.Вставить("П000010001001", П000010001001);
			
			Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Форма700Страница1" Тогда
				Форма.ТабличныйДокумент.Области.П000010001001.Значение = П000010001001;
			КонецЕсли;
			
			Расчет(Форма, "Форма700Страница1", "П000010001001_Рекурсия"); //перерасчет 1й страницы
			
		КонецЕсли;
		
		//700.00.002
		Если НЕ ЗначениеЗаполнено(ОбластьИмя) ИЛИ (Лев(ОбластьИмя,8) = "П0001100" И Прав(ОбластьИмя,3)= "002")
											  ИЛИ (Лев(ОбластьИмя,8) = "П0001200" И Прав(ОбластьИмя,3)= "002")Тогда
			
			П000010002001 = 0;
			Для Индекс = 1 По 26 Цикл
				
				ТекЭлемент = ("П0001100"+Формат(Индекс,"ЧЦ=2; ЧВН=")+"002");
				ЗначениеТекЭлемента = 0;
				
				Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Форма700_01Страница1" Тогда
					ЗначениеТекЭлемента = РегламентированнаяОтчетностьКлиентСервер.ОкруглитьЧислоПоФормату(Форма, Форма.ТабличныйДокумент.Области[ТекЭлемент].Значение);
				ИначеЕсли Форма.СтруктураДанныхФорма700_01Страница1.Свойство(ТекЭлемент) Тогда
					ЗначениеТекЭлемента = РегламентированнаяОтчетностьКлиентСервер.ОкруглитьЧислоПоФормату(Форма, Форма.СтруктураДанныхФорма700_01Страница1[ТекЭлемент]);
				КонецЕсли;
				
				П000010002001 = П000010002001 + ЗначениеТекЭлемента;
				
			КонецЦикла;
			
			Для Индекс = 27 По 33 Цикл
				ТекЭлемент = ("П0001200"+Формат(Индекс,"ЧЦ=2; ЧВН=")+"002");
				ЗначениеТекЭлемента = 0;
				
				Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Форма700_01Страница2" Тогда
					ЗначениеТекЭлемента = РегламентированнаяОтчетностьКлиентСервер.ОкруглитьЧислоПоФормату(Форма, Форма.ТабличныйДокумент.Области[ТекЭлемент].Значение);
				ИначеЕсли Форма.СтруктураДанныхФорма700_01Страница2.Свойство(ТекЭлемент) Тогда
					ЗначениеТекЭлемента = РегламентированнаяОтчетностьКлиентСервер.ОкруглитьЧислоПоФормату(Форма, Форма.СтруктураДанныхФорма700_01Страница2[ТекЭлемент]);
				КонецЕсли;
				
				П000010002001 = П000010002001 + ЗначениеТекЭлемента;
				
			КонецЦикла;
			
			Форма.СтруктураДанныхФорма700Страница1.Вставить("П000010002001", П000010002001);
			
			Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Форма700Страница1" Тогда
				Форма.ТабличныйДокумент.Области.П000010002001.Значение = П000010002001;
			КонецЕсли;
			
			Расчет(Форма, "Форма700Страница1", "П000010002001"); //перерасчет 1й страницы
			
