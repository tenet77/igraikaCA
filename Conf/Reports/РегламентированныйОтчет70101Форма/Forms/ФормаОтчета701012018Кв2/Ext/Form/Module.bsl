				ОкрП000110000105 = РегламентированнаяОтчетностьКлиентСервер.ОкруглитьЧислоПоФормату(Форма, Форма.ТабличныйДокумент.Области.П000110000105.Значение);
			ИначеЕсли Форма.СтруктураДанныхФорма70101_001Страница1.Свойство("П000110000105") Тогда
				ОкрП000110000105 = РегламентированнаяОтчетностьКлиентСервер.ОкруглитьЧислоПоФормату(Форма, Форма.СтруктураДанныхФорма70101_001Страница1.П000110000105);
			КонецЕсли;
			
			Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Форма70101_001Страница2" Тогда
				ОкрП000120000102 = РегламентированнаяОтчетностьКлиентСервер.ОкруглитьЧислоПоФормату(Форма, Форма.ТабличныйДокумент.Области.П000120000102.Значение);
			ИначеЕсли Форма.СтруктураДанныхФорма70101_001Страница2.Свойство("П000120000102") Тогда
				ОкрП000120000102 = РегламентированнаяОтчетностьКлиентСервер.ОкруглитьЧислоПоФормату(Форма, Форма.СтруктураДанныхФорма70101_001Страница2.П000120000102);
			КонецЕсли;
			
			П000120000103 = ОкрП000110000103 + ОкрП000110000104 + ОкрП000110000105 + ОкрП000120000102;
			
			Форма.СтруктураДанныхФорма70101_001Страница2.Вставить("П000120000103", П000120000103);
			
			Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Форма70101_001Страница2" Тогда
				Форма.ТабличныйДокумент.Области.П000120000103.Значение = П000120000103;
			КонецЕсли;
			
		КонецЕсли;
		
		Если СтрЧислоВхождений(Форма.СтруктураЗависимыхЯчеекДляАвторасчета.П000120000203, Лев(ОбластьИмя,13)) > 0 Тогда
			
			Префикс = Сред(ОбластьИмя,Найти(ОбластьИмя,"_"),СтрДлина(ОбластьИмя) - (Найти(ОбластьИмя,"_")-1));
			Индекс = Число(Прав(Префикс,СтрДлина(Префикс)-1)) - 1;
			
			ОкрП000110000203 = 0;
			ОкрП000110000204 = 0;
			ОкрП000110000205 = 0;
			ОкрП000120000202 = 0;

			
			Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Форма70101_001Страница1" Тогда
				ОкрП000110000203 = РегламентированнаяОтчетностьКлиентСервер.ОкруглитьЧислоПоФормату(Форма, Форма.ТабличныйДокумент.Области["П000110000203"+Префикс].Значение);
			ИначеЕсли Форма.СтруктураДанныхФорма70101_001Страница1.Свойство("П000110000203" + Префикс) Тогда
				ОкрП000110000203 = РегламентированнаяОтчетностьКлиентСервер.ОкруглитьЧислоПоФормату(Форма, Форма.СтруктураДанныхФорма70101_001Страница1["П000110000203"+Префикс]);
			КонецЕсли;
			
			Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Форма70101_001Страница1" Тогда
				ОкрП000110000204 = РегламентированнаяОтчетностьКлиентСервер.ОкруглитьЧислоПоФормату(Форма, Форма.ТабличныйДокумент.Области["П000110000204"+Префикс].Значение);
			ИначеЕсли Форма.СтруктураДанныхФорма70101_001Страница1.Свойство("П000110000204" + Префикс) Тогда
				ОкрП000110000204 = РегламентированнаяОтчетностьКлиентСервер.ОкруглитьЧислоПоФормату(Форма, Форма.СтруктураДанныхФорма70101_001Страница1["П000110000204"+Префикс]);
			КонецЕсли;
			
			Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Форма70101_001Страница1" Тогда
				ОкрП000110000205 = РегламентированнаяОтчетностьКлиентСервер.ОкруглитьЧислоПоФормату(Форма, Форма.ТабличныйДокумент.Области["П000110000205"+Префикс].Значение);
			ИначеЕсли Форма.СтруктураДанныхФорма70101_001Страница1.Свойство("П000110000205" + Префикс) Тогда
				ОкрП000110000205 = РегламентированнаяОтчетностьКлиентСервер.ОкруглитьЧислоПоФормату(Форма, Форма.СтруктураДанныхФорма70101_001Страница1["П000110000205"+Префикс]);
			КонецЕсли;
			
			Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Форма70101_001Страница2" Тогда
				ОкрП000120000202 = РегламентированнаяОтчетностьКлиентСервер.ОкруглитьЧислоПоФормату(Форма, Форма.ТабличныйДокумент.Области["П000120000202"+Префикс].Значение);
			ИначеЕсли Форма.СтруктураДанныхФорма70101_001Страница2.Свойство("П000120000202" + Префикс) Тогда
				ОкрП000120000202 = РегламентированнаяОтчетностьКлиентСервер.ОкруглитьЧислоПоФормату(Форма, Форма.СтруктураДанныхФорма70101_001Страница2["П000120000202"+Префикс]);
			КонецЕсли;
			
			П000120000203 = ОкрП000110000203 + ОкрП000110000204 + ОкрП000110000205 + ОкрП000120000202;
			
			Форма.СтруктураДанныхФорма70101_001Страница2.Вставить("П000120000203" + Префикс, П000120000203);
			
			Форма.П0001200002[Индекс].П000120000203 = П000120000203;
			
			Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Форма70101_001Страница2" Тогда
				Форма.ТабличныйДокумент.Области["П000120000203"+Префикс].Значение = П000120000203;
			КонецЕсли;
			
		КонецЕсли;
		
		Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = ИмяСтраницыПанели Тогда
			
			СуммаП000120000102 = 0;
			СуммаП000120000103 = 0;
			
			Для Ном = 1 По Форма[Форма.мСтруктураМногострочныхРазделов[Форма.СтруктураРеквизитовФормы.мИдГруппы12]].Количество() Цикл
				
				СуммаП000120000102 = СуммаП000120000102 + РегламентированнаяОтчетностьКлиентСервер.ОкруглитьЧислоПоФормату(Форма, Форма.ТабличныйДокумент.Области["П000120000202_" + Ном].Значение);
				СуммаП000120000103 = СуммаП000120000103 + РегламентированнаяОтчетностьКлиентСервер.ОкруглитьЧислоПоФормату(Форма, Форма.ТабличныйДокумент.Области["П000120000203_" + Ном].Значение);
				
			КонецЦикла;
			
			Форма.ТабличныйДокумент.Области.П000120000102.Значение = СуммаП000120000102;
			Форма.ТабличныйДокумент.Области.П000120000103.Значение = СуммаП000120000103;
			
			
		Иначе
			
			СуммаП000120000102 = 0;
			СуммаП000120000103 = 0;
			
			Для Ном = 1 По Форма[Форма.мСтруктураМногострочныхРазделов[Форма.СтруктураРеквизитовФормы.мИдГруппы12]].Количество() Цикл
				
				СуммаП000120000102 = СуммаП000120000102 + РегламентированнаяОтчетностьКлиентСервер.ОкруглитьЧислоПоФормату(Форма, Форма[Форма.мСтруктураМногострочныхРазделов[Форма.СтруктураРеквизитовФормы.мИдГруппы12]][Ном - 1].П000120000202);
				СуммаП000120000103 = СуммаП000120000103 + РегламентированнаяОтчетностьКлиентСервер.ОкруглитьЧислоПоФормату(Форма, Форма[Форма.мСтруктураМногострочныхРазделов[Форма.СтруктураРеквизитовФормы.мИдГруппы12]][Ном - 1].П000120000203);
				
			КонецЦикла;
			
			Форма.СтруктураДанныхФорма70101_001Страница2.Вставить("П000120000102", СуммаП000120000102);
			Форма.СтруктураДанныхФорма70101_001Страница2.Вставить("П000120000103", СуммаП000120000103);
			
		КонецЕсли;	
		
	//Авторасчет
	ИначеЕсли ИмяСтраницыПанели = "" Тогда
		
		Расчет(Форма,"Форма70101Страница1", "");
		Расчет(Форма,"Форма70101Страница2", "");
		
		Расчет(Форма,"Форма70101_001Страница1", "");
		Расчет(Форма,"Форма70101_001Страница2", "");
		
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Выгрузить(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыгрузитьЗавершение", ЭтотОбъект);

	Отказ = Ложь;
	ОнлайнСервисыРегламентированнойОтчетностиКлиент.ПередВыгрузкойРегламентированногоОтчета(ОписаниеОповещения, ЭтотОбъект, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьЗавершение(Отказ, ДополнительныеПараметры) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ВыгрузитьОтчет();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьОтчет() Экспорт
		
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыгрузитьОтчетЗавершение", ЭтотОбъект);
	
	Если Модифицированность Тогда
		СохранитьНаКлиенте(,ОписаниеОповещения);
	Иначе
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьОтчетЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ФормаВыгрузкиРеглОтчета = ПолучитьФорму("Документ.ВыгрузкаРегламентированныхОтчетов.Форма.ФормаДокумента", , ЭтаФорма);
	
	СпДокОсн = Новый СписокЗначений;
	СпДокОсн.Добавить(СтруктураРеквизитовФормы.мСохраненныйДок);
	
	ФормаВыгрузкиРеглОтчета.СформироватьИЗаписать(СпДокОсн);
	
КонецПроцедуры

&НаКлиенте
Функция УниверсальнаяВыгрузка (ТекстВыгрузки = Неопределено, ПроверятьБлокировки = Истина, ИмяФайлаВыгрузки = "", ВыгружатьСОшибками = Ложь) Экспорт
	
	ИмяФайлаВыгрузки = СформироватьИмяФайла();
	
	СформироватьСписокФормБезИерархии();
	
	ТекстВыгрузки =  УниверсальнаяВыгрузкаНаСервере();
	
	Если ТекстВыгрузки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция СформироватьИмяФайла()
	
	Перем ПолученноеЗначение;
	
	ИмяФайлаXML = "Форма701.01_"+ Прав(Этаформа.ИмяФормы,7)+ "_" + СтрЗаменить(СтрЗаменить(Строка(ТекущаяДата())," ","_"),":","-") + ".xml";
	
	Возврат ИмяФайлаXML;
	
КонецФункции

&НаСервере
Процедура СформироватьСписокФормБезИерархии()
	
	мСписокФормБезИерархии.ПолучитьЭлементы().Очистить();
	
	МакетПоказателей = Отчеты[Сред(Лев(ЭтотОбъект.ИмяФормы, СтрНайти(ЭтотОбъект.ИмяФормы, ".Форма.") - 1), 7)].ПолучитьМакет("Показатели");
	
	Префикс = Прав(ЭтаФорма.СтруктураРеквизитовФормы.мВыбраннаяФорма,7);
	
	ОбластьПоказателей = МакетПоказателей.Область("Форма70101_" + Префикс);
	
	Для Ном = ОбластьПоказателей.Верх По ОбластьПоказателей.Низ Цикл
		
		НоваяСтрока = мСписокФормБезИерархии.ПолучитьЭлементы().Добавить();
		НоваяСтрока.ИмяФормы			= СокрП(МакетПоказателей.Область(Ном, 1).Текст);
		НоваяСтрока.Выгружать			= ?(СокрП(МакетПоказателей.Область(Ном, 2).Текст)= "1",Истина,Ложь);
		НоваяСтрока.Многострочность		= ?(СокрП(МакетПоказателей.Область(Ном, 3).Текст)= "1",Истина,Ложь);
		НоваяСтрока.КодФормы			= СокрП(МакетПоказателей.Область(Ном, 4).Текст);
		НоваяСтрока.КоличествоНаЛисте	= Число(СокрП(МакетПоказателей.Область(Ном, 5).Текст));
		НоваяСтрока.КоличествоСтраницПриложения = Число(СокрП(МакетПоказателей.Область(Ном, 6).Текст));
		
		Если НоваяСтрока.Многострочность <> Истина Тогда
			Для КолСтр = 1 По НоваяСтрока.КоличествоСтраницПриложения  Цикл
				Для Каждого Элемент Из ЭтаФорма["СтруктураДанных"+ НоваяСтрока.КодФормы + "Страница" + КолСтр] Цикл
					НовыйЭлемент = НоваяСтрока.Значение.Добавить();
					НовыйЭлемент.ИмяОбласти = Элемент.Ключ;
					НовыйЭлемент.Значение = Элемент.Значение;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция  УниверсальнаяВыгрузкаНаСервере()
	Возврат РегламентированнаяОтчетностьРК.ВыгрузитьОтчетВXMLДляСОНО(ЭтотОбъект);
КонецФункции

&НаКлиенте
Процедура РасшифровкаПоЗемельномуНалогу(Команда)
	
	Если СтруктураРеквизитовФормы.ВидРасчета = "Дополнительный" Тогда
		Если Месяц(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета) = 1 Тогда
			ДатаНачала = СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета;
			// второй квартал
		ИначеЕсли Месяц(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета) = 4 Тогда
			ДатаНачала = Дата(СтруктураРеквизитовФормы.мГод,2,1);
			// третий квартал
		ИначеЕсли Месяц(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета) = 7 Тогда
			ДатаНачала = Дата(СтруктураРеквизитовФормы.мГод,5,1);
			// четвертый квартал
		ИначеЕсли Месяц(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета) = 10 Тогда
			ДатаНачала = Дата(СтруктураРеквизитовФормы.мГод,8,1);
		КонецЕсли;
		
		ДатаОкончания = КонецМесяца(Дата(СтруктураРеквизитовФормы.мГод,Месяц(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета),1));
		
		ПользовательскиеНастройки = Новый ПользовательскиеНастройкиКомпоновкиДанных;
		
		ЕстьОтбор = ПользовательскиеНастройки.Элементы.Найти("Отбор") <> Неопределено;
		ЗаполняемыеНастройки = Новый Структура("Показатели, Группировка, Отбор, ВыводимыеДанные", Ложь, Ложь, ЕстьОтбор, Ложь);
		
		ДополнительныеСвойства = ПользовательскиеНастройки.ДополнительныеСвойства;
		ДополнительныеСвойства.Вставить("РежимРасшифровки",  Истина);
		ДополнительныеСвойства.Вставить("Организация",       СтруктураРеквизитовФормы.Организация);
		ДополнительныеСвойства.Вставить("НачалоПериода",     ДатаНачала);
		ДополнительныеСвойства.Вставить("КонецПериода",      ДатаОкончания);
		ДополнительныеСвойства.Вставить("ВыводитьЗаголовок", Истина);
		ДополнительныеСвойства.Вставить("КлючВарианта",     "РасчетЗемельногоНалога");
		
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("ВидРасшифровки", 2);
		ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
		ПараметрыФормы.Вставить("ИДРасшифровки", "РасчетЗемельногоНалога");
		ПараметрыФормы.Вставить("ЗаполняемыеНастройки", ЗаполняемыеНастройки);
		ПараметрыФормы.Вставить("ПользовательскиеНастройки", ПользовательскиеНастройки);
		
		ОткрытьФорму("Отчет.СправкаРасчетЗемельногоНалога.Форма.ФормаОтчета", ПараметрыФормы,, Новый УникальныйИдентификатор);
		
	ИначеЕсли СтруктураРеквизитовФормы.ВидРасчета = "Очередной" Тогда
		//Даты   
		ДатаНачала 		= СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета;
		ДатаОкончания	= СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета;
		Период = Новый СтандартныйПериод;
		Период.ДатаНачала = ДатаНачала;
		Период.ДатаОкончания = ДатаОкончания;
		
		ПользовательскиеНастройки = Новый ПользовательскиеНастройкиКомпоновкиДанных;
		
		// Группировки	
		МассивГруппировок = Новый Массив();
		МассивГруппировок.Добавить(Новый Структура("Использование, Поле, Представление, ТипГруппировки", Истина, "ИФНС", НСтр("ru = 'Налоговый орган'"), "Без групп"));	

		ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("Группировка",  МассивГруппировок);
		
		
		//Выбранные поля
		ПользовательскиеПоля = ПользовательскиеНастройки.Элементы.Добавить(Тип("ВыбранныеПоляКомпоновкиДанных"));	
		ПользовательскиеПоля.ИдентификаторПользовательскойНастройки = "Выбор";	
		
		БухгалтерскиеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ПользовательскиеПоля, "ОсновноеСредство", 										"Объект");
		БухгалтерскиеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ПользовательскиеПоля, "КадастровыйНомер",    										"Кадастровый номер земельного участка");
		БухгалтерскиеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ПользовательскиеПоля, "Период",    												"Дата регистрации");
		БухгалтерскиеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ПользовательскиеПоля, "КодКатегорииЗемель", 										"Категория земель");
		БухгалтерскиеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ПользовательскиеПоля, "КБК", 														"КБК");
		БухгалтерскиеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ПользовательскиеПоля, "ДоляНалогоплательщика", 									"Доля налогоплательщика в праве на земельный участок");
		БухгалтерскиеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ПользовательскиеПоля, "ПлощадьНеОблагаемая", 										"Не облагаемая площадь земельного участка (га, кв.м.)");
		БухгалтерскиеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ПользовательскиеПоля, "ПлощадьОблагаемая",     									"Облагаемая площадь земельного участка (га. кв.м.)");
		БухгалтерскиеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ПользовательскиеПоля, "НалоговаяБаза", 											"Налоговая база");
		БухгалтерскиеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ПользовательскиеПоля, "НалоговаяСтавка", 											"Ставка налога");
		БухгалтерскиеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ПользовательскиеПоля, "КорректировкаБазовойСтавкиНалога", 						"Корректировка базовой ставки налога");
		БухгалтерскиеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ПользовательскиеПоля, "КорректировкаБазовойСтавкиНалогаНаТерриторияхСЭЗ", 		"Корректировка базовой ставки налога на территориях СЭЗ");
		БухгалтерскиеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ПользовательскиеПоля, "КорректировкаБазовойСтавкиНалогаПоРешениюМестныхОрганов", 	"Корректировка базовой ставки налога по решению местных органов");
		БухгалтерскиеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ПользовательскиеПоля, "ПроцентИзмененияБазовойСтавкиНалога", 						"Процент изменения базовой ставки налога");
		БухгалтерскиеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ПользовательскиеПоля, "СуммаНалога", 												"Исчисленная сумма налога, подлежащая уплате в бюджет (тенге)");
		
		
		// Прочие настройки
		ТекстЗаголовка = НСтр("ru = 'Расшифровка к форме 701.01 - Расчет земельного налога'");	
		ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("Заголовок", 	ТекстЗаголовка);
		
		
		
		
		
		//Параметры
		МассивПараметровДанных = Новый Массив(); 
		
		ДатаОтчета = СоздатьГраницу(НачалоГода(ДатаНачала)); 
		
		СписокОрганизаций = СформироватьСписокОрганизаций(СтруктураРеквизитовФормы.Организация, СтруктураРеквизитовФормы.НалоговыйКомитет, ДатаОкончания);
		
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьПараметр(МассивПараметровДанных, "ДатаОтчета",    			ДатаОтчета);
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьПараметр(МассивПараметровДанных, "НалоговыйОрганОсновной", 	ПолучитьНалоговыйКомитетОрганизации(СтруктураРеквизитовФормы.Организация));
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьПараметр(МассивПараметровДанных, "НалоговыйОрганОтчета",   	СтруктураРеквизитовФормы.НалоговыйКомитет);
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьПараметр(МассивПараметровДанных, "СписокОрганизаций",	 	СписокОрганизаций);
		
		ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("ПараметрыДанных", МассивПараметровДанных);
		
		
		
		ДополнительныеСвойства = ПользовательскиеНастройки.ДополнительныеСвойства;
		ДополнительныеСвойства.Вставить("Организация",      	СтруктураРеквизитовФормы.Организация);
		ДополнительныеСвойства.Вставить("НачалоПериода",    	ДатаНачала);
		ДополнительныеСвойства.Вставить("КонецПериода",     	ДатаОкончания);
		ДополнительныеСвойства.Вставить("Период",				Период);
		ДополнительныеСвойства.Вставить("ВыводитьЗаголовок",	Истина);
		ДополнительныеСвойства.Вставить("ТипДанных",			"РегистрыСведений");
		ДополнительныеСвойства.Вставить("ИмяОбъекта",			"РасчетЗемельногоНалога");
		
		
		
		СхемаКомпоновки = ПодменитьТекстЗапросаСхемыКомпоновкиДанных(,"РасчетЗемельногоНалога", "Расшифровка");
		ДополнительныеСвойства.Вставить("СхемаКомпоновкиДанных", СхемаКомпоновки);
		
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("ВидРасшифровки", 2);
		ПараметрыФормы.Вставить("РежимРасшифровки", Истина);
		ПараметрыФормы.Вставить("ПользовательскиеНастройки", ПользовательскиеНастройки);
		ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
		ПараметрыФормы.Вставить("ИДРасшифровки", "РасчетЗемельногоНалога");
		
		
		ОткрытьФорму("Отчет.РасшифровкаРегламентированныхОтчетов.Форма.ФормаОтчета", ПараметрыФормы,, Истина);
	
	КонецЕсли;	
	
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПоНалогуНаИмущество(Команда)
	
	Если СтруктураРеквизитовФормы.ВидРасчета = "Дополнительный" Тогда
		Если Месяц(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета) = 1 Тогда
			ДатаНачала = СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета;
			// второй квартал
		ИначеЕсли Месяц(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета) = 4 Тогда
			ДатаНачала = Дата(СтруктураРеквизитовФормы.мГод,2,1);
			// третий квартал
		ИначеЕсли Месяц(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета) = 7 Тогда
			ДатаНачала = Дата(СтруктураРеквизитовФормы.мГод,5,1);
			// четвертый квартал
		ИначеЕсли Месяц(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета) = 10 Тогда
			ДатаНачала = Дата(СтруктураРеквизитовФормы.мГод,8,1);
		КонецЕсли;
		
		ДатаОкончания = КонецМесяца(Дата(СтруктураРеквизитовФормы.мГод,Месяц(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета),1));
		
		ПользовательскиеНастройки = Новый ПользовательскиеНастройкиКомпоновкиДанных;
		
		ЕстьОтбор = ПользовательскиеНастройки.Элементы.Найти("Отбор") <> Неопределено;
		ЗаполняемыеНастройки = Новый Структура("Показатели, Группировка, Отбор, ВыводимыеДанные", Ложь, Ложь, ЕстьОтбор, Ложь);
		
		ДополнительныеСвойства = ПользовательскиеНастройки.ДополнительныеСвойства;
		ДополнительныеСвойства.Вставить("РежимРасшифровки",  Истина);
		ДополнительныеСвойства.Вставить("Организация",       СтруктураРеквизитовФормы.Организация);
		ДополнительныеСвойства.Вставить("НачалоПериода",     ДатаНачала);
		ДополнительныеСвойства.Вставить("КонецПериода",      ДатаОкончания);
		ДополнительныеСвойства.Вставить("ВыводитьЗаголовок", Истина);
		ДополнительныеСвойства.Вставить("КлючВарианта",     "РасчетНалогаНаИмущество");
		
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("ВидРасшифровки", 2);
		ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
		ПараметрыФормы.Вставить("ИДРасшифровки", "РасчетНалогаНаИмущество");
		ПараметрыФормы.Вставить("ЗаполняемыеНастройки", ЗаполняемыеНастройки);
		ПараметрыФормы.Вставить("ПользовательскиеНастройки", ПользовательскиеНастройки);
		
		ОткрытьФорму("Отчет.СправкаРасчетНалогаНаИмущество.Форма.ФормаОтчета", ПараметрыФормы,, Новый УникальныйИдентификатор);
		
	ИначеЕсли СтруктураРеквизитовФормы.ВидРасчета = "Очередной" Тогда
		
		//Даты   
		ДатаНачала 		= СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета;
		ДатаОкончания	= СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета;
		Период = Новый СтандартныйПериод;
		Период.ДатаНачала = ДатаНачала;
		Период.ДатаОкончания = ДатаОкончания;
		
		ПользовательскиеНастройки = Новый ПользовательскиеНастройкиКомпоновкиДанных;
		
		// Группировки	
		МассивГруппировок = Новый Массив();
		МассивГруппировок.Добавить(Новый Структура("Использование, Поле, Представление, ТипГруппировки", Истина, "ИФНС", НСтр("ru = 'Вид налоговой базы'"), "Без групп"));	
		
		ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("Группировка",  МассивГруппировок);
		
			
		//Выбранные поля
		ПользовательскиеПоля = ПользовательскиеНастройки.Элементы.Добавить(Тип("ВыбранныеПоляКомпоновкиДанных"));	
		ПользовательскиеПоля.ИдентификаторПользовательскойНастройки = "Выбор";	
		
		БухгалтерскиеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ПользовательскиеПоля, "ОсновноеСредствоИмущество",								"Налоговый орган, Объект");
		БухгалтерскиеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ПользовательскиеПоля, "ИнвентарныйНомер", 										"Инвентарный номер");
		БухгалтерскиеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ПользовательскиеПоля, "ДатаСостояния",    										"Дата ввода в эксплуатацию");
		БухгалтерскиеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ПользовательскиеПоля, "ДоляСтоимости",		 									"Доля стоимости");
		БухгалтерскиеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ПользовательскиеПоля, "НалоговаяБаза", 											"Налоговая база");
		БухгалтерскиеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ПользовательскиеПоля, "НалоговаяСтавка", 											"Ставка налога");
		БухгалтерскиеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ПользовательскиеПоля, "ОбщаяСумма",     											"Исчисленная сумма налога, подлежащая уплате в бюджет (тенге)");
		
		// Прочие настройки
		ТекстЗаголовка = НСтр("ru = 'Расшифровка к форме 701.01 - Расчет налога на имущество'");	
		ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("Заголовок", 	ТекстЗаголовка);
		
		
		
		
		
		//Параметры
		МассивПараметровДанных = Новый Массив(); 
		
		ГраницаНачалоПериода = СоздатьГраницу(НачалоГода(ДатаНачала)); 
		СписокОрганизаций = СформироватьСписокОрганизаций(СтруктураРеквизитовФормы.Организация, СтруктураРеквизитовФормы.НалоговыйКомитет, ДатаОкончания);
		
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьПараметр(МассивПараметровДанных, "ОсновнойНалоговыйОрган", 		ПолучитьНалоговыйКомитетОрганизации(СтруктураРеквизитовФормы.Организация));
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьПараметр(МассивПараметровДанных, "НалоговыйКомитет",   			СтруктураРеквизитовФормы.НалоговыйКомитет);
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьПараметр(МассивПараметровДанных, "СписокОрганизаций",	  		СписокОрганизаций);
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьПараметр(МассивПараметровДанных, "ГраницаНачалоПериодаОтчета",	ГраницаНачалоПериода);
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьПараметр(МассивПараметровДанных, "НачалоГода",					НачалоГода(Период.ДатаНачала));
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьПараметр(МассивПараметровДанных, "ДатаОкончания",				Период.ДатаОкончания);



		
		ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("ПараметрыДанных", МассивПараметровДанных);
		
		
		
		ДополнительныеСвойства = ПользовательскиеНастройки.ДополнительныеСвойства;
		ДополнительныеСвойства.Вставить("Организация",      	СтруктураРеквизитовФормы.Организация);
		ДополнительныеСвойства.Вставить("НачалоПериода",    	ДатаНачала);
		ДополнительныеСвойства.Вставить("КонецПериода",     	ДатаОкончания);
		ДополнительныеСвойства.Вставить("Период",				Период);
		ДополнительныеСвойства.Вставить("ВыводитьЗаголовок",	Истина);
		ДополнительныеСвойства.Вставить("ТипДанных",			"РегистрыСведений");
		ДополнительныеСвойства.Вставить("ИмяОбъекта",			"РасчетНалогаНаИмущество");
	
		
		СхемаКомпоновки = ПодменитьТекстЗапросаСхемыКомпоновкиДанных(,"РасчетНалогаНаИмущество", "Расшифровка");
		ДополнительныеСвойства.Вставить("СхемаКомпоновкиДанных", СхемаКомпоновки);

		
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("ВидРасшифровки", 2);
		ПараметрыФормы.Вставить("РежимРасшифровки", Истина);
		ПараметрыФормы.Вставить("ПользовательскиеНастройки", ПользовательскиеНастройки);
		ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
		ПараметрыФормы.Вставить("ИДРасшифровки", "РасчетЗемельногоНалога");
		
		
		ОткрытьФорму("Отчет.РасшифровкаРегламентированныхОтчетов.Форма.ФормаОтчета", ПараметрыФормы,, Истина);
	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьТекущуюСтраницу(Команда)
	
	РегламентированнаяОтчетностьКлиент.МеханизмыОчисткиРегламентированныхОтчетов(ЭтаФорма, "ОчиститьТекущийЭкземплярМногостраничногоРаздела" + Элементы.РазделыОтчета.ТекущиеДанные.КолонкаРазделыОтчетаСокрНаим);
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьТекущийРаздел(Команда)
	
	//РегламентированнаяОтчетностьКлиент.МеханизмыОчисткиРегламентированныхОтчетов(ЭтаФорма, "ОчиститьТекущийРаздел" + Элементы.РазделыОтчета.ТекущиеДанные.КолонкаРазделыОтчетаСокрНаим);
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьОтчет(Команда)
	
	РегламентированнаяОтчетностьКлиент.МеханизмыОчисткиРегламентированныхОтчетов(ЭтаФорма, "ОчиститьВесьОтчет");
	
КонецПроцедуры

&НаКлиенте
Процедура Очистить(ВыполняемоеОповещение = Неопределено) Экспорт
	
	РегламентированнаяОтчетностьКлиент.Очистить(ЭтаФорма, ВыполняемоеОповещение);
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьНаСервере() Экспорт
	
	СтруктураДанныхФорма70101Страница1.Очистить();
	СтруктураДанныхФорма70101Страница2.Очистить();
	
	СтруктураДанныхФорма70101_001Страница1.Очистить();
	СтруктураДанныхФорма70101_001Страница2.Очистить();
		
	ЗаполнитьПустыеСтруктурыДанных();
	
	ОчиститьТабличноеПолеНаСервере(СтруктураРеквизитовФормы.НаимТекущегоРаздела);
	
	ВывестиМакетСтраницыВТабличныйДокументНаСервере("Форма70101Страница1", 1);
	
	НачальныеОперацииСМногострочнымиБлоками();
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ОчисткаРегламентированногоОтчетаНаСервере(ИмяСтраницы, ЗапускатьОтдельнуюОбработкуПослеОчисткиЛиста, РежимОчистки, Многостраничность, КолВоСтраницВРазделе) Экспорт
	
	УдалятьсяВсеДопЭкземпляры = Ложь;
	
	Если СтрНайти(РежимОчистки, "ОчиститьТекущийЭкземплярМногостраничногоРаздела") > 0 Тогда
		
		ОчиститьТабличноеПолеНаСервере(ИмяСтраницы);
		
		РегламентированнаяОтчетностьКлиентСервер.ПослеОчисткиРегламентированногоОтчета(ЭтаФорма, ИмяСтраницы, ЗапускатьОтдельнуюОбработкуПослеОчисткиЛиста);
		
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ОчисткаРегламентированногоОтчетаНаКлиенте(ИмяСтраницы, ЗапускатьОтдельнуюОбработкуПослеОчисткиЛиста, РежимОчистки, Многостраничность, КолВоСтраницВРазделе) Экспорт
	
	УдалятьсяВсеДопЭкземпляры = Ложь;
	
	Если СтрНайти(РежимОчистки, "ОчиститьТекущийЭкземплярМногостраничногоРаздела") > 0 Тогда
		
		ОчиститьТабличноеПолеНаКлиенте(ИмяСтраницы);
		
		РегламентированнаяОтчетностьКлиентСервер.ПослеОчисткиРегламентированногоОтчета(ЭтаФорма, ИмяСтраницы, ЗапускатьОтдельнуюОбработкуПослеОчисткиЛиста);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастроек(Команда)
	ОткрытьФормуВыбораСтраниц("ВыбратьДляНастройки");
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыбораСтраниц(ВариантВыбора)
	Перем ТекущийРазделОтчетаСокрНаим;
	Перем НомерСтраницыРазделаОтчета;
	
	// Запоминаем текущий раздел, установленный в дереве разделов отчета.
	Если НЕ Элементы.РазделыОтчета.ТекущиеДанные = Неопределено Тогда
		ТекущийРазделОтчетаСокрНаим = Элементы.РазделыОтчета.ТекущиеДанные.КолонкаРазделыОтчетаСокрНаим;
		НомерСтраницыРазделаОтчета  = Элементы.РазделыОтчета.ТекущиеДанные.КолонкаНомерСтраницыРазделаОтчета;
	КонецЕсли;
	
	мПараметры = Новый Структура;
	мПараметры.Вставить("Автосохранение", Ложь);
	мПараметры.Вставить("мАвтоВыборКодов", Ложь);
	мПараметры.Вставить("ЗначенияИзСписка", Ложь);
	мПараметры.Вставить("ОтключитьАвтоРасчет", Ложь);
	мПараметры.Вставить("СчетчикСтраниц", Ложь);
	мПараметры.Вставить("ПараметрыОтображенияСумм", Ложь);
	мПараметры.Вставить("ИмеетсяРеквизитДеревоВыбранныхСтраниц", Истина);
	мПараметры.Вставить("ИмяОтчета", ИмяОтчета(ЭтаФорма.ИмяФормы));
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("мПараметры",                              мПараметры);
	
	ФормаНастройкиОтчета = РегламентированнаяОтчетностьКлиент.ПолучитьОбщуюФормуПоИмени("НастройкиОтчета", ПараметрыФормы, ЭтаФорма);
	
	ПодготовитьДеревоСтраницДляНастройки();
	
	КопироватьДанныеФормы(мДеревоВыбранныхСтраниц, ФормаНастройкиОтчета.Дерево);
	
	мДеревоВыбранныхСтраниц.ПолучитьЭлементы().Очистить();
	
	ЗначениеЕдИзм       = СтруктураРеквизитовФормы.ЕдиницаИзмерения;
	ЗначениеЗпт         = СтруктураРеквизитовФормы.ТочностьЕдиницыИзмерения;
	
	ДополнительныеПараметры = Новый Структура("ЗначениеАвторасчета, ЗначениеЕдИзм, ЗначениеЗпт, НомерСтраницыРазделаОтчета, ТекущийРазделОтчетаСокрНаим", , ЗначениеЕдИзм, ЗначениеЗпт, НомерСтраницыРазделаОтчета, ТекущийРазделОтчетаСокрНаим);
	ОписаниеОповещения = Новый ОписаниеОповещения("ОткрытьФормуВыбораСтраницЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ФормаНастройкиОтчета.ОписаниеОповещенияОЗакрытии = ОписаниеОповещения;
	ФормаНастройкиОтчета.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
	ФормаНастройкиОтчета.Открыть();
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьДеревоСтраницДляНастройки()
	
	мДеревоВыбранныхСтраниц.ПолучитьЭлементы().Очистить();
	ДеревоСтраниц = РеквизитФормыВЗначение("мДеревоСтраницОтчета");
	
	СтрокаУровня1 = мДеревоВыбранныхСтраниц.ПолучитьЭлементы().Добавить();
	СтрокаУровня1.ИмяСтраницы              = "Форма70101Страница1";
	СтрокаУровня1.Представление            = "Форма 701.01";
	СтрокаУровня1.ОриентацияСтраницы       = "Портрет";
	
	Строка = ДеревоСтраниц.Строки.Найти("Форма70101Страница1","ИмяСтраницы");
	СтрокаУровня1.ВыводНаПечать            = ?(Строка <> Неопределено,Строка.ВыводНаПечать,1);
	СтрокаУровня1.ПоказатьСтраницу         = ?(Строка <> Неопределено,Строка.ПоказатьСтраницу,1);
	СтрокаУровня1.ВыгрузитьСтраницу        = ?(Строка <> Неопределено,Строка.ВыгрузитьСтраницу,1);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыбораСтраницЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	//ЗначениеАвторасчета = ДополнительныеПараметры.ЗначениеАвторасчета;
	ЗначениеЕдИзм = ДополнительныеПараметры.ЗначениеЕдИзм;
	ЗначениеЗпт = ДополнительныеПараметры.ЗначениеЗпт;
	НомерСтраницыРазделаОтчета = ДополнительныеПараметры.НомерСтраницыРазделаОтчета;
	ТекущийРазделОтчетаСокрНаим = ДополнительныеПараметры.ТекущийРазделОтчетаСокрНаим;
	
	//СформироватьПодменюПечать(ЭтаФорма);
	Модифицированность = Истина;
	
	флЗначенияИдентичны = Истина;
	
	флЗначенияИдентичны = ПеренестиДанныеДереваСтраниц();
	
	Если НЕ флЗначенияИдентичны Тогда
		
		СформироватьДеревоРазделовОтчетаНаКлиенте();
		
		Если НЕ ТекущийРазделОтчетаСокрНаим = Неопределено Тогда
			
			// Пытаемся найти ранее запомненный раздел.
			НайденнаяСтрока = РегламентированнаяОтчетностьКлиентСервер.НайтиЭлементВДанныхФормыДерево(РазделыОтчета.ПолучитьЭлементы(), "КолонкаРазделыОтчетаСокрНаим", ТекущийРазделОтчетаСокрНаим);
			
			Если НЕ НайденнаяСтрока = Неопределено 
				И НЕ НомерСтраницыРазделаОтчета = Неопределено 
				И НайденнаяСтрока.ПолучитьЭлементы().Количество() > 0 Тогда
				
				НайденнаяСтрока = РегламентированнаяОтчетностьКлиентСервер.НайтиЭлементВДанныхФормыДерево(НайденнаяСтрока.ПолучитьЭлементы(), "КолонкаНомерСтраницыРазделаОтчета", НомерСтраницыРазделаОтчета);
				
			КонецЕсли;
			
			// В случае успешного поиска, устанавливаем курсор на найденный раздел.
			Если НЕ НайденнаяСтрока = Неопределено Тогда
				Элементы.РазделыОтчета.ТекущаяСтрока = НайденнаяСтрока.ПолучитьИдентификатор();
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПеренестиДанныеДереваСтраниц()
	
	флЗначенияИдентичны = Истина;
	
	ДеревоВыбСтраниц = РеквизитФормыВЗначение("мДеревоВыбранныхСтраниц");
	
	Для Каждого ЭлементДерева Из мДеревоСтраницОтчета.ПолучитьЭлементы() Цикл
		
		Строка = ДеревоВыбСтраниц.Строки.Найти(Лев(ЭлементДерева.Представление,12),"Представление");
		
		Если ЭлементДерева.ПоказатьСтраницу <> ?(Строка <> Неопределено,Строка.ПоказатьСтраницу,1) Тогда
			
			флЗначенияИдентичны = Ложь;
			
		КонецЕсли;
		
		ЭлементДерева.ВыводНаПечать            = ?(Строка <> Неопределено,Строка.ВыводНаПечать,1);
		ЭлементДерева.ПоказатьСтраницу         = ?(Строка <> Неопределено,Строка.ПоказатьСтраницу,1);
		ЭлементДерева.ВыгрузитьСтраницу        = ?(Строка <> Неопределено,Строка.ВыгрузитьСтраницу,1);
		
	КонецЦикла;
	
	Возврат флЗначенияИдентичны;
	
КонецФункции


