&НаСервере
Функция СформироватьСписокОрганизаций(Организация, НалоговыйКомитет, ДатаОкончания) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НалоговыйКомитет", НалоговыйКомитет);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	
	Запрос.Текст = "
	|ВЫБРАТЬ
    |	СтавкиНалогаНаИмущество.Организация
    |ИЗ
    |	РегистрСведений.СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам.СрезПоследних(&ДатаОкончания, ) КАК СтавкиНалогаНаИмущество
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО СтавкиНалогаНаИмущество.Организация = Организации.Ссылка
    |ГДЕ
    |	СтавкиНалогаНаИмущество.НалоговыйОрган = &НалоговыйКомитет
	|	И (СтавкиНалогаНаИмущество.Организация = &Организация
	|	ИЛИ Организации.ГоловнаяОрганизация = &Организация)
	|";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	СписокОрганизаций = Новый Массив;
	Если Не РезультатЗапроса.Пустой() Тогда
		СписокОрганизаций = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Организация");
	КонецЕсли;
	СписокОрганизаций.Добавить(Организация);
	
	Возврат СписокОрганизаций;
	
КонецФункции	

Функция ОпределитьЗначениеПараметра(ЗначениеПараметра, ИмяАтрибута = Неопределено, НомерСтроки = Ложь,ВыгружатьНулевыеЗначения = Ложь)
	
	//МассивОпций = Новый Массив;
	//МассивОпций.Добавить("Пропорциональный");
	//МассивОпций.Добавить("Раздельный");
	//МассивОпций.Добавить("ПропорцИРаздел");
	//МассивОпций.Добавить("Дополнительная");
	//МассивОпций.Добавить("Ликвидационная");
	//МассивОпций.Добавить("Первоначальная");
	//МассивОпций.Добавить("ПоУведомлению");
	//МассивОпций.Добавить("Очередная");
	//МассивОпций.Добавить("Условие_B");
	//МассивОпций.Добавить("Условие_A");
	//МассивОпций.Добавить("ОтказОтВозврата");
	//
	//Если Не МассивОпций.Найти(ИмяАтрибута) = Неопределено Тогда
	//	Значение = ?(ЗначениеПараметра = "Х", Истина, Ложь);
	//Иначе 
	Значение = ?(Не ЗначениеЗаполнено(ЗначениеПараметра) И НЕ ВыгружатьНулевыеЗначения, "", ЗначениеПараметра);
	//КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Если Значение = Дата("00010101000000") Тогда 
			Значение = "";
		Иначе 
			Значение = Формат(Значение, "ДЛФ=Д");
		КонецЕсли;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Булево") Тогда 
		Значение = ?(Значение, "true", "");
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Тогда 
		Значение = Окр(Значение, 2);
		
		Если НомерСтроки Тогда
			Значение = Строка(Значение);
			ДлиннаНомера = СтрДлина(Значение);
			
			Для Счетчик = ДлиннаНомера По 5 Цикл 
				Значение = "0" + Значение;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат XMLСтрока(Значение);
	
КонецФункции

