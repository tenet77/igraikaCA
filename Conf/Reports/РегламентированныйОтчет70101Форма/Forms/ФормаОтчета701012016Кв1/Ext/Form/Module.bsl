			Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Форма70101Страница2" Тогда
				ОкрП000210410102 = РегламентированнаяОтчетностьКлиентСервер.ОкруглитьЧислоПоФормату(Форма, Форма.ТабличныйДокумент.Области.П000210410102.Значение);
			ИначеЕсли Форма.СтруктураДанныхФорма70101Страница2.Свойство("П000210410102") Тогда
				ОкрП000210410102 = РегламентированнаяОтчетностьКлиентСервер.ОкруглитьЧислоПоФормату(Форма, Форма.СтруктураДанныхФорма70101Страница2.П000210410102);
			КонецЕсли;
			
			Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Форма70101Страница2" Тогда
				ОкрП000210410103 = РегламентированнаяОтчетностьКлиентСервер.ОкруглитьЧислоПоФормату(Форма, Форма.ТабличныйДокумент.Области.П000210410103.Значение);
			ИначеЕсли Форма.СтруктураДанныхФорма70101Страница2.Свойство("П000210410103") Тогда
				ОкрП000210410103 = РегламентированнаяОтчетностьКлиентСервер.ОкруглитьЧислоПоФормату(Форма, Форма.СтруктураДанныхФорма70101Страница2.П000210410103);
			КонецЕсли;
			
			Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Форма70101Страница2" Тогда
				ОкрП000210410104 = РегламентированнаяОтчетностьКлиентСервер.ОкруглитьЧислоПоФормату(Форма, Форма.ТабличныйДокумент.Области.П000210410104.Значение);
