&НаКлиенте
Процедура РасшифровкаПоЗемельномуНалогу(Команда)
	
	Если СтруктураРеквизитовФормы.ВидРасчета = "Дополнительный" Тогда
		Если Месяц(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета) = 1 Тогда
			ДатаНачала = СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета;
			// второй квартал
		ИначеЕсли Месяц(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета) = 4 Тогда
			ДатаНачала = Дата(СтруктураРеквизитовФормы.мГод,2,1);
			// третий квартал
		ИначеЕсли Месяц(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета) = 7 Тогда
			ДатаНачала = Дата(СтруктураРеквизитовФормы.мГод,5,1);
			// четвертый квартал
		ИначеЕсли Месяц(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета) = 10 Тогда
			ДатаНачала = Дата(СтруктураРеквизитовФормы.мГод,8,1);
		КонецЕсли;
		
		ДатаОкончания = КонецМесяца(Дата(СтруктураРеквизитовФормы.мГод,Месяц(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета),1));
		
		ПользовательскиеНастройки = Новый ПользовательскиеНастройкиКомпоновкиДанных;
		
		ЕстьОтбор = ПользовательскиеНастройки.Элементы.Найти("Отбор") <> Неопределено;
		ЗаполняемыеНастройки = Новый Структура("Показатели, Группировка, Отбор, ВыводимыеДанные", Ложь, Ложь, ЕстьОтбор, Ложь);
		
		ДополнительныеСвойства = ПользовательскиеНастройки.ДополнительныеСвойства;
		ДополнительныеСвойства.Вставить("РежимРасшифровки",  Истина);
		ДополнительныеСвойства.Вставить("Организация",       СтруктураРеквизитовФормы.Организация);
		ДополнительныеСвойства.Вставить("НачалоПериода",     ДатаНачала);
		ДополнительныеСвойства.Вставить("КонецПериода",      ДатаОкончания);
		ДополнительныеСвойства.Вставить("ВыводитьЗаголовок", Истина);
		ДополнительныеСвойства.Вставить("КлючВарианта",     "РасчетЗемельногоНалога");
		
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("ВидРасшифровки", 2);
		ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
		ПараметрыФормы.Вставить("ИДРасшифровки", "РасчетЗемельногоНалога");
		ПараметрыФормы.Вставить("ЗаполняемыеНастройки", ЗаполняемыеНастройки);
		ПараметрыФормы.Вставить("ПользовательскиеНастройки", ПользовательскиеНастройки);
		
		ОткрытьФорму("Отчет.СправкаРасчетЗемельногоНалога.Форма.ФормаОтчета", ПараметрыФормы,, Новый УникальныйИдентификатор);
		
	КонецЕсли;
	
КонецПроцедуры

