КонецФункции

Функция СформироватьТекстЗапроса (НаборДанных) Экспорт
	
	Если НаборДанных = "РасчетЗемельногоНалога" Тогда
		ТекстЗапроса = "ВЫБРАТЬ
		|	РегистрацияЗемельныхУчастковСрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
		|	РегистрацияЗемельныхУчастковСрезПоследних.КБК,
		|	РегистрацияЗемельныхУчастковСрезПоследних.ДоляВПравеОбщейСобственностиЧислитель,
		|	РегистрацияЗемельныхУчастковСрезПоследних.ДоляВПравеОбщейСобственностиЗнаменатель,
		|	РегистрацияЗемельныхУчастковСрезПоследних.ПлощадьОблагаемая,
		|	РегистрацияЗемельныхУчастковСрезПоследних.НалоговаяСтавка,
		|	РегистрацияЗемельныхУчастковСрезПоследних.ПроцентИзмененияБазовойСтавкиНалога,
		|	РегистрацияЗемельныхУчастковСрезПоследних.КорректировкаБазовойСтавкиНалога,
		|	РегистрацияЗемельныхУчастковСрезПоследних.КорректировкаБазовойСтавкиНалогаНаТерриторияхСЭЗ,
		|	РегистрацияЗемельныхУчастковСрезПоследних.КорректировкаБазовойСтавкиНалогаПоРешениюМестныхОрганов,
		|	ВЫБОР
		|		КОГДА РегистрацияЗемельныхУчастковСрезПоследних.ПостановкаНаУчетВНалоговомОргане = ЗНАЧЕНИЕ(Перечисление.ПостановкаНаУчетВНалоговомОргане.ПоМестуНахожденияОрганизации)
		|			ТОГДА &НалоговыйОрганОсновной
		|		ИНАЧЕ РегистрацияЗемельныхУчастковСрезПоследних.НалоговыйОрган
		|	КОНЕЦ КАК НалоговыйОрган,
		|	РегистрацияЗемельныхУчастковСрезПоследних.КадастровыйНомер,
		|	РегистрацияЗемельныхУчастковСрезПоследних.КодКатегорииЗемель,
		|	РегистрацияЗемельныхУчастковСрезПоследних.ПлощадьНеОблагаемая,
		|	РегистрацияЗемельныхУчастковСрезПоследних.Период,
		|	РегистрацияЗемельныхУчастковСрезПоследних.Организация
		|ПОМЕСТИТЬ ВТ_ЗемельныеУчастки
		|ИЗ
		|	РегистрСведений.РегистрацияЗемельныхУчастков.СрезПоследних(&ДатаОтчета, Организация В (&СписокОрганизаций)) КАК РегистрацияЗемельныхУчастковСрезПоследних
		|ГДЕ
		|	РегистрацияЗемельныхУчастковСрезПоследних.ВключатьВНалоговуюБазу = ИСТИНА
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ОсновноеСредство,
		|	НалоговыйОрган
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ЗемельныеУчастки.ОсновноеСредство,
		|	ВТ_ЗемельныеУчастки.КБК КАК КБК,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ВТ_ЗемельныеУчастки.ДоляВПравеОбщейСобственностиЧислитель, 0) <> 0
		|				И ЕСТЬNULL(ВТ_ЗемельныеУчастки.ДоляВПравеОбщейСобственностиЗнаменатель, 0) <> 0
		|			ТОГДА ВЫБОР
		|					КОГДА 1 > ВТ_ЗемельныеУчастки.ДоляВПравеОбщейСобственностиЧислитель / ВТ_ЗемельныеУчастки.ДоляВПравеОбщейСобственностиЗнаменатель
		|						ТОГДА ВТ_ЗемельныеУчастки.ДоляВПравеОбщейСобственностиЧислитель / ВТ_ЗемельныеУчастки.ДоляВПравеОбщейСобственностиЗнаменатель
		|					ИНАЧЕ 1
		|				КОНЕЦ
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК ДоляВПравеОбщейСобственности,
		|	ВТ_ЗемельныеУчастки.ПлощадьОблагаемая,
		|	(ЕСТЬNULL(ВТ_ЗемельныеУчастки.НалоговаяСтавка, 0) + ЕСТЬNULL(ВТ_ЗемельныеУчастки.ПроцентИзмененияБазовойСтавкиНалога, 0) * ЕСТЬNULL(ВТ_ЗемельныеУчастки.НалоговаяСтавка, 0) / 100) * ВЫБОР
		|		КОГДА ЕСТЬNULL(ВТ_ЗемельныеУчастки.КорректировкаБазовойСтавкиНалога, 0) = 0
		|			ТОГДА 1
		|		ИНАЧЕ ЕСТЬNULL(ВТ_ЗемельныеУчастки.КорректировкаБазовойСтавкиНалога, 0)
		|	КОНЕЦ * ВЫБОР
		|		КОГДА ЕСТЬNULL(ВТ_ЗемельныеУчастки.КорректировкаБазовойСтавкиНалогаНаТерриторияхСЭЗ, 0) = 0
		|			ТОГДА 1
		|		ИНАЧЕ ЕСТЬNULL(ВТ_ЗемельныеУчастки.КорректировкаБазовойСтавкиНалогаНаТерриторияхСЭЗ, 0)
		|	КОНЕЦ * ВЫБОР
		|		КОГДА ЕСТЬNULL(ВТ_ЗемельныеУчастки.КорректировкаБазовойСтавкиНалогаПоРешениюМестныхОрганов, 0) = 0
		|			ТОГДА 1
		|		ИНАЧЕ ЕСТЬNULL(ВТ_ЗемельныеУчастки.КорректировкаБазовойСтавкиНалогаПоРешениюМестныхОрганов, 0)
		|	КОНЕЦ КАК СтавкаНалогаСУчетомКорректировки,
		|	ВТ_ЗемельныеУчастки.КорректировкаБазовойСтавкиНалогаПоРешениюМестныхОрганов,
		|	ВТ_ЗемельныеУчастки.КорректировкаБазовойСтавкиНалогаНаТерриторияхСЭЗ,
		|	ВТ_ЗемельныеУчастки.КорректировкаБазовойСтавкиНалога,
		|	ВТ_ЗемельныеУчастки.ПроцентИзмененияБазовойСтавкиНалога,
		|	ВТ_ЗемельныеУчастки.НалоговаяСтавка,
		|	ВТ_ЗемельныеУчастки.НалоговыйОрган,
		|	ВТ_ЗемельныеУчастки.КадастровыйНомер,
		|	ВТ_ЗемельныеУчастки.КодКатегорииЗемель,
		|	ВТ_ЗемельныеУчастки.ПлощадьНеОблагаемая,
		|	ВТ_ЗемельныеУчастки.Период,
		|	ВТ_ЗемельныеУчастки.Организация,
		|	ВТ_ЗемельныеУчастки.ДоляВПравеОбщейСобственностиЧислитель,
		|	ВТ_ЗемельныеУчастки.ДоляВПравеОбщейСобственностиЗнаменатель
		|ПОМЕСТИТЬ ВТ_СуммаНалога
		|ИЗ
		|	ВТ_ЗемельныеУчастки КАК ВТ_ЗемельныеУчастки
		|ГДЕ
		|	ВТ_ЗемельныеУчастки.НалоговыйОрган = &НалоговыйОрганОтчета
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	КБК
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ВТ_СуммаНалога.ПлощадьОблагаемая * ВТ_СуммаНалога.ДоляВПравеОбщейСобственности * ВТ_СуммаНалога.СтавкаНалогаСУчетомКорректировки КАК ЧИСЛО(15, 2)) КАК СуммаНалога,
		|	ВТ_СуммаНалога.КБК КАК КБК,
		|	ВТ_СуммаНалога.ОсновноеСредство,
		|	ВТ_СуммаНалога.КорректировкаБазовойСтавкиНалогаПоРешениюМестныхОрганов,
		|	ВТ_СуммаНалога.КорректировкаБазовойСтавкиНалогаНаТерриторияхСЭЗ,
		|	ВТ_СуммаНалога.КорректировкаБазовойСтавкиНалога,
		|	ВТ_СуммаНалога.ПлощадьОблагаемая,
		|	ВТ_СуммаНалога.ПроцентИзмененияБазовойСтавкиНалога,
		|	ВТ_СуммаНалога.НалоговаяСтавка,
        |	ВТ_СуммаНалога.СтавкаНалогаСУчетомКорректировки,
        |	ВТ_СуммаНалога.НалоговыйОрган КАК ИФНС,
		|	ВТ_СуммаНалога.КадастровыйНомер,
		|	ВТ_СуммаНалога.КодКатегорииЗемель,
		|	ВТ_СуммаНалога.ПлощадьНеОблагаемая,
		|	ВТ_СуммаНалога.Период,
		|	ВТ_СуммаНалога.Организация,
		|	ВТ_СуммаНалога.ДоляВПравеОбщейСобственностиЗнаменатель,
		|	ВТ_СуммаНалога.ДоляВПравеОбщейСобственностиЧислитель,
		|	ВТ_СуммаНалога.ПлощадьОблагаемая КАК НалоговаяБаза
		|ИЗ
		|	ВТ_СуммаНалога КАК ВТ_СуммаНалога";	
		
	ИначеЕсли НаборДанных = "РасчетНалогаНаИмущество" Тогда
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	СостоянияОСОрганизаций.ОсновноеСредство КАК ОсновноеСредство,
		               |	СостоянияОСОрганизаций.Организация КАК Организация,
		               |	СостоянияОСОрганизаций.Состояние КАК Состояние,
		               |	СостоянияОСОрганизаций.ДатаСостояния
		               |ПОМЕСТИТЬ ОСПринятыеКУчету
		               |ИЗ
		               |	РегистрСведений.СостоянияОСОрганизаций.СрезПоследних(&ДатаОкончания, Организация В (&СписокОрганизаций)) КАК СостоянияОСОрганизаций
		               |ГДЕ
		               |	(СостоянияОСОрганизаций.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПринятоКУчету)
		               |			ИЛИ СостоянияОСОрганизаций.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияОС.СнятоСУчета))
		               |
		               |ИНДЕКСИРОВАТЬ ПО
		               |	ОсновноеСредство,
		               |	Организация
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	ОС.Ссылка КАК ОсновноеСредство
		               |ПОМЕСТИТЬ СписокРазрешенныхОС
		               |ИЗ
		               |	Справочник.ОбъектыЭксплуатации КАК ОС
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОСПринятыеКУчету КАК ОСПринятыеКУчету
		               |		ПО ОС.Ссылка = ОСПринятыеКУчету.ОсновноеСредство
		               |ГДЕ
		               |	ОС.Ссылка В
		               |			(ВЫБРАТЬ
		               |				ПервоначальныеСведения.ОсновноеСредство
		               |			ИЗ
		               |				РегистрСведений.ПервоначальныеСведенияОСБухгалтерскийУчет КАК ПервоначальныеСведения
		               |			ГДЕ
		               |				ПервоначальныеСведения.ОбъектИмущественногоНалога
		               |				И ПервоначальныеСведения.Период < &ДатаОкончания
		               |				И ПервоначальныеСведения.Организация В (&СписокОрганизаций))
		               |
		               |ИНДЕКСИРОВАТЬ ПО
		               |	ОС.Ссылка
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
		               |	ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.Организация КАК Организация,
		               |	ВЫБОР
		               |		КОГДА СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследних.ПостановкаНаУчетВНалоговомОргане = ЗНАЧЕНИЕ(Перечисление.ПостановкаНаУчетВНалоговомОргане.ВДругомНалоговомОргане)
		               |			ТОГДА СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследних.НалоговыйОрган
		               |		ИНАЧЕ &ОсновнойНалоговыйОрган
		               |	КОНЕЦ КАК НалоговыйКомитет,
		               |	ВЫБОР
		               |		КОГДА ЕСТЬNULL(СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследних.НалоговаяСтавка, 0) <> 0
		               |			ТОГДА ВЫБОР
		               |					КОГДА ЕСТЬNULL(СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследних.ДоляСтоимостиЧислитель, 0) <> 0
		               |							И ЕСТЬNULL(СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследних.ДоляСтоимостиЗнаменатель, 0) <> 0
		               |						ТОГДА ВЫБОР
		               |								КОГДА СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследних.ДоляСтоимостиЧислитель / СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследних.ДоляСтоимостиЗнаменатель < 1
		               |									ТОГДА СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследних.ДоляСтоимостиЧислитель / СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследних.ДоляСтоимостиЗнаменатель * СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследних.НалоговаяСтавка
		               |								ИНАЧЕ СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследних.НалоговаяСтавка
		               |							КОНЕЦ
		               |					ИНАЧЕ СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследних.НалоговаяСтавка
		               |				КОНЕЦ
		               |		ИНАЧЕ ЕСТЬNULL(СтавкиНалогаНаИмуществоСрезПоследних.НалоговаяСтавка, 0)
		               |	КОНЕЦ КАК НалоговаяСтавка,
		               |	ВЫБОР
		               |		КОГДА СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследних.ПорядокНалогообложения = ЗНАЧЕНИЕ(Перечисление.ПорядокНалогообложенияИмущества.НеПодлежитНалогообложению)
		               |				ИЛИ СтавкиНалогаНаИмуществоСрезПоследних.ОсвобождениеОтНалогообложения = ИСТИНА
		               |			ТОГДА ИСТИНА
		               |		ИНАЧЕ ЛОЖЬ
		               |	КОНЕЦ КАК НеПодлежитНалогообложению,
		               |	ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.ИнвентарныйНомер,
		               |	СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследних.ДоляСтоимостиЧислитель,
		               |	СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследних.ДоляСтоимостиЗнаменатель
		               |ПОМЕСТИТЬ СписокОС
		               |ИЗ
		               |	РегистрСведений.ПервоначальныеСведенияОСБухгалтерскийУчет.СрезПоследних(
		               |			&ДатаОкончания,
		               |			Организация В (&СписокОрганизаций)
		               |				И ОсновноеСредство В
		               |					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |						СписокРазрешенныхОС.ОсновноеСредство
		               |					ИЗ
		               |						СписокРазрешенныхОС КАК СписокРазрешенныхОС)) КАК ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам.СрезПоследних(&ДатаОкончания, Организация В (&СписокОрганизаций)) КАК СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследних
		               |		ПО ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство = СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследних.ОсновноеСредство
		               |			И ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.Организация = СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследних.Организация
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтавкиНалогаНаИмущество.СрезПоследних(&ДатаОкончания, Организация В (&СписокОрганизаций)) КАК СтавкиНалогаНаИмуществоСрезПоследних
		               |		ПО ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.Организация = СтавкиНалогаНаИмуществоСрезПоследних.Организация
		               |
		               |ИНДЕКСИРОВАТЬ ПО
		               |	ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство,
		               |	ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.Организация
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	СчетаБухгалтерскогоУчетаОССрезПоследних.ОсновноеСредство,
		               |	СчетаБухгалтерскогоУчетаОССрезПоследних.Организация,
		               |    ВЫБОР
		               |        КОГДА СчетаБухгалтерскогоУчетаОССрезПоследних.ГруппаФинансовогоУчета = ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаВнеоборотныхАктивов.ПустаяСсылка)
			           |            ТОГДА СчетаБухгалтерскогоУчетаОССрезПоследних.СчетУчета
		               |        ИНАЧЕ СчетаБухгалтерскогоУчетаОССрезПоследних.ГруппаФинансовогоУчета.СчетУчета
	                   |    КОНЕЦ КАК СчетУчета,
	                   |    ВЫБОР
		               |        КОГДА СчетаБухгалтерскогоУчетаОССрезПоследних.ГруппаФинансовогоУчета = ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаВнеоборотныхАктивов.ПустаяСсылка)
			           |            ТОГДА СчетаБухгалтерскогоУчетаОССрезПоследних.СчетНачисленияАмортизации
		               |        ИНАЧЕ СчетаБухгалтерскогоУчетаОССрезПоследних.ГруппаФинансовогоУчета.СчетУчетаАмортизации
	                   |    КОНЕЦ КАК СчетНачисленияАмортизации
		               |ПОМЕСТИТЬ ВТ_СчетаУчетаОС
		               |ИЗ
		               |	РегистрСведений.СчетаБухгалтерскогоУчетаОС.СрезПоследних(
		               |			&ГраницаНачалоПериодаОтчета,
		               |			Организация В (&СписокОрганизаций)
		               |				И ОсновноеСредство В
		               |					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |						СписокОС.ОсновноеСредство
		               |					ИЗ
		               |						СписокОС КАК СписокОС)) КАК СчетаБухгалтерскогоУчетаОССрезПоследних
		               |
		               |ИНДЕКСИРОВАТЬ ПО
		               |	СчетаБухгалтерскогоУчетаОССрезПоследних.ОсновноеСредство,
		               |	СчетаБухгалтерскогоУчетаОССрезПоследних.Организация
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	ПервоначальнаяСтоимостьОС.СуммаОстатокДт,
		               |	ПервоначальнаяСтоимостьОС.Субконто1,
		               |	ПервоначальнаяСтоимостьОС.Организация,
		               |	ПервоначальнаяСтоимостьОС.Счет
		               |ПОМЕСТИТЬ ВТ_ПервоначальнаяСтоимостьОС
		               |ИЗ
		               |	ВТ_СчетаУчетаОС КАК ВТ_СчетаУчетаОС
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.Хозрасчетный.Остатки(
		               |				&НачалоГода,
		               |				Счет В
		               |					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |						ВТ_СчетаУчетаОС.СчетУчета
		               |					ИЗ
		               |						ВТ_СчетаУчетаОС
		               |					ГДЕ
		               |						ВТ_СчетаУчетаОС.СчетУчета ЕСТЬ НЕ NULL ),
		               |				ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.ОсновныеСредства),
		               |				Организация В (&СписокОрганизаций)) КАК ПервоначальнаяСтоимостьОС
		               |		ПО (ПервоначальнаяСтоимостьОС.Субконто1 = ВТ_СчетаУчетаОС.ОсновноеСредство)
		               |			И (ПервоначальнаяСтоимостьОС.Счет = ВТ_СчетаУчетаОС.СчетУчета)
		               |			И ВТ_СчетаУчетаОС.Организация = ПервоначальнаяСтоимостьОС.Организация
		               |
		               |ИНДЕКСИРОВАТЬ ПО
		               |	ПервоначальнаяСтоимостьОС.Субконто1,
		               |	ПервоначальнаяСтоимостьОС.Организация
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	АмортизацияОС.СуммаОстатокКт,
		               |	АмортизацияОС.Субконто1,
		               |	АмортизацияОС.Организация,
		               |	АмортизацияОС.Счет
		               |ПОМЕСТИТЬ ВТ_АмортизацияОС
		               |ИЗ
		               |	ВТ_СчетаУчетаОС КАК ВТ_СчетаУчетаОС
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.Хозрасчетный.Остатки(
		               |				&НачалоГода,
		               |				Счет В
		               |					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |						ВТ_СчетаУчетаОС.СчетНачисленияАмортизации
		               |					ИЗ
		               |						ВТ_СчетаУчетаОС
		               |					ГДЕ
		               |						ВТ_СчетаУчетаОС.СчетНачисленияАмортизации ЕСТЬ НЕ NULL ),
		               |				ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.ОсновныеСредства),
		               |				Организация В (&СписокОрганизаций)) КАК АмортизацияОС
		               |		ПО ВТ_СчетаУчетаОС.СчетНачисленияАмортизации = АмортизацияОС.Счет
		               |			И ВТ_СчетаУчетаОС.ОсновноеСредство = АмортизацияОС.Субконто1
		               |			И ВТ_СчетаУчетаОС.Организация = АмортизацияОС.Организация
		               |
		               |ИНДЕКСИРОВАТЬ ПО
		               |	АмортизацияОС.Субконто1,
		               |	АмортизацияОС.Организация
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	СписокОС.Организация,
		               |	СписокОС.НалоговаяСтавка,
		               |	СписокОС.НалоговыйКомитет КАК ИФНС,
		               |	СписокОС.НеПодлежитНалогообложению,
		               |	ЕСТЬNULL(ВТ_ПервоначальнаяСтоимостьОС.СуммаОстатокДт, 0) - ЕСТЬNULL(ВТ_АмортизацияОС.СуммаОстатокКт, 0) КАК БалансоваяСтоимость,
		               |	(ЕСТЬNULL(ВТ_ПервоначальнаяСтоимостьОС.СуммаОстатокДт, 0) - ЕСТЬNULL(ВТ_АмортизацияОС.СуммаОстатокКт, 0)) * СписокОС.НалоговаяСтавка / 100 КАК ОбщаяСумма,
		               |	(ЕСТЬNULL(ВТ_ПервоначальнаяСтоимостьОС.СуммаОстатокДт, 0) - ЕСТЬNULL(ВТ_АмортизацияОС.СуммаОстатокКт, 0)) * СписокОС.НалоговаяСтавка КАК НалоговаяБаза,
		               |	СписокОС.ИнвентарныйНомер,
		               |	СписокОС.ДоляСтоимостиЧислитель,
		               |	СписокОС.ДоляСтоимостиЗнаменатель,
		               |	ОСПринятыеКУчету.ДатаСостояния,
		               |	СписокОС.ОсновноеСредство КАК ОсновноеСредствоИмущество
		               |ИЗ
		               |	СписокОС КАК СписокОС
		               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПервоначальнаяСтоимостьОС КАК ВТ_ПервоначальнаяСтоимостьОС
		               |		ПО СписокОС.ОсновноеСредство = ВТ_ПервоначальнаяСтоимостьОС.Субконто1
		               |			И СписокОС.Организация = ВТ_ПервоначальнаяСтоимостьОС.Организация
		               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_АмортизацияОС КАК ВТ_АмортизацияОС
		               |		ПО СписокОС.ОсновноеСредство = ВТ_АмортизацияОС.Субконто1
		               |			И СписокОС.Организация = ВТ_АмортизацияОС.Организация
		               |		ЛЕВОЕ СОЕДИНЕНИЕ ОСПринятыеКУчету КАК ОСПринятыеКУчету
		               |		ПО СписокОС.ОсновноеСредство = ОСПринятыеКУчету.ОсновноеСредство
		               |			И СписокОС.Организация = ОСПринятыеКУчету.Организация
		               |ГДЕ
		               |	СписокОС.НалоговыйКомитет = &НалоговыйКомитет
		               |	И СписокОС.НеПодлежитНалогообложению = ЛОЖЬ";
	КонецЕсли;
		
	Возврат ТекстЗапроса;
КонецФункции

Процедура ДобавитьПоляИтоговВСхему(СхемаКомпоновкиДанных, НаборДанных) Экспорт
    
    Если НаборДанных = "РасчетЗемельногоНалога" Тогда
        ДобавитьПолеИтога(СхемаКомпоновкиДанных, "СуммаНалога");
    ИначеЕсли НаборДанных = "РасчетНалогаНаИмущество" Тогда
        ДобавитьПолеИтога(СхемаКомпоновкиДанных, "ОбщаяСумма");   
    КонецЕсли;
    
КонецПроцедуры

Функция ДобавитьПолеИтога(СхемаКомпоновкиДанных, ПутьКДанным, Выражение = Неопределено)
	
	Если Выражение = Неопределено Тогда
		Выражение = "Сумма(" + ПутьКДанным + ")";
	КонецЕсли;
	
	ПолеИтога = СхемаКомпоновкиДанных.ПоляИтога.Добавить();
	ПолеИтога.ПутьКДанным = ПутьКДанным;
	ПолеИтога.Выражение = Выражение;
	Возврат ПолеИтога;
	
КонецФункции
