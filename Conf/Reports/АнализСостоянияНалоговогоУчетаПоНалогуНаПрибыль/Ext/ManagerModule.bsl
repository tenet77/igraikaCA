	ЗапросКорректировка.УстановитьПараметр("ОрганизацияГоловная",  	   ОрганизацияГоловная);
	ЗапросКорректировка.УстановитьПараметр("НачалоПериода",     	   ПараметрыОтчета.НачалоПериода);
	ЗапросКорректировка.УстановитьПараметр("КонецПериода",     	       КонецДня(ПараметрыОтчета.КонецПериода));
	
	ВыборкаКорректировка = ЗапросКорректировка.Выполнить().Выбрать();
	
	КорректировкаСуммаПР = 0;
	КорректировкаСуммаВР = 0;
	
	Пока ВыборкаКорректировка.Следующий() Цикл
		КорректировкаСуммаПР = - ВыборкаКорректировка.СуммаПР;
		КорректировкаСуммаВР = - ВыборкаКорректировка.СуммаВР;
	КонецЦикла;

	НалогБУСКорректировкой = НалогНаПрибыльПоБУ + КорректировкаСуммаПР + КорректировкаСуммаВР;
		
	ЭлементыСхемы.НалогБУ.Наименование    = Формат(НалогНаПрибыльПоБУ,    "ЧЦ=20; ЧДЦ=0; ЧРГ=' '");
	ЭлементыСхемы.НалогНУ.Наименование    = Формат(НалогНаПрибыльПоНУ,    "ЧЦ=20; ЧДЦ=0; ЧРГ=' '");
	ЭлементыСхемы.НалогПР.Наименование    = Формат(КорректировкаСуммаПР,    "ЧЦ=20; ЧДЦ=0; ЧРГ=' '");
	ЭлементыСхемы.НалогВР.Наименование    = Формат(КорректировкаСуммаВР,    "ЧЦ=20; ЧДЦ=0; ЧРГ=' '");
	ЭлементыСхемы.НалогБУКор.Наименование = Формат(НалогБУСКорректировкой, "ЧЦ=20; ЧДЦ=0; ЧРГ=' '");
	ЭлементыСхемы.СтавкаНалогаНаПрибыль.Наименование = Строка(СтавкаНалога) + "%";
	
	НастроитьРамку(ВыборкаДоходы,  "Доходы",  ЭлементыСхемы.РасшифровкаДоходы,  СтруктураВП.ПоказыватьЛегенду, НастройкаРамок);		
	НастроитьРамку(ВыборкаРасходы, "Расходы", ЭлементыСхемы.РасшифровкаРасходы, СтруктураВП.ПоказыватьЛегенду, НастройкаРамок);
	
	Если СтруктураВП.ПоказыватьЛегенду Тогда
		ВывестиЛегенду(ЭлементыСхемы);		
	КонецЕсли;
	
	ЭлементыСхемы.НазваниеОрганизации.Наименование = ЗаголовокОтчета(ПараметрыОтчета);
	
	// Сохраняем историю
	СохранитьИсториюСхемы(КэшПараметровОтчета, "РасчетНалогаНаПрибыль", РасшифровкаМакета, НастройкаРамок, ЭлементыСхемы);	
	
