	Если СтруктураВП.НомерТекущейСхемы > 20 Тогда
		
		Запрос.УстановитьПараметр("Организация", СписокОП);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Организация = &Организация", "Организация В (&Организация)");
		
