	РасшифровкаМакета.Вставить("РасходыПоНачисленнымНалогам", 	ПереходКРасшифровкеСхемы(ПараметрыОтчета, "РасшифровкаРасходыПоНачисленнымНалогам"));
	РасшифровкаМакета.Вставить("ПредставительскиеРасходы", 		ПереходКРасшифровкеСхемы(ПараметрыОтчета, "РасшифровкаПредставительскиеРасходы"));
	РасшифровкаМакета.Вставить("ДругиеПрочиеРасходы", 			ПереходКРасшифровкеСхемы(ПараметрыОтчета, "РасшифровкаДругиеПрочиеРасходы"));
	РасшифровкаМакета.Вставить("РасходыПоВознаграждениям", 		ПереходКРасшифровкеСхемы(ПараметрыОтчета, "РасшифровкаРасходыПоВознаграждениям"));
	РасшифровкаМакета.Вставить("РасшифровкаПрочиеРасходы",   	ПереходКРасшифровкеСхемы(ПараметрыОтчета, "РасшифровкаПрочиеРасходы"));
	
	Если СтруктураВП.ПоказыватьЛегенду Тогда
		
		ВывестиЛегенду(ЭлементыСхемы);
		
	КонецЕсли;
	
	ЭлементыСхемы.НазваниеОрганизации.Наименование = ЗаголовокОтчета(ПараметрыОтчета);
	
	// Сохраняем историю
	СохранитьИсториюСхемы(КэшПараметровОтчета, ИмяМакета, РасшифровкаМакета, НастройкаРамок, ЭлементыСхемы);

