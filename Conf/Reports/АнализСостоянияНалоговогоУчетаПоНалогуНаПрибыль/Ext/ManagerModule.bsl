	ЗапросСтавка.УстановитьПараметр("Дата", КонецДня(ПараметрыОтчета.КонецПериода));
	
	Выборка = ЗапросСтавка.Выполнить().Выбрать();
	
	СтавкаНалога = 0;
	Пока Выборка.Следующий() Цикл
		СтавкаНалога = Выборка.Ставка;
	КонецЦикла;
	
	ПрибыльБУ = ?(ЕстьДоходы,ВыборкаДоходы.ДоходыБУ,0) - ?(ЕстьРасходы,ВыборкаРасходы.РасходыБУ,0);
	НалогНаПрибыльПоБУ = ПрибыльБУ * СтавкаНалога / 100;
	
	ПрибыльНУ = ?(ЕстьДоходы,ВыборкаДоходы.ДоходыНУ,0) - ?(ЕстьРасходы,ВыборкаРасходы.РасходыНУ,0);
	НалогНаПрибыльПоНУ = ПрибыльНУ * СтавкаНалога / 100;
	
	ЗапросКорректировка = Новый Запрос;
	
	ЗапросКорректировка.Текст = "ВЫБРАТЬ
	|	ХозрасчетныйОбороты.Организация КАК Организация,
	|	ХозрасчетныйОбороты.СуммаПРОборотДт КАК Дт2810ПР,
