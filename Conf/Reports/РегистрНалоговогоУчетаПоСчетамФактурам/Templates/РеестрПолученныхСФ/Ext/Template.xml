ПОМЕСТИТЬ ВТ_ОбротыПоРеализацииПоРегистраторам
ИЗ
    РегистрНакопления.НДСКВозмещению.Обороты(&amp;НачалоПериода, &amp;КонецПериода, Регистратор, ) КАК НДСКВозмещениюОбороты
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
    ЖурналУчетаСчетовФактур.Организация,
    ЖурналУчетаСчетовФактур.СчетФактура,
    ВЫБОР
        КОГДА НЕ ЖурналУчетаСчетовФактур.ДатаИсправления = ДАТАВРЕМЯ(1, 1, 1)
            ТОГДА ЖурналУчетаСчетовФактур.ДатаИсправления
        КОГДА НЕ ЖурналУчетаСчетовФактур.ДатаКорректировочногоСчетаФактуры = ДАТАВРЕМЯ(1, 1, 1)
            ТОГДА ЖурналУчетаСчетовФактур.ДатаКорректировочногоСчетаФактуры
        ИНАЧЕ ЖурналУчетаСчетовФактур.ДатаСчетаФактуры
    КОНЕЦ КАК ДатаСчетаФактуры,
    ВЫБОР
        КОГДА НЕ ЖурналУчетаСчетовФактур.НомерИсправления = ""
            ТОГДА ЖурналУчетаСчетовФактур.НомерИсправления
        КОГДА НЕ ЖурналУчетаСчетовФактур.НомерКорректировочногоСчетаФактуры = ""
            ТОГДА ЖурналУчетаСчетовФактур.НомерКорректировочногоСчетаФактуры
        ИНАЧЕ ЖурналУчетаСчетовФактур.НомерСчетаФактуры
    КОНЕЦ КАК НомерСчетаФактуры,
    ЖурналУчетаСчетовФактур.Контрагент,
    СУММА(ЖурналУчетаСчетовФактур.СуммаРегл) КАК СуммаПоСчетуФактуре,
    СУММА(ЖурналУчетаСчетовФактур.СуммаНДСРегл) КАК СуммаНДСПоСчетуФактуре,
    ЖурналУчетаСчетовФактур.КодСпособаВыставленияПолучения КАК СпособВыставления,
    ЖурналУчетаСчетовФактур.ИсходныйСчетФактура КАК ИсходныйСчетФактура
ПОМЕСТИТЬ ВТ_ДанныеПоСФ
ИЗ
    РегистрСведений.ЖурналУчетаСчетовФактур КАК ЖурналУчетаСчетовФактур
ГДЕ
    ЖурналУчетаСчетовФактур.Период &gt;= &amp;НачалоПериода
    И ЖурналУчетаСчетовФактур.Период &lt;= &amp;КонецПериода
    И ЖурналУчетаСчетовФактур.ЧастьЖурнала = ЗНАЧЕНИЕ(Перечисление.ЧастиЖурналаУчетаСчетовФактур.ПолученныеСчетаФактуры)

СГРУППИРОВАТЬ ПО
    ЖурналУчетаСчетовФактур.СчетФактура,
    ЖурналУчетаСчетовФактур.Контрагент,
    ЖурналУчетаСчетовФактур.КодСпособаВыставленияПолучения,
    ЖурналУчетаСчетовФактур.ИсходныйСчетФактура,
    ЖурналУчетаСчетовФактур.Организация,
    ВЫБОР
        КОГДА НЕ ЖурналУчетаСчетовФактур.ДатаИсправления = ДАТАВРЕМЯ(1, 1, 1)
            ТОГДА ЖурналУчетаСчетовФактур.ДатаИсправления
        КОГДА НЕ ЖурналУчетаСчетовФактур.ДатаКорректировочногоСчетаФактуры = ДАТАВРЕМЯ(1, 1, 1)
            ТОГДА ЖурналУчетаСчетовФактур.ДатаКорректировочногоСчетаФактуры
        ИНАЧЕ ЖурналУчетаСчетовФактур.ДатаСчетаФактуры
    КОНЕЦ,
    ВЫБОР
        КОГДА НЕ ЖурналУчетаСчетовФактур.НомерИсправления = ""
            ТОГДА ЖурналУчетаСчетовФактур.НомерИсправления
        КОГДА НЕ ЖурналУчетаСчетовФактур.НомерКорректировочногоСчетаФактуры = ""
            ТОГДА ЖурналУчетаСчетовФактур.НомерКорректировочногоСчетаФактуры
        ИНАЧЕ ЖурналУчетаСчетовФактур.НомерСчетаФактуры
    КОНЕЦ
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ДанныеПоСФ.ИсходныйСчетФактура КАК ИсходныйСчетФактура
ПОМЕСТИТЬ ВТ_ПрекратившиеДействие
ИЗ
	ВТ_ДанныеПоСФ КАК ВТ_ДанныеПоСФ
ГДЕ
	ТИПЗНАЧЕНИЯ(ВТ_ДанныеПоСФ.ИсходныйСчетФактура) = ТИП(Документ.СчетФактураПолученный) И НЕ ВТ_ДанныеПоСФ.ИсходныйСчетФактура = ЗНАЧЕНИЕ(Документ.СчетФактураПолученный.ПустаяСсылка)

ИНДЕКСИРОВАТЬ ПО
	ИсходныйСчетФактура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
    ВТ_ОбротыПоРеализацииПоРегистраторам.Регистратор,
    МАКСИМУМ(ВТ_ОбротыПоРеализацииПоРегистраторам.ОборотПоРеализации) КАК ОборотПоРеализации,
    МАКСИМУМ(ВТ_ОбротыПоРеализацииПоРегистраторам.СуммаНДСОборот) КАК СуммаНДСОборот,
    СчетФактураПолученныйДокументыОснования.ИсходныйДокумент КАК ОсновнойСчетФактура
ПОМЕСТИТЬ ВТ_ДвиженияПоНДС
ИЗ
    ВТ_ОбротыПоРеализацииПоРегистраторам КАК ВТ_ОбротыПоРеализацииПоРегистраторам
        ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураПолученный.ДокументыОснования КАК СчетФактураПолученныйДокументыОснования
        ПО ВТ_ОбротыПоРеализацииПоРегистраторам.Регистратор = СчетФактураПолученныйДокументыОснования.Ссылка

СГРУППИРОВАТЬ ПО
    ВТ_ОбротыПоРеализацииПоРегистраторам.Регистратор,
    СчетФактураПолученныйДокументыОснования.ИсходныйДокумент
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
    ВТ_ДанныеПоСФ.Организация КАК Организация,
    ВТ_ДанныеПоСФ.СчетФактура КАК СчетФактураСсылка,
    ВТ_ДанныеПоСФ.Контрагент КАК Контрагент,
    ВТ_ДанныеПоСФ.Контрагент.ИНН КАК КонтрагентИНН,
    ВТ_ДвиженияПоНДС.СуммаНДСОборот КАК НачисленныйНДС,
    ВТ_ДанныеПоСФ.СуммаПоСчетуФактуре - ВТ_ДанныеПоСФ.СуммаНДСПоСчетуФактуре КАК СуммаПоСчетуФактуре,
    ВТ_ДанныеПоСФ.СуммаНДСПоСчетуФактуре КАК СуммаНДСПоСчетуФактуре,
    ВТ_ДанныеПоСФ.СпособВыставления КАК СпособВыставления,
    ВТ_ДвиженияПоНДС.ОборотПоРеализации КАК ОборотПоРеализации,
    ВТ_ДвиженияПоНДС.ОсновнойСчетФактура КАК ОсновнойСчетФактура,
    ВТ_ДанныеПоСФ.ДатаСчетаФактуры КАК Дата,
    ВТ_ДанныеПоСФ.НомерСчетаФактуры КАК Номер
{ВЫБРАТЬ
    Организация.*,
    СчетФактураСсылка.*,
    Контрагент.*,
    КонтрагентИНН,
    НачисленныйНДС,
    СуммаПоСчетуФактуре,
    СуммаНДСПоСчетуФактуре,
    СпособВыставления,
    ОборотПоРеализации,
    ОсновнойСчетФактура.*,
    Дата,
    Номер}
ИЗ
    ВТ_ДанныеПоСФ КАК ВТ_ДанныеПоСФ
        ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДвиженияПоНДС КАК ВТ_ДвиженияПоНДС
        ПО ВТ_ДанныеПоСФ.СчетФактура = ВТ_ДвиженияПоНДС.Регистратор
        ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПрекратившиеДействие КАК ВТ_ПрекратившиеДействие
        ПО ВТ_ДанныеПоСФ.СчетФактура = ВТ_ПрекратившиеДействие.ИсходныйСчетФактура
ГДЕ
    (НЕ ВТ_ДанныеПоСФ.СуммаПоСчетуФактуре = 0
            ИЛИ НЕ ВТ_ДанныеПоСФ.СуммаНДСПоСчетуФактуре = 0)
    И ВТ_ПрекратившиеДействие.ИсходныйСчетФактура ЕСТЬ NULL
{ГДЕ
    ВТ_ДанныеПоСФ.Организация.*,
    ВТ_ДанныеПоСФ.СчетФактура.*,
    ВТ_ДанныеПоСФ.Контрагент.*,
    ВТ_ДанныеПоСФ.Контрагент.ИНН,
    ВТ_ДанныеПоСФ.СуммаПоСчетуФактуре,
    ВТ_ДанныеПоСФ.СуммаНДСПоСчетуФактуре,
    ВТ_ДанныеПоСФ.СпособВыставления,
    ВТ_ДвиженияПоНДС.ОсновнойСчетФактура.*,
    ВТ_ДанныеПоСФ.ДатаСчетаФактуры,
    ВТ_ДанныеПоСФ.НомерСчетаФактуры}</query>
	</dataSet>
	<calculatedField>
		<dataPath>КварталГод</dataPath>
		<expression>БухгалтерскиеОтчетыКлиентСервер.ПолучитьПредставлениеПериода(&amp;НачалоПериода, &amp;КонецПериода)</expression>
