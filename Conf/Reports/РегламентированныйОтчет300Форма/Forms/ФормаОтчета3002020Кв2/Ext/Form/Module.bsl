		ИЛИ (Найти(ИмяЯчейки, "Условие_B") > 0)
		ИЛИ (Найти(ИмяЯчейки, "Условие_С1") > 0) 
		ИЛИ (Найти(ИмяЯчейки, "Условие_С2") > 0) 
