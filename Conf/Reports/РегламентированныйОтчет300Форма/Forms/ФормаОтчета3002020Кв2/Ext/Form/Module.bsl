&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьКоличествоПодразделовПоРодителю(Родитель)
	
	Если Родитель = "Форма300Страница1" Тогда
		Возврат 3;
	ИначеЕсли Родитель = "Форма300_01Страница1" Тогда
		Возврат 1;
	ИначеЕсли Родитель = "Форма300_02Страница1" Тогда
		Возврат 1;
	ИначеЕсли Родитель = "Форма300_03Страница1" Тогда
		Возврат 2;
	ИначеЕсли Родитель = "Форма300_04Страница1" Тогда
		Возврат 1;
	ИначеЕсли Родитель = "Форма300_05Страница1" Тогда
		Возврат 3;
	ИначеЕсли Родитель = "Форма300_06Страница1" Тогда
		Возврат 1;
	ИначеЕсли Родитель = "Форма300_07Страница1" Тогда
		Возврат 3;
	ИначеЕсли Родитель = "Форма300_08Страница1" Тогда
		Возврат 3;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПолучитьМетодОтнесенияНДСВЗачет()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА Не УчетнаяПолитикаОрганизацийСрезПоследних.УчетнаяПолитика.ПрименяетсяУчетНДСПоФактическомуИспользованию ЕСТЬ NULL 
	|				И УчетнаяПолитикаОрганизацийСрезПоследних.УчетнаяПолитика.ПрименяетсяУчетНДСПоФактическомуИспользованию = ИСТИНА
	|			ТОГДА ""Пропорциональный""
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ИспользоватьРаздельныйУчетПоНалогообложению.Значение
	|					ТОГДА ""Раздельный""
	|				ИНАЧЕ ""Пропорциональный""
	|			КОНЕЦ
	|	КОНЕЦ КАК МетодОтнесенияНДСВЗачет
	|ИЗ
	|	РегистрСведений.УчетнаяПолитикаОрганизаций.СрезПоследних(&Дата, Организация = &Организация) КАК УчетнаяПолитикаОрганизацийСрезПоследних,
	|	Константа.ИспользоватьРаздельныйУчетПоНалогообложению КАК ИспользоватьРаздельныйУчетПоНалогообложению";
	
	Запрос.УстановитьПараметр("Организация", СтруктураРеквизитовФормы.Организация);
	Запрос.УстановитьПараметр("Дата", СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета);
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.МетодОтнесенияНДСВЗачет;
	
КонецФункции

&НаСервере
Процедура СформироватьОтчетныйПериод()
	
	СтрПериодОтчета = ПредставлениеПериода(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета,СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета, "ФП = истина");
	
	СтруктураРеквизитовФормы.мКвартал = Лев(СтрПериодОтчета,1);
	СтруктураРеквизитовФормы.мГод = Лев(Прав(СтрПериодОтчета,7),4);
	
КонецПроцедуры

