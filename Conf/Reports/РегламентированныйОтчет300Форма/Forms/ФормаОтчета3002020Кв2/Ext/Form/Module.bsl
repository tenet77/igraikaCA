#Область РасшифровкаСКД

&НаКлиенте
Процедура ФормаРасшифровкаСКД(ИмяЯчейки)
	
	ИмяЯчейкиСтрокой = ПолучитьИмяЯчейкиПоКоду(ИмяЯчейки, ЭтаФорма);
	
	Если ИмяЯчейкиСтрокой = "300.00.010"
		ИЛИ ИмяЯчейкиСтрокой = "300.00.025.IV"
		ИЛИ ИмяЯчейкиСтрокой = "300.00.027.I" Тогда
		Возврат;//недропользователи;сельхозпроизводители
	КонецЕсли;
	
	ОтображатьПоказательСуммаВДекларации 	= Ложь;
	ОтображатьПоказательСуммаОборота		= Истина;
	ОтображатьПоказательСуммаНДС 			= Истина;
	
	// определим раздел формы для расшифровки
	РазделНДС = "НачисленныйНДС";
	ПредставлениеРазделаНДС = "Начисление НДС";
	
	
	Попытка
		СокращенныйКод = Число(Сред(ИмяЯчейки, 8,3));
		Если (Найти(ИмяЯчейкиСтрокой, "300.00") > 0 И СокращенныйКод >= 13 И СокращенныйКод <= 29)
			ИЛИ (Найти(ИмяЯчейкиСтрокой, "300.02") > 0 И СокращенныйКод >= 10)
			ИЛИ (Найти(ИмяЯчейкиСтрокой, "300.06") > 0 И СокращенныйКод >= 7)
			ИЛИ (Найти(ИмяЯчейкиСтрокой, "300.04") > 0)Тогда
			
			РазделНДС = "ЗачетныйНДС";
			ПредставлениеРазделаНДС = "Зачет НДС";
			ОтображатьПоказательСуммаВДекларации = Истина;
		Иначе

		КонецЕсли;
	Исключение
		
	КонецПопытки;
	
	// определим коды строк регистра для включения в расшифровку данной ячейки
	КодыСтрокРасшифровки = Форма300ПолучитьСписокКодовСтрокВключаемыхВРасшифровку(ИмяЯчейкиСтрокой);
	
	ПользовательскиеНастройки = Новый ПользовательскиеНастройкиКомпоновкиДанных;
	
	ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("НачалоПериода", 	СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета);
	ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("КонецПериода",  	СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета);
	ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("ТипДанных", 		"РегистрыНакопления");
	ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("ИмяОбъекта", 	"НДС");
	ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("ИмяТаблицы", 	"Обороты");
	ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("СхемаКомпоновкиДанных", ПолучитьАдресМакетаСКД(РазделНДС));
	
	// Отборы
	ПользовательскиеОтборы = ПользовательскиеНастройки.Элементы.Добавить(Тип("ОтборКомпоновкиДанных"));
	ПользовательскиеОтборы.ИдентификаторПользовательскойНастройки = "Отбор";
	
	// Сортировка
	ПользовательскиеСортировки = ПользовательскиеНастройки.Элементы.Добавить(Тип("ПорядокКомпоновкиДанных"));
	ПользовательскиеСортировки.ИдентификаторПользовательскойНастройки = "Порядок";
	
	НовыйЭлементПорядка = ПользовательскиеСортировки.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
	НовыйЭлементПорядка.Использование  = Истина;
	НовыйЭлементПорядка.Поле  = Новый ПолеКомпоновкиДанных("Регистратор.Дата");
	
	// Группировки	
	МассивГруппировок = Новый Массив();
	РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьГруппировку(МассивГруппировок,"КодСтроки", НСтр("ru = 'Код строки'"));
	Если РазделНДС = "НачисленныйНДС" Тогда
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьГруппировку(МассивГруппировок,"ВидОперацииРеализации", НСтр("ru = 'Вид операции реализации'"));
	Иначе
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьГруппировку(МассивГруппировок,"ВидОперацииПоступления", НСтр("ru = 'Вид операции поступления'"));
	КонецЕсли;
	
	ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("Группировка",  МассивГруппировок);
	
	// Параметры
	
	МассивПараметровДанных = Новый Массив();
	
	РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьПараметр(МассивПараметровДанных, "КодСтрокиРасшифровки", КодыСтрокРасшифровки);
	РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьПараметр(МассивПараметровДанных, "НачалоПериода", НачалоДня(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета));
	РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьПараметр(МассивПараметровДанных, "КонецПериода", КонецДня(СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета));
	РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьПараметр(МассивПараметровДанных, "Организация", СтруктураРеквизитовФормы.Организация);
	
	Если ИмяЯчейкиСтрокой = "300.00.004" Тогда
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьПараметр(МассивПараметровДанных, "Строка300_00_04", ИСТИНА);
	Иначе
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьПараметр(МассивПараметровДанных, "Строка300_00_04", ЛОЖЬ);
	КонецЕсли;
	
	// Метод отнесения НДС в зачет.
	// при расшифровке раздельного метода в расшифровку добавляем Вид оборота и Сумму в Декларации (сумма с учетом удельного веса)
	ПризнакРаздельногоМетода = ?((СтруктураРеквизитовФормы.мМетодРасчета = "Раздельный" И Найти(ИмяЯчейкиСтрокой, "300.04") = 0 И Найти(ИмяЯчейкиСтрокой, "300.00.028") = 0), Истина, Ложь);
	РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьПараметр(МассивПараметровДанных, "РаздельныйМетод", ПризнакРаздельногоМетода);
	
	
	//ПараметрыВывода.Значение = "Регистр налогового учета к строке "+ИмяЯчейки+" для Декларации по НДС";
	Если СтруктураДанныхФорма300Страница1.Свойство("П000010007002") Тогда
		УдельныйВес = ?(Не ЗначениеЗаполнено(СтруктураДанныхФорма300Страница1.П000010007002),
			1,СтруктураДанныхФорма300Страница1.П000010007002);
	Иначе
		УдельныйВес = 1;
	КонецЕсли;
	РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьПараметр(МассивПараметровДанных, "УдельныйВес", УдельныйВес);
	
	// Дополнительные отборы
	Если Найти(ИмяЯчейкиСтрокой, "300.00.003") > 0 Тогда
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьОтбор(ПользовательскиеОтборы, "СтавкаНДС.Ставка", 0, ВидСравненияКомпоновкиДанных.НеРавно);
		ОтображатьПоказательСуммаНДС 			= Истина;
		
	ИначеЕсли Найти(ИмяЯчейкиСтрокой, "300.00.002") > 0 Тогда
		// Корректировка по 0 ставке
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьОтбор(ПользовательскиеОтборы, "СтавкаНДС.Ставка", 0, ВидСравненияКомпоновкиДанных.Равно);
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьОтбор(ПользовательскиеОтборы, "СтавкаНДС.ДляОсвобожденногоОборота", Ложь, ВидСравненияКомпоновкиДанных.Равно);
		ОтображатьПоказательСуммаНДС = Ложь;
		
	ИначеЕсли Найти(ИмяЯчейкиСтрокой, "300.00.004") > 0 Тогда
		
		ОтображатьПоказательСуммаНДС = Ложь;
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьОтбор(ПользовательскиеОтборы,"ВидОперацииРеализации.НеЯвляетсяОборотомПоРеализации",
			Истина,
			ВидСравненияКомпоновкиДанных.Равно);
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьОтбор(ПользовательскиеОтборы, "СтавкаНДС.ДляОсвобожденногоОборота", Ложь, ВидСравненияКомпоновкиДанных.Равно);
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьОтбор(ПользовательскиеОтборы, "СтавкаНДС.МестоРеализацииНеРК", Истина, ВидСравненияКомпоновкиДанных.Равно);
		
	ИначеЕсли Найти(ИмяЯчейкиСтрокой, "300.00.005") > 0 Тогда
		
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьОтбор(ПользовательскиеОтборы, "СтавкаНДС.ДляОсвобожденногоОборота", Истина, ВидСравненияКомпоновкиДанных.Равно);
		ОтображатьПоказательСуммаНДС = Ложь;
		
	ИначеЕсли Найти(ИмяЯчейкиСтрокой, "300.00.015") > 0 Тогда
		
		ОтображатьПоказательСуммаВДекларации 	= Ложь;
		
	ИначеЕсли Найти(ИмяЯчейкиСтрокой, "300.00.017") > 0 Тогда
		
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьОтбор(ПользовательскиеОтборы, "СтавкаНДС.ДляОсвобожденногоОборота", Истина, ВидСравненияКомпоновкиДанных.Равно);
		ОтображатьПоказательСуммаНДС 			= Ложь;
		ОтображатьПоказательСуммаВДекларации 	= Ложь;
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьОтбор(ПользовательскиеОтборы, "СтавкаНДС.МестоРеализацииНеРК", Ложь, ВидСравненияКомпоновкиДанных.Равно);
		
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьОтбор(ПользовательскиеОтборы,"ВидОперацииРеализации.ВидНДС",
			ПредопределенноеЗначение("Перечисление.ВидыНДС.НДСУплачиваемыйПриИмпортеИзТаможенногоСоюза"),
			ВидСравненияКомпоновкиДанных.НеРавно);
		
	ИначеЕсли Найти(ИмяЯчейкиСтрокой, "300.00.018") > 0 Тогда
		
		ОтображатьПоказательСуммаНДС 			= Ложь;
		ОтображатьПоказательСуммаВДекларации 	= Ложь;
		
	ИначеЕсли Найти(ИмяЯчейкиСтрокой, "300.01") > 0 Тогда
		// 0 ставка НДС
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьОтбор(ПользовательскиеОтборы, "СтавкаНДС.ДляОсвобожденногоОборота", Ложь, ВидСравненияКомпоновкиДанных.Равно);
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьОтбор(ПользовательскиеОтборы, "СтавкаНДС.Ставка", 0, ВидСравненияКомпоновкиДанных.Равно);
		ОтображатьПоказательСуммаНДС = Ложь;
		
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьОтбор(ПользовательскиеОтборы,"ВидОперацииРеализации.ВидНДС",
			ПредопределенноеЗначение("Перечисление.ВидыНДС.НДСУплачиваемыйПриИмпортеМетодомЗачета"),
			ВидСравненияКомпоновкиДанных.НеРавно);
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьОтбор(ПользовательскиеОтборы,"ВидОперацииРеализации.ВидНДС",
			ПредопределенноеЗначение("Перечисление.ВидыНДС.НДСУплачиваемыйПриИмпортеИзТаможенногоСоюза"),
			ВидСравненияКомпоновкиДанных.НеРавно);
		
	ИначеЕсли Найти(ИмяЯчейкиСтрокой, "300.02") >0 Тогда
		// Без НДС (освобожденные обороты)
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьОтбор(ПользовательскиеОтборы, "СтавкаНДС.ДляОсвобожденногоОборота", Истина, ВидСравненияКомпоновкиДанных.Равно);
		ОтображатьПоказательСуммаНДС = Ложь;
		// освобожденный импорт, к его показателям не применяется удельный вес
		ОтображатьПоказательСуммаВДекларации 	= Ложь;
		
		Если РазделНДС = "ЗачетныйНДС" Тогда
			
			РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьОтбор(ПользовательскиеОтборы, "СтавкаНДС.МестоРеализацииНеРК", Ложь, ВидСравненияКомпоновкиДанных.Равно);
			
			РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьОтбор(ПользовательскиеОтборы,"ВидОперацииРеализации.ВидНДС",
				ПредопределенноеЗначение("Перечисление.ВидыНДС.НДСУплачиваемыйПриИмпортеИзТаможенногоСоюза"),
				ВидСравненияКомпоновкиДанных.НеРавно);
			
		КонецЕсли;
		
	ИначеЕсли Найти(ИмяЯчейкиСтрокой, "300.04") > 0 Тогда
		// НДС методом зачета, к его показателям не применяется удельный вес
		ОтображатьПоказательСуммаВДекларации 	= Ложь;
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьОтбор(ПользовательскиеОтборы,"ВидОперацииПоступления.ВидНДС",
			ПредопределенноеЗначение("Перечисление.ВидыНДС.НДСУплачиваемыйПриИмпортеМетодомЗачета"),
			ВидСравненияКомпоновкиДанных.Равно);
	ИначеЕсли ИмяЯчейкиСтрокой =  "300.06.004" Тогда
		// Корректировка по облагаемым оборотам
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьОтбор(ПользовательскиеОтборы, "СтавкаНДС.Ставка", 0, ВидСравненияКомпоновкиДанных.НеРавно);
		
	ИначеЕсли ИмяЯчейкиСтрокой =  "300.06.005" Тогда
		// Корректировка по 0 ставке
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьОтбор(ПользовательскиеОтборы, "СтавкаНДС.Ставка", 0, ВидСравненияКомпоновкиДанных.Равно);
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьОтбор(ПользовательскиеОтборы, "СтавкаНДС.ДляОсвобожденногоОборота", Ложь, ВидСравненияКомпоновкиДанных.Равно);
		ОтображатьПоказательСуммаНДС = Ложь;
		
	ИначеЕсли ИмяЯчейкиСтрокой =  "300.06.006" Тогда
		// Корректировка освобожденного оборота
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьОтбор(ПользовательскиеОтборы, "СтавкаНДС.ДляОсвобожденногоОборота", Истина, ВидСравненияКомпоновкиДанных.Равно);
		ОтображатьПоказательСуммаНДС = Ложь;
		
	ИначеЕсли ИмяЯчейкиСтрокой =  "300.00.013.I" Тогда
		// Корректировка освобожденного оборота
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьОтбор(ПользовательскиеОтборы, "ОборотыПоСчетуФактуре", Истина, ВидСравненияКомпоновкиДанных.Равно);
		
	ИначеЕсли ИмяЯчейкиСтрокой =  "300.00.013.II" Тогда
		// Корректировка освобожденного оборота
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьОтбор(ПользовательскиеОтборы, "ОборотыПоСчетуФактуре", Ложь, ВидСравненияКомпоновкиДанных.Равно);
		
		
	ИначеЕсли ИмяЯчейкиСтрокой =  "300.00.001.I" Тогда
		// Корректировка освобожденного оборота
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьОтбор(ПользовательскиеОтборы, "ОборотыПоСчетуФактуре", Истина, ВидСравненияКомпоновкиДанных.Равно);
		
	ИначеЕсли ИмяЯчейкиСтрокой =  "300.00.001.II" Тогда
		// Корректировка освобожденного оборота
		//СписокОтбор = Новый Массив;
		//СписокОтбор.Добавить(Ложь);
		//СписокОтбор.Добавить(Неопределено);
		//СписокОтбор.Добавить(Null);
		//РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьОтбор(ПользовательскиеОтборы, "ОборотыПоСчетуФактуре", СписокОтбор, ВидСравненияКомпоновкиДанных.ВСписке);
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьОтбор(ПользовательскиеОтборы, "ОборотыПоСчетуФактуре", Ложь, ВидСравненияКомпоновкиДанных.Равно);
		
		
	КонецЕсли;
	
	ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("ПараметрыДанных", МассивПараметровДанных);
	
	ПользовательскиеПоля = ПользовательскиеНастройки.Элементы.Добавить(Тип("ВыбранныеПоляКомпоновкиДанных"));
	ПользовательскиеПоля.ИдентификаторПользовательскойНастройки = "Выбор";
	
	Если ОтображатьПоказательСуммаОборота Тогда
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьВыбранноеПоле(ПользовательскиеПоля, "СуммаОборота", "Оборот по реализации");
	КонецЕсли;
	Если ОтображатьПоказательСуммаВДекларации Тогда
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьВыбранноеПоле(ПользовательскиеПоля, "СуммаВДекларации", "Сумма в декларации");
	КонецЕсли;
	Если ОтображатьПоказательСуммаНДС Тогда
		РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьВыбранноеПоле(ПользовательскиеПоля, "СуммаНДС", "Сумма НДС");
	КонецЕсли;
	
	РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьВыбранноеПоле(ПользовательскиеПоля, "Контрагент", "Контрагент");
	РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьВыбранноеПоле(ПользовательскиеПоля, "ИИН_БИН", "ИИН/БИН контрагента");
	РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьВыбранноеПоле(ПользовательскиеПоля, "Регистратор", "Документ");
	РегламентированнаяОтчетностьКлиентСерверРК.ДобавитьВыбранноеПоле(ПользовательскиеПоля, "СтавкаНДС", "Ставка НДС");
	
	// Прочие настройки
	ТекстЗаголовка = НСТР("ru = 'Регистр налогового учета к строке %1 для Декларации по НДС'");
	ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("Заголовок", СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстЗаголовка, ИмяЯчейкиСтрокой));
	ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("ВыводитьЗаголовок", Истина);
	ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("ВыводитьПодписи", Истина);
	
	ИмяРазделаРасшифровки = "Декларация по НДС:" + СтруктураРеквизитовФормы.мГод + ", " + ПредставлениеРазделаНДС;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВидРасшифровки", 2);
	ПараметрыФормы.Вставить("РежимРасшифровки", Истина);
	ПараметрыФормы.Вставить("ПользовательскиеНастройки", ПользовательскиеНастройки);
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
	ПараметрыФормы.Вставить("ВыводитьЗаголовок", Истина);
	ПараметрыФормы.Вставить("КлючНазначенияИспользования", ИмяРазделаРасшифровки);
	
	ОткрытьФорму("Отчет.РасшифровкаРегламентированныхОтчетов.Форма.ФормаОтчета", ПараметрыФормы,, Истина);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьИмяЯчейкиПоКоду(ИмяЯчейки, Форма)
	
	Раздел = Число(Сред(ИмяЯчейки,4,2));
	Ячейка = Число(Сред(ИмяЯчейки,8,3));
	Если СтрДлина(ИмяЯчейки)>13 Тогда
		Префикс = Число(Сред(ИмяЯчейки,11,2));
	Иначе
		Префикс = Число(Сред(ИмяЯчейки,11,1));
	КонецЕсли;
	
	ИмяСтрокой = "300." + Формат(Раздел, "ЧЦ=2; ЧН=00; ЧВН=") + "." + Формат(Ячейка, "ЧЦ=3; ЧВН=");
	
	Если Префикс = 0 Тогда
		//Возврат ИмяСтрокой;
	ИначеЕсли Префикс = 1 Тогда
		ИмяСтрокой = ИмяСтрокой + "." + "I";
	ИначеЕсли Префикс = 2 Тогда
		ИмяСтрокой = ИмяСтрокой + "." + "II";
	ИначеЕсли Префикс = 3 Тогда
		ИмяСтрокой = ИмяСтрокой + "." + "III";
	ИначеЕсли Префикс = 4 Тогда
		ИмяСтрокой = ИмяСтрокой + "." + "IV";
	ИначеЕсли Префикс = 5 Тогда
		ИмяСтрокой = ИмяСтрокой + "." + "V";
	ИначеЕсли Префикс = 6 Тогда
		ИмяСтрокой = ИмяСтрокой + "." + "VI";
	ИначеЕсли Префикс = 7 Тогда
		ИмяСтрокой = ИмяСтрокой + "." + "VII";
	ИначеЕсли Префикс = 8 Тогда
		ИмяСтрокой = ИмяСтрокой + "." + "VIII";
	ИначеЕсли Префикс = 9 Тогда
		ИмяСтрокой = ИмяСтрокой + "." + "IX";
	ИначеЕсли Префикс = 10 Тогда
		ИмяСтрокой = ИмяСтрокой + "." + "X";
	Иначе
		//Возврат ИмяСтрокой;
	КонецЕсли;
	
	Если СтрНайти(ИмяСтрокой, "300.01.003.") <> 0 Тогда
		
		НомерСтроки = Сред(ИмяСтрокой, 12, 1);
		НазваниеСтроки = "s_300_01_" + Сред(ИмяСтрокой, 8, 3) + "_text__" + Префикс;
		
		НаименованиеПоКлассификатору = "";
		Если Форма.СтруктураДанныхФорма300_01Страница1.Свойство(НазваниеСтроки) Тогда
			НаименованиеПоКлассификатору = Форма.СтруктураДанныхФорма300_01Страница1[НазваниеСтроки];
		КонецЕсли;	
		
		ИмяСтрокой = Сред(ИмяСтрокой, 1, 11) + СтрЗаменить(НаименованиеПоКлассификатору, "-", ".");

	ИначеЕсли СтрНайти(ИмяСтрокой, "300.02.001.") <> 0 ИЛИ СтрНайти(ИмяСтрокой, "300.02.010.") <> 0 Тогда
		
		НомерСтроки = Сред(ИмяСтрокой, 12, 1);
		НазваниеСтроки = "s_300_02_" + Сред(ИмяСтрокой, 8, 3) + "_text__" + Префикс;
		
		НаименованиеПоКлассификатору = "";
		Если Форма.СтруктураДанныхФорма300_02Страница1.Свойство(НазваниеСтроки) Тогда
			НаименованиеПоКлассификатору = Форма.СтруктураДанныхФорма300_02Страница1[НазваниеСтроки];
		КонецЕсли;	
		
		ИмяСтрокой = Сред(ИмяСтрокой, 1, 11) + СтрЗаменить(НаименованиеПоКлассификатору, "-", ".");
	ИначеЕсли СтрНайти(ИмяСтрокой, "300.06.001.") <> 0 ИЛИ СтрНайти(ИмяСтрокой, "300.06.006.") <> 0 ИЛИ  СтрНайти(ИмяСтрокой, "300.06.007.") Тогда
		
		НомерСтроки = Сред(ИмяСтрокой, 12, 1);
		НазваниеСтроки = "s_300_06_" + Сред(ИмяСтрокой, 8, 3) + "_text__" + Префикс;
		
		НаименованиеПоКлассификатору = "";
		Если Форма.СтруктураДанныхФорма300_06Страница1.Свойство(НазваниеСтроки) Тогда
			НаименованиеПоКлассификатору = Форма.СтруктураДанныхФорма300_06Страница1[НазваниеСтроки];
		КонецЕсли;	
		
		ИмяСтрокой = Сред(ИмяСтрокой, 1, 11) + СтрЗаменить(НаименованиеПоКлассификатору, "-", ".");	
	КонецЕсли;
	
	Возврат ИмяСтрокой;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция Форма300ПолучитьСписокКодовСтрокВключаемыхВРасшифровку(ИмяЯчейки)
	
	КодыСтрокРасшифровки = Новый СписокЗначений;
	
	Если ИмяЯчейки = "300.00.002" Тогда
		
		КодыСтрокРасшифровки.Добавить("300.00.002");
		
		КодыСтрокРасшифровки.Добавить("300.01.001");
		КодыСтрокРасшифровки.Добавить("300.01.002");
		КодыСтрокРасшифровки.Добавить("300.01.003");
		
		
		КодыСтрокРасшифровки.Добавить("300.06.005");
		
	ИначеЕсли ИмяЯчейки = "300.00.003" Тогда
		
		КодыСтрокРасшифровки.Добавить("300.06.001");
		
	ИначеЕсли Найти(ИмяЯчейки,"300.00.013")>0 Тогда
		
		КодыСтрокРасшифровки.Добавить("300.00.013");
		
	ИначеЕсли Найти(ИмяЯчейки,"300.00.001")>0 Тогда
		
		КодыСтрокРасшифровки.Добавить("300.00.001");
		
	ИначеЕсли ИмяЯчейки = "300.00.005" Тогда
		
		Для Сч = 1 по 5 Цикл
			КодыСтрокРасшифровки.Добавить("300.02.0"+ Формат(Сч, "ЧЦ=2; ЧН=; ЧВН="));
		КонецЦикла;
		Для Сч = 1 по 8 Цикл
			КодыСтрокРасшифровки.Добавить("300.06.0"+ Формат(Сч, "ЧЦ=2; ЧН=; ЧВН="));
		КонецЦикла;
		
	ИначеЕсли ИмяЯчейки = "300.00.014" Тогда
		
		КодыСтрокРасшифровки.Добавить("300.00.014");
		// НДС за нерезидента
		Для Сч = 1 по 7 Цикл
			КодыСтрокРасшифровки.Добавить("300.05.0"+ Формат(Сч, "ЧЦ=2; ЧН=; ЧВН="));
		КонецЦикла;
		
	ИначеЕсли ИмяЯчейки = "300.00.017" Тогда
		
		Для Сч = 10 по 13 Цикл
			КодыСтрокРасшифровки.Добавить("300.02.0"+ Формат(Сч, "ЧЦ=2; ЧН=; ЧВН="));
		КонецЦикла;
		
	ИначеЕсли ИмяЯчейки = "300.00.019" Тогда
		
		КодыСтрокРасшифровки.Добавить("300.03.001");
		КодыСтрокРасшифровки.Добавить("300.03.002");
		
	ИначеЕсли ИмяЯчейки = "300.00.022" Тогда
		
		Для Сч = 7 по 9 Цикл
			КодыСтрокРасшифровки.Добавить("300.06.0"+ Формат(Сч, "ЧЦ=2; ЧН=; ЧВН="));
		КонецЦикла;
		
	ИначеЕсли ИмяЯчейки = "300.00.029" Тогда
		
		КодыСтрокРасшифровки.Добавить("300.00.029");
		КодыСтрокРасшифровки.Добавить("300.04.001");
		
	ИначеЕсли ИмяЯчейки = "300.01.004" Тогда
		// итоговая строка
		Для Сч = 1 по 3 Цикл
			КодыСтрокРасшифровки.Добавить("300.01.0"+ Формат(Сч, "ЧЦ=2; ЧН=; ЧВН="));
		КонецЦикла;
		
	ИначеЕсли ИмяЯчейки = "300.02.009" Тогда
		// итоговая строка
		Для Сч = 1 по 8 Цикл
			КодыСтрокРасшифровки.Добавить("300.02.0"+ Формат(Сч, "ЧЦ=2; ЧН=; ЧВН="));
		КонецЦикла;
		
	ИначеЕсли ИмяЯчейки = "300.02.014" Тогда
		// итоговая строка
		Для Сч = 10 по 13 Цикл
			КодыСтрокРасшифровки.Добавить("300.02.0"+ Формат(Сч, "ЧЦ=2; ЧН=; ЧВН="));
		КонецЦикла;
		
	ИначеЕсли ИмяЯчейки = "300.06.004" Тогда
		
		Для Сч = 1 по 3 Цикл
			КодыСтрокРасшифровки.Добавить("300.06.0"+ Формат(Сч, "ЧЦ=2; ЧН=; ЧВН="));
		КонецЦикла;
		
	ИначеЕсли ИмяЯчейки = "300.06.010" Тогда
		// итоговая строка
		Для Сч = 7 по 9 Цикл
			КодыСтрокРасшифровки.Добавить("300.06.0"+ Формат(Сч, "ЧЦ=2; ЧН=; ЧВН="));
		КонецЦикла;
		
	Иначе
		
		КодыСтрокРасшифровки.Добавить(ИмяЯчейки);
		
	КонецЕсли;
	
	Возврат КодыСтрокРасшифровки;
	
КонецФункции

&НаСервере
Функция ПолучитьАдресМакетаСКД(знач ИмяРаздела)
	
	ОбщаяСКД = РеквизитФормыВЗначение("Отчет").ПолучитьМакет("МакетСКДФорма3002020Кв2");
