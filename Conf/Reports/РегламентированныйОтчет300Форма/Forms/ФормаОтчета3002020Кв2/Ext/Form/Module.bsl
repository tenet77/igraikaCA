&НаКлиенте
Процедура ПослеВыбораНалоговогоКомитета(ВыбЭлемент, Параметры) Экспорт
	
	ПоменялсяНалоговыйКомитет = Ложь;
	
	Если ЗначениеЗаполнено(ВыбЭлемент) Тогда
		ПоменялсяНалоговыйКомитет = НЕ(СтруктураРеквизитовФормы.НалоговыйКомитет = ВыбЭлемент);
		СтруктураРеквизитовФормы.НалоговыйКомитет = ВыбЭлемент;
	КонецЕсли;
	
	Если ПоменялсяНалоговыйКомитет Тогда
		ЗаполнитьСведенияОбОрганизацииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуРасшифровки(ИмяЯчейки,ИмяБезПрефикса,Многострочность)
	
	Если Многострочность Тогда
		
		Позиция = СтрНайти(ИмяЯчейки,"_");
		Индекс = Число(СокрЛП(Прав(ИмяЯчейки,СтрДлина(ИмяЯчейки)- Позиция))) - 1;
		ИмяТаблицы = СокрЛП(Лев(ИмяЯчейки,11));
		
		Если Индекс < ЭтаФорма[ИмяТаблицы].Количество() Тогда
			ЗначениеРасшифровки = ЭтаФорма[ИмяТаблицы][Индекс][ИмяБезПрефикса + "_Расшифровка"];
		Иначе
			Возврат;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЗначениеРасшифровки) Тогда
			ПоказатьЗначение(,ЗначениеРасшифровки);
		Иначе
			//Вход на ручной ввод ссылочных элементов
		КонецЕсли;
		
	Иначе
		
		//вход на обработку вывода ссылок не многострочных форм
		
	КонецЕсли;
	
КонецПроцедуры

