	СтруктураФормы = Новый Структура;
	СтруктураФормы.Вставить("ЛистA", П0008100001);
	СтруктураФормы.Вставить("ЛистB", П0008200002);
	СтруктураФормы.Вставить("ЛистC", П0008300001);
	
	ТаблицаДанныхA = Новый ТаблицаЗначений;              	
	ТаблицаДанныхA.Колонки.Добавить("НомерСтроки",,               "Номер строки");
	ТаблицаДанныхA.Колонки.Добавить("СтатусПоставщика",,          "Статус поставщика");
	ТаблицаДанныхA.Колонки.Добавить("ИННБИНПоставщика",,          "ИИН (БИН) поставщика");
	ТаблицаДанныхA.Колонки.Добавить("НомерСФ",,                   "Номер счета-фактуры");
	ТаблицаДанныхA.Колонки.Добавить("ДатаСФ",,                    "Дата выписки счета - фактуры");	
	ТаблицаДанныхA.Колонки.Добавить("ВидСФПрав",,                 "Признак счета-фактуры");
	ТаблицаДанныхA.Колонки.Добавить("СтоимостьБезНДС",,           "Всего стоимость по счету-фактуре (документу)  без учета НДС");
	ТаблицаДанныхA.Колонки.Добавить("СуммаНДССФ",,                "Сумма НДС, указанного в счете-фактуре  (документе)");
	ТаблицаДанныхA.Колонки.Добавить("СуммаНДСВЗачет",,            "Сумма НДС, подлежащего отнесению в зачет");
	ТаблицаДанныхA.Колонки.Добавить("ВидПолезногоИскопаемого",,   "Вид полезного ископаемого");
	ТаблицаДанныхA.Колонки.Добавить("ОбъемПолезногоИскопаемого",, "Объем полезного ископаемого");
	ТаблицаДанныхA.Колонки.Добавить("ЕдиницаИзмерения",,          "Единицы измерения");
	
	ТаблицаДанныхB = Новый ТаблицаЗначений;
	ТаблицаДанныхB.Колонки.Добавить("НомерСФ");
	ТаблицаДанныхB.Колонки.Добавить("ДатаСФ");	
	ТаблицаДанныхB.Колонки.Добавить("ВидСФПрав");

	ТаблицаДанныхC = Новый ТаблицаЗначений;
	ТаблицаДанныхC.Колонки.Добавить("СтоимостьБезНДС");
	ТаблицаДанныхC.Колонки.Добавить("СуммаНДССФ");
	ТаблицаДанныхC.Колонки.Добавить("СуммаНДСВЗачет");
	
	ТаблицаДанныхD = Новый ТаблицаЗначений;
	ТаблицаДанныхD.Колонки.Добавить("ВидПолезногоИскопаемого");
	ТаблицаДанныхD.Колонки.Добавить("ОбъемПолезногоИскопаемого");
	ТаблицаДанныхD.Колонки.Добавить("ЕдиницаИзмерения");
		                            	
	Для Каждого ЭлементСтруктуры Из СтруктураФормы Цикл
		
		ИмяГруппы 	= ЭлементСтруктуры.Ключ;
		ТаблицаСтрокГруппы = ЭлементСтруктуры.Значение;
				
		Для Каждого Элемент Из ТаблицаСтрокГруппы Цикл
		
			Если ИмяГруппы = "ЛистA" Тогда
				
				НоваяСтрокаДанных = ТаблицаДанныхA.Добавить();	
			
				//Так должны заполнять по отдельности значения выборки 
				//для каждого листа
				НоваяСтрокаДанных.НомерСтроки 	   = Элемент.П000810000101;
				НоваяСтрокаДанных.СтатусПоставщика = Элемент.П000810000102;
				Если ЗначениеЗаполнено(Элемент.П000810000103) Тогда 
					НоваяСтрокаДанных.ИННБИНПоставщика = Элемент.П000810000103;
				КонецЕсли;
				
				НоваяСтрокаДанных.НомерСФ 		   = Элемент.П000810000104;
				Если ЗначениеЗаполнено(Элемент.П000810000105) Тогда
					НоваяСтрокаДанных.ДатаСФ	   = НачалоДня(Элемент.П000810000105);
				КонецЕсли;
				Если ЗначениеЗаполнено(Элемент.П000810000106) Тогда
					НоваяСтрокаДанных.ВидСФПрав	   = Элемент.П000810000106;
				КонецЕсли;
				
			ИначеЕсли ИмяГруппы = "ЛистB" Тогда

				НоваяСтрокаДанных = ТаблицаДанныхC.Добавить();	

				НоваяСтрокаДанных.СтоимостьБезНДС = Элемент.П000820000202;
				НоваяСтрокаДанных.СуммаНДССФ 	  = Элемент.П000820000203;
				НоваяСтрокаДанных.СуммаНДСВЗачет  = Элемент.П000820000204;
				
			ИначеЕсли ИмяГруппы = "ЛистC" Тогда
				
				НоваяСтрокаДанных = ТаблицаДанныхD.Добавить();	

				НоваяСтрокаДанных.ВидПолезногоИскопаемого	= Элемент.П000830000102;
				НоваяСтрокаДанных.ОбъемПолезногоИскопаемого = Элемент.П000830000103;
				НоваяСтрокаДанных.ЕдиницаИзмерения          = Элемент.П000830000104;
				
			КонецЕсли;
			
		КонецЦикла;
	
	КонецЦикла;
	
	// сводная таблица
	ТаблицаДанныхA.ЗагрузитьКолонку(ТаблицаДанныхB.ВыгрузитьКолонку("НомерСФ"),                   "НомерСФ");
	ТаблицаДанныхA.ЗагрузитьКолонку(ТаблицаДанныхB.ВыгрузитьКолонку("ДатаСФ"),                    "ДатаСФ");	
    ТаблицаДанныхA.ЗагрузитьКолонку(ТаблицаДанныхB.ВыгрузитьКолонку("ВидСФПрав"),                 "ВидСФПрав");
	ТаблицаДанныхA.ЗагрузитьКолонку(ТаблицаДанныхC.ВыгрузитьКолонку("СтоимостьБезНДС"),           "СтоимостьБезНДС");
	ТаблицаДанныхA.ЗагрузитьКолонку(ТаблицаДанныхC.ВыгрузитьКолонку("СуммаНДССФ"),                "СуммаНДССФ");
	ТаблицаДанныхA.ЗагрузитьКолонку(ТаблицаДанныхC.ВыгрузитьКолонку("СуммаНДСВЗачет"),            "СуммаНДСВЗачет");
    ТаблицаДанныхA.ЗагрузитьКолонку(ТаблицаДанныхD.ВыгрузитьКолонку("ВидПолезногоИскопаемого"),	  "ВидПолезногоИскопаемого");
	ТаблицаДанныхA.ЗагрузитьКолонку(ТаблицаДанныхD.ВыгрузитьКолонку("ОбъемПолезногоИскопаемого"), "ОбъемПолезногоИскопаемого");
	ТаблицаДанныхA.ЗагрузитьКолонку(ТаблицаДанныхD.ВыгрузитьКолонку("ЕдиницаИзмерения"),          "ЕдиницаИзмерения");
	
	Возврат ТаблицаДанныхA
КонецФункции

&НаСервере
Функция Форма300_08ПолучитьСтруктуруСоответствияПолейРеестраExcel()
	
	СтруктураСоответствияПолей = Новый Структура();
	
	СтруктураСоответствияПолей.Вставить("НомерСтроки",                1);
	СтруктураСоответствияПолей.Вставить("СтатусПоставщика",           2);
	СтруктураСоответствияПолей.Вставить("РННПоставщика",              3);
	СтруктураСоответствияПолей.Вставить("ИННБИНПоставщика",           4);
	СтруктураСоответствияПолей.Вставить("НомерСФ",                    5);
	СтруктураСоответствияПолей.Вставить("ДатаСФ",                     6);	
	СтруктураСоответствияПолей.Вставить("ВидСФПрав",                  7);
	СтруктураСоответствияПолей.Вставить("СтоимостьБезНДС",            8);
	СтруктураСоответствияПолей.Вставить("СуммаНДССФ",                 9);
	СтруктураСоответствияПолей.Вставить("СуммаНДСВЗачет",            10);
	СтруктураСоответствияПолей.Вставить("ВидПолезногоИскопаемого", 	 11);
	СтруктураСоответствияПолей.Вставить("ОбъемПолезногоИскопаемого", 12);
	СтруктураСоответствияПолей.Вставить("ЕдиницаИзмерения",          13);

	
	Возврат СтруктураСоответствияПолей;
КонецФункции

&НаСервере
Функция Форма300_08ПолучитьСтруктуруИтоговыхПолейРеестраExcel()
	СтруктураИтоговыхПолей = Новый Структура;
	
	СтруктураИтоговыхПолей.Вставить("СтоимостьБезНДС", 8);
	СтруктураИтоговыхПолей.Вставить("СуммаНДССФ",      9);
	СтруктураИтоговыхПолей.Вставить("СуммаНДСВЗачет",  10);
	
	Возврат СтруктураИтоговыхПолей;
КонецФункции

#Если Не ВебКлиент Тогда
	
&НаКлиенте
Функция ВыгрузитьДанныеРеестраВExcelНаКлиенте(ИмяФормы, АдресФайлаШаблона, АдресРеестра, ИмяЛиста, НомерНачальнойСтрокиExcel, КоличествоЗаписей)

	Результат = Новый Структура("АдресФайлаExcel", Неопределено);
	
	Реестр = ПолучитьИзВременногоХранилища(АдресРеестра);
	
	// Сохраним шаблон во временный файл
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайлаШаблона);	
	ИмяВременногоШаблона = ПолучитьИмяВременногоФайла("xls");
	ДвоичныеДанные.Записать(ИмяВременногоШаблона);
	
	СтруктураСоответствияПолей = ПолучитьСтруктуруСоответствияПолейРеестраExcel(ИмяФормы);
	
	Попытка
		ОбъектЭксель = Новый COMОбъект("Excel.Application");
		ОбъектЭксель.ScreenUpdating = Ложь;
		ОбъектЭксель.EnableEvents = Ложь;
	Исключение		
		ТекстСообщения = НСтр("ru = 'Не удалось создать объект Excel.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);

		Возврат Результат;
	КонецПопытки;
	
	Попытка
		НоваяКнига = ОбъектЭксель.Workbooks.Add(ИмяВременногоШаблона);
	Исключение
		
		ТекстСообщения = НСтр("ru = 'Не удалось создать новый документ Excel, на основании указанного шаблона!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		
		Возврат Результат;
	КонецПопытки;

	Если КоличествоЗаписей > 65500 Тогда
		ВсегоСтраниц =  Цел(КоличествоЗаписей/65500);
		Если ВсегоСтраниц = КоличествоЗаписей/65500  Тогда
			ВсегоСтраниц = ВсегоСтраниц;
		Иначе
			ВсегоСтраниц = ВсегоСтраниц + 1;
		КонецЕсли;
	Иначе
		ВсегоСтраниц = 1;
	КонецЕсли;
	
	// переходим на лист для заполнения данных.
	// Если вместо шаблона Excel была указана книга Excel, на этом этапе может возникнуть ошибка.
    Попытка
		РабочийЛистКниги = НоваяКнига.Sheets.Item(ИмяЛиста);
	Исключение
		
		ТекстСообщения = НСтр("ru = 'Возникла ошибка при обработке документа Excel. Проверьте правильность указания шаблона формы.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		
		Возврат Результат;
	КонецПопытки;
	
	Если ВсегоСтраниц > 1 Тогда
		РабочийЛистКниги.Copy(,РабочийЛистКниги);
	КонецЕсли;
	
	НомерТекущейСтроки = НомерНачальнойСтрокиExcel;	     
	НомерПП = 0;
	КоличествоСтрок = КоличествоЗаписей;//ТаблицаДанныхДляВыгрузки.Количество();
	ТекСтр = 1;
	
	СтруктураСоответствияКолонок = Новый Структура;
	Для Каждого КлючИЗначение Из СтруктураСоответствияПолей Цикл
		Для НомерКолонки = 1 По СтруктураСоответствияПолей.Количество() Цикл
			ОбластьЗаголовок = Реестр.Область("R1C" + НомерКолонки);
			Если СокрЛП(ОбластьЗаголовок.Текст) = КлючИЗначение.Ключ Тогда
				СтруктураСоответствияКолонок.Вставить(КлючИЗначение.Ключ, НомерКолонки);
			КонецЕсли;	
		КонецЦикла;	
		
	КонецЦикла;	
	
	Для НомерСтроки = 2 По КоличествоЗаписей+1 Цикл
		НомерПП = НомерПП + 1;
		
		Если НомерПП > ТекСтр * 65500 Тогда
			ТекСтр = ТекСтр + 1;
			РабочийЛистКниги = НоваяКнига.Sheets.Item(ИмяЛиста + " (" + ТекСтр + ")");							
			НомерТекущейСтроки = НомерНачальнойСтрокиExcel;	     
			// проверим нужно ли еще добавлять листы
			Если ТекСтр < ВсегоСтраниц Тогда
				РабочийЛистКниги.Copy(,РабочийЛистКниги);
			КонецЕсли;
		КонецЕсли;
		Для Каждого КлючИЗначение Из СтруктураСоответствияПолей Цикл
			Если КлючИЗначение.Ключ = "НомерСтроки" 
			 ИЛИ КлючИЗначение.Ключ = "СтатусПоставщика"
			 ИЛИ КлючИЗначение.Ключ = "РННПоставщика"
			 ИЛИ КлючИЗначение.Ключ = "РННПокупателя"
			 ИЛИ КлючИЗначение.Ключ = "ИННБИНПоставщика" 
			 ИЛИ КлючИЗначение.Ключ = "ИННБИНПокупателя" 
			 ИЛИ КлючИЗначение.Ключ = "ИННПокупателя" 
			 ИЛИ КлючИЗначение.Ключ = "КПППокупателя" 
			 ИЛИ КлючИЗначение.Ключ = "УНППокупателя" 
			 ИЛИ КлючИЗначение.Ключ = "ВидОборота" 			 
			 ИЛИ КлючИЗначение.Ключ = "ВидСФЛев" 
			 ИЛИ КлючИЗначение.Ключ = "ВидСФПрав" 
			 ИЛИ КлючИЗначение.Ключ = "НомерСФ" Тогда
				РабочийЛистКниги.Cells(НомерТекущейСтроки,КлючИЗначение.Значение).NumberFormat = "@";  // текстовый формат
			КонецЕсли;
			
			Если КлючИЗначение.Ключ = "СтоимостьБезНДС"
			 ИЛИ КлючИЗначение.Ключ = "СуммаНДССФ" 
			 ИЛИ КлючИЗначение.Ключ = "СуммаНДСВЗачет"
			 ИЛИ КлючИЗначение.Ключ = "СуммаНДСНачисленного" Тогда
			 	РабочийЛистКниги.Cells(НомерТекущейСтроки,КлючИЗначение.Значение).NumberFormat = "0";  // числовой формат
			КонецЕсли;
			
			Если КлючИЗначение.Ключ = "ДатаСФ"
				ИЛИ КлючИЗначение.Ключ = "ДатаОборотаПоРеализации" Тогда
				РабочийЛистКниги.Cells(НомерТекущейСтроки,КлючИЗначение.Значение).NumberFormat = ""; // Формат даты Selection.NumberFormat = "m/d/yyyy"
			КонецЕсли;	
			
			Попытка
				ТекстОбласти = Реестр.Область("R" + Формат(НомерСтроки,"ЧЦ=10; ЧГ=0") + "C" + СтруктураСоответствияКолонок[КлючИЗначение.Ключ]).Текст;
				Если (КлючИЗначение.Ключ = "СтоимостьБезНДС" 
					ИЛИ КлючИЗначение.Ключ = "СуммаНДССФ" 
				 	ИЛИ КлючИЗначение.Ключ = "СуммаНДСВЗачет"
				 	ИЛИ КлючИЗначение.Ключ = "СуммаНДСНачисленного") и ЗначениеЗаполнено(ТекстОбласти) Тогда
				 			ТекстОбласти = Число(ТекстОбласти);
				КонецЕсли;
				РабочийЛистКниги.Cells(НомерТекущейСтроки,КлючИЗначение.Значение).Value = ?(ТекстОбласти="", Неопределено, ТекстОбласти);			
			Исключение
				ТекстСообщения = НСтр("ru = 'При выгрузке строки № %1 произошла ошибка. Строка выгружена частично...'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, СокрЛП(НомерТекущейСтроки));
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				Продолжить;
			КонецПопытки
			
		КонецЦикла;
	
		НомерТекущейСтроки = НомерТекущейСтроки + 1;
	КонецЦикла;

	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xls");
	НоваяКнига.SaveAs(ИмяВременногоФайла, 56); //  XlExcel8 (Microsoft Office 97-2003)
	
	ТекстСообщения = НСтр("ru = 'Формирование книги Excel завершено.'");
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		
	ОбъектЭксель.Quit();
	ОбъектЭксель = Неопределено;
	
	//////////////////////////////////////////////////////////////////////////////
	// Сохранить результат.	
	ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
	Результат.АдресФайлаExcel = ПоместитьВоВременноеХранилище(ДвоичныеДанные, ЭтаФорма.УникальныйИдентификатор);
		
	УдалитьФайлы(ИмяВременногоФайла);
	
	Возврат Результат;

КонецФункции	

#КонецЕсли

&НаКлиенте
Функция УниверсальнаяВыгрузка(ТекстВыгрузки = Неопределено, ПроверятьБлокировки = Истина, ИмяФайлаВыгрузки = "", ВыгружатьСОшибками = Ложь) Экспорт
	
	Перем ПараметрыВыгрузки;
	
	Если Модифицированность Тогда
		ТекстЗаголовка = ЗаголовокРегламентированногоОтчета(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета, СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета);
		
		ОргСтр = " (" + СтруктураРеквизитовФормы.Организация + ")";
		Если СтрНайти(ТекстЗаголовка, ОргСтр) = 0 Тогда
			ТекстЗаголовка = ТекстЗаголовка + ОргСтр;
		КонецЕсли;
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Отчет """ + ТекстЗаголовка + """ не сохранен.";
		Сообщение.Сообщить();
		
		Возврат Ложь;
	КонецЕсли;
	
	ИмяФайлаВыгрузки = СформироватьИмяФайла();
	
	Если НЕ УниверсальнаяВыгрузкаXMLНаСервере(ТекстВыгрузки, ПараметрыВыгрузки) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции // УниверсальнаяВыгрузка()

&НаСервере
Функция СформироватьИмяФайла()
	
	Перем ПолученноеЗначение;
	
	ИмяФайлаXML = "Форма300_"+ Прав(Этаформа.ИмяФормы,7)+ "_" + СтрЗаменить(СтрЗаменить(Строка(ТекущаяДата())," ","_"),":","-") + ".xml";
	
	Возврат ИмяФайлаXML;
	
КонецФункции


&НаКлиенте
Функция ЗаголовокРегламентированногоОтчета(ДатаНач, ДатаКон, Периодичность = Неопределено) Экспорт
	
	СтрПериодОтчета = ПредставлениеПериода( НачалоДня(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета), КонецДня(СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета), "ФП = Истина" );
	
	Если СтрНайти(ЭтаФорма.Заголовок, СтрПериодОтчета) = 0 Тогда
		Возврат ЭтаФорма.Заголовок + " за " + СтрПериодОтчета;
	Иначе
		Возврат ЭтаФорма.Заголовок;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция УниверсальнаяВыгрузкаXMLНаСервере(ТекстВыгрузки, ПараметрыВыгрузки)
	
	Префикс = Прав(СтруктураРеквизитовФормы.мВыбраннаяФорма,7);
	
	// запишем общие атрибуты (code, version) и создадим элемент form
	Запись = РегламентированнаяОтчетность.СоздатьНовыйПотокXML("UTF-8");
	
	// Запишем корневой элемент
	Запись.ЗаписатьНачалоЭлемента("fno");
	
	Попытка
		МакетВыгрузки = ЭтотОбъект.РеквизитФормыВЗначение("Отчет").ПолучитьМакет("СхемаВыгрузкиВXML");
	Исключение
		СообщениеТабл = ТаблицаСообщений.Добавить();
		СообщениеТабл.Описание = НСтр("ru = 'Отсутствует актуальный шаблон для выгрузки'");
	КонецПопытки;
	
	ТаблОбщиеРеквизиты = Новый ТаблицаЗначений;
	ТаблОбщиеРеквизиты.Колонки.Добавить("ИмяАтрибута");
	ТаблОбщиеРеквизиты.Колонки.Добавить("ЗначениеАтрибута");
	
	ОбластьОбщихРеквизитов = МакетВыгрузки.Область("ОбщиеРеквизиты" + Префикс);
	Для Ном = ОбластьОбщихРеквизитов.Верх По ОбластьОбщихРеквизитов.Низ Цикл
		Строка = ТаблОбщиеРеквизиты.Добавить();
		Строка.ИмяАтрибута		 = СокрП(МакетВыгрузки.Область(Ном, 1).Текст);
		Строка.ЗначениеАтрибута	 = СокрП(МакетВыгрузки.Область(Ном, 2).Текст);
	КонецЦикла;
	
	// Запишем атрибуты корневого элемента
	Для Каждого Строка Из ТаблОбщиеРеквизиты Цикл
		Запись.ЗаписатьАтрибут(Строка.ИмяАтрибута,Строка.ЗначениеАтрибута);
	КонецЦикла;
	
	// создадим таблицу для выгрузки
	ТаблицаВыгрузки = Новый ТаблицаЗначений;
	ТаблицаВыгрузки.Колонки.Добавить("Форма");
	ТаблицаВыгрузки.Колонки.Добавить("Страница");
	ТаблицаВыгрузки.Колонки.Добавить("ИмяАтрибута");
	ТаблицаВыгрузки.Колонки.Добавить("ИмяЯчейки");
	ТаблицаВыгрузки.Колонки.Добавить("КоличествоROW");
	ТаблицаВыгрузки.Колонки.Добавить("ИмяФормы");
	ТаблицаВыгрузки.Колонки.Добавить("ИмяЛиста");
	ТаблицаВыгрузки.Колонки.Добавить("Отображение");
	ТаблицаВыгрузки.Колонки.Добавить("ВыгружатьНулевыеЗначения");
	
	ТаблицаВыгрузки.Колонки.Добавить("КоличествоПодстрок");
	
	ТаблицаВыгрузки.Колонки.Добавить("КодФормы");
	ТаблицаВыгрузки.Колонки.Добавить("Выгружать");
	ТаблицаВыгрузки.Колонки.Добавить("Многострочность");
	ТаблицаВыгрузки.Колонки.Добавить("ЗаголовокФормы"); 
	ТаблицаВыгрузки.Колонки.Добавить("КоличествоНаЛисте");
	ТаблицаВыгрузки.Колонки.Добавить("Значение");    
	
	ОбластьВыгрузки = МакетВыгрузки.Область("Выгрузка" + Префикс);
	
	Для Ном = ОбластьВыгрузки.Верх По ОбластьВыгрузки.Низ Цикл
		
		Строка = ТаблицаВыгрузки.Добавить();
		Строка.Форма 	       			= СокрП(МакетВыгрузки.Область(Ном, 1).Текст);
		Строка.Страница        			= СокрП(МакетВыгрузки.Область(Ном, 2).Текст);
		Строка.ИмяАтрибута     			= СокрП(МакетВыгрузки.Область(Ном, 3).Текст);
		Строка.ИмяЯчейки      	 		= СокрП(МакетВыгрузки.Область(Ном, 4).Текст);
		Строка.КоличествоROW   			= СокрП(МакетВыгрузки.Область(Ном, 5).Текст);
		Строка.ИмяФормы        			= СокрП(МакетВыгрузки.Область(Ном, 6).Текст);
		Строка.ИмяЛиста        			= СокрП(МакетВыгрузки.Область(Ном, 7).Текст);
		Строка.Отображение     			= СокрП(МакетВыгрузки.Область(Ном, 8).Текст);
		
		Строка.ВыгружатьНулевыеЗначения = ?(СокрП(МакетВыгрузки.Область(Ном, 9).Текст) = "1", Истина, Ложь);
		
		МаксимальныйНормерПодстрокиЯчееки = 5;
		Если СокрП(МакетВыгрузки.Область(Ном, 10).Текст) = "x" Тогда
			Строка.КоличествоПодстрок =  МаксимальныйНормерПодстрокиЯчееки;
		Иначе	
			Строка.КоличествоПодстрок =  "";
		КонецЕсли;	
	КонецЦикла;
	
	// выгрузка в XML 
	КоличествоСтрокВТаблице = ТаблицаВыгрузки.Количество();
	НомерСтроки = 0;
	
	ТекущаяФорма = Неопределено;
	ТекущаяСтраница = Неопределено;
	
	Пока Истина Цикл
		
		Если НомерСтроки >= КоличествоСтрокВТаблице Тогда
			Прервать;
		КонецЕсли;
		
		Если Не ТекущаяФорма = ТаблицаВыгрузки[НомерСтроки].Форма Тогда
			
			ТекущаяФорма = ТаблицаВыгрузки[НомерСтроки].Форма;
			
			Если НомерСтроки > 0 Тогда 
				Запись.ЗаписатьКонецЭлемента();
			КонецЕсли;
			Запись.ЗаписатьНачалоЭлемента("form");
			Запись.ЗаписатьАтрибут("name", ТекущаяФорма);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТаблицаВыгрузки[НомерСтроки].КоличествоПодстрок) Тогда  // для обычных форм
			КоличествоПодстрок = Число(ТаблицаВыгрузки[НомерСтроки].КоличествоПодстрок);
			Для Н = 1 По КоличествоПодстрок Цикл
				ИмяАтрибута = ТаблицаВыгрузки[НомерСтроки].ИмяАтрибута;
				
				Если СтрНайти(ИмяАтрибута, "300_06_") = 0 Тогда
					ИмяАтрибута = СтрЗаменить(ИмяАтрибута, "n", Формат(Н,"ЧЦ=2; ЧВН="));
				Иначе
					ИмяАтрибута = СтрЗаменить(ИмяАтрибута, "n", Н);
				КонецЕсли;	
				
				Запись.ЗаписатьНачалоЭлемента("field");
				Запись.ЗаписатьАтрибут("name", ИмяАтрибута);
				
				ИмяЯчейки = ТаблицаВыгрузки[НомерСтроки].ИмяЯчейки;
				Если ЗначениеЗаполнено(ИмяЯчейки) Тогда
					ИмяЯчейки = СтрЗаменить(ИмяЯчейки, "n", Н);
					Значение = ОпределитьЗначениеПараметра(ЭтотОбъект[ТаблицаВыгрузки[НомерСтроки].ИмяФормы][ИмяЯчейки]);
				Иначе
					Значение = "";
				КонецЕсли;
				
				Если ЗначениеЗаполнено(Значение) Тогда
					Запись.ЗаписатьТекст(Строка(Значение));
				КонецЕсли;
				Запись.ЗаписатьКонецЭлемента();
			КонецЦикла;	
		ИначеЕсли ТаблицаВыгрузки[НомерСтроки].КоличествоROW = "0" Тогда
			//Если не многострочная форма, просто добавляем значение реквизита
			Запись.ЗаписатьНачалоЭлемента("field");
			Запись.ЗаписатьАтрибут("name", ТаблицаВыгрузки[НомерСтроки].ИмяАтрибута);
			//Проверим есть ли возможность заполнить данный параметр
			Если ЗначениеЗаполнено(ТаблицаВыгрузки[НомерСтроки].ИмяЯчейки) Тогда
				
				Если ТаблицаВыгрузки[НомерСтроки].ИмяЯчейки = "КодВалюты" Тогда
					Запись.ЗаписатьТекст("KZT");
				Иначе
					//Получим и обработаем значение параметра и запишем его
					Если ТаблицаВыгрузки[НомерСтроки].ИмяЯчейки = "НомерСтраницы" Тогда
						Значение = "1";
					Иначе 
						Значение = ОпределитьЗначениеПараметра(ЭтотОбъект[ТаблицаВыгрузки[НомерСтроки].ИмяФормы][ТаблицаВыгрузки[НомерСтроки].ИмяЯчейки], ТаблицаВыгрузки[НомерСтроки].ИмяЯчейки);
					КонецЕсли;
					
					Если Не ЗначениеЗаполнено(Значение) И ТаблицаВыгрузки[НомерСтроки].ВыгружатьНулевыеЗначения Тогда
						Значение = "0";
					КонецЕсли;
					
					Если ЗначениеЗаполнено(Значение) Тогда
						Запись.ЗаписатьТекст(Строка(Значение));
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
			Запись.ЗаписатьКонецЭлемента();
			
		Иначе
			
			//Определим состав колонок многострочной формы
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("Форма", ТаблицаВыгрузки[НомерСтроки].Форма);
			СтруктураПоиска.Вставить("КоличествоROW", "99999");
			СтрокиТаблицы = ТаблицаВыгрузки.НайтиСтроки(СтруктураПоиска);
			
			//Проверям есть ли у нас вообще записи в многострочной форме
			ЕстьЗаписи = Ложь;
			Для Каждого Строка Из СтрокиТаблицы Цикл
				Если ЭтотОбъект[Строка.ИмяФормы].Количество() <> 0 И ЗначениеЗаполнено(ЭтотОбъект[Строка.ИмяФормы][0][Строка.ИмяЯчейки]) Тогда 
					ЕстьЗаписи = Истина;
				КонецЕсли;
			КонецЦикла;
			
			Если ЕстьЗаписи Тогда 
				
				Для Счетчик = 0 По ЭтотОбъект[ТаблицаВыгрузки[НомерСтроки].ИмяФормы].Количество() - 1 Цикл
					//Начинаем запись по строкам
					Запись.ЗаписатьНачалоЭлемента("row");
					//Номер строки всегда первая колонка
					ЭтоНомерСтроки = Истина;
					Для Каждого Строка Из СтрокиТаблицы Цикл
						//Записываем значения элементов строки
						Запись.ЗаписатьНачалоЭлемента("field");
						Запись.ЗаписатьАтрибут("name", Строка.ИмяАтрибута);
						Значение = ОпределитьЗначениеПараметра(ЭтотОбъект[Строка.ИмяФормы][Счетчик][Строка.ИмяЯчейки], , ЭтоНомерСтроки,Строка.ВыгружатьНулевыеЗначения);
						ЭтоНомерСтроки = Ложь;
						Запись.ЗаписатьТекст(Значение);
						Запись.ЗаписатьКонецЭлемента();
					КонецЦикла;
					
					Запись.ЗаписатьКонецЭлемента();
					
				КонецЦикла;
				
			КонецЕсли;
			
			НомерСтроки = НомерСтроки + СтрокиТаблицы.Количество() - 1;
			
		КонецЕсли;
		
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента();// </form> 
	Запись.ЗаписатьКонецЭлемента();// fno
	// получаем текст XML
	ТекстВыгрузки = Запись.Закрыть();
	
	// Заменить в именах элементов "form_300_09_0X" на "form_300_09".
	Для Индекс = 1 По 4 Цикл
		ТекстВыгрузки = СтрЗаменить(ТекстВыгрузки,"form_300_09_" + Формат(Индекс, "ЧЦ=2; ЧВН="),"form_300_09");
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции // УниверсальнаяВыгрузкаXMLНаСервере()

&НаСервере
Функция ПроверитьПоказатели() Экспорт
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ОпределитьЗначениеПараметра(ЗначениеПараметра, ИмяАтрибута = Неопределено, НомерСтроки = Ложь,ВыгружатьНулевыеЗначения = Ложь)
	
	МассивОпций = Новый Массив;
	МассивОпций.Добавить("Пропорциональный");
	МассивОпций.Добавить("Раздельный");
	МассивОпций.Добавить("ПропорцИРаздел");
	МассивОпций.Добавить("Дополнительная");
	МассивОпций.Добавить("Ликвидационная");
	МассивОпций.Добавить("Первоначальная");
	МассивОпций.Добавить("ПоУведомлению");
	МассивОпций.Добавить("Очередная");
	МассивОпций.Добавить("Условие_B");
	МассивОпций.Добавить("Условие_A");
	МассивОпций.Добавить("ОтказОтВозврата");
	МассивОпций.Добавить("ИспользованиеКонтрольногоСчета");
	
	МассивОпций.Добавить("Приложение01");
	МассивОпций.Добавить("Приложение02");
	МассивОпций.Добавить("Приложение03");
	МассивОпций.Добавить("Приложение04");
	МассивОпций.Добавить("Приложение05");
	МассивОпций.Добавить("Приложение06");
	МассивОпций.Добавить("Приложение07");
	МассивОпций.Добавить("Приложение08");
	МассивОпций.Добавить("Приложение09");
	
	МассивОпций.Добавить("ВыпискаВЭлектронномВиде");
	МассивОпций.Добавить("ВыпискаНаБумажномНосителе");
	МассивОпций.Добавить("ПолучениеВЭлектронномВиде");
	МассивОпций.Добавить("ПолучениеНаБумажномНосителе");
	МассивОпций.Добавить("Условие_С2");
	МассивОпций.Добавить("Условие_С1");
	
	
	Если Не МассивОпций.Найти(ИмяАтрибута) = Неопределено Тогда
		Значение = ?(ЗначениеПараметра = "Х", Истина, Ложь);
	Иначе 
		Значение = ?(Не ЗначениеЗаполнено(ЗначениеПараметра) И НЕ ВыгружатьНулевыеЗначения, "", ЗначениеПараметра);
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Если Значение = Дата("00010101000000") Тогда 
			Значение = "";
		Иначе 
			Значение = Формат(Значение, "ДЛФ=Д");
		КонецЕсли;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Булево") Тогда 
		Значение = ?(Значение, "true", "");
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Тогда 
		Значение = Окр(Значение, 2);
		
		Если НомерСтроки Тогда
			Значение = Строка(Значение);
			ДлиннаНомера = СтрДлина(Значение);
			
			Для Счетчик = ДлиннаНомера По 7 Цикл 
				Значение = "0" + Значение;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат XMLСтрока(Значение);
	
КонецФункции

&НаКлиенте
Процедура Расшифровать(Команда)
	
	Попытка
		ИмяЯчейки = ЭтотОбъект.ТекущийЭлемент.ТекущаяОбласть.Имя;
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Активизируйте нужную ячейку отчета для расшифровки.'"));
		Возврат;
	КонецПопытки;
	
	ЦветРасшифровки = Новый Цвет(225, 253, 253);
	Если ЭтотОбъект.ТекущийЭлемент.ТекущаяОбласть.ЦветФона = ЦветРасшифровки Тогда 
		ФормаРасшифровкаСКД(ИмяЯчейки);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Расшифровка данной ячейки не поддерживается.'"));
	КонецЕсли;
	
КонецПроцедуры

