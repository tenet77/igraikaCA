	КонецЕсли;
	
	Если (Найти(ИмяЯчейки, "ОтказОтВозврата") > 0) Тогда
		РасчетНаКлиенте("Форма300Страница3",ИмяЯчейки);
	КонецЕсли;		
	
	Если (Найти(ИмяЯчейки, "ИспользованиеКонтрольногоСчета") > 0) Тогда
		РасчетНаКлиенте("Форма300Страница3",ИмяЯчейки);
	КонецЕсли;		
	
	Если (Найти(ИмяЯчейки, "КодНалоговогоОргана") > 0) Тогда 
		
		ЗначенияОтборов = Новый Структура;
		ЗначенияОтборов.Вставить("Владелец", СтруктураРеквизитовФормы.Организация);
		ПараметрыФормы = Новый Структура;
