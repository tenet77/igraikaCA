&НаСервере
Процедура ОчиститьНаСервере() Экспорт
	
	СтруктураДанныхФорма300Страница1.Очистить();
	СтруктураДанныхФорма300Страница2.Очистить();
	СтруктураДанныхФорма300Страница3.Очистить();
	СтруктураДанныхФорма300_01Страница1.Очистить();
	СтруктураДанныхФорма300_02Страница1.Очистить();
	СтруктураДанныхФорма300_03Страница1.Очистить();
	СтруктураДанныхФорма300_03Страница2.Очистить();
	СтруктураДанныхФорма300_04Страница1.Очистить();
	СтруктураДанныхФорма300_05Страница1.Очистить();
	СтруктураДанныхФорма300_05Страница2.Очистить();
	СтруктураДанныхФорма300_05Страница3.Очистить();
	СтруктураДанныхФорма300_06Страница1.Очистить();
	СтруктураДанныхФорма300_07Страница1.Очистить();
	СтруктураДанныхФорма300_07Страница2.Очистить();
	СтруктураДанныхФорма300_07Страница3.Очистить();
	СтруктураДанныхФорма300_08Страница1.Очистить();
	СтруктураДанныхФорма300_08Страница2.Очистить();
	СтруктураДанныхФорма300_08Страница3.Очистить();
	
	ЗаполнитьПустыеСтруктурыДанных();
	
	ОчиститьТабличноеПолеНаСервере(СтруктураРеквизитовФормы.НаимТекущегоРаздела);
	
