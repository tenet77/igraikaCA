		ОткрытьФорму("Справочник.РегистрацииВНалоговомОргане.Форма.ФормаВыбора",ПараметрыФормы,ЭтаФорма,,,,ОповещениеВыбора,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
	Если СтруктураЯчеекСРасшифровкой.Свойство(Лев(ИмяЯчейки,11),ЗначениеСвойства)Тогда
		ИмяБезПрефикса = Лев(ИмяЯчейки,13);
		Если СтрНайти(ЗначениеСвойства,ИмяБезПрефикса) > 0  Тогда
			ОткрытьФормуРасшифровки(ИмяЯчейки,ИмяБезПрефикса,ИмяБезПрефикса <> ИмяЯчейки);
		КонецЕсли;
