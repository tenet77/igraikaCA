		ИЛИ (Найти(ИмяЯчейки, "ВыпискаВЭлектронномВиде") > 0) 
		ИЛИ (Найти(ИмяЯчейки, "ПолучениеНаБумажномНосителе") > 0) 
		ИЛИ (Найти(ИмяЯчейки, "ПолучениеВЭлектронномВиде") > 0) 
		ИЛИ (Найти(ИмяЯчейки, "Приложение01") > 0)
