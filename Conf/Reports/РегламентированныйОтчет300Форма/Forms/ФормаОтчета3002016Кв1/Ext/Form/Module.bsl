&НаКлиенте
Процедура Выгрузить(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыгрузитьЗавершение", ЭтотОбъект);
	
	Отказ = Ложь;
	ОнлайнСервисыРегламентированнойОтчетностиКлиент.ПередВыгрузкойРегламентированногоОтчета(ОписаниеОповещения, ЭтотОбъект, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьЗавершение(Отказ, ДополнительныеПараметры) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ВыгрузитьОтчет();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьОтчет() Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыгрузитьОтчетЗавершение", ЭтотОбъект);
	
	Если Модифицированность Тогда
		СохранитьНаКлиенте(,ОписаниеОповещения);
	Иначе
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьОтчетЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ФормаВыгрузкиРеглОтчета = ПолучитьФорму("Документ.ВыгрузкаРегламентированныхОтчетов.Форма.ФормаДокумента", , ЭтаФорма);
	
	СпДокОсн = Новый СписокЗначений;
	СпДокОсн.Добавить(СтруктураРеквизитовФормы.мСохраненныйДок);
	
	ФормаВыгрузкиРеглОтчета.СформироватьИЗаписать(СпДокОсн);
	
КонецПроцедуры

&НаКлиенте
Функция УниверсальнаяВыгрузка(ТекстВыгрузки = Неопределено, ПроверятьБлокировки = Истина, ИмяФайлаВыгрузки = "", ВыгружатьСОшибками = Ложь) Экспорт
	
	Перем ПараметрыВыгрузки;
	
	Если Модифицированность Тогда
		ТекстЗаголовка = ЗаголовокРегламентированногоОтчета(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета, СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета);
		
		ОргСтр = " (" + СтруктураРеквизитовФормы.Организация + ")";
		Если СтрНайти(ТекстЗаголовка, ОргСтр) = 0 Тогда
			ТекстЗаголовка = ТекстЗаголовка + ОргСтр;
		КонецЕсли;
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Отчет """ + ТекстЗаголовка + """ не сохранен.";
		Сообщение.Сообщить();
		
		Возврат Ложь;
	КонецЕсли;
	
	ИмяФайлаВыгрузки = "Форма300_" + Прав(СтруктураРеквизитовФормы.мВыбраннаяФорма,7) + ".xml";
	
	Если НЕ УниверсальнаяВыгрузкаXMLНаСервере(ТекстВыгрузки, ПараметрыВыгрузки) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции // УниверсальнаяВыгрузка()

&НаКлиенте
Функция ЗаголовокРегламентированногоОтчета(ДатаНач, ДатаКон, Периодичность = Неопределено) Экспорт
	
	СтрПериодОтчета = ПредставлениеПериода( НачалоДня(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета), КонецДня(СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета), "ФП = Истина" );
	
	Если СтрНайти(ЭтаФорма.Заголовок, СтрПериодОтчета) = 0 Тогда
		Возврат ЭтаФорма.Заголовок + " за " + СтрПериодОтчета;
	Иначе
		Возврат ЭтаФорма.Заголовок;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция УниверсальнаяВыгрузкаXMLНаСервере(ТекстВыгрузки, ПараметрыВыгрузки)
	
	Префикс = Прав(СтруктураРеквизитовФормы.мВыбраннаяФорма,7);
	
	// запишем общие атрибуты (code, version) и создадим элемент form
	Запись = РегламентированнаяОтчетность.СоздатьНовыйПотокXML("UTF-8");
	
	// Запишем корневой элемент
	Запись.ЗаписатьНачалоЭлемента("fno");
	
	МакетВыгрузки = ЭтотОбъект.РеквизитФормыВЗначение("Отчет").ПолучитьМакет("СхемаВыгрузкиВXML");
	
	ТаблОбщиеРеквизиты = Новый ТаблицаЗначений;
	ТаблОбщиеРеквизиты.Колонки.Добавить("ИмяАтрибута");
	ТаблОбщиеРеквизиты.Колонки.Добавить("ЗначениеАтрибута");
	
	ОбластьОбщихРеквизитов = МакетВыгрузки.Область("ОбщиеРеквизиты" + Префикс);
	Для Ном = ОбластьОбщихРеквизитов.Верх По ОбластьОбщихРеквизитов.Низ Цикл
		Строка = ТаблОбщиеРеквизиты.Добавить();
		Строка.ИмяАтрибута		 = СокрП(МакетВыгрузки.Область(Ном, 1).Текст);
		Строка.ЗначениеАтрибута	 = СокрП(МакетВыгрузки.Область(Ном, 2).Текст);
	КонецЦикла;
	
	// Запишем атрибуты корневого элемента
	Для Каждого Строка Из ТаблОбщиеРеквизиты Цикл
		Запись.ЗаписатьАтрибут(Строка.ИмяАтрибута,Строка.ЗначениеАтрибута);
	КонецЦикла;
	
	// создадим таблицу для выгрузки
	ТаблицаВыгрузки = Новый ТаблицаЗначений;
	ТаблицаВыгрузки.Колонки.Добавить("Форма");
	ТаблицаВыгрузки.Колонки.Добавить("Страница");
	ТаблицаВыгрузки.Колонки.Добавить("ИмяАтрибута");
	ТаблицаВыгрузки.Колонки.Добавить("ИмяЯчейки");
	ТаблицаВыгрузки.Колонки.Добавить("КоличествоROW");
	ТаблицаВыгрузки.Колонки.Добавить("ИмяФормы");
	ТаблицаВыгрузки.Колонки.Добавить("ИмяЛиста");
	ТаблицаВыгрузки.Колонки.Добавить("Отображение");
	ТаблицаВыгрузки.Колонки.Добавить("ВыгружатьНулевыеЗначения");
	
	ТаблицаВыгрузки.Колонки.Добавить("КодФормы");
	ТаблицаВыгрузки.Колонки.Добавить("Выгружать");
	ТаблицаВыгрузки.Колонки.Добавить("Многострочность");
	ТаблицаВыгрузки.Колонки.Добавить("ЗаголовокФормы"); 
	ТаблицаВыгрузки.Колонки.Добавить("КоличествоНаЛисте");
	ТаблицаВыгрузки.Колонки.Добавить("Значение");    
	
	ОбластьВыгрузки = МакетВыгрузки.Область("Выгрузка" + Префикс);
	
	Для Ном = ОбластьВыгрузки.Верх По ОбластьВыгрузки.Низ Цикл
		
		Строка = ТаблицаВыгрузки.Добавить();
		Строка.Форма 	       			= СокрП(МакетВыгрузки.Область(Ном, 1).Текст);
		Строка.Страница        			= СокрП(МакетВыгрузки.Область(Ном, 2).Текст);
		Строка.ИмяАтрибута     			= СокрП(МакетВыгрузки.Область(Ном, 3).Текст);
		Строка.ИмяЯчейки      	 		= СокрП(МакетВыгрузки.Область(Ном, 4).Текст);
		Строка.КоличествоROW   			= СокрП(МакетВыгрузки.Область(Ном, 5).Текст);
		Строка.ИмяФормы        			= СокрП(МакетВыгрузки.Область(Ном, 6).Текст);
		Строка.ИмяЛиста        			= СокрП(МакетВыгрузки.Область(Ном, 7).Текст);
		Строка.Отображение     			= СокрП(МакетВыгрузки.Область(Ном, 8).Текст);
		
		Строка.ВыгружатьНулевыеЗначения = ?(СокрП(МакетВыгрузки.Область(Ном, 9).Текст) = "1", Истина, Ложь);
		
	КонецЦикла;
	
	Форма300_09УдалитьПустыеПриложенияИзТаблицыВыгрузки(ТаблицаВыгрузки);
	
	// выгрузка в XML 
	КоличествоСтрокВТаблице = ТаблицаВыгрузки.Количество();
	НомерСтроки = 0;
	
	ТекущаяФорма = Неопределено;
	ТекущаяСтраница = Неопределено;
	
	Пока Истина Цикл
		
		Если НомерСтроки >= КоличествоСтрокВТаблице Тогда
			Прервать;
		КонецЕсли;
		
		Если Не ТекущаяФорма = ТаблицаВыгрузки[НомерСтроки].Форма Тогда
			
			ТекущаяФорма = ТаблицаВыгрузки[НомерСтроки].Форма;
			
			Если НомерСтроки > 0 Тогда 
				Запись.ЗаписатьКонецЭлемента();
			КонецЕсли;
			Запись.ЗаписатьНачалоЭлемента("form");
			Запись.ЗаписатьАтрибут("name", ТекущаяФорма);
			
		КонецЕсли;
		
		Если ТаблицаВыгрузки[НомерСтроки].КоличествоROW = "0" Тогда
			//Если не многострочная форма, просто добавляем значение реквизита
			Запись.ЗаписатьНачалоЭлемента("field");
			Запись.ЗаписатьАтрибут("name", ТаблицаВыгрузки[НомерСтроки].ИмяАтрибута);
			//Проверим есть ли возможность заполнить данный параметр
			Если ЗначениеЗаполнено(ТаблицаВыгрузки[НомерСтроки].ИмяЯчейки) Тогда
				
				Если ТаблицаВыгрузки[НомерСтроки].ИмяЯчейки = "КодВалюты" Тогда
					Запись.ЗаписатьТекст("KZT");
				Иначе
					//Получим и обработаем значение параметра и запишем его
					Если ТаблицаВыгрузки[НомерСтроки].ИмяЯчейки = "НомерСтраницы" Тогда
						Значение = "1";
					Иначе 
						Значение = ОпределитьЗначениеПараметра(ЭтотОбъект[ТаблицаВыгрузки[НомерСтроки].ИмяФормы][ТаблицаВыгрузки[НомерСтроки].ИмяЯчейки], ТаблицаВыгрузки[НомерСтроки].ИмяЯчейки);
					КонецЕсли;
					
					Если Не ЗначениеЗаполнено(Значение) И ТаблицаВыгрузки[НомерСтроки].ВыгружатьНулевыеЗначения Тогда
						Значение = "0";
					КонецЕсли;
					
					Если ЗначениеЗаполнено(Значение) Тогда
						Запись.ЗаписатьТекст(Строка(Значение));
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
			Запись.ЗаписатьКонецЭлемента();
			
		Иначе
			
			//Определим состав колонок многострочной формы
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("Форма", ТаблицаВыгрузки[НомерСтроки].Форма);
			СтруктураПоиска.Вставить("КоличествоROW", "99999");
			СтрокиТаблицы = ТаблицаВыгрузки.НайтиСтроки(СтруктураПоиска);
			
			//Проверям есть ли у нас вообще записи в многострочной форме
			ЕстьЗаписи = Ложь;
			Для Каждого Строка Из СтрокиТаблицы Цикл
				Если ЗначениеЗаполнено(ЭтотОбъект[Строка.ИмяФормы][0][Строка.ИмяЯчейки]) Тогда 
					ЕстьЗаписи = Истина;
				КонецЕсли;
			КонецЦикла;
			
			Если ЕстьЗаписи Тогда 
				
				Для Счетчик = 0 По ЭтотОбъект[ТаблицаВыгрузки[НомерСтроки].ИмяФормы].Количество() - 1 Цикл
					//Начинаем запись по строкам
					Запись.ЗаписатьНачалоЭлемента("row");
					//Номер строки всегда первая колонка
					ЭтоНомерСтроки = Истина;
					Для Каждого Строка Из СтрокиТаблицы Цикл
						//Записываем значения элементов строки
						Запись.ЗаписатьНачалоЭлемента("field");
						Запись.ЗаписатьАтрибут("name", Строка.ИмяАтрибута);
						Значение = ОпределитьЗначениеПараметра(ЭтотОбъект[Строка.ИмяФормы][Счетчик][Строка.ИмяЯчейки], , ЭтоНомерСтроки);
						ЭтоНомерСтроки = Ложь;
						Запись.ЗаписатьТекст(Значение);
						Запись.ЗаписатьКонецЭлемента();
					КонецЦикла;
					
					Запись.ЗаписатьКонецЭлемента();
					
				КонецЦикла;
				
			КонецЕсли;
			
			НомерСтроки = НомерСтроки + СтрокиТаблицы.Количество() - 1;
			
		КонецЕсли;
		
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента();// </form> 
	Запись.ЗаписатьКонецЭлемента();// fno
	// получаем текст XML
	ТекстВыгрузки = Запись.Закрыть();
	
	Возврат Истина;
	
