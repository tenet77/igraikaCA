&НаСервере
Функция ОпределитьЗначениеПараметра(ЗначениеПараметра, ИмяАтрибута = Неопределено, НомерСтроки = Ложь)
	
	МассивОпций = Новый Массив;
	МассивОпций.Добавить("Пропорциональный");
	МассивОпций.Добавить("Раздельный");
	МассивОпций.Добавить("ПропорцИРаздел");
	МассивОпций.Добавить("Дополнительная");
	МассивОпций.Добавить("Ликвидационная");
	МассивОпций.Добавить("Первоначальная");
	МассивОпций.Добавить("ПоУведомлению");
	МассивОпций.Добавить("Очередная");
	МассивОпций.Добавить("Условие_B");
	МассивОпций.Добавить("Условие_A");
	МассивОпций.Добавить("ОтказОтВозврата");
	
	Если Не МассивОпций.Найти(ИмяАтрибута) = Неопределено Тогда
		Значение = ?(ЗначениеПараметра = "Х", Истина, Ложь);
	Иначе 
		Значение = ?(Не ЗначениеЗаполнено(ЗначениеПараметра), "", ЗначениеПараметра);
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Если Значение = Дата("00010101000000") Тогда 
			Значение = "";
		Иначе 
			Значение = Формат(Значение, "ДЛФ=Д");
		КонецЕсли;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Булево") Тогда 
		Значение = ?(Значение, "true", "");
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Тогда 
		Значение = Окр(Значение, 2);
		
		Если НомерСтроки Тогда
			Значение = Строка(Значение);
			ДлиннаНомера = СтрДлина(Значение);
			
			Для Счетчик = ДлиннаНомера По 7 Цикл 
				Значение = "0" + Значение;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Строка(Значение);
	
КонецФункции

&НаСервере
Процедура Форма300_09УдалитьПустыеПриложенияИзТаблицыВыгрузки(ТаблицаВыгрузки);
	
	//////////////////////////////////////////////////////////////////////////////
	// Определить какие формы 300_09_0X заполнены, а какие пустые.
	
	МассивЗаполненных = Новый Массив;
	
	Счетчик = 1;
	Для Счетчик = 1 По 4 Цикл
		
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("Форма", "form_300_09_0" + Счетчик);
		СтруктураПоиска.Вставить("КоличествоROW", "99999");
		МассивНайденныхСтрок = ТаблицаВыгрузки.НайтиСтроки(СтруктураПоиска);
		
		ЕстьЗаписи = Ложь;
		
		Для Каждого НайденнаяСтрока Из МассивНайденныхСтрок Цикл
			Если ЗначениеЗаполнено(ЭтотОбъект[НайденнаяСтрока.ИмяФормы][0][НайденнаяСтрока.ИмяЯчейки]) Тогда
				ЕстьЗаписи = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Если ЕстьЗаписи Тогда 
			МассивЗаполненных.Добавить(Счетчик);
		КонецЕсли;
		
	КонецЦикла;
	
	//////////////////////////////////////////////////////////////////////////////
	// Удалить пустые формы 300_09_0X.
	
	Если МассивЗаполненных.Количество() = 0 Тогда
		
		// В форме 300 всегда должен оставаться один раздел 300.09,
		// поэтому удалим все разделы 300_09_0X, кроме 300_09_01.
		
		Для Счетчик = 2 По 4 Цикл
			
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Форма", "form_300_09_0" + Счетчик);
			МассивНайденныхСтрок = ТаблицаВыгрузки.НайтиСтроки(ПараметрыОтбора);
			
			Для Каждого НайденнаяСтрока Из МассивНайденныхСтрок Цикл
				ТаблицаВыгрузки.Удалить(НайденнаяСтрока);
			КонецЦикла;
			
		КонецЦикла;
		
	Иначе
		
		// Удалить пустые формы 300_09_0X.
		
		Для Счетчик = 1 По 4 Цикл
			
			Форма300_09_0XПустая = ?(МассивЗаполненных.Найти(Счетчик) = Неопределено, Истина, Ложь);
			
			Если Форма300_09_0XПустая Тогда
				
				ПараметрыОтбора = Новый Структура;
				ПараметрыОтбора.Вставить("Форма", "form_300_09_0" + Счетчик);
				МассивНайденныхСтрок = ТаблицаВыгрузки.НайтиСтроки(ПараметрыОтбора);
				
				Для Каждого НайденнаяСтрока Из МассивНайденныхСтрок Цикл
					ТаблицаВыгрузки.Удалить(НайденнаяСтрока);
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	
КонецПроцедуры

