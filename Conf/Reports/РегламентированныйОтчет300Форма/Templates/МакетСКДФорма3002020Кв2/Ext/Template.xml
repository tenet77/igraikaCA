				<dataSource>ИсточникДанных1</dataSource>
				<query>ВЫБРАТЬ
	КодыСтрокДекларацииПоНДСКЗачетуСрезПоследних.Период КАК Период,
	КодыСтрокДекларацииПоНДСКЗачетуСрезПоследних.ВидОперации КАК ВидОперации,
	КодыСтрокДекларацииПоНДСКЗачетуСрезПоследних.КодСтроки КАК КодСтроки,
	ВидыОборотовПоРеализации.Ссылка КАК ВидОборота,
	ВЫБОР
		КОГДА КодыСтрокДекларацииПоНДСКЗачетуСрезПоследних.ВидОборота = ЗНАЧЕНИЕ(Перечисление.ВидыОборотовПоРеализации.ПустаяСсылка)
			ТОГДА 2
		ИНАЧЕ 1
	КОНЕЦ КАК Приоритет
ПОМЕСТИТЬ ВТ_Приоритет
ИЗ
	Перечисление.ВидыОборотовПоРеализации КАК ВидыОборотовПоРеализации
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыСтрокДекларацииПоНДСКЗачету.СрезПоследних(&amp;КонецПериода, ) КАК КодыСтрокДекларацииПоНДСКЗачетуСрезПоследних
		ПО (КодыСтрокДекларацииПоНДСКЗачетуСрезПоследних.ВидОборота = ВидыОборотовПоРеализации.Ссылка
				ИЛИ КодыСтрокДекларацииПоНДСКЗачетуСрезПоследних.ВидОборота = ЗНАЧЕНИЕ(Перечисление.ВидыОборотовПоРеализации.ПустаяСсылка))

ИНДЕКСИРОВАТЬ ПО
	Приоритет,
	ВидОперации,
	ВидОборота
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ТаблицаДохода.ВидОперацииПоступления КАК ВидОперацииПоступления,
	ТаблицаДохода.ВидОборота КАК ВидОборота,
	ДанныеОКодахДекларации.КодСтроки КАК КодСтроки
ПОМЕСТИТЬ ВТ_СведенияОкодахСтрокДекларации
ИЗ
	(ВЫБРАТЬ
		ТаблицаОпераций.ВидОперации КАК ВидОперацииПоступления,
		ТаблицаОпераций.ВидОборота КАК ВидОборота,
		МИНИМУМ(ТаблицаОпераций.Приоритет) КАК Приоритет
	ИЗ
		ВТ_Приоритет КАК ТаблицаОпераций
	
	СГРУППИРОВАТЬ ПО
		ТаблицаОпераций.ВидОперации,
		ТаблицаОпераций.ВидОборота) КАК ТаблицаДохода
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Приоритет КАК ДанныеОКодахДекларации
		ПО ТаблицаДохода.Приоритет = ДанныеОКодахДекларации.Приоритет
			И ТаблицаДохода.ВидОперацииПоступления = ДанныеОКодахДекларации.ВидОперации
			И ТаблицаДохода.ВидОборота = ДанныеОКодахДекларации.ВидОборота

ИНДЕКСИРОВАТЬ ПО
	ВидОперацииПоступления,
	ВидОборота,
	КодСтроки
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Организации.Ссылка
ПОМЕСТИТЬ СписокОрганизаций
ИЗ
	Справочник.Организации КАК Организации
ГДЕ
	Организации.Ссылка = &amp;Организация

ОБЪЕДИНИТЬ

ВЫБРАТЬ
	Организации.Ссылка
ИЗ
	Справочник.Организации КАК Организации
ГДЕ
	Организации.ГоловнаяОрганизация &lt;&gt; Организации.Ссылка
	И Организации.ГоловнаяОрганизация = &amp;Организация
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	НДСКВозмещениюОбороты.СуммаНДСОборот КАК СуммаНДС,
	НДСКВозмещениюОбороты.СуммаБезНДСОборот КАК СуммаОборота,
	НДСКВозмещениюОбороты.УплаченныйНДСОборот КАК СуммаУплаченныйНДС,
	ВЫБОР
		КОГДА &amp;РаздельныйМетод
				И НДСКВозмещениюОбороты.ВидОборота = ЗНАЧЕНИЕ(Перечисление.ВидыОборотовПоРеализации.Освобожденный)
			ТОГДА 0
		КОГДА &amp;РаздельныйМетод
				И НДСКВозмещениюОбороты.ВидОборота = ЗНАЧЕНИЕ(Перечисление.ВидыОборотовПоРеализации.Общий)
			ТОГДА ВЫРАЗИТЬ(НДСКВозмещениюОбороты.СуммаНДСОборот * &amp;УдельныйВес / 100 КАК ЧИСЛО(15, 3))
		ИНАЧЕ НДСКВозмещениюОбороты.СуммаНДСОборот
	КОНЕЦ КАК СуммаВДекларации,
	КодыСтрокДекларацииПоНДС.КодСтроки КАК КодСтроки,
	ПОДСТРОКА(КодыСтрокДекларацииПоНДС.КодСтроки, 1, 10) КАК КодСтрокиРасшифровки,
	"Приобретение" КАК Раздел,
	НДСКВозмещениюОбороты.Регистратор,
	НДСКВозмещениюОбороты.СтавкаНДС,
	НДСКВозмещениюОбороты.ВидОборота,
	НДСКВозмещениюОбороты.ВидОперацииПоступления,
	НДСКВозмещениюОбороты.Организация,
	НДСКВозмещениюОбороты.Контрагент,
	ВЫБОР
		КОГДА ТИПЗНАЧЕНИЯ(НДСКВозмещениюОбороты.Контрагент) = ТИП(Справочник.Контрагенты)
			ТОГДА ВЫРАЗИТЬ(НДСКВозмещениюОбороты.Контрагент КАК Справочник.Контрагенты).ИНН
		КОГДА ТИПЗНАЧЕНИЯ(НДСКВозмещениюОбороты.Контрагент) = ТИП(Справочник.Организации)
			ТОГДА ВЫРАЗИТЬ(НДСКВозмещениюОбороты.Контрагент КАК Справочник.Организации).ИНН
		ИНАЧЕ ""
	КОНЕЦ КАК ИИН_БИН,
	НДСКВозмещениюОбороты.ДоговорКонтрагента,
	НДСКВозмещениюОбороты.КорректируемыйПериод,
	НДСКВозмещениюОбороты.СчетФактура,
	ВЫБОР
		КОГДА ТИПЗНАЧЕНИЯ(НДСКВозмещениюОбороты.Регистратор) = ТИП(Документ.СчетФактураПолученный)
				ИЛИ НЕ ЗаписьКнигиПокупокПредъявленныеСФ.Ссылка ЕСТЬ NULL 
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ОборотыПоСчетуФактуре
ИЗ
	РегистрНакопления.НДСКВозмещению.Обороты(
			&amp;НачалоПериода,
			&amp;КонецПериода,
			Регистратор,
			Организация В
					(ВЫБРАТЬ
						Т.Ссылка
					ИЗ
						СписокОрганизаций КАК Т)
				И ЗаписьДополнительнойДекларации = ЛОЖЬ) КАК НДСКВозмещениюОбороты
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СведенияОкодахСтрокДекларации КАК КодыСтрокДекларацииПоНДС
		ПО НДСКВозмещениюОбороты.ВидОперацииПоступления = КодыСтрокДекларацииПоНДС.ВидОперацииПоступления
			И НДСКВозмещениюОбороты.ВидОборота = КодыСтрокДекларацииПоНДС.ВидОборота
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаписьКнигиПокупок КАК ЗаписьКнигиПокупокПредъявленныеСФ
		ПО НДСКВозмещениюОбороты.Регистратор = ЗаписьКнигиПокупокПредъявленныеСФ.Ссылка
			И (ЗаписьКнигиПокупокПредъявленныеСФ.ПредъявленСчетФактура)
ГДЕ
	(ПОДСТРОКА(КодыСтрокДекларацииПоНДС.КодСтроки, 1, 10) В (&amp;КодСтрокиРасшифровки)
			ИЛИ КодыСтрокДекларацииПоНДС.КодСтроки В (&amp;КодСтрокиРасшифровки))</query>
			</dataSet>
			<totalField>
				<dataPath>СуммаВДекларации</dataPath>
				<expression>Сумма(СуммаВДекларации)</expression>
			</totalField>
