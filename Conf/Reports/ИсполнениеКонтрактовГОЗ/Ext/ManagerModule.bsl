	НовоеПравило.ЦелевойПараметр = "ПрибыльКонтракта";
	
	Для каждого СчетУчета Из СчетаУчетаДенеженыеСредстваНаСчетах Цикл
		
		Заголовок = СтрШаблон(НСтр("ru = 'Кт Оборот %1 / %2'"), 
			СчетУчета,
			СтрСоединить(СчетаУчетаДенеженыеСредстваНаСчетах, ", "));
		
		ОтборОборота = ОтборОборота();
		ОтборОборота.Счет = СчетУчета;
		ОтборОборота.НаправлениеДеятельности    = ПараметрыОтчета.ОтборНаправленияДеятельности;
		ОтборОборота.КорСчет = СчетаУчетаДенеженыеСредстваНаСчетах;
		
		ТипыНаправленийДеятельности = Новый Массив;
		ТипыНаправленийДеятельности.Добавить(Перечисления.ТипыНаправленийДеятельности.ИнаяДеятельность);
		ТипыНаправленийДеятельности.Добавить(Перечисления.ТипыНаправленийДеятельности.ПустаяСсылка());
		ОтборОборота.ТипКорНаправлениеДеятельности = ТипыНаправленийДеятельности;
		
		ДобавитьОборот(НовоеПравило, Заголовок, ОтборОборота);
		
	КонецЦикла;

	Возврат ПравилаРасчетаПоказателей;
	
КонецФункции

Функция ДобавитьОборот(Правило, Заголовок, ОтборОборота)
	
	Оборот = Новый Структура;
	
	Оборот.Вставить("Счет",      ОтборОборота.Счет);
	
	МассивНаправленийДеятельности = Новый СписокЗначений;
	Если ТипЗнч(ОтборОборота.НаправлениеДеятельности) = Тип("Массив") Тогда
		МассивНаправленийДеятельности = ОбщегоНазначенияКлиентСервер.СкопироватьМассив(ОтборОборота.НаправлениеДеятельности);
	ИначеЕсли ТипЗнч(ОтборОборота.НаправлениеДеятельности) = Тип("ПланСчетовСсылка.Хозрасчетный") Тогда
		МассивНаправленийДеятельности.Добавить(ОтборОборота.НаправлениеДеятельности);
	КонецЕсли;
	Оборот.Вставить("НаправлениеДеятельности", МассивНаправленийДеятельности);
	
	МассивКорСчетов = Новый Массив;
	Если ТипЗнч(ОтборОборота.КорСчет) = Тип("Массив") Тогда
		МассивКорСчетов = ОбщегоНазначенияКлиентСервер.СкопироватьМассив(ОтборОборота.КорСчет);
	ИначеЕсли ТипЗнч(ОтборОборота.КорСчет) = Тип("ПланСчетовСсылка.Хозрасчетный") Тогда
		МассивКорСчетов.Добавить(ОтборОборота.КорСчет);
	КонецЕсли;
	Оборот.Вставить("КорСчет", МассивКорСчетов);
	
	МассивНаправленийДеятельности = Новый Массив;
	Если ТипЗнч(ОтборОборота.КорНаправлениеДеятельности) = Тип("Массив") Тогда
		МассивНаправленийДеятельности = ОбщегоНазначенияКлиентСервер.СкопироватьМассив(ОтборОборота.КорНаправлениеДеятельности);
	ИначеЕсли ТипЗнч(ОтборОборота.КорНаправлениеДеятельности) = Тип("ПланСчетовСсылка.Хозрасчетный") Тогда
		МассивНаправленийДеятельности.Добавить(ОтборОборота.КорНаправлениеДеятельности);
	КонецЕсли;
	Оборот.Вставить("КорНаправлениеДеятельности", МассивНаправленийДеятельности);
	
	МассивКорТипыНаправленийДеятельности = Новый Массив;
	Если ТипЗнч(ОтборОборота.ТипКорНаправлениеДеятельности) = Тип("Массив") Тогда
		МассивКорТипыНаправленийДеятельности = ОбщегоНазначенияКлиентСервер.СкопироватьМассив(ОтборОборота.ТипКорНаправлениеДеятельности);
	ИначеЕсли ТипЗнч(ОтборОборота.КорНаправлениеДеятельности) = Тип("ПланСчетовСсылка.Хозрасчетный") Тогда
		МассивКорТипыНаправленийДеятельности.Добавить(ОтборОборота.ТипКорНаправлениеДеятельности);
	КонецЕсли;
	Оборот.Вставить("ТипКорНаправлениеДеятельности", МассивКорТипыНаправленийДеятельности);
	
	Оборот.Вставить("ТипИтогов", ОтборОборота.ТипИтогов);
	Оборот.Вставить("Множитель", ОтборОборота.Множитель);
	
	НовоеОборот = Правило.Обороты.Добавить(Оборот, Заголовок);
	
	Возврат Оборот;
	
КонецФункции

Функция ОтборОборота()
	
	ОтборОборота = Новый Структура();
	ОтборОборота.Вставить("Счет");
	ОтборОборота.Вставить("НаправлениеДеятельности");
	ОтборОборота.Вставить("КорСчет");
	ОтборОборота.Вставить("КорНаправлениеДеятельности");
	ОтборОборота.Вставить("ТипКорНаправлениеДеятельности");
	ОтборОборота.Вставить("ТипИтогов", Перечисления.ТипыИтогов.Оборот);
	ОтборОборота.Вставить("Множитель", 1);
	
	Возврат ОтборОборота;
	
КонецФункции

