// Процедура очищает содержимое редактируемых и вычисляемых ячеек
// поля табличного документа, переданного параметром ВыбТабличноеПоле.
//
// Параметры:
//  ВыбТабличноеПоле - поле табличного документа.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ОчиститьТабличноеПоле(Форма, ВыбТабличноеПолеИмя) Экспорт
	
	ВыбТабличноеПоле = Форма.ТабличныйДокумент;
	
	// Непосредственно очищаем ячейки табличного документа.
	Для Инд = 0 По ВыбТабличноеПоле.Области.Количество() - 1 Цикл
		ТекущаяОбласть = ВыбТабличноеПоле.Области[Инд];
		
		Если Не ТекущаяОбласть.ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Прямоугольник Тогда
			Продолжить;
		КонецЕсли;
	
		Если ТекущаяОбласть.СодержитЗначение <> Истина Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТекущаяОбласть.Защита Тогда
			Продолжить;
		КонецЕсли;
		
		ТекущаяОбласть.Очистить();
		
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСведенияОбОрганизацииНаСервере()
	
	ЗаполнитьСведенияОбОрганизации(ЭтаФорма);
	
КонецПроцедуры // ЗаполнитьСведенияОбОрганизацииНаСервере()

// Процедура управляет выводом сведений о выбранной организации
// в соответствующие ячейки табличного документа.
//
// Параметры:
// ВПрограммеИзмененаДатаПодписи - Истина, если процедура запускается для обновления параметров завясящих
// от даты подписания документа, например ФИО должностных лиц
//
&НаСервере
Процедура ЗаполнитьСведенияОбОрганизации(Форма)
	
	Если (Форма.СтруктураРеквизитовФормы.Организация  = Неопределено) Или (Форма.СтруктураРеквизитовФормы.Организация = РегламентированнаяОтчетностьКлиентСервер.ПустоеЗначениеТипа("СправочникСсылка.Организации")) Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаСведений = "ИННЮЛ, НаимЮЛПол, ФИОРук, АдрЮР, ТелОрганизации, ФИОБух,АдресЭлектроннойПочтыОрганизации";
	СведенияОбОрганизации = РегламентированнаяОтчетностьРК.ПолучитьСведенияОбОрганизации(СтруктураРеквизитовФормы.Организация,,СтрокаСведений);
	Если ТабличныйДокумент.Области.Найти("ИИН_БИН") <> Неопределено
		И Не ЗначениеЗаполнено(ТабличныйДокумент.Области["ИИН_БИН"].Значение) Тогда
		ТабличныйДокумент.Области["ИИН_БИН"].Значение = СведенияОбОрганизации.ИННЮЛ;
	КонецЕсли;	
	Если ТабличныйДокумент.Области.Найти("НаимЮЛПол") <> Неопределено
		И Не ЗначениеЗаполнено(ТабличныйДокумент.Области["НаимЮЛПол"].Значение) Тогда
		ТабличныйДокумент.Области["НаимЮЛПол"].Значение = СведенияОбОрганизации.НаимЮЛПол;
	КонецЕсли;	
	Если ТабличныйДокумент.Области.Найти("ФИОРук") <> Неопределено
		И Не ЗначениеЗаполнено(ТабличныйДокумент.Области["ФИОРук"].Значение) Тогда
		ТабличныйДокумент.Области["ФИОРук"].Значение = СведенияОбОрганизации.ФИОРук;
	КонецЕсли;	
	Если ТабличныйДокумент.Области.Найти("АдрЮР") <> Неопределено
		И Не ЗначениеЗаполнено(ТабличныйДокумент.Области["АдрЮР"].Значение) Тогда
		ТабличныйДокумент.Области["АдрЮР"].Значение = РегламентированнаяОтчетностьКлиентСервер.ПредставлениеАдресаВФормате9Запятых(СведенияОбОрганизации.АдрЮР);
	КонецЕсли;	
	Если ТабличныйДокумент.Области.Найти("ТелОрганизации") <> Неопределено
		И Не ЗначениеЗаполнено(ТабличныйДокумент.Области["ТелОрганизации"].Значение) Тогда
		ТабличныйДокумент.Области["ТелОрганизации"].Значение = СведенияОбОрганизации.ТелОрганизации;
	КонецЕсли;	
	Если ТабличныйДокумент.Области.Найти("ФИОБух") <> Неопределено
		И Не ЗначениеЗаполнено(ТабличныйДокумент.Области["ФИОБух"].Значение) Тогда
		ТабличныйДокумент.Области["ФИОБух"].Значение = СведенияОбОрганизации.ФИОБух;
	КонецЕсли;	
	Если ТабличныйДокумент.Области.Найти("ГодОтчета") <> Неопределено 
		И Не ЗначениеЗаполнено(ТабличныйДокумент.Области["ГодОтчета"].Значение) Тогда
		ТабличныйДокумент.Области["ГодОтчета"].Значение = СтруктураРеквизитовФормы.мГод;
	КонецЕсли;	
	Если ТабличныйДокумент.Области.Найти("АдресЭлектроннойПочтыОрганизации") <> Неопределено
		И Не ЗначениеЗаполнено(ТабличныйДокумент.Области["АдресЭлектроннойПочтыОрганизации"].Значение) Тогда
		ТабличныйДокумент.Области["АдресЭлектроннойПочтыОрганизации"].Значение = СведенияОбОрганизации.АдресЭлектроннойПочтыОрганизации;
	КонецЕсли;	
	
	//Форма.Модифицированность = Истина;
	
КонецПроцедуры // ЗаполнитьСведенияОбОрганизации()

