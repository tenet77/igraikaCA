&НаКлиенте
Процедура ЗаполнитьАвтоЗавершение(Отказ, ДополнительныеПараметры) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Команда = ДополнительныеПараметры.Команда;
	
	ЗаполнитьАвтоНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьАвтоНаСервере()
	
	ОчиститьНаСервере();	
	
	СоответствиеКодовКОФСтрокам 	= Новый Соответствие;
	СоответствиеКодовКОФСтрокамНеОНД= Новый Соответствие;
	
	Макет = Отчеты[Сред(Лев(ЭтаФорма.ИмяФормы, СтрНайти(ЭтаФорма.ИмяФормы, ".Форма.") - 1), 7)].ПолучитьМакет("КлассификаторОсновныхФондов_2016");
	Для Сч = Макет.Область("Строки|Соответствия").Верх ПО Макет.Область("Строки|Соответствия").Низ Цикл
		КодКОФ = "к" + СокрЛП(Макет.Область(Сч, 1).Текст);
		Строки = СокрЛП(Макет.Область(Сч, 3).Текст);
		Если Не (ПустаяСтрока(Строки) ИЛИ (Строки = "-")) Тогда
			СоответствиеКодовКОФСтрокам.Вставить(КодКОФ, Строки);
		КонецЕсли;
		Строки = СокрЛП(Макет.Область(Сч, 4).Текст);
		Если Не (ПустаяСтрока(Строки) ИЛИ (Строки = "-")) Тогда
			СоответствиеКодовКОФСтрокамНеОНД.Вставить(КодКОФ, Строки);
		КонецЕсли;
		
	КонецЦикла;
	
	
	СохранитьДанныеРаздела(СтруктураРеквизитовФормы.НаимТекущегоРаздела);
	
	ЗаполнитьПустыеСтруктурыДанных();
	
	СтруктураРеквизитовФормы.АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	
	// исключаем землю из 1 и 2 раздела
	КодыКОФЗемли = Новый СписокЗначений;
	КодыКОФЗемли.Добавить("110.000000");
	КодыКОФЗемли.Добавить("111.000000");
	КодыКОФЗемли.Добавить("112.000000");
	КодыКОФЗемли.Добавить("113.000000");
	КодыКОФЗемли.Добавить("114.000000");
	КодыКОФЗемли.Добавить("115.000000");
	
	ПараметрыОтчета = Новый Структура();
	ПараметрыОтчета.Вставить("Организация"						, СтруктураРеквизитовФормы.Организация);
	ПараметрыОтчета.Вставить("ГруппаОрганизаций"				, СтруктураРеквизитовФормы.ГруппаОрганизаций);
	ПараметрыОтчета.Вставить("мДатаНачалаПериодаОтчета"			, СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета);
	ПараметрыОтчета.Вставить("мДатаКонцаПериодаОтчета"			, СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета);
	ПараметрыОтчета.Вставить("УникальныйИдентификаторФормы"		, ЭтаФорма.УникальныйИдентификатор);
	ПараметрыОтчета.Вставить("АдресВоВременномХранилище"		, СтруктураРеквизитовФормы.АдресВоВременномХранилище);
	ПараметрыОтчета.Вставить("Декларация"						, СтруктураРеквизитовФормы.мСохраненныйДок);
	ПараметрыОтчета.Вставить("СоответствиеКодовКОФСтрокам"		, СоответствиеКодовКОФСтрокам);
	ПараметрыОтчета.Вставить("СоответствиеКодовКОФСтрокамНеОНД"	, СоответствиеКодовКОФСтрокамНеОНД);
	ПараметрыОтчета.Вставить("ВключатьЗемлюВ_Основные_разделы"	, ВключатьЗемлюВ_Основные_разделы);
	ПараметрыОтчета.Вставить("ВключатьОбособленныеПодразделения", ВключатьОбособленныеПодразделения);
	ПараметрыОтчета.Вставить("ОсновныеНаправленияДеятельности"	, ОсновныеНаправленияДеятельности);
	
	ПараметрыОтчета.Вставить("КодыКОФЗемли"						, КодыКОФЗемли);

	Контейнер = Новый Структура();
	Контейнер.Вставить("Раздел2", СтруктураДанныхРаздел2);
	Контейнер.Вставить("Раздел3", СтруктураДанныхРаздел3);
	Контейнер.Вставить("Раздел4", СтруктураДанныхРаздел4);
	Контейнер.Вставить("Раздел5", СтруктураДанныхРаздел5);
	Контейнер.Вставить("Раздел6", СтруктураДанныхРаздел6);
	
	ЗаданиеВыполнено = Ложь;
	
	ПараметрыЗаполнения = Новый Массив;
	ПараметрыЗаполнения.Добавить(ИмяОтчета(ЭтаФорма.ИмяФормы));
	ПараметрыЗаполнения.Добавить(ИмяФормыОтчета(ЭтаФорма.ИмяФормы));
	ПараметрыЗаполнения.Добавить(ПараметрыОтчета);
	ПараметрыЗаполнения.Добавить(Контейнер);
	
	//РегламентированнаяОтчетностьПереопределяемыйРК.ЗаполнитьОтчетРК(Сред(Лев(ЭтаФорма.ИмяФормы, СтрНайти(ЭтаФорма.ИмяФормы, ".Форма.") - 1), 7), Сред(ЭтаФорма.ИмяФормы, СтрНайти(ЭтаФорма.ИмяФормы, ".Форма.") + 7), ПараметрыОтчета, Контейнер);
	РегламентированнаяОтчетностьУПК.ЗаполнитьОтчетУПК(ИмяОтчета(ЭтаФорма.ИмяФормы), ИмяФормыОтчета(ЭтаФорма.ИмяФормы), ПараметрыОтчета, Контейнер);
	Для Каждого ЭлементКонтейнера Из Контейнер Цикл
		
		ИмяСтраницы = ЭлементКонтейнера.Ключ;
		ЭтаФорма["СтруктураДанных" + ИмяСтраницы] = ЭлементКонтейнера.Значение;
		
	КонецЦикла;
	
	Расчет(ЭтаФорма,"Раздел2");
	Расчет(ЭтаФорма,"Раздел3");
	Расчет(ЭтаФорма,"Раздел4");
	Расчет(ЭтаФорма,"Раздел5");
	
	ВывестиМакетВТаблДокНаСервере(СтруктураРеквизитовФормы.НаимТекущегоРаздела);
	ЗаполнитьСведенияОбОрганизацииНаСервере();
	
	Модифицированность = Истина;
	
КонецПроцедуры

// Процедуры и функции для расчета при интерактивном изменении
//
&НаСервереБезКонтекста
Функция ПолучитьМассиСтрокАвторасчет(КоличествоСтрок, ОбластьИмя)
	МассивСтрок = Новый Массив; // Пока оставлю так 
	Если ОбластьИмя <> Неопределено 
	Тогда
		МассивСтрок.Добавить(Сред(ОбластьИмя,8,3));
	Иначе
		Для НомерСтроки = 1 По КоличествоСтрок Цикл
			МассивСтрок.Добавить(НомерСтроки);
		КонецЦикла;	
	КонецЕсли;	
	Возврат МассивСтрок;
КонецФункции	

&НаКлиентеНаСервереБезКонтекста
Процедура Расчет(Форма, ИмяСтраницыПанели, ОбластьИмя = Неопределено, ИнтерактивныйВвод = Ложь)
	Если ИмяСтраницыПанели = "Раздел2" Или ИмяСтраницыПанели = "Раздел3" Тогда
		НомерРаздела = Число(Прав(ИмяСтраницыПанели,1));
		Если ИмяСтраницыПанели = "Раздел2" Тогда
			// Итоги по столбцам. графа 10 = сумма граф 1,2,3,4 - сумма граф 5,7,8;
			РасчетИтоговСтолбцов("10", "1,2,3,4,-5,-7,-8", ПолучитьМассиСтрокАвторасчет(60,ОбластьИмя), Форма, 2, ИнтерактивныйВвод);
		КонецЕсли;	
		//строка 49 = сумме строк 50,53,54,55,56,57 		
		РасчетИтоговСтрок("49", "50,53,54,55,56,57",Форма, НомерРаздела, ИнтерактивныйВвод);
		//строка 3 = сумме строк 4,5;	
		РасчетИтоговСтрок("3", "4,5", Форма, НомерРаздела, ИнтерактивныйВвод);
		//строка 10 = сумме строк 11,13;	
		РасчетИтоговСтрок("10", "11,13", Форма, НомерРаздела, ИнтерактивныйВвод);
		//строка 16 = сумме строк 17-20 для каждой графы;
		РасчетИтоговСтрок("16", "17,18,19,20",Форма, НомерРаздела, ИнтерактивныйВвод);
		//строка 39 = сумме строк 40, 42 для каждой графы;
		РасчетИтоговСтрок("39", "40,42",Форма, НомерРаздела, ИнтерактивныйВвод);
		//строка 15 = сумме строк 16, 21, 39 для каждой графы;
		РасчетИтоговСтрок("15", "16,21,39",Форма, НомерРаздела, ИнтерактивныйВвод);
		//строка 44 = сумме строк 45,46;
		РасчетИтоговСтрок("44", "45,46",Форма, НомерРаздела, ИнтерактивныйВвод);
	    //строка 2 = сумме строк 3,10,15,43,44,47;
		РасчетИтоговСтрок("2", "3,10,15,43,44,47",Форма, НомерРаздела, ИнтерактивныйВвод);
		//строка 1 = сумме строк 2,49;
		РасчетИтоговСтрок("1", "2,49",Форма, НомерРаздела, ИнтерактивныйВвод);		
		//Раздел 6строка 1 = (1 + 10) /2;
		Если ИмяСтраницыПанели = "Раздел2" Тогда 
			Форма.СтруктураДанныхРаздел6.П000060001001 = (ЗначениеЯчейки("2","2",1,,Форма,ИнтерактивныйВвод) + ЗначениеЯчейки("2","2",10,,Форма,ИнтерактивныйВвод)) /2;
		КонецЕсли;	
	ИначеЕсли ИмяСтраницыПанели = "Раздел4" или ИмяСтраницыПанели = "Раздел5" Тогда
		НомерРаздела = Число(Прав(ИмяСтраницыПанели,1));
		Если ИмяСтраницыПанели = "Раздел4" Тогда
			// Итоги по столбцам. графа 10 = сумма граф 1,2,3,4 - сумма граф 5,7,8;
			РасчетИтоговСтолбцов("10", "1,2,3,4,-5,-7,-8", ПолучитьМассиСтрокАвторасчет(12,ОбластьИмя), Форма, 4, ИнтерактивныйВвод);
		КонецЕсли;	
		//строка 4 = сумме строк 5, 6, 7 для каждой графы;
		РасчетИтоговСтрок("4", "5,6,7",Форма, НомерРаздела, ИнтерактивныйВвод);
		//строка 1 = сумма 2,3,4,10
		РасчетИтоговСтрок("1", "2,3,4,10",Форма, НомерРаздела, ИнтерактивныйВвод);
		//Раздел 6 строка 2  = (1 + 10) /2;
		
		Если ИмяСтраницыПанели = "Раздел4" Тогда
			Форма.СтруктураДанныхРаздел6.П000060002001 = (ЗначениеЯчейки("4","1",1,,Форма,ИнтерактивныйВвод) + ЗначениеЯчейки("4","1",10,,Форма,ИнтерактивныйВвод)) /2;
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РасчетИтоговСтолбцов(СтолбецПриемник, СтолбцыИсточники, МассивСтрок, Форма, Раздел, ИнтерактивныйВвод) 
	РазделСтрокой 	= Строка(Раздел);
	МассивСтолбцов 	= СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтолбцыИсточники, ",") ;
	Для НомерСтрокиМассиваСтрок = 0 по МассивСтрок.Количество()-1 Цикл
		Результат 	= 0;
		Строка 		= МассивСтрок[НомерСтрокиМассиваСтрок];
		Если Строка = "" Тогда
			Продолжить;
		КонецЕсли;	
		Для НомерСтрокиМассива = 0 по МассивСтолбцов.Количество()-1 Цикл
			ИмяСтолбца = МассивСтолбцов[НомерСтрокиМассива];
			Коэфициент = 1;
			Если Лев(ИмяСтолбца, 1) = "-" Тогда
				Коэфициент = -1;
				ИмяСтолбца = СтрЗаменить(ИмяСтолбца,"-","");
			КонецЕсли;	
			Результат = Результат + ЗначениеЯчейки(РазделСтрокой, Строка, ИмяСтолбца, , Форма, ИнтерактивныйВвод) * Коэфициент;	
		КонецЦикла;
		ЗначениеЯчейки(РазделСтрокой, Строка, СтолбецПриемник, Результат, Форма, ИнтерактивныйВвод)
	КонецЦикла;	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РасчетИтоговСтрок(СтрокаПриемник, СтрокиИсточники, Форма, Раздел, ИнтерактивныйВвод)
	Если Раздел = 2 ИЛИ Раздел = 4 Тогда
		НачальноеЗначениеКолонки = 1;
		КонечноеЗначениеКолонки  = 11;
	ИначеЕсли Раздел = 3 ИЛИ Раздел = 5 Тогда 
		НачальноеЗначениеКолонки = 1;
		КонечноеЗначениеКолонки  = 7;
	Иначе
		Возврат;
	КонецЕсли;
	РазделСтрокой = Строка(Раздел);
	Для Столбец = НачальноеЗначениеКолонки По КонечноеЗначениеКолонки Цикл	
		Результат 			= 0;
		МассивСтрок = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокиИсточники, ",") ;
		Для НомерСтрокиМассива = 0 по МассивСтрок.Количество()-1 Цикл
			Результат = Результат + ЗначениеЯчейки(РазделСтрокой, МассивСтрок[НомерСтрокиМассива], Столбец, , Форма, ИнтерактивныйВвод);
		КонецЦикла;
		ЗначениеЯчейки(РазделСтрокой, СтрокаПриемник, Столбец, Результат, Форма, ИнтерактивныйВвод)
	КонецЦикла;        
	

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЗначениеЯчейки(Раздел, Строка, Столбец, Значение = Неопределено, Форма, ИнтерактивныйВвод)
	РазделСтрокой = Строка(Раздел);
	ИмяСтраницы 			= "Раздел" + РазделСтрокой; 
	ИмяЯчейки 				= ПолучитьИмяЯчейки(РазделСтрокой, Строка, Столбец);
	ВозвращаемоеЗначение 	= 0;
	Если ИнтерактивныйВвод 
	Тогда
		Если Форма.ТабличныйДокумент.Области.Найти(ИмяЯчейки) = Неопределено Тогда
			ТекстСообщения = НСтр("ru='В отчете не найдена ячейка %1'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, СокрЛП(ИмяЯчейки));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения); 
		Иначе	
			Если Значение = Неопределено 
			Тогда
				ВозвращаемоеЗначение = Форма.ТабличныйДокумент.Области[ИмяЯчейки].Значение;
			Иначе	
				Форма.ТабличныйДокумент.Области[ИмяЯчейки].Значение = Значение;
			КонецЕсли;
		КонецЕсли;	
	Иначе
		Если Не Форма["СтруктураДанных" + ИмяСтраницы].Свойство(ИмяЯчейки, ВозвращаемоеЗначение)
		Тогда	
			ТекстСообщения = НСтр("ru='В отчете не найдена ячейка %1'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, СокрЛП(ИмяЯчейки));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			ВозвращаемоеЗначение = 0;
		Иначе	
			Если Значение = Неопределено 
			Тогда
				ВозвращаемоеЗначение = Форма["СтруктураДанных" + ИмяСтраницы][ИмяЯчейки];
			Иначе	
				Форма["СтруктураДанных" + ИмяСтраницы][ИмяЯчейки] = Значение;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;
	Возврат ВозвращаемоеЗначение;
КонецФункции	

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьИмяЯчейки(РазделСтрокой, Строка, Столбец)
	//Предпологается что длинна имяни ячейки 13 символов
	//Где первые 4 символа П000
	//3 символа номер раздела
	//3 символа номера строки
	//3 символа номера графы
	
	ИмяЯчейки = "";
	
	РазделСтрокой = СокрЛП(РазделСтрокой);
	Если СтрДлина(РазделСтрокой) = 3 Тогда
		
	ИначеЕсли СтрДлина(РазделСтрокой) < 3 Тогда
		РазделСтрокой = ?(СтрДлина(РазделСтрокой) = 1, "00", "0") + РазделСтрокой;
	Иначе
		ТекстСообщения = НСтр("ru='Не коректный номер раздела %1'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, СокрЛП(РазделСтрокой));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения); 
	КонецЕсли;	
	
	Строка = СокрЛП(Строка);
	Если СтрДлина(Строка) = 3 Тогда
		
	ИначеЕсли СтрДлина(Строка) < 3 Тогда
		Строка = ?(СтрДлина(Строка) = 1, "00", "0") + Строка;
	Иначе
		ТекстСообщения = НСтр("ru='Не коректный номер строки %1'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, СокрЛП(Строка));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения); 
	КонецЕсли;	
	
	Столбец = СокрЛП(Столбец);
	Если СтрДлина(Столбец) = 3 Тогда
		
	ИначеЕсли СтрДлина(Столбец) < 3 Тогда
		Столбец = ?(СтрДлина(Столбец) = 1, "00", "0") + Столбец;
	Иначе
		ТекстСообщения = НСтр("ru='Не коректный номер столбца %1'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, СокрЛП(Столбец));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения); 
	КонецЕсли;	
	
	ИмяЯчейки = "П000" + РазделСтрокой + Строка + Столбец;
	
	Возврат ИмяЯчейки;
	
КонецФункции	

&НаКлиенте
Процедура ОсновныеНаправленияДеятельностиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ПараметрыОткрытия = НОвый Структура;
	ПараметрыОткрытия.Вставить("ОсновныеНаправленияДеятельности", ОсновныеНаправленияДеятельности);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораНаправленийДеятельности", ЭтаФорма, Новый Структура);	
	ОткрытьФорму("Отчет.РегламентированныйОтчетСтатистикаФорма11ОС.Форма.ФормаПодбораНаправленийДеятельности",ПараметрыОткрытия,,,,,ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура  ПослеВыбораНаправленийДеятельности(РезультатВыбора, ДопПараметры) Экспорт
	ОсновныеНаправленияДеятельности = РезультатВыбора;
	ПустоеНД = ОсновныеНаправленияДеятельности.НайтиПоЗначению(ПредопределенноеЗначение("Справочник.НаправленияДеятельности.ПустаяСсылка"));
	Если ПустоеНД <> Неопределено Тогда
		ПустоеНД.Представление = "<Пустое значение>";
	КонецЕсли;	
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Функция ИмяОтчета(ЭтаФормаИмя)
	Форма_Имя = СтрЗаменить(ЭтаФормаИмя, "Внешний", "");
	Возврат Сред(Лев(Форма_Имя, СтрНайти(Форма_Имя, ".Форма.") - 1), 7);
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИмяФормыОтчета(ЭтаФормаИмя)
	Возврат Сред(ЭтаФормаИмя, СтрНайти(ЭтаФормаИмя, ".Форма.") + 7);
КонецФункции

