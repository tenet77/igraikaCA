&НаКлиенте
Процедура Расшифровать(Команда)
	
	Попытка
		ИмяЯчейки = ЭтотОбъект.ТекущийЭлемент.ТекущаяОбласть.Имя;
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Активизируйте нужную ячейку отчета для расшифровки.'"));
		Возврат;
	КонецПопытки;

	Если (Найти(ИмяЯчейки , "П0000100") > 0)
		ИЛИ (Найти(ИмяЯчейки , "П0000200") > 0)
		ИЛИ (Найти(ИмяЯчейки , "П0000300") > 0)
		ИЛИ (Найти(ИмяЯчейки , "П0000400") > 0)
		ИЛИ (Найти(ИмяЯчейки , "П0000500") > 0)
		ИЛИ (Найти(ИмяЯчейки , "П0000600") > 0) Тогда 
		МетодРасшифровки = Ложь;
		Форма100РасшифровкаСКД(ИмяЯчейки, МетодРасшифровки);		
	//ИначеЕсли (Найти(ИмяЯчейки , "П0001") > 0) И Не ИмяЯчейки = "Ф100_01_F" Тогда //  И Не (Найти(ИмяЯчейки , "П000120000202_") > 0)
	//	МетодРасшифровки = Ложь; 
	//	Форма100_01Расшифровка(ИмяЯчейки, МетодРасшифровки);
	Иначе	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Расшифровка данной ячейки не поддерживается.'"));
	КонецЕсли;
	
	
КонецПроцедуры

