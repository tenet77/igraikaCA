&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Пропускаем инициализацию, чтобы гарантировать получение формы при передаче параметра "АвтоТест".
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	// Обход ошибки платформы "Параметр сеанса отсутствует или удален".
	ТабличныйДокумент.Очистить();
	
	СформироватьСтруктуруРеквизитовФормы();
	СформироватьСтруктуруСоответствияКодовСтрок();
	
	СоответствиеЕдиницыИзмеренияДелителю = Новый Структура;
	СоответствиеЕдиницыИзмеренияДелителю.Вставить("Окр1", 1);
	СоответствиеЕдиницыИзмеренияДелителю.Вставить("Окр1000", 1000);
	СоответствиеЕдиницыИзмеренияДелителю.Вставить("Окр1000000", 1000000);
	
	// ОПИСАНИЕ ПАРАМЕТРОВ МНОГОСТРОЧНЫХ ГРУПП
	// Идентификаторы многострочных групп
	СтруктураРеквизитовФормы.мИдГруппы11  = "П0001100001";
	СтруктураРеквизитовФормы.мИдГруппы12  = "П0001200002";
	
	
	//100.01
	КолИсхСтрокИдГруппы11  = 1;
	КолИсхСтрокИдГруппы12  = 1;
	
	//100.01
	КолКолонокИдГруппы11 = 5;
	КолКолонокИдГруппы12 = 3;
	
	СтруктураДанныхФорма100Страница1        = Новый Структура;
	СтруктураДанныхФорма100Страница2        = Новый Структура;
	СтруктураДанныхФорма100Страница3        = Новый Структура;
	СтруктураДанныхФорма100Страница4        = Новый Структура;
	СтруктураДанныхФорма100Страница5        = Новый Структура;
	СтруктураДанныхФорма100Страница6        = Новый Структура;
	СтруктураДанныхФорма100Страница7        = Новый Структура;
	СтруктураДанныхФорма100_01Страница1     = Новый Структура;
	СтруктураДанныхФорма100_01Страница2     = Новый Структура;
	СтруктураДанныхФорма100_02Страница1     = Новый Структура;
	СтруктураДанныхФорма100_02Страница2     = Новый Структура;
	//СтруктураДанныхФорма100_02Страница3     = Новый Структура;
	СтруктураДанныхФорма100_07Страница1     = Новый Структура;
	СтруктураДанныхФорма100_07Страница2     = Новый Структура;
	//СтруктураДанныхФорма100_07Страница3     = Новый Структура;
	
	// структура многострочных разделов формы
	мСтруктураМногострочныхРазделов = Новый Структура;
	//100.01
	мСтруктураМногострочныхРазделов.Вставить(СтруктураРеквизитовФормы.мИдГруппы11, СтруктураРеквизитовФормы.мИдГруппы11);
