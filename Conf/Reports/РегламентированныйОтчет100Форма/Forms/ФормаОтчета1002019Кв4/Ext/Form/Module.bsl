	СтруктураРеквизитовФормы.ВидДокумента = 0;
	СтруктураРеквизитовФормы.НомерСтраницыПриложений  = "001";
	
	НалоговыйКомитет = ?(ЗначениеЗаполнено(СтруктураРеквизитовФормы.Организация), СтруктураРеквизитовФормы.Организация.РегистрацияВНалоговомОргане, Неопределено);
	СтруктураРеквизитовФормы.НалоговыйКомитет = ?(ЗначениеЗаполнено(НалоговыйКомитет),НалоговыйКомитет,Справочники.РегистрацииВНалоговомОргане.ПустаяСсылка());
	
	ИмяРаздела = "Форма100Страница1";
	СтруктураРеквизитовФормы.НаимТекущегоРаздела = ИмяРаздела;
	ТабличныйДокумент.Вывести(Отчеты[ИмяОтчета(ЭтаФорма.ИмяФормы)].ПолучитьМакет(Сред(
	ЭтаФорма.ИмяФормы, СтрНайти(ЭтаФорма.ИмяФормы, "ФормаОтчета")) + "_" + ИмяРаздела));
	
	СтруктураРеквизитовФормы.НаимТекущегоРаздела = ИмяРаздела;
	
	//индивидуальные ключи формы
	СтруктураРеквизитовФормы.КодСтрокиДоходОтКурсовойРазницы   = "100.00.014.К";
	СтруктураРеквизитовФормы.КодСтрокиРасходыПоКурсовойРазнице = "100.00.035.К";
	СтруктураРеквизитовФормы.ГруппаОрганизаций = ПолучитьСписокСтруктурныхЕдиниц(Параметры.Организация);
	
	СформироватьОтчетныйПериод();
	
	Инициализация(Параметры.БезОткрытияФормы);
	
КонецПроцедуры

