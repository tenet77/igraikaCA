		//	
		//ИначеЕсли ИмяЭлемента = "Форма300_08Страница2_ДанныеДопСтрок" Тогда
		//	ЗначениеВДанныеФормы(ЭлементСтруктуры.Значение, П0008200001);
		//	
		//ИначеЕсли ИмяЭлемента = "Форма300_08Страница3_ДанныеДопСтрок" Тогда
		//	ЗначениеВДанныеФормы(ЭлементСтруктуры.Значение, П0008300002);
