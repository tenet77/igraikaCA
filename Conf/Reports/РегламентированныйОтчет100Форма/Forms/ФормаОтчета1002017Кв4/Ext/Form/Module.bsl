	ДобавитьПараметр(МассивПараметровДанных, "Организация", 				СтруктураРеквизитовФормы.Организация);
	ДобавитьПараметр(МассивПараметровДанных, "ПустаяОрганизация", 			ПредопределенноеЗначение("Справочник.Организации.ПустаяСсылка"));
	ДобавитьПараметр(МассивПараметровДанных, "ПустоеЗначение", 				Неопределено);
