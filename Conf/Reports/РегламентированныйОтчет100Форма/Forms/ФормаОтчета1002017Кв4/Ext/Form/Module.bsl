			Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Форма100_07Страница3" Тогда
				ОкрП000730036002 = РегламентированнаяОтчетностьКлиентСервер.ОкруглитьЧислоПоФормату(Форма, Форма.ТабличныйДокумент.Области.П000730036002.Значение);
			ИначеЕсли Форма.СтруктураДанныхФорма100_07Страница3.Свойство("П000730036002") Тогда
				ОкрП000730036002 = РегламентированнаяОтчетностьКлиентСервер.ОкруглитьЧислоПоФормату(Форма, Форма.СтруктураДанныхФорма100_07Страница3.П000730036002);
			КонецЕсли;
			
			Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Форма100_07Страница3" Тогда
				ОкрП000730037002 = РегламентированнаяОтчетностьКлиентСервер.ОкруглитьЧислоПоФормату(Форма, Форма.ТабличныйДокумент.Области.П000730037002.Значение);
			ИначеЕсли Форма.СтруктураДанныхФорма100_07Страница3.Свойство("П000730037002") Тогда
				ОкрП000730037002 = РегламентированнаяОтчетностьКлиентСервер.ОкруглитьЧислоПоФормату(Форма, Форма.СтруктураДанныхФорма100_07Страница3.П000730037002);
			КонецЕсли;
			
			
			П000730038002 = ОкрП000730031002 + ОкрП000730032002 + ОкрП000730033002 + ОкрП000730034002 + ОкрП000730035002 + ОкрП000730036002 + ОкрП000730037002;
			
			Форма.СтруктураДанныхФорма100_07Страница3.Вставить("П000730038002", П000730038002);
			Если Форма.СтруктураРеквизитовФормы.НаимТекущегоРаздела = "Форма100_07Страница3" Тогда
				Форма.ТабличныйДокумент.Области.П000730038002.Значение = П000730038002;
			КонецЕсли;
			
		КонецЕсли;
		
	//Авторасчет
	ИначеЕсли ИмяСтраницыПанели = "" Тогда
		
		Расчет(Форма,"Форма100Страница1", "");
		Расчет(Форма,"Форма100Страница2", "");
		Расчет(Форма,"Форма100Страница3", "");
		Расчет(Форма,"Форма100Страница4", "");
		
		Расчет(Форма,"Форма100_01Страница1", "");
		Расчет(Форма,"Форма100_01Страница2", "");
		
		Расчет(Форма,"Форма100_02Страница1", "");
		Расчет(Форма,"Форма100_02Страница2", "");
		Расчет(Форма,"Форма100_02Страница3", "");
		
		Расчет(Форма,"Форма100_07Страница1", "");
		Расчет(Форма,"Форма100_07Страница2", "");
		Расчет(Форма,"Форма100_07Страница3", "");
		
	КонецЕсли;
	
КонецПроцедуры

