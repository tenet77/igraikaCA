	ДобавитьПараметр(МассивПараметровДанных, "ПустоеРБП", 					ПредопределенноеЗначение("ПланВидовХарактеристик.СтатьиРасходов.ПустаяСсылка"));
	ДобавитьПараметр(МассивПараметровДанных, "СчетНЗС", 					ПредопределенноеЗначение("ПланСчетов.Хозрасчетный.НезавершенноеСтроительство"));
	ДобавитьПараметр(МассивПараметровДанных, "СчетаДоходов", 				ПредопределенноеЗначение("ПланСчетов.Хозрасчетный.Доходы"));
	ДобавитьПараметр(МассивПараметровДанных,  "ВидСубконтоСтатьиДДС", 		ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.СтатьиДвиженияДенежныхСредств"));
	
