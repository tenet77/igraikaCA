	СписокСчетовАктивов.Добавить(ПредопределенноеЗначение("ПланСчетов.Хозрасчетный.ПрочиеКраткосрочныеАктивы")); // 1630
	СписокСчетовАктивов.Добавить(ПредопределенноеЗначение("ПланСчетов.Хозрасчетный.ДолгосрочныеРасходыБудущихПериодов"));  //2920
	СписокСчетовАктивов.Добавить(ПредопределенноеЗначение("ПланСчетов.Хозрасчетный.ДолгосрочныеАктивыДляПродажи_"));
