// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	СписокЗначенийОбластьПолномочий  = ЗаполнитьСписокЗначенийОбластьПолномочий();
	Элементы.ОбластьПолномочий.СписокВыбора.Очистить();
	Для каждого Эл Из СписокЗначенийОбластьПолномочий Цикл
		Элементы.ОбластьПолномочий.СписокВыбора.Добавить(Эл.Значение, Эл.Представление);
	КонецЦикла;
	
	СписокЗначенийСтатус  = ЗаполнитьСписокЗначенийСтатус();
	Элементы.СтатусПодписанта.СписокВыбора.Очистить();
	Для каждого Эл Из СписокЗначенийСтатус Цикл
		Элементы.СтатусПодписанта.СписокВыбора.Добавить(Эл.Значение, Эл.Представление);
	КонецЦикла;
	
	СписокЗначенийАлгоритмПодписи  = ЗаполнитьАлгоритмПодписи();
	Элементы.АлгоритмПодписи.СписокВыбора.Очистить();
	Для каждого Эл Из СписокЗначенийАлгоритмПодписи Цикл
		Элементы.АлгоритмПодписи.СписокВыбора.Добавить(Эл.Значение, Эл.Представление);
	КонецЦикла;
	
	Если Параметры.Ключ.Пустая() Тогда
	     Объект.ОснованиеПолномочий = "Должностные обязанности";
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ОтпечатокСертификатаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("АлгоритмПодписи"           , Объект.АлгоритмПодписи);
	ПараметрыФормы.Вставить("СертификатНаСервере"       , Объект.СертификатНаСервере);
	ПараметрыФормы.Вставить("УстановленВЛичномХранилище", Объект.УстановленВЛичномХранилище);
	
	Оповещение = Новый ОписаниеОповещения("ПодписиУПДСертификатОбработкаВыбора", ЭтаФорма); 
	ОткрытьФорму("Справочник.ЭКОМ_Сертификаты.Форма.УФ_ФормаВсеСертификаты", ПараметрыФормы, , , , , Оповещение); 

КонецПроцедуры

#КонецОбласти


////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ЗаполнитьСписокЗначенийОбластьПолномочий()
	
	СписокЗначенийОбластьПолномочий = Новый СписокЗначений;
	СписокЗначенийОбластьПолномочий.Добавить("0", "0 - лицо, ответственное за подписание счетов-фактур");
	СписокЗначенийОбластьПолномочий.Добавить("1", "1 - лицо, совершившее сделку, операцию");
	СписокЗначенийОбластьПолномочий.Добавить("2", "2 - лицо, совершившее сделку, операцию и ответственное за ее оформление");
	СписокЗначенийОбластьПолномочий.Добавить("3", "3 - лицо, ответственное за оформление свершившегося события");
	СписокЗначенийОбластьПолномочий.Добавить("4", "4 - лицо, совершившее сделку, операцию и ответственное за подписание счетов-фактур");
	СписокЗначенийОбластьПолномочий.Добавить("5", "5 - лицо, совершившее сделку, операцию и ответственное за ее оформление и за подписание счетов-фактур");
	СписокЗначенийОбластьПолномочий.Добавить("6", "6 - лицо, ответственное за оформление свершившегося события и за подписание счетов-фактур");
	
	Возврат СписокЗначенийОбластьПолномочий;
	
КонецФункции

&НаКлиенте
Функция ЗаполнитьСписокЗначенийСтатус()
	
	СписокЗначенийСтатус = Новый СписокЗначений;
	СписокЗначенийСтатус.Добавить("1", "1 - работник организации продавца товаров (работ, услуг, имущественных прав");
	СписокЗначенийСтатус.Добавить("2", "2 - работник организации - составителя информации продавца");
	СписокЗначенийСтатус.Добавить("3", "3 - работник иной уполномоченной организации");
	СписокЗначенийСтатус.Добавить("4", "4 - уполномоченное физическое лицо (в том числе индивидуальный предприниматель)");
    СписокЗначенийСтатус.Добавить("5", "5 - работник организации — покупателя");
	СписокЗначенийСтатус.Добавить("6", "6 - работник организации — составителя файла обмена информации покупателя, если составитель файла обмена информации покупателя не является покупателем");

	Возврат СписокЗначенийСтатус;

КонецФункции

