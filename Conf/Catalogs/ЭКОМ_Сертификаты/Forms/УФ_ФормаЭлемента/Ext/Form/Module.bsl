&НаСервере
Процедура ОбработатьДанныеСертификата(Результат)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Организации.Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.ИНН = &ИНН";
	
	Запрос.УстановитьПараметр("ИНН", Прав(Результат.ИНН, 12));
	РезультатЗапроса = Запрос.Выполнить();	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Объект.Организация = Выборка.Ссылка; 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписиУПДСертификатОбработкаВыбора(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
	    Возврат;
	КонецЕсли;

	Объект.ДолжностьПодписанта  = Результат.ДолжностьПодписанта;
	Объект.ФамилияПодписанта    = Результат.ФамилияПодписанта;
	Объект.ИмяПодписанта        = Результат.ИмяПодписанта;
	Объект.ОтчествоПодписанта   = Результат.ОтчествоПодписанта;
	Объект.ОтпечатокСертификата = Результат.ОтпечатокСертификата;
	Объект.ИмяСертификата       = Результат.ИмяСертификата;	
	Объект.Наименование         = Результат.ИмяСертификата;
	Объект.АлгоритмПодписи      = Результат.АлгоритмПодписи;
	Объект.СертификатНаСервере        = Результат.СертификатНаСервере;
    Объект.УстановленВЛичномХранилище = Результат.УстановленВЛичномХранилище;
	
	ОбработатьДанныеСертификата(Результат);

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСертификат(Команда)
    Записать();
    МассивЛогаСобытий = Новый Массив;
    Если Объект.СертификатНаСервере Тогда
		СертификатПроверен = ЭКОМ_ОбщегоНазначения.ПроверитьСертификат(Объект.Ссылка, МассивЛогаСобытий);
	Иначе	
		СертификатПроверен = ЭКОМ_ОбщегоНазначенияКлиент.ПроверитьСертификат(Объект.Ссылка, МассивЛогаСобытий);
    КонецЕсли;
	
	Если МассивЛогаСобытий.Количество() > 0 Тогда
		ЭтаФорма.ТекстСообщения = ЭКОМ_ОбщегоНазначенияКлиент.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий);
	КонецЕсли;
	
	СообщениеНаФорме = ?(СертификатПроверен = Истина, "Проверка успешно выполнена", "Ошибка проверки. Подробности в нижней части этой формы - строка События");
    Элементы.ТекстСообщения.ЦветТекста = ?(ПустаяСтрока(ТекстСообщения), WebЦвета.Черный, WebЦвета.Кирпичный);

    ПоказатьПредупреждение(Новый ОписаниеОповещения, СообщениеНаФорме, , "Проверка подписи этим сертификатом для этой организации");
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    ВсеАлгоритмыПодписей = ЭКОМ_ОбщегоНазначения.ВсеАлгоритмыПодписей();
    СписокВыбораАлгоритма = Элементы.АлгоритмПодписи.СписокВыбора;
    СписокВыбораАлгоритма.Очистить();
    СписокВыбораАлгоритма.ЗагрузитьЗначения(ВсеАлгоритмыПодписей);

КонецПроцедуры

&НаКлиенте
Процедура ТекстСообщенияНажатие(Элемент, СтандартнаяОбработка)
    СтандартнаяОбработка = Ложь;
    ПоказатьПредупреждение(Новый ОписаниеОповещения, ЭтаФорма.ТекстСообщения, , "События и ошибки");
КонецПроцедуры

#КонецОбласти



