	Возврат СписокФорматовИнфоПолей;

КонецФункции 

Функция ПроверкаНаУникальностьСправочника(ИмяФорматаУПД, Ссылка) Экспорт   
	
	ЗначениеУникально = Ложь;
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЭКОМ_ИнфоПоля.Ссылка
		|ИЗ
		|	Справочник.ЭКОМ_ИнфоПоля КАК ЭКОМ_ИнфоПоля
		|ГДЕ
		|	ЭКОМ_ИнфоПоля.ФорматУПД = &ФорматУПД
		|	И НЕ ЭКОМ_ИнфоПоля.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("ФорматУПД", ИмяФорматаУПД);
	Запрос.УстановитьПараметр("Ссылка"   , Ссылка);	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
	     Выборка = РезультатЗапроса.Выбрать();
		 Если Выборка.Количество() = 1 
			  И НЕ ЗначениеЗаполнено(Ссылка) Тогда
		      ЗначениеУникально = Истина;
		  КонецЕсли;
	Иначе
		 ЗначениеУникально = Истина; 
	КонецЕсли;
	
	Возврат ЗначениеУникально;
	
КонецФункции

Процедура ЗаполнитьУПД_поУмолчанию(ЭКОМ_ИнфоПоляСсылка) Экспорт
	
	ЭКОМ_ИнфоПолеОбъект = ЭКОМ_ИнфоПоляСсылка.ПолучитьОбъект();
	
	ЭКОМ_ИнфоПолеОбъект.ФорматУПД = ЭКОМ_ИнфоПолеОбъект.Наименование;
	  
	НовСтр = ЭКОМ_ИнфоПолеОбъект.ТабличнаяЧасть.Добавить();
	НовСтр.Идентификатор = "отправитель";
	НовСтр.ТипПоля       = "ИнфПолФХЖ1";
	НовСтр.Источники     = "ORDER.HEAD.RECIPIENT";
	НовСтр.Обязательное  = Истина;    	
	
	НовСтр = ЭКОМ_ИнфоПолеОбъект.ТабличнаяЧасть.Добавить();
