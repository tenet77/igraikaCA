
Функция ПодключениеПодключитьсяSOAPНаСервере(ПараметрыОбъекта) Экспорт
	
	РежимСовместимости = ЭКОМ_ОбщегоНазначения.ПолучитьРежимСовместимости();
	
	ИмяСобытия = "Подключение по SOAP на сервере";
	МассивЛогаСобытий = Новый Массив;
	Если РежимСовместимости < 8370 Тогда 		
		Рез = ЭКОМ_ОбщегоНазначения.НовыйSOAPОбращение(ПараметрыОбъекта, "getListRequest",,, МассивЛогаСобытий);
			
	Иначе	
		Рез = ЭКОМ_ОбщегоНазначения.WS_ПолучитьСписокДокументов_getList();	
		
	КонецЕсли;
	
	// Получение ответа от сервиса.
	Если Рез.errorCode = "" Тогда
		ТекстЛогаСобытий = "Нет данных об ответе или ответ сформирован не верно";
		ЗаписьСтруктурыЛога = ЭКОМ_ОбщегоНазначения.ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
	ИначеЕсли НЕ Рез.errorCode = "0" Тогда
		ТекстЛогаСобытий = "Ошибка подключения. (" + Рез.errorCode + ": " + Рез.errorMessage + ")";
		ЗаписьСтруктурыЛога = ЭКОМ_ОбщегоНазначения.ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
	Иначе
		ТекстЛогаСобытий = "Подключение по SOAP успешно";
		ЗаписьСтруктурыЛога = ЭКОМ_ОбщегоНазначения.ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Успешно, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
	КонецЕсли;

	
	ТекстСообщения = "";
	Если МассивЛогаСобытий.Количество() > 0 Тогда
	   ТекстСообщения = ЭКОМ_ОбщегоНазначения.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий);
	КонецЕсли;
		
	Возврат ТекстСообщения;
	
КонецФункции

Функция ПодключениеПодключитьсяFTPНаСервере(ПараметрыОбъекта, ТипОбменаЭТРН) Экспорт
	
    ТекстСообщения = ЭКОМ_ОбщегоНазначения.ПроверкаПодключенияПоFTP(ПараметрыОбъекта, ТипОбменаЭТРН);	
	Возврат ТекстСообщения;
	
КонецФункции

Функция ПолучитьСписокСтран() Экспорт
	
	СписокСтран = Новый СписокЗначений;
	СписокСтран.Добавить("ru", "Россия");
	СписокСтран.Добавить("kz", "Казахстан");
	
	Возврат СписокСтран;

КонецФункции 

Функция ПолучитьНастройкиПоУмолчанию() Экспорт
	
	НастройкиПоУмолчанию = Новый Структура;
	НастройкиПоУмолчанию.Вставить("СерверFTP"              , "ftpex.e-vo.ru");
	НастройкиПоУмолчанию.Вставить("ЭТРН_Сервер"            , "89.208.197.1");
	НастройкиПоУмолчанию.Вставить("СерверAPI"              , "api-service.e-vo.ru");
	НастройкиПоУмолчанию.Вставить("СерверREST"             , "exite-api.e-vo.ru");
	НастройкиПоУмолчанию.Вставить("ВходящийПутьFTP"        , "/inbox/");
	НастройкиПоУмолчанию.Вставить("ИсходящийПутьFTP"       , "/outbox/");
	НастройкиПоУмолчанию.Вставить("Порт"                   , 21);
	НастройкиПоУмолчанию.Вставить("ОбменПоSOAP"            , Истина);
	НастройкиПоУмолчанию.Вставить("Страна"                 , "ru");
	НастройкиПоУмолчанию.Вставить("КоличествоФайловВПакете", 500);
	
	Возврат НастройкиПоУмолчанию;

КонецФункции 

