
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПроверитьОтобразитьОбновления();
	ЗаполнитьМестаИспользованияРоли();
	ТабличнаяЧастьОбновитьСписокВыбора();
	КолонкиУстановитьОтборПоВкладке();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	 
    Если ЗавершениеРаботы = Истина Тогда
        ТекстПредупреждения = "Docrobot: для корректного сохранения настроек сначала необходимо закрыть форму ""Docrobot роль""!";
        Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ПередЗакрытиемНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПередЗакрытиемНаСервере()
	
	ОписаниеНастроек = Новый ОписаниеНастроек;
	ОписаниеНастроек.Представление = "Результат выбора пользователем из списка ""Табличная часть""";                                     
	ХранилищеНастроекДанныхФорм.Сохранить("ЭлементФормыЭкомРоли", "ТабличнаяЧасть", ТабличнаяЧасть, ОписаниеНастроек, ПараметрыСеанса.ТекущийПользователь.Наименование);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура ОбновитьКнопки(Команда)
	
	ВызватьМетодМодуляОбъекта("ОбновитьКнопки", Ложь);
	ПроверитьОтобразитьОбновления("Кнопки");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКолонки(Команда)
	
	ВызватьМетодМодуляОбъекта("ОбновитьКолонки", Ложь);
	ПроверитьОтобразитьОбновления("Колонки");
	ТабличнаяЧастьОбновитьСписокВыбора();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКонтрагенты(Команда)

	ВызватьМетодМодуляОбъекта("ОбновитьКонтрагентов", Ложь);
	ПроверитьОтобразитьОбновления("Контрагенты");

КонецПроцедуры

&НаКлиенте
Процедура УправлениеПометками(Команда)
	Если Элементы.Страницы.ТекущаяСтраница <> Неопределено Тогда
		ИмяЭлемента = СтрЗаменить(Элементы.Страницы.ТекущаяСтраница.Имя, "Группа", "");
		ТабличноеПоле = Элементы.Найти(ИмяЭлемента);      
		Если ТабличноеПоле.ВыделенныеСтроки.Количество() = 1 Тогда 
			Если ТабличноеПоле.Имя = "Контрагенты" Тогда
				Для Каждого Строка Из Объект.ОграниченияПоКонтрагентам Цикл    
					Если Строка.Контрагент = ТабличноеПоле.ТекущиеДанные.Контрагент Тогда
						Строка.Доступность = Команда.Имя = "ПометитьВсе";
					КонецЕсли;  
				КонецЦикла
			Иначе
				Для Каждого Строка Из Объект[ИмяЭлемента] Цикл
					Строка.Доступность = Команда.Имя = "ПометитьВсе";
				КонецЦикла;
			КонецЕсли;
		Иначе
			Для Каждого Идентификатор Из ТабличноеПоле.ВыделенныеСтроки Цикл
				ТабличноеПоле.ДанныеСтроки(Идентификатор).Доступность = Команда.Имя = "ПометитьВсе";
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТабличнаяЧастьПриИзменении(Элемент)
	КолонкиУстановитьОтборПоВкладке();
КонецПроцедуры

&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	ПроверитьОтобразитьОбновления(ТекущаяСтраница.Заголовок);

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ ДЛЯ ПОДДЕРЖКИ МЕХАНИЗМОВ ФОРМЫ

// Проверяет доступные обновления для роли и сообщает о необходимости обновиться
//
// Параметры:
//  Вкладка  - Строка - вкладка, данные которой необходимо обновить. Если параметр пустой, обновляются данные всех вкладок
//
&НаКлиенте
Процедура ПроверитьОтобразитьОбновления(Вкладка = Неопределено)

	// Для вкладки кнопок.
	Если НЕ (Вкладка = "Колонки" ИЛИ Вкладка = "Контрагенты") Тогда
		ЭлементОбновитьКнопки = Элементы.Найти("КнопкиОбновить");
		Если ЭлементОбновитьКнопки <> Неопределено Тогда
			НужноОбновление = ВызватьМетодМодуляОбъекта("ПроверитьОбновлениеКнопок");
			ЭлементОбновитьКнопки.Отображение = ?(НужноОбновление,
				ПредопределенноеЗначение("ОтображениеКнопки.КартинкаИТекст"),
				ПредопределенноеЗначение("ОтображениеКнопки.Картинка"));
		КонецЕсли;
	КонецЕсли;
		
	// Для вкладки колонок.
	Если НЕ (Вкладка = "Кнопки" ИЛИ Вкладка = "Контрагенты") Тогда
		ЭлементОбновитьКолонки = Элементы.Найти("КолонкиОбновить");
		Если ЭлементОбновитьКолонки <> Неопределено Тогда
			НужноОбновление = ВызватьМетодМодуляОбъекта("ПроверитьОбновлениеКолонок");
			ЭлементОбновитьКолонки.Отображение = ?(НужноОбновление,
				ПредопределенноеЗначение("ОтображениеКнопки.КартинкаИТекст"),
				ПредопределенноеЗначение("ОтображениеКнопки.Картинка"));
		КонецЕсли;
	КонецЕсли;
	
	// Для вкладки контрагенты.
	Если НЕ (Вкладка = "Колонки" ИЛИ Вкладка = "Кнопки") Тогда 
		ЭлементОбновитьКонтрагенты = Элементы.Найти("КонтрагентыОбновить");
		Если ЭлементОбновитьКонтрагенты <> Неопределено Тогда
			НужноОбновление = ВызватьМетодМодуляОбъекта("ПроверитьОбновлениеКонтрагентов");
			ЭлементОбновитьКонтрагенты.Отображение = ?(НужноОбновление,
				ПредопределенноеЗначение("ОтображениеКнопки.КартинкаИТекст"),
				ПредопределенноеЗначение("ОтображениеКнопки.Картинка"));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры // ПроверитьОтобразитьОбновления()

// Выполняет экспортный метод модуля текущего объекта
//
// Параметры:
//  Метод  - Строка - имя метода, к которому происходит обращение
//  ЭтоФункция  - Булево - пометка возможности возврата значения
//
// Возвращаемое значение:
//   AnyType   - любое значение, которое может быть возвращено указанным методом
//
&НаСервере
Функция ВызватьМетодМодуляОбъекта(Метод, ЭтоФункция = Истина)

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Если ЭтоФункция Тогда
		Возврат Вычислить("ОбработкаОбъект." + Метод + "()");
	Иначе
		Выполнить "ОбработкаОбъект." + Метод + "()";
	КонецЕсли;
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
КонецФункции // ВызватьМетодМодуляОбъекта()

// Устанавливает отбор строк на вкладке Колонки
//
&НаКлиенте
Процедура КолонкиУстановитьОтборПоВкладке()
	
	Элементы.Колонки.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("Путь", ТабличнаяЧасть));
	
КонецПроцедуры // КолонкиУстановитьОтборПоВкладке()

// Обновляет список выбора для реквизита формы ТабличнаяЧасть
//
&НаКлиенте
Процедура ТабличнаяЧастьОбновитьСписокВыбора()

	Элементы.ТабличнаяЧасть.СписокВыбора.ЗагрузитьЗначения(ТабличнаяЧастьОбновитьСписокВыбораНаСервере());

	Если ЗначениеЗаполнено(ТабличнаяЧасть) 
		И НЕ Элементы.ТабличнаяЧасть.СписокВыбора.НайтиПоЗначению(ТабличнаяЧасть) = Неопределено Тогда
		// Оставляем текущее значение.
	ИначеЕсли Элементы.ТабличнаяЧасть.СписокВыбора.Количество() = 0 Тогда
		ТабличнаяЧасть = "";
	Иначе
		ТабличнаяЧасть = Элементы.ТабличнаяЧасть.СписокВыбора.Получить(0).Значение;
	КонецЕсли;
	
КонецПроцедуры // ТабличнаяЧастьОбновитьСписокВыбора()

// Получает и устанавливает настройки пользователя из хранилища настроек, возвращает доступные для выбора вкладки основной формы
//
// Возвращаемое значение:
//   Массив   - доступные для выбора вкладки основной формы
//
&НаСервере
Функция ТабличнаяЧастьОбновитьСписокВыбораНаСервере()
	
	ПараметрыОтбора = Новый Структура("КлючОбъекта, ИмяПользователя", "ЭлементФормыЭкомРоли", ПараметрыСеанса.ТекущийПользователь.Наименование);
	ВыборкаНастроек = ХранилищеНастроекДанныхФорм.Выбрать(ПараметрыОтбора);
	Пока ВыборкаНастроек.Следующий() Цикл
		ЭтаФорма[ВыборкаНастроек.КлючНастроек] = ВыборкаНастроек.Настройки;
	КонецЦикла;
	
	КолонкиКопия = Объект.Колонки.Выгрузить();
	КолонкиКопия.Свернуть("Путь");
	Возврат КолонкиКопия.ВыгрузитьКолонку("Путь");

КонецФункции // ТабличнаяЧастьОбновитьСписокВыбораНаСервере()

// Заполняет реквизит формы Пользователи
//
&НаСервере
Процедура ЗаполнитьМестаИспользованияРоли()

	Для Каждого Роль Из ВызватьМетодМодуляОбъекта("ПолучитьМестаИспользованияРоли") Цикл
		СтрокаПользователя = ЭтаФорма.Пользователи.Добавить();
		СтрокаПользователя.Пользователь = Роль;
	КонецЦикла;

КонецПроцедуры // ЗаполнитьМестаИспользованияРоли()
