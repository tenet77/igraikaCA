// Обновляет коллекцию кнопок и колонок
//
Процедура ОбновитьКнопкиИКолонки(ЭтоОФ) Экспорт

	ОбновитьКнопки(ЭтоОФ);
	ОбновитьКолонки();

КонецПроцедуры // ОбновитьКнопкиИКолонки()

// Возвращает коллекцию пользователей, которым назначена данная роль
//
// Возвращаемое значение:
//   Массив   - коллекция пользователей, использующих текущую роль
//
Функция ПолучитьМестаИспользованияРоли() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЭКОМ_ПользователиРоли.Ссылка
		|ИЗ
		|	Справочник.ЭКОМ_Пользователи.Роли КАК ЭКОМ_ПользователиРоли
		|ГДЕ
		|	ЭКОМ_ПользователиРоли.Роль = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЭКОМ_ПользователиРоли.Ссылка.Наименование";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Таблица = РезультатЗапроса.Выгрузить();

	Возврат Таблица.ВыгрузитьКолонку("Ссылка");
	
КонецФункции // ПолучитьМестаИспользованияРоли()

// Функция возвращает уникальную последовательность символов для формирования имен диоанических кнопок
//
// Возвращаемое значение:
//   Строка   - уникальная строка
//
Функция ПолучитьУникальнуюСтроку()

	Строка = ПолучитьИмяВременногоФайла();
	Строка = СтрЗаменить(Строка, ".tmp", "");
	Строка = СтрЗаменить(Строка, "/tmp/", "");
	Пока НЕ Найти(Строка, "\") = 0 Цикл
		Позиция = Найти(Строка, "\");
		Строка = Прав(Строка, СтрДлина(Строка) - Позиция);
	КонецЦикла;

	Возврат Строка;
	
КонецФункции // ПолучитьУникальнуюСтроку()

Процедура ПриЗаписи(Отказ)
	
	Запрос = Новый Запрос("ВЫБРАТЬ Наименование ИЗ Справочник.ЭКОМ_Роли ГДЕ Наименование = &Наименование");
	Запрос.УстановитьПараметр("Наименование",Наименование);
	Результат = Запрос.Выполнить();
	Если Результат.Выгрузить().Количество() > 1 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Роль с наименованием <" + Наименование + "> уже существует!";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры
