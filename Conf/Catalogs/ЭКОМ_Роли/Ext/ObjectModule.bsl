
////////////////////////////////////////////////////////////////////////////////
// КНОПКИ

// Обновляет коллекцию кнопок
//
Процедура ОбновитьКнопки(ЭтоОФ = Ложь) Экспорт

	КнопкиШаблонов = ПолучитьКнопкиИзШаблонов(ЭтоОФ);
	
	Для Каждого Кнопка Из КнопкиШаблонов Цикл
		КнопкиЭлементаОтбор = Кнопки.НайтиСтроки(Новый Структура("Синоним, Путь", Кнопка.Синоним, Кнопка.Путь));
		Если КнопкиЭлементаОтбор.Количество() = 1 Тогда
			 ЗаполнитьЗначенияСвойств(Кнопка, КнопкиЭлементаОтбор.Получить(0), "Доступность, Синоним");
		КонецЕсли;
	КонецЦикла;
	
	Кнопки.Загрузить(КнопкиШаблонов);
	
КонецПроцедуры // ОбновитьКнопки()

// Проверяет наличие обновлений кнопок
//
// Возвращаемое значение:
//   Булево   - признак наличия обновления
//
Функция ПроверитьОбновлениеКнопок(ЭтоОФ = Ложь) Экспорт

	НужноОбновление = Ложь;
	КнопкиВрем = ПолучитьКнопкиИзШаблонов(ЭтоОФ);
	// Проверка на наличие изменений.
	Если КнопкиВрем.Количество() <> Кнопки.Количество() Тогда 
		НужноОбновление = Истина;
	КонецЕсли;
	
	Если НЕ НужноОбновление Тогда
		Для Каждого КнопкаВрем Из КнопкиВрем Цикл
			ЗаписиКнопок = Кнопки.НайтиСтроки(Новый Структура("Синоним, Путь", КнопкаВрем.Синоним, КнопкаВрем.Путь));
			// Одной паре Синоним + Шаблон из шаблонов должна соответствовать одна кнопка роли.
			// Если их нет или несколько, значит есть свежиен данные для этой роли.
			Если НЕ ЗаписиКнопок.Количество() = 1 Тогда
				НужноОбновление = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат НужноОбновление;
	
КонецФункции // ПроверитьОбновлениеКнопок()

// Получает информацию о кнопках из шаблонов
//
// Возвращаемое значение:
//   ТаблицаЗначений   - информация о кнопках из шаблонов
//
Функция ПолучитьКнопкиИзШаблонов(ЭтоОФ = Ложь)

	Результат = Кнопки.ВыгрузитьКолонки();
	Действия = Новый Структура("Входящие, Исходящие, Документы",
		"ДинамическаяКнопкаПолучитьВыполнитьНажатие",
		"ДинамическаяКнопкаОтправитьВыполнитьНажатие",
		"ДинамическаяКнопкаВыполнитьНажатие");
	// Здесь нужно указать типы транзакций для шаблонов, на которые не нужно создавать кнопки.
	КнопкиИсключения = Новый Массив;
	КнопкиИсключения.Добавить("Исходящий CONDRA (Принятие)");
	КнопкиИсключения.Добавить("Исходящий CONDRA (Отклонение)");
	КнопкиИсключения.Добавить("Входящий DP_IZVPOL_23 (подтверждение аннулирования)");
	КнопкиИсключения.Добавить("Входящий DP_PRANNUL (аннулирование)");
	КнопкиИсключения.Добавить("Входящий DP_UVUTOCH_24 (отклонение аннулирования)");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Настройки.ДополнительнаяКонстанта КАК Имя,
		|	Настройки.ЗначениеДополнительногоХранилища КАК Данные
		|ИЗ
		|	РегистрСведений.ЭКОМ_ЗначениеДополнительныхКонстант КАК Настройки
		|ГДЕ
		|	(Настройки.ДополнительнаяКонстанта ПОДОБНО ""СтруктураФайлаXMLВходящие""
		|			ИЛИ Настройки.ДополнительнаяКонстанта ПОДОБНО ""СтруктураФайлаXMLИсходящие""
		|			ИЛИ Настройки.ДополнительнаяКонстанта ПОДОБНО ""СтруктураФайлаXMLДокументы"")";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Записи = РезультатЗапроса.Выбрать();
	
	Пока Записи.Следующий() Цикл
		// Получаем дерево из хранилища значений.
		Данные = Записи.Данные.Получить();
		Если НЕ ТипЗнч(Данные) = Тип("ДеревоЗначений") Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого СтрокаДерева Из Данные.Строки Цикл
			Если СтрокаДерева.Использовать Тогда
				// Исключаем шаблоны, для которых типы транзакций не предполагают создание кнопок.
				Если НЕ Данные.Колонки.Найти("ТипТранзакции") = Неопределено
					И НЕ КнопкиИсключения.Найти(СтрокаДерева.ТипТранзакции) = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				Путь = СтрЗаменить(Записи.Имя, "СтруктураФайлаXML", "");
				
				Если Данные.Колонки.Найти("ТипТранзакции") = Неопределено Тогда
					ИмяКнопки = ПолучитьУникальнуюСтроку();
				Иначе
					ИсключаемыеСимволы = "!""№;%:?*()-+=@#$&' ";
					ИмяКнопки = ТРег(СтрокаДерева.ТипТранзакции);
					Для Номер = 1 По СтрДлина(ИсключаемыеСимволы) Цикл
						Символ = Сред(ИсключаемыеСимволы, Номер, 1);
						ИмяКнопки = СтрЗаменить(ИмяКнопки, Символ, "");
					КонецЦикла;
				КонецЕсли;
				
				НоваяСтрока 		= Результат.Добавить();
				НоваяСтрока.Синоним = СтрокаДерева.Кнопка;
				НоваяСтрока.Имя 	= ИмяКнопки;
				НоваяСтрока.Путь 	= "__" + Путь; // "__" указывает на то, что командная панель для вывода будет определена в другом месте (в нашем случае в настройках шаблона)
				НоваяСтрока.Доступность = Истина;
				НоваяСтрока.ИмяКоманды = ИмяКнопки;
				Если НЕ Действия.Свойство(Путь, НоваяСтрока.Действие) Тогда
					Результат.Удалить(НоваяСтрока);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	//Docrobot 2021.11.29 MOD-1340 ((
	Если Результат.НайтиСтроки(новый структура("Имя","ВходящийPricat")).Количество() = 1 Тогда
		Если ЭтоОФ Тогда 
			Результат.НайтиСтроки(новый структура("Имя","ВходящийPricat"))[0].Путь = "КоманднаяПанельПрайсЛист";
		Иначе
			Результат.НайтиСтроки(новый структура("Имя","ВходящийPricat"))[0].Путь = "КоманднаяПанельПрайсЛистВходящий";
		КонецЕсли;
	КонецЕсли;
	Если Результат.НайтиСтроки(новый структура("Имя","ИсходящийPricat")).Количество() = 1 Тогда
		Если ЭтоОФ Тогда 
			Результат.НайтиСтроки(новый структура("Имя","ИсходящийPricat"))[0].Путь = "КоманднаяПанельПрайсЛист";	
		Иначе
			Результат.НайтиСтроки(новый структура("Имя","ИсходящийPricat"))[0].Путь = "КоманднаяПанельПрайсЛистИсходящий";		
		КонецЕсли;
	КонецЕсли;
	
	//Docrobot 2021.11.29 MOD-1340 ))
	
	// Добавление результата предопределенными кнопками.
	Для Каждого Строка Из ПолучитьПредопределенныеКнопки(ЭтоОФ) Цикл
		ЗаполнитьЗначенияСвойств(Результат.Добавить(), Строка);
	КонецЦикла;
	ПлюсRETORD = Результат.Добавить();
	ПлюсRETORD.Действие    = "СоздатьRETORD";
	ПлюсRETORD.Доступность = Истина;
	ПлюсRETORD.Имя         = "СоздатьRETORD";
	ПлюсRETORD.ИмяКоманды  = "СоздатьRETORD";
	ПлюсRETORD.Путь        = ?(ЭтоОФ, "КоманднаяПанельПоставщик", "СписокДляПоставщикаКонтекстноеМеню"); 
	ПлюсRETORD.Синоним     = "Создать обратный заказ(RETORD)";
	
	Возврат Результат;

КонецФункции // ПолучитьКнопкиИзШаблонов()

// Возвращает предопределенные кнопки из макета
//
// Возвращаемое значение:
//   ТаблицаЗначений   - коллекция предопределенных кнопок для добавления к списку динамчиеских кнопок
//
Функция ПолучитьПредопределенныеКнопки(ЭтоОФ = Ложь)

	ОписаниеТиповСтрока = Новый ОписаниеТипов("Строка", ,,, Новый КвалификаторыСтроки(100, ДопустимаяДлина.Переменная));
	ТипыДанных = Новый Структура("Синоним, Имя, Доступность, Путь, ИмяКоманды, Действие, Предопределенная",
		ОписаниеТиповСтрока,
		ОписаниеТиповСтрока,
		Новый ОписаниеТипов("Булево"),
		ОписаниеТиповСтрока,
		ОписаниеТиповСтрока,
		ОписаниеТиповСтрока,
		Новый ОписаниеТипов("Булево"));
	
	Макет = ЭтотОбъект.ПолучитьМакет(?(ЭтоОФ, "ОФ_ОбязательныеКнопки", "УФ_ОбязательныеКнопки"));
	КолонкаИндекса = 1;
	ТаблицаДанных = Новый ТаблицаЗначений;
	НомерКолонки = 0;
	
	// Формирование колонок.
	Пока Истина Цикл
		НомерКолонки = НомерКолонки + 1;
		ИмяКолонки = Макет.Область(1, НомерКолонки).Текст;
		Если ПустаяСтрока(ИмяКолонки) Тогда
			Прервать;
		КонецЕсли; 
		Тип = ОписаниеТиповСтрока;
		ТипыДанных.Свойство(ИмяКолонки, Тип);
		ТаблицаДанных.Колонки.Добавить(ИмяКолонки, Тип);
	КонецЦикла;
	
	СчетчикКолонок = НомерКолонки - 1;
	
	НомерСтроки = 1;
	ФлагПрерывания = Ложь;
	
	Пока Истина Цикл
		НомерСтроки = НомерСтроки + 1;
		Строка = ТаблицаДанных.Добавить();
		
		Для Колонка = 1 ПО СчетчикКолонок Цикл
			ТекстКолонки = Макет.Область(НомерСтроки, Колонка).Текст;
			Если ПустаяСтрока(ТекстКолонки) Тогда
				Если Колонка = КолонкаИндекса Тогда
					ФлагПрерывания = Истина;
					ТаблицаДанных.Удалить(Строка);
				КонецЕсли;
			Иначе
				Строка[Колонка - 1] = ТекстКолонки;
			КонецЕсли;
			
			Если ФлагПрерывания Тогда
				Прервать
			КонецЕсли;
		КонецЦикла;
		
		Если ФлагПрерывания Тогда
			Прервать
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТаблицаДанных;

КонецФункции // ПолучитьПредопределенныеКнопки()

////////////////////////////////////////////////////////////////////////////////
// КОЛОНКИ

// Обновляет коллекцию колонок
//
Процедура ОбновитьКолонки() Экспорт

	КолонкиЗапросов = ПолучитьКолонкиИзЗапросов();
	
	// Перенос отметок и синонимов из настроенных ранее пользователем в полученные колонки.
	Для Каждого Колонка Из КолонкиЗапросов Цикл
		КолонкиЭлементаОтбор = Колонки.НайтиСтроки(Новый Структура("Имя, Путь", Колонка.Имя, Колонка.Путь));
		Если КолонкиЭлементаОтбор.Количество() = 1 Тогда
			 ЗаполнитьЗначенияСвойств(Колонка, КолонкиЭлементаОтбор.Получить(0));
		КонецЕсли;
	КонецЦикла;
	
	// Попытаемся восстановить ранее заданную пользователем последовательность колонок (для тех, что есть в новой таблице).
	Индекс = 0;
	Для Каждого Колонка Из Колонки Цикл
		КолонкиЗапросаОтбор = КолонкиЗапросов.НайтиСтроки(Новый Структура("Имя, Путь", Колонка.Имя, Колонка.Путь));
		Если КолонкиЗапросаОтбор.Количество() = 1 Тогда
			КолонкаЗапроса = КолонкиЗапросаОтбор.Получить(0);
			Смещение = Индекс - КолонкиЗапросов.Индекс(КолонкаЗапроса);
			КолонкиЗапросов.Сдвинуть(КолонкаЗапроса, Смещение);
			Индекс = Индекс + 1;
		КонецЕсли;
	КонецЦикла;
	
	Колонки.Загрузить(КолонкиЗапросов);

КонецПроцедуры // ОбновитьКолонки()

// Проверяет наличие обновлений колонок
//
// Возвращаемое значение:
//   Булево   - признак наличия обновления
//
Функция ПроверитьОбновлениеКолонок() Экспорт

	НужноОбновление = Ложь;
	КолонкиВрем = ПолучитьКолонкиИзЗапросов();
	// Проверка на наличие изменений.
	Если КолонкиВрем.Количество() <> Колонки.Количество() Тогда 
		НужноОбновление = Истина;
	КонецЕсли;
	
	Если НЕ НужноОбновление Тогда
		Для Каждого КолонкаВрем Из КолонкиВрем Цикл
			ЗаписиКолонок = Колонки.НайтиСтроки(Новый Структура("Имя, Путь", КолонкаВрем.Имя, КолонкаВрем.Путь));
			// Одной паре Синоним + Шаблон из шаблонов должна соответствовать одна кнопка роли.
			// Если их нет или несколько, значит есть свежиен данные для этой роли.
			Если НЕ ЗаписиКолонок.Количество() = 1 Тогда
				НужноОбновление = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат НужноОбновление;
	
КонецФункции // ПроверитьОбновлениеКолонок()

// Получает инфомрацию о колонках из запросов
//
// Возвращаемое значение:
//   ТаблицаЗначений   - информация о кнопках из шаблонов
//
Функция ПолучитьКолонкиИзЗапросов()

	Результат = Колонки.ВыгрузитьКолонки();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА Настройки.ДополнительнаяКонстанта ПОДОБНО ""СлужебныйЗапросДляФормыПоставщика""
		|			ТОГДА ""Поставщик""
		|		КОГДА Настройки.ДополнительнаяКонстанта ПОДОБНО ""СлужебныйЗапросДляФормыПокупателя""
		|			ТОГДА ""Сеть""
		|		КОГДА Настройки.ДополнительнаяКонстанта ПОДОБНО ""СлужебныйЗапросДляФормыЭТРН""
		|			ТОГДА ""ЭТРН""
		|		КОГДА Настройки.ДополнительнаяКонстанта ПОДОБНО ""СлужебныйЗапросДляФормыCondra""
		|			ТОГДА ""Condra""
		|		КОГДА Настройки.ДополнительнаяКонстанта ПОДОБНО ""СлужебныйЗапросДляФормыПрайсЛист""
		|			ТОГДА ""ПрайсЛист""
		|	КОНЕЦ КАК Имя,
		|	Настройки.ЗначениеДополнительногоХранилища КАК Данные
		|ИЗ
		|	РегистрСведений.ЭКОМ_ЗначениеДополнительныхКонстант КАК Настройки
		|ГДЕ
		|	(Настройки.ДополнительнаяКонстанта ПОДОБНО ""СлужебныйЗапросДляФормыПоставщика""
		|			ИЛИ Настройки.ДополнительнаяКонстанта ПОДОБНО ""СлужебныйЗапросДляФормыПокупателя""
		|			ИЛИ Настройки.ДополнительнаяКонстанта ПОДОБНО ""СлужебныйЗапросДляФормыЭТРН""
		|			ИЛИ Настройки.ДополнительнаяКонстанта ПОДОБНО ""СлужебныйЗапросДляФормыCondra""
		|			ИЛИ Настройки.ДополнительнаяКонстанта ПОДОБНО ""СлужебныйЗапросДляФормыПрайсЛист"")";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Записи = РезультатЗапроса.Выбрать();
	
	Пока Записи.Следующий() Цикл
		// Получаем текст запроса из хранилища значений.
		Данные = Записи.Данные.Получить();
		Если НЕ ТипЗнч(Данные) = Тип("Строка")
			ИЛИ ПустаяСтрока(Данные) Тогда
			Продолжить;
		КонецЕсли;
		// Записываем текст запроса в переменную.
		ТекстЗапроса = "";
		Попытка
			Выполнить(Данные);
		Исключение
			ОписаниеОшибки = ОписаниеОшибки();
			Продолжить;
		КонецПопытки;
		// Выполняем запрос по полученной настройке.
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("ДатаНач", 			ТекущаяДата());
		Запрос.УстановитьПараметр("ДатаКон", 			ТекущаяДата());	
	    Запрос.УстановитьПараметр("масПомеченныхДоков", Новый Массив);
		Запрос.УстановитьПараметр("НаправлениеОбмена" , Перечисления.ЭКОМ_НаправлениеОбмена.ПустаяСсылка());
		
		Попытка
			ТаблицаИзЗапроса = Запрос.Выполнить().Выгрузить();
		Исключение
			ОписаниеОшибки = ОписаниеОшибки();
			Продолжить;
		КонецПопытки;
		
		Для Каждого Колонка Из ТаблицаИзЗапроса.Колонки Цикл
			НоваяСтрока = Результат.Добавить();
			НоваяСтрока.Синоним = ЭКОМ_ОбщегоНазначения.ТекстШапкиИзДанных(Колонка.Имя);
			НоваяСтрока.Имя = Колонка.Имя;
			НоваяСтрока.Путь = Записи.Имя;
			НоваяСтрока.Доступность = Истина;
		КонецЦикла;
		
	КонецЦикла;

	Возврат Результат;
	
КонецФункции // ПолучитьКолонкиИзЗапросов()

////////////////////////////////////////////////////////////////////////////////
// КОНТРАГЕНТЫ

// Получает инфомрацию о кнопках и контрагентах из запроса
//
// Возвращаемое значение:
//   ТаблицаЗначений   - информация о кнопках и контрагентах, участвующих в документообороте (поля Контрагент, Синоним, Имя, Доступность)
//
Функция ПолучитьЗаписиОграниченияПоКонтрагентам()

	ТипыКонтрагентов = Новый Массив;
	
	МетаданныеСправочники = Метаданные.Справочники;
	Если МетаданныеСправочники.Найти("Контрагенты") <> Неопределено Тогда
		Выполнить("ТипыКонтрагентов.Добавить(Тип(""СправочникСсылка.Контрагенты""))");
	КонецЕсли;
	Если МетаданныеСправочники.Найти("Партнеры") <> Неопределено Тогда
		Выполнить("ТипыКонтрагентов.Добавить(Тип(""СправочникСсылка.Партнеры""))");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЭКОМ_GLN.Объект КАК Контрагент
		|ИЗ
		|	РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN
		|ГДЕ
		|	ТИПЗНАЧЕНИЯ(ЭКОМ_GLN.Объект) В (&ТипыКонтрагентов)";
	
	Запрос.УстановитьПараметр("ТипыКонтрагентов", ТипыКонтрагентов);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ЗаписиОграниченияПоКонтрагентам = Новый ТаблицаЗначений;
	ЗаписиОграниченияПоКонтрагентам.Колонки.Добавить("Контрагент", 	Новый ОписаниеТипов(ТипыКонтрагентов));
	ЗаписиОграниченияПоКонтрагентам.Колонки.Добавить("Синоним", 	Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(100)));
	ЗаписиОграниченияПоКонтрагентам.Колонки.Добавить("Имя", 		Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(100)));
	ЗаписиОграниченияПоКонтрагентам.Колонки.Добавить("Доступность", Новый ОписаниеТипов("Булево"));
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл      
		Для Каждого Кнопка Из Кнопки.НайтиСтроки(Новый Структура("Доступность", Истина)) Цикл
			Если Найти(Кнопка.Путь, "__Исходящие") > 0
				ИЛИ (Кнопка.Путь = "КоманднаяПанельCondra" И Найти(Кнопка.Имя, "Исходящий") > 0)Тогда // Работат только для исходящих документов.
				
				НоваяЗапись = ЗаписиОграниченияПоКонтрагентам.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяЗапись, ВыборкаДетальныеЗаписи);
				ЗаполнитьЗначенияСвойств(НоваяЗапись, Кнопка, "Синоним, Имя");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ЗаписиОграниченияПоКонтрагентам;
	
КонецФункции // ПолучитьКонтрагентов()

// Проверяет наличие обновлений контрагентов
//
// Возвращаемое значение:
//   Булево   - признак наличия обновления
//
Функция ПроверитьОбновлениеКонтрагентов() Экспорт
	
	НужноОбновление = Ложь;
	
	ВыборкаДетальныеЗаписи = ПолучитьЗаписиОграниченияПоКонтрагентам();
	ВыборкаДетальныеЗаписи.Колонки.Добавить("Найден", Новый ОписаниеТипов("Булево"));
	
	Если ВыборкаДетальныеЗаписи.Количество() <> ОграниченияПоКонтрагентам.Количество() Тогда
		НужноОбновление 	= Истина;
	Иначе
		Для Каждого Запись Из ВыборкаДетальныеЗаписи Цикл
			Если ОграниченияПоКонтрагентам.НайтиСтроки(Новый Структура("Контрагент, Имя",
					Запись.Контрагент, Запись.Имя)).Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			Запись.Найден 	= Истина;
		КонецЦикла;   
		НужноОбновление 	= ВыборкаДетальныеЗаписи.НайтиСтроки(Новый Структура("Найден", Ложь)).Количество() <> 0;
	КонецЕсли;
	
	Возврат НужноОбновление;
	
КонецФункции // ПроверитьОбновлениеКонтрагентов()

// Обновляет коллекцию контрагентов
//
Процедура ОбновитьКонтрагентов() Экспорт
	
	Контрагенты = ПолучитьЗаписиОграниченияПоКонтрагентам();

	Для Каждого Контрагент Из Контрагенты Цикл
		КонтрагентыЭлементаОтбор = ОграниченияПоКонтрагентам.НайтиСтроки(Новый Структура("Контрагент, Имя", Контрагент.Контрагент, Контрагент.Имя));
		Если КонтрагентыЭлементаОтбор.Количество() = 1 Тогда
			 ЗаполнитьЗначенияСвойств(Контрагент, КонтрагентыЭлементаОтбор.Получить(0), "Доступность"); 
		 Иначе
			 Контрагент.Доступность = Истина; // По умолчанию кнопка доступна
		КонецЕсли;
	КонецЦикла;

	ОграниченияПоКонтрагентам.Очистить();
	Для Каждого Контрагент Из Контрагенты Цикл
		ЗаполнитьЗначенияСвойств(ОграниченияПоКонтрагентам.Добавить(), Контрагент);
	КонецЦикла;

КонецПроцедуры // ОбновитьКонтрагентов()

