Процедура УстановитьУчетВремениВДняхЧасахДляБольничных() Экспорт
	
	// у следующих начислений заполним при записи вида расчета реквизит УчетВремениВДняхЧасах через РасчетЗарплатыРасширенный.ЗаполнитьИнформациюОбУчетеВремени
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Начисления.Ссылка КАК Ссылка
	|ИЗ
	|	ПланВидовРасчета.Начисления КАК Начисления
	|ГДЕ
	|	НЕ Начисления.УчетВремениВДняхЧасах
	|	И Начисления.КатегорияНачисленияИлиНеоплаченногоВремени = ЗНАЧЕНИЕ(Перечисление.КатегорииНачисленийИНеоплаченногоВремени.ОплатаБольничногоЛистаЗаСчетРаботодателя)";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда 
		// Нет начислений, которые требовалось бы обработать.
		Возврат;
	КонецЕсли;

	ПакетВидовРасчета = Новый Массив;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НачислениеОбъект = Выборка.Ссылка.ПолучитьОбъект();
		РасчетЗарплатыРасширенный.ЗаполнитьИнформациюОбУчетеВремени(НачислениеОбъект);
		ПакетВидовРасчета.Добавить(НачислениеОбъект);
	КонецЦикла;
	
	РасчетЗарплатыРасширенный.ЗаписатьПакетВидовРасчета(ПакетВидовРасчета, Ложь);
	
КонецПроцедуры

Процедура ОбновитьВидыОтпусковТКРК202007() Экспорт
	
	Справочники.ВидыОтпусков.ОписатьВидОтпускаДляПрохожденияСкрининговыхИсследований();
	Справочники.ВидыОтпусков.ОписатьВидОтпускаНаПостановкуНаМедицинскийУчетПоБеременностиДоДвенадцатиНедель();
	
	ПланыВидовРасчета.Начисления.СоздатьНачисленияОтпускДляПрохожденияСкрининговыхИсследований();
	ПланыВидовРасчета.Начисления.СоздатьНачисленияОтпускНаПостановкуНаМедицинскийУчетПоБеременностиДоДвенадцатиНедель();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Начисления.Ссылка КАК Начисление
		|ИЗ
		|	ПланВидовРасчета.Начисления КАК Начисления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НалогообложениеНачислений КАК НалогообложениеНачислений
		|		ПО (НалогообложениеНачислений.Начисление = Начисления.Ссылка)
		|ГДЕ
		|	Начисления.ВидОтпуска В(&ВидыОтпусков)
		|	И Начисления.КатегорияНачисленияИлиНеоплаченногоВремени = ЗНАЧЕНИЕ(Перечисление.КатегорииНачисленийИНеоплаченногоВремени.ОплатаОтпуска)
		|	И НалогообложениеНачислений.Начисление ЕСТЬ NULL";
	
	ВидыОтпусков = Новый Массив;
	ВидыОтпусков.Добавить(ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Справочник.ВидыОтпусков.ОтпускДляПрохожденияСкрининговыхИсследований"));
	ВидыОтпусков.Добавить(ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Справочник.ВидыОтпусков.ОтпускНаПостановкуНаМедицинскийУчетПоБеременностиДоДвенадцатиНедель"));
	
	Запрос.УстановитьПараметр("ВидыОтпусков", ВидыОтпусков);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ОблагаетсяЦеликом = Перечисления.СпособыНалогообложенияДоходов.ОблагаетсяЦеликом;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		РегистрыСведений.НалогообложениеНачислений.ДобавитьСведенияОНалогообложениеНачислений(ВыборкаДетальныеЗаписи.Начисление, Справочники.ВидыДоходов.ДоходыОтРаботодателя, '20200701', ОблагаетсяЦеликом, ОблагаетсяЦеликом, ОблагаетсяЦеликом, ОблагаетсяЦеликом, ОблагаетсяЦеликом, ОблагаетсяЦеликом, ОблагаетсяЦеликом);	
	КонецЦикла;
	
КонецПроцедуры

