		|	НачисленияУдержанияВзносы.ФизическоеЛицо КАК ФизическоеЛицо,
		|	НачисленияУдержанияВзносы.Ссылка.Подразделение КАК Подразделение,
		|	НачисленияУдержанияВзносы.Ссылка.ПериодРегистрации КАК ПериодРегистрации,
		|	НачисленияУдержанияВзносы.Ссылка.ВидПрочегоДохода КАК ВидПрочегоДохода,
		|	НачисленияУдержанияВзносы.Начислено КАК Начислено,
		|	НачисленияУдержанияВзносы.СуммаВычета КАК СуммаВычета,
		|	НачисленияУдержанияВзносы.КВыплате КАК КВыплате,
		|	НачисленияУдержанияВзносы.УдалитьИПН КАК УдалитьИПН,
		|	НачисленияУдержанияВзносы.Удержано КАК Удержано,
		|	НачисленияУдержанияВзносы.УдалитьНеоблагаемыйДоход КАК УдалитьНеоблагаемыйДоход,
		|	НачисленияУдержанияВзносы.УдалитьПримененнаяЛьгота КАК УдалитьПримененнаяЛьгота,
		|	НачисленияУдержанияВзносы.УдалитьОбъектИсчисления КАК УдалитьОбъектИсчисления
		|ПОМЕСТИТЬ ВТ_НачисленияУдержанияВзносы
		|ИЗ
		|	Документ.РегистрацияПрочихДоходов.НачисленияУдержанияВзносы КАК НачисленияУдержанияВзносы
		|ГДЕ
		|	(НачисленияУдержанияВзносы.УдалитьИПН > 0
		|			ИЛИ НачисленияУдержанияВзносы.УдалитьНеоблагаемыйДоход > 0
		|			ИЛИ НачисленияУдержанияВзносы.УдалитьПримененнаяЛьгота > 0
		|			ИЛИ НачисленияУдержанияВзносы.УдалитьОбъектИсчисления > 0)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Ссылка,
		|	ПериодРегистрации,
		|	ВидПрочегоДохода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РегистрацияПрочихДоходов.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_НалогиВзносыОтчисления
		|ИЗ
		|	Документ.РегистрацияПрочихДоходов КАК РегистрацияПрочихДоходов
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РегистрацияПрочихДоходов.НалогиВзносыОтчисления КАК РегистрацияПрочихДоходовНалогиВзносыОтчисления
		|		ПО РегистрацияПрочихДоходов.Ссылка = РегистрацияПрочихДоходовНалогиВзносыОтчисления.Ссылка
		|ГДЕ
		|	РегистрацияПрочихДоходовНалогиВзносыОтчисления.Ссылка ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МАКСИМУМ(НалогообложениеНачислений.Период) КАК Период,
		|	НалогообложениеНачислений.Начисление КАК Начисление
		|ПОМЕСТИТЬ ВТ_НалогообложениеНачислений
		|ИЗ
		|	РегистрСведений.НалогообложениеНачислений КАК НалогообложениеНачислений
		|ГДЕ
		|	НалогообложениеНачислений.Начисление ССЫЛКА Справочник.ВидыПрочихДоходовФизическихЛиц
		|
		|СГРУППИРОВАТЬ ПО
		|	НалогообложениеНачислений.Начисление
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НалогообложениеНачислений.Период КАК Период,
		|	НалогообложениеНачислений.Начисление КАК Начисление,
		|	НалогообложениеНачислений.ВидДохода КАК ВидДохода
		|ПОМЕСТИТЬ ВТ_НалогообложениеНачисленийСрез
		|ИЗ
		|	РегистрСведений.НалогообложениеНачислений КАК НалогообложениеНачислений
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_НалогообложениеНачислений КАК ВТ_НалогообложениеНачислений
		|		ПО (ВТ_НалогообложениеНачислений.Период = НалогообложениеНачислений.Период)
		|			И (ВТ_НалогообложениеНачислений.Начисление = НалогообложениеНачислений.Начисление)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Период,
		|	Начисление
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_НачисленияУдержанияВзносы.Ссылка КАК Ссылка,
		|	ВТ_НачисленияУдержанияВзносы.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ВТ_НачисленияУдержанияВзносы.Подразделение КАК Подразделение,
		|	ВТ_НачисленияУдержанияВзносы.ПериодРегистрации КАК МесяцНалоговогоПериода,
		|	ВТ_НалогообложениеНачисленийСрез.ВидДохода КАК ВидДохода,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыНалоговВзносовОтчислений.ИПН) КАК ВидНалогаВзносаОтчисления,
		|	ВТ_НачисленияУдержанияВзносы.Начислено - ВТ_НачисленияУдержанияВзносы.УдалитьНеоблагаемыйДоход КАК ОблагаемыйДоход,
		|	ВТ_НачисленияУдержанияВзносы.УдалитьНеоблагаемыйДоход КАК НеоблагаемыйДоход,
		|	ВТ_НачисленияУдержанияВзносы.УдалитьИПН КАК НалогВзнос,
		|	ВТ_НачисленияУдержанияВзносы.УдалитьОбъектИсчисления КАК ОбъектИсчисления,
		|	0 КАК РазрешенныйВычет,
		|	0 КАК ПримененныйВычет,
		|	ВТ_НачисленияУдержанияВзносы.УдалитьПримененнаяЛьгота КАК ПримененнаяЛьгота,
		|	0 КАК ПрочиеВычеты,
		|	ЛОЖЬ КАК ФиксСтрока,
		|	ЛОЖЬ КАК ФиксРасчет,
		|	0 КАК ИдентификаторСтрокиНалогиВзносыОтчисления
		|ИЗ
		|	ВТ_НачисленияУдержанияВзносы КАК ВТ_НачисленияУдержанияВзносы
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_НалогообложениеНачисленийСрез КАК ВТ_НалогообложениеНачисленийСрез
		|		ПО ВТ_НачисленияУдержанияВзносы.ПериодРегистрации >= ВТ_НалогообложениеНачисленийСрез.Период
		|			И ВТ_НачисленияУдержанияВзносы.ВидПрочегоДохода = ВТ_НалогообложениеНачисленийСрез.Начисление
		|ГДЕ
		|	ВТ_НачисленияУдержанияВзносы.Ссылка В
		|			(ВЫБРАТЬ
		|				Т.Ссылка
		|			ИЗ
		|				ВТ_НалогиВзносыОтчисления КАК Т)
		|ИТОГИ ПО
		|	Ссылка";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДокументы = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаДокументы.Следующий() Цикл
		
		ДокументОбъект = ВыборкаДокументы.Ссылка.ПолучитьОбъект();
		
		ВыборкаСтроки = ВыборкаДокументы.Выбрать();
		Пока ВыборкаСтроки.Следующий() Цикл
			
			НоваяСтрока = ДокументОбъект.НалогиВзносыОтчисления.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,ВыборкаСтроки);
			
		КонецЦикла;
		
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		ДокументОбъект.Записать();
		
	КонецЦикла;
	
	
КонецПроцедуры

Процедура ОбновитьПорядокУчетаРабочегоВремени(ПараметрыОбновления = Неопределено) Экспорт
	
	ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(ПараметрыОбновления, "ОбработкаЗавершена", Ложь);
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Начисления.Ссылка КАК Ссылка,
	|	ПорядокРегистрацииВидовУчетаВремени.ВидИспользованияРабочегоВремениКадровый КАК ВидИспользованияРабочегоВремениКадровый,
	|	НачисленияВидыВремени.ВидВремени КАК ВидВремени
	|ИЗ
	|	ПланВидовРасчета.Начисления КАК Начисления
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УдалитьПорядокРегистрацииВидовУчетаВремени.СрезПоследних() КАК ПорядокРегистрацииВидовУчетаВремени
	|		ПО Начисления.ОбозначениеВТабелеУчетаРабочегоВремени = ПорядокРегистрацииВидовУчетаВремени.ВидИспользованияРабочегоВремениРасчетный
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланВидовРасчета.Начисления.ВидыВремени КАК НачисленияВидыВремени
	|		ПО (НачисленияВидыВремени.Ссылка = Начисления.Ссылка)
	|			И (НачисленияВидыВремени.ВидВремени = ПорядокРегистрацииВидовУчетаВремени.ВидИспользованияРабочегоВремениКадровый)
	|ГДЕ
	|	НачисленияВидыВремени.Ссылка ЕСТЬ NULL
	|ИТОГИ ПО
	|	Ссылка";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.УстановитьПараметрОбновления(ПараметрыОбновления, "ОбработкаЗавершена", Истина);
		Возврат;
	КонецЕсли;
	
	ВыборкаПоНачислениям = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаПоНачислениям.Следующий() Цикл
		
		НачислениеОбъект = ВыборкаПоНачислениям.Ссылка.ПолучитьОбъект();
		
		Выборка = ВыборкаПоНачислениям.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			ВидВремениСтрока = НачислениеОбъект.ВидыВремени.Добавить();
			ВидВремениСтрока.ВидВремени = Выборка.ВидИспользованияРабочегоВремениКадровый;
			
		КонецЦикла;
		
		Если Не ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.ПодготовитьОбновлениеДанных(ПараметрыОбновления, "ПланВидовРасчета.Начисления", "Ссылка", ВыборкаПоНачислениям.Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		
		ОбновлениеИнформационнойБазы.ЗаписатьДанные(НачислениеОбъект);
		ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.ЗавершитьОбновлениеДанных(ПараметрыОбновления);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновлениеПоказателейОтОбратного() Экспорт
	
	ОтОбратногоСуммаНаРуки = ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Справочник.ПоказателиРасчетаЗарплаты.ОтОбратногоСуммаНаРуки");
	
	Если ОтОбратногоСуммаНаРуки = Неопределено Тогда
		Справочники.ПоказателиРасчетаЗарплаты.СоздатьПредопределенныеПоказателиОтОбратного();
		Справочники.ПоказателиРасчетаЗарплаты.ОтключитьПредопределенныеПоказателиОтОбратного();
		ОбновитьПовторноИспользуемыеЗначения();
	КонецЕсли;

КонецПроцедуры

Процедура УдалитьНеиспользуемыеНачисления() Экспорт
	
	// начисления мешают корректной работе запроса настроек
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Начисления.Ссылка КАК Ссылка
		|ИЗ
		|	ПланВидовРасчета.Начисления КАК Начисления
		|ГДЕ
		|	Начисления.КатегорияНачисленияИлиНеоплаченногоВремени = ЗНАЧЕНИЕ(Перечисление.КатегорииНачисленийИНеоплаченногоВремени.ОплатаКомандировки)
		|	ИЛИ Начисления.Наименование ПОДОБНО ""%Материальная помощь, не облагаемая налогами%""";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	МассивНачислений = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Если МассивНачислений.Количество() > 0 Тогда
		УдалитьОбъекты(МассивНачислений, Истина);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнениеРегистраНалогиВзносыРасчетыНалогоплательщиков() Экспорт
	
	НаборЗаписей = РегистрыНакопления.НалогиВзносыРасчетыНалогоплательщиков.СоздатьНаборЗаписей();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НалогиВзносы.Организация КАК Организация,
		|	НалогиВзносы.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
		|	НалогиВзносы.ФизическоеЛицо КАК ФизическоеЛицо,
		|	НалогиВзносы.ПериодРегистрации КАК МесяцНалоговогоПериода,
		|	НалогиВзносы.ВидНалогаВзносаОтчисления КАК ВидНалогаВзносаОтчисления,
		|	НалогиВзносы.НалогВзнос КАК НалогВзнос,
		|	НалогиВзносы.Регистратор КАК Регистратор,
		|	НалогиВзносы.Период КАК Период
		|ИЗ
		|	РегистрНакопления.СведенияОбИсчисленииНалоговВзносовОтчислений КАК НалогиВзносы
		|ГДЕ
		|	НалогиВзносы.ВидНалогаВзносаОтчисления В (ЗНАЧЕНИЕ(Перечисление.ВидыНалоговВзносовОтчислений.ИПН), ЗНАЧЕНИЕ(Перечисление.ВидыНалоговВзносовОтчислений.ОПВ), ЗНАЧЕНИЕ(Перечисление.ВидыНалоговВзносовОтчислений.ВОСМС))
		|
		|УПОРЯДОЧИТЬ ПО
		|	Регистратор,
		|	Организация,
		|	РегистрацияВНалоговомОргане,
		|	ФизическоеЛицо,
		|	НалогиВзносы.ПериодРегистрации,
		|	ВидНалогаВзносаОтчисления
		|ИТОГИ ПО
		|	Регистратор";
		
	ВыборкаРегистраторы = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаРегистраторы.Следующий() Цикл
		НаборЗаписей.Отбор.Регистратор.Установить(ВыборкаРегистраторы.Регистратор);
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() <> 0 Тогда
			НаборЗаписей.Очистить();
		КонецЕсли;
		ВыборкаЗаписи = ВыборкаРегистраторы.Выбрать();
		Пока ВыборкаЗаписи.Следующий() Цикл
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.ВидДвижения = ВидДвиженияНакопления.Приход;
			ЗаполнитьЗначенияСвойств(НоваяЗапись,ВыборкаЗаписи);
			
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.ВидДвижения = ВидДвиженияНакопления.Расход;
			ЗаполнитьЗначенияСвойств(НоваяЗапись,ВыборкаЗаписи);
		КонецЦикла;
		НаборЗаписей.Записать();
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновлениеРегистраНалогиВзносыРасчетыНалогоплательщиков() Экспорт
	
	НаборЗаписей = РегистрыНакопления.НалогиВзносыРасчетыНалогоплательщиков.СоздатьНаборЗаписей();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УчетнаяПолитикаПоНалоговомуУчету.Организация КАК Организация,
		|	МИНИМУМ(УчетнаяПолитикаПоНалоговомуУчету.Период) КАК Период
		|ПОМЕСТИТЬ ВТ_Политика
		|ИЗ
		|	РегистрСведений.УчетнаяПолитикаПоНалоговомуУчету КАК УчетнаяПолитикаПоНалоговомуУчету
		|ГДЕ
		|	УчетнаяПолитикаПоНалоговомуУчету.ОтражатьУдержаниеНалоговИВзносовПропорциональноВыплаченномуДоходу = ИСТИНА
		|
		|СГРУППИРОВАТЬ ПО
		|	УчетнаяПолитикаПоНалоговомуУчету.Организация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////Приход + Расход
		|ВЫБРАТЬ
		|	НалогиВзносы.Организация КАК Организация,
		|	НалогиВзносы.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
		|	НалогиВзносы.ФизическоеЛицо КАК ФизическоеЛицо,
		|	НалогиВзносы.ПериодРегистрации КАК МесяцНалоговогоПериода,
		|	НалогиВзносы.ВидНалогаВзносаОтчисления КАК ВидНалогаВзносаОтчисления,
		|	НалогиВзносы.ВидДохода КАК ВидДохода,
		|	НалогиВзносы.НалогВзнос КАК НалогВзнос,
		|	НалогиВзносы.Регистратор КАК Регистратор,
		|	НалогиВзносы.Период КАК Период
		|ИЗ
		|	РегистрНакопления.СведенияОбИсчисленииНалоговВзносовОтчислений КАК НалогиВзносы
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Политика КАК ВТ_Политика
		|		ПО НалогиВзносы.Организация = ВТ_Политика.Организация
		|ГДЕ
		|	НалогиВзносы.ВидНалогаВзносаОтчисления В (ЗНАЧЕНИЕ(Перечисление.ВидыНалоговВзносовОтчислений.ИПН), ЗНАЧЕНИЕ(Перечисление.ВидыНалоговВзносовОтчислений.ОПВ), ЗНАЧЕНИЕ(Перечисление.ВидыНалоговВзносовОтчислений.ВОСМС))
		|	И ВЫБОР
		|			КОГДА ВТ_Политика.Период ЕСТЬ NULL
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ НалогиВзносы.ПериодРегистрации < ВТ_Политика.Период
		|		КОНЕЦ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Регистратор,
		|	Организация,
		|	РегистрацияВНалоговомОргане,
		|	ФизическоеЛицо,
		|	НалогиВзносы.ПериодРегистрации,
		|	ВидНалогаВзносаОтчисления,
		|	ВидДохода
		|ИТОГИ ПО
		|	Регистратор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////Приход
		|ВЫБРАТЬ
		|	НалогиВзносы.Организация КАК Организация,
		|	НалогиВзносы.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
		|	НалогиВзносы.ФизическоеЛицо КАК ФизическоеЛицо,
		|	НалогиВзносы.ПериодРегистрации КАК МесяцНалоговогоПериода,
		|	НалогиВзносы.ВидНалогаВзносаОтчисления КАК ВидНалогаВзносаОтчисления,
		|	НалогиВзносы.ВидДохода КАК ВидДохода,
		|	НалогиВзносы.НалогВзнос КАК НалогВзнос,
		|	НалогиВзносы.Регистратор КАК Регистратор,
		|	НалогиВзносы.Период КАК Период
		|ИЗ
		|	РегистрНакопления.СведенияОбИсчисленииНалоговВзносовОтчислений КАК НалогиВзносы
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Политика КАК ВТ_Политика
		|		ПО НалогиВзносы.Организация = ВТ_Политика.Организация
		|ГДЕ
		|	НалогиВзносы.ВидНалогаВзносаОтчисления В (ЗНАЧЕНИЕ(Перечисление.ВидыНалоговВзносовОтчислений.ИПН), ЗНАЧЕНИЕ(Перечисление.ВидыНалоговВзносовОтчислений.ОПВ), ЗНАЧЕНИЕ(Перечисление.ВидыНалоговВзносовОтчислений.ВОСМС))
		|	И ВЫБОР
		|			КОГДА ВТ_Политика.Период ЕСТЬ NULL
		|				ТОГДА ЛОЖЬ
		|			ИНАЧЕ НалогиВзносы.ПериодРегистрации >= ВТ_Политика.Период
		|		КОНЕЦ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Регистратор,
		|	Организация,
		|	РегистрацияВНалоговомОргане,
		|	ФизическоеЛицо,
		|	НалогиВзносы.ПериодРегистрации,
		|	ВидНалогаВзносаОтчисления,
		|	ВидДохода
		|ИТОГИ ПО
		|	Регистратор";
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ВыборкаРегистраторы = МассивРезультатов[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаРегистраторы.Следующий() Цикл
		НаборЗаписей.Отбор.Регистратор.Установить(ВыборкаРегистраторы.Регистратор);
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() <> 0 Тогда
			НаборЗаписей.Очистить();
		КонецЕсли;
		ВыборкаЗаписи = ВыборкаРегистраторы.Выбрать();
		Пока ВыборкаЗаписи.Следующий() Цикл
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.ВидДвижения = ВидДвиженияНакопления.Приход;
			ЗаполнитьЗначенияСвойств(НоваяЗапись,ВыборкаЗаписи);
			
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.ВидДвижения = ВидДвиженияНакопления.Расход;
			ЗаполнитьЗначенияСвойств(НоваяЗапись,ВыборкаЗаписи);
		КонецЦикла;
		НаборЗаписей.Записать();
	КонецЦикла;
	
	ВыборкаРегистраторы = МассивРезультатов[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаРегистраторы.Следующий() Цикл
		НаборЗаписей.Отбор.Регистратор.Установить(ВыборкаРегистраторы.Регистратор);
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() <> 0 Тогда
			НаборЗаписей.Очистить();
		КонецЕсли;
		ВыборкаЗаписи = ВыборкаРегистраторы.Выбрать();
		Пока ВыборкаЗаписи.Следующий() Цикл
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.ВидДвижения = ВидДвиженияНакопления.Приход;
			ЗаполнитьЗначенияСвойств(НоваяЗапись,ВыборкаЗаписи);
		КонецЦикла;
		НаборЗаписей.Записать();
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьПоказателиНачисленийПоСреднемуЗаработкуОплатаБольничного() Экспорт
	
	// у следующих начислений добави показатель СреднийЗаработокОбщий
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Начисления.Ссылка
	|ИЗ
	|	ПланВидовРасчета.Начисления КАК Начисления
	|ГДЕ
	|	Начисления.КатегорияНачисленияИлиНеоплаченногоВремени = ЗНАЧЕНИЕ(Перечисление.КатегорииНачисленийИНеоплаченногоВремени.ОплатаБольничногоЛистаЗаСчетРаботодателя)
	|	И НЕ ИСТИНА В
	|				(ВЫБРАТЬ ПЕРВЫЕ 1
	|					ИСТИНА
	|				ИЗ
	|					ПланВидовРасчета.Начисления.Показатели КАК ПоказателиНачислений
	|				ГДЕ
	|					ПоказателиНачислений.Ссылка = Начисления.Ссылка
	|					И ПоказателиНачислений.Показатель = &СреднийЗаработокОбщий)";
	
	СреднийЗаработокОбщий = ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Справочник.ПоказателиРасчетаЗарплаты.СреднийЗаработокОбщий");
	
	Если СреднийЗаработокОбщий = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СреднийЗаработокОбщий", СреднийЗаработокОбщий);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда 
		// Нет начислений, которые требовалось бы обработать.
		Возврат;
	КонецЕсли;

	ПакетВидовРасчета = Новый Массив;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НачислениеОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ЗарплатаКадрыРасширенный.ЗаполнитьПоказателиПредопределенногоСпособаРасчета(НачислениеОбъект.СпособРасчета, НачислениеОбъект.Показатели);
		НачислениеОбъект.ИспользуетСреднийЗаработокОбщий = Истина;
		ПакетВидовРасчета.Добавить(НачислениеОбъект);
	КонецЦикла;
	
	РасчетЗарплатыРасширенный.ЗаписатьПакетВидовРасчета(ПакетВидовРасчета, Ложь);
	
КонецПроцедуры

Процедура УстановитьУчетВремениВДняхЧасах() Экспорт

	// у следующих начислений заполним при записи вида расчета реквизит УчетВремениВДняхЧасах через РасчетЗарплатыРасширенный.ЗаполнитьИнформациюОбУчетеВремени
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Начисления.Ссылка КАК Ссылка
	|ИЗ
	|	ПланВидовРасчета.Начисления КАК Начисления
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВидовРасчета.Начисления.Показатели КАК ПоказателиНачислений
	|		ПО Начисления.Ссылка = ПоказателиНачислений.Ссылка
	|ГДЕ
	|	НЕ Начисления.УчетВремениВДняхЧасах
	|	И ПоказателиНачислений.Показатель В(&МассивПоказателей)";
	
	КоличествоДнейКомпенсации = ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Справочник.ПоказателиРасчетаЗарплаты.КоличествоДнейКомпенсации");
	КоличествоДнейОтпуска = ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Справочник.ПоказателиРасчетаЗарплаты.КоличествоДнейОтпуска");
	
	Если КоличествоДнейКомпенсации = Неопределено 
		И КоличествоДнейОтпуска = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МассивПоказателей = Новый Массив;
	МассивПоказателей.Добавить(КоличествоДнейКомпенсации);
	МассивПоказателей.Добавить(КоличествоДнейОтпуска);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("МассивПоказателей", МассивПоказателей);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда 
		// Нет начислений, которые требовалось бы обработать.
		Возврат;
	КонецЕсли;

	ПакетВидовРасчета = Новый Массив;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НачислениеОбъект = Выборка.Ссылка.ПолучитьОбъект();
		РасчетЗарплатыРасширенный.ЗаполнитьИнформациюОбУчетеВремени(НачислениеОбъект);
		ПакетВидовРасчета.Добавить(НачислениеОбъект);
	КонецЦикла;
	
	РасчетЗарплатыРасширенный.ЗаписатьПакетВидовРасчета(ПакетВидовРасчета, Ложь);
	
КонецПроцедуры

Процедура ЗаполнитьПризнакиДублированияНачисленийДляОплатаБольничногоЛистаЗаСчетРаботодателя() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОплатаБольничногоЛистаЗаСчетРаботодателя", Перечисления.КатегорииНачисленийИНеоплаченногоВремени.ОплатаБольничногоЛистаЗаСчетРаботодателя);
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Начисления.Ссылка,
		|	ЛОЖЬ КАК ДублироватьДляВнутреннихСовместителейИПодработок,
		|	ЛОЖЬ КАК ДублироватьДляПодработок
		|ИЗ
		|	ПланВидовРасчета.Начисления КАК Начисления
		|ГДЕ
		|	Начисления.КатегорияНачисленияИлиНеоплаченногоВремени = &ОплатаБольничногоЛистаЗаСчетРаботодателя
		|	И Начисления.ДублироватьДляВнутреннихСовместителейИПодработок = ИСТИНА";
		
	РезультатЗапроса = Запрос.Выполнить();
	
	ПакетВидовРасчета = Новый Массив;
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			ВидРасчетаОбъект = Выборка.Ссылка.ПолучитьОбъект();
			
			ВидРасчетаОбъект.ДублироватьДляВнутреннихСовместителейИПодработок = Выборка.ДублироватьДляВнутреннихСовместителейИПодработок;
			ВидРасчетаОбъект.ДублироватьДляПодработок = Выборка.ДублироватьДляПодработок;
			
			ПакетВидовРасчета.Добавить(ВидРасчетаОбъект);
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	РасчетЗарплатыРасширенный.ЗаписатьПакетВидовРасчета(ПакетВидовРасчета, Ложь);

КонецПроцедуры

Процедура ЗаполнитьСпособРасчетаСуммКПеречислению() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВедомостьНаПеречислениеВзносовОтчислений.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ВедомостьНаПеречислениеВзносовОтчислений КАК ВедомостьНаПеречислениеВзносовОтчислений
		|ГДЕ
		|	ВедомостьНаПеречислениеВзносовОтчислений.СпособРасчетаСуммКПеречислению = ЗНАЧЕНИЕ(Перечисление.СпособыЗаполненияСуммКПеречислениюНалоговВзносовОтчислений.ПустаяСсылка)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ДокументОбъект.СпособРасчетаСуммКПеречислению = Перечисления.СпособыЗаполненияСуммКПеречислениюНалоговВзносовОтчислений.ПоОстаткамЗадолженностиНаКонецМесяца;
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		ДокументОбъект.Записать();
		
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьКоэффициентИндексацииЗаработка() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КоэффициентИндексацииЗаработка.Период КАК Период,
		|	КоэффициентИндексацииЗаработка.Регистратор КАК Регистратор,
		|	КоэффициентИндексацииЗаработка.НомерСтроки КАК НомерСтроки,
		|	КоэффициентИндексацииЗаработка.Активность КАК Активность,
		|	КоэффициентИндексацииЗаработка.Сотрудник КАК Сотрудник,
		|	КоэффициентИндексацииЗаработка.ДатаИндексации КАК ДатаИндексации,
		|	КоэффициентИндексацииЗаработка.Коэффициент КАК Коэффициент,
		|	КоэффициентИндексацииЗаработка.КоэффициентИндексации КАК КоэффициентИндексации
		|ПОМЕСТИТЬ ВТ_НеобработанныеДанные
		|ИЗ
		|	РегистрСведений.КоэффициентИндексацииЗаработка КАК КоэффициентИндексацииЗаработка
		|ГДЕ
		|	КоэффициентИндексацииЗаработка.ДатаИндексации = ДАТАВРЕМЯ(1, 1, 1)
		|	И КоэффициентИндексацииЗаработка.КоэффициентИндексации = 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_НеобработанныеДанные.Регистратор КАК Регистратор,
		|	ВТ_НеобработанныеДанные.Сотрудник КАК Сотрудник,
		|	ВТ_НеобработанныеДанные.Период КАК Период,
		|	ВТ_НеобработанныеДанные.Период КАК ДатаИндексации,
		|	ВТ_НеобработанныеДанные.Коэффициент КАК Коэффициент,
		|	ВТ_НеобработанныеДанные.Коэффициент КАК КоэффициентИндексации
		|ИЗ
		|	ВТ_НеобработанныеДанные КАК ВТ_НеобработанныеДанные
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТ_НеобработанныеДанные.Регистратор,
		|	ВТ_НеобработанныеДанные.Сотрудник,
		|	ВТ_НеобработанныеДанные.Период,
		|	КоэффициентИндексацииЗаработка.Период,
		|	ВТ_НеобработанныеДанные.Коэффициент,
		|	КоэффициентИндексацииЗаработка.Коэффициент
		|ИЗ
		|	ВТ_НеобработанныеДанные КАК ВТ_НеобработанныеДанные
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ВТ_НеобработанныеДанные.Регистратор КАК РегистраторОсновнойЗаписи,
		|			ВТ_НеобработанныеДанные.Сотрудник КАК Сотрудник,
		|			ВТ_НеобработанныеДанные.Период КАК Период,
		|			КоэффициентИндексацииЗаработка.Период КАК ПредыдущийПериодИндексации
		|		ИЗ
		|			ВТ_НеобработанныеДанные КАК ВТ_НеобработанныеДанные
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КоэффициентИндексацииЗаработка КАК КоэффициентИндексацииЗаработка
		|				ПО (КоэффициентИндексацииЗаработка.Сотрудник = ВТ_НеобработанныеДанные.Сотрудник)
		|					И (КоэффициентИндексацииЗаработка.Регистратор <> ВТ_НеобработанныеДанные.Регистратор
		|						ИЛИ ТИПЗНАЧЕНИЯ(КоэффициентИндексацииЗаработка.Регистратор) = ТИП(Документ.ПереносДанных))
		|					И ВТ_НеобработанныеДанные.Период > КоэффициентИндексацииЗаработка.Период) КАК КоэффициентыИндексацииЗаработкаПериоды
		|		ПО ВТ_НеобработанныеДанные.Регистратор = КоэффициентыИндексацииЗаработкаПериоды.РегистраторОсновнойЗаписи
		|			И ВТ_НеобработанныеДанные.Сотрудник = КоэффициентыИндексацииЗаработкаПериоды.Сотрудник
		|			И ВТ_НеобработанныеДанные.Период = КоэффициентыИндексацииЗаработкаПериоды.Период
		|			И (ГОД(КоэффициентыИндексацииЗаработкаПериоды.ПредыдущийПериодИндексации) + МЕСЯЦ(КоэффициентыИндексацииЗаработкаПериоды.ПредыдущийПериодИндексации) - ГОД(КоэффициентыИндексацииЗаработкаПериоды.ПредыдущийПериодИндексации) - МЕСЯЦ(КоэффициентыИндексацииЗаработкаПериоды.ПредыдущийПериодИндексации) + 1 <= 12)
		|			И (ВТ_НеобработанныеДанные.Коэффициент > 1)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КоэффициентИндексацииЗаработка КАК КоэффициентИндексацииЗаработка
		|		ПО (КоэффициентИндексацииЗаработка.Сотрудник = ВТ_НеобработанныеДанные.Сотрудник)
		|			И (КоэффициентИндексацииЗаработка.Сотрудник = КоэффициентыИндексацииЗаработкаПериоды.Сотрудник)
		|			И (КоэффициентИндексацииЗаработка.Период = КоэффициентыИндексацииЗаработкаПериоды.ПредыдущийПериодИндексации)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Регистратор,
		|	Сотрудник,
		|	Период УБЫВ,
		|	ДатаИндексации УБЫВ
		|ИТОГИ ПО
		|	Регистратор";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаРегистратор = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	НаборЗаписей = РегистрыСведений.КоэффициентИндексацииЗаработка.СоздатьНаборЗаписей();
	ТаблицаКоэффициентовИндексации = НаборЗаписей.Выгрузить();
	// иначе у записей будет установлена Ложь
	ТаблицаКоэффициентовИндексации.Колонки.Удалить("Активность");

	Пока ВыборкаРегистратор.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.КоэффициентИндексацииЗаработка.СоздатьНаборЗаписей();
		НаборЗаписей.ОбменДанными.Загрузка = Истина;
	
		НаборЗаписей.Отбор.Регистратор.Установить(ВыборкаРегистратор.Регистратор);
		
		ТаблицаКоэффициентовИндексации.Очистить();
		
		ВыборкаПоРегистратору = ВыборкаРегистратор.Выбрать();
		
		Пока ВыборкаПоРегистратору.Следующий() Цикл
			
			ЗаписьРегистра = ТаблицаКоэффициентовИндексации.Добавить();
			ЗаполнитьЗначенияСвойств(ЗаписьРегистра, ВыборкаПоРегистратору);
			
		КонецЦикла;
		
		УчетСреднегоЗаработкаРК.ОбработатьТаблицуКоэффициентовИндексации(ТаблицаКоэффициентовИндексации);
		
		НаборЗаписей.Загрузить(ТаблицаКоэффициентовИндексации);
			
		НаборЗаписей.Записать();
		
	КонецЦикла;

КонецПроцедуры

