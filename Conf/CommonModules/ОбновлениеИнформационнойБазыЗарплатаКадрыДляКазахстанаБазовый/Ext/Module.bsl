Процедура ЗаполнитьРегистрУчетнаяПолитикаПоНалоговомуУчету2021() Экспорт
	
	НаборЗаписей = РегистрыСведений.УчетнаяПолитикаПоНалоговомуУчету.СоздатьНаборЗаписей();
	
	Запрос = Новый Запрос;
	// обновим учетную политику пользователей, созданную в 2021 году
	// учетную политику индивидуальных предпринимателей не обновляем, тк расчет СН для ИП реализован не был
	// заполним учетную политику для юр лиц знчением по умолчанию (расчет происходил по общеустановленному режиму всегда) 
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УчетнаяПолитикаПоНалоговомуУчету.Период КАК Период,
		|	УчетнаяПолитикаПоНалоговомуУчету.Организация КАК Организация
		|ИЗ
		|	РегистрСведений.УчетнаяПолитикаПоНалоговомуУчету КАК УчетнаяПолитикаПоНалоговомуУчету
		|ГДЕ
		|	УчетнаяПолитикаПоНалоговомуУчету.Период МЕЖДУ ДАТАВРЕМЯ(2021, 1, 1) И ДАТАВРЕМЯ(2021, 12, 31)
		|	И УчетнаяПолитикаПоНалоговомуУчету.СистемаНалогообложения = ЗНАЧЕНИЕ(Перечисление.СистемыНалогообложения.ПустаяСсылка)
		|	И УчетнаяПолитикаПоНалоговомуУчету.Организация.ЮридическоеФизическоеЛицо = ЗНАЧЕНИЕ(Перечисление.ЮридическоеФизическоеЛицо.ЮридическоеЛицо)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		НаборЗаписей.Отбор.Организация.Установить(ВыборкаДетальныеЗаписи.Организация);
		НаборЗаписей.Отбор.Период.Установить(ВыборкаДетальныеЗаписи.Период);
		
		НаборЗаписей.Прочитать();
		
		Если НЕ НаборЗаписей.Количество() = 0 Тогда
			
			Для Каждого ЗаписьНабора Из НаборЗаписей Цикл
				ЗаписьНабора.СистемаНалогообложения = Перечисления.СистемыНалогообложения.Общая;
			КонецЦикла;
			
		КонецЕсли;
		
		Если НЕ НаборЗаписей.Количество() = 0 Тогда
			
			Попытка
				
				НаборЗаписей.ОбменДанными.Загрузка = Истина;
				НаборЗаписей.Записать();

			Исключение
				
				ТекстСообщения = НСтр(
				"ru = 'при записи набора данных ""Учетная политика по налоговому учету"" произошла ошибка: 
				|%1");
				
				ПодробноеПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				Комментарий = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ПодробноеПредставлениеОшибки);
				
				ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Не удалось обновить ""Регистр сведений  ""Учетная политика по налоговому учету"""".'"), 
				УровеньЖурналаРегистрации.Ошибка, , , Комментарий);					
				
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПризнакиДублированияНачисленийДляБольничного() Экспорт
	
	Запрос = Новый Запрос;
	
	СписокКатегорий = Новый Массив;
	СписокКатегорий.Добавить(Перечисления.КатегорииНачисленийИНеоплаченногоВремени.БолезньБезОплаты);
	СписокКатегорий.Добавить(Перечисления.КатегорииНачисленийИНеоплаченногоВремени.ОплатаБольничногоЛиста);
	СписокКатегорий.Добавить(Перечисления.КатегорииНачисленийИНеоплаченногоВремени.ОплатаБольничногоНесчастныйСлучайНаПроизводстве);
	СписокКатегорий.Добавить(Перечисления.КатегорииНачисленийИНеоплаченногоВремени.ОплатаБольничногоПрофзаболевание);
	СписокКатегорий.Добавить(Перечисления.КатегорииНачисленийИНеоплаченногоВремени.ОтпускПоБеременностиИРодам);
	СписокКатегорий.Добавить(Перечисления.КатегорииНачисленийИНеоплаченногоВремени.ОтпускПоБеременностиИРодамБезОплаты);
	СписокКатегорий.Добавить(Перечисления.КатегорииНачисленийИНеоплаченногоВремени.ОтпускПоБеременностиИРодамВоеннослужащего);
	
	Запрос.УстановитьПараметр("СписокКатегорий", СписокКатегорий);
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Начисления.Ссылка,
		|	ЛОЖЬ КАК ДублироватьДляВнутреннихСовместителейИПодработок,
		|	ЛОЖЬ КАК ДублироватьДляПодработок
		|ИЗ
		|	ПланВидовРасчета.Начисления КАК Начисления
		|ГДЕ
		|	Начисления.КатегорияНачисленияИлиНеоплаченногоВремени В (&СписокКатегорий)
		|	И Начисления.ДублироватьДляВнутреннихСовместителейИПодработок = ИСТИНА";
		
	РезультатЗапроса = Запрос.Выполнить();
	
	ПакетВидовРасчета = Новый Массив;
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			ВидРасчетаОбъект = Выборка.Ссылка.ПолучитьОбъект();
			
			ВидРасчетаОбъект.ДублироватьДляВнутреннихСовместителейИПодработок = Выборка.ДублироватьДляВнутреннихСовместителейИПодработок;
			ВидРасчетаОбъект.ДублироватьДляПодработок = Выборка.ДублироватьДляПодработок;
			
			ПакетВидовРасчета.Добавить(ВидРасчетаОбъект);
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	РасчетЗарплатыРасширенный.ЗаписатьПакетВидовРасчета(ПакетВидовРасчета, Ложь);

КонецПроцедуры

