Процедура ЗаполнитьСведенияОСтавкахНалоговСборовОтчислений() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СведенияОСтавкахНалоговСборовОтчислений.Период КАК Период,
		|	СведенияОСтавкахНалоговСборовОтчислений.Организация КАК Организация,
		|	СведенияОСтавкахНалоговСборовОтчислений.ВидНалогаВзносаОтчисления КАК ВидНалогаВзносаОтчисления
		|ИЗ
		|	РегистрСведений.СведенияОСтавкахНалоговСборовОтчислений КАК СведенияОСтавкахНалоговСборовОтчислений
		|ГДЕ
		|	СведенияОСтавкахНалоговСборовОтчислений.ВидДохода = ЗНАЧЕНИЕ(Справочник.ВидыДоходов.ПустаяСсылка)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	НаборЗаписей = РегистрыСведений.СведенияОСтавкахНалоговСборовОтчислений.СоздатьНаборЗаписей();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		НаборЗаписей.Отбор.Период.Установить(ВыборкаДетальныеЗаписи.Период);
		НаборЗаписей.Отбор.Организация.Установить(ВыборкаДетальныеЗаписи.Организация);
		НаборЗаписей.Отбор.ВидНалогаВзносаОтчисления.Установить(ВыборкаДетальныеЗаписи.ВидНалогаВзносаОтчисления);
		
		НаборЗаписей.Прочитать();
		Для Каждого ЗаписьНабора Из НаборЗаписей Цикл
				ЗаписьНабора.ВидДохода = Справочники.ВидыДоходов.ДоходыОтРаботодателя;
		КонецЦикла;
		
		Попытка
			
			НаборЗаписей.ОбменДанными.Загрузка = Истина;
			НаборЗаписей.Записать();
			
		Исключение
			
			ТекстСообщения = НСтр(
			"ru = 'При записи набора данных ""Сведения о ставках налогов, сборов, отчислений"" произошла ошибка: 
			|%1");
			
			ПодробноеПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			Комментарий = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ПодробноеПредставлениеОшибки);
			
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Не удалось обновить ""Регистр сведений  ""Сведения о ставках налогов, сборов, отчислений"""".'"),
				УровеньЖурналаРегистрации.Ошибка, , , Комментарий);
			
		КонецПопытки;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВидыДоходов.Ссылка КАК ВидДохода
		|ИЗ
		|	Справочник.ВидыДоходов КАК ВидыДоходов
		|ГДЕ
		|	ВидыДоходов.Предопределенный = ИСТИНА
		|	И ВидыДоходов.УчитыватьОПВ = ИСТИНА";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		НаборЗаписей.Отбор.Период.Установить('20200101');
		НаборЗаписей.Отбор.Организация.Установить(Справочники.Организации.ПустаяСсылка());
		НаборЗаписей.Отбор.ВидНалогаВзносаОтчисления.Установить(Перечисления.ВидыНалоговВзносовОтчислений.ОПВ);
		НаборЗаписей.Отбор.ВидДохода.Установить(ВыборкаДетальныеЗаписи.ВидДохода);
		
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() = 0 Тогда
			
			Движение = НаборЗаписей.Добавить();
			// Свойства
			Движение.Период = '20200101';
			//Измерения
			Движение.Организация = Справочники.Организации.ПустаяСсылка();
			Движение.ВидНалогаВзносаОтчисления = Перечисления.ВидыНалоговВзносовОтчислений.ОПВ;
			Движение.ВидДохода = ВыборкаДетальныеЗаписи.ВидДохода;
			// Ресурсы
			Движение.Ставка = 10;
			
			Попытка
				
				НаборЗаписей.ОбменДанными.Загрузка = Истина;
				НаборЗаписей.Записать();
				
			Исключение
				
				ТекстСообщения = НСтр(
				"ru = 'При записи набора данных ""Сведения о ставках налогов, сборов, отчислений"" произошла ошибка: 
				|%1");
				
				ПодробноеПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				Комментарий = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ПодробноеПредставлениеОшибки);
				
				ЗаписьЖурналаРегистрации(
					НСтр("ru = 'Не удалось обновить ""Регистр сведений  ""Сведения о ставках налогов, сборов, отчислений"""".'"),
				УровеньЖурналаРегистрации.Ошибка, , , Комментарий);
				
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
	
	
КонецПроцедуры

Процедура ОбновитьИспользованиеВремениКомпенсацииОтпуска() Экспорт 
	
	КоличествоДнейКомпенсации = ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Справочник.ПоказателиРасчетаЗарплаты.КоличествоДнейКомпенсации");
	
	Если КоличествоДнейКомпенсации = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Показатель", КоличествоДнейКомпенсации);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	НачисленияПоказатели.Ссылка
	               |ИЗ
	               |	ПланВидовРасчета.Начисления.Показатели КАК НачисленияПоказатели
	               |ГДЕ
	               |	НачисленияПоказатели.Показатель = &Показатель";
				   
	Выборка = Запрос.Выполнить().Выбрать();
	
	ПакетВидовРасчета = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		НачислениеОбъект = Выборка.Ссылка.ПолучитьОбъект();
		РасчетЗарплатыРасширенный.ЗаполнитьИнформациюОбУчетеВремени(НачислениеОбъект);
		ПакетВидовРасчета.Добавить(НачислениеОбъект);
	КонецЦикла;
	
	РасчетЗарплатыРасширенный.ЗаписатьПакетВидовРасчета(ПакетВидовРасчета, Ложь);
	
КонецПроцедуры

Процедура ОтработаноДнейЧасов() Экспорт
	
	ОтработаноДнейЧасовСсылка = Справочники.ПоказателиРасчетаЗарплаты.НайтиПоНаименованию("Отработано дней (часов), в т.ч. сверхурочно");
	
	Если ЗначениеЗаполнено(ОтработаноДнейЧасовСсылка) Тогда
		
		ОтработаноДнейЧасовОбъект = ОтработаноДнейЧасовСсылка.ПолучитьОбъект();
		
		Если НЕ ЗначениеЗаполнено(ОтработаноДнейЧасовОбъект.ИмяПредопределенныхДанных) Тогда
			Возврат;	
		КонецЕсли;
			
		ОтработаноДнейЧасовОбъект.ИмяПредопределенныхДанных = "";
		
		Попытка
			ОтработаноДнейЧасовОбъект.Заблокировать();
		Исключение
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Невозможно изменить показатель """"%2"""". Возможно, он редактируется другим пользователем'"), ОтработаноДнейЧасовОбъект.Наименование);
