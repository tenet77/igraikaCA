	|	&Договор КАК ДоговорКонтрагента,
	|	&Ссылка КАК СчетФактура,
	|	ЗНАЧЕНИЕ(Справочник.ВидыРеализации.РеализацияТМЗ) КАК ВидОперацииРеализации,
	|	Товары.СтавкаНДС КАК СтавкаНДС,
	|	СУММА(ВЫРАЗИТЬ((Товары.СуммаСНДС - Товары.СуммаНДС) * &КоэффициентПересчетаВВалютуРегл КАК ЧИСЛО(15, 2))) КАК СуммаБезНДС,
	|	СУММА(ВЫРАЗИТЬ((Товары.СуммаСНДС - Товары.СуммаНДС) * &КоэффициентПересчетаВВалютуРегл КАК ЧИСЛО(15, 2))) КАК ОборотПоРеализации,
	|	СУММА(ВЫРАЗИТЬ(Товары.СуммаНДС * &КоэффициентПересчетаВВалютуРегл КАК ЧИСЛО(15, 2))) КАК СуммаНДС
	|ИЗ
	|	Документ.СчетФактураНаНеподтвержденнуюРеализацию0.Товары КАК Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НДССостояниеРеализации0 КАК НДССостояниеРеализации0
	|			ПО Товары.Ссылка.ДокументОснование = НДССостояниеРеализации0.ДокументРеализации
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|	И Товары.Номенклатура.ТипНоменклатуры В (ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга),
	|											 ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа))
	|	И Товары.ТипЗапасов = ЗНАЧЕНИЕ(Перечисление.ТипыЗапасов.Услуга)
	|	И &Организация <> ЗНАЧЕНИЕ(Справочник.Организации.УправленческаяОрганизация)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР
	|		КОГДА НАЧАЛОПЕРИОДА(НДССостояниеРеализации0.ДатаРеализации,КВАРТАЛ) < НАЧАЛОПЕРИОДА(&Дата,КВАРТАЛ)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА НАЧАЛОПЕРИОДА(НДССостояниеРеализации0.ДатаРеализации,КВАРТАЛ) < НАЧАЛОПЕРИОДА(&Дата,КВАРТАЛ)
	|			ТОГДА НДССостояниеРеализации0.ДатаРеализации
	|		ИНАЧЕ NULL
	|	КОНЕЦ,
	|	Товары.СтавкаНДС";

	Возврат ТекстЗапроса;

КонецФункции

Функция ТекстЗапросаТаблицаНДС_ВозвратТоваровМеждуОрганизациями()

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	&Дата КАК Период,
	|	&Дата КАК НалоговыйПериод,
	|	NULL КАК КорректируемыйПериод,
	|	&Ссылка КАК Регистратор,
	|	&ОрганизацияПолучатель КАК Организация,
	|	ВЫБОР
	|		КОГДА &РасчетыЧерезОтдельногоКонтрагента = ИСТИНА
	|			ТОГДА &Контрагент
	|		ИНАЧЕ &Организация
	|	КОНЕЦ КАК Контрагент,
	|	&Договор КАК ДоговорКонтрагента,
	|	&Ссылка КАК СчетФактура,
	|	ТаблицаТовары.СтавкаНДС КАК СтавкаНДС,
	|	-1 * СУММА(ВЫРАЗИТЬ((Строки.СуммаСНДС - Строки.СуммаНДС) * &КоэффициентПересчетаВВалютуРегл КАК ЧИСЛО(15, 2))) КАК СуммаБезНДС,
	|	-1 * СУММА(ВЫРАЗИТЬ((Строки.СуммаСНДС - Строки.СуммаНДС) * &КоэффициентПересчетаВВалютуРегл КАК ЧИСЛО(15, 2))) КАК ОборотПоРеализации,
	|	-1 * СУММА(ВЫРАЗИТЬ(Строки.СуммаНДС * &КоэффициентПересчетаВВалютуРегл КАК ЧИСЛО(15, 2))) КАК СуммаНДС,
	|	ТаблицаТовары.ВидОперацииРеализации КАК ВидОперацииРеализации
	|ИЗ
	|	Документ.ВозвратТоваровМеждуОрганизациями.Товары КАК ТаблицаТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВозвратТоваровМеждуОрганизациями.ВидыЗапасов КАК Строки
	|		ПО ТаблицаТовары.Ссылка = Строки.Ссылка
	|			И ТаблицаТовары.АналитикаУчетаНоменклатуры = Строки.АналитикаУчетаНоменклатуры
	|ГДЕ
	|	ТаблицаТовары.Ссылка = &Ссылка
	|	И &ОрганизацияПолучатель <> ЗНАЧЕНИЕ(Справочник.Организации.УправленческаяОрганизация)
	|	И &НалогообложениеНДС В (ЗНАЧЕНИЕ(Перечисление.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС), ЗНАЧЕНИЕ(Перечисление.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС))
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаТовары.СтавкаНДС,
	|	ТаблицаТовары.ВидОперацииРеализации";
	
	Возврат ТекстЗапроса;

КонецФункции

Функция ТекстЗапросаТаблицаНДС_ВозвратТоваровОтКлиента()

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	&Дата КАК Период,
	|	&Дата КАК НалоговыйПериод,
	|	NULL КАК КорректируемыйПериод,
	|	&Ссылка КАК Регистратор,
