	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Дата КАК Период,
	|	&Дата КАК НалоговыйПериод,
	|	ЛОЖЬ КАК ЗаписьДополнительнойДекларации,
	|	NULL КАК КорректируемыйПериод,
	|	&Ссылка КАК Регистратор,
	|	&Организация КАК Организация,
	|	&Контрагент КАК Контрагент,
	|	&Договор КАК ДоговорКонтрагента,
	|	&Ссылка КАК СчетФактура,
	|	Значение(Справочник.ВидыРеализации.РеализацияТМЗ) КАК ВидОперацииРеализации,
	|	ТаблицаТовары.СтавкаНДС КАК СтавкаНДС,
	|	СУММА(ВЫРАЗИТЬ((ТаблицаТовары.СуммаСНДС - ТаблицаТовары.СуммаНДС) * &КоэффициентПересчетаВВалютуРегл КАК ЧИСЛО(15, 2))) КАК СуммаБезНДС,
	|	СУММА(ВЫРАЗИТЬ((ТаблицаТовары.СуммаСНДС - ТаблицаТовары.СуммаНДС) * &КоэффициентПересчетаВВалютуРегл КАК ЧИСЛО(15, 2))) КАК ОборотПоРеализации,
	|	СУММА(ВЫРАЗИТЬ((ТаблицаТовары.СуммаСНДС - ТаблицаТовары.СуммаНДС) * &КоэффициентПересчетаВВалютуРегл КАК ЧИСЛО(15, 2)) * ЕСТЬNULL(СтавкиНДС.Ставка,0)/100) КАК СуммаНДС
	|ИЗ
	|	Документ.ВыкупВозвратнойТарыКлиентом.Товары КАК ТаблицаТовары
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтавкиНДС КАК СтавкиНДС
	|		ПО ТаблицаТовары.СтавкаНДС = СтавкиНДС.Ссылка
	|
	|
	|ГДЕ
	|	ТаблицаТовары.Ссылка = &Ссылка
	|	И ТаблицаТовары.Номенклатура.ТипНоменклатуры <> ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
	|	И &НалогообложениеНДС В(ЗНАЧЕНИЕ(Перечисление.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС),
	|							ЗНАЧЕНИЕ(Перечисление.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС))
	|	И &Организация <> ЗНАЧЕНИЕ(Справочник.Организации.УправленческаяОрганизация)
	|	И  ТаблицаТовары.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.МногооборотнаяТара)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаТовары.СтавкаНДС";


	Возврат ТекстЗапроса;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОтразитьНДС(Объект, ДополнительныеСвойства, Движения, Отказ) Экспорт

	Если НЕ ДополнительныеСвойства.ТаблицыДляДвижений.Свойство("ТаблицаНДС") Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Движения.НДС.ДополнительныеСвойства.Свойство("ДляПроведения") Тогда
        ПроведениеСерверУТ.ЗаполнитьДополнительныеСвойстваНабораПоДокументу(Объект, Движения.НДС);
	КонецЕсли;

	ТаблицаДвижений = ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаНДС;

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Движения.НДС.Записывать = Истина;
	Движения.НДС.Загрузить(ТаблицаДвижений);
	
	ЗарегистрироватьЗаданияКЗакрытиюМесяцаНДС(Объект, ДополнительныеСвойства);

КонецПроцедуры

Процедура ОтразитьНДСКВозмещению(Объект, ДополнительныеСвойства, Движения, Отказ) Экспорт

	Если НЕ ДополнительныеСвойства.ТаблицыДляДвижений.Свойство("ТаблицаНДСКВозмещению") Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Движения.НДСКВозмещению.ДополнительныеСвойства.Свойство("ДляПроведения") Тогда
		ПроведениеСерверУТ.ЗаполнитьДополнительныеСвойстваНабораПоДокументу(Объект, Движения.НДСКВозмещению);
	КонецЕсли;
	
	ТаблицаДвижений = ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаНДСКВозмещению;

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Движения.НДСКВозмещению.Записывать = Истина;
	Движения.НДСКВозмещению.Загрузить(ТаблицаДвижений);
	
	ЗарегистрироватьЗаданияКЗакрытиюМесяцаНДСКВозмещению(Объект, ДополнительныеСвойства);

КонецПроцедуры

Процедура ОтразитьНДСЗаНерезидента(ДополнительныеСвойства, Движения, Отказ) Экспорт

	Если НЕ ДополнительныеСвойства.ТаблицыДляДвижений.Свойство("ТаблицаНДСЗаНерезидента") Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаДвижений = ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаНДСЗаНерезидента;

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Движения.НДСЗаНерезидента.Записывать = Истина;
	Движения.НДСЗаНерезидента.Загрузить(ТаблицаДвижений);

КонецПроцедуры

Процедура ИнициализироватьДанныеДокумента(ДокументОбъект, ДополнительныеСвойства, СтруктураРегистров) Экспорт
	
	////////////////////////////////////////////////////////////////////////////
	// Создадим запрос инициализации движений
	
	СтруктураПараметров = Новый Структура;
	ЗаполнитьСтруктуруПараметровЗапроса(СтруктураПараметров, ДокументОбъект);
	
	Запрос = Новый Запрос;
	УстановитьПараметрыЗапроса(Запрос, СтруктураПараметров);
	
	////////////////////////////////////////////////////////////////////////////
	// Сформируем текст запроса
	
	ТекстыЗапроса = Новый СписокЗначений;
	Для Каждого Регистр Из СтруктураРегистров Цикл
		
		Если Регистр.Значение Тогда
			Если Регистр.Ключ = "НДСКВозмещению" И 
				(ДокументОбъект.Метаданные().Имя = "РеализацияТоваровУслуг" ИЛИ ДокументОбъект.Метаданные().Имя = "КорректировкаРеализации") Тогда
				Продолжить;
			КонецЕсли;
			ИмяПроцедуры = "ТекстЗапросаТаблица" + Регистр.Ключ + "_[ИмяДокумента]()";
			ИмяПроцедуры = СтрЗаменить(ИмяПроцедуры, "[ИмяДокумента]", ДокументОбъект.Метаданные().Имя);
			ТекстЗапроса = Вычислить(ИмяПроцедуры);
			
			Если ЗначениеЗаполнено(ТекстЗапроса) Тогда
				ТекстыЗапроса.Добавить(ТекстЗапроса, "Таблица" + Регистр.Ключ);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ПроведениеСерверУТ.ИнициализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, ДополнительныеСвойства.ТаблицыДляДвижений, Истина);
	
КонецПроцедуры

Процедура ЗаполнитьСтруктуруПараметровЗапроса(СтруктураПараметров, ДокументОбъект)
	
	СтруктураПараметров.Вставить("Ссылка");
	СтруктураПараметров.Вставить("Статус");
	СтруктураПараметров.Вставить("Дата");
	СтруктураПараметров.Вставить("Организация");
	СтруктураПараметров.Вставить("Контрагент");
	СтруктураПараметров.Вставить("НалогообложениеНДС");
	СтруктураПараметров.Вставить("ВернутьМногооборотнуюТару");
	СтруктураПараметров.Вставить("Валюта");
	СтруктураПараметров.Вставить("ВалютаВзаиморасчетов");
	СтруктураПараметров.Вставить("Договор");
	СтруктураПараметров.Вставить("РасчетыЧерезОтдельногоКонтрагента");
	СтруктураПараметров.Вставить("ОрганизацияПолучатель");
	СтруктураПараметров.Вставить("Комитент");
	СтруктураПараметров.Вставить("Комиссионер");
	СтруктураПараметров.Вставить("СтавкаНДС");
	СтруктураПараметров.Вставить("ЗакупкаПодДеятельность");
	СтруктураПараметров.Вставить("ВидОперацииРеализации");
	СтруктураПараметров.Вставить("ПрименяетсяУчетНДСПоФактическомуИспользованию");
	СтруктураПараметров.Вставить("ИспользоватьРаздельныйУчетПоНалогообложению");
	СтруктураПараметров.Вставить("ВозвратПереданнойМногооборотнойТары");

	ЗаполнитьЗначенияСвойств(СтруктураПараметров, ДокументОбъект);
	
КонецПроцедуры

Процедура УстановитьПараметрыЗапроса(Запрос, СтруктураПараметров)

	СтруктураПараметров.Валюта				 = ?(ЗначениеЗаполнено(СтруктураПараметров.Валюта), СтруктураПараметров.Валюта, Константы.ВалютаРегламентированногоУчета.Получить());
	СтруктураПараметров.ВалютаВзаиморасчетов = ?(ЗначениеЗаполнено(СтруктураПараметров.ВалютаВзаиморасчетов), СтруктураПараметров.ВалютаВзаиморасчетов, СтруктураПараметров.Валюта);

	Для Каждого Параметр Из СтруктураПараметров Цикл 

		Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);

	КонецЦикла;

	УстановитьПараметрыЗапросаКоэффициентыВалют(Запрос);

	ПараметрыУчетнойПолитики = РегистрыСведений.УчетнаяПолитикаОрганизаций.ПараметрыУчетнойПолитики(СтруктураПараметров.Организация, СтруктураПараметров.Дата);
	Запрос.УстановитьПараметр("ПрименяетсяУчетНДСПоФактическомуИспользованию", ?(ПараметрыУчетнойПолитики = Неопределено, Ложь, ПараметрыУчетнойПолитики.ПрименяетсяУчетНДСПоФактическомуИспользованию));
	Запрос.УстановитьПараметр("ИспользоватьРаздельныйУчетПоНалогообложению", ПолучитьФункциональнуюОпцию("ИспользоватьРаздельныйУчетПоНалогообложению"));

КонецПроцедуры

Процедура УстановитьПараметрыЗапросаКоэффициентыВалют(Запрос)

	Если Запрос.Параметры.Свойство("КоэффициентПересчетаВВалютуУПР")
		И Запрос.Параметры.Свойство("КоэффициентПересчетаВВалютуРегл")
		И Запрос.Параметры.Свойство("КоэффициентПересчетаВВалютуВзаиморасчетов") Тогда
		Возврат;
	КонецЕсли;

	Коэффициенты = РаботаСКурсамивалютУТ.ПолучитьКоэффициентыПересчетаВалюты(
		Запрос.Параметры.Валюта,
		Запрос.Параметры.ВалютаВзаиморасчетов,
		Запрос.Параметры.Дата);

	Запрос.УстановитьПараметр("КоэффициентПересчетаВВалютуУПР",            Коэффициенты.КоэффициентПересчетаВВалютуУПР);
	Запрос.УстановитьПараметр("КоэффициентПересчетаВВалютуРегл",           Коэффициенты.КоэффициентПересчетаВВалютуРегл);
	Запрос.УстановитьПараметр("КоэффициентПересчетаВВалютуВзаиморасчетов", Коэффициенты.КоэффициентПересчетаВВалютуВзаиморасчетов);

КонецПроцедуры

