Функция ТекстЗапросаТаблицаНДС_ОтчетДавальцу()
	
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА НЕ Продукция.Ссылка.СпособВыпискиАктовВыполненныхРабот = ЗНАЧЕНИЕ(Перечисление.СпособыВыпискиАктовВыполненныхРабот.ВБумажномВиде) И НЕ Продукция.Ссылка.ДатаПодписанияГЗ = ДАТАВРЕМЯ(1,1,1)
	|			ТОГДА Продукция.Ссылка.ДатаПодписанияГЗ
	|		ИНАЧЕ &Дата
	|	КОНЕЦ КАК Период,
	|	ВЫБОР
	|		КОГДА НЕ Продукция.Ссылка.СпособВыпискиАктовВыполненныхРабот = ЗНАЧЕНИЕ(Перечисление.СпособыВыпискиАктовВыполненныхРабот.ВБумажномВиде) И НЕ Продукция.Ссылка.ДатаПодписанияГЗ = ДАТАВРЕМЯ(1,1,1)
	|			ТОГДА Продукция.Ссылка.ДатаПодписанияГЗ
	|		ИНАЧЕ &Дата
	|	КОНЕЦ КАК НалоговыйПериод,
	|	NULL КАК КорректируемыйПериод,
	|	Продукция.Ссылка КАК Регистратор,
	|	&Организация КАК Организация,
	|	&Контрагент КАК Контрагент,
	|	&Договор КАК ДоговорКонтрагента,
	|	&Ссылка КАК СчетФактура,
	|	&ВидОперацииРеализации КАК ВидОперацииРеализации,
	|	&СтавкаНДС КАК СтавкаНДС,
	|	СУММА(ВЫРАЗИТЬ((Продукция.СуммаСНДС - Продукция.СуммаНДС) * &КоэффициентПересчетаВВалютуРегл КАК ЧИСЛО(15, 2))) КАК СуммаБезНДС,
	|	СУММА(ВЫРАЗИТЬ((Продукция.СуммаСНДС - Продукция.СуммаНДС) * &КоэффициентПересчетаВВалютуРегл КАК ЧИСЛО(15, 2))) КАК ОборотПоРеализации,
	|	СУММА(ВЫРАЗИТЬ((Продукция.СуммаСНДС - Продукция.СуммаНДС) * &КоэффициентПересчетаВВалютуРегл КАК ЧИСЛО(15, 2)) * ЕСТЬNULL(СтавкиНДС.Ставка,0)/100) КАК СуммаНДС
	|ИЗ
	|	Документ.ОтчетДавальцу.Продукция КАК Продукция
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтавкиНДС КАК СтавкиНДС
	|		ПО СтавкиНДС.Ссылка = &СтавкаНДС
	|	
	|ГДЕ
	|	Продукция.Ссылка = &Ссылка
	|	И &Организация <> ЗНАЧЕНИЕ(Справочник.Организации.УправленческаяОрганизация)
	|	И &НалогообложениеНДС В(ЗНАЧЕНИЕ(Перечисление.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС),
	|							ЗНАЧЕНИЕ(Перечисление.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС))
	|	И ((НЕ Продукция.Ссылка.СпособВыпискиАктовВыполненныхРабот = ЗНАЧЕНИЕ(Перечисление.СпособыВыпискиАктовВыполненныхРабот.ВБумажномВиде) 
	|				И НЕ Продукция.Ссылка.ДатаПодписанияГЗ = ДАТАВРЕМЯ(1,1,1)) 
	|				ИЛИ Продукция.Ссылка.СпособВыпискиАктовВыполненныхРабот = ЗНАЧЕНИЕ(Перечисление.СпособыВыпискиАктовВыполненныхРабот.ВБумажномВиде))
	|СГРУППИРОВАТЬ ПО
