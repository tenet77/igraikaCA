	|	&Ссылка КАК СчетФактура,
	|	Товары.ВидОперацииРеализации КАК ВидОперацииРеализации,
	|	Товары.СтавкаНДС КАК СтавкаНДС,
	|	СУММА(ВЫРАЗИТЬ((Товары.СуммаСНДС - Товары.СуммаНДС) * &КоэффициентПересчетаВВалютуРегл КАК ЧИСЛО(15, 2)) * -1) КАК СуммаБезНДС,
	|	СУММА(ВЫРАЗИТЬ((Товары.СуммаСНДС - Товары.СуммаНДС) * &КоэффициентПересчетаВВалютуРегл КАК ЧИСЛО(15, 2)) * -1) КАК ОборотПоРеализации,
	|	СУММА(ВЫРАЗИТЬ((Товары.СуммаСНДС - Товары.СуммаНДС) * &КоэффициентПересчетаВВалютуРегл КАК ЧИСЛО(15, 2)) * ЕСТЬNULL(СтавкиНДС.Ставка,0)/100 * -1) КАК СуммаНДС
	|ИЗ
	|	Документ.ВозвратТоваровОтКлиента.Товары КАК Товары
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтавкиНДС КАК СтавкиНДС
	|		ПО Товары.СтавкаНДС = СтавкиНДС.Ссылка
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|	И &Организация <> ЗНАЧЕНИЕ(Справочник.Организации.УправленческаяОрганизация)
	|	И &НалогообложениеНДС В (ЗНАЧЕНИЕ(Перечисление.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС), ЗНАЧЕНИЕ(Перечисление.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС))
	|	И ВЫБОР
	|			КОГДА &ВозвратПереданнойМногооборотнойТары
	|				ТОГДА Товары.АналитикаУчетаНоменклатуры.Номенклатура.ТипНоменклатуры <> ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.МногооборотнаяТара)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И Товары.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	Товары.СтавкаНДС,
	|	Товары.ВидОперацииРеализации";
	
	Возврат ТекстЗапроса;

КонецФункции

Функция ТекстЗапросаТаблицаНДС_ТаможеннаяДекларацияИмпорт()

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	&Дата КАК Период,
	|	&Дата КАК НалоговыйПериод,
	|	ЛОЖЬ КАК ЗаписьДополнительнойДекларации,
	|	NULL КАК КорректируемыйПериод,
	|	&Ссылка КАК Регистратор,
	|	&Ссылка КАК СчетФактура,
	|	&Организация КАК Организация,
	|	&Контрагент КАК Контрагент,
	|	&Договор КАК ДоговорКонтрагента,
	|	Разделы.СтавкаНДС,
	|	ЗНАЧЕНИЕ(Справочник.ВидыРеализации.ИмпортТМЗМетодомЗачета) КАК ВидОперацииРеализации,
	|	СУММА(ВЫРАЗИТЬ((ТаблицаТовары.ТаможеннаяСтоимость + ТаблицаТовары.СуммаПошлины + ТаблицаТовары.СпециальнаяПошлина + ТаблицаТовары.ТаможенныйСбор) * &КоэффициентПересчетаВВалютуРегл КАК ЧИСЛО(15, 2))) КАК СуммаБезНДС,
	|	СУММА(ВЫРАЗИТЬ(ТаблицаТовары.СуммаНДС * &КоэффициентПересчетаВВалютуРегл КАК ЧИСЛО(15, 2))) КАК СуммаНДС,
	|	СУММА(ВЫРАЗИТЬ((ТаблицаТовары.ТаможеннаяСтоимость + ТаблицаТовары.СуммаПошлины + ТаблицаТовары.СпециальнаяПошлина + ТаблицаТовары.ТаможенныйСбор) * &КоэффициентПересчетаВВалютуРегл КАК ЧИСЛО(15, 2))) КАК ОборотПоРеализации
	|ИЗ
	|	Документ.ТаможеннаяДекларацияИмпорт.Товары КАК ТаблицаТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТаможеннаяДекларацияИмпорт.Разделы КАК Разделы
	|		ПО ТаблицаТовары.Ссылка = Разделы.Ссылка
	|			И ТаблицаТовары.НомерРаздела = Разделы.НомерРаздела
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УчетнаяПолитикаОрганизаций.СрезПоследних(&Дата, Организация = &Организация) КАК РегУчетнаяПолитика
	|		ПО РегУчетнаяПолитика.Организация = &Организация
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УчетныеПолитикиОрганизаций КАК СпрУчетнаяПолитика
	|		ПО РегУчетнаяПолитика.УчетнаяПолитика = СпрУчетнаяПолитика.Ссылка
	|ГДЕ
	|	ТаблицаТовары.Ссылка = &Ссылка
	|	И ТаблицаТовары.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыТаможенныхДеклараций.ВыпущеноСТаможни)
	|	И &Организация <> ЗНАЧЕНИЕ(Справочник.Организации.УправленческаяОрганизация)
	|	И ТаблицаТовары.ВидОперацииПоступления.ВидНДС = Значение(Перечисление.ВидыНДС.НДСУплачиваемыйПриИмпортеМетодомЗачета)
	|	И ВЫБОР
	|			КОГДА &ВернутьМногооборотнуюТару
	|				ТОГДА ТаблицаТовары.Номенклатура.ТипНоменклатуры <> ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.МногооборотнаяТара)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ЕСТЬNULL(СпрУчетнаяПолитика.ПрименяетсяОсвобождениеОтУплатыНДС, ИСТИНА) = ЛОЖЬ
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаТовары.ВидОперацииПоступления,
	|	Разделы.СтавкаНДС";

	Возврат ТекстЗапроса;

КонецФункции

