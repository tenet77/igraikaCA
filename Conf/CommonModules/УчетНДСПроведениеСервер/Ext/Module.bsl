	|			И ТаблицаРасхождения.Склад = Строки.Склад
	|			И ТаблицаРасхождения.ЗаказКлиента = Строки.ЗаказКлиента
	|			И ТаблицаРасхождения.Упаковка = Строки.Упаковка
	// Примечание - подумать над соединением, соединение по идентификатору не подходит, т.к они разные.
	// по сути таблица Товары нужно только для того, чтобы определить вид операции по реализации НДС
	|ГДЕ
	|	ТаблицаРасхождения.Ссылка = &Ссылка
	|	И &Организация <> ЗНАЧЕНИЕ(Справочник.Организации.УправленческаяОрганизация)
	|	И &НалогообложениеНДС В(ЗНАЧЕНИЕ(Перечисление.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС),
	|							ЗНАЧЕНИЕ(Перечисление.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС),
	|							ЗНАЧЕНИЕ(Перечисление.ТипыНалогообложенияНДС.ПродажаНаЭкспорт))
	|	И ТаблицаРасхождения.Ссылка.ВидКорректировки = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.РеализацияПерепоставленногоТовара)
	|	И (Строки.ВидЗапасов ЕСТЬ NULL
	|		ИЛИ Строки.ВидЗапасов.ТипЗапасов = ЗНАЧЕНИЕ(Перечисление.ТипыЗапасов.Товар))
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаРасхождения.СтавкаНДС,
	|	ТаблицаРасхождения.ВидОперацииРеализации";
	
	Возврат ТекстЗапроса;

КонецФункции

Функция ТекстЗапросаТаблицаНДСКВозмещению_ТаможеннаяДекларацияИмпорт()

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	&Дата КАК Период,
	|	&Дата КАК НалоговыйПериод,
	|	ЛОЖЬ КАК ЗаписьДополнительнойДекларации,
	|	NULL КАК КорректируемыйПериод,
	|	&Ссылка КАК Регистратор,
	|	&Организация КАК Организация,
	|	&Контрагент КАК Контрагент,
	|	&Договор КАК ДоговорКонтрагента,
	|	&Ссылка КАК СчетФактура,
	|	Разделы.СтавкаНДС,
	|	ТаблицаТовары.ВидОперацииПоступления КАК ВидОперацииПоступления,
	|	ВЫБОР
	|		КОГДА &ИспользоватьРаздельныйУчетПоНалогообложению
	|			ТОГДА ВЫБОР
	|					КОГДА &ПрименяетсяУчетНДСПоФактическомуИспользованию = ЛОЖЬ
	|						ТОГДА ВЫБОР
	|								КОГДА ТаблицаТовары.ЗакупкаПодДеятельность = ЗНАЧЕНИЕ(Перечисление.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС)
	|									ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыОборотовПоРеализации.Облагаемый)
	|								ИНАЧЕ ВЫБОР
	|										КОГДА ТаблицаТовары.ЗакупкаПодДеятельность = ЗНАЧЕНИЕ(Перечисление.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС)
	|											ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыОборотовПоРеализации.Освобожденный)
	|										ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыОборотовПоРеализации.Общий)
	|									КОНЕЦ
	|							КОНЕЦ
	|					ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыОборотовПоРеализации.Общий)
	|				КОНЕЦ
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыОборотовПоРеализации.Общий)
	|	КОНЕЦ КАК ВидОборота,
	|	СУММА(ВЫРАЗИТЬ((ТаблицаТовары.ТаможеннаяСтоимость + ТаблицаТовары.СуммаПошлины + ТаблицаТовары.СпециальнаяПошлина + ТаблицаТовары.ТаможенныйСбор) * &КоэффициентПересчетаВВалютуРегл КАК ЧИСЛО(15, 2))) КАК СуммаБезНДС,
	|	СУММА(ВЫРАЗИТЬ(ТаблицаТовары.СуммаНДС * &КоэффициентПересчетаВВалютуРегл КАК ЧИСЛО(15, 2))) КАК СуммаНДС,
	|	СУММА(ВЫРАЗИТЬ(ТаблицаТовары.СуммаНДС * &КоэффициентПересчетаВВалютуРегл КАК ЧИСЛО(15, 2))) КАК УплаченныйНДС
	|ИЗ
	|	Документ.ТаможеннаяДекларацияИмпорт.Товары КАК ТаблицаТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТаможеннаяДекларацияИмпорт.Разделы КАК Разделы
	|		ПО ТаблицаТовары.Ссылка = Разделы.Ссылка
	|			И ТаблицаТовары.НомерРаздела = Разделы.НомерРаздела
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УчетнаяПолитикаОрганизаций.СрезПоследних(&Дата, Организация = &Организация) КАК РегУчетнаяПолитика
	|		ПО РегУчетнаяПолитика.Организация = &Организация
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УчетныеПолитикиОрганизаций КАК СпрУчетнаяПолитика
	|		ПО РегУчетнаяПолитика.УчетнаяПолитика = СпрУчетнаяПолитика.Ссылка
	|ГДЕ
	|	ТаблицаТовары.Ссылка = &Ссылка
	|	И ТаблицаТовары.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыТаможенныхДеклараций.ВыпущеноСТаможни)
	|	И &Организация <> ЗНАЧЕНИЕ(Справочник.Организации.УправленческаяОрганизация)
	|	И ВЫБОР
	|			КОГДА &ВернутьМногооборотнуюТару
	|				ТОГДА ТаблицаТовары.Номенклатура.ТипНоменклатуры <> ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.МногооборотнаяТара)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ЕСТЬNULL(СпрУчетнаяПолитика.ПрименяетсяОсвобождениеОтУплатыНДС, ИСТИНА) = ЛОЖЬ
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаТовары.ВидОперацииПоступления,
	|	ТаблицаТовары.ЗакупкаПодДеятельность,
	|	Разделы.СтавкаНДС";

	Возврат ТекстЗапроса;

КонецФункции

