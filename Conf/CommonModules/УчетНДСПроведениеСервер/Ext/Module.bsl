
#Область ПрограммныйИнтерфейс

//++ НЕ УТ

//Процедура-обработчик подписки на событие ОбработкаПроведения для документов, выполняющих движения по регистрам НДС и НДСКВозмещению.
//Предназначена для формирования движений по указанным регистрам.
//
//Параметры:
//		Источник - ДокументОбъект - документ-регистратор для регистров НДС и НДСКВозмещению
//		Отказ - Булево - флаг отказа
//		РежимПроведения - РежимПроведенияДокумента - Режим проведения документа
//
Процедура ПриПроведенииДокумента(Источник, Отказ, РежимПроведения) Экспорт

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	СтруктураРегистров = Новый Структура("НДС, НДСКВозмещению, НДСЗаНерезидента",
		Не Источник.Движения.Найти("НДС") = Неопределено,
		Не Источник.Движения.Найти("НДСКВозмещению") = Неопределено,
		Не Источник.Движения.Найти("НДСЗаНерезидента") = Неопределено);

	ИнициализироватьДанныеДокумента(Источник, Источник.ДополнительныеСвойства, СтруктураРегистров);

	Если СтруктураРегистров.НДС Тогда
		ОтразитьНДС(Источник, Источник.ДополнительныеСвойства, Источник.Движения, Отказ);
	КонецЕсли;

	Если СтруктураРегистров.НДСКВозмещению Тогда
		ОтразитьНДСКВозмещению(Источник, Источник.ДополнительныеСвойства, Источник.Движения, Отказ);
	КонецЕсли;

	Если СтруктураРегистров.НДСЗаНерезидента Тогда
		ОтразитьНДСЗаНерезидента(Источник.ДополнительныеСвойства, Источник.Движения, Отказ);
	КонецЕсли;
	
КонецПроцедуры

// Формирует записи в регистре накопления "НДС" без проведения документа
//
// Параметры:
// 	 ДокументСсылка - ДокументСсылка.РеализацияТоваровУслуг, ДокументСсылка.АктВыполненныхРабот - Документ реализации
//
Процедура СформироватьЗаписиНДС(ДокументСсылка) Экспорт
	
	ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
    Если ДокументОбъект.ДополнительныеСвойства.Количество() = 0 Тогда
        ДокументОбъект.ДополнительныеСвойства.Вставить("ЭтоНовый", Ложь);
        ДокументОбъект.ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписиДокумента.Запись);
    КонецЕсли;
    ПроведениеСерверУТ.ИнициализироватьДополнительныеСвойстваДляПроведения(ДокументСсылка, ДокументОбъект.ДополнительныеСвойства);
	
	Движения = Новый Структура;
	
	НДС = РегистрыНакопления.НДС.СоздатьНаборЗаписей();
	НДС.Отбор.Регистратор.Установить(ДокументСсылка);
	Движения.Вставить("НДС", НДС);
	
	Регистры = Новый Структура;
	Регистры.Вставить("НДС", Истина);
	
    ИнициализироватьДанныеДокумента(ДокументСсылка, ДокументОбъект.ДополнительныеСвойства, Регистры);
	ОтразитьНДС(ДокументОбъект, ДокументОбъект.ДополнительныеСвойства, Движения, Ложь);
	
	Для каждого Движение Из Движения Цикл
		Движение.Значение.Записать();
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗарегистрироватьЗаданияКЗакрытиюМесяцаНДС(Регистратор, ДополнительныеСвойства)
	
 	Если НЕ ДополнительныеСвойства.ДляПроведения.Свойство("СтруктураВременныеТаблицы") Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ДополнительныеСвойства.ДляПроведения.СтруктураВременныеТаблицы.Свойство("МенеджерВременныхТаблицНДС") Тогда
		МенеджерВременныхТаблицНДС = Новый МенеджерВременныхТаблиц;
		ДополнительныеСвойства.ДляПроведения.СтруктураВременныеТаблицы.Вставить("МенеджерВременныхТаблицНДС", МенеджерВременныхТаблицНДС);
	Иначе
		МенеджерВременныхТаблицНДС = ДополнительныеСвойства.ДляПроведения.СтруктураВременныеТаблицы.МенеджерВременныхТаблицНДС;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблицНДС;
	Запрос.УстановитьПараметр("Регистратор", Регистратор.Ссылка);
	ТекстЗапроса = "";
	
	Если МенеджерВременныхТаблицНДС.Таблицы.Найти("НДСПередЗаписью") = Неопределено Тогда
		
		ТекстЗапроса = ТекстЗапроса + "
		|ВЫБРАТЬ
		|	НДС.Период,
		|	НДС.Регистратор,
		|	НДС.Организация,
		|	НДС.ВидОперацииРеализации,
		|	НДС.СтавкаНДС,
		|	НДС.Контрагент,
		|	НДС.КорректируемыйПериод,
		|	НДС.СчетФактура,
		|	НДС.ДоговорКонтрагента,
		|	НДС.ЗаписьДополнительнойДекларации,
		|	НДС.НалоговыйПериод,
		|
		|	НДС.СуммаБезНДС,
		|	НДС.ОборотПоРеализации,
		|	НДС.СуммаНДС
		|
		|ПОМЕСТИТЬ НДСПередЗаписью
		|ИЗ
		|	РегистрНакопления.НДС КАК НДС
		|ГДЕ
		|	НДС.Регистратор = &Регистратор
		|;";
		
	КонецЕсли;
		
	Если ДополнительныеСвойства.ТаблицыДляДвижений.Свойство("ТаблицаНДС") Тогда
		ТекстЗапроса  = ТекстЗапроса + "ВЫБРАТЬ
		|	ДанныеНДС.Период КАК Период,
		|	ДанныеНДС.Регистратор КАК Регистратор,
		|	ДанныеНДС.Организация КАК Организация,
		|	ДанныеНДС.ВидОперацииРеализации КАК ВидОперацииРеализации,
		|	ДанныеНДС.СтавкаНДС КАК СтавкаНДС,
		|	ДанныеНДС.Контрагент КАК Контрагент,
		|	ЕСТЬNULL(ДанныеНДС.КорректируемыйПериод, ДатаВремя(1,1,1)) КАК КорректируемыйПериод,
		|	ДанныеНДС.СчетФактура КАК СчетФактура,
		|	ВЫБОР
		|		КОГДА ДанныеНДС.ДоговорКонтрагента = НЕОПРЕДЕЛЕНО
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
		|		ИНАЧЕ ДанныеНДС.ДоговорКонтрагента
		|	КОНЕЦ КАК ДоговорКонтрагента,
		|	ДанныеНДС.НалоговыйПериод,
		|	ДанныеНДС.СуммаБезНДС КАК СуммаБезНДС,
		|	ДанныеНДС.ОборотПоРеализации КАК ОборотПоРеализации,
		|	ДанныеНДС.СуммаНДС КАК СуммаНДС
		|ПОМЕСТИТЬ НДСдвижения
		|ИЗ
		|	&ТаблицаНДС КАК ДанныеНДС
		|;";
		
		ТаблицаНДС = ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаНДС;
		Запрос.УстановитьПараметр("ТаблицаНДС", ТаблицаНДС);
		Если ТаблицаНДС.Колонки.Найти("ДоговорКонтрагента") = Неопределено Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДанныеНДС.ДоговорКонтрагента", "ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)");
		КонецЕсли;
	Иначе
		ТекстЗапроса  = ТекстЗапроса + "ВЫБРАТЬ
		|	ДанныеНДС.Период КАК Период,
		|	ДанныеНДС.Регистратор КАК Регистратор,
		|	ДанныеНДС.Организация КАК Организация,
		|	ДанныеНДС.ВидОперацииРеализации КАК ВидОперацииРеализации,
		|	ДанныеНДС.СтавкаНДС КАК СтавкаНДС,
		|	ДанныеНДС.Контрагент КАК Контрагент,
		|	ЕСТЬNULL(ДанныеНДС.КорректируемыйПериод, ДатаВремя(1,1,1)) КАК КорректируемыйПериод,
		|	ДанныеНДС.СчетФактура КАК СчетФактура,
		|	ДанныеНДС.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	ДанныеНДС.НалоговыйПериод КАК НалоговыйПериод,
		|	ДанныеНДС.СуммаБезНДС КАК СуммаБезНДС,
		|	ДанныеНДС.ОборотПоРеализации КАК ОборотПоРеализации,
		|	ДанныеНДС.СуммаНДС КАК СуммаНДС
		|ПОМЕСТИТЬ НДСдвижения
		|ИЗ
		|	РегистрНакопления.НДС КАК ДанныеНДС
		|ГДЕ
		|	ДанныеНДС.Регистратор = &Регистратор
		|;";
	КонецЕсли;
	
	ТекстЗапроса  = ТекстЗапроса + "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НАЧАЛОПЕРИОДА(КОНЕЦПЕРИОДА(Таблица.Период, КВАРТАЛ), МЕСЯЦ) КАК Месяц,
	|	ЗНАЧЕНИЕ(Перечисление.ОперацииЗакрытияМесяца.РаспределениеНДС) КАК Операция,
	|	Таблица.Организация КАК Организация,
	|	Таблица.Регистратор КАК Документ
	|ПОМЕСТИТЬ НДСЗаданияКЗакрытиюМесяца
	|ИЗ
	|	(ВЫБРАТЬ
	|		НДС.Период КАК Период,
	|		НДС.Регистратор КАК Регистратор,
	|		НДС.Организация КАК Организация,
	|		НДС.ВидОперацииРеализации КАК ВидОперацииРеализации,
	|		НДС.СтавкаНДС КАК СтавкаНДС,
	|		НДС.Контрагент КАК Контрагент,
	|		ЕСТЬNULL(НДС.КорректируемыйПериод, ДАТАВРЕМЯ(1, 1, 1)) КАК КорректируемыйПериод,
	|		НДС.СчетФактура КАК СчетФактура,
	|		ВЫБОР
	|			КОГДА НДС.ДоговорКонтрагента = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
	|				ТОГДА НЕОПРЕДЕЛЕНО
	|			ИНАЧЕ НДС.ДоговорКонтрагента
	|		КОНЕЦ КАК ДоговорКонтрагента,
	|		НДС.НалоговыйПериод КАК НалоговыйПериод,
	|		НДС.СуммаБезНДС КАК СуммаБезНДС,
	|		НДС.ОборотПоРеализации КАК ОборотПоРеализации,
	|		НДС.СуммаНДС КАК СуммаНДС
	|	ИЗ
	|		НДСПередЗаписью КАК НДС
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		НДСдвижения.Период,
	|		НДСдвижения.Регистратор,
	|		НДСдвижения.Организация,
	|		НДСдвижения.ВидОперацииРеализации,
	|		НДСдвижения.СтавкаНДС,
	|		НДСдвижения.Контрагент,
	|		ЕСТЬNULL(НДСдвижения.КорректируемыйПериод, ДАТАВРЕМЯ(1, 1, 1)),
	|		НДСдвижения.СчетФактура,
	|		ВЫБОР
	|			КОГДА НДСдвижения.ДоговорКонтрагента = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
	|				ТОГДА НЕОПРЕДЕЛЕНО
	|			ИНАЧЕ НДСдвижения.ДоговорКонтрагента
	|		КОНЕЦ,
	|		НДСдвижения.НалоговыйПериод,
	|		-НДСдвижения.СуммаБезНДС,
	|		-НДСдвижения.ОборотПоРеализации,
	|		-НДСдвижения.СуммаНДС
	|	ИЗ
	|		НДСдвижения КАК НДСдвижения) КАК Таблица
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(КОНЕЦПЕРИОДА(Таблица.Период, КВАРТАЛ), МЕСЯЦ),
	|	Таблица.Период,
	|	Таблица.Регистратор,
	|	Таблица.Организация,
	|	Таблица.ВидОперацииРеализации,
	|	Таблица.СтавкаНДС,
	|	Таблица.Контрагент,
	|	Таблица.КорректируемыйПериод,
	|	Таблица.СчетФактура,
	|	Таблица.ДоговорКонтрагента,
	|	Таблица.НалоговыйПериод
	|
	|ИМЕЮЩИЕ
	|	(СУММА(Таблица.СуммаБезНДС) <> 0
	|		ИЛИ СУММА(Таблица.ОборотПоРеализации) <> 0
	|		ИЛИ СУММА(Таблица.СуммаНДС) <> 0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ НДСПередЗаписью";

	Попытка
		Запрос.Текст = ТекстЗапроса;
		Запрос.Выполнить();
		
		СтруктураВременныеТаблицы = ДополнительныеСвойства.ДляПроведения.СтруктураВременныеТаблицы;
		МенеджерВременныхТаблицДоЗаданийНДС = СтруктураВременныеТаблицы.МенеджерВременныхТаблиц;
		СтруктураВременныеТаблицы.МенеджерВременныхТаблиц = Запрос.МенеджерВременныхТаблиц;
		ПроведениеСерверУТ.СформироватьЗаписиРегистровЗаданий(Регистратор);
		
		СтруктураВременныеТаблицы.МенеджерВременныхТаблиц = МенеджерВременныхТаблицДоЗаданийНДС;
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Формирование задания к распределению НДС.'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗарегистрироватьЗаданияКЗакрытиюМесяцаНДСКВозмещению(Регистратор, ДополнительныеСвойства)
	
 	Если НЕ ДополнительныеСвойства.ДляПроведения.Свойство("СтруктураВременныеТаблицы") Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ДополнительныеСвойства.ДляПроведения.СтруктураВременныеТаблицы.Свойство("МенеджерВременныхТаблицНДС") Тогда
		МенеджерВременныхТаблицНДС = Новый МенеджерВременныхТаблиц;
		ДополнительныеСвойства.ДляПроведения.СтруктураВременныеТаблицы.Вставить("МенеджерВременныхТаблицНДС", МенеджерВременныхТаблицНДС);
	Иначе
		МенеджерВременныхТаблицНДС = ДополнительныеСвойства.ДляПроведения.СтруктураВременныеТаблицы.МенеджерВременныхТаблицНДС;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблицНДС;
	Запрос.УстановитьПараметр("Регистратор", Регистратор.Ссылка);
	ТекстЗапроса = "";
	
	Если МенеджерВременныхТаблицНДС.Таблицы.Найти("НДСКВозмещениюПередЗаписью") = Неопределено Тогда
		
		ТекстЗапроса = ТекстЗапроса + "
		|ВЫБРАТЬ
		|	НДСКВозмещению.Период,
		|	НДСКВозмещению.Регистратор,
		|	НДСКВозмещению.Организация,
		|	НДСКВозмещению.ВидОперацииПоступления,
		|	НДСКВозмещению.СтавкаНДС,
		|	НДСКВозмещению.Контрагент,
		|	НДСКВозмещению.ВидОборота,
		|	НДСКВозмещению.КорректируемыйПериод,
		|	НДСКВозмещению.СчетФактура,
		|	ВЫБОР
		|		КОГДА НДСКВозмещению.ДоговорКонтрагента = Неопределено 
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
		|		ИНАЧЕ НДСКВозмещению.ДоговорКонтрагента 
		|	КОНЕЦ КАК ДоговорКонтрагента,
		|	НДСКВозмещению.ЗаписьДополнительнойДекларации,
		|	НДСКВозмещению.НалоговыйПериод,
		|
		|	НДСКВозмещению.СуммаБезНДС,
		|	НДСКВозмещению.УплаченныйНДС,
		|	НДСКВозмещению.СуммаНДС,
		|
		|	НДСКВозмещению.ЗакупкаПодДеятельность
		|
		|ПОМЕСТИТЬ НДСКВозмещениюПередЗаписью
		|ИЗ
		|	РегистрНакопления.НДСКВозмещению КАК НДСКВозмещению
		|ГДЕ
		|	НДСКВозмещению.Регистратор = &Регистратор
		|;";
		
	КонецЕсли;
		
	Если ДополнительныеСвойства.ТаблицыДляДвижений.Свойство("НДСКВозмещению") 
		ИЛИ ДополнительныеСвойства.ТаблицыДляДвижений.Свойство("ТаблицаНДСКВозмещению") Тогда
		ТекстЗапроса  = ТекстЗапроса + "ВЫБРАТЬ
		|	ДанныеНДС.Период КАК Период,
		|	ДанныеНДС.Регистратор КАК Регистратор,
		|	ДанныеНДС.Организация КАК Организация,
		|	ДанныеНДС.ВидОперацииПоступления КАК ВидОперацииПоступления,
		|	ДанныеНДС.СтавкаНДС КАК СтавкаНДС,
		|	ДанныеНДС.Контрагент КАК Контрагент,
		|	ДанныеНДС.ВидОборота КАК ВидОборота,
		|	ЕСТЬNULL(ДанныеНДС.КорректируемыйПериод, ДатаВремя(1,1,1)) КАК КорректируемыйПериод,
		|	ДанныеНДС.СчетФактура КАК СчетФактура,
		|	ВЫБОР 
		|		КОГДА ДанныеНДС.ДоговорКонтрагента = НЕОПРЕДЕЛЕНО
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
		|		ИНАЧЕ ДанныеНДС.ДоговорКонтрагента
		|	КОНЕЦ КАК ДоговорКонтрагента,
		|	ДанныеНДС.НалоговыйПериод КАК НалоговыйПериод,
		|	ДанныеНДС.СуммаБезНДС КАК СуммаБезНДС,
		|	ДанныеНДС.УплаченныйНДС КАК УплаченныйНДС,
		|	ДанныеНДС.СуммаНДС КАК СуммаНДС,
		|	ДанныеНДС.ЗакупкаПодДеятельность КАК ЗакупкаПодДеятельность
		|ПОМЕСТИТЬ НДСКВозмещениюДвижения
		|ИЗ
		|	&НДСКВозмещению КАК ДанныеНДС
		|;";
		Если ДополнительныеСвойства.ТаблицыДляДвижений.Свойство("НДСКВозмещению") Тогда
			ТаблицаНДС = ДополнительныеСвойства.ТаблицыДляДвижений.НДСКВозмещению;
		Иначе
			ТаблицаНДС = ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаНДСКВозмещению;
		КонецЕсли;
		Запрос.УстановитьПараметр("НДСКВозмещению", ТаблицаНДС);
		
		Если ТаблицаНДС.Колонки.Найти("ДоговорКонтрагента") = Неопределено Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДанныеНДС.ДоговорКонтрагента", "ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)");
		КонецЕсли;
		Если ТаблицаНДС.Колонки.Найти("ЗакупкаПодДеятельность") = Неопределено Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДанныеНДС.ЗакупкаПодДеятельность", "ЗНАЧЕНИЕ(Перечисление.ТипыНалогообложенияНДС.ПустаяСсылка)");
		КонецЕсли;
	Иначе
		ТекстЗапроса  = ТекстЗапроса + "ВЫБРАТЬ
		|	ДанныеНДС.Период КАК Период,
		|	ДанныеНДС.Регистратор КАК Регистратор,
		|	ДанныеНДС.Организация КАК Организация,
		|	ДанныеНДС.ВидОперацииПоступления КАК ВидОперацииПоступления,
		|	ДанныеНДС.СтавкаНДС КАК СтавкаНДС,
		|	ДанныеНДС.Контрагент КАК Контрагент,
		|	ДанныеНДС.ВидОборота КАК ВидОборота,
		|	ЕСТЬNULL(ДанныеНДС.КорректируемыйПериод, ДатаВремя(1,1,1)) КАК КорректируемыйПериод,
		|	ДанныеНДС.СчетФактура КАК СчетФактура,
		|	ДанныеНДС.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	ДанныеНДС.НалоговыйПериод КАК НалоговыйПериод,
		|	ДанныеНДС.СуммаБезНДС КАК СуммаБезНДС,
		|	ДанныеНДС.УплаченныйНДС КАК УплаченныйНДС,
		|	ДанныеНДС.СуммаНДС КАК СуммаНДС,
		|	ДанныеНДС.ЗакупкаПодДеятельность КАК ЗакупкаПодДеятельность
		|ПОМЕСТИТЬ НДСКВозмещениюДвижения
		|ИЗ
		|	РегистрНакопления.НДСКВозмещению КАК ДанныеНДС
		|ГДЕ
		|	ДанныеНДС.Регистратор = &Регистратор
		|;";
	КонецЕсли;
	
	ТекстЗапроса  = ТекстЗапроса + "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НАЧАЛОПЕРИОДА(КОНЕЦПЕРИОДА(Таблица.Период, КВАРТАЛ), МЕСЯЦ) КАК Месяц,
	|	ЗНАЧЕНИЕ(Перечисление.ОперацииЗакрытияМесяца.РаспределениеНДС) КАК Операция,
	|	Таблица.Организация КАК Организация,
	|	Таблица.Регистратор КАК Документ
	|ПОМЕСТИТЬ НДСЗаданияКЗакрытиюМесяца
	|ИЗ
	|	(ВЫБРАТЬ
	|		НДС.Период КАК Период,
	|		НДС.Регистратор КАК Регистратор,
	|		НДС.Организация КАК Организация,
	|		НДС.ВидОперацииПоступления КАК ВидОперацииПоступления,
	|		НДС.СтавкаНДС КАК СтавкаНДС,
	|		НДС.Контрагент КАК Контрагент,
	|		НДС.ВидОборота КАК ВидОборота,
	|		ЕСТЬNULL(НДС.КорректируемыйПериод, ДАТАВРЕМЯ(1, 1, 1)) КАК КорректируемыйПериод,
	|		НДС.СчетФактура КАК СчетФактура,
	|		ВЫБОР
	|			КОГДА НДС.ДоговорКонтрагента = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
	|				ТОГДА НЕОПРЕДЕЛЕНО
	|			ИНАЧЕ НДС.ДоговорКонтрагента
	|		КОНЕЦ КАК ДоговорКонтрагента,
	|		НДС.НалоговыйПериод КАК НалоговыйПериод,
	|		НДС.СуммаБезНДС КАК СуммаБезНДС,
	|		НДС.УплаченныйНДС КАК УплаченныйНДС,
	|		НДС.СуммаНДС КАК СуммаНДС,
	|		НДС.ЗакупкаПодДеятельность КАК ЗакупкаПодДеятельность
	|	ИЗ
	|		НДСКВозмещениюПередЗаписью КАК НДС
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		НДСКВозмещениюДвижения.Период,
	|		НДСКВозмещениюДвижения.Регистратор,
	|		НДСКВозмещениюДвижения.Организация,
	|		НДСКВозмещениюДвижения.ВидОперацииПоступления,
	|		НДСКВозмещениюДвижения.СтавкаНДС,
	|		НДСКВозмещениюДвижения.Контрагент,
	|		НДСКВозмещениюДвижения.ВидОборота,
	|		ЕСТЬNULL(НДСКВозмещениюДвижения.КорректируемыйПериод, ДАТАВРЕМЯ(1, 1, 1)),
	|		НДСКВозмещениюДвижения.СчетФактура,
	|		ВЫБОР
	|			КОГДА НДСКВозмещениюДвижения.ДоговорКонтрагента = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
	|				ТОГДА НЕОПРЕДЕЛЕНО
	|			ИНАЧЕ НДСКВозмещениюДвижения.ДоговорКонтрагента
	|		КОНЕЦ,
	|		НДСКВозмещениюДвижения.НалоговыйПериод КАК НалоговыйПериод,
	|		-НДСКВозмещениюДвижения.СуммаБезНДС,
	|		-НДСКВозмещениюДвижения.УплаченныйНДС,
	|		-НДСКВозмещениюДвижения.СуммаНДС,
	|		НДСКВозмещениюДвижения.ЗакупкаПодДеятельность
	|	ИЗ
	|		НДСКВозмещениюДвижения КАК НДСКВозмещениюДвижения) КАК Таблица
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(КОНЕЦПЕРИОДА(Таблица.Период, КВАРТАЛ), МЕСЯЦ),
	|	Таблица.Период,
	|	Таблица.Регистратор,
	|	Таблица.Организация,
	|	Таблица.ВидОперацииПоступления,
	|	Таблица.СтавкаНДС,
	|	Таблица.Контрагент,
	|	Таблица.ВидОборота,
	|	Таблица.КорректируемыйПериод,
	|	Таблица.СчетФактура,
	|	Таблица.ДоговорКонтрагента,
	|	Таблица.НалоговыйПериод,
	|	Таблица.ЗакупкаПодДеятельность
	|
	|ИМЕЮЩИЕ
	|	(СУММА(Таблица.СуммаБезНДС) <> 0
	|		ИЛИ СУММА(Таблица.УплаченныйНДС) <> 0
	|		ИЛИ СУММА(Таблица.СуммаНДС) <> 0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ НДСКВозмещениюПередЗаписью";
		
	Попытка
		Запрос.Текст = ТекстЗапроса;
		Запрос.Выполнить();
		
		СтруктураВременныеТаблицы = ДополнительныеСвойства.ДляПроведения.СтруктураВременныеТаблицы;
		МенеджерВременныхТаблицДоЗаданийНДС = СтруктураВременныеТаблицы.МенеджерВременныхТаблиц;
		СтруктураВременныеТаблицы.МенеджерВременныхТаблиц = Запрос.МенеджерВременныхТаблиц;
		ПроведениеСерверУТ.СформироватьЗаписиРегистровЗаданий(Регистратор);
		
		СтруктураВременныеТаблицы.МенеджерВременныхТаблиц = МенеджерВременныхТаблицДоЗаданийНДС;
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Формирование задания к распределению НДС.'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Процедура ПередЗаписьюЗаданияКЗакрытиюМесяцаПередЗаписью(Источник, Отказ, Замещение) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = ОбменДаннымиСервер.ЭтоПодчиненныйУзелРИБ();
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Источник);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВТНаборЗаписей.Организация
	|ПОМЕСТИТЬ ВТОрганизации
	|ИЗ
	|	&НаборЗаписей КАК ВТНаборЗаписей
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Организации.Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТОрганизации.Организация
	|			ИЗ
	|				ВТОрганизации КАК ВТОрганизации)
	|	И Организации.ОбособленноеПодразделение = ИСТИНА";
	
	Запрос.УстановитьПараметр("НаборЗаписей", Источник.Выгрузить());
	
	УстановитьПривилегированныйРежим(Истина);
	
	МассивОбособленныхПодразделений = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Для НомерЗаписи = -Источник.Количество() + 1 По 0 Цикл
		
		Запись = Источник[-НомерЗаписи];
		
		Если (Запись.Операция = Перечисления.ОперацииЗакрытияМесяца.ПризнаниеРасходовПриУСН ИЛИ Запись.Операция = Перечисления.ОперацииЗакрытияМесяца.РасчетНалогаУСН) 
			ИЛИ (Запись.Операция = Перечисления.ОперацииЗакрытияМесяца.РаспределениеНДС И МассивОбособленныхПодразделений.Найти(Запись.Организация) <> Неопределено) Тогда
			Источник.Удалить(-НомерЗаписи);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры
//-- НЕ УТ

Процедура ДобавитьНастройку(НастройкиОтраженияНДС, ВидНДС, Налогообложение, СчетУчета) Экспорт
	
	ШаблонНастройки = "
	|	ВЫБРАТЬ
	|		ЗНАЧЕНИЕ(Перечисление.ТипыНалогообложенияНДС.ПустаяСсылка) КАК АналитикаУчета,
	|		ЗНАЧЕНИЕ(Перечисление.ВидыНДС.Товары)                	   КАК МестоУчета,
	|		ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.НДСНачисленныйПриПокупке)    КАК СчетУчета
	|
	|";
	ШаблонНастройки = СтрЗаменить(ШаблонНастройки, "ПустаяСсылка",          Налогообложение);
	ШаблонНастройки = СтрЗаменить(ШаблонНастройки, "Товары",                ВидНДС);
	ШаблонНастройки = СтрЗаменить(ШаблонНастройки, "НДСНачисленныйПриПокупке", СчетУчета);
	
	НастройкиОтраженияНДС.Добавить(ШаблонНастройки);
	
КонецПроцедуры

#КонецОбласти

