
Процедура АвтоматическийОбменEDI() Экспорт
		
	//Docrobot 1.19.0 MOD-1581 [+]
	Если Не Метаданные.Справочники.Найти("ДополнительныеОтчетыИОбработки") = Неопределено Тогда
		ВнешняяФорма = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоНаименованию("Docrobot: Интеграция EDI", Истина); 
		ДвоичныеДанные = ВнешняяФорма.ХранилищеОбработки.Получить();
	ИначеЕсли Не Метаданные.Справочники.Найти("ВнешниеОбработки") = Неопределено Тогда
		ВнешняяФорма = Справочники.ВнешниеОбработки.НайтиПоНаименованию("Docrobot: Интеграция EDI", Истина);
		ДвоичныеДанные = ВнешняяФорма.ХранилищеВнешнейОбработки.Получить();
	Иначе
		ВнешняяФорма = Неопределено;
	КонецЕсли;
	//Docrobot 1.19.0 MOD-1581 [-]
	
	Если ЗначениеЗаполнено(ВнешняяФорма) Тогда
		ИмяФайла = ПолучитьИмяВременногоФайла(); 
		
		ДвоичныеДанные.Записать(ИмяФайла); 
		
		ВнешняяОбработка = ВнешниеОбработки.Создать(ИмяФайла, Ложь);
		ВнешняяОбработка.АвтоматическийОбменEDI();
	Иначе
		Сообщить("Внешняя обработка - 'Docrobot: Интеграция EDI' не найдена!");
	КонецЕсли;
	
КонецПроцедуры

Процедура ЭКОМ_GLN_ОбновитьИлиСоздать(п_Объект, п_Структура)
	МЗ = РегистрыСведений.ЭКОМ_GLN.СоздатьМенеджерЗаписи();
	МЗ.Объект   = п_Объект;
    МЗ.Прочитать();
	
	Если НЕ МЗ.Выбран() Тогда
    		МЗ.Объект = п_Объект; 
	КонецЕсли; 
	
	Для Каждого Элемент Из п_Структура Цикл
			Если ЗначениеЗаполнено(Элемент.Значение) Тогда
				МЗ[Элемент.Ключ] = Элемент.Значение; 	
			КонецЕсли;	
	КонецЦикла;
		
	МЗ.Записать();	

КонецПроцедуры // ЭКОМ_GLN_ОбновитьИлиСоздать(п_Объект)

Процедура ЭКОМ_ТочкиДоставки_ОбновитьИлиСоздать(п_Объект, п_Структура)
