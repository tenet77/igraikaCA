			               |		ПО НалоговыеОрганы.ОсновноеСредство = ПервоначальнаяСтоимостьОСПоступившихСНачалаГода.Субконто1,
			               |	РегистрСведений.СтавкиНалогаНаИмущество.СрезПоследних(&КонецПериодаОтчета, Организация = &Организация) КАК СтавкиНалогаНаИмуществоСрезПоследних";

		КонецЕсли;	
		Результат = Запрос.Выполнить();
				
		Если Не Результат.Пустой() Тогда
			
			РасчетНалога = Результат.Выгрузить();
				
			Для Каждого СтрокаТаблицы Из РасчетНалога Цикл
				
				Если НЕ ГодовойРасчет И НЕ СтрокаТаблицы.УплачиваютсяАвансы Тогда
					Продолжить;
				КонецЕсли;
				
				Отбор = Новый Структура("ИФНС, ОсновноеСредство");
				
				Если ГодовойРасчет Тогда
					
					РасчетНалога1Кв = ТаблицаРасчетНалога.СкопироватьКолонки();
					РасчетНалога2Кв = ТаблицаРасчетНалога.СкопироватьКолонки();
					РасчетНалога3Кв = ТаблицаРасчетНалога.СкопироватьКолонки();
					РасчетНалога4Кв = ТаблицаРасчетНалога.СкопироватьКолонки();
					
					НайденнаяСтрока = РасчетНалога.Найти(Истина, "УплачиваютсяАвансы");
					Если НайденнаяСтрока <> Неопределено Тогда
						РасчетНалога1Кв = ПолучитьРасчетНалогаНаИмуществоЗаКвартал(Организация, Дата(Год(ПериодРасчета), 01, 31));
						РасчетНалога2Кв = ПолучитьРасчетНалогаНаИмуществоЗаКвартал(Организация, Дата(Год(ПериодРасчета), 04, 30));
						РасчетНалога3Кв = ПолучитьРасчетНалогаНаИмуществоЗаКвартал(Организация, Дата(Год(ПериодРасчета), 07, 31));
						РасчетНалога4Кв = ПолучитьРасчетНалогаНаИмуществоЗаКвартал(Организация, Дата(Год(ПериодРасчета), 10, 31));
					КонецЕсли;
					
				КонецЕсли;
				
				НоваяСтрока = ТаблицаРасчетНалога.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
				
				УчитыватьАвансы = ГодовойРасчет И СтрокаТаблицы.УплачиваютсяАвансы;
				
				ДоляСтоимости = 1;
				Если СтрокаТаблицы.ДоляСтоимостиЧислитель > 0 И СтрокаТаблицы.ДоляСтоимостиЗнаменатель > 0 Тогда
					ДоляСтоимости = СтрокаТаблицы.ДоляСтоимостиЧислитель / СтрокаТаблицы.ДоляСтоимостиЗнаменатель;
				КонецЕсли;
				
				Если ГодовойРасчет Тогда
					ДелимоеСредняяСтоимость = 0;
					ДелимоеНеоблагаемаяСредняяСтоимость = 0;
					
					Для Счетчик = 1 По Делитель Цикл
						
						Период = ?(Счетчик = 13, "3112", "01" + Формат(Счетчик, "ЧЦ=2; ЧВН="));
						НоваяСтрока["ОстаточнаяСтоимостьНа" + Период] = Окр(СтрокаТаблицы["ОстаточнаяСтоимостьНа" + Период]);
						ДелимоеСредняяСтоимость = ДелимоеСредняяСтоимость + СтрокаТаблицы["ОстаточнаяСтоимостьНа" + Период];
						
						Если СтрокаТаблицы.ОсвобождениеОтНалогообложения Тогда
							ДелимоеНеоблагаемаяСредняяСтоимость = ДелимоеНеоблагаемаяСредняяСтоимость + НоваяСтрока["ОстаточнаяСтоимостьНа" + Период];		
						КонецЕсли;
						
					КонецЦикла;
					
					НоваяСтрока.СредняяСтоимость = Окр(ДелимоеСредняяСтоимость / Делитель);
					НоваяСтрока.НеоблагаемаяСредняяСтоимость = Окр(ДелимоеНеоблагаемаяСредняяСтоимость / Делитель);
					
					СтоимостьОблагаемогоНалогомИмущества = Макс(НоваяСтрока.СредняяСтоимость - НоваяСтрока.НеоблагаемаяСредняяСтоимость, 0);
					
					НоваяСтрока.НалоговаяБаза = Окр(СтоимостьОблагаемогоНалогомИмущества * ДоляСтоимости);	
				
					НоваяСтрока.СуммаНалога = Окр(НоваяСтрока.НалоговаяБаза * СтрокаТаблицы.НалоговаяСтавка / 100);
				Иначе	
					ЧислоМесяцевВОтчетномПериоде = 13;
					КоличествоМесяцевПоступивших = СтрокаТаблицы.КоличествоМесяцевПоступивших;
					КоличествоМесяцевВыбывших = СтрокаТаблицы.КоличествоМесяцевВыбывших;
					КоличествоМесяцевПеремещения = СтрокаТаблицы.КоличествоМесяцевПеремещения;
					
					КоэффициентПоступивших = КоличествоМесяцевПоступивших / ЧислоМесяцевВОтчетномПериоде;
					КоэффициентВыбывших  = КоличествоМесяцевВыбывших / ЧислоМесяцевВОтчетномПериоде;
					
					//для перемещений по налоговым органам
					КоэффициентПеремещения = КоличествоМесяцевПеремещения / ЧислоМесяцевВОтчетномПериоде;
					
					Если СтрокаТаблицы.ПервоначальнаяСтоимостьПоступивших <> 0 Или СтрокаТаблицы.ИзменениеСтоимостиВыбывших <> 0 Или СтрокаТаблицы.СтоимостьПеремещения <> 0 Тогда
						
						//каждую составляющую рассчитываем по отдельности
						//н-р, если в отчетном периоде были и увеличения стоимости и уменьшения стоимости актива
						//то при расчете базы, к каждому из этих показателей применяем количество месяцев до конца НП, начиная с месяца изменения каждого из них
						СуммаНалогаПоступивших = Окр(СтрокаТаблицы.ПервоначальнаяСтоимостьПоступивших * КоэффициентПоступивших * ДоляСтоимости * СтрокаТаблицы.НалоговаяСтавка / 100);
						СуммаНалогаВыбывших = Окр(СтрокаТаблицы.ИзменениеСтоимостиВыбывших * КоэффициентВыбывших * ДоляСтоимости * СтрокаТаблицы.НалоговаяСтавка / 100);
						
						// стоимость перемещения (читай поступления) в налоговый орган
						// - показатель выделен отдельно, т.к. в одном отчетном периоде могут быть случаи когда
						// объект перемещен в данный налоговый орган, и в этом же периоде было произведено увеличение стоимости объекта
						// в этом случае для каждой базы применяем коэффициент исходя из количества месяцев в НП, начиная с месяца изменения каждого из этих показателей
						СуммаНалогаПеремещение = Окр(СтрокаТаблицы.СтоимостьПеремещения * КоэффициентПеремещения * ДоляСтоимости * СтрокаТаблицы.НалоговаяСтавка / 100);
						
						
						НоваяСтрока.СтоимостьПоступивших = СтрокаТаблицы.ПервоначальнаяСтоимостьПоступивших + СтрокаТаблицы.СтоимостьПеремещения;
						НоваяСтрока.СтоимостьВыбывших = СтрокаТаблицы.ИзменениеСтоимостиВыбывших;
						
						//пока запишем наибольшее значение количества месяцев владения
						НоваяСтрока.КоличествоМесяцевВладения = Макс(КоличествоМесяцевПоступивших, КоличествоМесяцевПеремещения); //пока запишем показатели в одной колонке
						НоваяСтрока.КоличествоМесяцевВладенияВыбывших = КоличествоМесяцевВыбывших;
						
						ОбщаяСумма = СуммаНалогаПоступивших + СуммаНалогаПеремещение - СуммаНалогаВыбывших;
					Иначе	
						ОбщаяСумма = 0;
					КонецЕсли;	
					НоваяСтрока.СуммаИзмененияНалога = ОбщаяСумма;
					
					НомерТекущегоКвартала = Цел((Месяц(мДатаКонцаПериодаОтчета) - 1) / 3) + 1;
					КоличествоОставшихсяПериодовПлатежа = 4 - НомерТекущегоКвартала + 1;	
					
					// сумму платежа за последний месяц считаем таким способом, чтобы избежать ошибок
					// округления
					СуммаВМесяц = Окр(ОбщаяСумма/КоличествоОставшихсяПериодовПлатежа);
					СуммаВПоследнийМесяц = Окр(ОбщаяСумма - (СуммаВМесяц*(КоличествоОставшихсяПериодовПлатежа - 1)));
					СуммаИзмененийТекКвартал = ?(НомерТекущегоКвартала = 4, СуммаВПоследнийМесяц, СуммаВМесяц);
					
					//Изменения налога в пред.периодах
					СуммаИзменений = 0;
					ЗаполнитьЗначенияСвойств(Отбор, СтрокаТаблицы);
					
					Если НомерТекущегоКвартала > 1 Тогда
						Для НомерКвартала = 1 По НомерТекущегоКвартала-1 Цикл
							
							ПериодКвартал = ДобавитьМесяц(Дата(Год(ПериодРасчета), 01, 31), ?(НомерКвартала <> 1, (НомерКвартала-1)*3, 0));
							РасчетПоКварталу = ПолучитьРасчетНалогаНаИмуществоЗаКвартал(Организация, ПериодКвартал);
							
							СтрокиРасчетаАвансовыхПлатежей = РасчетПоКварталу.НайтиСтроки(Отбор);
							
							СуммаИзмененияНалога = 0;
							Для Каждого СтрокаРасчетаАвансовыхПлатежей Из СтрокиРасчетаАвансовыхПлатежей Цикл
								
								НомерКварталаРасчет = Цел((Месяц(ПериодКвартал) - 1) / 3) + 1;
								КоличествоОставшихсяПериодовПлатежа = 4 - НомерКварталаРасчет + 1;	
					
								СуммаВМесяц = Окр(СтрокаРасчетаАвансовыхПлатежей.СуммаИзмененияНалога/КоличествоОставшихсяПериодовПлатежа);
								СуммаВПоследнийМесяц = Окр(СтрокаРасчетаАвансовыхПлатежей.СуммаИзмененияНалога - (СуммаВМесяц*(КоличествоОставшихсяПериодовПлатежа - 1)));
								СуммаИзмененияНалога = ?(НомерТекущегоКвартала = 4, СуммаВПоследнийМесяц, СуммаВМесяц);
							
							КонецЦикла;
							СуммаИзменений = СуммаИзменений + СуммаИзмененияНалога;
							
						КонецЦикла;
					КонецЕсли;				
					
					//найдем размер текущего платежа, рассчитанный для текущего квартала, по состоянию на начало года
					//налоговой базой считается балансовая стоимость на начало года,
					СуммаНаНачалоГода = СтрокаТаблицы.БалансоваяСтоимостьНаНачалоГода * ДоляСтоимости * СтрокаТаблицы.НалоговаяСтавка / 100;
					СуммаВМесяц = Окр(СуммаНаНачалоГода/4);
					СуммаВПоследнийМесяц = Окр(СуммаНаНачалоГода - (СуммаВМесяц*(4 - 1)));
					ТекПлатежНаНачалоГода = ?(НомерТекущегоКвартала = 4, СуммаВПоследнийМесяц, СуммаВМесяц);
					
					ИтоговаяСуммаНалога = ТекПлатежНаНачалоГода + СуммаИзменений + СуммаИзмененийТекКвартал;
					
					НоваяСтрока.СуммаНалога = ИтоговаяСуммаНалога;
				
				КонецЕсли;
				
				НоваяСтрока.СуммаНалогаКУплате = НоваяСтрока.СуммаНалога;
				
				Если ГодовойРасчет И СтрокаТаблицы.УплачиваютсяАвансы Тогда
				
					ЗаполнитьЗначенияСвойств(Отбор, НоваяСтрока);
					
					СуммаАвансовыхПлатежей1Кв = 0;
					СтрокиРасчетаАвансовыхПлатежей = РасчетНалога1Кв.НайтиСтроки(Отбор);
					Для Каждого СтрокаРасчетаАвансовыхПлатежей Из СтрокиРасчетаАвансовыхПлатежей Цикл
						СуммаАвансовыхПлатежей1Кв = СуммаАвансовыхПлатежей1Кв
							+ СтрокаРасчетаАвансовыхПлатежей.СуммаНалогаКУплате;
					КонецЦикла;
					
					СуммаАвансовыхПлатежей2Кв = 0;
					СтрокиРасчетаАвансовыхПлатежей = РасчетНалога2Кв.НайтиСтроки(Отбор);
					Для Каждого СтрокаРасчетаАвансовыхПлатежей Из СтрокиРасчетаАвансовыхПлатежей Цикл
						СуммаАвансовыхПлатежей2Кв = СуммаАвансовыхПлатежей2Кв
							+ СтрокаРасчетаАвансовыхПлатежей.СуммаНалогаКУплате;
					КонецЦикла;
					
					СуммаАвансовыхПлатежей3Кв = 0;
					СтрокиРасчетаАвансовыхПлатежей = РасчетНалога3Кв.НайтиСтроки(Отбор);
					Для Каждого СтрокаРасчетаАвансовыхПлатежей Из СтрокиРасчетаАвансовыхПлатежей Цикл
						СуммаАвансовыхПлатежей3Кв = СуммаАвансовыхПлатежей3Кв
						+ СтрокаРасчетаАвансовыхПлатежей.СуммаНалогаКУплате;
					КонецЦикла;
					
					СуммаАвансовыхПлатежей4Кв = 0;
					СтрокиРасчетаАвансовыхПлатежей = РасчетНалога4Кв.НайтиСтроки(Отбор);
					Для Каждого СтрокаРасчетаАвансовыхПлатежей Из СтрокиРасчетаАвансовыхПлатежей Цикл
						СуммаАвансовыхПлатежей4Кв = СуммаАвансовыхПлатежей4Кв
						+ СтрокаРасчетаАвансовыхПлатежей.СуммаНалогаКУплате;
					КонецЦикла;

					
					СуммаАвансовыхПлатежей = СуммаАвансовыхПлатежей1Кв + СуммаАвансовыхПлатежей2Кв + СуммаАвансовыхПлатежей3Кв + СуммаАвансовыхПлатежей4Кв;
					НоваяСтрока.СуммаАвансовыхПлатежей = СуммаАвансовыхПлатежей;
					
					НоваяСтрока.СуммаНалогаКУплате = НоваяСтрока.СуммаНалогаКУплате - СуммаАвансовыхПлатежей;						
					
				Иначе
					НоваяСтрока.СуммаНалогаКУплате = НоваяСтрока.СуммаНалога;
					НоваяСтрока.СуммаАвансовыхПлатежей = НоваяСтрока.СуммаНалога;
				КонецЕсли;	
				
			КонецЦикла;
			
		КонецЕсли;
			
	КонецЕсли;
	
	ТаблицаРасчетНалога.ЗаполнитьЗначения(мДатаКонцаПериодаОтчета, "ПериодРасчета");
	ТаблицаРасчетНалога.ЗаполнитьЗначения(Организация, "Организация");
	
	Возврат ТаблицаРасчетНалога;
	
КонецФункции

#КонецОбласти
