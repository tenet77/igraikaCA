	|	РегистрацияТранспортныхСредств.СуммаУменьшения,
	|	РегистрацияТранспортныхСредств.ЭкологическийКласс,
	|	РегистрацияТранспортныхСредств.ДоляВПравеОбщейСобственностиЧислитель,
	|	РегистрацияТранспортныхСредств.ДоляВПравеОбщейСобственностиЗнаменатель,
	|	РегистрацияТранспортныхСредств.ПовышающийКоэффициент,
	|	РегистрацияТранспортныхСредств.НалоговаяСтавкаЗависитОтГодаВыпускаТС,
	|	РегистрацияТранспортныхСредств.ЭксплуатацияВРКдо1апреля1999г,
	|	РегистрацияТранспортныхСредств.СтранаПроизводитель,
	|	РегистрацияТранспортныхСредств.ДатаВвозаНаТерриториюРК,
	|	ВЫБОР
	|		КОГДА ВТ_НалоговыеОрганыСУстановленнойУплатойАвансов.НалоговыйОрган ЕСТЬ NULL 
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ,
	|	ОсновныеСредства.ДатаВыпуска,
	|	ВТ_ДатыПостановкиИСнятия.ПериодПервоначальнойРегистрации,
	|	ВТ_ДатыПостановкиИСнятия.ПериодСнятияСУчета
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИФНС,
	|	КодПоОКТМО,
	|	ОсновноеСредство";
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		
		РасчетТранспортногоНалога = Результат.Выгрузить();
		
		МРП = РегистрыСведений.МесячныйРасчетныйПоказатель.ПолучитьПоследнее(ДатаНачалаПериодаОтчета);
		ВеличинаМРП = ?(МРП = Неопределено, 0, МРП.Размер);
		
		Если ГодовойРасчет Тогда
			
			РасчетНалога2Кв = ТаблицаРасчетТранспортногоНалога.СкопироватьКолонки();
			
			Отбор = Новый Структура("ИФНС, КодПоОКТМО, ОсновноеСредство, ДатаРегистрационныхДанных");
			
			НайденнаяСтрока = РасчетТранспортногоНалога.Найти(Истина, "УплачиваютсяАвансы");
			Если НайденнаяСтрока <> Неопределено Тогда
				РасчетНалога2Кв = ПолучитьРасчетПоТранспортномуНалогуРК(Организация, Дата(Год(ПериодРасчета), 06, 30)).Налог;
			КонецЕсли;
			
		КонецЕсли;
		
		Для Каждого СтрокаРасчета Из РасчетТранспортногоНалога Цикл
			
			Если НЕ ГодовойРасчет И НЕ СтрокаРасчета.УплачиваютсяАвансы Тогда
				Продолжить;
			КонецЕсли;
			
			Если Не СтрокаРасчета.КодВидаТранспортногоСредства = Null И Не СтрокаРасчета.КодВидаТранспортногоСредства.Пустая() Тогда
				
				Если СтрокаРасчета.ДоляВПравеОбщейСобственностиЧислитель <> 0 И СтрокаРасчета.ДоляВПравеОбщейСобственностиЗнаменатель <> 0 Тогда
					ДоляВПравеОбщейСобственности = 
						Мин(1, СтрокаРасчета.ДоляВПравеОбщейСобственностиЧислитель / СтрокаРасчета.ДоляВПравеОбщейСобственностиЗнаменатель);
				Иначе
					ДоляВПравеОбщейСобственности = 1;
				КонецЕсли;
				
				НоваяСтрока = ТаблицаРасчетТранспортногоНалога.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРасчета);
					
				// Базовая ставка Налога
				ТаблицаСтавокНалога = Неопределено;				 
				СуммаНалога 		= 0;
				СтавкаНалога 		= 0;
				Префикс 			= "";
				
				МетаданныеЗначенияПеречисления = Метаданные.Перечисления["ВидыТранспортныхСредств"].ЗначенияПеречисления[Перечисления.ВидыТранспортныхСредств.Индекс(СтрокаРасчета.КодВидаТранспортногоСредства)];
				ВидТранспортногоСредстваСтрока = СокрЛП(МетаданныеЗначенияПеречисления.Имя);
				
				Если СтрокаРасчета.КодВидаТранспортногоСредства = Перечисления.ВидыТранспортныхСредств.Мотоцикл Тогда				
					// У мотоцикла мощность в лошадиных силах и мощность в киловаттах хранится в ресурсе МощностьВКиловаттах.				
					Если СтрокаРасчета.ЕдиницаИзмерения = "251" Тогда // Лошадиные силы
						ВидТранспортногоСредстваДляШкалыНалога = "МотоциклЛошадиныеСилы";		
					Иначе
						ВидТранспортногоСредстваДляШкалыНалога = "МотоциклКиловатты";
					КонецЕсли;
					
					Если НЕ СтруктураСтавокНалога.Свойство(ВидТранспортногоСредстваДляШкалыНалога) Тогда
						ВидТранспортногоСредстваДляШкалыНалога = ВидТранспортногоСредстваСтрока;
					КонецЕсли;
				
				Иначе
					ВидТранспортногоСредстваДляШкалыНалога = ВидТранспортногоСредстваСтрока;	
				КонецЕсли;  				
				
				// Для легковых автомобилей применяется разная шкала в зависимости от даты и места производства
				Если СтрокаРасчета.КодВидаТранспортногоСредства = Перечисления.ВидыТранспортныхСредств.ЛегковойАвтомобиль Тогда 
					// Для легковых автомобилей с объемом двигателя свыше 3000 кубических сантиметров,
					// произведенных (изготовленных или собранных) в Республике Казахстан после 31 декабря 2013 года
					// или ввезенных на территорию Республики Казахстан после 31 декабря 2013 года, исчисление налога
					// производится по следующим ставкам, установленным в месячных расчетных показателях...
					// см. п. 1. ст. 367 НК РК
					Если СтрокаРасчета.СтранаПроизводитель = Справочники.СтраныМира.Казахстан Или СтрокаРасчета.СтранаПроизводитель.Код = "398" Тогда
						// анализируется дата выпуска
						Если СтрокаРасчета.ДатаВыпуска >= Дата(2014,1,1) Тогда
							Префикс = "После2013";
						Иначе
							Префикс = "До2013";
						КонецЕсли;       					
					Иначе
						// анализируется дата ввоза в РК
						Если СтрокаРасчета.ДатаВвозаНаТерриториюРК >= Дата(2014,1,1) Тогда
							Префикс = "После2013";
						Иначе
							Префикс = "До2013";
						КонецЕсли;       										
					КонецЕсли;
						
					ВидТранспортногоСредстваДляШкалыНалога = ВидТранспортногоСредстваСтрока + Префикс;
				КонецЕсли;
				
				Если СтруктураСтавокНалога.Свойство(ВидТранспортногоСредстваДляШкалыНалога, ТаблицаСтавокНалога) Тогда				 	
					СтавкаНалога = ПолучитьСтавкуНалогаНаТранспортДляОбъекта(ТаблицаСтавокНалога, СтрокаРасчета.НалоговаяБаза);
					
					НоваяСтрока.НалоговаяСтавка = СтавкаНалога;
					
					Если СтрокаРасчета.КодВидаТранспортногоСредства = Перечисления.ВидыТранспортныхСредств.ЛетательныйАппарат
						Или СтрокаРасчета.КодВидаТранспортногоСредства = Перечисления.ВидыТранспортныхСредств.ЖелезнодорожныйТяговыйПодвижнойСостав
						Или СтрокаРасчета.КодВидаТранспортногоСредства = Перечисления.ВидыТранспортныхСредств.МотороВагонныйПодвижнойСостав Тогда
						СуммаНалога = СтавкаНалога * СтрокаРасчета.НалоговаяБаза * ВеличинаМРП;
					Иначе
						СуммаНалога = СтавкаНалога * ВеличинаМРП;						 
					КонецЕсли;
					
				КонецЕсли;
				
				// Для легковых автомобилей рассчитываем размер превышения
				СуммаПревышения = 0;
				Если СтрокаРасчета.КодВидаТранспортногоСредства = Перечисления.ВидыТранспортныхСредств.ЛегковойАвтомобиль Тогда
					
					РазмерПревышения = ПолучитьРазмерПревышенияПоОбъему(СтрокаРасчета.КодВидаТранспортногоСредства, СтрокаРасчета.НалоговаяБаза, СтруктураСтавокНалога, Префикс);
					СуммаПревышения = РазмерПревышения*7;						
					
				КонецЕсли;
				
				ОбщаяСуммаНалога = СуммаНалога + СуммаПревышения;
				РазмерКорректировки = ПолучитьРазмерКорректировки(СтрокаРасчета.КодВидаТранспортногоСредства, СтрокаРасчета.ЭксплуатацияВРКдо1апреля1999г, СтрокаРасчета.ДатаВыпуска, СтруктураСтавокНалога, ДатаКонцаПериодаОтчета);
				
				СуммаСУчетомКорректировки = ОбщаяСуммаНалога * РазмерКорректировки;
					
				ОбщаяСуммаНалога = Окр(СуммаСУчетомКорректировки * СтрокаРасчета.КоличествоМесяцевВладения/12,0);
							
				НоваяСтрока.СуммаНалога = ОбщаяСуммаНалога * ДоляВПравеОбщейСобственности;
				НоваяСтрока.СуммаНалогаКУплате = НоваяСтрока.СуммаНалога;
				
				Если ГодовойРасчет И СтрокаРасчета.УплачиваютсяАвансы Тогда
					
					ЗаполнитьЗначенияСвойств(Отбор, НоваяСтрока);
					
					НоваяСтрока.СуммаАвансовыхПлатежей2Кв = 0;
					СтрокиРасчетаАвансовыхПлатежей = РасчетНалога2Кв.НайтиСтроки(Отбор);
					Для Каждого СтрокаРасчетаАвансовыхПлатежей Из СтрокиРасчетаАвансовыхПлатежей Цикл
						НоваяСтрока.СуммаАвансовыхПлатежей2Кв = НоваяСтрока.СуммаАвансовыхПлатежей2Кв
							+ СтрокаРасчетаАвансовыхПлатежей.СуммаНалогаКУплате;
					КонецЦикла;
					НоваяСтрока.СуммаНалогаКУплате = НоваяСтрока.СуммаНалогаКУплате - НоваяСтрока.СуммаАвансовыхПлатежей2Кв;
					
				КонецЕсли;

				Если НЕ ГодовойРасчет Тогда
					НоваяСтрока["СуммаАвансовыхПлатежей" + Формат(ПериодРасчета, "ДФ='q''Кв'''")] = НоваяСтрока.СуммаНалогаКУплате;
				КонецЕсли;
				
			КонецЕсли;	
			
		КонецЦикла;
		
	КонецЕсли;
	
	ТаблицаРасчетТранспортногоНалога.ЗаполнитьЗначения(ДатаКонцаПериодаОтчета, "ПериодРасчета");
	ТаблицаРасчетТранспортногоНалога.ЗаполнитьЗначения(Организация, "Организация");
	
	ТаблицаРасходыНаПлатон = РасчетИмущественныхНалоговПереопределяемый.ПолучитьРасходыНаПлатон(
		Организация, ПериодРасчета, ТаблицаРасчетТранспортногоНалога);
	
	Возврат Новый Структура("Налог, Платон", ТаблицаРасчетТранспортногоНалога, ТаблицаРасходыНаПлатон);

КонецФункции

#КонецОбласти

#Область ЗемельныйНалог

// Возвращает дату начала отчетного периода, исходя из номера отчетного квартала
//
// Параметры:
//  ПериодРасчета - Дата - период расчета текущего платежа по налогу
//
// Возвращаемое значение:
//  ДатаНачала - Дата - дата начала периода расчета текущего платежа
//
Функция ПолучитьДатуНачала(ПериодРасчета)
	// первый квартал
	Если Месяц(НачалоКвартала(ПериодРасчета)) = 1 Тогда
		ДатаНачала = НачалоКвартала(ПериодРасчета);
	КонецЕсли;
	// второй квартал
	Если Месяц(НачалоКвартала(ПериодРасчета)) = 4 Тогда
		ДатаНачала = Дата(Год(ПериодРасчета),2,1);
	КонецЕсли;
	// третий квартал
	Если Месяц(НачалоКвартала(ПериодРасчета)) = 7 Тогда
		ДатаНачала = Дата(Год(ПериодРасчета),5,1);
	КонецЕсли;
	// четвертый квартал
	Если Месяц(НачалоКвартала(ПериодРасчета)) = 10 Тогда
		ДатаНачала = Дата(Год(ПериодРасчета),8,1);
	КонецЕсли;
	
	Возврат ДатаНачала;
	
КонецФункции // ПолучитьДатуНачала

// Возвращает дату окончания отчетного периода, исходя из номера отчетного квартала
//
// Параметры:
//  ПериодРасчета - Дата, период расчета текущего платежа по налогу
//
// Возвращаемое значение:
//  ДатаОкончания - Дата - дата начала периода расчета текущего платежа
//
Функция ПолучитьДатуОкончания(ПериодРасчета)
	
	ДатаОкончания = КонецМесяца(ПериодРасчета);
	
	Возврат ДатаОкончания;
	
КонецФункции // ПолучитьДатуОкончания

// Возвращает расчет земельного налога за квартал
//
// Параметры:
//  Организация - СправочникСсылка.Организации - организация, по которому нужно получить расчет
//  ПериодРасчета - Дата - период, для которого нужно получить расчет (конец января, апреля, июля, октярбя и декабря)
//
// Возвращаемое значение:
//  ТаблицаРасчета - ТаблицаЗначений - таблица, содержащая данные по расчету за указанный квартал
//
Функция ПолучитьРасчетЗемельногоНалогаЗаКвартал(Организация, ПериодРасчета)

	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	РасчетЗемельногоНалога.ПериодРасчета,
	               |	РасчетЗемельногоНалога.Организация,
	               |	РасчетЗемельногоНалога.ИФНС,
	               |	РасчетЗемельногоНалога.ОсновноеСредство,
				   |	РасчетЗемельногоНалога.СуммаАвансовыхПлатежей1Кв,
				   |	РасчетЗемельногоНалога.СуммаАвансовыхПлатежей2Кв,
				   |	РасчетЗемельногоНалога.СуммаАвансовыхПлатежей3Кв,
				   |	РасчетЗемельногоНалога.СуммаАвансовыхПлатежей4Кв,
	               |	РасчетЗемельногоНалога.СуммаИзмененияНалога
	               |ИЗ
	               |	РегистрСведений.РасчетЗемельногоНалога КАК РасчетЗемельногоНалога
	               |ГДЕ
	               |	РасчетЗемельногоНалога.Организация = &Организация
	               |	И РасчетЗемельногоНалога.ПериодРасчета = &ПериодРасчета";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ПериодРасчета", ПериодРасчета);
	
	ТаблицаРасчета = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаРасчета;
	
КонецФункции
 
// Возвращает результат расчета земельного налога (или аванса по налогу)
//
// Параметры:
// 	Организация - СправочникСсылка.Организации - Организация, для которой необходимо выполнить расчет
// 	Период - Дата - Дата закрытия месяца
//
// Возвращаемое значение:
// 	ТаблицаРасчетНалога - ТаблицаЗначений - Результат расчета земельного налога
//
Функция ПолучитьРасчетПоЗемельномуНалогуРК(Организация, ПериодРасчета) Экспорт
	
	РеквизитыОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Организация, "РегистрацияВНалоговомОргане");
	
	ГодовойРасчет = КонецМесяца(ПериодРасчета) = КонецГода(ПериодРасчета);
	
	ДатаНачалаПериодаОтчета = ?(ГодовойРасчет,	НачалоГода(ПериодРасчета),	ПолучитьДатуНачала(ПериодРасчета));
	ДатаКонцаПериодаОтчета = ?(ГодовойРасчет, КонецГода(ПериодРасчета), ПолучитьДатуОкончания(ПериодРасчета));
		
	ТаблицаРасчетНалога = РасчетИмущественныхНалогов.ПустаяСправкаРасчет("РасчетЗемельногоНалога");
	
	ЭтоНеЮрЛицо = НЕ ОбщегоНазначенияБПВызовСервераПовтИсп.ЭтоЮрЛицо(Организация);
	
	Если Не (Месяц(ПериодРасчета) = 1 ИЛИ Месяц(ПериодРасчета) = 4 Или Месяц(ПериодРасчета) = 7 Или Месяц(ПериодРасчета) = 10 Или Месяц(ПериодРасчета) = 12)
		Или ЭтоНеЮрЛицо Тогда
		
		Возврат ТаблицаРасчетНалога;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаКонцаПериодаОтчета", ДатаКонцаПериодаОтчета);
	Запрос.УстановитьПараметр("ОсновнойНалоговыйОрган", РеквизитыОрганизации.РегистрацияВНалоговомОргане);
	Запрос.УстановитьПараметр("Период", КонецГода(ПериодРасчета));
	Запрос.УстановитьПараметр("НачалоГода", НачалоГода(ПериодРасчета));
	Запрос.УстановитьПараметр("ГраницаНачалоГода", Новый Граница(НачалоГода(ПериодРасчета), ВидГраницы.Исключая));
		
	Период = ДатаНачалаПериодаОтчета;
	
	ТекстОбъединяющегоЗапроса = "";
	
	Пока Период <= ДатаКонцаПериодаОтчета Цикл
		
		Запрос.УстановитьПараметр("НачалоМесяца", НачалоМесяца(Период));
