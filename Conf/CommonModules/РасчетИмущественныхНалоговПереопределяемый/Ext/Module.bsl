			РасчетНалога1Кв = ТаблицаРасчетНалога.СкопироватьКолонки();
			РасчетНалога2Кв = ТаблицаРасчетНалога.СкопироватьКолонки();
			РасчетНалога3Кв = ТаблицаРасчетНалога.СкопироватьКолонки();
			РасчетНалога4Кв = ТаблицаРасчетНалога.СкопироватьКолонки();
			
			НайденнаяСтрока = РасчетЗемельногоНалога.Найти(Истина, "УплачиваютсяАвансы");
			Если НайденнаяСтрока <> Неопределено Тогда
				РасчетНалога1Кв = ПолучитьРасчетПоЗемельномуНалогуРК(Организация, Дата(Год(ПериодРасчета), 01, 31));
				РасчетНалога2Кв = ПолучитьРасчетПоЗемельномуНалогуРК(Организация, Дата(Год(ПериодРасчета), 04, 30));
				РасчетНалога3Кв = ПолучитьРасчетПоЗемельномуНалогуРК(Организация, Дата(Год(ПериодРасчета), 07, 31));
				РасчетНалога4Кв = ПолучитьРасчетПоЗемельномуНалогуРК(Организация, Дата(Год(ПериодРасчета), 10, 31));
			КонецЕсли;
			
		КонецЕсли;
		
		Для Каждого СтрокаРасчета Из РасчетЗемельногоНалога Цикл
			
			Если НЕ ГодовойРасчет И НЕ СтрокаРасчета.УплачиваютсяАвансы Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ТаблицаРасчетНалога.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРасчета);
			
			ЧислоМесяцевВОтчетномПериоде = 12;
			
			Если НоваяСтрока.ДоляВПравеОбщейСобственностиЧислитель <> 0 И НоваяСтрока.ДоляВПравеОбщейСобственностиЗнаменатель <> 0 Тогда
				ДоляВПравеОбщейСобственности = 
					Мин(1, НоваяСтрока.ДоляВПравеОбщейСобственностиЧислитель / НоваяСтрока.ДоляВПравеОбщейСобственностиЗнаменатель);
			Иначе
				ДоляВПравеОбщейСобственности = 1;
			КонецЕсли;
			
			//Расчет налоговой базы
			НоваяСтрока.НалоговаяБаза = СтрокаРасчета.ПлощадьОблагаемая;
						
			//Коэффициент Кв определяется как отношение числа полных месяцев, 
			//в течение которых данный земельный участок находился в собственности
			//налогоплательщика к числу календарных месяцев в налоговом периоде.
			
			КоэффициентКв = НоваяСтрока.КоличествоМесяцевВладения / ЧислоМесяцевВОтчетномПериоде;
			
			Если ГодовойРасчет Тогда
				НоваяСтрока.СуммаНалога = Окр(НоваяСтрока.НалоговаяБаза * СтрокаРасчета.СтавкаНалогаСУчетомКорректировки * КоэффициентКв * ДоляВПравеОбщейСобственности);
			Иначе 
				//ОбщаяСумма - величина изменений налогового обязательства
				Если СтрокаРасчета.СуммаИзмененийНалога = 0 Тогда
					ОбщаяСумма = 0;
				Иначе	
					ОбщаяСумма = Окр(СтрокаРасчета.СуммаИзмененийНалога * КоэффициентКв);
				КонецЕсли;	
				
				НоваяСтрока.СуммаИзмененияНалога = ОбщаяСумма;
				
				НомерТекущегоКвартала = Цел((Месяц(ДатаКонцаПериодаОтчета) - 1) / 3) + 1;
				КоличествоОставшихсяПериодовПлатежа = 4 - НомерТекущегоКвартала + 1;	
				
				// сумму платежа за последний месяц считаем таким способом, чтобы избежать ошибок
				// округления
				СуммаВМесяц = Окр(ОбщаяСумма/КоличествоОставшихсяПериодовПлатежа);
				СуммаВПоследнийМесяц = Окр(ОбщаяСумма - (СуммаВМесяц*(КоличествоОставшихсяПериодовПлатежа - 1)));
				СуммаИзмененийТекКвартал = ?(НомерТекущегоКвартала = 4, СуммаВПоследнийМесяц, СуммаВМесяц);
				
				//Изменения налога в пред.периодах
				СуммаИзменений = 0;
				ЗаполнитьЗначенияСвойств(Отбор, НоваяСтрока);
				
				//округлим площадь до 2-х знаков после запятой
				НоваяСтрока.ПлощадьОблагаемая 	= Окр(СтрокаРасчета.ПлощадьОблагаемая, 2);
				НоваяСтрока.ПлощадьНеОблагаемая = Окр(СтрокаРасчета.ПлощадьНеОблагаемая, 2);
				
				Если НомерТекущегоКвартала > 1 Тогда
					Для НомерКвартала = 1 По НомерТекущегоКвартала-1 Цикл
						
						ПериодКвартал = ДобавитьМесяц(Дата(Год(ПериодРасчета), 01, 31), ?(НомерКвартала <> 1, (НомерКвартала-1)*3, 0));
						РасчетПоКварталу = ПолучитьРасчетЗемельногоНалогаЗаКвартал(Организация, ПериодКвартал);
						
						СтрокиРасчетаАвансовыхПлатежей = РасчетПоКварталу.НайтиСтроки(Отбор);
						
						СуммаИзмененияНалога = 0;
						Для Каждого СтрокаРасчетаАвансовыхПлатежей Из СтрокиРасчетаАвансовыхПлатежей Цикл
							
							НомерКвартала = Цел((Месяц(ПериодКвартал) - 1) / 3) + 1;
							КоличествоОставшихсяПериодовПлатежа = 4 - НомерКвартала + 1;	
				
							СуммаВМесяц = Окр(СтрокаРасчетаАвансовыхПлатежей.СуммаИзмененияНалога/КоличествоОставшихсяПериодовПлатежа);
							СуммаВПоследнийМесяц = Окр(СтрокаРасчетаАвансовыхПлатежей.СуммаИзмененияНалога - (СуммаВМесяц*(КоличествоОставшихсяПериодовПлатежа - 1)));
							СуммаИзмененияНалога = ?(НомерКвартала = 4, СуммаВПоследнийМесяц, СуммаВМесяц);
							
						КонецЦикла;
						
						СуммаИзменений = СуммаИзменений + СуммаИзмененияНалога;
					КонецЦикла;
				КонецЕсли;				
				
				//найдем размер текущего платежа, рассчитанный для текущего квартала, по состоянию на начало года
				СуммаНаНачалоГода = СтрокаРасчета.СуммаЗемельногоНалогаНаНачалоГода;
				СуммаВМесяц = Окр(СуммаНаНачалоГода/4);
				СуммаВПоследнийМесяц = Окр(СуммаНаНачалоГода - (СуммаВМесяц*(4 - 1)));
				ТекПлатежНаНачалоГода = ?(НомерТекущегоКвартала = 4, СуммаВПоследнийМесяц, СуммаВМесяц);
				
				ИтоговаяСуммаНалога = ТекПлатежНаНачалоГода + СуммаИзменений + СуммаИзмененийТекКвартал;
				
				НоваяСтрока.СуммаНалога = ИтоговаяСуммаНалога;
			КонецЕсли;
			
			//Расчет суммы налога к уплате
			НоваяСтрока.СуммаНалогаКУплате = НоваяСтрока.СуммаНалога;
						
			Если ГодовойРасчет И СтрокаРасчета.УплачиваютсяАвансы Тогда
				
				ЗаполнитьЗначенияСвойств(Отбор, НоваяСтрока);
				
				НоваяСтрока.СуммаАвансовыхПлатежей1Кв = 0;
				СтрокиРасчетаАвансовыхПлатежей = РасчетНалога1Кв.НайтиСтроки(Отбор);
				Для Каждого СтрокаРасчетаАвансовыхПлатежей Из СтрокиРасчетаАвансовыхПлатежей Цикл
					НоваяСтрока.СуммаАвансовыхПлатежей1Кв = НоваяСтрока.СуммаАвансовыхПлатежей1Кв
						+ СтрокаРасчетаАвансовыхПлатежей.СуммаНалогаКУплате;
				КонецЦикла;
				
				НоваяСтрока.СуммаАвансовыхПлатежей2Кв = 0;
				СтрокиРасчетаАвансовыхПлатежей = РасчетНалога2Кв.НайтиСтроки(Отбор);
				Для Каждого СтрокаРасчетаАвансовыхПлатежей Из СтрокиРасчетаАвансовыхПлатежей Цикл
					НоваяСтрока.СуммаАвансовыхПлатежей2Кв = НоваяСтрока.СуммаАвансовыхПлатежей2Кв
						+ СтрокаРасчетаАвансовыхПлатежей.СуммаНалогаКУплате;
				КонецЦикла;
				
				НоваяСтрока.СуммаАвансовыхПлатежей3Кв = 0;
				СтрокиРасчетаАвансовыхПлатежей = РасчетНалога3Кв.НайтиСтроки(Отбор);
				Для Каждого СтрокаРасчетаАвансовыхПлатежей Из СтрокиРасчетаАвансовыхПлатежей Цикл
					НоваяСтрока.СуммаАвансовыхПлатежей3Кв = НоваяСтрока.СуммаАвансовыхПлатежей3Кв
					+ СтрокаРасчетаАвансовыхПлатежей.СуммаНалогаКУплате;
				КонецЦикла;
				
				НоваяСтрока.СуммаАвансовыхПлатежей4Кв = 0;
				СтрокиРасчетаАвансовыхПлатежей = РасчетНалога4Кв.НайтиСтроки(Отбор);
				Для Каждого СтрокаРасчетаАвансовыхПлатежей Из СтрокиРасчетаАвансовыхПлатежей Цикл
					НоваяСтрока.СуммаАвансовыхПлатежей4Кв = НоваяСтрока.СуммаАвансовыхПлатежей4Кв
					+ СтрокаРасчетаАвансовыхПлатежей.СуммаНалогаКУплате;
				КонецЦикла;

				
				НоваяСтрока.СуммаНалогаКУплате = НоваяСтрока.СуммаНалогаКУплате - НоваяСтрока.СуммаАвансовыхПлатежей1Кв
					- НоваяСтрока.СуммаАвансовыхПлатежей2Кв - НоваяСтрока.СуммаАвансовыхПлатежей3Кв - НоваяСтрока.СуммаАвансовыхПлатежей4Кв;
				
			КонецЕсли;
			
			Если НЕ ГодовойРасчет Тогда
				НоваяСтрока["СуммаАвансовыхПлатежей" + Формат(ПериодРасчета, "ДФ='q''Кв'''")] = НоваяСтрока.СуммаНалогаКУплате;
			КонецЕсли;
				
		КонецЦикла;
		
	КонецЕсли;
	
	ТаблицаРасчетНалога.ЗаполнитьЗначения(ДатаКонцаПериодаОтчета, "ПериодРасчета");
	ТаблицаРасчетНалога.ЗаполнитьЗначения(Организация, "Организация");

	Возврат ТаблицаРасчетНалога;
	
КонецФункции

#КонецОбласти

#Область НалогНаИмущество

// Возвращает расчет земельного налога за квартал
//
// Параметры:
//  Организация - СправочникСсылка.Организации - организация, по которому нужно получить расчет
//  ПериодРасчета - Дата - период, для которого нужно получить расчет (конец января, апреля, июля, октярбя и декабря)
//
// Возвращаемое значение:
//  ТаблицаРасчета - ТаблицаЗначений - таблица, содержащая данные по расчету за указанный квартал
//
Функция ПолучитьРасчетНалогаНаИмуществоЗаКвартал(Организация, ПериодРасчета)

	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	РасчетНалогаНаИмущество.ПериодРасчета,
	               |	РасчетНалогаНаИмущество.Организация,
	               |	РасчетНалогаНаИмущество.ИФНС,
	               |	РасчетНалогаНаИмущество.ОсновноеСредство,
	               |	РасчетНалогаНаИмущество.СуммаНалогаКУплате,
	               |	РасчетНалогаНаИмущество.СуммаИзмененияНалога
	               |ИЗ
	               |	РегистрСведений.РасчетНалогаНаИмущество КАК РасчетНалогаНаИмущество
	               |ГДЕ
	               |	РасчетНалогаНаИмущество.Организация = &Организация
	               |	И РасчетНалогаНаИмущество.ПериодРасчета = &ПериодРасчета";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ПериодРасчета", ПериодРасчета);
	
	ТаблицаРасчета = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаРасчета;
	
КонецФункции
 
// Возвращает результат расчета налога (или аванса по налогу) на имущество
//
// Параметры:
// 	Организация - СправочникСсылка.Организации - Организация, для которой необходимо выполнить проверку
// 	Период - Дата - Дата закрытия месяца
//
// Возвращаемое значение:
// 	ТаблицаРасчетНалога - ТаблицаЗначений - Результат расчета налога
//
Функция ПолучитьРасчетПоНалогуНаИмуществоРК(Организация, ПериодРасчета, МенеджерВТДляРасчетаПоФактическойСтоимости = Неопределено) Экспорт
	
	ГодовойРасчет = Месяц(ПериодРасчета) = 12;
	
	РеквизитыОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Организация, "РегистрацияВНалоговомОргане");
	
	мДатаНачалаПериодаОтчета = ?(ГодовойРасчет,	НачалоГода(ПериодРасчета),	ПолучитьДатуНачала(ПериодРасчета));
	мДатаКонцаПериодаОтчета = ?(ГодовойРасчет, КонецГода(ПериодРасчета), ПолучитьДатуОкончания(ПериодРасчета));
	
	ТаблицаРасчетНалога = РасчетИмущественныхНалогов.ПустаяСправкаРасчет("РасчетНалогаНаИмущество");

	ЭтоНеЮрЛицо = НЕ ОбщегоНазначенияБПВызовСервераПовтИсп.ЭтоЮрЛицо(Организация);
	
	Если Не (Месяц(ПериодРасчета) = 1 ИЛИ Месяц(ПериодРасчета) = 4 Или Месяц(ПериодРасчета) = 7 Или Месяц(ПериодРасчета) = 10 Или Месяц(ПериодРасчета) = 12)
		Или ЭтоНеЮрЛицо Тогда
		
		Возврат ТаблицаРасчетНалога;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Если МенеджерВТДляРасчетаПоФактическойСтоимости <> Неопределено Тогда
		Запрос.МенеджерВременныхТаблиц = МенеджерВТДляРасчетаПоФактическойСтоимости;
		РасчетПоФактическойСтоимости = Истина;
	Иначе
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		РасчетПоФактическойСтоимости = Ложь;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("КонецПериодаОтчета", мДатаКонцаПериодаОтчета);
			
	СчетаУчетаОС = Новый Массив;
	СчетаУчетаОС.Добавить(ПланыСчетов.Хозрасчетный.ОСвОрганизации); //2413
	СчетаУчетаОС.Добавить(ПланыСчетов.Хозрасчетный.ОсновныеСредстваПереданныеВАренду); //2414
	СчетаУчетаОС.Добавить(ПланыСчетов.Хозрасчетный.АмортизацияОсновныхСредств); //2420
	СчетаУчетаОС.Добавить(ПланыСчетов.Хозрасчетный.УбытокОтОбесцененияОсновныхСредств); //2430
	
	СчетаУчетаОС.Добавить(ПланыСчетов.Хозрасчетный.МЦвОрганизации);// 2312
	СчетаУчетаОС.Добавить(ПланыСчетов.Хозрасчетный.ИнвестицииВНедвижимостьПереданныеВАренду); //2313
	СчетаУчетаОС.Добавить(ПланыСчетов.Хозрасчетный.АмортизацияИнвестицийВНедвижимость_); //2320
	СчетаУчетаОС.Добавить(ПланыСчетов.Хозрасчетный.УбытокОтОбесцененияИнвестицийВНедвижимость); //2330
	
	Запрос.УстановитьПараметр("СчетаУчетаОС", СчетаУчетаОС);
	
	СчетаУчетаОСПервоначальнойСтоимости = Новый Массив;
	СчетаУчетаОСПервоначальнойСтоимости.Добавить(ПланыСчетов.Хозрасчетный.ОСвОрганизации);
	СчетаУчетаОСПервоначальнойСтоимости.Добавить(ПланыСчетов.Хозрасчетный.ОсновныеСредстваПереданныеВАренду);
	СчетаУчетаОСПервоначальнойСтоимости.Добавить(ПланыСчетов.Хозрасчетный.МЦвОрганизации);
	СчетаУчетаОСПервоначальнойСтоимости.Добавить(ПланыСчетов.Хозрасчетный.ИнвестицииВНедвижимостьПереданныеВАренду);
	
	Запрос.УстановитьПараметр("СчетаУчетаОСПервоначальнойСтоимости", СчетаУчетаОСПервоначальнойСтоимости);
	
	ТекстОбъединяющегоЗапроса = "";

	Период  = НачалоГода(ПериодРасчета);
	ИспользуетсяУправлениеВНА_2_4 = ВнеоборотныеАктивы.ИспользуетсяУправлениеВНА_2_4(Период);
	
	Счетчик = 1;
	
	Пока  Период <= ?(ГодовойРасчет, НачалоМесяца(ДобавитьМесяц(мДатаКонцаПериодаОтчета, 1)), мДатаКонцаПериодаОтчета) Цикл
		
		КонецПериода = ?(Год(Период) = Год(ПериодРасчета), Период, мДатаКонцаПериодаОтчета);
		
		Запрос.УстановитьПараметр("Период", Период);
		Запрос.УстановитьПараметр("КонецПериода", ?(ГодовойРасчет, КонецПериода, КонецМесяца(Период)));
		Запрос.УстановитьПараметр("КонецМесяца", КонецМесяца(Период));
		Запрос.УстановитьПараметр("КонецПредыдущегоМесяца", ДобавитьМесяц(КонецМесяца(Период),-1));
		
		// Срез последних записей по основному средству в регистре "Ставки налога на имущество по отдельным основным средствам".
		Если Не ГодовойРасчет И Период >= мДатаНачалаПериодаОтчета Тогда
			Запрос.Текст = "
			|ВЫБРАТЬ
			|	СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам.ОсновноеСредство,
			|	МАКСИМУМ(СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам.Период) КАК ПериодСреза
			|ПОМЕСТИТЬ СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследнихПериодов
			|ИЗ
			|	РегистрСведений.СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам КАК СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам
			|ГДЕ
			|	СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам.Период <= &КонецПредыдущегоМесяца
			|	И СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам.Организация = &Организация
			|
			|СГРУППИРОВАТЬ ПО
			|	СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам.ОсновноеСредство
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам.ОсновноеСредство,
			|	СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам.НалоговыйОрган,
			|	СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам.ПорядокНалогообложения,
			|	СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам.ПостановкаНаУчетВНалоговомОргане
			|ПОМЕСТИТЬ СтавкиНалогаНаИмуществоПоОтдельнымОСКонецПредыдущегоМесяца
			|ИЗ
			|	СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследнихПериодов КАК СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследнихПериодов
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам КАК СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам
			|		ПО СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследнихПериодов.ОсновноеСредство = СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам.ОсновноеСредство
			|			И СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследнихПериодов.ПериодСреза = СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам.Период
			|;
			|";
			Запрос.Выполнить();
			
		КонецЕсли;
		
		Запрос.Текст = "
		|////////////////////////////////////////////////////////////////////////////////
		|//////////////Отдельные запросы по состоянию на начало месяца////////////////////
		|ВЫБРАТЬ
		|	СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам.ОсновноеСредство,
		|	МАКСИМУМ(СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам.Период) КАК ПериодСреза
		|ПОМЕСТИТЬ СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамНачалоМесяца
		|ИЗ
		|	РегистрСведений.СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам КАК СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам
		|ГДЕ
		|	СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам.Период <= &Период
		|	И СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам.Организация = &Организация
		|
		|СГРУППИРОВАТЬ ПО
		|	СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам.ОсновноеСредство
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам.ОсновноеСредство,
		|	СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам.НалоговыйОрган,
		|	СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам.ПорядокНалогообложения,
		|	СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам.НалоговаяБаза
		|ПОМЕСТИТЬ СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследнихНачалоМесяца
		|ИЗ
		|	СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамНачалоМесяца КАК СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамНачалоМесяца
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам КАК СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам
		|		ПО СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамНачалоМесяца.ОсновноеСредство = СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам.ОсновноеСредство
		|			И СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамНачалоМесяца.ПериодСреза = СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам.Период
		|";
		
		Запрос.Выполнить();
		
		// Основные средства, находящиеся в состоянии "принято к учету".
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СостоянияОСОрганизаций.ОсновноеСредство КАК ОсновноеСредство,
		|	СостоянияОСОрганизаций.Состояние КАК Состояние
		|ПОМЕСТИТЬ
		|	ОСПринятыеКУчету
		|ИЗ
		|	РегистрСведений.СостоянияОСОрганизаций.СрезПоследних(" + ?(ГодовойРасчет, "&Период", "&КонецМесяца") + ", Организация = &Организация) КАК СостоянияОСОрганизаций
		|ГДЕ
		|	СостоянияОСОрганизаций.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПринятоКУчету)
		|	ИЛИ СостоянияОСОрганизаций.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияОС.СнятоСУчета)
		|	
		|ИНДЕКСИРОВАТЬ ПО
		|	ОсновноеСредство
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СостоянияОСОрганизаций.ОсновноеСредство КАК ОсновноеСредство,
		|	СостоянияОСОрганизаций.Состояние КАК Состояние
		|ПОМЕСТИТЬ
		|	ОСПринятыеКУчетуНачалоМесяца
		|ИЗ
		|	РегистрСведений.СостоянияОСОрганизаций.СрезПоследних(&Период, Организация = &Организация) КАК СостоянияОСОрганизаций
		|ГДЕ
		|	СостоянияОСОрганизаций.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПринятоКУчету)
		|	ИЛИ СостоянияОСОрганизаций.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияОС.СнятоСУчета)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ОсновноеСредство";
		
		Запрос.Выполнить();
		
		// Выборка объектов по основному налоговому органу организации (его нет в справочнике Регистрация в налоговом органе).
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОС.Ссылка КАК ОсновноеСредство
		|ПОМЕСТИТЬ
		|	СписокРазрешенныхОС
		|ИЗ
		|	Справочник.ОбъектыЭксплуатации КАК ОС
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|		ОСПринятыеКУчету КАК ОСПринятыеКУчету
		|	ПО
		|		ОС.Ссылка = ОСПринятыеКУчету.ОсновноеСредство
		|		
		|ГДЕ
		|	(ОС.Ссылка В 
		|		(ВЫБРАТЬ
		|			ПервоначальныеСведения.ОсновноеСредство
		|		ИЗ
		|			РегистрСведений.ПервоначальныеСведенияОС"+?(ИспользуетсяУправлениеВНА_2_4, "", "БухгалтерскийУчет")+" КАК ПервоначальныеСведения
		|		ГДЕ
		|			ПервоначальныеСведения.ОбъектИмущественногоНалога
		|			И ПервоначальныеСведения.Период < &КонецПериода
		|			И ПервоначальныеСведения.Организация = &Организация
		|			//ОТБОР_ОС//
		|			))
		|ИНДЕКСИРОВАТЬ ПО
		|	ОС.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство КАК ОсновноеСредство
		|
		|ПОМЕСТИТЬ
		|	СписокОС
		|
		|ИЗ
		|	РегистрСведений.ПервоначальныеСведенияОС"+?(ИспользуетсяУправлениеВНА_2_4, "", "БухгалтерскийУчет")+".СрезПоследних(
		|			" + ?(ГодовойРасчет, "&Период", "&КонецПериода") + ",
		|			Организация = &Организация
		|			И (ОсновноеСредство В (ВЫБРАТЬ РАЗЛИЧНЫЕ СписокРазрешенныхОС.ОсновноеСредство ИЗ СписокРазрешенныхОС КАК СписокРазрешенныхОС))
		|	) КАК ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам.СрезПоследних(
		|			" + ?(ГодовойРасчет, "&Период", "&КонецПериода") + ",
		|			Организация = &Организация
		|			И (ОсновноеСредство В (ВЫБРАТЬ РАЗЛИЧНЫЕ СписокРазрешенныхОС.ОсновноеСредство ИЗ СписокРазрешенныхОС КАК СписокРазрешенныхОС))) КАК СтавкиНалогаПоОтдельнымОбъектам
		|		ПО ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство = СтавкиНалогаПоОтдельнымОбъектам.ОсновноеСредство
		|ГДЕ
		|	ВЫБОР 
		|		КОГДА ЕСТЬNULL(СтавкиНалогаПоОтдельнымОбъектам.ПорядокНалогообложения, НЕОПРЕДЕЛЕНО) = НЕОПРЕДЕЛЕНО
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ СтавкиНалогаПоОтдельнымОбъектам.ПорядокНалогообложения <> ЗНАЧЕНИЕ(Перечисление.ПорядокНалогообложенияИмущества.НеПодлежитНалогообложению)
		|	КОНЕЦ
		|ИНДЕКСИРОВАТЬ ПО
		|	 ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство";
		Если РасчетПоФактическойСтоимости Тогда
			ТекстОтбораОС = "И ПервоначальныеСведения.ОсновноеСредство В
			|					(ВЫБРАТЬ
			|						ВТ_РазницаВСтоимостиОС.ОбъектУчета
			|					ИЗ
			|						ВТ_РазницаВСтоимостиОС КАК ВТ_РазницаВСтоимостиОС
			|					ГДЕ
			|						ВТ_РазницаВСтоимостиОС.СтоимостьРегл > 0)";
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "//ОТБОР_ОС//", ТекстОтбораОС);
		КонецЕсли;
		Запрос.Выполнить();
		
		Если Период >= мДатаНачалаПериодаОтчета Тогда
			// Выборка счетов учета ОС
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	"+?(ИспользуетсяУправлениеВНА_2_4,"ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПустаяСсылка)", "СчетаБухгалтерскогоУчетаОССрезПоследних.СчетУчета")+" КАК СчетУчета,
			|	"+?(ИспользуетсяУправлениеВНА_2_4,"ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПустаяСсылка)", "СчетаБухгалтерскогоУчетаОССрезПоследних.СчетНачисленияАмортизации")+" КАК СчетНачисленияАмортизации
			|
			|ПОМЕСТИТЬ
			|	СчетаУчетаОС
			|
			|ИЗ
			|	РегистрСведений.СчетаБухгалтерскогоУчетаОС.СрезПоследних(
			|		&КонецПериода, 
			|		Организация = &Организация 
			|		И ОсновноеСредство В (ВЫБРАТЬ ОсновноеСредство ИЗ СписокОС)) КАК СчетаБухгалтерскогоУчетаОССрезПоследних
			|;
			|
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СчетаБухгалтерскогоУчетаОССрезПоследних.Период,
			|	СчетаБухгалтерскогоУчетаОССрезПоследних.ОсновноеСредство,
			|	СчетаБухгалтерскогоУчетаОССрезПоследних.Организация,
			|	"+?(ИспользуетсяУправлениеВНА_2_4,"ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПустаяСсылка)", "СчетаБухгалтерскогоУчетаОССрезПоследних.СчетУчета")+" КАК СчетУчета,
			|	"+?(ИспользуетсяУправлениеВНА_2_4,"ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПустаяСсылка)", "СчетаБухгалтерскогоУчетаОССрезПоследних.СчетНачисленияАмортизации")+" КАК СчетНачисленияАмортизации
			|ПОМЕСТИТЬ ВТ_СчетаБухгалтерскогоУчетаОССрезПоследних
			|ИЗ
			|	РегистрСведений.СчетаБухгалтерскогоУчетаОС.СрезПоследних(&КонецПериода, Организация = &Организация И ОсновноеСредство В (ВЫБРАТЬ ОсновноеСредство ИЗ СписокОС)) КАК СчетаБухгалтерскогоУчетаОССрезПоследних
			|ИНДЕКСИРОВАТЬ ПО
			|	СчетаБухгалтерскогоУчетаОССрезПоследних.ОсновноеСредство
			|;
			|
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ПервоначальныеСведения.*
			|ПОМЕСТИТЬ ВТ_ПервоначальныеСведенияОС
			|ИЗ
			|	РегистрСведений.ПервоначальныеСведенияОС"+?(ИспользуетсяУправлениеВНА_2_4, "", "БухгалтерскийУчет")+".СрезПоследних(" + ?(ГодовойРасчет, "&Период", "&КонецПериода") + ", Организация = &Организация И ОсновноеСредство В (ВЫБРАТЬ СписокОС.ОсновноеСредство ИЗ СписокОС)) КАК ПервоначальныеСведения
			|ИНДЕКСИРОВАТЬ ПО
			|	ПервоначальныеСведения.ОсновноеСредство
			|;
			|
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СтавкиНалогаНаИмуществоСрезПоследних.*
			|ПОМЕСТИТЬ ВТ_СтавкиНалогаНаИмуществоСрезПоследних
			|ИЗ
			|	РегистрСведений.СтавкиНалогаНаИмущество.СрезПоследних(&КонецПериода, Организация = &Организация) КАК СтавкиНалогаНаИмуществоСрезПоследних
			|;";
			
			Если ИспользуетсяУправлениеВНА_2_4 Тогда
				
				Если Месяц(мДатаКонцаПериодаОтчета)+1 = Месяц(Период) И НЕ РасчетПоФактическойСтоимости Тогда
					
					Запрос.Текст = Запрос.Текст +
					"ВЫБРАТЬ
					|	СтоимостьОС.СтоимостьБУ КАК СтоимостьРегл,
					|	СтоимостьОС.ОсновноеСредство КАК ОсновноеСредство
					|ПОМЕСТИТЬ СписокОС_РасчетПоПредварительнойСтоимости
					|ИЗ
					|	Документ.ПринятиеКУчетуОС2_4 КАК ПринятиеКУчетуОС
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПринятиеКУчетуОС2_4.ОС КАК СтоимостьОС
					|		ПО (СтоимостьОС.Ссылка = ПринятиеКУчетуОС.Ссылка)
					|ГДЕ
					|	ПринятиеКУчетуОС.Организация = &Организация
					|	И ПринятиеКУчетуОС.Проведен
					|	И ПринятиеКУчетуОС.ОтражатьВРеглУчете
					|	И ПринятиеКУчетуОС.Дата МЕЖДУ &НачалоПредыдущегоМесяца И &КонецПредыдущегоМесяца
					|	И СтоимостьОС.ОсновноеСредство В
					|			(ВЫБРАТЬ
					|				СписокОС.ОсновноеСредство
					|			ИЗ
					|				СписокОС КАК СписокОС)
					|
					|ОБЪЕДИНИТЬ ВСЕ
					|
					|ВЫБРАТЬ
					|	СтоимостьОС.СтоимостьБУ,
					|	СтоимостьОС.ОсновноеСредство
					|ИЗ
					|	Документ.МодернизацияОС2_4 КАК МодернизацияОС2_4
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.МодернизацияОС2_4.ОС КАК СтоимостьОС
					|		ПО (СтоимостьОС.Ссылка = МодернизацияОС2_4.Ссылка)
