	ОБ_99_02_4__77 = БухИтогиРС.ПолучитьИтог("СуммаКорОборотДт", "Счет, КорСчет", Счет("99.02.4"), Счет("77"));
	ОБ_77__99_02_4 = БухИтогиРС.ПолучитьИтог("СуммаКорОборотКт", "Счет, КорСчет", Счет("99.02.4"), Счет("77"));
	
	ОБ_99_02_4__09 = БухИтогиРС.ПолучитьИтог("СуммаКорОборотДт", "Счет, КорСчет", Счет("99.02.4"), Счет("09"));
	ОБ_09__99_02_4 = БухИтогиРС.ПолучитьИтог("СуммаКорОборотКт", "Счет, КорСчет", Счет("99.02.4"), Счет("09"));
	
	РезделенноеСальдоСчета_02_01 = ЗаполнениеБухгалтерскойОтчетностиИтоги.РазделенноеСальдоСчета_02_01(НачалоПериодаОтчета, КонецПериодаОтчета, Организация);
	
	СтруктураСКД_97      = ЗаполнениеБухгалтерскойОтчетностиИтоги.РазделенноеСальдоСчета_97(НачалоПериодаОтчета, КонецПериодаОтчета, Организация);
	СтруктураСКД_76_01_2 = ЗаполнениеБухгалтерскойОтчетностиИтоги.РазделенноеСальдоСчета_76(Счет("76.01.2"), НачалоПериодаОтчета, КонецПериодаОтчета, Организация);
	СтруктураСКД_76_01_9 = ЗаполнениеБухгалтерскойОтчетностиИтоги.РазделенноеСальдоСчета_76(Счет("76.01.9"), НачалоПериодаОтчета, КонецПериодаОтчета, Организация);
	
	НомерСтроки = "1110";
	НаименованиеСтроки = "Нематериальные активы";
	
	ИмяОбластиПоказателя = "П000100" + НомерСтроки + Графа;
