	      ИЛИ ИдентификаторАвтозаполнения = "БалансНКО_2012Кв4_3" Тогда
		ЗаполнитьФормаОтчета2011Кв4_БалансПоГрафеРаздел3_НКО(КонтекстИсполнения);
