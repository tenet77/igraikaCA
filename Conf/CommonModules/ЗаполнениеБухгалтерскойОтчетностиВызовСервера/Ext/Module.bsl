	НачалоПредшествующегоПериодаОтчета = ДобавитьМесяц(НачалоПериодаОтчета, -12);
	КонецПредшествующегоПериодаОтчета  = ДобавитьМесяц(КонецПериодаОтчета, -12);
	
	РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П000100567003", Истина, Истина);
	РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П000100568003", Истина, Истина);
	
	Если НЕ РасширенныйПериодОтчета(ПараметрыОтчета.СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета) Тогда
