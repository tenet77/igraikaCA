		Запрос.УстановитьПараметр("Организации", ПолныйСписокОрганизаций);
		
		Запрос.УстановитьПараметр("НачПериодаОтч",  ДатаНачалаПериодаОтчета);
		Запрос.УстановитьПараметр("КонПериодаОтч",  ДатаКонцаПериодаОтчета);
