	ИначеЕсли ИдентификаторАвтозаполнения = "БалансНКО"
	      ИЛИ ИдентификаторАвтозаполнения = "БалансНКО_2012Кв1"
	      ИЛИ ИдентификаторАвтозаполнения = "БалансНКО_2012Кв4"
