Процедура ЗаполнитьФормаОтчета2018Кв1_ОДДС_2018(ПараметрыВывода)
	
	ПравилаЗаполненияСтрок = ПараметрыВывода.ПравилаЗаполненияСтрок;
	ТаблицаКодовСтрок = ПравилаЗаполненияСтрок.Скопировать();
	ТаблицаКодовСтрок.Свернуть("КодСтроки, НаименованиеСтроки, ВидДвижения");
	СтрокаПрочееПоступление = "";
	СтрокаПрочееВыбытие 	= "";
	ПараметрыВывода.СтрокиПрочихСтатейДДС.Свойство("ПрочееПоступление", СтрокаПрочееПоступление);
	ПараметрыВывода.СтрокиПрочихСтатейДДС.Свойство("ПрочееВыбытие", СтрокаПрочееВыбытие);
	
	Для Каждого ТекСтрока Из ТаблицаКодовСтрок Цикл 
		НомерСтроки        = ТекСтрока.КодСтроки;
		НаименованиеСтроки = ТекСтрока.НаименованиеСтроки;
		
		СтрокиВидовДДС = ПравилаЗаполненияСтрок.НайтиСтроки(Новый Структура("КодСтроки", НомерСтроки));
		Если СтрокиВидовДДС = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ВидДДСМассив = Новый Массив;
		Для каждого ТекСтрокаВида Из СтрокиВидовДДС Цикл
			Если НЕ ЗначениеЗаполнено(ТекСтрокаВида.ИмяВидаДДС) Тогда
				Продолжить;
			КонецЕсли;
			ВидДДС = Перечисления.ВидыДвиженийДенежныхСредств[ТекСтрокаВида.ИмяВидаДДС];
			ВидДДСМассив.Добавить(ВидДДС);
		КонецЦикла; 
		
		Если НомерСтроки = СтрокаПрочееПоступление ИЛИ НомерСтроки = СтрокаПрочееВыбытие Тогда
			ВидДДСМассив.Добавить(Перечисления.ВидыДвиженийДенежныхСредств.ПустаяСсылка());
		КонецЕсли;
		
		ПараметрыВывода.Вставить("НомерСтроки", "4" + НомерСтроки);
		ПараметрыВывода.Вставить("НаименованиеСтроки", НаименованиеСтроки);
		ПараметрыВывода.Вставить("ВидДДС", ВидДДСМассив);
		ПараметрыВывода.Вставить("ВидДвижения", ТекСтрока.ВидДвижения);
		ВывестиСтрокуОДДС2018Кв1(ПараметрыВывода);
	КонецЦикла;

КонецПроцедуры

