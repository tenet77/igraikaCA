		Запрос.УстановитьПараметр("СчетаПлюс",  ПолучитьМассивСчетовИзСписка("90.07.1, 90.07.2, 90.08.1, 90.08.2"));
		Запрос.УстановитьПараметр("СчетаМинус", ПолучитьМассивСчетовИзСписка(""));
