				Постфикс = "_" + Формат(Инд + 1, "ЧГ=0");
				Для Каждого Колонка Из МСЧ.Колонки Цикл
					Показатель = Колонка.Имя + Постфикс;
					Контейнер[Раздел].Вставить(Показатель, МСЧ[Инд][Колонка.Имя]);
				КонецЦикла;
			КонецЦикла;
			
