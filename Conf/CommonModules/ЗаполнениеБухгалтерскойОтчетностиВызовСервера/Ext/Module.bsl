	ЗаполнитьФормаОтчета2011Кв4_Пояснения8Строки5800и5810(КонтекстИсполнения, "03", НаименованиеГрафы, ДатаНачалаПериодаОтчета, ДатаКонцаПериодаОтчета);
	
	ЗаполнятьПредыдущиеПериоды = НЕ РасширенныйПериодОтчета(ДатаНачалаПериодаОтчета);
	Если ЗаполнятьПредыдущиеПериоды Тогда
		ПараметрыРасшифровки.Вставить("НачалоПериода", ДатаНачалаПредыдущегоГода);
		ПараметрыРасшифровки.Вставить("КонецПериода",  ДатаКонцаПредыдущегоГода);
		
		КонтекстИсполнения.Вставить("ПараметрыРасшифровки", ПараметрыРасшифровки);
		
		НаименованиеГрафы = "На " + Формат(ДатаКонцаПредыдущегоГода, "ДЛФ=DD");
		ЗаполнитьФормаОтчета2011Кв4_Пояснения8Строки5800и5810(КонтекстИсполнения, "04", НаименованиеГрафы, ДатаНачалаПредыдущегоГода, ДатаКонцаПредыдущегоГода);
		
		ПараметрыРасшифровки.Вставить("НачалоПериода", ДатаНачалаГодаПредшествующегоПредыдущему);
		ПараметрыРасшифровки.Вставить("КонецПериода",  ДатаКонцаГодаПредшествующегоПредыдущему);
		
		КонтекстИсполнения.Вставить("ПараметрыРасшифровки", ПараметрыРасшифровки);
		
		НаименованиеГрафы = "На " + Формат(ДатаКонцаГодаПредшествующегоПредыдущему, "ДЛФ=DD");
		ЗаполнитьФормаОтчета2011Кв4_Пояснения8Строки5800и5810(КонтекстИсполнения, "05", НаименованиеГрафы, ДатаНачалаГодаПредшествующегоПредыдущему, ДатаКонцаГодаПредшествующегоПредыдущему);
	КонецЕсли;
	
	КонтекстИсполнения.Удалить("ПараметрыРасшифровки");
	
