Процедура ЗаполнитьФормаОтчета2017Кв1_БалансПоГрафе(КонтекстИсполнения)
	
	КонтекстИсполнения.Вставить("РассчитаныеПараметры", Новый Структура);
	
	// Основные бухгалтерские величины по счетам.
	БухИтоги = Обработки.БухгалтерскиеИтоги.Создать();
	
	Итоги = "НачальныйОстатокДт, НачальныйРазвернутыйОстатокДт,
	        |НачальныйОстатокКт, НачальныйРазвернутыйОстатокКт,
	        |КонечныйОстатокДт,  КонечныйРазвернутыйОстатокДт,
	        |КонечныйОстатокКт,  КонечныйРазвернутыйОстатокКт";
	БухИтоги.РассчитатьИтоги("Хозрасчетный", Итоги, "Сумма", "Счет", КонтекстИсполнения.НачалоПериодаОтчета, КонтекстИсполнения.КонецПериодаОтчета, , , , , , "Организация", КонтекстИсполнения.Организация);
	
	КонтекстИсполнения.РассчитаныеПараметры.Вставить("БухИтоги", БухИтоги);
	
	ИдентификаторАвтозаполнения = КонтекстИсполнения.СтруктураОтчета.Баланс.ИдентификаторАвтозаполнения;
	
	ЗаполнитьФормаОтчета2017Кв1_Баланс_УПК(КонтекстИсполнения);
	
	КонтекстИсполнения.Удалить("РассчитаныеПараметры");
	
КонецПроцедуры

