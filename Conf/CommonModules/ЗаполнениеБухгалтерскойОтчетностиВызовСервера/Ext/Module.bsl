	// Cтрока 5180/5190 графа 04.
	СНД_08_05 = СНД("08.05", БухИтоги);
	Графа = "04";
	ПоказательСтроки = СНД_08_05;
	УстановитьЗначениеПоказателя(РассчитанныеПоказатели, ИмяРаздела, "П000100" + НомерСтроки + Графа, ПоказательСтроки);
	ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки, "П000100" + НомерСтроки + Графа, "Строка " + НомерСтроки + " ""незаконченные операции по приобретению нематериальных активов - всего"", графа ""На начало года""", "+", "!СНД " +  Счет("08.05").Код, СНД_08_05, ИмяРаздела, НастройкиОСВПоСчету(КонтекстИсполнения, "08.05"));
	
	// Cтрока 5180/5190 графа 05.
	ДО_08_05 = ДО("08.05", БухИтоги);
	Графа = "05";
	ПоказательСтроки = ДО_08_05;
	УстановитьЗначениеПоказателя(РассчитанныеПоказатели, ИмяРаздела, "П000100" + НомерСтроки + Графа, ПоказательСтроки);
	ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки, "П000100" + НомерСтроки + Графа, "Строка " + НомерСтроки + " ""незаконченные операции по приобретению нематериальных активов - всего"", графа ""Изменения за период - затраты за период""", "+", "!ДО " + Счет("08.05").Код, ДО_08_05, ИмяРаздела, НастройкиОСВПоСчету(КонтекстИсполнения, "08.05"));
	
	// Cтрока 5180/5190 графа 06.
	ОБ_91_02__08_05 = ОБ("91.02", "08.05", БухИтоги);
