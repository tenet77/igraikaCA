	               |	ХозрасчетныйОстаткиИОбороты.Счет КАК Счет,
	               |	ХозрасчетныйОстаткиИОбороты.Счет.Предопределенный КАК Предопределенный,
	               |	ХозрасчетныйОстаткиИОбороты.Счет.Вид КАК ВидСчета,
	               |	ХозрасчетныйОстаткиИОбороты.СуммаНачальныйОстатокДт КАК СуммаНачальныйОстатокДт,
	               |	ХозрасчетныйОстаткиИОбороты.СуммаНачальныйОстатокКт КАК СуммаНачальныйОстатокКт,
	               |	ХозрасчетныйОстаткиИОбороты.СуммаКонечныйОстатокДт КАК СуммаКонечныйОстатокДт,
	               |	ХозрасчетныйОстаткиИОбороты.СуммаКонечныйОстатокКт КАК СуммаКонечныйОстатокКт
	               |ИЗ
	               |	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
	               |			&ДатаНачала,
	               |			&ДатаОкончания,
	               |			,
	               |			,
	               |			НЕ Счет.Забалансовый
	               |				И НЕ Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.СчетаРоссийскойФедерации)),
	               |			,
	               |			Организация В (&СписокОрганизаций)) КАК ХозрасчетныйОстаткиИОбороты
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Счет
	               |АВТОУПОРЯДОЧИВАНИЕ";
				   
	Запрос.УстановитьПараметр("ДатаНачала", 			НачалоДня(КонтекстИсполнения.НачалоПериодаОтчета));
	Запрос.УстановитьПараметр("ДатаОкончания", 			КонецДня(КонтекстИсполнения.КонецПериодаОтчета));
	Запрос.УстановитьПараметр("СписокОрганизаций", 		КонтекстИсполнения.Организация);
		                	           	
	Результат = Запрос.Выполнить();

	КонтекстИсполнения.РассчитаныеПараметры.Вставить("БухИтоги", Результат.Выбрать());
	
	ИдентификаторАвтозаполнения = КонтекстИсполнения.СтруктураОтчета.Баланс.ИдентификаторАвтозаполнения;
	
	ЗаполнитьФормаОтчета2018Кв1_Баланс_УПК(КонтекстИсполнения);
	
	КонтекстИсполнения.Удалить("РассчитаныеПараметры");
	
КонецПроцедуры

// Функция возвращает код строки макета баланса для конкретного счета
 // 
Функция ПолучитьПараметрыСтроки(Счет, СчетВидСчета = Неопределено, КонтекстИсполнения)
	
	Если НЕ ЗначениеЗаполнено(СчетВидСчета) Тогда
		СчетВидСчета = Счет.Вид;   		
	КонецЕсли;
	ПараметрыСтроки = Неопределено;
	
	ПравилаЗаполненияСтрок = КонтекстИсполнения.ПравилаЗаполненияСтрок;
	
	КодСтроки = Неопределено;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Счет", Счет);
	Отбор.Вставить("ВключенВСтроку", Истина);
	
	СтрокиПравилЗаполненияСтрок = ПравилаЗаполненияСтрок.НайтиСтроки(Отбор);
	Если СтрокиПравилЗаполненияСтрок.Количество() > 0 Тогда
		СтрокаПравилЗаполнения = СтрокиПравилЗаполненияСтрок[0];
		КодСтроки = СтрокаПравилЗаполнения.КодСтроки;
		НаименованиеСтроки = СтрокаПравилЗаполнения.НаименованиеСтроки;
	КонецЕсли;
		
	Если НЕ ЗначениеЗаполнено(КодСтроки) Тогда
		// счета в макете соответствий нет
		// пробуем найти код по родителям счета рекурсивно			
		Если ЗначениеЗаполнено(Счет.Родитель) Тогда
			ПараметрыСтроки = ПолучитьПараметрыСтроки(Счет.Родитель, СчетВидСчета, КонтекстИсполнения);
			Если НЕ ПараметрыСтроки = Неопределено Тогда
				КодСтроки = ПараметрыСтроки.КодСтроки;
			КонецЕсли;
		КонецЕсли;				
	КонецЕсли;				
		
	Если НЕ ЗначениеЗаполнено(КодСтроки) И КонтекстИсполнения.ОтображатьВПрочихРазделах Тогда
		// Включаем его  в прочие активы, прочие резервы или пассивы в зависимости от вида счета
		Если СчетВидСчета  = ВидСчета.Активный Тогда
			КодСтроки =  		 КонтекстИсполнения.СтрокиПрочихАктивовОбязательствБаланса.КодСтрокиПрочиеАктивы; 		// прочие краткосрочные активы
			НаименованиеСтроки = КонтекстИсполнения.СтрокиПрочихАктивовОбязательствБаланса.НаименованиеСтрокиПрочиеАктивы; 		
		Иначе	
			КодСтроки =  		 КонтекстИсполнения.СтрокиПрочихАктивовОбязательствБаланса.КодСтрокиПрочиеОбязательства; // прочие краткосрочные обязательства
			НаименованиеСтроки = КонтекстИсполнения.СтрокиПрочихАктивовОбязательствБаланса.НаименованиеСтрокиПрочиеОбязательства;
		КонецЕсли;	
	КонецЕсли;	
	
	Если ПараметрыСтроки = Неопределено И ЗначениеЗаполнено(КодСтроки) Тогда
		ПараметрыСтроки = Новый Структура;
		ПараметрыСтроки.Вставить("КодСтроки", КодСтроки);
		ПараметрыСтроки.Вставить("НаименованиеСтроки", НаименованиеСтроки);
	КонецЕсли;
	
	Возврат ПараметрыСтроки;
	
КонецФункции // ПолучитьКодСтрокиБаланса

Процедура ЗаполнитьФормаОтчета2018Кв1_Баланс_УПК(КонтекстИсполнения)
	
	Организация = КонтекстИсполнения.Организация;
	ТаблицаРасшифровки = КонтекстИсполнения.ТаблицаРасшифровки;
	РассчитанныеПоказатели = КонтекстИсполнения.РассчитанныеПоказатели;
	
	Графа = КонтекстИсполнения.Графа;
	ЗаголовокГрафы = КонтекстИсполнения.ЗаголовокГрафы;
	НачалоПериодаОтчета = КонтекстИсполнения.НачалоПериодаОтчета;
	КонецПериодаОтчета  = КонтекстИсполнения.КонецПериодаОтчета;
	КодНачалаРазделаОбязательств = КонтекстИсполнения.КодНачалаРазделаОбязательств;
	
	ИмяРаздела = "Баланс";
	ДополнительныеПараметрыРасшифровки = Новый Структура("Организация", Организация);
	
	//ДеревоНастроекСтрокРасшифровки = КонтекстИсполнения.СоставДополнительныхСтрокБаланс;
	
	ОбщиеПараметрыРасшифровки = Новый Структура;
	ОбщиеПараметрыРасшифровки.Вставить("Организация", Организация);
	ОбщиеПараметрыРасшифровки.Вставить("НачалоПериода", НачалоПериодаОтчета);
	ОбщиеПараметрыРасшифровки.Вставить("КонецПериода", КонецПериодаОтчета);
	
	// Основные бухгалтерские величины по счетам.
	БухИтоги = КонтекстИсполнения.РассчитаныеПараметры.БухИтоги;
	
	ТаблицаЗначенийПоказателей = Новый ТаблицаЗначений;
	
	ОписаниеТиповСтрока4   = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(4));
	ОписаниеТиповСтрока   = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки());
	ОписаниеТиповЧисло15_2 = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2));
	
	ТаблицаЗначенийПоказателей.Колонки.Добавить("КодСтроки", ОписаниеТиповСтрока4);
	ТаблицаЗначенийПоказателей.Колонки.Добавить("ИмяОбластиПоказателя", ОписаниеТиповСтрока);
	ТаблицаЗначенийПоказателей.Колонки.Добавить("ЗначениеПоказателя", ОписаниеТиповЧисло15_2);
	
	Пока БухИтоги.Следующий() Цикл
		
		Если БухИтоги.СуммаНачальныйОстатокДт = 0 И БухИтоги.СуммаНачальныйОстатокКт = 0 И  БухИтоги.СуммаКонечныйОстатокДт = 0 И БухИтоги.СуммаКонечныйОстатокКт = 0 Тогда
			Продолжить;
		КонецЕсли;	
		
		ПараметрыСтроки = ПолучитьПараметрыСтроки(БухИтоги.Счет, БухИтоги.ВидСчета, КонтекстИсполнения);
		
		Если ПараметрыСтроки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НомерСтроки 		= СокрЛП(ПараметрыСтроки.КодСтроки);
		НаименованиеСтроки  = СокрЛП(ПараметрыСтроки.НаименованиеСтроки);
		
		ИмяОбластиПоказателя = "П0001001" + НомерСтроки + Графа;
				
		СтрокаЗначенийПоказателей = ТаблицаЗначенийПоказателей.Найти(НомерСтроки, "КодСтроки");
		Если СтрокаЗначенийПоказателей = Неопределено Тогда
			СтрокаЗначенийПоказателей = ТаблицаЗначенийПоказателей.Добавить();
			СтрокаЗначенийПоказателей.КодСтроки = НомерСтроки;
			СтрокаЗначенийПоказателей.ИмяОбластиПоказателя = ИмяОбластиПоказателя;
			СтрокаЗначенийПоказателей.ЗначениеПоказателя = 0;
			ЗаголовокРасшифровки = "Строка " + Прав(НомерСтроки,3) + " """ + НаименованиеСтроки + """, графа """ + ЗаголовокГрафы + """";
		Иначе
			ЗаголовокРасшифровки = "";
		КонецЕсли;
		
		Счет = БухИтоги.Счет;
		ЧисловойКодБаланса = Число(НомерСтроки);
		
		Если Графа = "04" Тогда
			СНД_Счет = БухИтоги.СуммаНачальныйОстатокДт;
			СНК_Счет = БухИтоги.СуммаНачальныйОстатокКт;
			
			Если ЧисловойКодБаланса >= КодНачалаРазделаОбязательств Тогда
				СтрокаЗначенийПоказателей.ЗначениеПоказателя = СтрокаЗначенийПоказателей.ЗначениеПоказателя + СНК_Счет - СНД_Счет;
				ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки, ИмяОбластиПоказателя, ЗаголовокРасшифровки, "+", "!СНК " + Счет.Код, СНК_Счет, ИмяРаздела);
				ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки, ИмяОбластиПоказателя, "", "-", "!СНД " + Счет.Код, - СНД_Счет, ИмяРаздела);
			Иначе	
				СтрокаЗначенийПоказателей.ЗначениеПоказателя = СтрокаЗначенийПоказателей.ЗначениеПоказателя + СНД_Счет - СНК_Счет;
				ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки, ИмяОбластиПоказателя, ЗаголовокРасшифровки, "+", "!СНД " + Счет.Код, СНД_Счет, ИмяРаздела);
				ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки, ИмяОбластиПоказателя, "", "-", "!СНК " + Счет.Код, - СНК_Счет, ИмяРаздела);
			КонецЕсли;
		Иначе
			СКД_Счет = БухИтоги.СуммаКонечныйОстатокДт;
			СКК_Счет = БухИтоги.СуммаКонечныйОстатокКт;
			
			Если ЧисловойКодБаланса >= КодНачалаРазделаОбязательств Тогда
				СтрокаЗначенийПоказателей.ЗначениеПоказателя = СтрокаЗначенийПоказателей.ЗначениеПоказателя + СКК_Счет - СКД_Счет;
				ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки, ИмяОбластиПоказателя, ЗаголовокРасшифровки, "+", "!СКК " + Счет.Код, СКК_Счет, ИмяРаздела);
				ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки, ИмяОбластиПоказателя, "", "-", "!СКД " + Счет.Код, - СКД_Счет, ИмяРаздела);
			Иначе
				СтрокаЗначенийПоказателей.ЗначениеПоказателя = СтрокаЗначенийПоказателей.ЗначениеПоказателя + СКД_Счет - СКК_Счет;
				ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки, ИмяОбластиПоказателя, ЗаголовокРасшифровки, "+", "!СКД " + Счет.Код, СКД_Счет, ИмяРаздела);
				ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки, ИмяОбластиПоказателя, "", "-", "!СКК " + Счет.Код, - СКК_Счет, ИмяРаздела);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для каждого СтрокаЗначенийПоказателей Из ТаблицаЗначенийПоказателей Цикл
	
		УстановитьЗначениеПоказателя(РассчитанныеПоказатели, ИмяРаздела, СтрокаЗначенийПоказателей.ИмяОбластиПоказателя, СтрокаЗначенийПоказателей.ЗначениеПоказателя);
	
	КонецЦикла; 
	
КонецПроцедуры

Процедура ЗаполнитьФормаОтчета2018Кв1_ОФР_УПК(Графа, ЗаголовокГрафы, КонтекстИсполнения, НачалоПериодаОтчета, КонецПериодаОтчета)
	
	Организация = КонтекстИсполнения.Организация;
	ТаблицаРасшифровки = КонтекстИсполнения.ТаблицаРасшифровки;
	РассчитанныеПоказатели = КонтекстИсполнения.РассчитанныеПоказатели;
	
	ИмяРаздела = "ФормаОтчета";
	
	ОбщиеПараметрыРасшифровки = Новый Структура;
	ОбщиеПараметрыРасшифровки.Вставить("Организация", Организация);
	ОбщиеПараметрыРасшифровки.Вставить("НачалоПериода", НачалоПериодаОтчета);
	ОбщиеПараметрыРасшифровки.Вставить("КонецПериода", КонецПериодаОтчета);
	
	Запрос = Новый Запрос;		
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЕСТЬNULL(ХозрасчетныйОбороты.СуммаОборотДт, 0) КАК СуммаОборотДт,
	               |	ЕСТЬNULL(ХозрасчетныйОбороты.СуммаОборотКт, 0) КАК СуммаОборотКт,
	               |	ХозрасчетныйОбороты.КорСчет КАК КорСчет
	               |ИЗ
	               |	РегистрБухгалтерии.Хозрасчетный.Обороты(&ДатаНачала, &ДатаОкончания, , Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ИтоговаяПрибыльИтоговыйУбыток), , Организация В (&СписокОрганизаций), КорСчет В ИЕРАРХИИ (&КорСчет), ) КАК ХозрасчетныйОбороты";
	
	Запрос.УстановитьПараметр("ДатаНачала", 			НачалоДня(НачалоПериодаОтчета));
	Запрос.УстановитьПараметр("ДатаОкончания", 			КонецДня(КонецПериодаОтчета));
	Запрос.УстановитьПараметр("СписокОрганизаций", 		Организация);	
	
	ПравилаЗаполненияСтрок = КонтекстИсполнения.ПравилаЗаполненияСтрок;
	//кор.счета, относящиеся к доходам/убыткам организации	
	МассивСчетов = ПравилаЗаполненияСтрок.ВыгрузитьКолонку("Счет");
	Запрос.УстановитьПараметр("КорСчет", МассивСчетов);	
	
	ТаблицаЗначенийПоказателей = Новый ТаблицаЗначений;
	
	ОписаниеТиповСтрока4   = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(4));
	ОписаниеТиповСтрока   = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки());
	ОписаниеТиповЧисло15_2 = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2));
	
	ТаблицаЗначенийПоказателей.Колонки.Добавить("КодСтроки", ОписаниеТиповСтрока4);
	ТаблицаЗначенийПоказателей.Колонки.Добавить("ИмяОбластиПоказателя", ОписаниеТиповСтрока);
	ТаблицаЗначенийПоказателей.Колонки.Добавить("ЗначениеПоказателя", ОписаниеТиповЧисло15_2);
	
	Результат = Запрос.Выполнить();
	БухИтоги = Результат.Выбрать();
	
	Пока БухИтоги.Следующий() Цикл
		
		Если БухИтоги.СуммаОборотДт = 0 И БухИтоги.СуммаОборотКт = 0 Тогда
			Продолжить;
		КонецЕсли;	
		
		Счет = БухИтоги.КорСчет;
		ПараметрыСтроки = ПолучитьПараметрыСтроки(Счет, Счет.Вид, КонтекстИсполнения);
		
		Если ПараметрыСтроки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НомерСтроки 		= СокрЛП(ПараметрыСтроки.КодСтроки);
		НаименованиеСтроки  = СокрЛП(ПараметрыСтроки.НаименованиеСтроки);
		
		ИмяОбластиПоказателя = "П0001002" + НомерСтроки + Графа;
				
		СтрокаЗначенийПоказателей = ТаблицаЗначенийПоказателей.Найти(НомерСтроки, "КодСтроки");
		Если СтрокаЗначенийПоказателей = Неопределено Тогда
			СтрокаЗначенийПоказателей = ТаблицаЗначенийПоказателей.Добавить();
			СтрокаЗначенийПоказателей.КодСтроки = НомерСтроки;
			СтрокаЗначенийПоказателей.ИмяОбластиПоказателя = ИмяОбластиПоказателя;
			СтрокаЗначенийПоказателей.ЗначениеПоказателя = 0;
			ЗаголовокРасшифровки = "Строка " + Прав(НомерСтроки,3) + " """ + НаименованиеСтроки + """, графа """ + ЗаголовокГрафы + """";
		Иначе
			ЗаголовокРасшифровки = "";
		КонецЕсли;
		
		КО_5710 = БухИтоги.СуммаОборотКт;
		ДО_5710 = БухИтоги.СуммаОборотДт;
		
		ЗначениеПоказателя = 0;
		Если НомерСтроки = "010" ИЛИ НомерСтроки = "024" ИЛИ НомерСтроки = "021" 
			ИЛИ НомерСтроки = "023" ИЛИ НомерСтроки = "201" ИЛИ НомерСтроки = "101" Тогда
			ЗначениеПоказателя = КО_5710 - ДО_5710;
			ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки, ИмяОбластиПоказателя, ЗаголовокРасшифровки, "+", "Оборот по кредиту счета 5710 в корреспонденции со счетом " + Счет.Код,КО_5710, ИмяРаздела,);
			ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки, ИмяОбластиПоказателя, "", "-", "Оборот по дебету счета 5710 в корреспонденции со счетом " + Счет.Код,-ДО_5710, ИмяРаздела, );
		Иначе
