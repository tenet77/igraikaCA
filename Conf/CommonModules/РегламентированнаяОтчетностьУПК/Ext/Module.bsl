// Процедура заполняет переданную в виде контейнера структуру данных отчета.
//
// Пример:
//	Если ИДОтчета = "РегламентированныйОтчет210Форма" Тогда
//		Если ИДРедакцииОтчета = "ФормаОтчета2102016Кв1" Тогда
//			ЗаполнитьФорма2102016Кв1(ПараметрыОтчета, Контейнер);
//		КонецЕсли;
//	КонецЕсли;
//
Процедура ЗаполнитьОтчетУПК(ИДОтчета, ИДРедакцииОтчета, ПараметрыОтчета, Контейнер) Экспорт
	
	Если ИДОтчета = "РегламентированныйОтчет300Форма" Тогда
		
		Если ИДРедакцииОтчета = "ФормаОтчета3002016Кв1" Тогда
			
			ЗаполнитьФорма3002016Кв1(ПараметрыОтчета, Контейнер);
			
		ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета3002017Кв1" Тогда
			
			ЗаполнитьФорма3002017Кв1(ПараметрыОтчета, Контейнер);
			
		ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета3002018Кв1" Тогда
			
			ЗаполнитьФорма3002018Кв1(ПараметрыОтчета, Контейнер);
			
		ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета3002019Кв1" ИЛИ ИДРедакцииОтчета = "ФормаОтчета3002020Кв1" Тогда
			
			ЗаполнитьФорма3002019Кв1(ПараметрыОтчета, Контейнер);
            
        ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета3002020Кв2" Тогда
			
			ЗаполнитьФорма3002020Кв1(ПараметрыОтчета, Контейнер);
			
		ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета3002021Кв1" Тогда
			
			ЗаполнитьФорма3002021Кв1(ПараметрыОтчета, Контейнер);
			
		КонецЕсли;
		
	ИначеЕсли ИДОтчета = "РегламентированныйОтчет70101Форма" Тогда
		
		Если ИДРедакцииОтчета = "ФормаОтчета701012016Кв1" Тогда
			
			ЗаполнитьФорма701012016Кв1(ПараметрыОтчета, Контейнер);
			
		ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета701012017Кв1" Тогда
			
			ЗаполнитьФорма701012017Кв1(ПараметрыОтчета, Контейнер);
			
		ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета701012018Кв1" Тогда
			
			ЗаполнитьФорма701012018Кв1(ПараметрыОтчета, Контейнер);
			
		ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета701012018Кв2" Тогда
			
			ЗаполнитьФорма701012018Кв2(ПараметрыОтчета, Контейнер);
			
		ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета701012019Кв1" Тогда
			
			ЗаполнитьФорма701012019Кв1(ПараметрыОтчета, Контейнер);
            
        ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета701012020Кв2" ИЛИ ИДРедакцииОтчета = "ФормаОтчета701012021Кв1" Тогда
			
			ЗаполнитьФорма701012020Кв2(ПараметрыОтчета, Контейнер);
			
		КонецЕсли;
		
	ИначеЕсли ИДОтчета = "РегламентированныйОтчет701Форма" Тогда
		
		Если ИДРедакцииОтчета = "ФормаОтчета7012016Кв1" Или ИДРедакцииОтчета = "ФормаОтчета7012017Кв1" Или ИДРедакцииОтчета = "ФормаОтчета7012018Кв1" Тогда
			
			ЗаполнитьФорма7012016Кв1(ПараметрыОтчета, Контейнер);
			
		ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета7012019Кв1" Или ИДРедакцииОтчета = "ФормаОтчета7012020Кв1" Или ИДРедакцииОтчета = "ФормаОтчета7012020Кв2" Тогда
			
			ЗаполнитьФорма7012019Кв1(ПараметрыОтчета, Контейнер);
			
		КонецЕсли;
		
	ИначеЕсли ИДОтчета = "РегламентированныйОтчет100Форма" Тогда
		
		Если ИДРедакцииОтчета = "ФормаОтчета1002016Кв4" ИЛИ ИДРедакцииОтчета = "ФормаОтчета1002017Кв4" Тогда
			
			ЗаполнитьФорма1002016Кв4(ПараметрыОтчета, Контейнер);
			
		ИначеЕсли  ИДРедакцииОтчета = "ФормаОтчета1002018Кв4"    Тогда
			
			ЗаполнитьФорма1002018Кв4(ПараметрыОтчета, Контейнер);
							
		ИначеЕсли  ИДРедакцииОтчета = "ФормаОтчета1002019Кв1"    Тогда
			
			ЗаполнитьФорма1002019Кв1(ПараметрыОтчета, Контейнер);
							
		ИначеЕсли  ИДРедакцииОтчета = "ФормаОтчета1002019Кв4"    Тогда
			
			ЗаполнитьФорма1002019Кв4(ПараметрыОтчета, Контейнер);
			
		ИначеЕсли  ИДРедакцииОтчета = "ФормаОтчета1002020Кв4"    Тогда
			
			ЗаполнитьФорма1002020Кв4(ПараметрыОтчета, Контейнер);
			
		КонецЕсли;
        
    ИначеЕсли ИДОтчета = "РегламентированныйОтчет910Форма" Тогда
        
        Если ИДРедакцииОтчета = "ФормаОтчета9102021Кв1" Тогда
            
            ЗаполнитьФорма9102021Кв1(ПараметрыОтчета, Контейнер);
            
        КонецЕсли; 
        
    ИначеЕсли ИДОтчета = "РегламентированныйОтчетСтатистикаФорма11ОС" Тогда
		
		Если ИДРедакцииОтчета = "ФормаОтчета112016Кв4"
				ИЛИ ИДРедакцииОтчета = "ФормаОтчета112017Кв4"
				ИЛИ ИДРедакцииОтчета = "ФормаОтчета112019Кв4" Тогда
			
			ЗаполнитьФорма112016Кв4(ПараметрыОтчета, Контейнер);
			
		КонецЕсли;
		
	ИначеЕсли ИДОтчета = "РегламентированныйОтчет700Форма" Тогда
		
		Если ИДРедакцииОтчета = "ФормаОтчета7002016Кв4" Тогда
			
			ЗаполнитьФорма7002016Кв4(ПараметрыОтчета, Контейнер);
			
		ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета7002018Кв4" Тогда
			
			ЗаполнитьФорма7002018Кв4(ПараметрыОтчета, Контейнер);
			
		ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета7002019Кв4" Тогда
			
			ЗаполнитьФорма7002019Кв4(ПараметрыОтчета, Контейнер);
			
		ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета7002020Кв4" Тогда
			
			ЗаполнитьФорма7002020Кв4(ПараметрыОтчета, Контейнер);
			
		ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета7002021Кв4" Тогда
			
			ЗаполнитьФорма7002021Кв4(ПараметрыОтчета, Контейнер);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ФоновыеСообщенияПользователю(УникальныйИдентификатор, ИдентификаторНазначения = "") Экспорт
	
	ИсходныеСообщенияПользователю = ДлительныеОперации.СообщенияПользователю(Истина, УникальныйИдентификатор);
	
	Для Каждого Сообщение Из ИсходныеСообщенияПользователю Цикл
		
		Если НЕ ПустаяСтрока(ИдентификаторНазначения) Тогда
			
			Сообщение.ИдентификаторНазначения = ИдентификаторНазначения;
			
		КонецЕсли;	
		
		Сообщение.Сообщить();
		
	КонецЦикла;
		
КонецПроцедуры

#КонецОбласти

#Область Форма300

Функция ПолучитьЗначениеСтрокНДСКВозм(КодСтроки, ТЗ)
	
	Отбор = Новый Структура();
	Отбор.Вставить("КодСтроки", КодСтроки);
	
	МассивСтрок = ТЗ.НайтиСтроки(Отбор);
	СтруктураЗначений = Неопределено;
	
	Если МассивСтрок.Количество() > 0 Тогда 
		
		СтруктураЗначений = Новый Структура("СуммаБезНДСОборот, СуммаНДСОборот", 0, 0);
		
		Для Каждого СтрокаТЗ Из МассивСтрок Цикл 
			СтруктураЗначений.СуммаБезНДСОборот		 = СтруктураЗначений.СуммаБезНДСОборот + СтрокаТЗ.СуммаБезНДСОборот;
			СтруктураЗначений.СуммаНДСОборот		 = СтруктураЗначений.СуммаНДСОборот + СтрокаТЗ.СуммаНДСОборот;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат СтруктураЗначений;
	
КонецФункции

Процедура ЗаполнитьФорма3002016Кв1(ПараметрыОтчета, Контейнер) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода",    НачалоМесяца(ПараметрыОтчета.мДатаНачалаПериодаОтчета));
	Запрос.УстановитьПараметр("КонецПериода",     КонецМесяца(ПараметрыОтчета.мДатаКонцаПериодаОтчета));
	Запрос.УстановитьПараметр("парамОрганизация", ПараметрыОтчета.Организация);
	Запрос.УстановитьПараметр("ПустаяДата",       '00010101000000');
	
	#Область Запрос_300_00_06
	МенеджерВременныТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныТаблиц;
	Запрос.Текст = "ВЫБРАТЬ
	|	Организации.Ссылка
	|ПОМЕСТИТЬ СписокОрганизаций
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	(Организации.ГоловнаяОрганизация = &парамОрганизация
	|			ИЛИ Организации.Ссылка = &парамОрганизация)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(НДСОбороты.СуммаНДСОборот) КАК СуммаНДСОборот,
	|	СУММА(НДСОбороты.СуммаБезНДСОборот) КАК СуммаБезНДСОборот,
	|	КодыСтрокДекларацииПоНДССрезПоследних.КодСтроки КАК КодСтроки,
	|	НДСОбороты.СтавкаНДС
	|ПОМЕСТИТЬ ОборотыПоСтатьямИСтавкамНДС
	|ИЗ
	|	РегистрНакопления.НДС.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			Организация В
	|					(ВЫБРАТЬ
	|						СписокОрганизаций.Ссылка
	|					ИЗ
	|						СписокОрганизаций КАК СписокОрганизаций)
	|				И ЗаписьДополнительнойДекларации = ЛОЖЬ) КАК НДСОбороты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КодыСтрокДекларацииПоНДС.СрезПоследних(&КонецПериода, ) КАК КодыСтрокДекларацииПоНДССрезПоследних
	|		ПО НДСОбороты.ВидОперацииРеализации = КодыСтрокДекларацииПоНДССрезПоследних.ВидОперации
	|
	|СГРУППИРОВАТЬ ПО
	|	КодыСтрокДекларацииПоНДССрезПоследних.КодСтроки,
	|	НДСОбороты.СтавкаНДС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(НДСКВозмещениюОбороты.СуммаНДСОборот) КАК СуммаНДСОборот,
	|	СУММА(НДСКВозмещениюОбороты.СуммаБезНДСОборот) КАК СуммаБезНДСОборот,
	|	КодыСтрокДекларацииПоНДСКЗачетуСрезПоследних.КодСтроки КАК КодСтроки,
	|	НДСКВозмещениюОбороты.СтавкаНДС,
	|	НДСКВозмещениюОбороты.ВидОборота
	|ПОМЕСТИТЬ ОборотыПоСтатьямИСтавкамНДСКВозмещению
	|ИЗ
	|	РегистрНакопления.НДСКВозмещению.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			Организация В
	|					(ВЫБРАТЬ
	|						СписокОрганизаций.Ссылка
	|					ИЗ
	|						СписокОрганизаций КАК СписокОрганизаций)
	|				И ЗаписьДополнительнойДекларации = ЛОЖЬ) КАК НДСКВозмещениюОбороты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КодыСтрокДекларацииПоНДСКЗачету.СрезПоследних(&КонецПериода, ) КАК КодыСтрокДекларацииПоНДСКЗачетуСрезПоследних
	|		ПО НДСКВозмещениюОбороты.ВидОперацииПоступления = КодыСтрокДекларацииПоНДСКЗачетуСрезПоследних.ВидОперации
	|
	|СГРУППИРОВАТЬ ПО
	|	КодыСтрокДекларацииПоНДСКЗачетуСрезПоследних.КодСтроки,
	|	НДСКВозмещениюОбороты.СтавкаНДС,
	|	НДСКВозмещениюОбороты.ВидОборота";
	
	Запрос.Выполнить();
	
	Запрос.Текст = //////Таблица 0
	"ВЫБРАТЬ
	|	СУММА(ОборотыПоСтатьямИСтавкамНДС.СуммаНДСОборот) КАК СуммаНДСОборот,
	|	СУММА(ОборотыПоСтатьямИСтавкамНДС.СуммаБезНДСОборот) КАК СуммаБезНДСОборот,
	|	ОборотыПоСтатьямИСтавкамНДС.КодСтроки
	|ИЗ
	|	ОборотыПоСтатьямИСтавкамНДС КАК ОборотыПоСтатьямИСтавкамНДС
	|ГДЕ
	|	ОборотыПоСтатьямИСтавкамНДС.КодСтроки В (""300.00.001"", ""300.00.004"")
	|
	|СГРУППИРОВАТЬ ПО
	|	ОборотыПоСтатьямИСтавкамНДС.КодСтроки
	|;
	|
	//////Таблица 1
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОборотыПоСтатьямИСтавкамНДС.КодСтроки,
	|	СУММА(ОборотыПоСтатьямИСтавкамНДС.СуммаБезНДСОборот) КАК СуммаБезНДСОборот,
	|	СУММА(ОборотыПоСтатьямИСтавкамНДС.СуммаНДСОборот) КАК СуммаНДСОборот
	|ИЗ
	|	ОборотыПоСтатьямИСтавкамНДС КАК ОборотыПоСтатьямИСтавкамНДС
	|ГДЕ
	|	ОборотыПоСтатьямИСтавкамНДС.КодСтроки В (""300.06.001"", ""300.06.002"", ""300.06.003"", ""300.06.004"", ""300.06.005"", ""300.06.006"", ""300.06.007"", ""300.06.008"")
	|
	|СГРУППИРОВАТЬ ПО
	|	ОборотыПоСтатьямИСтавкамНДС.КодСтроки
	|;
	|
	//////Таблица 2
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОборотыПоСтатьямИСтавкамНДС.СуммаБезНДСОборот КАК СуммаБезНДСОборот,
	|	ОборотыПоСтатьямИСтавкамНДС.СтавкаНДС.Ставка КАК Ставка,
	|	ОборотыПоСтатьямИСтавкамНДС.СуммаНДСОборот КАК СуммаНДСОборот
	|ИЗ
	|	ОборотыПоСтатьямИСтавкамНДС КАК ОборотыПоСтатьямИСтавкамНДС
	|ГДЕ
	|	ОборотыПоСтатьямИСтавкамНДС.КодСтроки В (""300.06.001"", ""300.06.002"", ""300.06.003"", ""300.06.004"", ""300.06.005"", ""300.06.006"", ""300.06.007"", ""300.06.008"")
	|	И ОборотыПоСтатьямИСтавкамНДС.СтавкаНДС.Ставка <> 0
	|;
	|
	//////Таблица 3
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОборотыПоСтатьямИСтавкамНДС.СуммаБезНДСОборот КАК СуммаБезНДСОборот,
	|	ОборотыПоСтатьямИСтавкамНДС.СтавкаНДС.Ставка КАК Ставка
	|ИЗ
	|	ОборотыПоСтатьямИСтавкамНДС КАК ОборотыПоСтатьямИСтавкамНДС
	|ГДЕ
	|	ОборотыПоСтатьямИСтавкамНДС.КодСтроки В (""300.06.001"", ""300.06.002"", ""300.06.003"", ""300.06.004"", ""300.06.005"", ""300.06.006"", ""300.06.007"", ""300.06.008"")
	|	И ОборотыПоСтатьямИСтавкамНДС.СтавкаНДС.Ставка = 0
