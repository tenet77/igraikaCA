//Получает информацию для заполнения разделов
Функция ПолучитьРезультатЗапроса(ПараметрыОтчета, втВнеоборотныйАктив, ВидСубконто, ЗапросПоНМА)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЗапросДляВывода.ВнеоборотныйАктив КАК ВнеоборотныйАктив,
	|	ЗапросДляВывода.КодКоф КАК КодКоф,
	|	ЕСТЬNULL(ЗапросДляВывода.ОстатокНаНачало, 0) КАК ОстатокНаНачало,
	|	ЕСТЬNULL(ЗапросДляВывода.Поступило, 0) КАК Поступило,
	|	ЕСТЬNULL(ЗапросДляВывода.Выбыло, 0) КАК Выбыло,
	|	ЕСТЬNULL(ЗапросДляВывода.ОстатокНаКонец, 0) КАК ОстатокНаКонец,
	|	ЕСТЬNULL(ЗапросДляВывода.Дооценка, 0) КАК Дооценка,
	|	ЕСТЬNULL(ЗапросДляВывода.Уценка, 0) КАК Уценка,
	|	ЕСТЬNULL(ЗапросДляВывода.Амортизация, 0) КАК Амортизация,
	|	ЕСТЬNULL(ЗапросДляВывода.АмортизацияНаКонец, 0) КАК АмортизацияНаКонец,
	|	ЕСТЬNULL(ЗапросДляВывода.АмортизацияСписано, 0) КАК АмортизацияСписано,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ЗапросДляВывода.ОстатокНаКонец, 0) = 0
	|			ТОГДА ЕСТЬNULL(ЗапросДляВывода.Выбыло, 0) - ЕСТЬNULL(ЗапросДляВывода.Уценка, 0)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Списано,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ЗапросДляВывода.ОстатокНаКонец, 0) <> 0
	|			ТОГДА ЕСТЬNULL(ЗапросДляВывода.Выбыло, 0) - ЕСТЬNULL(ЗапросДляВывода.Уценка, 0)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ПрочееВыбытие,
