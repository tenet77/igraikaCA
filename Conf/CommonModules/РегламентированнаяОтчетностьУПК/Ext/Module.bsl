				ИмяСтруктуры ="Форма700_01Страница2";
			КонецЕсли;
			
			// Подраздел 6.1
			Подраздел_6_1 = "До2013";
			Если ВидТранспортногоСредстваСтрока = "ЛегковойАвтомобиль" 
				И (ИмяЯчейкиВидаТС = "П0001100220"
				ИЛИ ИмяЯчейкиВидаТС = "П0001100230"
				ИЛИ ИмяЯчейкиВидаТС = "П0001100240"
				ИЛИ ИмяЯчейкиВидаТС = "П0001100250"
				ИЛИ ИмяЯчейкиВидаТС = "П0001100260") Тогда
				
				Подраздел_6_1 = "После2013";
				
			КонецЕсли;
			
			СуммаПревышения = 0;
			
			// Для легковых автомобилей рассчитываем размер превышения
			Если Выборка.КодВидаТранспортногоСредства = Перечисления.ВидыТранспортныхСредств.ЛегковойАвтомобиль Тогда
				СуммаПревышения = ПолучитьРазмерПревышенияПоОбъему(Выборка.КодВидаТранспортногоСредства, ЗначениеПоказателя, СтруктураСтавокНалога, Подраздел_6_1);
			КонецЕсли;
			
			// Для летательных аппаратов и ЖД - показываем суммарную мощность
			Если Выборка.КодВидаТранспортногоСредства = Перечисления.ВидыТранспортныхСредств.ЛетательныйАппарат
				ИЛИ Выборка.КодВидаТранспортногоСредства = Перечисления.ВидыТранспортныхСредств.ЖелезнодорожныйТяговыйПодвижнойСостав
				ИЛИ Выборка.КодВидаТранспортногоСредства = Перечисления.ВидыТранспортныхСредств.МотороВагонныйПодвижнойСостав Тогда
				
				// с накоплением
				
				Контейнер[ИмяСтруктуры][ИмяЯчейкиВидаТС + "03"] =  ЗначениеПоказателя + Контейнер[ИмяСтруктуры][ИмяЯчейкиВидаТС + "03"];
				
			ИначеЕсли Выборка.КодВидаТранспортногоСредства = Перечисления.ВидыТранспортныхСредств.ЛегковойАвтомобиль Тогда
				
				Если Контейнер[ИмяСтруктуры].Свойство(ИмяЯчейкиВидаТС + "03") Тогда
					Контейнер[ИмяСтруктуры][ИмяЯчейкиВидаТС + "03"] =  СуммаПревышения + Контейнер[ИмяСтруктуры][ИмяЯчейкиВидаТС + "03"];
				КонецЕсли;
				
			КонецЕсли;
			
			Контейнер[ИмяСтруктуры][ИмяЯчейкиВидаТС + "01"] = 1 + Контейнер[ИмяСтруктуры][ИмяЯчейкиВидаТС + "01"];
			Контейнер[ИмяСтруктуры][ИмяЯчейкиВидаТС + "02"] = Выборка.СуммаНалога + Контейнер[ИмяСтруктуры][ИмяЯчейкиВидаТС + "02"];
			Контейнер[ИмяСтруктуры][ИмяЯчейкиВидаТС + "04"] = КоличествоМесяцев + Контейнер[ИмяСтруктуры][ИмяЯчейкиВидаТС + "04"];
			
		КонецЦикла;
		
	КонецЕсли;
	
	//700.002
	Если Результат700_02.Количество()> 0 Тогда
		
		Выборка = Результат700_02;
		Счетчик = 4;
        Контейнер.Форма700Страница1.Вставить("КоличествоПриложений700_02", 1);
		Контейнер.Форма700Страница1.Вставить("Приложение02", "Х");
        Контейнер.Форма700_02Страница1_ДанныеДопСтрок.Очистить();
		Контейнер.Форма700_02Страница2_ДанныеДопСтрок.Очистить();
		Контейнер.Форма700_02Страница3_ДанныеДопСтрок.Очистить();
		
		Пока Выборка.Следующий() Цикл
			
			//Страница 1
			НоваяСтрока = Контейнер.Форма700_02Страница1_ДанныеДопСтрок.Добавить();
			НоваяСтрока.П000210000501 = Счетчик + 1; 
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
			//Страница 2
			НоваяСтрока = Контейнер.Форма700_02Страница2_ДанныеДопСтрок.Добавить();
			НоваяСтрока.П000220000501 = Счетчик + 1;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
			СтавкаСУчетомКорректировки = Окр((Выборка.НалоговаяСтавка + Выборка.НалоговаяСтавка * Выборка.П000210000507 / 100) *
			?(Выборка.П000220000502 = 0, 1, Выборка.П000220000502) *
			?(Выборка.П000220000503 = 0, 1, Выборка.П000220000503) *
			?(Выборка.П000220000504 = 0, 1, Выборка.П000220000504), 3);
			
			НоваяСтрока.П000220000506 = СтавкаСУчетомКорректировки;
			
			//Страница 3
			НоваяСтрока = Контейнер.Форма700_02Страница3_ДанныеДопСтрок.Добавить();
			НоваяСтрока.П000230000501 = Счетчик + 1;
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
			Счетчик = Счетчик + 1;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ПоместитьВоВременноеХранилище(Контейнер, ПараметрыОтчета.АдресВоВременномХранилище);
	
КонецПроцедуры

Функция СформироватьСтуктуруСтавокНалогаНаТранспорт(Год)
	
	СтруктураСтавок = Новый Структура;
	МакетСтавок = РегистрыСведений.РегистрацияТранспортныхСредств.ПолучитьМакет("СтавкиНалогаНаТранспорт");
	
	СтруктураТаблицы = Новый ТаблицаЗначений;
	СтруктураТаблицы.Колонки.Добавить("НижнийПредел");
	СтруктураТаблицы.Колонки.Добавить("ВерхнийПредел");
	СтруктураТаблицы.Колонки.Добавить("БезОграничения");
	СтруктураТаблицы.Колонки.Добавить("СтавкаНалога");
	
	ИмяОбласти = "Строка" + Год;
	Область = МакетСтавок.Области[ИмяОбласти];
	
	Для Ном = Область.Верх По Область.Низ Цикл
		Наименование = СокрЛП(МакетСтавок.Область(Ном, 1).Текст);
		НижнийПредел 	 = СокрЛП(МакетСтавок.Область(Ном, 2).Текст);
		ВерхнийПредел 	 = СокрЛП(МакетСтавок.Область(Ном, 3).Текст);
		СтавкаНалога 	 = СокрЛП(МакетСтавок.Область(Ном, 4).Текст);
		
		Если Не СтруктураСтавок.Свойство(Наименование) Тогда
			СтруктураСтавок.Вставить(Наименование, СтруктураТаблицы.Скопировать());
		КонецЕсли;
		
		Строка = СтруктураСтавок[Наименование].Добавить();
		Строка.БезОграничения = ВерхнийПредел = "*";
		Строка.НижнийПредел   = ?(Не НижнийПредел = "*", Число(НижнийПредел), 0);
		Строка.ВерхнийПредел  = ?(НЕ ВерхнийПредел = "*",Число(ВерхнийПредел), 999999);
		Строка.СтавкаНалога	  = Число(СтавкаНалога);
	КонецЦикла;
	
	Возврат СтруктураСтавок;
	
КонецФункции

Функция ПолучитьИмяЯчейкиВидаТС(ВидТС,КонецПериода, Категория = 0, Выборка = Неопределено, ЕдиницаИзмеренияНалоговойБазы = Неопределено)
	
	ИмяЯчейкиВидаТС = Неопределено;
	
	Если ВидТС = Перечисления.ВидыТранспортныхСредств.ГрузовойАвтомобиль Тогда
		Если Категория <= 1 Тогда
			ИмяЯчейкиВидаТС = "П0001100010"
		ИначеЕсли Категория <= 1.5 Тогда
			ИмяЯчейкиВидаТС = "П0001100020"
		ИначеЕсли Категория <= 5 Тогда
			ИмяЯчейкиВидаТС = "П0001100030"
		Иначе
			ИмяЯчейкиВидаТС = "П0001100040"
		КонецЕсли;
	ИначеЕсли ВидТС = Перечисления.ВидыТранспортныхСредств.СамоходнаяМашина Тогда
		ИмяЯчейкиВидаТС = "П0001100050";
	ИначеЕсли ВидТС = Перечисления.ВидыТранспортныхСредств.Автобус Тогда
		Если Категория <= 12 Тогда
			ИмяЯчейкиВидаТС = "П0001100060"
		ИначеЕсли Категория <= 25 Тогда
			ИмяЯчейкиВидаТС = "П0001100070"
		Иначе
			ИмяЯчейкиВидаТС = "П0001100080"
		КонецЕсли;
	ИначеЕсли ВидТС = Перечисления.ВидыТранспортныхСредств.Мотоцикл Тогда
		
		Если ЕдиницаИзмеренияНалоговойБазы = "251" Тогда // Лошадиные силы
			ПределКатегории = 75;
		Иначе // Киловатты
			ПределКатегории = 55;
		КонецЕсли;
		
		Если Категория <= ПределКатегории Тогда
			ИмяЯчейкиВидаТС = "П0001100090"
		Иначе
			ИмяЯчейкиВидаТС = "П0001100100"
		КонецЕсли;
		
	ИначеЕсли ВидТС = Перечисления.ВидыТранспортныхСредств.Катер Тогда
		Если Категория <= 160 Тогда
			ИмяЯчейкиВидаТС = "П0001100110"
		ИначеЕсли Категория <= 500 Тогда
			ИмяЯчейкиВидаТС = "П0001100120"
		ИначеЕсли Категория <= 1000 Тогда
			ИмяЯчейкиВидаТС = "П0001100130"
		Иначе
			ИмяЯчейкиВидаТС = "П0001100140"
		КонецЕсли;
	ИначеЕсли ВидТС = Перечисления.ВидыТранспортныхСредств.ЛегковойАвтомобиль Тогда
		
		Категория6_1 = (Категория >= 3000 И (Выборка.ДатаВвозаНаТерриториюРК > Дата("20131231") ИЛИ (Выборка.ДатаВыпуска > Дата("20131231") И Выборка.ПроизведеноВРК)));
		
		Если Категория6_1 Тогда
			Если Категория <= 3200 Тогда
				ИмяЯчейкиВидаТС = "П0001100220"
			ИначеЕсли Категория <= 3500 Тогда
				ИмяЯчейкиВидаТС = "П0001100230"
			ИначеЕсли Категория <= 4000 Тогда
				ИмяЯчейкиВидаТС = "П0001100240"
			ИначеЕсли Категория <= 5000 Тогда
				ИмяЯчейкиВидаТС = "П0001100250"
			ИначеЕсли Категория > 5000 Тогда
				ИмяЯчейкиВидаТС = "П0001100260"
			КонецЕсли;
		Иначе
			Если Категория <= 1100 Тогда
				ИмяЯчейкиВидаТС = "П0001100150"
			ИначеЕсли Категория <= 1500 Тогда
				ИмяЯчейкиВидаТС = "П0001100160"
			ИначеЕсли Категория <= 2000 Тогда
				ИмяЯчейкиВидаТС = "П0001100170"
			ИначеЕсли Категория <= 2500 Тогда
				ИмяЯчейкиВидаТС = "П0001100180"
			ИначеЕсли Категория <= 3000 Тогда
				ИмяЯчейкиВидаТС = "П0001100190"
			ИначеЕсли Категория <= 4000 Тогда
				ИмяЯчейкиВидаТС = "П0001100200"
			Иначе
				ИмяЯчейкиВидаТС = "П0001100210"
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ВидТС = Перечисления.ВидыТранспортныхСредств.ЛетательныйАппарат Тогда
		// 01 июля отчетного года
		ОтчетнаяДата = Дата(Год(КонецПериода), 07, 01);
		
		КоличествоЛет = РазностьДатВМесяцах(Выборка.ДатаВыпуска, ОтчетнаяДата)/12;
		Если КоличествоЛет <=5 Тогда
			Если Выборка.ЭксплуатацияВРКдо1апреля1999г = Ложь Тогда
				ИмяЯчейкиВидаТС = "П0001200270"
			Иначе
				ИмяЯчейкиВидаТС = "П0001200300"
			КонецЕсли;
		ИначеЕсли КоличествоЛет <=15 Тогда
			Если Выборка.ЭксплуатацияВРКдо1апреля1999г = Ложь Тогда
				ИмяЯчейкиВидаТС = "П0001200280"
			Иначе
				ИмяЯчейкиВидаТС = "П0001200310"
			КонецЕсли;
		Иначе
			Если Выборка.ЭксплуатацияВРКдо1апреля1999г = Ложь Тогда
				ИмяЯчейкиВидаТС = "П0001200290"
			Иначе
				ИмяЯчейкиВидаТС = "П0001200320"
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ВидТС = Перечисления.ВидыТранспортныхСредств.ЖелезнодорожныйТяговыйПодвижнойСостав
			ИЛИ ВидТС = Перечисления.ВидыТранспортныхСредств.МотороВагонныйПодвижнойСостав Тогда
		ИмяЯчейкиВидаТС = "П0001200330"
	КонецЕсли;
	
	Возврат ИмяЯчейкиВидаТС;
	
КонецФункции

Функция РазностьДатВМесяцах(знач Дата1, Дата2)
	
	КоличествоЛет     = Год(Дата2) - Год(Дата1);
	КоличествоМесяцев = Месяц(Дата2) - Месяц(Дата1);
	// корректировка для случая Дата1 = 15 марта, Дата2 = 10 апреля. месяц еще не истек
	Если НЕ Месяц(Дата2) = Месяц(Дата1) И
		День(Дата2) < День(Дата1) Тогда
		КоличествоМесяцев =  КоличествоМесяцев - 1;
	КонецЕсли;
	РазностьВМесяцах = КоличествоЛет * 12 + КоличествоМесяцев;
	
	Возврат РазностьВМесяцах;
	
КонецФункции

Функция ПолучитьРазмерПревышенияПоОбъему(ВидТранспортногоСредства, ЗначениеХарактеристикиОбъекта, СтруктураСтавокНалога, Подраздел_6_1)
	
	Если ТипЗнч(ВидТранспортногоСредства) = Тип("ПеречислениеСсылка.ВидыТранспортныхСредств") 
		И ВидТранспортногоСредства = Перечисления.ВидыТранспортныхСредств.ЛегковойАвтомобиль Тогда
		
		ТаблицаСтавокНалога = Неопределено;
		Если СтруктураСтавокНалога.Свойство("ПревышенияПоVЛегковых" + Подраздел_6_1, ТаблицаСтавокНалога) Тогда
			ОбъемПревышения = 0;
			ОбъемПревышения = ПолучитьОбъемПревышения(ТаблицаСтавокНалога, ЗначениеХарактеристикиОбъекта,1) ;
			Возврат ОбъемПревышения;
		КонецЕсли;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Функция ПолучитьОбъемПревышения(ТаблицаСтавок, ЗначениеПоказателя = Неопределено, РассчитатьОтПревышения = 0) 
	
	Если ЗначениеПоказателя = Неопределено Тогда
		ЗначениеПоказателя  = 0;
	КонецЕсли;
	
	Если НЕ ТипЗнч(ТаблицаСтавок) = Тип("ТаблицаЗначений") Тогда
		Возврат 0;
	КонецЕсли;
	
	ТаблицаСтавок.Сортировать("НижнийПредел");
	Для каждого СтрокаСтавок из ТаблицаСтавок Цикл
		НижнийПредел  = СтрокаСтавок.НижнийПредел;
		ВерхнийПредел = СтрокаСтавок.ВерхнийПредел;
		БезОграничения = СтрокаСтавок.БезОграничения;
		
		Если БезОграничения Тогда
			
			Если РассчитатьОтпревышения = 1 Тогда
				ОбъемПревышения = ЗначениеПоказателя - НижнийПредел;
				Если ОбъемПревышения < 0 Тогда
					Возврат 0;
				Иначе
					Возврат ОбъемПревышения;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		Если (ЗначениеПоказателя > НижнийПредел) И
			((ЗначениеПоказателя <= ВерхнийПредел) ИЛИ БезОграничения) Тогда
			
			Если РассчитатьОтпревышения = 1 Тогда
				Возврат  ЗначениеПоказателя - НижнийПредел;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат 0;
	
КонецФункции

Функция ПолучитьИмяЯчейкиКатегорииЗемель(КатегорияЗемель)
	
	ИмяЯчейки = Неопределено;
	
	Если СтрНайти(КатегорияЗемель,"Земли сельскохозяйственного назначения")> 0 Тогда
		
		ИмяЯчейки = "П000210014007";
		
	ИначеЕсли СтрНайти(КатегорияЗемель,"Земли населенных пунктов")> 0 Тогда
		
		ИмяЯчейки = "П000210014002";
		
	ИначеЕсли СтрНайти(КатегорияЗемель,"Земли промышленности, транспорта, связи, обороны")> 0 Тогда
		
		ИмяЯчейки = "П000210014003";
		
	ИначеЕсли СтрНайти(КатегорияЗемель,"Земли особо охраняемых природных территорий")> 0 Тогда
		
		ИмяЯчейки = "П000210014006";
		
	ИначеЕсли СтрНайти(КатегорияЗемель,"Земли лесного фонда")> 0 Тогда
		
		ИмяЯчейки = "П000210014004";
		
	ИначеЕсли СтрНайти(КатегорияЗемель,"Земли водного фонда")> 0 Тогда
		
		ИмяЯчейки = "П000210014005";
		
	КонецЕсли;
	
	Возврат ИмяЯчейки;
	
КонецФункции

Процедура ЗаполнитьФорма7002020Кв4(ПараметрыОтчета, Контейнер)
	
	//ОбщиеСведения 
	СтрокаСведений = "ИННЮЛ, НаимЮЛПол, ФИОРук";
	СведенияОбОрганизации = РегламентированнаяОтчетностьРК.ПолучитьСведенияОбОрганизации(ПараметрыОтчета.Организация,, СтрокаСведений);
	Год = Год (ПараметрыОтчета.мДатаКонцаПериодаОтчета);
	Год = Формат(Год, "ЧГ=0");
	ГоловнаяОрганизация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыОтчета.Организация, "ГоловнаяОрганизация");
	ГоловнаяОрганизация = ?(ЗначениеЗаполнено(ГоловнаяОрганизация), ГоловнаяОрганизация, ПараметрыОтчета.Организация);
	СведенияОГоловнойОрганизации = РегламентированнаяОтчетностьРК.ПолучитьСведенияОбОрганизации(ГоловнаяОрганизация,,"ИННЮЛ");
	
	Контейнер.Форма700Страница2.Вставить("КодНалоговогоОргана", ПараметрыОтчета.НалоговыйКомитет.Код);
	Контейнер.Форма700Страница2.Вставить("ДатаПодачи", ТекущаяДата());
	Контейнер.Форма700Страница2.Вставить("Руководитель", СведенияОбОрганизации.ФИОРук);
	
