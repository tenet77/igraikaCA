		Если Контейнер.Форма100_02Страница2.Свойство("П000220010"+Номер+"01") = Истина Тогда
			Контейнер.Форма100_02Страница2["П000220010"+Номер+ "01"] = ЗначениеРасходыНаТекущийРемонт;
		КонецЕсли;
		        	
		//КонечныйОстаток = ?(Строка.КонечныйОстаток <> Null,Строка.КонечныйОстаток,0);
		//
		//Если КонечныйОстаток < 0 Тогда 
		//	КонечныйОстаток = - КонечныйОстаток;
		//КонецЕсли;
		
		
 	КонецЦикла;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаДвойнаяАмортизацияФА();
	
	//Запрос.УстановитьПараметр("ДатаОкончания1ГодНазад", 	ДобавитьМесяц(ПараметрыОтчета.мДатаКонцаПериодаОтчета,-12));
	//Запрос.УстановитьПараметр("ДатаОкончания2ГодаНазад", 	ДобавитьМесяц(ПараметрыОтчета.мДатаКонцаПериодаОтчета,-24));
	
	Запрос.УстановитьПараметр("ДатаНачала", 				НачалоМесяца(ПараметрыОтчета.мДатаНачалаПериодаОтчета));
	Запрос.УстановитьПараметр("ДатаОкончания", 				ПараметрыОтчета.мДатаКонцаПериодаОтчета);
	Запрос.УстановитьПараметр("ПустаяГруппаНУ",				Перечисления.АмортизационныеГруппы.ПустаяСсылка());	
	Запрос.УстановитьПараметр("ПустаяОрганизация",			Справочники.Организации.ПустаяСсылка());	
	Запрос.УстановитьПараметр("СписокОрганизаций", 			СписокОрганизаций);

	Запрос.УстановитьПараметр("ВключенВСоставГруппы",		Перечисления.СобытияФАУчитываемыхОтдельно.ВключениеВСоставГруппы);	    
	Запрос.УстановитьПараметр("Выбыл",						Перечисления.ВидыСостоянийФА.Выбыл);
	Запрос.УстановитьПараметр("ФаОтдельно_ПринятКУчету",	Перечисления.СобытияФАУчитываемыхОтдельно.ПринятиеКУчету);
	Запрос.УстановитьПараметр("ДвойнаяНорма",				Перечисления.ВидыФАУчитываемыхОтдельно.ДвойнаяНормаАмортизации);
	Запрос.УстановитьПараметр("ПорядокПогашенияДвойнаяНорма", Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизацииПоДвойнойНорме);

	Результат = Запрос.Выполнить();
	ТаблицаОтчета = Результат.Выгрузить();
	
	Для Каждого Строка Из ТаблицаОтчета Цикл
		Если Строка.ГруппаНУ = Перечисления.АмортизационныеГруппы.ПерваяГруппа Тогда
			Номер = 1;
		ИначеЕсли Строка.ГруппаНУ = Перечисления.АмортизационныеГруппы.ВтораяГруппа Тогда
			Номер = 2;
		ИначеЕсли Строка.ГруппаНУ = Перечисления.АмортизационныеГруппы.ТретьяГруппа Тогда
			Номер = 3;
		ИначеЕсли Строка.ГруппаНУ = Перечисления.АмортизационныеГруппы.ЧетвертаяГруппа Тогда
			Номер = 4;
		Иначе
			Номер = 5; //условно поставим знчение
		КонецЕсли;
		
		// Проверим, что преобразованный номер входит в наш диапазон
		Если Номер < 1 Или Номер > 4 Тогда 
			
			Продолжить;;
			
		КонецЕсли;
		
		АмортизацияНачисленная = Окр(Строка.АмортизацияНачисленная);
		Если Контейнер.Форма100_02Страница2.Свойство("П000220007"+Номер + "01") = Истина Тогда
			Контейнер.Форма100_02Страница2["П000220007" + Номер + "01"] = АмортизацияНачисленная;
		КонецЕсли;
					
	КонецЦикла;	
#КонецОбласти

	ПоместитьВоВременноеХранилище(Контейнер, ПараметрыОтчета.АдресВоВременномХранилище);

КонецПроцедуры

Функция ТекстЗапросаОстаткиТМЗ() Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ХозрасчетныйОстатки.СуммаНУОстатокДт - ХозрасчетныйОстатки.СуммаНУОстатокКт КАК Сумма,
	|	""100.00.009.I"" КАК КодСтроки
	|
	|ПОМЕСТИТЬ ВТ_ОстаткиТМЗ
	|
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(
	|			&НачПериода,
	|			Счет В ИЕРАРХИИ (&СчетаОстатковТМЗ),
	|			,
	|			Организация В
	|				(ВЫБРАТЬ
	|					СписокОрганизаций.Ссылка
	|				ИЗ
	|					ВТ_СписокОрганизаций КАК СписокОрганизаций)) КАК ХозрасчетныйОстатки
	|
	|ОБЪЕДИНИТЬ ВСЕ 
	|
	|ВЫБРАТЬ
	|	ХозрасчетныйОстатки.СуммаНУОстатокДт - ХозрасчетныйОстатки.СуммаНУОстатокКт КАК Сумма,
	|	""100.00.009.II"" КАК КодСтроки
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(
	|			&КонПериода,
	|			Счет В ИЕРАРХИИ (&СчетаОстатковТМЗ),
	|			,
	|			Организация В
	|				(ВЫБРАТЬ
	|					СписокОрганизаций.Ссылка
	|				ИЗ
	|					ВТ_СписокОрганизаций КАК СписокОрганизаций)) КАК ХозрасчетныйОстатки
	|
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ 
	|	СУММА(ОстаткиТМЗ.Сумма) КАК Сумма,
	| 	ОстаткиТМЗ.КодСтроки
	|ИЗ
	|	ВТ_ОстаткиТМЗ КАК ОстаткиТМЗ
	|
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиТМЗ.КодСтроки
	|";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаДоходыРасходыПоКурсовымРазницам() Экспорт

	ТекстЗапроса = "
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	//|	ХозрасчетныйОборотыПоДоходам.Субконто1 КАК ДоходРасход,
	|	ЕСТЬNULL(ХозрасчетныйОборотыПоДоходам.СуммаНУОборотКт, 0) КАК ПоложительнаяКР,
	|	0 КАК ОтрицательнаяКР
	|ПОМЕСТИТЬ ВТ_ДоходРасходКурсовыеРазницы
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(
	|			&НачПериода,
	|			&КонПериода,
	|			,
	|			Счет В ИЕРАРХИИ (&СчетаДоходов),
	|			&ВидСубконтоДоходов,
	//|			Организация В (&СписокОрганизаций)
	|			Организация В (ВЫБРАТЬ СписокОрганизаций.Ссылка ИЗ ВТ_СписокОрганизаций КАК СписокОрганизаций)
	|			И Субконто1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиДоходов.КурсовыеРазницы),
	|			НЕ КорСчет В ИЕРАРХИИ (&Счет000),
	|			) КАК ХозрасчетныйОборотыПоДоходам
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СведенияОкодахСтрокДекларации КАК ДанныеОКодахДекларации
	|		ПО ХозрасчетныйОборотыПоДоходам.Субконто1 = ДанныеОКодахДекларации.ДоходРасход
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	//|	ХозрасчетныйОборотыПоЗатратам.Субконто1 КАК ДоходРасход,
	|	0 КАК ПоложительнаяКР,
	|	ЕСТЬNULL(ХозрасчетныйОборотыПоЗатратам.СуммаНУОборотДт, 0) КАК ОтрицательнаяКР
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(
	|			&НачПериода,
	|			&КонПериода,
	|			,
	|			Счет В ИЕРАРХИИ (&СчетаРасходов) И НЕ Счет.Забалансовый,
	|			&ВидСубконтоЗатрат,
	//|			Организация В (&СписокОрганизаций)
	|			Организация В (ВЫБРАТЬ СписокОрганизаций.Ссылка ИЗ ВТ_СписокОрганизаций КАК СписокОрганизаций)
	|			И Субконто1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиРасходов.КурсовыеРазницы)
	|			И Субконто1 НЕ В (Выбрать СтатьиРемонтовИПреференций.СтатьяРасходов Из ВТ_СтатьиРемонтовИПреференций КАК СтатьиРемонтовИПреференций),
	|			НЕ КорСчет В ИЕРАРХИИ (&Счет000),
	|			) КАК ХозрасчетныйОборотыПоЗатратам
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СведенияОкодахСтрокДекларации КАК ДанныеОКодахДекларации
	|		ПО ХозрасчетныйОборотыПоЗатратам.Субконто1 = ДанныеОКодахДекларации.ДоходРасход
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА КурсоваяРазница.ПоложительнаяКР - КурсоваяРазница.ОтрицательнаяКР < 0
	|			ТОГДА ""100.00.020""
	|		ИНАЧЕ ""100.00.004""
	|	КОНЕЦ КАК КодСтроки,
	|	ВЫБОР
	|		КОГДА КурсоваяРазница.ПоложительнаяКР - КурсоваяРазница.ОтрицательнаяКР < 0
	|			ТОГДА КурсоваяРазница.ОтрицательнаяКР - КурсоваяРазница.ПоложительнаяКР
	|		ИНАЧЕ КурсоваяРазница.ПоложительнаяКР - КурсоваяРазница.ОтрицательнаяКР
	|	КОНЕЦ КАК Сумма
	|ПОМЕСТИТЬ ВТ_КурсовыеРазницы
	|ИЗ
	|	(ВЫБРАТЬ
	|		СУММА(ДоходРасходКурсовыеРазницы.ПоложительнаяКР) КАК ПоложительнаяКР,
	|		СУММА(ДоходРасходКурсовыеРазницы.ОтрицательнаяКР) КАК ОтрицательнаяКР
	|	ИЗ
	|		ВТ_ДоходРасходКурсовыеРазницы КАК ДоходРасходКурсовыеРазницы) КАК КурсоваяРазница
	|;
	|";

	Возврат ТекстЗапроса;


КонецФункции
 
