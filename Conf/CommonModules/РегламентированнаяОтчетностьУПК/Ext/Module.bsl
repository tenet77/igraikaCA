	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СписокОС.ОсновноеСредство,
	|	СписокОС.Организация,
	|	СписокОС.НалоговаяСтавка,
	|	СписокОС.НалоговыйКомитет,
	|	СписокОС.НеПодлежитНалогообложению,
	|	ЕСТЬNULL(ВТ_ПервоначальнаяСтоимостьОС.СуммаОстатокДт, 0) - ЕСТЬNULL(ВТ_АмортизацияОС.СуммаОстатокКт, 0) КАК БалансоваяСтоимость
	|ИЗ
	|	СписокОС КАК СписокОС
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПервоначальнаяСтоимостьОС КАК ВТ_ПервоначальнаяСтоимостьОС
	|		ПО СписокОС.ОсновноеСредство = ВТ_ПервоначальнаяСтоимостьОС.Субконто1
	|		И СписокОС.Организация = ВТ_ПервоначальнаяСтоимостьОС.Организация
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_АмортизацияОС КАК ВТ_АмортизацияОС
	|		ПО СписокОС.ОсновноеСредство = ВТ_АмортизацияОС.Субконто1
	|		И СписокОС.Организация = ВТ_АмортизацияОС.Организация
	|ГДЕ
	|	СписокОС.НалоговыйКомитет В (&НалоговыйКомитет)
	|	И СписокОС.НеПодлежитНалогообложению = ЛОЖЬ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если ПараметрыОтчета.ВидРасчета = "Очередной" Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			// сумму платежа за последний месяц считаем таким способом, чтобы избежать ошибок округления
			//ОбщаяСумма = Окр(Выборка.БалансоваяСтоимость * Выборка.НалоговаяСтавка /100,0);
			ОбщаяСумма = Окр((Выборка.БалансоваяСтоимость * Выборка.НалоговаяСтавка)/100);
			СуммаВМесяц = Окр(ОбщаяСумма/4);
			СуммаВПоследнийМесяц = Окр(ОбщаяСумма - (СуммаВМесяц*3));
			                                  
			
			Контейнер.Форма70101Страница1.П000210410101 = Контейнер.Форма70101Страница1.П000210410101 + СуммаВМесяц;
			Контейнер.Форма70101Страница1.П000210410102 = Контейнер.Форма70101Страница1.П000210410102 + СуммаВМесяц;
			Контейнер.Форма70101Страница2.П000210410103 = Контейнер.Форма70101Страница2.П000210410103 + СуммаВМесяц;
			Контейнер.Форма70101Страница2.П000210410104 = Контейнер.Форма70101Страница2.П000210410104 + СуммаВПоследнийМесяц;
			Контейнер.Форма70101Страница2.П000210410105 = Контейнер.Форма70101Страница2.П000210410105 + ОбщаяСумма;
			
		КонецЦикла;
		
	Иначе 
		
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	ЕСТЬNULL(РасчетНалогаНаИмущество.СуммаИзмененияНалога, 0) КАК СуммаИзмененияНалога
		|ИЗ
		|	РегистрСведений.РасчетНалогаНаИмущество КАК РасчетНалогаНаИмущество
		|ГДЕ
		|	РасчетНалогаНаИмущество.ПериодРасчета МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И РасчетНалогаНаИмущество.ИФНС В (&НалоговыйКомитет)
		|";

		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		
		НомерТекущегоКвартала = Цел((Месяц(ПараметрыОтчета.мДатаКонцаПериодаОтчета) - 1) / 3) + 1;
		КоличествоОставшихсяПериодовПлатежа = 4 - НомерТекущегоКвартала + 1;
		
		Пока Выборка.Следующий() Цикл
			
			ОбщаяСумма = Окр(Выборка.СуммаИзмененияНалога,0);
			// сумму платежа за последний месяц считаем таким способом, чтобы избежать ошибок округления
			СуммаПоСроку = Окр(ОбщаяСумма/КоличествоОставшихсяПериодовПлатежа);
			СуммаВПоследнийМесяц = Окр(ОбщаяСумма - (СуммаПоСроку*(КоличествоОставшихсяПериодовПлатежа - 1)));
			Если НомерТекущегоКвартала = 1 Тогда
				Контейнер.Форма70101Страница1.П000210410101 = Контейнер.Форма70101Страница1.П000210410101 + СуммаПоСроку;
			КонецЕсли;
			Если НомерТекущегоКвартала <= 2 Тогда
				Контейнер.Форма70101Страница1.П000210410102 = Контейнер.Форма70101Страница1.П000210410102 + СуммаПоСроку;
			КонецЕсли;
			Если НомерТекущегоКвартала <= 3 Тогда
				Контейнер.Форма70101Страница2.П000210410103 = Контейнер.Форма70101Страница2.П000210410103 + СуммаПоСроку;
			КонецЕсли;
			Контейнер.Форма70101Страница2.П000210410104 = Контейнер.Форма70101Страница2.П000210410104 + СуммаВПоследнийМесяц;
			
			// Итоговая сумма текущих платежей
