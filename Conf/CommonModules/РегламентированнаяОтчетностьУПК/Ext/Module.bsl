			Контейнер.Форма700_02[НомерЛиста].Страница1[0].Значение.Вставить("СтрПриложение02", Формат(НомерЛиста+1,"ЧЦ=3; ЧВН="));
			
			МестонахождениеУчастка = СокрЛП(Выборка.Расположение);
			Контейнер.Форма700_02[НомерЛиста].Страница1[0].Значение.Вставить("П000210001101",СокрЛП(Лев(МестонахождениеУчастка, 27)));
