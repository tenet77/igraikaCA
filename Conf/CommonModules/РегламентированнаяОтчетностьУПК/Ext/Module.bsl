	|	ВТ_ИтогиЗемля.НалоговаяЛьготаПоНалоговойБазе,
	|	ВТ_ИтогиЗемля.ДоляНеоблагаемойПлощадиЧислитель,
	|	ВТ_ИтогиЗемля.ДоляНеоблагаемойПлощадиЗнаменатель,
	|	ВТ_ИтогиЗемля.НалоговаяБаза,
	|	ВТ_ИтогиЗемля.КоличествоМесяцевВладения КАК П000220000507,
	|	ВТ_ИтогиЗемля.КоличествоМесяцевПримененияЛьготы,
	|	ВТ_ИтогиЗемля.НалоговаяСтавка,
	|	ВТ_ИтогиЗемля.КодНалоговойЛьготыОсвобождениеОтНалогообложенияПоСтатье395,
	|	ВТ_ИтогиЗемля.СуммаНалоговойЛьготыВВидеУменьшенияСуммыНалога,
	|	ВТ_ИтогиЗемля.СуммаНалоговойЛьготыВВидеСниженияНалоговойСтавки,
	|	ВТ_ИтогиЗемля.ПредставлениеНалоговойЛьготы,
	|	ВТ_ИтогиЗемля.СуммаНалогаКУплате,
	|	ВТ_ИтогиЗемля.СниженнаяНалоговаяСтавка,
	|	ВТ_ИтогиЗемля.ПроцентУменьшенияСуммыНалога,
	|	ВТ_ИтогиЗемля.КорректировкаБазовойСтавкиНалога КАК П000220000503,
	|	ВТ_ИтогиЗемля.КорректировкаБазовойСтавкиНалогаНаТерриторияхСЭЗ КАК П000220000504,
	|	ВТ_ИтогиЗемля.КорректировкаБазовойСтавкиНалогаПоРешениюМестныхОрганов КАК П000220000502,
	|	ВТ_ИтогиЗемля.ПлощадьНеОблагаемая,
	|	ВТ_ИтогиЗемля.ПлощадьОблагаемая  КАК П000210000505,
	|	ВЫБОР
	|		КОГДА ПОДСТРОКА(ВТ_ИтогиЗемля.ЕдиницаИзмерения.Наименование, 1, 2) = ""га""
	|			ТОГДА ""Х""
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК П000210000503,
	|	ВЫБОР
	|		КОГДА НЕ ПОДСТРОКА(ВТ_ИтогиЗемля.ЕдиницаИзмерения.Наименование, 1, 2) = ""га""
	|			ТОГДА ""Х""
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК П000210000504,
	|	ВТ_ИтогиЗемля.ПроцентИзмененияБазовойСтавкиНалога КАК П000210000507,
	|	ВТ_ИтогиЗемля.СуммаИзмененияНалога,
	|	ВТ_ИтогиЗемля.ПлощадьНеОблагаемая + ВТ_ИтогиЗемля.ПлощадьОблагаемая,
	|	ЕстьNULL(ВТ_ИтогиЗемля.ОсновноеСредство.Расположение,"""") КАК Расположение
	|ИЗ
	|	ВТ_ИтогиЗемля КАК ВТ_ИтогиЗемля";
	
	#КонецОбласти 
	
	МассивРезультатовЗапроса = Запрос.ВыполнитьПакет();
	НалогНаТранспорт = МассивРезультатовЗапроса[3].Выбрать();
	НалогНаЗемлюКБК = МассивРезультатовЗапроса[4].Выбрать();
	НалогНаИмущество = МассивРезультатовЗапроса[5].Выбрать();
	Результат700_01 = МассивРезультатовЗапроса[6].Выбрать();
	Результат700_02 = МассивРезультатовЗапроса[7].Выбрать();
	
	Если НалогНаТранспорт.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Контейнер.Форма700_01Страница2, НалогНаТранспорт);
	КонецЕсли;
	Если НалогНаЗемлюКБК.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Контейнер.Форма700Страница1, НалогНаЗемлюКБК);
		ЗаполнитьЗначенияСвойств(Контейнер.Форма700_02Страница3, НалогНаЗемлюКБК);
	КонецЕсли;
	Если НалогНаИмущество.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Контейнер.Форма700Страница1, НалогНаИмущество);
		ЗаполнитьЗначенияСвойств(Контейнер.Форма700Страница2, НалогНаИмущество);
	КонецЕсли;
	
	//700.001
	Если Результат700_01.Количество()> 0 Тогда
		
		Выборка = Результат700_01;
		СтруктураСтавокНалога = СформироватьСтуктуруСтавокНалогаНаТранспорт(Год);
		//Шапка Страница 1
		Контейнер.Форма700Страница1.Вставить("КоличествоПриложений700_01", 1);
		Контейнер.Форма700Страница1.Вставить("Приложение01", "Х");
		Контейнер.Форма700_01Страница1.Вставить("ИИН_БИН", СведенияОбОрганизации.ИННЮЛ);
		//Контейнер.Форма700_01Страница1.Вставить("ИИН_БИНАкимат",СведенияОбОрганизации.);
		Контейнер.Форма700_01Страница1.Вставить("Год", Год);
		Контейнер.Форма700_01Страница1.Вставить("СтрПриложение01", "001");
		
		//Шапка Страница 2
		Контейнер.Форма700_01Страница2.Вставить("ИИН_БИН", СведенияОбОрганизации.ИННЮЛ);
		//Контейнер.Форма700_01Страница1.Вставить("ИИН_БИНАкимат",СведенияОбОрганизации.);
		Контейнер.Форма700_01Страница2.Вставить("Год", Год);
		
		//Табличная часть
		Пока Выборка.Следующий() Цикл
			
			КоличествоМесяцев = Выборка.КоличествоМесяцевВладения;
			
			Попытка
				МетаданныеЗначенияПеречисления = Метаданные.Перечисления["ВидыТранспортныхСредств"].ЗначенияПеречисления[Перечисления.ВидыТранспортныхСредств.Индекс(Выборка.КодВидаТранспортногоСредства)];
				ВидТранспортногоСредстваСтрока = СокрЛП(МетаданныеЗначенияПеречисления.Имя);
			Исключение
				ВидТранспортногоСредстваСтрока = "";
			КонецПопытки;
			
			ЗначениеПоказателя = Выборка.НалоговаяБаза;
			
			ИмяЯчейкиВидаТС = ПолучитьИмяЯчейкиВидаТС(Выборка.КодВидаТранспортногоСредства, ПараметрыОтчета.мДатаКонцаПериодаОтчета, ЗначениеПоказателя, Выборка, Выборка.ЕдиницаИзмерения);
			ИмяСтруктуры = "Форма700_01Страница1";
			
			Если Сред(ИмяЯчейкиВидаТС,6,1) = "1" Тогда
				ИмяСтруктуры ="Форма700_01Страница1";
			ИначеЕсли Сред(ИмяЯчейкиВидаТС,6,1) = "2" Тогда
				ИмяСтруктуры ="Форма700_01Страница2";
			КонецЕсли;
			
			// Подраздел 6.1
			Подраздел_6_1 = "До2013";
			Если ВидТранспортногоСредстваСтрока = "ЛегковойАвтомобиль" 
				И (ИмяЯчейкиВидаТС = "П0001100220"
				ИЛИ ИмяЯчейкиВидаТС = "П0001100230"
				ИЛИ ИмяЯчейкиВидаТС = "П0001100240"
				ИЛИ ИмяЯчейкиВидаТС = "П0001100250"
				ИЛИ ИмяЯчейкиВидаТС = "П0001100260") Тогда
				
				Подраздел_6_1 = "После2013";
				
			КонецЕсли;
			
			СуммаПревышения = 0;
			
			// Для легковых автомобилей рассчитываем размер превышения
			Если Выборка.КодВидаТранспортногоСредства = Перечисления.ВидыТранспортныхСредств.ЛегковойАвтомобиль Тогда
				СуммаПревышения = ПолучитьРазмерПревышенияПоОбъему(Выборка.КодВидаТранспортногоСредства, ЗначениеПоказателя, СтруктураСтавокНалога, Подраздел_6_1);
			КонецЕсли;
			
			// Для летательных аппаратов и ЖД - показываем суммарную мощность
			Если Выборка.КодВидаТранспортногоСредства = Перечисления.ВидыТранспортныхСредств.ЛетательныйАппарат
				ИЛИ Выборка.КодВидаТранспортногоСредства = Перечисления.ВидыТранспортныхСредств.ЖелезнодорожныйТяговыйПодвижнойСостав
				ИЛИ Выборка.КодВидаТранспортногоСредства = Перечисления.ВидыТранспортныхСредств.МотороВагонныйПодвижнойСостав Тогда
				
				// с накоплением
				
				Контейнер[ИмяСтруктуры][ИмяЯчейкиВидаТС + "03"] =  ЗначениеПоказателя + Контейнер[ИмяСтруктуры][ИмяЯчейкиВидаТС + "03"];
				
			ИначеЕсли Выборка.КодВидаТранспортногоСредства = Перечисления.ВидыТранспортныхСредств.ЛегковойАвтомобиль Тогда
				
				Если Контейнер[ИмяСтруктуры].Свойство(ИмяЯчейкиВидаТС + "03") Тогда
					Контейнер[ИмяСтруктуры][ИмяЯчейкиВидаТС + "03"] =  СуммаПревышения + Контейнер[ИмяСтруктуры][ИмяЯчейкиВидаТС + "03"];
				КонецЕсли;
				
			КонецЕсли;
			
			Контейнер[ИмяСтруктуры][ИмяЯчейкиВидаТС + "01"] = 1 + Контейнер[ИмяСтруктуры][ИмяЯчейкиВидаТС + "01"];
			Контейнер[ИмяСтруктуры][ИмяЯчейкиВидаТС + "02"] = Выборка.СуммаНалога + Контейнер[ИмяСтруктуры][ИмяЯчейкиВидаТС + "02"];
			Контейнер[ИмяСтруктуры][ИмяЯчейкиВидаТС + "04"] = КоличествоМесяцев + Контейнер[ИмяСтруктуры][ИмяЯчейкиВидаТС + "04"];
			
		КонецЦикла;
		
	КонецЕсли;
	
	//700.002
	Если Результат700_02.Количество()> 0 Тогда
		
		Выборка = Результат700_02;
		Счетчик = 4;
        Контейнер.Форма700Страница1.Вставить("КоличествоПриложений700_02", 1);
		Контейнер.Форма700Страница1.Вставить("Приложение02", "Х");
        Контейнер.Форма700_02Страница1_ДанныеДопСтрок.Очистить();
		Контейнер.Форма700_02Страница2_ДанныеДопСтрок.Очистить();
		Контейнер.Форма700_02Страница3_ДанныеДопСтрок.Очистить();
		
		Пока Выборка.Следующий() Цикл
			
			//Страница 1
			НоваяСтрока = Контейнер.Форма700_02Страница1_ДанныеДопСтрок.Добавить();
			НоваяСтрока.П000210000501 = Счетчик + 1; 
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
			//Страница 2
			НоваяСтрока = Контейнер.Форма700_02Страница2_ДанныеДопСтрок.Добавить();
			НоваяСтрока.П000220000501 = Счетчик + 1;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
			СтавкаСУчетомКорректировки = Окр((Выборка.НалоговаяСтавка + Выборка.НалоговаяСтавка * Выборка.П000210000507 / 100) *
			?(Выборка.П000220000502 = 0, 1, Выборка.П000220000502) *
			?(Выборка.П000220000503 = 0, 1, Выборка.П000220000503) *
			?(Выборка.П000220000504 = 0, 1, Выборка.П000220000504), 3);
			
			НоваяСтрока.П000220000506 = СтавкаСУчетомКорректировки;
			
			//Страница 3
			НоваяСтрока = Контейнер.Форма700_02Страница3_ДанныеДопСтрок.Добавить();
			НоваяСтрока.П000230000501 = Счетчик + 1;
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
			Счетчик = Счетчик + 1;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ПоместитьВоВременноеХранилище(Контейнер, ПараметрыОтчета.АдресВоВременномХранилище);
	
КонецПроцедуры

