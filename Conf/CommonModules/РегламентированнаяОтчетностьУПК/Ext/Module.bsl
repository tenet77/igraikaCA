#Область Форма700

Процедура ЗаполнитьФорма7002016Кв4(ПараметрыОтчета, Контейнер)
	
	//ОбщиеСведения 
	СтрокаСведений = "ИННЮЛ, НаимЮЛПол, ФИОРук";
	СведенияОбОрганизации = РегламентированнаяОтчетностьРК.ПолучитьСведенияОбОрганизации(ПараметрыОтчета.Организация,,СтрокаСведений);
	Год = Год (ПараметрыОтчета.мДатаКонцаПериодаОтчета);
	Год = Формат(Год,"ЧГ=0");
	ГоловнаяОрганизация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыОтчета.Организация,"ГоловнаяОрганизация");
	ГоловнаяОрганизация = ?(ЗначениеЗаполнено(ГоловнаяОрганизация),ГоловнаяОрганизация,ПараметрыОтчета.Организация);
	СведенияОГоловнойОрганизации = РегламентированнаяОтчетностьРК.ПолучитьСведенияОбОрганизации(ГоловнаяОрганизация,,"ИННЮЛ");
	
	Контейнер.Форма700Страница2.Вставить("КодНалоговогоОргана",ПараметрыОтчета.НалоговыйКомитет.Код);
	Контейнер.Форма700Страница2.Вставить("ДатаПодачи",ТекущаяДата());
	Контейнер.Форма700Страница2.Вставить("Руководитель",СведенияОбОрганизации.ФИОРук);
	
	//700.000
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Дата",             НачалоДня(ПараметрыОтчета.мДатаКонцаПериодаОтчета));
	Запрос.УстановитьПараметр("Организация",      ПараметрыОтчета.Организация);
	Запрос.УстановитьПараметр("НалоговыйКомитет", ПараметрыОтчета.НалоговыйКомитет);
	Запрос.УстановитьПараметр("ПустаяДата",       Дата(1,1,1));
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ЕСТЬNULL(РасчетТранспортногоНалога.СуммаНалога, 0) КАК СуммаНалога,
	|	ЕСТЬNULL(РасчетТранспортногоНалога.ИФНС, ЗНАЧЕНИЕ(Справочник.РегистрацииВНалоговомОргане.ПустаяСсылка)) КАК ИФНС,
	|	ЕСТЬNULL(РасчетТранспортногоНалога.СуммаАвансовыхПлатежей2Кв, 0) КАК СуммаАвансовыхПлатежей2Кв,
	|	РасчетТранспортногоНалога.ПериодРасчета,
	|	РасчетТранспортногоНалога.Организация,
	|	ЕСТЬNULL(РасчетТранспортногоНалога.КодПоОКТМО, """") КАК КодПоОКТМО,
	|	РасчетТранспортногоНалога.ОсновноеСредство,
	|	РасчетТранспортногоНалога.ДатаРегистрационныхДанных,
	|	ЕСТЬNULL(РасчетТранспортногоНалога.КодВидаТранспортногоСредства, ЗНАЧЕНИЕ(Перечисление.ВидыТранспортныхСредств.ПустаяСсылка)) КАК КодВидаТранспортногоСредства,
	|	ЕСТЬNULL(РасчетТранспортногоНалога.ИдентификационныйНомер, """") КАК ИдентификационныйНомер,
	|	ЕСТЬNULL(РасчетТранспортногоНалога.Марка, """") КАК Марка,
	|	ЕСТЬNULL(РасчетТранспортногоНалога.РегистрационныйЗнак, """") КАК РегистрационныйЗнак,
	|	ЕСТЬNULL(РасчетТранспортногоНалога.НалоговаяБаза, 0) КАК НалоговаяБаза,
	|	ЕСТЬNULL(РасчетТранспортногоНалога.ЕдиницаИзмерения, """") КАК ЕдиницаИзмерения,
	|	ЕСТЬNULL(РасчетТранспортногоНалога.КоличествоМесяцевВладения, 0) КАК КоличествоМесяцевВладения,
	|	ЕСТЬNULL(РасчетТранспортногоНалога.НалоговаяСтавка, 0) КАК НалоговаяСтавка,
	|	ЕСТЬNULL(РасчетТранспортногоНалога.КоличествоМесяцевЛьготы, 0) КАК КоличествоМесяцевЛьготы,
	|	ЕСТЬNULL(РасчетТранспортногоНалога.КодНалоговойЛьготы, """") КАК КодНалоговойЛьготы,
	|	ЕСТЬNULL(РасчетТранспортногоНалога.РегиональныйКодЛьготы, """") КАК РегиональныйКодЛьготы,
	|	ЕСТЬNULL(РасчетТранспортногоНалога.ПроцентУменьшения, 0) КАК ПроцентУменьшения,
	|	ЕСТЬNULL(РасчетТранспортногоНалога.ЛьготнаяСтавка, 0) КАК ЛьготнаяСтавка,
	|	ЕСТЬNULL(РасчетТранспортногоНалога.СуммаНалоговойЛьготы, 0) КАК СуммаНалоговойЛьготы,
	|	ЕСТЬNULL(РасчетТранспортногоНалога.СуммаНалогаКУплате, 0) КАК СуммаНалогаКУплате,
	|	ЕСТЬNULL(РасчетТранспортногоНалога.ЭкологическийКласс, """") КАК ЭкологическийКласс,
	|	ЕСТЬNULL(РасчетТранспортногоНалога.СуммаАвансовыхПлатежей1Кв, 0) КАК СуммаАвансовыхПлатежей1Кв,
	|	ЕСТЬNULL(РасчетТранспортногоНалога.СуммаАвансовыхПлатежей3Кв, 0) КАК СуммаАвансовыхПлатежей3Кв,
