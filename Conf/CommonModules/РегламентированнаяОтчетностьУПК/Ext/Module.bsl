				Если НомерТекущегоКвартала <= 3 Тогда
					Если Выборка.КБК = NULL ИЛИ СокрЛП(Выборка.КБК) = "104303" 
						ИЛИ СокрЛП(Выборка.КБК) = "104304" ИЛИ СокрЛП(Выборка.КБК) = "104305" 
						ИЛИ СокрЛП(Выборка.КБК) = "104306" ИЛИ СокрЛП(Выборка.КБК) = "104307" 
						ИЛИ	СокрЛП(Выборка.КБК) = "104308" ИЛИ СокрЛП(Выборка.КБК) = "104309" ИЛИ СокрЛП(Выборка.КБК) = "104302" Тогда
						
						Контейнер.Форма70101Страница2.П000210430203 = Контейнер.Форма70101Страница2.П000210430204 + СуммаПоСроку;
                        
                        //КБК не заполнен
						Если Выборка.КБК = NULL Тогда
							ВыборкаСтрока = Выборка.Выбрать();
							СообщитьОНеверномКБК(ВыборкаСтрока, Неопределено, "104302");
                        КонецЕсли;
                        
                        //КБК не равен "104302"
                        Если НЕ Выборка.КБК = "104302" И НЕ Выборка.КБК = NULL Тогда
                            ВыборкаСтрока = Выборка.Выбрать();
                            СообщитьОНеверномКБК(ВыборкаСтрока, Выборка.КБК, "104302");
                        КонецЕсли;
						
						//Другой КБК
					Иначе
						
						ВыборкаСтрока = Выборка.Выбрать();
						СообщитьОНеверномКБК(ВыборкаСтрока, Выборка.КБК);
						
					КонецЕсли;
					
				КонецЕсли;
				Если Выборка.КБК = NULL ИЛИ СокрЛП(Выборка.КБК) = "104303" 
						ИЛИ СокрЛП(Выборка.КБК) = "104304" ИЛИ СокрЛП(Выборка.КБК) = "104305" 
						ИЛИ СокрЛП(Выборка.КБК) = "104306" ИЛИ СокрЛП(Выборка.КБК) = "104307" 
						ИЛИ	СокрЛП(Выборка.КБК) = "104308" ИЛИ СокрЛП(Выборка.КБК) = "104309" ИЛИ СокрЛП(Выборка.КБК) = "104302" Тогда
					
					Контейнер.Форма70101Страница2.П000210430204 = Контейнер.Форма70101Страница2.П000210430204 + СуммаВПоследнийМесяц;
					Контейнер.Форма70101Страница2.П000210430205 = Контейнер.Форма70101Страница2.П000210430205 + ОбщаяСумма;
                    
                    //КБК не заполнен
					Если Выборка.КБК = NULL Тогда
						ВыборкаСтрока = Выборка.Выбрать();
						СообщитьОНеверномКБК(ВыборкаСтрока, Неопределено, "104302");
                    КонецЕсли; 
                    
                    //КБК не равен "104302"
                    Если НЕ Выборка.КБК = "104302" И НЕ Выборка.КБК = NULL Тогда
                        ВыборкаСтрока = Выборка.Выбрать();
                        СообщитьОНеверномКБК(ВыборкаСтрока, Выборка.КБК, "104302");
                    КонецЕсли;

					//Другой КБК
				Иначе
					
					ВыборкаСтрока = Выборка.Выбрать();
					СообщитьОНеверномКБК(ВыборкаСтрока, Выборка.КБК);
					
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		//+
		Если УчетПоМестнымБюджетам Тогда
			
			//На текущий момент, акимат указывается для налоговго комитета. Соответственно у всех объектов 
			//данного налогового комитета будет один и тот же БИН акимата. Поэтому запуск цикла не нужен. В многострочной части будет только одна строка
			Если ОбщСумма <> 0 Тогда 
			
				Счетчик = 1;
				Контейнер.Форма70101_001Страница1_ДанныеДопСтрок.Очистить();
				Контейнер.Форма70101_001Страница2_ДанныеДопСтрок.Очистить();
						
