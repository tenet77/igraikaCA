			//300.00.025II (300.00.023 х 300.00.007)
			Контейнер.Форма300Страница2.П000020025102 = (Контейнер.Форма300Страница2.П000020023002 / 100) * Контейнер.Форма300Страница1.П000010007002;
		КонецЕсли;
		
	Иначе 
		
		//300.00.025I (300.00.023)
		Контейнер.Форма300Страница2.П000020025202 = Контейнер.Форма300Страница2.П000020023002;
		
