			СуммаБезНДСОборот 	= СуммаБезНДСОборот + СтрокаТЗ.СуммаБезНДСОборот;
			Если СтрокаТЗ.ВидОборота = Перечисления.ВидыОборотовПоРеализации.Облагаемый Тогда 
				СуммаНДСОборот 		= СуммаНДСОборот + СтрокаТЗ.СуммаНДСОборот;
			ИначеЕсли СтрокаТЗ.ВидОборота = Перечисления.ВидыОборотовПоРеализации.Общий Тогда 
				СуммаНДСОборот = СуммаНДСОборот + (СтрокаТЗ.СуммаНДСОборот / 100) * Контейнер.Форма300Страница1.П000010007002;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	//300.06.010 А,В
	Контейнер.Форма300_06Страница1.П000610010002 = СуммаНДСОборот;
	//300.00.022 (Перенос значения из строки 300.06.010В)
	Контейнер.Форма300Страница2.П000020022002 = СуммаНДСОборот;
	
	//300.00.023 Общая сумма НДС, относимого в зачет, за исключением строки 300.00.024 (300.00.013В + 300.00.014В + 300.00.016ВI + 300.00.016ВII + 300.00.019В + 300.00.020В + 300.00.022)
	Контейнер.Форма300Страница2.П000020023002 = Контейнер.Форма300Страница2.П000020013002 + Контейнер.Форма300Страница2.П000020014002 + 
	Контейнер.Форма300Страница2.П000020016102 + Контейнер.Форма300Страница2.П000020016202 + Контейнер.Форма300Страница2.П000020019002 +
	Контейнер.Форма300Страница2.П000020020002 + Контейнер.Форма300Страница2.П000020022002;
	
	#КонецОбласти
	
	#Область Заполнение300_00_Страница3
	
	Если ПараметрыОтчета.МетодОтнесенияНДСВЗачет = "Пропорциональный" Тогда 
		
		Если Контейнер.Форма300Страница1.П000010006001 <> 0 И Контейнер.Форма300Страница1.П000010007002 = 0 Тогда
			Контейнер.Форма300Страница2.П000020025102 = 0;
		ИначеЕсли Контейнер.Форма300Страница1.П000010007002 = 0 Тогда
			Контейнер.Форма300Страница2.П000020025102 = Контейнер.Форма300Страница2.П000020023002;
