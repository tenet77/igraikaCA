Процедура ЗаполнитьФорма701012017Кв1(ПараметрыОтчета, Контейнер) Экспорт
	
	ДатаНачала 		= ПараметрыОтчета.мДатаНачалаПериодаОтчета;
	ДатаОкончания 	= ПараметрыОтчета.мДатаКонцаПериодаОтчета;
	
	Если ПараметрыОтчета.ВидРасчета = "Дополнительный" Тогда
		Если Месяц(ПараметрыОтчета.мДатаНачалаПериодаОтчета) = 1 Тогда
			ДатаНачала = ПараметрыОтчета.мДатаНачалаПериодаОтчета;
			// второй квартал
		ИначеЕсли Месяц(ПараметрыОтчета.мДатаНачалаПериодаОтчета) = 4 Тогда
			ДатаНачала = Дата(ПараметрыОтчета.мГод,2,1);
			// третий квартал
		ИначеЕсли Месяц(ПараметрыОтчета.мДатаНачалаПериодаОтчета) = 7 Тогда
			ДатаНачала = Дата(ПараметрыОтчета.мГод,5,1);
			// четвертый квартал
		ИначеЕсли Месяц(ПараметрыОтчета.мДатаНачалаПериодаОтчета) = 10 Тогда
			ДатаНачала = Дата(ПараметрыОтчета.мГод,8,1);
		КонецЕсли;
		
		ДатаОкончания = КонецМесяца(Дата(ПараметрыОтчета.мГод,Месяц(ПараметрыОтчета.мДатаНачалаПериодаОтчета),1));
		
	КонецЕсли;
	
	//Налог на имущество
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала",                 ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",              ДатаОкончания);
	Запрос.УстановитьПараметр("Организация",                ПараметрыОтчета.Организация);
	Запрос.УстановитьПараметр("НалоговыйКомитет",           ПараметрыОтчета.НалоговыйКомитет);
	Запрос.УстановитьПараметр("ГраницаНачалоПериодаОтчета", Новый Граница(НачалоМесяца(ДатаНачала), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("НачалоГода",                 НачалоГода(ДатаНачала));
	
	РеквизитыОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыОтчета.Организация, "РегистрацияВНалоговомОргане");
	Запрос.УстановитьПараметр("ОсновнойНалоговыйОрган",    РеквизитыОрганизации.РегистрацияВНалоговомОргане);
	
	Запрос.Текст = "
	|ВЫБРАТЬ
    |	СтавкиНалогаНаИмущество.Организация
    |ИЗ
    |	РегистрСведений.СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам.СрезПоследних(&ДатаОкончания, ) КАК СтавкиНалогаНаИмущество
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО СтавкиНалогаНаИмущество.Организация = Организации.Ссылка
    |ГДЕ
