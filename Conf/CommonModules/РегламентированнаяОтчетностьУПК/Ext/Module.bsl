    СчетаРасходовИНезавершенногоСтроительства.Добавить(ПланыСчетов.Хозрасчетный.Расходы);    					
	СчетаРасходовИНезавершенногоСтроительства.Добавить(ПланыСчетов.Хозрасчетный.СчетаПроизводственногоУчета); 	
 	
	Запрос.УстановитьПараметр("СчетаРасходовИНезавершенногоСтроительства", СчетаРасходовИНезавершенногоСтроительства);
    
    СчетаКапитальногоРемонтаОС = Новый СписокЗначений;
	СчетаКапитальногоРемонтаОС.Добавить(ПланыСчетов.Хозрасчетный.КапитальныйРемонтОС);   //2933
 	
	Запрос.УстановитьПараметр("СчетаКапитальногоРемонтаОС", СчетаКапитальногоРемонтаОС);
    
