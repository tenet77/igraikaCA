	Запрос.УстановитьПараметр("ПустаяДата",       		'00010101000000');
	Запрос.УстановитьПараметр("ПустоеЗначение", 		Неопределено);

#Область Форма100_00
		
    ВидСубконтоЗатрат = Новый Массив;
    ВидСубконтоЗатрат.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.СтатьиЗатрат);
