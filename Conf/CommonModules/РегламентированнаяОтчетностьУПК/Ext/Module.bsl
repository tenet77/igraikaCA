				Контейнер.Форма300Страница2.П000020013102 = Контейнер.Форма300Страница2.П000020013102 + Окр(ДанныеСтроки.СуммаНДСПоСФОбщий*Контейнер.Форма300Страница1.П000010007002/100);
				Контейнер.Форма300Страница2.П000020013202 = Контейнер.Форма300Страница2.П000020013202 + Окр(ДанныеСтроки.СуммаНДСПоИнымОбщий*Контейнер.Форма300Страница1.П000010007002/100);
