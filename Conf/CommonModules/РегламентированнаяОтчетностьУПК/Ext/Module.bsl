	Запрос.УстановитьПараметр("КонПериода",     		Новый Граница(КонецМесяца(ПараметрыОтчета.мДатаКонцаПериодаОтчета), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("КонПериодаДата",     	КонецДня(ПараметрыОтчета.мДатаКонцаПериодаОтчета));
	Запрос.УстановитьПараметр("Организация", 	  		ПараметрыОтчета.Организация);
