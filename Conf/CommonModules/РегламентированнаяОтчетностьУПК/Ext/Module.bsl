	|	РасчетТранспортногоНалога.СуммаНалога,
	|	РасчетТранспортногоНалога.ИФНС
	|ИЗ
	|	РегистрСведений.РасчетТранспортногоНалога КАК РасчетТранспортногоНалога
	|ГДЕ
	|	(РасчетТранспортногоНалога.Организация = &Организация ИЛИ РасчетТранспортногоНалога.Организация.ГоловнаяОрганизация = &Организация)
	|	И РасчетТранспортногоНалога.ИФНС = &НалоговыйКомитет
	|	И РасчетТранспортногоНалога.ПериодРасчета = &Дата";
	
	Выборка = Запрос.Выполнить();
	
	ТаблицаРасчетовТранспортногоНалога = Новый ТаблицаЗначений;
	Если Не Выборка.Пустой() Тогда
		ТаблицаРасчетовТранспортногоНалога = Выборка.Выгрузить();
	Иначе
		ТаблицаРасчетовТранспортногоНалога = РасчетИмущественныхНалогов.ПолучитьРасчетПоТранспортномуНалогу(ПараметрыОтчета.Организация, КонецИюня).Налог;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ТаблицаРасчетовТранспортногоНалога", ТаблицаРасчетовТранспортногоНалога);
	Запрос.Текст = 
	"ВЫБРАТЬ *
	|	Поместить ВТ_ТаблицаРасчетовТранспортногоНалога
	|	Из &ТаблицаРасчетовТранспортногоНалога КАК ТаблицаРасчетовТранспортногоНалога";
	Запрос.Выполнить();
		
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СУММА(ТаблицаРасчетовТранспортногоНалога.СуммаНалога) КАК СуммаНалога
	|ИЗ
	|	ВТ_ТаблицаРасчетовТранспортногоНалога КАК ТаблицаРасчетовТранспортногоНалога
	|ГДЕ
	|	ТаблицаРасчетовТранспортногоНалога.ИФНС = &НалоговыйКомитет";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл 
		
		Контейнер.Форма701Страница1.П000010001001 = Выборка.СуммаНалога;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьФорма7012019Кв1(ПараметрыОтчета, Контейнер) Экспорт
	
	КонецИюня = Дата(Год(ПараметрыОтчета.мДатаКонцаПериодаОтчета),6,30);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Дата",             КонецИюня);
	Запрос.УстановитьПараметр("Организация",      ПараметрыОтчета.Организация);
	СписокНалоговыхКомитетов = ПолучитьСписокНалоговыхКомитетов(ПараметрыОтчета.Организация, ПараметрыОтчета.НалоговыйКомитет);
	Запрос.УстановитьПараметр("НалоговыйКомитет", СписокНалоговыхКомитетов);
	
	Запрос.Текст = "ВЫБРАТЬ
	|	РасчетТранспортногоНалога.Организация,
	|	РасчетТранспортногоНалога.СуммаНалога,
	|	РасчетТранспортногоНалога.ИФНС
	|ИЗ
	|	РегистрСведений.РасчетТранспортногоНалога КАК РасчетТранспортногоНалога
	|ГДЕ
	|	(РасчетТранспортногоНалога.Организация = &Организация ИЛИ РасчетТранспортногоНалога.Организация.ГоловнаяОрганизация = &Организация)
	|   И РасчетТранспортногоНалога.ИФНС В (&НалоговыйКомитет)
	|	И РасчетТранспортногоНалога.ПериодРасчета = &Дата";
	
	Выборка = Запрос.Выполнить();
	
	ТаблицаРасчетовТранспортногоНалога = Новый ТаблицаЗначений;
	Если Не Выборка.Пустой() Тогда
		ТаблицаРасчетовТранспортногоНалога = Выборка.Выгрузить();
	Иначе
		ТаблицаРасчетовТранспортногоНалога = РасчетИмущественныхНалогов.ПолучитьРасчетПоТранспортномуНалогу(ПараметрыОтчета.Организация, КонецИюня).Налог;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ТаблицаРасчетовТранспортногоНалога", ТаблицаРасчетовТранспортногоНалога);
	Запрос.Текст = 
	"ВЫБРАТЬ *
	|	Поместить ВТ_ТаблицаРасчетовТранспортногоНалога
	|	Из &ТаблицаРасчетовТранспортногоНалога КАК ТаблицаРасчетовТранспортногоНалога";
	Запрос.Выполнить();
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Организация КАК Организация,
	|	ИФНС КАК НалоговыйКомитет,
	|	СУММА(ТаблицаРасчетовТранспортногоНалога.СуммаНалога) КАК СуммаНалога
	|ИЗ
	|	ВТ_ТаблицаРасчетовТранспортногоНалога КАК ТаблицаРасчетовТранспортногоНалога
	|ГДЕ 
	|	ТаблицаРасчетовТранспортногоНалога.ИФНС В (&НалоговыйКомитет) 
	|СГРУППИРОВАТЬ ПО 
	|	Организация,
	|	ИФНС";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Контейнер.Форма70100_001Страница1_ДанныеДопСтрок.Очистить();
	НомерСтроки = 2;
	
	Пока Выборка.Следующий() Цикл 
		
		Контейнер.Форма701Страница1.П000010001001 = Контейнер.Форма701Страница1.П000010001001 + Выборка.СуммаНалога;
		
		Если Выборка.Организация.УчетПоМестнымБюджетам Тогда
			//На текущий момент, акимат указывается для налоговго комитета. Соответственно у всех объектов 
			//данного налогового комитета будет один и тот же БИН акимата. Поэтому запуск цикла не нужен. В многострочной части будет только одна строка
			Если ЗначениеЗаполнено(Контейнер.Форма701Страница1.П000010001001) Тогда
				
				Акимат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выборка.НалоговыйКомитет, "МестныйБюджет");
				
				Если ЗначениеЗаполнено(Акимат) Тогда
					НоваяСтрока = Контейнер.Форма70100_001Страница1_ДанныеДопСтрок.Добавить();
					НоваяСтрока.П000110000201 = НомерСтроки;
					НоваяСтрока.П000110000202 = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Акимат, "ИНН");
					НоваяСтрока.П000110000203 = Выборка.СуммаНалога;
					НомерСтроки = НомерСтроки + 1;
				Иначе
					Контейнер.Форма70100_001Страница1.П000010001001 = Контейнер.Форма70100_001Страница1.П000010001001 + Выборка.СуммаНалога;
				КонецЕсли;	
			КонецЕсли
		Иначе
			Контейнер.Форма70100_001Страница1.П000010001001 = Контейнер.Форма70100_001Страница1.П000010001001 + Выборка.СуммаНалога;
		КонецЕсли;
		
	КонецЦикла;
 
КонецПроцедуры

#КонецОбласти

#Область Форма70101

Процедура ЗаполнитьФорма701012016Кв1(ПараметрыОтчета, Контейнер) Экспорт
	
	ДатаНачала 		= ПараметрыОтчета.мДатаНачалаПериодаОтчета;
	ДатаОкончания 	= ПараметрыОтчета.мДатаКонцаПериодаОтчета;
	
	Если ПараметрыОтчета.ВидРасчета = "Дополнительный" Тогда
		Если Месяц(ПараметрыОтчета.мДатаНачалаПериодаОтчета) = 1 Тогда
			ДатаНачала = ПараметрыОтчета.мДатаНачалаПериодаОтчета;
			// второй квартал
		ИначеЕсли Месяц(ПараметрыОтчета.мДатаНачалаПериодаОтчета) = 4 Тогда
			ДатаНачала = Дата(ПараметрыОтчета.мГод,2,1);
			// третий квартал
		ИначеЕсли Месяц(ПараметрыОтчета.мДатаНачалаПериодаОтчета) = 7 Тогда
			ДатаНачала = Дата(ПараметрыОтчета.мГод,5,1);
			// четвертый квартал
		ИначеЕсли Месяц(ПараметрыОтчета.мДатаНачалаПериодаОтчета) = 10 Тогда
			ДатаНачала = Дата(ПараметрыОтчета.мГод,8,1);
		КонецЕсли;
		
		ДатаОкончания = КонецМесяца(Дата(ПараметрыОтчета.мГод,Месяц(ПараметрыОтчета.мДатаНачалаПериодаОтчета),1));
		
	КонецЕсли;
	
	//Налог на имущество
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала",                 ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",              ДатаОкончания);
	Запрос.УстановитьПараметр("Организация",                ПараметрыОтчета.Организация);
	Запрос.УстановитьПараметр("НалоговыйКомитет",           ПараметрыОтчета.НалоговыйКомитет);
	Запрос.УстановитьПараметр("ГраницаНачалоПериодаОтчета", Новый Граница(НачалоМесяца(ДатаНачала), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("НачалоГода",                 НачалоГода(ДатаНачала));
	
	РеквизитыОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыОтчета.Организация, "РегистрацияВНалоговомОргане");
	Запрос.УстановитьПараметр("ОсновнойНалоговыйОрган",    РеквизитыОрганизации.РегистрацияВНалоговомОргане);
	
	
	//+
	Запрос.Текст = "
	|ВЫБРАТЬ
    |	СтавкиНалогаНаИмущество.Организация
    |ИЗ
    |	РегистрСведений.СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам.СрезПоследних(&ДатаОкончания, ) КАК СтавкиНалогаНаИмущество
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО СтавкиНалогаНаИмущество.Организация = Организации.Ссылка
    |ГДЕ
    |	СтавкиНалогаНаИмущество.НалоговыйОрган = &НалоговыйКомитет
	|	И (СтавкиНалогаНаИмущество.Организация = &Организация
	|	ИЛИ Организации.ГоловнаяОрганизация = &Организация)
	|";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	СписокОрганизаций = Новый Массив;
	Если Не РезультатЗапроса.Пустой() Тогда
		СписокОрганизаций = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Организация");
	КонецЕсли;
	СписокОрганизаций.Добавить(ПараметрыОтчета.Организация);
	
	Запрос.УстановитьПараметр("СписокОрганизаций", СписокОрганизаций);
	//-
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СостоянияОСОрганизаций.ОсновноеСредство КАК ОсновноеСредство,
	|	СостоянияОСОрганизаций.Организация КАК Организация,
	|	СостоянияОСОрганизаций.Состояние КАК Состояние
	|ПОМЕСТИТЬ ОСПринятыеКУчету
	|ИЗ
	//|	РегистрСведений.СостоянияОСОрганизаций.СрезПоследних(&ДатаОкончания, Организация = &Организация) КАК СостоянияОСОрганизаций
	|	РегистрСведений.СостоянияОСОрганизаций.СрезПоследних(&ДатаОкончания, Организация В (&СписокОрганизаций)) КАК СостоянияОСОрганизаций
	|ГДЕ
	|	(СостоянияОСОрганизаций.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПринятоКУчету)
	|			ИЛИ СостоянияОСОрганизаций.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияОС.СнятоСУчета))
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство,
	|	Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОС.Ссылка КАК ОсновноеСредство
	|ПОМЕСТИТЬ СписокРазрешенныхОС
	|ИЗ
	|	Справочник.ОбъектыЭксплуатации КАК ОС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОСПринятыеКУчету КАК ОСПринятыеКУчету
	|		ПО ОС.Ссылка = ОСПринятыеКУчету.ОсновноеСредство
	|ГДЕ
	|	ОС.Ссылка В
	|			(ВЫБРАТЬ
	|				ПервоначальныеСведения.ОсновноеСредство
	|			ИЗ
	|				РегистрСведений.ПервоначальныеСведенияОСБухгалтерскийУчет КАК ПервоначальныеСведения
	|			ГДЕ
	|				ПервоначальныеСведения.ОбъектИмущественногоНалога
	|				И ПервоначальныеСведения.Период < &ДатаОкончания
	//|				И ПервоначальныеСведения.Организация = &Организация)
	|				И ПервоначальныеСведения.Организация В (&СписокОрганизаций))
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОС.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследних.ПостановкаНаУчетВНалоговомОргане = ЗНАЧЕНИЕ(Перечисление.ПостановкаНаУчетВНалоговомОргане.ВДругомНалоговомОргане)
	|			ТОГДА СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследних.НалоговыйОрган
	|		ИНАЧЕ &ОсновнойНалоговыйОрган
	|	КОНЕЦ КАК НалоговыйКомитет,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследних.НалоговаяСтавка, 0) <> 0
	|			ТОГДА ВЫБОР
	|					КОГДА ЕСТЬNULL(СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследних.ДоляСтоимостиЧислитель, 0) <> 0
	|							И ЕСТЬNULL(СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследних.ДоляСтоимостиЗнаменатель, 0) <> 0
	|						ТОГДА ВЫБОР
	|								КОГДА СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследних.ДоляСтоимостиЧислитель / СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследних.ДоляСтоимостиЗнаменатель < 1
	|									ТОГДА СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследних.ДоляСтоимостиЧислитель / СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследних.ДоляСтоимостиЗнаменатель * СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследних.НалоговаяСтавка
	|								ИНАЧЕ СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследних.НалоговаяСтавка
	|							КОНЕЦ
	|					ИНАЧЕ СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследних.НалоговаяСтавка
	|				КОНЕЦ
	|		ИНАЧЕ ЕСТЬNULL(СтавкиНалогаНаИмуществоСрезПоследних.НалоговаяСтавка, 0)
	|	КОНЕЦ КАК НалоговаяСтавка,
	|	ВЫБОР
	|		КОГДА СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследних.ПорядокНалогообложения = ЗНАЧЕНИЕ(Перечисление.ПорядокНалогообложенияИмущества.НеПодлежитНалогообложению)
	|				ИЛИ СтавкиНалогаНаИмуществоСрезПоследних.ОсвобождениеОтНалогообложения = ИСТИНА
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК НеПодлежитНалогообложению
	|ПОМЕСТИТЬ СписокОС
	|ИЗ
	|	РегистрСведений.ПервоначальныеСведенияОСБухгалтерскийУчет.СрезПоследних(
	|			&ДатаОкончания,
	//|			Организация = &Организация
	|			Организация В (&СписокОрганизаций)
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						СписокРазрешенныхОС.ОсновноеСредство
	|					ИЗ
	|						СписокРазрешенныхОС КАК СписокРазрешенныхОС)) КАК ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствам.СрезПоследних(&ДатаОкончания, Организация В (&СписокОрганизаций)) КАК СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследних
	|			ПО ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство = СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследних.ОсновноеСредство
	//+
	|			И ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.Организация = СтавкиНалогаНаИмуществоПоОтдельнымОсновнымСредствамСрезПоследних.Организация,
	//-
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтавкиНалогаНаИмущество.СрезПоследних(&ДатаОкончания, Организация В (&СписокОрганизаций)) КАК СтавкиНалогаНаИмуществоСрезПоследних
	|			ПО ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.Организация = СтавкиНалогаНаИмуществоСрезПоследних.Организация
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство,
	|	ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СчетаБухгалтерскогоУчетаОССрезПоследних.ОсновноеСредство,
	|	СчетаБухгалтерскогоУчетаОССрезПоследних.Организация,
	|	СчетаБухгалтерскогоУчетаОССрезПоследних.СчетУчета,
	|	СчетаБухгалтерскогоУчетаОССрезПоследних.СчетНачисленияАмортизации
	|ПОМЕСТИТЬ ВТ_СчетаУчетаОС
	|ИЗ
	|	РегистрСведений.СчетаБухгалтерскогоУчетаОС.СрезПоследних(
	|			&ГраницаНачалоПериодаОтчета,
	|			Организация В (&СписокОрганизаций)
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						НалоговаяБаза.ОсновноеСредство
	|					ИЗ
	|						СписокОС КАК НалоговаяБаза)) КАК СчетаБухгалтерскогоУчетаОССрезПоследних
	|ГДЕ
