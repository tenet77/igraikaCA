	|	ЕСТЬNULL(ВТ_ПервоначальнаяСтоимостьОС.СуммаОстатокДт, 0) - ЕСТЬNULL(ВТ_АмортизацияОС.СуммаОстатокКт, 0) КАК БалансоваяСтоимость
	|ИЗ
	|	СписокОС КАК СписокОС
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПервоначальнаяСтоимостьОС КАК ВТ_ПервоначальнаяСтоимостьОС
	|		ПО СписокОС.ОсновноеСредство = ВТ_ПервоначальнаяСтоимостьОС.Субконто1
	//+
	|		И СписокОС.Организация = ВТ_ПервоначальнаяСтоимостьОС.Организация
	//-
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_АмортизацияОС КАК ВТ_АмортизацияОС
	|		ПО СписокОС.ОсновноеСредство = ВТ_АмортизацияОС.Субконто1
	//+
	|		И СписокОС.Организация = ВТ_АмортизацияОС.Организация
	//-
	|ГДЕ
	|	СписокОС.НалоговыйКомитет = &НалоговыйКомитет
	|	И СписокОС.НеПодлежитНалогообложению = ЛОЖЬ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если ПараметрыОтчета.ВидРасчета = "Очередной" Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			// сумму платежа за последний месяц считаем таким способом, чтобы избежать ошибок округления
			//ОбщаяСумма = Окр(Выборка.БалансоваяСтоимость * Выборка.НалоговаяСтавка /100,0);
			ОбщаяСумма = (Выборка.БалансоваяСтоимость * Выборка.НалоговаяСтавка)/100;
			СуммаВМесяц = Окр(ОбщаяСумма/4);
			СуммаВПоследнийМесяц = Окр(ОбщаяСумма - (СуммаВМесяц*3));
			
			
			Контейнер.Форма70101Страница2.П000210410101 = Контейнер.Форма70101Страница2.П000210410101 + СуммаВМесяц;
			Контейнер.Форма70101Страница2.П000210410102 = Контейнер.Форма70101Страница2.П000210410102 + СуммаВМесяц;
			Контейнер.Форма70101Страница2.П000210410103 = Контейнер.Форма70101Страница2.П000210410103 + СуммаВМесяц;
			Контейнер.Форма70101Страница2.П000210410104 = Контейнер.Форма70101Страница2.П000210410104 + СуммаВПоследнийМесяц;
			Контейнер.Форма70101Страница2.П000210410105 = Контейнер.Форма70101Страница2.П000210410105 + ОбщаяСумма;
			
		КонецЦикла;
		
	Иначе 
		
		Запрос.Текст = "
		//|ВЫБРАТЬ 
		//|	СписокОС.ОсновноеСредство,
		//|	СписокОС.Организация,
		//|	ЕСТЬNULL(РасчетНалогаНаИмущество.СуммаИзмененияНалога, 0) КАК СуммаИзмененияНалога
		//|ИЗ
		//|	СписокОС КАК СписокОС
		//|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РасчетНалогаНаИмущество КАК РасчетНалогаНаИмущество
		//|		ПО СписокОС.ОсновноеСредство = РасчетНалогаНаИмущество.ОсновноеСредство
		//|		И СписокОС.Организация = РасчетНалогаНаИмущество.Организация
		//|ГДЕ
		//|	РасчетНалогаНаИмущество.ИФНС = &НалоговыйКомитет
		//|	И (РасчетНалогаНаИмущество.Организация = &Организация ИЛИ РасчетНалогаНаИмущество.Организация.ГоловнаяОрганизация = &Организация)
		//|	И РасчетНалогаНаИмущество.ПериодРасчета МЕЖДУ &ДатаНачала И &ДатаОкончания";
		//
		|ВЫБРАТЬ
		|	ЕСТЬNULL(РасчетНалогаНаИмущество.СуммаИзмененияНалога, 0) КАК СуммаИзмененияНалога
		//|	РасчетЗемельногоНалога.КБК КАК КБК,
		//|	РасчетЗемельногоНалога.ОсновноеСредство
		|ИЗ
		|	РегистрСведений.РасчетНалогаНаИмущество КАК РасчетНалогаНаИмущество
		|ГДЕ
		//|	(РасчетНалогаНаИмущество.Организация = &Организация ИЛИ РасчетНалогаНаИмущество.Организация.ГоловнаяОрганизация = &Организация)
		|	РасчетНалогаНаИмущество.ПериодРасчета МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И РасчетНалогаНаИмущество.ИФНС = &НалоговыйКомитет
		|";

		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		
		НомерТекущегоКвартала = Цел((Месяц(ПараметрыОтчета.мДатаКонцаПериодаОтчета) - 1) / 3) + 1;
		КоличествоОставшихсяПериодовПлатежа = 4 - НомерТекущегоКвартала + 1;
		
		Пока Выборка.Следующий() Цикл
			
			ОбщаяСумма = Окр(Выборка.СуммаИзмененияНалога,0);
			// сумму платежа за последний месяц считаем таким способом, чтобы избежать ошибок округления
			СуммаПоСроку = Окр(ОбщаяСумма/КоличествоОставшихсяПериодовПлатежа);
			СуммаВПоследнийМесяц = Окр(ОбщаяСумма - (СуммаПоСроку*(КоличествоОставшихсяПериодовПлатежа - 1)));
			Если НомерТекущегоКвартала = 1 Тогда
				Контейнер.Форма70101Страница2.П000210410101 = Контейнер.Форма70101Страница2.П000210410101 + СуммаПоСроку;
			КонецЕсли;
			Если НомерТекущегоКвартала <= 2 Тогда
				Контейнер.Форма70101Страница2.П000210410102 = Контейнер.Форма70101Страница2.П000210410102 + СуммаПоСроку;
			КонецЕсли;
			Если НомерТекущегоКвартала <= 3 Тогда
				Контейнер.Форма70101Страница2.П000210410103 = Контейнер.Форма70101Страница2.П000210410103 + СуммаПоСроку;
			КонецЕсли;
			Контейнер.Форма70101Страница2.П000210410104 = Контейнер.Форма70101Страница2.П000210410104 + СуммаВПоследнийМесяц;
			
			// Итоговая сумма текущих платежей
			Контейнер.Форма70101Страница2.П000210410105 = Контейнер.Форма70101Страница2.П000210410105 + ОбщаяСумма;
			
		КонецЦикла;
		
	КонецЕсли;
	
	РеквизитыОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыОтчета.Организация, "РегистрацияВНалоговомОргане");
	
	//Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаОтчета",             Новый Граница(НачалоГода(ДатаНачала), ВидГраницы.Исключая));
	//Запрос.УстановитьПараметр("Организация",            ПараметрыОтчета.Организация);
	Запрос.УстановитьПараметр("НалоговыйОрганОсновной", РеквизитыОрганизации.РегистрацияВНалоговомОргане);
	Запрос.УстановитьПараметр("НалоговыйОрганОтчета",   ПараметрыОтчета.НалоговыйКомитет);
	//Запрос.УстановитьПараметр("ДатаНачала",             ДатаНачала);
	//Запрос.УстановитьПараметр("ДатаОкончания",          ДатаОкончания);
	
	//Земельный налог
	Если ПараметрыОтчета.ВидРасчета = "Очередной" Тогда
		
		Запрос.Текст = "ВЫБРАТЬ
		|	РегистрацияЗемельныхУчастковСрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
		|	РегистрацияЗемельныхУчастковСрезПоследних.КБК,
		|	РегистрацияЗемельныхУчастковСрезПоследних.ДоляВПравеОбщейСобственностиЧислитель,
		|	РегистрацияЗемельныхУчастковСрезПоследних.ДоляВПравеОбщейСобственностиЗнаменатель,
		|	РегистрацияЗемельныхУчастковСрезПоследних.ПлощадьОблагаемая,
		|	РегистрацияЗемельныхУчастковСрезПоследних.НалоговаяСтавка,
		|	РегистрацияЗемельныхУчастковСрезПоследних.ПроцентИзмененияБазовойСтавкиНалога,
		|	РегистрацияЗемельныхУчастковСрезПоследних.КорректировкаБазовойСтавкиНалога,
		|	РегистрацияЗемельныхУчастковСрезПоследних.КорректировкаБазовойСтавкиНалогаНаТерриторияхСЭЗ,
		|	РегистрацияЗемельныхУчастковСрезПоследних.КорректировкаБазовойСтавкиНалогаПоРешениюМестныхОрганов,
		|	ВЫБОР
		|		КОГДА РегистрацияЗемельныхУчастковСрезПоследних.ПостановкаНаУчетВНалоговомОргане = ЗНАЧЕНИЕ(Перечисление.ПостановкаНаУчетВНалоговомОргане.ПоМестуНахожденияОрганизации)
		|			ТОГДА &НалоговыйОрганОсновной
		|		ИНАЧЕ РегистрацияЗемельныхУчастковСрезПоследних.НалоговыйОрган
		|	КОНЕЦ КАК НалоговыйОрган
		|ПОМЕСТИТЬ ВТ_ЗемельныеУчастки
		|ИЗ
		|	РегистрСведений.РегистрацияЗемельныхУчастков.СрезПоследних(
		|			&ДатаОтчета,
		|			Организация В (&СписокОрганизаций)
		|				И ВключатьВНалоговуюБазу = ИСТИНА) КАК РегистрацияЗемельныхУчастковСрезПоследних
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ОсновноеСредство,
		|	НалоговыйОрган
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ЗемельныеУчастки.ОсновноеСредство,
		|	ВТ_ЗемельныеУчастки.КБК КАК КБК,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ВТ_ЗемельныеУчастки.ДоляВПравеОбщейСобственностиЧислитель, 0) <> 0
		|				И ЕСТЬNULL(ВТ_ЗемельныеУчастки.ДоляВПравеОбщейСобственностиЗнаменатель, 0) <> 0
		|			ТОГДА ВЫБОР
		|					КОГДА 1 > ВТ_ЗемельныеУчастки.ДоляВПравеОбщейСобственностиЧислитель / ВТ_ЗемельныеУчастки.ДоляВПравеОбщейСобственностиЗнаменатель
		|						ТОГДА ВТ_ЗемельныеУчастки.ДоляВПравеОбщейСобственностиЧислитель / ВТ_ЗемельныеУчастки.ДоляВПравеОбщейСобственностиЗнаменатель
		|					ИНАЧЕ 1
		|				КОНЕЦ
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК ДоляВПравеОбщейСобственности,
		|	ВТ_ЗемельныеУчастки.ПлощадьОблагаемая,
		|	(ЕСТЬNULL(ВТ_ЗемельныеУчастки.НалоговаяСтавка, 0) + ЕСТЬNULL(ВТ_ЗемельныеУчастки.ПроцентИзмененияБазовойСтавкиНалога, 0) * ЕСТЬNULL(ВТ_ЗемельныеУчастки.НалоговаяСтавка, 0) / 100) * ВЫБОР
		|		КОГДА ЕСТЬNULL(ВТ_ЗемельныеУчастки.КорректировкаБазовойСтавкиНалога, 0) = 0
		|			ТОГДА 1
		|		ИНАЧЕ ЕСТЬNULL(ВТ_ЗемельныеУчастки.КорректировкаБазовойСтавкиНалога, 0)
		|	КОНЕЦ * ВЫБОР
		|		КОГДА ЕСТЬNULL(ВТ_ЗемельныеУчастки.КорректировкаБазовойСтавкиНалогаНаТерриторияхСЭЗ, 0) = 0
		|			ТОГДА 1
		|		ИНАЧЕ ЕСТЬNULL(ВТ_ЗемельныеУчастки.КорректировкаБазовойСтавкиНалогаНаТерриторияхСЭЗ, 0)
		|	КОНЕЦ * ВЫБОР
		|		КОГДА ЕСТЬNULL(ВТ_ЗемельныеУчастки.КорректировкаБазовойСтавкиНалогаПоРешениюМестныхОрганов, 0) = 0
		|			ТОГДА 1
		|		ИНАЧЕ ЕСТЬNULL(ВТ_ЗемельныеУчастки.КорректировкаБазовойСтавкиНалогаПоРешениюМестныхОрганов, 0)
		|	КОНЕЦ КАК СтавкаНалогаСУчетомКорректировки
		|ПОМЕСТИТЬ ВТ_СуммаНалога
		|ИЗ
		|	ВТ_ЗемельныеУчастки КАК ВТ_ЗемельныеУчастки
