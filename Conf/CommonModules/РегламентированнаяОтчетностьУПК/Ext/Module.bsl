	Запрос.УстановитьПараметр("парамОрганизация", ПараметрыОтчета.Организация);
	Запрос.УстановитьПараметр("ВидСубконто"		, ВидСубконто);
	Запрос.УстановитьПараметр("ОсновныеНД"		, ПараметрыОтчета.ОсновныеНаправленияДеятельности);
	Запрос.УстановитьПараметр("НеучитыватьНД"	, Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетВнеоборотныхАктивовПоНаправлениямДеятельности"));
	
	Запрос.МенеджерВременныхТаблиц = втВнеоборотныйАктив;
	Если ПараметрыОтчета.ВключатьОбособленныеПодразделения Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Организация = &парамОрганизация", "Организация.ГоловнаяОрганизация = &парамОрганизация"); 
	КонецЕсли;	

	Если Не ЗапросПоНМА Тогда
		ПодСтрокаПоиска = "			ВЫБОР
			|				КОГДА ХозрасчетныйОстаткиИОборотыОС.Субконто2 В (&ПоступлениеФА)
			|					ТОГДА ХозрасчетныйОстаткиИОборотыОС.СуммаОборотДт
			|				ИНАЧЕ 0
			|			КОНЕЦ,";
		ПодСтрокаЗамены = " ХозрасчетныйОстаткиИОборотыОС.СуммаОборотДт,";
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, ПодСтрокаПоиска, ПодСтрокаЗамены); 
		
		ПодСтрокаПоиска = "			ВЫБОР
			|				КОГДА ХозрасчетныйОстаткиИОборотыОС.Субконто2 В (&ВыбытиеФА)
			|					ТОГДА ХозрасчетныйОстаткиИОборотыОС.СуммаОборотКт
			|				ИНАЧЕ 0
			|			КОНЕЦ,";
		ПодСтрокаЗамены = " ХозрасчетныйОстаткиИОборотыОС.СуммаОборотКт,";
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, ПодСтрокаПоиска, ПодСтрокаЗамены); 
		
	КонецЕсли;
	
	ПараметрыКлюча = Новый Структура("ВидАктиваНУ, ВидДвиженияСтоимостиНУ");
	
	ВидАктиваНУ = Новый Массив;
	ВидАктиваНУ.Добавить(Перечисления.ВидАктиваНУ.ФиксированныйАктив);
	ВидАктиваНУ.Добавить(Перечисления.ВидАктиваНУ.ФиксированныйАктивУчитываемыйОтдельно);
	
	ВидДвиженияСтоимостиНУ = Новый Массив;
	ВидДвиженияСтоимостиНУ.Добавить(Перечисления.ВидыДвиженияСтоимостиФА.Выбытие);
	
	ПараметрыКлюча.ВидАктиваНУ 				= ВидАктиваНУ;
	
	ПараметрыКлюча.ВидДвиженияСтоимостиНУ 	= ВидДвиженияСтоимостиНУ;
	ВыбытиеФА 								= ЗначениеКлючаАналитики(ПараметрыКлюча);
	
	ВидДвиженияСтоимостиНУ = Новый Массив;
	ВидДвиженияСтоимостиНУ.Добавить(Перечисления.ВидыДвиженияСтоимостиФА.Поступление);
	
	ПараметрыКлюча.ВидДвиженияСтоимостиНУ 	= ВидДвиженияСтоимостиНУ;
	ПоступлениеФА 							= ЗначениеКлючаАналитики(ПараметрыКлюча);
	
	//Запрос.УстановитьПараметр("ЗапросПоНМА"		, ЗапросПоНМА);
	Запрос.УстановитьПараметр("ПоступлениеФА"	, ПоступлениеФА);
	Запрос.УстановитьПараметр("ВыбытиеФА"		, ВыбытиеФА);
	
	Возврат Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
КонецФункции

Функция ЗначениеКлючаАналитики(ПараметрыАналитики) Экспорт

    МассивКлюченй = Новый Массив;
	
	Для Каждого ВидАктива ИЗ ПараметрыАналитики.ВидАктиваНУ Цикл
		Для Каждого ВидДвиженияСтоимости Из ПараметрыАналитики.ВидДвиженияСтоимостиНУ Цикл
			МенеджерЗаписи = РегистрыСведений.АналитикаУчетаВнеоборотныхАктивов.СоздатьМенеджерЗаписи();
		
			МенеджерЗаписи.ВидАктиваНУ = ВидАктива;
			МенеджерЗаписи.ВидДвиженияСтоимостиНУ = ВидДвиженияСтоимости;
			
			МенеджерЗаписи.Прочитать();
			Если МенеджерЗаписи.Выбран() Тогда
				МассивКлюченй.Добавить(МенеджерЗаписи.КлючАналитики);
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
	Возврат МассивКлюченй;

КонецФункции

//Получает временную таблиц основных средств
Функция Получить_втОсновныеСредства(ПараметрыОтчета)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство как ВнеоборотныйАктив,
	|	ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.КодПоОКОФ.КодКоф КАК КодКОФ,
	|	ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.Организация,
	|	СчетаБухгалтерскогоУчетаОССрезПоследних.СчетУчета,
	|	СчетаБухгалтерскогоУчетаОССрезПоследних.СчетНачисленияАмортизации
	|ПОМЕСТИТЬ втВнеоборотныйАктив
	|ИЗ
	|	РегистрСведений.ПервоначальныеСведенияОСБухгалтерскийУчет.СрезПоследних(&КонецПериода, Организация = &парамОрганизация) КАК ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СчетаБухгалтерскогоУчетаОС.СрезПоследних(&КонецПериода, Организация = &парамОрганизация) КАК СчетаБухгалтерскогоУчетаОССрезПоследних
	|		ПО ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.Организация = СчетаБухгалтерскогоУчетаОССрезПоследних.Организация
	|			И ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство = СчетаБухгалтерскогоУчетаОССрезПоследних.ОсновноеСредство
	|ГДЕ
	|	СчетаБухгалтерскогоУчетаОССрезПоследних.СчетУчета.Забалансовый = ЛОЖЬ
	|	И ВЫБОР
	|			КОГДА ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.ДоговорЛизинга <> ЗНАЧЕНИЕ(Справочник.ДоговорыЛизинга.ПустаяСсылка)
	|				ТОГДА ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.ДоговорЛизинга.ВариантУчетаИмущества = ЗНАЧЕНИЕ(Перечисление.ВариантыУчетаИмуществаПриЛизинге.Набалансе)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ";
	                                      
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Если ПараметрыОтчета.ВключатьОбособленныеПодразделения Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Организация = &парамОрганизация", "Организация.ГоловнаяОрганизация = &парамОрганизация"); 
	КонецЕсли;	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("НачалоПериода",    НачалоМесяца(ПараметрыОтчета.мДатаНачалаПериодаОтчета));
	Запрос.УстановитьПараметр("КонецПериода",     КонецМесяца(ПараметрыОтчета.мДатаКонцаПериодаОтчета));
	Запрос.УстановитьПараметр("парамОрганизация", ПараметрыОтчета.Организация);
	Результат = Запрос.Выполнить();
	Возврат МенеджерВременныхТаблиц;
КонецФункции

//Получает временную таблиц НМА
Функция Получить_втНМА(ПараметрыОтчета)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ПервоначальныеСведенияНМАБухгалтерскийУчетСрезПоследних.КодПоОКОФ.КодКоф КАК КодКОФ,
	|	ПервоначальныеСведенияНМАБухгалтерскийУчетСрезПоследних.Организация,
	|	СчетаБухгалтерскогоУчетаНМАСрезПоследних.СчетУчета,
	|	СчетаБухгалтерскогоУчетаНМАСрезПоследних.СчетНачисленияАмортизации,
	|	ПервоначальныеСведенияНМАБухгалтерскийУчетСрезПоследних.НематериальныйАктив КАК ВнеоборотныйАктив
	|ПОМЕСТИТЬ втВнеоборотныйАктив
	|ИЗ
	|	РегистрСведений.ПервоначальныеСведенияНМАБухгалтерскийУчет.СрезПоследних(&КонецПериода, Организация = &парамОрганизация) КАК ПервоначальныеСведенияНМАБухгалтерскийУчетСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СчетаБухгалтерскогоУчетаНМА.СрезПоследних(&КонецПериода, Организация = &парамОрганизация) КАК СчетаБухгалтерскогоУчетаНМАСрезПоследних
	|		ПО ПервоначальныеСведенияНМАБухгалтерскийУчетСрезПоследних.Организация = СчетаБухгалтерскогоУчетаНМАСрезПоследних.Организация
	|			И ПервоначальныеСведенияНМАБухгалтерскийУчетСрезПоследних.НематериальныйАктив = СчетаБухгалтерскогоУчетаНМАСрезПоследних.НематериальныйАктив
	|ГДЕ
	|	СчетаБухгалтерскогоУчетаНМАСрезПоследних.СчетУчета.Забалансовый = ЛОЖЬ";
	                                      
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Если ПараметрыОтчета.ВключатьОбособленныеПодразделения Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Организация = &парамОрганизация", "Организация.ГоловнаяОрганизация = &парамОрганизация"); 
	КонецЕсли;	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("НачалоПериода",    НачалоМесяца(ПараметрыОтчета.мДатаНачалаПериодаОтчета));
	Запрос.УстановитьПараметр("КонецПериода",     КонецМесяца(ПараметрыОтчета.мДатаКонцаПериодаОтчета));
	Запрос.УстановитьПараметр("парамОрганизация", ПараметрыОтчета.Организация);
	Результат = Запрос.Выполнить();
	Возврат МенеджерВременныхТаблиц;
КонецФункции

//Получаем информацию об ощей площади земельных участков
Функция ПолучитьИнформациюОбОбщейПлощади(ДатаАнализа, ПараметрыОтчета, втОсновныеСредства)
	ОбщаяПлощадь = 0;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	РегистрацияЗемельныхУчастковСрезПоследних.Организация,
	|	СУММА(ЕСТЬNULL(РегистрацияЗемельныхУчастковСрезПоследних.ПлощадьНеОблагаемая + РегистрацияЗемельныхУчастковСрезПоследних.ПлощадьОблагаемая, 0)) КАК ОбщаяПлощадь
	|ИЗ
	|	РегистрСведений.РегистрацияЗемельныхУчастков.СрезПоследних(
	|			&КонецПериода,
	|			ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						втВнеоборотныйАктив.ВнеоборотныйАктив
	|					ИЗ
	|						втВнеоборотныйАктив КАК втВнеоборотныйАктив
	|					ГДЕ
	|						втВнеоборотныйАктив.КодКОФ В (&КодКОФЗемля)
	|					СГРУППИРОВАТЬ ПО
	|						втВнеоборотныйАктив.ВнеоборотныйАктив)
	|				И Организация = &парамОрганизация) КАК РегистрацияЗемельныхУчастковСрезПоследних
	|
	|СГРУППИРОВАТЬ ПО
	|	РегистрацияЗемельныхУчастковСрезПоследних.Организация";
	
	Запрос.УстановитьПараметр("КонецПериода"	, ДатаАнализа);
	Запрос.УстановитьПараметр("парамОрганизация", ПараметрыОтчета.Организация);
	Запрос.УстановитьПараметр("КодКОФЗемля"		, ПараметрыОтчета.КодыКОФЗемли);
	Запрос.МенеджерВременныхТаблиц = втОсновныеСредства;
	Если ПараметрыОтчета.ВключатьОбособленныеПодразделения Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Организация = &парамОрганизация", "Организация.ГоловнаяОрганизация = &парамОрганизация"); 
	КонецЕсли;	
	ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
	Если ВыборкаЗапроса.Следующий() Тогда
		ОбщаяПлощадь = ВыборкаЗапроса.ОбщаяПлощадь
	КонецЕсли;	
	
	Возврат ОбщаяПлощадь;
КонецФункции	

//Получаем массив строк соответсвия кодов КОФ для заполнения отчета
Функция ПолучитьКодыСтрок(СоответствиеКодовКОФСтрокам, КодКоф) 
	
	Резт = "";
	Строки = Неопределено;
	Строки = СоответствиеКодовКОФСтрокам.Получить("к" + КодКоф);
	Если Строки <> Неопределено Тогда
		Резт = Строки;
	КонецЕсли;
	
	Возврат Резт;
	
КонецФункции

//Заполняем строку отчета
Процедура ЗаполнитьСтрокуЗначений(СоответствиеКодовКОФСтрокам, СтрокаТЗ, Контейнер, Ремонт = Ложь)
	
	КодыСтрок 	= ПолучитьКодыСтрок(СоответствиеКодовКОФСтрокам, СокрЛП(СтрокаТЗ.КодКОФ));
	
	Если ПустаяСтрока(КодыСтрок) Тогда			
		Для Каждого СтрокаОС Из СтрокаТЗ.Строки Цикл
			ТекстСообщения = НСтр("ru='Не корректно указан код КОФ для : %1'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Строка(СтрокаОС.ВнеоборотныйАктив));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, СтрокаОС.ВнеоборотныйАктив); 					
		КонецЦикла;
		Возврат;
	КонецЕсли;
	НомерРаздела2 = ?(СтрокаТЗ.ОсновнойНД, "2", "4");
	НомерРаздела3 = ?(СтрокаТЗ.ОсновнойНД, "3", "5");
	Раздел2 = Контейнер["Раздел" + НомерРаздела2];
	Раздел3 = Контейнер["Раздел" + НомерРаздела3];
	МассивКодКОФСтроки = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(КодыСтрок, ",") ;
	Для НомерСтрокиМассива = 0 По МассивКодКОФСтроки.Количество()-1 Цикл
		НомерСтроки = МассивКодКОФСтроки[НомерСтрокиМассива]; 
		ЗаписатьЗначениеЯчейки(Раздел2, ПолучитьИмяЯчейки(НомерРаздела2, НомерСтроки, "1") , СтрокаТЗ.ОстатокНаНачало);
		ЗаписатьЗначениеЯчейки(Раздел2, ПолучитьИмяЯчейки(НомерРаздела2, НомерСтроки, "2") , СтрокаТЗ.Приобретено);
		ЗаписатьЗначениеЯчейки(Раздел2, ПолучитьИмяЯчейки(НомерРаздела2, НомерСтроки, "3") , СтрокаТЗ.Дооценка);
		ЗаписатьЗначениеЯчейки(Раздел2, ПолучитьИмяЯчейки(НомерРаздела2, НомерСтроки, "4") , СтрокаТЗ.ПрочееПоступление);
		ЗаписатьЗначениеЯчейки(Раздел2, ПолучитьИмяЯчейки(НомерРаздела2, НомерСтроки, "5") , СтрокаТЗ.Списано);
		ЗаписатьЗначениеЯчейки(Раздел2, ПолучитьИмяЯчейки(НомерРаздела2, НомерСтроки, "7") , СтрокаТЗ.Уценка);
		ЗаписатьЗначениеЯчейки(Раздел2, ПолучитьИмяЯчейки(НомерРаздела2, НомерСтроки, "8") , СтрокаТЗ.ПрочееВыбытие);
		ЗаписатьЗначениеЯчейки(Раздел2, ПолучитьИмяЯчейки(НомерРаздела2, НомерСтроки, "11"), СтрокаТЗ.ОстатокНаКонецБаланс);
		
		ЗаписатьЗначениеЯчейки(Раздел3, ПолучитьИмяЯчейки(НомерРаздела3, НомерСтроки, "1") , СтрокаТЗ.Амортизация);
		ЗаписатьЗначениеЯчейки(Раздел3, ПолучитьИмяЯчейки(НомерРаздела3, НомерСтроки, "2") , СтрокаТЗ.ПолностьюАмартизировано);
		ЗаписатьЗначениеЯчейки(Раздел3, ПолучитьИмяЯчейки(НомерРаздела3, НомерСтроки, "3") , СтрокаТЗ.АмортизацияСписано);
		ЗаписатьЗначениеЯчейки(Раздел3, ПолучитьИмяЯчейки(НомерРаздела3, НомерСтроки, "4") , СтрокаТЗ.ТекущийРемонт);
		ЗаписатьЗначениеЯчейки(Раздел3, ПолучитьИмяЯчейки(НомерРаздела3, НомерСтроки, "5") , СтрокаТЗ.КапитальныйРемонт);
	КонецЦикла;	
КонецПроцедуры

//Записываем информацию в отчет
Процедура ЗаписатьЗначениеЯчейки(Раздел, ИмяЯчейки, Результат)
	Если Не Раздел.Свойство(ИмяЯчейки) Тогда
		ТекстСообщения = НСтр("ru='В отчете не найдена ячейка %1'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, СокрЛП(ИмяЯчейки));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	Иначе 
		Раздел[ИмяЯчейки] = Раздел[ИмяЯчейки] + Результат;
	КонецЕсли;	
КонецПроцедуры

//Получение имени ячейки отчета
Функция ПолучитьИмяЯчейки(РазделСтрокой, Строка, Столбец) Экспорт
	//Предпологается что длинна имяни ячейки 13 символов
	//Где первые 4 символа П000
	//3 символа номер раздела
	//3 символа номера строки
	//3 символа номера графы
	
	ИмяЯчейки = "";
	
	РазделСтрокой = СокрЛП(РазделСтрокой);
	Если СтрДлина(РазделСтрокой) = 3 Тогда
		
	ИначеЕсли СтрДлина(РазделСтрокой) < 3 Тогда
		РазделСтрокой = ?(СтрДлина(РазделСтрокой) = 1, "00", "0") + РазделСтрокой;
	Иначе
		ТекстСообщения = НСтр("ru='Не коректный номер раздела %1'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, СокрЛП(РазделСтрокой));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения); 
	КонецЕсли;	
	
	Строка = СокрЛП(Строка);
	Если СтрДлина(Строка) = 3 Тогда
		
	ИначеЕсли СтрДлина(Строка) < 3 Тогда
		Строка = ?(СтрДлина(Строка) = 1, "00", "0") + Строка;
	Иначе
		ТекстСообщения = НСтр("ru='Не коректный номер строки %1'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, СокрЛП(Строка));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения); 
	КонецЕсли;	
	
	Столбец = СокрЛП(Столбец);
	Если СтрДлина(Столбец) = 3 Тогда
		
	ИначеЕсли СтрДлина(Столбец) < 3 Тогда
		Столбец = ?(СтрДлина(Столбец) = 1, "00", "0") + Столбец;
	Иначе
		ТекстСообщения = НСтр("ru='Не коректный номер столбца %1'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, СокрЛП(Столбец));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения); 
	КонецЕсли;	
	
	ИмяЯчейки = "П000" + РазделСтрокой + Строка + Столбец;
	
	Возврат ИмяЯчейки;
	
КонецФункции	

//Заполняет данные отчет за 2016 Год  
Процедура ЗаполнитьФорма112016Кв4(ПараметрыОтчета, Контейнер) Экспорт
	//Получаем результат запроса
	втОсновныеСредства 				= Получить_втОсновныеСредства(ПараметрыОтчета);
	ВидСубконто 					= ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ОсновныеСредства;
	Раздел6 						= Контейнер.Раздел6;
	КодыКОФЗемли 					= ПараметрыОтчета.КодыКОФЗемли;
	РезультатЗапроса 				= ПолучитьРезультатЗапроса(ПараметрыОтчета, втОсновныеСредства, ВидСубконто, Ложь);
	НедоамортизированнаяСтоимость 	= 0;
	Для Каждого СтрокаНД Из РезультатЗапроса.Строки Цикл 
		Если СтрокаНД.ОсновнойНД тогда
			СоответствиеКодовКОФСтрокам = ПараметрыОтчета.СоответствиеКодовКОФСтрокам
		Иначе
			СоответствиеКодовКОФСтрокам = ПараметрыОтчета.СоответствиеКодовКОФСтрокамНеОНД
		КонецЕсли;	
		Для Каждого СтрокаТЗ Из СтрокаНД.Строки Цикл 
			Если Не ЗначениеЗаполнено(СтрокаТЗ.КодКоф)Тогда
				Для Каждого СтрокаОС Из СтрокаТЗ.Строки Цикл
					Если НЕ ЗначениеЗаполнено(СтрокаОС.ВнеоборотныйАктив) ТОгда
						Продолжить;
					КонецЕсли;	
					ТекстСообщения = НСтр("ru='Не указан код КОФ для: %1'");
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Строка(СтрокаОС.ВнеоборотныйАктив));
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, СтрокаОС.ВнеоборотныйАктив); 					
				КонецЦикла;
				Продолжить;
			КонецЕсли;
			Если КодыКОФЗемли.НайтиПоЗначению(СокрЛП(СтрокаТЗ.КодКОФ)) = Неопределено Тогда 
				ЗаполнитьСтрокуЗначений(СоответствиеКодовКОФСтрокам, СтрокаТЗ, Контейнер);
			Иначе
				Если ПараметрыОтчета.ВключатьЗемлюВ_Основные_разделы Тогда
					ЗаполнитьСтрокуЗначений(СоответствиеКодовКОФСтрокам, СтрокаТЗ, Контейнер);
				КонецЕсли;	
				Если СтрокаТЗ.КодКОФ = "114.000000" Тогда
					ЗаписатьЗначениеЯчейки(Раздел6, "П000061011001", СтрокаТЗ.ОстатокНаНачало);
					ЗаписатьЗначениеЯчейки(Раздел6, "П000061011002", СтрокаТЗ.ОстатокНаКонецБаланс);
				КонецЕсли;
				ЗаписатьЗначениеЯчейки(Раздел6, "П000061001001", СтрокаТЗ.ОстатокНаНачало);
				ЗаписатьЗначениеЯчейки(Раздел6, "П000061001002", СтрокаТЗ.ОстатокНаКонецБаланс);
			КонецЕсли;
			НедоамортизированнаяСтоимость = НедоамортизированнаяСтоимость + СтрокаТЗ.НедоамортизированнаяСтоимость;
		КонецЦикла;	
	КонецЦикла;
	//Заполняем НМА
	ВидСубконто 					= Новый Массив;
	ВидСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.НематериальныеАктивы);
	ВидСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ВидыАктиваИДвиженияСтоимостиНУ);
	втНМА 							= Получить_втНМА(ПараметрыОтчета);
	РезультатЗапроса 				= ПолучитьРезультатЗапроса(ПараметрыОтчета, втНМА, ВидСубконто, Истина);
	//НедоамортизированнаяСтоимость 	= 0;
	Для Каждого СтрокаНД Из РезультатЗапроса.Строки Цикл 	
		Если СтрокаНД.ОсновнойНД тогда
			СоответствиеКодовКОФСтрокам = ПараметрыОтчета.СоответствиеКодовКОФСтрокам
		Иначе
			СоответствиеКодовКОФСтрокам = ПараметрыОтчета.СоответствиеКодовКОФСтрокамНеОНД
		КонецЕсли;	
		
		Для Каждого СтрокаТЗ Из СтрокаНД.Строки Цикл
			Если Не ЗначениеЗаполнено(СтрокаТЗ.КодКоф)Тогда
				Для Каждого СтрокаОС Из СтрокаТЗ.Строки Цикл
					Если НЕ ЗначениеЗаполнено(СтрокаОС.ВнеоборотныйАктив) ТОгда
						Продолжить;
					КонецЕсли;	
					ТекстСообщения = НСтр("ru='Не указан код КОФ для: %1'");
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Строка(СтрокаОС.ВнеоборотныйАктив));
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, СтрокаОС.ВнеоборотныйАктив); 					
				КонецЦикла;
				Продолжить;
			КонецЕсли;	
			ЗаполнитьСтрокуЗначений(СоответствиеКодовКОФСтрокам, СтрокаТЗ, Контейнер);
			//НедоамортизированнаяСтоимость = НедоамортизированнаяСтоимость + СтрокаТЗ.НедоамортизированнаяСтоимость;
		КонецЦикла;	
	КонецЦикла;
	
	//Заполняем Раздел 6
	ЗаписатьЗначениеЯчейки(Раздел6, "П000060003001", НедоамортизированнаяСтоимость);
	
	//Заполняем количество организаций
	Если ПараметрыОтчета.ВключатьОбособленныеПодразделения Тогда 
		ПараметрыОтбора = Новый Структура("ГоловнаяОрганизация", ПараметрыОтчета.Организация);
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Организации.Ссылка) КАК Количество
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.ГоловнаяОрганизация = &ГоловнаяОрганизация";
		Запрос.УстановитьПараметр("ГоловнаяОрганизация",ПараметрыОтчета.Организация);
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		КоличествоОрганизаций = ?(РезультатЗапроса.Следующий(), РезультатЗапроса.Количество, 1);
	Иначе
		КоличествоОрганизаций =  1;
	КонецЕсли;	
	ЗаписатьЗначениеЯчейки(Раздел6, "П000060006001", КоличествоОрганизаций);
	
	//Получим незавершонное строительство
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ХозрасчетныйОстаткиИОбороты.СуммаНачальныйОстатокДт Как НЗСНачальное,
	|	ХозрасчетныйОстаткиИОбороты.СуммаКонечныйОстатокДт Как НЗСКонечное
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, , , Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.НезавершенноеСтроительство), 
	|			, Организация = &парамОрганизация) КАК ХозрасчетныйОстаткиИОбороты";
	
	Запрос.УстановитьПараметр("НачалоПериода"	, НачалоМесяца(ПараметрыОтчета.мДатаНачалаПериодаОтчета));
	Запрос.УстановитьПараметр("КонецПериода"	, КонецМесяца(ПараметрыОтчета.мДатаКонцаПериодаОтчета));
	Запрос.УстановитьПараметр("парамОрганизация", ПараметрыОтчета.Организация);
	Если ПараметрыОтчета.ВключатьОбособленныеПодразделения Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Организация = &парамОрганизация", "Организация.ГоловнаяОрганизация = &парамОрганизация"); 
	КонецЕсли;	
	
	ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
	Если ВыборкаЗапроса.Следующий() Тогда
		ЗаписатьЗначениеЯчейки(Раздел6, "П000061003001", ВыборкаЗапроса.НЗСНачальное);
		ЗаписатьЗначениеЯчейки(Раздел6, "П000061003002", ВыборкаЗапроса.НЗСКонечное);
	КонецЕсли;
	
	//Заполним информацию по площадям
	ЗаписатьЗначениеЯчейки(Раздел6, "П000061002001", ПолучитьИнформациюОбОбщейПлощади(НачалоДня(ПараметрыОтчета.мДатаНачалаПериодаОтчета), ПараметрыОтчета, втОсновныеСредства));
	ЗаписатьЗначениеЯчейки(Раздел6, "П000061002002", ПолучитьИнформациюОбОбщейПлощади(КонецДня(ПараметрыОтчета.мДатаКонцаПериодаОтчета), ПараметрыОтчета, втОсновныеСредства));
	
	
КонецПроцедуры

