	СчетаРасчетов.Добавить(ПланыСчетов.Хозрасчетный.КраткосрочнаяКредиторскаяЗадолженность);
	СчетаРасчетов.Добавить(ПланыСчетов.Хозрасчетный.КраткосрочныеОценочныеОбязательства);
	СчетаРасчетов.Добавить(ПланыСчетов.Хозрасчетный.ПрочиеКраткосрочныеОбязательства_);
	СчетаРасчетов.Добавить(ПланыСчетов.Хозрасчетный.ДолгосрочнаяКредиторскаяЗадолженность);
	СчетаРасчетов.Добавить(ПланыСчетов.Хозрасчетный.ДолгосрочныеОценочныеОбязательства);
	СчетаРасчетов.Добавить(ПланыСчетов.Хозрасчетный.ПрочиеДолгосрочныеОбязательства_);
	
