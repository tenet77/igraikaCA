#КонецОбласти

	//300.00.014 А
	Контейнер.Форма300Страница2.П000020014001 = Форма_300_05_СуммаОборот;
	
	//300.00.014 В
	Если ПараметрыОтчета.МетодОтнесенияНДСВЗачет = "Пропорциональный" ИЛИ ПараметрыОтчета.МетодОтнесенияНДСВЗачет = "ПропорцИРаздел" Тогда
		
