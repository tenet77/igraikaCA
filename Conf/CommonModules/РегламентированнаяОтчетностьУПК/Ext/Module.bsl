					ИЛИ СокрЛП(Выборка.КБК) = "104307" ИЛИ СокрЛП(Выборка.КБК) = "104308" 
					ИЛИ СокрЛП(Выборка.КБК) = "104309" Тогда
					
					Контейнер.Форма70101Страница2.П000210430901 = Контейнер.Форма70101Страница2.П000210430901 + СуммаПоСроку;
					
					//КБК не заполнен
					Если Выборка.КБК = NULL Тогда
						ВыборкаСтрока = Выборка.Выбрать();
						СообщитьОНеверномКБК(ВыборкаСтрока, Неопределено, "104309");
					КонецЕсли; 
					
					
				ИначеЕсли СокрЛП(Выборка.КБК) = "104302" Тогда
					
					Контейнер.Форма70101Страница2.П000210430201 = Контейнер.Форма70101Страница2.П000210430201 + СуммаПоСроку;
					
					//Другой КБК
				Иначе
					
					ВыборкаСтрока = Выборка.Выбрать();
					СообщитьОНеверномКБК(ВыборкаСтрока, Выборка.КБК);
					
				КонецЕсли;
				
			КонецЕсли;
			Если НомерТекущегоКвартала <= 2 Тогда
				Если Выборка.КБК = NULL ИЛИ СокрЛП(Выборка.КБК) = "104303" 
					ИЛИ СокрЛП(Выборка.КБК) = "104304" ИЛИ СокрЛП(Выборка.КБК) = "104305" 
					ИЛИ СокрЛП(Выборка.КБК) = "104306" ИЛИ СокрЛП(Выборка.КБК) = "104307" 
					ИЛИ	СокрЛП(Выборка.КБК) = "104308" ИЛИ СокрЛП(Выборка.КБК) = "104309" Тогда
					
					Контейнер.Форма70101Страница2.П000210430902 = Контейнер.Форма70101Страница2.П000210430902 + СуммаПоСроку;
					
					//КБК не заполнен
					Если Выборка.КБК = NULL Тогда
						ВыборкаСтрока = Выборка.Выбрать();
						СообщитьОНеверномКБК(ВыборкаСтрока, Неопределено, "104309");
					КонецЕсли; 
					
				ИначеЕсли СокрЛП(Выборка.КБК) = "104302" Тогда
					
					Контейнер.Форма70101Страница2.П000210430202 = Контейнер.Форма70101Страница2.П000210430202 + СуммаПоСроку;
					
					//Другой КБК
				Иначе
					
					ВыборкаСтрока = Выборка.Выбрать();
					СообщитьОНеверномКБК(ВыборкаСтрока, Выборка.КБК);
					
				КонецЕсли;
			КонецЕсли;
			Если НомерТекущегоКвартала <= 3 Тогда
				Если Выборка.КБК = NULL ИЛИ СокрЛП(Выборка.КБК) = "104303" 
					ИЛИ СокрЛП(Выборка.КБК) = "104304" ИЛИ СокрЛП(Выборка.КБК) = "104305" 
					ИЛИ СокрЛП(Выборка.КБК) = "104306" ИЛИ СокрЛП(Выборка.КБК) = "104307" 
					ИЛИ	СокрЛП(Выборка.КБК) = "104308" ИЛИ СокрЛП(Выборка.КБК) = "104309" Тогда
					
					Контейнер.Форма70101Страница2.П000210430903 = Контейнер.Форма70101Страница2.П000210430903 + СуммаПоСроку;
					
					//КБК не заполнен
					Если Выборка.КБК = NULL Тогда
						ВыборкаСтрока = Выборка.Выбрать();
						СообщитьОНеверномКБК(ВыборкаСтрока, Неопределено, "104309");
					КонецЕсли; 
					
				ИначеЕсли СокрЛП(Выборка.КБК) = "104302" Тогда
					
					Контейнер.Форма70101Страница2.П000210430203 = Контейнер.Форма70101Страница2.П000210430204 + СуммаПоСроку;
					
					//Другой КБК
				Иначе
					
					ВыборкаСтрока = Выборка.Выбрать();
					СообщитьОНеверномКБК(ВыборкаСтрока, Выборка.КБК);
					
				КонецЕсли;
				
			КонецЕсли;
			Если Выборка.КБК = NULL ИЛИ СокрЛП(Выборка.КБК) = "104303" 
					ИЛИ СокрЛП(Выборка.КБК) = "104304" ИЛИ СокрЛП(Выборка.КБК) = "104305" 
					ИЛИ СокрЛП(Выборка.КБК) = "104306" ИЛИ СокрЛП(Выборка.КБК) = "104307" 
