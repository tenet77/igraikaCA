		Контейнер.Форма700_01Страница2.Вставить("ИИН_БИН",СведенияОбОрганизации.ИННЮЛ);
		Контейнер.Форма700_01Страница2.Вставить("Год",Год);
		
		Пока Выборка.Следующий() Цикл
			
