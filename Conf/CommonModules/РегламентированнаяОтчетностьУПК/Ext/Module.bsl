		ЗначениеПоступления = Окр(Строка.Поступление);
		Если Контейнер.Форма100_02Страница1.Свойство("П000210002"+Номер + "01") = Истина Тогда
			Контейнер.Форма100_02Страница1["П000210002"+Номер+"01"] = ЗначениеПоступления;
		КонецЕсли;
		
		ЗначениеВыбытие = Окр(Строка.Выбытие);
		Если Контейнер.Форма100_02Страница1.Свойство("П000210003"+Номер+ "01") = Истина Тогда
			Контейнер.Форма100_02Страница1["П000210003"+Номер+"01"] = ЗначениеВыбытие;
		КонецЕсли;
		
		УвеличениеСтоимостиЗаСчетРемонта = Окр(Строка.УвеличениеСтоимостиЗаСчетРемонта);
		Если Контейнер.Форма100_02Страница1.Свойство("П000210004"+Номер+"01") = Истина Тогда
			Контейнер.Форма100_02Страница1["П000210004"+Номер+"01"] = УвеличениеСтоимостиЗаСчетРемонта;
		КонецЕсли;
		
		ЗначениеАмортизация = Окр(Строка.АмортизацияНачисленная);
		Если Контейнер.Форма100_02Страница2.Свойство("П000220006"+Номер+"01") = Истина Тогда
			Контейнер.Форма100_02Страница2["П000220006"+Номер+"01"] = ЗначениеАмортизация;
		КонецЕсли;
		
		ЗначениеСписаниеБалансаВыбывших = Окр(Строка.СписаниеБалансаВыбывших);
		Если Контейнер.Форма100_02Страница2.Свойство("П000220008"+Номер+"01") = Истина Тогда
			Контейнер.Форма100_02Страница2["П000220008"+Номер+"01"] = ЗначениеСписаниеБалансаВыбывших;
		КонецЕсли;
		
		ЗначениеСписаниеБалансаМененееМинимума = Окр(Строка.СписаниеБалансаМененееМинимума);
		Если Контейнер.Форма100_02Страница2.Свойство("П000220009"+Номер+"01") = Истина Тогда
			Контейнер.Форма100_02Страница2["П000220009"+Номер+"01"] = ЗначениеСписаниеБалансаМененееМинимума;
		КонецЕсли;
		
		ЗначениеРасходыНаТекущийРемонт = Окр(Строка.РасходыНаТекущийРемонт);
		Если Контейнер.Форма100_02Страница3.Свойство("П000230010"+Номер+"01") = Истина Тогда
			Контейнер.Форма100_02Страница3["П000230010"+Номер+ "01"] = ЗначениеРасходыНаТекущийРемонт;
		КонецЕсли;
		        	
		//КонечныйОстаток = ?(Строка.КонечныйОстаток <> Null,Строка.КонечныйОстаток,0);
		//
		//Если КонечныйОстаток < 0 Тогда 
		//	КонечныйОстаток = - КонечныйОстаток;
		//КонецЕсли;
		
		
 	КонецЦикла;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаДвойнаяАмортизацияФА();
	
	//Запрос.УстановитьПараметр("ДатаОкончания1ГодНазад", 	ДобавитьМесяц(ПараметрыОтчета.мДатаКонцаПериодаОтчета,-12));
	//Запрос.УстановитьПараметр("ДатаОкончания2ГодаНазад", 	ДобавитьМесяц(ПараметрыОтчета.мДатаКонцаПериодаОтчета,-24));
	
	Запрос.УстановитьПараметр("ДатаНачала", 				НачалоМесяца(ПараметрыОтчета.мДатаНачалаПериодаОтчета));
	Запрос.УстановитьПараметр("ДатаОкончания", 				ПараметрыОтчета.мДатаКонцаПериодаОтчета);
	Запрос.УстановитьПараметр("ПустаяГруппаНУ",				Перечисления.АмортизационныеГруппы.ПустаяСсылка());	
	Запрос.УстановитьПараметр("ПустаяОрганизация",			Справочники.Организации.ПустаяСсылка());	
	Запрос.УстановитьПараметр("СписокОрганизаций", 			СписокОрганизаций);

	Запрос.УстановитьПараметр("ВключенВСоставГруппы",		Перечисления.СобытияФАУчитываемыхОтдельно.ВключениеВСоставГруппы);	    
	Запрос.УстановитьПараметр("Выбыл",						Перечисления.ВидыСостоянийФА.Выбыл);
	Запрос.УстановитьПараметр("ФаОтдельно_ПринятКУчету",	Перечисления.СобытияФАУчитываемыхОтдельно.ПринятиеКУчету);
	Запрос.УстановитьПараметр("ДвойнаяНорма",				Перечисления.ВидыФАУчитываемыхОтдельно.ДвойнаяНормаАмортизации);
	Запрос.УстановитьПараметр("ПорядокПогашенияДвойнаяНорма", Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизацииПоДвойнойНорме);

	Результат = Запрос.Выполнить();
	ТаблицаОтчета = Результат.Выгрузить();
	
	Для Каждого Строка Из ТаблицаОтчета Цикл
		Если Строка.ГруппаНУ = Перечисления.АмортизационныеГруппы.ПерваяГруппа Тогда
			Номер = 1;
		ИначеЕсли Строка.ГруппаНУ = Перечисления.АмортизационныеГруппы.ВтораяГруппа Тогда
			Номер = 2;
		ИначеЕсли Строка.ГруппаНУ = Перечисления.АмортизационныеГруппы.ТретьяГруппа Тогда
			Номер = 3;
		ИначеЕсли Строка.ГруппаНУ = Перечисления.АмортизационныеГруппы.ЧетвертаяГруппа Тогда
			Номер = 4;
		Иначе
			Номер = 5; //условно поставим знчение
		КонецЕсли;
		
		// Проверим, что преобразованный номер входит в наш диапазон
		Если Номер < 1 Или Номер > 4 Тогда 
			
			Продолжить;;
			
		КонецЕсли;
		
		АмортизацияНачисленная = Окр(Строка.АмортизацияНачисленная);
		Если Контейнер.Форма100_02Страница2.Свойство("П000220007"+Номер + "01") = Истина Тогда
			Контейнер.Форма100_02Страница2["П000220007" + Номер + "01"] = АмортизацияНачисленная;
		КонецЕсли;
					
	КонецЦикла;	
#КонецОбласти

	ПоместитьВоВременноеХранилище(Контейнер, ПараметрыОтчета.АдресВоВременномХранилище);

КонецПроцедуры

Процедура ЗаполнитьФорма1002018Кв4(ПараметрыОтчета, Контейнер) Экспорт
	
	ДатаНачала 		= ПараметрыОтчета.мДатаНачалаПериодаОтчета;
	ДатаОкончания 	= ПараметрыОтчета.мДатаКонцаПериодаОтчета;
	
	Запрос = Новый Запрос;
