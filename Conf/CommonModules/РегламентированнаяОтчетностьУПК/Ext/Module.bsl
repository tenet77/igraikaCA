		|";

		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		
		НомерТекущегоКвартала = Цел((Месяц(ПараметрыОтчета.мДатаКонцаПериодаОтчета) - 1) / 3) + 1;
		КоличествоОставшихсяПериодовПлатежа = 4 - НомерТекущегоКвартала + 1;
		
		Пока Выборка.Следующий() Цикл
			
			ОбщаяСумма = Окр(Выборка.СуммаИзмененияНалога,0);
			// сумму платежа за последний месяц считаем таким способом, чтобы избежать ошибок округления
			СуммаПоСроку = Окр(ОбщаяСумма/КоличествоОставшихсяПериодовПлатежа);
			СуммаВПоследнийМесяц = Окр(ОбщаяСумма - (СуммаПоСроку*(КоличествоОставшихсяПериодовПлатежа - 1)));
			Если НомерТекущегоКвартала = 1 Тогда
				Контейнер.Форма70101Страница1.П000210410101 = Контейнер.Форма70101Страница1.П000210410101 + СуммаПоСроку;
			КонецЕсли;
			Если НомерТекущегоКвартала <= 2 Тогда
				Контейнер.Форма70101Страница1.П000210410102 = Контейнер.Форма70101Страница1.П000210410102 + СуммаПоСроку;
			КонецЕсли;
			Если НомерТекущегоКвартала <= 3 Тогда
				Контейнер.Форма70101Страница2.П000210410103 = Контейнер.Форма70101Страница2.П000210410103 + СуммаПоСроку;
			КонецЕсли;
			Контейнер.Форма70101Страница2.П000210410104 = Контейнер.Форма70101Страница2.П000210410104 + СуммаВПоследнийМесяц;
			
			// Итоговая сумма текущих платежей
			Контейнер.Форма70101Страница2.П000210410105 = Контейнер.Форма70101Страница2.П000210410105 + ОбщаяСумма;
		КонецЦикла;
		
	КонецЕсли;
	
	РеквизитыОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыОтчета.Организация, "РегистрацияВНалоговомОргане");
	
	Запрос.УстановитьПараметр("ДатаОтчета",             Новый Граница(НачалоГода(ДатаНачала), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("НалоговыйОрганОсновной", РеквизитыОрганизации.РегистрацияВНалоговомОргане);
	Запрос.УстановитьПараметр("НалоговыйОрганОтчета",   ПараметрыОтчета.НалоговыйКомитет);
	
	//Земельный налог
	Если ПараметрыОтчета.ВидРасчета = "Очередной" Тогда
		
		Запрос.Текст = "ВЫБРАТЬ
		|	РегистрацияЗемельныхУчастковСрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
		|	РегистрацияЗемельныхУчастковСрезПоследних.КБК,
		|	РегистрацияЗемельныхУчастковСрезПоследних.ДоляВПравеОбщейСобственностиЧислитель,
		|	РегистрацияЗемельныхУчастковСрезПоследних.ДоляВПравеОбщейСобственностиЗнаменатель,
		|	РегистрацияЗемельныхУчастковСрезПоследних.ПлощадьОблагаемая,
		|	РегистрацияЗемельныхУчастковСрезПоследних.НалоговаяСтавка,
		|	РегистрацияЗемельныхУчастковСрезПоследних.ПроцентИзмененияБазовойСтавкиНалога,
		|	РегистрацияЗемельныхУчастковСрезПоследних.КорректировкаБазовойСтавкиНалога,
		|	РегистрацияЗемельныхУчастковСрезПоследних.КорректировкаБазовойСтавкиНалогаНаТерриторияхСЭЗ,
		|	РегистрацияЗемельныхУчастковСрезПоследних.КорректировкаБазовойСтавкиНалогаПоРешениюМестныхОрганов,
		|	ВЫБОР
		|		КОГДА РегистрацияЗемельныхУчастковСрезПоследних.ПостановкаНаУчетВНалоговомОргане = ЗНАЧЕНИЕ(Перечисление.ПостановкаНаУчетВНалоговомОргане.ПоМестуНахожденияОрганизации)
		|			ТОГДА &НалоговыйОрганОсновной
		|		ИНАЧЕ РегистрацияЗемельныхУчастковСрезПоследних.НалоговыйОрган
		|	КОНЕЦ КАК НалоговыйОрган
