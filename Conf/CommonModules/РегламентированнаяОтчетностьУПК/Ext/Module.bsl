				НоваяСтрока = Контейнер.Форма70101_001Страница1_ДанныеДопСтрок.Добавить();
				НоваяСтрока.П000110000201 = Счетчик + 1;
				
				Акимат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыОтчета.НалоговыйКомитет, "МестныйБюджет");
				НоваяСтрока.П000110000202 = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Акимат, "ИНН");
				НоваяСтрока.П000110000203 = ?(НомерТекущегоКвартала = 1, СуммаКв1, 0);
				НоваяСтрока.П000110000204 = ?(НомерТекущегоКвартала <= 2, СуммаКв2, 0);
				НоваяСтрока.П000110000205 = ?(НомерТекущегоКвартала <= 3, СуммаКв3, 0);
				
				//Страница 2
				НоваяСтрока = Контейнер.Форма70101_001Страница2_ДанныеДопСтрок.Добавить();
				НоваяСтрока.П000120000201 = Счетчик + 1;
				НоваяСтрока.П000120000202 = ?(НомерТекущегоКвартала <= 4, СуммаКв4, 0);
				НоваяСтрока.П000120000203 = ОбщСумма;
										
			КонецЕсли;
		КонецЕсли;

		//-
	КонецЕсли;
	
	Контейнер.Форма70101Страница1.КоличествоПриложений = ?(УчетПоМестнымБюджетам,1,0);

КонецПроцедуры

Процедура СообщитьОНеверномКБК(Выборка,КБК, КБКОтражения = "104308")
	
	Если КБК = Неопределено Тогда
		Пока Выборка.Следующий() Цикл
			
			ТекстСообщения = "";
			
			Если ЗначениеЗаполнено(Выборка.СуммаНалога) Тогда
				
				ПараметрТекстСообщения = НСтр("ru = ' ""Код бюджетной классификации"", который указывается для вида земельного налога.'");
				
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Для объекта земельного налога ""%1"" в параметрах расчета не заполнены:
						|%3
						|Рассчитанная сумма земельного налога отражена в строке с Кодом бюджетной классификации ""%4"".'"),
					Выборка.ОбъектНалогообложения,
					ПараметрТекстСообщения, КБКОтражения);
				
			Иначе
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Для объекта земельного налога ""%1"" не рассчитана сумма налога. Проверьте параметры расчета.'"),
					Выборка.ОсновноеСредство);
			КонецЕсли;
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			
		КонецЦикла;
		
	Иначе //Другой КБК.
		
		Пока Выборка.Следующий() Цикл 
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Для объекта земельного налога ""%1"" указан Код бюджетной классификации ""%2"".
					|Сумма рассчитанного земельного налога для данного объекта налогообложения не отражена в форме.'"),
				Выборка.ОсновноеСредство,
				СокрЛП(КБК));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЦикла;
		
	КонецЕсли;
	
