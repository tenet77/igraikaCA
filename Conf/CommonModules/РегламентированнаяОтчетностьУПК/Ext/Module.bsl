			Если НомерЛиста = 0 И Контейнер.Форма700_02.Количество() = 1 Тогда
				НоваяСтрокаТаблицы = Контейнер.Форма700_02[0];
			Иначе
				НоваяСтрокаТаблицы = Контейнер.Форма700_02.Добавить();
			КонецЕсли;
			НоваяСтрокаТаблицы.Страница1.Добавить();
			НоваяСтрокаТаблицы.Страница1[0].Значение = Новый Структура;
			
