	СписокСчетовАктивов = Новый СписокЗначений;
	СписокСчетовАктивов.Добавить(ПланыСчетов.Хозрасчетный.Запасы); 		  			  	
	СписокСчетовАктивов.Добавить(ПланыСчетов.Хозрасчетный.КраткосрочныеРасходыБудущихПериодов); //1620
	СписокСчетовАктивов.Добавить(ПланыСчетов.Хозрасчетный.ПрочиеКраткосрочныеАктивы); // 1630
	СписокСчетовАктивов.Добавить(ПланыСчетов.Хозрасчетный.ДолгосрочныеРасходыБудущихПериодов);  //2920
	СписокСчетовАктивов.Добавить(ПланыСчетов.Хозрасчетный.ДолгосрочныеАктивыДляПродажи_);
	СписокСчетовАктивов.Добавить(ПланыСчетов.Хозрасчетный.МонтажОборудования); //2932
	
	Запрос.УстановитьПараметр("СписокСчетовАктивов", СписокСчетовАктивов); 	
	
	СчетаРасходовИНезавершенногоСтроительства = Новый СписокЗначений;
