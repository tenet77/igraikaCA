				Контейнер.Форма70101Страница2.П000210430904 = Контейнер.Форма70101Страница2.П000210430904 + СуммаВПоследнийМесяц;
				Контейнер.Форма70101Страница2.П000210430905 = Контейнер.Форма70101Страница2.П000210430905 + ОбщаяСумма;
				
				//КБК не заполнен
				Если Выборка.КБК = NULL Тогда
					ВыборкаСтрока = Выборка.Выбрать();
					СообщитьОНеверномКБК(ВыборкаСтрока, Неопределено, "104309");
