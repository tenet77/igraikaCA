			Контейнер.Форма300Страница2.П000020013202 = ДанныеСтроки.СуммаНДСПоИным;
			
			//Распределяем НДС по общему обороту реализации при раздельном учете
			Если ПараметрыОтчета.МетодОтнесенияНДСВЗачет = "Пропорциональный" Тогда
				Контейнер.Форма300Страница2.П000020013102 = Контейнер.Форма300Страница2.П000020013102 + ДанныеСтроки.СуммаНДСПоСФОбщий;
				Контейнер.Форма300Страница2.П000020013202 = Контейнер.Форма300Страница2.П000020013202 + ДанныеСтроки.СуммаНДСПоИнымОбщий;
