Функция ТекстЗапросаОбщиеРасходы() Экспорт

	ТекстЗапроса = "
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ХозрасчетныйОборотыПоЗатратам.Субконто1 КАК ДоходРасход,
    |	ЗНАЧЕНИЕ(Перечисление.ТипыЗатратРегл.Прочее) КАК ТипРасходов,
	|	ЕСТЬNULL(ХозрасчетныйОборотыПоЗатратам.СуммаНУОборотДт, 0) - ЕСТЬNULL(ХозрасчетныйОборотыПоЗатратам.СуммаНУОборотКт, 0) КАК Сумма
	|ПОМЕСТИТЬ ВТ_ОбщиеРасходы
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(
	|			&НачПериода,
	|			&КонПериода,
	|			,
	|			Счет В ИЕРАРХИИ (&СчетаРасходов) И НЕ Счет.Забалансовый И НЕ Счет В ИЕРАРХИИ (&СчетаПроизводственныхРасходов),
	|			&ВидСубконтоЗатрат,
	|			Организация В (ВЫБРАТЬ СписокОрганизаций.Ссылка ИЗ ВТ_СписокОрганизаций КАК СписокОрганизаций)
	|			И Субконто1 НЕ В (Выбрать СтатьиРемонтовИПреференций.СтатьяРасходов Из ВТ_СтатьиРемонтовИПреференций КАК СтатьиРемонтовИПреференций),
	|			НЕ КорСчет В ИЕРАРХИИ (&Счет000)
	|				И НЕ КорСчет В ИЕРАРХИИ (&СчетаРасходов),
	|			) КАК ХозрасчетныйОборотыПоЗатратам
	|    
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ХозрасчетныйОборотыПоЗатратам.Субконто2 = ЗНАЧЕНИЕ(Перечисление.ТипыЗатратРегл.СдельнаяОплатаТруда)
	|			ТОГДА ВЫБОР
	|					КОГДА ХозрасчетныйОборотыПоЗатратам.КорСчет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.СоциальныйНалог)
	|						ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыНалогов.СН)
	|					КОГДА ХозрасчетныйОборотыПоЗатратам.КорСчет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ОбязательстваПоСоциальномуСтрахованию)
	|						ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыНалогов.СО)
	|					КОГДА ХозрасчетныйОборотыПоЗатратам.КорСчет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ОбязательстваПоОтчислениямОСМС)
	|						ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыНалогов.ВОСМС)
	|					КОГДА ХозрасчетныйОборотыПоЗатратам.КорСчет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ОбязательныеПрофессиональныеПенсионныеВзносы)
	|						ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыНалогов.ОППВ)
	|					ИНАЧЕ НЕОПРЕДЕЛЕНО
	|				КОНЕЦ
    |		КОГДА ХозрасчетныйОборотыПоЗатратам.Субконто2 = ЗНАЧЕНИЕ(Перечисление.ТипыЗатратРегл.МатериальныеЗатраты)
    |           ТОГДА НЕОПРЕДЕЛЕНО
    |		ИНАЧЕ ХозрасчетныйОборотыПоЗатратам.Субконто1
	|	КОНЕЦ,
	|	ХозрасчетныйОборотыПоЗатратам.Субконто2,
	|	ЕСТЬNULL(ХозрасчетныйОборотыПоЗатратам.СуммаНУОборотДт, 0) - ЕСТЬNULL(ХозрасчетныйОборотыПоЗатратам.СуммаНУОборотКт, 0)
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(
	|			&НачПериода,
	|			&КонПериода,
	|			,
	|			Счет В ИЕРАРХИИ (&СчетаПроизводственныхРасходов)
	|				И НЕ Счет.Забалансовый,
	|			&ВидСубконтоПроизводственныхЗатрат,
	|			Организация В
	|					(ВЫБРАТЬ
	|						СписокОрганизаций.Ссылка
	|					ИЗ
	|						ВТ_СписокОрганизаций КАК СписокОрганизаций)
	|				И НЕ Субконто1 В
	|						(ВЫБРАТЬ
	|							СтатьиРемонтовИПреференций.СтатьяРасходов
	|						ИЗ
	|							ВТ_СтатьиРемонтовИПреференций КАК СтатьиРемонтовИПреференций),
	|			НЕ КорСчет В ИЕРАРХИИ (&Счет000)
	|				И НЕ КорСчет В ИЕРАРХИИ (&СчетаРасходов),
	|			) КАК ХозрасчетныйОборотыПоЗатратам
    |;
	|";

	Возврат ТекстЗапроса;

КонецФункции

Функция ТекстЗапросаПоступлениеТМЗ() Экспорт
	
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	""100.00.009.IIIA"" КАК КодСтроки,
	|	0 КАК ДоходРасход,
	|	СУММА(ЕСТЬNULL(ХозрасчетныйОбороты.СуммаНУОборотДт, 0) - ЕСТЬNULL(ХозрасчетныйОбороты.СуммаНУОборотКт, 0)) КАК СуммаНУ,
	|	СУММА(ЕСТЬNULL(ХозрасчетныйОбороты.СуммаПРОборотДт, 0) - ЕСТЬNULL(ХозрасчетныйОбороты.СуммаПРОборотКт, 0)) КАК СуммаПР,
	|	0 КАК ВыдСообщение
	|ПОМЕСТИТЬ ВТ_СтрокаIIIA
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(
	|			&НачПериода,
	|			&КонПериода,
	|			,
	|			Счет В ИЕРАРХИИ (&СписокСчетовСтрокиA)
	|			,
	|			,
	|			Организация В (ВЫБРАТЬ СписокОрганизаций.Ссылка ИЗ ВТ_СписокОрганизаций КАК СписокОрганизаций)
