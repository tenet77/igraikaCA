		Движение.Событие 			= Событие;		
		Движение.ВидЛьготыФА 		= СтрокаДанных.ВидЛьготыФА;
		
	КонецЦикла;	
	
 	Движения.Хозрасчетный.Записывать = Истина;
	Движения.ОбъектыНалоговогоУчетаФА.Записывать = Истина;	
	Движения.ФиксированныеАктивыУчитываемыеОтдельно.Записывать = Истина;
	Движения.СтоимостьОС.Записывать 	= Истина;
	Движения.СтоимостьНМА.Записывать 	= Истина;
	
КонецПроцедуры
 
#КонецОбласти 

#Область СписаниеРезерваПоПереоценкеВНА

Функция ПодготовитьПараметрыСписанияРезерваПоПереоценкеВНА(СтруктураШапки, Отказ) Экспорт
	
	Период  = НачалоМесяца(СтруктураШапки.Дата);
	ИспользуетсяУправлениеВНА_2_4 = ВнеоборотныеАктивы.ИспользуетсяУправлениеВНА_2_4(Период);
	Если НЕ ИспользуетсяУправлениеВНА_2_4 Тогда
		Отказ = Истина;
	КонецЕсли;
	
	ПараметрыПроведения = Новый Структура;

	Содержание  = НСтр("ru = 'Списание резерва по переоценке ОС'");
	
	Запрос = Новый Запрос;
		
	Запрос.УстановитьПараметр("Ссылка", СтруктураШапки.Ссылка);
	Запрос.УстановитьПараметр("Содержание", Содержание);
	
	ПоддержкаПБУ18  = УчетнаяПолитика.ПоддержкаПБУ18(СтруктураШапки.Организация, СтруктураШапки.Дата);
	Запрос.УстановитьПараметр("ПоддержкаПБУ18", ПоддержкаПБУ18);
	
	НомераТаблиц = Новый Структура;
	Запрос.Текст = ТекстЗапросаПараметрыСписанияРезерваПереоценкиВНА(НомераТаблиц);
	Результат = Запрос.ВыполнитьПакет();
	
	Для каждого НомерТаблицы Из НомераТаблиц Цикл
		ПараметрыПроведения.Вставить(НомерТаблицы.Ключ, Результат[НомерТаблицы.Значение].Выгрузить());
	КонецЦикла;
	
	Возврат ПараметрыПроведения;
	
КонецФункции

Функция ТекстЗапросаПараметрыСписанияРезерваПереоценкиВНА(НомераТаблиц)

	НомераТаблиц.Вставить("ТаблицаРеквизиты", НомераТаблиц.Количество());
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	РегламентнаяОперация.Ссылка КАК Регистратор,
	|	РегламентнаяОперация.Организация КАК Организация,
	|	РегламентнаяОперация.Дата КАК Период,
	|	&ПоддержкаПБУ18 КАК ПоддержкаПБУ18,
	|	&Содержание КАК Содержание
	|ИЗ
	|	Документ.РегламентнаяОперация КАК РегламентнаяОперация
	|ГДЕ
	|	РегламентнаяОперация.Ссылка = &Ссылка";
	
	Возврат ТекстЗапроса + ОбщегоНазначенияБПВызовСервера.ТекстРазделителяЗапросовПакета();

КонецФункции

Функция ПодготовитьПараметрыСписанияРезерваПереоценки(ТаблицаРеквизиты)
	
	Параметры = Новый Структура;
	
	// Подготовка таблицы Параметры.Реквизиты
	СписокОбязательныхКолонок = ""
	+ "Период,"												// <Дата>
	+ "Организация,"										// <СправочникСсылка.Организации>
	+ "Регистратор,"										// <ДокументСсылка.*>
	+ "ПоддержкаПБУ18";
	
	Параметры.Вставить("Реквизиты", 
		ОбщегоНазначенияБПВызовСервера.ПолучитьТаблицуПараметровПроведения(ТаблицаРеквизиты, СписокОбязательныхКолонок));
	
	Возврат Параметры;
	
КонецФункции

Функция ПодготовитьТаблицыСписанияРезерваПоПереоценкеВНА(ТаблицаРеквизиты, СписокОрганизаций, Отказ) Экспорт
	
	Параметры = ПодготовитьПараметрыСписанияРезерваПереоценки(ТаблицаРеквизиты);
	Если Параметры.Реквизиты.Количество() = 0 Тогда
		Отказ = Истина;
		Возврат Неопределено;
	КонецЕсли;
	
	Реквизиты = Параметры.Реквизиты[0];
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	СтруктураТаблиц = РассчитатьСписаниеРезерваПоПереоценкеВНА(Реквизиты, СписокОрганизаций, МенеджерВременныхТаблиц);
	
	Возврат СтруктураТаблиц;
	
КонецФункции

Функция РассчитатьСписаниеРезерваПоПереоценкеВНА(Реквизиты, СписокОрганизаций, МенеджерВременныхТаблиц)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Если Константы.ПорядокУчетаВНАВУпрУчете.Получить() = Перечисления.ПорядокУчетаВНАВУпрУчете.ПоСтандартамМУ 
		//Т.к. переоценка ОС не учитывается в месяце ее отражения, то данную функциональность пока не используем
		И ПолучитьФункциональнуюОпцию("ОтключенныйФункционал") Тогда
		Период = Новый Граница (КонецМесяца(Реквизиты.Период),ВидГраницы.Включая);
	Иначе
		Период = НачалоМесяца(Реквизиты.Период);
	КонецЕсли;
	Запрос.УстановитьПараметр("Период",           				Период);
	Запрос.УстановитьПараметр("ГраницаРезерва",					Новый Граница(Реквизиты.Регистратор.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("НачДата",           				НачалоМесяца(Реквизиты.Период));
	Запрос.УстановитьПараметр("КонДата",           				Новый Граница (КонецМесяца(Реквизиты.Период),ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", 	  				Реквизиты.Организация);
	Запрос.УстановитьПараметр("СписокОрганизаций", 				СписокОрганизаций);
	
	Запрос.Текст = "ВЫБРАТЬ
	|	СтоимостьОСОстатки.Организация КАК Организация,
	|	СтоимостьОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОСОстатки.РезервПереоценкиСтоимостиНачальныйОстаток КАК РезервСтоимости,
	|	СтоимостьОСОстатки.РезервПереоценкиСтоимостиРеглНачальныйОстаток КАК РезервСтоимостиРегл,
	|	0 КАК РезервАмортизации,
	|	0 КАК РезервАмортизацииРегл,
	|	СтоимостьОСОстатки.РезервПереоценкиСтоимостиКонечныйОстаток КАК РезервСтоимостиНаКонец,
	|	СтоимостьОСОстатки.РезервПереоценкиСтоимостиРеглКонечныйОстаток КАК РезервСтоимостиРеглНаКонец,
	|	0 КАК РезервАмортизацииНаКонец,
	|	0 КАК РезервАмортизацииРеглНаКонец
	|ПОМЕСТИТЬ ВТ_ОстаткиРезерваПереоценкиОС
	|ИЗ
	|	РегистрНакопления.СтоимостьОС.ОстаткиИОбороты(&Период, &ГраницаРезерва, Период, , Организация В (&СписокОрганизаций)) КАК СтоимостьОСОстатки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	АмортизацияОСОстатки.Организация,
	|	АмортизацияОСОстатки.ОсновноеСредство,
	|	0,
	|	0,
	|	АмортизацияОСОстатки.РезервПереоценкиАмортизацииНачальныйОстаток,
	|	АмортизацияОСОстатки.РезервПереоценкиАмортизацииРеглНачальныйОстаток,
	|	0,
	|	0,
	|	АмортизацияОСОстатки.РезервПереоценкиАмортизацииКонечныйОстаток,
	|	АмортизацияОСОстатки.РезервПереоценкиАмортизацииРеглКонечныйОстаток
	|ИЗ
	|	РегистрНакопления.АмортизацияОС.ОстаткиИОбороты(&Период, &ГраницаРезерва, Период, , Организация В (&СписокОрганизаций)) КАК АмортизацияОСОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОстаткиРезерваПереоценки.Организация КАК Организация,
	|	ВТ_ОстаткиРезерваПереоценки.ОсновноеСредство КАК ОсновноеСредство,
	|	СУММА(ВТ_ОстаткиРезерваПереоценки.РезервСтоимости) КАК РезервСтоимости,
	|	СУММА(ВТ_ОстаткиРезерваПереоценки.РезервСтоимостиРегл) КАК РезервСтоимостиРегл,
	|	СУММА(ВТ_ОстаткиРезерваПереоценки.РезервАмортизации) КАК РезервАмортизации,
	|	СУММА(ВТ_ОстаткиРезерваПереоценки.РезервАмортизацииРегл) КАК РезервАмортизацииРегл
	|ПОМЕСТИТЬ ВТ_ОстаткиРезервовПереоценкиОСИтоги
	|ИЗ
	|	ВТ_ОстаткиРезерваПереоценкиОС КАК ВТ_ОстаткиРезерваПереоценки
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ОстаткиРезерваПереоценки.Организация,
	|	ВТ_ОстаткиРезерваПереоценки.ОсновноеСредство
	|
	|ИМЕЮЩИЕ
	|	(СУММА(ВТ_ОстаткиРезерваПереоценки.РезервСтоимости) > 0
	|			И СУММА(ВТ_ОстаткиРезерваПереоценки.РезервСтоимостиНаКонец) > 0
	|		ИЛИ СУММА(ВТ_ОстаткиРезерваПереоценки.РезервСтоимостиРегл) > 0
	|			И СУММА(ВТ_ОстаткиРезерваПереоценки.РезервСтоимостиРеглНаКонец) > 0
	|		ИЛИ СУММА(ВТ_ОстаткиРезерваПереоценки.РезервАмортизации) > 0
	|			И СУММА(ВТ_ОстаткиРезерваПереоценки.РезервАмортизацииНаКонец) > 0
	|		ИЛИ СУММА(ВТ_ОстаткиРезерваПереоценки.РезервАмортизацииРегл) > 0
	|			И СУММА(ВТ_ОстаткиРезерваПереоценки.РезервАмортизацииРеглНаКонец) > 0)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Организация,
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АмортизацияОСОбороты.Организация КАК Организация,
	|	АмортизацияОСОбороты.ОсновноеСредство КАК ОсновноеСредство,
	|	СУММА(АмортизацияОСОбороты.АмортизацияРасход) КАК АмортизацияРасход,
	|	СУММА(АмортизацияОСОбороты.АмортизацияРеглРасход) КАК АмортизацияРеглРасход
	|ПОМЕСТИТЬ ВТ_АмортизацияОСЗаМесяц
	|ИЗ
	|	РегистрНакопления.АмортизацияОС.Обороты(
	|			&НачДата,
	|			&КонДата,
	|			Регистратор,
	|			(Организация, ОсновноеСредство) В
	|				(ВЫБРАТЬ
	|					ВТ_ОстаткиРезервовПереоценкиОСИтоги.Организация КАК Организация,
	|					ВТ_ОстаткиРезервовПереоценкиОСИтоги.ОсновноеСредство КАК ОсновноеСредство
	|				ИЗ
	|					ВТ_ОстаткиРезервовПереоценкиОСИтоги КАК ВТ_ОстаткиРезервовПереоценкиОСИтоги)) КАК АмортизацияОСОбороты
	|ГДЕ
	|	ТИПЗНАЧЕНИЯ(АмортизацияОСОбороты.Регистратор) = ТИП(Документ.АмортизацияОС2_4)
	|
	|СГРУППИРОВАТЬ ПО
	|	АмортизацияОСОбороты.ОсновноеСредство,
	|	АмортизацияОСОбороты.Организация
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Организация,
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтоимостьОСОстатки.Организация КАК Организация,
	|	СтоимостьОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОСОстатки.СтоимостьОстаток КАК ОстаточнаяСтоимость,
	|	СтоимостьОСОстатки.СтоимостьРеглОстаток КАК ОстаточнаяСтоимостьРегл
	|ПОМЕСТИТЬ ВТ_СтоимостьОСНаКонец
	|ИЗ
	|	РегистрНакопления.СтоимостьОС.Остатки(
	|			&Период,
	|			(Организация, ОсновноеСредство) В
	|				(ВЫБРАТЬ
	|					ВТ_ОстаткиРезервовПереоценкиОСИтоги.Организация КАК Организация,
	|					ВТ_ОстаткиРезервовПереоценкиОСИтоги.ОсновноеСредство КАК ОсновноеСредство
	|				ИЗ
	|					ВТ_ОстаткиРезервовПереоценкиОСИтоги КАК ВТ_ОстаткиРезервовПереоценкиОСИтоги)) КАК СтоимостьОСОстатки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	АмортизацияОСОстатки.Организация,
	|	АмортизацияОСОстатки.ОсновноеСредство,
	|	АмортизацияОСОстатки.АмортизацияОстаток,
	|	АмортизацияОСОстатки.АмортизацияРеглОстаток
	|ИЗ
	|	РегистрНакопления.АмортизацияОС.Остатки(
	|			&Период,
	|			(Организация, ОсновноеСредство) В
	|				(ВЫБРАТЬ
	|					ВТ_ОстаткиРезервовПереоценкиОСИтоги.Организация КАК Организация,
	|					ВТ_ОстаткиРезервовПереоценкиОСИтоги.ОсновноеСредство КАК ОсновноеСредство
	|				ИЗ
	|					ВТ_ОстаткиРезервовПереоценкиОСИтоги КАК ВТ_ОстаткиРезервовПереоценкиОСИтоги)) КАК АмортизацияОСОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СтоимостьНаКонец.Организация КАК Организация,
	|	ВТ_СтоимостьНаКонец.ОсновноеСредство КАК ОсновноеСредство,
	|	СУММА(ВТ_СтоимостьНаКонец.ОстаточнаяСтоимость) КАК ОстаточнаяСтоимость,
	|	СУММА(ВТ_СтоимостьНаКонец.ОстаточнаяСтоимостьРегл) КАК ОстаточнаяСтоимостьРегл
	|ПОМЕСТИТЬ ВТ_ОстаточнаяСтоимостьОСНаКонецИтоги
	|ИЗ
	|	ВТ_СтоимостьОСНаКонец КАК ВТ_СтоимостьНаКонец
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_СтоимостьНаКонец.Организация,
	|	ВТ_СтоимостьНаКонец.ОсновноеСредство
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Организация,
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОстаткиРезервовПереоценкиИтоги.Организация КАК Организация,
	|	ВТ_ОстаткиРезервовПереоценкиИтоги.ОсновноеСредство КАК ОсновноеСредство,
	|	ЕСТЬNULL(МестонахождениеОССрезПоследних.МОЛ, ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)) КАК МОЛ,
	|	ВТ_ОстаткиРезервовПереоценкиИтоги.РезервСтоимости КАК РезервСтоимости,
	|	ВТ_ОстаткиРезервовПереоценкиИтоги.РезервСтоимостиРегл КАК РезервСтоимостиРегл,
	|	ВТ_ОстаткиРезервовПереоценкиИтоги.РезервАмортизации * -1 КАК РезервАмортизации,
	|	ВТ_ОстаткиРезервовПереоценкиИтоги.РезервАмортизацииРегл * -1 КАК РезервАмортизацииРегл,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВТ_ОстаточнаяСтоимостьНаКонецИтоги.ОстаточнаяСтоимость, 0) = 0
	|			ТОГДА 1
	|		ИНАЧЕ ЕСТЬNULL(ВТ_АмортизацияЗаМесяц.АмортизацияРасход, 0) / ВТ_ОстаточнаяСтоимостьНаКонецИтоги.ОстаточнаяСтоимость
	|	КОНЕЦ КАК КоэффициентСписанияРезерва,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВТ_ОстаточнаяСтоимостьНаКонецИтоги.ОстаточнаяСтоимостьРегл, 0) = 0
	|			ТОГДА 1
	|		ИНАЧЕ ЕСТЬNULL(ВТ_АмортизацияЗаМесяц.АмортизацияРеглРасход, 0) / ВТ_ОстаточнаяСтоимостьНаКонецИтоги.ОстаточнаяСтоимостьРегл
	|	КОНЕЦ КАК КоэффициентСписанияРезерваРегл
	|ПОМЕСТИТЬ ВТ_ИтогиРезерваПереоценкиОСКСписанию
	|ИЗ
	|	ВТ_ОстаткиРезервовПереоценкиОСИтоги КАК ВТ_ОстаткиРезервовПереоценкиИтоги
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_АмортизацияОСЗаМесяц КАК ВТ_АмортизацияЗаМесяц
