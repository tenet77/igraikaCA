Процедура ИнициализироватьДанныеДокумента(ДокументОбъект, ДополнительныеСвойства, СтруктураРегистров)

	////////////////////////////////////////////////////////////////////////////
	// Создадим запрос инициализации движений

	СтруктураПараметров = Новый Структура;
	ЗаполнитьСтруктуруПараметровЗапроса(СтруктураПараметров);
	
	ЗаполнитьЗначенияСвойств(СтруктураПараметров, ДокументОбъект);

	Запрос = Новый Запрос;
	УстановитьПараметрыЗапроса(Запрос, СтруктураПараметров);

	////////////////////////////////////////////////////////////////////////////
	// Сформируем текст запроса

	ТекстыЗапроса = Новый СписокЗначений;
	ИмяДокумента  = ДокументОбъект.Метаданные().Имя;
	
	Для Каждого Регистр Из СтруктураРегистров Цикл

		Если Регистр.Значение Тогда

			ИмяПроцедуры = "ТекстЗапросаТаблица" + Регистр.Ключ + "_[ИмяДокумента]()";
			ИмяПроцедуры = СтрЗаменить(ИмяПроцедуры, "[ИмяДокумента]", ИмяДокумента);
			
			Если НЕ СтрНайти(ИмяПроцедуры, "2_4") = 0 Тогда
				ИмяПроцедуры = СтрЗаменить(ИмяПроцедуры, "2_4()", "(Истина)");	
			КонецЕсли;
			ТекстЗапроса = СтрЗаменить(Вычислить(ИмяПроцедуры), "#ИмяДокумента#", ИмяДокумента);
			ТекстыЗапроса.Добавить(ТекстЗапроса, "Таблица" + Регистр.Ключ);

		КонецЕсли;

	КонецЦикла;

	ПроведениеСерверУТ.ИнициализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, ДополнительныеСвойства.ТаблицыДляДвижений);
 					   	
КонецПроцедуры

Процедура ЗаполнитьСтруктуруПараметровЗапроса(СтруктураПараметров)
	
	СтруктураПараметров.Вставить("Ссылка");
	СтруктураПараметров.Вставить("Организация");
	СтруктураПараметров.Вставить("Дата");
	СтруктураПараметров.Вставить("АмортизационнаяГруппа");
	СтруктураПараметров.Вставить("ПорядокУчетаНУ");
	СтруктураПараметров.Вставить("НематериальныйАктив");
	СтруктураПараметров.Вставить("СнятьСУчетаПоНалогам");
	СтруктураПараметров.Вставить("ХозяйственнаяОперация");
	СтруктураПараметров.Вставить("ОрганизацияПолучатель");
	
КонецПроцедуры

Процедура УстановитьПараметрыЗапроса(Запрос, СтруктураПараметров)

	Для Каждого Параметр Из СтруктураПараметров Цикл

		Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);

	КонецЦикла;

КонецПроцедуры

Функция ПолучитьПолныйСписокВидовАктивовНУ() Экспорт

	ВидыАктива = Новый Массив;
	
	Для Каждого ВидАктиваНУ Из Перечисления.ВидАктиваНУ Цикл
		ВидыАктива.Добавить(ВидАктиваНУ);
	КонецЦикла;
	
	Возврат ВидыАктива;
	
КонецФункции

#КонецОбласти

#Область ОтражениеВреглУчетеТекущегоРемонта

Функция ДокументыКОтражениюРасходовНаРемонты()
	
	СписокДокументов = Новый СписокЗначений;
	
	СписокДокументов.Добавить("АвансовыйОтчет");
	СписокДокументов.Добавить("АмортизацияОС");
	СписокДокументов.Добавить("АмортизацияНМА");
	СписокДокументов.Добавить("ВнутреннееПотреблениеТоваров");
	СписокДокументов.Добавить("ВыбытиеДенежныхДокументов");
	СписокДокументов.Добавить("КорректировкаПриобретения");
	СписокДокументов.Добавить("ПогашениеСтоимостиТМЦВЭксплуатации");
	СписокДокументов.Добавить("ПриобретениеТоваровУслуг");
	СписокДокументов.Добавить("ПриобретениеУслугПрочихАктивов");
	СписокДокументов.Добавить("ПрочиеДоходыРасходы");
	СписокДокументов.Добавить("РаспределениеРасходовБудущихПериодов");
	СписокДокументов.Добавить("РасходныйКассовыйОрдер");
	СписокДокументов.Добавить("СписаниеБезналичныхДенежныхСредств");
	СписокДокументов.Добавить("ОтражениеЗарплатыВФинансовомУчете");
	
	Возврат СписокДокументов;
	
КонецФункции

Функция ТекстОтраженияАвансовыйОтчет()
	
	ТекстЗапроса = "
	|ВЫБРАТЬ // Поступление услуг (Дт 44 :: Кт 71)
	|	Операция.Ссылка КАК Ссылка,
	|	Операция.Дата КАК Период,
	|	Операция.Организация КАК Организация,
	|	НЕОПРЕДЕЛЕНО КАК ИдентификаторСтроки,
	|
	|	0 КАК Сумма,
	|	0 КАК СуммаУУ,
	|
	|	НЕОПРЕДЕЛЕНО КАК ВидСчетаДт,
	|	Строки.СтатьяРасходов КАК АналитикаУчетаДт,
	|	Строки.Подразделение КАК МестоУчетаДт,
	|
	|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК ВалютаДт,
	|	Строки.Подразделение КАК ПодразделениеДт,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка) КАК НаправлениеДеятельностиДт,
	|
	|	ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасходыПоРемонтуОсновныхСредствВНУ) КАК СчетДт,
	|	Строки.СтатьяРасходов КАК СубконтоДт1,
	|	Строки.АналитикаРасходов КАК СубконтоДт2,
	|	ВЫБОР 
	|		КОГДА СтатьиНаРемонтОС.ВидРасходов = ЗНАЧЕНИЕ(Перечисление.ВидыРасходовНУ.РемонтОсновныхСредств)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыЗатратВА.Текущий)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыЗатратВА.Преференции)
	|	КОНЕЦ КАК СубконтоДт3,
	|	
	|	0 КАК ВалютнаяСуммаДт,
	|	0 КАК КоличествоДт,
	|	ЕСТЬNULL(Суммы.СуммаБезНДСРегл, Строки.СуммаСНДС - Строки.СуммаНДС) КАК СуммаНУДт,
	|	0 КАК СуммаПРДт,
	|	0 КАК СуммаВРДт,
	|	
	|	НЕОПРЕДЕЛЕНО КАК ВидСчетаКт,
	|	НЕОПРЕДЕЛЕНО КАК АналитикаУчетаКт,
	|	НЕОПРЕДЕЛЕНО КАК МестоУчетаКт,
	|
	|	НЕОПРЕДЕЛЕНО КАК ВалютаКт,
	|	НЕОПРЕДЕЛЕНО КАК ПодразделениеКт,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка) КАК НаправлениеДеятельностиКт,
	|
	|	ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПустаяСсылка) СчетКт,
	|	НЕОПРЕДЕЛЕНО КАК СубконтоКт1,
	|	НЕОПРЕДЕЛЕНО КАК СубконтоКт2,
	|	НЕОПРЕДЕЛЕНО КАК СубконтоКт3,
	|
	|	0 КАК ВалютнаяСуммаКт,
	|
	|	0 КАК КоличествоКт,
	|	0 КАК СуммаНУКт,
	|	0 КАК СуммаПРКт,
	|	0 КАК СуммаВРКт,
	|	""Поступление расходов"" КАК Содержание
	|ИЗ
	|	ДокументыКОтражению КАК ДокументыКОтражению
	|	
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|		Документ.АвансовыйОтчет КАК Операция
	|	ПО
	|		ДокументыКОтражению.Ссылка = Операция.Ссылка
	|
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|		Документ.АвансовыйОтчет.ПрочиеРасходы КАК Строки
	|	ПО
	|		Строки.Ссылка = ДокументыКОтражению.Ссылка
	|
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		РегистрСведений.СуммыДокументовВВалютеРегл КАК Суммы
	|	ПО
	|		Суммы.Регистратор = Строки.Ссылка
	|		И Суммы.ИдентификаторСтроки = Строки.ИдентификаторСтроки
	|		И Суммы.СуммаБезНДСРегл <> 0
	|
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|		ПланВидовХарактеристик.СтатьиРасходов КАК СтатьиНаРемонтОС
	|	ПО
	|		Строки.СтатьяРасходов = СтатьиНаРемонтОС.Ссылка
	|		И (СтатьиНаРемонтОС.ВариантРаспределенияРасходовРегл = ЗНАЧЕНИЕ(Перечисление.ВариантыРаспределенияРасходов.НаНаправленияДеятельности)
	|			ИЛИ СтатьиНаРемонтОС.ВариантРаспределенияРасходовРегл = ЗНАЧЕНИЕ(Перечисление.ВариантыРаспределенияРасходов.НаПроизводственныеЗатраты))
	|		И СтатьиНаРемонтОС.ПринятиеКналоговомуУчету = ИСТИНА
	|		И СтатьиНаРемонтОС.ВидРасходов В (ЗНАЧЕНИЕ(Перечисление.ВидыРасходовНУ.РемонтОсновныхСредств), ЗНАЧЕНИЕ(Перечисление.ВидыРасходовНУ.Преференции))
	|		И СтатьиНаРемонтОС.РасходыНаОбъектыЭксплуатации = ИСТИНА
	|
	|ГДЕ
	|	ТИПЗНАЧЕНИЯ(Строки.СтатьяРасходов) = ТИП(ПланВидовХарактеристик.СтатьиРасходов)
	|	И Операция.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыАвансовогоОтчета.Утвержден)
	|	И НЕ Строки.Отменено
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ // Поступление услуг (Дт 44 :: Кт 71)
	|	Операция.Ссылка КАК Ссылка,
	|	Операция.Дата КАК Период,
	|	Операция.Организация КАК Организация,
	|	НЕОПРЕДЕЛЕНО КАК ИдентификаторСтроки,
	|
	|	0 КАК Сумма,
	|	0 КАК СуммаУУ,
	|
	|	НЕОПРЕДЕЛЕНО КАК ВидСчетаДт,
	|	Строки.СтатьяРасходов КАК АналитикаУчетаДт,
	|	Строки.Подразделение КАК МестоУчетаДт,
	|
	|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК ВалютаДт,
	|	Строки.Подразделение КАК ПодразделениеДт,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка) КАК НаправлениеДеятельностиДт,
	|
	|	ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасходыПоРемонтуОсновныхСредствВНУ) КАК СчетДт,
	|	Строки.СтатьяРасходов КАК СубконтоДт1,
	|	Строки.АналитикаРасходов КАК СубконтоДт2,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыЗатратВА.Капитальный) КАК СубконтоДт3,
	|	
	|	0 КАК ВалютнаяСуммаДт,
	|	0 КАК КоличествоДт,
	|	ЕСТЬNULL(Суммы.СуммаБезНДСРегл, Строки.СуммаСНДС - Строки.СуммаНДС) КАК СуммаНУДт,
	|	0 КАК СуммаПРДт,
	|	0 КАК СуммаВРДт,
	|	
	|	НЕОПРЕДЕЛЕНО КАК ВидСчетаКт,
	|	НЕОПРЕДЕЛЕНО КАК АналитикаУчетаКт,
	|	НЕОПРЕДЕЛЕНО КАК МестоУчетаКт,
	|
	|	НЕОПРЕДЕЛЕНО КАК ВалютаКт,
	|	НЕОПРЕДЕЛЕНО КАК ПодразделениеКт,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка) КАК НаправлениеДеятельностиКт,
	|
	|	ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПустаяСсылка) СчетКт,
	|	НЕОПРЕДЕЛЕНО КАК СубконтоКт1,
	|	НЕОПРЕДЕЛЕНО КАК СубконтоКт2,
	|	НЕОПРЕДЕЛЕНО КАК СубконтоКт3,
	|
	|	0 КАК ВалютнаяСуммаКт,
	|
	|	0 КАК КоличествоКт,
	|	0 КАК СуммаНУКт,
	|	0 КАК СуммаПРКт,
	|	0 КАК СуммаВРКт,
	|	""Поступление расходов"" КАК Содержание
	|ИЗ
	|	ДокументыКОтражению КАК ДокументыКОтражению
	|	
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|		Документ.АвансовыйОтчет КАК Операция
	|	ПО
	|		ДокументыКОтражению.Ссылка = Операция.Ссылка
	|
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|		Документ.АвансовыйОтчет.ПрочиеРасходы КАК Строки
	|	ПО
	|		Строки.Ссылка = ДокументыКОтражению.Ссылка
	|
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		РегистрСведений.СуммыДокументовВВалютеРегл КАК Суммы
	|	ПО
	|		Суммы.Регистратор = Строки.Ссылка
	|		И Суммы.ИдентификаторСтроки = Строки.ИдентификаторСтроки
	|		И Суммы.СуммаБезНДСРегл <> 0
	|
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|		ПланВидовХарактеристик.СтатьиРасходов КАК СтатьиНаРемонтОС
	|	ПО
	|		Строки.СтатьяРасходов = СтатьиНаРемонтОС.Ссылка
	|		И СтатьиНаРемонтОС.ВариантРаспределенияРасходовРегл = ЗНАЧЕНИЕ(Перечисление.ВариантыРаспределенияРасходов.НаВнеоборотныеАктивы)
	|		И СтатьиНаРемонтОС.ПринятиеКналоговомуУчету = ИСТИНА
	|		И СтатьиНаРемонтОС.ВидРасходов = ЗНАЧЕНИЕ(Перечисление.ВидыРасходовНУ.КапитальныйРемонтОсновныхСредств)
	|		И СтатьиНаРемонтОС.РасходыНаОбъектыЭксплуатации = ИСТИНА
	|
	|ГДЕ
	|	ТИПЗНАЧЕНИЯ(Строки.СтатьяРасходов) = ТИП(ПланВидовХарактеристик.СтатьиРасходов)
	|	И Операция.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыАвансовогоОтчета.Утвержден)
	|	И НЕ Строки.Отменено
	|";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстОтраженияАмортизацияОС()
	
	ТекстЗапроса = "
	|////////////////////////////////////////////////////////////////////////////////////////////////////
	|// Амортизация (Дт СчетУчетаЗатрат :: Кт СчетНакопленияАмортизации)
	|ВЫБРАТЬ
	|	
	|	&Ссылка КАК Ссылка,
	|	&Дата КАК Период,
	|	Строки.Организация КАК Организация,
	|	"""" КАК ИдентификаторСтроки,
	|	
	|	0 КАК Сумма,
	|	0 КАК СуммаУУ,
	|	
	|	// Дт ///////////////////////////////////////////////////////////////////////////////////////////
	|	
	|	НЕОПРЕДЕЛЕНО КАК ВидСчетаДт,
	|	Строки.СтатьяРасходов КАК АналитикаУчетаДт,
	|	Строки.Подразделение КАК МестоУчетаДт,
	|	
	|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК ВалютаДт,
	|	Строки.Подразделение КАК ПодразделениеДт,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка) КАК НаправлениеДеятельностиДт,
	|
	|	ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасходыПоРемонтуОсновныхСредствВНУ) КАК СчетДт,
	|	Строки.СтатьяРасходов КАК СубконтоДт1,
	|	Строки.АналитикаРасходов КАК СубконтоДт2,
	|	ВЫБОР 
	|		КОГДА СтатьиНаРемонтОС.ВидРасходов = ЗНАЧЕНИЕ(Перечисление.ВидыРасходовНУ.РемонтОсновныхСредств)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыЗатратВА.Текущий)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыЗатратВА.Преференции)
	|	КОНЕЦ КАК СубконтоДт3,
	|	
	|	0 КАК ВалютнаяСуммаДт,
	|	0 КАК КоличествоДт,
	|	Строки.СуммаБУ КАК СуммаНУДт,
	|	0 КАК СуммаПРДт,
	|	0 КАК СуммаВРДт,
	|	
	|	// Кт ///////////////////////////////////////////////////////////////////////////////////////////
	|	
	|	НЕОПРЕДЕЛЕНО КАК ВидСчетаКт,
	|	НЕОПРЕДЕЛЕНО КАК АналитикаУчетаКт,
	|	НЕОПРЕДЕЛЕНО КАК МестоУчетаКт,
	|	
	|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК ВалютаКт,
	|	НЕОПРЕДЕЛЕНО КАК ПодразделениеКт,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка) КАК НаправлениеДеятельностиКт,
	|
	|	ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПустаяСсылка) КАК СчетКт,
	|	НЕОПРЕДЕЛЕНО КАК СубконтоКт1,
	|	НЕОПРЕДЕЛЕНО КАК СубконтоКт2,
	|	НЕОПРЕДЕЛЕНО КАК СубконтоКт3,
	|	
	|	0 КАК ВалютнаяСуммаКт,
	|	0 КАК КоличествоКт,
	|	0 КАК СуммаНУКт,
	|	0 КАК СуммаПРКт,
	|	0 КАК СуммаВРКт,
	|	
	|	/////////////////////////////////////////////////////////////////////////////////////////////////
	|	
	|	""Начисление амортизации"" КАК Содержание
	|ИЗ
	|	втНачисленнаяАмортизация КАК Строки
	|	
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|		ПланВидовХарактеристик.СтатьиРасходов КАК СтатьиНаРемонтОС
	|	ПО
	|		Строки.СтатьяРасходов = СтатьиНаРемонтОС.Ссылка
	|		И СтатьиНаРемонтОС.ВариантРаспределенияРасходовРегл = ЗНАЧЕНИЕ(Перечисление.ВариантыРаспределенияРасходов.НаПроизводственныеЗатраты)
	|		И СтатьиНаРемонтОС.ПринятиеКналоговомуУчету = ИСТИНА
	|		И СтатьиНаРемонтОС.ВидРасходов В (ЗНАЧЕНИЕ(Перечисление.ВидыРасходовНУ.РемонтОсновныхСредств), ЗНАЧЕНИЕ(Перечисление.ВидыРасходовНУ.Преференции))
	|		И СтатьиНаРемонтОС.РасходыНаОбъектыЭксплуатации = ИСТИНА
	|
	|	ЛЕВОЕ СОЕДИНЕНИЕ втПервоначальныеСведения КАК втПервоначальныеСведения
	|	ПО Строки.ОбъектУчета = втПервоначальныеСведения.ОбъектУчета
	|
	|ГДЕ
	|	НЕ Строки.ЭтоАмортизационнаяПремия
	|	И НЕ Строки.ПередаватьРасходыВДругуюОрганизацию
	|	И НЕ втПервоначальныеСведения.НачислятьИзнос
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|////////////////////////////////////////////////////////////////////////////////////////////////////
	|// Амортизация (Дт СчетУчетаЗатрат :: Кт СчетНакопленияАмортизации)
	|ВЫБРАТЬ
	|	
	|	&Ссылка КАК Ссылка,
	|	&Дата КАК Период,
	|	ЕСТЬNULL(ОрганизациПолучатель.Ссылка, ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)) КАК Организация,
	|	"""" КАК ИдентификаторСтроки,
	|	
	|	0 КАК Сумма,
	|	0 КАК СуммаУУ,
	|	
	|	// Дт ///////////////////////////////////////////////////////////////////////////////////////////
	|	
	|	НЕОПРЕДЕЛЕНО КАК ВидСчетаДт,
	|	Строки.СтатьяРасходов КАК АналитикаУчетаДт,
