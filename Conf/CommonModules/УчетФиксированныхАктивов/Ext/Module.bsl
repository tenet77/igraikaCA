Функция РасходыПоАмортизацииНУ(Реквизиты, ТаблицаАмортизации, Отказ)
	
КонецФункции	

Процедура СформироватьДвиженияРасчетВычетовФАНУ(ТаблицаВычетыФА, ТаблицаРеквизиты, Движения, Отказ)
	
	Реквизиты = ТаблицаРеквизиты[0];
	
	Если Реквизиты.РассчитыватьДоходОтПревышенияСтоимостиВыбывшихФА Тогда
		СформироватьДвиженияПризнаниеДоходаОтПревышенияСтоимостиВыбывшегоАктива(ТаблицаВычетыФА.ТаблицаДоходы, Реквизиты, Движения, Отказ);
	КонецЕсли;	
	
	Если Реквизиты.СписыватьСтоимостныйБалансПриВыбытииВсехФАГруппы Тогда
		СформироватьДвиженияСписаниеПриВыбытииВсехАктивовГруппы(ТаблицаВычетыФА.ТаблицаСписаниеПриВыбытии, Реквизиты, Движения, Отказ);
	КонецЕсли;	
	
	Если Реквизиты.СписыватьСтоимостныйБалансГруппыМенееМинимума Тогда
		СформироватьДвиженияГруппМенееМинимума(ТаблицаВычетыФА.ТаблицаСписаниеМенееМинимума, Реквизиты, Движения, Отказ);
	КонецЕсли;	
	
	Если Реквизиты.АмортизацияФАНУ Тогда
		СформироватьДвиженияПоАмортизации(ТаблицаВычетыФА.ТаблицаРасчетАмортизацииНУ, Реквизиты, Движения, Отказ);
	КонецЕсли;
		
КонецПроцедуры

Процедура СформироватьДвиженияПризнаниеДоходаОтПревышенияСтоимостиВыбывшегоАктива(ТаблицаДанных, Реквизиты, Движения, Отказ)
	
	ПараметрыКлюча = Новый Структура("ВидАктиваНУ, ВидДвиженияСтоимостиНУ", Перечисления.ВидАктиваНУ.ФиксированныйАктив, Перечисления.ВидыДвиженияСтоимостиФА.СписаниеОтрицательногоБалансаГруппы);
	КлючАналитики = РегистрыСведений.АналитикаУчетаВнеоборотныхАктивов.ЗначениеКлючаАналитики(ПараметрыКлюча);
	
	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл
		Если СтрокаДанных.СтоимостьНУ = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Проводка = Движения.Хозрасчетный.Добавить();
		Проводка.Период      = Реквизиты.Период;
		Проводка.Организация = СтрокаДанных.Организация;
		
		Проводка.СчетДт      = СтрокаДанных.СчетУчетаФА;
		Проводка.СчетКт      = ПланыСчетов.Хозрасчетный.ДоходыОтВыбытияАктивов;
		
		БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 1, СтрокаДанных.ФиксированныйАктив);
		Если ТипЗнч(СтрокаДанных.ФиксированныйАктив) = Тип("СправочникСсылка.ОбъектыЭксплуатации")
			И НЕ СтрокаДанных.СчетУчетаФА = ПланыСчетов.Хозрасчетный.ДолгосрочныеАктивыДляПродажи Тогда
			БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 2, СтрокаДанных.МОЛ);
			БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 3, КлючАналитики);
		Иначе	
			БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 2, КлючАналитики);
		КонецЕсли;
		
		БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 1, ПланыВидовХарактеристик.СтатьиДоходов.ДоходыОтВыбытияФА);
		БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 2, СтрокаДанных.ФиксированныйАктив);
		
		БухгалтерскийУчет.УстановитьПодразделенияПроводки(Проводка, СтрокаДанных.Подразделение, СтрокаДанных.Подразделение);
		
		СуммаНУ        = -СтрокаДанных.СтоимостьНУ;
		СуммаПР        = 0;
		СуммаВР        = СтрокаДанных.СтоимостьНУ;
		
		НалоговыйУчет.ЗаполнитьНалоговыеСуммыПроводки(СуммаНУ, СуммаНУ, СуммаПР, СуммаПР,
								СуммаВР, СуммаВР, Проводка, Реквизиты.ПоддержкаПБУ18);
								
		Проводка.Содержание = НСтр("ru='Признан доход от превышения доходов выбывших ФА над стоимостным балансом группы/подгруппы'");
		
		//Формирование движений по РН СтоимостьОС и СтоимостьНМА
		Если Реквизиты.ИспользуетсяУправлениеВНА_2_4 Тогда
			
			Если ТипЗнч(СтрокаДанных.ФиксированныйАктив) = Тип("СправочникСсылка.ОбъектыЭксплуатации") Тогда
				СтрокаСтоимостьВНА = Движения.СтоимостьОС.ДобавитьПриход();
				СтрокаСтоимостьВНА.ОсновноеСредство 		= СтрокаДанных.ФиксированныйАктив;
				СтрокаСтоимостьВНА.МОЛ 						= СтрокаДанных.МОЛ;
				СтрокаСтоимостьВНА.ХозяйственнаяОперация 	= Перечисления.ХозяйственныеОперации.РеализацияОС;
			Иначе
				СтрокаСтоимостьВНА = Движения.СтоимостьНМА.ДобавитьПриход();
				СтрокаСтоимостьВНА.НематериальныйАктив 		= СтрокаДанных.ФиксированныйАктив;
				СтрокаСтоимостьВНА.ХозяйственнаяОперация 	= Перечисления.ХозяйственныеОперации.РеализацияНМА;
			КонецЕсли;
			
			СтрокаСтоимостьВНА.Период = Реквизиты.Период;
			
			СтрокаСтоимостьВНА.Организация 				= СтрокаДанных.Организация;
			СтрокаСтоимостьВНА.Подразделение 			= СтрокаДанных.Подразделение;
			СтрокаСтоимостьВНА.ГруппаФинансовогоУчета 	= СтрокаДанных.ГруппаФинансовогоУчета;
			СтрокаСтоимостьВНА.НаправлениеДеятельности 	= СтрокаДанных.НаправлениеДеятельности;
			
			СтрокаСтоимостьВНА.СтоимостьНУ = -СтрокаДанных.СтоимостьНУ;
			СтрокаСтоимостьВНА.СтоимостьВР = СтрокаДанных.СтоимостьНУ;
			
			СтрокаСтоимостьВНА.КорПодразделение = СтрокаДанных.Подразделение;
			СтрокаСтоимостьВНА.ВидАктиваИДвиженияСтоимостиНУ = КлючАналитики;
			СтрокаСтоимостьВНА.ОтражатьВРеглУчете = Истина;
			
		КонецЕсли;

	КонецЦикла;		
	
	Движения.Хозрасчетный.Записывать = Истина;
	Движения.СтоимостьОС.Записывать = Истина;
	Движения.СтоимостьНМА.Записывать = Истина;
	
КонецПроцедуры	

// Процедура формирует корреспонденции в НУ по списанию стоимостного
// баланса группы при выбытии всех, входищих в нее, активов
//
// Параметры:
// 	ВыборкаВидовОпераций - выборка из результата запроса, содержаща группировки по ГРуппамФА и ФА.
// 	Содержит поля
//		ГруппаУчетаФА 	- Группа НУ (если учет в целом по группе)	либо ФА, если учет в группе ведется по объектам
//		ГруппаФА 		- 	Группа налогового учета
//		ФиксированныйАктив  - Фиксирвоанный актив
//		СчетУчетаФА			- Счет учета фиксированного актива в НУ
//		ВидУчетаВГруппеФА	- Вид учета в группе: "по объектам"/ "по группе в целом"
//		СостояниеФиксированногоАктива - состояние актива в налоговом учете:	"принят к учету"/"выбыл"/ "снят с учета"
//		ИтоговаяСтоимостьГруппыНУ	 - Стоимостный баланс по ГруппеУчетаФА
//		СтоимостьНУ					 - Стоимостный баланс по фиксированному активу
//		ВидОперацииПоАктиву			 - Вид регламентой операции (из числа взаимоисключающих), которая выполняется с активом в документе:
//									 1 - Признание дохода от превышения стоимости выбывших активов над стоимостным балансом группы
//									 2 - Списание стоимостного баланса при выбытии всех активов группы
//									 3 - Списание стоимостного баланса группы, если величина баланса менее установленого минимума (с. 111, п.2)
//									 4 - Начисление амортизации по активу
//		ПрименяемаяНормаАмортизации - Применяемая норма амортизации
//		РасчетнаяАмортизацияФА		- Сумма расчетной амортизации по активу
//		УчитыватьОтдельно			- Признак того, что данный актив учитывается отдельно от стоимостного баланса группы
//
Процедура СформироватьДвиженияСписаниеПриВыбытииВсехАктивовГруппы(ТаблицаДанных, Реквизиты, Движения, Отказ)
	
	ПараметрыКлюча = Новый Структура("ВидАктиваНУ, ВидДвиженияСтоимостиНУ", Перечисления.ВидАктиваНУ.ФиксированныйАктив, Перечисления.ВидыДвиженияСтоимостиФА.СписаниеПриВыбытииВсехАктивовГруппы);
	КлючАналитики = РегистрыСведений.АналитикаУчетаВнеоборотныхАктивов.ЗначениеКлючаАналитики(ПараметрыКлюча);
	
	ПараметрыКлюча = Новый Структура("ВидАктиваНУ, ВидДвиженияСтоимостиНУ", Перечисления.ВидАктиваНУ.ФиксированныйАктив, Перечисления.ВидыДвиженияСтоимостиФА.СписаниеНакопленнойАмортизации);
	КлючАналитикиСписаниеАмортизации = РегистрыСведений.АналитикаУчетаВнеоборотныхАктивов.ЗначениеКлючаАналитики(ПараметрыКлюча);

	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл
		//Проводки
		Если СтрокаДанных.СтоимостьНУ <> 0 Тогда 
			Проводка = Движения.Хозрасчетный.Добавить();
			Проводка.Период      = Реквизиты.Период;
			Проводка.Организация = СтрокаДанных.Организация;
			
			Проводка.СчетДт      = ПланыСчетов.Хозрасчетный.ПрочиеРасходыВНалоговомУчете;
			Проводка.СчетКт      = СтрокаДанных.СчетУчетаФА;
			
			//СубконтоДТ
			БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 1, ПланыВидовХарактеристик.СтатьиРасходов.СписаниеПриВыбытииВсехФАГруппы);
							
			//СубконтоКТ
			БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 1, СтрокаДанных.ФиксированныйАктив);
			
			Если ТипЗнч(СтрокаДанных.ФиксированныйАктив) = Тип("СправочникСсылка.ОбъектыЭксплуатации") 
				И НЕ СтрокаДанных.СчетУчетаФА = ПланыСчетов.Хозрасчетный.ДолгосрочныеАктивыДляПродажи Тогда
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 2, СтрокаДанных.МОЛ);
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 3, КлючАналитики);
			Иначе	
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 2, КлючАналитики);
			КонецЕсли;
			
			БухгалтерскийУчет.УстановитьПодразделенияПроводки(Проводка, СтрокаДанных.Подразделение, СтрокаДанных.Подразделение);
			
			СуммаНУ        = СтрокаДанных.СтоимостьНУ;
			СуммаПР        = 0;
			СуммаВР        = -СтрокаДанных.СтоимостьНУ;
			
			НалоговыйУчет.ЗаполнитьНалоговыеСуммыПроводки(СуммаНУ, СуммаНУ, СуммаПР, СуммаПР,
									СуммаВР, СуммаВР, Проводка, Реквизиты.ПоддержкаПБУ18);
									
			Проводка.Содержание = НСтр("ru='Стоимость группы, все активы которой выбыли, отнесена на вычеты'");
			
			//Прочие расходы
			СтрокаРасходы = Движения.ПрочиеРасходы.Добавить();
			СтрокаРасходы.Период = Реквизиты.Период;
			СтрокаРасходы.Организация = СтрокаДанных.Организация; 
			
			СтрокаРасходы.СтатьяРасходов = ПланыВидовХарактеристик.СтатьиРасходов.СписаниеПриВыбытииВсехФАГруппы;
			СтрокаРасходы.АналитикаРасходов = СтрокаДанных.ФиксированныйАктив;
			
			СтрокаРасходы.Подразделение = СтрокаДанных.Подразделение;
			СтрокаРасходы.ВременнаяРазница = -СтрокаДанных.СтоимостьНУ;
			
			СтрокаРасходы.СчетКт = СтрокаДанных.СчетУчетаФА;
			СтрокаРасходы.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПрочиеРасходы;
			
			//Формирование движений по РН СтоимостьОС и СтоимостьНМА
			Если Реквизиты.ИспользуетсяУправлениеВНА_2_4 Тогда
				
				Если ТипЗнч(СтрокаДанных.ФиксированныйАктив) = Тип("СправочникСсылка.ОбъектыЭксплуатации") Тогда
					СтрокаСтоимостьВНА = Движения.СтоимостьОС.ДобавитьРасход();
					СтрокаСтоимостьВНА.ОсновноеСредство 		= СтрокаДанных.ФиксированныйАктив;
					СтрокаСтоимостьВНА.МОЛ 						= СтрокаДанных.МОЛ;
					СтрокаСтоимостьВНА.ХозяйственнаяОперация 	= Перечисления.ХозяйственныеОперации.СписаниеОС;
				Иначе
					СтрокаСтоимостьВНА = Движения.СтоимостьНМА.ДобавитьРасход();
					СтрокаСтоимостьВНА.НематериальныйАктив 		= СтрокаДанных.ФиксированныйАктив;
					СтрокаСтоимостьВНА.ХозяйственнаяОперация 	= Перечисления.ХозяйственныеОперации.СписаниеНМА;
				КонецЕсли;
				
				СтрокаСтоимостьВНА.Период = Реквизиты.Период;
				
				СтрокаСтоимостьВНА.Организация 				= СтрокаДанных.Организация;
				СтрокаСтоимостьВНА.Подразделение 			= СтрокаДанных.Подразделение;
				СтрокаСтоимостьВНА.ГруппаФинансовогоУчета 	= СтрокаДанных.ГруппаФинансовогоУчета;
				СтрокаСтоимостьВНА.НаправлениеДеятельности 	= СтрокаДанных.НаправлениеДеятельности;
				
				СтрокаСтоимостьВНА.СтоимостьНУ = СтрокаДанных.СтоимостьНУ;
				СтрокаСтоимостьВНА.СтоимостьВР = -СтрокаДанных.СтоимостьНУ;
				
				СтрокаСтоимостьВНА.КорПодразделение 				= СтрокаДанных.Подразделение;
				СтрокаСтоимостьВНА.КорСтатьяРасходов 				= ПланыВидовХарактеристик.СтатьиРасходов.СписаниеПриВыбытииВсехФАГруппы;
				СтрокаСтоимостьВНА.КорАналитикаРасходов 			= СтрокаДанных.ФиксированныйАктив;;
				СтрокаСтоимостьВНА.ВидАктиваИДвиженияСтоимостиНУ 	= КлючАналитики;
				СтрокаСтоимостьВНА.ОтражатьВРеглУчете 				= Истина;
				
			КонецЕсли;
		КонецЕсли;	
			
		//Списание накопленной амортизации
		Если СтрокаДанных.АмортизацияКонечныйОстаток <> 0 Тогда
			Проводка = Движения.Хозрасчетный.Добавить();
			Проводка.Период      = Реквизиты.Период;
			Проводка.Организация = СтрокаДанных.Организация;
			
			Проводка.СчетДт      = СтрокаДанных.СчетАмортизацииФА;
			Проводка.СчетКт      = СтрокаДанных.СчетУчетаФА;
			
			//СубконтоДТ
			БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 1, СтрокаДанных.ФиксированныйАктив);
			
			Если ТипЗнч(СтрокаДанных.ФиксированныйАктив) = Тип("СправочникСсылка.ОбъектыЭксплуатации") Тогда
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 2, СтрокаДанных.МОЛ);
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 3, КлючАналитикиСписаниеАмортизации);
			Иначе	
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 2, КлючАналитикиСписаниеАмортизации);
			КонецЕсли;
			
			//СубконтоКТ
			БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 1, СтрокаДанных.ФиксированныйАктив);
			
			Если ТипЗнч(СтрокаДанных.ФиксированныйАктив) = Тип("СправочникСсылка.ОбъектыЭксплуатации") Тогда
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 2, СтрокаДанных.МОЛ);
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 3, КлючАналитикиСписаниеАмортизации);
			Иначе	
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 2, КлючАналитикиСписаниеАмортизации);
			КонецЕсли;
			
			БухгалтерскийУчет.УстановитьПодразделенияПроводки(Проводка, СтрокаДанных.Подразделение, СтрокаДанных.Подразделение);
			
			СуммаНУ        = СтрокаДанных.АмортизацияКонечныйОстаток;
			СуммаПР        = 0;
			СуммаВР        = -СтрокаДанных.АмортизацияКонечныйОстаток;
			
			НалоговыйУчет.ЗаполнитьНалоговыеСуммыПроводки(СуммаНУ, СуммаНУ, СуммаПР, СуммаПР,
									СуммаВР, СуммаВР, Проводка, Реквизиты.ПоддержкаПБУ18);
									
			Проводка.Содержание = НСтр("ru='Списана амортизация в НУ'");
			
			Если Реквизиты.ИспользуетсяУправлениеВНА_2_4 Тогда
				
				Если ТипЗнч(СтрокаДанных.ФиксированныйАктив) = Тип("СправочникСсылка.ОбъектыЭксплуатации") Тогда
					СтрокаАмортизацияВНА = Движения.АмортизацияОС.ДобавитьПриход();
					СтрокаАмортизацияВНА.ОсновноеСредство 		= СтрокаДанных.ФиксированныйАктив;
					СтрокаАмортизацияВНА.МОЛ 					= СтрокаДанных.МОЛ;
					СтрокаАмортизацияВНА.ХозяйственнаяОперация 	= Перечисления.ХозяйственныеОперации.СписаниеАмортизацииОС;
				Иначе
					СтрокаАмортизацияВНА = Движения.АмортизацияНМА.ДобавитьПриход();
					СтрокаАмортизацияВНА.НематериальныйАктив 	= СтрокаДанных.ФиксированныйАктив;
					СтрокаАмортизацияВНА.ХозяйственнаяОперация 	= Перечисления.ХозяйственныеОперации.СписаниеАмортизацииНМА;
				КонецЕсли;
				
				СтрокаАмортизацияВНА.Период = Реквизиты.Период;
				
				СтрокаАмортизацияВНА.Организация 				= СтрокаДанных.Организация;
				СтрокаАмортизацияВНА.Подразделение 				= СтрокаДанных.Подразделение;
				СтрокаАмортизацияВНА.ГруппаФинансовогоУчета 	= СтрокаДанных.ГруппаФинансовогоУчета;
				СтрокаАмортизацияВНА.НаправлениеДеятельности 	= СтрокаДанных.НаправлениеДеятельности;
				
				СтрокаАмортизацияВНА.АмортизацияНУ = СтрокаДанных.АмортизацияКонечныйОстаток;
				СтрокаАмортизацияВНА.АмортизацияВР = -СтрокаДанных.АмортизацияКонечныйОстаток;
				
				СтрокаАмортизацияВНА.КорПодразделение 				= СтрокаДанных.Подразделение;
				СтрокаАмортизацияВНА.ВидАктиваИДвиженияСтоимостиНУ 	= КлючАналитикиСписаниеАмортизации;
				
				Если ТипЗнч(СтрокаДанных.ФиксированныйАктив) = Тип("СправочникСсылка.ОбъектыЭксплуатации") Тогда
					СтрокаСтоимостьВНА = Движения.СтоимостьОС.ДобавитьРасход();
					СтрокаСтоимостьВНА.ОсновноеСредство 		= СтрокаДанных.ФиксированныйАктив;
					СтрокаСтоимостьВНА.МОЛ 						= СтрокаДанных.МОЛ;
					СтрокаСтоимостьВНА.ХозяйственнаяОперация 	= Перечисления.ХозяйственныеОперации.СписаниеАмортизацииОС;
				Иначе
					СтрокаСтоимостьВНА = Движения.СтоимостьНМА.ДобавитьРасход();
					СтрокаСтоимостьВНА.НематериальныйАктив 		= СтрокаДанных.ФиксированныйАктив;
					СтрокаСтоимостьВНА.ХозяйственнаяОперация 	= Перечисления.ХозяйственныеОперации.СписаниеАмортизацииНМА;
				КонецЕсли;
				
				СтрокаСтоимостьВНА.Период = Реквизиты.Период;
				
				СтрокаСтоимостьВНА.Организация 				= СтрокаДанных.Организация;
				СтрокаСтоимостьВНА.Подразделение 			= СтрокаДанных.Подразделение;
				СтрокаСтоимостьВНА.ГруппаФинансовогоУчета 	= СтрокаДанных.ГруппаФинансовогоУчета;
				СтрокаСтоимостьВНА.НаправлениеДеятельности 	= СтрокаДанных.НаправлениеДеятельности;
				
				СтрокаСтоимостьВНА.СтоимостьНУ = СтрокаДанных.АмортизацияКонечныйОстаток;
				СтрокаСтоимостьВНА.СтоимостьВР = -СтрокаДанных.АмортизацияКонечныйОстаток;
				
				СтрокаСтоимостьВНА.КорПодразделение 				= СтрокаДанных.Подразделение;
				СтрокаСтоимостьВНА.ВидАктиваИДвиженияСтоимостиНУ 	= КлючАналитикиСписаниеАмортизации;
				СтрокаСтоимостьВНА.ОтражатьВРеглУчете 				= Истина;
				
			КонецЕсли;
		КонецЕсли;	
		
	КонецЦикла;		

	Движения.Хозрасчетный.Записывать 	= Истина;
	Движения.ПрочиеРасходы.Записывать 	= Истина;
	Движения.СтоимостьОС.Записывать 	= Истина;
	Движения.СтоимостьНМА.Записывать 	= Истина;
	Движения.АмортизацияОС.Записывать 	= Истина;
	Движения.АмортизацияНМА.Записывать 	= Истина;

КонецПроцедуры // ВыполнитьСписаниеПриВыбытииВсехАктивовГруппы_НУ

// Процедура формирует корреспонденции по отражению амортизации в налоговом учете
//
// Параметры:
// 	ВыборкаВидовОпераций - выборка из результата запроса, содержаща группировки по ГРуппамФА и ФА.
// 	Содержит поля
//		ГруппаУчетаФА 	- Группа НУ (если учет в целом по группе)	либо ФА, если учет в группе ведется по объектам
//		ГруппаФА 		- 	Группа налогового учета
//		ФиксированныйАктив  - Фиксирвоанный актив
//		СчетУчетаФА			- Счет учета фиксированного актива в НУ
//		ВидУчетаВГруппеФА	- Вид учета в группе: "по объектам"/ "по группе в целом"
//		СостояниеФиксированногоАктива - состояние актива в налоговом учете:	"принят к учету"/"выбыл"/ "снят с учета"
//		ИтоговаяСтоимостьГруппыНУ	 - Стоимостный баланс по ГруппеУчетаФА
//		СтоимостьНУ					 - Стоимостный баланс по фиксированному активу
//		ВидОперацииПоАктиву			 - Вид регламентой операции (из числа взаимоисключающих), которая выполняется с активом в документе:
//									 1 - Признание дохода от превышения стоимости выбывших активов над стоимостным балансом группы
//									 2 - Списание стоимостного баланса при выбытии всех активов группы
//									 3 - Списание стоимостного баланса группы, если величина баланса менее установленого минимума (с. 111, п.2)
//									 4 - Начисление амортизации по активу
//		ПрименяемаяНормаАмортизации - Применяемая норма амортизации
//		РасчетнаяАмортизацияФА		- Сумма расчетной амортизации по активу
//		УчитыватьОтдельно			- Признак того, что данный актив учитывается отдельно от стоимостного баланса группы
//
Процедура СформироватьДвиженияПоАмортизации(ТаблицаРасчетАмортизацииНУ, Реквизиты, Движения, Отказ)
	
	ПараметрыКлюча = Новый Структура("ВидАктиваНУ, ВидДвиженияСтоимостиНУ", Перечисления.ВидАктиваНУ.ФиксированныйАктив, Перечисления.ВидыДвиженияСтоимостиФА.Амортизация);
	КлючАналитики = РегистрыСведений.АналитикаУчетаВнеоборотныхАктивов.ЗначениеКлючаАналитики(ПараметрыКлюча);
		
	Для Каждого СтрокаАмортизации Из ТаблицаРасчетАмортизацииНУ Цикл
		
		Если СтрокаАмортизации.Сумма <> 0 Тогда
			Если НЕ СтрокаАмортизации.ПередаватьРасходыВДругуюОрганизацию Тогда
				Проводка = Движения.Хозрасчетный.Добавить();
				Проводка.Период      = Реквизиты.Период;
				Проводка.Организация = СтрокаАмортизации.Организация;
				
				Проводка.СчетДт      = СтрокаАмортизации.СчетРасходов;
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 1, СтрокаАмортизации.СтатьяРасходов);
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 2, СтрокаАмортизации.АналитикаРасходов);
				
				Проводка.СчетКт      = СтрокаАмортизации.СчетАмортизацииФА;
				
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 1, СтрокаАмортизации.ФиксированныйАктив);
				Если ТипЗнч(СтрокаАмортизации.ФиксированныйАктив) = Тип("СправочникСсылка.ОбъектыЭксплуатации") Тогда
					БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 2, СтрокаАмортизации.МОЛ);
					БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 3, КлючАналитики);
				Иначе	
					БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 2, КлючАналитики);
				КонецЕсли;
				
				БухгалтерскийУчет.УстановитьПодразделенияПроводки(Проводка, СтрокаАмортизации.ПодразделениеЗатрат, СтрокаАмортизации.Подразделение);
				
				СуммаНУ        = СтрокаАмортизации.Сумма;
				СуммаПР        = 0;
				СуммаВР        = -СтрокаАмортизации.Сумма;
				
				НалоговыйУчет.ЗаполнитьНалоговыеСуммыПроводки(СуммаНУ, СуммаНУ, СуммаПР, СуммаПР,
				СуммаВР, СуммаВР, Проводка, Реквизиты.ПоддержкаПБУ18);
				
				Проводка.Содержание = НСтр("ru='Начислена амортизация (НУ)'");
				
			Иначе
				
				//отправитель
				Проводка = Движения.Хозрасчетный.Добавить();
				Проводка.Период      = Реквизиты.Период;
				Проводка.Организация = СтрокаАмортизации.Организация;
				
				Проводка.СчетДт      = ПланыСчетов.Хозрасчетный.КраткосрочнаяДебиторскаяЗадолженностьФилиаловИСтруктурныхПодразделений;
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 1, СтрокаАмортизации.ОрганизацияПолучательРасходов);
							
				Проводка.СчетКт      = СтрокаАмортизации.СчетАмортизацииФА;
				
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 1, СтрокаАмортизации.ФиксированныйАктив);
				Если ТипЗнч(СтрокаАмортизации.ФиксированныйАктив) = Тип("СправочникСсылка.ОбъектыЭксплуатации") Тогда
					БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 2, СтрокаАмортизации.МОЛ);
					БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 3, КлючАналитики);
				Иначе	
					БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 2, КлючАналитики);
				КонецЕсли;
				
				БухгалтерскийУчет.УстановитьПодразделенияПроводки(Проводка, СтрокаАмортизации.ПодразделениеЗатрат, СтрокаАмортизации.Подразделение);
				
				СуммаНУ        = СтрокаАмортизации.Сумма;
				СуммаПР        = 0;
				СуммаВР        = -СтрокаАмортизации.Сумма;
				
				НалоговыйУчет.ЗаполнитьНалоговыеСуммыПроводки(СуммаНУ, СуммаНУ, СуммаПР, СуммаПР,
				СуммаВР, СуммаВР, Проводка, Реквизиты.ПоддержкаПБУ18);
				
				Проводка.Содержание = НСтр("ru='Начислена амортизация (НУ)'");
				
				//получатель
				Проводка = Движения.Хозрасчетный.Добавить();
				Проводка.Период      = Реквизиты.Период;
				Проводка.Организация = СтрокаАмортизации.ОрганизацияПолучательРасходов;
				
				Проводка.СчетДт      = СтрокаАмортизации.СчетРасходов;
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 1, СтрокаАмортизации.СтатьяРасходов);
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 2, СтрокаАмортизации.АналитикаРасходов);
							
				Проводка.СчетКт      = ПланыСчетов.Хозрасчетный.КраткосрочнаяКредиторскаяЗадолженностьФилиаламИСтруктурнымПодразделениям;
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 1, Реквизиты.Организация);
				
				БухгалтерскийУчет.УстановитьПодразделенияПроводки(Проводка, СтрокаАмортизации.Подразделение, СтрокаАмортизации.Подразделение);
				
				СуммаНУ        = СтрокаАмортизации.Сумма;
				СуммаПР        = 0;
				СуммаВР        = -СтрокаАмортизации.Сумма;
				
				НалоговыйУчет.ЗаполнитьНалоговыеСуммыПроводки(СуммаНУ, СуммаНУ, СуммаПР, СуммаПР,
				СуммаВР, СуммаВР, Проводка, Реквизиты.ПоддержкаПБУ18);
				
				Проводка.Содержание = НСтр("ru='Начислена амортизация (НУ)'");
				
			КонецЕсли;
			
			//Прочие расходы
			СтрокаРасходы = Движения.ПрочиеРасходы.Добавить();
			СтрокаРасходы.Период = Реквизиты.Период;
			Если НЕ СтрокаАмортизации.ПередаватьРасходыВДругуюОрганизацию Тогда
				СтрокаРасходы.Организация = СтрокаАмортизации.Организация;
			Иначе
				СтрокаРасходы.Организация = СтрокаАмортизации.ОрганизацияПолучательРасходов;
			КонецЕсли;	
			
			СтрокаРасходы.СтатьяРасходов = СтрокаАмортизации.СтатьяРасходов;
			СтрокаРасходы.АналитикаРасходов = СтрокаАмортизации.ФиксированныйАктив;
			
			СтрокаРасходы.Подразделение = СтрокаАмортизации.ПодразделениеЗатрат;
			СтрокаРасходы.ВременнаяРазница = -СтрокаАмортизации.Сумма;
			
			Если НЕ СтрокаАмортизации.ПередаватьРасходыВДругуюОрганизацию Тогда
				СтрокаРасходы.СчетКт = СтрокаАмортизации.СчетАмортизацииФА;
			Иначе
				СтрокаРасходы.СчетКт = ПланыСчетов.Хозрасчетный.КраткосрочнаяКредиторскаяЗадолженностьФилиаламИСтруктурнымПодразделениям; 
			КонецЕсли;
			
			СтрокаРасходы.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.АмортизацияВнеоборотныхАктивов;

			//Формирование движений по РН АмортизацияОС и АмортизацияНМА
			Если Реквизиты.ИспользуетсяУправлениеВНА_2_4 Тогда
				
				Если ТипЗнч(СтрокаАмортизации.ФиксированныйАктив) = Тип("СправочникСсылка.ОбъектыЭксплуатации") Тогда
					СтрокаАмортизацияВНА = Движения.АмортизацияОС.ДобавитьРасход();
					СтрокаАмортизацияВНА.ОсновноеСредство = СтрокаАмортизации.ФиксированныйАктив;
					СтрокаАмортизацияВНА.МОЛ = СтрокаАмортизации.МОЛ;
					СтрокаАмортизацияВНА.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.АмортизацияОС;
				Иначе
					СтрокаАмортизацияВНА = Движения.АмортизацияНМА.ДобавитьРасход();
					СтрокаАмортизацияВНА.НематериальныйАктив = СтрокаАмортизации.ФиксированныйАктив;
					СтрокаАмортизацияВНА.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.АмортизацияНМА;
				КонецЕсли;
				
				СтрокаАмортизацияВНА.Период = Реквизиты.Период;
				
				СтрокаАмортизацияВНА.Организация 				= СтрокаАмортизации.Организация;
				СтрокаАмортизацияВНА.Подразделение 				= СтрокаАмортизации.Подразделение;
				СтрокаАмортизацияВНА.ГруппаФинансовогоУчета 	= СтрокаАмортизации.ГруппаФинансовогоУчета;
				СтрокаАмортизацияВНА.НаправлениеДеятельности 	= СтрокаАмортизации.НаправлениеДеятельности;
				
				СтрокаАмортизацияВНА.АмортизацияНУ = СтрокаАмортизации.Сумма;
				СтрокаАмортизацияВНА.АмортизацияВР = -СтрокаАмортизации.Сумма;
				
				СтрокаАмортизацияВНА.КорПодразделение = СтрокаАмортизации.ПодразделениеЗатрат;
				СтрокаАмортизацияВНА.КорСтатьяРасходов = СтрокаАмортизации.СтатьяРасходов;
				СтрокаАмортизацияВНА.КорАналитикаРасходов = СтрокаАмортизации.АналитикаРасходов;
				СтрокаАмортизацияВНА.ВидАктиваИДвиженияСтоимостиНУ = КлючАналитики;
				
			КонецЕсли;
			
		КонецЕсли;	
			
	КонецЦикла;	
	
	Движения.Хозрасчетный.Записывать = Истина;
	Движения.ПрочиеРасходы.Записывать = Истина;
	Движения.АмортизацияОС.Записывать = Истина;
	Движения.АмортизацияНМА.Записывать = Истина;

КонецПроцедуры

// Процедура формирует корреспонденции в НУ по списанию стоимостного
// баланса группы, если данная величина менее установленной налоговым законодательством (ст. 111, п.2)
//
// Параметры:
// 	ВыборкаВидовОпераций - выборка из результата запроса, содержаща группировки по ГРуппамФА и ФА.
// 	Содержит поля
//		ГруппаУчетаФА 	- Группа НУ (если учет в целом по группе)	либо ФА, если учет в группе ведется по объектам
//		ГруппаФА 		- 	Группа налогового учета
//		ФиксированныйАктив  - Фиксирвоанный актив
//		СчетУчетаФА			- Счет учета фиксированного актива в НУ
//		ВидУчетаВГруппеФА	- Вид учета в группе: "по объектам"/ "по группе в целом"
//		СостояниеФиксированногоАктива - состояние актива в налоговом учете:	"принят к учету"/"выбыл"/ "снят с учета"
//		ИтоговаяСтоимостьГруппыНУ	 - Стоимостный баланс по ГруппеУчетаФА
//		СтоимостьНУ					 - Стоимостный баланс по фиксированному активу
//		ВидОперацииПоАктиву			 - Вид регламентой операции (из числа взаимоисключающих), которая выполняется с активом в документе:
//									 1 - Признание дохода от превышения стоимости выбывших активов над стоимостным балансом группы
//									 2 - Списание стоимостного баланса при выбытии всех активов группы
//									 3 - Списание стоимостного баланса группы, если величина баланса менее установленого минимума (с. 111, п.2)
//									 4 - Начисление амортизации по активу
//		ПрименяемаяНормаАмортизации - Применяемая норма амортизации
//		РасчетнаяАмортизацияФА		- Сумма расчетной амортизации по активу
//		УчитыватьОтдельно			- Признак того, что данный актив учитывается отдельно от стоимостного баланса группы
//
Процедура СформироватьДвиженияГруппМенееМинимума(ТаблицаДанных, Реквизиты, Движения, Отказ)
	
	ПараметрыКлюча = Новый Структура("ВидАктиваНУ, ВидДвиженияСтоимостиНУ", Перечисления.ВидАктиваНУ.ФиксированныйАктив, Перечисления.ВидыДвиженияСтоимостиФА.СписаниеСтоимостногоБалансаГруппыМенееМинимума);
	КлючАналитики = РегистрыСведений.АналитикаУчетаВнеоборотныхАктивов.ЗначениеКлючаАналитики(ПараметрыКлюча);
	
	ПараметрыКлюча = Новый Структура("ВидАктиваНУ, ВидДвиженияСтоимостиНУ", Перечисления.ВидАктиваНУ.ФиксированныйАктив, Перечисления.ВидыДвиженияСтоимостиФА.СписаниеНакопленнойАмортизации);
	КлючАналитикиСписаниеАмортизации = РегистрыСведений.АналитикаУчетаВнеоборотныхАктивов.ЗначениеКлючаАналитики(ПараметрыКлюча);

	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл
			
		Если СтрокаДанных.СтоимостьНУ = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		//Проводки
		Проводка = Движения.Хозрасчетный.Добавить();
		Проводка.Период      = Реквизиты.Период;
		Проводка.Организация = СтрокаДанных.Организация;
		
		Проводка.СчетДт      = ПланыСчетов.Хозрасчетный.ПрочиеРасходыВНалоговомУчете;
		Проводка.СчетКт      = СтрокаДанных.СчетУчетаФА;
		
		//СубконтоДТ
		БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 1, ПланыВидовХарактеристик.СтатьиРасходов.СписаниеСтоимостногоБалансаГруппыМенееМинимума);
						
		//СубконтоКТ
		БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 1, СтрокаДанных.ФиксированныйАктив);
		
		Если ТипЗнч(СтрокаДанных.ФиксированныйАктив) = Тип("СправочникСсылка.ОбъектыЭксплуатации") Тогда
			БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 2, СтрокаДанных.МОЛ);
			БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 3, КлючАналитики);
		Иначе	
			БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 2, КлючАналитики);
		КонецЕсли;
		
		БухгалтерскийУчет.УстановитьПодразделенияПроводки(Проводка, СтрокаДанных.Подразделение, СтрокаДанных.Подразделение);
		
		СуммаНУ        = СтрокаДанных.СтоимостьНУ;
		СуммаПР        = 0;
		СуммаВР        = -СтрокаДанных.СтоимостьНУ;
		
		НалоговыйУчет.ЗаполнитьНалоговыеСуммыПроводки(СуммаНУ, СуммаНУ, СуммаПР, СуммаПР,
								СуммаВР, СуммаВР, Проводка, Реквизиты.ПоддержкаПБУ18);
								
		Проводка.Содержание = НСтр("ru='Стоимость группы менее минимума отнесена на вычеты'");
		
		//Формирование движений по РН СтоимостьОС и СтоимостьНМА
		Если Реквизиты.ИспользуетсяУправлениеВНА_2_4 Тогда
			
			Если ТипЗнч(СтрокаДанных.ФиксированныйАктив) = Тип("СправочникСсылка.ОбъектыЭксплуатации") Тогда
				СтрокаСтоимостьВНА = Движения.СтоимостьОС.ДобавитьРасход();
				СтрокаСтоимостьВНА.ОсновноеСредство 		= СтрокаДанных.ФиксированныйАктив;
				СтрокаСтоимостьВНА.МОЛ 						= СтрокаДанных.МОЛ;
				СтрокаСтоимостьВНА.ХозяйственнаяОперация 	= Перечисления.ХозяйственныеОперации.СписаниеОС;
			Иначе
				СтрокаСтоимостьВНА = Движения.СтоимостьНМА.ДобавитьРасход();
				СтрокаСтоимостьВНА.НематериальныйАктив 		= СтрокаДанных.ФиксированныйАктив;
				СтрокаСтоимостьВНА.ХозяйственнаяОперация 	= Перечисления.ХозяйственныеОперации.СписаниеНМА;
			КонецЕсли;
			
			СтрокаСтоимостьВНА.Период = Реквизиты.Период;
			
			СтрокаСтоимостьВНА.Организация 				= СтрокаДанных.Организация;
			СтрокаСтоимостьВНА.Подразделение 			= СтрокаДанных.Подразделение;
			СтрокаСтоимостьВНА.ГруппаФинансовогоУчета 	= СтрокаДанных.ГруппаФинансовогоУчета;
			СтрокаСтоимостьВНА.НаправлениеДеятельности 	= СтрокаДанных.НаправлениеДеятельности;
			
			СтрокаСтоимостьВНА.СтоимостьНУ = СтрокаДанных.СтоимостьНУ;
			СтрокаСтоимостьВНА.СтоимостьВР = -СтрокаДанных.СтоимостьНУ;
			
			СтрокаСтоимостьВНА.КорПодразделение 				= СтрокаДанных.Подразделение;
			СтрокаСтоимостьВНА.КорСтатьяРасходов 				= ПланыВидовХарактеристик.СтатьиРасходов.СписаниеСтоимостногоБалансаГруппыМенееМинимума;
			СтрокаСтоимостьВНА.КорАналитикаРасходов 			= СтрокаДанных.ФиксированныйАктив;;
			СтрокаСтоимостьВНА.ВидАктиваИДвиженияСтоимостиНУ 	= КлючАналитики;
			СтрокаСтоимостьВНА.ОтражатьВРеглУчете 				= Истина;
			
		КонецЕсли;
		
		//Списание накопленной амортизации
		Если СтрокаДанных.АмортизацияКонечныйОстаток <> 0 Тогда
			Проводка = Движения.Хозрасчетный.Добавить();
			Проводка.Период      = Реквизиты.Период;
			Проводка.Организация = СтрокаДанных.Организация;
			
			Проводка.СчетДт      = СтрокаДанных.СчетАмортизацииФА;
			Проводка.СчетКт      = СтрокаДанных.СчетУчетаФА;
			
			//СубконтоДТ
			БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 1, СтрокаДанных.ФиксированныйАктив);
			
			Если ТипЗнч(СтрокаДанных.ФиксированныйАктив) = Тип("СправочникСсылка.ОбъектыЭксплуатации") Тогда
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 2, СтрокаДанных.МОЛ);
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 3, КлючАналитикиСписаниеАмортизации);
			Иначе	
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 2, КлючАналитикиСписаниеАмортизации);
			КонецЕсли;
			
			//СубконтоКТ
			БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 1, СтрокаДанных.ФиксированныйАктив);
			
			Если ТипЗнч(СтрокаДанных.ФиксированныйАктив) = Тип("СправочникСсылка.ОбъектыЭксплуатации") Тогда
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 2, СтрокаДанных.МОЛ);
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 3, КлючАналитикиСписаниеАмортизации);
			Иначе	
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 2, КлючАналитикиСписаниеАмортизации);
			КонецЕсли;
			
			БухгалтерскийУчет.УстановитьПодразделенияПроводки(Проводка, СтрокаДанных.Подразделение, СтрокаДанных.Подразделение);
			
			СуммаНУ        = СтрокаДанных.АмортизацияКонечныйОстаток;
			СуммаПР        = 0;
			СуммаВР        = -СтрокаДанных.АмортизацияКонечныйОстаток;
			
			НалоговыйУчет.ЗаполнитьНалоговыеСуммыПроводки(СуммаНУ, СуммаНУ, СуммаПР, СуммаПР,
									СуммаВР, СуммаВР, Проводка, Реквизиты.ПоддержкаПБУ18);
									
			Проводка.Содержание = НСтр("ru='Списана амортизация в НУ'");
			
			Если Реквизиты.ИспользуетсяУправлениеВНА_2_4 Тогда
				
				Если ТипЗнч(СтрокаДанных.ФиксированныйАктив) = Тип("СправочникСсылка.ОбъектыЭксплуатации") Тогда
					СтрокаАмортизацияВНА = Движения.АмортизацияОС.ДобавитьПриход();
					СтрокаАмортизацияВНА.ОсновноеСредство 		= СтрокаДанных.ФиксированныйАктив;
					СтрокаАмортизацияВНА.МОЛ 					= СтрокаДанных.МОЛ;
					СтрокаАмортизацияВНА.ХозяйственнаяОперация 	= Перечисления.ХозяйственныеОперации.СписаниеАмортизацииОС;
				Иначе
					СтрокаАмортизацияВНА = Движения.АмортизацияНМА.ДобавитьПриход();
					СтрокаАмортизацияВНА.НематериальныйАктив 	= СтрокаДанных.ФиксированныйАктив;
					СтрокаАмортизацияВНА.ХозяйственнаяОперация 	= Перечисления.ХозяйственныеОперации.СписаниеАмортизацииНМА;
				КонецЕсли;
				
				СтрокаАмортизацияВНА.Период = Реквизиты.Период;
				
				СтрокаАмортизацияВНА.Организация 				= СтрокаДанных.Организация;
				СтрокаАмортизацияВНА.Подразделение 				= СтрокаДанных.Подразделение;
				СтрокаАмортизацияВНА.ГруппаФинансовогоУчета 	= СтрокаДанных.ГруппаФинансовогоУчета;
				СтрокаАмортизацияВНА.НаправлениеДеятельности 	= СтрокаДанных.НаправлениеДеятельности;
				
				СтрокаАмортизацияВНА.АмортизацияНУ = СтрокаДанных.АмортизацияКонечныйОстаток;
				СтрокаАмортизацияВНА.АмортизацияВР = -СтрокаДанных.АмортизацияКонечныйОстаток;
				
				СтрокаАмортизацияВНА.КорПодразделение 				= СтрокаДанных.Подразделение;
				СтрокаАмортизацияВНА.ВидАктиваИДвиженияСтоимостиНУ 	= КлючАналитикиСписаниеАмортизации;
				
				Если ТипЗнч(СтрокаДанных.ФиксированныйАктив) = Тип("СправочникСсылка.ОбъектыЭксплуатации") Тогда
					СтрокаСтоимостьВНА = Движения.СтоимостьОС.ДобавитьРасход();
					СтрокаСтоимостьВНА.ОсновноеСредство 		= СтрокаДанных.ФиксированныйАктив;
					СтрокаСтоимостьВНА.МОЛ 						= СтрокаДанных.МОЛ;
					СтрокаСтоимостьВНА.ХозяйственнаяОперация 	= Перечисления.ХозяйственныеОперации.СписаниеАмортизацииОС;
				Иначе
					СтрокаСтоимостьВНА = Движения.СтоимостьНМА.ДобавитьРасход();
					СтрокаСтоимостьВНА.НематериальныйАктив 		= СтрокаДанных.ФиксированныйАктив;
					СтрокаСтоимостьВНА.ХозяйственнаяОперация 	= Перечисления.ХозяйственныеОперации.СписаниеАмортизацииНМА;
				КонецЕсли;
				
				СтрокаСтоимостьВНА.Период = Реквизиты.Период;
				
				СтрокаСтоимостьВНА.Организация 				= СтрокаДанных.Организация;
				СтрокаСтоимостьВНА.Подразделение 			= СтрокаДанных.Подразделение;
				СтрокаСтоимостьВНА.ГруппаФинансовогоУчета 	= СтрокаДанных.ГруппаФинансовогоУчета;
				СтрокаСтоимостьВНА.НаправлениеДеятельности 	= СтрокаДанных.НаправлениеДеятельности;
				
				СтрокаСтоимостьВНА.СтоимостьНУ = СтрокаДанных.АмортизацияКонечныйОстаток;
				СтрокаСтоимостьВНА.СтоимостьВР = -СтрокаДанных.АмортизацияКонечныйОстаток;
				
				СтрокаСтоимостьВНА.КорПодразделение 				= СтрокаДанных.Подразделение;
				СтрокаСтоимостьВНА.ВидАктиваИДвиженияСтоимостиНУ 	= КлючАналитикиСписаниеАмортизации;
				СтрокаСтоимостьВНА.ОтражатьВРеглУчете 				= Истина;
				
			КонецЕсли;

		КонецЕсли;	
		
		//Прочие расходы
		СтрокаРасходы = Движения.ПрочиеРасходы.Добавить();
		СтрокаРасходы.Период = Реквизиты.Период;
		СтрокаРасходы.Организация = СтрокаДанных.Организация; 
		
		СтрокаРасходы.СтатьяРасходов = ПланыВидовХарактеристик.СтатьиРасходов.СписаниеСтоимостногоБалансаГруппыМенееМинимума;
		СтрокаРасходы.АналитикаРасходов = СтрокаДанных.ФиксированныйАктив;
		
		СтрокаРасходы.Подразделение = СтрокаДанных.Подразделение;
		СтрокаРасходы.ВременнаяРазница = -СтрокаДанных.СтоимостьНУ;
		
		СтрокаРасходы.СчетКт = СтрокаДанных.СчетУчетаФА;
		СтрокаРасходы.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПрочиеРасходы;
				
	КонецЦикла;		
	
	Движения.Хозрасчетный.Записывать 	= Истина;
	Движения.ПрочиеРасходы.Записывать 	= Истина;
	Движения.СтоимостьОС.Записывать 	= Истина;
	Движения.СтоимостьНМА.Записывать 	= Истина;
	Движения.АмортизацияОС.Записывать 	= Истина;
	Движения.АмортизацияНМА.Записывать 	= Истина;
	
КонецПроцедуры

Функция ПодготовитьТаблицуАмортизацииФАНУ(Реквизиты, МенеджерВременныхТаблиц)

	ЗапросПланаСчетов = РеглУчетВыборкиСерверПовтИсп.ЗапросПланаСчетов();
	ЗапросПланаСчетов.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	ЗапросПланаСчетов.Выполнить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КонДата", Новый Граница (КонецГода(Реквизиты.Период),ВидГраницы.Включая));
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
 	Если Реквизиты.ИспользуетсяУправлениеВНА_2_4 Тогда
		Запрос.Текст = "
		           |ВЫБРАТЬ
	               |	СпособыОтраженияРасходовОСБУ.ОсновноеСредство КАК ОбъектУчета,
	               |	СпособыОтраженияРасходовОСБУ.Организация КАК Организация,
				   |	ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка) КАК Подразделение,
