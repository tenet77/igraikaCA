	ТаблицаРасчета.Колонки.Добавить("Организация",          Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблицаРасчета.Колонки.Добавить("СчетРасходов",         ОписаниеТипаСчетХозр);
	ТаблицаРасчета.Колонки.Добавить("СчетАмортизацииФА",    ОписаниеТипаСчетХозр);
