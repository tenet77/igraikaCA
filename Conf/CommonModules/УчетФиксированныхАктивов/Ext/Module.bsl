КонецФункции

Функция ТекстЗапросаВТВидыАктиваНМА(Документ, ТабличнаяЧасть = Неопределено) Экспорт
	
	ТекстЗапроса = "
	|////////////////////////////////////////////////////////////////////////////////
	|// Таблица ВТВидыАктива
	|ВЫБРАТЬ
	|	ДокументНМА.НематериальныйАктив КАК ОбъектУчета,
	|	ВЫБОР КОГДА
	|			ФиксированныеАктивыУчитываемыеОтдельно.СобытиеФАОтдельно = ЗНАЧЕНИЕ(Перечисление.СобытияФАУчитываемыхОтдельно.ПринятиеКУчету)
	|			Или ФиксированныеАктивыУчитываемыеОтдельно.СобытиеФАОтдельно = ЗНАЧЕНИЕ(Перечисление.СобытияФАУчитываемыхОтдельно.Выбытие)
	|		ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидАктиваНУ.ФиксированныйАктивУчитываемыйОтдельно)
	|		ИНАЧЕ
	|			ВЫБОР КОГДА ОбъектыНалоговогоУчетаФА.СостояниеФА <> ЗНАЧЕНИЕ(Перечисление.ВидыСостоянийФА.ПустаяСсылка) 
	|				ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидАктиваНУ.ФиксированныйАктив) 
	|				ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидАктиваНУ.НеФиксированныйАктив)
	|			КОНЕЦ
	|	КОНЕЦ КАК ВидАктиваНУ
	|ПОМЕСТИТЬ ВТВидыАктива
	|ИЗ
	|	Документ.ИмяДокумента КАК ДокументНМА
	|	ЛЕВОЕ СОЕДИНЕНИЕ ВТФиксированныеАктивыУчитываемыеОтдельноПеремещение КАК ФиксированныеАктивыУчитываемыеОтдельно
	|		ПО ДокументНМА.НематериальныйАктив = ФиксированныеАктивыУчитываемыеОтдельно.ОбъектУчета
	|	ЛЕВОЕ СОЕДИНЕНИЕ ВТОбъектыНалоговогоУчетаФАПеремещение КАК ОбъектыНалоговогоУчетаФА
	|		ПО ДокументНМА.НематериальныйАктив = ОбъектыНалоговогоУчетаФА.ОбъектУчета
	|ГДЕ ДокументНМА.Ссылка = &Ссылка
	|";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяДокумента", Документ + ?(НЕ ТабличнаяЧасть = Неопределено, "." + ТабличнаяЧасть, ""));
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаВТАналитикаУчетаВАНМА(Движение) Экспорт
	
	ТекстЗапроса = "
	|////////////////////////////////////////////////////////////////////////////////
	|// Таблица ВТАналитикаУчетаВА(Движение)
	|ВЫБРАТЬ
	|	ВидыАктива.ОбъектУчета КАК ОбъектУчета,
	|	АналитикаУчетаВнеоборотныхАктивов.КлючАналитики КАК КлючАналитики
	|ПОМЕСТИТЬ ВТАналитикаУчетаВА#Движение#
	|ИЗ
	|	ВТВидыАктива КАК ВидыАктива
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаВнеоборотныхАктивов КАК АналитикаУчетаВнеоборотныхАктивов
	|		ПО ВидыАктива.ВидАктиваНУ = АналитикаУчетаВнеоборотныхАктивов.ВидАктиваНУ
	|		И АналитикаУчетаВнеоборотныхАктивов.ВидДвиженияСтоимостиНУ = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженияСтоимостиФА.#Движение#)
	|";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#Движение#", Движение);
	
	Возврат ТекстЗапроса;
	
КонецФункции

Процедура ТекстЗапросаВТАналитикаУчетаВАОС_РеализацияВА(ТекстыЗапроса) Экспорт
	
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	СписокОбъектов.Ссылка,
	|	СписокОбъектов.АналитикаДоходов КАК ОбъектУчета
	|ПОМЕСТИТЬ ВТОперация
	|ИЗ
	|	Документ.РеализацияУслугПрочихАктивов.Доходы КАК СписокОбъектов
	|
	|ГДЕ 
	|	СписокОбъектов.Ссылка = &Ссылка
	|	И (СписокОбъектов.АналитикаДоходов ССЫЛКА Справочник.ОбъектыЭксплуатации 
	|		Или СписокОбъектов.АналитикаДоходов ССЫЛКА Справочник.НематериальныеАктивы)
	|";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТОперация");
	
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	СписокОбъектов.ОбъектУчета КАК ОбъектУчета,
	|	ЕСТЬNULL(ОбъектыНалоговогоУчета.СостояниеФиксированногоАктива, ЗНАЧЕНИЕ(Перечисление.ВидыСостоянийФА.ПустаяСсылка)) КАК СостояниеФА
	|ПОМЕСТИТЬ ВТОбъектыНалоговогоУчетаФАРеализация
	|ИЗ
	|	ВТОперация КАК СписокОбъектов
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОбъектыНалоговогоУчетаФА.СрезПоследних(
	|			&Дата,
	|			Регистратор <> &Ссылка
	|			И (Организация, ФиксированныйАктив) В
	|				(ВЫБРАТЬ
	|					Т.Ссылка.Организация,
	|					Т.ОбъектУчета
	|				ИЗ
	|					ВТОперация КАК Т
	|				)) КАК ОбъектыНалоговогоУчета
	|	ПО СписокОбъектов.ОбъектУчета = ОбъектыНалоговогоУчета.ФиксированныйАктив
	|";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТОбъектыНалоговогоУчетаФАРеализация");
	
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	СписокОбъектов.ОбъектУчета КАК ОбъектУчета,
	|	ЕСТЬNULL(ФиксированныеАктивыУчитываемыеОтдельно.Событие, ЗНАЧЕНИЕ(Перечисление.СобытияФАУчитываемыхОтдельно.ПустаяСсылка)) КАК СобытиеФАОтдельно
	|ПОМЕСТИТЬ ВТФиксированныеАктивыУчитываемыеОтдельноРеализация
	|ИЗ
	|	ВТОперация КАК СписокОбъектов
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФиксированныеАктивыУчитываемыеОтдельно.СрезПоследних(
	|			&Дата,
	|			Регистратор <> &Ссылка
	|			И (Организация, ФиксированныйАктив) В
	|				(ВЫБРАТЬ
	|					Т.Ссылка.Организация,
	|					Т.ОбъектУчета
	|				ИЗ
	|					ВТОперация КАК Т
	|				)) КАК ФиксированныеАктивыУчитываемыеОтдельно
	|	ПО СписокОбъектов.ОбъектУчета = ФиксированныеАктивыУчитываемыеОтдельно.ФиксированныйАктив
	|";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТФиксированныеАктивыУчитываемыеОтдельноРеализация");
	
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	СписокОбъектов.ОбъектУчета КАК ОбъектУчета,
	|	ВЫБОР КОГДА
	|			ФиксированныеАктивыУчитываемыеОтдельно.СобытиеФАОтдельно = ЗНАЧЕНИЕ(Перечисление.СобытияФАУчитываемыхОтдельно.ПринятиеКУчету)
	|			Или ФиксированныеАктивыУчитываемыеОтдельно.СобытиеФАОтдельно = ЗНАЧЕНИЕ(Перечисление.СобытияФАУчитываемыхОтдельно.Выбытие)
	|		ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидАктиваНУ.ФиксированныйАктивУчитываемыйОтдельно)
	|		ИНАЧЕ
	|			ВЫБОР КОГДА ОбъектыНалоговогоУчетаФА.СостояниеФА <> ЗНАЧЕНИЕ(Перечисление.ВидыСостоянийФА.ПустаяСсылка) 
	|				ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидАктиваНУ.ФиксированныйАктив) 
	|				ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидАктиваНУ.НеФиксированныйАктив)
	|			КОНЕЦ
	|	КОНЕЦ КАК ВидАктиваНУ
	|ПОМЕСТИТЬ ВТВидыАктиваРеализация
	|ИЗ
	|	ВТОперация КАК СписокОбъектов
	|	ЛЕВОЕ СОЕДИНЕНИЕ ВТФиксированныеАктивыУчитываемыеОтдельноРеализация КАК ФиксированныеАктивыУчитываемыеОтдельно
	|		ПО СписокОбъектов.ОбъектУчета = ФиксированныеАктивыУчитываемыеОтдельно.ОбъектУчета
	|	ЛЕВОЕ СОЕДИНЕНИЕ ВТОбъектыНалоговогоУчетаФАРеализация КАК ОбъектыНалоговогоУчетаФА
	|		ПО СписокОбъектов.ОбъектУчета = ОбъектыНалоговогоУчетаФА.ОбъектУчета
	|";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТФиксированныеАктивыУчитываемыеОтдельноРеализация");
	
	ТекстЗапроса = "
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВидыАктива.ОбъектУчета КАК ОбъектУчета,
	|	АналитикаУчетаВнеоборотныхАктивов.КлючАналитики КАК КлючАналитики
	|ПОМЕСТИТЬ ВТАналитикаУчетаВАРеализация
	|ИЗ
	|	ВТВидыАктиваРеализация КАК ВидыАктива
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаВнеоборотныхАктивов КАК АналитикаУчетаВнеоборотныхАктивов
	|		ПО ВидыАктива.ВидАктиваНУ = АналитикаУчетаВнеоборотныхАктивов.ВидАктиваНУ
	|		И АналитикаУчетаВнеоборотныхАктивов.ВидДвиженияСтоимостиНУ = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженияСтоимостиФА.Выбытие)";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТАналитикаУчетаВАРеализация");
	
	//Возврат "
