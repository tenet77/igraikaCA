	               |ГДЕ
	               |	Данные.СпособОтраженияРасходовЗаданДокументом = ЛОЖЬ";
	
	Результат = Запрос.ВыполнитьПакет();
	
	Возврат Результат;
	
КонецФункции // ()

Функция РаспределитьРасходыПоАмортизации(ТаблицаЗатрат, ДеревоАмортизации)
	
	Для Каждого СтрокаАмортизации Из ДеревоАмортизации.Строки Цикл
		ДобавитьСтрокиВТаблицуАмортизацииНУ(ТаблицаЗатрат, СтрокаАмортизации, СтрокаАмортизации.Строки);
	КонецЦикла;	
	
	Возврат ТаблицаЗатрат;
	
КонецФункции

Процедура ДобавитьСтрокиВТаблицуАмортизацииНУ(Таблица, Строка, ТаблицаРаспределения)
	
	Если (Строка.РасчетнаяАмортизацияФА = 0) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТаблицаРаспределения = Неопределено Тогда
		СтрокаТаблицыЗатрат = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТаблицыЗатрат, Строка);
		
	Иначе
		МассивКоэффицентов = ТаблицаРаспределения.ВыгрузитьКолонку("Коэффициент");
		Суммы = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(Строка.РасчетнаяАмортизацияФА, МассивКоэффицентов);
		Коэффициенты = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(Строка.Коэффициент, МассивКоэффицентов, 100);
		
		Если Суммы = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Для Индекс=0 По ТаблицаРаспределения.Количество()-1 Цикл
			ПравилоОтражения = ТаблицаРаспределения[Индекс];
			СтрокаТаблицыЗатрат = Таблица.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТаблицыЗатрат, Строка);
			ЗаполнитьЗначенияСвойств(СтрокаТаблицыЗатрат, ПравилоОтражения);
			СтрокаТаблицыЗатрат.Сумма = ?(Суммы = Неопределено, 0, Суммы[Индекс]);
			СтрокаТаблицыЗатрат.Коэффициент = ?(Коэффициенты=Неопределено, 0, Коэффициенты[Индекс]);
		КонецЦикла;
	КонецЕсли;
			
КонецПроцедуры

#КонецОбласти

#Область ВключениеАктивовВСтоимостныйБалансГруппы

Функция ПодготовитьПараметрыПроведенияВключениеАктивовВСБ(СтруктураШапки, Отказ) Экспорт
	
	ПараметрыПроведения = Новый Структура;

	Запрос = Новый Запрос;
		
	Запрос.УстановитьПараметр("Ссылка", СтруктураШапки.Ссылка);
	Запрос.УстановитьПараметр("Содержание",	НСтр("ru='Активы, учитываемые отдельно, включены в стоимостный баланс групп (НУ)'"));
	
	ПоддержкаПБУ18  = УчетнаяПолитика.ПоддержкаПБУ18(СтруктураШапки.Организация, СтруктураШапки.Дата);
	Запрос.УстановитьПараметр("ПоддержкаПБУ18", ПоддержкаПБУ18);
	
	Период  = НачалоГода(СтруктураШапки.Дата);
	ИспользуетсяУправлениеВНА_2_4 = ВнеоборотныеАктивы.ИспользуетсяУправлениеВНА_2_4(Период);
    Запрос.УстановитьПараметр("ИспользуетсяУправлениеВНА_2_4", ИспользуетсяУправлениеВНА_2_4);
	
	НомераТаблиц = Новый Структура;
	Запрос.Текст = ТекстЗапросаВключениеАктивовВСтоимостныйБаланс(НомераТаблиц);
	Результат = Запрос.ВыполнитьПакет();
	
	Для каждого НомерТаблицы Из НомераТаблиц Цикл
		ПараметрыПроведения.Вставить(НомерТаблицы.Ключ, Результат[НомерТаблицы.Значение].Выгрузить());
	КонецЦикла;
	
	Возврат ПараметрыПроведения;
	
КонецФункции

Функция ТекстЗапросаВключениеАктивовВСтоимостныйБаланс(НомераТаблиц)

	НомераТаблиц.Вставить("ТаблицаРеквизиты", НомераТаблиц.Количество());
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	РегламентнаяОперация.Ссылка КАК Регистратор,
	|	РегламентнаяОперация.Организация КАК Организация,
	|	РегламентнаяОперация.Дата КАК Период,
	|	&Содержание КАК Содержание,
	|	&ПоддержкаПБУ18 КАК ПоддержкаПБУ18
	|,	&ИспользуетсяУправлениеВНА_2_4 КАК ИспользуетсяУправлениеВНА_2_4
	|ИЗ
	|	Документ.РегламентнаяОперация КАК РегламентнаяОперация
	|ГДЕ
	|	РегламентнаяОперация.Ссылка = &Ссылка";
	
	Возврат ТекстЗапроса + ОбщегоНазначенияБПВызовСервера.ТекстРазделителяЗапросовПакета();

КонецФункции

Функция ПодготовитьТаблицыАктивыУчитываемыеОтдельно(ТаблицаРеквизиты, СписокОрганизаций, Отказ)
	
	Запрос = Новый Запрос;
	Реквизиты = ТаблицаРеквизиты[0];
	
	Запрос.УстановитьПараметр("НачДата", 									НачалоГода(Реквизиты.Период));
	Запрос.УстановитьПараметр("КонДата", 									КонецМесяца(Реквизиты.Период));
	Запрос.УстановитьПараметр("УчитываетсяОтдельноОтСтоимостногоБаланса",	Перечисления.СобытияФАУчитываемыхОтдельно.ПринятиеКУчету);	
	Запрос.УстановитьПараметр("СписокОрганизаций",							СписокОрганизаций);
	Запрос.УстановитьПараметр("ВидАктиваУчитываемогоОтдельно",				Перечисления.ВидАктиваНУ.ФиксированныйАктивУчитываемыйОтдельно);
	
	ИспользуетсяУправлениеВНА_2_4 = Реквизиты.ИспользуетсяУправлениеВНА_2_4;
	
	Если ИспользуетсяУправлениеВНА_2_4 Тогда
		СтоимостьВНААктуальна = ПроверитьАктуальностьРасчетаСтоимостиВНА(Реквизиты);
		
		Если НЕ СтоимостьВНААктуальна Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не выполнена регламентная операция по расчету стоимости ОС и НМА'"),
					Реквизиты.Регистратор.ПолучитьОбъект(),
					"",
					,
					Отказ);
		КонецЕсли;
	КонецЕсли;

	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ФиксированныеАктивыУчитываемыеОтдельноСрезПоследних.ФиксированныйАктив,
	|	ФиксированныеАктивыУчитываемыеОтдельноСрезПоследних.Организация,
	|	ФиксированныеАктивыУчитываемыеОтдельноСрезПоследних.ВидЛьготыФА
	|ПОМЕСТИТЬ ВТ_ФАУчитываемыеОтдельно
	|ИЗ
	|	РегистрСведений.ФиксированныеАктивыУчитываемыеОтдельно.СрезПоследних(&КонДата, Организация В (&СписокОрганизаций)) КАК ФиксированныеАктивыУчитываемыеОтдельноСрезПоследних
	|ГДЕ
	|	ФиксированныеАктивыУчитываемыеОтдельноСрезПоследних.Событие = &УчитываетсяОтдельноОтСтоимостногоБаланса
	|	И (ФиксированныеАктивыУчитываемыеОтдельноСрезПоследних.ВидЛьготыФА = ЗНАЧЕНИЕ(Перечисление.ВидыФАУчитываемыхОтдельно.ДвойнаяНормаАмортизации)
	|				И ФиксированныеАктивыУчитываемыеОтдельноСрезПоследних.Период < &НачДата
	|			ИЛИ ФиксированныеАктивыУчитываемыеОтдельноСрезПоследних.ВидЛьготыФА = ЗНАЧЕНИЕ(Перечисление.ВидыФАУчитываемыхОтдельно.ОбъектыПреференций)
	|				И ДОБАВИТЬКДАТЕ(ФиксированныеАктивыУчитываемыеОтдельноСрезПоследних.Период, ГОД, 3) < &НачДата)
	|ИНДЕКСИРОВАТЬ ПО
	|	Организация, 
	|	ФиксированныйАктив
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СчетаУчетаОС.Организация КАК Организация,
	|	СчетаУчетаОС.ОсновноеСредство КАК ОбъектУчета,
	|	ВЫБОР
	|		КОГДА СчетаУчетаОС.ГруппаФинансовогоУчета = ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаВнеоборотныхАктивов.ПустаяСсылка)
	|			ТОГДА СчетаУчетаОС.СчетУчета
	|		ИНАЧЕ СчетаУчетаОС.ГруппаФинансовогоУчета.СчетУчета
	|	КОНЕЦ КАК СчетУчета,
	|	ВЫБОР
	|		КОГДА СчетаУчетаОС.ГруппаФинансовогоУчета = ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаВнеоборотныхАктивов.ПустаяСсылка)
	|			ТОГДА СчетаУчетаОС.СчетНачисленияАмортизации
	|		ИНАЧЕ СчетаУчетаОС.ГруппаФинансовогоУчета.СчетУчетаАмортизации
	|	КОНЕЦ КАК СчетНачисленияАмортизации	
	|ПОМЕСТИТЬ ВТ_СчетаУчетаОСИНМА
	|ИЗ
	|	РегистрСведений.СчетаБухгалтерскогоУчетаОС.СрезПоследних(
	|			&НачДата,            
	|			Организация В (&СписокОрганизаций)
	|			И ОсновноеСредство В
	|				(ВЫБРАТЬ
	|					ВЫРАЗИТЬ(ВТ_ФАУчитываемыеОтдельно.ФиксированныйАктив КАК Справочник.ОбъектыЭксплуатации)
	|				ИЗ
	|					ВТ_ФАУчитываемыеОтдельно)) КАК СчетаУчетаОС
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СчетаУчетаНМА.Организация КАК Организация,
	|	СчетаУчетаНМА.НематериальныйАктив КАК ОбъектУчета,
	|	СчетаУчетаНМА."+?(ИспользуетсяУправлениеВНА_2_4, "ГруппаФинансовогоУчета.СчетУчета", "СчетУчета")+",
	|	СчетаУчетаНМА."+?(ИспользуетсяУправлениеВНА_2_4, "ГруппаФинансовогоУчета.СчетУчетаАмортизации", "СчетНачисленияАмортизации")+"
	|ИЗ
	|	РегистрСведений."+?(ИспользуетсяУправлениеВНА_2_4, "ПорядокУчетаНМА", "СчетаБухгалтерскогоУчетаНМА")+".СрезПоследних(
	|			&КонДата,
	|			Организация В (&СписокОрганизаций)
	|			И НематериальныйАктив В
	|				(ВЫБРАТЬ
	|					ВЫРАЗИТЬ(ВТ_ФАУчитываемыеОтдельно.ФиксированныйАктив КАК Справочник.НематериальныеАктивы)
	|				ИЗ
	|					ВТ_ФАУчитываемыеОтдельно)) КАК СчетаУчетаНМА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
