	ТаблицаРасчета.Колонки.Добавить("Коэффициент",        	ОписаниеТипаЧисла15_2);
	
	ТаблицаРасчета.Колонки.Добавить("ФиксированныйАктив",  	);
	ТаблицаРасчета.Колонки.Добавить("СтатьяРасходов",   	Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.СтатьиРасходов"));
	ТаблицаРасчета.Колонки.Добавить("Подразделение",  		Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия"));
	ТаблицаРасчета.Колонки.Добавить("ПодразделениеЗатрат",	Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия"));
	ТаблицаРасчета.Колонки.Добавить("МОЛ",  				Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
	ТаблицаРасчета.Колонки.Добавить("НаправлениеДеятельности",	Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"));
	ТаблицаРасчета.Колонки.Добавить("ГруппаФинансовогоУчета",  	Новый ОписаниеТипов("СправочникСсылка.ГруппыФинансовогоУчетаВнеоборотныхАктивов"));
	ТаблицаРасчета.Колонки.Добавить("Арендатор",  	Неопределено);
	
	ТаблицаРасчета.Колонки.Добавить("АналитикаРасходов",  	);
	ТаблицаРасчета.Колонки.Добавить("ПередаватьРасходыВДругуюОрганизацию",  	Новый ОписаниеТипов("Булево"));
	ТаблицаРасчета.Колонки.Добавить("ОрганизацияПолучательРасходов",  			Новый ОписаниеТипов("СправочникСсылка.Организации"));
	
