// ПРОЦЕДУРЫ И ФУНКЦИИ РАБОТЫ С ДВИЖЕНИЯМИ ДОКУМЕНТОВ ПО НУ

#Область ПрограммныйИнтерфейс

//Процедура-обработчик подписки на событие ОбработкаПроведения для документов, выполняющих движения по регистрам ОбъектыНалоговогоУчетаФА и ФиксированныеАктивыУчитываемыеОтдельно.
//Предназначена для формирования движений по указанным регистрам.
//
//Параметры:
//		Источник - ДокументОбъект - документ-регистратор для регистров ОбъектыНалоговогоУчетаФА и ФиксированныеАктивыУчитываемыеОтдельно
//		Отказ - Булево - флаг отказа
//		РежимПроведения - РежимПроведенияДокумента - Режим проведения документа
//
Процедура ПриПроведенииДокумента(Источник, Отказ, РежимПроведения) Экспорт

	ДатаУчетнойПолитики = ?(ТипЗнч(Источник) = Тип("ДокументОбъект.ВводОстатковВнеоборотныхАктивов") ИЛИ ТипЗнч(Источник) = Тип("ДокументОбъект.ВводОстатковВнеоборотныхАктивов2_4"), 
			КонецМесяца(Источник.Дата) + 1, Источник.Дата);
	ПлательщикНалогаНаПрибыль = УчетнаяПолитика.ПлательщикНалогаНаПрибыль(Источник.Организация, ДатаУчетнойПолитики);
	
	Если Отказ Или Не ПлательщикНалогаНаПрибыль Тогда
		Возврат;
	КонецЕсли;

	СтруктураРегистров = Новый Структура("ОбъектыНалоговогоУчетаФА, ФиксированныеАктивыУчитываемыеОтдельно",
		Не Источник.Движения.Найти("ОбъектыНалоговогоУчетаФА") = Неопределено,
		Не Источник.Движения.Найти("ФиксированныеАктивыУчитываемыеОтдельно") = Неопределено);

	ИнициализироватьДанныеДокумента(Источник, Источник.ДополнительныеСвойства, СтруктураРегистров);

	Если СтруктураРегистров.ОбъектыНалоговогоУчетаФА Тогда
		ДвижениеПоРегиструОбъектыНалоговогоУчетаФА(Источник.ДополнительныеСвойства, Источник.Движения, Отказ);
	КонецЕсли;

	Если СтруктураРегистров.ФиксированныеАктивыУчитываемыеОтдельно Тогда
		ДвижениеПоРегиструФиксированныеАктивыУчитываемыеОтдельно(Источник.ДополнительныеСвойства, Источник.Движения, Отказ);
	КонецЕсли;

КонецПроцедуры

Функция ОпределитьВидаАктиваНУ(ПорядокУчета) Экспорт
	
	Если Не ЗначениеЗаполнено(ПорядокУчета) Тогда
		ВидАктиваНУ = Неопределено;
	ИначеЕсли ПорядокУчета = Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации Тогда
		ВидАктиваНУ = Перечисления.ВидАктиваНУ.ФиксированныйАктив;
	ИначеЕсли ПорядокУчета = Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизацииПоДвойнойНорме
		Или ПорядокУчета = Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.ВключениеВРасходыПриПринятииКУчету
		Или ПорядокУчета = Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.ОтнесениеНаВычетыРавнымиДолями Тогда
		
		ВидАктиваНУ = Перечисления.ВидАктиваНУ.ФиксированныйАктивУчитываемыйОтдельно;
	Иначе
		ВидАктиваНУ = Перечисления.ВидАктиваНУ.НеФиксированныйАктив;
	КонецЕсли;
	
	Возврат ВидАктиваНУ;

КонецФункции

Процедура СоздатьКлючиАналитикиУчетаВА(ВидыАктиваНУ, ВидыДвиженияСтоимости) Экспорт
	
	ВидыДвижения = Новый Массив;
	ВидыАктива   = Новый Массив;
	
	Если ТипЗнч(ВидыДвиженияСтоимости) = Тип("ПеречислениеСсылка.ВидыДвиженияСтоимостиФА") Тогда
		ВидыДвижения.Добавить(ВидыДвиженияСтоимости);
	Иначе
		ВидыДвижения = ВидыДвиженияСтоимости;
	КонецЕсли;
	
	Если ТипЗнч(ВидыАктиваНУ) = Тип("ПеречислениеСсылка.ВидАктиваНУ") Тогда
		ВидыАктива.Добавить(ВидыАктиваНУ);
	Иначе
		ВидыАктива = ВидыАктиваНУ;
	КонецЕсли;
	
	ПараметрыКлюча = Новый Структура("ВидАктиваНУ, ВидДвиженияСтоимостиНУ");
	
	Для Каждого ВидАктива ИЗ ВидыАктива Цикл
		Для Каждого ВидДвиженияСтоимости Из ВидыДвижения Цикл
			ПараметрыКлюча.ВидАктиваНУ = ВидАктива;
			ПараметрыКлюча.ВидДвиженияСтоимостиНУ = ВидДвиженияСтоимости;
			
			КлючАналитикиВА = РегистрыСведений.АналитикаУчетаВнеоборотныхАктивов.ЗначениеКлючаАналитики(ПараметрыКлюча);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция ТекстОтраженияРемонтовВНУ(ДокументИмя) Экспорт
	
	ИмяПроцедуры = "ТекстОтражения" + ДокументИмя + "()";
	
	СписокДокументовКОтражению = ДокументыКОтражениюРасходовНаРемонты();
	
	Если СписокДокументовКОтражению.НайтиПоЗначению(ДокументИмя) = Неопределено Тогда
		ТекстЗапроса = "";
	Иначе
		ТекстЗапроса = Вычислить(ИмяПроцедуры);
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ЭтоСчетКапитализацииРасходовПоВНА(Счет) Экспорт
	
	Результат =
		(Счет = ПланыСчетов.Хозрасчетный.ПодготовкаКВводуВЭксплуатацию
		ИЛИ Счет = ПланыСчетов.Хозрасчетный.ПодготовкаКВводуВЭксплуатациюАрендованногоИмущества
		ИЛИ Счет = ПланыСчетов.Хозрасчетный.ПриобретениеЗемельныхУчастков
		ИЛИ Счет = ПланыСчетов.Хозрасчетный.ПриобретениеОбъектовПриродопользования
		ИЛИ Счет = ПланыСчетов.Хозрасчетный.СтроительствоОбъектовОсновныхСредств
		ИЛИ Счет = ПланыСчетов.Хозрасчетный.ПриобретениеНематериальныхАктивов
		ИЛИ Счет = ПланыСчетов.Хозрасчетный.ВыполнениеНИОКР
		ИЛИ Счет = ПланыСчетов.Хозрасчетный.ПодготовкаКВводуВЭксплуатациюИнвестицийВНедвижимость
		ИЛИ Счет = ПланыСчетов.Хозрасчетный.НематериальныеАктивыОрганизации
		ИЛИ Счет = ПланыСчетов.Хозрасчетный.Гудвилл);
		
	Возврат Результат;
	
КонецФункции

Функция ПодготовитьТаблицуЗакрытиеРемонтыВНУ(ТаблицаРеквизиты, Отказ) Экспорт
	
	ТаблицаЗакрытие = ТаблицаЗакрытие();
	Параметры       = ПодготовитьПараметрыЗакрытиеРемонтыВНУ(ТаблицаЗакрытие, ТаблицаРеквизиты);
	Реквизиты       = Параметры.Реквизиты[0];
	ТаблицаЗакрытиеРемонты = Параметры.ТаблицаЗакрытие;
	
	КонГраница = Новый Граница(Реквизиты.КонДата, ВидГраницы.Включая);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КонГраница",  КонГраница);
	Запрос.УстановитьПараметр("Организация", Реквизиты.Организация);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НалоговыйОстатки.Счет КАК Счет,
	|	НалоговыйОстатки.Подразделение 			 КАК Подразделение,
	|	НалоговыйОстатки.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	0 КАК СуммаСписанияУУ,
	|	0 КАК СуммаСписания,
	|	0 КАК СуммаСписанияФО,
	|	СУММА(ЕСТЬNULL(НалоговыйОстатки.СуммаНУОстатокДт, 0) - ЕСТЬNULL(НалоговыйОстатки.СуммаНУОстатокКт, 0)) КАК СуммаСписанияНУ,
	|	СУММА(ЕСТЬNULL(НалоговыйОстатки.СуммаПРОстатокДт, 0) - ЕСТЬNULL(НалоговыйОстатки.СуммаПРОстатокКт, 0)) КАК СуммаСписанияПР,
	|	СУММА(ЕСТЬNULL(НалоговыйОстатки.СуммаВРОстатокДт, 0) - ЕСТЬNULL(НалоговыйОстатки.СуммаВРОстатокКт, 0)) КАК СуммаСписанияВР
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(
	|			&КонГраница,
	|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасходыПоРемонтуОсновныхСредствВНУ),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.СтатьиЗатрат),
	|			Организация = &Организация
	|		) КАК НалоговыйОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	НалоговыйОстатки.Счет,
	|	НалоговыйОстатки.Подразделение,
	|	НалоговыйОстатки.НаправлениеДеятельности";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Выборка Из Результат Цикл
		Если Выборка.СуммаСписанияНУ <> 0 Тогда
			Запись = ТаблицаЗакрытиеРемонты.Добавить();
			Запись.СчетДт      = ПланыСчетов.Хозрасчетный.ПустаяСсылка();
			Запись.СчетКт      = ПланыСчетов.Хозрасчетный.РасходыПоРемонтуОсновныхСредствВНУ;
			
			Запись.Подразделение 			= Выборка.Подразделение;
			Запись.НаправлениеДеятельности 	= Выборка.НаправлениеДеятельности;
			
			Запись.СуммаУУ     = Выборка.СуммаСписанияУУ;
			Запись.Сумма       = Выборка.СуммаСписания;
			Запись.СуммаФО     = Выборка.СуммаСписанияФО;
			Запись.СуммаНУ     = Выборка.СуммаСписанияНУ;
			Запись.СуммаПР     = Выборка.СуммаСписанияПР;
			Запись.СуммаВР     = Выборка.СуммаСписанияВР;
			Запись.Содержание  = НСтр("ru = 'Закрытие счета затрат по ремонтам и объектам преференций в НУ'");
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТаблицаЗакрытиеРемонты;
	
КонецФункции

Процедура СозатьКлючиАналитикиУчетаАмортизации() Экспорт
	
	ВидыАктиваНУ = Новый Массив;
	ВидыАктиваНУ.Добавить(Перечисления.ВидАктиваНУ.НеФиксированныйАктив);
	ВидыАктиваНУ.Добавить(Перечисления.ВидАктиваНУ.ФиксированныйАктив);
	ВидыАктиваНУ.Добавить(Перечисления.ВидАктиваНУ.ФиксированныйАктивУчитываемыйОтдельно);
	
	УчетФиксированныхАктивов.СоздатьКлючиАналитикиУчетаВА(ВидыАктиваНУ, Перечисления.ВидыДвиженияСтоимостиФА.Амортизация);
	
КонецПроцедуры

#Область РегламентныеОперацииПоФиксированнымАктивам

Процедура РасчетДоходовИВычетовПоФАНУ(СтруктураШапкиДокумента, Движения, Отказ) Экспорт
	
	// ПОДГОТОВКА ПРОВЕДЕНИЯ ПО ДАННЫМ ДОКУМЕНТА
	
	ПараметрыПроведения = ПодготовитьПараметрыПроведенияРасчетВычетовФАНУ(СтруктураШапкиДокумента, Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// ПОДГОТОВКА ПРОВЕДЕНИЯ ПО ДАННЫМ ИНФОРМАЦИОННОЙ БАЗЫ
	
	ТаблицаВычетыФА = ПодготовитьТаблицыРасчетВычетовФАНУ(
		ПараметрыПроведения.ТаблицаРеквизиты,
		СтруктураШапкиДокумента.СписокОрганизаций,
		Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// ФОРМИРОВАНИЕ ДВИЖЕНИЙ
	
	СформироватьДвиженияРасчетВычетовФАНУ(
		ТаблицаВычетыФА,
		ПараметрыПроведения.ТаблицаРеквизиты,
		Движения,
		Отказ);
		
КонецПроцедуры

Функция ПараметрыУчетнойПолитикиПоВычетамФА(Организация, Период) Экспорт
	
	Запрос = Новый Запрос("
		|ВЫБРАТЬ
		|	УчетныеПолитики.СписыватьСтоимостныйБалансПриВыбытииВсехФАГруппы,
		|	УчетныеПолитики.РассчитыватьДоходОтПревышенияСтоимостиВыбывшихФА,
		|	УчетныеПолитики.СписыватьСтоимостныйБалансГруппыМенееМинимума,
		|	УчетныеПолитики.АмортизацияФАНУ
		|ИЗ
		|	РегистрСведений.УчетнаяПолитикаОрганизаций.СрезПоследних(&Период,
		|							Организация = &Организация) КАК ДанныеРегистра
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.УчетныеПолитикиОрганизаций КАК УчетныеПолитики
		|		ПО ДанныеРегистра.УчетнаяПолитика = УчетныеПолитики.Ссылка");

	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Организация", Организация);

	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	СтруктураПараметров = Новый Структура;
	Для Каждого Колонка Из Результат.Колонки Цикл
		СтруктураПараметров.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);
	КонецЦикла;
	
	Возврат СтруктураПараметров;

КонецФункции

Процедура ВключениеВСтоимостныйБалансАктивовУчитываемыхОтдельно(СтруктураШапкиДокумента, Движения, Отказ) Экспорт
	
	// ПОДГОТОВКА ПРОВЕДЕНИЯ ПО ДАННЫМ ДОКУМЕНТА
	ПараметрыПроведения = ПодготовитьПараметрыПроведенияВключениеАктивовВСБ(СтруктураШапкиДокумента, Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// ПОДГОТОВКА ПРОВЕДЕНИЯ ПО ДАННЫМ ИНФОРМАЦИОННОЙ БАЗЫ
	ТаблицаАктивыУчитываемыеОтдельно = ПодготовитьТаблицыАктивыУчитываемыеОтдельно(
		ПараметрыПроведения.ТаблицаРеквизиты,
		СтруктураШапкиДокумента.СписокОрганизаций,
		Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// ФОРМИРОВАНИЕ ДВИЖЕНИЙ
	
	СформироватьДвиженияВключениеАктивовВСтоимостныйБаланс(
		ТаблицаАктивыУчитываемыеОтдельно,
		ПараметрыПроведения.ТаблицаРеквизиты,
		Движения,
		Отказ);		

КонецПроцедуры

Процедура СписаниеРезерваПоПереоценкеВНА(СтруктураШапкиДокумента, Движения, Отказ) Экспорт
	
	// ПОДГОТОВКА ПРОВЕДЕНИЯ ПО ДАННЫМ ДОКУМЕНТА
	
	ПараметрыПроведения = ПодготовитьПараметрыСписанияРезерваПоПереоценкеВНА(СтруктураШапкиДокумента, Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// ПОДГОТОВКА ПРОВЕДЕНИЯ ПО ДАННЫМ ИНФОРМАЦИОННОЙ БАЗЫ
	
	ТаблицаСписанияРезерваВНА = ПодготовитьТаблицыСписанияРезерваПоПереоценкеВНА(
		ПараметрыПроведения.ТаблицаРеквизиты,
		СтруктураШапкиДокумента.СписокОрганизаций,
		Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// ФОРМИРОВАНИЕ ДВИЖЕНИЙ
	
	СформироватьДвиженияСписаниеРезерваПоПереоценкеВНА(
		ТаблицаСписанияРезерваВНА,
		ПараметрыПроведения.ТаблицаРеквизиты,
		Движения,
		Отказ);
		
	
КонецПроцедуры

#КонецОбласти 

#Область ОтражениеВРеглУчете

Функция ТекстЗапросаВТОтраженияВНалУчетеОС(Документ, Движение, ТекстыВременныхТаблиц) Экспорт
	
	ТекстыВременныхТаблиц.Добавить(УчетФиксированныхАктивов.ТекстЗапросаВТОбъектыНалоговогоУчетаФАОС(Документ));
	ТекстыВременныхТаблиц.Добавить(УчетФиксированныхАктивов.ТекстЗапросаВТФиксированныеАктивыУчитываемыеОтдельноОС(Документ));
	ТекстыВременныхТаблиц.Добавить(УчетФиксированныхАктивов.ТекстЗапросаВТВидыАктиваОС(Документ));
	ТекстыВременныхТаблиц.Добавить(УчетФиксированныхАктивов.ТекстЗапросаВТАналитикаУчетаВАОС(Движение));
	
	Если ТипЗнч(ТекстыВременныхТаблиц) = Тип("СписокЗначений") Тогда
