#Область ЗакрытиеЗабалансовогоСчетаРемонтыВНУ

Функция ТаблицаЗакрытие()
	
	ОписаниеТипаЧисла15_2 = ОбщегоНазначенияБПКлиентСервер.ПолучитьОписаниеТиповЧисла(15, 2);
	ОписаниеТипаЧисла15_3 = ОбщегоНазначенияБПКлиентСервер.ПолучитьОписаниеТиповЧисла(15, 3);
	ОписаниеТипаСчетХозр  = Новый ОписаниеТипов("ПланСчетовСсылка.Хозрасчетный");
	
	ТаблицаЗакрытие = Новый ТаблицаЗначений;
	ТаблицаЗакрытие.Колонки.Добавить("СчетДт",        ОписаниеТипаСчетХозр);
	ТаблицаЗакрытие.Колонки.Добавить("СчетКт",        ОписаниеТипаСчетХозр);
	ТаблицаЗакрытие.Колонки.Добавить("Подразделение", 			Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия"));
	ТаблицаЗакрытие.Колонки.Добавить("НаправлениеДеятельности", Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"));
	ТаблицаЗакрытие.Колонки.Добавить("СубконтоДт1");
	ТаблицаЗакрытие.Колонки.Добавить("СубконтоКт1");
	ТаблицаЗакрытие.Колонки.Добавить("СуммаУУ",       ОписаниеТипаЧисла15_2);
	ТаблицаЗакрытие.Колонки.Добавить("Сумма",         ОписаниеТипаЧисла15_2);
	ТаблицаЗакрытие.Колонки.Добавить("СуммаФО",       ОписаниеТипаЧисла15_2);
	ТаблицаЗакрытие.Колонки.Добавить("СуммаНУ",       ОписаниеТипаЧисла15_2);
	ТаблицаЗакрытие.Колонки.Добавить("СуммаПР",       ОписаниеТипаЧисла15_2);
	ТаблицаЗакрытие.Колонки.Добавить("СуммаВР",       ОписаниеТипаЧисла15_2);
	ТаблицаЗакрытие.Колонки.Добавить("КоличествоДт",  ОписаниеТипаЧисла15_3);
	ТаблицаЗакрытие.Колонки.Добавить("КоличествоКт",  ОписаниеТипаЧисла15_3);
	ТаблицаЗакрытие.Колонки.Добавить("Содержание",    ОбщегоНазначенияБПКлиентСервер.ПолучитьОписаниеТиповСтроки(150));
	
	Возврат ТаблицаЗакрытие;
	
КонецФункции

Функция ПодготовитьПараметрыЗакрытиеРемонтыВНУ(ТаблицаЗакрытие, ТаблицаРеквизиты)
	
	Параметры = Новый Структура;
	
	// Подготовка таблицы Параметры.ТаблицаЗакрытие
	СписокОбязательныхКолонок = ""
	+ "СчетДт,"        // <ПланСчетовСсылка.Хозрасчетный>
	+ "СчетКт,"        // <ПланСчетовСсылка.Хозрасчетный>
	+ "Подразделение," // <Ссылка на справочник подразделений>
	+ "НаправлениеДеятельности," // <Ссылка на справочник подразделений>
	+ "СубконтоДт1,"
	+ "СубконтоКт1,"
	+ "СуммаУУ,"       // <Число, 15, 2>
	+ "СуммаФО,"       // <Число, 15, 2>
	+ "Сумма,"         // <Число, 15, 2>
	+ "СуммаНУ,"       // <Число, 15, 2>
	+ "СуммаПР,"       // <Число, 15, 2>
	+ "СуммаВР,"       // <Число, 15, 2>
	+ "КоличествоДт,"  // <Число, 15, 3>
	+ "КоличествоКт,"  // <Число, 15, 3>
	+ "Содержание"     // <Строка, 150>
	;
	
	ТаблицаПараметров = ОбщегоНазначенияБПВызовСервера.ПолучитьТаблицуПараметровПроведения(
		ТаблицаЗакрытие,
		СписокОбязательныхКолонок);
	Параметры.Вставить("ТаблицаЗакрытие", ТаблицаПараметров);
	
	// Подготовка таблицы Параметры.Реквизиты
	СписокОбязательныхКолонок = ""
	+ "Период,"                  // <Дата>
	+ "НачалоГода,"              // <Дата>
	+ "НачДата,"                 // <Дата>
	+ "КонДата,"                 // <Дата>
	+ "Организация,"             // <СправочникСсылка.Организации>
	+ "Регистратор,"             // <ДокументСсылка.*>
	+ "СодержаниеЗакрытиеГода"   // <Строка, 150>
	;
	
	ТаблицаПараметров = ОбщегоНазначенияБПВызовСервера.ПолучитьТаблицуПараметровПроведения(
		ТаблицаРеквизиты,
		СписокОбязательныхКолонок);
	Параметры.Вставить("Реквизиты", ТаблицаПараметров);
	Возврат Параметры;
	
КонецФункции

#КонецОбласти

#Область РасчетАмортизации_ФАНУ

Функция ПодготовитьПараметрыПроведенияРасчетВычетовФАНУ(СтруктураШапки, Отказ) Экспорт
	
	ПараметрыПроведения = Новый Структура;

	Содержание  = НСтр("ru = 'Начислена амортизация фиксированных активов в НУ'");
	
	ПараметрыУчетнойПолитики = ПараметрыУчетнойПолитикиПоВычетамФА(СтруктураШапки.Организация, СтруктураШапки.Дата);
	
	Период  = НачалоГода(СтруктураШапки.Дата);
	ИспользуетсяУправлениеВНА_2_4 = ВнеоборотныеАктивы.ИспользуетсяУправлениеВНА_2_4(Период);
	
	Если ПараметрыУчетнойПолитики = Неопределено Тогда
		СписыватьСтоимостныйБалансПриВыбытииВсехФАГруппы = Ложь;
		РассчитыватьДоходОтПревышенияСтоимостиВыбывшихФА = Ложь;
		СписыватьСтоимостныйБалансГруппыМенееМинимума = Ложь;
		АмортизацияФАНУ = Ложь;
	Иначе
		СписыватьСтоимостныйБалансПриВыбытииВсехФАГруппы = ПараметрыУчетнойПолитики.СписыватьСтоимостныйБалансПриВыбытииВсехФАГруппы;
		РассчитыватьДоходОтПревышенияСтоимостиВыбывшихФА = ПараметрыУчетнойПолитики.РассчитыватьДоходОтПревышенияСтоимостиВыбывшихФА;
		СписыватьСтоимостныйБалансГруппыМенееМинимума = ПараметрыУчетнойПолитики.СписыватьСтоимостныйБалансГруппыМенееМинимума;
		АмортизацияФАНУ = ПараметрыУчетнойПолитики.АмортизацияФАНУ;
	КонецЕсли;	
	
	
	Запрос = Новый Запрос;
		
	Запрос.УстановитьПараметр("Ссылка", СтруктураШапки.Ссылка);
	Запрос.УстановитьПараметр("Содержание", Содержание);
	Запрос.УстановитьПараметр("СписыватьСтоимостныйБалансПриВыбытииВсехФАГруппы", СписыватьСтоимостныйБалансПриВыбытииВсехФАГруппы);
	Запрос.УстановитьПараметр("СписыватьСтоимостныйБалансГруппыМенееМинимума", СписыватьСтоимостныйБалансГруппыМенееМинимума);
	Запрос.УстановитьПараметр("РассчитыватьДоходОтПревышенияСтоимостиВыбывшихФА", РассчитыватьДоходОтПревышенияСтоимостиВыбывшихФА);
	Запрос.УстановитьПараметр("АмортизацияФАНУ", АмортизацияФАНУ);
	Запрос.УстановитьПараметр("ИспользуетсяУправлениеВНА_2_4", ИспользуетсяУправлениеВНА_2_4);
	
	ПоддержкаПБУ18  = УчетнаяПолитика.ПоддержкаПБУ18(СтруктураШапки.Организация, СтруктураШапки.Дата);
	Запрос.УстановитьПараметр("ПоддержкаПБУ18", ПоддержкаПБУ18);
	
	НомераТаблиц = Новый Структура;
	Запрос.Текст = ТекстЗапросаРасчетАмортизацииФАНУ(НомераТаблиц);
	Результат = Запрос.ВыполнитьПакет();
	
	Для каждого НомерТаблицы Из НомераТаблиц Цикл
		ПараметрыПроведения.Вставить(НомерТаблицы.Ключ, Результат[НомерТаблицы.Значение].Выгрузить());
	КонецЦикла;
	
	Возврат ПараметрыПроведения;
	
КонецФункции

Функция ТекстЗапросаРасчетАмортизацииФАНУ(НомераТаблиц)

	НомераТаблиц.Вставить("ТаблицаРеквизиты", НомераТаблиц.Количество());
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	РегламентнаяОперация.Ссылка КАК Регистратор,
	|	РегламентнаяОперация.Организация КАК Организация,
	|	РегламентнаяОперация.Дата КАК Период,
	|	&СписыватьСтоимостныйБалансПриВыбытииВсехФАГруппы КАК СписыватьСтоимостныйБалансПриВыбытииВсехФАГруппы,
	|	&СписыватьСтоимостныйБалансГруппыМенееМинимума КАК СписыватьСтоимостныйБалансГруппыМенееМинимума,
	|	&РассчитыватьДоходОтПревышенияСтоимостиВыбывшихФА КАК РассчитыватьДоходОтПревышенияСтоимостиВыбывшихФА,
	|	&АмортизацияФАНУ КАК АмортизацияФАНУ,
	|	&ПоддержкаПБУ18 КАК ПоддержкаПБУ18,
	|   &ИспользуетсяУправлениеВНА_2_4 КАК ИспользуетсяУправлениеВНА_2_4
	|ИЗ
	|	Документ.РегламентнаяОперация КАК РегламентнаяОперация
	|ГДЕ
	|	РегламентнаяОперация.Ссылка = &Ссылка";
	
	Возврат ТекстЗапроса + ОбщегоНазначенияБПВызовСервера.ТекстРазделителяЗапросовПакета();

КонецФункции

Функция ПроверитьАктуальностьРасчетаСтоимостиВНА(Реквизиты)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	|	Задания.Организация,
	|	МИНИМУМ(НАЧАЛОПЕРИОДА(Задания.Месяц, МЕСЯЦ)) КАК Месяц
	|ИЗ
	|	РегистрСведений.ЗаданияКРасчетуСтоимостиВНА КАК Задания
	|ГДЕ
	|	НАЧАЛОПЕРИОДА(Задания.Месяц, МЕСЯЦ) <= &Период
	|	И Задания.Организация = &Организация
	|
	|СГРУППИРОВАТЬ ПО
	|	Задания.Организация";
	
	Запрос.УстановитьПараметр("Организация", Реквизиты.Организация);
	Запрос.УстановитьПараметр("Период", Реквизиты.Период);
	Результат = Запрос.Выполнить();
	
	СтоимостьВНААктуальна = Истина;
	Если Не Результат.Пустой() Тогда
		СтоимостьВНААктуальна = Ложь;
	КонецЕсли;
	
	Возврат СтоимостьВНААктуальна;
	
КонецФункции

Функция ПодготовитьТаблицыРасчетВычетовФАНУ(ТаблицаРеквизиты, СписокОрганизаций, Отказ) Экспорт
	
	РасчетВычетовПоФА = ПолучитьТаблицаРасчетВычетовПоФА();
	
	СтруктураТаблиц = Новый Структура();
	СтруктураТаблиц.Вставить("ТаблицаРасходыПоАмортизацииНУ");
	
	Параметры = ПодготовитьПараметрыРасчетАмортизацииНУ(РасчетВычетовПоФА, ТаблицаРеквизиты);
	Если Параметры.Реквизиты.Количество() = 0 Тогда
		Возврат СтруктураТаблиц;
	КонецЕсли;
	
	Реквизиты = Параметры.Реквизиты[0];
	
	Если Реквизиты.ИспользуетсяУправлениеВНА_2_4 Тогда
		СтоимостьВНААктуальна = ПроверитьАктуальностьРасчетаСтоимостиВНА(Реквизиты);
		
		Если НЕ СтоимостьВНААктуальна Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не выполнена регламентная операция по расчету стоимости ОС и НМА'"),
					Реквизиты.Регистратор.ПолучитьОбъект(),
					"",
					,
					Отказ);
		КонецЕсли;
	КонецЕсли;
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	МассивРезультатов = РассчитатьВычетыФАНУ(Реквизиты, СписокОрганизаций, МенеджерВременныхТаблиц);
	
	СтруктураТаблиц.Вставить("ТаблицаДоходы", 				 МассивРезультатов[0].Выгрузить());
	СтруктураТаблиц.Вставить("ТаблицаСписаниеПриВыбытии", 	 МассивРезультатов[1].Выгрузить());
	СтруктураТаблиц.Вставить("ТаблицаСписаниеМенееМинимума", МассивРезультатов[2].Выгрузить());
	
	ТаблицаАмортизацииПрямая = Новый ТаблицаЗначений;
	ТаблицаАмортизацииКРаспределению = Новый ДеревоЗначений;
	
	Если Реквизиты.АмортизацияФАНУ Тогда
		МассивРезультатов = ПодготовитьТаблицуАмортизацииФАНУ(Реквизиты, МенеджерВременныхТаблиц);
		
		ТаблицаАмортизацииКРаспределению = МассивРезультатов[0].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
		ТаблицаАмортизацииПрямая = МассивРезультатов[1].Выгрузить();
	КонецЕсли;	
	
	ТаблицаЗатрат = ПолучитьТаблицаРасчетВычетовПоФА();
	
	Для Каждого СтрокаАмортизации Из ТаблицаАмортизацииПрямая Цикл 
		СтрокаЗатрат = ТаблицаЗатрат.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаЗатрат, СтрокаАмортизации);
		СтрокаЗатрат.Сумма = СтрокаАмортизации.РасчетнаяАмортизацияФА; 
	КонецЦикла;	
	
	ТаблицаРаспределения = РаспределитьРасходыПоАмортизации(ТаблицаЗатрат, ТаблицаАмортизацииКРаспределению);
	
	СтруктураТаблиц.Вставить("ТаблицаРасчетАмортизацииНУ", ТаблицаЗатрат);
	
	Возврат СтруктураТаблиц;
	
КонецФункции

Функция ПодготовитьПараметрыРасчетАмортизацииНУ(ТаблицаПроводок, ТаблицаРеквизиты)
	
	Параметры = Новый Структура;
	
	// Подготовка таблицы Параметры.Реквизиты
	
	СписокОбязательныхКолонок = ""
	+ "Период,"												// <Дата>
	+ "Организация,"										// <СправочникСсылка.Организации>
	+ "Регистратор,"										// <ДокументСсылка.*>
	+ "СписыватьСтоимостныйБалансПриВыбытииВсехФАГруппы,"	// <Булево>
	+ "СписыватьСтоимостныйБалансГруппыМенееМинимума,"		// <Булево>
	+ "РассчитыватьДоходОтПревышенияСтоимостиВыбывшихФА,"	// <Булево>
	+ "АмортизацияФАНУ,"									// <Булево>
	+ "ИспользуетсяУправлениеВНА_2_4";    					// <Булево>
	
	Параметры.Вставить("Реквизиты", 
		ОбщегоНазначенияБПВызовСервера.ПолучитьТаблицуПараметровПроведения(ТаблицаРеквизиты, СписокОбязательныхКолонок));
	
	Возврат Параметры;
	
КонецФункции

Функция РассчитатьВычетыФАНУ(Реквизиты, СписокОрганизаций, МенеджерВременныхТаблиц)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("НачДата",           				Новый Граница (НачалоГода(Реквизиты.Период),ВидГраницы.Включая));
	Запрос.УстановитьПараметр("КонДата",           				Новый Граница (КонецГода(Реквизиты.Период),ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", 	  				Реквизиты.Организация);
	Запрос.УстановитьПараметр("СписокОрганизаций", 				СписокОрганизаций);
	Запрос.УстановитьПараметр("СписыватьГруппыМенееМинимума", 	Реквизиты.СписыватьСтоимостныйБалансГруппыМенееМинимума);
	Запрос.УстановитьПараметр("НачислятьАмортизацию", 			Реквизиты.АмортизацияФАНУ);
	
	Запрос.Текст = "
	|ВЫБРАТЬ 
	|	МесячныйРасчетныйПоказатель.Размер КАК МРП
	|ИЗ
	|	РегистрСведений.МесячныйРасчетныйПоказатель.СрезПоследних(&КонДата) КАК МесячныйРасчетныйПоказатель
	|";
	
	Результат = Запрос.Выполнить(); 
	Если Не Результат.Пустой() Тогда
		Таблица = Результат.Выгрузить();
		СтавкаМРП = Таблица[0].МРП;
	Иначе
		СтавкаМРП = 0;
	КонецЕсли;	
	
	Запрос.УстановитьПараметр("СтавкаМРП", СтавкаМРП);
	
	ИспользуетсяУправлениеВНА_2_4 = Реквизиты.ИспользуетсяУправлениеВНА_2_4;
	
	Запрос.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОбъектыНалоговогоУчетаФА.Организация КАК Организация,
	|	ОбъектыНалоговогоУчетаФА.ФиксированныйАктив КАК ФиксированныйАктив,
	|	ОбъектыНалоговогоУчетаФА.СостояниеФиксированногоАктива КАК СостояниеФиксированногоАктива,
	|	ИСТИНА КАК ВходитВСтоимостныйБалансГруппы
	|ПОМЕСТИТЬ ВТ_СписокОбъектов
	|ИЗ
	|	РегистрСведений.ОбъектыНалоговогоУчетаФА.СрезПоследних(&КонДата, Организация В (&СписокОрганизаций)) КАК ОбъектыНалоговогоУчетаФА
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ФиксированныеАктивыУчитываемыеОтдельно.Организация,
	|	ФиксированныеАктивыУчитываемыеОтдельно.ФиксированныйАктив,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСостоянийФА.ПринятКУчету),
	|	ЛОЖЬ
	|ИЗ
	|	РегистрСведений.ФиксированныеАктивыУчитываемыеОтдельно.СрезПоследних(
	|			&КонДата,
	|			Организация В (&СписокОрганизаций)
	|				) КАК ФиксированныеАктивыУчитываемыеОтдельно
	|ГДЕ ФиксированныеАктивыУчитываемыеОтдельно.Событие <> ЗНАЧЕНИЕ(Перечисление.СобытияФАУчитываемыхОтдельно.ВключениеВСоставГруппы)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПервоначальныеСведенияОСНУ.ОсновноеСредство КАК ОбъектУчета,
	|	ПервоначальныеСведенияОСНУ."+?(ИспользуетсяУправлениеВНА_2_4, "ПорядокУчетаНУ", "ПорядокВключенияСтоимостиВСоставРасходов")+" КАК ПорядокПогашенияСтоимостиНУ,
	|	ПервоначальныеСведенияОСНУ.АмортизационнаяГруппа КАК ГруппаФА
	|ПОМЕСТИТЬ ВТ_ПервоначальныеСведенияОбъектов
	|ИЗ
	|	РегистрСведений.ПервоначальныеСведенияОС"+?(ИспользуетсяУправлениеВНА_2_4, "", "НалоговыйУчет")+".СрезПоследних(
	|			&КонДата,
	|			ОсновноеСредство В
	|				(ВЫБРАТЬ
	|					СписокОбъектов.ФиксированныйАктив
	|				ИЗ
	|					ВТ_СписокОбъектов КАК СписокОбъектов)) КАК ПервоначальныеСведенияОСНУ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПервоначальныеСведенияНМАНУ.НематериальныйАктив,
	|	ПервоначальныеСведенияНМАНУ."+?(ИспользуетсяУправлениеВНА_2_4, "ПорядокУчетаНУ", "ПорядокВключенияСтоимостиВСоставРасходов")+",
	|	ПервоначальныеСведенияНМАНУ.АмортизационнаяГруппа
	|ИЗ
	|	РегистрСведений.ПервоначальныеСведенияНМА"+?(ИспользуетсяУправлениеВНА_2_4, "", "НалоговыйУчет")+".СрезПоследних(
	|			&КонДата,
	|			НематериальныйАктив В
	|				(ВЫБРАТЬ
	|					СписокОбъектов.ФиксированныйАктив
	|				ИЗ
	|					ВТ_СписокОбъектов КАК СписокОбъектов)) КАК ПервоначальныеСведенияНМАНУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СписокОбъектов.Организация КАК Организация,
	|	СписокОбъектов.ФиксированныйАктив КАК ФиксированныйАктив,
	|	СписокОбъектов.СостояниеФиксированногоАктива КАК СостояниеФиксированногоАктива,
	|	СписокОбъектов.ВходитВСтоимостныйБалансГруппы КАК ВходитВСтоимостныйБалансГруппы,
	|	ПервоначальныеСведения.ПорядокПогашенияСтоимостиНУ КАК ПорядокПогашенияСтоимостиНУ,
	|	ПервоначальныеСведения.ГруппаФА КАК ГруппаФА,
	|	ВЫБОР
	|		КОГДА ПервоначальныеСведения.ГруппаФА = ЗНАЧЕНИЕ(Перечисление.АмортизационныеГруппы.ПерваяГруппа)
	|			ТОГДА СписокОбъектов.ФиксированныйАктив
	|		ИНАЧЕ ПервоначальныеСведения.ГруппаФА	
	|	КОНЕЦ КАК ГруппаУчетаФА
	|ПОМЕСТИТЬ ВТ_ОбъектыНалоговогоУчетаФА
	|ИЗ
	|	ВТ_СписокОбъектов КАК СписокОбъектов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПервоначальныеСведенияОбъектов КАК ПервоначальныеСведения
	|		ПО СписокОбъектов.ФиксированныйАктив = ПервоначальныеСведения.ОбъектУчета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СчетаУчетаОС.Организация КАК Организация,
	|	СчетаУчетаОС.ОсновноеСредство КАК ОбъектУчета,
	|	ВЫБОР
	|		КОГДА СчетаУчетаОС.ГруппаФинансовогоУчета = ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаВнеоборотныхАктивов.ПустаяСсылка)
	|			ТОГДА СчетаУчетаОС.СчетУчета
	|		ИНАЧЕ СчетаУчетаОС.ГруппаФинансовогоУчета.СчетУчета
	|	КОНЕЦ КАК СчетУчета,
	|	ВЫБОР
	|		КОГДА СчетаУчетаОС.ГруппаФинансовогоУчета = ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаВнеоборотныхАктивов.ПустаяСсылка)
	|			ТОГДА СчетаУчетаОС.СчетНачисленияАмортизации
	|		ИНАЧЕ СчетаУчетаОС.ГруппаФинансовогоУчета.СчетУчетаАмортизации
	|	КОНЕЦ КАК СчетНачисленияАмортизации
	|ПОМЕСТИТЬ ВТ_СчетаУчетаОСИНМА
	|ИЗ
	|	РегистрСведений.СчетаБухгалтерскогоУчетаОС.СрезПоследних(
	|			&КонДата,
	|			(ОсновноеСредство, Организация) В
	|				(ВЫБРАТЬ
	|					ВЫРАЗИТЬ(ВТ_ОбъектыНалоговогоУчетаФА.ФиксированныйАктив КАК Справочник.ОбъектыЭксплуатации),
