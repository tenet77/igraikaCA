	|
	|";
#КонецОбласти
	
	Возврат ТекстРегистрацияПрочихРасходов
		+ " ОБЪЕДИНИТЬ ВСЕ " + ТекстСписаниеПрочихРасходов
		+ " ОБЪЕДИНИТЬ ВСЕ " + ТекстСторнированиеПрочихРасходов
