	|	СтоимостьНМАОстатки.ГруппаФинансовогоУчета КАК ГруппаФинансовогоУчета,
	|	СтоимостьНМАОстатки.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ВЫРАЗИТЬ(ВТ_ИтогиРезерваПереоценкиКСписанию.РезервСтоимости * ВТ_ИтогиРезерваПереоценкиКСписанию.КоэффициентСписанияРезерва КАК ЧИСЛО(15, 2)) КАК СуммаСписанияРезерваСтоимости,
	|	ВЫРАЗИТЬ(ВТ_ИтогиРезерваПереоценкиКСписанию.РезервСтоимостиРегл * ВТ_ИтогиРезерваПереоценкиКСписанию.КоэффициентСписанияРезерваРегл КАК ЧИСЛО(15, 2)) КАК СуммаСписанияРезерваСтоимостиРегл,
	|	ВЫРАЗИТЬ(ВТ_ИтогиРезерваПереоценкиКСписанию.РезервАмортизации * ВТ_ИтогиРезерваПереоценкиКСписанию.КоэффициентСписанияРезерва КАК ЧИСЛО(15, 2)) КАК СуммаСписанияРезерваАмортизации,
	|	ВЫРАЗИТЬ(ВТ_ИтогиРезерваПереоценкиКСписанию.РезервАмортизацииРегл * ВТ_ИтогиРезерваПереоценкиКСписанию.КоэффициентСписанияРезерваРегл КАК ЧИСЛО(15, 2)) КАК СуммаСписанияРезерваАмортизацииРегл
	|ИЗ
	|	ВТ_ИтогиРезерваПереоценкиНМАКСписанию КАК ВТ_ИтогиРезерваПереоценкиКСписанию
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.СтоимостьНМА.Остатки(
	|				&КонДата,
	|				(Организация, НематериальныйАктив) В
	|					(ВЫБРАТЬ
	|						ВТ_ОстаткиРезервовПереоценкиНМАИтоги.Организация КАК Организация,
	|						ВТ_ОстаткиРезервовПереоценкиНМАИтоги.НематериальныйАктив КАК НематериальныйАктив
	|					ИЗ
	|						ВТ_ОстаткиРезервовПереоценкиНМАИтоги КАК ВТ_ОстаткиРезервовПереоценкиНМАИтоги)) КАК СтоимостьНМАОстатки
	|		ПО ВТ_ИтогиРезерваПереоценкиКСписанию.Организация = СтоимостьНМАОстатки.Организация
	|			И ВТ_ИтогиРезерваПереоценкиКСписанию.НематериальныйАктив = СтоимостьНМАОстатки.НематериальныйАктив";
	
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаДляРасчетаНМА = РезультатЗапроса.Выгрузить();
	
	МассивТаблицРасчета.Вставить("ТаблицаДляРасчетаНМА", ТаблицаДляРасчетаНМА);

	Возврат МассивТаблицРасчета;
	
КонецФункции

Процедура СформироватьДвиженияСписаниеРезерваПоПереоценкеВНА(ТаблицаСписанияРезерваВНА, ТаблицаРеквизиты, Движения, Отказ)
	
	Реквизиты = ТаблицаРеквизиты[0];
	
	//Движения по списанию резерва переоценки основных средств
	Для Каждого СтрокаСписанияРезерва Из ТаблицаСписанияРезерваВНА.ТаблицаДляРасчетаОС Цикл
		
		//Формирование движений по РН СтоимостьОС
		СтрокаСтоимостьОС = Движения.СтоимостьОС.ДобавитьРасход();
		СтрокаСтоимостьОС.Период = Реквизиты.Период;
		ЗаполнитьЗначенияСвойств(СтрокаСтоимостьОС, СтрокаСписанияРезерва);
		СтрокаСтоимостьОС.РезервПереоценкиСтоимости = СтрокаСписанияРезерва.СуммаСписанияРезерваСтоимости;
		СтрокаСтоимостьОС.РезервПереоценкиСтоимостиРегл = СтрокаСписанияРезерва.СуммаСписанияРезерваСтоимостиРегл;
		СтрокаСтоимостьОС.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СписаниеРезерваПереоценкиСтоимостиОС;
		
		//Формирование движений по РН АмортизацияОС
		СтрокаАмортизацияОС = Движения.АмортизацияОС.ДобавитьПриход();
		СтрокаАмортизацияОС.Период = Реквизиты.Период;
		ЗаполнитьЗначенияСвойств(СтрокаАмортизацияОС, СтрокаСписанияРезерва);
		СтрокаАмортизацияОС.РезервПереоценкиАмортизации = СтрокаСписанияРезерва.СуммаСписанияРезерваАмортизации;
		СтрокаАмортизацияОС.РезервПереоценкиАмортизацииРегл = СтрокаСписанияРезерва.СуммаСписанияРезерваАмортизацииРегл;
		СтрокаАмортизацияОС.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СписаниеРезерваПереоценкиАмортизацииОС;
		
		//Формирование проводок
		Проводка = Движения.Хозрасчетный.Добавить();
		Проводка.Период      = Реквизиты.Период;
		Проводка.Организация = СтрокаСписанияРезерва.Организация;
		
		Проводка.СчетДт      = ПланыСчетов.Хозрасчетный.РезервНаПереоценкуОсновныхСредств;
		БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 1, СтрокаСписанияРезерва.ОсновноеСредство);
		
		Проводка.СчетКт      = ПланыСчетов.Хозрасчетный.НераспределеннаяПрибыльНепокрытыйУбытокОтчетногоГода;
		
		БухгалтерскийУчет.УстановитьПодразделенияПроводки(Проводка, СтрокаСписанияРезерва.Подразделение, СтрокаСписанияРезерва.Подразделение);
		
		СуммаСписанияРезерваОС = СтрокаСписанияРезерва.СуммаСписанияРезерваСтоимостиРегл - СтрокаСписанияРезерва.СуммаСписанияРезерваАмортизацииРегл;
		Проводка.Сумма = СуммаСписанияРезерваОС;
		СуммаНУ        = 0;
		СуммаПР        = СуммаСписанияРезерваОС;
		СуммаВР        = 0;
		
		НалоговыйУчет.ЗаполнитьНалоговыеСуммыПроводки(СуммаНУ, СуммаНУ, СуммаПР, СуммаПР,
		СуммаВР, СуммаВР, Проводка, Реквизиты.ПоддержкаПБУ18);
		
		Проводка.Содержание = НСтр("ru='Списание резерва по переоценке ОС'");
	КонецЦикла;
	
	//Движения по списанию резерва переоценки нематериальных активов
	Для Каждого СтрокаСписанияРезерва Из ТаблицаСписанияРезерваВНА.ТаблицаДляРасчетаНМА Цикл
		
		//Формирование движений по РН СтоимостьНМА
		СтрокаСтоимостьНМА = Движения.СтоимостьНМА.ДобавитьРасход();
		СтрокаСтоимостьНМА.Период = Реквизиты.Период;
		ЗаполнитьЗначенияСвойств(СтрокаСтоимостьНМА, СтрокаСписанияРезерва);
		СтрокаСтоимостьНМА.РезервПереоценкиСтоимости = СтрокаСписанияРезерва.СуммаСписанияРезерваСтоимости;
		СтрокаСтоимостьНМА.РезервПереоценкиСтоимостиРегл = СтрокаСписанияРезерва.СуммаСписанияРезерваСтоимостиРегл;
		СтрокаСтоимостьНМА.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СписаниеРезерваПереоценкиСтоимостиНМА;
		
		//Формирование движений по РН АмортизацияНМА
		СтрокаАмортизацияНМА = Движения.АмортизацияНМА.ДобавитьПриход();
		СтрокаАмортизацияНМА.Период = Реквизиты.Период;
		ЗаполнитьЗначенияСвойств(СтрокаАмортизацияНМА, СтрокаСписанияРезерва);
		СтрокаАмортизацияНМА.РезервПереоценкиАмортизации = СтрокаСписанияРезерва.СуммаСписанияРезерваАмортизации;
		СтрокаАмортизацияНМА.РезервПереоценкиАмортизацииРегл = СтрокаСписанияРезерва.СуммаСписанияРезерваАмортизацииРегл;
		СтрокаАмортизацияНМА.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СписаниеРезерваПереоценкиАмортизацииНМА;
		
		//Формирование проводок
		Проводка = Движения.Хозрасчетный.Добавить();
		Проводка.Период      = Реквизиты.Период;
		Проводка.Организация = СтрокаСписанияРезерва.Организация;
		
		Проводка.СчетДт      = ПланыСчетов.Хозрасчетный.РезервНаПереоценкуНематериальныхАктивов;
		БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 1, СтрокаСписанияРезерва.НематериальныйАктив);
		
		Проводка.СчетКт      = ПланыСчетов.Хозрасчетный.НераспределеннаяПрибыльНепокрытыйУбытокОтчетногоГода;
		
		БухгалтерскийУчет.УстановитьПодразделенияПроводки(Проводка, СтрокаСписанияРезерва.Подразделение, СтрокаСписанияРезерва.Подразделение);
		
		СуммаСписанияРезерваОС = СтрокаСписанияРезерва.СуммаСписанияРезерваСтоимостиРегл - СтрокаСписанияРезерва.СуммаСписанияРезерваАмортизацииРегл;
		Проводка.Сумма = СуммаСписанияРезерваОС;
		СуммаНУ        = 0;
		СуммаПР        = СуммаСписанияРезерваОС;
		СуммаВР        = 0;
		
		НалоговыйУчет.ЗаполнитьНалоговыеСуммыПроводки(СуммаНУ, СуммаНУ, СуммаПР, СуммаПР,
		СуммаВР, СуммаВР, Проводка, Реквизиты.ПоддержкаПБУ18);
		
		Проводка.Содержание = НСтр("ru='Списание резерва по переоценке НМА'");
	КонецЦикла;
	
	Движения.Хозрасчетный.Записывать = Истина;
	Движения.СтоимостьОС.Записывать = Истина;
	Движения.СтоимостьНМА.Записывать = Истина;
	Движения.АмортизацияОС.Записывать = Истина;
	Движения.АмортизацияНМА.Записывать = Истина;
		
КонецПроцедуры

#КонецОбласти