	|	ДоходыНеПодлежащиеНалогообложению.ВидНалогаВзносаОтчисления,
	|	ДоходыНеПодлежащиеНалогообложению.Начисление,
	|	ДоходыНеПодлежащиеНалогообложению.СуммаДохода,
	|	ДоходыНеПодлежащиеНалогообложению.НеоблагаемыйДоход,
	|	ДоходыНеПодлежащиеНалогообложению.ФиксСтрока,
	|	ДоходыНеПодлежащиеНалогообложению.ФиксРасчет
	|ИЗ
	|	ВТ_ТаблицаДоходыНеПодлежащиеНалогообложению КАК ДоходыНеПодлежащиеНалогообложению
	|ГДЕ 
	|	ДоходыНеПодлежащиеНалогообложению.ВидНалогаВзносаОтчисления = &ВидНалогаВзносаОтчисления
	|	ИЛИ &БезОтбораПоВиду";
	
	ДоходыНеПодлежащиеНалогообложению.Вставить("ДоходыНеПодлежащиеНалогообложению", Запрос.Выполнить().Выгрузить());
	
	Возврат ПоместитьВоВременноеХранилище(ДоходыНеПодлежащиеНалогообложению, Форма.УникальныйИдентификатор);
	
КонецФункции

Процедура УдалитьДанныеПоНалогамВзносамОтчислениямФизическоголица(Объект, ФизическоеЛицо) Экспорт
	
	СтрокиНалогиВзносыОтчисления = Объект.НалогиВзносыОтчисления.НайтиСтроки(Новый Структура("ФизическоеЛицо", ФизическоеЛицо));
	Для Каждого СтрокаНалогиВзносыОтчисления Из СтрокиНалогиВзносыОтчисления Цикл
		
		СтрокиВычетовИПН = Объект.ВычетыИПН.НайтиСтроки(
			Новый Структура("ИдентификаторСтрокиНалогиВзносыОтчисления", СтрокаНалогиВзносыОтчисления.ИдентификаторСтрокиНалогиВзносыОтчисления));
			
		Для Каждого СтрокаВычетов Из СтрокиВычетовИПН Цикл
			Объект.ВычетыИПН.Удалить(СтрокаВычетов);
		КонецЦикла;
		
		Объект.НалогиВзносыОтчисления.Удалить(СтрокаНалогиВзносыОтчисления);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьДанныеПоНалогамВзносамОтчислениямПоИдентификатору(Объект, ИдентификаторСтрокиНалогиВзносыОтчисления) Экспорт
	
	СтрокиВычетовИПН = Объект.ВычетыИПН.НайтиСтроки(
		Новый Структура("ИдентификаторСтрокиНалогиВзносыОтчисления", ИдентификаторСтрокиНалогиВзносыОтчисления));
		
	Для Каждого СтрокаВычетов Из СтрокиВычетовИПН Цикл
		Объект.ВычетыИПН.Удалить(СтрокаВычетов);
	КонецЦикла;
	
КонецПроцедуры

Процедура НалогиВзносыОтчисленияДанныеВМенеджераРасчета(ТаблицаНалогиВзносыОтчисления, ТаблицаВычетыИПН, ТаблицаДоходыНеПодлежащиеНалогообложению, МенеджерРасчета, Отбор = Неопределено, НачальныеПозицииВставки = Неопределено, ДанныеРезультатовРаспределения = Неопределено) Экспорт
	
	НалогиВзносыОтчисления = МенеджерРасчета.Зарплата.НалогиВзносыОтчисления;
	СтрокиРасчетаНалогиВзносыОтчисления = Новый Массив;
	СтрокиРасчетаВычетыИПН = Новый Массив;
	СтрокиРасчетаДоходыНеПодлежащиеНалогообложению = Новый Массив;
	НачальныеПозицииСотрудников = Новый Соответствие;
	НачальныеПозицииДоходыНеПодлежащиеНалогообложению = Новый Соответствие;
	
	Для Каждого СтрокаФормы Из ТаблицаНалогиВзносыОтчисления Цикл
		
		Если Отбор <> Неопределено Тогда
			ФизическоеЛицо = Отбор.ФизическиеЛицаОтбор[СтрокаФормы.ФизическоеЛицо];
			Если ФизическоеЛицо = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			УстановитьНачальнуюПозициюПоСотруднику(НачальныеПозицииСотрудников, СтрокаФормы.ФизическоеЛицо, ТаблицаНалогиВзносыОтчисления.Индекс(СтрокаФормы));
			СтрокиРасчетаНалогиВзносыОтчисления.Добавить(СтрокаФормы);
			
		КонецЕсли;
		
		СтруктураПоиска = Новый Структура("ИдентификаторСтрокиНалогиВзносыОтчисления", СтрокаФормы.ИдентификаторСтрокиНалогиВзносыОтчисления);
		СтрокиВычетыИПН = ТаблицаВычетыИПН.НайтиСтроки(СтруктураПоиска);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СтрокиРасчетаВычетыИПН, СтрокиВычетыИПН);
		ЗаполнитьЗначенияСвойств(МенеджерРасчета.Зарплата.НалогиВзносыОтчисления.Добавить(), СтрокаФормы);
		Для Каждого СтрокаВычетов Из СтрокиВычетыИПН Цикл
			ЗаполнитьЗначенияСвойств(МенеджерРасчета.Зарплата.ВычетыИПН.Добавить(), СтрокаВычетов);
		КонецЦикла;
		
	КонецЦикла;
		
	Если НачальныеПозицииВставки <> Неопределено Тогда	
		НачальныеПозицииВставки.Вставить("НалогиВзносыОтчисления", НачальныеПозицииСотрудников);
	КонецЕсли;
	
	Для Каждого СтрокаФормы Из ТаблицаДоходыНеПодлежащиеНалогообложению Цикл
		Если Отбор <> Неопределено Тогда
			ФизическоеЛицо = Отбор.ФизическиеЛицаОтбор[СтрокаФормы.ФизическоеЛицо];
			Если ФизическоеЛицо = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			УстановитьНачальнуюПозициюПоСотруднику(НачальныеПозицииДоходыНеПодлежащиеНалогообложению, СтрокаФормы.ФизическоеЛицо, ТаблицаДоходыНеПодлежащиеНалогообложению.Индекс(СтрокаФормы));
			СтрокиРасчетаДоходыНеПодлежащиеНалогообложению.Добавить(СтрокаФормы);
			
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(МенеджерРасчета.Зарплата.ДоходыНеПодлежащиеНалогообложению.Добавить(), СтрокаФормы);
	КонецЦикла;
	
	Если НачальныеПозицииВставки <> Неопределено Тогда	
		НачальныеПозицииВставки.Вставить("ДоходыНеПодлежащиеНалогообложению", НачальныеПозицииДоходыНеПодлежащиеНалогообложению);
	КонецЕсли;
	
	УдалитьСтрокиРасчета(ТаблицаНалогиВзносыОтчисления, СтрокиРасчетаНалогиВзносыОтчисления, Отбор = Неопределено);
	УдалитьСтрокиРасчета(ТаблицаВычетыИПН, СтрокиРасчетаВычетыИПН, Отбор = Неопределено);
	УдалитьСтрокиРасчета(ТаблицаДоходыНеПодлежащиеНалогообложению, СтрокиРасчетаДоходыНеПодлежащиеНалогообложению, Отбор = Неопределено);
	
КонецПроцедуры

Процедура УстановитьНачальнуюПозициюПоСотруднику(НачальныеПозицииВставкиТаблицы, Сотрудник, Индекс) Экспорт
	
	НачальныеПозицииСотрудника = НачальныеПозицииВставкиТаблицы.Получить(Сотрудник);
	Если НачальныеПозицииСотрудника = Неопределено Тогда
		Позиции = Новый Структура("НачальнаяПозиция, КоличествоСтрок", Индекс, 1);
		НачальныеПозицииВставкиТаблицы.Вставить(Сотрудник, Позиции);
	Иначе
		НачальныеПозицииСотрудника.КоличествоСтрок = НачальныеПозицииСотрудника.КоличествоСтрок + 1;
	КонецЕсли;
	
КонецПроцедуры

Процедура РасчетЗарплатыНалогиВзносыОтчисленияВДанныеФормы(ДанныеДляЗаполнения, Объект, НачальныеПозицииВставки = Неопределено) Экспорт
	
	МаксимальныйИдентификаторСтрокиНалогиВзносыОтчисления = УчетНалоговВзносовОтчислений.МаксимальныйИдентификаторСтрокиНалогиВзносыОтчисления(Объект.НалогиВзносыОтчисления) + 1;
	
	НалогиВзносыОтчисления = ДанныеДляЗаполнения.НалогиВзносыОтчисления.Скопировать();
	Если НачальныеПозицииВставки <> Неопределено Тогда
		
		ПозицииСотрудников = РасчетЗарплатыРасширенныйФормы.ТаблицаПозицииСотрудников(НачальныеПозицииВставки["НалогиВзносыОтчисления"]);

		Сдвиг = 0;
		СтруктураПоиска = Новый Структура("ФизическоеЛицо");
		СтрокиКУдалению = Новый Массив;

		Для Каждого СтрокаПозиций Из ПозицииСотрудников Цикл
			
			СтруктураПоиска.ФизическоеЛицо = СтрокаПозиций.Сотрудник;
			СтрокиНалогиВзносыОтчисления = НалогиВзносыОтчисления.НайтиСтроки(СтруктураПоиска);
			ПозицияВставки = СтрокаПозиций.НачальнаяПозиция + Сдвиг;
			КоличествоСтрок = 0;
			
			Для Каждого СтрокаИсточник Из СтрокиНалогиВзносыОтчисления Цикл
				
				ПараметрыОтбора = Новый Структура("ИдентификаторСтрокиНалогиВзносыОтчисления", СтрокаИсточник.ИдентификаторСтрокиНалогиВзносыОтчисления);
				МассивСтрокВычетыИПН = ДанныеДляЗаполнения.ВычетыИПН.НайтиСтроки(ПараметрыОтбора);
				
				СтрокаИсточник.ИдентификаторСтрокиНалогиВзносыОтчисления = МаксимальныйИдентификаторСтрокиНалогиВзносыОтчисления;
				СтрокаНалогиВзносыОтчисления = РасчетЗарплатыРасширенныйФормы.СтрокаТаблицыПоНачальнойПозиции(Объект.НалогиВзносыОтчисления, ПозицияВставки);
				СтрокаНалогиВзносыОтчисленияВДанныеФормы(СтрокаНалогиВзносыОтчисления, СтрокаИсточник, МассивСтрокВычетыИПН, Объект);
				КоличествоСтрок = КоличествоСтрок + 1;
				ПозицияВставки = ПозицияВставки + 1;
				СтрокиКУдалению.Добавить(СтрокаИсточник);
				МаксимальныйИдентификаторСтрокиНалогиВзносыОтчисления = МаксимальныйИдентификаторСтрокиНалогиВзносыОтчисления + 1;
				
			КонецЦикла; 
			
			Сдвиг = Сдвиг + КоличествоСтрок - СтрокаПозиций.КоличествоСтрок;
			
		КонецЦикла;
		
		УдалитьСтрокиРасчета(НалогиВзносыОтчисления, СтрокиКУдалению);
		
	КонецЕсли;
	
	Для Каждого СтрокаИсточник Из НалогиВзносыОтчисления Цикл
		
		ПараметрыОтбора = Новый Структура("ИдентификаторСтрокиНалогиВзносыОтчисления", СтрокаИсточник.ИдентификаторСтрокиНалогиВзносыОтчисления);
		МассивСтрокВычетыИПН = ДанныеДляЗаполнения.ВычетыИПН.НайтиСтроки(ПараметрыОтбора);
		
		СтрокаИсточник.ИдентификаторСтрокиНалогиВзносыОтчисления = МаксимальныйИдентификаторСтрокиНалогиВзносыОтчисления;
		СтрокаНалогиВзносыОтчисления = Объект.НалогиВзносыОтчисления.Добавить();
		СтрокаНалогиВзносыОтчисленияВДанныеФормы(СтрокаНалогиВзносыОтчисления, СтрокаИсточник, МассивСтрокВычетыИПН, Объект);
		МаксимальныйИдентификаторСтрокиНалогиВзносыОтчисления = МаксимальныйИдентификаторСтрокиНалогиВзносыОтчисления + 1;
		
	КонецЦикла;
	
	
	ДоходыНеПодлежащиеНалогообложению = ДанныеДляЗаполнения.ДоходыНеПодлежащиеНалогообложению.Скопировать();
	Если НачальныеПозицииВставки <> Неопределено Тогда
		
		ПозицииСотрудников = РасчетЗарплатыРасширенныйФормы.ТаблицаПозицииСотрудников(НачальныеПозицииВставки["ДоходыНеПодлежащиеНалогообложению"]);

		Сдвиг = 0;
		СтруктураПоиска = Новый Структура("ФизическоеЛицо");
		СтрокиКУдалению = Новый Массив;

		Для Каждого СтрокаПозиций Из ПозицииСотрудников Цикл
			
			СтруктураПоиска.ФизическоеЛицо = СтрокаПозиций.Сотрудник;
			СтрокиДоходыНеПодлежащиеНалогообложению = ДоходыНеПодлежащиеНалогообложению.НайтиСтроки(СтруктураПоиска);
			ПозицияВставки = СтрокаПозиций.НачальнаяПозиция + Сдвиг;
			КоличествоСтрок = 0;
			
			Для Каждого СтрокаИсточник Из СтрокиДоходыНеПодлежащиеНалогообложению Цикл
			
				НоваяСтрока = РасчетЗарплатыРасширенныйФормы.СтрокаТаблицыПоНачальнойПозиции(Объект.ДоходыНеПодлежащиеНалогообложению, ПозицияВставки);
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсточник);
				КоличествоСтрок = КоличествоСтрок + 1;
				ПозицияВставки = ПозицияВставки + 1;
				СтрокиКУдалению.Добавить(СтрокаИсточник);
				
			КонецЦикла; 
			
			Сдвиг = Сдвиг + КоличествоСтрок - СтрокаПозиций.КоличествоСтрок;
			
		КонецЦикла;
		УдалитьСтрокиРасчета(ДоходыНеПодлежащиеНалогообложению, СтрокиКУдалению);
		
	КонецЕсли;
	
	Для Каждого СтрокаИсточник Из ДоходыНеПодлежащиеНалогообложению Цикл
		
		НоваяСтрока = Объект.ДоходыНеПодлежащиеНалогообложению.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсточник);
		
	КонецЦикла;
	
	
КонецПроцедуры

Процедура НалогиВзносыОтчисленияВДанныеМенеджераРасчета(ТаблицаНалогиВзносыОтчисления, ТаблицаВычетыИПН, ТаблицаДоходыНеПодлежащиеНалогообложению, МенеджерРасчета, Отбор = Неопределено, НачальныеПозицииВставки = Неопределено) Экспорт
	
	НалогиВзносыОтчисления = МенеджерРасчета.Зарплата.НалогиВзносыОтчисления;
	ДоходыНеПодлежащиеНалогообложению = МенеджерРасчета.Зарплата.ДоходыНеПодлежащиеНалогообложению;
	
	СтрокиРасчетаНалогиВзносыОтчисления = Новый Массив;
	СтрокиРасчетаВычетыИПН = Новый Массив;
	НачальныеПозицииСотрудников = Новый Соответствие;
	
	Для Каждого СтрокаФормы Из ТаблицаНалогиВзносыОтчисления Цикл
		
		Если Отбор <> Неопределено Тогда
			ФизическоеЛицо = Отбор.ФизическиеЛицаОтбор[СтрокаФормы.ФизическоеЛицо];
			Если ФизическоеЛицо = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			УстановитьНачальнуюПозициюПоСотруднику(НачальныеПозицииСотрудников, СтрокаФормы.ФизическоеЛицо, ТаблицаНалогиВзносыОтчисления.Индекс(СтрокаФормы));
			СтрокиРасчетаНалогиВзносыОтчисления.Добавить(СтрокаФормы);
			
		КонецЕсли;
		
		СтруктураПоиска = Новый Структура("ИдентификаторСтрокиНалогиВзносыОтчисления", СтрокаФормы.ИдентификаторСтрокиНалогиВзносыОтчисления);
		СтрокиПримененныеВычеты = ТаблицаВычетыИПН.НайтиСтроки(СтруктураПоиска);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СтрокиРасчетаВычетыИПН, СтрокиПримененныеВычеты);
		СтрокаНалогиВзносыОтчисленияВДанныеМенеджераРасчета(МенеджерРасчета, СтрокаФормы, СтрокиПримененныеВычеты);
		
	КонецЦикла;
	
	Если НачальныеПозицииВставки <> Неопределено Тогда
		НачальныеПозицииВставки.Вставить("НалогиВзносыОтчисления", НачальныеПозицииСотрудников);
	КонецЕсли;
	
	СтрокиРасчетаДоходыНеПодлежащиеНалогообложению = Новый Массив;
	НачальныеПозицииСотрудников = Новый Соответствие;
	
	Для Каждого СтрокаФормы Из ТаблицаДоходыНеПодлежащиеНалогообложению Цикл
		
		Если Отбор <> Неопределено Тогда
			ФизическоеЛицо = Отбор.ФизическиеЛицаОтбор[СтрокаФормы.ФизическоеЛицо];
			Если ФизическоеЛицо = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			УстановитьНачальнуюПозициюПоСотруднику(НачальныеПозицииСотрудников, СтрокаФормы.ФизическоеЛицо, ТаблицаДоходыНеПодлежащиеНалогообложению.Индекс(СтрокаФормы));
			СтрокиРасчетаДоходыНеПодлежащиеНалогообложению.Добавить(СтрокаФормы);
			
		КонецЕсли;
		
		СтрокаДоходыНеПодлежащиеНалогообложениюВДанныеМенеджераРасчета(МенеджерРасчета, СтрокаФормы);
		
	КонецЦикла;
	
	Если НачальныеПозицииВставки <> Неопределено Тогда
		НачальныеПозицииВставки.Вставить("ДоходыНеПодлежащиеНалогообложению", НачальныеПозицииСотрудников);
	КонецЕсли;
	
	УдалитьСтрокиРасчета(ТаблицаНалогиВзносыОтчисления, СтрокиРасчетаНалогиВзносыОтчисления, Отбор = Неопределено);
	УдалитьСтрокиРасчета(ТаблицаДоходыНеПодлежащиеНалогообложению, СтрокиРасчетаДоходыНеПодлежащиеНалогообложению, Отбор = Неопределено);
	УдалитьСтрокиРасчета(ТаблицаВычетыИПН, СтрокиРасчетаВычетыИПН, Отбор = Неопределено);
	
КонецПроцедуры

Процедура СтрокаНалогиВзносыОтчисленияВДанныеМенеджераРасчета(МенеджерРасчета, СтрокаИсточник, СтрокиПримененныеВычеты) Экспорт
	
	СтрокаПриемник = МенеджерРасчета.Зарплата.НалогиВзносыОтчисления.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаПриемник, СтрокаИсточник);
	
КонецПроцедуры

Процедура СтрокаДоходыНеПодлежащиеНалогообложениюВДанныеМенеджераРасчета(МенеджерРасчета, СтрокаИсточник) Экспорт
	
	СтрокаПриемник = МенеджерРасчета.Зарплата.ДоходыНеПодлежащиеНалогообложению.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаПриемник, СтрокаИсточник);
	
КонецПроцедуры

Процедура СтрокаНалогиВзносыОтчисленияВДанныеФормы(СтрокаНалогиВзносыОтчисления, СтрокаИсточник, МассивСтрок, Объект)
	
	ЗаполнитьЗначенияСвойств(СтрокаНалогиВзносыОтчисления, СтрокаИсточник);
	
	Для Каждого СтрокаИсточникВычетИПН Из МассивСтрок Цикл
		СтрокаВычетИПН = Объект.ВычетыИПН.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаВычетИПН, СтрокаИсточникВычетИПН);
		СтрокаВычетИПН.ИдентификаторСтрокиНалогиВзносыОтчисления = СтрокаИсточник.ИдентификаторСтрокиНалогиВзносыОтчисления;
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьСтрокиРасчета(Таблица, СтрокиРасчета, ПолноеУдаление = Ложь)
	
	Если ПолноеУдаление Тогда
		Таблица.Очистить();
	Иначе
		Для Каждого СтрокаУдаления Из СтрокиРасчета Цикл
			Таблица.Удалить(СтрокаУдаления);
		КонецЦикла;	
	КонецЕсли;
	
КонецПроцедуры

