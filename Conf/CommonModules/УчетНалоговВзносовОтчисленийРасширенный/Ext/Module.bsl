Функция СведенияОНалогахВзносахОтчислениях(Форма, ВидНалогаВзносаОтчисления, ФизическоеЛицо = Неопределено, ПутьКДаннымАдресРаспределенияРезультатовВХранилище = Неопределено, ТаблицаНачислений= Неопределено) Экспорт
	
	ДанныеОНалогеВзносеОтчислении = Новый Структура;
	
	СтруктураОтбора = Новый Структура("ВидНалогаВзносаОтчисления", ВидНалогаВзносаОтчисления);
	КоллекцияСтрокОПВ = Форма.Объект.НалогиВзносыОтчисления.Выгрузить(СтруктураОтбора);
	
	ДанныеОНалогеВзносеОтчислении.Вставить("НалогиВзносыОтчисления", КоллекцияСтрокОПВ);
	
	Если ПутьКДаннымАдресРаспределенияРезультатовВХранилище <> Неопределено Тогда
		ДанныеОНалогеВзносеОтчислении.Вставить("АдресРаспределенияРезультатовВХранилище", Форма[ПутьКДаннымАдресРаспределенияРезультатовВХранилище]);
	КонецЕсли; 
	
	Возврат ПоместитьВоВременноеХранилище(ДанныеОНалогеВзносеОтчислении, Форма.УникальныйИдентификатор);
	
КонецФункции

Функция ВычетыИПН(Форма, ПутьКДаннымАдресРаспределенияРезультатовВХранилище = Неопределено, ТаблицаНачислений= Неопределено) Экспорт
	
	ВычетыИПН = Новый Структура;
	
	ТаблицаВычетыИПН = Форма.Объект.ВычетыИПН.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаВычетыИПН", ТаблицаВычетыИПН);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаВычетыИПН.ИдентификаторСтрокиНалогиВзносыОтчисления,
	|	ТаблицаВычетыИПН.ВидВычетаИПН,
	|	ТаблицаВычетыИПН.РазрешенныйВычет,
	|	ТаблицаВычетыИПН.ПримененныйВычет,
	|	ТаблицаВычетыИПН.ФиксСтрока,
	|	ТаблицаВычетыИПН.ФиксРасчет
	|ПОМЕСТИТЬ ВТ_ТаблицаВычетыИПН
	|ИЗ
	|	&ТаблицаВычетыИПН КАК ТаблицаВычетыИПН
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВычетыИПН.ИдентификаторСтрокиНалогиВзносыОтчисления,
	|	ВычетыИПН.ВидВычетаИПН,
	|	ВычетыИПН.РазрешенныйВычет,
	|	ВычетыИПН.ПримененныйВычет,
	|	ВычетыИПН.ФиксСтрока,
	|	ВычетыИПН.ФиксРасчет
	|ИЗ
	|	ВТ_ТаблицаВычетыИПН КАК ВычетыИПН";
	
	ВычетыИПН.Вставить("ВычетыИПН",Запрос.Выполнить().Выгрузить());
	
	
	Возврат ПоместитьВоВременноеХранилище(ВычетыИПН, Форма.УникальныйИдентификатор);
	
КонецФункции

