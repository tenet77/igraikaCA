Функция ПреобразоватьТипДокументаКЗначениюАтоллv3(Знач ТипДокумента) Экспорт
	ТипДокумента = НРег(ТипДокумента);
	Если ТипДокумента = "order" Или ТипДокумента = "retin" Тогда
		ТипДокумента = ТипДокумента + "s";
	КонецЕсли;
	
