// Вызывает выполнение запроса API /event/content, возвращает структуру:
//		- Успешно - булево - обязательный
//		- ФайлXML - файл
//		- Signs   - файл
//		- Ответ	  - Соответствие, ответ API
// Параметры:
//ПараметрыМетода - тип структура - параметры метода GET /api/v2/edo/timeline/event/content/
//					gln  	 - строка - обязательный (gln или Guid), идентификатор пользователя, участника EDI обмена.
//					Guid 	 - строка - обязательный (gln или Guid), идентификатор пользователя, участника ЮЗД обмена.
//					doc_uuid - строка - обязательный, идентификатор документа УПД/УКД или квитанции. Строка в формате GUID.
//ДанныеПодключения - тип структура - данные о сервере, токене для выполнения метода API
//					 Сервер - строка (адрес сервера)
//					 Токен  - строка (токен из РС ЭКОМ значения доп констант)
Функция ПолучитьВходящийДокументЮЗДv3(ПараметрыМетода, ДанныеПодключения, Каталог, ТипДокумента) Экспорт
	ИмяМетода  = "/api/v2/edo/timeline/event/content/"; 	
	Заголовки  = Новый Соответствие;
	Заголовки.Вставить("X-Auth-Token", ДанныеПодключения.Токен);
	ЗаполнитьПараметрыМетода(ИмяМетода, ПараметрыМетода);
	
	РезультатAPI = ВыполнитьЗапросAPI(ДанныеПодключения.Сервер,, ИмяМетода,, Заголовки); 
	Результат    = РезультатAPI;
	Если РезультатAPI.Успешно Тогда
		Идентификатор = ПараметрыМетода.gln + " - " + ПараметрыМетода.doc_uuid;
		ФайлТело      = ФайлИзBase64(РезультатAPI.Ответ.Получить("body"), Каталог, ТипДокумента, Идентификатор, ".xml");
		Результат.Вставить("ФайлBody", ФайлТело);
		
		МассивSigns = РезультатAPI.Ответ.Получить("signs");
		Если ТипЗнч(МассивSigns) = Тип("Массив") Тогда
			МассивПодписей = Новый Массив;
			Для Каждого Элемент Из МассивSigns Цикл
				ФайлПодпись = ФайлИзBase64(Элемент.Получить("body"), Каталог, ТипДокумента, Идентификатор, ".bin");
				МассивПодписей.Добавить(ФайлПодпись);
			КонецЦикла;
			Результат.Вставить("МассивПодписей", МассивПодписей);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

