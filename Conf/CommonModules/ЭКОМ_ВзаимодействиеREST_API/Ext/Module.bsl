// Область Атолл (REST v2)

// Область Авторизация

// Возвращает структуру:
// 	Получены 	 - булево - Истина, в случае успешной авторизации, иначе Ложь
//  Токен        - строка - токен полученный в результате авторизации
//  РезультатAPI - структура - ответ API
//
//	Параметры:
//	ПрофильОбмена - ссылка на элемент справочника ЭКОМ_ПрофилиОбмена	
Функция ВыполнитьАвторизациюАтолл(ПрофильОбмена) Экспорт
	ДанныеАвторизации = Новый Структура;
	ДанныеАвторизации.Вставить("Получены", Ложь);
	ДанныеПодключения = ПолучитьДанныеПодключенияEvolution(ПрофильОбмена);
	Если ДанныеПодключения.ПолученПрофиль Тогда
		ДанныеАвторизации = ВыполнитьАвторизациюАтолл_БезДанных(ДанныеПодключения);
	КонецЕсли;
	
	Возврат ДанныеАвторизации; 		
КонецФункции

// Возвращает структуру:
// 	Получены 	 - булево - Истина, в случае успешной авторизации, иначе Ложь
//  Токен        - строка - токен полученный в результате авторизации
//  РезультатAPI - структура - ответ API
//
//	Параметры:
//	ДанныеПодключения - структура
//		- ИмяПользователя    - строка - логин учетной записи e-vo.ru
//		- ПарольПользователя - строка - пароль учетной записи e-vo.ru
//		- Сервер			 - строка - сервер REST API
Функция ВыполнитьАвторизациюАтолл_БезДанных(ДанныеПодключения) Экспорт
	МассивЛогаСобытий = Новый Массив;
	ДанныеАвторизации = Новый Структура;
	ДанныеАвторизации.Вставить("Получены", Ложь);
	
	ИмяМетода = "/api/v2/edo/index/authorize";
	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("varLogin", ДанныеПодключения.ИмяПользователя);
	ТелоЗапроса.Вставить("varPassword", ДанныеПодключения.ПарольПользователя);
	РезультатAPI = ВыполнитьЗапросAPI(ДанныеПодключения.Сервер, , ИмяМетода, ТелоЗапроса);
	
	Если РезультатAPI.Успешно Тогда
		ДанныеАвторизации.Получены = Истина;
		ДанныеАвторизации.Вставить("Токен", РезультатAPI.Заголовки.Получить("X-Auth-Token"));
		// TODO: заменить на ЭКОМ_ОбщегоНазначения.НастройкаПараметрЗаписать
		ЗаписатьТокен(ДанныеАвторизации.Токен);
	КонецЕсли;
	
	ДанныеАвторизации.Вставить("РезультатAPI", РезультатAPI);
	
	Возврат ДанныеАвторизации;		
КонецФункции
// КонецОбласти Авторизация

