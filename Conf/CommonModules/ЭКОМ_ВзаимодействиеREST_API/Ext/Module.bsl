//					body - Строка - обязательный. Тело документа преобразованного к строке в кодировке BASE64.
//					docType - Строка - обязательный. Тип передаваемого дкоумента.
//					docName - Строка - Параметр обязателен при отправке EDI документов.
//					Sign - Строка - Электронно-цифровая подпись документа преобразованная к строке в кодировке BASE64.
//					Signs - Массив - Массив данных по электронно-цифровой подписи.
//ДанныеПодключения - тип структура - данные о сервере, токене для выполнения метода API
//					 Сервер - строка (адрес сервера)
//					 Токен  - строка (токен из РС ЭКОМ значения доп констант)
Функция Отправить_ДокументEDI_ЮЗД_Атолл(ТелоЗапроса, ДанныеПодключения) Экспорт
	ИмяМетода  = "/api/v2/edo/document"; 	
