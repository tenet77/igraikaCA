Процедура ЗаписатьТокен(Токен)
	МенеджерЗаписи = РегистрыСведений.ЭКОМ_ЗначениеДополнительныхКонстант.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ДополнительнаяКонстанта = "ЭКОМ_ТокенEvolution";
	МенеджерЗаписи.Прочитать();
	
	Если Не МенеджерЗаписи.Выбран() Тогда
		МенеджерЗаписи.ДополнительнаяКонстанта = "ЭКОМ_ТокенEvolution";
	КонецЕсли;
	МенеджерЗаписи.ЗначениеДополнительнойКонстанты = Токен;      	
	МенеджерЗаписи.Записать();
КонецПроцедуры

Функция Входящий_EDI_JSON_В_XML(СтрокаJSON, ТелоДокумента, ТипДокумента, ВременныйКаталог, ИмяФайла, Кодировка)
	СтрокиПодстрокиJSON    = РазделитьОсновнуюСтрокуИПодстрокиJSON(СтрокаJSON);
	ЭлементыОсновнойСтроки = СтрокиПодстрокиJSON.ЭлементыОсновнойСтроки;
	ЭлементыПодстрок       = СтрокиПодстрокиJSON.ЭлементыПодстрок;
	
	Попытка
		ЗаписьXML = Новый ЗаписьXML; 
		ЗаписьXML.УстановитьСтроку(Кодировка);
		ЗаписьXML.ЗаписатьОбъявлениеXML();
		ЗаписьXML.ЗаписатьНачалоЭлемента(ТипДокумента);
		Для Каждого Элемент Из ЭлементыОсновнойСтроки Цикл
			Значение = ТелоДокумента.Получить(Элемент);
			ЗначениеВЗаписьXML(Элемент, Значение, ЗаписьXML, ЭлементыПодстрок);
		КонецЦикла;
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
		СтрокаXML = ЗаписьXML.Закрыть();
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.ОткрытьФайл(ИмяФайла);
		ЗаписьXML.ЗаписатьБезОбработки(СтрокаXML);
		ЗаписьXML.Закрыть();		
	Исключение
		СтрокаXML = "";
	КонецПопытки;
	
	Возврат СтрокаXML;
КонецФункции

Процедура ЗначениеВЗаписьXML(Ключ, Значение, ЗаписьXML, ПодчиненныеСтроки)
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		МассивЭлементовПодстроки = ПодчиненныеСтроки.Получить(Ключ);
		МассивJSON = Значение;
		Для Каждого СоответствиеJSON Из МассивJSON Цикл
			ЗаписьXML.ЗаписатьНачалоЭлемента(Ключ);
			Для Каждого ВложенныйЭлемент Из МассивЭлементовПодстроки Цикл
				ЗначениеВложенногоЭлемента = СоответствиеJSON.Получить(ВложенныйЭлемент);
				Если ЗначениеВложенногоЭлемента <> Неопределено Тогда
					ЗначениеВЗаписьXML(ВложенныйЭлемент, ЗначениеВложенногоЭлемента, ЗаписьXML, ПодчиненныеСтроки);
				КонецЕсли;
			КонецЦикла;
			ЗаписьXML.ЗаписатьКонецЭлемента();
		КонецЦикла;
	Иначе
		ЗаписатьЭлементXML(Ключ, Значение, ЗаписьXML);
	КонецЕсли;
КонецПроцедуры

Процедура ЗаписатьЭлементXML(Ключ, Значение, ЗаписьXML)
	ЗаписьXML.ЗаписатьНачалоЭлемента(Ключ);
	ЗаписьXML.ЗаписатьТекст(Строка(Значение));
	ЗаписьXML.ЗаписатьКонецЭлемента();
КонецПроцедуры

Функция РазделитьОсновнуюСтрокуИПодстрокиJSON(Знач СтрокаJSON)
	// для сохранения последовательности элементов при конвертировании JSON в XML
	// будет выполнено последовательное чтение, но предварительно для простоты чтения и сохранения структуры выполняется запись
	// подмножеств и удаление их из головного элемента, 
	
	НачальнаяПозиция = 1;
	// символ "[" означает начало множества элементов
	ОткрывающаяСкобка = ЭКОМ_ОбщегоНазначения.ПоискВСтроке(СтрокаJSON, "[", , НачальнаяПозиция);
	ПодчиненныеСтроки  = Новый Соответствие; 	
	Пока ОткрывающаяСкобка <> 0 Цикл
		// наличие символа "[" внутри множества (до символа "]"), означает наличие подмножества
		СледующаяОткрСкобка = ЭКОМ_ОбщегоНазначения.ПоискВСтроке(СтрокаJSON, "[",, ОткрывающаяСкобка + 1);
		ЗакрывающаяСкобка   = ЭКОМ_ОбщегоНазначения.ПоискВСтроке(СтрокаJSON, "]",, НачальнаяПозиция);
		
		Если ЗакрывающаяСкобка = 0 Тогда
			Прервать;	
		КонецЕсли;
		
		ЧислоЗакрывающихСкобок = 1;
		// сбор всех подмножеств в массив подчиненных строк
		Пока СледующаяОткрСкобка <> 0 И СледующаяОткрСкобка < ЗакрывающаяСкобка Цикл
			ЧислоЗакрывающихСкобок =  ЧислоЗакрывающихСкобок + 1;
			СледующаяОткрСкобка  = ЭКОМ_ОбщегоНазначения.ПоискВСтроке(СтрокаJSON, "[",, СледующаяОткрСкобка + 1);
		КонецЦикла;
		
		
		// сохранение имени элемента в составе редактируемой строки, для формирования ключа
		КонецИмени  = ЭКОМ_ОбщегоНазначения.ПоискВСтроке(СтрокаJSON, """:", 1, ОткрывающаяСкобка);
		НачалоИмени = ЭКОМ_ОбщегоНазначения.ПоискВСтроке(СтрокаJSON, """", 1, КонецИмени - 1);
		
		КонецСтроки         = ЭКОМ_ОбщегоНазначения.ПоискВСтроке(СтрокаJSON, "]",, НачальнаяПозиция, ЧислоЗакрывающихСкобок);
		РедактируемаяСтрока = Сред(СтрокаJSON, НачалоИмени, КонецСтроки - НачалоИмени + 1);
		
		Счетчик				= 1;
		ВхождениеЗакрСкобки = ЧислоЗакрывающихСкобок;
		// чтение подстрок от последнего уровня вложенности к первому
		Пока ВхождениеЗакрСкобки > 0 Цикл
			// получение текущей подстроки: последняя открывающая скобка закрывается ближайшей к ней закрывающей скобкой
			НачалоПодстроки = ЭКОМ_ОбщегоНазначения.ПоискВСтроке(РедактируемаяСтрока, "[", , , ВхождениеЗакрСкобки);
			КонецПодстроки  = ЭКОМ_ОбщегоНазначения.ПоискВСтроке(РедактируемаяСтрока, "]", , , Счетчик);
			Подстрока       = Сред(РедактируемаяСтрока, НачалоПодстроки, КонецПодстроки - НачалоПодстроки + 1);
			
			// вычисление имени элемента, к которому относится множество (подстрока)
			КонецИмени      = ЭКОМ_ОбщегоНазначения.ПоискВСтроке(РедактируемаяСтрока, """:", 1, НачалоПодстроки);
			НачалоИмени     = ЭКОМ_ОбщегоНазначения.ПоискВСтроке(РедактируемаяСтрока, """", 1, КонецИмени - 1);
			ИмяПодмножества = Сред(РедактируемаяСтрока, НачалоИмени + 1, КонецИмени - НачалоИмени - 1);
			ПодчиненныеСтроки.Вставить(ИмяПодмножества, Подстрока);
			
			// удаление прочитанной подстроки из строки множества
			РедактируемаяСтрока	= СтрЗаменить(РедактируемаяСтрока, Подстрока, "");
			
			ВхождениеЗакрСкобки = ВхождениеЗакрСкобки - 1;
			Счетчик 			= Счетчик + 1;
		КонецЦикла;
		
		// удаление прочитанных подстрок из основной строки
		СтрокаУдаление    = Сред(СтрокаJSON, ОткрывающаяСкобка, КонецСтроки - ОткрывающаяСкобка + 1);
		СтрокаJSON 		  = СтрЗаменить(СтрокаJSON, СтрокаУдаление, "");				
		Попытка
			НачальнаяПозиция = ОткрывающаяСкобка + 1;
			ОткрывающаяСкобка = ЭКОМ_ОбщегоНазначения.ПоискВСтроке(СтрокаJSON, "[",, НачальнаяПозиция);
		Исключение
			НачальнаяПозиция = 0;
		КонецПопытки;
	КонецЦикла;
	
	СтрокаJSON = СтрЗаменить(СтрокаJSON, """body""", "");
	ЭлементыОсновнойСтроки = ПолучитьЭлементыСтрокиJSON(СтрокаJSON);
	
	ЭлементыПодстрок = Новый Соответствие;
	Для Каждого Элемент Из ПодчиненныеСтроки Цикл
		МассивЭлементовПодстроки = ПолучитьЭлементыСтрокиJSON(Элемент.Значение);
		ЭлементыПодстрок.Вставить(Элемент.Ключ, МассивЭлементовПодстроки);
	КонецЦикла;
	
	Результат = Новый Структура("ОсновнаяСтрока, Подстроки, ЭлементыОсновнойСтроки, ЭлементыПодстрок", 
								СтрокаJSON, ПодчиненныеСтроки, ЭлементыОсновнойСтроки, ЭлементыПодстрок);

	Возврат Результат;	
	
КонецФункции

Функция ПолучитьЭлементыСтрокиJSON(Строка)
	НачальнаяПозиция = 1;
	ОткрывающаяКовычка = ЭКОМ_ОбщегоНазначения.ПоискВСтроке(Строка, """",, НачальнаяПозиция);
	МассивЭлементов = Новый Массив;
	Пока ОткрывающаяКовычка <> 0 Цикл
		ЗавершениеЭлемента = ЭКОМ_ОбщегоНазначения.ПоискВСтроке(Строка, """:",, НачальнаяПозиция);
		Если ЗавершениеЭлемента <> 0 Тогда
			Элемент = Сред(Строка, ОткрывающаяКовычка + 1, ЗавершениеЭлемента - ОткрывающаяКовычка - 1);
			Если МассивЭлементов.Найти(Элемент) = Неопределено Тогда
				МассивЭлементов.Добавить(Элемент);
			КонецЕсли;
		Иначе
			Прервать;
		КонецЕсли;
		ЗавершениеСтроки = ЭКОМ_ОбщегоНазначения.ПоискВСтроке(Строка, ",",, ЗавершениеЭлемента);
		Если ЗавершениеСтроки = 0 Тогда
			Прервать;
		КонецЕсли;
		ОткрывающаяКовычка = ЭКОМ_ОбщегоНазначения.ПоискВСтроке(Строка, """",, ЗавершениеСтроки);
		НачальнаяПозиция   = ОткрывающаяКовычка + 1;
	КонецЦикла;
	
	Возврат МассивЭлементов;	
КонецФункции

Функция ЗаписатьВходящийEDI_В_XML(ВременныйКаталог, ТипДокумента, ИмяФайла, ТелоДокумента, Кодировка)
	Попытка
		ЗаписьXML = Новый ЗаписьXML; 
		ЗаписьXML.УстановитьСтроку(Кодировка);
		ЗаписьXML.ЗаписатьОбъявлениеXML();
		ЗаписьXML.ЗаписатьНачалоЭлемента(ТипДокумента);
		Для Каждого Элемент Из ТелоДокумента Цикл		
			МассивСоответствийВXML(Элемент, ЗаписьXML);
		КонецЦикла;
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
		СтрокаXML 		 = ЗаписьXML.Закрыть();
		
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.ОткрытьФайл(ИмяФайла);
		ЗаписьXML.ЗаписатьБезОбработки(СтрокаXML);
		ЗаписьXML.Закрыть();
		
	Исключение
	КонецПопытки;
	
	Возврат СтрокаXML;
КонецФункции

Процедура МассивСоответствийВXML(Значение, Файл)
		Если ТипЗнч(Значение) = Тип("Массив") 
			Или ТипЗнч(Значение) = Тип("Соответствие") Тогда
			Для Каждого Элемент Из Значение Цикл
				МассивСоответствийВXML(Элемент, Файл);
			КонецЦикла;
		Иначе
			ЗначениеВЭлемент(Значение, Файл);
		КонецЕсли; 		
КонецПроцедуры

Процедура ЗначениеВЭлемент(Соответствие, Файл)
	Файл.ЗаписатьНачалоЭлемента(Соответствие.Ключ);
	Если ТипЗнч(Соответствие.Значение) = Тип("Массив") 
		Или ТипЗнч(Соответствие.Значение) = Тип("Соответствие") Тогда
		МассивСоответствийВXML(Соответствие.Значение, Файл);
	Иначе
		Файл.ЗаписатьТекст(Строка(Соответствие.Значение));
	КонецЕсли; 
	файл.ЗаписатьКонецЭлемента();
КонецПроцедуры

Функция ФайлИзBase64(СтрокаBase64, Каталог, ТипДокумента, Идентификатор, Расширение)
	ДвоичныеДанные = Base64Значение(СтрокаBase64);
	Если ДвоичныеДанные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяФайла = Каталог + "\" + ТипДокумента + "_" + Идентификатор + Расширение; 
	ДвоичныеДанные.Записать(ИмяФайла);
	
	Файл = Новый Файл(ИмяФайла);
	Возврат Файл;	
КонецФункции

