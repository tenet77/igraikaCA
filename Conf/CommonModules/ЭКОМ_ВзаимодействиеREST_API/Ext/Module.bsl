// Вызывает выполнение запроса API /condras/content, возвращает структуру:
//		- Успешно - булево - обязательный
//		- Файл - файл
//		- Sign - файл
//		- Ответ	  - Соответствие, ответ API
// Параметры:
//ПараметрыМетода - тип структура - параметры метода GET /api/v2/edo/timeline/event/content/
//					gln  	 - строка - обязательный (gln или Guid), идентификатор пользователя, участника EDI обмена.
//					Guid 	 - строка - обязательный (gln или Guid), идентификатор пользователя, участника ЮЗД обмена.
//					doc_uuid - строка - Идентификатор запрашиваемого документа.
//					limit    - Строка - количество выводимых документов при чтении ленты за 1 раз; по умолчанию значение «40» 
//ДанныеПодключения - тип структура - данные о сервере, токене для выполнения метода API
//					 Сервер - строка (адрес сервера)
//					 Токен  - строка (токен из РС ЭКОМ значения доп констант)
Функция ПолучитьВходящийДокументCONDRA(ПараметрыМетода, ДанныеПодключения, Каталог, ТипДокумента) Экспорт
	ИмяМетода  = "/api/v2/edo/condras/content/"; 	
	Заголовки  = Новый Соответствие;
	Заголовки.Вставить("X-Auth-Token", ДанныеПодключения.Токен);
	ЗаполнитьПараметрыМетода(ИмяМетода, ПараметрыМетода);
	
	РезультатAPI = ВыполнитьЗапросAPI(ДанныеПодключения.Сервер,, ИмяМетода,, Заголовки); 
	Результат = РезультатAPI;
	Если РезультатAPI.Успешно Тогда
		Идентификатор = ПараметрыМетода.gln + " - " + ПараметрыМетода.docID;
