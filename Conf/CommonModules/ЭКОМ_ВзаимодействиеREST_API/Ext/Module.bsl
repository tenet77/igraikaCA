//Область ОбщиеAPI

Функция ВыполнитьЗапросAPI(Сервер, Знач ПортAPI = 443, ИмяМетода, ТелоЗапроса = Неопределено, СвоиЗаголовки = Неопределено, HTTPМетод = "GET") Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Успешно"   , Ложь);
	Результат.Вставить("КодСостояния");
	
	Если СвоиЗаголовки = Неопределено Тогда
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Content-Type", "application/json");
		Заголовки.Вставить("cache-control", "no-cache");
	Иначе
		Заголовки = СвоиЗаголовки;
	КонецЕсли;
	
	ПортAPI		 = ЭКОМ_ОбщегоНазначения.ЭКОМ_ПреобразоватьВЧислоОбщегоНазначения(ПортAPI);
	Соединение   = Новый HTTPСоединение(Сервер, ПортAPI,,,,, Новый ЗащищенноеСоединениеOpenSSL);

	Если Не ТелоЗапроса = Неопределено Тогда
		HTTPМетод = "POST";
		ТекстJSON = ПреобразоватьТелоЗапросаВJSON(ТелоЗапроса);
	КонецЕсли;

	HTTPЗапрос = Новый HTTPЗапрос(ИмяМетода, Заголовки);
	Если HTTPМетод = "POST" Тогда
		HTTPЗапрос.УстановитьТелоИзСтроки(ТекстJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;

	ИмяВыходногоФайла = "";
	Попытка
		HTTPОтвет = Соединение.ВызватьHTTPМетод(HTTPМетод, HTTPЗапрос, ИмяВыходногоФайла);
	Исключение
		Результат.КодСостояния = 0;
		Результат.Вставить("ОписаниеОшибки", ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;
	
	СтрокаОтвет = HTTPОтвет.ПолучитьТелоКакСтроку();
	Если Не (HTTPОтвет.КодСостояния = 200 Или HTTPОтвет.КодСостояния = 201) Тогда
		Результат.Вставить("ОтветТекст", СокрЛП(HTTPОтвет.КодСостояния) + " " + СтрокаОтвет);
		Результат.КодСостояния = HTTPОтвет.КодСостояния;			
		Возврат Результат;
	КонецЕсли;
	
	Если ЭКОМ_ОбщегоНазначения.ПоискВСтроке(СтрокаОтвет, "{") = 1 Тогда
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(СтрокаОтвет);
		Соответствие = ПрочитатьJSON(ЧтениеJSON, Истина);
		Соответствие.Вставить("Заголовки", HTTPОтвет.Заголовки);
		ЧтениеJSON.Закрыть();
	Иначе
		Соответствие = Новый Соответствие;
	КонецЕсли;
    Соответствие.Вставить("СтрокаОтвет", СтрокаОтвет);
	
	Результат.Успешно 	   = Истина;
	Результат.КодСостояния = HTTPОтвет.КодСостояния;
	Результат.Вставить("Ответ", Соответствие);
	Результат.Вставить("Заголовки", HTTPОтвет.Заголовки);
	
	Возврат Результат;
КонецФункции

Функция ПреобразоватьТелоЗапросаВJSON(ТелоЗапроса) Экспорт
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ТелоЗапроса);
	ТекстJSON = ЗаписьJSON.Закрыть();	
	                                
	Возврат ТекстJSON;
КонецФункции

Функция ПолучитьДанныеПодключенияEvolution(ПрофильОбмена) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("ПолученПрофиль", Ложь);
	Результат.Вставить("ПолученТокен", Ложь);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЭКОМ_ПрофилиОбмена.СерверREST КАК Сервер,
	               |	ЭКОМ_ПрофилиОбмена.ИмяПользователяFTP КАК ИмяПользователя,
	               |	ЭКОМ_ПрофилиОбмена.ПарольПользователяAPI КАК ПарольПользователя
	               |ИЗ
	               |	Справочник.ЭКОМ_ПрофилиОбмена КАК ЭКОМ_ПрофилиОбмена
	               |ГДЕ
	               |	ЭКОМ_ПрофилиОбмена.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ПрофильОбмена);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.ПолученПрофиль = Истина;
		Результат.Вставить("Сервер", Выборка.Сервер);
		Результат.Вставить("ИмяПользователя", Выборка.ИмяПользователя);
		Результат.Вставить("ПарольПользователя", Выборка.ПарольПользователя);
	КонецЕсли;  
	
	МенеджерЗаписи = РегистрыСведений.ЭКОМ_ЗначениеДополнительныхКонстант.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ДополнительнаяКонстанта = "ЭКОМ_ТокенEvolution";
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() Тогда
		Результат.ПолученТокен = Истина;
		Результат.Вставить("Токен", МенеджерЗаписи.ЗначениеДополнительнойКонстанты);
	КонецЕсли;
	
	Возврат Результат;	
КонецФункции

Процедура ЗаполнитьПараметрыМетода(МетодСПараметрами, ПараметрыСообщения)   	
	Для Каждого Параметр Из ПараметрыСообщения Цикл
		СлужебныйСимвол = ?(Прав(МетодСПараметрами, 1) = "/", "?", "&");
		Если ТипЗнч(Параметр.Значение) = Тип("Строка") И ЗначениеЗаполнено(Параметр.Значение) Тогда
			МетодСПараметрами = МетодСПараметрами + СлужебныйСимвол + Параметр.Ключ + "=" + Параметр.Значение;
		КонецЕсли;
	КонецЦикла;    	
КонецПроцедуры

Функция ПолучитьПараметрыСообщенияEdiDocuments(gln, limit, offset, time_from, time_to, doc_type, status, docid, description)    	
	ПараметрыСообщения = Новый Структура;
	ПараметрыСообщения.Вставить("gln", gln);  // обязательный параметр(!) / идентификатор пользователя, участника EDI обмена.
	ПараметрыСообщения.Вставить("limit", limit); // Устанавливает количество выводимых документов при чтении ленты за 1 раз; по умолчанию значение «40»
	ПараметрыСообщения.Вставить("offset", offset); // Устанавливает смещение индекса первого элемента при чтении ленты документов; по умолчанию значение «0».
	ПараметрыСообщения.Вставить("time_from", time_from); // Дата начала периода, работает с датой получения/отправки документа. Формат yyyy-MM-dd’T’HH:mm:ss (2019-01-01T00:00:00)
	ПараметрыСообщения.Вставить("time_to", time_to); // Дата окончания периода, работает с датой получения/отправки документа. Формат yyyy-MM-dd’T’HH:mm:ss (2019-01-01T00:00:00)
	ПараметрыСообщения.Вставить("doc_type", doc_type); // Order, Ordrsp, Desadv, Recadv, Insdes, Desscc, Invoice, Alcdes, Retann, Retins, Pricat
	ПараметрыСообщения.Вставить("status", status); // sent, delivered, inbox, read, error
	ПараметрыСообщения.Вставить("doc_id", docid); // обязательный параметр(!) / Идентификатор документа, чье содержание необходимо получить.
	ПараметрыСообщения.Вставить("description", description);
	
	Возврат ПараметрыСообщения;
КонецФункции

Функция ПолучитьПараметрыСообщенияBodies(gln, doc_id)
	ПараметрыСообщения = Новый Структура;
	ПараметрыСообщения.Вставить("gln", gln);  // обязательный параметр(!) / идентификатор пользователя, участника EDI обмена.
	ПараметрыСообщения.Вставить("doc_id", doc_id); // обязательный параметр(!) / Идентификатор документа, чье содержание необходимо получить.
	
	Возврат ПараметрыСообщения;
КонецФункции

Функция ВызываемыйМетодПрошелПроверку(ИмяМетода, ПараметрыСообщения)
	ДоступныеМетоды = Новый Массив;
	ДоступныеМетоды.Добавить("/api/v2/edi/documents/bodies/");
	ДоступныеМетоды.Добавить("/api/v2/edo/timeline/event/content/");
	ДоступныеМетоды.Добавить("/api/v2/edo/condras/content/");
	
	Если ДоступныеМетоды.Найти(ИмяМетода) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОбязательныеПараметры = ПолучитьОбязательныеПараметрыМетода(ИмяМетода);
	Если ОбязательныеПараметры = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого Параметр Из ПараметрыСообщения Цикл
		Если ОбязательныеПараметры.Найти(Параметр) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
КонецФункции

Функция ПолучитьОбязательныеПараметрыМетода(ИмяМетода)
	МассивEdiBodies = Новый Массив;
	МассивEdiBodies.Добавить("gln");
	МассивEdiBodies.Добавить("doc_id");
	
	МассивContent = Новый Массив;
	МассивContent.Добавить("gln");
	МассивContent.Добавить("guid");
	МассивContent.Добавить("doc_uuid");
	
	ОбязательныеПараметры = Новый Соответствие;
	ОбязательныеПараметры.Вставить("/api/v2/edi/documents/bodies/"	    , МассивEdiBodies);
	ОбязательныеПараметры.Вставить("/api/v2/edo/timeline/event/content/", МассивContent);
	ОбязательныеПараметры.Вставить("/api/v2/edo/condras/content/"	    , МассивContent);
	
	Возврат ОбязательныеПараметры.Получить(ИмяМетода);
КонецФункции

Функция ПолучитьМассивВходящихДокументовEDI(ДанныеПодключения, ТипДокумента, gln, status = "inbox")
	// значения в API и модуле 1С отличаются для данных типов, приведение к одному виду
	DocType 	 = НРег(ТипДокумента);
	Если DocType = "order" Или DocType = "retin" Тогда
		DocType = DocType + "s";
	КонецЕсли;
	
	МетодApiDocuments  = "/api/v2/edi/documents/";
	ПараметрыСообщения = Новый Структура("gln, doc_type, status", gln, DocType, status);
	Заголовки 		   = Новый Структура("X-Auth-Token", ДанныеПодключения.Токен);  	
	ЗаполнитьПараметрыМетода(МетодApiDocuments, ПараметрыСообщения);
	
	РезультатAPI = ВыполнитьЗапросAPI(ДанныеПодключения.Сервер,, МетодApiDocuments,, Заголовки);    
	Если РезультатAPI.Успешно Тогда 
		МассивДокументов = РезультатAPI.Ответ.Получить("documents");
	КонецЕсли;
	
	Возврат МассивДокументов;
КонецФункции
// КонецОбласти ОбщиеAPI

