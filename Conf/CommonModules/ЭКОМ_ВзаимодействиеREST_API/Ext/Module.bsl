// Вызывает выполнение запроса API v3 /Api/V1/Edo/Document/GetEdiDocBody, возвращает структуру:
//		- Успешно - булево - обязательный
//		- ФайлXML - файл
//		- Ответ	  - Соответствие, ответ API
// Параметры:
//ПараметрыМетода - тип структура - параметры метода GET /api/v2/edi/documents/bodies/
//					gln   - строка - обязательный
//					ДокИд - строка - обязательный
//ДанныеПодключения - тип структура - данные о сервере, токене для выполнения метода API
//					 Сервер - строка (адрес сервера)
//					 Токен  - строка (токен из РС ЭКОМ значения доп констант)
Функция ПолучитьВходящийДокументEDIv3(ПараметрыМетода, ДанныеПодключения, Каталог, ТипДокумента) Экспорт
	ИмяМетода  = "/Api/V1/Edo/Document/GetEdiDocBody"; 	
	ТелоЗапроса = Новый Соответствие;
	ТелоЗапроса.Вставить("intDocID", ПараметрыМетода.ДокИд);
	ТелоЗапроса.Вставить("varToken", ДанныеПодключения.Токен);
	
	РезультатAPI = ВыполнитьЗапросAPI(ДанныеПодключения.Сервер,, ИмяМетода, ТелоЗапроса); 
	Результат = РезультатAPI;
	Если РезультатAPI.Успешно Тогда
		Идентификатор = ПараметрыМетода.gln + "-" + ПараметрыМетода.ДокИд;
		ТелоДокумента = РезультатAPI.Ответ.Получить("body");
		ИмяФайла 	  = Каталог +  ТипДокумента + "_" + Идентификатор + ".xml";
		
		СтрокаXML 	  = ЗаписатьВходящийEDI_В_XML(Каталог, ТипДокумента, ИмяФайла, ТелоДокумента, "UTF-8"); 
		Результат.Вставить("СтрокаXML", СтрокаXML);
		Результат.Вставить("ИмяФайла" , ИмяФайла); 	
		Результат.Вставить("ФайлBody" , Новый Файл(ИмяФайла)); 	
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

