////////////////////////////////////////////////////////////////////////////////
// Область ЗаполнениеИдентификаторовЦепочки

Процедура ЗаполнитьИдентификаторыЦепочекСредствамиRESTv2(ЗаписыватьЛог = Ложь) Экспорт
	ПолучатьИдентификаторы = ЭКОМ_ОбщегоНазначения.Настройка_Параметр_Прочитать("ЭКОМ_ПолучатьИдентификаторыЦепочек", Ложь);
	Если Не ПолучатьИдентификаторы Тогда
		Возврат;
	КонецЕсли;
	
	ИмяСобытия = "Получение идентификаторов цепочек";
	МассивЛогаСобытий = Новый Массив;
	СчетчикИзмененных = 0;
	СчетчикПустых     = 0;
	
	ДанныеДляЗаполненияИдЦепочки = ДанныеДляЗаполненияИдЦепочки();
	Если Не ДанныеДляЗаполненияИдЦепочки.ДатаЗаполнена Тогда
		ТекстЛогаСобытий = "Не заполнена служебная константа - дата начала использования идентификаторов цепочек.";
		ЗаписьСтруктурыЛога = ЭКОМ_ОбщегоНазначения.ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);    
		ЭКОМ_ОбщегоНазначения.ЗаписатьЛогСобытийвРегистрЛогирование(МассивЛогаСобытий);    
		Возврат;
	КонецЕсли;
	
	ЗаписиДляЗаполненияИдЦепочки = ДанныеДляЗаполненияИдЦепочки.ДеревоЗаписей;
	СтрокиОрганизации = ЗаписиДляЗаполненияИдЦепочки.Строки;
	Для Каждого СтрокаОрганизация Из СтрокиОрганизации Цикл    		
		СтрокиПрофилиОбмена = СтрокаОрганизация.Строки;
		Для Каждого СтрокаПрофиль Из СтрокиПрофилиОбмена Цикл
			Для Каждого СтрокаВидДокумента Из СтрокаПрофиль.Строки Цикл
				СчетчикПустых  = СчетчикПустых + СтрокаВидДокумента.Строки.Количество();
			КонецЦикла;
		КонецЦикла;

		Если Не ЗначениеЗаполнено(СтрокаОрганизация.Организация) Тогда
			ТекстЛогаСобытий = "Имеются записи с незаполненной организацией, для таких записей идентификаторы цепочки не будут получены.";
			ЗаписьСтруктурыЛога = ЭКОМ_ОбщегоНазначения.ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			Продолжить;
		КонецЕсли;
		
		Для Каждого СтрокаПрофиль Из СтрокиПрофилиОбмена Цикл
			ПрофильОбмена = СтрокаПрофиль.ПрофильОбмена;   	
			
			ЕстьОшибка = РезультатПроверкиПрофиляОбмена(СтрокаПрофиль, МассивЛогаСобытий, ИмяСобытия);
			Если ЕстьОшибка Тогда
				Продолжить;
			КонецЕсли;
			
			ДанныеПодключения = ПолучитьДанныеПодключенияEvolution(ПрофильОбмена);
			ДанныеАвторизации = ВыполнитьАвторизациюАтолл_БезДанных(ДанныеПодключения);
			Если Не ДанныеАвторизации.Получены Тогда
				ТекстЛогаСобытий = "Для профиля обмена " + Строка(ПрофильОбмена) + " не удалось выполнить авторизацию в API v2. Проверьте поля: ""Сервер (обмен)"", ""логин"" и ""пароль (e-vo.ru)"" в профиле обмена.";
				ЗаписьСтруктурыЛога = ЭКОМ_ОбщегоНазначения.ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
				Продолжить;
			КонецЕсли;
			
			СтрокиВидыДокументов = СтрокаПрофиль.Строки;
			Для Каждого СтрокаВидДокумента Из СтрокиВидыДокументов Цикл
				ЗаписиРегистра = СтрокаВидДокумента.Строки;
				
				ЛимитСообщений = ЭКОМ_ОбщегоНазначения.Настройка_Параметр_Прочитать("ЭКОМ_ЛимитСообщенийRESTv2", "50");
				// подготовка: определение типов документа, документооборота, направления обмена
				ТипыДляREST 		= ТипДокументооборотаDoctypeПоВидуДокумента(СтрокаВидДокумента.ВидДокумента);
				doc_type 			= ТипыДляREST.doc_type;
				ТипДокументооборота = ТипыДляREST.ТипДокументооборота;
				Направление			= ?(СтрокаВидДокумента.НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Исходящий, "исходящий", "входящий");
				
				direction  		  = ?(Направление = "исходящий", "1", "0"); // параметр для /edi/documents, определяет получать входящие или исходящие сообщения
				ИмяИдентификатора = ?(ТипДокументооборота = "EDI", "GLN", "ИдУчастника"); // определяет значение какого ресурса ЭКОМ_GLN использовать в качестве параметра метода REST API
				ИмяПоляПоиска     = ?(Направление = "входящий" ИЛИ ТипДокументооборота = "ЮЗД", "docUUID", "ftpFileName"); // определяет какое имя поля использовать для поиска в полученной таблице документов REST API
				
				Если СтрокаВидДокумента.МинимальнаяДата = Дата(1,1,1) Тогда
					ТекстЛогаСобытий = "Для вида документа " + Строка(СтрокаВидДокумента.ВидДокумента) + " имеются записи с незаполненной датой. Идентификаторы для записей с данным видом документа не будут заполнены.";
					ЗаписьСтруктурыЛога = ЭКОМ_ОбщегоНазначения.ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
					МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
					Продолжить;
				КонецЕсли;
				// значения для параметров time_from, time_to ограничивающие список сообщений в ответе REST API
				МинимальнаяДата  = Формат(СтрокаВидДокумента.МинимальнаяДата, "ДФ=yyyy-MM-dd");
				МаксимальнаяДата = Формат(СтрокаВидДокумента.МаксимальнаяДата + 3600 * 24, "ДФ=yyyy-MM-dd");
				
				// в зависимости от типа документооборота используются разные методы API v2 (/edi/documents, /edo/documents)
				Если ТипДокументооборота = "EDI" Тогда
					ПараметрыМетода = Новый Структура("gln, doc_type, time_from, time_to, limit, direction", 
					СтрокаВидДокумента[ИмяИдентификатора], doc_type, МинимальнаяДата, МаксимальнаяДата, ЛимитСообщений, direction);
					МассивДокументов = ПолучитьСписокВходящихДокументовEDI(ПараметрыМетода, ДанныеПодключения);
					ТаблицаОтветAPI = СформироватьТаблицуИзСпискаДокументовAPI(МассивДокументов);
				ИначеЕсли ТипДокументооборота = "ЮЗД" Тогда
					ПараметрыМетода = Новый Структура("guid, time_from, time_to, limit", 
					СтрокаВидДокумента[ИмяИдентификатора], МинимальнаяДата, МаксимальнаяДата, ЛимитСообщений);
					МассивДокументов = ПолучитьСписокВходящихДокументовЮЗД(ПараметрыМетода, ДанныеПодключения, doc_type);
					ТаблицаОтветAPI = СформироватьТаблицуИзСпискаДокументовAPI(МассивДокументов);
				Иначе
					ТекстЛогаСобытий = "Не удалось определить тип документооборота для вида документа " + Строка(СтрокаВидДокумента.ВидДокумента) + ". Нельзя выполнить запрос к API v2 для получения идентификаторов.";
					ЗаписьСтруктурыЛога = ЭКОМ_ОбщегоНазначения.ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
					МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
					Продолжить;
				КонецЕсли;
				
				// поиск chainID и в случае успеха заполнение идентификатора цепочки в записи регистра 
				Для Каждого Запись ИЗ ЗаписиРегистра Цикл
					ЗначениеДляПоиска = ЗначениеДляПоискаИзСпискаДокументовAPI(Запись.ФайлИмя, Направление, ТипДокументооборота);
					НайденнаяСтрока   = ТаблицаОтветAPI.Найти(ЗначениеДляПоиска, ИмяПоляПоиска);					
					Если НайденнаяСтрока = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					МенеджерЗаписи = РегистрыСведений.ЭКОМ_Объекты_События.СоздатьМенеджерЗаписи();
					ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Запись);
					МенеджерЗаписи.Прочитать();
					
					Если МенеджерЗаписи.Выбран() Тогда
						МенеджерЗаписи.ИдентификаторЦепочки = НайденнаяСтрока.chainID;	
						МенеджерЗаписи.Записать();
						СчетчикИзмененных = СчетчикИзмененных + 1;
					КонецЕсли;
				КонецЦикла; // обход записей ЭКОМ_Объекты_События с группировкой по профилю и виду документа
			КонецЦикла; // обход видов документов
		КонецЦикла;	// обход строк профилей обмена	
	КонецЦикла; // обход строк организаций
	
	СтрокаРезультат = "Количество найденных записей без идентификатора: " + СчетчикПустых + ", из них заполнено: " + СчетчикИзмененных + ".";
	Если МассивЛогаСобытий.Количество() Тогда
		ТекстЛогаСобытий = "Операция получения идентификаторов завершена." + Символы.ПС + СтрокаРезультат;
		ЗаписьСтруктурыЛога = ЭКОМ_ОбщегоНазначения.ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
	Иначе
		ТекстЛогаСобытий = "Операция получения идентификаторов завершена успешно." + Символы.ПС + СтрокаРезультат;
		ЗаписьСтруктурыЛога = ЭКОМ_ОбщегоНазначения.ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Успешно, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
	КонецЕсли;
	
	Если ЗаписыватьЛог Тогда
		ЭКОМ_ОбщегоНазначения.ЗаписатьЛогСобытийвРегистрЛогирование(МассивЛогаСобытий);
	КонецЕсли;
КонецПроцедуры

Функция ЗначениеДляПоискаИзСпискаДокументовAPI(ИсходноеЗначение, Направление, ТипДокументооборота)
	Результат = "";
	Если ТипДокументооборота = "EDI" И Направление = "входящий" Тогда
		Попытка
			Результат = СтрЗаменить(ИсходноеЗначение, ".xml", "");
			Результат = Прав(Результат, СтрДлина(Результат) - ЭКОМ_ОбщегоНазначения.ПоискВСтроке(Результат, "_",,,2));
		Исключение
			Результат = "";
		КонецПопытки; 
	ИначеЕсли ТипДокументооборота = "EDI" И Направление = "исходящий" Тогда
		Результат = ИсходноеЗначение;
	ИначеЕсли ТипДокументооборота = "ЮЗД" Тогда
		Попытка
			Результат = СтрЗаменить(ИсходноеЗначение, ".xml", "");
			Результат = Прав(Результат, СтрДлина(Результат) - ЭКОМ_ОбщегоНазначения.ПоискВСтроке(Результат, "_", 1,, 1));
		Исключение
			Результат = "";
		КонецПопытки;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция СформироватьТаблицуИзСпискаДокументовAPI(МассивДокументов)
	ТаблицаРезультат = Новый ТаблицаЗначений;
	ТаблицаРезультат.Колонки.Добавить("chainID"    , Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(36)));
	ТаблицаРезультат.Колонки.Добавить("ftpFileName", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(50)));
	ТаблицаРезультат.Колонки.Добавить("docUUID"    , Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(36)));
	
	Для Каждого Соответствие Из МассивДокументов Цикл
		НовСтр = ТаблицаРезультат.Добавить();
		НовСтр.chainID    = Соответствие.Получить("chainID");
		НовСтр.ftpFileName = Соответствие.Получить("ftpFileName");
		НовСтр.docUUID     = Соответствие.Получить("docUUID");
	КонецЦикла;
	
	Возврат ТаблицаРезультат;	
КонецФункции

Функция ДанныеДляЗаполненияИдЦепочки() 
	Результат = Новый Структура("ДеревоЗаписей, ДатаЗаполнена", Новый ДеревоЗначений, Ложь);
	
	НачалоИспользованияИдЦепочки = ЭКОМ_ОбщегоНазначения.Настройка_Параметр_Прочитать("ЭКОМ_НачалоИспользованияИдентификаторовЦепочки", Дата(1,1,1));
	Если ТипЗнч(НачалоИспользованияИдЦепочки) = Тип("Дата") И НачалоИспользованияИдЦепочки > Дата(1,1,1) Тогда	
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ЭКОМ_Объекты_События.ВидДокумента КАК ВидДокумента,
		|	ЭКОМ_GLN.ПрофильОбмена КАК ПрофильОбмена,
		|	ЭКОМ_Объекты_События.Организация КАК Организация,
		|	ЭКОМ_GLN.Ид_ОЭД КАК ИдУчастника,
		|	ЭКОМ_GLN.GLN КАК GLN,
		|	ЭКОМ_Объекты_События.ДатаДокумента КАК МинимальнаяДата,
		|	ЭКОМ_Объекты_События.ДатаДокумента КАК МаксимальнаяДата,
		|	ЭКОМ_Объекты_События.Документ_Основание КАК Документ_Основание,
		|	ЭКОМ_Объекты_События.ФайлИмя КАК ФайлИмя,
		|	ЭКОМ_Объекты_События.НаправлениеОбмена КАК НаправлениеОбмена,
		|	ЭКОМ_GLN.ПрофильОбмена.ПометкаУдаления КАК ПрофильПометкаУдаления,
		|	ЭКОМ_GLN.ПрофильОбмена.Активный КАК ПрофильАктивный
		|ИЗ
		|	РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_События
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN
		|		ПО ЭКОМ_Объекты_События.Организация = ЭКОМ_GLN.Объект
		|ГДЕ
		|	ЭКОМ_Объекты_События.ИдентификаторЦепочки = """"
		|	И ЭКОМ_Объекты_События.ДатаЗаписи >= &НачалоИспользованияИдентификаторовЦепочки
		|	И НЕ ЭКОМ_Объекты_События.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.PRICAT_Исходящий)
		|	И НЕ ЭКОМ_Объекты_События.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.PRICAT_Входящий)
		|	И НЕ ЭКОМ_Объекты_События.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.CONDRA_Исходящий)
		|	И НЕ ЭКОМ_Объекты_События.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.CONDRA_Входящий)
		|ИТОГИ
		|	МАКСИМУМ(ИдУчастника),
		|	МАКСИМУМ(GLN),
		|	МИНИМУМ(МинимальнаяДата),
		|	МАКСИМУМ(МаксимальнаяДата),
		|	МАКСИМУМ(НаправлениеОбмена)
		|ПО
		|	Организация,
		|	ПрофильОбмена,
		|	ВидДокумента";
		Запрос.УстановитьПараметр("НачалоИспользованияИдентификаторовЦепочки", НачалоИспользованияИдЦепочки);
		Результат.ДеревоЗаписей = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
		Результат.ДатаЗаполнена = Истина;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ТипДокументооборотаDoctypeПоВидуДокумента(ВидДокумента)
	СоответствиеDocTypeВидуДокументовEDI_Атолл = СоответствиеDocTypeВидуДокументовEDI_Атолл();
	
	ТипДокументооборота = Неопределено;
	doc_type			= СоответствиеDocTypeВидуДокументовEDI_Атолл.Получить(ВидДокумента);
	
	Если doc_type = Неопределено Тогда
		СоответствиеDocTypeВидуДокументов_Атолл = СоответствиеDocTypeВидуДокументов_Атолл();
		doc_type = СоответствиеDocTypeВидуДокументов_Атолл.Получить(ВидДокумента);
		Если Не doc_type = Неопределено Тогда
			ТипДокументооборота = "ЮЗД";
			doc_type = ПреобразоватьТипДокументаКЗначениюАтолл(doc_type, ТипДокументооборота);			
		КонецЕсли;
	Иначе
		ТипДокументооборота = "EDI";
	КонецЕсли;
	
	Возврат Новый Структура("ТипДокументооборота, doc_type", ТипДокументооборота, doc_type);
КонецФункции

Функция РезультатПроверкиПрофиляОбмена(СтрокаПрофиль, МассивЛогаСобытий, ИмяСобытия)
	Если Не ЗначениеЗаполнено(СтрокаПрофиль.ПрофильОбмена) Тогда
		ТекстЛогаСобытий = "Не найден профиль обмена для организации " + СтрокаПрофиль.Организация + ". Идентификаторы цепочек для записей по данной организации не будут получены.";
		ЗаписьСтруктурыЛога = ЭКОМ_ОбщегоНазначения.ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		Возврат Истина;
	КонецЕсли;
	
	Если Не СтрокаПрофиль.ПрофильАктивный Или СтрокаПрофиль.ПрофильПометкаУдаления Тогда
		ТекстЛогаСобытий = "Для профиля обмена " + Строка(СтрокаПрофиль.ПрофильОбмена) + " нельзя выполнить получение идентификаторов, профиль не активен или помечен на удаление.";
		ЗаписьСтруктурыЛога = ЭКОМ_ОбщегоНазначения.ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
КонецФункции
// КонецОбласти ЗаполнениеИдентификаторовЦепочки
