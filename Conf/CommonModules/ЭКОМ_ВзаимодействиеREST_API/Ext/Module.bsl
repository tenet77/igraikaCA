// ПараметрыМетода - Структура - параметры метода GET /api/v2/edo/timeline/event/content/
//					gln  	 - Строка - обязательный (gln или Guid), идентификатор пользователя, участника EDI обмена.
//					Guid 	 - Строка - обязательный (gln или Guid), идентификатор пользователя, участника ЮЗД обмена.
//					unread   - Булево - Состояние события (документа): прочитан - 0, не прочитан - 1.
// ДанныеПодключения - Структура - данные о сервере, токене (ПолучитьДанныеПодключенияEvolution)
Функция ПолучитьСписокВходящихДокументовCONDRAv3(ПараметрыМетода, ДанныеПодключения) Экспорт
	ИмяМетода = "/api/v2/edo/condras/timeline/";
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("X-Auth-Token", ДанныеПодключения.Токен);
	ЗаполнитьПараметрыМетода(ИмяМетода, ПараметрыМетода);
	
	РезультатAPI 	 = ВыполнитьЗапросAPI(ДанныеПодключения.Сервер,, ИмяМетода,, Заголовки);    
	МассивДокументов = Новый Массив; 
	Если РезультатAPI.Успешно Тогда 
		МассивДокументов = РезультатAPI.Ответ.Получить("timeLine");
	КонецЕсли;
	
	Возврат МассивДокументов;
КонецФункции
// КонецОбласти CONDRA

Функция ВыполнитьАвторизациюEvolutionV3(ДанныеПодключения) Экспорт
	ИмяМетода = "/Api/V1/Edo/Index/Authorize";
	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("varLogin", ДанныеПодключения.ИмяПользователя);
	ТелоЗапроса.Вставить("varPassword", ДанныеПодключения.ПарольПользователя);
	РезультатAPI = ВыполнитьЗапросAPI("exite-api.e-vo.ru", , ИмяМетода, ТелоЗапроса);
	
	Если РезультатAPI.Успешно Тогда
		Токен = РезультатAPI.Ответ.Получить("varToken"); 
		ЗаписатьТокен(Токен);
	КонецЕсли;
	
	Возврат РезультатAPI;		
КонецФункции

Функция ИзменитьGlnEvolutionV3(ДанныеПодключения, gln) Экспорт
	ИмяМетода = "/Api/V1/User/ChangeApiGln";
	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("gln", gln);
	ТелоЗапроса.Вставить("varToken", ДанныеПодключения.Токен);
	РезультатAPI = ВыполнитьЗапросAPI("exite-api.e-vo.ru", , ИмяМетода, ТелоЗапроса);
	
	Возврат РезультатAPI;		
КонецФункции
// КонецОбласти Evolution_v3

