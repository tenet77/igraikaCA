// Область ПолучениеВходящихДокументов 
// Область EDI

// Вызывает выполнение запроса API /documents/bodies, возвращает структуру:
//		- Успешно - булево - обязательный
//		- ФайлXML - файл
//		- Ответ	  - Соответствие, ответ API
// Параметры:
//ПараметрыМетода - тип структура - параметры метода GET /api/v2/edi/documents/bodies/
//					gln - строка - обязательный
//					doc_id - строка - обязательный
//ДанныеПодключения - тип структура - данные о сервере, токене для выполнения метода API
//					 Сервер - строка (адрес сервера)
//					 Токен  - строка (токен из РС ЭКОМ значения доп констант)
Функция ПолучитьВходящийДокументEDI(ПараметрыМетода, ДанныеПодключения, Каталог, ТипДокумента) Экспорт
	ИмяМетода  = "/api/v2/edi/documents/bodies/"; 	
	Заголовки  = Новый Соответствие;
	Заголовки.Вставить("X-Auth-Token", ДанныеПодключения.Токен);
	ЗаполнитьПараметрыМетода(ИмяМетода, ПараметрыМетода);
	
	РезультатAPI = ВыполнитьЗапросAPI(ДанныеПодключения.Сервер,, ИмяМетода,, Заголовки); 
	Результат = РезультатAPI;
	Если РезультатAPI.Успешно Тогда
		Идентификатор   = ПараметрыМетода.gln + "_" + ПараметрыМетода.doc_id;
		СтрокаСообщения = РезультатAPI.Ответ.Получить("СтрокаОтвет");
		ТелоДокумента   = РезультатAPI.Ответ.Получить("body");
		ИмяФайла 	    = Каталог +  ТипДокумента + "_" + Идентификатор + ".xml";
		
		КодировкаXML  = "UTF-8";
		СтрокаXML 	  = Входящий_EDI_JSON_В_XML(СтрокаСообщения, ТелоДокумента, ТипДокумента, Каталог, ИмяФайла, КодировкаXML); 
		Результат.Вставить("СтрокаXML", СтрокаXML);
		Результат.Вставить("ИмяФайла" , ИмяФайла); 	
		Результат.Вставить("ФайлBody" , Новый Файл(ИмяФайла)); 	
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

// Вызывает выполнение запроса API /edi/documents, возвращает Массив документов edo с отбором по типу
//
// Параметры:
// ПараметрыМетода - Структура - параметры метода GET /api/v2/edi/documents
//					gln  	 - Строка - обязательный (gln или Guid), идентификатор пользователя, участника EDI обмена.
//					status 	 - Строка - обязательный, статус документа (sent, delivered, inbox, read, error).
//					doc_type - Строка - обязательный, тип документа (Order, Ordrsp, Desadv, Recadv, 
//															Insdes, Desscc, Invoice, Alcdes, Retann, Retins, Pricat).
//					limit    - Строка - количество выводимых документов при чтении ленты за 1 раз; по умолчанию значение «40»  
// ДанныеПодключения - Структура - данные о сервере, токене (ПолучитьДанныеПодключенияEvolution)
// ТипДокумента - Строка - Тип документа по которому состоялось событие.
//			Значения: UPD_SCHFDOP, UPD_SCHF
Функция ПолучитьСписокВходящихДокументовEDI(ПараметрыМетода, ДанныеПодключения) Экспорт
	ИмяМетода = "/api/v2/edi/documents/";
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("X-Auth-Token", ДанныеПодключения.Токен);
	
	ЗаполнитьПараметрыМетода(ИмяМетода, ПараметрыМетода);
	РезультатAPI     = ВыполнитьЗапросAPI(ДанныеПодключения.Сервер,, ИмяМетода,, Заголовки);  
	МассивДокументов = Новый Массив;
	Если РезультатAPI.Успешно Тогда 
		МассивДокументов = РезультатAPI.Ответ.Получить("documents");
	КонецЕсли;
	
	Возврат МассивДокументов;
КонецФункции

// Возвращает строку, соответствие типа документа REST API v2 типу документа модуля docrobot
//
// Параметры:
//	ТипДокумента 	    - строка - тип документа модуля docrobot
//	ТипДокументооборота - строка - тип документооборота ("EDI", "ЮЗД", "CNDR") 
Функция ПреобразоватьТипДокументаКЗначениюАтолл(Знач ТипДокумента, ТипДокументооборота) Экспорт
	Если ТипДокументооборота = "EDI" Тогда
		ТипДокумента = НРег(ТипДокумента);
		Если ТипДокумента = "order" Или ТипДокумента = "retin" Тогда
			ТипДокумента = ТипДокумента + "s";         	
		КонецЕсли;
	Иначе
		ТипыEdoTimeline = СоответствиеTypeTimelineТипамДокументов_Атолл();
		ТипДокумента = ТипыEdoTimeline.Получить(ТипДокумента);  
		Если ТипДокумента = Неопределено Тогда
			ТипДокумента = "";
		КонецЕсли;   
	КонецЕсли;   
	
	Возврат ТипДокумента;
КонецФункции
// КонецОбласти EDI

// Область ЮЗД  

// Вызывает выполнение запроса API /event/content, возвращает структуру:
//		- Успешно - булево - обязательный
//		- ФайлXML - файл
//		- Signs   - файл
//		- Ответ	  - Соответствие, ответ API
// Параметры:
//ПараметрыМетода - тип структура - параметры метода GET /api/v2/edo/timeline/event/content/
//					gln  	 - строка - обязательный (gln или Guid), идентификатор пользователя, участника EDI обмена.
//					Guid 	 - строка - обязательный (gln или Guid), идентификатор пользователя, участника ЮЗД обмена.
//					doc_uuid - строка - обязательный, идентификатор документа УПД/УКД или квитанции. Строка в формате GUID.
//ДанныеПодключения - тип структура - данные о сервере, токене для выполнения метода API
//					 Сервер - строка (адрес сервера)
//					 Токен  - строка (токен из РС ЭКОМ значения доп констант)
Функция ПолучитьВходящийДокументЮЗД(ПараметрыМетода, ДанныеПодключения, Каталог, ТипДокумента) Экспорт
	ИмяМетода  = "/api/v2/edo/timeline/event/content/"; 	
	Заголовки  = Новый Соответствие;
	Заголовки.Вставить("X-Auth-Token", ДанныеПодключения.Токен);
	ЗаполнитьПараметрыМетода(ИмяМетода, ПараметрыМетода);
	
	РезультатAPI = ВыполнитьЗапросAPI(ДанныеПодключения.Сервер,, ИмяМетода,, Заголовки); 
	Результат    = РезультатAPI;
	Если РезультатAPI.Успешно Тогда
		Идентификатор = ПараметрыМетода.guid + "_" + ПараметрыМетода.doc_uuid;
		ФайлТело      = ФайлИзBase64(РезультатAPI.Ответ.Получить("body"), Каталог, ТипДокумента, Идентификатор, ".xml");
		Результат.Вставить("ФайлBody", ФайлТело);
		
		МассивSigns = РезультатAPI.Ответ.Получить("signs");
		Если ТипЗнч(МассивSigns) = Тип("Массив") Тогда
			МассивПодписей = Новый Массив;
			Для Каждого Элемент Из МассивSigns Цикл
				ФайлПодпись = ФайлИзBase64(Элемент.Получить("body"), Каталог, ТипДокумента, Идентификатор, ".bin");
				МассивПодписей.Добавить(ФайлПодпись);
			КонецЦикла;
			Результат.Вставить("МассивПодписей", МассивПодписей);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

// Вызывает выполнение запроса API /edo/timeline, возвращает Массив документов edo с отбором по типу
//
// Параметры:
// ПараметрыМетода - Структура - параметры метода GET /api/v2/edo/timeline/event/content/
//					gln  	 - Строка - обязательный (gln или Guid), идентификатор пользователя, участника EDI обмена.
//					Guid 	 - Строка - обязательный (gln или Guid), идентификатор пользователя, участника ЮЗД обмена.
//					unread   - Булево - Состояние события (документа): прочитан - 0, не прочитан - 1.
//					limit    - Строка - количество выводимых документов при чтении ленты за 1 раз; по умолчанию значение «40» 
// ДанныеПодключения - Структура - данные о сервере, токене (ПолучитьДанныеПодключенияEvolution)
// ТипДокумента - Строка - Тип документа по которому состоялось событие.
//			Значения: UPD_SCHFDOP, UPD_SCHF
Функция ПолучитьСписокВходящихДокументовЮЗД(ПараметрыМетода, ДанныеПодключения, ТипДокумента) Экспорт
	ИмяМетода = "/api/v2/edo/timeline/";
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("X-Auth-Token", ДанныеПодключения.Токен);
	ЗаполнитьПараметрыМетода(ИмяМетода, ПараметрыМетода);
	
	РезультатAPI 	 = ВыполнитьЗапросAPI(ДанныеПодключения.Сервер,, ИмяМетода,, Заголовки);  
	МассивДокументов = Новый Массив;
	Если РезультатAPI.Успешно Тогда 
		TimeLine = РезультатAPI.Ответ.Получить("timeLine");
		Для Каждого Элемент Из TimeLine Цикл
			Если Элемент <> Неопределено И ТипДокумента = Элемент.Получить("type") Тогда
				МассивДокументов.Добавить(Элемент);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат МассивДокументов;
КонецФункции
