////////////////////////////////////////////////////////////////////////////////
// ПЕРЕДАЧА ПАРАМЕТРОВ

Функция ПодготовитьПараметры(РасчетНалога, ТаблицаРеквизиты) Экспорт
	
	Параметры = Новый Структура;
	
	// Подготовка таблицы Параметры.ТаблицаРасчетНалога
	
	СписокОбязательныхКолонок = ""
	+ "СуммаНалога,"       // <Число, 15, 2>
	+ "КоррСчет,"          // <ПланСчетовСсылка.Хозрасчетный>
	+ "Субконто,"
	+ "ПоДебету,"          // <Строка, 1>
	+ "СодержаниеПроводки" // <Строка, 150>
	;
	
	Параметры.Вставить("ТаблицаРасчетНалога", 
		ОбщегоНазначенияБПВызовСервера.ПолучитьТаблицуПараметровПроведения(РасчетНалога, СписокОбязательныхКолонок));
	
	// Подготовка таблицы Параметры.Реквизиты
	
	СписокОбязательныхКолонок = ""
	+ "Дата,"                        // <Дата>
	+ "Период,"                      // <Дата>
	+ "НачалоГода,"                  // <Дата>
	+ "НачДата,"                     // <Дата>
	+ "КонДата,"                     // <Дата>
	+ "Организация,"                 // <СправочникСсылка.Организации>
	+ "РегистрацияВНалоговомОргане," // <СправочникСсылка.РегистрацииВНалоговомОргане>
	+ "Регистратор,"                 // <ДокументСсылка.*>
	+ "СтавкаНалогаНаПрибыль,"       // <Число, 15, 2>
	+ "Содержание"                   // <Строка, 150>
	;
	
	Параметры.Вставить("Реквизиты", 
		ОбщегоНазначенияБПВызовСервера.ПолучитьТаблицуПараметровПроведения(ТаблицаРеквизиты, СписокОбязательныхКолонок));
	
	Возврат Параметры;
	
КонецФункции // ПодготовитьПараметры()

////////////////////////////////////////////////////////////////////////////////
// НАЧИСЛЕНИЕ НАЛОГА

// Рассчитывает налоговую базу по налогу на прибыль
Функция НалоговаяБаза(НачалоПериода, КонецПериода, Организации) Экспорт
	
	СчетаПрибылиУбытки = новый Массив;	
	СчетаПрибылиУбытки.Добавить(ПланыСчетов.Хозрасчетный.Доходы);
	СчетаПрибылиУбытки.Добавить(ПланыСчетов.Хозрасчетный.Расходы);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", НачалоГода(НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода",  КонецГода(КонецПериода));
	Запрос.УстановитьПараметр("Организации",   Организации);
	Запрос.УстановитьПараметр("СчетаПрибылиУбытки", СчетаПрибылиУбытки);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СУММА(ХозрасчетныйОбороты.СуммаНУОборотКт - ХозрасчетныйОбороты.СуммаНУОборотДт) КАК НалоговаяБаза
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			Счет В ИЕРАРХИИ (&СчетаПрибылиУбытки) И Счет <> ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасходыПоКорпоративномуПодоходномуНалогу),
	|			,
	|			Организация В (&Организации)
	|			,
	|			КорСчет <> ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ИтоговаяПрибыльИтоговыйУбыток),
	|			) КАК ХозрасчетныйОбороты";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.НалоговаяБаза;
	Иначе
		Возврат 0;
	КонецЕсли;

КонецФункции

// Начисляет налог на прибыль - формирует проводки.
//
// Возвращаемое значение:
//  Число - общая сумма (до)начисленного налога
Функция НачислитьНалогНаПрибыль(Движения, СписокОрганизаций, Знач Реквизиты) Экспорт
	
	Параметры                    = ПодготовитьПараметры(Неопределено, Реквизиты);
	Реквизиты                    = Параметры.Реквизиты[0];
	Параметры                    = Неопределено; // Далее не используется
	
	ПоддержкаПБУ18               = УчетнаяПолитика.ПоддержкаПБУ18(Реквизиты.Организация, Реквизиты.Период);
	
	// Рассчитаем базу налога на прибыль
	БазаНалогаЗаГод  = НалоговаяБаза(НачалоГода(Реквизиты.Период), КонецМесяца(Реквизиты.Период), СписокОрганизаций);
	
	ОбщаяСуммаНалога = 0; // Общая сумма за месяц - во все бюджеты и все налог.органы
	
	Ставка = 0;
	ТочностьРасчета = 0;//округлим результат расчета, т.к. в декларации по КПН налог на прибыль указывается в целых числах.
	НалоговыйУчет.ПолучитьСтавкуНалогаНаПрибыль(Реквизиты, Неопределено, Ставка);
	
	ПараметрыНачисления = Новый Структура;
	ПараметрыНачисления.Вставить("ПоддержкаПБУ18",  ПоддержкаПБУ18);
	ПараметрыНачисления.Вставить("ТочностьРасчета", ТочностьРасчета);
	ПараметрыНачисления.Вставить("БазаНалогаЗаГод", БазаНалогаЗаГод);
	
	ПараметрыНачисления.Вставить("СтавкаНалога", Ставка);
	
	ОбщаяСуммаНалога = ОбщаяСуммаНалога
		+ ДобавитьПроводкуНачислениеНалогаНаПрибыль(Движения, Реквизиты, ПараметрыНачисления);
	
	Движения.Хозрасчетный.Записывать = Истина;
	
	Возврат ОбщаяСуммаНалога;
	
КонецФункции

Функция ДобавитьПроводкуНачислениеНалогаНаПрибыль(Движения, Реквизиты, ПараметрыНачисления)
	
	Если ПараметрыНачисления.БазаНалогаЗаГод < 0 Тогда
		СуммаНалога = 0;
		СуммаРасчетногоНалога = 0; 
	Иначе 
		СуммаНалога = Окр(ПараметрыНачисления.БазаНалогаЗаГод * ПараметрыНачисления.СтавкаНалога, ПараметрыНачисления.ТочностьРасчета);
		СуммаРасчетногоНалога = СуммаНалога;
	КонецЕсли;

	Если СуммаНалога = 0 Тогда
		Возврат СуммаРасчетногоНалога;
	КонецЕсли;
	
	Проводка = Движения.Хозрасчетный.Добавить();
	Проводка.Период      = Реквизиты.Период;
	Проводка.Организация = Реквизиты.Организация;
	Проводка.Сумма       = СуммаНалога;
	Проводка.Содержание  = Реквизиты.Содержание;
	Проводка.СчетДт      = ПланыСчетов.Хозрасчетный.РасходыПоКорпоративномуПодоходномуНалогу;
	БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 1, ПланыВидовХарактеристик.СтатьиРасходов.РасходыПоНалогуНаПрибыль);
				
	Проводка.СчетКт = ПланыСчетов.Хозрасчетный.КорпоративныйПодоходныйНалогПодлежащийУплате;
	БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 1, Перечисления.ВидыПлатежейВГосБюджет.Налог);
	
	Возврат СуммаРасчетногоНалога;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// РАСЧЕТ ПОСТОЯННЫХ И ОТЛОЖЕННЫХ НАЛОГОВЫХ АКТИВОВ И ОБЯЗАТЕЛЬСТВ

Процедура РасчетВременныхРазницБалансовымМетодом(Движения, СписокОрганизаций, ТаблицаРеквизиты) Экспорт
	
	Параметры                    = ПодготовитьПараметры(Неопределено, ТаблицаРеквизиты);
	Реквизиты                    = Параметры.Реквизиты[0];
	Параметры                    = Неопределено; // Далее не используется
	
	МассивРассматриваемыхСчетов = Новый Массив;
	МассивРассматриваемыхСчетов.Добавить(ПланыСчетов.Хозрасчетный.КраткосрочныеАктивы);
	МассивРассматриваемыхСчетов.Добавить(ПланыСчетов.Хозрасчетный.ДолгосрочныеАктивы);
	МассивРассматриваемыхСчетов.Добавить(ПланыСчетов.Хозрасчетный.КраткосрочныеОбязательства);
	МассивРассматриваемыхСчетов.Добавить(ПланыСчетов.Хозрасчетный.ДолгосрочныеОбязательства);
	МассивРассматриваемыхСчетов.Добавить(ПланыСчетов.Хозрасчетный.КапиталИРезервы);
		
	КонГраница = Новый Граница(КонецМесяца(Реквизиты.Период), ВидГраницы.Включая);

	// Найдем расчетное значение ОНО и ОНА по результатам года
	Запрос = Новый Запрос;                                           	
	Запрос.УстановитьПараметр("ДатаКон",    	КонГраница);
	Запрос.УстановитьПараметр("Организации",   	СписокОрганизаций);
	Запрос.УстановитьПараметр("СписокСчетов",   МассивРассматриваемыхСчетов);
		
	Запрос.Текст = "ВЫБРАТЬ
	               |	ХозрасчетныйОстатки.Счет,
	               |	ХозрасчетныйОстатки.СуммаВРОстатокДт КАК СуммаОстатокДт,
	               |	ХозрасчетныйОстатки.СуммаВРОстатокКт КАК СуммаОстатокКт,
	               |	ХозрасчетныйОстатки.СуммаВРОстаток КАК СуммаОНО
	               |ИЗ
	               |	РегистрБухгалтерии.Хозрасчетный.Остатки(
	               |			&ДатаКон,
	               |			Счет В ИЕРАРХИИ (&СписокСчетов),
	               |			,
	               |			Организация В (&Организации)
	               |			) КАК ХозрасчетныйОстатки
	               |ИТОГИ
	               |	СУММА(СуммаОстатокДт),
	               |	СУММА(СуммаОстатокКт),
	               |	СУММА(СуммаОНО)
	               |ПО
	               |	ОБЩИЕ";

    Результат = Запрос.Выполнить();
	РасчетнаяСумаОНА_ОНО = 0;
	Если НЕ Результат.Пустой() Тогда		
	    ВыборкаИтогов = Результат.Выбрать();
		ВыборкаИтогов.Следующий();
		
		Ставка = 0;
		НалоговыйУчет.ПолучитьСтавкуНалогаНаПрибыль(Реквизиты, Неопределено, Ставка);
		
		РасчетнаяСумаОНА_ОНО = Окр(ВыборкаИтогов.СуммаОНО * Ставка, 2);
	КонецЕсли;
	
	// Найдем текущие данные по отражению ОНО и ОНА в балансе
	Запрос.Текст  = "ВЫБРАТЬ
	|	ХозрасчетныйОстатки.Счет,
	|	ХозрасчетныйОстатки.СуммаОстаток КАК СуммаОстаток
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(&ДатаКон, 
	|		Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ОтложенныеНалоговыеАктивыПоКорпоративномуПодоходномуНалогу), 
	|				ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ОтложенныеНалоговыеОбязательстваПоКорпоративномуПодоходномуНалогу))
	|		,
	|		, 
	|		Организация В (&Организации)
	|) КАК ХозрасчетныйОстатки";
	
	Результат = Запрос.Выполнить();
	ТекущаяСуммаОНА_ОНО = РасчетнаяСумаОНА_ОНО; // будем корректировать имеющиеся остатки ОНО_ОНА. Оставшуюся величину - признаем в балансе 
	
	Таблица = Результат.Выгрузить();
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("ТаблицаОНАОНО", Таблица);
	ПараметрыРасчета.Вставить("РасчетнаяСумаОНА_ОНО", РасчетнаяСумаОНА_ОНО);
	
	СформироватьДвиженияПоОтложеннымАктивамИОбязательствам(Движения, Реквизиты, ПараметрыРасчета);
	
КонецПроцедуры

Процедура СформироватьДвиженияПоОтложеннымАктивамИОбязательствам(Движения, Реквизиты, ПараметрыРасчета)
	
	РасчетнаяСумаОНА_ОНО = ПараметрыРасчета.РасчетнаяСумаОНА_ОНО;
	
	ПризнакОНО = РасчетнаяСумаОНА_ОНО > 0;	
	
	СчетРасходовПоКПН = ПланыСчетов.Хозрасчетный.РасходыПоКорпоративномуПодоходномуНалогу;
	
	Для Каждого СтрокаРасчета Из ПараметрыРасчета.ТаблицаОНАОНО Цикл
		// ОНО. Списываем имеющееся ОНА. Корректируем размер ОНО
		Если СтрокаРасчета.СуммаОстаток > 0 Тогда
			// в балансе отражено ОНА. Списываем его
			Проводка = Движения.Хозрасчетный.Добавить();
			Проводка.Период       = Реквизиты.Период;
			Проводка.Организация  = Реквизиты.Организация;
			
			Проводка.СчетДт       = СчетРасходовПоКПН;
			БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 1, ПланыВидовХарактеристик.СтатьиРасходов.УсловныеРасходыПоНалогуНаПрибыль);
						
			Проводка.СчетКт       = СтрокаРасчета.Счет;	
			Проводка.Сумма        = СтрокаРасчета.СуммаОстаток;
			
			Проводка.Содержание   = НСтр("ru='Списан имеющийся отложенный налоговый актив " + ПредставлениеПериода(НачалоГода(Реквизиты.Период),  КонецГода(Реквизиты.Период), "ФП=Истина")+"'");
			
		Иначе	
			// в балансе отражено ОНО. Списываем его
			Проводка = Движения.Хозрасчетный.Добавить();
			Проводка.Период       = Реквизиты.Период;
			Проводка.Организация  = Реквизиты.Организация;
			
			Проводка.СчетДт       = СтрокаРасчета.Счет;		
			
			Проводка.СчетКт       = СчетРасходовПоКПН;
			БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 1, ПланыВидовХарактеристик.СтатьиРасходов.УсловныеРасходыПоНалогуНаПрибыль);
						
			Проводка.Сумма        = - СтрокаРасчета.СуммаОстаток;
			
			Проводка.Содержание   =  НСтр("ru='Списано имеющееся отложенное налоговое обязательство " + ПредставлениеПериода(НачалоГода(Реквизиты.Период),  КонецГода(Реквизиты.Период), "ФП=Истина")+"'");
			
		КонецЕсли;	
	КонецЦикла;	
	
	Если РасчетнаяСумаОНА_ОНО <> 0 Тогда
		
		Если ПризнакОНО Тогда
			// отложенное налоговое обязательство
			Проводка = Движения.Хозрасчетный.Добавить();
			Проводка.Период       = Реквизиты.Период;
			Проводка.Организация  = Реквизиты.Организация;
			
			Проводка.СчетДт       = СчетРасходовПоКПН;
			БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 1, ПланыВидовХарактеристик.СтатьиРасходов.УсловныеРасходыПоНалогуНаПрибыль);
						
			Проводка.СчетКт       = ПланыСчетов.Хозрасчетный.ОтложенныеНалоговыеОбязательстваПоКорпоративномуПодоходномуНалогу;
			Проводка.Сумма        = РасчетнаяСумаОНА_ОНО;
			
			Проводка.Содержание   = НСтр("ru='Признано отложенное налоговое обязательство за период " + ПредставлениеПериода(НачалоГода(Реквизиты.Период),  КонецГода(Реквизиты.Период), "ФП=Истина")+"'");
			
		Иначе
			// отложенный налоговый актив, так как сумма вычетов по налоговому учету превысила полученные доходы
			Проводка = Движения.Хозрасчетный.Добавить();
			Проводка.Период       = Реквизиты.Период;
			Проводка.Организация  = Реквизиты.Организация;
			
			Проводка.СчетДт       = ПланыСчетов.Хозрасчетный.ОтложенныеНалоговыеАктивыПоКорпоративномуПодоходномуНалогу;		
			
			Проводка.СчетКт       = СчетРасходовПоКПН;
			БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 1, ПланыВидовХарактеристик.СтатьиРасходов.УсловныеРасходыПоНалогуНаПрибыль);
			
			Проводка.Сумма        = - РасчетнаяСумаОНА_ОНО;
			
			Проводка.Содержание   =  НСтр("ru='Признан отложенный налоговый актив за период " + ПредставлениеПериода(НачалоГода(Реквизиты.Период),  КонецГода(Реквизиты.Период), "ФП=Истина")+"'");
		КонецЕсли;			
	КонецЕсли;
	
	Движения.Хозрасчетный.Записывать = Истина;
	
КонецПроцедуры	
