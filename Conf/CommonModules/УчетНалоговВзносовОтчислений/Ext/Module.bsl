Процедура СоздатьВТРазмерыМЗППоПериодам(МенеджерВременныхТаблиц) Экспорт
	
	УничтожитьВТ = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МАКСИМУМ(МинимальнаяЗаработнаяПлата.Период) КАК ПериодМЗП,
		|	МАКСИМУМ(МинимальнаяЗаработнаяПлатаНаНачалоГода.Период) КАК ПериодМЗПНаНачалоГода,
		|	ПериодыРасчета.Период КАК МесяцНалоговогоПериода
		|ПОМЕСТИТЬ ВТПериодыМЗП
		|ИЗ
		|	ВТДатыПоМесяцам КАК ПериодыРасчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МинимальнаяОплатаТрудаРФ КАК МинимальнаяЗаработнаяПлата
		|		ПО ПериодыРасчета.Период >= МинимальнаяЗаработнаяПлата.Период
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МинимальнаяОплатаТрудаРФ КАК МинимальнаяЗаработнаяПлатаНаНачалоГода
		|		ПО НАЧАЛОПЕРИОДА(ПериодыРасчета.Период, ГОД) >= МинимальнаяЗаработнаяПлатаНаНачалоГода.Период
		|
		|СГРУППИРОВАТЬ ПО
		|	ПериодыРасчета.Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТПериодыМЗП.МесяцНалоговогоПериода,
		|	ЕСТЬNULL(МинимальнаяЗаработнаяПлата.Размер, 0) КАК РазмерМЗП,
		|	ЕСТЬNULL(МинимальнаяЗаработнаяПлатаНаНачалоГода.Размер, 0) КАК РазмерМЗПНаНачалоГода
		|ПОМЕСТИТЬ ВТРазмерыМЗППоПериодам
		|ИЗ
		|	ВТПериодыМЗП КАК ВТПериодыМЗП
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МинимальнаяОплатаТрудаРФ КАК МинимальнаяЗаработнаяПлата
		|		ПО ВТПериодыМЗП.ПериодМЗП = МинимальнаяЗаработнаяПлата.Период
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МинимальнаяОплатаТрудаРФ КАК МинимальнаяЗаработнаяПлатаНаНачалоГода
		|		ПО ВТПериодыМЗП.ПериодМЗПНаНачалоГода = МинимальнаяЗаработнаяПлатаНаНачалоГода.Период
		|";
		
	Запрос.Выполнить();
	УничтожитьВТ.Добавить("ВТПериодыМЗП");
	
	ЗарплатаКадры.УничтожитьВТ(МенеджерВременныхТаблиц, УничтожитьВТ);
	
КонецПроцедуры

