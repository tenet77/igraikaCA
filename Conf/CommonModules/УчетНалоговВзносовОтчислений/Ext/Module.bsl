		СтрокаИПН.ВидНалогаВзносаОтчисления = ВидНалогаВзноса;
	КонецЦикла;
	
	ВычетыИПН = Новый ТаблицаЗначений;
	ВычетыИПН.Колонки.Добавить("ИдентификаторСтрокиНалогиВзносыОтчисления", Новый ОписаниеТипов("Число"));
	ВычетыИПН.Колонки.Добавить("ВидВычетаИПН", Новый ОписаниеТипов("СправочникСсылка.ВидыВычетовИПН"));
	ВычетыИПН.Колонки.Добавить("РазрешенныйВычет", Новый ОписаниеТипов("Число"));
	ВычетыИПН.Колонки.Добавить("ПримененныйВычет", Новый ОписаниеТипов("Число"));
	
	Возврат Новый Структура("ИПН, ВычетыИПН", ИПН, ВычетыИПН);

КонецФункции

Функция ДанныеОРезультатахРасчетаИПНДляДокументаПосле2018(ИПН) 
	
	// Надо разделить вычеты и ИПН
	
	ВидНалогаВзноса = Перечисления.ВидыНалоговВзносовОтчислений.ИПН;

	// Приводим таблицу к структуре, соответствующей документам расчета.
	ИПН.Колонки.Добавить("ИдентификаторСтрокиНалогиВзносыОтчисления", Новый ОписаниеТипов("Число"));
	ИПН.Колонки.Добавить("НалогВзнос", Новый ОписаниеТипов("Число"));
	ИПН.Колонки.Добавить("ОбъектИсчисления", Новый ОписаниеТипов("Число"));
	ИПН.Колонки.Добавить("ВидНалогаВзносаОтчисления", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыНалоговВзносовОтчислений"));
	
	Для Каждого СтрокаИПН Из ИПН Цикл
		СтрокаИПН.НалогВзнос = СтрокаИПН.ИсчисленныйИПН;
		СтрокаИПН.ОбъектИсчисления = СтрокаИПН.ОбъектИсчисленияИПН;
		СтрокаИПН.ВидНалогаВзносаОтчисления = ВидНалогаВзноса;
	КонецЦикла;
	
	ВычетыИПН = Новый ТаблицаЗначений;
	ВычетыИПН.Колонки.Добавить("ИдентификаторСтрокиНалогиВзносыОтчисления", Новый ОписаниеТипов("Число"));
	ВычетыИПН.Колонки.Добавить("ВидВычетаИПН", Новый ОписаниеТипов("СправочникСсылка.ВидыВычетовИПН"));
	ВычетыИПН.Колонки.Добавить("РазрешенныйВычет", Новый ОписаниеТипов("Число"));
	ВычетыИПН.Колонки.Добавить("ПримененныйВычет", Новый ОписаниеТипов("Число"));
	
	// Определяем соответствие видов вычетов полям таблицы.
	ВидыВычетов = ВидыВычетовПоПолямТаблицы(ИПН.СкопироватьКолонки());
	
	// Заполняем таблицу ВычетыИПН: 
	// для каждой строки ИПН добавляем столько отдельных строк, сколько вычетов было применено.
	Для Каждого СтрокаИПН Из ИПН Цикл
		СтрокаИПН.ИдентификаторСтрокиНалогиВзносыОтчисления = ИПН.Индекс(СтрокаИПН);
		Для Каждого КлючПоля Из ВидыВычетов Цикл
			Если СтрокаИПН["РазрешенныйВычет" + КлючПоля] <> 0 
				ИЛИ СтрокаИПН["ПримененныйВычет" + КлючПоля] <> 0 Тогда
				СтрокаВычетов = ВычетыИПН.Добавить();
				СтрокаВычетов.ИдентификаторСтрокиНалогиВзносыОтчисления = СтрокаИПН.ИдентификаторСтрокиНалогиВзносыОтчисления;
				СтрокаВычетов.ВидВычетаИПН = СтрокаИПН["ВидВычета" + КлючПоля];
				СтрокаВычетов.РазрешенныйВычет = СтрокаИПН["РазрешенныйВычет" + КлючПоля];
				СтрокаВычетов.ПримененныйВычет = СтрокаИПН["ПримененныйВычет" + КлючПоля];
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Новый Структура("ИПН, ВычетыИПН", ИПН, ВычетыИПН);

