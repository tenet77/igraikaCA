Функция РассчитатьНеоблагаемыеДоходы(Организация, Регистратор, МенеджерВременныхТаблиц, МесяцНачисления, ОкончательныйРасчет) Экспорт
	
	УничтожитьВТ = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПериодРегистрации", НачалоМесяца(МесяцНачисления));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ИсключаемыйРегистратор", Регистратор);
	Запрос.УстановитьПараметр("ОкончательныйРасчет", ОкончательныйРасчет);
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(СведенияОНеоблагаемыхДоходах.Период, МЕСЯЦ) КАК МесяцНалоговогоПериода,
		|	СведенияОНеоблагаемыхДоходах.ПериодРегистрации,
		|	СведенияОНеоблагаемыхДоходах.Подразделение,
		|	СведенияОНеоблагаемыхДоходах.ФизическоеЛицо,
		|	СведенияОНеоблагаемыхДоходах.Начисление,
		|	СведенияОНеоблагаемыхДоходах.ВидНалогаВзносаОтчисления,
		|	СведенияОНеоблагаемыхДоходах.ДоходНеПодлежащийНалогообложению,
		|	СУММА(СведенияОНеоблагаемыхДоходах.СуммаДоходаОборот) КАК СуммаДохода,
		|	СУММА(СведенияОНеоблагаемыхДоходах.НеоблагаемыйДоходОборот) КАК НеоблагаемыйДоход
		|ПОМЕСТИТЬ ВТСведенияОНеоблагаемыхЧастичноДоходахРанееИсчисленные
		|ИЗ
		|	РегистрНакопления.СведенияОНеоблагаемыхДоходахФизическихЛиц.Обороты(
		|			,
		|			,
		|			Регистратор,
		|			Организация = &Организация
		|				И ФизическоеЛицо В
		|					(ВЫБРАТЬ
		|						СписокСотрудников.ФизическоеЛицо
		|					ИЗ
		|						ВТФизическиеЛица КАК СписокСотрудников)
		|				И &ОкончательныйРасчетДоходы) КАК СведенияОНеоблагаемыхДоходах
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПериодыПоФизлицам КАК ПериодыПоФизлицам
		|		ПО (НАЧАЛОПЕРИОДА(СведенияОНеоблагаемыхДоходах.Период, ГОД) = НАЧАЛОПЕРИОДА(ПериодыПоФизлицам.МесяцНалоговогоПериода, ГОД))
		|			И СведенияОНеоблагаемыхДоходах.ФизическоеЛицо = ПериодыПоФизлицам.ФизическоеЛицо
		|ГДЕ
		|	СведенияОНеоблагаемыхДоходах.Регистратор <> &ИсключаемыйРегистратор
		|	И СведенияОНеоблагаемыхДоходах.ПериодРегистрации <= &ПериодРегистрации
		|	И (ВЫБОР
