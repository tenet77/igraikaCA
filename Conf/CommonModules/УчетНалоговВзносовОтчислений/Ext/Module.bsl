Функция ПодготовитьСлужебныеДанныеДляРасчетаИПН();
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВидыВычетовИПН.Ссылка,
		|	ВидыВычетовИПН.Приоритет КАК Приоритет
