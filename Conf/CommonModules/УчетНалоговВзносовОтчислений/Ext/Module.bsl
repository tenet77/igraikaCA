		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТПериодыСведений.МесяцНалоговогоПериода КАК МесяцНалоговогоПериода,
		|	НалогообложениеНачислений.Начисление,
		|	НалогообложениеНачислений.ВидДохода,
		|
		|	НалогообложениеНачислений.СпособОбложенияОПВ,
		|	НалогообложениеНачислений.ДоходНеПодлежащийНалогообложениюОПВ,
		|
		|	НалогообложениеНачислений.СпособОбложенияИПН,
		|	НалогообложениеНачислений.ДоходНеПодлежащийНалогообложениюИПН,
		|
		|	НалогообложениеНачислений.СпособОбложенияСО,
		|	НалогообложениеНачислений.ДоходНеПодлежащийНалогообложениюСО,
		|
		|	НалогообложениеНачислений.СпособОбложенияСН,
		|	НалогообложениеНачислений.ДоходНеПодлежащийНалогообложениюСН,
		|
		|	НалогообложениеНачислений.СпособОбложенияОППВ,
		|	НалогообложениеНачислений.ДоходНеПодлежащийНалогообложениюОППВ,
		|
		|	НалогообложениеНачислений.СпособОбложенияВОСМС,
		|	НалогообложениеНачислений.ДоходНеПодлежащийНалогообложениюВОСМС,
		|
		|	НалогообложениеНачислений.СпособОбложенияООСМС,
		|	НалогообложениеНачислений.ДоходНеПодлежащийНалогообложениюООСМС
		|
		|ПОМЕСТИТЬ ВТНалогообложениеНачислений
		|ИЗ
		|	ВТПериодыСведений КАК ВТПериодыСведений
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НалогообложениеНачислений КАК НалогообложениеНачислений
		|		ПО ВТПериодыСведений.ПериодСведений = НалогообложениеНачислений.Период
		|			И ВТПериодыСведений.Начисление = НалогообложениеНачислений.Начисление";
		
	Запрос.Выполнить();	
	УничтожитьВТ.Добавить("ВТПериодыСведений");
	
	ЗарплатаКадры.УничтожитьВТ(МенеджерВременныхТаблиц, УничтожитьВТ);

