		|	Справочник.ВидыВычетовИПН КАК ВидыВычетовИПН
		|ГДЕ
		|	ВидыВычетовИПН.ПометкаУдаления = ЛОЖЬ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Приоритет";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	КвалификаторЧисла = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2));
	ВспомогательнаяТаблицаРасчета = Новый ТаблицаЗначений;
	ВспомогательнаяТаблицаРасчета.Колонки.Добавить("МесяцНалоговогоПериода", Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ВспомогательнаяТаблицаРасчета.Колонки.Добавить("ФизическоеЛицо", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
	ВспомогательнаяТаблицаРасчета.Колонки.Добавить("ВидДохода", Новый ОписаниеТипов("СправочникСсылка.ВидыДоходов"));
	ВспомогательнаяТаблицаРасчета.Колонки.Добавить("ОбъектИсчисленияИПН", КвалификаторЧисла);
	ВспомогательнаяТаблицаРасчета.Колонки.Добавить("ИсчисленныйИПН", КвалификаторЧисла);
	ВспомогательнаяТаблицаРасчета.Колонки.Добавить("ПримененнаяЛьгота", КвалификаторЧисла);
	
	РезультатыРасчетов = ВспомогательнаяТаблицаРасчета.СкопироватьКолонки();
	РезультатыРасчетов.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.ПодразделенияОрганизаций"));
	РезультатыРасчетов.Колонки.Добавить("ОблагаемыйДоход", КвалификаторЧисла);
	РезультатыРасчетов.Колонки.Добавить("НеоблагаемыйДоход", КвалификаторЧисла);      
	
	РезультатыРасчетов.Колонки.Добавить("ОблагаемыйДоходВЦеломЗаПериод", КвалификаторЧисла);
	РезультатыРасчетов.Колонки.Добавить("НеоблагаемыйДоходВЦеломЗаПериод", КвалификаторЧисла);
	РезультатыРасчетов.Колонки.Добавить("ОбъектИсчисленияИПНВЦеломЗаПериод", КвалификаторЧисла);
	РезультатыРасчетов.Колонки.Добавить("ИсчисленныйИПНВЦеломЗаПериод", КвалификаторЧисла);
	РезультатыРасчетов.Колонки.Добавить("ПримененнаяЛьготаВЦеломЗаПериод", КвалификаторЧисла);
	
	РезультатыРасчетов.Колонки.Добавить("ОблагаемыйДоходИсчисленныйРанее", КвалификаторЧисла);
	РезультатыРасчетов.Колонки.Добавить("НеоблагаемыйДоходИсчисленныйРанее", КвалификаторЧисла);
	РезультатыРасчетов.Колонки.Добавить("ОбъектИПНИсчисленныйРанее", КвалификаторЧисла);
	РезультатыРасчетов.Колонки.Добавить("ИПНИсчисленныйРанее", КвалификаторЧисла);

	ИзмеренияРасчетаВычетов = "";
	РесурсыРасчетаВычетов = "";
	
	// Добавляем колонки для вычетов
	Пока Выборка.Следующий() Цикл
		
		ВспомогательнаяТаблицаРасчета.Колонки.Добавить("ВидВычета" + Строка(Выборка.Приоритет), Новый ОписаниеТипов("СправочникСсылка.ВидыВычетовИПН"));
		ВспомогательнаяТаблицаРасчета.Колонки.Добавить("ПримененныйВычет" + Строка(Выборка.Приоритет), КвалификаторЧисла);
		ВспомогательнаяТаблицаРасчета.Колонки.Добавить("РазрешенныйВычет" + Строка(Выборка.Приоритет), КвалификаторЧисла);
		ВспомогательнаяТаблицаРасчета.Колонки.Добавить("ИспользуетсяПоНесколькимВидамДохода" + Строка(Выборка.Приоритет), Новый ОписаниеТипов("Булево"));
		
		РезультатыРасчетов.Колонки.Добавить("ВидВычета" + Строка(Выборка.Приоритет), Новый ОписаниеТипов("СправочникСсылка.ВидыВычетовИПН"));
		РезультатыРасчетов.Колонки.Добавить("ПримененныйВычет" + Строка(Выборка.Приоритет), КвалификаторЧисла);
		РезультатыРасчетов.Колонки.Добавить("РазрешенныйВычет" + Строка(Выборка.Приоритет), КвалификаторЧисла);
		
		РезультатыРасчетов.Колонки.Добавить("ПримененныйВычет" + Строка(Выборка.Приоритет) + "ВЦеломЗаПериод", КвалификаторЧисла);
		РезультатыРасчетов.Колонки.Добавить("РазрешенныйВычет" + Строка(Выборка.Приоритет) + "ВЦеломЗаПериод", КвалификаторЧисла);
		
		РезультатыРасчетов.Колонки.Добавить("ПримененныйВычет" + Строка(Выборка.Приоритет) + "ИсчисленныйРанее", КвалификаторЧисла);
		РезультатыРасчетов.Колонки.Добавить("РазрешенныйВычет" + Строка(Выборка.Приоритет) + "ИсчисленныйРанее", КвалификаторЧисла);
		
		ИзмеренияРасчетаВычетов = ИзмеренияРасчетаВычетов + ",ВидВычета" + Строка(Выборка.Приоритет);
		РесурсыРасчетаВычетов = РесурсыРасчетаВычетов + ",ПримененныйВычет" + Строка(Выборка.Приоритет)
													  + ",РазрешенныйВычет" + Строка(Выборка.Приоритет); 
	КонецЦикла;
												  
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ВспомогательнаяТаблицаРасчета", ВспомогательнаяТаблицаРасчета);
	СтруктураДанных.Вставить("РезультатыРасчетов", РезультатыРасчетов);
	СтруктураДанных.Вставить("ИзмеренияРасчетаВычетов", ИзмеренияРасчетаВычетов);
	СтруктураДанных.Вставить("РесурсыРасчетаВычетов", РесурсыРасчетаВычетов);
	
	Возврат СтруктураДанных;
	
КонецФункции

Функция ВидыВычетовПоПолямТаблицы(ТаблицаИПН)
	
	МассивВычетов = Новый Массив;
	
	Для Каждого Колонка Из ТаблицаИПН.Колонки Цикл
		Если СтрНайти(Колонка.Имя, "ВидВычета") > 0 Тогда
			МассивВычетов.Добавить(СтрЗаменить(Колонка.Имя, "ВидВычета", ""));			
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивВычетов;
	
КонецФункции

Функция РассчитатьУдержаниеНалоговВзносовПоНУ(МенеджерВременныхТаблиц, Ссылка, Организация, ДатаОперации, ПериодРегистрации = Неопределено, ОкончательныйРасчет = Истина) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ПериодРегистрации",ПериодРегистрации);
	Запрос.УстановитьПараметр("ПериодВзаиморасчетов",КонецМесяца(ПериодРегистрации));
	Запрос.УстановитьПараметр("Организация",Организация);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗарплатаКВыплатеОстатки.Сотрудник КАК Сотрудник,
	|	ЗарплатаКВыплатеОстатки.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ЗарплатаКВыплатеОстатки.Подразделение КАК Подразделение,
	|	ЗарплатаКВыплатеОстатки.ПериодВзаиморасчетов КАК ПериодВзаиморасчетов,
	|	ЗарплатаКВыплатеОстатки.СтатьяФинансирования КАК СтатьяФинансирования,
	|	ЗарплатаКВыплатеОстатки.СтатьяРасходов КАК СтатьяРасходов,
	|	ЗарплатаКВыплатеОстатки.ДокументОснование КАК ДокументОснование,
	|	СУММА(ЗарплатаКВыплатеОстатки.СуммаКВыплатеОстаток) КАК СуммаКВыплате
	|ПОМЕСТИТЬ ВТЗарплатаКВыплатеОстатки
	|ИЗ
	|	РегистрНакопления.ЗарплатаКВыплате.Остатки(
	|			&ПериодВзаиморасчетов,
	|					Организация = &Организация
	|				И Сотрудник В
	|					(ВЫБРАТЬ
	|						T.Сотрудник
	|					ИЗ
	|						ВТСотрудники КАК T)) КАК ЗарплатаКВыплатеОстатки
	//|ГДЕ
	//|	ЗарплатаКВыплатеОстатки.ДокументОснование <> НЕОПРЕДЕЛЕНО
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗарплатаКВыплатеОстатки.Сотрудник,
	|	ЗарплатаКВыплатеОстатки.ФизическоеЛицо,
	|	ЗарплатаКВыплатеОстатки.Подразделение,
	|	ЗарплатаКВыплатеОстатки.ПериодВзаиморасчетов,
	|	ЗарплатаКВыплатеОстатки.СтатьяФинансирования,
	|	ЗарплатаКВыплатеОстатки.СтатьяРасходов,
	|	ЗарплатаКВыплатеОстатки.ДокументОснование
	// добавим полностью выплаченные документы за месяц
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗарплатаКВыплатеОстатки.Сотрудник КАК Сотрудник,
	|	ЗарплатаКВыплатеОстатки.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ЗарплатаКВыплатеОстатки.Подразделение КАК Подразделение,
	|	ЗарплатаКВыплатеОстатки.ПериодВзаиморасчетов КАК ПериодВзаиморасчетов,
	|	ЗарплатаКВыплатеОстатки.СтатьяФинансирования КАК СтатьяФинансирования,
	|	ЗарплатаКВыплатеОстатки.СтатьяРасходов КАК СтатьяРасходов,
	|	ЗарплатаКВыплатеОстатки.ДокументОснование КАК ДокументОснование,
	|	0
	|ИЗ
	|	РегистрНакопления.ЗарплатаКВыплате.Обороты(НАЧАЛОПЕРИОДА(&ПериодВзаиморасчетов, МЕСЯЦ), КОНЕЦПЕРИОДА(&ПериодВзаиморасчетов, МЕСЯЦ), МЕСЯЦ, Организация = &Организация) КАК ЗарплатаКВыплатеОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗарплатаКВыплатеОстатки.Сотрудник,
	|	ЗарплатаКВыплатеОстатки.ФизическоеЛицо,
	|	ЗарплатаКВыплатеОстатки.Подразделение,
	|	ЗарплатаКВыплатеОстатки.ПериодВзаиморасчетов,
	|	ЗарплатаКВыплатеОстатки.СтатьяФинансирования,
	|	ЗарплатаКВыплатеОстатки.СтатьяРасходов,
	|	ЗарплатаКВыплатеОстатки.ДокументОснование
	|
	|ИМЕЮЩИЕ
	|	СУММА(ЗарплатаКВыплатеОстатки.СуммаКВыплатеПриход) - СУММА(ЗарплатаКВыплатеОстатки.СуммаКВыплатеРасход) = 0	
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НачисленияУдержанияПоСотрудникам.ФизическоеЛицо КАК ФизическоеЛицо,
	|	НачисленияУдержанияПоСотрудникам.Регистратор КАК ДокументОснование,
	|	НачисленияУдержанияПоСотрудникам.СтатьяФинансирования КАК СтатьяФинансирования,
	|	НачисленияУдержанияПоСотрудникам.СтатьяРасходов КАК СтатьяРасходов,
	|	СУММА(НачисленияУдержанияПоСотрудникам.Сумма) КАК Сумма
	|ПОМЕСТИТЬ ВТУдержания
	|ИЗ
	|	РегистрНакопления.НачисленияУдержанияПоСотрудникам КАК НачисленияУдержанияПоСотрудникам
	|ГДЕ
	|	НачисленияУдержанияПоСотрудникам.Период <= &ПериодРегистрации
	|	И НачисленияУдержанияПоСотрудникам.Организация = &Организация
	|	И (ТИПЗНАЧЕНИЯ(НачисленияУдержанияПоСотрудникам.НачислениеУдержание) = ТИП(ПланВидовРасчета.Удержания)
	|		ИЛИ НачисленияУдержанияПоСотрудникам.НачислениеУдержание В (
	|			ЗНАЧЕНИЕ(Перечисление.ВидыОсобыхНачисленийИУдержаний.ПогашениеЗаймаИзЗарплаты),
	|			ЗНАЧЕНИЕ(Перечисление.ВидыОсобыхНачисленийИУдержаний.ПроцентыПоЗайму),
	|			ЗНАЧЕНИЕ(Перечисление.ВидыОсобыхНачисленийИУдержаний.НачисленоПроцентовПоЗайму),
	|			ЗНАЧЕНИЕ(Перечисление.ВидыОсобыхНачисленийИУдержаний.МатериальнаяВыгодаПоЗаймам)))
	|	И НачисленияУдержанияПоСотрудникам.Сотрудник В
	|			(ВЫБРАТЬ
	|				Т.Сотрудник
	|			ИЗ
	|				ВТСотрудники КАК Т)
	|	И НачисленияУдержанияПоСотрудникам.Регистратор В
	|			(ВЫБРАТЬ
	|				Т.ДокументОснование
	|			ИЗ
	|				ВТЗарплатаКВыплатеОстатки КАК Т)
	|
	|СГРУППИРОВАТЬ ПО
	|	НачисленияУдержанияПоСотрудникам.ФизическоеЛицо,
	|	НачисленияУдержанияПоСотрудникам.Регистратор,
	|	НачисленияУдержанияПоСотрудникам.СтатьяФинансирования,
	|	НачисленияУдержанияПоСотрудникам.СтатьяРасходов
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ФизическоеЛицо,
	|	ДокументОснование,
	|	СтатьяФинансирования,
	|	СтатьяРасходов
	|;
	
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СведенияОДоходахФизическихЛиц.ФизическоеЛицо КАК ФизическоеЛицо,
	|	СведенияОДоходахФизическихЛиц.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
	|	СведенияОДоходахФизическихЛиц.ПериодРегистрации КАК ПериодРегистрации,
	|	СУММА(СведенияОДоходахФизическихЛиц.СуммаДоходаОборот) КАК Сумма
	|ПОМЕСТИТЬ ВТДоходВНатуральнойФорме
	|ИЗ
	|	РегистрНакопления.СведенияОДоходахФизическихЛиц.Обороты(
	|				НАЧАЛОПЕРИОДА(&ПериодРегистрации,МЕСЯЦ),
	|				КОНЕЦПЕРИОДА(&ПериодРегистрации,МЕСЯЦ),
	|				,
	|				Организация = &Организация
	|				И ФизическоеЛицо В
	|				(ВЫБРАТЬ
	|					Т.ФизическоеЛицо
	|						ИЗ
	|					ВТСотрудники КАК Т)
	|				И ВЫРАЗИТЬ(Начисление КАК ПланВидовРасчета.Начисления).КатегорияНачисленияИлиНеоплаченногоВремени = ЗНАЧЕНИЕ(Перечисление.КатегорииНачисленийИНеоплаченногоВремени.ДоходВНатуральнойФорме)
	|				) КАК СведенияОДоходахФизическихЛиц
	|
	|СГРУППИРОВАТЬ ПО
	|	СведенияОДоходахФизическихЛиц.ФизическоеЛицо,
	|	СведенияОДоходахФизическихЛиц.ПериодРегистрации,
	|	СведенияОДоходахФизическихЛиц.РегистрацияВНалоговомОргане
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ФизическоеЛицо,
	|	ПериодРегистрации,
	|	РегистрацияВНалоговомОргане
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗарплатаКВыплате.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ЗарплатаКВыплате.ДокументОснование КАК ДокументОснование,
	|	ЗарплатаКВыплате.СтатьяФинансирования КАК СтатьяФинансирования,
	|	ЗарплатаКВыплате.СтатьяРасходов КАК СтатьяРасходов,
	|	СУММА(ВЫБОР
	|			КОГДА ЗарплатаКВыплате.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|				ТОГДА ЗарплатаКВыплате.СуммаКВыплате
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СуммаНачисленная,
	|	СУММА(ВЫБОР
	|			КОГДА ЗарплатаКВыплате.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|				ТОГДА ЗарплатаКВыплате.СуммаКВыплате
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СуммаВыплаченная
	|ПОМЕСТИТЬ ВТЗарплатаКВыплате
	|ИЗ
	|	РегистрНакопления.ЗарплатаКВыплате КАК ЗарплатаКВыплате
	|ГДЕ
	|	ЗарплатаКВыплате.Период <= &ПериодРегистрации
	|	И ЗарплатаКВыплате.Организация = &Организация
	|	И ЗарплатаКВыплате.Сотрудник В
	|			(ВЫБРАТЬ
	|				Т.Сотрудник
	|			ИЗ
	|				ВТСотрудники КАК Т)
	|	И ЗарплатаКВыплате.ДокументОснование В
	|			(ВЫБРАТЬ
	|				Т.ДокументОснование
	|			ИЗ
	|				ВТЗарплатаКВыплатеОстатки КАК Т)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗарплатаКВыплате.ФизическоеЛицо,
	|	ЗарплатаКВыплате.ДокументОснование,
	|	ЗарплатаКВыплате.СтатьяФинансирования,
	|	ЗарплатаКВыплате.СтатьяРасходов
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ФизическоеЛицо,
	|	ДокументОснование,
	|	СтатьяФинансирования,
	|	СтатьяРасходов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.ФизическоеЛицо КАК ФизическоеЛицо,
	|	Остатки.ДокументОснование КАК ДокументОснование,
	|	Остатки.СтатьяФинансирования КАК СтатьяФинансирования,
	|	Остатки.СтатьяРасходов КАК СтатьяРасходов,
	|	Остатки.ПериодВзаиморасчетов КАК ПериодВзаиморасчетов,
	|	ЕСТЬNULL(ЗарплатаКВыплате.СуммаНачисленная, 0) + ВЫБОР КОГДА Удержания.Сумма ЕСТЬ NULL ТОГДА 0 ИНАЧЕ Удержания.Сумма КОНЕЦ
	|													+ ВЫБОР КОГДА ДоходВНатуральнойФорме.Сумма ЕСТЬ NULL ТОГДА 0 ИНАЧЕ ДоходВНатуральнойФорме.Сумма КОНЕЦ
	|		КАК СуммаНачисленная,
	|	ЕСТЬNULL(ЗарплатаКВыплате.СуммаВыплаченная, 0) + ВЫБОР КОГДА Удержания.Сумма ЕСТЬ NULL ТОГДА 0 ИНАЧЕ Удержания.Сумма КОНЕЦ 
	|													+ ВЫБОР КОГДА ДоходВНатуральнойФорме.Сумма ЕСТЬ NULL ТОГДА 0 ИНАЧЕ ДоходВНатуральнойФорме.Сумма КОНЕЦ
	|		КАК СуммаВыплаченная
