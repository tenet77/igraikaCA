		|		КОГДА НастройкиВычетов.ПредоставлениеВычета В (ЗНАЧЕНИЕ(Перечисление.ВидыПредоставленияВычетов.Стандартный), ЗНАЧЕНИЕ(Перечисление.ВидыПредоставленияВычетов.ПоПериодическимПлатежам))
		|			ТОГДА НастройкиВычетов.ПределВычета * ВЫБОР
		|					КОГДА НастройкиВычетов.ВидПределаВычета = ЗНАЧЕНИЕ(Перечисление.ВидыПределовВычетовИКорректировокДоходов.МРП)
		|						ТОГДА ЕСТЬNULL(РазмерыМРППоПериодам.РазмерМРПНаНачалоГода, 0)
		|					ИНАЧЕ ЕСТЬNULL(РазмерыМЗППоПериодам.РазмерМЗПНаНачалоГода, 0)
		|				КОНЕЦ
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СуммовойПределВычета
		|ПОМЕСТИТЬ ВТНастройкиИРазмерыВычетов
		|ИЗ
		|	ВТНастойкиВычетов КАК НастройкиВычетов
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТРазмерыВзносов КАК РазмерыВзносов
		|		ПО НастройкиВычетов.МесяцНалоговогоПериода = РазмерыВзносов.МесяцНалоговогоПериода
		|			И НастройкиВычетов.ФизическоеЛицо = РазмерыВзносов.ФизическоеЛицо
		|			И НастройкиВычетов.ВидВзносов = РазмерыВзносов.ВидВзносов
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСтатусыФизическихЛицКакНалогоплательщиков КАК СтатусыФизическихЛицКакНалогоплательщиков
		|		ПО НастройкиВычетов.МесяцНалоговогоПериода = СтатусыФизическихЛицКакНалогоплательщиков.МесяцНалоговогоПериода
		|			И НастройкиВычетов.ФизическоеЛицо = СтатусыФизическихЛицКакНалогоплательщиков.ФизическоеЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТРазмерыМЗППоПериодам КАК РазмерыМЗППоПериодам
		|		ПО НастройкиВычетов.МесяцНалоговогоПериода = РазмерыМЗППоПериодам.МесяцНалоговогоПериода
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТРазмерыМРППоПериодам КАК РазмерыМРППоПериодам
		|		ПО НастройкиВычетов.МесяцНалоговогоПериода = РазмерыМРППоПериодам.МесяцНалоговогоПериода
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТНастройкиВычетовПоВидамДоходаКоличество КАК НастройкиВычетовПоВидамДоходаКоличество
		|		ПО НастройкиВычетов.МесяцНалоговогоПериода = НастройкиВычетовПоВидамДоходаКоличество.МесяцНалоговогоПериода
		|			И НастройкиВычетов.ВидВычета = НастройкиВычетовПоВидамДоходаКоличество.ВидВычета
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТНастройкиВычетовПоВидамДохода КАК НастройкиВычетовПоВидамДохода
		|		ПО НастройкиВычетовПоВидамДоходаКоличество.ВидВычета = НастройкиВычетовПоВидамДохода.ВидВычета
		|			И НастройкиВычетовПоВидамДоходаКоличество.МесяцНалоговогоПериода = НастройкиВычетовПоВидамДохода.МесяцНалоговогоПериода
		// распределение более одного вида дохода у вычета будет происходить при расчете налога
		|			И НастройкиВычетовПоВидамДоходаКоличество.КоличествоВидовДохода = 1
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПрочиеВычетыФизическихЛицИПН КАК ПрочиеВычетыФизическихЛицИПН
		|		ПО НастройкиВычетов.МесяцНалоговогоПериода = ПрочиеВычетыФизическихЛицИПН.МесяцНалоговогоПериода
		|			И НастройкиВычетов.ФизическоеЛицо = ПрочиеВычетыФизическихЛицИПН.ФизическоеЛицо
		|			И НастройкиВычетов.ВидВычета = ПрочиеВычетыФизическихЛицИПН.ВидВычета
		|";
	
	Если ПредоставлятьВычетВМесяцеОтсутствияДохода Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"ВТПериодыПоФизлицам КАК ПериодыПоФизлицам","ВТПериодыПоФизлицамОбъединенная КАК ПериодыПоФизлицам");
	КонецЕсли;
	
	Запрос.Выполнить();
	УничтожитьВТ.Добавить("ВТНастойкиВычетов");
	УничтожитьВТ.Добавить("ВТНастройкиИРазмерыВычетов");
	УничтожитьВТ.Добавить("ВТРазмерыПределовПосле2018");
	УничтожитьВТ.Добавить("ВТНастройкиВычетовПоВидамДоходаКоличество");
		
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастройкиИРазмерыВычетов.МесяцНалоговогоПериода,
		|	НастройкиИРазмерыВычетов.ФизическоеЛицо,
		|	НастройкиИРазмерыВычетов.ВидВычета,
		|	НастройкиИРазмерыВычетов.Приоритет,
		|	НастройкиИРазмерыВычетов.ПредоставлениеВычета,
		|	НастройкиИРазмерыВычетов.ВидВзносов,
		|	НастройкиИРазмерыВычетов.ПределВычета,
		|	НастройкиИРазмерыВычетов.ПериодПредоставления,
		|	НастройкиИРазмерыВычетов.ВидДоходаВзносов,
		|	НастройкиИРазмерыВычетов.ВидДоходаВычета,
		|	НастройкиИРазмерыВычетов.ИспользуетсяПоНесколькимВидамДохода,
		|	НастройкиИРазмерыВычетов.РазмерВычета,
		|	НастройкиИРазмерыВычетов.СуммовойПределВычета,
		|	СУММА(ЕСТЬNULL(НакопленныеДанныеПоВычетам.РазрешенныйВычетВТекущемПериоде, 0)) КАК РазрешенныйВычетВТекущемПериоде,
		|	СУММА(ЕСТЬNULL(НакопленныеДанныеПоВычетам.ПримененныйВычетВТекущемПериоде, 0)) КАК ПримененныйВычетВТекущемПериоде,
		|	СУММА(ЕСТЬNULL(НакопленныеДанныеПоВычетам.РазрешенныйВычетСНачалаГода, 0)) КАК РазрешенныйВычетСНачалаГода,
		|	СУММА(ЕСТЬNULL(НакопленныеДанныеПоВычетам.ПримененныйВычетСНачалаГода, 0) + ЕСТЬNULL(ВычетыПримененныеУДругогоРаботодателя.ПримененныйВычетСНачалаГода, 0)) КАК ПримененныйВычетСНачалаГода,
		|	СУММА(ЕСТЬNULL(НакопленныеДанныеПоВычетам.РазрешенныйВычетСНачалаГодаОтОбратного, 0)) КАК РазрешенныйВычетСНачалаГодаОтОбратного,
		|	СУММА(ЕСТЬNULL(НакопленныеДанныеПоВычетам.ПримененныйВычетСНачалаГодаОтОбратного, 0) + ЕСТЬNULL(ВычетыПримененныеУДругогоРаботодателя.ПримененныйВычетСНачалаГода, 0)) КАК ПримененныйВычетСНачалаГодаОтОбратного
		|ПОМЕСТИТЬ ВТДанныеДляРасчетаВычетовИПН
		|ИЗ
		|	ВТНастройкиИРазмерыВычетов КАК НастройкиИРазмерыВычетов
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТНакопленныеДанныеПоВычетам КАК НакопленныеДанныеПоВычетам
		|		ПО НастройкиИРазмерыВычетов.МесяцНалоговогоПериода = НакопленныеДанныеПоВычетам.МесяцНалоговогоПериода
		|			И НастройкиИРазмерыВычетов.ФизическоеЛицо = НакопленныеДанныеПоВычетам.ФизическоеЛицо
		|			И НастройкиИРазмерыВычетов.ВидВычета = НакопленныеДанныеПоВычетам.ВидВычета
		|			И НастройкиИРазмерыВычетов.МесяцНалоговогоПериода = НакопленныеДанныеПоВычетам.МесяцНалоговогоПериода
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТВычетыПримененныеУДругогоРаботодателя КАК ВычетыПримененныеУДругогоРаботодателя
		|		ПО НастройкиИРазмерыВычетов.МесяцНалоговогоПериода = ВычетыПримененныеУДругогоРаботодателя.МесяцНалоговогоПериода
		|			И НастройкиИРазмерыВычетов.ФизическоеЛицо = ВычетыПримененныеУДругогоРаботодателя.ФизическоеЛицо
		|			И НастройкиИРазмерыВычетов.ВидВычета = ВычетыПримененныеУДругогоРаботодателя.ВидВычета
		|
		|СГРУППИРОВАТЬ ПО
		|	НастройкиИРазмерыВычетов.МесяцНалоговогоПериода,
		|	НастройкиИРазмерыВычетов.ФизическоеЛицо,
		|	НастройкиИРазмерыВычетов.ВидВычета,
		|	НастройкиИРазмерыВычетов.Приоритет,
		|	НастройкиИРазмерыВычетов.ПредоставлениеВычета,
		|	НастройкиИРазмерыВычетов.ВидВзносов,
		|	НастройкиИРазмерыВычетов.ПределВычета,
		|	НастройкиИРазмерыВычетов.ПериодПредоставления,
		|	НастройкиИРазмерыВычетов.ВидДоходаВзносов,
		|	НастройкиИРазмерыВычетов.ВидДоходаВычета,
		|	НастройкиИРазмерыВычетов.ИспользуетсяПоНесколькимВидамДохода,
		|	НастройкиИРазмерыВычетов.РазмерВычета,
		|	НастройкиИРазмерыВычетов.СуммовойПределВычета";
		
	Запрос.Выполнить();
	
	ЗарплатаКадры.УничтожитьВТ(МенеджерВременныхТаблиц, УничтожитьВТ);

КонецПроцедуры

Процедура СоздатьВТДанныеДляРасчетаВычетовИПНДо2021(МенеджерВременныхТаблиц, Организация, ПредоставлятьВычетВМесяцеОтсутствияДохода = Ложь, МесяцНачисления) Экспорт
    
	УничтожитьВТ = Новый Массив;
	
	// если применяется корректировка прочих доходов, то расчет ВОСМС происходит позже расчета ИПН
	ПрименятьКорректировкуПрочихНалоговВзносовОтчислений = ЗарплатаКадрыРКПовтИсп.ПрименятьКорректировкуПрочихНалоговВзносовОтчислений(ЗарплатаКадрыПовтИсп.ГоловнаяОрганизация(Организация), МесяцНачисления);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Организация", Организация);
	
	ПрименятьВычетВОСМСДляФизическихЛиц = ЗарплатаКадрыРКПовтИсп.ПрименятьВычетВОСМСДляФизическихЛицИГПХ(Организация, МесяцНачисления);
	ПрименятьВычетОПВиВОСМСГПХ = ЗарплатаКадрыРКПовтИсп.ПрименятьВычетОПВиВОСМСДляГПХ(Организация, МесяцНачисления);
	
	Если НЕ ВТСуществует(МенеджерВременныхТаблиц, "ВТИсчисленныеОПВ") Тогда
		Запрос.Текст =
			"ВЫБРАТЬ
			|	NULL КАК МесяцНалоговогоПериода,
			|	NULL КАК ФизическоеЛицо,
			|	NULL КАК ВидДохода,
			|	0 КАК ИсчисленныеОПВ
			|ПОМЕСТИТЬ ВТИсчисленныеОПВ";
		Запрос.Выполнить();
	КонецЕсли;
	
	Если НЕ ВТСуществует(МенеджерВременныхТаблиц, "ВТИсчисленныеВОСМС")
		И НЕ ПрименятьКорректировкуПрочихНалоговВзносовОтчислений Тогда
		Запрос.Текст =
			"ВЫБРАТЬ
			|	NULL КАК МесяцНалоговогоПериода,
			|	NULL КАК ФизическоеЛицо,
			|	NULL КАК ВидДохода,
			|	0 КАК ИсчисленныеВОСМС
			|ПОМЕСТИТЬ ВТИсчисленныеВОСМС";
		Запрос.Выполнить();
	КонецЕсли;
	
	// Применение вычетов ИПН
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МАКСИМУМ(ПрименениеВычетовИПН.Период) КАК Период,
		|	ПрименениеВычетовИПН.ФизическоеЛицо,
		|	ПериодыПоФизлицам.МесяцНалоговогоПериода КАК МесяцНалоговогоПериода
		|ПОМЕСТИТЬ ВТПериодыПримененияВычетов
		|ИЗ
		|	ВТПериодыПоФизлицам КАК ПериодыПоФизлицам
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПрименениеВычетовИПН КАК ПрименениеВычетовИПН
		|		ПО ПериодыПоФизлицам.МесяцНалоговогоПериода >= ПрименениеВычетовИПН.Период
		|			И ПериодыПоФизлицам.ФизическоеЛицо = ПрименениеВычетовИПН.ФизическоеЛицо
		|			И (ПрименениеВычетовИПН.Активность)
		|
		|СГРУППИРОВАТЬ ПО
		|	ПрименениеВычетовИПН.ФизическоеЛицо,
		|	ПериодыПоФизлицам.МесяцНалоговогоПериода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТПериодыПримененияВычетов.ФизическоеЛицо,
		|	ВТПериодыПримененияВычетов.МесяцНалоговогоПериода,
		|	ПрименениеВычетовИПН.Организация
		|ПОМЕСТИТЬ ВТПрименениеВычетовИПН
		|ИЗ
		|	ВТПериодыПримененияВычетов КАК ВТПериодыПримененияВычетов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПрименениеВычетовИПН КАК ПрименениеВычетовИПН
		|		ПО ВТПериодыПримененияВычетов.Период = ПрименениеВычетовИПН.Период
		|			И ВТПериодыПримененияВычетов.ФизическоеЛицо = ПрименениеВычетовИПН.ФизическоеЛицо
		|			И (ПрименениеВычетовИПН.Активность)
		|ГДЕ
		|	ПрименениеВычетовИПН.Организация = &Организация";
	
	Если ПредоставлятьВычетВМесяцеОтсутствияДохода Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"ВТПериодыПоФизлицам КАК ПериодыПоФизлицам","ВТПериодыПоФизлицамОбъединенная КАК ПериодыПоФизлицам");
	КонецЕсли;
	
	Запрос.Выполнить();
	УничтожитьВТ.Добавить("ВТПериодыПримененияВычетов");
	УничтожитьВТ.Добавить("ВТПрименениеВычетовИПН");
	
	// Назначенные вычеты ИПН
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МАКСИМУМ(ВычетыФизическихЛицИПН.Период) КАК Период,
		|	ВычетыФизическихЛицИПН.ФизическоеЛицо,
		|	ВычетыФизическихЛицИПН.ВидВычета,
		|	ПериодыПоФизлицам.МесяцНалоговогоПериода КАК МесяцНалоговогоПериода
		|ПОМЕСТИТЬ ВТПериодыВычетовИПН
		|ИЗ
		|	ВТПериодыПоФизлицам КАК ПериодыПоФизлицам
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВычетыФизическихЛицИПН КАК ВычетыФизическихЛицИПН
		|		ПО ПериодыПоФизлицам.МесяцНалоговогоПериода >= ВычетыФизическихЛицИПН.Период
		|			И ПериодыПоФизлицам.ФизическоеЛицо = ВычетыФизическихЛицИПН.ФизическоеЛицо
		|			И (ВычетыФизическихЛицИПН.Активность)
		|ГДЕ
		|	ВычетыФизическихЛицИПН.ВидВычета <> ЗНАЧЕНИЕ(Справочник.ВидыВычетовИПН.ВычетОПВ)
		|	И ВычетыФизическихЛицИПН.ВидВычета <> ЗНАЧЕНИЕ(Справочник.ВидыВычетовИПН.ВычетВОСМС)
		|
		|СГРУППИРОВАТЬ ПО
		|	ВычетыФизическихЛицИПН.ФизическоеЛицо,
		|	ВычетыФизическихЛицИПН.ВидВычета,
		|	ПериодыПоФизлицам.МесяцНалоговогоПериода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТПериодыВычетовИПН.МесяцНалоговогоПериода,
		|	ВТПериодыВычетовИПН.ФизическоеЛицо,
		|	ВТПериодыВычетовИПН.ВидВычета,
		|	ВычетыФизическихЛицИПН.ПредоставлятьВычет,
		|	ВычетыФизическихЛицИПН.ДействуетПо
		|ПОМЕСТИТЬ ВТВычетыФизическихЛицИПН
		|ИЗ
		|	ВТПериодыВычетовИПН КАК ВТПериодыВычетовИПН
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ВычетыФизическихЛицИПН КАК ВычетыФизическихЛицИПН
		|		ПО ВТПериодыВычетовИПН.Период = ВычетыФизическихЛицИПН.Период
		|			И ВТПериодыВычетовИПН.ФизическоеЛицо = ВычетыФизическихЛицИПН.ФизическоеЛицо
		|			И ВТПериодыВычетовИПН.ВидВычета = ВычетыФизическихЛицИПН.ВидВычета
