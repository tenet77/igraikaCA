		|	РанееИсчисленныеНалогиВзносы.НалогВзнос,
		|	РанееИсчисленныеНалогиВзносы.ОбъектИсчисления,
		|	РанееИсчисленныеНалогиВзносы.ПримененныйВычет,
		|	РанееИсчисленныеНалогиВзносы.РазрешенныйВычет,
		|	РанееИсчисленныеНалогиВзносы.ПримененнаяЛьгота,
		|	РанееИсчисленныеНалогиВзносы.ПрочиеВычеты,
		|	РанееИсчисленныеНалогиВзносы.ПримененныйВычетСНачалаГода,
		|	РанееИсчисленныеНалогиВзносы.РазрешенныйВычетСНачалаГода,
		|	РанееИсчисленныеНалогиВзносы.ПримененнаяЛьготаСНачалаГода
		|ПОМЕСТИТЬ ВТИсчисленныеНалогиВзносыПоПодразделениям
		|ИЗ
		|	ВТРанееИсчисленныеНалогиВзносы КАК РанееИсчисленныеНалогиВзносы
		|ГДЕ
		|	РанееИсчисленныеНалогиВзносы.ВидНалогаВзносаОтчисления = &ВидНалогаВзносаОтчисления";
	
	Если ПредоставлятьВычетВМесяцеОтсутствияДохода Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВТРанееИсчисленныеНалогиВзносы КАК РанееИсчисленныеНалогиВзносы", "ВТРанееИсчисленныеНалогиВзносыОбъедененная КАК РанееИсчисленныеНалогиВзносы");
	КонецЕсли;
		
	Запрос.Выполнить();
	
КонецПроцедуры

Функция ПолучитьСпособОкругления(МенеджерВременныхТаблиц, ВидНалогаВзносаОтчисления)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидНалогаВзносаОтчисления", ВидНалогаВзносаОтчисления);
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВТСпособыОкругления.СпособОкругления
		|ИЗ
		|	ВТСпособыОкругления КАК ВТСпособыОкругления
		|ГДЕ
		|	ВТСпособыОкругления.ВидРасчета = &ВидНалогаВзносаОтчисления";
		
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СпособОкругления = Выборка.СпособОкругления;
	Иначе 
		СпособОкругления = Справочники.СпособыОкругленияПриРасчетеЗарплаты.ПоУмолчанию();
	КонецЕсли;
	
	Возврат СпособОкругления;
	
КонецФункции

Функция ПолучитьСпособОкругленияСПериодом(МенеджерВременныхТаблиц, ВидНалогаВзносаОтчисления)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидНалогаВзносаОтчисления", ВидНалогаВзносаОтчисления);
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВТСпособыОкругления.Период,
		|	ВТСпособыОкругления.СпособОкругления
		|ИЗ
		|	ВТСпособыОкругления КАК ВТСпособыОкругления
		|ГДЕ
		|	ВТСпособыОкругления.ВидРасчета = &ВидНалогаВзносаОтчисления";
		
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ДанныеОкругления = Новый Структура("Период, СпособОкругления", Выборка.Период, Выборка.СпособОкругления);
	Иначе 
		ДанныеОкругления = Новый Структура("Период, СпособОкругления", '00010101', Справочники.СпособыОкругленияПриРасчетеЗарплаты.ПоУмолчанию());
	КонецЕсли;
	
	Возврат ДанныеОкругления;
	
КонецФункции

Процедура РаспределитьНалогиВзносыПоПодразделениям(РезультатыРасчетов, СтрокаРаспределения, ДоходыМесяца, РаспределяемыеРесурсы, Точность = 2)
	
	МассивРесурсов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(РаспределяемыеРесурсы);
	КоэффициентыПодразделений = ОбщегоНазначения.ВыгрузитьКолонку(ДоходыМесяца, "ОблагаемыйДоход");    
	СоответствиеРаспределений = Новый Соответствие;
	// типовая БСП процедура в некоторых ситуациях производит округление числа, при отсутствии распределения
	// Например
	// РаспределяемаяСумма 117 569.98 (погрешность -0.02)
	// Коэффициенты (массив из одной строки) 117 569.98
	// Точность 0
	// Типовая возвращает округленное значение 117570
	// При отсутствии распределения округление происходить не должно и должно вернуться число 117 569.98	
	ПроизводитьРаспределение = КоэффициентыПодразделений.Количество() > 1;
	
	Для Каждого Ресурс Из МассивРесурсов Цикл 
		Если СтрокаРаспределения[Ресурс] = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПроизводитьРаспределение Тогда
			РаспределениеРесурса = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(СтрокаРаспределения[Ресурс], КоэффициентыПодразделений, Точность);
		Иначе
			РаспределениеРесурса = Новый Массив;
			РаспределениеРесурса.Добавить(СтрокаРаспределения[Ресурс]);
		КонецЕсли;
		
		Если РаспределениеРесурса = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СоответствиеРаспределений.Вставить(Ресурс, РаспределениеРесурса);
	КонецЦикла;
	
	Если ДоходыМесяца.Количество() > 0 Тогда
		
		Индекс = 0;
		Для Каждого СтрокаДоходы Из ДоходыМесяца Цикл
			НоваяСтрока = РезультатыРасчетов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРаспределения,, РаспределяемыеРесурсы);
			НоваяСтрока.Подразделение = ДоходыМесяца[Индекс].Подразделение;
			НоваяСтрока.ОблагаемыйДоход = СтрокаДоходы.ОблагаемыйДоход;
			НоваяСтрока.НеоблагаемыйДоход = СтрокаДоходы.НеоблагаемыйДоход;
			НоваяСтрока.ОблагаемыйДоходВЦеломЗаПериод = СтрокаДоходы.ОблагаемыйДоход;
			НоваяСтрока.НеоблагаемыйДоходВЦеломЗаПериод = СтрокаДоходы.НеоблагаемыйДоход;
			Для Каждого  Ресурс Из МассивРесурсов Цикл
				РаспределениеРесурса = СоответствиеРаспределений.Получить(Ресурс);
				Если РаспределениеРесурса = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				НоваяСтрока[Ресурс] = РаспределениеРесурса[Индекс];
				НоваяСтрока[Ресурс + "ВЦеломЗаПериод"] = РаспределениеРесурса[Индекс];
			КонецЦикла;
			Индекс = Индекс + 1;
		КонецЦикла;
		
	Иначе
		
		НоваяСтрока = РезультатыРасчетов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРаспределения);
		
	КонецЕсли;
		
КонецПроцедуры

Функция ПолучитьКоэффициентКРаспределениюПоВидуДохода(РаспределениеПоВидамДохода, НастройкиВидовВычетаПоВидамДоходаМесяцаПоВидуВычета, ВидДохода)
	
	// рассчитываем коэффициент, если более одного вида дохода
	Если РаспределениеПоВидамДохода.Количество() < 2 Тогда
		Возврат 1;
	КонецЕсли;
	
	СуммаДоходовВычета = 0;
	
	Для Каждого СтрокаНастроек Из НастройкиВидовВычетаПоВидамДоходаМесяцаПоВидуВычета Цикл
		
		СтрокаСуммы = РаспределениеПоВидамДохода.Найти(СтрокаНастроек.ВидДохода, "ВидДохода");
		
		Если НЕ СтрокаСуммы = Неопределено Тогда
			СуммаДоходовВычета = СуммаДоходовВычета + СтрокаСуммы.ОблагаемыйДоход;
		КонецЕсли;
		
	КонецЦикла;
	
	СтрокаВидаДохода = РаспределениеПоВидамДохода.Найти(ВидДохода, "ВидДохода");
	
	Если СтрокаВидаДохода = Неопределено
		ИЛИ СуммаДоходовВычета = 0 Тогда
		Возврат 1;
	Иначе
		Возврат СтрокаВидаДохода.ОблагаемыйДоход / СуммаДоходовВычета;
	КонецЕсли;
	
КонецФункции

Процедура РаспределитьНалогиВзносыПоПодразделениямИВидуДохода(РезультатыРасчетов, СтрокаРаспределения, ДоходыМесяца, ДоходыПоВидамДохода, РаспределяемыеРесурсы, НастройкиВидовВычетаПоВидамДоходаМесяца, Точность = 2)
	
	// распредилить по подразделению
	МассивРесурсов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(РаспределяемыеРесурсы);
	КоэффициентыПодразделений = ОбщегоНазначения.ВыгрузитьКолонку(ДоходыМесяца, "ОблагаемыйДоход");    
	СоответствиеРаспределений = Новый Соответствие;
	МаксимальныйПриоритет = ЗарплатаКадрыРКПовтИсп.МаксимальныйПриоритетВычетаИПН();
	// типовая БСП процедура в некоторых ситуациях производит округление числа, при отсутствии распределения
	// Например
	// РаспределяемаяСумма 117 569.98 (погрешность -0.02)
	// Коэффициенты (массив из одной строки) 117 569.98
	// Точность 0
	// Типовая возвращает округленное значение 117570
	// При отсутствии распределения округление происходить не должно и должно вернуться число 117 569.98	
	ПроизводитьРаспределение = КоэффициентыПодразделений.Количество() > 1;
	
	Для Каждого Ресурс Из МассивРесурсов Цикл 
		Если СтрокаРаспределения[Ресурс] = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		КоэффициентПоВидуДохода = 1;
		
		ЭтоРесурРазрешенный = СтрНайти(Ресурс, "Разрешенный") > 0;
		
		// применяем коэффициент только для разрешенного вычета
		Если СтрНайти(Ресурс, "Разрешенный") > 0  Тогда
			
			Счетчик = МаксимальныйПриоритет;
			
			Пока Счетчик <> 0 Цикл
				
				Позиция = СтрНайти(Ресурс, Строка(Счетчик));
				
				Если Позиция <> 0 Тогда
					Прервать;
				КонецЕсли;
				
				Счетчик = Счетчик - 1;
				
			КонецЦикла;
			
			Если Счетчик <> 0 Тогда
				Если СтрокаРаспределения["ИспользуетсяПоНесколькимВидамДохода" + Строка(Счетчик)] Тогда
					НастройкиВидовВычетаПоВидамДоходаМесяцаПоВидуВычета = НастройкиВидовВычетаПоВидамДоходаМесяца.Скопировать(Новый Структура("ВидВычета", СтрокаРаспределения["ВидВычета" + Строка(Счетчик)]));
					КоэффициентПоВидуДохода = ПолучитьКоэффициентКРаспределениюПоВидуДохода(ДоходыПоВидамДохода, НастройкиВидовВычетаПоВидамДоходаМесяцаПоВидуВычета, СтрокаРаспределения.ВидДохода);
				Иначе
					КоэффициентПоВидуДохода = 1;
				КонецЕсли;
					
			КонецЕсли;
			
		КонецЕсли;
		
		Если ПроизводитьРаспределение Тогда
			// округлим до одного знака после запятой, уберем погрешность КоэффициентПоВидуДохода
			РаспределениеРесурса = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(СтрокаРаспределения[Ресурс] * КоэффициентПоВидуДохода, КоэффициентыПодразделений, ?(ЭтоРесурРазрешенный И КоэффициентПоВидуДохода > 1, 1, 2));
		Иначе
			РаспределениеРесурса = Новый Массив;
			РаспределениеРесурса.Добавить(СтрокаРаспределения[Ресурс] * КоэффициентПоВидуДохода);
		КонецЕсли;
		
		Если РаспределениеРесурса = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СоответствиеРаспределений.Вставить(Ресурс, РаспределениеРесурса);
	КонецЦикла;
	
	Индекс = 0;
	Для Каждого СтрокаДоходы Из ДоходыМесяца Цикл
		НоваяСтрока = РезультатыРасчетов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРаспределения,, РаспределяемыеРесурсы);
		НоваяСтрока.Подразделение = ДоходыМесяца[Индекс].Подразделение;
		НоваяСтрока.ОблагаемыйДоход = СтрокаДоходы.ОблагаемыйДоход;
		НоваяСтрока.НеоблагаемыйДоход = СтрокаДоходы.НеоблагаемыйДоход;
		НоваяСтрока.ОблагаемыйДоходВЦеломЗаПериод = СтрокаДоходы.ОблагаемыйДоход;
		НоваяСтрока.НеоблагаемыйДоходВЦеломЗаПериод = СтрокаДоходы.НеоблагаемыйДоход;
		Для Каждого  Ресурс Из МассивРесурсов Цикл
			РаспределениеРесурса = СоответствиеРаспределений.Получить(Ресурс);
			Если РаспределениеРесурса = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока[Ресурс] = РаспределениеРесурса[Индекс];
			НоваяСтрока[Ресурс + "ВЦеломЗаПериод"] = РаспределениеРесурса[Индекс];
		КонецЦикла;
		Индекс = Индекс + 1;
	КонецЦикла;
	
КонецПроцедуры


