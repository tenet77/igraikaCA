// Универсальные функции и процедуры

Процедура СоздатьВТДоходы(МенеджерВременныхТаблиц, ВидНалогаВзносаОтчисления, ИмяВТИсключаемыеЛица = Неопределено, ИсключаемыеЛицаУдалитьСвязьПоПериоду = Истина)
	
	УничтожитьВТ = Новый Массив;
	
	Если ИмяВТИсключаемыеЛица = Неопределено Тогда
		ИмяВТИсключаемыеЛица = 
			"(ВЫБРАТЬ
			|	NULL КАК ФизическоеЛицо)";
	КонецЕсли;
	
	// Облагаемые и необлагаемые доходы 
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	НалогообложениеНачислений.МесяцНалоговогоПериода,
		|	НалогообложениеНачислений.Начисление,
		|	НалогообложениеНачислений.ВидДохода,
		|	ВЫБОР
		|		КОГДА &ВидНалогаВзносаОтчисления = ЗНАЧЕНИЕ(Перечисление.ВидыНалоговВзносовОтчислений.ОПВ)
		|			ТОГДА НалогообложениеНачислений.СпособОбложенияОПВ
		|		КОГДА &ВидНалогаВзносаОтчисления = ЗНАЧЕНИЕ(Перечисление.ВидыНалоговВзносовОтчислений.ИПН)
		|			ТОГДА НалогообложениеНачислений.СпособОбложенияИПН
		|		КОГДА &ВидНалогаВзносаОтчисления = ЗНАЧЕНИЕ(Перечисление.ВидыНалоговВзносовОтчислений.СО)
		|			ТОГДА НалогообложениеНачислений.СпособОбложенияСО
		|		КОГДА &ВидНалогаВзносаОтчисления = ЗНАЧЕНИЕ(Перечисление.ВидыНалоговВзносовОтчислений.СН)
		|			ТОГДА НалогообложениеНачислений.СпособОбложенияСН
		|		КОГДА &ВидНалогаВзносаОтчисления = ЗНАЧЕНИЕ(Перечисление.ВидыНалоговВзносовОтчислений.ОППВ)
		|			ТОГДА НалогообложениеНачислений.СпособОбложенияОППВ
		|		КОГДА &ВидНалогаВзносаОтчисления = ЗНАЧЕНИЕ(Перечисление.ВидыНалоговВзносовОтчислений.ВОСМС)
		|			ТОГДА НалогообложениеНачислений.СпособОбложенияВОСМС
		|		КОГДА &ВидНалогаВзносаОтчисления = ЗНАЧЕНИЕ(Перечисление.ВидыНалоговВзносовОтчислений.ООСМС)
		|			ТОГДА НалогообложениеНачислений.СпособОбложенияООСМС
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СпособыНалогообложенияДоходов.ПустаяСсылка)
		|	КОНЕЦ КАК СпособОбложения,
		|	ВЫБОР
		|		КОГДА &ВидНалогаВзносаОтчисления = ЗНАЧЕНИЕ(Перечисление.ВидыНалоговВзносовОтчислений.ОПВ)
		|			ТОГДА НалогообложениеНачислений.ДоходНеПодлежащийНалогообложениюОПВ
		|		КОГДА &ВидНалогаВзносаОтчисления = ЗНАЧЕНИЕ(Перечисление.ВидыНалоговВзносовОтчислений.ИПН)
		|			ТОГДА НалогообложениеНачислений.ДоходНеПодлежащийНалогообложениюИПН
		|		КОГДА &ВидНалогаВзносаОтчисления = ЗНАЧЕНИЕ(Перечисление.ВидыНалоговВзносовОтчислений.СО)
		|			ТОГДА НалогообложениеНачислений.ДоходНеПодлежащийНалогообложениюСО
		|		КОГДА &ВидНалогаВзносаОтчисления = ЗНАЧЕНИЕ(Перечисление.ВидыНалоговВзносовОтчислений.СН)
		|			ТОГДА НалогообложениеНачислений.ДоходНеПодлежащийНалогообложениюСН
		|		КОГДА &ВидНалогаВзносаОтчисления = ЗНАЧЕНИЕ(Перечисление.ВидыНалоговВзносовОтчислений.ОППВ)
		|			ТОГДА НалогообложениеНачислений.ДоходНеПодлежащийНалогообложениюОППВ
		|		КОГДА &ВидНалогаВзносаОтчисления = ЗНАЧЕНИЕ(Перечисление.ВидыНалоговВзносовОтчислений.ВОСМС)
		|			ТОГДА НалогообложениеНачислений.ДоходНеПодлежащийНалогообложениюВОСМС
		|		КОГДА &ВидНалогаВзносаОтчисления = ЗНАЧЕНИЕ(Перечисление.ВидыНалоговВзносовОтчислений.ООСМС)
		|			ТОГДА НалогообложениеНачислений.ДоходНеПодлежащийНалогообложениюООСМС
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ДоходыНеПодлежащиеНалогообложениюЧастично.ПустаяСсылка)
		|	КОНЕЦ КАК ДоходНеПодлежащийНалогообложению
		|ПОМЕСТИТЬ ВТНалогообложениеНачисленийПоВидуНалогаВзноса
		|ИЗ
		|	ВТНалогообложениеНачислений КАК НалогообложениеНачислений
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НалогобложениеНачислений.МесяцНалоговогоПериода,
		|	СведенияОДоходах.Подразделение,
		|	СведенияОДоходах.ФизическоеЛицо,
		|	НалогобложениеНачислений.ВидДохода,
		|	СУММА(СведенияОДоходах.СуммаДохода) КАК СуммаДохода,
		|	СУММА(ВЫБОР
		|			КОГДА НалогобложениеНачислений.СпособОбложения = ЗНАЧЕНИЕ(Перечисление.СпособыНалогообложенияДоходов.ОблагаетсяЦеликом)
		|					ИЛИ НалогобложениеНачислений.СпособОбложения = ЗНАЧЕНИЕ(Перечисление.СпособыНалогообложенияДоходов.НеОблагаетсяЧастично)
		|				ТОГДА СведенияОДоходах.СуммаДохода
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК ОблагаемыйДоход,
		|	СУММА(ВЫБОР
		|			КОГДА НалогобложениеНачислений.СпособОбложения = ЗНАЧЕНИЕ(Перечисление.СпособыНалогообложенияДоходов.НеОблагаетсяЦеликом)
		|				ТОГДА СведенияОДоходах.СуммаДохода
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК НеоблагаемыйДоход
		|ПОМЕСТИТЬ ВТДоходыПоПодразделениям
		|ИЗ
		|	ВТСведенияОДоходах КАК СведенияОДоходах
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТНалогообложениеНачисленийПоВидуНалогаВзноса КАК НалогобложениеНачислений
		|		ПО СведенияОДоходах.Начисление = НалогобложениеНачислений.Начисление
		|			И СведенияОДоходах.МесяцНалоговогоПериода = НалогобложениеНачислений.МесяцНалоговогоПериода
		|		ЛЕВОЕ СОЕДИНЕНИЕ #ВТИсключаемыеЛица КАК ИсключаемыеЛица
		|		ПО СведенияОДоходах.ФизическоеЛицо = ИсключаемыеЛица.ФизическоеЛицо
		|			И (ВЫБОР
		|				КОГДА ИсключаемыеЛица.МесяцНалоговогоПериода = ДАТАВРЕМЯ(1, 1, 1)
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ СведенияОДоходах.МесяцНалоговогоПериода = ИсключаемыеЛица.МесяцНалоговогоПериода
		|			КОНЕЦ)
		|ГДЕ
		|	ИсключаемыеЛица.ФизическоеЛицо ЕСТЬ NULL 
		|
		|СГРУППИРОВАТЬ ПО
		|	НалогобложениеНачислений.МесяцНалоговогоПериода,
		|	СведенияОДоходах.Подразделение,
		|	СведенияОДоходах.ФизическоеЛицо,
		|	НалогобложениеНачислений.ВидДохода
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СведенияОНеоблагаемыхДоходах.МесяцНалоговогоПериода,
		|	СведенияОНеоблагаемыхДоходах.Подразделение,
		|	СведенияОНеоблагаемыхДоходах.ФизическоеЛицо,
		|	НалогобложениеНачислений.ВидДохода,
		|	0,
		|	-СведенияОНеоблагаемыхДоходах.НеоблагаемыйДоход,
		|	СведенияОНеоблагаемыхДоходах.НеоблагаемыйДоход
		|ИЗ
		|	ВТСведенияОНеоблагаемыхДоходах КАК СведенияОНеоблагаемыхДоходах
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТНалогообложениеНачисленийПоВидуНалогаВзноса КАК НалогобложениеНачислений
		|		ПО СведенияОНеоблагаемыхДоходах.Начисление = НалогобложениеНачислений.Начисление
		|			И СведенияОНеоблагаемыхДоходах.МесяцНалоговогоПериода = НалогобложениеНачислений.МесяцНалоговогоПериода
		|		ЛЕВОЕ СОЕДИНЕНИЕ #ВТИсключаемыеЛица КАК ИсключаемыеЛица
		|		ПО СведенияОНеоблагаемыхДоходах.ФизическоеЛицо = ИсключаемыеЛица.ФизическоеЛицо
		|			И (ВЫБОР
		|				КОГДА ИсключаемыеЛица.МесяцНалоговогоПериода = ДАТАВРЕМЯ(1, 1, 1)
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ СведенияОНеоблагаемыхДоходах.МесяцНалоговогоПериода = ИсключаемыеЛица.МесяцНалоговогоПериода
		|			КОНЕЦ)
		|ГДЕ
		|	СведенияОНеоблагаемыхДоходах.ВидНалогаВзносаОтчисления = &ВидНалогаВзносаОтчисления	
		|	И ИсключаемыеЛица.ФизическоеЛицо ЕСТЬ NULL 
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДоходыФизическихЛиц.МесяцНалоговогоПериода,
		|	ДоходыФизическихЛиц.ФизическоеЛицо,
		|	ДоходыФизическихЛиц.ВидДохода,
		|	СУММА(ДоходыФизическихЛиц.СуммаДохода) КАК СуммаДохода,
		|	СУММА(ДоходыФизическихЛиц.ОблагаемыйДоход) КАК ОблагаемыйДоход,
		|	СУММА(ДоходыФизическихЛиц.НеоблагаемыйДоход) КАК НеоблагаемыйДоход
		|ПОМЕСТИТЬ ВТДоходы
		|ИЗ
		|	ВТДоходыПоПодразделениям КАК ДоходыФизическихЛиц
		|
		|СГРУППИРОВАТЬ ПО
		|	ДоходыФизическихЛиц.МесяцНалоговогоПериода,
		|	ДоходыФизическихЛиц.ФизическоеЛицо,
		|	ДоходыФизическихЛиц.ВидДохода";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ВТИсключаемыеЛица", ИмяВТИсключаемыеЛица);
	Если ИсключаемыеЛицаУдалитьСвязьПоПериоду Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, 
					"И (ВЫБОР
					|				КОГДА ИсключаемыеЛица.МесяцНалоговогоПериода = ДАТАВРЕМЯ(1, 1, 1)
					|					ТОГДА ИСТИНА
					|				ИНАЧЕ СведенияОДоходах.МесяцНалоговогоПериода = ИсключаемыеЛица.МесяцНалоговогоПериода
					|			КОНЕЦ)", "");	
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, 
					"И (ВЫБОР
					|				КОГДА ИсключаемыеЛица.МесяцНалоговогоПериода = ДАТАВРЕМЯ(1, 1, 1)
					|					ТОГДА ИСТИНА
					|				ИНАЧЕ СведенияОНеоблагаемыхДоходах.МесяцНалоговогоПериода = ИсключаемыеЛица.МесяцНалоговогоПериода
					|			КОНЕЦ)", "");	
	КонецЕсли;
		
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ВидНалогаВзносаОтчисления", ВидНалогаВзносаОтчисления);
	Запрос.Выполнить();	
	УничтожитьВТ.Добавить("ВТНалогообложениеНачисленийПоВидуНалогаВзноса");
	
	ЗарплатаКадры.УничтожитьВТ(МенеджерВременныхТаблиц, УничтожитьВТ);
	
КонецПроцедуры

Процедура СоздатьВТИсчисленныеНалогиВзносыПоПодразделениям(МенеджерВременныхТаблиц, ВидНалогаВзносаОтчисления, ПредоставлятьВычетВМесяцеОтсутствияДохода = Ложь)

