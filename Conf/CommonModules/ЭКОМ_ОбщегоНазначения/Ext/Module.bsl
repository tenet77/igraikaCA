Функция ЭтоПоддерживаемыйАлгоритмПодписи(Алгоритм) Экспорт
    Если ЗначениеЗаполнено(Алгоритм) = Ложь Тогда //при не заполненном алгоритме считаю что он поддерживается (это бывает в случае не выбранного алгоритма на форме ВсеСертификаты)
        Возврат Истина;
    КонецЕсли;
    ВсеАлгоритмы = ВсеАлгоритмыПодписей();
    Результат = ?(ВсеАлгоритмы.Найти(Алгоритм) = Неопределено, Ложь, Истина);
    
    Возврат Результат;
КонецФункции //ЭтоПоддерживаемыйАлгоритмПодписи()

Функция ЭЦП_ПараметрыМенеджераКриптографииПоАлгоритмуПодписи(АлгоритмПодписи) Экспорт
    
	Результат = Новый Структура;
	Результат.Вставить("АлгоритмПодписи"       , "");
	Результат.Вставить("ИмяМодуляКриптографии" , "");
	Результат.Вставить("ПутьМодуляКриптографии", "");
	Результат.Вставить("ТипМодуляКриптографии" , "");
	
	СистемнаяИнформация = Новый СистемнаяИнформация;	
	ЭтоLinuxКлиент = СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86 
	ИЛИ СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86_64;
	
	Если ЭтоLinuxКлиент Тогда 		
		ПутьМодуляКриптографии = "/opt/cprocsp/lib/amd64/libcapilite.so:/opt/cprocsp/lib/amd64/libcapi10.so:/opt/cprocsp/lib/amd64/libcapi20.so"; // Linux		
	    ИмяМодуляКриптографии2001 = "";
		ИмяМодуляКриптографии2012 = "";	
	Иначе
		ПутьМодуляКриптографии = "";  // Windows
		ИмяМодуляКриптографии2001 = "Crypto-Pro GOST R 34.10-2001 Cryptographic Service Provider";
		ИмяМодуляКриптографии2012 = "Crypto-Pro GOST R 34.10-2012 Cryptographic Service Provider";
	КонецЕсли;

	Если АлгоритмПодписи = "ГОСТ Р 34.10-2001" 
		ИЛИ АлгоритмПодписи = "GOST R 34.10-2001" Тогда
		
		Результат.Вставить("АлгоритмПодписи"       , "ГОСТ Р 34.10-2001");
		Результат.Вставить("ИмяМодуляКриптографии" , ИмяМодуляКриптографии2001);
		Результат.Вставить("ПутьМодуляКриптографии", ПутьМодуляКриптографии);
		Результат.Вставить("ТипМодуляКриптографии" , 75);
		
	ИначеЕсли АлгоритмПодписи = "ГОСТ Р 34.10-2012 256 бит" 
		ИЛИ АлгоритмПодписи = "ГОСТ Р 34.10-2012/256" 
		ИЛИ АлгоритмПодписи = "GOST R 34.10-2012 256 bit" 
		ИЛИ АлгоритмПодписи = "GOST R 34.10-2012/256" Тогда
		
		Результат.Вставить("АлгоритмПодписи"       , "ГОСТ Р 34.10-2012 256 бит");
		Результат.Вставить("ИмяМодуляКриптографии" , ИмяМодуляКриптографии2012);
		Результат.Вставить("ПутьМодуляКриптографии", ПутьМодуляКриптографии);
		Результат.Вставить("ТипМодуляКриптографии" , 80);

	ИначеЕсли АлгоритмПодписи = "ГОСТ Р 34.10-2012 512 бит" 
		ИЛИ АлгоритмПодписи = "ГОСТ Р 34.10-2012/512" 
		ИЛИ АлгоритмПодписи = "GOST R 34.10-2012 512 bit" 
		ИЛИ АлгоритмПодписи = "GOST R 34.10-2012/512" Тогда
		
		Результат.Вставить("АлгоритмПодписи"       , "ГОСТ Р 34.10-2012 512 бит");
