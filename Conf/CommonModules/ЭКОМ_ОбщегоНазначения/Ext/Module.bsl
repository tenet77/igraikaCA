Функция ЭЦП_ЗаполнитьСтруктуруСертификата(Сертификат, АлгоритмПодписи, МассивЛогаСобытий, ПустойАлгоритмПодписиЕслиНетБиблиотеки = Истина) Экспорт
	
    КомуВыдан = ЭЦП_ПолучитьПредставлениеПользователя(Сертификат.Субъект);
    КемВыдан  = ЭЦП_ПолучитьПредставлениеПользователя(Сертификат.Издатель);
    ДействителенДо = Сертификат.ДатаОкончания;
     
    ОтпечатокСертификата = Base64Строка(Сертификат.Отпечаток);
	
	ЭЦП_ЗаменитьНедопустимыеСимволы(КомуВыдан);
    ЭЦП_ЗаменитьНедопустимыеСимволы(КемВыдан);

    ИНН = "";
	Сертификат.Субъект.Свойство("OID1_2_643_100_4", ИНН);
	Если ИНН = Неопределено Тогда
		Сертификат.Субъект.Свойство("OID1_2_643_3_131_1_1", ИНН);
	КонецЕсли;
	ИНН_Число = ЭКОМ_ПреобразоватьВЧислоОбщегоНазначения(ИНН); 
	
	ДолжностьПодписанта = "";
	Сертификат.Субъект.Свойство("T", ДолжностьПодписанта);
	
	ФамилияПодписанта = "";
	Сертификат.Субъект.Свойство("SN", ФамилияПодписанта);
	
	ИмяОтчествоПодписанта = "";
	Сертификат.Субъект.Свойство("OID2_5_4_42", ИмяОтчествоПодписанта);
	ПерваяПозиция      = Найти(ИмяОтчествоПодписанта, " "); 
    ИмяПодписанта      = Лев(ИмяОтчествоПодписанта, ПерваяПозиция - 1);
	ОтчествоПодписанта = Прав(ИмяОтчествоПодписанта, СтрДлина(ИмяОтчествоПодписанта) - ПерваяПозиция);
	
	ИмяСертификата = Формат(ДействителенДо,"ДФ=dd.MM.yyyy") + " " + КомуВыдан;
	
	ИНН_Строка = Формат(ИНН_Число, "ЧГ=0");
	ЭЦП_ЗаменитьНедопустимыеСимволы(ИНН_Строка);
	ЭЦП_ЗаменитьНедопустимыеСимволы(ДолжностьПодписанта);
	ЭЦП_ЗаменитьНедопустимыеСимволы(ФамилияПодписанта);
	ЭЦП_ЗаменитьНедопустимыеСимволы(ИмяПодписанта);
	ЭЦП_ЗаменитьНедопустимыеСимволы(ОтчествоПодписанта);
	ЭЦП_ЗаменитьНедопустимыеСимволы(ОтпечатокСертификата);
	ЭЦП_ЗаменитьНедопустимыеСимволы(ИмяСертификата);
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("КомуВыдан"              , КомуВыдан);
	СтруктураДанных.Вставить("КемВыдан"               , КемВыдан);
	СтруктураДанных.Вставить("ДействителенДо"         , ДействителенДо);
	СтруктураДанных.Вставить("ИНН"                    , ИНН_Строка);	
	СтруктураДанных.Вставить("ДолжностьПодписанта"     , ДолжностьПодписанта);
	СтруктураДанных.Вставить("ФамилияПодписанта"       , ФамилияПодписанта);
	СтруктураДанных.Вставить("ИмяПодписанта"           , ИмяПодписанта);
	СтруктураДанных.Вставить("ОтчествоПодписанта"      , ОтчествоПодписанта);   
	СтруктураДанных.Вставить("ОтпечатокСертификата"    , ОтпечатокСертификата);    
	СтруктураДанных.Вставить("ИмяСертификата"          , ИмяСертификата);
    
    ИздательСертификата = "";
    Если Сертификат.Издатель.Свойство("O", ИздательСертификата) = Ложь Тогда
        Сертификат.Издатель.Свойство("CN", ИздательСертификата);
    КонецЕсли;
    
    СтруктураДанных.Вставить("ИздательСертификата", ИздательСертификата);	
    СтруктураДанных.Вставить("АлгоритмПодписи"    , АлгоритмПодписи);
    СтруктураДанных.Вставить("СертификатОтпечаток", Сертификат.Отпечаток);
    
	Возврат СтруктураДанных;
КонецФункции

Функция ЭЦП_ПолучитьПредставлениеПользователя(СтруктураПользователя) Экспорт
    
    Представление = "";
    CN = "";
    Если СтруктураПользователя.Свойство("CN", CN) Тогда
        Представление = Представление + CN;
    КонецЕсли;	
    O = "";
    Если СтруктураПользователя.Свойство("O", O) Тогда
        Представление = Представление + ", " + O;
    КонецЕсли;	
    OU = "";
    Если СтруктураПользователя.Свойство("OU", OU) Тогда
        Представление = Представление + ", " + OU;
    КонецЕсли;	
    
    Возврат Представление;
    
КонецФункции

