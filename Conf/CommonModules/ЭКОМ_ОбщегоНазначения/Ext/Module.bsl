Функция РазложитьСтрокуВМассивПодстрок(Знач Строка, Знач Разделитель = ",", Знач ПропускатьПустыеСтроки = Неопределено) Экспорт
 
    Результат = Новый Массив;
 
    // для обеспечения обратной совместимости
    Если ПропускатьПустыеСтроки = Неопределено Тогда
        ПропускатьПустыеСтроки = ?(Разделитель = " ", Истина, Ложь);
        Если ПустаяСтрока(Строка) Тогда 
            Если Разделитель = " " Тогда
                Результат.Добавить("");
            КонецЕсли;
            Возврат Результат;
        КонецЕсли;
    КонецЕсли;
 
    Позиция = Найти(Строка, Разделитель);
    Пока Позиция > 0 Цикл
        Подстрока = Лев(Строка, Позиция - 1);
        Если Не ПропускатьПустыеСтроки Или Не ПустаяСтрока(Подстрока) Тогда
            Результат.Добавить(Подстрока);
        КонецЕсли;
        Строка = Сред(Строка, Позиция + СтрДлина(Разделитель));
        Позиция = Найти(Строка, Разделитель);
    КонецЦикла;
 
    Если Не ПропускатьПустыеСтроки Или Не ПустаяСтрока(Строка) Тогда
        Результат.Добавить(Строка);
    КонецЕсли;
 
    Возврат Результат;
 
КонецФункции

Функция ОбъектВнешнейКомпонентыXMLDSig(МассивЛогаСобытий) Экспорт
	
	ИмяСобытия = "Объект внешней компоненты";
	ОбъектКомпоненты = Неопределено;
	Если ПодключитьВнешнююКомпоненту("Справочник.ЭКОМ_Сертификаты.Макет.КомпонентаXMLDSIG", "XMLDSignAddInSymbolicName", ТипВнешнейКомпоненты.Native) Тогда
        Попытка
            ОбъектКомпоненты = Новый("AddIn.XMLDSignAddInSymbolicName.XMLDSignAddIn");
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
            ТекстЛогаСобытий = "Не удалось подключить внешнюю компоненту XMLDSig.";
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
        КонецПопытки;        
    КонецЕсли;
	
	Если ОбъектКомпоненты = Неопределено Тогда ;
		ТекстЛогаСобытий = "Оператор Новый вернул Неопределено";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
	Иначе
		ОбъектКомпоненты.ПутьККриптопровайдеру = "";
	КонецЕсли;
	    
    Возврат ОбъектКомпоненты;
КонецФункции 

Функция РезультатCMSSign(ОбъектКомпоненты, ДанныеДляПодписания, ПараметрыКомпоненты, СертификатКриптографии, ПарольДоступаКЗакрытомуКлючу, МассивЛогаСобытий) Экспорт
	
	ИмяСобытия = "Объект внешней компоненты CMSSign";

	АтрибутSignatureValue = Неопределено;
	Попытка
		АтрибутSignatureValue = ОбъектКомпоненты.CMSSign(
			ДанныеДляПодписания,
			СертификатКриптографииBase64(СертификатКриптографии.Выгрузить()),
			ПарольДоступаКЗакрытомуКлючу,
			ПараметрыКомпоненты.ТипПодписи,
			ПараметрыКомпоненты.Открепленная,
			ПараметрыКомпоненты.ВключениеСертификатовВПодпись);
	Исключение
		ТекстЛогаСобытий = "Ошибка вызова метода CMSSign компоненты XMLDSig." + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

	КонецПопытки;
	
	Если НЕ ЗначениеЗаполнено(АтрибутSignatureValue) Тогда
		ТекстЛогаСобытий = "Ошибка вызова метода CMSSign компоненты XMLDSig." + Символы.ПС + ОбъектКомпоненты.GetLastError();
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

	КонецЕсли;
	
	Возврат АтрибутSignatureValue;
	
КонецФункции

