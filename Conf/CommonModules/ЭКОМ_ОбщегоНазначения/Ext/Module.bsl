КонецФункции

Функция ДокументыСписокВыбораПолучить(ТипСписка = "", МассивИменДокументов = Неопределено, Значение = Неопределено) Экспорт

	// Используется для формирования имени файла гибких настроек
	СоответствиеТипуОперации = ПолучитьТипыОпераций(ТипСписка);
    Результат = Новый Массив;
	Для каждого СтрСоответствия Из СоответствиеТипуОперации Цикл
		Результат.Добавить(СтрСоответствия.Ключ);
	КонецЦикла;

    Если ТипСписка = "ТабличныеЧасти" Тогда
        
        Результат.Добавить("");
        Результат.Добавить("Товары");
        Результат.Добавить("Сырье");    
        
    ИначеЕсли ТипСписка = "СвойАлгоритм" Тогда
        
        Результат.Добавить("");
        Результат.Добавить("<Свой алгоритм>");
        
    ИначеЕсли ТипСписка = "ТабличныеЧастиАлгоритм" Тогда
        
        Результат.Добавить("");
        Результат.Добавить("<Свой алгоритм>");
        
    ИначеЕсли ТипСписка = "ОсновнойАлгоритм" Тогда
		
		Если ТипЗнч(МассивИменДокументов) = Тип("Массив") Тогда
			
			Если МассивИменДокументов.Количество() = 1 Тогда
				
				Для Каждого Реквизит Из Метаданные.Документы.Найти(МассивИменДокументов[0]).Реквизиты Цикл
					Результат.Добавить(Реквизит.Синоним + " (" + Реквизит.Имя + ")");
				КонецЦикла;
				
				// Добавим стандартные реквизиты.
				Результат.Добавить("Ссылка (Ссылка)");
				Результат.Добавить("Номер (Номер)");
				Результат.Добавить("Дата (Дата)");
				Результат.Добавить("Проведен (Проведен)");
				Результат.Добавить("Пометка удаления (ПометкаУдаления)");
				
			ИначеЕсли МассивИменДокументов.Количество() = 2 Тогда
				
				Для Каждого Реквизит Из Метаданные.Документы.Найти(МассивИменДокументов[1]).ТабличныеЧасти.Найти(МассивИменДокументов[0]).Реквизиты Цикл
					Результат.Добавить(Реквизит.Синоним + " (" + Реквизит.Имя + ")");
				КонецЦикла;
				                                 
				// Добавим стандартные реквизиты.
				Результат.Добавить("Ссылка (Ссылка)");
				Результат.Добавить("Номер строки (НомерСтроки)");
				
			КонецЕсли;
			
		КонецЕсли;
		
		Результат = СортировкаМассива(Результат);
		//Результат.Вставить(0, "<Свой алгоритм>"); // Открытие будет происходить по нажатию кнопки Открыть
		//Результат.Вставить(1, "_______________");
		
		Если ЗначениеЗаполнено(Значение) Тогда
			Результат.Добавить("_______________");
			Результат.Добавить(Значение);
		КонецЕсли;
		
    ИначеЕсли ТипСписка = "Документы" ИЛИ ТипСписка = "Справочники" Тогда
        
        Результат = ПолучитьСписокВыбораИзИменМетаданных(ТипСписка);
        
    ИначеЕсли ТипСписка = "РеквизитыДокументов" И ТипЗнч(МассивИменДокументов) = Тип("Массив") Тогда
        
        НовыйМассив = Новый Массив;
        Для каждого ИмяДокумента Из МассивИменДокументов Цикл
        
        	 СтандартныеРеквизитыДокумента = Метаданные.Документы[ИмяДокумента].СтандартныеРеквизиты;
             РеквизитыДокумента            = Метаданные.Документы[ИмяДокумента].Реквизиты;
                          
             Для каждого СРД Из СтандартныеРеквизитыДокумента Цикл
                 Если НовыйМассив.Найти(СРД.Имя) <> Неопределено Тогда
                     Продолжить; 
                 КонецЕсли;
                 НовыйМассив.Добавить(СРД.Имя);
             КонецЦикла;             
             
             Для каждого РД Из РеквизитыДокумента Цикл
                 Если НовыйМассив.Найти(РД.Имя) <> Неопределено Тогда
                     Продолжить; 
                 КонецЕсли;
                 НовыйМассив.Добавить(РД.Имя);
             КонецЦикла;
             
        КонецЦикла;
        Результат = НовыйМассив;
        
    КонецЕсли;
    
    Возврат Результат;
    
КонецФункции // ДокументыСписокВыбораПолучить()

Функция ПолучитьСписокВыбораИзИменМетаданных(ТипМД) Экспорт
	
	Результат = Новый Массив;
	
	Если ТипМД = "Документы" Тогда
