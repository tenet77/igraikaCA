//
// Параметры:
//	ИмяРегистра - Строка, имя регистра сведений, в котором осуществляется проверка
//
//  Поля   - Строка, имена полей через запятую, значения которых необходимо получить.
//
//  Отборы - Структура
//		     Ключи элементов структуры содержат имена полей отбора РС ЦепочкиДокументовПоставщиков;
//			 Значения элементов структуры содержат значения параметров для отбора к соответствующему ключу.
//
// Возвращаемое значение:
//  Структура - содержит ключ "Успешно" с типом булево, который фиксирует результат выполнения функции;
//			  - в случае, если "Успешно" - Истина, содержит имена (ключи) и значения затребованных полей.
Функция ПолучитьПоляЦепочкиДокументов(ИмяРегистра, Поля, Отборы) Экспорт 
	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	
	Если ИмяРегистра = Метаданные.РегистрыСведений.ЭКОМ_ЦепочкиДокументовПокупателя.Имя 
		ИЛИ ИмяРегистра = Метаданные.РегистрыСведений.ЭКОМ_ЦепочкиДокументовПоставщика.Имя Тогда
		
		МассивПолей = Эком_РазложитьСтрокуВМассивПодстрок(Поля, ",", Истина, Истина);
		
		ПроверкаПройдена = ЕстьПоляВРегистреСведенийЭКОМ(ИмяРегистра, МассивПолей, Отборы);
		Если ПроверкаПройдена Тогда
			
			Запрос = ЗапросКРегиструЭКОМ(ИмяРегистра, МассивПолей, Отборы);	
			
			Попытка
				РезультатЗапроса = Запрос.Выполнить();
				Если Не РезультатЗапроса.Пустой() Тогда   	
					Выборка = РезультатЗапроса.Выбрать();
					Выборка.Следующий();
					Для Каждого Элемент Из МассивПолей Цикл
						Результат.Вставить(Элемент, Выборка[Элемент]);
					КонецЦикла;
					Результат.Успешно = Истина; 					
				КонецЕсли; // результат запроса
			Исключение
				ТекстОшибки = ОписаниеОшибки();	
			КонецПопытки;
			
		КонецЕсли; // наличие полей метаданных
	КонецЕсли; // соответствие имени регистра
	
	Возврат Результат;		
КонецФункции

// Возвращает булево значение по результатам проверки наличия полей в метаданных регистра сведений.
// Параметры:
//	ИмяРегистра - Строка, имя регистра сведений, к которому осуществляется запрос
//
//  Поля     	- Массив строковых значений;
//				элементы массива "Измерения" - имена измерений, значения которых необходимо получить. 
//
//  Отборы - Структура
//		     Ключи элементов структуры содержат имена полей отбора РС ЦепочкиДокументовПоставщиков;
//			 Значения элементов структуры содержат значения параметров для отбора к соответствующему ключу.
//
// Возвращаемое значение:
//  Булево		 - Истина, если все измерения найдены в метаданных регистра сведений;
//				   Ложь, если хотя бы одно измерение не найдено.
Функция ЕстьПоляВРегистреСведенийЭКОМ(ИмяРегистра, Поля, Отборы)
	Для Каждого Элемент Из Поля Цикл
		НайденноеИзмерение = Метаданные.РегистрыСведений[ИмяРегистра].Измерения.Найти(Элемент);
		НайденныеРесурс    = Метаданные.РегистрыСведений[ИмяРегистра].Ресурсы.Найти(Элемент);
		Если НайденноеИзмерение = Неопределено И НайденныеРесурс = Неопределено Тогда
			Возврат Ложь;	
		КонецЕсли;
	КонецЦикла;  
	
	Для Каждого Элемент Из Отборы Цикл
		НайденноеИзмерение = Метаданные.РегистрыСведений[ИмяРегистра].Измерения.Найти(Элемент.Ключ);
		НайденныеРесурс    = Метаданные.РегистрыСведений[ИмяРегистра].Ресурсы.Найти(Элемент.Ключ);
		Если НайденноеИзмерение = Неопределено И НайденныеРесурс = Неопределено Тогда
			Возврат Ложь;	
		КонецЕсли;
	КонецЦикла; 
	
	Возврат Истина;
КонецФункции

// Возвращает объект запрос со сформированным текстом на основании полученных параметров.
// Параметры:
//	ИмяРегистра - Строка, имя регистра сведений, в котором осуществляется проверка
//
//  Поля     	- Массив строковых значений;
//				элементы массива - имена измерений, ресурсов, значения которых необходимо получить. 
//
//  Отборы 	    - Структура
//		     	Ключи элементов структуры содержат имена полей отбора РС ЦепочкиДокументовПоставщиков;
//			 	Значения элементов структуры содержат значения параметров для отбора к соответствующему ключу.
//
//  ТипСравнения - Строка
//		     	Доступны значения "=" и "В", по умолчанию "=". При значении "В" в условии формируемого запроса используется
//			 	проверка на вхождение поля регистра в список элементов.
//
//  ТипУсловия  - Строка
//		     	Доступны значения "И" и "ИЛИ", по умолчанию "И". При значении "ИЛИ" в блоке запроса "ГДЕ"
//			 	условия перечисляются через "ИЛИ".
//
// Возвращаемое значение:
//  Запрос		- объект запрос со сформированным текстом.
Функция ЗапросКРегиструЭКОМ(ИмяРегистра, Поля, Отборы, ТипСравнения = "=", ТипУсловия = "И") Экспорт
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	|	*
	|ИЗ
	|	&ИмяРегистра КАК РегистрСведенийЭКОМ
	|ГДЕ
	|	&Отборы";
	ТекстПоля = "";
	Для Каждого Элемент Из Поля Цикл
		ТекстПоля = ТекстПоля + "РегистрСведенийЭКОМ." + Элемент +  "," + Символы.ПС + Символы.Таб; 
	КонецЦикла;
	Если СтрДлина(ТекстПоля) >= 3 Тогда
		ТекстПоля    = Лев(ТекстПоля, СтрДлина(ТекстПоля) - 3); 
	КонецЕсли;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "*", ТекстПоля);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяРегистра", "РегистрСведений." + ИмяРегистра);
	
	РазделительСравнения = ?(ТипСравнения = "В", ")", ",");
	ТипСравнения 		 = ?(ТипСравнения = "В", " В(&", " = &");
	
	ТекстОтборов = "";
	Для Каждого Элемент Из Отборы Цикл
		ТекстОтборов = ТекстОтборов + "РегистрСведенийЭКОМ." + Элемент.Ключ + ТипСравнения + Элемент.Ключ + РазделительСравнения + Символы.ПС + Символы.Таб + ТипУсловия + " ";
		Запрос.УстановитьПараметр(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	
	Если СтрДлина(ТекстОтборов) >= 5 Тогда
	ТекстОтборов = Лев(ТекстОтборов, СтрДлина(ТекстОтборов) - 5);
	КонецЕсли;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Отборы", ТекстОтборов); 
	Запрос.Текст = ТекстЗапроса;
	
	Возврат Запрос;
КонецФункции
// Преобразовывает числовое значение в секундах во время в часах, минутах, секундах
//
// Параметры:
//  Значение  - Число - значение в секундах
//
// Возвращаемое значение:
//   Структура   - преобразованное значение (часы, минуты, секунды, строковое представление)
//
Функция СекундыВоВремяНаСервере(Значение) Экспорт

	Результат = Новый Структура("Часы, Минуты, Секунды, Строка", 0, 0, 0, "");

	Если Значение = 0 Тогда
		Результат.Строка	= "менее одной секунды";
	Иначе
	
		Результат.Секунды	= Значение % 60;
		Результат.Минуты 	= (Значение - Результат.Секунды)/60;
		Результат.Минуты 	= Результат.Минуты % 60;
		Результат.Часы 		= (Значение - Результат.Секунды - Результат.Минуты * 60) / 3600;
		Результат.Строка	= ?(Результат.Часы = 0, "", Формат(Результат.Часы, "ЧГ=0") + " ч. ")
			+ ?(Результат.Минуты = 0, "", Формат(Результат.Минуты, "ЧГ=0") + " мин. ")
			+ ?(Результат.Секунды = 0, "", Формат(Результат.Секунды, "ЧГ=0") + " сек.");
		
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции // СекундыВВремя()

Функция ИспользуетсяОтправкаВMarking() Экспорт
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЭКОМ_ПрофилиОбмена.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ЭКОМ_ПрофилиОбмена КАК ЭКОМ_ПрофилиОбмена
	               |ГДЕ
	               |	ЭКОМ_ПрофилиОбмена.ОтправлятьУПДВMarking";
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ПолучитьНастройкиПрофилейОбмена() Экспорт
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЭКОМ_GLN.Объект КАК Организация,
	|	ЕСТЬNULL(ЭКОМ_GLN.ПрофильОбмена.ПроверятьФайлыЛокально, ЛОЖЬ) КАК ПроверятьФайлыЛокально
	|ИЗ
	|	РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN
	|ГДЕ
	|	ЭКОМ_GLN.Объект ССЫЛКА Справочник.Организации";
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Вставить(Выборка.Организация, Выборка.ПроверятьФайлыЛокально);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;	
КонецФункции

// Выполнение кода подписки на сервере в привелигированном режиме
//
// Параметры:
//  Источник  - ДокументСсылка - ссылка на документ источника для подписки
//  Алгоритм  - Строка - текст подписки
//
Процедура ВыполнитьПодпискуВПривелигированномРежиме(Источник, Алгоритм) Экспорт

	Алгоритм = СтрЗаменить(Алгоритм, "КонтрагентУчаствуетВЭДО(", "ЭКОМ_ПодпискаСобытий.КонтрагентУчаствуетВЭДО(");
	Алгоритм = СтрЗаменить(Алгоритм, "ПолучитьИсправляемыйДокументРеализации(", "ЭКОМ_ПодпискаСобытий.ПолучитьИсправляемыйДокументРеализации(");
	
	УстановитьПривилегированныйРежим(Истина);
	Выполнить(Алгоритм);
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры // ВыполнитьВПривелигированномРежиме()

// Вызывается кодом подписки (процедура ВыполнитьПодпискуВПривелигированномРежиме())
//
Функция ПолучитьИсправляемыйДокументРеализации(Док, Исходный = Ложь, ИмяРеквизита = "ДокументРеализации")
   
    Если  Док.Метаданные().Имя = "КорректировкаРеализации"	Тогда       
        Возврат ПолучитьИсправляемыйДокументРеализации(Док[ИмяРеквизита], Исходный);       
    Иначе
        Возврат Док;
    КонецЕсли;   
КонецФункции

// Вызывается кодом подписки (процедура ВыполнитьПодпискуВПривелигированномРежиме())
//
Функция КонтрагентУчаствуетВЭДО(Организация, Контрагент, ТочкаДоставки = Неопределено)
	
	ЗапроcПроверкаКлиента = Новый Запрос;
	ЗапроcПроверкаКлиента.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	                              |	ЭКОМ_Организации.GLN КАК GLN_Организация,
	                              |	ЭКОМ_Контрагенты.GLN КАК GLN_Контрагент,
	                              |	ЭКОМ_ТочкиДоставки.GLN КАК GLN_ТочкаДоставки,
	                              |	ЭКОМ_Контрагенты.Ид_ОЭД КАК ИдентификаторКонтрагент,
	                              |	ЭКОМ_Организации.Ид_ОЭД КАК ИдентификаторОрганизация,
	                              |	ЭКОМ_ТочкиДоставки.Ид_ОЭД КАК ИдентификаторТочкаДоставки
	                              |ИЗ
	                              |	РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_Организации
	                              |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_Контрагенты
	                              |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_ТочкиДоставки КАК ЭКОМ_ТочкиДоставки
	                              |			ПО (ИСТИНА)
	                              |		ПО (ИСТИНА)
	                              |ГДЕ
	                              |	ЭКОМ_Организации.Объект = &Организация
	                              |	И ЭКОМ_Контрагенты.Объект = &Контрагент
	                              |	И ВЫБОР
	                              |			КОГДА &ТочкаДоставки = НЕОПРЕДЕЛЕНО
	                              |				ТОГДА ИСТИНА
	                              |			ИНАЧЕ ЭКОМ_ТочкиДоставки.Объект = &ТочкаДоставки
	                              |		КОНЕЦ";
	ЗапроcПроверкаКлиента.УстановитьПараметр("ТочкаДоставки", ТочкаДоставки);
	ЗапроcПроверкаКлиента.УстановитьПараметр("Организация", Организация);
	ЗапроcПроверкаКлиента.УстановитьПараметр("Контрагент", Контрагент);
	РезультатЗапроса = ЗапроcПроверкаКлиента.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Возврат Выборка;

КонецФункции


// Функционал работы с информационными сообщениями компании.

// Загружает в базу данных информационные сообщения компании.
//
Процедура ОбработатьНовости() Экспорт
	
	// Если обработка только установлена и дата загрузки новостей еще не заполнена, тогда качаем новости за последний месяц.
	ДатаПоследнейЗагрузки 	= НастройкиПрочитатьНаСервере("СлужебныйДатаЗагрузкиНовостей", НачалоДня(ДобавитьМесяц(ТекущаяДата(), -1)));
	МассивЛогаСобытий 		= Новый Массив;
	ИмяКаталога				= "news";
	ДопустимыеРасширения 	= Новый Массив;
	ДопустимыеРасширения.Добавить("html");
	ДопустимыеРасширения.Добавить("txt");                                                                                              
	// Здесь не анализируется ответ сервера. Возможно мы получим ошибку, но посчитаем, что за эту дату не было новостей!!!
	ФайлыКЗагрузке	 		= ПолучитьИменаФайловНовостей(ДатаПоследнейЗагрузки, ДопустимыеРасширения, ИмяКаталога, МассивЛогаСобытий);
	
	КоллекцияНовостей 	= ПолучитьДанныеНовостей(ФайлыКЗагрузке.ИменаФайлов, ДопустимыеРасширения, ИмяКаталога, МассивЛогаСобытий);
	Если ЗначениеЗаполнено(ФайлыКЗагрузке.ДатаВремяЗагрузки)
		И СохранитьНовости(КоллекцияНовостей, МассивЛогаСобытий) Тогда
		
		НастройкаПараметрЗаписать("СлужебныйДатаЗагрузкиНовостей", ФайлыКЗагрузке.ДатаВремяЗагрузки, , МассивЛогаСобытий);
	КонецЕсли;
	
	ЗаписатьЛогСобытийвРегистрЛогирование(МассивЛогаСобытий);
	
	Отбор = Новый Структура("Пользователь, Прочитано",
		ПолучитьЭкомПользователяПоПользователю(НайтиТекущегоПользователя()), Истина);
	ИзменитьНовость(Отбор, , Истина);
	
КонецПроцедуры // ПолучитьНовости()

// Загружает имена доступных новостей из GIT репозитория
//
// Параметры:
//  ДатаПоследнейЗагрузки  	- ДатаВремя - дата последнего обновления новостей
//  ДопустимыеРасширения  	- Массив - коллекция разрешенных к загрузке расширений файлов
//  ИмяКаталога  			- Строка - наименование каталога для загрузки в GIT репозитории
//  МассивЛогаСобытий  		- Массив - коллекция записей лога событий
//
// Возвращаемое значение:
//   Массив   - коллекция имен файлов на GIT, доступных для загрузки
//
Функция ПолучитьИменаФайловНовостей(Знач ДатаПоследнейЗагрузки, Знач ДопустимыеРасширения, Знач ИмяКаталога, МассивЛогаСобытий)
	
	ИмяСобытия			= "Загрузка новостей";
    ОписаниеТиповОтвета = Новый ОписаниеТипов("Массив, Соответствие");
	Результат = Новый Структура("ИменаФайлов, ДатаВремяЗагрузки", Новый Массив, '0001-01-01');
	КомандаЗапроса    	= "/repos/1cdevelopexite/" + ИмяКаталога + "/contents";
	ОтветСервера 		= ПолучениеДанныхGITНаСервере(КомандаЗапроса, МассивЛогаСобытий);
	
	Если ОтветСервера <> Неопределено И ОписаниеТиповОтвета.СодержитТип(ТипЗнч(ОтветСервера)) Тогда
		
		Результат.ДатаВремяЗагрузки = ТекущаяДата();
		
		Если ОтветСервера.Количество() = 0 Тогда
			Возврат Результат;
		КонецЕсли;
		
		Для Каждого ФайлЗапись Из ОтветСервера Цикл
			Результат.ИменаФайлов.Добавить(ФайлЗапись.Получить("name"));
		КонецЦикла;
		
	Иначе
		
		ТекстЛогаСобытий 	=  "Ответ сервера содержит недопустимый тип данных - " + ТипЗнч(ОтветСервера);
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
		Возврат Результат;
	КонецЕсли; 
	
	МаксИндекс = Результат.ИменаФайлов.ВГраница();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЭКОМ_Новости.ДатаФайла КАК ДатаФайла,
		|	ЭКОМ_Новости.ИмяФайла
		|ПОМЕСТИТЬ вт
		|ИЗ
		|	РегистрСведений.ЭКОМ_Новости КАК ЭКОМ_Новости
		|ГДЕ
		|	ЭКОМ_Новости.ДатаФайла > &ДатаПоследнейЗагрузки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	вт.ИмяФайла
		|ИЗ
		|	вт КАК вт";
	
	Запрос.УстановитьПараметр("ДатаПоследнейЗагрузки", ДатаПоследнейЗагрузки);
	РанееЗагруженные = Запрос.Выполнить().Выгрузить();
	РанееЗагруженные.Индексы.Добавить("ИмяФайла");
	
	Для Счетчик = 0 По МаксИндекс Цикл
		
		Индекс 		= МаксИндекс - Счетчик;
		ИмяФайла 	= Результат.ИменаФайлов.Получить(Индекс);
		ДатаФайла	= '0001-01-01';
		
		Если РанееЗагруженные.Найти(ИмяФайла, "ИмяФайла") <> Неопределено
			ИЛИ НЕ РазобратьПроверитьИмяФайлаНовости(ИмяФайла, ДопустимыеРасширения, МассивЛогаСобытий, ДатаФайла)
			ИЛИ (ЗначениеЗаполнено(ДатаФайла) И ДатаФайла <= ДатаПоследнейЗагрузки) Тогда

			Результат.ИменаФайлов.Удалить(Индекс);
			Продолжить;
		КонецЕсли;     
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // ЗагрузитьНовостиGIT()

// Проверяет допустимость имени файла новости, получает дату и заглавие новости, возвращает признак корректности имени файла
//
// Параметры:
//  Имя  					- Строка 	- имя файла для проверки. Пример: "2021-01-01-01-01-01_Заглавие новости.txt"
//  ДопустимыеРасширения 	- Массив 	- коллекция допустимых для загрузки расширений
//	МассивЛогаСобытий		- Массив 	- коллекция записей лога событий
//	Дата 					- ДатаВремя - дата последней загрузки новостей 
//	Заглавие 				- Строка 	- полученная из имени файла строка заглавия новости
//
// Возвращаемое значение:
//   Булево   - возвращает Истина, если имя файла корректно
//
Функция РазобратьПроверитьИмяФайлаНовости(Знач Имя, Знач ДопустимыеРасширения, МассивЛогаСобытий, Дата = '0001-01-01', Заглавие = "")
	
	ИмяСобытия		= "Проверка имени файла новости";
	ИмяКорректно 	= Истина;
	
	// Проверка расширения.
	ПоискРасширения = СтрЗаменить(Имя, ".", Символы.ПС);
	Если СтрЧислоСтрок(ПоискРасширения) = 0 Тогда
		ИмяКорректно = Ложь;     
		ТекстЛогаСобытий 	=  "Не найдено расширение в имени файла - " + Имя;
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
	КонецЕсли;
	
	Если ИмяКорректно Тогда
		Расширение 		= СтрПолучитьСтроку(ПоискРасширения, СтрЧислоСтрок(ПоискРасширения)); 
		ПоискРасширения = Неопределено;
		Если ДопустимыеРасширения.Найти(Расширение) = Неопределено Тогда 
			ИмяКорректно = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	// Проверка даты новости.
	Если ИмяКорректно Тогда
		ПоискДаты = СтрЗаменить(Имя, "_", Символы.ПС);
		Если СтрЧислоСтрок(ПоискДаты) = 0 Тогда
			ИмяКорректно = Ложь;     
			ТекстЛогаСобытий 	=  "Не правильный формат даты или неправильный разделитель между датой и заглавием новости в имени файла - " + Имя;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяКорректно Тогда
		ДатаСтрокой = СтрПолучитьСтроку(ПоискДаты, 1);
		Попытка
			Дата = Вычислить("'" + ДатаСтрокой + "'");
		Исключение
			ИмяКорректно = Ложь;     
			ТекстЛогаСобытий 	=  "Не правильный формат даты или неправильный разделитель между датой и заглавием новости в имени файла - " + Имя;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		КонецПопытки;
	КонецЕсли;
	
	Если ИмяКорректно Тогда
		времЗаглавие 	= Лев(Имя, СтрДлина(Имя) - (СтрДлина(Расширение) + 1));
		Заглавие 		= Прав(времЗаглавие, СтрДлина(времЗаглавие) - (СтрДлина(ДатаСтрокой) + 1));
	КонецЕсли;
	
	Возврат ИмяКорректно;

КонецФункции // РазобратьПроверитьИмяФайлаНовости()

// Получает информацию из файлов новостей на основании входящих имен файлов
//
// Параметры:
//  Имена  					- Массив - коллекция имен файлов на GIT
//  ДопустимыеРасширения  	- Массив - коллекция допустимых для загрузки расширений
//	ИмяКаталога				- Строка - наименование каталога для загрузки в GIT репозитории
//	МассивЛогаСобытий		- Массив - коллекция записей лога событий
//
// Возвращаемое значение:
//   ТаблицаЗначений   		- информация из файлов новостей. Колонки: Заглавие (Строка, 300), ДатаФайла (ДатаВремя), Содержание(Строка, неогр.)
//
Функция ПолучитьДанныеНовостей(Имена, Знач ДопустимыеРасширения, Знач ИмяКаталога, МассивЛогаСобытий)
	
	ИмяСобытия		= "Загрузка новости";
	КомандаЗапроса	= "/repos/1cdevelopexite/" + ИмяКаталога + "/contents/";
	Ответ			= Новый ТаблицаЗначений;
	Ответ.Колонки.Добавить("ИмяФайла", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(300)));
	Ответ.Колонки.Добавить("Заглавие", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(300)));
	Ответ.Колонки.Добавить("ДатаФайла",Новый ОписаниеТипов("Дата",,,,, Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	Ответ.Колонки.Добавить("Содержание", Новый ОписаниеТипов("Строка"));
	
	Если ТипЗнч(Имена) <> Тип("Массив") Тогда
		ТекстЛогаСобытий 	=  "Ошибка типа параметра функции - " + ТипЗнч(Имена);
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		Возврат Ответ;
	ИначеЕсли Имена.Количество() > 0 Тогда
		ВерсияПлатформы = ВерсияПлатформыНаСервере();
		Если ВерсияПлатформы < 83100 Тогда
			КаталогВременныхФайлов = КаталогВременныхФайлов() + "TempECOM" + ПолучитьРазделительПути();
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого ИмяФайла Из Имена Цикл
		
		ОтветСервера 		= ПолучениеДанныхGITНаСервере(КомандаЗапроса + ИмяФайла, МассивЛогаСобытий);
		
		Если ОтветСервера 	= Неопределено Тогда
			ТекстЛогаСобытий 	=  "Данные файла " + ИмяФайла + " не получены";
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			Продолжить;
		КонецЕсли;
		
		СтрокаBase64   	= СтрЗаменить(ОтветСервера.Получить("content"), "\/", "/");
		ДвоичныеДанные 	= Base64Значение(СтрокаBase64);
		Чтение			= Неопределено;
		Если ВерсияПлатформы >= 83100 Тогда
			Чтение = Вычислить("Новый ЧтениеДанных(ДвоичныеДанные)"); 
			Файл = Вычислить("Новый ПотокВПамяти(Чтение.ПрочитатьВБуферДвоичныхДанных())");
			Чтение.Закрыть();
		Иначе
			Файл = КаталогВременныхФайлов + ИмяФайла;
			ДвоичныеДанные.Записать(Файл);
		КонецЕсли;
		
		ЧтениеФайла = Новый ЧтениеТекста(Файл, КодировкаТекста.UTF8);
		Содержание 	= ЧтениеФайла.Прочитать();
		ЧтениеФайла.Закрыть();     
		
		Если ВерсияПлатформы >= 83100 Тогда
			Выполнить("Файл.Закрыть()");
		Иначе
			УдалитьФайлы(Файл.ПолноеИмя);
		КонецЕсли;
		
		СтрокаОтвета 			= Ответ.Добавить();
		СтрокаОтвета.ИмяФайла	= ИмяФайла;
		СтрокаОтвета.Содержание = Содержание;
		РазобратьПроверитьИмяФайлаНовости(ИмяФайла, ДопустимыеРасширения, МассивЛогаСобытий, СтрокаОтвета.ДатаФайла, СтрокаОтвета.Заглавие)
		
	КонецЦикла;	
	
	Возврат Ответ;
	
КонецФункции // ПолучитьДанныеНовостей()

// Сохраняет полученные новости в регистр сведений
//
// Параметры:
//  КоллекцияНовостей	 - ТаблицаЗначений	 - информация из файлов новостей. Колонки: Заглавие (Строка, 300), ДатаФайла (ДатаВремя), Содержание(Строка, неогр.)
//  МассивЛогаСобытий	 - Массив			 - коллекция записей лога событий
// 
// Возвращаемое значение:
//  Булево - признак успешности записи новостей
//
Функция СохранитьНовости(КоллекцияНовостей, МассивЛогаСобытий)
	
	ИмяСобытия = "Сохранение новости";
	
	// Валидация входных данных.
	Если НЕ ТипЗнч(КоллекцияНовостей) = Тип("ТаблицаЗначений") Тогда
		ТекстЛогаСобытий 	=  "Неправильный тип коллекции новостей. Текущий тип " + ТипЗнч(КоллекцияНовостей)
			+ ". Ожидается ТаблицаЗначений";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		Возврат Ложь;
	ИначеЕсли КоллекцияНовостей.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	КоллекцияНовостей.Колонки.Добавить("Пользователь", Новый ОписаниеТипов("СправочникСсылка.ЭКОМ_Пользователи"));
	
	Колонки = Новый Структура;
	Колонки.Вставить("ИмяФайла",	Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(300)));
	Колонки.Вставить("Заглавие", 	Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(300)));
	Колонки.Вставить("ДатаФайла",	Новый ОписаниеТипов("Дата",,,,, Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	Колонки.Вставить("Содержание",	Новый ОписаниеТипов("Строка"));
	
	Для Каждого Колонка Из Колонки Цикл
		КолонкаТЗ = КоллекцияНовостей.Колонки.Найти(Колонка.Ключ);
		ТекстЛогаСобытий = "";
		Если КолонкаТЗ = Неопределено Тогда
			ТекстЛогаСобытий =  "Не корректный список колонок в коллекции новостей. Ожидается колонка с именем " + Колонка.Ключ;
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(КолонкаТЗ) И КолонкаТЗ.ТипЗначения <> Колонка.Значение Тогда
			ТекстЛогаСобытий =  "Не корректный тип значений колонок в коллекции новостей. Для колонки " + КолонкаТЗ.Имя
				+ " ожидается тип " + Строка(Колонка.Значение) + ". Текущий тип " + Строка(КолонкаТЗ.ТипЗначения);
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(ТекстЛогаСобытий) Тогда
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	// Запись новостей в регистр.
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЭКОМ_Пользователи.Ссылка
		|ИЗ
		|	Справочник.ЭКОМ_Пользователи КАК ЭКОМ_Пользователи
		|ГДЕ
		|	ЭКОМ_Пользователи.ПометкаУдаления = ЛОЖЬ";
	
	КоллекцияПользователей = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
	
	НаборЗаписей = РегистрыСведений.ЭКОМ_Новости.СоздатьНаборЗаписей();
	Для Каждого Новость Из КоллекцияНовостей Цикл
		Если КоллекцияПользователей.Количество() = 0 Тогда 
			ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), Новость);
		Иначе
			Для Каждого Пользователь Из КоллекцияПользователей Цикл
				НоваяЗапись = НаборЗаписей.Добавить();
				НоваяЗапись.Пользователь = Пользователь;
				ЗаполнитьЗначенияСвойств(НоваяЗапись, Новость, , "Пользователь");
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;  
	
	Если НаборЗаписей.Модифицированность() Тогда
		НаборЗаписей.Записать();
		ТекстЛогаСобытий 	=  "Загружено " + КоллекцияНовостей.Количество() + ?(КоллекцияНовостей.Количество() = 1, " новостное сообщение.", " новостных сообщений.");
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Успешно, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции // СохранитьНовости()

// Меняет записи РС ЭКОМ_Новости
//
// Параметры:
//  Отбор  - Структура - параметры отбора для поиска записей в регистре
//  Значения  - Структура - значения для замены в записях. Может быть не заполненно
//  Удалить  - Булево - пометка удаления записей по отбору
//
Процедура ИзменитьНовость(Отбор, Значения = Неопределено, Удалить = Ложь) Экспорт
	
	Если ТипЗнч(Отбор) <> Тип("Структура") Тогда 
		Возврат;
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.ЭКОМ_Новости.СоздатьНаборЗаписей();
	
	Для Каждого ЭлементОтбора Из Отбор Цикл
		
		ОтборНабора 		= НаборЗаписей.Отбор.Найти(ЭлементОтбора.Ключ);
		Если ОтборНабора 	= Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ОтборНабора.Установить(ЭлементОтбора.Значение);
		
	КонецЦикла;
	
	НачатьТранзакцию(); 
	
	ЭКОМ_ПодпискаСобытий.ВыполнитьБлокировкуНабораЗаписей(НаборЗаписей.Отбор, "ЭКОМ_Новости");
	НаборЗаписей.Прочитать();
	
	Если Удалить = Истина Тогда 
		НаборЗаписей.Очистить();
	ИначеЕсли ТипЗнч(Значения) = Тип("Структура") Тогда
		Для Каждого Запись Из НаборЗаписей Цикл
			Для Каждого ЭлементЗначения Из Значения Цикл
				Попытка
					Запись[ЭлементЗначения.Ключ] = ЭлементЗначения.Значение;
				Исключение   
					ОтменитьТранзакцию();
					Возврат;
				КонецПопытки;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	Если НаборЗаписей.Модифицированность() = Истина Тогда 
		НаборЗаписей.Записать();
	КонецЕсли;
	
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры // ИзменитьНовость()

// Возвращает ссылку на элемент справочника ЭКОМ_Пользователи, к которому привязан переданный пользователь
//
// Параметры:
//  Пользователь  - СправочникСсылка.Пользователи - польозватель, для которого нужно найти соответствия
//
// Возвращаемое значение:
//   СправочникСсылка.ЭКОМ_Пользователи   - элемент, связанный с переданным пользователем. Если не найден, возвращается пустая ссылка
//
Функция ПолучитьЭкомПользователяПоПользователю(Пользователь) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ЭКОМ_Пользователи.Ссылка
		|ПОМЕСТИТЬ втПользователи
		|ИЗ
		|	Справочник.ЭКОМ_Пользователи КАК ЭКОМ_Пользователи
		|ГДЕ
		|	ЭКОМ_Пользователи.Пользователь = &Пользователь
		|	И ЭКОМ_Пользователи.ПометкаУдаления = ЛОЖЬ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Справочник.ЭКОМ_Пользователи.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	втПользователи.Ссылка
		|ИЗ
		|	втПользователи КАК втПользователи";
	
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка").Получить(0);
	
КонецФункции // ПолучитьЭкомПользователяПоПользователю()

// Получает непрочитанные новости для текущего пользователя с сортировкой по убыванию даты
//
// Возвращаемое значение:
//   ТаблицаЗначений   - коллекция новостей пользователя
//
Функция ПолучитьНовостиПользователя() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЭКОМ_Новости.ДатаФайла,
		|	ЭКОМ_Новости.Заглавие,
		|	ЭКОМ_Новости.ИмяФайла,
		|	ЭКОМ_Новости.Прочитано,
		|	ЭКОМ_Новости.Содержание
		|ИЗ
		|	РегистрСведений.ЭКОМ_Новости КАК ЭКОМ_Новости
		|ГДЕ
		|	ЭКОМ_Новости.Пользователь = &Пользователь
		|	И ЭКОМ_Новости.Прочитано = ЛОЖЬ
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаФайла УБЫВ";
	
	Запрос.УстановитьПараметр("Пользователь", ПолучитьЭкомПользователяПоПользователю(НайтиТекущегоПользователя()));
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции // ПолучитьНовостиПользователя()

