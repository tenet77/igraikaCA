// ПОДКЛЮЧЕНИЕ К GIT

// GET запрос - Получаем данные с HTTP-сервера
Функция ПолучениеДанныхGITНаСервере(КомандаЗапроса, МассивЛогаСобытий) Экспорт
			
	Ответ = ВыполнитьЗапросGIT(КомандаЗапроса, Неопределено, "GET", МассивЛогаСобытий);   
	Если НЕ Ответ = Неопределено Тогда
	     Результат = ОбработатьОтвет(Ответ.Текст)
	Иначе
		 Результат = Неопределено;
	КонецЕсли;
	 
	Возврат Результат;

КонецФункции

// ДанныеЗапроса - Структура
// ДанныеЗапроса.Текст - текст запроса
// ДанныеЗапроса.Заголовки
Функция ВыполнитьЗапросGIT(КомандаЗапроса, ДанныеЗапроса, HTTPМетод, МассивЛогаСобытий) Экспорт
		
	СтруктураОшибки = Новый Структура;
	СтруктураОшибки.Вставить("ЕстьОшибка" , Ложь);
	СтруктураОшибки.Вставить("КодОшибки"  , "");
	СтруктураОшибки.Вставить("ТекстОшибки", "");
	
	ТокенGIT = "84cabc6dac4746014ed2157563537b4c530a4d64";
	АдресСервера = "api.github.com";
		
	Если НЕ ЗначениеЗаполнено(АдресСервера) Тогда
		
		СтруктураОшибки.Вставить("ЕстьОшибка" , Истина); 
		СтруктураОшибки.Вставить("КодОшибки"  , "");
		СтруктураОшибки.Вставить("ТекстОшибки", "В настройках программы не заполнен адрес сервера");
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	ЭКОМ_ИспользуетсяПрокси = НастройкиПрочитатьНаСервере("ЭКОМ_ИспользуетсяПрокси", Ложь);	
	Если ЭКОМ_ИспользуетсяПрокси Тогда
		ЭКОМ_ИмяСервераПрокси         = НастройкиПрочитатьНаСервере("ЭКОМ_ИмяСервераПрокси"        , "");
		ЭКОМ_ИмяПользователяПрокси    = НастройкиПрочитатьНаСервере("ЭКОМ_ИмяПользователяПрокси"   , "");
		ЭКОМ_ПарольПользователяПрокси = НастройкиПрочитатьНаСервере("ЭКОМ_ПарольПользователяПрокси", "");
		
	Иначе
		ЭКОМ_ИмяСервераПрокси         = "";
		ЭКОМ_ИмяПользователяПрокси    = "";
		ЭКОМ_ПарольПользователяПрокси = "";
	КонецЕсли;
	
	ПроксиСервер = Новый ИнтернетПрокси;
	ПроксиСервер.Пользователь = ЭКОМ_ИмяПользователяПрокси;
	ПроксиСервер.Пароль       = ЭКОМ_ПарольПользователяПрокси;
	ПроксиСервер.Сервер(ЭКОМ_ИмяСервераПрокси);	
	
	// Хост и порт
	Хост = АдресСервера;
	Порт = 443;
	Позиция = Найти(АдресСервера, ":");
	Если Позиция > 0 Тогда
		Хост = Лев(АдресСервера, Позиция - 1);
		Порт = ЭКОМ_ПреобразоватьВЧислоОбщегоНазначения(Сред(АдресСервера, Позиция + 1));
	КонецЕсли;
	
	ОтветСтрока = "";
	
	ТекстJSON = "";
	Если HTTPМетод = "POST" 
		ИЛИ HTTPМетод = "PUT" Тогда
		
		ТекстJSON = API_СформироватьЗапрос(ДанныеЗапроса);

	КонецЕсли;
	
	ЗаголовокHTTP = Новый Соответствие;
	ЗаголовокHTTP.Вставить("Content-Type" , "application/json; charset=utf-8");
	ЗаголовокHTTP.Вставить("Accept"       , "application/vnd.github.v3+json");
	ЗаголовокHTTP.Вставить("cache-control", "no-cache");
	ЗаголовокHTTP.Вставить("Origin"       , "*");	
	ЗаголовокHTTP.Вставить("Authorization", "token " + ТокенGIT);
			
	Ответ = Новый Структура;
	Ответ.Вставить("Текст", "");
	
	Если ВерсияПлатформыНаСервере() >= 8340  Тогда
					
		HTTPЗапрос = Неопределено;		
		Выполнить("HTTPЗапрос = Новый HTTPЗапрос(КомандаЗапроса, ЗаголовокHTTP);");
		Если HTTPМетод = "POST" 
		     ИЛИ HTTPМетод = "PUT" Тогда
			HTTPЗапрос.УстановитьТелоИзСтроки(ТекстJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		КонецЕсли;
		
		Попытка
			СоединениеHTTP = "";
			Выполнить("СоединениеHTTP = Новый HTTPСоединение(Хост, Порт,,, ПроксиСервер,, Новый ЗащищенноеСоединениеOpenSSL());");			
			
		Исключение
			ТекстОшибки = "Не удалось установить соединение с сервером:" + Символы.ПС + ИнформацияОбОшибке().Описание;
			
			СтруктураОшибки.Вставить("ЕстьОшибка" , Истина); 
			СтруктураОшибки.Вставить("КодОшибки"  , "");
			СтруктураОшибки.Вставить("ТекстОшибки", ТекстОшибки);
			
			Возврат Неопределено;
			
		КонецПопытки;
		
		ИмяВыходногоФайла = "";
		Попытка
			
			Если HTTPМетод = "PUT" Тогда
				HTTPОтвет = СоединениеHTTP.Записать(HTTPЗапрос);			
				
			ИначеЕсли HTTPМетод = "POST" Тогда	
				HTTPОтвет = СоединениеHTTP.ОтправитьДляОбработки(HTTPЗапрос, ИмяВыходногоФайла);
				
			Иначе
				HTTPОтвет = СоединениеHTTP.Получить(HTTPЗапрос, ИмяВыходногоФайла);
			КонецЕсли;
			
		Исключение
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ОписаниеОшибки();
			Сообщение.Сообщить();
			Возврат Неопределено;
		КонецПопытки;
		
		ОтветСтрока = ПреобразоватьЮникод(HTTPОтвет.ПолучитьТелоКакСтроку(), МассивЛогаСобытий);
		 
		 Если HTTPОтвет.КодСостояния > 299 Тогда
			 
			 ТекстОшибки = "Код состояния " + HTTPОтвет.КодСостояния + ". Запрос не отправлен. " + ОтветСтрока;
			 
			 СтруктураОшибки.Вставить("ЕстьОшибка" , Истина); 
			 СтруктураОшибки.Вставить("КодОшибки"  , "");
			 СтруктураОшибки.Вставить("ТекстОшибки", ТекстОшибки);
			 
			 Возврат Неопределено;
			 
		 ИначеЕсли НЕ ЗначениеЗаполнено(ОтветСтрока) Тогда
			 
			 ТекстОшибки = "Ошибка, результат пустой, " + HTTPОтвет.КодСостояния;
			 
			 СтруктураОшибки.Вставить("ЕстьОшибка" , Истина); 
			 СтруктураОшибки.Вставить("КодОшибки"  , "");
			 СтруктураОшибки.Вставить("ТекстОшибки", ТекстОшибки);
			 
			 Возврат Неопределено;
			 
		 Иначе
			 
			 Ответ = Новый Структура;
			 Ответ.Вставить("КодОтвета" , HTTPОтвет.КодСостояния);
			 Ответ.Вставить("exchangeid", "");
			 Ответ.Вставить("Текст"     , ОтветСтрока);			
			 Ответ.Вставить("XML"       , "");
			 Ответ.Вставить("XML_Текст" , ОтветСтрока);	
			 
		 КонецЕсли;
		
	Иначе
		
		АдресСервера = "https://" + АдресСервера;
		API = Новый COMОбъект("MSXML2.XMLHTTP");
		API.Open(HTTPМетод, АдресСервера + КомандаЗапроса, 0);
		Для Каждого Заголовок Из ЗаголовокHTTP Цикл
			API.setRequestHeader(Заголовок.Ключ, Заголовок.Значение);
		КонецЦикла;
				
		// Отправляем
		API.send(ТекстJSON);
		
		// Результат
		Ответ = Новый Структура;
		Ответ.Вставить("КодОтвета"        , API.Status);
		Ответ.Вставить("Текст"            , API.responseText);
		Ответ.Вставить("XML"              , API.responseXml);
		Ответ.Вставить("XML_Текст"        , API.responseXml.text);
		Ответ.Вставить("exchangeid"       , "");
		
		Если НЕ ЗначениеЗаполнено(Ответ.Текст) Тогда
			
			ТекстОшибки = "Ошибка, результат пустой, " + Ответ.КодОтвета;
			
			СтруктураОшибки.Вставить("ЕстьОшибка" , Истина); 
			СтруктураОшибки.Вставить("КодОшибки"  , "");
			СтруктураОшибки.Вставить("ТекстОшибки", ТекстОшибки);
			
			Возврат Неопределено;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если СтруктураОшибки.ЕстьОшибка = Истина Тогда
		МассивЛогаСобытий.Добавить(СтруктураОшибки.КодОшибки + " - " + СтруктураОшибки.ТекстОшибки);
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтруктураОшибки.ТекстОшибки + " " + СтруктураОшибки.ТекстОшибки;
		Сообщение.Сообщить();
		
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

