Функция ПолучитьДанныеПоКолонкамИсточника() Экспорт
	
	ЭКОМ_ОбменСеть      = НастройкиПрочитатьНаСервере("ЭКОМ_ОбменСеть"     , Истина);
	ЭКОМ_ОбменПоставщик = НастройкиПрочитатьНаСервере("ЭКОМ_ОбменПоставщик", Истина);
	ЭКОМ_ОбменЭТРН      = НастройкиПрочитатьНаСервере("ЭКОМ_ОбменЭТРН"     , Истина);
	ЭКОМ_ОбменCondra    = НастройкиПрочитатьНаСервере("ЭКОМ_ОбменCondra"   , Истина);
	ЭКОМ_ОбменПрайсЛист = НастройкиПрочитатьНаСервере("ЭКОМ_ОбменПрайсЛист", Истина);
	
	СтруктураДанных = Новый Структура;
	Если ЭКОМ_ОбменСеть = Истина Тогда
		АлгоритмЗаполненияСписка = НастройкиПрочитатьНаСервере("СлужебныйЗапросДляФормыПокупателя", , "Служебный");		
		СтруктураДанных.Вставить("Сеть", АлгоритмЗаполненияСписка);
		
	КонецЕсли;
	
	Если ЭКОМ_ОбменПоставщик = Истина Тогда
		АлгоритмЗаполненияСписка = НастройкиПрочитатьНаСервере("СлужебныйЗапросДляФормыПоставщика", , "Служебный");
		СтруктураДанных.Вставить("Поставщик", АлгоритмЗаполненияСписка);
		
	КонецЕсли;		
	
	Если ЭКОМ_ОбменЭТРН = Истина Тогда
		АлгоритмЗаполненияСписка = НастройкиПрочитатьНаСервере("СлужебныйЗапросДляФормыЭТРН", , "Служебный");
		СтруктураДанных.Вставить("ЭТРН", АлгоритмЗаполненияСписка);
		
	КонецЕсли;
	
	Если ЭКОМ_ОбменCondra = Истина Тогда
		АлгоритмЗаполненияСписка = НастройкиПрочитатьНаСервере("СлужебныйЗапросДляФормыCondra", , "Служебный");
		СтруктураДанных.Вставить("CONDRA", АлгоритмЗаполненияСписка);
		
	КонецЕсли;
	
	Если ЭКОМ_ОбменПрайсЛист = Истина Тогда
		АлгоритмЗаполненияСписка = НастройкиПрочитатьНаСервере("СлужебныйЗапросДляФормыПрайсЛист", ,"Служебный");
		СтруктураДанных.Вставить("ПрайсЛист", АлгоритмЗаполненияСписка);
		
	КонецЕсли;
	
	СписокКолонок = Новый Соответствие;
	Для каждого Данные Из СтруктураДанных Цикл
		
		ТекстЗапроса = "";
		
		Попытка
			
			Выполнить(Данные.Значение);
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВЫБРАТЬ", "ВЫБРАТЬ ПЕРВЫЕ 3");
			Запрос = Новый Запрос;
			Запрос.Текст = ТекстЗапроса;			
			Запрос.УстановитьПараметр("ДатаНач", ТекущаяДата());
			Запрос.УстановитьПараметр("ДатаКон", ТекущаяДата());	
			Запрос.УстановитьПараметр("масПомеченныхДоков", Новый Массив);
			Запрос.УстановитьПараметр("НаправлениеОбмена" , Перечисления.ЭКОМ_НаправлениеОбмена.ПустаяСсылка());

			РезультатЗапроса = Запрос.Выполнить();
			КолонкиЗапроса = РезультатЗапроса.Колонки;				
			Для каждого ТекКолонка Из КолонкиЗапроса Цикл
				СписокКолонок.Вставить(ТекКолонка.Имя, ТекКолонка.ТипЗначения);			
			КонецЦикла;
			
		Исключение				
		КонецПопытки;
		
	КонецЦикла;		     
	
	Возврат СписокКолонок;
	
КонецФункции

