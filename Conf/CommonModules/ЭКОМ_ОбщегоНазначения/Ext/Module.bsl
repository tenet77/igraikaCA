Функция СформироватьДокументыXML(МассивСтрок, МассивЛогаСобытий, ЭтоРегламентноеЗадание, ТипДокумента, ПодписатьФайл, НомерИсправления = "") Экспорт 
	
	МассивСтруктур = Новый Массив;
	
	ДанныеПоКолонкам            = ПолучитьДанныеПоКолонкамИсточника(); 
	ДанныеПоИсходящимНастройкам = ПолучитьДанныеПоИсходящимНастройкам(ДанныеПоКолонкам, ТипДокумента, МассивЛогаСобытий);
	
	ИсходящееДерево       = ДанныеПоИсходящимНастройкам["ИсходящееДерево"].Получить();	
	ИмяДокументаИсточника = ДанныеПоИсходящимНастройкам["ИмяДокументаИсточника"];

	МассивДок = ПолучитьДокументыДляСозданияШаблона(МассивСтрок, ИмяДокументаИсточника, ТипДокумента, МассивЛогаСобытий);
	
	Если Не МассивДок.Количество()=0 Тогда	
		Ошибка     = ПолучитьСтруктуруОшибки();
		ПолучитьДанныеДокументов(ИсходящееДерево, МассивДок, НомерИсправления, МассивЛогаСобытий, Ошибка);
		
		Если Ошибка.ЕстьОшибка Тогда
		    МассивЛогаСобытий.Добавить(Ошибка.ТекстОшибки);
			Возврат МассивСтруктур;
		КонецЕсли;
			
		МассивСтруктур = СозданиеДокументаПоШаблонуXML(ИсходящееДерево, ТипДокумента, МассивЛогаСобытий, ЭтоРегламентноеЗадание, ПодписатьФайл);
		
	КонецЕсли;
	
	Возврат МассивСтруктур; 
	
КонецФункции

Функция ПолучитьДокументыДляСозданияШаблона(МассивСтрок, ИмяДокументаИсточника, ТипДокумента, МассивЛогаСобытий) Экспорт
	
	ИмяСобытия = "Получение документов для создания шаблона";
	ЭКОМ_ОтправлятьНепроведенные = НастройкиПрочитатьНаСервере("ЭКОМ_ОтправлятьНепроведенные", Ложь);

	// Получение значений "через точку".
	ДокументыДляОтправки = Новый ТаблицаЗначений;
	
	СоответствиеТиповДокументов = Новый Соответствие;
	ИмяДокумента = Неопределено;
	Для Каждого ЭлементМассива Из МассивСтрок Цикл		
		СтрокаМассива = ЭлементМассива.Строка;
		Если СтрокаМассива.Свойство(ИмяДокументаИсточника) = Истина Тогда
			ДокументДляОтправки = СтрокаМассива[ИмяДокументаИсточника];
			Если ЗначениеЗаполнено(ДокументДляОтправки) Тогда
				ТекущийТипДокумента = ТипЗнч(ДокументДляОтправки);
				ИмяДокумента = СоответствиеТиповДокументов.Получить(ТекущийТипДокумента);			
				Если ИмяДокумента = Неопределено Тогда
					ИмяДокумента = ДокументДляОтправки.Метаданные().Имя;
					Если ДокументыДляОтправки.Колонки.Найти(ИмяДокумента) = Неопределено Тогда
						ДокументыДляОтправки.Колонки.Добавить(ИмяДокумента, Новый ОписаниеТипов("ДокументСсылка." + ИмяДокумента));
					КонецЕсли;
				КонецЕсли;
				
				НоваяСтрока = ДокументыДляОтправки.Добавить();
				НоваяСтрока[ИмяДокумента] = ДокументДляОтправки;
				
				СоответствиеТиповДокументов.Вставить(ТекущийТипДокумента, ИмяДокумента);
			Иначе
				ТекстЛогаСобытий = "Ошибка отправки документа. Отсутствует значение колонки документа для отправки - " + ИмяДокументаИсточника;
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			КонецЕсли;
		Иначе
			ТекстЛогаСобытий = "Ошибка отправки документа. Отсутствует значение колонки документа для отправки - " + ИмяДокументаИсточника;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
		КонецЕсли;								
	КонецЦикла;
	
	ТекстУсловия = "";
	Для каждого СтрТипа Из СоответствиеТиповДокументов Цикл	
		ИмяДокумента = СтрТипа.Значение;
		Если НЕ ЗначениеЗаполнено(ТекстУсловия) Тогда
			ТекстУсловия = "КОГДА НЕ Входящая." + ИмяДокумента + " = НЕОПРЕДЕЛЕНО
			|			И НЕ Входящая." + ИмяДокумента + " = ЗНАЧЕНИЕ(Документ." + ИмяДокумента + ".ПустаяСсылка)
			|			И НЕ Входящая." + ИмяДокумента + " ЕСТЬ NULL
			|			И НЕ Входящая." + ИмяДокумента + " = """"
			|		ТОГДА ВЫРАЗИТЬ(Входящая." + ИмяДокумента + " КАК Документ." + ИмяДокумента + ")";
		Иначе	
			ТекстУсловия = ТекстУсловия + Символы.ПС + "|КОГДА НЕ Входящая." + ИмяДокумента + " = НЕОПРЕДЕЛЕНО
			|			И НЕ Входящая." + ИмяДокумента + " = ЗНАЧЕНИЕ(Документ." + ИмяДокумента + ".ПустаяСсылка)
			|			И НЕ Входящая." + ИмяДокумента + " ЕСТЬ NULL
			|			И НЕ Входящая." + ИмяДокумента + " = """"
			|		ТОГДА ВЫРАЗИТЬ(Входящая." + ИмяДокумента + " КАК Документ." + ИмяДокумента + ")";
		КонецЕсли;		
	КонецЦикла;
	
	МассивДок = Новый Массив;
	МассивОтправленныхДок = Новый Массив;
	
	Если НЕ ДокументыДляОтправки.Количество() = 0 Тогда 		
		Запрос = Новый Запрос;			
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА Входящая.Документ = ""ТекстУсловия"" ТОГДА ИСТИНА
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ КАК ДокументДляОтправки
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&ДокументыДляОтправки КАК Входящая
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.ДокументДляОтправки КАК ДокументДляОтправки,
		|	ВТ.ДокументДляОтправки.Проведен КАК Проведен,
		|	"""" КАК Комментарий,
		|	ВТ.ДокументДляОтправки.Представление КАК Представление,
		|	ВТ.ДокументДляОтправки.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	ВТ КАК ВТ";
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КОГДА Входящая.Документ = ""ТекстУсловия"" ТОГДА ИСТИНА", ТекстУсловия);
		
		// Изменяем комментарий
		Если ТипДокумента = "DP_UVUTOCH" Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, """"" КАК Комментарий", "ВТ.ДокументДляОтправки.Комментарий КАК Комментарий");
		КонецЕсли;
			
		Запрос.УстановитьПараметр("ДокументыДляОтправки", ДокументыДляОтправки);
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если НЕ ЗначениеЗаполнено(Выборка.ДокументДляОтправки) Тогда
				ТекстЛогаСобытий = "Ошибка отправки документа. Отсутствует значение колонки документа для отправки - " + ИмяДокументаИсточника;
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
				
				Продолжить;
			КонецЕсли; 	
			
			ТекстОшибки = "";
			СтрокаМассива.Свойство("ТекстОшибки", ТекстОшибки);
			Если ЗначениеЗаполнено(ТекстОшибки) Тогда
				ТекстЛогаСобытий = "Ошибка отправки документа - " + Выборка.Представление + ". Есть ошибки(поле текст ошибки): " + ТекстОшибки;
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

				Продолжить;
			КонецЕсли;
			
			Если ТипДокумента = "CONDRA_ОТКЛОНИТЬ" Тогда
				ПричинаОтклонения = "";
				СтрокаМассива.Свойство("Информация", ПричинаОтклонения);
				Если НЕ ЗначениеЗаполнено(ПричинаОтклонения) Тогда
					ТекстЛогаСобытий = "Ошибка отправки документа - " + Выборка.Представление + ". Отсутствует значение колонки <<<Причина отклонения>>>";
					ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
					МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			Если ТипДокумента = "DP_UVUTOCH" Тогда
				Если НЕ ЗначениеЗаполнено(Выборка.Комментарий) Тогда
					ТекстЛогаСобытий = "Ошибка отправки документа - " + Выборка.Представление + ". Не заполнен текс комментария (уточнения).";
					ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
					МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

					Продолжить;	 
				КонецЕсли;	
			КонецЕсли;
			
			Если Найти(ТипДокумента, "DP_PRANNUL") > 0 Тогда
				ТекстПричиныАннулирования = "";
				СтрокаМассива.Свойство("ТекстПричиныАннулирования", ТекстПричиныАннулирования);
				Если НЕ ЗначениеЗаполнено(ТекстПричиныАннулирования) Тогда
					ТекстЛогаСобытий = "Ошибка отправки документа - " + Выборка.Представление + ". Не заполнен текст причины аннулирования!";
					ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
					МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

					Продолжить;	 
				КонецЕсли;	
			КонецЕсли;
			
			Если ТипДокумента = "DP_UVUTOCH_24" Тогда
				ТекстОтклоненияАннулирования = "";
				СтрокаМассива.Свойство("ТекстОтклоненияАннулирования", ТекстОтклоненияАннулирования);
				Если НЕ ЗначениеЗаполнено(ТекстОтклоненияАннулирования) Тогда
					ТекстЛогаСобытий = "Ошибка отправки документа - " + Выборка.Представление + ". Не заполнен текст отклонения аннулирования!";
					ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
					МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

					Продолжить;	 
				КонецЕсли;	
			КонецЕсли;
			
			Если Выборка.ПометкаУдаления Тогда
				ТекстЛогаСобытий = "Документ помечен на удаление - " + Выборка.Представление;
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

				Продолжить;
			КонецЕсли;
			
			Если ТипЗнч(Выборка.ДокументДляОтправки) = Тип("ДокументСсылка.ЭКОМ_Документы") Тогда
				Если Выборка.ДокументДляОтправки.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.Обработан Тогда 
					МассивДок.Добавить(Выборка.ДокументДляОтправки); 
				Иначе
					ТекстЛогаСобытий = "Документ " + Выборка.ДокументДляОтправки.ВидДокумента + " не обработан - " + Выборка.Представление;
					ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
					МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

				КонецЕсли;
				
			Иначе
				Если ЭКОМ_ОтправлятьНепроведенные = Истина Тогда			
					МассивДок.Добавить(Выборка.ДокументДляОтправки);
					
				Иначе				
					Если Выборка.Проведен Тогда 
						МассивДок.Добавить(Выборка.ДокументДляОтправки); 
					Иначе
						ТекстЛогаСобытий = "Документ 1С не проведен - " + Выборка.Представление;
						ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
						МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

					КонецЕсли;
					
				КонецЕсли;		
			КонецЕсли;
			
			ОтправитьПовторно = Неопределено;
			ЭлементМассива.Свойство("ОтправитьПовторно", ОтправитьПовторно); 
			Если ОтправитьПовторно = Истина Тогда			
				МассивОтправленныхДок.Добавить(Выборка.ДокументДляОтправки);		
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// Очищаем ранее отправленные квитанции
	Если МассивОтправленныхДок.Количество() > 0 Тогда
		ОчиститьИсториюПоОтпрДокументам(ТипДокумента, МассивОтправленныхДок);	
	КонецЕсли;

	Возврат МассивДок;
	
КонецФункции

Функция ПолучитьДанныеПоИсходящимНастройкам(ДанныеПоКолонкам, ТипДокумента, МассивЛогаСобытий) Экспорт
	
	ИмяСобытия = "Получение данных по исходящим документам";
	ДанныеПоНастройкам = Новый Соответствие;
	ДанныеПоНастройкам.Вставить("ИсходящееДерево", Неопределено);
	ДанныеПоНастройкам.Вставить("ИмяДокументаИсточника", "");
	
    Дерево = Новый ДеревоЗначений;
	Если ТипДокумента = "WHGOV_01_Исходящий" Тогда		
		Дерево = ПолучитьСтруктуруФайлаДанных("Исходящий WHGOV_01 (Отгрузка - сообщение ГО) - ПЭП Кладовщика");
		
	ИначеЕсли ТипДокумента = "WHGOU_04_Исходящий" Тогда		
		Дерево = ПолучитьСтруктуруФайлаДанных("Исходящий WHGOU_04 (Отгрузка - титул ГО) - КЭП ГО");
		
	ИначеЕсли ТипДокумента = "WHGPV_05_Исходящий" Тогда			
		Дерево = ПолучитьСтруктуруФайлаДанных("Исходящий WHGPV_05 (Приемка - сообщение ГП) - ПЭП");
		
	ИначеЕсли ТипДокумента = "WHGPU_08_Исходящий" Тогда			
		Дерево = ПолучитьСтруктуруФайлаДанных("Исходящий WHGPU_08 (Приемка - титул ГП) - Титул ГП");	 
		
	ИначеЕсли ТипДокумента = "ORDRSP" Тогда			
		Дерево = ПолучитьСтруктуруФайлаДанных("Исходящий ORDRSP (подтверждение заказа)");
		
	ИначеЕсли ТипДокумента = "DESADV" Тогда		
		Дерево = ПолучитьСтруктуруФайлаДанных("Исходящий DESADV (подтверждение отгрузки)");
		
	ИначеЕсли ТипДокумента = "INVOICE" Тогда			
		Дерево = ПолучитьСтруктуруФайлаДанных("Исходящий INVOICE (счёт)");
		
	ИначеЕсли ТипДокумента = "DESSCC" Тогда	
		Дерево = ПолучитьСтруктуруФайлаДанных("Исходящий DESSCC (уведомление об отгрузке)");
		
	ИначеЕсли ТипДокумента = "RETINS" Тогда	
		Дерево = ПолучитьСтруктуруФайлаДанных("Исходящий RETINS (инструкция о возврате)");
		
	ИначеЕсли ТипДокумента = "RETANN" Тогда	
		Дерево = ПолучитьСтруктуруФайлаДанных("Исходящий RETANN (уведомление о возврате)");
		
	ИначеЕсли ТипДокумента = "ORDER" ИЛИ ТипДокумента = "ORDERS" Тогда	
		Дерево = ПолучитьСтруктуруФайлаДанных("Исходящий ORDER (заказ поставщику)");
		
	ИначеЕсли ТипДокумента = "RETORD" Тогда	
		Дерево = ПолучитьСтруктуруФайлаДанных("Исходящий RETORD (обратный заказ)");
		
	ИначеЕсли ТипДокумента = "RECADV" Тогда	
		Дерево = ПолучитьСтруктуруФайлаДанных("Исходящий RECADV (уведомление о приеме)");
		
	ИначеЕсли ТипДокумента = "ЮЗД" Тогда 		
		Дерево = ПолучитьСтруктуруФайлаДанных("Исходящий ЮЗД - универсальный передаточный документ");
		
	ИначеЕсли ТипДокумента = "STATUS" Тогда
		Дерево = ПолучитьСтруктуруФайлаДанных("Исходящий STATUS (Служебный документ)");
		
	ИначеЕсли ТипДокумента = "CONDRA_ПРИНЯТЬ" Тогда
		Дерево = ПолучитьСтруктуруФайлаДанных("Исходящий CONDRA (Принятие)");
		
	ИначеЕсли ТипДокумента = "CONDRA_ОТКЛОНИТЬ" Тогда
		Дерево = ПолучитьСтруктуруФайлаДанных("Исходящий CONDRA (Отклонение)");
		
	ИначеЕсли ТипДокумента = "DP_PRANNUL_22_Сеть" Тогда
		Дерево = ПолучитьСтруктуруФайлаДанных("Исходящий DP_PRANNUL_22 (покупатель - аннулирование)");
		
	ИначеЕсли ТипДокумента = "DP_PRANNUL_22_Поставщик" Тогда
		Дерево = ПолучитьСтруктуруФайлаДанных("Исходящий DP_PRANNUL_22 (поставщик - аннулирование)");
		
	ИначеЕсли ТипДокумента = "DP_IZVPOL_23" Тогда
		Дерево = ПолучитьСтруктуруФайлаДанных("Исходящий DP_IZVPOL_23 (подтверждение аннулирования)");
		
	ИначеЕсли ТипДокумента = "DP_UVUTOCH_24" Тогда
		Дерево = ПолучитьСтруктуруФайлаДанных("Исходящий DP_UVUTOCH_24 (отклонение аннулирования)");

	ИначеЕсли ТипДокумента = "DP_REZRUISP" Тогда
		Дерево = ПолучитьСтруктуруФайлаДанных("Исходящий DP_REZRUISP (Акт выполненных работ)");
		
	ИначеЕсли ТипДокумента = "PRICAT" Тогда
		Дерево = ПолучитьСтруктуруФайлаДанных("Исходящий PRICAT");
		
	КонецЕсли;	
	
	СтруктураФайлаДанных = Дерево;
	
	ИмяДокументаИсточника = ПолучитьСинонимИсточника(СтруктураФайлаДанных, "Источник", МассивЛогаСобытий);	
	Если ИмяДокументаИсточника = Неопределено Тогда
		ТекстЛогаСобытий = "Не заполнен документ-источник! Смотрите гибкие настройки.";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
		Возврат ДанныеПоНастройкам;
	КонецЕсли;
			
	// Преобразуем старый алгоритм к новому
	Если ДанныеПоКолонкам.Получить(ИмяДокументаИсточника) = Неопределено Тогда
		
		ЭКОМ_ДеревоКонфигурации = НастройкиПрочитатьНаСервере("СлужебныйДеревоКонфигурации", Новый ДеревоЗначений, "Служебный", Истина);
		Если ЭКОМ_ДеревоКонфигурации.Строки.Найти(ИмяДокументаИсточника, "Синоним") = Неопределено Тогда 
			СтрокиДерева	= ЭКОМ_ДеревоКонфигурации.Строки.Найти(ИмяДокументаИсточника, "Имя");
		Иначе
			СтрокиДерева	= ЭКОМ_ДеревоКонфигурации.Строки.Найти(ИмяДокументаИсточника, "Синоним");
		КонецЕсли;
		
		СоответсвиеПоДокументам = Новый Соответствие;
		Если ТипДокумента = "ORDRSP" 
			ИЛИ ТипДокумента = "DESADV"
			ИЛИ ТипДокумента = "INVOICE" Тогда		 
			
			СоответсвиеПоДокументам.Вставить(ПолучитьТипДокументаЗаказаПокупателя(МассивЛогаСобытий), "ДокументЗаказа");
			СоответсвиеПоДокументам.Вставить(ПолучитьТипДокументаРеализации(МассивЛогаСобытий)      , "ДокументРеализации");
			СоответсвиеПоДокументам.Вставить("ЭКОМ_Документы"                                , "ЭКОМ_Документ_ORDER");
			
		ИначеЕсли ТипДокумента = "DESSCC" Тогда			 
			СоответсвиеПоДокументам.Вставить(ПолучитьТипДокументаЗаказаПокупателя(МассивЛогаСобытий)       , "ДокументЗаказа");
			СоответсвиеПоДокументам.Вставить(ПолучитьТипДокументаРеализации(МассивЛогаСобытий)             , "ДокументРеализации");
			СоответсвиеПоДокументам.Вставить(ПолучитьТипДокументаКорректировкаРеализации(МассивЛогаСобытий), "КорректировкаРеализации");
			СоответсвиеПоДокументам.Вставить("ЭКОМ_Документы"                                       , "ЭКОМ_Документ_ORDER");
			
		ИначеЕсли ТипДокумента = "RETINS" Тогда		 
			СоответсвиеПоДокументам.Вставить(ПолучитьТипДокументаЗаказаПокупателя(МассивЛогаСобытий)       , "ДокументЗаказа");
			СоответсвиеПоДокументам.Вставить(ПолучитьТипДокументаРеализации(МассивЛогаСобытий)             , "ДокументРеализации");
			СоответсвиеПоДокументам.Вставить(ПолучитьТипДокументаКорректировкаРеализации(МассивЛогаСобытий), "КорректировкаРеализации");
			СоответсвиеПоДокументам.Вставить(ПолучитьТипДокументаВозвратОтПокупателя(МассивЛогаСобытий)    , "ВозвратТоваровОтПокупателя");
			СоответсвиеПоДокументам.Вставить("ЭКОМ_Документы"                                       , "ЭКОМ_Документ_RETANN");
			
		ИначеЕсли ТипДокумента = "RETANN" Тогда		 
			СоответсвиеПоДокументам.Вставить(ПолучитьТипДокументаЗаказаПоставщика(МассивЛогаСобытий)        , "ДокументЗаказа");
			СоответсвиеПоДокументам.Вставить(ПолучитьТипДокументаПоступления(МассивЛогаСобытий)             , "ДокументПоступления");
			СоответсвиеПоДокументам.Вставить(ПолучитьТипДокументаКорректировкаПоступления(МассивЛогаСобытий), "КорректировкаПоступления");
			СоответсвиеПоДокументам.Вставить(ПолучитьТипДокументаВозвратТоваровПоставщику(МассивЛогаСобытий), "ВозвратТоваровПоставщику");
			СоответсвиеПоДокументам.Вставить("ЭКОМ_Документы"                                        , "ЭКОМ_Документ_DESADV");
			
		ИначеЕсли ТипДокумента = "ORDER" ИЛИ ТипДокумента = "ORDERS" Тогда	 
			СоответсвиеПоДокументам.Вставить(ПолучитьТипДокументаЗаказаПоставщика(МассивЛогаСобытий)        , "ДокументЗаказа");
			СоответсвиеПоДокументам.Вставить(ПолучитьТипДокументаПоступления(МассивЛогаСобытий)             , "ДокументПоступления");
						
		ИначеЕсли ТипДокумента = "RETORD" Тогда			 
			СоответсвиеПоДокументам.Вставить(ПолучитьТипДокументаЗаказаПокупателя(МассивЛогаСобытий), "ДокументЗаказа");
			СоответсвиеПоДокументам.Вставить(ПолучитьТипДокументаРеализации(МассивЛогаСобытий)      , "ДокументРеализации");
			
		ИначеЕсли ТипДокумента = "RECADV" Тогда	 
			
			СоответсвиеПоДокументам.Вставить(ПолучитьТипДокументаЗаказаПоставщика(МассивЛогаСобытий), "ДокументЗаказа");
			СоответсвиеПоДокументам.Вставить(ПолучитьТипДокументаПоступления(МассивЛогаСобытий)     , "ДокументПоступления");
			СоответсвиеПоДокументам.Вставить("ЭКОМ_Документы"                                       , "ЭКОМ_Документ_DESADV");
					
		ИначеЕсли ТипДокумента = "ON_SCHFDOPPR" 
			ИЛИ ТипДокумента = "ON_NSCHFDOPPR" Тогда // Подходит для типа ON_NSCHFDOPPRMARK, ON_NSCHFDOPPRPROS (определяется в гибких настройках)
			
			СоответсвиеПоДокументам.Вставить(ПолучитьТипДокументаСчетФактураВыданный(МассивЛогаСобытий), "ДокументСЧФ");
			
		КонецЕсли;
				
		ИмяДокументаИсточника = СоответсвиеПоДокументам.Получить(СтрокиДерева.Имя);
		
	КонецЕсли;

	ДанныеПоНастройкам.Вставить("ИсходящееДерево"      , Новый ХранилищеЗначения(Дерево, Новый СжатиеДанных(9)));
	ДанныеПоНастройкам.Вставить("ИмяДокументаИсточника", ИмяДокументаИсточника);
	
	Возврат ДанныеПоНастройкам;
	
КонецФункции

Функция ПолучитьИмяДокументаИсточника(ДанныеПоКолонкам, ТипДокумента, МассивЛогаСобытий) Экспорт
	
	ДанныеПоНастройкам = ПолучитьДанныеПоИсходящимНастройкам(ДанныеПоКолонкам, ТипДокумента, МассивЛогаСобытий);	
	Возврат ДанныеПоНастройкам["ИмяДокументаИсточника"];
	
КонецФункции

Функция ПолучитьСтруктуруОшибки()
	
	Структура = Новый Структура;
	Структура.Вставить("ЕстьОшибка" , Ложь);
	Структура.Вставить("КодОшибки"  , "");
	Структура.Вставить("ТекстОшибки", "");
	Возврат Структура;
	
КонецФункции

// Функция выполняет код, указанный в колонке Данные и заполняет результатом колонку ДанныеЗначения
//
// Параметры:
//  xstocuav9a  - ДеревоЗначений - шаблон документа (Дерево)
//  МассивДокументов  - Массив - коллекция отправляемых документов (Документ)
//  xjq6vt118r  - Строка - номер исправления УПД с формы (НомерИсправления)
//
// sksa17twrs = Строка
// x9b4sfry2s = Результат
// kpbnmbyjuh = Код
//
Процедура ПолучитьДанныеДокументов(Шаблон_xstocuav9a, Источник, НомерИсправления_xjq6vt118r, МассивЛогаСобытий, Ошибка)
	
	ИмяСобытия = "Получение данных по гибким настройкам";
	Если Ошибка = Неопределено Тогда
		Ошибка = ПолучитьСтруктуруОшибки();
	КонецЕсли;
		
	Для Каждого Строка_sksa17twrs Из Шаблон_xstocuav9a.Строки Цикл
		
		Если Строка_sksa17twrs.Использовать = Истина И НЕ Строка_sksa17twrs.Строки.Количество() = 0 Тогда // Может быть код для выполнения
			
			Если ЗначениеЗаполнено(Строка_sksa17twrs.Данные) Тогда // Есть код для выполнения
				
				x9b4sfry2s = Неопределено;
				kpbnmbyjuh = ?(ЗначениеЗаполнено(НомерИсправления_xjq6vt118r), 
				"НомерИсправления = " + НомерИсправления_xjq6vt118r + ";" + Символы.ПС + Строка_sksa17twrs.Данные,
				"НомерИсправления = """";" + Символы.ПС + Строка_sksa17twrs.Данные);  ;
				kpbnmbyjuh = СтрЗаменить(kpbnmbyjuh, "¶" 			          , Символы.ПС);
				kpbnmbyjuh = СтрЗаменить(kpbnmbyjuh, "Возврат "               , "x9b4sfry2s = ");
				
				ЛогСобытий = ""; // Используется в гибких настройках
				Отказ = Ложь;
				Попытка				
					Выполнить(kpbnmbyjuh);
					
					Если НЕ ТипЗнч(x9b4sfry2s) = Тип("ТаблицаЗначений") 
						ИЛИ Отказ = Истина Тогда 						
						ТекстЛогаСобытий 	= "Критическая ошибка. Обработка документов остановлена";
						ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
						МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
						
						Возврат;
						
					КонецЕсли;
					Строка_sksa17twrs.ДанныеЗначения = x9b4sfry2s.Скопировать();
					Если ЗначениеЗаполнено(ЛогСобытий) Тогда
						ТекстЛогаСобытий = ЛогСобытий; 
						ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Информация, ИмяСобытия);
						МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
					КонецЕсли;
					 
				Исключение
					ОшибкаТекст     	= ОписаниеОшибки();
					ТекстЛогаСобытий    = "Критическая ошибка. Обработка документов остановлена. Ошибка выполнения кода из шаблона документа.";
					ТекстЛогаСобытий 	= ТекстЛогаСобытий + Символы.ПС + ОшибкаТекст + Символы.ПС + ОписаниеСтрокиГибкихНастроек(Строка_sksa17twrs);
					ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
					МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
					
					Ошибка.ТекстОшибки 	= ОшибкаТекст;
					Ошибка.ЕстьОшибка = Истина;
					
					Возврат;
					
				КонецПопытки;
				
			КонецЕсли;
			
			ПолучитьДанныеДокументов(Строка_sksa17twrs, Источник, НомерИсправления_xjq6vt118r, МассивЛогаСобытий, Ошибка);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // ПолучитьДанныеДокуменов()

Процедура ОчиститьИсториюПоОтпрДокументам(ТипДокумента, МассивОтправленныхДок)

	Если ТипДокумента = "WHGOV_01_Исходящий" Тогда		
		
		МассивВидовДокументов = Новый Массив;
		МассивВидовДокументов.Добавить(Перечисления.ЭКОМ_ВидыДокументов.WHGOV_01_Исходящий);
		МассивВидовДокументов.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DRVGOV_02_Входящий);
		МассивВидовДокументов.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DRVGOU_03_Входящий);
		МассивВидовДокументов.Добавить(Перечисления.ЭКОМ_ВидыДокументов.WHGOU_04_Исходящий);
		МассивВидовДокументов.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DRVGPU_07_Входящий);
		МассивВидовДокументов.Добавить(Перечисления.ЭКОМ_ВидыДокументов.WHGPU_08_Входящий);

		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЭКОМ_Объекты_События.ВидДокумента,
		|	ЭКОМ_Объекты_События.Документ_Основание,
		|	ЭКОМ_Объекты_События.НаправлениеОбмена
		|ИЗ
		|	РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_События
		|ГДЕ
		|	ЭКОМ_Объекты_События.Документ_Основание В(&МассивОтправленныхДок)
		|	И ЭКОМ_Объекты_События.ВидДокумента В(&МассивВидовДокументов)";
		
		Запрос.УстановитьПараметр("МассивВидовДокументов", МассивВидовДокументов);
		Запрос.УстановитьПараметр("МассивОтправленныхДок", МассивОтправленныхДок);
		
		РезультатЗапроса = Запрос.Выполнить();			
		Если НЕ РезультатЗапроса.Пустой() Тогда
		     Выборка = РезультатЗапроса.Выбрать();
			 Пока Выборка.Следующий() Цикл
				 
				 МЗ_События = РегистрыСведений.ЭКОМ_Объекты_События.СоздатьМенеджерЗаписи();
				 МЗ_События.Документ_Основание  = Выборка.Документ_Основание;
				 МЗ_События.ВидДокумента        = Выборка.ВидДокумента;
				 МЗ_События.Прочитать();
				 МЗ_События.Удалить();
				 
				 НЗ_ЦепочкаДокументов = РегистрыСведений.ЭКОМ_ЦепочкиДокументовЭТРН.СоздатьНаборЗаписей();
				 НЗ_ЦепочкаДокументов.Отбор.Накладная.Установить(Выборка.Документ_Основание);
				 НЗ_ЦепочкаДокументов.Прочитать();
				 
				 Если НЕ НЗ_ЦепочкаДокументов.Количество() = 0 Тогда
					 Для Каждого ЗаписьНабора Из НЗ_ЦепочкаДокументов Цикл
						 ЗаписьНабора.Статус_DRVGOV_02 = Ложь; 
						 ЗаписьНабора.Статус_DRVGOU_03 = Ложь;
						 ЗаписьНабора.Статус_WHGOU_04  = Ложь;
						 ЗаписьНабора.Статус_DRVGPU_07 = Ложь;
						 ЗаписьНабора.Статус_WHGPU_08  = Ложь;
						 ЗаписьНабора.СостояниеОбмена  = Перечисления.ЭКОМ_Статусы.ПустаяСсылка();
					 КонецЦикла;	
					 
					 НЗ_ЦепочкаДокументов.Записать();
				 КонецЕсли;				
			 КонецЦикла;			 
		КонецЕсли;	
	КонецЕсли;

КонецПроцедуры

// Процедура формирует и отправляет XML документы по данным дерева значений
//
// Параметры:
//  Дерево  - ДеревоЗначений - макет документа XML, сожержащий в себе все формулы и значения для выгрузки
//  Сервер  - FTPСоединение - содинение с сервером по FTP
//	Тип	- Строка - тип отправляемого документа
//
Функция СозданиеДокументаПоШаблонуXML(Дерево, ТипДокумента, МассивЛогаСобытий, ЭтоРегламентноеЗадание, ПодписатьФайл)
	
	ИмяСобытия = "Создание XML документов по шаблону, модуль общего назначения";
	МассивСтруктур = Новый Массив;
	
	ВременныйКаталог = ПутьВременногоКаталогаЭКОМ("Send_xml");	
	
	КаталогВременный = ЭКОМ_СоздатьКаталогПроверитьНаЗапись(ВременныйКаталог, МассивЛогаСобытий);	
	Если КаталогВременный = Неопределено Тогда		
		Возврат МассивСтруктур;		
	КонецЕсли;
	
	Если Дерево.Строки.Количество() = 1 Тогда // По определению у нас должен быть только один макет для указанного типа документа
		ДокументыКоллекция = Дерево.Строки.Получить(0).ДанныеЗначения;
		Если НЕ ТипЗнч(ДокументыКоллекция) = Тип("ТаблицаЗначений") Тогда // И в корневой строке в столбце ДанныеЗначения должна быть таблица значений с документами
			Возврат МассивСтруктур;
		КонецЕсли;
	Иначе
		Возврат МассивСтруктур;
	КонецЕсли;
	
	Для Каждого Документ Из ДокументыКоллекция Цикл
		
		XMLДокумент        	= Новый ЗаписьXML;
		
		КодировкаXML = "UTF-8";
		Если Найти(ТипДокумента, "CONDRA") = 0  // Все подписанные файлы, кроме CONDRA
			И ПодписатьФайл = Истина Тогда
		    КодировкаXML = "WINDOWS-1251";
		КонецЕсли;
		
		ПараметрыЗаписиXML 	= Новый ПараметрыЗаписиXML(КодировкаXML, "1.0", Истина, Ложь, Символы.Таб); 
		XMLДокумент.УстановитьСтроку(КодировкаXML);
		XMLДокумент.ЗаписатьОбъявлениеXML();
		
		Служебные = СтрокаДереваВXML(Новый Структура("Документ", Документ), XMLДокумент, Дерево,,, Документ, МассивЛогаСобытий); // Создание файла XML					
		Если Служебные = Неопределено Тогда
			Возврат МассивСтруктур;
		ИначеЕсли ТипЗнч(Служебные) = Тип("Структура") 
			И Служебные.Отказ = Истина Тогда					
			Продолжить;
		КонецЕсли;
		
		ФайлИмя = Неопределено;
		Служебные.Свойство("ФайлИмя", ФайлИмя);
		Если НЕ ЗначениеЗаполнено(ФайлИмя) Тогда
			ТекстЛогаСобытий = "В гибких настройках не заполнены служебные поля!";
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		     Возврат МассивСтруктур;
		КонецЕсли;
		
		СтруктураEDI = Новый Структура;
		СтруктураEDI.Вставить("СтрокаXML"     , Служебные.СтрокаXML);
		СтруктураEDI.Вставить("КодировкаФайла", КодировкаXML);
		
		Если НЕ ЗначениеЗаполнено(Служебные.СтрокаXML) Тогда	
			ТекстЛогаСобытий = "Файл не сформирован - " + ФайлИмя;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

			Продолжить;
		ИначеЕсли Найти(ТипДокумента, "CONDRA") > 0 Тогда
			СтруктураEDI.Вставить("Идентификатор", Служебные.Идентификатор);
			СтруктураEDI.Вставить("Организация"  , Служебные.Организация);
			СтруктураEDI.Вставить("Статус"       , Служебные.Статус);
			
			ТипФайла = "CONDRA";
			СтруктураEDI.Вставить("ИмяФайлаXML", ФайлИмя);
			СтруктураEDI.Вставить("Сообщение"  , "");
			СтруктураEDI.Вставить("Отправлен"  , "");
			
		Иначе
			
			Статус = Перечисления.ЭКОМ_Статусы.Отправлен;
			
			Если Служебные.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_PRANNUL_22 Тогда	
				ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_PRANNUL_22;
				ТипФайла     = "DP_PRANNUL";
				
			ИначеЕсли Служебные.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_IZVPOL_23 Тогда	
				ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_IZVPOL_23;
				ТипФайла     = "DP_IZVPOL_23";
				
			ИначеЕсли Служебные.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_UVUTOCH_24 Тогда	
				ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_UVUTOCH_24;
				ТипФайла     = "DP_UVUTOCH_24";

			ИначеЕсли Найти(Служебные.Идентификатор, "ORDER") = 1 Тогда
				ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ORDER_Исходящий;
				ТипФайла     = "ORDER";
				
			ИначеЕсли Найти(Служебные.Идентификатор, "ORDRSP") = 1 Тогда	
				ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ORDRSP_Исходящий;
				ТипФайла     = "ORDRSP";
				
			ИначеЕсли Найти(Служебные.Идентификатор, "DESADV") = 1 Тогда	
				ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DESADV_Исходящий;
				ТипФайла     = "DESADV";
				
				// Записываем в цепочку поставщика номер и дату
				ПараметрыОтбора = Новый Структура;
				ПараметрыОтбора.Вставить("Накладная", Служебные.Ссылка);
				
				ПараметрыЗаписи = Новый Структура;
				ПараметрыЗаписи.Вставить("DESADVNUMBER", Документ.NUMBER);
				ПараметрыЗаписи.Вставить("DESADVDATE"  , ДатаИзXML_в_1С(Документ.DATE));
				
				ЭКОМ_ЦепочкиДокументовПоставщикаЗаписать(ПараметрыОтбора, ПараметрыЗаписи);
							
			ИначеЕсли Найти(Служебные.Идентификатор, "RECADV") = 1 Тогда	
				ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.RECADV_Исходящий;
				ТипФайла     = "RECADV";
			ИначеЕсли Найти(Служебные.Идентификатор, "RETANN") = 1 Тогда	
				ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.RETANN_Исходящий;
				ТипФайла     = "RETANN";
			ИначеЕсли Найти(Служебные.Идентификатор, "RETINS") = 1 Тогда	
				ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.RETINS_Исходящий;
				ТипФайла     = "RETINS";	
			ИначеЕсли Найти(Служебные.Идентификатор, "DESSCC") = 1 Тогда	
				ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DESSCC_Исходящий;
				ТипФайла     = "DESSCC";
			ИначеЕсли Найти(Служебные.Идентификатор, "INVOICE") = 1 Тогда	
				ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.INVOICE;
				ТипФайла     = "INVOICE";
			ИначеЕсли Найти(Служебные.Идентификатор, "DP_UVUTOCH") = 1 Тогда	
				ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_UVUTOCH_09;
				Статус       = Перечисления.ЭКОМ_Статусы.Отправлен;
				ТипФайла     = "DP_UVUTOCH";
			ИначеЕсли Найти(Служебные.Идентификатор, "ON_SCHFDOPPR") = 1  Тогда	
				ВидДокумента = Служебные.ВидДокумента;
				ТипФайла     = "ON_SCHFDOPPR";
			ИначеЕсли Найти(Служебные.Идентификатор, "ON_KORSCHFDOPPR") = 1 Тогда	
				ВидДокумента = Служебные.ВидДокумента;
				ТипФайла     = "ON_KORSCHFDOPPR";
			ИначеЕсли Найти(Служебные.Идентификатор, "ON_NSCHFDOPPRMARK") = 1  Тогда	
				ВидДокумента = Служебные.ВидДокумента;
				ТипФайла     = "ON_NSCHFDOPPRMARK";
				
			ИначеЕсли Найти(Служебные.Идентификатор, "ON_NSCHFDOPPRPROS") = 1  Тогда	
				ВидДокумента = Служебные.ВидДокумента;
				ТипФайла     = "ON_NSCHFDOPPRPROS";
			ИначеЕсли Найти(Служебные.Идентификатор, "ON_NSCHFDOPPR") = 1  Тогда	
				ВидДокумента = Служебные.ВидДокумента;
				ТипФайла     = "ON_NSCHFDOPPR";
				
			ИначеЕсли Служебные.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.WHGOV_01_Исходящий  Тогда	
				ВидДокумента = Служебные.ВидДокумента;
				ТипФайла     = "WHGOV_01_Исходящий";
				
			ИначеЕсли Служебные.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.WHGOU_04_Исходящий  Тогда	
				ВидДокумента = Служебные.ВидДокумента;
				ТипФайла     = "WHGOU_04_Исходящий";
				
			ИначеЕсли Служебные.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.WHGPV_05_Исходящий Тогда	
				ВидДокумента = Служебные.ВидДокумента;
				ТипФайла     = "WHGPV_05_Исходящий";
				
			ИначеЕсли Служебные.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.WHGPU_08_Исходящий Тогда	
				ВидДокумента = Служебные.ВидДокумента;
				ТипФайла     = "WHGPU_08_Исходящий";
				
			ИначеЕсли Служебные.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.WHGPU_08_Исходящий Тогда	
				ВидДокумента = Служебные.ВидДокумента;
				ТипФайла     = "WHGPU_08_Исходящий";
				
			ИначеЕсли Найти(Служебные.Идентификатор, "STATUS") = 1 Тогда	
				ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.STATUS;
				ТипФайла     = "STATUS";
				
			ИначеЕсли Найти(Служебные.Идентификатор, "DP_REZRUISP") = 1 Тогда	
				ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_REZRUISP_Исходящий;
				ТипФайла     = "DP_REZRUISP";
				
			ИначеЕсли Найти(Служебные.Идентификатор, "PRICAT") = 1 Тогда	
				ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.PRICAT_Исходящий;
				ТипФайла     = "PRICAT";
	
			КонецЕсли;
			
			СтруктураEDI.Вставить("Документ"              , Служебные.Ссылка);
			СтруктураEDI.Вставить("СтруктураДокумента"    , Служебные);
			СтруктураEDI.Вставить("Отправлен"             , Ложь);
			СтруктураEDI.Вставить("Сообщение"             , "");
			СтруктураEDI.Вставить("ЗаказДата"             , Служебные.ЗаказДата);					
			СтруктураEDI.Вставить("ЗаказНомер"            , Служебные.ЗаказНомер);
			СтруктураEDI.Вставить("Контрагент"            , Служебные.Контрагент);
			СтруктураEDI.Вставить("Организация"           , Служебные.Организация);
			СтруктураEDI.Вставить("ВидДокумента"          , ВидДокумента);
			СтруктураEDI.Вставить("ИмяФайлаXML"           , ФайлИмя);
			СтруктураEDI.Вставить("Статус"                , Статус);
			СтруктураEDI.Вставить("ТипФайла"              , ТипФайла);
			СтруктураEDI.Вставить("ИдентификаторИспр"     , ?(Служебные.Свойство("ИдентификаторИспр"), Служебные.ИдентификаторИспр, ""));							
			
		КонецЕсли;
		
		Если ПодписатьФайл = Истина Тогда 																				
			ДанныеПоОрганизации = ЭКОМ_GLN_Прочитать(Служебные.Организация);
			Если ДанныеПоОрганизации.СведенияЕсть = Ложь Тогда
				ТекстЛогаСобытий = "Нет данных о сертификате электронной подписи.";
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

				Продолжить;
			КонецЕсли;
			СтруктураEDI.Вставить("ДанныеСертификатаЭКОМ", ДанныеПоОрганизации.Сертификат);
			СтруктураEDI.Вставить("СертификатНаСервере"  , ДанныеПоОрганизации.Сертификат.СертификатНаСервере);
			
		КонецЕсли;
		
		МассивСтруктур.Добавить(СтруктураEDI);
		
	КонецЦикла;
		
	Возврат МассивСтруктур;
	
КонецФункции // СформироватьОтправитьXML()

// Функция получает настройки для выгрузки данных из документа 1С в файл XML
//
// Параметры
//  ТипТранзакции  	- Строка - тип исходящего документа
//
// Возвращаемое значение:
//   ДеревоЗначений	- содержит макет структуры исходящего документа с пользовательскими настройками
//
Функция ПолучитьСтруктуруФайлаДанных(ТипТранзакции) 
	
	ЭКОМ_СтруктураФайлаXMLВходящие 	= НастройкиПрочитатьНаСервере("СтруктураФайлаXMLВходящие", 	Новый ДеревоЗначений);
	ЭКОМ_СтруктураФайлаXMLИсходящие	= НастройкиПрочитатьНаСервере("СтруктураФайлаXMLИсходящие", Новый ДеревоЗначений);
	ЭКОМ_СтруктураФайлаXMLДокументы = НастройкиПрочитатьНаСервере("СтруктураФайлаXMLДокументы", Новый ДеревоЗначений);
	
	// Поиск по вкладке Исходящие.
	Результат	= ЭКОМ_СтруктураФайлаXMLИсходящие.Скопировать();
	Если НЕ Результат.Колонки.Найти("ТипТранзакции") = Неопределено Тогда
		Индекс 	= Результат.Строки.Количество() - 1;
		Пока НЕ Индекс < 0 Цикл
			Строка = Результат.Строки.Получить(Индекс);
			Если НЕ Строка.ТипТранзакции = ТипТранзакции Тогда
				Результат.Строки.Удалить(Строка);
			КонецЕсли;
			Индекс = Индекс - 1;
		КонецЦикла;
	КонецЕсли;
	
	// Поиск по вкладке Входящие.
	Если Результат.Строки.Количество() = 0 Тогда
		Результат	= ЭКОМ_СтруктураФайлаXMLВходящие.Скопировать();
		Если НЕ Результат.Колонки.Найти("ТипТранзакции") = Неопределено Тогда
			Индекс 		= Результат.Строки.Количество() - 1;
			Пока НЕ Индекс < 0 Цикл
				Строка = Результат.Строки.Получить(Индекс);
				Если НЕ Строка.ТипТранзакции = ТипТранзакции Тогда
					Результат.Строки.Удалить(Строка);
				КонецЕсли;
				Индекс = Индекс - 1;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	//Поиск по вкладке Документы.
	Если Результат.Строки.Количество() = 0 Тогда		
		Результат	= ЭКОМ_СтруктураФайлаXMLДокументы.Скопировать();
		Если НЕ Результат.Колонки.Найти("Кнопка") = Неопределено Тогда
			Индекс 		= Результат.Строки.Количество() - 1;
			Пока НЕ Индекс < 0 Цикл
				Строка = Результат.Строки.Получить(Индекс);
				Если НЕ Строка.Кнопка = ТипТранзакции Тогда
					Результат.Строки.Удалить(Строка);
				КонецЕсли;
				Индекс = Индекс - 1;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Индекс = Результат.Строки.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Строка = Результат.Строки.Получить(Индекс);
		Если Не Строка.Использовать Тогда
			Результат.Строки.Удалить(Строка);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	
	Возврат ?(Результат.Строки.Количество() = 0, Новый ДеревоЗначений, Результат);
	
КонецФункции // ПолучитьСтруктуруФайлаДанных()

// Функция возвращает строковое представление пути к указанному объекту конфигурации
//
// Параметры:
//  Дерево  	- ДеревоЗначений, СтрокаДереваЗначений - объект, хранящий структуру документа
//  ВидОбъекта  - Число - признак пути к объекту. Возможные значения: 1 - путь к документу, 2 - путь к табличной части документа
//  Колонка  	- Строка - имя колонки дерева значений, которая содержит синоним объекта конфигурации
//
// Возвращаемое значение:
//   Строка   - строковое представление пути к объекту дерева конфигурации
//
Функция ПолучитьСинонимИсточника(Дерево, Колонка, МассивЛогаСобытий)  // Приемник

	Если ТипЗнч(Дерево) = Тип("ДеревоЗначений") Тогда
		Если Дерево.Строки.Количество() = 0 Тогда
			Возврат Неопределено;
		Иначе
			Дерево = Дерево.Строки.Получить(0);
		КонецЕсли;
	ИначеЕсли НЕ ТипЗнч(Дерево) = Тип("СтрокаДереваЗначений") Тогда
		ТекстЛогаСобытий = "Ошибка в параметре функции.";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, "Получение синонима источника");
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Возврат Дерево[Колонка];
	
КонецФункции

Функция ОписаниеСтрокиГибкихНастроек(СтрокаНастроек, ВыполняемыйКод = Неопределено, Результат = "", ИмяНастройки = "ТипТранзакции") 
	
	Если ТипЗнч(СтрокаНастроек) <> Тип("СтрокаДереваЗначений") Тогда
		Возврат Результат;
	КонецЕсли;
	
	Владелец = СтрокаНастроек.Владелец();
	
	ИмяИсточника = "";
	ЗначениеИсточникаЗаполнено = Ложь;
	КолонкаИсточника = Владелец.Колонки.Найти("Источник");
	Если НЕ КолонкаИсточника = Неопределено Тогда
	    ИмяИсточника = СтрокаНастроек.Источник;
		Если ЗначениеЗаполнено(СтрокаНастроек.Источник) Тогда
		     ЗначениеИсточникаЗаполнено = Истина;
		КонецЕсли;
	КонецЕсли;
		
	ИмяПриемника = "";
	ЗначениеПриемникаЗаполнено = Ложь;
	КолонкаПриемник = Владелец.Колонки.Найти("Приемник");
	Если НЕ КолонкаПриемник = Неопределено Тогда
	    ИмяПриемника = СтрокаНастроек.Приемник;
		Если ЗначениеЗаполнено(СтрокаНастроек.Приемник) Тогда
		     ЗначениеПриемникаЗаполнено = Истина;
		КонецЕсли;
	КонецЕсли;

	Попытка
		ИмяНастройкиИзСтроки = СтрокаНастроек[ИмяНастройки];
	Исключение
		ИмяНастройки = ?(ИмяНастройки = "ТипТранзакции", "Кнопка", "ТипТранзакции");
	КонецПопытки;
	Если ЗначениеЗаполнено(СтрокаНастроек[ИмяНастройки]) = Ложь Тогда
		Если ТипЗнч(СтрокаНастроек.Родитель) = Тип("СтрокаДереваЗначений") Тогда
			Если ЗначениеИсточникаЗаполнено = Истина
				ИЛИ ЗначениеПриемникаЗаполнено = Истина
				И ЗначениеЗаполнено(Результат) = Ложь Тогда
				Результат = Результат + Символы.ПС + "Ошибка в коде настроек в строке вложенность: " + Строка(СтрокаНастроек.Уровень()) + Символы.ПС + 
				"Источник [" + ИмяИсточника + "], " + 
				"Приемник [" + ИмяПриемника + "]" + Символы.ПС
				;
			КонецЕсли;
			Результат = ОписаниеСтрокиГибкихНастроек(СтрокаНастроек.Родитель, "", Результат);
		Иначе
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаНастроек[ИмяНастройки]) = Истина Тогда
		Результат = Результат + "Место в гибких настройках: " + Символы.ПС + 
		"Действие [" + СтрокаНастроек[ИмяНастройки] + "], " + 
		"Источник [" + ИмяИсточника + "], " + 
		"Приемник [" + ИмяПриемника + "]";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Функция обходит дерево значений и заполняет XMLДокумент данными документа. Данные шапки и товаров получаем ранее. Здесь выполняется код обращения к данным из СтрокаТаблицыЗначений шапки и строк товаров.
//
// Параметры:
//  Документ  	 - СтрокаТаблицыЗначений - данные документа для записи в XML
//  XMLДокумент  - ЗаписьXML - запись XML, в которую будут записаны все данные
//  Дерево       - ДеревоЗначений - макет документа XML, сожержащий в себе все формулы и значения для выгрузки
//  ДанныеСтроки - СтрокаТаблицыЗначений, Неопределено - переменная используется внутри текущего метода для передачи строки товара для записи в XML. Не передается извне.
//  ПропуститьСтроку - Булево - флаг, определяющий пропуск следующей строки дерева. Используется для работы с товарами. Не передается извне.
Функция СтрокаДереваВXML(НаборДанных, XMLДокумент, Дерево, ДанныеСтроки = Неопределено, ПропуститьСтроку = Ложь, Документ, МассивЛогаСобытий, ТребуютЗаполнения = "")
	
	ИмяСобытия = "Формирование строки XML для документа";
	Если ПропуститьСтроку Тогда // Пропускаем строку товаров, так как ее уже отработали
		ПропуститьСтроку = Ложь;
	Иначе
		
		Для каждого СтрокаДЗ из Дерево.Строки Цикл
			
			СтрокаРодитель	= СтрокаДЗ;
			Использовать	= Истина;
			
			Пока НЕ СтрокаРодитель = Неопределено Цикл
				Использовать 	= ?(СтрокаРодитель.Использовать = Истина, Использовать, Ложь);
				СтрокаРодитель 	= СтрокаРодитель.Родитель;
			КонецЦикла;
			
			Если Использовать Тогда
				
				ВыводитьСтроку = Истина;
				
				// Проверка наличия условий для вывода ветки.
				Если НЕ СтрокаДЗ.Уровень() = 0 И ЗначениеЗаполнено(СтрокаДЗ.Служебные) Тогда
					Попытка
						УсловиеВыводитьСтроку = СтрЗаменить(СтрокаДЗ.Служебные, "Возврат ", "ВыводитьСтроку = ");
						Для Каждого Данные Из НаборДанных Цикл
							ПозицияКлюча = Найти(УсловиеВыводитьСтроку, Данные.Ключ);
							Если НЕ ПозицияКлюча = 0 Тогда
								УсловиеВыводитьСтроку = Лев(УсловиеВыводитьСтроку, ПозицияКлюча - 1)  + "НаборДанных." 
								+ Прав(УсловиеВыводитьСтроку, СтрДлина(УсловиеВыводитьСтроку) - ПозицияКлюча + 1);
							КонецЕсли;
						КонецЦикла;
						
						Выполнить(УсловиеВыводитьСтроку);
					Исключение
						Описание  = ОписаниеСтрокиГибкихНастроек(СтрокаДЗ);
						ТекстЛогаСобытий    = "Критическая ошибка. Обработка документов остановлена" + Символы.ПС + ОписаниеОшибки() + Символы.ПС + Описание;
						ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
						МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
				
						Возврат Неопределено;
						
					КонецПопытки;
				КонецЕсли;
				
				Если ВыводитьСтроку Тогда
					
					Если НЕ СтрокаДЗ.Строки.Количество() = 0 ИЛИ (ТипЗнч(СтрокаДЗ.Атрибуты) = Тип("СписокЗначений") И НЕ СтрокаДЗ.Атрибуты.Количество() = 0) Тогда
						XMLДокумент.ЗаписатьНачалоЭлемента(СтрокаДЗ.Приемник); // Первый раз тег записывается без значения (как будто  него есть подчиненные строки)
					КонецЕсли;
					
					Если СтрокаДЗ.Строки.Количество() = 0 Тогда // Сначала записываем атрибуты, а после данные (только для подчиненных строк)
						ЗаписатьАтрибутыXML(XMLДокумент, СтрокаДЗ, Документ, ДанныеСтроки, МассивЛогаСобытий, ТребуютЗаполнения);
					КонецЕсли;
					
					// Запись значений.
					Если НЕ СтрокаДЗ.Уровень() = 0 И ТипЗнч(СтрокаДЗ.Данные) = Тип("Строка") Тогда 
						
						Если (ТипЗнч(СтрокаДЗ.Связи) = Тип("СписокЗначений") ИЛИ ТипЗнч(СтрокаДЗ.Связи) = Тип("Соответствие"))
							И СтрокаДЗ.Связи.Количество() > 0 Тогда // Имеем дело с списком значений
							
							// Формируем структуру отбора строк товаров для текущего документа.
							Отборы = Новый Структура;
							Для Каждого Связь Из СтрокаДЗ.Связи Цикл
								Попытка
									Ключ = СтрЗаменить(Связь.Представление, СтрокаДЗ.Приемник + "." , "");
									Значение = Неопределено;
									Выполнить("Значение = НаборДанных." + Связь.Значение);
									Отборы.Вставить(Ключ, Значение);
								Исключение
									Описание = ОписаниеСтрокиГибкихНастроек(Связь);
									ТекстЛогаСобытий = "Ошибка установки связи. Обработка документов остановлена" + Символы.ПС + ОписаниеОшибки() + Символы.ПС + Описание;									
									ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
									МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

									Возврат Неопределено;
									
								КонецПопытки;
							КонецЦикла;
							
							// Обходим строки текущего документа.
							СтрокиТовары = СтрокаДЗ.ДанныеЗначения.НайтиСтроки(Отборы);
							Счетчик = 0;
							Для Каждого ДанныеСтроки Из СтрокиТовары Цикл
								
								Счетчик = Счетчик + 1;
								
								ЗаписатьАтрибутыXML(XMLДокумент, СтрокаДЗ, Документ, ДанныеСтроки, МассивЛогаСобытий, ТребуютЗаполнения);
								
								// Новый Функционал с сохранением текущей строки в структуру (для иерархии более 2-х таблиц)
								Если НЕ НаборДанных.Свойство(СтрокаДЗ.Приемник) Тогда
									НаборДанных.Вставить(СтрокаДЗ.Приемник, Неопределено);
								КонецЕсли;
								НаборДанных[СтрокаДЗ.Приемник] = ДанныеСтроки;
								// Конец нового функционала
								
								СтрокаДереваВXML(НаборДанных, XMLДокумент, СтрокаДЗ, ДанныеСтроки, ПропуститьСтроку, Документ, МассивЛогаСобытий, ТребуютЗаполнения); // Далее проверяем, если заполнена перем ДанныеСтроки, работаем как со строкой
								// Закрываем/открываем теги для каждой строки, кроме последней (она закроется ниже, а открывать более ничего не нужно).
								Если НЕ Счетчик = СтрокиТовары.Количество() Тогда
									XMLДокумент.ЗаписатьКонецЭлемента();
									XMLДокумент.ЗаписатьНачалоЭлемента(СтрокаДЗ.Приемник);
								КонецЕсли;
								
							КонецЦикла;
							
							ДанныеСтроки 		= Неопределено; // Очищаем данные строки, чтобы процедура не пыталась обработать последующий код как строку
							ПропуститьСтроку 	= Истина;
							
						ИначеЕсли НЕ ПустаяСтрока(СтрокаДЗ.Данные) Тогда
							Значение = "";
							Попытка
								Выполнить("Значение = НаборДанных." + СтрокаДЗ.Данные + ";");
							Исключение
								Описание            = ОписаниеСтрокиГибкихНастроек(СтрокаДЗ);
								ТекстЛогаСобытий    = "Критическая ошибка. Обработка документов остановлена." + Символы.ПС + ОписаниеОшибки() + Символы.ПС + Описание;					
								ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
								МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
								
								Возврат Неопределено;
								
							КонецПопытки;
							
							Если ТипЗнч(Значение) = Тип("Структура") 
								ИЛИ ТипЗнч(Значение) = Тип("Соответствие") Тогда // Структура(в старых настройках) или Соответствие(в новых) предназначена для инфополей
								
								// Удаление пустых значений.
								МассивУдаляемых = Новый Массив;
								Для Каждого ИнфоПоле Из Значение Цикл
									Если НЕ ЗначениеЗаполнено(ИнфоПоле.Значение) Тогда
										МассивУдаляемых.Добавить(ИнфоПоле.Ключ);
									КонецЕсли;
								КонецЦикла;
								
								Для Каждого Удаляемый Из МассивУдаляемых Цикл
									Значение.Удалить(Удаляемый);
								КонецЦикла;
								
								Счетчик = Значение.Количество();
								Для Каждого ИнфоПоле Из Значение Цикл
									XMLДокумент.ЗаписатьАтрибут("Идентиф", 	Строка(ИнфоПоле.Ключ));
									XMLДокумент.ЗаписатьАтрибут("Значен", 	Строка(ИнфоПоле.Значение)); // Проверить заполненность
									Если Счетчик > 1 Тогда
										XMLДокумент.ЗаписатьКонецЭлемента();
										XMLДокумент.ЗаписатьНачалоЭлемента(СтрокаДЗ.Приемник);
									КонецЕсли;
									Счетчик = Счетчик - 1;
								КонецЦикла;
														
							ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда // Массив предназначен для маркировки
								
								// Маркировка
								Счетчик = Значение.Количество();
								Для Каждого СтрокаМаркировки Из Значение Цикл
									ИдентТрансУпак = "";
									СтрокаМаркировки.Свойство("ИдентТрансУпак", ИдентТрансУпак);
									ИдентТрансУпак = ?(ЗначениеЗаполнено(ИдентТрансУпак), Строка(ИдентТрансУпак), "");
									Если ЗначениеЗаполнено(ИдентТрансУпак)  Тогда
									     XMLДокумент.ЗаписатьАтрибут("ИдентТрансУпак", 	Строка(ИдентТрансУпак));										 
									КонецЕсли;
									
									ЗаполненКИЗ     = Ложь;
									ЗаполненНомУпак = Ложь;
									ЗначенияКодов = "";
                                    СтрокаМаркировки.Свойство("ЗначенияКодов", ЗначенияКодов);
                                    ЗначенияКодов = ?(ЗначениеЗаполнено(ЗначенияКодов), ЗначенияКодов, Новый Массив);
									Для каждого СтрокаКодов Из СтрокаМаркировки.ЗначенияКодов Цикл
										КИЗ = "";
										СтрокаКодов.Свойство("КИЗ", КИЗ);
										КИЗ = ?(ЗначениеЗаполнено(КИЗ), Строка(КИЗ), "");
										Если ЗначениеЗаполнено(КИЗ) Тогда
											XMLДокумент.ЗаписатьНачалоЭлемента("КИЗ");
											XMLДокумент.ЗаписатьТекст(КИЗ);
											XMLДокумент.ЗаписатьКонецЭлемента();
											ЗаполненКИЗ = Истина;
										КонецЕсли;
										
										НомУпак = "";
										СтрокаКодов.Свойство("НомУпак", НомУпак);
										НомУпак = ?(ЗначениеЗаполнено(НомУпак), Строка(НомУпак), "");
										Если ЗначениеЗаполнено(НомУпак) Тогда
											XMLДокумент.ЗаписатьНачалоЭлемента("НомУпак");
											XMLДокумент.ЗаписатьТекст(НомУпак);
											XMLДокумент.ЗаписатьКонецЭлемента();
											ЗаполненНомУпак = Истина;
										КонецЕсли;						
									КонецЦикла;
									
									Если ЗаполненКИЗ = Истина 
										И ЗаполненНомУпак = Истина Тогда
										ТребуютЗаполнения = ТребуютЗаполнения + ?(ПустаяСтрока(ТребуютЗаполнения), "", Символы.ПС) 
										                    + "- " + Строка(СтрокаДЗ.Приемник) + " должен быть заполнен КИЗ или НомУпак (два тега одновременно не могут быть заполнены)!";
									КонецЕсли;
									
									Если Счетчик > 1 Тогда
										XMLДокумент.ЗаписатьКонецЭлемента();
										XMLДокумент.ЗаписатьНачалоЭлемента(СтрокаДЗ.Приемник);
									КонецЕсли;
									Счетчик = Счетчик - 1;
														
								КонецЦикла;
															
							ИначеЕсли ТипЗнч(Значение) = Тип("СписокЗначений") Тогда // Для всех
																						
								Для Каждого СтрокаМассива Из Значение Цикл
									
									// Теги <КолНеттоВс>10</КолНеттоВс>
									Если ТипЗнч(СтрокаМассива.Значение) = Тип("Строка") Тогда
										
										XMLДокумент.ЗаписатьНачалоЭлемента(СтрокаДЗ.Приемник);
										XMLДокумент.ЗаписатьТекст(СокрЛП(СтрокаМассива.Значение));
										XMLДокумент.ЗаписатьКонецЭлемента();
										
								    // Атрибуты <АдрРФ Индекс="117630" КодРегион="77" Город="г Москва" Улица="Профсоюзная"/> 
									ИначеЕсли  ТипЗнч(СтрокаМассива.Значение) = Тип("Структура") Тогда
										XMLДокумент.ЗаписатьНачалоЭлемента(СтрокаДЗ.Приемник);
										Для каждого ЭлСтруктуры Из СтрокаМассива.Значение Цикл
											
											Если ЗначениеЗаполнено(ЭлСтруктуры.Значение) Тогда
												XMLДокумент.ЗаписатьАтрибут(ЭлСтруктуры.Ключ, 	СокрЛП(ЭлСтруктуры.Значение));
											КонецЕсли;	
										КонецЦикла;
										XMLДокумент.ЗаписатьКонецЭлемента();
										
									// Теги и атрибуты <НомСредИдентТов ИдентТрансУпак="011">010460043993</НомСредИдентТов>
									ИначеЕсли  ТипЗнч(СтрокаМассива.Значение) = Тип("Соответствие") Тогда
										XMLДокумент.ЗаписатьНачалоЭлемента(СтрокаДЗ.Приемник);
										Для каждого ЭлСоответствия Из СтрокаМассива.Значение Цикл
											
											СтруктураАтрибутов = ЭлСоответствия.Ключ;	
											Для каждого ЭлСтруктуры Из СтруктураАтрибутов Цикл
												
												Если ЗначениеЗаполнено(ЭлСтруктуры.Значение) Тогда
													XMLДокумент.ЗаписатьАтрибут(ЭлСтруктуры.Ключ, 	СокрЛП(ЭлСтруктуры.Значение));
												КонецЕсли;	
											КонецЦикла;
											
											XMLДокумент.ЗаписатьТекст(СокрЛП(ЭлСоответствия.Значение));
								
										КонецЦикла;
										XMLДокумент.ЗаписатьКонецЭлемента();

									КонецЕсли;
								КонецЦикла;
								
							Иначе // Остальное обычные значения
								Значение = ?(ЗначениеЗаполнено(Значение), Строка(Значение), "");
								Если СтрокаДЗ.Обязательный = Истина И НЕ ЗначениеЗаполнено(Значение) Тогда
									ТребуютЗаполнения = ТребуютЗаполнения + ?(ПустаяСтрока(ТребуютЗаполнения), "", Символы.ПС) + "- " + Строка(СтрокаДЗ.Приемник) + ",данные " + СтрокаДЗ.Данные;
								КонецЕсли;
								Если НЕ ПустаяСтрока(Значение) Тогда
									ЗаписатьXML(XMLДокумент, Значение, СтрокаДЗ.Приемник); // Проверить заполненность
								КонецЕсли;
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЕсли;
					
					// Запись атрибутов.
					Если НЕ ПропуститьСтроку И НЕ СтрокаДЗ.Строки.Количество() = 0 Тогда // Сначала получаем данные, а после записываем атрибуты (только для корневых строк)
						ЗаписатьАтрибутыXML(XMLДокумент, СтрокаДЗ, Документ, ДанныеСтроки, МассивЛогаСобытий, ТребуютЗаполнения);
					КонецЕсли;
					
					СтрокаДереваВXML(НаборДанных, XMLДокумент, СтрокаДЗ, ДанныеСтроки, ПропуститьСтроку, Документ, МассивЛогаСобытий, ТребуютЗаполнения);
					
					Если НЕ СтрокаДЗ.Строки.Количество() = 0 ИЛИ (ТипЗнч(СтрокаДЗ.Атрибуты) = Тип("СписокЗначений") И НЕ СтрокаДЗ.Атрибуты.Количество() = 0) Тогда
						XMLДокумент.ЗаписатьКонецЭлемента();
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			Если СтрокаДЗ.Уровень() = 0 Тогда
				СтрокаXML = XMLДокумент.Закрыть();
				// Выполнение служебных настроек.
				СтруктураСлужебные = Новый Структура;
				СтруктураСлужебные.Вставить("СтрокаXML", СтрокаXML);
				СтруктураСлужебные.Вставить("Отказ"    , НЕ ПустаяСтрока(ТребуютЗаполнения));
				Если НЕ ПустаяСтрока(ТребуютЗаполнения) Тогда
					ТекстЛогаСобытий = "Ошибка отправки " + Документ.ВидДокумента + " на основании документа "
					+ Строка(Документ.Ссылка) + ". Необходимо проверить заполнение следующих реквизитов:"
					+ Символы.ПС + ТребуютЗаполнения;
					ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
					МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
				КонецЕсли;
				
				Для Каждого Служебные Из СтрокаДЗ.Служебные Цикл
					Если ЗначениеЗаполнено(Служебные.Значение) Тогда
						Значение = "";
						Попытка
							Выполнить("Значение = НаборДанных." + Служебные.Значение + ";");
						Исключение
							ТекстЛогаСобытий = "Критическая ошибка. Обработка документов остановлена" + Символы.ПС 
							+ ОписаниеОшибки() + Символы.ПС + ОписаниеСтрокиГибкихНастроек(Служебные);			
							ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
							МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
							
							Возврат Неопределено;
							
						КонецПопытки;
						СтруктураСлужебные.Вставить(Служебные.Ключ, Значение);
					КонецЕсли;
				КонецЦикла;
				
				Возврат СтруктураСлужебные;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецФункции // СтрокаДереваВXML()

Функция ДатаИзXML_в_1С(Знач ДатаXML) 
	
	Если НЕ (ТипЗнч(ДатаXML) = Тип("Строка")
		ИЛИ ТипЗнч(ДатаXML) = Тип("Число")) Тогда	
	      Возврат Дата(0001, 01, 1);
	КонецЕсли;
	
	ЦифровойРяд = "0123456789";
	
	Год 	= "0001";
	Месяц 	= "01";
	День 	= "01";
	Час		= "00";
	Минута	= "00";
	Секунда	= "00";
	
	Дата 	= СокрЛП(Лев (ДатаXML, 10));
	Время 	= СокрЛП(Прав(ДатаXML, СтрДлина(ДатаXML) - 10));
	
	Если 		Найти(ЦифровойРяд, Сред(Дата, 3, 1)) = 0 Тогда // Сред(Дата, 3, 1) - 
		// "28х03х2019", где х - любой символ разделителя
		Год 	= Прав(СокрЛП(Дата), 4);
		Месяц 	= Сред(СокрЛП(Дата), 4, 2);
		День  	= Лев (СокрЛП(Дата), 2);
	ИначеЕсли 	Найти(ЦифровойРяд, Сред(Дата, 5, 1)) = 0 Тогда
		// "2019х03х28", где х - любой символ разделителя
		Год   = Лев (СокрЛП(Дата), 4);
		Месяц = Сред(СокрЛП(Дата), 6, 2);
		День  = Прав(СокрЛП(Дата), 2);
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(Время) И СтрДлина(Время) = 8 Тогда
		// "10х05х30", где х - любой символ разделителя
		Час		= Лев (СокрЛП(Время), 2);
		Минута	= Сред(СокрЛП(Время), 4, 2);
		Секунда	= Прав(СокрЛП(Время), 2);
	КонецЕсли;
	
	Попытка
		Результат  	= Дата(Год + Месяц + День + Час + Минута + Секунда);
	Исключение
		Результат 	= Дата(0001, 01, 1);
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

