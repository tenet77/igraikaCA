КонецФункции

Функция ОтправитьВсеФайлы(МассивСтрок, ТипДокумента, МассивЛогаСобытий, НомерИсправления, ЭтоРегламентноеЗадание, ПодписатьФайл, СтруктураЛога) Экспорт 
	
	ИмяСобытия = "Формирование списка для отправки";
	МассивСтруктур = Новый Массив;
	ПродолжитьОбмен = ПроверитьУстановитьБлокировкуОперации(ТипДокумента, "Исходящий", МассивЛогаСобытий);

	Если ПродолжитьОбмен = Ложь Тогда
		Возврат Новый Массив;	
	КонецЕсли;
		
	Если ТипДокумента = "ORDRSP"
		ИЛИ ТипДокумента = "DESADV" 
		ИЛИ ТипДокумента = "INVOICE" 
		ИЛИ ТипДокумента = "DESSCC"
		ИЛИ ТипДокумента = "RETINS"
		ИЛИ ТипДокумента = "ORDER"
		ИЛИ ТипДокумента = "ORDERS"
		ИЛИ	ТипДокумента = "RETORD"
		ИЛИ	ТипДокумента = "RECADV"
		ИЛИ ТипДокумента = "WHGOV_01_Исходящий" 
		ИЛИ ТипДокумента = "WHGPV_05_Исходящий" 
		ИЛИ ТипДокумента = "STATUS" 
		ИЛИ ТипДокумента = "ON_SCHFDOPPR" 
		ИЛИ ТипДокумента = "ON_NSCHFDOPPR"
		ИЛИ ТипДокумента = "ON_SCHFDOPPR_01"    //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _01. 2 этап]
		ИЛИ ТипДокумента = "ON_NSCHFDOPPR_01"   //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _01. 2 этап]
		ИЛИ ТипДокумента = "WHGOU_04_Исходящий"
		ИЛИ ТипДокумента = "WHGPU_08_Исходящий"
		ИЛИ Найти(ТипДокумента, "CONDRA") > 0
		ИЛИ Найти(ТипДокумента, "DP_PRANNUL") > 0 
		ИЛИ ТипДокумента = "DP_IZVPOL_23"
		ИЛИ ТипДокумента = "DP_UVUTOCH_24"
		ИЛИ ТипДокумента = "DP_REZRUISP" 
		ИЛИ ТипДокумента = "PRICAT" Тогда
		
		МассивСтруктур = СформироватьДокументыXML(МассивСтрок, МассивЛогаСобытий, ЭтоРегламентноеЗадание, ТипДокумента, ПодписатьФайл, НомерИсправления);
		
    Иначе	
		ТекстЛогаСобытий = "!!! Данный тип файла не поддерживается для отправки.";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

    КонецЕсли;
		
	Если МассивСтруктур.Количество() = 0 Тогда
		ЭКОМ_ОбщегоНазначения.СнятьБлокировкуОперации(ТипДокумента, "Исходящий", МассивЛогаСобытий);	
	КонецЕсли;
	
	Возврат МассивСтруктур;
	
КонецФункции

// Функция проверяет возможность заблокировать указанную операцию и в случае такой возможности блокирует ее
//
// Параметры:
//  ИмяОперации  - Строка - наименование операции для блокировки
//
// Возвращаемое значение:
//   Структура   - информация о блокировке операции
//
Функция ПроверитьУстановитьБлокировкуОперации(ТипДокумента, НаправлениеОбмена, МассивЛогаСобытий) 
	
	// В случае ошибки добавим в массив текст лога 
	ТекстЛогаСобытий = "Процесс " + НаправлениеОбмена + " - " + ТипДокумента + " уже запущен другим пользователем(%время%). 
				|Для ручной разблокировки (в случае неудачного завершения работы) перейдите в Настройки - Хранение данных и нажмите кнопку <<<Разблокировать обмен>>>";

	ПродолжитьОбмен = Ложь;
	ИмяОперации = "Блокировка" + НаправлениеОбмена + "_" + ТипДокумента;
	Блокировать = ПолучитьРежимУправленияБлокировкойДанныхПоУмолчанию(); 	
	// Установка блокировки
	НачатьТранзакцию();
	Попытка
		
		Если Блокировать = Истина Тогда
			БлокировкаДанных 		= Новый БлокировкаДанных;
			ЭлементБлокировки 		= БлокировкаДанных.Добавить("РегистрСведений.ЭКОМ_ЗначениеДополнительныхКонстант");
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			ЭлементБлокировки.УстановитьЗначение("ДополнительнаяКонстанта", ИмяОперации);
			ЭлементБлокировки.УстановитьЗначение("Измерение", "Блокировка");
			БлокировкаДанных.Заблокировать();	
		КонецЕсли;

		// Читаем настройки и записываем если процесс еще не запущен. 
		МенеджерЗаписи = РегистрыСведений.ЭКОМ_ЗначениеДополнительныхКонстант.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ДополнительнаяКонстанта = ИмяОперации;
		МенеджерЗаписи.Измерение               = "Блокировка";
		МенеджерЗаписи.Прочитать();	
		Если МенеджерЗаписи.Выбран() Тогда			
			ВремяНачалаБлокировки = ?(ТипЗнч(МенеджерЗаписи.ЗначениеДополнительнойКонстанты) = Тип("Булево"), Дата(0001, 01, 01), МенеджерЗаписи.ЗначениеДополнительнойКонстанты);
			ВремяБлокировки = (ТекущаяДата() - ВремяНачалаБлокировки)/(60*60);
			Если ВремяБлокировки <= 3 Тогда // если меньше 3 часов 
				
				МассивЛогаСобытий.Добавить(СтрЗаменить(ТекстЛогаСобытий, "%время%", ВремяНачалаБлокировки));
				
			Иначе
				МенеджерЗаписи.ЗначениеДополнительнойКонстанты = ТекущаяДата();
				МенеджерЗаписи.Записать();
				
				ПродолжитьОбмен = Истина;
				
			КонецЕсли;
		Иначе
			МенеджерЗаписи.ДополнительнаяКонстанта         = ИмяОперации;
			МенеджерЗаписи.Измерение                       = "Блокировка";
			МенеджерЗаписи.ЗначениеДополнительнойКонстанты = ТекущаяДата();
			МенеджерЗаписи.Записать();
			
			ПродолжитьОбмен = Истина;
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();	
		МассивЛогаСобытий.Добавить(ОписаниеОшибки() + " - " + ТекстЛогаСобытий);
	КонецПопытки;
	
	Возврат ПродолжитьОбмен;
	
КонецФункции // ПроверитьУстановитьБлокировкуОперации()

Функция ПолучитьРежимУправленияБлокировкойДанныхПоУмолчанию() 
	
	// Автоматический - все транзакции, будут выполняться в автоматическом режиме.
	// АвтоматическийИУправляемый  - транзакции, будут выполняться в режиме, определяемом установкой соответствующего свойства объекта метаданных.
	// Управляемый - все транзакции, будут выполняться в управляемом режиме. 
	Блокировать = Ложь;
	Если Метаданные.РежимУправленияБлокировкойДанных = Метаданные.Свойстваобъектов.РежимУправленияБлокировкойДанныхПоУмолчанию.Управляемый Тогда
		Блокировать = Истина;
	КонецЕсли;
	
	Возврат Блокировать;
	
КонецФункции // ПолучитьРежимУправленияБлокировкойДанныхПоУмолчанию()

// Функция возвращает уникальный номер транзакции 
//
// Параметры:
//  ПредыдущийНомер  - Число - номер предыдущей транзакции при обработке массива документов в цикле.
//
// Возвращаемое значение:
//   Число   - номер текущей транзакции
//
Функция НовыйНомерТранзакции(ПредыдущийНомер) Экспорт
	
	Если НЕ ТипЗнч(ПредыдущийНомер) = Тип("Число") Тогда		
		ТекстЛогаСобытий = "Критическая ошибка. Обработка документов остановлена. Параметр процедуры не является числом";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, "Получение нового номера транзакции");
		ЗаписатьСтрокуЛогаСобытийвРегистрЛогирование(ЗаписьСтруктурыЛога);
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	ТекущийНомер = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Если ТекущийНомер <= ПредыдущийНомер Тогда
		ТекущийНомер = ПредыдущийНомер + 1;
	КонецЕсли;
	
	Возврат ТекущийНомер;
	
КонецФункции 

Процедура ОтправитьФайлы(ОбщийМассивФайлов, ТипДокумента, МассивЛогаСобытий, ЭтоРегламентноеЗадание, СтруктураЛога) Экспорт
	
	ИмяСобытия = "Отправить файлы, модуль общего назначения";
	КоличествоФайлов = ОбщийМассивФайлов.Количество();
	Если КоличествоФайлов = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВременныйКаталог = ПутьВременногоКаталогаЭКОМ("Send_file");	
	КаталогВременный = ЭКОМ_СоздатьКаталогПроверитьНаЗапись(ВременныйКаталог, МассивЛогаСобытий);	
	Если КаталогВременный = Неопределено Тогда		
		Возврат;		
	КонецЕсли;
	
	ТипОбменаЭТРН = Ложь;
	Если ТипДокумента = "WHGOV_01_Исходящий"  
		ИЛИ ТипДокумента = "WHGOU_04_Исходящий" 
		ИЛИ ТипДокумента = "WHGPV_05_Исходящий"  
		ИЛИ ТипДокумента = "WHGPU_08_Исходящий" Тогда	
		ТипОбменаЭТРН = Истина;
	КонецЕсли;
	
	// Разделим файлы для отправки
	СоответствиеПрофилей = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЭКОМ_GLN.ПрофильОбмена КАК ПрофильОбмена,
	|	ЭКОМ_GLN.Объект КАК Организация
	|ИЗ
	|	РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN
	|ГДЕ
	|	НЕ ЭКОМ_GLN.ПрофильОбмена = ЗНАЧЕНИЕ(Справочник.ЭКОМ_ПрофилиОбмена.ПустаяСсылка)
	|	И НЕ ЭКОМ_GLN.ПрофильОбмена.ПометкаУдаления
	|	И ЭКОМ_GLN.ПрофильОбмена.Активный = ИСТИНА
	|ИТОГИ ПО
	|	ПрофильОбмена";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		ВыборкаПрофильОбмена = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПрофильОбмена.Следующий() Цикл
			ПрофильОбмена = ВыборкаПрофильОбмена.ПрофильОбмена;
			МассивПоПрофилям = Новый Массив;
			Выборка = ВыборкаПрофильОбмена.Выбрать();
			Пока Выборка.Следующий() Цикл				
				Для каждого СтрокаМассива Из ОбщийМассивФайлов Цикл	
					Если СтрокаМассива.Организация = Выборка.Организация Тогда
						МассивПоПрофилям.Добавить(СтрокаМассива);
					КонецЕсли;
				КонецЦикла;		
			КонецЦикла;	
			СоответствиеПрофилей.Вставить(ПрофильОбмена, МассивПоПрофилям);
		КонецЦикла;	 
	Иначе
		ТекстЛогаСобытий = "Выберите в настройках профиль обмена по организации." + Символы.ПС + "Не заполнен профиль обмена в справочнике <<<ЭКОМ Профили обмена>>>!";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

	КонецЕсли;
	
	Для каждого КлючЗначение Из СоответствиеПрофилей Цикл
		ПрофильОбмена = КлючЗначение.Ключ; 
		МассивФайловВсего = КлючЗначение.Значение;
		
		Если МассивФайловВсего.Количество() = 0 Тогда
		     Продолжить;
		КонецЕсли;
		
		Если ТипОбменаЭТРН = Истина Тогда
			знИспользоватьАПИ = ПрофильОбмена.ЭТРН_ОбменПоSOAP;
		Иначе
			знИспользоватьАПИ = ПрофильОбмена.ОбменПоSOAP;
		КонецЕсли;
				
		Если ПрофильОбмена.ПроверятьФайлыЛокально = Ложь Тогда
			Если знИспользоватьАПИ Тогда
				
				ЭтоКазахстан = ПрофильОбмена.Страна = "kz";
				
				// Делим файлы на пакеты для отправки по SOAP - ограничение веб сервиса
				ПакетФайлов = Новый Структура;
				
				НомерПоПорядку	= 0;
				Соответствие   	= Новый Соответствие;
				КоличествоФайловВПакете = ?(ПрофильОбмена.КоличествоФайловВПакете = 0, 500, ПрофильОбмена.КоличествоФайловВПакете);
				
				Для Каждого Элемент Из МассивФайловВсего Цикл
					
					НомерПоПорядку = НомерПоПорядку + 1;
					Соответствие.Вставить(Элемент, НомерПоПорядку);
					
					Если Соответствие.Количество() = КоличествоФайловВПакете Тогда
						ПакетФайлов.Вставить("Часть" + Формат(ПакетФайлов.Количество() + 1, "ЧГ=0"), Соответствие);
						Соответствие = Новый Соответствие;
					КонецЕсли;
					
				КонецЦикла;
				
				// Добавляем последний пакет, если он не был добавлен в цикле (неполный пакет).
				Если НЕ Соответствие.Количество() = КоличествоФайловВПакете
					И НЕ Соответствие.Количество() = 0 Тогда
					ПакетФайлов.Вставить("Часть" + Формат(ПакетФайлов.Количество() + 1, "ЧГ=0"), Соответствие);
				КонецЕсли;
				
				Для каждого ЭлементПакета Из ПакетФайлов Цикл
					
					МассивФайлов = Новый Массив;
					Для каждого ЭлИменаФайлов Из ЭлементПакета.Значение Цикл
						МассивФайлов.Добавить(ЭлИменаФайлов.Ключ);
					КонецЦикла;
					
					Если ЭтоКазахстан Тогда
						
						Для Каждого СтруктураEDI Из МассивФайлов Цикл					
							
							ФайлXML = ПолучитьФайлДокумента(СтруктураEDI, ВременныйКаталог);						
							Если ФайлXML = Неопределено Тогда
								Продолжить;
							КонецЕсли;
							ДвоичныеДанныеФайлаXML = Новый ДвоичныеДанные(ФайлXML.ПолноеИмя);
							
							ОдноИмяФайла = Новый Массив;
							ОдноИмяФайла.Добавить(ФайлXML.Имя);
														
							Рез	= Вычислить("ЭКОМ_ОбщегоНазначения.НовыйSOAPОбращение(ПрофильОбмена, ""sendDoc"", ОдноИмяФайла, ДвоичныеДанныеФайлаXML, МассивЛогаСобытий)");
														
							Если Рез.errorCode = "" Тогда								
								ТекстЛогаСобытий    = "Нет данных об ответе или ответ сформирован не верно";		
								ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
								МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
								
								Возврат;
								
							ИначеЕсли Рез.errorCode = "0" Тогда			
								
								СтруктураEDI.Сообщение = " успешно отправлен через интерфейс API на платформу Exite Evolution";
								СтруктураEDI.Отправлен = Истина;
								
							Иначе								
								// Все документы не отправлены. Сообщаем об этом.			
								ТекстЛогаСобытий = "Ошибка отправки файла " + СтруктураEDI.ИмяФайлаXML;
								ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
								МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
								
							КонецЕсли;
							
						КонецЦикла;	
						
					Иначе
						// Создаем архив с файлами для отправки по SOAP
						ИмяZipФайла =  ВременныйКаталог + ТипДокумента + "_" + ЭлементПакета.Ключ + "_" + Формат(ТекущаяДата(), "ДФ=ddMMyyhhmmss" ) + ".zip";
						ЗаписьZIP   = Новый ЗаписьZipФайла(
						ИмяZipФайла,
						"", // пароль на архив (оставим пустой)
						"Этот архив создан из 1с", // комментарий к архиву
						МетодСжатияZIP.Сжатие, // сжатие или копирование
						УровеньСжатияZIP.Оптимальный,
						МетодШифрованияZIP.Zip20
						);
						
						Если ТипДокумента = "ON_SCHFDOPPR_01"          //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _01. 2 этап]
							ИЛИ ТипДокумента = "ON_NSCHFDOPPR_01"      //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _01. 2 этап]
							ИЛИ ТипДокумента = "ON_NSCHFDOPPRPROS_01"  //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _01. 2 этап]
							ИЛИ ТипДокумента = "ON_NSCHFDOPPRMARK_01"  //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _01. 2 этап]
							ИЛИ ТипДокумента = "ON_KORSCHFDOPPR_01"    //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _01. 2 этап]
							ИЛИ ТипДокумента = "DP_REZRUISP"
							ИЛИ Найти(ТипДокумента, "CONDRA") > 0 Тогда  
							
							Для Каждого СтруктураEDI Из МассивФайлов Цикл					
								
								НеобходимаПодпись = Ложь;
								ФайлBIN = ПолучитьФайлПодписи(СтруктураEDI, НеобходимаПодпись, ВременныйКаталог);						
								Если НеобходимаПодпись = Истина 
									И ФайлBIN = Неопределено Тогда
									Продолжить;
								КонецЕсли;
								
								ФайлДанных = Неопределено;
								Если СтруктураEDI.Свойство("ИмяФайлаДанных") Тогда
									ПолноеИмяФайлаДанных = ВременныйКаталог + СтруктураEDI.ИмяФайлаДанных;
									СтруктураEDI.ДвоичныеДанныеФайлаДанных.Записать(ПолноеИмяФайлаДанных);
									
									ФайлДанных = Новый Файл(ПолноеИмяФайлаДанных);
									Если НЕ ФайлДанных.Существует() Тогда
										ФайлДанных = Неопределено;
									КонецЕсли;
									СтруктураEDI.Вставить("ПолноеИмяФайлаДанных", ПолноеИмяФайлаДанных);
								КонецЕсли;
								
								ФайлXML = ПолучитьФайлДокумента(СтруктураEDI, ВременныйКаталог);						
								Если ФайлXML = Неопределено Тогда
									Продолжить;
								КонецЕсли;
								
								// Создаем архив с файлами ЮЗД
								ИмяZipФайлаЮЗД = ВременныйКаталог + ФайлXML.ИмяБезРасширения + ".zip";
								ЗаписьZIP_ЮЗД  = Новый ЗаписьZipФайла(
								ИмяZipФайлаЮЗД,
								"", // пароль на архив (оставим пустой)
								"Этот архив создан из 1с", // комментарий к архиву
								МетодСжатияZIP.Сжатие, // сжатие или копирование
								УровеньСжатияZIP.Оптимальный,
								МетодШифрованияZIP.Zip20
								);
								
								Если Найти(ТипДокумента, "CONDRA") > 0 Тогда
									// Переименовываем xml файл в condra.xml
									ПереместитьФайл(ФайлXML.ПолноеИмя, ФайлXML.Путь + "condra.xml");
									ЗаписьZIP_ЮЗД.Добавить(ФайлXML.Путь + "condra.xml");
								Иначе
									ЗаписьZIP_ЮЗД.Добавить(ФайлXML.ПолноеИмя);
								КонецЕсли;
								
								Если НЕ ФайлBIN = Неопределено Тогда
									ЗаписьZIP_ЮЗД.Добавить(ФайлBIN.ПолноеИмя);
								КонецЕсли;
								
								Если НЕ ФайлДанных = Неопределено Тогда
									ЗаписьZIP_ЮЗД.Добавить(ФайлДанных.ПолноеИмя);
								КонецЕсли;
								
								ЗаписьZIP_ЮЗД.Записать();
								
								Если Найти(ТипДокумента, "CONDRA") > 0 Тогда
									// Возвращаем старое название файлу xml.
									ПереместитьФайл(ФайлXML.Путь + "condra.xml", ФайлXML.ПолноеИмя);
								КонецЕсли;
								
								ЗаписьZIP.Добавить(ИмяZipФайлаЮЗД);
								СтруктураEDI.Вставить("ИмяАрхива", ИмяZipФайлаЮЗД);
								
							КонецЦикла;
							
						Иначе	
							
							Для Каждого СтруктураEDI Из МассивФайлов Цикл					
								
								НеобходимаПодпись = Ложь;
								ФайлBIN = ПолучитьФайлПодписи(СтруктураEDI, НеобходимаПодпись, ВременныйКаталог);						
								Если НеобходимаПодпись = Истина 
									И ФайлBIN = Неопределено Тогда
									Продолжить;
								КонецЕсли;
								
								ФайлXML = ПолучитьФайлДокумента(СтруктураEDI, ВременныйКаталог);						
								Если ФайлXML = Неопределено Тогда
									Продолжить;
								КонецЕсли;
								
								ЗаписьZIP.Добавить(ФайлXML.ПолноеИмя);
								Если НеобходимаПодпись = Истина Тогда
									ЗаписьZIP.Добавить(ФайлBIN.ПолноеИмя);				
								КонецЕсли;
							КонецЦикла;	
							
						КонецЕсли;
						
						ЗаписьZIP.Записать();
						
						Рез	= Вычислить("ЭКОМ_ОбщегоНазначения.НовыйSOAPОбращение(ПрофильОбмена, ""sendDocumentsRequest"", , Новый ДвоичныеДанные(ИмяZipФайла), МассивЛогаСобытий)");
												
						// Удалим файлы
						Попытка
							УдалитьФайлы(ИмяZipФайла);		
						Исключение
							ТекстЛогаСобытий = ОписаниеОшибки();
							ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
							МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

						КонецПопытки;
						
						Если Рез.errorCode = "" Тогда						
							ТекстЛогаСобытий = "Нет данных об ответе или ответ сформирован не верно";		
							ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
							МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
							
							Возврат;
							
						ИначеЕсли Рез.errorCode = "0" Тогда			
							Для Каждого СтруктураEDI Из МассивФайлов Цикл
								СтруктураEDI.Сообщение = " успешно отправлен через интерфейс API на платформу Exite Evolution";
								СтруктураEDI.Отправлен = Истина;				
							КонецЦикла;
						Иначе
							// Все документы не отправлены. Сообщаем об этом.
							Для Каждого СтруктураEDI Из МассивФайлов Цикл					
								ТекстЛогаСобытий = "Ошибка отправки файла " + СтруктураEDI.ИмяФайлаXML;
								ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
								МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

							КонецЦикла;	
						КонецЕсли;
						
					КонецЕсли;	
				КонецЦикла;
				
			Иначе
				// Отправим на сервер по FTP
				Сервер = ПолучитьFTPСоединение(ПрофильОбмена, ТипОбменаЭТРН, МассивЛогаСобытий);	
				Если Сервер = Неопределено Тогда
					ТекстЛогаСобытий = "Отсутствует подключение к FTP!";
					ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
					МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

					Возврат;
				КонецЕсли;
				
				Для Каждого СтруктураEDI Из МассивФайловВсего Цикл
					
					НеобходимаПодпись = Ложь;
					ФайлBIN = ПолучитьФайлПодписи(СтруктураEDI, НеобходимаПодпись, ВременныйКаталог);						
					Если НеобходимаПодпись = Истина 
						И ФайлBIN = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					ФайлXML = ПолучитьФайлДокумента(СтруктураEDI, ВременныйКаталог);						
					Если ФайлXML = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					ФайлОтправлен = ОтправитьФайлыВНужномФорматеПоТипуДокументаПоFTP(ФайлXML, ФайлBIN, ТипДокумента, Сервер, ВременныйКаталог, МассивЛогаСобытий, ПрофильОбмена, ТипОбменаЭТРН);
					
					Если ФайлОтправлен = Истина Тогда
						СтруктураEDI.Сообщение = " успешно отправлен по FTP в каталог outbox платформы Exite Evolution";
						СтруктураEDI.Отправлен = Истина;						
					КонецЕсли;
					
				КонецЦикла; 
				
			КонецЕсли;		
			
			// Локально
		Иначе
			Для Каждого СтруктураEDI Из МассивФайловВсего Цикл
				
				НеобходимаПодпись = Ложь;
				ФайлBIN = ПолучитьФайлПодписи(СтруктураEDI, НеобходимаПодпись, ВременныйКаталог);						
				Если НеобходимаПодпись = Истина 
					И ФайлBIN = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				ФайлXML = ПолучитьФайлДокумента(СтруктураEDI, ВременныйКаталог);						
				Если ФайлXML = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				СтруктураEDI.Сообщение = " записан в локальный каталог outbox.";
				СтруктураEDI.Отправлен = Истина;
				
			КонецЦикла;	
		КонецЕсли;
		
		НомПП = 0;
		Для Каждого СтруктураEDI Из МассивФайловВсего Цикл			
			
			Если СтруктураEDI.Отправлен Тогда
				
				НомПП = НомПП + 1;
				
				Если Найти(ТипДокумента, "CONDRA") > 0 Тогда // Для кондры используем другой регистр.
					
					Если ПустаяСтрока(СтруктураEDI.Идентификатор) Тогда
						ТекстЛогаСобытий = "Ошибка отправки файла " + СтруктураEDI.ИмяФайлаXML + ". Не указан идентификатор цепочки (TRANSGUID).";
						ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
						МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

					Иначе
						
						МенеджерЗаписи = РегистрыСведений.ЭКОМ_ЦепочкиНеструктурированныхДокументов.СоздатьМенеджерЗаписи();
						МенеджерЗаписи.TRANSGUID 			= СтруктураEDI.Идентификатор;
						//МенеджерЗаписи.НаправлениеОбмена 	= ПредопределенноеЗначение("Перечисление.ЭКОМ_НаправлениеОбмена.Исходящий");
						МенеджерЗаписи.Прочитать();
						
						Если МенеджерЗаписи.Выбран() Тогда
							МенеджерЗаписи.Статус = СтруктураEDI.Статус;
							МенеджерЗаписи.Действие = Перечисления.ЭКОМ_ТребуемоеДействиеCONDRA[Строка(СтруктураEDI.Статус)];
							МенеджерЗаписи.ДатаПоследнейТранзакции = ТекущаяДатаСеанса();
							МенеджерЗаписи.Записать();
							СтруктураEDI.Вставить("Документ", МенеджерЗаписи.ДокументОригинала);
							// Удаление записи с данными после первой отправки.
							МенеджерЗаписи = РегистрыСведений.ЭКОМ_НеструктурированныеДокументы.СоздатьМенеджерЗаписи();
							МенеджерЗаписи.TRANSGUID = СтруктураEDI.Идентификатор;
							МенеджерЗаписи.Прочитать();
							Если МенеджерЗаписи.Выбран() Тогда
								МенеджерЗаписи.Удалить();
							КонецЕсли;
						КонецЕсли;
							
					КонецЕсли;
					
				Иначе
					
					Структура = Новый Структура; 
					Структура.Вставить("ДатаЗаписи"                  , ТекущаяДата());
					Структура.Вставить("Контрагент"                  , СтруктураEDI.Контрагент);
					Структура.Вставить("Организация"                 , СтруктураEDI.Организация);
					Структура.Вставить("ЗаказДата"                   , СтруктураEDI.ЗаказДата);					
					Структура.Вставить("ЗаказНомер"                  , СтруктураEDI.ЗаказНомер);
					Структура.Вставить("НаправлениеОбмена"           , Перечисления.ЭКОМ_НаправлениеОбмена.Исходящий);
					Структура.Вставить("ФайлИмя"                     , СтруктураEDI.ИмяФайлаXML);
					Структура.Вставить("Статус"                      , СтруктураEDI.Статус);
					Структура.Вставить("ИдентификаторИспр"           , ?(СтруктураEDI.Свойство("ИдентификаторИспр"), СтруктураEDI.ИдентификаторИспр, ""));
					Структура.Вставить("Идентификатор"               , СтрЗаменить(СтруктураEDI.ИмяФайлаXML, ".xml", ""));
					Структура.Вставить("СтруктураФайла"              , Новый ХранилищеЗначения(СтруктураEDI.СтруктураДокумента,  Новый СжатиеДанных(9)));		
					
					Если СтруктураEDI.Свойство("ДвоичныеДанныеФайлаBIN") Тогда
						ЭЦПотКвитанции = СтруктураEDI.ДвоичныеДанныеФайлаBIN;
						Структура.Вставить("ЭЦП", Новый ХранилищеЗначения(ЭЦПотКвитанции, Новый СжатиеДанных(9)));
					КонецЕсли;
					
					ЭКОМ_Объекты_События_Записать(СтруктураEDI.Документ, СтруктураEDI.ВидДокумента, Структура);	
					
				КонецЕсли;
				
				ПредставлениеДокумента = Строка(СтруктураEDI.Документ);
								
				ТекстЛогаСобытий = "Отправка № " + Строка(НомПП) + " из " + Строка(КоличествоФайлов) + " " + ПредставлениеДокумента + " - тип [" + ТипДокумента  + "]"
				+ " файл [" + СтруктураEDI.ИмяФайлаXML + "] " + СтруктураEDI.Сообщение;
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Успешно, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

			КонецЕсли;
			
			// Удалим файл
			Попытка
				
				Если СтруктураEDI.Свойство("ПолноеИмяФайлаXML") Тогда
					ФайлXML = Новый Файл(СтруктураEDI.ПолноеИмяФайлаXML);			
					Если ФайлXML.Существует() Тогда
						УдалитьФайлы(ФайлXML.ПолноеИмя);
					КонецЕсли;
				КонецЕсли;
				
				Если СтруктураEDI.Свойство("ПолноеИмяФайлаBIN") Тогда
					ФайлBIN = Новый Файл(СтруктураEDI.ПолноеИмяФайлаBIN);
					Если ФайлBIN.Существует() Тогда
						УдалитьФайлы(ФайлBIN.ПолноеИмя);
					КонецЕсли;
				КонецЕсли;
				
				Если СтруктураEDI.Свойство("ПолноеИмяФайлаДанных") Тогда
					ФайлДанных = Новый Файл(СтруктураEDI.ПолноеИмяФайлаДанных);
					Если ФайлДанных.Существует() Тогда
						УдалитьФайлы(ФайлДанных.ПолноеИмя);
					КонецЕсли;
				КонецЕсли;
				
			Исключение
			КонецПопытки;		
		КонецЦикла;
		
	КонецЦикла;	
	
	СнятьБлокировкуОперации(ТипДокумента, "Исходящий", МассивЛогаСобытий);
	
КонецПроцедуры

// Процедура снимает блокировку указанной операции
//
// Параметры:
//  ИмяОперации  - Строка - имя операции
//
Процедура СнятьБлокировкуОперации(ТипДокумента, НаправлениеОбмена, МассивЛогаСобытий) Экспорт
	
	ИмяОперации = "Блокировка" + НаправлениеОбмена + "_" + ТипДокумента;
	Блокировать = ПолучитьРежимУправленияБлокировкойДанныхПоУмолчанию(); 	
	НачатьТранзакцию();
	Попытка
		
		Если Блокировать = Истина Тогда
			БлокировкаДанных 		= Новый БлокировкаДанных;
			ЭлементБлокировки 		= БлокировкаДанных.Добавить("РегистрСведений.ЭКОМ_ЗначениеДополнительныхКонстант");
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			ЭлементБлокировки.УстановитьЗначение("ДополнительнаяКонстанта", ИмяОперации);
			ЭлементБлокировки.УстановитьЗначение("Измерение", "Блокировка");
			БлокировкаДанных.Заблокировать();	
		КонецЕсли;

		// Читаем настройки и записываем если процесс еще не запущен. 
		МенеджерЗаписи = РегистрыСведений.ЭКОМ_ЗначениеДополнительныхКонстант.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ДополнительнаяКонстанта = ИмяОперации;
		МенеджерЗаписи.Измерение               = "Блокировка";
		МенеджерЗаписи.Прочитать();
		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.ЗначениеДополнительнойКонстанты = Дата(0001, 01, 01);
			МенеджерЗаписи.Записать();
		Иначе
			МенеджерЗаписи.ДополнительнаяКонстанта         = ИмяОперации;
			МенеджерЗаписи.Измерение                       = "Блокировка";
			МенеджерЗаписи.ЗначениеДополнительнойКонстанты = Дата(0001, 01, 01);
			МенеджерЗаписи.Записать();
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();		
		ТекстЛогаСобытий = "Регистр заблокирован - " + ТипДокумента + "! - " + ОписаниеОшибки();
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, "Снять блокировку " + ТипДокумента);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
	КонецПопытки;
	
КонецПроцедуры // СнятьБлокировкуОперации()

Функция ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, УровеньЛогирования, ИмяСобытия) Экспорт		
	ЗаписьСтруктурыЛога = ЗаписьСтруктурыЛогаНаСервере();
	ЗаписьСтруктурыЛога.Комментарий        = ТекстЛогаСобытий;
	ЗаписьСтруктурыЛога.УровеньЛогирования = УровеньЛогирования;
	ЗаписьСтруктурыЛога.ИмяСобытия         = ИмяСобытия;
	ЗаписьСтруктурыЛога.НачалоВыполнения   = ТекущаяДата();
	
	Возврат ЗаписьСтруктурыЛога;
	
КонецФункции

Функция НайтиТекущегоПользователя() Экспорт
	
	ТекущийПользователь = Неопределено;
	Если НЕ Метаданные.ПараметрыСеанса.Найти("ТекущийПользователь") = Неопределено Тогда
		ТекущийПользователь = ПараметрыСеанса.ТекущийПользователь;
	ИначеЕсли НЕ Метаданные.ПараметрыСеанса.Найти("ТекущийВнешнийПользователь") = Неопределено Тогда
		ТекущийПользователь = ПараметрыСеанса.ТекущийВнешнийПользователь;	 
	Иначе	
		Попытка
			ТекущийПользователь = Вычислить("глЗначениеПеременной(""глТекущийПользователь"")")
		Исключение
			Ошибка = ОписаниеОшибки();
			ТекущийПользователь = "ТекущийПользователь";
		КонецПопытки;
	КонецЕсли;
	
	Возврат ТекущийПользователь;
	
КонецФункции 

Функция ПолучитьФайлДокумента(СтруктураEDI, ВременныйКаталог)
	     
	ПолноеИмяФайлаXML = ВременныйКаталог + СтруктураEDI.ИмяФайлаXML;
	Текст = Новый ТекстовыйДокумент; 
	Текст.УстановитьТекст(СтруктураEDI.СтрокаXML); 
	Текст.Записать(ПолноеИмяФайлаXML, СтруктураEDI.КодировкаФайла); 
	
	ФайлXML = Новый Файл(ПолноеИмяФайлаXML);
	Если НЕ ФайлXML.Существует() Тогда
	     ФайлXML = Неопределено;
	КонецЕсли;
	СтруктураEDI.Вставить("ПолноеИмяФайлаXML", ПолноеИмяФайлаXML);
	
	Возврат ФайлXML;			
		
КонецФункции

Функция ПолучитьФайлПодписи(СтруктураEDI, НеобходимаПодпись, ВременныйКаталог) 
	
	ФайлBIN = Неопределено;
	НеобходимаПодпись = Ложь;
	Если СтруктураEDI.Свойство("ИмяФайлаBIN") Тогда
		НеобходимаПодпись = Истина;
		ПолноеИмяФайлаBIN = ВременныйКаталог + СтруктураEDI.ИмяФайлаBIN;
		
		// Файл подписи необходимо закодировать в Base64
		ФайлПодписи = Новый ЗаписьТекста(ПолноеИмяФайлаBIN, КодировкаТекста.ANSI);		
		ФайлПодписи.Записать(Base64Строка(СтруктураEDI.ДвоичныеДанныеФайлаBIN));
		ФайлПодписи.Закрыть();
		
		ФайлBIN = Новый Файл(ПолноеИмяФайлаBIN);
		Если НЕ ФайлBIN.Существует() Тогда
			ФайлBIN = Неопределено;
		КонецЕсли;
		СтруктураEDI.Вставить("ПолноеИмяФайлаBIN", ПолноеИмяФайлаBIN);
	КонецЕсли;
	
	Возврат ФайлBIN;
	
КонецФункции 

Функция ОтправитьФайлыВНужномФорматеПоТипуДокументаПоFTP(ФайлXML, ФайлBIN, ТипДокумента, Сервер, ВременныйКаталог, МассивЛогаСобытий, ПрофильОбмена, ТипОбменаЭТРН)
	
	ФайлОтправлен = Ложь;
	
	Если ТипДокумента = "ON_SCHFDOPPR_01"           //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _01. 2 этап]
		ИЛИ ТипДокумента = "ON_NSCHFDOPPR_01"       //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _01. 2 этап]
		ИЛИ ТипДокумента = "ON_NSCHFDOPPRPROS_01"   //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _01. 2 этап]
		ИЛИ ТипДокумента = "ON_NSCHFDOPPRMARK_01"   //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _01. 2 этап]
		ИЛИ ТипДокумента = "ON_KORSCHFDOPPR_01"     //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _01. 2 этап]
		ИЛИ ТипДокумента = "WHGOV_01_Исходящий" 
		ИЛИ ТипДокумента = "WHGOU_04_Исходящий"
		ИЛИ ТипДокумента = "WHGPV_05_Исходящий" 
		ИЛИ ТипДокумента = "WHGPU_08_Исходящий"
		ИЛИ ТипДокумента = "DP_REZRUISP"
		ИЛИ Найти(ТипДокумента, "CONDRA") > 0 Тогда
		
		// Создаем архив с файлами ЮЗД
		ИмяФайлаДляОтправки = ВременныйКаталог + ФайлXML.ИмяБезРасширения + ".zip";
		
		ЗаписьZIP_ЮЗД  = Новый ЗаписьZipФайла(
						ИмяФайлаДляОтправки,
						"", // пароль на архив (оставим пустой)
						"Этот архив создан из 1с", // комментарий к архиву
						МетодСжатияZIP.Сжатие, // сжатие или копирование
						УровеньСжатияZIP.Оптимальный,
						МетодШифрованияZIP.Zip20
						);
		
		ЗаписьZIP_ЮЗД.Добавить(ФайлXML.ПолноеИмя);
		Если НЕ ФайлBIN = Неопределено Тогда
			ЗаписьZIP_ЮЗД.Добавить(ФайлBIN.ПолноеИмя);
		КонецЕсли;
		ЗаписьZIP_ЮЗД.Записать();					
		ФайлОтправлен = ОтправитьФайлПоFTP(Сервер, ИмяФайлаДляОтправки, ФайлXML.ИмяБезРасширения + ".zip", МассивЛогаСобытий , ПрофильОбмена, ТипОбменаЭТРН);
		
		// Удаление архива
		УдалитьФайлы(ИмяФайлаДляОтправки);
		
	Иначе
		ФайлОтправлен = ОтправитьФайлПоFTP(Сервер, ФайлXML.ПолноеИмя, ФайлXML.Имя, МассивЛогаСобытий , ПрофильОбмена, ТипОбменаЭТРН);
		Если ФайлBIN = Неопределено Тогда
			РезультатОтправкиBIN = Истина;	
		Иначе
			РезультатОтправкиBIN = ОтправитьФайлПоFTP(Сервер, ФайлBIN.ПолноеИмя, ФайлBIN.Имя, МассивЛогаСобытий , ПрофильОбмена, ТипОбменаЭТРН);
			Если ФайлBIN.Существует() Тогда
				УдалитьФайлы(ФайлBIN.ПолноеИмя);
			КонецЕсли;
		КонецЕсли;
		
		Если РезультатОтправкиBIN = Ложь 
			ИЛИ ФайлОтправлен = Ложь Тогда
			ФайлОтправлен = Ложь;
		КонецЕсли;
			 
	КонецЕсли;            
	
	// Удаление файлов
	Если ФайлXML.Существует() Тогда
		УдалитьФайлы(ФайлXML.ПолноеИмя);
	КонецЕсли;
	Если НЕ ФайлBIN = Неопределено Тогда
		Если ФайлBIN.Существует() Тогда
			УдалитьФайлы(ФайлBIN.ПолноеИмя);
		КонецЕсли;
	КонецЕсли;
		
	Возврат ФайлОтправлен;
	
КонецФункции

Процедура ЭКОМ_Объекты_События_Записать(п_Регистратор, п_ВидДокумента, п_Структура, ЗаписыватьПустыеЗначения = Ложь) Экспорт
	
	Блокировать = ПолучитьРежимУправленияБлокировкойДанныхПоУмолчанию(); 	
	// Установка блокировки
	НачатьТранзакцию();
	Попытка
		
		Если Блокировать = Истина Тогда
			БлокировкаДанных 		= Новый БлокировкаДанных;
			ЭлементБлокировки 		= БлокировкаДанных.Добавить("РегистрСведений.ЭКОМ_Объекты_События");
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			ЭлементБлокировки.УстановитьЗначение("Документ_Основание", п_Регистратор);
			ЭлементБлокировки.УстановитьЗначение("ВидДокумента", п_ВидДокумента);
			БлокировкаДанных.Заблокировать();	
		КонецЕсли;
		
		НЗ = РегистрыСведений.ЭКОМ_Объекты_События.СоздатьНаборЗаписей();
		НЗ.Отбор.Документ_Основание.Установить(п_Регистратор);
		НЗ.Отбор.ВидДокумента.Установить(п_ВидДокумента);
		НЗ.Прочитать();
		
		Если НЗ.Количество() = 0 Тогда
			НоваяЗапись = НЗ.Добавить();
			НоваяЗапись.Документ_Основание = п_Регистратор;
			НоваяЗапись.ВидДокумента       = п_ВидДокумента;
			НоваяЗапись.ДатаЗаписи         = ТекущаяДата();	
		Иначе
			НоваяЗапись = НЗ[0];
		КонецЕсли;
		
		Для Каждого Элемент Из п_Структура Цикл			
			Если ЗаписыватьПустыеЗначения Тогда
				НоваяЗапись[Элемент.Ключ] = Элемент.Значение; 	
			Иначе
				Если ЗначениеЗаполнено(Элемент.Значение) Тогда
					НоваяЗапись[Элемент.Ключ] = Элемент.Значение; 	
				КонецЕсли;
			КонецЕсли;			
		КонецЦикла;

		НЗ.ДополнительныеСвойства.Вставить("ПерваяЗапись", Истина);
		НЗ.Записать();
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();	
		ЗаписьЖурналаРегистрации("Обработка ""Интеграция Docrobot""", УровеньЖурналаРегистрации.Ошибка, , , "Конфликт записи в регистр - " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры // ЭКОМ_Объекты_События_Записать()

Функция ОтправитьФайлПоFTP(Сервер, ПолноеИмяФайла, КраткоеИмяФайла, МассивЛогаСобытий, ПрофильОбмена, ТипОбменаЭТРН)
	
	ИмяСобытия = "Отправка файлов по FTP";
	Результат = Ложь;
	Попытка
		Сервер.Записать(ПолноеИмяФайла, ПрофильОбмена.ИсходящийПутьFTP + КраткоеИмяФайла);
		Результат = Истина;
	Исключение
		Сервер = ПолучитьFTPСоединение(ПрофильОбмена, ТипОбменаЭТРН, МассивЛогаСобытий);
		Если НЕ Сервер = Неопределено тогда
			Сервер.Записать(ПолноеИмяФайла, ПрофильОбмена.ИсходящийПутьFTP + КраткоеИмяФайла);
			Результат = Истина;
		Иначе
			ТекстЛогаСобытий = "Ошибка отправки файла - " + КраткоеИмяФайла;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
		КонецЕсли;
	КонецПопытки;
	
	Возврат Результат;    
КонецФункции

Функция СтавкаНДСЧислом(знач СтавкаНДС) Экспорт	
	
	ОбъектПеречисления  = Метаданные.Перечисления.Найти("СтавкиНДС");
	ОбъектСправочники   = Метаданные.Справочники.Найти("СтавкиНДС");
	ОбъектВидыСтавокНДС = Метаданные.Перечисления.Найти("ВидыСтавокНДС");
	
	//ТМ{   
	ЗначениеНалога = Неопределено; //инициализируем возвращаемое значение
	
	//Добавим вариант для конфигураций, в которых (на уровне метаданных) есть и перечисление СтавкиНДС, и справочник СтавкиНДС. Это, например, ERP 2.5 для РФ
	Если НЕ ОбъектПеречисления = Неопределено И НЕ ОбъектСправочники = Неопределено Тогда
		РеквизитСтавка = Метаданные.Справочники.СтавкиНДС.Реквизиты.Найти("Ставка");
		Если НЕ РеквизитСтавка = Неопределено И РеквизитСтавка.Тип.СодержитТип(Тип("Число")) Тогда
			ЗначениеНалога = СтавкаНДС.Ставка;
			
			Возврат ЗначениеНалога; 
		КонецЕсли;	
	КонецЕсли;	
	//}ТМ
	
	Если НЕ ОбъектВидыСтавокНДС = Неопределено 
		И ТипЗнч(СтавкаНДС) = Тип("ПеречислениеСсылка.ВидыСтавокНДС") Тогда
		СтавкаНДС = Перечисления.СтавкиНДС.СтавкаНДС(СтавкаНДС, ТекущаяДата());				
	КонецЕсли;	

	Если НЕ ОбъектПеречисления = Неопределено Тогда		
		Если СтавкаНДС = Перечисления.СтавкиНДС.БезНДС Тогда
			ЗначениеНалога = 0;
		ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС10 
			ИЛИ СтавкаНДС = Перечисления.СтавкиНДС.НДС10_110 Тогда
			ЗначениеНалога = 10;
		ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС18 
			ИЛИ СтавкаНДС = Перечисления.СтавкиНДС.НДС18_118 Тогда
			ЗначениеНалога = 18;
		ИначеЕсли НЕ Найти(Строка(СтавкаНДС), "20%") = 0 Тогда // Исключаем УТ 3.1 для Казахстана
			ЗначениеНалога = 20;
		Иначе		
			ЗначениеНалога = 0;
		КонецЕсли;
		
	ИначеЕсли НЕ ОбъектСправочники = Неопределено Тогда 
		
		РеквизитСтавка = Метаданные.Справочники.СтавкиНДС.Реквизиты.Найти("Ставка");
		Если НЕ РеквизитСтавка = Неопределено И РеквизитСтавка.Тип.СодержитТип(Тип("Число")) Тогда
			ЗначениеНалога = СтавкаНДС.Ставка;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ЗначениеНалога;
	
КонецФункции

Функция ПолучитьФункциюЮЗД(ФорматЮЗД = Неопределено, Контрагент = Неопределено) Экспорт 
	
	Если ЗначениеЗаполнено(Контрагент) и ФорматЮЗД = Неопределено Тогда
		
		ОтборКонтрагент = Новый Структура;
		ОтборКонтрагент.Вставить("Объект", Контрагент);
		ВыборкаGLN = РегистрыСведений.ЭКОМ_GLN.Выбрать(ОтборКонтрагент);
		Пока ВыборкаGLN.Следующий() Цикл
			ФорматЮЗД = ВыборкаGLN.Контрагент_ФорматЭСФ; 
		КонецЦикла;
		
	КонецЕсли;
		
	ДокФункция = "СЧФДОП";
	
	Если ФорматЮЗД = "УПД Лента СЧФ" 
		ИЛИ ФорматЮЗД = "УПД Метро" 
		ИЛИ ФорматЮЗД = "УПД Зельгрос"
		ИЛИ ФорматЮЗД = "УПД Магнолия"
		ИЛИ ФорматЮЗД = "УПД ОКЕЙ"
		ИЛИ ФорматЮЗД = "УПД Спар"
		ИЛИ ФорматЮЗД = "УПД Дикси юг"
		ИЛИ ФорматЮЗД = "УПД Виктория" Тогда	
		ДокФункция = "СЧФ";
	КонецЕсли;
	
	Возврат ДокФункция;
	
КонецФункции

// Функция формирует структуру инфополей для переданного формата УПД
//
// Параметры:
//  Формат  - Строка - формат УПД
//  Данные  - Структура - используемые данные для заполнения инфополей:. Список ожидаемых ключей структуры:
//		RECADV_EDIINTERCHANGEID
//		ГЛНКонтрагент
//		ГЛНОрганизации
//		ГЛНТочкиДоставки
//		ГУИДДокОснованиеДляКУПД
//		ДатаАкта
//		ДатаЗаказа
//		ДатаНакладной
//		ДатаПоставки
//		КодПоставщика
//		НомерАкта
//		НомерЗаказа
//		НомерНакладной
//
//  ЭСФБезИнфПоля  - Булево - признак отсутствия инфополей в электронной УПД
//  Отказ  - Булево - признак ошибки
//
// Возвращаемое значение:
//   Структура   - полученная коллекция инфополей
//
Функция ПолучитьСтруктуруИнфоПолейИзСправочника(ТипИнфополя, ЭКОМ_ИнфоПоле, ДанныеИнфополя, ЭтоЮЗДБезИнфПоля, ТекстСообщения = "") Экспорт
	
	Отказ = Ложь;
	МассивЛогаСобытий = Новый Массив;
	ИмяСобытия = "Получить данные ИнфоПолей - " + ТипИнфополя;
	
	// Все возможные данные по инфо полям для примера
	ПолныеДанныеИнфоПолей = Новый Массив; 
	ПолныеДанныеИнфоПолей.Добавить("номер_накладной");      // НомерНакладной - номер накладной
	ПолныеДанныеИнфоПолей.Добавить("НомНакл");              // НомерНакладной - номер накладной
	ПолныеДанныеИнфоПолей.Добавить("Номер_накладной");      // НомерНакладной - номер накладной
	ПолныеДанныеИнфоПолей.Добавить("номер_отгрузки");       // НомерНакладной - номер накладной
    ПолныеДанныеИнфоПолей.Добавить("дата_накладной");       // ДокументОснованиеДата - дата накладной
	ПолныеДанныеИнфоПолей.Добавить("ДтНакл");               // ДокументОснованиеДата - дата накладной
	ПолныеДанныеИнфоПолей.Добавить("дата_отгрузки");        // ДокументОснованиеДата - дата накладной
	ПолныеДанныеИнфоПолей.Добавить("дата_поставки");        // ДокументОснованиеДата - дата накладной 
	ПолныеДанныеИнфоПолей.Добавить("номер_заказа");         // ЗаказНомер
	ПолныеДанныеИнфоПолей.Добавить("Заказ_на_поставку");    // ЗаказНомер	
	ПолныеДанныеИнфоПолей.Добавить("дата_заказа");          // ДатаЗаказа - дата заказа	
	ПолныеДанныеИнфоПолей.Добавить("номер_акта");           // RECADV_Номер - номер акта
	ПолныеДанныеИнфоПолей.Добавить("номер_апп");            // RECADV_Номер - номер акта	
	ПолныеДанныеИнфоПолей.Добавить("дата_акта");            // RECADV_Дата - дата акта
	ПолныеДанныеИнфоПолей.Добавить("дата_апп");             // RECADV_Дата - дата акта
    ПолныеДанныеИнфоПолей.Добавить("код_поставщика");       // CAMPAIGNNUMBER - номер договора 	
	ПолныеДанныеИнфоПолей.Добавить("GLN_грузополучателя");  // ГЛНТочкиДоставки - GLN точки доставки
	ПолныеДанныеИнфоПолей.Добавить("грузополучатель");      // ГЛНТочкиДоставки - GLN точки доставки 	
    ПолныеДанныеИнфоПолей.Добавить("документ_основание");   // ГУИДДокОснованиеДляКУПД 	
	ПолныеДанныеИнфоПолей.Добавить("отправитель");          // ГЛНОрганизации - GLN организации
	ПолныеДанныеИнфоПолей.Добавить("грузоотправитель");     // ГЛНОрганизации - GLN организации
	ПолныеДанныеИнфоПолей.Добавить("поставщик");            // ГЛНОрганизации - GLN организации
	ПолныеДанныеИнфоПолей.Добавить("GLN_грузоотправителя"); // ГЛНОрганизации - GLN организации	  
	ПолныеДанныеИнфоПолей.Добавить("VID");                  // RECADV_EDIINTERCHANGEID 		
	ПолныеДанныеИнфоПолей.Добавить("получатель");           // ГЛНКонтрагент - GLN контрагента
	ПолныеДанныеИнфоПолей.Добавить("покупатель");           // ГЛНКонтрагент - GLN контрагента
	ПолныеДанныеИнфоПолей.Добавить("ORDERVID");             // ORDERVID
		 	
	// ИнфПолФХЖ2		
	ПолныеДанныеИнфоПолей.Добавить("CAMPAIGNNUMBER");                // CAMPAIGNNUMBER - номер договора
	ПолныеДанныеИнфоПолей.Добавить("номер_уведомления_об_отгрузке"); // НомерНакладной - номер накладной
	ПолныеДанныеИнфоПолей.Добавить("код_материала");                 // КодТовараПокупателя
	ПолныеДанныеИнфоПолей.Добавить("КдВЕРНЫЙ");	                     // КодТовараПокупателя
	ПолныеДанныеИнфоПолей.Добавить("SKU");                           // КодТовараПокупателя
	ПолныеДанныеИнфоПолей.Добавить("штрихкод");                      // Штрихкод
	ПолныеДанныеИнфоПолей.Добавить("Штрих-код");                     // Штрихкод
	ПолныеДанныеИнфоПолей.Добавить("артикул_поставщика");            // КодТовараПоставщика
	ПолныеДанныеИнфоПолей.Добавить("код_продавца");                  // КодТовараПоставщика
	ПолныеДанныеИнфоПолей.Добавить("вложенность_кол");               // КоличествоМест
	ПолныеДанныеИнфоПолей.Добавить("вложенность_океи");              // НаименованиеЕдиницыИзмерения
	ПолныеДанныеИнфоПолей.Добавить("позиция_заказа");                // НомерСтроки
			
	ТекстОшибки = Новый Массив;
	Результат   = Новый Соответствие;
	
	Если НЕ ЗначениеЗаполнено(ЭКОМ_ИнфоПоле) 
		 ИЛИ ЭтоЮЗДБезИнфПоля = Истина Тогда
		ЭКОМ_ИнфоПоле = Справочники.ЭКОМ_ИнфоПоля.УПД_по_умолчанию;	
	КонецЕсли;
	
	// Заполняем формат по умолчанию
	Если (ЭКОМ_ИнфоПоле.ФорматУПД = "УПД по умолчанию"
		 ИЛИ ЭКОМ_ИнфоПоле.Наименование = "УПД по умолчанию") Тогда
	     Если ЭКОМ_ИнфоПоле.ТабличнаяЧасть.Количество() = 0 Тогда
			 
			 НовыйОбъект    = Справочники.ЭКОМ_ИнфоПоля.СоздатьЭлемент();	
	         НовыйОбъект.ЗаполнитьУПД_поУмолчанию(ЭКОМ_ИнфоПоле);
			  
		 КонецЕсли;			
	КонецЕсли;
	
	// Проверка параметров.
	Если НЕ ТипЗнч(ТипИнфополя) = Тип("Строка") Тогда
		ТекстОшибки.Добавить("<<<ТипИнфополя>>> - ошибка передачи значения в параметре, тип значения должно быть строка");
	КонецЕсли;

	Если НЕ ТипЗнч(ДанныеИнфополя) = Тип("Соответствие") Тогда
		ТекстОшибки.Добавить("<<<ДанныеИнфополя>>> - ошибка при передачи значения в параметре, тип значения должно быть соответствие");
	КонецЕсли;
		
	Если НЕ ТекстОшибки.Количество() = 0 Тогда		
		ТекстЛогаСобытий = СокрЛП(ТипИнфополя) + "Ошибка (" +  СокрЛП(ТипИнфополя) + ") при заполнении процедуры для формата УПД = <<<" + ЭКОМ_ИнфоПоле.Наименование + ">>>:";
		Для Каждого Ошибка Из ТекстОшибки Цикл
			ТекстЛогаСобытий =  ТекстЛогаСобытий + Символы.ПС + "	- " + Ошибка;
		КонецЦикла;
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
		Отказ     = Истина;
		Результат = Неопределено;	
	КонецЕсли;
	
	Если Отказ = Ложь Тогда
		// Добавляем обязательные поля
		Если ТипИнфополя = "ИнфПолФХЖ1" Тогда
			
			ИмяИдентификатора = "отправитель"; 
			Значение = ДанныеИнфополя.Получить(ИмяИдентификатора);
			Если НЕ ЗначениеЗаполнено(Значение) Тогда
				ТекстОшибки.Добавить("<<<" + ИмяИдентификатора + ">>> (GLN организации) - отсутствует обязательное значение");
			КонецЕсли;
			Результат.Вставить(ИмяИдентификатора, СокрЛП(Значение));
			
			ИмяИдентификатора = "получатель";
			Значение = ДанныеИнфополя.Получить(ИмяИдентификатора);
			Если НЕ ЗначениеЗаполнено(Значение) Тогда
				ТекстОшибки.Добавить("<<<" + ИмяИдентификатора + ">>> (GLN контрагента) - отсутствует обязательное значение");
			КонецЕсли;
			Результат.Вставить(ИмяИдентификатора, СокрЛП(Значение));
			
		КонецЕсли;
		
		// Собираем нужные нам данные по формату УПД
		Для каждого Стр Из ЭКОМ_ИнфоПоле.ТабличнаяЧасть Цикл
			
			Если ТипИнфополя = Стр.ТипПоля Тогда
				
				Значение = ДанныеИнфополя.Получить(Стр.Идентификатор);
				Если ЗначениеЗаполнено(Значение) Тогда
					
					Если ТипЗнч(Значение) = Тип("Дата") Тогда
						Значение = Формат(Значение, "ДФ=dd.MM.yyyy");
					Иначе
						Значение = СокрЛП(Значение);
					КонецЕсли;
					
					Результат.Вставить(Стр.Идентификатор, Значение);
				ИначеЕсли Стр.Обязательное = Истина Тогда
					ТекстОшибки.Добавить("<<<" + Стр.Идентификатор + ">>> - отсутствует обязательное значение");
				КонецЕсли;	
				
			КонецЕсли;
			
		КонецЦикла;
		
		
		Если НЕ ТекстОшибки.Количество() = 0 Тогда		
			ТекстЛогаСобытий = "Ошибка (" +  СокрЛП(ТипИнфополя) + ") при заполнении инфополей для формата УПД = <<<" + Строка(ЭКОМ_ИнфоПоле) + ">>>:";
			Для Каждого Ошибка Из ТекстОшибки Цикл
				ТекстЛогаСобытий =  ТекстЛогаСобытий + Символы.ПС + "	- " + Ошибка;
			КонецЦикла;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Отказ     = Истина;
			Результат = Неопределено;			
		КонецЕсли;	
	КонецЕсли;
	
	Если МассивЛогаСобытий.Количество() > 0 Тогда
		 ЗаписатьЛогСобытийвРегистрЛогирование(МассивЛогаСобытий);
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

// Функция возвращает строку на валюту документа
Функция ПолучитьСтрокуВалютыДокумента(знач НаименованиеВалюты) Экспорт
	
	xmlВалюта = "RUB";
	НаименованиеВалюты = НРег(НаименованиеВалюты);
	
	Если Найти(НаименованиеВалюты, "бел") > 0
		ИЛИ НаименованиеВалюты = "BYR" Тогда
		xmlВалюта = "BYR";

	ИначеЕсли Найти(НаименованиеВалюты, "руб") > 0
		ИЛИ НаименованиеВалюты = "RUB" Тогда
		xmlВалюта = "RUB";
		
	ИначеЕсли Найти(НаименованиеВалюты, "тен") > 0
		ИЛИ НаименованиеВалюты = "KZT" Тогда
		xmlВалюта = "KZT";	
		
	ИначеЕсли Найти(НаименованиеВалюты, "грив") > 0
		ИЛИ НаименованиеВалюты = "UAH" Тогда
		xmlВалюта = "UAH";
		
	ИначеЕсли Найти(НаименованиеВалюты, "долл") > 0
		ИЛИ НаименованиеВалюты = "USD" Тогда
		xmlВалюта = "USD";
		
	ИначеЕсли Найти(НаименованиеВалюты, "евр") > 0
		ИЛИ НаименованиеВалюты = "EUR" Тогда
		xmlВалюта = "EUR";
		
	ИначеЕсли Найти(НаименованиеВалюты, "лей") > 0
		ИЛИ НаименованиеВалюты = "MDL" Тогда
		xmlВалюта = "MDL";
						
	КонецЕсли;		
	
	Возврат xmlВалюта; 
	
КонецФункции

