		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ParsedString;    
КонецФункции

Функция JSONПрочитать(Значение)
	
	ЧтениеJSON = "";
	Выполнить("ЧтениеJSON = Новый ЧтениеJSON;");
	ЧтениеJSON.УстановитьСтроку(Значение);
	
	Результат = Неопределено;
	СформироватьДерево(ЧтениеJSON, Результат);
	
	ЧтениеJSON.Закрыть();
	
	Возврат Результат;
	
КонецФункции

Функция UnJSON(СтрJSON)
	Перем Значение;
	Если ПолучитьЗначениеJSON(СтрJSON,Значение)=0 Тогда
		Возврат Значение
	КонецЕсли;
	Возврат Неопределено
КонецФункции

Функция Hex2Число(Hex) 
	
	Стр=ВРег(СокрЛП(Hex));
	Dec=0;
	Для Х=1 По СтрДлина(Стр) Цикл
		Dec=Dec+Найти("123456789ABCDEF",Сред(Стр,Х,1))*Pow(16,СтрДлина(Стр)-Х)
	КонецЦикла;
	
	Возврат Dec;
	
КонецФункции

Процедура СформироватьДерево(ЧтениеJSON, Дерево)
	
	Выполнить("ИмяСвойства = Неопределено;
	
	| Пока ЧтениеJSON.Прочитать() Цикл
	|     TипJSON = ЧтениеJSON.ТипТекущегоЗначения;
	|     
	|     Если TипJSON = ТипЗначенияJSON.НачалоОбъекта 
	|     ИЛИ TипJSON = ТипЗначенияJSON.НачалоМассива Тогда
	|         НовыйОбъект = ?(TипJSON = ТипЗначенияJSON.НачалоОбъекта, Новый Соответствие, Новый Массив);
	|         
	|         Если ТипЗнч(Дерево) = Тип(""Массив"") Тогда
	|             Дерево.Добавить(НовыйОбъект);
	|         ИначеЕсли ТипЗнч(Дерево) = Тип(""Соответствие"") И ЗначениеЗаполнено(ИмяСвойства) Тогда
	|             Дерево.Вставить(ИмяСвойства, НовыйОбъект);
	|         КонецЕсли;
	|         
	|         СформироватьДерево(ЧтениеJSON, НовыйОбъект);
	|         
	|         Если Дерево = Неопределено Тогда
	|             Дерево = НовыйОбъект;
	|         КонецЕсли;
	|     ИначеЕсли TипJSON = ТипЗначенияJSON.ИмяСвойства Тогда
	|         ИмяСвойства = ЧтениеJSON.ТекущееЗначение;
	|     ИначеЕсли TипJSON = ТипЗначенияJSON.Число 
	|     ИЛИ TипJSON = ТипЗначенияJSON.Строка 
	|     ИЛИ TипJSON = ТипЗначенияJSON.Булево 
	|     ИЛИ TипJSON = ТипЗначенияJSON.Null Тогда
	|         Если ТипЗнч(Дерево) = Тип(""Массив"") Тогда
	|             Дерево.Добавить(ЧтениеJSON.ТекущееЗначение);
	|         ИначеЕсли ТипЗнч(Дерево) = Тип(""Соответствие"") Тогда
	|             Дерево.Вставить(ИмяСвойства, ЧтениеJSON.ТекущееЗначение);
	|         КонецЕсли;
	|     Иначе
	|         Прервать;
	|     КонецЕсли;
	| КонецЦикла;");
	
КонецПроцедуры

Функция ПолучитьЗначениеJSON(СтрJSON,Значение,Позиция=1,Ключ="")
	Кавычка = "";
	
	ЗначениеВСтроке="";
	Кавычек=0;
	Комментарий=Ложь;
	Строка=Ложь;
	
	Пока Позиция<=СтрДлина(СтрJSON) Цикл
		ХХ=Сред(СтрJSON,Позиция,2);
		Х=Лев(ХХ,1);
		Позиция=Позиция+1;
		
		Если Х>" " ИЛИ Строка Тогда //Отсекаем всякий хлам
			
			Если Комментарий Тогда
				//Это комментарий. Крутимся в цикле пока не встретится конец комментария
				Если ХХ="*/" Тогда
					//Комментарий закончился
					Комментарий=Ложь;
					Позиция=Позиция+1;
				КонецЕсли;
				
			ИначеЕсли Х="\" Тогда
				Позиция=Позиция+1;
				ХХ=ВРег(ХХ);
				Если ХХ="\""" Тогда ЗначениеВСтроке=ЗначениеВСтроке+""""
				ИначеЕсли ХХ="\\" Тогда ЗначениеВСтроке=ЗначениеВСтроке+"\"
				ИначеЕсли ХХ="\/" Тогда ЗначениеВСтроке=ЗначениеВСтроке+"/"
				ИначеЕсли ХХ="\B" Тогда ЗначениеВСтроке=ЗначениеВСтроке+Символ(8)
				ИначеЕсли ХХ="\F" Тогда ЗначениеВСтроке=ЗначениеВСтроке+Символы.ПФ //перевод формы (страницы)
				ИначеЕсли ХХ="\N" Тогда ЗначениеВСтроке=ЗначениеВСтроке+Символы.ПС //перевод строки
				ИначеЕсли ХХ="\R" Тогда ЗначениеВСтроке=ЗначениеВСтроке+Символы.ВК //возврат каретки
				ИначеЕсли ХХ="\T" Тогда ЗначениеВСтроке=ЗначениеВСтроке+Символы.ВТаб //символ вертикальной табуляции
				ИначеЕсли ХХ="\U" Тогда
					ЗначениеВСтроке=ЗначениеВСтроке+Символ(Hex2Число(Сред(СтрJSON,Позиция,4))); //шестнадцатиричное число
					Позиция=Позиция+4
				КонецЕсли;
				
			ИначеЕсли Строка Тогда
				//Если строка не закончилась - то пропускаем управляющие символы
				Если Х=Кавычка Тогда
					//Закончилась строка
					Строка=Ложь;
					Кавычек=Кавычек+1;
				Иначе
					ЗначениеВСтроке=ЗначениеВСтроке+Х;
				КонецЕсли;
				
			ИначеЕсли ХХ="/*" Тогда
				//Начался комментарий
				Комментарий=Истина;
				Позиция=Позиция+1;
				
			ИначеЕсли Найти("""'{}[]:,",Х)>0 Тогда
				Если Х="""" ИЛИ Х="'" Тогда
					//Началась строка
					//Строка - коллекция нуля или больше символов Unicode, заключенная в
					//двойные кавычки, используя "\" в качестве символа экранирования.
					//Символ представляется как односимвольная строка.
					//Похожий синтаксис используется в C и Java.
					Строка=Истина;
					Кавычка=Х;
					Кавычек=Кавычек+1;
					
				ИначеЕсли Х="{" Тогда
					//Начался объект
					//Объект - неупорядоченный набор пар ключ/значение.
					//Объект начинается с "{" и заканчивается "}".
					//Каждое имя сопровождается ":", пары ключ/значение разделяются ",".
					Объект=Новый Соответствие;
					//Объект=Новый Структура;
					Пока Истина Цикл
						//Получим ключ и значение
						Ключ="";
						Режим=ПолучитьЗначениеJSON(СтрJSON,Значение,Позиция,Ключ);
						//0 - есть значение и не конец объекта (запятая)
						//1 - есть значение и конец объекта
						//2 - нет значения и не конец объекта (запятая)
						//3 - нет значения и конец объекта
						Если Режим=0 Тогда
							Объект.Вставить(Ключ,Значение);
						ИначеЕсли Режим=1 Тогда
							Объект.Вставить(Ключ,Значение);
							Прервать
						ИначеЕсли Режим=3 Тогда
							Прервать
						КонецЕсли;
					КонецЦикла;
					Значение=Объект;
					Возврат 0
					
				ИначеЕсли Х="[" Тогда
					//Начался массив
					//Массив - упорядоченная коллекция значений.
					//Массив начинается с "[" и заканчивается "]".
					//Значения разделены ",".
					Массив=Новый Массив;
					Пока Истина Цикл
						Режим=ПолучитьЗначениеJSON(СтрJSON,Значение,Позиция);
						//0 - есть значение и не конец массива (запятая)
						//1 - есть значение и конец массива
						//2 - нет значения и не конец массива (запятая)
						//3 - нет значения и конец массива
						Если Режим=0 Тогда
							Массив.Добавить(Значение);
						ИначеЕсли Режим=1 Тогда
							Массив.Добавить(Значение);
							Прервать
						ИначеЕсли Режим=3 Тогда
							Прервать
						КонецЕсли;
					КонецЦикла;
					Значение=Массив;
					Возврат 0
					
				ИначеЕсли Х="]" ИЛИ Х="}" Тогда
					//Закончился массив/объект
					Если ЗначениеВСтроке="" И Кавычек=0 Тогда
						Возврат 3 //нет значения и конец массива/объекта
					Иначе
						Значение=ПолучитьЗначениеИзСтроки(ЗначениеВСтроке,Кавычек);
						Возврат 1 //есть значение и конец массива/объекта
					КонецЕсли;
					
				ИначеЕсли Х=":" Тогда
					Ключ=ЗначениеВСтроке;
					Возврат ПолучитьЗначениеJSON(СтрJSON,Значение,Позиция);
					
				Иначе
					// запятая
					Прервать
				КонецЕсли;
				
			Иначе
				ЗначениеВСтроке=ЗначениеВСтроке+Х;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если Кавычек>0 Тогда
		Значение=ЗначениеВКавычках(ЗначениеВСтроке);
	Иначе
		Если ЗначениеВСтроке="" Тогда
			Возврат 2
		Иначе
			Значение=ЗначениеБезКавычек(ЗначениеВСтроке)
		КонецЕсли;
	КонецЕсли;
	Возврат 0
КонецФункции

Функция ПолучитьЗначениеИзСтроки(ЗначениеВСтроке,Кавычек)
	Если Кавычек>0 Тогда
		Возврат ЗначениеВКавычках(ЗначениеВСтроке)
	ИначеЕсли ЗначениеВСтроке="" Тогда
		Возврат Неопределено
	КонецЕсли;
	Возврат ЗначениеБезКавычек(ЗначениеВСтроке)
КонецФункции

Функция ЗначениеВКавычках(ЗначениеВСтроке)
	//Это или строка или дата.
	//Дата пока не обрабатывается (потом надо дописать)
	//Пока всегда возвращаем просто строку
	Возврат ЗначениеВСтроке
КонецФункции

Функция ЗначениеБезКавычек(ЗначениеВСтроке)
	//Это число, булево или null.
	//Хотя здесь могут быть и строки. Например: {Code:123}
	Стр=ВРег(ЗначениеВСтроке);
	Если Стр="TRUE" Тогда Возврат Истина
	ИначеЕсли Стр="FALSE" Тогда Возврат Ложь
	ИначеЕсли Стр="NULL" Тогда Возврат Неопределено
	КонецЕсли;
	
	//Пробежимся по предполагаемому "числу"
	Экспонента=Ложь;
	ХХ=" ";
	Для Индекс=1 По СтрДлина(Стр) Цикл
		Х=Сред(Стр,Индекс,1);
		Если Найти("0123456789.+-",Х) Тогда
			ХХ=ХХ+Х
		ИначеЕсли Х="E" Тогда
			Экспонента=Истина;
			УУ=XMLЗначение(Тип("Число"),ХХ);
			ХХ=" ";
		Иначе
			Возврат ЗначениеВСтроке //Это точно не число, а строка
		КонецЕсли;
	КонецЦикла;
	
	ХХ=XMLЗначение(Тип("Число"),ХХ);
	Если Экспонента Тогда
		ХХ=УУ*Pow(10,ХХ)
	КонецЕсли;
	
	Возврат ХХ
КонецФункции

Функция ПолучитьКраткуюИнформацияОКонфигурации() Экспорт
	
	СокращеннаяВерсия = "";
	Версия = Эком_РазложитьСтрокуВМассивПодстрок(СокрЛП(Метаданные.Версия), ".");
	Если Версия.Количество() > 1 Тогда
	     СокращеннаяВерсия = СокрЛП(Версия[0]) + "." + СокрЛП(Версия[1]);		
	КонецЕсли;
	ИмяКонфигурацииСлитно = СокрЛП(Метаданные.Имя);
	
	СоответствиеКонфигурации = Новый Соответствие;
	СоответствиеКонфигурации.Вставить("УправлениеТорговлей"     , "УТ");
	СоответствиеКонфигурации.Вставить("БухгалтерияПредприятия"  , "БП");
	СоответствиеКонфигурации.Вставить("КомплекснаяАвтоматизация", "КА");
	СоответствиеКонфигурации.Вставить("УправлениеПроизводственнымПредприятием", "УПП");
	СоответствиеКонфигурации.Вставить("УправлениеПредприятием"                , "ERP");
	
	ТипКонфигурации = СокрЛП(СоответствиеКонфигурации.Получить(ИмяКонфигурацииСлитно)) + " " + СокращеннаяВерсия;
		 
	Возврат ТипКонфигурации;
	
КонецФункции

// Функция "расщепляет" строку на подстроки, используя заданный 
//		разделитель. Разделитель может иметь любую длину. 
//		Если в качестве разделителя задан пробел, рядом стоящие пробелы 
//		считаются одним разделителем, а ведущие и хвостовые пробелы параметра Стр
//		игнорируются.
//		Например, 
//		Эком_РазложитьСтрокуВМассивПодстрок(",строка 1,,,строка 2", ",") возвратит массив значений из пяти элементов, 
//		три из которых - пустые строки, а 
//		Эком_РазложитьСтрокуВМассивПодстрок(" строка1   строка 2", " ") возвратит массив значений из двух элементов
//
//	Параметры: 
//		Стр - 			строка, которую необходимо разложить на подстроки. 
//						Параметр передается по значению.
//		Разделитель - 	строка-разделитель, по умолчанию - запятая.
//
//
//	Возвращаемое значение:
//		массив значений, элементы которого - подстроки
//
Функция Эком_РазложитьСтрокуВМассивПодстрок(Знач Стр, Разделитель = ",", ДелатьСокрЛП = Истина, ПропускатьПустыеЗначения = Истина) Экспорт
	
	МассивСтрок = Новый Массив();
	Если Разделитель = " " Тогда
		Стр = СокрЛП(Стр);
		Пока Истина Цикл
			Поз = Найти(Стр,Разделитель);
			Если Поз=0 Тогда
				ТекущееЗначение = ?(ДелатьСокрЛП = Истина, СокрЛП(Стр), Стр);
				Если ЗначениеЗаполнено(ТекущееЗначение) ИЛИ ПропускатьПустыеЗначения = Ложь Тогда 
					МассивСтрок.Добавить(ТекущееЗначение);
				КонецЕсли;
				Возврат МассивСтрок;
			КонецЕсли;
			ТекущееЗначение = Лев(Стр,Поз-1);
			ТекущееЗначение = ?(ДелатьСокрЛП = Истина, СокрЛП(ТекущееЗначение), ТекущееЗначение);
			Если ЗначениеЗаполнено(ТекущееЗначение) ИЛИ ПропускатьПустыеЗначения = Ложь Тогда 
				МассивСтрок.Добавить(ТекущееЗначение);
			КонецЕсли;
			Стр = СокрЛ(Сред(Стр,Поз));
		КонецЦикла;
	ИначеЕсли Разделитель = "" Тогда
		Для Поз = 1 По СтрДлина(Стр) Цикл
			Если ЗначениеЗаполнено(ТекущееЗначение) ИЛИ ПропускатьПустыеЗначения = Ложь Тогда 
				МассивСтрок.Добавить(Сред(Стр, Поз, 1));
			КонецЕсли;
		КонецЦикла;
		Возврат МассивСтрок;
	Иначе
		ДлинаРазделителя = СтрДлина(Разделитель);
		Пока Истина Цикл
			Поз = Найти(Стр,Разделитель);
			Если Поз=0 Тогда
				ТекущееЗначение = ?(ДелатьСокрЛП = Истина, СокрЛП(Стр), Стр);
				Если ЗначениеЗаполнено(ТекущееЗначение) ИЛИ ПропускатьПустыеЗначения = Ложь Тогда 
					МассивСтрок.Добавить(ТекущееЗначение);
				КонецЕсли;
				Возврат МассивСтрок;
			КонецЕсли;
			ТекущееЗначение = Лев(Стр,Поз-1);
			ТекущееЗначение = ?(ДелатьСокрЛП = Истина, СокрЛП(ТекущееЗначение), ТекущееЗначение);
			Если ЗначениеЗаполнено(ТекущееЗначение) ИЛИ ПропускатьПустыеЗначения = Ложь Тогда 
				МассивСтрок.Добавить(ТекущееЗначение);
			КонецЕсли;
			Стр = Сред(Стр,Поз+ДлинаРазделителя);
		КонецЦикла;
	КонецЕсли;
	Результат = МассивСтрок;
КонецФункции

Функция ЭКОМ_ЕстьРоль(ИмяРоли, Пользователь) Экспорт

	ЭКОМ_РольУстановлена = Ложь;
	Если НЕ Метаданные.Справочники.Найти("ГруппыДоступа") = Неопределено Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	1 
		|ИЗ
		|	Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПрофилиГруппДоступа.Роли КАК ПрофилиГруппДоступаРоли
		|		ПО ГруппыДоступаПользователи.Ссылка.Профиль = ПрофилиГруппДоступаРоли.Ссылка
		|ГДЕ
		|	ПрофилиГруппДоступаРоли.Роль.Имя = &Роль
		|	И ГруппыДоступаПользователи.Пользователь = &Пользователь";
		
		Запрос.УстановитьПараметр("Пользователь", Пользователь);
		Запрос.УстановитьПараметр("Роль", ИмяРоли);
		
		УстановитьПривилегированныйРежим(Истина);
		РезультатЗапроса = Запрос.Выполнить();
		УстановитьПривилегированныйРежим(Ложь);
		
		Если НЕ РезультатЗапроса.Пустой() Тогда		
			ЭКОМ_РольУстановлена = Истина;
		Иначе
			ЭКОМ_РольУстановлена = РольДоступна(ИмяРоли) ИЛИ РольДоступна("ПолныеПрава");
		КонецЕсли;
	Иначе	
		
		ЭКОМ_РольУстановлена = РольДоступна(ИмяРоли) ИЛИ РольДоступна("ПолныеПрава");  
		
	КонецЕсли;
	
	Возврат ЭКОМ_РольУстановлена;
	
КонецФункции

// Функция предназначена для преобразования номера документа.
//
// Параметры:
//  Документ - ДокументСсылка или Номер документа строкой.
//
// Возвращаемое значение.
//  Строка - номер документа для печати
//
Функция ЭКОМ_ПолучитьНомерНаПечать(Документ, Латинские=Ложь) Экспорт 
	
	Если Документ = Неопределено Тогда 
		Возврат "0";
	КонецЕсли;
	
	Если ТипЗнч(Документ) = Тип("Строка") Тогда
		
		НомерБезПрефиксовИНулей = Врег(СокрЛП(Документ)); 
		
		Буквы = Врег("абвгдеёжзийклмнопрстуфхцчшщъыьэюя-0");
		Пока Найти(Буквы, Лев(НомерБезПрефиксовИНулей, 1)) > 0 Цикл
			НомерБезПрефиксовИНулей = Сред(НомерБезПрефиксовИНулей, 2);	
		КонецЦикла;
		
		Если Латинские Тогда
			Буквы = Врег("qwertyuiopasdfghjklzxcvbnm-0");
			Пока Найти(Буквы, Лев(НомерБезПрефиксовИНулей, 1)) > 0 Цикл
				НомерБезПрефиксовИНулей = Сред(НомерБезПрефиксовИНулей, 2);	
			КонецЦикла;
		КонецЕсли;
		
	Иначе
		
		Номер   = СокрЛП(Документ.Номер);
		Длина 	= СтрДлина(Номер);
		Цифры	= "0123456789";
		Результат = "";
		
		Для Индекс = 0 По Длина - 1 Цикл
			
			НомерСимвола 	= Длина - Индекс;
			Символ 			= Сред(Номер, НомерСимвола, 1);
			
			Если Найти(Цифры, Символ) = 0 Тогда
				Прервать;
			Иначе
				Результат = Символ + Результат;
			КонецЕсли;
			
		КонецЦикла;
		
		НомерБезПрефиксовИНулей  = Формат(Число(Результат), "ЧГ=0");
		
	КонецЕсли;
	
	Возврат НомерБезПрефиксовИНулей;
	
КонецФункции

// Функция преобразования телефона без знаков.
//
// Параметры:
//  Телефон - строка.
//
// Возвращаемое значение.
//  Строка - телефон
//
Функция ЭКОМ_ПолучитьТелефонНаПечать(Телефон) Экспорт 
	
	Если Телефон = Неопределено Тогда 
		Возврат "0";
	КонецЕсли;
	
	Телефон = СтрЗаменить(Телефон,"+","");
	Телефон = СтрЗаменить(Телефон,"-","");
	Телефон = СтрЗаменить(Телефон,"(","");
	Телефон = СтрЗаменить(Телефон,")","");
	Телефон = СтрЗаменить(Телефон,Символы.НПП,"");
	Если Лев(Телефон, 1) = "7" Тогда
		Телефон = Сред(Телефон, 2);	
	КонецЕсли;
	
	Возврат Телефон
	
КонецФункции

Функция ОпределитьИННОрганизации(Организация) Экспорт 
	
	ИмяТипаОрганизации  = Организация.Метаданные().Имя;
	Если НЕ ЗначениеЗаполнено(ИмяТипаОрганизации) Тогда
		ИмяТипаОрганизации = "Организации";
	КонецЕсли;
	МетаданныеОрганизацииИНН = Метаданные.Справочники[ИмяТипаОрганизации].Реквизиты.Найти("ИНН");
	
	ИННОрганизации = "";
	Если НЕ МетаданныеОрганизацииИНН = Неопределено Тогда
		ИННОрганизации = Организация.ИНН; 
	Иначе
		ИННОрганизации = НастройкиПрочитатьНаСервере("ЭКОМ_ИНН_Организации", "", "РеквизитДляОрганизации");
	КонецЕсли;
		
	Возврат ИННОрганизации;
	
КонецФункции

// Так как на клиенте ссылки не читаются передаем реквизиты в структуру
Функция ПолучитьДанныеСертификатаЭКОМ(СертификатЭКОМ) Экспорт
	
	ИННОрганизации = ОпределитьИННОрганизации(СертификатЭКОМ.Организация);
	
	Результат = Новый Структура;
	Результат.Вставить("Организация"               , СертификатЭКОМ.Организация);
	Результат.Вставить("ИНН"                       , ИННОрганизации);
	Результат.Вставить("СертификатЭКОМ"            , СертификатЭКОМ);
	Результат.Вставить("ДолжностьПодписанта"       , СертификатЭКОМ.ДолжностьПодписанта);
	Результат.Вставить("ФамилияПодписанта"         , СертификатЭКОМ.ФамилияПодписанта);
	Результат.Вставить("ИмяПодписанта"             , СертификатЭКОМ.ИмяПодписанта);
	Результат.Вставить("ОтчествоПодписанта"        , СертификатЭКОМ.ОтчествоПодписанта);
	Результат.Вставить("ОтпечатокСертификата"      , СертификатЭКОМ.ОтпечатокСертификата);
	Результат.Вставить("ИмяСертификата"            , СертификатЭКОМ.ИмяСертификата);
	Результат.Вставить("ПарольСертификата"         , СертификатЭКОМ.ПарольСертификата);
	Результат.Вставить("ОбластьПолномочий"         , СертификатЭКОМ.ОбластьПолномочий);
	Результат.Вставить("СтатусПодписанта"          , СертификатЭКОМ.СтатусПодписанта);
	Результат.Вставить("ОснованиеПолномочий"       , СертификатЭКОМ.ОснованиеПолномочий);
	Результат.Вставить("АлгоритмПодписи"           , СертификатЭКОМ.АлгоритмПодписи);
	Результат.Вставить("СведенияЕсть"              , Истина);
	Результат.Вставить("СертификатНаСервере"       , СертификатЭКОМ.СертификатНаСервере);
	Результат.Вставить("УстановленВЛичномХранилище", СертификатЭКОМ.УстановленВЛичномХранилище);
	
    Возврат Результат;
	
КонецФункции 

// Настройки хранятся в ЭКОМ_ЗначениеДополнительныхКонстант - функция получает соответствие настроек
// Имя - имя настройки
// опрЗначение - значение по умолчанию
// Измерение - может хранится в разрезе (организаций, пользователей)
Функция ПолучитьСписокНастроекНаСервере() Экспорт	
	
	Настройки 	= Новый Соответствие;
	Запрос 		= Новый Запрос;
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЭКОМ_ЗначениеДополнительныхКонстант.ДополнительнаяКонстанта КАК ДополнительнаяКонстанта,
		|	ЭКОМ_ЗначениеДополнительныхКонстант.Измерение КАК Измерение,
		|	ЭКОМ_ЗначениеДополнительныхКонстант.ЗначениеДополнительногоХранилища,
		|	ЭКОМ_ЗначениеДополнительныхКонстант.ЗначениеДополнительнойКонстанты
		|ИЗ
		|	РегистрСведений.ЭКОМ_ЗначениеДополнительныхКонстант КАК ЭКОМ_ЗначениеДополнительныхКонстант
		|ГДЕ
		|	НЕ ЭКОМ_ЗначениеДополнительныхКонстант.Измерение = ""Номенклатура_""
		|	И НЕ ЭКОМ_ЗначениеДополнительныхКонстант.Измерение = ""Контрагент_""
		|	И НЕ ЭКОМ_ЗначениеДополнительныхКонстант.Измерение = ""ТочкаДоставки_""
		|	И НЕ ЭКОМ_ЗначениеДополнительныхКонстант.Измерение = ""Организация_""";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ТипЗнч(Выборка.ЗначениеДополнительнойКонстанты) = Тип("Неопределено") Тогда
			Значение = Выборка.ЗначениеДополнительногоХранилища.Получить();
		Иначе	
			Значение = Выборка.ЗначениеДополнительнойКонстанты;
		КонецЕсли;

		Настройки.Вставить(Выборка.ДополнительнаяКонстанта + СокрЛП(Выборка.Измерение), Значение);
	КонецЦикла;

	Возврат Настройки;
	
КонецФункции

Функция ПолучитьЗначениеНастройкиНаСервере(Настройка, Имя, Измерение, ЗначениеПоУмолчанию) Экспорт	
	
	ЗначениеНастройки = Настройка.Получить(Имя + СокрЛП(Измерение));
	Если ЗначениеНастройки = Неопределено Тогда
	     ЗначениеНастройки = ЗначениеПоУмолчанию
	 КонецЕсли;
	 
	Возврат ЗначениеНастройки;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ОТПРАВКА ДОКУМЕНТОВ

// Процедура вызывает отправку входящих документов
//
// Параметры:
//  Адрес  - Строка - адрес параметров во временном хранилище
//	АдресНаСервере - Строка - адрес недоступных на клиенте параметров во временном хранилище
//
Процедура ОтправкаДокументовПотоком(Обработка, СписокДляОтправки, ТипДокумента, МассивЛогаСобытий, ЭтоРегламентноеЗадание, СтруктураЛога) Экспорт
	
	КоличествоВПакете		       = 200;
	ЧислоПараллельныхПотоков       = 5;
	
	// Разбивка коллекции для отправки на пакеты по n документов.
	ПакетыФайлов = Новый Массив;
	Пакет        = Новый Массив;		
	Для каждого ЭлементСписка Из СписокДляОтправки Цикл
		
		// Больше в пакет не помещается
		Если Пакет.Количество() >= КоличествоВПакете Тогда 
			
			ПакетыФайлов.Добавить(Пакет);
			Пакет = Новый Массив;
		КонецЕсли;
		
		Пакет.Добавить(ЭлементСписка);
		
	КонецЦикла;
	
	// Если не добираем пакет 
	Если ПакетыФайлов.Найти(Пакет) = Неопределено Тогда
		ПакетыФайлов.Добавить(Пакет);
	КонецЕсли;
	
	// Отправка файлов (запуск фоновых заданий).
		
	// Массив, где будут храниться фоновые задания
	МассивФоновыхЗаданий = Новый Массив;
	
	Для каждого СтрокаПакет Из ПакетыФайлов Цикл
		
		УникальныйИдентификатор = Новый УникальныйИдентификатор;
		
		// Определяем массив параметров для процедуры		
		ПараметрыПотока = Новый Массив;
		ПараметрыПотока.Добавить(Обработка);
		ПараметрыПотока.Добавить(СтрокаПакет);
		ПараметрыПотока.Добавить(ТипДокумента);
		ПараметрыПотока.Добавить(МассивЛогаСобытий);
		ПараметрыПотока.Добавить(ЭтоРегламентноеЗадание);
		ПараметрыПотока.Добавить(СтруктураЛога);
		
		// Запуск фонового задания
		Задание = ФоновыеЗадания.Выполнить("ЭКОМ_ОбщегоНазначения.ВыполнитьПотокОтправкиДокументов", ПараметрыПотока, УникальныйИдентификатор, "Docrobot: Отправка документов");
		
		// Добавляем задание в массив, чтобы потом отследить выполнение
		МассивФоновыхЗаданий.Добавить(Задание);

		Если МассивФоновыхЗаданий.Количество() >= ЧислоПараллельныхПотоков Тогда
            Попытка
                ФоновыеЗадания.ОжидатьЗавершенияВыполнения(МассивФоновыхЗаданий);
			Исключение
				ЗаписьЖурналаРегистрации("Отправка документов потоком", УровеньЖурналаРегистрации.Ошибка, , , КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				
            КонецПопытки;
            МассивФоновыхЗаданий.Очистить();
		КонецЕсли;
			
	КонецЦикла;
	
	// Проверим результат выполнения фоновых заданий
	Если МассивФоновыхЗаданий.Количество() > 0 Тогда
		Попытка
			ФоновыеЗадания.ОжидатьЗавершенияВыполнения(МассивФоновыхЗаданий);
		Исключение
			ЗаписьЖурналаРегистрации("Отправка документов потоком", УровеньЖурналаРегистрации.Ошибка, , , КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));

		КонецПопытки;
		МассивФоновыхЗаданий.Очистить();
		 
	КонецЕсли;
	
КонецПроцедуры // ЗагрузитьВходящиеДокументы()

