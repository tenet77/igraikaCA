// Записывает лог событий 
Процедура ЗаписатьЛогСобытий(ТекстСообщения, Знач ТекстЛогаСобытий)
    
	Если НЕ ЗначениеЗаполнено(ТекстЛогаСобытий) Тогда
		Возврат;
	Иначе
		ТекстЛогаСобытий = Строка(ТекущаяДата()) + ": " + ТекстЛогаСобытий;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстСообщения) Тогда
		ТекстСообщения = ТекстСообщения + Символы.ПС + ТекстЛогаСобытий;
	Иначе
		ТекстСообщения = ТекстЛогаСобытий;
	КонецЕсли;
	
КонецПроцедуры

// Преобразует массив лога в строковое значение 
// МассивЛогаСобытий - Массив
// ТекстСообщения - Текущий текстовый лог 
Функция ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий, ТекстСообщения = "") Экспорт
     	
  	Для каждого Запись Из МассивЛогаСобытий Цикл
		Если ЗначениеЗаполнено(Запись.Комментарий) Тогда
			ТекстСообщения = ТекстСообщения + ?(ЗначениеЗаполнено(ТекстСообщения), Символы.ПС, "") + Запись.Комментарий;
		КонецЕсли;		
	КонецЦикла;

	Возврат ТекстСообщения;
	
КонецФункции

// В регистре сведений изменяет статус цепочки документов
// Используется в ЭКОМ_Объекты_События 
Процедура ЗаписатьСтатусДокумента(ИмяРегистра, ИмяДокумента, ДокументОснование, ДанныеРесурсов, ДанныеОтбора) Экспорт
			
	НаборЗаписейЦепочкаДокументов = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
	НаборЗаписейЦепочкаДокументов.Отбор[ИмяДокумента].Установить(ДокументОснование);
	
	Для каждого Стр Из ДанныеОтбора Цикл
	    Если ЗначениеЗаполнено(Стр.Значение) Тогда
		     НаборЗаписейЦепочкаДокументов.Отбор[Стр.Ключ].Установить(Стр.Значение);
		КонецЕсли;
	КонецЦикла;
	
	НаборЗаписейЦепочкаДокументов.Прочитать();
	
	Если НаборЗаписейЦепочкаДокументов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЗаписьНабора Из НаборЗаписейЦепочкаДокументов Цикл
		
		Если НЕ ЗначениеЗаполнено(ЗаписьНабора[ИмяДокумента]) Тогда
			Продолжить;
		КонецЕсли;
		
		// Статус ЮЗД
		Если ДанныеРесурсов.Свойство("СтатусЮЗД") Тогда
			ТекущийСтатусЮЗД = ЗаписьНабора.СтатусЮЗД; 
			СтатусЮЗД = ДанныеРесурсов.СтатусЮЗД;		 
			Если СтатусЮЗД = Перечисления.ЭКОМ_Статусы.ПустаяСсылка() 
				ИЛИ  СтатусЮЗД = Перечисления.ЭКОМ_Статусы.Отправлен Тогда 
				ЗаписьНабора.КоличествоКвитанций = 0;			
			КонецЕсли;
			
			Если ДанныеРесурсов.Свойство("СчитатьКоличествоКвитанций")  Тогда
				Если ДанныеРесурсов.СчитатьКоличествоКвитанций = Истина Тогда
					ЗаписьНабора.КоличествоКвитанций = ЗаписьНабора.КоличествоКвитанций + 1;			  
				КонецЕсли;
				ДанныеРесурсов.Удалить("СчитатьКоличествоКвитанций");  
			КонецЕсли;		 		 
			
			Если СтатусЮЗД = Перечисления.ЭКОМ_Статусы.ОтправленоАннулирование
					ИЛИ СтатусЮЗД = Перечисления.ЭКОМ_Статусы.ПредложеноАннулирование
					ИЛИ СтатусЮЗД = Перечисления.ЭКОМ_Статусы.ПринятоАннулирование
					ИЛИ СтатусЮЗД = Перечисления.ЭКОМ_Статусы.ОтклоненоАннулирование Тогда
					// Для аннулирования оставляем как есть независимо от имени регистра.
				
			ИначеЕсли ИмяРегистра = "ЭКОМ_ЦепочкиДокументовПоставщика" Тогда			 
				
				Если (ТекущийСтатусЮЗД = Перечисления.ЭКОМ_Статусы.ПодписаноПокупателем
					ИЛИ СтатусЮЗД = Перечисления.ЭКОМ_Статусы.ПодписаноПокупателем)
					И ЗаписьНабора.КоличествоКвитанций >= 4 Тогда // квитанции 2, 4, 6, 11 // Новая схема 2, 3, 6, 8, 11
					СтатусЮЗД = Перечисления.ЭКОМ_Статусы.ДокументооборотЗавершен;
					
				ИначеЕсли (ТекущийСтатусЮЗД = Перечисления.ЭКОМ_Статусы.Уточнение_Получено
					ИЛИ СтатусЮЗД = Перечисления.ЭКОМ_Статусы.Уточнение_Получено)
					И ЗаписьНабора.КоличествоКвитанций >= 5 Тогда // квитанции 2, 4, 6, 9, 10 // Новая схема 2, 3, 6, 8, 9, 13
					СтатусЮЗД = Перечисления.ЭКОМ_Статусы.Подтвержден_с_отклонением;
					
				ИначеЕсли ТекущийСтатусЮЗД = Перечисления.ЭКОМ_Статусы.ПодписаноПокупателем  // квитанция 11
					И НЕ ЗаписьНабора.КоличествоКвитанций = 0 Тогда                          
					СтатусЮЗД = Перечисления.ЭКОМ_Статусы.ПодписаноПокупателем;
					
				ИначеЕсли ТекущийСтатусЮЗД = Перечисления.ЭКОМ_Статусы.Уточнение_Получено   // квитанция 9
					И НЕ ЗаписьНабора.КоличествоКвитанций = 0 Тогда 
					СтатусЮЗД = Перечисления.ЭКОМ_Статусы.Уточнение_Получено;
					
				ИначеЕсли ТекущийСтатусЮЗД = Перечисления.ЭКОМ_Статусы.ДокументооборотЗавершен Тогда 					 
					СтатусЮЗД = Перечисления.ЭКОМ_Статусы.ДокументооборотЗавершен;
					
				ИначеЕсли ТекущийСтатусЮЗД = Перечисления.ЭКОМ_Статусы.Подтвержден_с_отклонением Тогда 					 
					СтатусЮЗД = Перечисления.ЭКОМ_Статусы.Подтвержден_с_отклонением;
					
				КонецЕсли;
			ИначеЕсли ИмяРегистра = "ЭКОМ_ЦепочкиДокументовПокупателя" Тогда	
				 //Docrobot 29.11.21 MOD-1451 [получение статуса ЮЗД по приоритету]
				 //Закомментирован так как последний статус мы получаем в модуле набора записей РС ЭКОМ ОбъектыСобытия 
				//Если (ТекущийСтатусЮЗД = Перечисления.ЭКОМ_Статусы.ПодписаноПокупателем
				//	ИЛИ СтатусЮЗД = Перечисления.ЭКОМ_Статусы.ПодписаноПокупателем)
				//	И ЗаписьНабора.КоличествоКвитанций >= 5 Тогда // квитанции 3, 5, 6, 7, 8, 11  // Новая схема 3, 6, 7, 8, 11
				//	СтатусЮЗД = Перечисления.ЭКОМ_Статусы.ДокументооборотЗавершен;
				//	
				//ИначеЕсли (ТекущийСтатусЮЗД = Перечисления.ЭКОМ_Статусы.ОтправленоУточнение
				//	ИЛИ СтатусЮЗД = Перечисления.ЭКОМ_Статусы.ОтправленоУточнение)
				//	И ЗаписьНабора.КоличествоКвитанций >= 7 Тогда // квитанции 3, 5, 6, 7, 8, 9, 10  // Новая схема 3, 6, 7, 8, 9, 12, 13
