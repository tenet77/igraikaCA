Функция ЭКОМ_Общее_ПолучитьРазделительПутиНаСервере() Экспорт
		
	РазделительПути = "";

	Если ВерсияПлатформыНаСервере() >= 8330 Тогда
		Выполнить("РазделительПути = ПолучитьРазделительПутиСервера()");
	Иначе
		
		СистемнаяИнформация = Новый СистемнаяИнформация;	
		ЭтоLinuxКлиент = СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86 
		ИЛИ СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86_64;
		
		Если ЭтоLinuxКлиент Тогда 
			РазделительПути = "/"; // Linux
		Иначе
			РазделительПути = "\";  // Windows
		КонецЕсли;
		
	КонецЕсли;
			
    Возврат РазделительПути;

КонецФункции

Функция ВерсияПлатформыНаСервере() Экспорт
	
	// # Пример: 8.3.11.3034 - 83110 (версия по трем позициям) и до 4 знаков 
    // # Пример: 8.3.5.6565  - 8350 (версия по трем позициям) и до 4 знаков 	
	// # Пример: 8.2.19.4342 - 8219 (версия по трем позициям) и до 4 знаков 
    // # Пример: 8.3.10.4342 - 83100(версия по трем позициям) и до 4 знаков
	// # Пример: 8.3.9.4342  - 8390 (версия по трем позициям) и до 4 знаков
	// # Пример: 8.3.12.4342 - 83120(версия по трем позициям) и до 4 знаков
	// # Пример: 8.3.1.00    - 8310(версия по трем позициям) и до 4 знаков
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	ТекущаяВерсия = СистемнаяИнформация.ВерсияПриложения;
	
	Версия  = "";
	Для н = 1  По 3 Цикл
		ПозицияТочки  = Найти(ТекущаяВерсия, ".");
		Символ        = Лев(ТекущаяВерсия , ПозицияТочки - 1);
		ТекущаяВерсия = Сред(ТекущаяВерсия, ПозицияТочки + 1);
		Версия        = Версия + Символ;
	КонецЦикла;
	
	Если СтрДлина(Версия) < 4 
		 ИЛИ (Сред(Версия, 2, 1) = "3" И СтрДлина(Версия) = 4) Тогда
	    Версия = Версия + "0";	
	КонецЕсли;
	
	ВерсияЧисло = ЭКОМ_ПреобразоватьВЧислоОбщегоНазначения(Версия);
	
	Возврат ВерсияЧисло;
	
КонецФункции

Функция ПроверитьСертификат(Знач ЭКОМ_СправочникСертификат, МассивЛогаСобытий) Экспорт
	
	СертификатПроверен = Ложь;
    
    ФайлXMLПолноеИмя       = СоздатьТестовыйФайл();
    ДвоичныеДанныеФайлаXML = Новый ДвоичныеДанные(ФайлXMLПолноеИмя);
	
    НоваяПодписьДвоичныеДанные = ЭЦП_СформироватьПодписьФайлаОбщегоНазначения(ДвоичныеДанныеФайлаXML, ЭКОМ_СправочникСертификат, МассивЛогаСобытий);
	Если НоваяПодписьДвоичныеДанные = Неопределено Тогда
		ТекстЛогаСобытий = "Подпись не сформирована - проверьте пароль, алгоритм подписи, срок действия сертификата.";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, "Проверка сертификата");
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
	Иначе
		СертификатПроверен = Истина;
	КонецЕсли;

    УдалитьФайлы(ФайлXMLПолноеИмя);
    
    Возврат СертификатПроверен;
	
КонецФункции  

Процедура ЭЦП_ЗаменитьНедопустимыеСимволы(Текст) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Текст = "";
		Возврат;
	КонецЕсли;
	
	#Если НЕ ВебКлиент Тогда	
        Позиция = 1;
        Пока Позиция <> 0 Цикл
            
            Позиция = НайтиНедопустимыеСимволыXML(Текст, Позиция);
            
            Если Позиция <> 0 Тогда
                НоваяСтрока = Лев(Текст, Позиция - 1) + " " + Сред(Текст, Позиция + 1);
                Текст = НоваяСтрока;
            КонецЕсли;	
            
        КонецЦикла;	
    #КонецЕсли
КонецПроцедуры

Функция ЭЦП_СформироватьПодписьФайлаОбщегоНазначения(ДвоичныеДанныеФайлаXML, СертификатЭКОМ, МассивЛогаСобытий) Экспорт
	
	ИмяСобытия = "Формирование подписи";
	МенеджерКриптографии  = ЭЦП_ПолучитьМенеджерКриптографии(СертификатЭКОМ.АлгоритмПодписи, МассивЛогаСобытий);	
	Если МенеджерКриптографии = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    
	// Получаем сертификат
	Сертификат = ЭЦП_ПолучитьСертификатПоОтпечатку(МенеджерКриптографии, СертификатЭКОМ);	
	Если Сертификат = Неопределено Тогда
		ТекстЛогаСобытий = ЭКОМ_ОбщегоНазначения.ОписаниеСертификата(СертификатЭКОМ) + " не найден в настройках [ЭКОМ_Сертификаты] в указанном хранилище сертификатов." + Символы.ПС + "Сертификат не определен (На сервере)."; 
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		Возврат Неопределено;
	//Docrobot 1.19.1 MOD-1637	
	ИначеЕсли Сертификат.ДатаОкончания < ТекущаяДата() Тогда 
		ТекстЛогаСобытий = "У сертификата " + ЭКОМ_ОбщегоНазначения.ОписаниеСертификата(СертификатЭКОМ) + " истек срок действия.";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		Возврат Неопределено;
		
	КонецЕсли;
	
	СертификатПодходит = СертификатПодходит(Сертификат, СертификатЭКОМ, МассивЛогаСобытий);	
	Если НЕ СертификатПодходит Тогда
        Возврат Неопределено;
    КонецЕсли;
			
	МенеджерКриптографии.ПарольДоступаКЗакрытомуКлючу = СертификатЭКОМ.ПарольСертификата;
	ДатаПодписи = ТекущаяДата();
	
	Попытка
		ДвоичныеДанныеПодписи = МенеджерКриптографии.Подписать(ДвоичныеДанныеФайлаXML, Сертификат);
				
	Исключение
		ТекстЛогаСобытий = "";
		Если ПустаяСтрока(СертификатЭКОМ.ПарольСертификата) Тогда
			ТекстЛогаСобытий = "Обратите внимание, у Вас в справочнике ЭКОМ_Сертификаты не указан пароль. Неправильный/пустой пароль может быть причиной ошибки подписания."; 
		КонецЕсли;
		ТекстЛогаСобытий    = ТекстЛогаСобытий + ?(ЗначениеЗаполнено(ТекстЛогаСобытий), Символы.ПС, "") + ОписаниеОшибки();
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		Возврат Неопределено;
	КонецПопытки;
    				  	
	Возврат ДвоичныеДанныеПодписи;
	
КонецФункции

Функция СертификатПодходит(СертификатМенеджераКриптографии, ДанныеСертификатаЭКОМ, МассивЛогаСобытий) Экспорт
	
	ЭтотСертификатПодходит = Ложь;
    
    Организация        = ДанныеСертификатаЭКОМ.Организация;
    СубъектСертификата = СертификатМенеджераКриптографии.Субъект;
    
    ИНН_Юл_ИзСертификата = "";
	СубъектСертификата.Свойство("OID1_2_643_100_4", ИНН_Юл_ИзСертификата);
	Если ИНН_Юл_ИзСертификата = Неопределено Тогда
		СубъектСертификата.Свойство("OID1_2_643_3_131_1_1", ИНН_Юл_ИзСертификата);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИНН_Юл_ИзСертификата) Тогда
		
		ИННОрганизации = ОпределитьИННОрганизации(Организация); 
		
		ИННСертификатаПодписи = ЭКОМ_ПреобразоватьВЧислоОбщегоНазначения(ИНН_Юл_ИзСертификата);
		ИННОрганизации        = ЭКОМ_ПреобразоватьВЧислоОбщегоНазначения(ИННОрганизации);
		
		ЭтотСертификатПодходит = (ИННОрганизации = ИННСертификатаПодписи);
		
		Если ЭтотСертификатПодходит = Ложь Тогда
			ОрганизацияСертификата = ?(ЗначениеЗаполнено(Организация)
			, "организации [" + Строка(Организация) + "]"
			, "в справочнике ЭКОМ_Сертификаты, не заполнена организация. ИНН по пустой организации"
			);
			
			ТекстЛогаСобытий = "ИНН [" + Формат(ИННОрганизации, "ЧГ=0") + "] " + ОрганизацияСертификата + " отличается от ИНН [" 
			+ Формат(ИННСертификатаПодписи, "ЧГ=0") + "] сертификата, указанного для этой организации.";
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, "Проверка сертификата");
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		КонецЕсли;
			
	Иначе
		
		ЭтотСертификатПодходит = Истина;
		
	КонецЕсли;
        
    Возврат ЭтотСертификатПодходит;
	
КонецФункции 

Функция ЭЦП_ПолучитьСертификатПоОтпечатку(МенеджерКриптографии, СертификатЭКОМ) Экспорт
	
	ЗначениеХранилищеСертификатов = Неопределено;
	Если СертификатЭКОМ.УстановленВЛичномХранилище Тогда
		ЗначениеХранилищеСертификатов = МенеджерКриптографии.ПолучитьХранилищеСертификатов(ТипХранилищаСертификатовКриптографии.ПерсональныеСертификаты);
	Иначе	
		ЗначениеХранилищеСертификатов = МенеджерКриптографии.ПолучитьХранилищеСертификатов();
	КонецЕсли;
	
	ДвоичныеДанныеОтпечатка = Base64Значение(СертификатЭКОМ.ОтпечатокСертификата);
	Сертификат = ЗначениеХранилищеСертификатов.НайтиПоОтпечатку(ДвоичныеДанныеОтпечатка);
	
	Возврат Сертификат;
    
КонецФункции

