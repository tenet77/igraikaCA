// ПОДКЛЮЧЕНИЕ ПО WS

Функция WS_ПодключениеПоСсылкиWS(ПрофильОбмена)
	
	СтруктураДанных = Новый Структура;
	
	Если ЗначениеЗаполнено(ПрофильОбмена.СерверAPI) Тогда
		ЭКОМ_СерверОбменаAPI = ПрофильОбмена.СерверAPI;
		
	Иначе	
		ЭКОМ_СерверОбменаAPI = "api-service.e-vo.ru";	
	
	КонецЕсли;

	// Определяем страну для подключения
	Если ПрофильОбмена.Страна = "kz" Тогда
		
		URIПространстваИмен = "http://soap.edi.exite.org/";
		Если НЕ Метаданные.WSСсылки.Найти("ExiteWsServiceKZ") = Неопределено Тогда
			ПроксиWS = WSСсылки.ExiteWsServiceKZ.СоздатьWSПрокси(URIПространстваИмен, "EdiServerImplService", "EdiServerImplPort");
		Иначе
			ОпределениеWS = Новый WSОпределения("https://soap.e-vo.kz/soap/?wsdl", "", "");
			ПроксиWS = Новый WSПрокси(ОпределениеWS, URIПространстваИмен, "EdiServerImplService", "EdiServerImplPort");		
		КонецЕсли;
		
	Иначе
		
		URIПространстваИмен = "http://soap.edi.exite.org";
		Если НЕ Метаданные.WSСсылки.Найти("ExiteWsServiceRU") = Неопределено Тогда
			ПроксиWS = WSСсылки.ExiteWsServiceRU.СоздатьWSПрокси(URIПространстваИмен, "ExiteWsService", "ExiteWsSoap11");
		Иначе
			ОпределениеWS = Новый WSОпределения("https://soap-api.e-vo.ru/soap/exite.wsdl", "", "");
			ПроксиWS = Новый WSПрокси(ОпределениеWS, URIПространстваИмен, "ExiteWsService", "ExiteWsSoap11");		
		КонецЕсли;
		
	КонецЕсли;
	
	// Авторизация
	Если ВерсияПлатформыНаСервере() < 8310 Тогда 
		
		ПарольХеш 		= MD5(ПрофильОбмена.ПарольПользователяFTP);
		ПарольХешMD5 	= СтрЗаменить(НРег(ПарольХеш), " ", "");
		
	Иначе // ХешированиеДанных доступна с версии платформы 8.3.1
		
		ПарольХеш		= Неопределено;
		Выполнить("ПарольХеш = Новый ХешированиеДанных(ХешФункция.MD5)");
		ПарольХеш.Добавить(ПрофильОбмена.ПарольПользователяFTP);
		ПарольХешMD5 	= СтрЗаменить(НРег(ПарольХеш.ХешСумма), " ", "");
		
	КонецЕсли;
	
	ТипПользователя    = ПроксиWS.ФабрикаXDTO.Тип(URIПространстваИмен, "ediLogin"); 
	Пользователь	   = ПроксиWS.ФабрикаXDTO.Создать(ТипПользователя);
	Пользователь.login = ПрофильОбмена.ИмяПользователяFTP;
	Пользователь.pass  = ПарольХешMD5;	
	
	СтруктураДанных.Вставить("СсылкаWS"    , ПроксиWS);
	СтруктураДанных.Вставить("Пользователь", Пользователь);
	
	Возврат СтруктураДанных;
	
КонецФункции

Функция WS_ПолучитьСписокДокументов_getList(ПрофильОбмена) Экспорт
	
	СтруктураДанных = WS_ПодключениеПоСсылкиWS(ПрофильОбмена);
	Если СтруктураДанных.Свойство("СсылкаWS") = Истина Тогда
		ПроксиWS = СтруктураДанных.ПроксиWS;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	//Вызываем метод веб-сервиса, записываем результат в переменную .
	СписокДокументов = ПроксиWS.getList(СтруктураДанных.Пользователь);
	
	Возврат СписокДокументов;
	
КонецФункции


////////////////////////////////////////////////////////////////////////////////
// ПОДКЛЮЧЕНИЕ ПО FTP

Функция ПолучитьFTPСоединение(ПараметрыОбъекта, ТипОбменаЭТРН, МассивЛогаСобытий) Экспорт
	
	знИспользуетсяПрокси       = НастройкиПрочитатьНаСервере("ЭКОМ_ИспользуетсяПрокси", Ложь);
	знИмяПользователяПрокси    = НастройкиПрочитатьНаСервере("ЭКОМ_ИмяПользователяПрокси", "");
	знПарольПользователяПрокси = НастройкиПрочитатьНаСервере("ЭКОМ_ПарольПользователяПрокси", "");
	знПорт                     = ПараметрыОбъекта.Порт;
	
	Если ТипОбменаЭТРН Тогда
		знИмяПользователяFTP       = ПараметрыОбъекта.ЭТРН_ИмяПользователя;
		знПарольПользователяFTP    = ПараметрыОбъекта.ЭТРН_ПарольПользователя;
		знСерверОбмена             = ПараметрыОбъекта.ЭТРН_Сервер;

	Иначе	
		знИмяПользователяFTP       = ПараметрыОбъекта.ИмяПользователяFTP;
		знПарольПользователяFTP    = ПараметрыОбъекта.ПарольПользователяFTP;
		знСерверОбмена             = ПараметрыОбъекта.СерверFTP;
		
	КонецЕсли;
	   		
	ПараметрыFTP = Новый Структура;
	ПараметрыFTP.Вставить("Сервер"                       , знСерверОбмена);
	ПараметрыFTP.Вставить("Порт"                         , знПорт);
	ПараметрыFTP.Вставить("ИмяПользователя"              , знИмяПользователяFTP);
	ПараметрыFTP.Вставить("ПарольПользователя"           , знПарольПользователяFTP);
	ПараметрыFTP.Вставить("ПассивноеСоединение"          , Истина);
	ПараметрыFTP.Вставить("Таймаут"                      , 0);
	ПараметрыFTP.Вставить("ЗащищенноеСоединение"         , Неопределено);
	ПараметрыFTP.Вставить("УровеньИспользованияЗащитыFTP", УровеньИспользованияЗащищенногоСоединенияFTP.Авто);
	ПараметрыFTP.Вставить("ИспользуетсяПрокси"           , знИспользуетсяПрокси);
	ПараметрыFTP.Вставить("ИмяПользователяПрокси"        , знИмяПользователяПрокси);
	ПараметрыFTP.Вставить("ПарольПользователяПрокси"     , знПарольПользователяПрокси);
	
	СерверFTP = ПолучитьСерверFTPОбщийМодуль(ПараметрыFTP, МассивЛогаСобытий);
	
	Возврат СерверFTP;
	
КонецФункции

Функция ПолучитьСерверFTPОбщийМодуль(ПараметрыFTP, МассивЛогаСобытий) Экспорт
	
	ИмяСобытия = "Получение сервера FTP, модуль общего назначения";
	СерверFTP    = Неопределено;
	ПроксиСервер = Новый ИнтернетПрокси();	     			
	Если ПараметрыFTP.ИспользуетсяПрокси = Истина Тогда	
		ПроксиСервер.Пользователь = СокрЛП(ПараметрыFTP.ИмяПользователяПрокси);
		ПроксиСервер.Пароль       = СокрЛП(ПараметрыFTP.ПарольПользователяПрокси);
		ПараметрыFTP.Вставить("Прокси", ПроксиСервер);
	КонецЕсли;
	
	знПорт = ?(ТипЗнч(ПараметрыFTP.Порт) = Тип("Число"), ПараметрыFTP.Порт, ЭКОМ_ПреобразоватьВЧислоОбщегоНазначения(ПараметрыFTP.Порт));
	ПараметрыFTP.Вставить("Порт"  , знПорт);
	ПараметрыFTP.Вставить("Прокси", ПроксиСервер);
		
	Если ВерсияПлатформыНаСервере() >= 8309 Тогда
		Попытка
			Выполнить("СерверFTP = Новый FTPСоединение(
			|ПараметрыFTP.Сервер, 
			|ПараметрыFTP.Порт, 
			|ПараметрыFTP.ИмяПользователя, 
			|ПараметрыFTP.ПарольПользователя,
			|ПараметрыFTP.Прокси,
			|ПараметрыFTP.ПассивноеСоединение,
			|ПараметрыFTP.Таймаут,
			|ПараметрыFTP.ЗащищенноеСоединение,
			|ПараметрыFTP.УровеньИспользованияЗащитыFTP);");					
		Исключение
			
			ОписаниеОшибкиТекст = ОписаниеОшибки();
			Ошибка = ДатьОписаниеОшибкиПоТекстуОшибкиОбщийМодуль(ОписаниеОшибкиТекст);
			ТекстЛогаСобытий = "Не удается подключиться к серверу: " + ПараметрыFTP.Сервер + Символы.ПС + Ошибка;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
		КонецПопытки;	
	Иначе
		Попытка
			СерверFTP = Новый FTPСоединение(
			ПараметрыFTP.Сервер, 
			ПараметрыFTP.Порт, 
			ПараметрыFTP.ИмяПользователя, 
			ПараметрыFTP.ПарольПользователя,
			ПараметрыFTP.Прокси,
			ПараметрыFTP.ПассивноеСоединение,
			ПараметрыFTP.Таймаут);			
		Исключение
			ТекстЛогаСобытий = "Не удается подключиться к серверу: " + ПараметрыFTP.Сервер;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
		КонецПопытки;
	КонецЕсли;
	
	Если СерверFTP = Неопределено Тогда
		ТекстЛогаСобытий = "Отсутствует подключение к FTP (Неопределено)!";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
	КонецЕсли;

	Возврат СерверFTP;
	
КонецФункции

Функция ПроверкаПодключенияПоFTP(ПараметрыОбъекта, ТипОбменаЭТРН) Экспорт
	
	МассивЛогаСобытий = Новый Массив;
    СерверFTP = ЭКОМ_ОбщегоНазначения.ПолучитьFTPСоединение(ПараметрыОбъекта, ТипОбменаЭТРН, МассивЛогаСобытий);
	Если СерверFTP = Неопределено Тогда
	     ТекстСообщения = "Ошибка подключения по FTP";
	Иначе
		 ТекстСообщения = "Подключение по FTP успешно";  
	КонецЕсли;
	
	Возврат ТекстСообщения;
	
КонецФункции

Функция ДатьОписаниеОшибкиПоТекстуОшибкиОбщийМодуль(ТекстОшибки) Экспорт
	Если Найти(ТекстОшибки, "is not retailer gln") > 0 Тогда
		Результат = "Этот GLN не принадлежит розничной сети (ретейлеру)";
	ИначеЕсли Найти(ТекстОшибки, "error during archiving - File not found or can't be archived") > 0 Тогда
		Результат = "Ошибка помещения в архив: Файл не найден на сервере в Inbox (возможно он уже был помещен в архив ранее)";
	ИначеЕсли Найти(ТекстОшибки, "{(1)}: Ошибка при вызове конструктора (FTPСоединение): ") > 0 Тогда
		Результат = "Проблема с подключением к FTP: " + СтрЗаменить(ТекстОшибки, "{(1)}: Ошибка при вызове конструктора (FTPСоединение): ", "");
	Иначе
		Результат = ТекстОшибки;
	КонецЕсли;
	Возврат Результат;
КонецФункции

