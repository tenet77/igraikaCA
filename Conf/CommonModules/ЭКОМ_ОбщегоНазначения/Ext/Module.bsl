// ПОДКЛЮЧЕНИЕ ПО SOAP
 
Функция НовыйSOAPОбращение(ПрофильОбмена, ИмяМетода, ИменаФайлов = Неопределено, ДанныеФайла = Неопределено, МассивЛогаСобытий) Экспорт
		
	НастройкиSOAP = Новый Структура;
	НастройкиSOAP.Вставить("ПространствоИменSOAP", "http://schemas.xmlsoap.org/soap/envelope/");
	
	// Определяем страну для подключения
	Если ПрофильОбмена.Страна = "kz" Тогда		
		ХостWebСервиса      = "soap.e-vo.kz/soap";
		URIПространстваИмен = "http://soap.edi.exite.org/";
		
		Если ИмяМетода = "getListRequest" Тогда
			ИмяМетода = "getList";
			
		ИначеЕсли ИмяМетода = "getDocumentsRequest" Тогда
			ИмяМетода = "getDoc";
			
	    ИначеЕсли ИмяМетода = "sendDocumentsRequest" Тогда		
			ИмяМетода = "sendDoc";
			
		ИначеЕсли ИмяМетода = "archiveDocumentsRequest" Тогда		
			ИмяМетода = "archiveDoc";

		КонецЕсли; 
			
	Иначе
		ХостWebСервиса      = "soap-api.e-vo.ru";
		URIПространстваИмен = "http://soap.edi.exite.org";
		
	КонецЕсли;
	
	НастройкиSOAP.Вставить("ХостWebСервиса"     , ХостWebСервиса);
	НастройкиSOAP.Вставить("ПространствоИменEDI", URIПространстваИмен);
		
	XML       = СформироватьЗапросSOAP(НастройкиSOAP, ПрофильОбмена, ИмяМетода, ИменаФайлов, ДанныеФайла);
	HTTPОтвет = ОтправитьЗапросSOAP(НастройкиSOAP, ПрофильОбмена, ИмяМетода, XML, МассивЛогаСобытий);
	Результат = ОбработатьРезультатЗапросаSOAP(ИмяМетода, HTTPОтвет);
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьЗапросSOAP(НастройкиSOAP, ПрофильОбмена, ИмяМетода, ИменаФайлов = Неопределено, ДанныеФайла = Неопределено)
	
	ЗаписьXML = Новый ЗаписьXML;
	
	ПараметрыЗаписиXML = Новый ПараметрыЗаписиXML("UTF-8");
	ЗаписьXML.УстановитьСтроку(ПараметрыЗаписиXML);
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("soapenv:Envelope");
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("soapenv", НастройкиSOAP.ПространствоИменSOAP);
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("soap"   , НастройкиSOAP.ПространствоИменEDI);
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("soapenv:Header");
	ЗаписьXML.ЗаписатьКонецЭлемента(); // soapenv:Header
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("soapenv:Body");
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("soap:" + ИмяМетода); // + "Request");
	ЗаписьXML.ЗаписатьНачалоЭлемента("user");
	ЗаписатьXML(ЗаписьXML, ПрофильОбмена.ИмяПользователяFTP, "login");
	
	Если ВерсияПлатформыНаСервере() < 8310 Тогда 
		
		ПарольХеш 		= MD5(ПрофильОбмена.ПарольПользователяFTP);
		ПарольХешMD5 	= СтрЗаменить(НРег(ПарольХеш), " ", "");
		
	Иначе // ХешированиеДанных доступна с версии платформы 8.3.1
		
		ПарольХеш		= Неопределено;
		Выполнить("ПарольХеш = Новый ХешированиеДанных(ХешФункция.MD5)");
		ПарольХеш.Добавить(ПрофильОбмена.ПарольПользователяFTP);
		ПарольХешMD5 	= СтрЗаменить(НРег(ПарольХеш.ХешСумма), " ", "");
		
	КонецЕсли;
	
	ЗаписатьXML(ЗаписьXML, ПарольХешMD5, "pass");
	ЗаписьXML.ЗаписатьКонецЭлемента(); // user
	
	Если НЕ ИменаФайлов = Неопределено Тогда
		
		Для Каждого ЭлИмяФайла Из ИменаФайлов Цикл
			Если ЗначениеЗаполнено(ЭлИмяФайла) Тогда
			     ЗаписатьXML(ЗаписьXML, ЭлИмяФайла, "fileName");
			КонецЕсли;		
		КонецЦикла;
		
	КонецЕсли;
	
	Если НЕ ДанныеФайла = Неопределено Тогда
		ЗаписатьXML(ЗаписьXML, Base64Строка(ДанныеФайла), "content");
	КонецЕсли;
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // soap:_Request
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // soapenv:Body
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // soapenv:Envelope
	
	XML = ЗаписьXML.Закрыть();
	
	Возврат XML;
	
КонецФункции 

Функция ОтправитьЗапросSOAP(НастройкиSOAP, ПрофильОбмена, ИмяМетода, XML, МассивЛогаСобытий)
	
	ИмяСобытия = "Отправка по SOAP";
	Ответ      = Неопределено;
	
	ЭКОМ_ИспользуетсяПрокси = НастройкиПрочитатьНаСервере("ЭКОМ_ИспользуетсяПрокси"      , Ложь);
	Если ЭКОМ_ИспользуетсяПрокси Тогда
		ЭКОМ_ИмяСервераПрокси         = НастройкиПрочитатьНаСервере("ЭКОМ_ИмяСервераПрокси"        , "");
		ЭКОМ_ИмяПользователяПрокси    = НастройкиПрочитатьНаСервере("ЭКОМ_ИмяПользователяПрокси"   , "");
		ЭКОМ_ПарольПользователяПрокси = НастройкиПрочитатьНаСервере("ЭКОМ_ПарольПользователяПрокси", "");
		
	Иначе
		ЭКОМ_ИмяСервераПрокси         = "";
		ЭКОМ_ИмяПользователяПрокси    = "";
		ЭКОМ_ПарольПользователяПрокси = "";
	КонецЕсли;
	
	ПроксиСервер = Новый ИнтернетПрокси;
	ПроксиСервер.Пользователь = ЭКОМ_ИмяПользователяПрокси;
	ПроксиСервер.Пароль       = ЭКОМ_ПарольПользователяПрокси;
	ПроксиСервер.Сервер(ЭКОМ_ИмяСервераПрокси);	
	
	Если ВерсияПлатформыНаСервере() >= 8340  Тогда
		
		знИмяПользователяFTP    = ПрофильОбмена.ИмяПользователяFTP;
		знПарольПользователяFTP = ПрофильОбмена.ПарольПользователяFTP;
		
		Соединение = Неопределено;
		Попытка
			Выполнить("Соединение = Новый HTTPСоединение(НастройкиSOAP.ХостWebСервиса,443,знИмяПользователяFTP,знПарольПользователяFTP, ПроксиСервер, 0, Новый ЗащищенноеСоединениеOpenSSL(),Ложь);");
		Исключение
			ТекстЛогаСобытий = "Не удалось установить соединение с сервером:" 
			+ Символы.ПС + ИнформацияОбОшибке().Описание;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Возврат Неопределено;
		КонецПопытки;
		
		Попытка
			
			ЗаголовокHTTP = Новый Соответствие;
			ЗаголовокHTTP.Вставить("Content-type", "text/xml; charset=UTF-8");
			ЗаголовокHTTP.Вставить("SOAPAction", НастройкиSOAP.ПространствоИменEDI + "/" + ИмяМетода + "/Request");
			
			HTTPЗапрос = "";
			Выполнить("HTTPЗапрос = Новый HTTPЗапрос(""/soap"", ЗаголовокHTTP);");
			Выполнить("HTTPЗапрос.УстановитьТелоИзСтроки(XML, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);");
			
			ИмяВыходногоФайла = "";
			Попытка		
				Результат  = Соединение.ОтправитьДляОбработки(HTTPЗапрос, ИмяВыходногоФайла);
				Соединение = Неопределено;
				Ответ      = Результат.ПолучитьТелоКакСтроку("UTF-8");
			Исключение
				ТекстЛогаСобытий = XML + Символы.ПС + "Ошибка при отправке запроса: " + ОписаниеОшибки() + ИмяВыходногоФайла;
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
				
				Возврат Неопределено;
			КонецПопытки;
			
			Если Результат.КодСостояния > 299 Тогда
				ТекстЛогаСобытий = "Код состояния " + Результат.КодСостояния + ". Запрос не отправлен.";
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

				Возврат Неопределено;
			Иначе
				ОтветСтруктура = Новый Структура;
				ОтветСтруктура.Вставить("status", Результат.КодСостояния);
				ОтветСтруктура.Вставить("responseText", Ответ);
				Возврат ОтветСтруктура;			
			КонецЕсли;
		Исключение
			ТекстЛогаСобытий = ОписаниеОшибки();
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
					
			Возврат Ответ;
		КонецПопытки;
		
	Иначе
		
		Ответ = Новый COMОбъект("MSXML2.ServerXMLHTTP.6.0"); 	//MSXML2.xmlHttp
		Ответ.setTimeouts(10*1000, 10*1000, 20*1000, 180*1000); //resolveTimeout, connectTimeout, sendTimeout, receiveTimeout
		
		Ответ.setOption(2, 13056);
		
		Ответ.OPEN("POST", НастройкиSOAP.ХостWebСервиса, 0);
		
		Ответ.setRequestHeader("Content-type", "text/xml");
		Ответ.setRequestHeader("SOAPAction",   НастройкиSOAP.ПространствоИменEDI + "/" + ИмяМетода + "/" + "Request");
		Ответ.setRequestHeader("Host",         НастройкиSOAP.ХостWebСервиса);
		
		Попытка
			Ответ.SEND(XML);
		Исключение
			ТекстЛогаСобытий = ОписаниеОшибки();
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Возврат Неопределено;
		КонецПопытки;
		
		Возврат Ответ;
		
	КонецЕсли;
	
КонецФункции // ОтправитьЗапросSOAP()

// Функция разбирает ответ от web-сервиса после выполнения запроса
//
// Параметры
//  ИмяМетода	- Строка - метод web-сервиса, который будет исполнен в текущем запросе
//  Ответ		- экземпляр объекта, сформированный в результате выполнения запроса
//
// Возвращаемое значение:
//   Строка   	- ответ по результатам выполнения заполса к web-сервису.
//					При ошибке выполнения возвращает значение Неопределено
//
Функция ОбработатьРезультатЗапросаSOAP(ИмяМетода, Ответ)
	
	Результат 	= Новый Структура("errorCode, errorMessage, list, content", "", "", Новый Массив, Новый Массив);
	
	Если Ответ = Неопределено Тогда
		Результат.errorCode = "";
		Возврат Результат;
	КонецЕсли;
	
	ОтветXML 	= ?(Ответ.status = 200, Ответ.responseText, Неопределено);
	
	Если ОтветXML <> Неопределено Тогда
		
		ОтветДерево = СтрокаXMLВДеревоЗначений(ОтветXML);
		Result 		= Неопределено;
		
		ПолучитьЗначениеСтрокиДерева(ОтветДерево, "result", Result);
		
		Если НЕ Result = Неопределено 
			И НЕ Result.строки.Количество() = 0 Тогда
			
			Для Каждого Строка Из Result.строки Цикл
				
				Если ТипЗнч(Результат[Строка.Имя]) = Тип("Строка") Тогда
					Результат[Строка.Имя] = Строка.Значение;
				ИначеЕсли ТипЗнч(Результат[Строка.Имя]) = Тип("Массив") Тогда
					Результат[Строка.Имя].Добавить(Строка.Значение);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ОбработатьРезультатЗапросаSOAP()

Функция MD5(Знач Строка) Экспорт

	Попытка
		
		// Вычисление хэш-суммы.
		UTF8Encoding = Новый COMОбъект("System.Text.UTF8Encoding");
		MD5CryptoServiceProvider = Новый COMОбъект("System.Security.Cryptography.MD5CryptoServiceProvider");
		МассивБайтов = MD5CryptoServiceProvider.ComputeHash_2(UTF8Encoding.GetBytes_4(Строка));
		
		// Преобразование хэш-суммы в строку.
		StringBuilder = Новый COMОбъект("System.Text.StringBuilder");
		Для Каждого Элемент Из МассивБайтов Цикл
			StringBuilder.AppendFormat("{0:x2}", Элемент);
		КонецЦикла;
		
		Возврат StringBuilder.ToString();
		
	Исключение
	КонецПопытки;

КонецФункции // ВычислитьХешСтрокиПоАлгоритмуMD5()

Функция СтрокаXMLВДеревоЗначений(XMLСтрока)
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(XMLСтрока);
	ЧтениеXML.Прочитать();
	РезультатДерево = Новый ДеревоЗначений;
	РезультатДерево.Колонки.Добавить("Имя");
	РезультатДерево.Колонки.Добавить("Значение");
	МассивОткрытыхСтрок = Новый Массив;
	ПоследняяОткрытаяСтрока = Неопределено;
	
	Пока ЧтениеXML.Прочитать() Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			Если МассивОткрытыхСтрок.Количество() Тогда
				_Родитель = МассивОткрытыхСтрок[МассивОткрытыхСтрок.Количество()-1];
			Иначе
				_Родитель = РезультатДерево;
			КонецЕсли;
			
			ПоследняяОткрытаяСтрока = _Родитель.Строки.Добавить();
			ПоследняяОткрытаяСтрока.Имя = ЧтениеXML.Имя;
			МассивОткрытыхСтрок.Добавить(ПоследняяОткрытаяСтрока);
			
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
			
			ПоследняяОткрытаяСтрока.Значение = ЧтениеXML.Значение;
			
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			
			Если МассивОткрытыхСтрок.Количество() Тогда
				
				МассивОткрытыхСтрок.Удалить(МассивОткрытыхСтрок.Количество()-1);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат РезультатДерево;
	
КонецФункции // СтрокаXMLВДеревоЗначений()

Процедура ПолучитьЗначениеСтрокиДерева(ДеревоЗначений, ИмяСтроки, Результат)
	
	Для Каждого Строка Из ДеревоЗначений.Строки Цикл
		
		Если Строка.Имя = ИмяСтроки Тогда
			Результат = Строка;
		Иначе
			ПолучитьЗначениеСтрокиДерева(Строка, ИмяСтроки, Результат);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры 

