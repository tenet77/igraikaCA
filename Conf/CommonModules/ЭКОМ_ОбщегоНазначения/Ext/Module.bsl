//Docrobot 1.19.1 MOD-1637[вызывается из модуля обработки для проверки срока действия сертификата]
Функция ПроверитьСертификатДействителен(СертификатЭКОМ) Экспорт 

	МенеджерКриптографии  = ЭЦП_ПолучитьМенеджерКриптографии(СертификатЭКОМ.АлгоритмПодписи, Новый Массив);	
	Если МенеджерКриптографии = Неопределено Тогда
		Возврат "Не удалось создать менеджер криптографии.";
	Иначе 	
		// Получаем сертификат
		Сертификат = ЭЦП_ПолучитьСертификатПоОтпечатку(МенеджерКриптографии, СертификатЭКОМ);
		Если Сертификат = Неопределено Тогда 
			Возврат "Не удалось получить сертификат."
		КонецЕсли;
		Если Сертификат.ДатаОкончания < ТекущаяДата() Тогда 
			Возврат "У сертификата " + ОписаниеСертификата(СертификатЭКОМ) + " истек срок действия.";
		КонецЕсли;
	КонецЕсли;
	//Все хорошо, сертификат не просрочен
	Возврат 0;
	
КонецФункции

Функция УдалитьПовторяющиесяЭлементыМассива(Массив, НеИспользоватьНеопределено = Ложь) Экспорт
	
	ОписаниеТиповСправочники  = Справочники.ТипВсеСсылки(); 
	ОписаниеТиповДокументы    = Документы.ТипВсеСсылки(); 
	ОписаниеТиповПВХ          = ПланыВидовХарактеристик.ТипВсеСсылки(); 
	ОписаниеТиповПланыСчетов  = ПланыСчетов.ТипВсеСсылки(); 
	ОписаниеТиповПланыРасчета = ПланыВидовРасчета.ТипВсеСсылки(); 
	
	Если ТипЗнч(Массив) = Тип("Массив") Тогда 
		
		УжеВМассиве 		   = Новый Соответствие; 
		БылоНеопределено 	   = Ложь;
		КоличествоЭлементовВМассиве = Массив.Количество(); 
		
		Для ОбратныйИндекс = 1 По КоличествоЭлементовВМассиве Цикл 
			
			ЭлементМассива = Массив[КоличествоЭлементовВМассиве - ОбратныйИндекс]; 
			ТипЭлемента    = ТипЗнч(ЭлементМассива); 
			
			Если ЭлементМассива = Неопределено Тогда
				
				Если БылоНеопределено ИЛИ НеИспользоватьНеопределено Тогда
					Массив.Удалить(КоличествоЭлементовВМассиве - ОбратныйИндекс); 
				Иначе
					БылоНеопределено = Истина;
				КонецЕсли;
				
				Продолжить;
				
			ИначеЕсли ОписаниеТиповСправочники.СодержитТип(ТипЭлемента) 
			 ИЛИ ОписаниеТиповДокументы.СодержитТип(ТипЭлемента) 
			 ИЛИ ОписаниеТиповПВХ.СодержитТип(ТипЭлемента) 
			 ИЛИ ОписаниеТиповПланыСчетов.СодержитТип(ТипЭлемента) 
			 ИЛИ ОписаниеТиповПланыРасчета.СодержитТип(ТипЭлемента) Тогда 
				
				ИДЭлемента = Строка(ЭлементМассива.УникальныйИдентификатор()); 
				
			Иначе 
				
				ИДЭлемента = ЭлементМассива; 
				
			КонецЕсли; 
			
			Если УжеВМассиве[ИДЭлемента] = Истина Тогда 
				Массив.Удалить(КоличествоЭлементовВМассиве - ОбратныйИндекс); 
			Иначе 
				УжеВМассиве[ИДЭлемента] = Истина; 
			КонецЕсли; 
			
		КонецЦикла;      
		
	КонецЕсли;
	
	Возврат Массив;
	
КонецФункции

Процедура ОчиститьСтрокуXMLОтПустыхТегов(СтрокаXML, МассивТегов) Экспорт
	
	МассивТегов = ЭКОМ_ОбщегоНазначения.УдалитьПовторяющиесяЭлементыМассива(МассивТегов);
	Для Каждого Тег Из МассивТегов Цикл
		
		ИскомыйТег = "<" + Тег + "/>";
		ПозицияТега = ЭКОМ_ОбщегоНазначения.ПоискВСтроке(СтрокаXML, ИскомыйТег);
		
		Пока НЕ ПозицияТега = 0 Цикл
			
			ПозицияПСПередТегом = ЭКОМ_ОбщегоНазначения.ПоискВСтроке(СтрокаXML, "" + Символы.ПС, -1, ПозицияТега, 1);
			ДлинаТега = СтрДлина(ИскомыйТег);
			
			Если ПозицияПСПередТегом > 0 И ПозицияПСПередТегом < ПозицияТега Тогда
				Подстрока = Сред(СтрокаXML, ПозицияПСПередТегом + 1, ПозицияТега - ПозицияПСПередТегом + ДлинаТега - 1);
			Иначе
				Подстрока = ИскомыйТег;
			КонецЕсли;
			Если Сред(СтрокаXML, ПозицияТега + ДлинаТега, 1) = Символы.ПС Тогда
				Подстрока = Подстрока + Символы.ПС;
			КонецЕсли;
			
			СтрокаXML = СтрЗаменить(СтрокаXML, Подстрока, "");
			ПозицияТега = ЭКОМ_ОбщегоНазначения.ПоискВСтроке(СтрокаXML, ИскомыйТег);
			
		КонецЦикла;		
	КонецЦикла;
	
КонецПроцедуры
