// Функция преобразует иерархический XML в объект типа ДеревоЗначений
//
// Параметры
//  ИмяФайла  - Строка - путь к файлу XML
//  Колонки  - Массив - коллекция колонок создаваемого дерева значений. Может быть не заполнен
//	ДеревоЗначений - ДеревоЗначений - объект, в который будет добавлена структура файла XML.
//		Если не передается, то создается новый объект
//
// Возвращаемое значение:
//   ДеревоЗначений   - объект, созданный в результате работы функции.
//		При создании объекта на него накладывается ограничение: на одном уровне иерархии все
//		элементы будут иметь уникальное имя. Дубли элементов будут удалены из дерева значений.
//
Функция ДеревоЗначенийИзФайлаXML(ИмяФайла, Колонки = Неопределено, ДеревоЗначений = Неопределено) Экспорт

	Если ДеревоЗначений = Неопределено Тогда
    	ДеревоЗначений = Новый ДеревоЗначений();
	КонецЕсли;
	
    Если Колонки = Неопределено Тогда
        
        Колонки = Новый Массив;
        Колонки.Добавить("Тег");
        Колонки.Добавить("Атрибуты");
		Колонки.Добавить("Формула");
        Колонки.Добавить("Служебные");
		Колонки.Добавить("Использовать");
		
	КонецЕсли;
    
    Для каждого Элемент Из Колонки Цикл
		
		Если ДеревоЗначений.Колонки.Найти(Элемент) = Неопределено Тогда
        	ДеревоЗначений.Колонки.Добавить(Элемент);	
		КонецЕсли;
        
    КонецЦикла;    
        
    ЧтениеXML = Новый ЧтениеXML();

    Попытка
		ЧтениеXML.ОткрытьФайл(ИмяФайла);
		ЧтениеXML.Прочитать();
	Исключение
		ЧтениеXML.Закрыть();
		Возврат ДеревоЗначений;
	КонецПопытки;
    
    Корень         = ДеревоЗначений.Строки.Добавить();
	Если ДеревоЗначений.Колонки.Найти("Приемник") = Неопределено Тогда
    	Корень.Тег = ЧтениеXML.Имя; // Старый вариант. Предполагается в итоге отказаться от него, когда будут ликвидированы вкадки Входящие, Исходящие.
		ИмяКолонкиСТегом = "Тег";
	Иначе
		Корень.Приемник = ЧтениеXML.Имя;
		ИмяКолонкиСТегом = "Приемник";
	КонецЕсли;
	
	Корень.Служебные = ЗаполнитьСлужебныеНастройки();
    Рекурсия(Корень, ЧтениеXML, ИмяКолонкиСТегом);
	УбратьДублиСтрокНаОдномУровне(ДеревоЗначений, ИмяКолонкиСТегом);
    Дерево = ДеревоЗначений;
    
    Возврат Дерево;
    
КонецФункции // ДеревоЗначенийИзФайлаXML(ИмяФайла)

Процедура Рекурсия(СтрокаДерева, Чтение, ИмяКолонкиСТегом = "Тег") Экспорт
    
    АтрибутыСоответствие = Новый СписокЗначений;
    Пока Чтение.ПрочитатьАтрибут() Цикл
        АтрибутыСоответствие.Добавить(Чтение.Имя, "");
    КонецЦикла;
    
    Если АтрибутыСоответствие.Количество() > 0 Тогда
       	СтрокаДерева.Атрибуты = АтрибутыСоответствие;
    Иначе
        АтрибутыСоответствие = 0;
    КонецЕсли;
	
    Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
            Прервать;
        ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.Текст Тогда
            // СтрокаДерева.Текст = Чтение.Значение;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Дочерний		= СтрокаДерева.Строки.Добавить();
            Дочерний[ИмяКолонкиСТегом]	= Чтение.Имя; // Временное решение. Предполагается в итоге отказаться от него, когда будут ликвидированы вкадки Входящие, Исходящие.
            Рекурсия(Дочерний, Чтение, ИмяКолонкиСТегом);
        КонецЕсли;
    КонецЦикла;
    
КонецПроцедуры

// Процедура заполняет ключи для структуры служебных настроек
//
// Параметры:
//  Служебные  - Структура - коллекция служебных настроек
//
Функция ЗаполнитьСлужебныеНастройки() Экспорт

	Служебные = Новый Структура;
	
	Служебные.Вставить("ВидДокумента", 		Неопределено);
	Служебные.Вставить("ЗаказДата", 		Неопределено);
	Служебные.Вставить("ЗаказНомер", 		Неопределено);  
	Служебные.Вставить("Идентификатор", 	Неопределено);
	Служебные.Вставить("ИдентификаторИспр", Неопределено);
	Служебные.Вставить("Контрагент", 		Неопределено);
	Служебные.Вставить("Номер", 			Неопределено);
	Служебные.Вставить("Организация", 		Неопределено);
	Служебные.Вставить("Ссылка", 			Неопределено);
	Служебные.Вставить("Статус", 			Неопределено);
	Служебные.Вставить("ФайлИмя", 			Неопределено);
	Служебные.Вставить("ЭлектронныйДокумент", Неопределено);

	Возврат Служебные;
	
КонецФункции // ЗаполнитьСлужебныеНастройки()

// Процедура удаляет дубли строк дерева значений на одном уровне иерархии
//
// Параметры:
//  Дерево  - ДеревоЗначений - объект для работы
//
Процедура УбратьДублиСтрокНаОдномУровне(Дерево, ИмяКолонкиСТегом = "Тег")

	Для Каждого Строка Из Дерево.Строки Цикл
		
		Строки = Дерево.Строки.НайтиСтроки(Новый Структура(ИмяКолонкиСТегом, Строка[ИмяКолонкиСТегом])); // Временное решение. Предполагается в итоге отказаться от него, когда будут ликвидированы вкадки Входящие, Исходящие.
		
		Если Строки.Количество() > 1
			И НЕ Строка.Уровень() = 0 Тогда // Можно добавлять несколько одинаковых файлов
			
			Для Индекс = 1 По Строки.Количество() - 1 Цикл
				Дерево.Строки.Удалить(Строки[Индекс]);
			КонецЦикла;
			
		КонецЕсли;
		
		// Рекурсия.
		УбратьДублиСтрокНаОдномУровне(Строка, ИмяКолонкиСТегом);
		
	КонецЦикла;

КонецПроцедуры // УбратьДублиСтрокНаОдномУровне()

