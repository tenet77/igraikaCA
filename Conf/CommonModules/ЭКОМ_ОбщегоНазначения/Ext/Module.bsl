// ПРОЧИЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Функция преобразовывает имя реквизита (колонки табличной части) в его представление (текст шапки табличной части)
//
// Параметры:
//  ИмяРеквизита  - Строка - имя реквизита, используемое в коде
//
// Возможные проблемы:
//	Функция не понимает аббревиатуры, состоящие из нескольких заглавных букв. Для нее это будут отдельные слова.
//	По условиям функция возвращает строку с первой заглавной буквой, остальные прописные.
//
// Возвращаемое значение:
//   Строка   - представление реквизита для пользователя (с пробелами)
//
Функция ТекстШапкиИзДанных(Знач ИмяРеквизита) Экспорт

	ИмяРеквизита 			= СтрЗаменить(ИмяРеквизита, "_", " ");
	
	Если Найти(ИмяРеквизита, " ") = 0 Тогда
		
		ПозицииБудущихПробелов 	= Новый Массив;
		
		// Поиск позиции для вставки пробелов.
		Для Позиция = 1 По СтрДлина(ИмяРеквизита) Цикл
			Символ 	= Сред(ИмяРеквизита, Позиция, 1);
			Если НЕ Позиция = 1 И ВРег(Символ) = Символ Тогда
				ПозицииБудущихПробелов.Добавить(Позиция);
			КонецЕсли;
		КонецЦикла;
		
		// Вставка пробелов.
		Для Вычитаемое = 0 По ПозицииБудущихПробелов.ВГраница() Цикл
			Индекс 	= ПозицииБудущихПробелов.ВГраница() - Вычитаемое;
			Позиция = ПозицииБудущихПробелов.Получить(Индекс);
			
			ИмяРеквизита = Лев(ИмяРеквизита, Позиция - 1) + " " + Прав(ИмяРеквизита, СтрДлина(ИмяРеквизита) - Позиция + 1); 
		КонецЦикла;
		
		ИмяРеквизита = СокрЛП(ИмяРеквизита);
		ИмяРеквизита = Лев(ИмяРеквизита, 1) + НРег(Прав(ИмяРеквизита, СтрДлина(ИмяРеквизита) - 1));
		
	КонецЕсли;
	
	Возврат ИмяРеквизита;
	
КонецФункции // ТекстШапкиИзДанных()

Процедура СобратьДанныеДляСтатистики(ВерсияОбработки, АвтообновлениеВключено, МассивЛогаСобытий) Экспорт

	МЗ = РегистрыСведений.ЭКОМ_ЗначениеДополнительныхКонстант.СоздатьМенеджерЗаписи();
	МЗ.ДополнительнаяКонстанта = "СлужебныйДатаОбновленияСтатистикиПоМодулю";
	МЗ.Измерение = "Служебный";
	МЗ.Прочитать();
	
	Если НЕ МЗ.Выбран() Тогда
		МЗ.ДополнительнаяКонстанта = "СлужебныйДатаОбновленияСтатистикиПоМодулю";
		МЗ.Измерение = "Служебный";
	КонецЕсли;
	
	ВремяПоследнегоОбновления = ?(НЕ ЗначениеЗаполнено(МЗ.ЗначениеДополнительнойКонстанты), Дата(0001, 01, 01), МЗ.ЗначениеДополнительнойКонстанты);
	ВремяОбновления = (ТекущаяДата() - ВремяПоследнегоОбновления)/(60*60);
	Если ВремяОбновления >= 24 Тогда // если больше 24 часов то обновляем 
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЭКОМ_GLN.ПрофильОбмена КАК ПрофильОбмена,
		|	ЭКОМ_GLN.Объект КАК Организация,
		|	ЭКОМ_GLN.ПрофильОбмена.ИмяПользователяFTP КАК ИмяПользователяFTP,
		|	ЭКОМ_GLN.ПрофильОбмена.ОбменПоSOAP КАК ОбменПоSOAP
		|ИЗ
		|	РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN
		|ГДЕ
		|	НЕ ЭКОМ_GLN.ПрофильОбмена = ЗНАЧЕНИЕ(Справочник.ЭКОМ_ПрофилиОбмена.ПустаяСсылка)
		|	И НЕ ЭКОМ_GLN.ПрофильОбмена.ПометкаУдаления
		|	И ЭКОМ_GLN.ПрофильОбмена.Активный = ИСТИНА
		|ИТОГИ ПО
		|	ПрофильОбмена";
		
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			
			СистемнаяИнформация = Новый СистемнаяИнформация;
			ТекущаяВерсия = СистемнаяИнформация.ВерсияПриложения;
			
			ВыборкаПрофильОбмена = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаПрофильОбмена.Следующий() Цикл
				ИмяФайла = СокрЛП(ВыборкаПрофильОбмена.ИмяПользователяFTP);
				КомандаЗапроса    = "/repos/1cdevelopexite/OrganizationsData/contents/" + ИмяФайла + ".json";          
				ОтветСервераПоФайлу = ПолучениеДанныхGITНаСервере(КомандаЗапроса, МассивЛогаСобытий);
				
				МассивНаименованийОрганизаций = Новый Массив;
				Выборка = ВыборкаПрофильОбмена.Выбрать();		
				Пока Выборка.Следующий() Цикл
					МассивНаименованийОрганизаций.Добавить(СокрЛП(Выборка.Организация.Наименование));
				КонецЦикла;
				
				ДанныйФайла = Новый Структура;
				ДанныйФайла.Вставить("Организация", МассивНаименованийОрганизаций);
				ДанныйФайла.Вставить("Платформа", ТекущаяВерсия);
				ДанныйФайла.Вставить("Конфигурация", Метаданные.КраткаяИнформация);
				ДанныйФайла.Вставить("ВерсияОбработки", ВерсияОбработки);
				ДанныйФайла.Вставить("АвтообновлениеВключено", Формат(АвтообновлениеВключено, "БЛ=Нет; БИ=Да"));
				ДанныйФайла.Вставить("ТипПодключенияКвеб", Формат(ВыборкаПрофильОбмена.ОбменПоSOAP, "БЛ=FTP; БИ=SOAP"));
				ДанныйФайла.Вставить("РасположениеБазыДанных", СтрокаСоединенияИнформационнойБазы());
				ДанныйФайла.Вставить("ТипПодключенияКплатформе", ТипПодключенияКплатформе());
				
				ТекстJSON = ЭКОМ_ПреобразоватьВJSON(ДанныйФайла);
				
				ДанныеЗапроса = Новый Структура;
				Если Не ОтветСервераПоФайлу = Неопределено Тогда
					ДанныеЗапроса.Вставить("sha", ОтветСервераПоФайлу.Получить("sha"));
					ДанныеЗапроса.Вставить("message", "файл обновлен");
				Иначе
					ДанныеЗапроса.Вставить("message", "файл создан");
				КонецЕсли;			
				ДанныеЗапроса.Вставить("content", Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(ТекстJSON)));
				
				// Создаем или обновляем файл
				Ответ = ВыполнитьЗапросGIT(КомандаЗапроса, ДанныеЗапроса, "PUT", МассивЛогаСобытий);
				Если НЕ Ответ = Неопределено Тогда
					МЗ.ЗначениеДополнительнойКонстанты = ТекущаяДата();
					МЗ.Записать();	
				КонецЕсли;
				
			КонецЦикла;			
		КонецЕсли;		
	КонецЕсли;  
	
КонецПроцедуры

