Функция ПроверитьСтрануВПрофилеОбмена()
	ПроверятьНаЗаполненностьПароля = Истина;
	Запрос = Новый("Запрос");
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЭКОМ_GLN.Объект КАК Организация,
	               |	ЭКОМ_GLN.ПрофильОбмена КАК ПрофильОбмена,
	               |	ЭКОМ_GLN.ПрофильОбмена.Страна КАК Страна
	               |ИЗ
	               |	РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN
	               |ГДЕ
	               |	ТИПЗНАЧЕНИЯ(ЭКОМ_GLN.Объект) = ТИП(Справочник.Организации)
	               |	И ЭКОМ_GLN.ПрофильОбмена.Страна = ""kz""";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ПроверятьНаЗаполненностьПароля = Ложь;
	конецЕсли;
	
	Возврат ПроверятьНаЗаполненностьПароля;
	
КонецФункции
