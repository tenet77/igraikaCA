КонецПроцедуры

Функция ОпределитьТипРаботыБазы() Экспорт
	СтрокаСоединенияСБД = СтрокаСоединенияИнформационнойБазы();
	// в зависимости от того файловый это вариант БД или нет,  по-разному отображается путь в БД 
	ПозицияПоиска = Найти(Врег(СтрокаСоединенияСБД), "FILE=");
	Если ПозицияПоиска = 1 тогда
		Возврат "Файловая";	
	Иначе 
		Возврат "Серверная";
	КонецЕсли; 
	
КонецФункции    

// Функция определяет версию режима совместимости конфигурации 
Функция ПолучитьРежимСовместимости() Экспорт
	
	ТекущаяВерсия = Строка(Метаданные.РежимСовместимости);
	ТекущаяВерсия = СтрЗаменить(ТекущаяВерсия, "Версия", "");
	ТекущаяВерсия = СтрЗаменить(ТекущаяВерсия, "_", ".");
	
	Версия  = "";
	Для н = 1  По 3 Цикл
		ПозицияТочки  = Найти(ТекущаяВерсия, ".");
		Символ        = Лев(ТекущаяВерсия , ПозицияТочки - 1);
		ТекущаяВерсия = Сред(ТекущаяВерсия, ПозицияТочки + 1);
		Версия        = Версия + Символ;
	КонецЦикла;
	
	Если СтрДлина(Версия) < 4 
		ИЛИ (Сред(Версия, 2, 1) = "3" И СтрДлина(Версия) = 4) Тогда
		Версия = Версия + "0";	
	КонецЕсли;
	
	Попытка
		ВерсияЧисло = ЭКОМ_ПреобразоватьВЧислоОбщегоНазначения(Версия);
	Исключение
		ВерсияЧисло  = 0;
	КонецПопытки;
	
	Возврат ВерсияЧисло;
	
КонецФункции

