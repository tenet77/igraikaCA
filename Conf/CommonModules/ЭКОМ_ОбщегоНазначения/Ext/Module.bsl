Функция ОтноситсяКЮЗД(ВидДокумента) Экспорт
	
	МассивВидовДокументовЮЗД = Новый Массив;
	ПолучитьПервичныеВидыДокументовЮЗД(МассивВидовДокументовЮЗД);
	ПолучитьИсправительныеВидыДокументовЮЗД(МассивВидовДокументовЮЗД);
	ПолучитьКорректировочныеВидыДокументовЮЗД(МассивВидовДокументовЮЗД);
	Если МассивВидовДокументовЮЗД.Найти(ВидДокумента) = Неопределено Тогда
		ЭтоВидДокументаЮЗД = Ложь;
	Иначе
		ЭтоВидДокументаЮЗД = Истина;
	КонецЕсли;
	
	Возврат ЭтоВидДокументаЮЗД; 
	
КонецФункции

Функция ЯвляетсяПодписьюЮЗД(ВидДокумента) Экспорт
	
	МассивВидовДокументовЮЗД = Новый Массив;
	ПолучитьПодписьВидовДокументовЮЗД(МассивВидовДокументовЮЗД);
	Если МассивВидовДокументовЮЗД.Найти(ВидДокумента) = Неопределено Тогда
		ЭтоВидДокументаЮЗД = Ложь;
	Иначе
		ЭтоВидДокументаЮЗД = Истина;
	КонецЕсли;
	
	Возврат ЭтоВидДокументаЮЗД; 
	
КонецФункции

Процедура ЗаписатьЛогСобытийвРегистрЛогирование(МассивЛогаСобытий) Экспорт	
	ТекущийПользователь     = НайтиТекущегоПользователя();
	ИдентификаторТранзакции = СокрЛП(Новый УникальныйИдентификатор);
	
	НаборЗаписей = РегистрыСведений.ЭКОМ_Логирование.СоздатьНаборЗаписей();		
	НаборЗаписей.Отбор.ИдентификаторТранзакции.Установить(ИдентификаторТранзакции);
	НаборЗаписей.Отбор.Пользователь.Установить(ТекущийПользователь);	
	Н = 1;
	Для Каждого ЗаписьСтроки Из МассивЛогаСобытий Цикл 
		НоваяЗапись = НаборЗаписей.Добавить(); 	
		ЗаполнитьЗначенияСвойств(НоваяЗапись, ЗаписьСтроки);
		
		НоваяЗапись.ИдентификаторТранзакции = ИдентификаторТранзакции; 
		НоваяЗапись.Пользователь            = ТекущийПользователь;
		НоваяЗапись.Период                  = ТекущаяДата();		
		НоваяЗапись.КоличествоСообщений     = Н;
		
		Н = Н + 1;
	КонецЦикла; 
	
	НаборЗаписей.Записать(); 		
	
КонецПроцедуры

Процедура ЗаписатьСтрокуЛогаСобытийвРегистрЛогирование(ЗаписьСтроки) Экспорт	
	
	ТекущийПользователь     = НайтиТекущегоПользователя();
	ИдентификаторТранзакции = СокрЛП(Новый УникальныйИдентификатор);
	
	НаборЗаписей = РегистрыСведений.ЭКОМ_Логирование.СоздатьНаборЗаписей();		
	НаборЗаписей.Отбор.ИдентификаторТранзакции.Установить(ИдентификаторТранзакции);
	НаборЗаписей.Отбор.Пользователь.Установить(ТекущийПользователь);	
	
	НоваяЗапись = НаборЗаписей.Добавить(); 	
	ЗаполнитьЗначенияСвойств(НоваяЗапись, ЗаписьСтроки);
	
	НоваяЗапись.ИдентификаторТранзакции = ИдентификаторТранзакции; 
	НоваяЗапись.Пользователь            = ТекущийПользователь;
	НоваяЗапись.Период                  = ТекущаяДата();		
	НоваяЗапись.КоличествоСообщений     = 1;
	
	НаборЗаписей.Записать(); 
	
КонецПроцедуры

