Функция ПолучитьТокенАвторизации(ПрофильОбмена, Ошибка, МассивЛогаСобытий) Экспорт

	ИмяСобытия = "Получить токен авторизации";
	ТокенАвторизации = Неопределено;
	
	Если НЕ ЗначениеЗаполнено(ПрофильОбмена) Тогда
		Возврат Неопределено; 
	КонецЕсли;
	
	Ошибка.Вставить("ЕстьОшибка" , Ложь); 
	Ошибка.Вставить("ТекстОшибки", "");
		
	// Токен не действителен. Получаем новый.
	Если ПустаяСтрока(СокрЛП(ПрофильОбмена.ИмяПользователяFTP)) Тогда
		ТекстЛогаСобытий = "В настройках программы не заполнен логин";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
		Ошибка.ЕстьОшибка = Истина;
		Ошибка.ТекстОшибки = "Не заполнен логин";
		
	КонецЕсли;
	
	//Docrobot 29.11.2021 MOD-1361
	Если ПроверитьСтрануВПрофилеОбмена() Тогда
		Если ПустаяСтрока(СокрЛП(ПрофильОбмена.ПарольПользователяAPI)) Тогда
			ТекстЛогаСобытий = "В настройках программы не заполнен пароль";
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);	
		
			Ошибка.ЕстьОшибка = Истина;
			Ошибка.ТекстОшибки = ?(ПустаяСтрока(Ошибка.ТекстОшибки), "Не заполнен пароль", Ошибка.ТекстОшибки + "/пароль");
		
		КонецЕсли;
	КонецЕсли;
	//Docrobot 29.11.2021 MOD-1361
	
	Если Ошибка.ЕстьОшибка = Ложь Тогда
		ДанныеЗапроса = Новый Структура;
		ДанныеЗапроса.Вставить("varLogin"   , ПрофильОбмена.ИмяПользователяFTP);
		ДанныеЗапроса.Вставить("varPassword", ПрофильОбмена.ПарольПользователяAPI);
		
		ЗаголовокHTTP = Новый Соответствие;
		ЗаголовокHTTP.Вставить("Content-type", "application/json");
		ЗаголовокHTTP.Вставить("Accept"      , "application/json");	
		
		ПараметрыЗапроса = Новый Структура;
		ПараметрыЗапроса.Вставить("МетодHTTP"    , "POST");
		ПараметрыЗапроса.Вставить("ЗаголовокHTTP", ЗаголовокHTTP);
		
		//Выполняем запрос.
		Ответ = ВыполнитьЗапрос("/Api/V1/Edo/Index/Authorize", ПрофильОбмена, ДанныеЗапроса, ПараметрыЗапроса, Ошибка, МассивЛогаСобытий);		
		
		Если Ошибка.ЕстьОшибка Тогда
			ТекстЛогаСобытий = "Код: " + Ошибка.КодОшибки + " - " + Ошибка.ТекстОшибки;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
					
		Иначе
			// Проверяем ответ.
			ТокенАвторизации = Сред(Ответ.Текст, 14, 26);
			
		КонецЕсли;
	
	КонецЕсли;
	   
	Возврат ТокенАвторизации;
	
КонецФункции // ПолучитьТокенАвторизации()

Функция ВыполнитьЗапрос(Команда, ПрофильОбмена, ДанныеЗапроса, ПараметрыЗапроса, Ошибка, МассивЛогаСобытий) Экспорт
	
	Если ЗначениеЗаполнено(ПрофильОбмена.СерверAPI) Тогда
		знСерверОбменаAPI = ПрофильОбмена.СерверAPI;
		
	Иначе	
		знСерверОбменаAPI = "api-service.e-vo.ru";	
	
	КонецЕсли;
	
	Если Найти(знСерверОбменаAPI, "." + ПрофильОбмена.Страна) = 0 Тогда
		
		Ошибка.Вставить("ЕстьОшибка" , Истина); 
		Ошибка.Вставить("КодОшибки"  , "");
		Ошибка.Вставить("ТекстОшибки", "В настройках профиля не верно выбрана страна.");
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	знСерверОбменаAPI = СтрЗаменить(знСерверОбменаAPI, "https://", "");
	знСерверОбменаAPI = СтрЗаменить(знСерверОбменаAPI, "http://" , "");
	
	Если НЕ ЗначениеЗаполнено(знСерверОбменаAPI) Тогда
		
		Ошибка.Вставить("ЕстьОшибка" , Истина); 
		Ошибка.Вставить("КодОшибки"  , "");
		Ошибка.Вставить("ТекстОшибки", "В настройках программы не заполнен адрес сервера");
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	ЭКОМ_ИспользуетсяПрокси = НастройкиПрочитатьНаСервере("ЭКОМ_ИспользуетсяПрокси"      , Ложь);
	Если ЭКОМ_ИспользуетсяПрокси Тогда
		ЭКОМ_ИмяСервераПрокси         = НастройкиПрочитатьНаСервере("ЭКОМ_ИмяСервераПрокси"        , "");
		ЭКОМ_ИмяПользователяПрокси    = НастройкиПрочитатьНаСервере("ЭКОМ_ИмяПользователяПрокси"   , "");
		ЭКОМ_ПарольПользователяПрокси = НастройкиПрочитатьНаСервере("ЭКОМ_ПарольПользователяПрокси", "");
		
	Иначе
		ЭКОМ_ИмяСервераПрокси         = "";
		ЭКОМ_ИмяПользователяПрокси    = "";
		ЭКОМ_ПарольПользователяПрокси = "";
	КонецЕсли;
	
	ПроксиСервер = Новый ИнтернетПрокси;
	ПроксиСервер.Пользователь = ЭКОМ_ИмяПользователяПрокси;
	ПроксиСервер.Пароль       = ЭКОМ_ПарольПользователяПрокси;
	ПроксиСервер.Сервер(ЭКОМ_ИмяСервераПрокси);	
	
	ОтветСтрока = "";
	
	ТелоЗапроса	= API_СформироватьЗапрос(ДанныеЗапроса);
		
	Ответ = Новый Структура;	
	Если ВерсияПлатформыНаСервере() >= 8340  Тогда
		
		знИмяПользователяFTP    = ПрофильОбмена.ИмяПользователяFTP;
		знПарольПользователяFTP = ПрофильОбмена.ПарольПользователяFTP;
		
		Попытка
			Соединение = "";
			Выполнить("Соединение = Новый HTTPСоединение(знСерверОбменаAPI,443,знИмяПользователяFTP,знПарольПользователяFTP, ПроксиСервер, 0 ,Новый ЗащищенноеСоединениеOpenSSL(),Ложь);");
		Исключение
			ТекстОшибки = "Не удалось установить соединение с сервером:" + Символы.ПС + ИнформацияОбОшибке().Описание;
			
			Ошибка.Вставить("ЕстьОшибка" , Истина); 
			Ошибка.Вставить("КодОшибки"  , "");
			Ошибка.Вставить("ТекстОшибки", ТекстОшибки);
			
			Возврат Неопределено;
			
		КонецПопытки;
		
		Попытка
			
			// Заголовки
			ЗаголовокHTTP = ПараметрыЗапроса.ЗаголовокHTTP;
						
			HTTPЗапрос = "";
			Выполнить("HTTPЗапрос = Новый HTTPЗапрос(Команда, ЗаголовокHTTP);");
			Выполнить("HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);");
			
			Попытка
				ИмяВыходногоФайла = "";
				Результат   = Соединение.ОтправитьДляОбработки(HTTPЗапрос, ИмяВыходногоФайла);
				Соединение  = Неопределено;
				ОтветСтрока = ПреобразоватьЮникод(Результат.ПолучитьТелоКакСтроку("UTF-8"), МассивЛогаСобытий);
			Исключение
				
				ТекстОшибки = "Ошибка при отправке запроса: " + ОписаниеОшибки() + ИмяВыходногоФайла;
				
				Ошибка.Вставить("ЕстьОшибка" , Истина); 
				Ошибка.Вставить("КодОшибки"  , "");
				Ошибка.Вставить("ТекстОшибки", ТекстОшибки);
				
				Возврат Неопределено;
				
			КонецПопытки;
			
			Если Результат.КодСостояния > 299 Тогда
				
				ТекстОшибки = "Код состояния " + Результат.КодСостояния + ". Запрос не отправлен. " + ОтветСтрока;
				
				Ошибка.Вставить("ЕстьОшибка" , Истина); 
				Ошибка.Вставить("КодОшибки"  , "");
				Ошибка.Вставить("ТекстОшибки", ТекстОшибки);
				
				Возврат Неопределено;
				
			ИначеЕсли НЕ ЗначениеЗаполнено(ОтветСтрока) Тогда
				
				ТекстОшибки = "Ошибка, результат пустой, " + Результат.КодСостояния;
				
				Ошибка.Вставить("ЕстьОшибка" , Истина); 
				Ошибка.Вставить("КодОшибки"  , "");
				Ошибка.Вставить("ТекстОшибки", ТекстОшибки);
				
				Возврат Неопределено;
				
			Иначе
				
				Ответ = Новый Структура;
				Ответ.Вставить("КодОтвета" , Результат.КодСостояния);
				Ответ.Вставить("exchangeid", "");
				Ответ.Вставить("Текст"     , ОтветСтрока);			
				Ответ.Вставить("XML"       , "");
				Ответ.Вставить("XML_Текст" , ОтветСтрока);	
				
			КонецЕсли;
		Исключение
			
			ТекстОшибки = ИнформацияОбОшибке().Описание;
			
			Ошибка.Вставить("ЕстьОшибка" , Истина); 
			Ошибка.Вставить("КодОшибки"  , "");
			Ошибка.Вставить("ТекстОшибки", ТекстОшибки);
			
			Возврат Неопределено;
			
		КонецПопытки;
		
	Иначе
		
		знСерверОбменаAPI = "https://" + знСерверОбменаAPI;
		API = Новый COMОбъект("MSXML2.XMLHTTP");
		API.Open(ПараметрыЗапроса.МетодHTTP, знСерверОбменаAPI + Команда, 0);
		// Заголовки
		Для Каждого Заголовок Из ПараметрыЗапроса.ЗаголовокHTTP Цикл
			API.setRequestHeader(Заголовок.Ключ, Заголовок.Значение);
		КонецЦикла;
							
		// Отправляем
		API.send(ТелоЗапроса);
		
		// Результат
		Ответ = Новый Структура;
		Ответ.Вставить("КодОтвета"        , API.Status);
		Ответ.Вставить("Текст"            , API.responseText);
		Ответ.Вставить("XML"              , API.responseXml);
		Ответ.Вставить("XML_Текст"        , API.responseXml.text);
		Ответ.Вставить("exchangeid"       , "");
		
		Если НЕ ЗначениеЗаполнено(Ответ.Текст) Тогда
			
			ТекстОшибки = "Ошибка, результат пустой, " + Ответ.КодОтвета;
			
			Ошибка.Вставить("ЕстьОшибка" , Истина); 
			Ошибка.Вставить("КодОшибки"  , "");
			Ошибка.Вставить("ТекстОшибки", ТекстОшибки);
			
			Возврат Неопределено;
			
		КонецЕсли;
		
	КонецЕсли;
		
	СообщениеОбОшибке = ПроверкаРезультатовВыполнения(Ответ, МассивЛогаСобытий);
	
	Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
		
		Ошибка.Вставить("ЕстьОшибка" , Истина); 
		Ошибка.Вставить("КодОшибки"  , Ответ.КодОтвета);
		Ошибка.Вставить("ТекстОшибки", СообщениеОбОшибке);
		
		Возврат Неопределено;
		
	КонецЕсли;
		
	Возврат Ответ;
	
КонецФункции

// Функция формирует запрос в формате JSON.
//
// Параметры:
//  ДанныеЗапроса  - Структура - данные для формирования запроса
//
// Возвращаемое значение:
//   Строка   - итоговый текст запроса
//
Функция API_СформироватьЗапрос(ДанныеЗапроса) Экспорт
	
	ТекстЗапроса = "";
	
	Для Каждого Данные Из ДанныеЗапроса Цикл
		
		ТекстЗапроса = ТекстЗапроса + ?(ПустаяСтрока(ТекстЗапроса), "{""", ", """) + Данные.Ключ + """: ";
		
		Если ТипЗнч(Данные.Значение) = Тип("Структура") Тогда
			ТекстЗапроса = ТекстЗапроса + "[" + API_СформироватьЗапрос(Данные.Значение) + "]";
		ИначеЕсли ТипЗнч(Данные.Значение) = Тип("Массив") Тогда
			Значение = "";
			н = 0;
			Для каждого ЭлМассива Из Данные.Значение Цикл
			    Значение = ?(Значение = "", "", Значение) + """" + ЭлМассива + ?(Данные.Значение[н] = Данные.Значение[Данные.Значение.Количество()-1], """", """, ");
				н = н + 1;
			КонецЦикла;
			ТекстЗапроса = ТекстЗапроса + "[" + Значение + "]";
		Иначе
			ТекстЗапроса = ТекстЗапроса + """" + Данные.Значение + """";
		КонецЕсли;
		
	КонецЦикла;
	
	ТекстЗапроса = ТекстЗапроса + "}";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, Символы.ПС, "");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, Символы.ВК, "");
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ЭКОМ_ПреобразоватьВJSON(ДанныеЗапроса) Экспорт
	
	ТекстЗапроса = "";
	
	Для Каждого Данные Из ДанныеЗапроса Цикл
		
		ТекстЗапроса = ТекстЗапроса + ?(ПустаяСтрока(ТекстЗапроса), "{" + Символы.ПС + "  """, ", " + Символы.ПС + "  """) + Данные.Ключ + """: ";
		
		Если ТипЗнч(Данные.Значение) = Тип("Структура") Тогда
			ТекстЗапроса = ТекстЗапроса + "[" + API_СформироватьЗапрос(Данные.Значение) + "]";
		ИначеЕсли ТипЗнч(Данные.Значение) = Тип("Массив") Тогда
			Значение = "";
			н = 0;
			Для каждого ЭлМассива Из Данные.Значение Цикл
			    Значение = ?(Значение = "", "", Значение) + """" + ЭлМассива + ?(Данные.Значение[н] = Данные.Значение[Данные.Значение.Количество()-1], """", """, ");
				н = н + 1;
			КонецЦикла;
			ТекстЗапроса = ТекстЗапроса + "[" + Значение + "]";
		Иначе
			ТекстЗапроса = ТекстЗапроса + """" + Данные.Значение + """";
		КонецЕсли;
		
	КонецЦикла;
	
	ТекстЗапроса = ТекстЗапроса + Символы.ПС + "}";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ПроверкаРезультатовВыполнения(РезультатЗапроса, МассивЛогаСобытий)
	
	СообщениеОбОшибке     = "";
	ОбработанныйРезультат = Новый Структура;
	ЧтениеJSON            = "";	
	
	Если ВерсияПлатформыНаСервере() >= 8360 Тогда
		Выполнить("ЧтениеJSON = Новый ЧтениеJSON;");		
		ЧтениеJSON.УстановитьСтроку(РезультатЗапроса.Текст);
		Выполнить("ОбработанныйРезультат = ПрочитатьJSON(ЧтениеJSON);");
	Иначе 
		ОбработанныйРезультат = ЗаполнитьСтруктуруИзОтветаJSON(РезультатЗапроса.Текст, МассивЛогаСобытий);
	КонецЕсли; 
	
	Если РезультатЗапроса.КодОтвета = 200 
		ИЛИ РезультатЗапроса.КодОтвета = 201 Тогда
		
		РезультатЗапроса.exchangeid = ?(ОбработанныйРезультат.Свойство("exchangeid"), 	ОбработанныйРезультат.exchangeid,	РезультатЗапроса.exchangeid);
		
		Если ОбработанныйРезультат.Свойство("timeline") Тогда
			РезультатЗапроса.Вставить("timeline", ОбработанныйРезультат.timeline);
		КонецЕсли;
		
		Если ОбработанныйРезультат.Свойство("document") Тогда
			РезультатЗапроса.Вставить("document", ОбработанныйРезультат.document);
		КонецЕсли;
		
		Если ОбработанныйРезультат.Свойство("body") Тогда
			РезультатЗапроса.Вставить("body", Base64Значение(ОбработанныйРезультат.body));
		КонецЕсли;
		
		Если ОбработанныйРезультат.Свойство("sign")
			И НЕ ОбработанныйРезультат.sign.Количество() = 0 Тогда
			
			РезультатЗапроса.Вставить("sign", ОбработанныйРезультат.sign);
			
		КонецЕсли;
		
		Если ОбработанныйРезультат.Свойство("content") Тогда
			РезультатЗапроса.Вставить("content", Base64Значение(ОбработанныйРезультат.content));
		КонецЕсли;
		
		Если ОбработанныйРезультат.Свойство("intCode") Тогда
			РезультатЗапроса.Вставить("intCode", Base64Значение(ОбработанныйРезультат.intCode));
		КонецЕсли;
		
		Если ОбработанныйРезультат.Свойство("varMessage") Тогда
			РезультатЗапроса.Вставить("varMessage", Base64Значение(ОбработанныйРезультат.varMessage));
		КонецЕсли;
		
	ИначеЕсли РезультатЗапроса.КодОтвета = 400 Тогда
		
		СообщениеОбОшибке = "Ошибка в запросе";
		
	ИначеЕсли РезультатЗапроса.КодОтвета = 401 Тогда	
		
		СообщениеОбОшибке = "Не достаточно прав!";
		
	ИначеЕсли РезультатЗапроса.КодОтвета = 404 Тогда	
		
		СообщениеОбОшибке ="Объект не найден";
		
	ИначеЕсли РезультатЗапроса.КодОтвета = 503 Тогда	
		
		СообщениеОбОшибке = "Сервер не доступен";	
		
	Иначе
		
		СообщениеОбОшибке = "Ошибка API!";
		
	КонецЕсли;
	
	Возврат СообщениеОбОшибке;
	
КонецФункции

Функция ЗаполнитьСтруктуруИзОтветаJSON(Знач ТекстJSON, МассивЛогаСобытий) Экспорт
	
	Возврат ОбработатьОтвет(ТекстJSON);
	
КонецФункции

Функция ДатьОписаниеОшибкиПоТекстуОшибки(ТекстОшибки) Экспорт
	Если Найти(ТекстОшибки, "is not retailer gln") > 0 Тогда
		Результат = "Этот GLN не принадлежит розничной сети (ретейлеру)";
	ИначеЕсли Найти(ТекстОшибки, "error during archiving - File not found or can't be archived") > 0 Тогда
		Результат = "Ошибка помещения в архив: Файл не найден на сервере в Inbox (возможно он уже был помещен в архив ранее)";
	ИначеЕсли Найти(ТекстОшибки, "{(1)}: Ошибка при вызове конструктора (FTPСоединение): ") > 0 Тогда
		Результат = "Проблема с подключением к FTP: " + СтрЗаменить(ТекстОшибки, "{(1)}: Ошибка при вызове конструктора (FTPСоединение): ", "");
	Иначе
		Результат = ТекстОшибки;
	КонецЕсли;
	Возврат Результат;
КонецФункции 

