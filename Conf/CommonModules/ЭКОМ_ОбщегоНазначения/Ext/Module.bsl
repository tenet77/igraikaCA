Процедура ЭКОМ_ЦепочкиДокументовПоставщикаЗаписать(ПараметрыОтбора, ПараметрыЗаписи)
	
	НачатьТранзакцию();
	Попытка
		
		НаборЗаписей = РегистрыСведений.ЭКОМ_ЦепочкиДокументовПоставщика.СоздатьНаборЗаписей();
		Для каждого СтрОтбора Из ПараметрыОтбора Цикл
			Если ЗначениеЗаполнено(СтрОтбора.Значение) Тогда
			    НаборЗаписей.Отбор[СтрОтбора.Ключ].Установить(СтрОтбора.Значение);
			КонецЕсли;
			
		КонецЦикла;	
		
		//Выполним блокировку данных
		Выполнить("ЭКОМ_ПодпискаСобытий.ВыполнитьБлокировкуНабораЗаписей(НаборЗаписей.Отбор, ""ЭКОМ_ЦепочкиДокументовПоставщика"")");

		НаборЗаписей.Прочитать();
		
		/// Если существует документ в регистре
		Для Каждого НоваяЗапись Из НаборЗаписей Цикл
			Для каждого СтрЗаписи Из ПараметрыЗаписи Цикл
				НоваяЗапись[СтрЗаписи.Ключ] = СтрЗаписи.Значение;
			КонецЦикла;
			Если НЕ ЗначениеЗаполнено(НоваяЗапись.ДатаЗаписи) Тогда
				НоваяЗапись.ДатаЗаписи = ТекущаяДата();
			КонецЕсли;
		КонецЦикла;	
		
		// Записываем документ в первый раз
		Если НаборЗаписей.Количество() = 0 Тогда
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.ДатаЗаписи = ТекущаяДата();
			
			Для каждого СтрОтбора Из ПараметрыОтбора Цикл
				НоваяЗапись[СтрОтбора.Ключ] = СтрОтбора.Значение;
			КонецЦикла;
			
			Для каждого СтрЗаписи Из ПараметрыЗаписи Цикл
				НоваяЗапись[СтрЗаписи.Ключ] = СтрЗаписи.Значение;
			КонецЦикла;			
		КонецЕсли;
		
		НаборЗаписей.Записать();	
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();		
	КонецПопытки;

КонецПроцедуры

Функция ЭКОМ_GLN_Прочитать(п_Объект)  
	Структура = Новый Структура;
	МенеджерЗаписи        = РегистрыСведений.ЭКОМ_GLN.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Объект = п_Объект;
	МенеджерЗаписи.Прочитать();
	
	Если МенеджерЗаписи.Выбран() Тогда	
		Структура.Вставить("СведенияЕсть", Истина);
		Для каждого Данные Из Метаданные.РегистрыСведений.ЭКОМ_GLN.Ресурсы  Цикл
			Структура.Вставить(Данные.Имя, МенеджерЗаписи[Данные.Имя]);		
		КонецЦикла;
		Структура.Вставить("Комментарий"                 , МенеджерЗаписи.Комментарий);		
	Иначе
		Структура.Вставить("СведенияЕсть"                , Ложь);
	КонецЕсли;
	
	Возврат Структура;
	
КонецФункции

// Процедура заполняет атрибуты XML документа из текущей строки
//
// Параметры:
//  XMLДокумент  - <Тип.Вид> - <описание параметра>
//                 <продолжение описания параметра>
//  СтрокаДЗ  - СтрокаДереваЗначений - строка дерева с атрибутами (или без)
//
Процедура ЗаписатьАтрибутыXML(XMLДокумент, СтрокаДЗ, Документ, ДанныеСтроки, МассивЛогаСобытий, ТребуютЗаполнения)
	
	Если ТипЗнч(СтрокаДЗ.Атрибуты) = Тип("СписокЗначений") Тогда
		
		Для Каждого Атрибут Из СтрокаДЗ.Атрибуты Цикл
			// Проверка незаполненной формулы при обязательном выводе значения.
			Если Атрибут.Пометка = Истина И НЕ ЗначениеЗаполнено(Атрибут.Представление) Тогда
				ТребуютЗаполнения = ТребуютЗаполнения + ?(ПустаяСтрока(ТребуютЗаполнения), "", Символы.ПС) + "- " + Строка(Атрибут.Значение);
				Продолжить;
			ИначеЕсли НЕ ЗначениеЗаполнено(Атрибут.Представление) Тогда
				Продолжить;
			КонецЕсли;
			
			ЗначениеАтрибута = "";
			
			Попытка
				Выполнить("ЗначениеАтрибута = " + Атрибут.Представление + ";");
			Исключение
				Если ЗначениеЗаполнено(ДанныеСтроки) И Найти(Атрибут.Представление, СтрокаДЗ.Приемник) = 1 Тогда
					Значение = СтрЗаменить(Атрибут.Представление, СтрокаДЗ.Приемник, "ДанныеСтроки");
					Попытка
						Выполнить("ЗначениеАтрибута = " + Значение + ";");
					Исключение
						// Ошибка при обязательном выводе значения.
						Если Атрибут.Пометка = Истина Тогда
							ТребуютЗаполнения = ТребуютЗаполнения + ?(ПустаяСтрока(ТребуютЗаполнения), "", Символы.ПС) + "- " + Строка(Атрибут.Значение);
						КонецЕсли;
						Продолжить;
					КонецПопытки;
				Иначе
					Попытка
						Выполнить("ЗначениеАтрибута = " + "ДанныеСтроки" + Прав(Атрибут.Представление, СтрДлина(Атрибут.Представление) - Найти(Атрибут.Представление, ".") + 1) + ";");
					Исключение
						// Ошибка при обязательном выводе значения.
						Если Атрибут.Пометка = Истина Тогда
							ТребуютЗаполнения = ТребуютЗаполнения + ?(ПустаяСтрока(ТребуютЗаполнения), "", Символы.ПС) + "- " + Строка(Атрибут.Значение);
						КонецЕсли;
						Продолжить;
					КонецПопытки;
				КонецЕсли;
			КонецПопытки;
			
			Попытка
				Если ЗначениеЗаполнено(ЗначениеАтрибута) Тогда
					XMLДокумент.ЗаписатьАтрибут(Атрибут.Значение, ЗначениеАтрибута);
				ИначеЕсли Атрибут.Пометка = Истина Тогда // Ошибка при обязательном выводе значения
					ТребуютЗаполнения = ТребуютЗаполнения + ?(ПустаяСтрока(ТребуютЗаполнения), "", Символы.ПС) + "- " + Строка(Атрибут.Значение);
				КонецЕсли;
			Исключение
				
				// Ошибка при обязательном выводе значения.
				Если Атрибут.Пометка = Истина Тогда
					ТребуютЗаполнения = ТребуютЗаполнения + ?(ПустаяСтрока(ТребуютЗаполнения), "", Символы.ПС) + "- " + Строка(Атрибут.Значение);
				КонецЕсли;
				
				ТекстЛогаСобытий = "Ошибка записи атрибута в XML файл. Ключ атрибута [" + Атрибут.Значение + "], значение атрибута [" 
				+ Строка(ЗначениеАтрибута) + "] тип значения [" + ТипЗнч(ЗначениеАтрибута) + "]" + Символы.ПС + ОписаниеОшибки();
				
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, "Заполнение атрибута XML документа");
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
				
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры // ЗаписатьАтрибутыXML()

// Возвращает стандартную структуру сообщения об ошибке
Функция ПолучитьСтруктуруЛогаНаСервере() Экспорт
	Структура = Новый Структура;
	// Флаг ставиться в значение "Истина" если в ходе выполнения операции произошла ошибка. 
	//Если после выполнения команды в флаг сброшен, операция считается успешно выполненой
	Структура.Вставить("БлокировкаОперации" , Ложь);
	Структура.Вставить("ЕстьОшибка"         , Ложь); 
	Структура.Вставить("ТекстОшибки"        , "");
	Возврат Структура;
КонецФункции

// Возвращает структуру регистра ЭКОМ Логирование для заполнения
Функция ЗаписьСтруктурыЛогаНаСервере()
	Структура = Новый Структура;	
