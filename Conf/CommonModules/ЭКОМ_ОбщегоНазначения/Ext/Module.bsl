// Настройки хранятся в ЭКОМ_ЗначениеДополнительныхКонстант
// Имя - имя настройки
// опрЗначение - значение по умолчанию
// Измерение - может хранится в разрезе (организаций, пользователей)
Функция НастройкиПрочитатьНаСервере(Имя, ЗначениеПоУмолчанию = Неопределено, Измерение = Неопределено, Обязательно = Ложь) Экспорт	
        
    МЗ = РегистрыСведений.ЭКОМ_ЗначениеДополнительныхКонстант.СоздатьМенеджерЗаписи();
	МЗ.ДополнительнаяКонстанта  = Имя;
	МЗ.Измерение                = Измерение;         
	
	УстановитьПривилегированныйРежим(Истина);
	МЗ.Прочитать();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если МЗ.Выбран() Тогда
		
		Если ТипЗнч(МЗ.ЗначениеДополнительнойКонстанты) = Тип("Неопределено") Тогда
			ЗначениеПоУмолчанию = МЗ.ЗначениеДополнительногоХранилища.Получить();
		Иначе	
			ЗначениеПоУмолчанию = МЗ.ЗначениеДополнительнойКонстанты;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Обязательно 
		 И НЕ ЗначениеЗаполнено(ЗначениеПоУмолчанию) Тогда		
		 ТекстЛогаСобытий = "Значение не заполнено для настройки - <<< " + Имя + ">>>";
		 ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, "Чтение настроек из регистра");
		 ЗаписатьСтрокуЛогаСобытийвРегистрЛогирование(ЗаписьСтруктурыЛога);
		 
		 Возврат Неопределено;
		 
	КонецЕсли;
	
	Возврат ЗначениеПоУмолчанию;
    
КонецФункции

// Процедура добавляет или изменяе запись в регистре сведений ЭКОМ_ЗначениеДополнительныхКонстант
//
// Параметры:
//  пИмя  				- Строка - значение реквизита ДополнительнаяКонстанта
//  пЗначение  			- ЛюбаяСсылка, Булево, Строка, Дата, Число; ХранилищеЗначения - значение реквизитов ЗначениеДополнительнойКонстанты
//		либо ЗначениеДополнительногоХранилища, если первый символ строки в параметре пИмя равен "_"
//  пИзмерение  		- ДокументСсылка, Строка, СправочникСсылка - значение реквизита Измерение
//  пНовоеИзмерение  	- ДокументСсылка, Строка, СправочникСсылка - значение реквизита Измерение для замены. Если оставить значение
//		по умолчанию - Неопределено - замены не произойдет
//
Функция НастройкаПараметрЗаписать(Имя, Значение, Измерение, МассивЛогаСобытий) Экспорт
	
	МЗ = РегистрыСведений.ЭКОМ_ЗначениеДополнительныхКонстант.СоздатьМенеджерЗаписи();
	
	Если Лев(Имя , 1) = "_" Тогда
		ПоместитьВХранилище = Истина;
	Иначе
		ПоместитьВХранилище = Ложь;
	КонецЕсли;
	
	МЗ.ДополнительнаяКонстанта  = ?(ПоместитьВХранилище, Сред(Имя, 2), Имя);
	МЗ.Измерение                = Измерение;
	МЗ.Прочитать();
	
	Если НЕ МЗ.Выбран() Тогда
		МЗ.ДополнительнаяКонстанта  = ?(ПоместитьВХранилище, Сред(Имя, 2), Имя);
		МЗ.Измерение                = Измерение;
	КонецЕсли;
	
	Если ПоместитьВХранилище Тогда
		МЗ.ЗначениеДополнительногоХранилища = Новый ХранилищеЗначения(Значение);
		МЗ.ЗначениеДополнительнойКонстанты  = Неопределено; // Очищаем данные
	Иначе
		МЗ.ЗначениеДополнительнойКонстанты 	= Значение;
	КонецЕсли;
	
	НастройкаЗаписана = Ложь;
	Попытка
		МЗ.Записать();
		НастройкаЗаписана = Истина;
	Исключение
		ТекстЛогаСобытий = "Ошибка записи настройки в [РегистрСведений.ЭКОМ_ЗначениеДополнительныхКонстант] - <<< " + Имя + ">>>";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, "Записать настройку в регистр");
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

	КонецПопытки;
	
	Возврат НастройкаЗаписана;
	
КонецФункции

//Docrobot 1.20.0 MOD-1573[Вызывает функцию НастройкиПрочитатьНаСервере. Используется при вызове из гибких настроек]
Функция Настройка_Параметр_Прочитать(Имя, ЗначениеПоУмолчанию = Неопределено, Измерение = Неопределено, Обязательно = Ложь) Экспорт 

	Возврат НастройкиПрочитатьНаСервере(Имя, ЗначениеПоУмолчанию, Измерение, Обязательно);

