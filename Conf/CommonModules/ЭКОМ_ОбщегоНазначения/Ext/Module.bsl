КонецФункции   

Функция ИзвлечьPDF_ЭКОМ(ПрофильОбмена, ИД_Документа, Ошибка, МассивЛогаСобытий) Экспорт
	
	ТокенАвторизации = ПолучитьТокенАвторизации(ПрофильОбмена, Ошибка, МассивЛогаСобытий);	
	Если Ошибка.ЕстьОшибка Тогда
		ТекстЛогаСобытий = Ошибка.ТекстОшибки;
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, "Получение печатной формы для ЮЗД");
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		Возврат Неопределено;
	КонецЕсли;
	
	ТекстКоманды =  "/Api/V1/Edo/PrintForm/Generate";
	
	ДанныеЗапроса = Новый Структура;
	ДанныеЗапроса.Вставить("identifier", ИД_Документа);
	ДанныеЗапроса.Вставить("varToken"  , ТокенАвторизации);
	
	ЗаголовокHTTP = Новый Соответствие;
	ЗаголовокHTTP.Вставить("Content-type", "application/json");
	ЗаголовокHTTP.Вставить("Accept"      , "application/json");	
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("МетодHTTP"    , "POST");
	ПараметрыЗапроса.Вставить("ЗаголовокHTTP", ЗаголовокHTTP);

	Результат = ВыполнитьЗапрос(ТекстКоманды, ПрофильОбмена, ДанныеЗапроса, ПараметрыЗапроса, Ошибка, МассивЛогаСобытий);
	
	Если Ошибка.ЕстьОшибка Тогда						
		Возврат Неопределено;		
	КонецЕсли;
	
	Текст = Результат.Текст;
	
	Информация = Сред(Текст, 10, Найти(Текст, ",""varMessage""") - 10);
	Информация = СтрЗаменить(Информация,"\/","/");  
	
	СтрокаBase64PDF_Документа = Информация;
	Если Base64Значение(Информация) = Неопределено Тогда
		
		Ошибка.Вставить("ЕстьОшибка" , Истина); 
		Ошибка.Вставить("КодОшибки"  , "");
		Ошибка.Вставить("ТекстОшибки", Текст);
		
	КонецЕсли;
	
	///////////////////////////////
	
	Возврат СтрокаBase64PDF_Документа; // СтрокаBase64 файла PDF
	
КонецФункции

Функция ПутьВременногоКаталогаЭКОМ(ТипФайла = "") Экспорт  
	
	РазделительПути = ЭКОМ_ПолучитьРазделительПути();
	Если ТипФайла = "" Тогда
		 Результат = КаталогВременныхФайлов() + "TempECOM" + РазделительПути;
	Иначе
	     Результат = КаталогВременныхФайлов() + "TempECOM" + РазделительПути + ТипФайла + РазделительПути;
	КонецЕсли;
	   
	Возврат Результат;
	
КонецФункции

Функция ЭКОМ_ПолучитьРазделительПути()
		
	РазделительПути = "";
	
	Если ВерсияПлатформыНаСервере() >= 8330 Тогда
		РазделительПути = ПолучитьРазделительПути();
	Иначе
		
		СистемнаяИнформация = Новый СистемнаяИнформация;	
		ЭтоLinuxКлиент = СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86 
		ИЛИ СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86_64;
		
		Если ЭтоLinuxКлиент Тогда 
			РазделительПути = "/"; // Linux
		
		Иначе
			РазделительПути = "\";  // Windows
			
		КонецЕсли;
	КонецЕсли;
				
    Возврат РазделительПути;

КонецФункции

Функция ЭКОМ_СоздатьКаталогПроверитьНаЗапись(ПолныйПутьКаталога, МассивЛогаСобытий) Экспорт
	
	ИмяСобытия = "Проверка каталога на запись файлов";
	КаталогСоздан = Ложь;
	Если ЗначениеЗаполнено(ПолныйПутьКаталога) 
		 И ТипЗнч(ПолныйПутьКаталога) = Тип("Строка") Тогда

		 // Создаем каталог 
		 Каталог = Новый Файл(ПолныйПутьКаталога);
		 Если НЕ Каталог.Существует() Тогда
			 Попытка
				 СоздатьКаталог(ПолныйПутьКаталога);
				 Каталог = Новый Файл(ПолныйПутьКаталога);
			 Исключение
				 ТекстЛогаСобытий = "Каталог, указанный в настройках модуля отсутствует. 
				 |Ошибка создания каталога по настройке [" + ПолныйПутьКаталога + "] Текст ошибки платформы: " + ОписаниеОшибки();
				 ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
				 МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

				 Возврат Ложь;
				 
			 КонецПопытки;
			 
		 КонецЕсли;
		 
		 // Проверяем на запись
		 Попытка
			 Текст = Новый ЗаписьТекста(ПолныйПутьКаталога + "ТестНаЗапись.txt", КодировкаТекста.ANSI);    
			 Текст.ЗаписатьСтроку("Проверка на запись файлов!");
			 Текст.Закрыть();
			 
			 Попытка
				 ФайлПроверкиЗаписи = Новый Файл(ПолныйПутьКаталога + "ТестНаЗапись.txt");
				 Если ФайлПроверкиЗаписи.Существует() Тогда
					 УдалитьФайлы(ФайлПроверкиЗаписи.ПолноеИмя);
				 КонецЕсли;
			 Исключение
			 КонецПопытки; 			 
			 			 
		 Исключение
			 ТекстЛогаСобытий = "Нет прав на запись файлов. Текст ошибки платформы: " + ОписаниеОшибки();
			 ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			 МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			 
			 Возврат Ложь;
			 
		 КонецПопытки;
		 
		 КаталогСоздан = Истина;

	КонецЕсли;

    Возврат КаталогСоздан;

КонецФункции

// Функция имитирует метод платформы СтрНайти
//	Параметры:
//	Строка - строка
//  ПодстрокаПоиска - строка
//  НаправлениеПоиска - число - 0 (значение по умолчанию) - поиск СНачала, любое другое значение - СКонца
//  НачальнаяПозиция - число
//  НомерВхождения  - число
Функция ПоискВСтроке(Знач Строка, ПодстрокаПоиска, НаправлениеПоиска = 0 , НачальнаяПозиция = -1, НомерВхождения = 1) Экспорт
	Если НаправлениеПоиска = 0 И НачальнаяПозиция = -1 Тогда
		НачальнаяПозиция = 1;
	ИначеЕсли НаправлениеПоиска <> 0 И НачальнаяПозиция = -1 Тогда
		НачальнаяПозиция = СтрДлина(Строка);
	КонецЕсли;
	
	ДлинаСтроки = СтрДлина(Строка);
	СтрокаПоиска = Прав(Строка, ДлинаСтроки - НачальнаяПозиция + 1); 
	УбраноСимволов = ДлинаСтроки - СтрДлина(СтрокаПоиска);
	
	Если НаправлениеПоиска <> 0 Тогда
		СтрокаПоиска = Лев(Строка, НачальнаяПозиция - 1); 
		УбраноСимволов = ДлинаСтроки - СтрДлина(СтрокаПоиска);
		
		ДлинаСтрокиПоиска = СтрДлина(СтрокаПоиска);
		Счетчик = 0;
		НоваяСтрока = "";
		Пока Счетчик < ДлинаСтрокиПоиска Цикл
			ТекСимвол = Сред(СтрокаПоиска, ДлинаСтрокиПоиска - Счетчик, 1);
			НоваяСтрока = НоваяСтрока + ТекСимвол;
			Счетчик = Счетчик + 1;
		КонецЦикла;
		
		ДлинаПодстрокиПоиска = СтрДлина(ПодстрокаПоиска);
		Счетчик = 0;
		НоваяПодстрока = "";
		Пока Счетчик < ДлинаПодстрокиПоиска Цикл
			ТекСимвол = Сред(ПодстрокаПоиска, ДлинаПодстрокиПоиска - Счетчик, 1);
			НоваяПодстрока = НоваяПодстрока + ТекСимвол;
			Счетчик = Счетчик + 1;
		КонецЦикла;
		ПодстрокаПоиска = НоваяПодстрока;
		
		СтрокаПоиска = НоваяСтрока;
	КонецЕсли;
	
	Счетчик      = 0;
	НомерСимвола = 0;
	СчетчикДлины = УбраноСимволов;
	Пока Счетчик < НомерВхождения Цикл
		НомерСимвола = Найти(СтрокаПоиска, ПодстрокаПоиска);
		
		ДлинаДо      = СтрДлина(СтрокаПоиска);
		СтрокаПоиска = Прав(СтрокаПоиска, ДлинаДо - НомерСимвола);
		
		Счетчик 		= Счетчик + 1;
		НомерСледующего = Найти(СтрокаПоиска, ПодстрокаПоиска);
		Если НомерСледующего = 0 Или Счетчик = НомерВхождения Тогда
			Прервать;
		КонецЕсли;
		
		ДлинаСтрокиПоиска = СтрДлина(СтрокаПоиска);
		СчетчикДлины 	  = СчетчикДлины + ДлинаДо - СтрДлина(СтрокаПоиска);
	КонецЦикла;
	
	Если НомерСимвола = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Если НаправлениеПоиска = 0 Тогда
		Результат = СчетчикДлины + НомерСимвола;
	Иначе
		Результат = СтрДлина(Строка) - СчетчикДлины - НомерСимвола  + 1 - СтрДлина(ПодстрокаПоиска) + 1;
	КонецЕсли;
	Если Счетчик < НомерВхождения Тогда
		Результат = 0;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

