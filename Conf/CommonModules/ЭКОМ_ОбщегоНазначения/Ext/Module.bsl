Функция ЭКОМ_ПреобразоватьВЧислоОбщегоНазначения(ЧислоСтрока) Экспорт
	
	Если ТипЗнч(ЧислоСтрока) = Тип("Число") Тогда
		Возврат ЧислоСтрока;
	КонецЕсли;
	
	ЧислоСтрокаПреобразование = СокрЛП(Строка(ЧислоСтрока));
	ЧислоСтрокаПреобразование = СтрЗаменить(ЧислоСтрокаПреобразование, " ", "");
	ЧислоСтрокаПреобразование = СтрЗаменить(ЧислоСтрокаПреобразование, Символы.НПП, "");
	
	НомерРазделителяДробнойЧасти = 0;    
	ЧислоСтрокаРезультат         = "";
	КоличествоСимволов           = СтрДлина(ЧислоСтрокаПреобразование);
	Для НомерСимвола = 1 По КоличествоСимволов Цикл
		
		// 0 в кодировке Unicode это 48
		// 9 в кодировке Unicode это 57
		СимволЧисла = Сред(ЧислоСтрокаПреобразование, НомерСимвола, 1);
		Если (КодСимвола(СимволЧисла) >= 48) 
			И (КодСимвола(СимволЧисла) <= 57) Тогда
			ЧислоСтрокаРезультат = ЧислоСтрокаРезультат + СимволЧисла;
			
		ИначеЕсли (НомерСимвола = 1) 
			И ((СимволЧисла = "-") 
			ИЛИ (СимволЧисла = "+" )) Тогда
			ЧислоСтрокаРезультат = ЧислоСтрокаРезультат + СимволЧисла;
			
		ИначеЕсли (СимволЧисла = ",") 
			ИЛИ (СимволЧисла = ".") Тогда
			НомерРазделителяДробнойЧасти = НомерРазделителяДробнойЧасти + 1;
			
			Если НомерРазделителяДробнойЧасти > 1 Тогда
				Прервать;
			КонецЕсли;
			ЧислоСтрокаРезультат = ЧислоСтрокаРезультат + ".";
			
		Иначе
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	ЧислоРезультат = 0;
	
	Если НЕ ЧислоСтрокаРезультат = "" Тогда	
		ЧислоРезультат = Число(ЧислоСтрокаРезультат);
	КонецЕсли;
	
	Возврат ЧислоРезультат;
	
КонецФункции

Функция ЭЦП_ОперацииПроверкиПодписиНаСервере(ДвоичныеДанныеBIN, ДанныеСертификатаЭКОМ, МассивЛогаСобытий) Экспорт
		
	МенеджерКриптографии = ЭЦП_ПолучитьМенеджерКриптографии(ДанныеСертификатаЭКОМ.АлгоритмПодписи, МассивЛогаСобытий);
	Если МенеджерКриптографии = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИмяФайлаBIN = ПолучитьИмяВременногоФайла("bin");
	ДвоичныеДанныеBIN.Записать(ИмяФайлаBIN);
	
	ПодписьBIN = Новый ТекстовыйДокумент;
	ПодписьBIN.Прочитать(ИмяФайлаBIN);
    СтрокаBase64 = ПодписьBIN.ПолучитьТекст();
	СтрокаBase64 = СтрЗаменить(СтрокаBase64, Символы.ПС, "");
	СтрокаBase64 = СтрЗаменить(СтрокаBase64, Символы.ВК, "");
	
	ИмяФайлаSGN = ПолучитьИмяВременногоФайла("sgn");
	ДвоичныеДанныеSGN = Base64Значение(СтрокаBase64);
	Если ДвоичныеДанныеSGN = Неопределено Тогда
	     ДвоичныеДанныеBIN.Записать(ИмяФайлаSGN);
	Иначе	
	     ДвоичныеДанныеSGN.Записать(ИмяФайлаSGN);
	КонецЕсли;
	
	СертификатСовпадает = Ложь;
	
	МассивДанных = МенеджерКриптографии.ПолучитьСертификатыИзПодписи(ИмяФайлаSGN);		
	Для каждого Эл Из МассивДанных Цикл
		Если Base64Строка(Эл.Отпечаток) = ДанныеСертификатаЭКОМ.ОтпечатокСертификата Тогда
			СертификатСовпадает = Истина;
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	
	Возврат СертификатСовпадает;
	
КонецФункции

// /! Процедура из БСП !/ Формирует и выводит сообщение, которое может быть связано с элементом управления формы.
//
// Параметры:
//  ТекстСообщенияПользователю - Строка - текст сообщения.
//  КлючДанных - ЛюбаяСсылка - объект или ключ записи информационной базы, к которому это сообщение относится.
//  Поле - Строка - наименование реквизита формы.
//  ПутьКДанным - Строка - путь к данным (путь к реквизиту формы).
//  Отказ - Булево - выходной параметр, всегда устанавливается в значение Истина.
//
// Пример:
//
//  1. Для вывода сообщения у поля управляемой формы, связанного с реквизитом объекта:
//  ОбщегоНазначенияКлиент.СообщитьПользователю(
//   НСтр("ru = 'Сообщение об ошибке.'"), ,
//   "ПолеВРеквизитеФормыОбъект",
//   "Объект");
//
//  Альтернативный вариант использования в форме объекта:
//  ОбщегоНазначенияКлиент.СообщитьПользователю(
//   НСтр("ru = 'Сообщение об ошибке.'"), ,
//   "Объект.ПолеВРеквизитеФормыОбъект");
//
//  2. Для вывода сообщения рядом с полем управляемой формы, связанным с реквизитом формы:
//  ОбщегоНазначенияКлиент.СообщитьПользователю(
//   НСтр("ru = 'Сообщение об ошибке.'"), ,
//   "ИмяРеквизитаФормы");
//
//  3. Для вывода сообщения связанного с объектом информационной базы:
//  ОбщегоНазначенияКлиент.СообщитьПользователю(
//   НСтр("ru = 'Сообщение об ошибке.'"), ОбъектИнформационнойБазы, "Ответственный",,Отказ);
//
//  4. Для вывода сообщения по ссылке на объект информационной базы:
//  ОбщегоНазначенияКлиент.СообщитьПользователю(
//   НСтр("ru = 'Сообщение об ошибке.'"), Ссылка, , , Отказ);
//
//  Случаи некорректного использования:
//   1. Передача одновременно параметров КлючДанных и ПутьКДанным.
//   2. Передача в параметре КлючДанных значения типа отличного от допустимого.
//   3. Установка ссылки без установки поля (и/или пути к данным).
//
Процедура СообщитьПользователю( 
	Знач ТекстСообщенияПользователю,
	Знач КлючДанных = Неопределено,
	Знач Поле = "",
	Знач ПутьКДанным = "",
	Отказ = Ложь) Экспорт
	
	ЭтоОбъект = Ложь;
	
	Если КлючДанных <> Неопределено
		И XMLТипЗнч(КлючДанных) <> Неопределено Тогда
		
		ТипЗначенияСтрокой = XMLТипЗнч(КлючДанных).ИмяТипа;
		ЭтоОбъект = ЭКОМ_ОбщегоНазначения.ПоискВСтроке(ТипЗначенияСтрокой, "Object.") > 0;
	КонецЕсли;
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщенияПользователю;
	Сообщение.Поле = Поле;
	
	Если ЭтоОбъект Тогда
		Сообщение.УстановитьДанные(КлючДанных);
	Иначе
		Сообщение.КлючДанных = КлючДанных;
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(ПутьКДанным) Тогда
		Сообщение.ПутьКДанным = ПутьКДанным;
	КонецЕсли;
	
	Сообщение.Сообщить();
	
	Отказ = Истина;
	
КонецПроцедуры

