//Выдает строкой полный путь до каталога временных файлов типа ("C:\temp\") на сервере т.к. это серверый общий модуль
Функция ПолучитьКаталогВременныхФайлов() Экспорт
	
	РазделительПути = ЭКОМ_Общее_ПолучитьРазделительПутиНаСервере();
	
	Результат = "";
    Результат = КаталогВременныхФайлов();
    Если НЕ Прав(Результат, 1) = РазделительПути Тогда
    	Результат = Результат + РазделительПути;
    КонецЕсли;
    
    Возврат Результат;
	
