КонецФункции

Функция СертификатКриптографииBase64(ДвоичныеДанныеСертификата)
	
	СтрокаBase64 = Base64Строка(ДвоичныеДанныеСертификата);
	
	Значение = СтрЗаменить(СтрокаBase64, Символы.ВК, "");
	Значение = СтрЗаменить(Значение, Символы.ПС, "");
	
	Возврат Значение;
	
КонецФункции

Функция ЭЦП_ПолучитьСертификатыКриптографии(Знач АлгоритмПодписи, Знач ТолькоЛичные, Знач ТолькоДействующиеСертификаты = Истина, МассивЛогаСобытий) Экспорт
	
	СписокСертификатовВсего = Новый Массив;
	МассивСтрокОтпечатков   = Новый Массив;
    
    ОписаниеУказанногоАлгоритмаПодписи = ?(ЗначениеЗаполнено(АлгоритмПодписи), АлгоритмПодписи, "алгоритм подписи не заполнен");
     
    ОписаниеОперации = "Получение [МенеджерКриптографии] для чтения всех сертификатов НаКлиенте с алгоритмом подписи [" + ОписаниеУказанногоАлгоритмаПодписи + "]";
    
    Если ЗначениеЗаполнено(АлгоритмПодписи) Тогда
        ТекущийАлгоритмПодписи = АлгоритмПодписи;
    Иначе
        ВсеПоддерживаемыеАлгоритмыПодписей = ВсеАлгоритмыПодписей();
        ТекущийАлгоритмПодписи = ВсеПоддерживаемыеАлгоритмыПодписей[0]; //алгоритм можно брать любой 1с возвращает все равно все сертификаты вне зависимости от алгоритма создания МенеджерКриптографии
    КонецЕсли;
    
    МенеджерКриптографии = ЭЦП_ПолучитьМенеджерКриптографии(ТекущийАлгоритмПодписи, МассивЛогаСобытий);
	                                           
	Если НЕ МенеджерКриптографии = Неопределено Тогда
			
		СписокСертификатов = ЭЦП_ПолучитьВсеСертификатыСтруктурами(МенеджерКриптографии, АлгоритмПодписи, ТолькоЛичные, МассивСтрокОтпечатков, МассивЛогаСобытий);	
        Для каждого ТекущийСертификатИзВсехСертификатов  Из СписокСертификатов Цикл	
            Если НЕ ПодходитАлгоритмСрокДействияСертификата(ТекущийСертификатИзВсехСертификатов, ТолькоДействующиеСертификаты) Тогда
                Продолжить;
            КонецЕсли;
			СписокСертификатовВсего.Добавить(ТекущийСертификатИзВсехСертификатов);	
		КонецЦикла;
    Иначе
        Возврат Новый Массив;
	КонецЕсли;
	
	Возврат СписокСертификатовВсего;		

КонецФункции	

// Возвращает созданный МенеджерКриптографии
//
// Параметры:
//  Параметры   - Структура - Создается функцией ПараметрыМенеджераКриптографииПоАлгоритмуПодписи() на основе переданного параметра АлгоритмПодписи
//  МассивЛогаСобытий  - Строка - Сюда будет дописано описание в случае ошибки
// 
// Возвращаемое значение:
// Неопределено, МенеджерКриптографии - если МенеджерКриптографии не создан возвращается Неопределено
//
Функция СоздатьМенеджерКриптографии(Параметры, МассивЛогаСобытий) Экспорт
    Результат = Неопределено;
    Попытка
    	Результат = Новый МенеджерКриптографии(Параметры.ИмяМодуляКриптографии, Параметры.ПутьМодуляКриптографии, Параметры.ТипМодуляКриптографии);
    Исключение
        Ошибка = ОписаниеОшибки();
		ТекстЛогаСобытий = "Проверьте установлена ли программа криптопровайдера [" + Параметры.ИмяМодуляКриптографии + "] на компьютер
		| с алгоритмом подписи [" + Параметры.АлгоритмПодписи + "]" + Символы.ПС + Символы.ПС + Ошибка;
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, "Создать менеджер криптографии");
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
    КонецПопытки;
    
    Возврат Результат;
КонецФункции 

Функция ЭЦП_ПолучитьМенеджерКриптографии(АлгоритмПодписи, МассивЛогаСобытий) Экспорт
	
    ЭКОМ_МенеджерКриптографии  = Неопределено;
	
    Параметры = ЭЦП_ПараметрыМенеджераКриптографииПоАлгоритмуПодписи(АлгоритмПодписи);    
	Если Параметры.АлгоритмПодписи = "" Тогда
		ТекстЛогаСобытий = "Менеджер криптографии не создан, проверьте поддержку алгоритма подписи [" + АлгоритмПодписи + "] в программе
		| криптопровайдера [" + Параметры.ИмяМодуляКриптографии + "]";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, "Создать менеджер криптографии");
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

	Иначе
		 ЭКОМ_МенеджерКриптографии = СоздатьМенеджерКриптографии(Параметры, МассивЛогаСобытий);
	КонецЕсли;

    Возврат ЭКОМ_МенеджерКриптографии;
	
КонецФункции

Функция ПодходитАлгоритмСрокДействияСертификата(Знач Сертификат, Знач ТолькоДействующиеСертификаты = Истина)
    Перем ДатаОкончания;
    
    Если Сертификат.Свойство("ДействителенДо", ДатаОкончания) = Неопределено Тогда //нет поля ДействителенДо
        Возврат Истина;
    КонецЕсли;
    
    Если ТолькоДействующиеСертификаты = Истина И ДатаОкончания < ТекущаяДата() Тогда // отфильтровываем истекшие сертификаты. Сертификат уже не подходит дальше продолжать нет смысла
        Возврат Ложь;
    Иначе
        Результат = Истина;
    КонецЕсли;
    
    Результат = ЭКОМ_ОбщегоНазначения.ЭтоПоддерживаемыйАлгоритмПодписи(Сертификат.АлгоритмПодписи);
    
    Возврат Результат;
КонецФункции

Функция ЭЦП_ПолучитьВсеСертификатыСтруктурами(МенеджерКриптографии, АлгоритмПодписи, ТолькоЛичные, МассивСтрокОтпечатков, МассивЛогаСобытий)
	
	Сертификаты = Новый Массив;
   
	ЭЦП_ЗаполнитьМассивСертификатовПоТипуХранилищаСертификатов(АлгоритмПодписи, МассивЛогаСобытий, МенеджерКриптографии, ТипХранилищаСертификатовКриптографии.ПерсональныеСертификаты , Сертификаты);
	
    Если НЕ ТолькоЛичные Тогда
        ЭЦП_ЗаполнитьМассивСертификатовПоТипуХранилищаСертификатов(АлгоритмПодписи, МассивЛогаСобытий, МенеджерКриптографии, ТипХранилищаСертификатовКриптографии.КорневыеСертификаты, Сертификаты);
	КонецЕсли;
	
	Возврат Сертификаты;		

КонецФункции

Процедура ЭЦП_ЗаполнитьМассивСертификатовПоТипуХранилищаСертификатов(Знач АлгоритмПодписи, МассивЛогаСобытий, Знач МенеджерКриптографии, ТипХранилища, Сертификаты)
       
    Хранилище = МенеджерКриптографии.ПолучитьХранилищеСертификатов(ТипХранилища);
    СертификатыХранилища = Хранилище.ПолучитьВсе(); 
	СписокСертификатов   = ПолучитьДанныеОСертификатах();
	
	АлгоритмыПодписиСертификата    = ИдентификаторыАлгоритмовПодписи(Истина);
	АлгоритмыСформированнойПодписи = ИдентификаторыАлгоритмовПодписи(Ложь);

	ОбъектКомпоненты = ОбъектВнешнейКомпонентыXMLDSig(МассивЛогаСобытий);
	
	Для Каждого Сертификат Из СертификатыХранилища Цикл
		
		Если НЕ ОбъектКомпоненты = Неопределено Тогда
			OIDАлгоритмаПодписи         = РезультатGetSignOIDFromCert(ОбъектКомпоненты, Сертификат, МассивЛогаСобытий);  
			МассивАлгоритмовСертификата = АлгоритмыСформированнойПодписи.Получить(OIDАлгоритмаПодписи);
			
			Если МассивАлгоритмовСертификата = Неопределено Тогда
				Продолжить;
				
			КонецЕсли;
			
			// Меняем алгоритм подписи на корректный
			Индекс = МассивАлгоритмовСертификата.Найти(АлгоритмПодписи);
			Если Индекс = Неопределено Тогда
				 АлгоритмПодписи = МассивАлгоритмовСертификата[0];
				
			КонецЕсли;
		КонецЕсли;
		
		ДвоичныйОтпечатокСертификата = Строка(Сертификат.Отпечаток);
		ДвоичныйОтпечатокСертификата = СтрЗаменить(ДвоичныйОтпечатокСертификата, " ", "");
        АлгоритмаПодписиСертификата = СписокСертификатов.Получить(ДвоичныйОтпечатокСертификата);
		МассивАлгоритмовСертификата = АлгоритмыПодписиСертификата.Получить(АлгоритмаПодписиСертификата);
		Если НЕ МассивАлгоритмовСертификата = Неопределено Тогда
			// Меняем алгоритм подписи на корректный
			Индекс = МассивАлгоритмовСертификата.Найти(АлгоритмПодписи);
			Если Индекс = Неопределено Тогда
				АлгоритмПодписи = МассивАлгоритмовСертификата[0];
				
			КонецЕсли;	
		КонецЕсли;
		
		СтруктураСертификата = ЭЦП_ЗаполнитьСтруктуруСертификата(Сертификат, АлгоритмПодписи, МассивЛогаСобытий); //есть реквизиты дата окончания, кому выдан и т.п.
        Если СтруктураСертификата = Неопределено Тогда
            Продолжить;
        КонецЕсли;
					 
        Сертификаты.Добавить(СтруктураСертификата);
	   
    КонецЦикла;
      
КонецПроцедуры	

Процедура ПолучитьМассивСертификатов(ОсновнойАлгоритмПодписи, Сертификаты, СертификатыХранилища, СписокСертификатов, МассивЛогаСобытий) Экспорт
	
	
КонецПроцедуры

Функция ПолучитьДанныеОСертификатах()
	
	СписокСертификатов = Новый Соответствие;
	
	Попытка
		OSertificats = Новый COMОбъект("CAdESCOM.Store");
	Исключение
		Сообщить("Объект CAdESCOM.Store не создан: " + ОписаниеОшибки());
		Возврат СписокСертификатов;
	КонецПопытки;
	
	CURRENT_USER_STORE = 2;
	MY_STORE = "My";
	STORE_OPEN_READ_ONLY = 0;
		
	OSertificats.Open(CURRENT_USER_STORE, MY_STORE, STORE_OPEN_READ_ONLY);
	
	Для каждого ТекущийСертификат Из OSertificats.Certificates Цикл
		АлгоритмПодписиСертификата = "";
		ОтпечатокСертификата       = ТекущийСертификат.Thumbprint;
		Попытка
			ОткрытыйКлюч = ТекущийСертификат.PublicKey();
			АлгоритмПодписиСертификата = ОткрытыйКлюч.Algorithm.Value;
		Исключение  // Если что-то не так возвращет
			АлгоритмПодписиСертификата = "ГОСТ Р 34.10-2012 256 бит";          
		КонецПопытки; 
		
		СписокСертификатов.Вставить(ОтпечатокСертификата, АлгоритмПодписиСертификата);
	КонецЦикла;
	
	Возврат СписокСертификатов;
	
КонецФункции 

Функция АлгоритмПодписи(Данные, ЭтоДанныеСертификата, ВключаяOID = Ложь)
	
	ДвоичныеДанные = ""; //ДвоичныеДанныеИзДанных(Данные,
		//"ЭлектроннаяПодписьСлужебныйКлиентСервер.АлгоритмПодписи");
	
	АнализДанных = НовыйАнализДанных(ДвоичныеДанные);
	
	Если ЭтоДанныеСертификата Тогда
		// SEQUENCE (Certificate).
		ПропуститьНачалоБлока(АнализДанных, 0, 16);
			// SEQUENCE (tbsCertificate).
			ПропуститьНачалоБлока(АнализДанных, 0, 16);
				//          (version              [0]  EXPLICIT Version DEFAULT v1).
				ПропуститьБлок(АнализДанных, 2, 0);
				// INTEGER  (serialNumber         CertificateSerialNumber).
				ПропуститьБлок(АнализДанных, 0, 2);
				// SEQUENCE (signature            AlgorithmIdentifier).
				ПропуститьБлок(АнализДанных, 0, 16);
				// SEQUENCE (issuer               Name).
				ПропуститьБлок(АнализДанных, 0, 16);
				// SEQUENCE (validity             Validity).
				ПропуститьБлок(АнализДанных, 0, 16);
				// SEQUENCE (subject              Name).
				ПропуститьБлок(АнализДанных, 0, 16);
				// SEQUENCE (subjectPublicKeyInfo SubjectPublicKeyInfo).
				ПропуститьНачалоБлока(АнализДанных, 0, 16);
					// SEQUENCE (algorithm  AlgorithmIdentifier).
					ПропуститьНачалоБлока(АнализДанных, 0, 16);
						// OBJECT IDENTIFIER (algorithm).
						ПропуститьНачалоБлока(АнализДанных, 0, 6);
	Иначе
		// SEQUENCE (PKCS #7 ContentInfo).
		ПропуститьНачалоБлока(АнализДанных, 0, 16);
			// OBJECT IDENTIFIER (contentType).
			ПропуститьНачалоБлока(АнализДанных, 0, 6);
				// 1.2.840.113549.1.7.2 signedData (PKCS #7).
				ПроверитьДанныеБлока(АнализДанных, "2A864886F70D010702");
				ПропуститьРодительскийБлок(АнализДанных);
			// [0]CS             (content [0] EXPLICIT ANY DEFINED BY contentType OPTIONAL).
			ПропуститьНачалоБлока(АнализДанных, 2, 0);
				// SEQUENCE (content SignedData).
				ПропуститьНачалоБлока(АнализДанных, 0, 16);
					// INTEGER  (version          Version).
					ПропуститьБлок(АнализДанных, 0, 2);
					// SET      (digestAlgorithms DigestAlgorithmIdentifiers).
					ПропуститьБлок(АнализДанных, 0, 17);
					// SEQUENCE (contentInfo      ContentInfo).
					ПропуститьБлок(АнализДанных, 0, 16);
					// [0]CS    (certificates     [0] IMPLICIT ExtendedCertificatesAndCertificates OPTIONAL).
					ПропуститьБлок(АнализДанных, 2, 0, Ложь);
					// [1]CS    (crls             [1] IMPLICIT CertificateRevocationLists OPTIONAL).
					ПропуститьБлок(АнализДанных, 2, 1, Ложь);
					// SET      (signerInfos      SET OF SignerInfo).
					ПропуститьНачалоБлока(АнализДанных, 0, 17);
						// SEQUENCE (signerInfo SignerInfo).
						ПропуститьНачалоБлока(АнализДанных, 0, 16);
							// INTEGER  (version                   Version).
							ПропуститьБлок(АнализДанных, 0, 2);
							// SEQUENCE (issuerAndSerialNumber     IssuerAndSerialNumber).
							ПропуститьБлок(АнализДанных, 0, 16);
							// SEQUENCE (digestAlgorithm           DigestAlgorithmIdentifier).
							ПропуститьБлок(АнализДанных, 0, 16);
							// [0]CS    (authenticatedAttributes   [0] IMPLICIT Attributes OPTIONAL).
							ПропуститьБлок(АнализДанных, 2, 0, Ложь);
							// SEQUENCE (digestEncryptionAlgorithm AlgorithmIdentifier).
							ПропуститьНачалоБлока(АнализДанных, 0, 16);
								// OBJECT IDENTIFIER (algorithm).
								ПропуститьНачалоБлока(АнализДанных, 0, 6);
	КонецЕсли;
	
	OIDАлгоритмаПодписи = ПрочитанныйOID(АнализДанных);
	Если АнализДанных.ЕстьОшибка Тогда
		Возврат "";
	КонецЕсли;
	
	ИдентификаторыАлгоритмов = ИдентификаторыАлгоритмовПодписи(ЭтоДанныеСертификата);
	Алгоритм = АлгоритмПоOID(OIDАлгоритмаПодписи, ИдентификаторыАлгоритмов, ВключаяOID);
	
	Возврат Алгоритм;
	
КонецФункции

Функция АлгоритмПоOID(OIDАлгоритма, ИдентификаторыАлгоритмов, ВключаяOID)
	
	ИмяАлгоритма = ИдентификаторыАлгоритмов.Получить(OIDАлгоритма);
	
	Если ИмяАлгоритма = Неопределено Тогда
		Если ВключаяOID Тогда
			Возврат НСтр("ru = 'Неизвестный'") + " (OID " + OIDАлгоритма + ")";
		КонецЕсли;
		Возврат "";
	ИначеЕсли ВключаяOID Тогда	
		
		Возврат РазложитьСтрокуВМассивПодстрок(ИмяАлгоритма, ",", Ложь)[0] + " (OID " + OIDАлгоритма + ")";
	Иначе
		Возврат ИмяАлгоритма;
	КонецЕсли;
	
КонецФункции

Функция ПрочитанныйOID(АнализДанных)
	
	Если АнализДанных.ЕстьОшибка Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если АнализДанных.Родители.Количество() = 0 Тогда
		ПриОшибкеСтруктурыДанных(АнализДанных);
		Возврат Неопределено;
	КонецЕсли;
	
	ЦелыеЧисла = Новый Массив;
	РазмерДанных = АнализДанных.Родители[0].РазмерДанных;
	Если РазмерДанных = 0 Тогда
		ПриОшибкеСтруктурыДанных(АнализДанных);
		Возврат Неопределено;
	КонецЕсли;
	ГраницаСмещения = АнализДанных.Смещение + РазмерДанных;
	
	Пока АнализДанных.Смещение < ГраницаСмещения Цикл
		ЦелоеЧисло = ПрочитатьПотоковоеЦелое(АнализДанных);
		Если АнализДанных.ЕстьОшибка Тогда
			Возврат Неопределено;
		КонецЕсли;
		ЦелыеЧисла.Добавить(ЦелоеЧисло);
	КонецЦикла;
	
	Если АнализДанных.Смещение <> ГраницаСмещения
	 Или ЦелыеЧисла.Количество() = 0 Тогда
		
		ПриОшибкеКодированияASN1(АнализДанных);
		Возврат Неопределено;
	КонецЕсли;
	
	ЧислоSID2 = ЦелыеЧисла[0];
	Если ЧислоSID2 < 40 Тогда
		SID1 = 0;
	ИначеЕсли ЧислоSID2 < 80 Тогда
		SID1 = 1;
	Иначе
		SID1 = 2;
	КонецЕсли;
	ЦелыеЧисла[0] = ЧислоSID2 - SID1*40;
	ЦелыеЧисла.Вставить(0, SID1);
	
	СтрокиЧисел = Новый Массив;
	Для Каждого ЦелоеЧисло Из ЦелыеЧисла Цикл
		СтрокиЧисел.Добавить(Формат(ЦелоеЧисло, "ЧН=0; ЧГ="));
	КонецЦикла;
	
	ПолноеИмя = "";
	Для Каждого Стр Из СтрокиЧисел Цикл
		ПолноеИмя = ?(ПолноеИмя="", "", ПолноеИмя + ".")  + Стр;
	КонецЦикла;
	
	Возврат ПолноеИмя;
	
КонецФункции

