				НоваяЗапись.КоличествоГрузовыхМест = Источник.Товары.Итог("Количество");
				НоваяЗапись.Организация = Источник[ИмяОрганизации];
				НоваяЗапись.Контрагент  = Источник[ИмяКонтрагента];
				НоваяЗапись.ДатаЭТРН    = Источник[ДатаЭТРН];
				НоваяЗапись.НомерЭТРН   = Источник[НомерЭТРН];		
			КонецЦикла;	
			
			// Записываем документ в первый раз
			Если НаборЗаписей.Количество() = 0 Тогда
				
				НоваяЗапись = НаборЗаписей.Добавить();
				НоваяЗапись.Накладная   = Источник.Ссылка;
				
				НоваяЗапись.Организация = Источник[ИмяОрганизации];
				НоваяЗапись.Контрагент  = Источник[ИмяКонтрагента];
				НоваяЗапись.ДатаЭТРН    = Источник[ДатаЭТРН];
				НоваяЗапись.НомерЭТРН   = Источник[НомерЭТРН];					
				НоваяЗапись.СчетФактура            = СчетФактура;
				НоваяЗапись.Заказ                  = Источник[ИмяЗаказа1С];
				НоваяЗапись.Перевозчик             = Источник[ИмяПеревозчика];
				НоваяЗапись.КоличествоГрузовыхМест = Источник.Товары.Итог("Количество");
			КонецЕсли;
			
			НаборЗаписей.Записать();		
			
			НаборЗаписейТИ = РегистрыСведений.ЭКОМ_ТранспортнаяИнформация.СоздатьНаборЗаписей();
			НаборЗаписейТИ.Отбор.Документ.Установить(Источник.Ссылка);
			
			// Выполним блокировку данных
			ВыполнитьБлокировкуНабораЗаписей(НаборЗаписейТИ.Отбор, "ЭКОМ_ТранспортнаяИнформация");
			
			НаборЗаписейТИ.Прочитать();
			
			Данные = Новый Структура;
			Данные.Вставить("Перевозчик", Источник[ИмяПеревозчика]);
			
			// Транспортная информация для УТ 11
			//Если ЗначениеЗаполнено(Источник.Водитель) Тогда
			
			//ДлинаСтроки = СтрДлина(Источник.Водитель);
			//ПервыйСимволПробела = Найти(Источник.Водитель, " ");
			
			//ИмяОтчество = Сред(Источник.Водитель, ПервыйСимволПробела + 1, ДлинаСтроки-ПервыйСимволПробела);
			//ВторойСимволПробела = Найти(ИмяОтчество, " ");
			
			//ВодительФамилия  = Лев(Источник.Водитель, ПервыйСимволПробела-1);
			//ВодительИмя      = Лев(ИмяОтчество, ВторойСимволПробела-1);
			//ВодительОтчество = Прав(ИмяОтчество, ДлинаСтроки - ВторойСимволПробела - ПервыйСимволПробела);
			
			//Иначе
			
			//ВодительФамилия  = "";
			//ВодительИмя      = "";
			//ВодительОтчество = "";
			
			//КонецЕсли;
			
			//Данные.Вставить("Марка"                    , Источник.МаркаАвтомобиля);
			//Данные.Вставить("Номер"                    , Источник.РегистрационныйЗнакАвтомобиля);
			//Данные.Вставить("ВодительФамилия"          , ВодительФамилия);
			//Данные.Вставить("ВодительИмя"              , ВодительИмя);
			//Данные.Вставить("ВодительОтчество"         , ВодительОтчество);
			//Данные.Вставить("ВодительскоеУдостоверение", Источник.ВодительскоеУдостоверение);
			
			// Если существует документ в регистре 
			Для Каждого НоваяЗапись Из НаборЗаписейТИ Цикл
				
				Для каждого Эл Из Данные Цикл
					Если ЗначениеЗаполнено(Эл.Значение) Тогда
						НоваяЗапись[Эл.Ключ] = Эл.Значение;		 
					КонецЕсли;
				КонецЦикла;
				
			КонецЦикла;	
			
			// Записываем документ в первый раз
			Если НаборЗаписейТИ.Количество() = 0 Тогда
				
				НоваяЗапись = НаборЗаписейТИ.Добавить();
				НоваяЗапись.Документ   = Источник.Ссылка;
				
				Для каждого Эл Из Данные Цикл
					Если ЗначениеЗаполнено(Эл.Значение) Тогда
						НоваяЗапись[Эл.Ключ] = Эл.Значение;		 
					КонецЕсли;
				КонецЦикла;
				
			КонецЕсли;
			
			НаборЗаписейТИ.Записать();	
			
		КонецЕсли;
		
	КонецЕсли;         
	
	// Получатель - входящий 1С документ WHGOU_04_Входящий
	Если  ТипЗнч(Источник.Ссылка) = Тип(ТипДокументаПоступления) Тогда
		
		НаборЗаписей = РегистрыСведений.ЭКОМ_ЦепочкиДокументовЭТРН.СоздатьНаборЗаписей();
