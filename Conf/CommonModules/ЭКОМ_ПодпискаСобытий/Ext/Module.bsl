// В конфигурации не вызывается. Если не используется в гибких настройках - необходимо удалить
//
Функция ПолучитьЦепочкаДокументов(СтруктураПоиска, ТипОбмена) Экспорт
	
	ЗапросЦепочкаДокументов = Новый Запрос;
	Если ТипОбмена = "ЭТРН" Тогда
		
		ТекстПолучить =  "ВЫБРАТЬ
		                 |	ЭКОМ_ЦепочкиДокументовЭТРН.ДатаЭТРН КАК ДатаЭТРН,
		                 |	ЭКОМ_ЦепочкиДокументовЭТРН.НомерЭТРН КАК НомерЭТРН,
		                 |	ЭКОМ_ЦепочкиДокументовЭТРН.Накладная КАК Накладная
		                 |ИЗ
		                 |	РегистрСведений.ЭКОМ_ЦепочкиДокументовЭТРН КАК ЭКОМ_ЦепочкиДокументовЭТРН
		                 |ГДЕ
		                 |	ИСТИНА";
		
		ТекстУсловие = "";
		Для Каждого ЭлементСтруктуры Из СтруктураПоиска Цикл
			ТекстУсловие = ТекстУсловие + "
			|	И ЭКОМ_ЦепочкиДокументовЭТРН." + ЭлементСтруктуры.Ключ + " = &" + ЭлементСтруктуры.Ключ;
			
			ЗапросЦепочкаДокументов.УстановитьПараметр(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);
			
		КонецЦикла;
		
	ИначеЕсли ТипОбмена = "Поставщик" Тогда
		
		ТекстПолучить =  "ВЫБРАТЬ
		                 |	ЭКОМ_ЦепочкиДокументовПоставщика.ORDERDATE,
		                 |	ЭКОМ_ЦепочкиДокументовПоставщика.xmlОрганизация,
		                 |	ЭКОМ_ЦепочкиДокументовПоставщика.xmlКонтрагент,
		                 |	ЭКОМ_ЦепочкиДокументовПоставщика.xmlТочкаДоставки,
		                 |	ЭКОМ_ЦепочкиДокументовПоставщика.ORDERNUMBER,
		                 |	ЭКОМ_ЦепочкиДокументовПоставщика.ORDER,
		                 |	ЭКОМ_ЦепочкиДокументовПоставщика.Заказ,
		                 |	ЭКОМ_ЦепочкиДокументовПоставщика.Накладная,
		                 |	ЭКОМ_ЦепочкиДокументовПоставщика.СЧФ,
		                 |	ЭКОМ_ЦепочкиДокументовПоставщика.RECADV,
		                 |	ЭКОМ_ЦепочкиДокументовПоставщика.Накладная_Кор,
		                 |	ЭКОМ_ЦепочкиДокументовПоставщика.RETANN,
		                 |	ЭКОМ_ЦепочкиДокументовПоставщика.ВозвратнаяНакладная
		                 |ИЗ
		                 |	РегистрСведений.ЭКОМ_ЦепочкиДокументовПоставщика КАК ЭКОМ_ЦепочкиДокументовПоставщика
		                 |ГДЕ
		                 |	ИСТИНА";
		
		ТекстУсловие = "";
		Для Каждого ЭлементСтруктуры Из СтруктураПоиска Цикл
			ТекстУсловие = ТекстУсловие + "
			|	И ЭКОМ_ЦепочкиДокументовПоставщика." + ЭлементСтруктуры.Ключ + " = &" + ЭлементСтруктуры.Ключ;
			
			ЗапросЦепочкаДокументов.УстановитьПараметр(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);
			
		КонецЦикла;
		
	ИначеЕсли ТипОбмена = "Сеть" Тогда
		
		ТекстПолучить =  "ВЫБРАТЬ
		                 |	ЭКОМ_ЦепочкиДокументовПокупателя.ORDERDATE,
		                 |	ЭКОМ_ЦепочкиДокументовПокупателя.xmlОрганизация,
		                 |	ЭКОМ_ЦепочкиДокументовПокупателя.xmlКонтрагент,
		                 |	ЭКОМ_ЦепочкиДокументовПокупателя.xmlТочкаДоставки,
		                 |	ЭКОМ_ЦепочкиДокументовПокупателя.ORDERNUMBER,
		                 |	ЭКОМ_ЦепочкиДокументовПокупателя.Заказ,
		                 |	ЭКОМ_ЦепочкиДокументовПокупателя.Накладная,
		                 |	ЭКОМ_ЦепочкиДокументовПокупателя.СЧФ,
		                 |	ЭКОМ_ЦепочкиДокументовПокупателя.ВозвратнаяНакладная
		                 |ИЗ
		                 |	РегистрСведений.ЭКОМ_ЦепочкиДокументовПокупателя КАК ЭКОМ_ЦепочкиДокументовПокупателя
		                 |ГДЕ
		                 |	ИСТИНА";
		
		ТекстУсловие = "";
		Для Каждого ЭлементСтруктуры Из СтруктураПоиска Цикл
			ТекстУсловие = ТекстУсловие + "
			|	И ЭКОМ_ЦепочкиДокументовПокупателя." + ЭлементСтруктуры.Ключ + " = &" + ЭлементСтруктуры.Ключ;
			
			ЗапросЦепочкаДокументов.УстановитьПараметр(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);
			
		КонецЦикла;

	КонецЕсли;
	
	ЗапросЦепочкаДокументов.Текст = ТекстПолучить + ТекстУсловие;
	
	Возврат ЗапросЦепочкаДокументов.Выполнить().Выгрузить();
	
КонецФункции	

// Функция перенесена в ЭКОМ_ОбщегоНазначения.КонтрагентУчаствуетВЭДО(). Если не используется где-то кроме подписки - удалить.
//
Функция КонтрагентУчаствуетВЭДО(Организация, Контрагент, ТочкаДоставки = Неопределено) Экспорт
	
	ЗапроcПроверкаКлиента = Новый Запрос;
	ЗапроcПроверкаКлиента.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	                              |	ЭКОМ_Организации.GLN КАК GLN_Организация,
	                              |	ЭКОМ_Контрагенты.GLN КАК GLN_Контрагент,
	                              |	ЭКОМ_ТочкиДоставки.GLN КАК GLN_ТочкаДоставки,
	                              |	ЭКОМ_Контрагенты.Ид_ОЭД КАК ИдентификаторКонтрагент,
	                              |	ЭКОМ_Организации.Ид_ОЭД КАК ИдентификаторОрганизация,
	                              |	ЭКОМ_ТочкиДоставки.Ид_ОЭД КАК ИдентификаторТочкаДоставки
	                              |ИЗ
	                              |	РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_Организации
	                              |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_Контрагенты
	                              |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_ТочкиДоставки КАК ЭКОМ_ТочкиДоставки
	                              |			ПО (ИСТИНА)
	                              |		ПО (ИСТИНА)
	                              |ГДЕ
	                              |	ЭКОМ_Организации.Объект = &Организация
	                              |	И ЭКОМ_Контрагенты.Объект = &Контрагент
	                              |	И ВЫБОР
	                              |			КОГДА &ТочкаДоставки = НЕОПРЕДЕЛЕНО
	                              |				ТОГДА ИСТИНА
	                              |			ИНАЧЕ ЭКОМ_ТочкиДоставки.Объект = &ТочкаДоставки
	                              |		КОНЕЦ";
	ЗапроcПроверкаКлиента.УстановитьПараметр("ТочкаДоставки", ТочкаДоставки);
	ЗапроcПроверкаКлиента.УстановитьПараметр("Организация", Организация);
	ЗапроcПроверкаКлиента.УстановитьПараметр("Контрагент", Контрагент);
	РезультатЗапроса = ЗапроcПроверкаКлиента.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Возврат Выборка;

КонецФункции

Функция УчаствуетВЭТРН(Организация, Контрагент, Перевозчик) Экспорт
	
	ЯвляютсяУчастникамиДокументооборота = Ложь;
	ЗапроcПроверкаКлиента = Новый Запрос;
	ЗапроcПроверкаКлиента.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	                              |	ЭКОМ_Организации.GLN КАК GLN_Организация,
	                              |	ЭКОМ_Контрагенты.GLN КАК GLN_Контрагент,
	                              |	ЭКОМ_Перевозчик.GLN КАК GLN_Перевозчика,
	                              |	ЭКОМ_Контрагенты.Ид_ОЭД КАК ИдентификаторКонтрагент,
	                              |	ЭКОМ_Организации.Ид_ОЭД КАК ИдентификаторОрганизация,
	                              |	ЭКОМ_Перевозчик.Ид_ОЭД КАК ИдентификаторПеревозчика
	                              |ИЗ
	                              |	РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_Организации
	                              |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_Контрагенты
	                              |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_Перевозчик
	                              |			ПО (ИСТИНА)
	                              |		ПО (ИСТИНА)
	                              |ГДЕ
	                              |	ЭКОМ_Организации.Объект = &Организация
	                              |	И ЭКОМ_Контрагенты.Объект = &Контрагент
	                              |	И ЭКОМ_Перевозчик.Объект = &Перевозчик";
	ЗапроcПроверкаКлиента.УстановитьПараметр("Перевозчик" , Перевозчик);
	ЗапроcПроверкаКлиента.УстановитьПараметр("Организация", Организация);
	ЗапроcПроверкаКлиента.УстановитьПараметр("Контрагент" , Контрагент);
	РезультатЗапроса = ЗапроcПроверкаКлиента.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
	     ЯвляютсяУчастникамиДокументооборота = Истина;
	КонецЕсли;
		
	Возврат ЯвляютсяУчастникамиДокументооборота;

КонецФункции

Процедура ВыполнитьБлокировкуНабораЗаписей(ОтборБлокировки, ИмяРегистра) Экспорт
	
	// Автоматический - все транзакции, будут выполняться в автоматическом режиме.
	// АвтоматическийИУправляемый  - транзакции, будут выполняться в режиме, определяемом установкой соответствующего свойства объекта метаданных.
	// Управляемый - все транзакции, будут выполняться в управляемом режиме. 
	Блокировать = Ложь;
	Если Метаданные.РежимУправленияБлокировкойДанных = Метаданные.Свойстваобъектов.РежимУправленияБлокировкойДанныхПоУмолчанию.Управляемый Тогда
		Блокировать = Истина;
	КонецЕсли;
	
	Если Блокировать = Истина Тогда
		
		БлокировкаДанных = Новый БлокировкаДанных;
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений." + ИмяРегистра);
		
		Для Каждого ЭлементОтбораБлокировки Из ОтборБлокировки Цикл
			Если ЭлементОтбораБлокировки.Использование Тогда
				ЭлементБлокировкиДанных.УстановитьЗначение(ЭлементОтбораБлокировки.Имя, ЭлементОтбораБлокировки.Значение);
			КонецЕсли;
		КонецЦикла;
		
		ЭлементБлокировкиДанных.Режим = РежимБлокировкиДанных.Исключительный;
		БлокировкаДанных.Заблокировать();
		
	КонецЕсли;
			
КонецПроцедуры	

// Функция перенесена в ЭКОМ_ОбщегоНазначения.ПолучитьИсправляемыйДокументРеализации(). Если не используется где-то кроме подписки - удалить.
//
Функция ПолучитьИсправляемыйДокументРеализации(Док, Исходный = Ложь, ИмяРеквизита = "ДокументРеализации") Экспорт
   
    Если  Док.Метаданные().Имя = "КорректировкаРеализации"	Тогда       
        Возврат ПолучитьИсправляемыйДокументРеализации(Док[ИмяРеквизита], Исходный);       
    Иначе
        Возврат Док;
    КонецЕсли;   
КонецФункции

Функция ПолучитьИсправляемыйДокументПоступления(Док, Исходный = Ложь, ИмяРеквизита = "ДокументПоступления") Экспорт
   
    Если  Док.Метаданные().Имя = "КорректировкаПоступления"	Тогда       
        Возврат ПолучитьИсправляемыйДокументПоступления(Док[ИмяРеквизита], Исходный);       
    Иначе
        Возврат Док;
    КонецЕсли;   
КонецФункции

// Записываем данные в регистр цепочки, если они заполнены
Процедура СформироватьЗаписьВРегистр(НоваяЗапись, ДанныеИзмерений, ДанныеРесурсов) Экспорт

	// Измерения
	Для Каждого СтрокаИзмерения Из ДанныеИзмерений Цикл
		Если НЕ НоваяЗапись[СтрокаИзмерения.Ключ] = СтрокаИзмерения.Значение 
			И ЗначениеЗаполнено(СтрокаИзмерения.Значение) Тогда
			НоваяЗапись[СтрокаИзмерения.Ключ] = СтрокаИзмерения.Значение;		
		КонецЕсли;			    		
	КонецЦикла;
	
	// Ресурсы		
	Для Каждого СтрокаРесурсов Из ДанныеРесурсов Цикл
		Если (НЕ НоваяЗапись[СтрокаРесурсов.Ключ] = СтрокаРесурсов.Значение 
			И ЗначениеЗаполнено(СтрокаРесурсов.Значение)) 
			ИЛИ СтрокаРесурсов.Ключ = "ТекстОшибки" Тогда
			НоваяЗапись[СтрокаРесурсов.Ключ] = СтрокаРесурсов.Значение;		
		КонецЕсли;			    		
	КонецЦикла;
	
КонецПроцедуры

