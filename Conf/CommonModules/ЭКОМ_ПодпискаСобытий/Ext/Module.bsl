//Блок подписки
Функция ПолучитьПодпискуСобытия(Источник, Отказ) Экспорт
	
	ЭКОМ_ОбменСеть      = ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере("ЭКОМ_ОбменСеть"     , Ложь);
	ЭКОМ_ОбменПоставщик = ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере("ЭКОМ_ОбменПоставщик", Ложь);
	ЭКОМ_ОбменЭТРН      = ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере("ЭКОМ_ОбменЭТРН"     , Ложь);
	ЭКОМ_ОбменCONDRA    = ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере("ЭКОМ_ОбменCONDRA"     , Ложь);
	
	Если ЭКОМ_ОбменЭТРН = Истина Тогда
		 ПолучитьПодпискуСобытияЭТРН(Источник);
	КонецЕсли;
	
	Если ЭКОМ_ОбменСеть = Истина Тогда
		 ПолучитьПодпискуСобытияСеть(Источник);
	КонецЕсли;

	Если ЭКОМ_ОбменПоставщик = Истина Тогда
		 ПолучитьПодпискуСобытияПоставщик(Источник);
	КонецЕсли;
	
	Если ЭКОМ_ОбменCONDRA = Истина Тогда
		 ПолучитьПодпискуСобытияCONDRA(Источник);
	КонецЕсли;
	
КонецФункции	

Функция ПолучитьПодпискуСобытияЭТРН(Источник) Экспорт
	
	Алгоритм = ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере("СлужебныйЗапросДляПодпискиДокументовЭТРН", ,"Служебный");	
	Если НЕ ЗначениеЗаполнено(Алгоритм) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка			
		// Примерный код для гибких настроек
		// ПримерШаблоновЭТРН(Источник);
		ЭКОМ_ОбщегоНазначения.ВыполнитьПодпискуВПривелигированномРежиме(Источник.Ссылка, Алгоритм);
		
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Ошибка в подписке:'"), УровеньЖурналаРегистрации.Ошибка,,, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Ошибка в подписке. " + ОписаниеОшибки();
		Сообщение.Сообщить();
		
		ВызватьИсключение;	

	КонецПопытки;	
	
КонецФункции	

