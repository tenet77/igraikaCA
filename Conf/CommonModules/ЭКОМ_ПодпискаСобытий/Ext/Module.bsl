	//УТ 11.4                          
	//ИмяОрганизации   = "Организация";
	//ИмяКонтрагента   = "Контрагент";
	//ИмяПеревозчика   = "Перевозчик";
	//ИмяТочкиДоставки = "Грузополучатель";
	//ИмяЗаказа1С	   = "ЗаказКлиента";
