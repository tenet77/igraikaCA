Функция ЭЦП_ПолучитьСертификатыКриптографииНаКлиенте(Знач АлгоритмПодписи, Знач ТолькоЛичные, Знач ТолькоДействующиеСертификаты = Истина, ОбъектКомпоненты, МассивЛогаСобытий) Экспорт
	
	СписокСертификатовВсего = Новый Массив;
	МассивСтрокОтпечатков   = Новый Массив;
    
    ОписаниеУказанногоАлгоритмаПодписи = ?(ЗначениеЗаполнено(АлгоритмПодписи), АлгоритмПодписи, "алгоритм подписи не заполнен");
      
    ОписаниеОперации = "Получение [МенеджерКриптографии] для чтения всех сертификатов НаКлиенте с алгоритмом подписи [" + ОписаниеУказанногоАлгоритмаПодписи + "]";
    
    Если ЗначениеЗаполнено(АлгоритмПодписи) Тогда
        ТекущийАлгоритмПодписи = АлгоритмПодписи;
    Иначе
        ВсеПоддерживаемыеАлгоритмыПодписей = ЭКОМ_ОбщегоНазначения.ВсеАлгоритмыПодписей();
        ТекущийАлгоритмПодписи = ВсеПоддерживаемыеАлгоритмыПодписей[0]; //алгоритм можно брать любой 1с возвращает все равно все сертификаты вне зависимости от алгоритма создания МенеджерКриптографии
    КонецЕсли;
    
    МенеджерКриптографии = ЭЦП_ПолучитьМенеджерКриптографииНаКлиенте(ТекущийАлгоритмПодписи, МассивЛогаСобытий);
	
	Если НЕ МенеджерКриптографии = Неопределено Тогда
			
		СписокСертификатов = ЭЦП_ПолучитьВсеСертификатыСтруктурами(МенеджерКриптографии, АлгоритмПодписи, ТолькоЛичные, МассивСтрокОтпечатков, ОбъектКомпоненты, МассивЛогаСобытий);	
        Для каждого ТекущийСертификатИзВсехСертификатов  Из СписокСертификатов Цикл	
            Если НЕ ПодходитАлгоритмСрокДействияСертификата(ТекущийСертификатИзВсехСертификатов, ТолькоДействующиеСертификаты) Тогда
                Продолжить;
            КонецЕсли;
			СписокСертификатовВсего.Добавить(ТекущийСертификатИзВсехСертификатов);	
		КонецЦикла;
    Иначе
        Возврат Новый Массив;
	КонецЕсли;
	
	Возврат СписокСертификатовВсего;		

КонецФункции	

// Возвращает созданный МенеджерКриптографии
//
// Параметры:
//  Параметры   - Структура - Создается функцией ПараметрыМенеджераКриптографииПоАлгоритмуПодписи() на основе переданного параметра АлгоритмПодписи
//  МассивЛогаСобытий  - Строка - Сюда будет дописано описание в случае ошибки
// 
// Возвращаемое значение:
// Неопределено, МенеджерКриптографии - если МенеджерКриптографии не создан возвращается Неопределено
//
Функция СоздатьМенеджерКриптографии(Параметры, МассивЛогаСобытий) Экспорт
	
	Результат = Неопределено;
    Попытка
    	Результат = Новый МенеджерКриптографии(Параметры.ИмяМодуляКриптографии, Параметры.ПутьМодуляКриптографии, Параметры.ТипМодуляКриптографии);
	Исключение
		ТекстЛогаСобытий = "Проверьте установлена ли программа криптопровайдера [" + Параметры.ИмяМодуляКриптографии + "] на компьютер
		| с алгоритмом подписи [" + Параметры.АлгоритмПодписи + "]" + Символы.ПС + Символы.ПС + ОписаниеОшибки();
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Ошибка"), "Создать менеджер криптографии на клиенте");
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

    КонецПопытки;
    
    Возврат Результат;
	
КонецФункции 

Функция ЭЦП_ПолучитьМенеджерКриптографииНаКлиенте(АлгоритмПодписи, МассивЛогаСобытий) Экспорт
    	
    ЭКОМ_МенеджерКриптографии  = Неопределено;
	
    Параметры = ЭКОМ_ОбщегоНазначения.ЭЦП_ПараметрыМенеджераКриптографииПоАлгоритмуПодписи(АлгоритмПодписи);    
	Если Параметры.АлгоритмПодписи = "" Тогда
		ТекстЛогаСобытий = "Менеджер криптографии не создан, проверьте поддержку алгоритма подписи [" + АлгоритмПодписи + "] в программе
		| криптопровайдера [" + Параметры.ИмяМодуляКриптографии + "]";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Ошибка"), "Получить менеджер криптографии на клиенте");
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

	Иначе
		 ЭКОМ_МенеджерКриптографии = СоздатьМенеджерКриптографии(Параметры, МассивЛогаСобытий);
	КонецЕсли;
	
    Возврат ЭКОМ_МенеджерКриптографии;
	
КонецФункции

Функция ПодходитАлгоритмСрокДействияСертификата(Знач Сертификат, Знач ТолькоДействующиеСертификаты = Истина)
    Перем ДатаОкончания;
    
    Если Сертификат.Свойство("ДействителенДо", ДатаОкончания) = Неопределено Тогда //нет поля ДействителенДо
        Возврат Истина;
    КонецЕсли;
    
    Если ТолькоДействующиеСертификаты = Истина И ДатаОкончания < ТекущаяДата() Тогда // отфильтровываем истекшие сертификаты. Сертификат уже не подходит дальше продолжать нет смысла
        Возврат Ложь;
    Иначе
        Результат = Истина;
    КонецЕсли;
    
    Результат = ЭКОМ_ОбщегоНазначения.ЭтоПоддерживаемыйАлгоритмПодписи(Сертификат.АлгоритмПодписи);
    
    Возврат Результат;
КонецФункции

Функция ЭЦП_ПолучитьВсеСертификатыСтруктурами(МенеджерКриптографии, АлгоритмПодписи, ТолькоЛичные, МассивСтрокОтпечатков, ОбъектКомпоненты, МассивЛогаСобытий)
	Сертификаты = Новый Массив;
    
	ЭЦП_ЗаполнитьМассивСертификатовПоТипуХранилищаСертификатов(АлгоритмПодписи, МассивЛогаСобытий, МенеджерКриптографии, ТипХранилищаСертификатовКриптографии.ПерсональныеСертификаты, Сертификаты, ОбъектКомпоненты);
	
    Если НЕ ТолькоЛичные Тогда
        ЭЦП_ЗаполнитьМассивСертификатовПоТипуХранилищаСертификатов(АлгоритмПодписи, МассивЛогаСобытий, МенеджерКриптографии, ТипХранилищаСертификатовКриптографии.КорневыеСертификаты, Сертификаты, ОбъектКомпоненты);
	КонецЕсли;
	
	Возврат Сертификаты;		

КонецФункции

Процедура ЭЦП_ЗаполнитьМассивСертификатовПоТипуХранилищаСертификатов(Знач АлгоритмПодписи, МассивЛогаСобытий, Знач МенеджерКриптографии, ТипХранилища, Сертификаты, ОбъектКомпоненты)
       		
    Хранилище = МенеджерКриптографии.ПолучитьХранилищеСертификатов(ТипХранилища);
    СертификатыХранилища = Хранилище.ПолучитьВсе(); 
	СписокСертификатов   = ПолучитьДанныеОСертификатах();
	
	АлгоритмыПодписиСертификата    = ИдентификаторыАлгоритмовПодписи(Истина);
	АлгоритмыСформированнойПодписи = ИдентификаторыАлгоритмовПодписи(Ложь);
	
	Для Каждого Сертификат Из СертификатыХранилища Цикл
		
		Если НЕ ОбъектКомпоненты = Неопределено Тогда
			OIDАлгоритмаПодписи         = РезультатGetSignOIDFromCert(ОбъектКомпоненты, Сертификат, МассивЛогаСобытий);  
			МассивАлгоритмовСертификата = АлгоритмыСформированнойПодписи.Получить(OIDАлгоритмаПодписи);
			
			Если МассивАлгоритмовСертификата = Неопределено Тогда
				Продолжить;
				
			КонецЕсли;
			
			// Меняем алгоритм подписи на корректный
			Индекс = МассивАлгоритмовСертификата.Найти(АлгоритмПодписи);
			Если Индекс = Неопределено Тогда
				 АлгоритмПодписи = МассивАлгоритмовСертификата[0];
				
			КонецЕсли;
		КонецЕсли;
		
		ДвоичныйОтпечатокСертификата = Строка(Сертификат.Отпечаток);
		ДвоичныйОтпечатокСертификата = СтрЗаменить(ДвоичныйОтпечатокСертификата, " ", "");
        АлгоритмаПодписиСертификата = СписокСертификатов.Получить(ДвоичныйОтпечатокСертификата);
		МассивАлгоритмовСертификата = АлгоритмыПодписиСертификата.Получить(АлгоритмаПодписиСертификата);
		Если НЕ МассивАлгоритмовСертификата = Неопределено Тогда
			// Меняем алгоритм подписи на корректный
			Индекс = МассивАлгоритмовСертификата.Найти(АлгоритмПодписи);
			Если Индекс = Неопределено Тогда
				АлгоритмПодписи = МассивАлгоритмовСертификата[0];
				
			КонецЕсли;	
		КонецЕсли;
		
		СтруктураСертификата = ЭЦП_ЗаполнитьСтруктуруСертификата(Сертификат, АлгоритмПодписи, МассивЛогаСобытий); //есть реквизиты дата окончания, кому выдан и т.п.
        Если СтруктураСертификата = Неопределено Тогда
            Продолжить;
        КонецЕсли;
					 
        Сертификаты.Добавить(СтруктураСертификата);
	   
    КонецЦикла;
	      
КонецПроцедуры	

Функция ОбъектВнешнейКомпонентыXMLDSigПрямойСпособ(МассивЛогаСобытий) Экспорт
	
	ИмяСобытия = "Объект внешней компоненты XMLDSig";
	ОбъектКомпоненты = Неопределено;
	Если ПодключитьВнешнююКомпоненту("Справочник.ЭКОМ_Сертификаты.Макет.КомпонентаXMLDSIG", "XMLDSignAddInSymbolicName", ТипВнешнейКомпоненты.Native) Тогда
        Попытка
            ОбъектКомпоненты = Новый("AddIn.XMLDSignAddInSymbolicName.XMLDSignAddIn");
		Исключение
            ТекстЛогаСобытий = "Не удалось подключить внешнюю компоненту XMLDSig." + СокрЛП(ИнформацияОбОшибке());
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Ошибка"), ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

        КонецПопытки;        
    КонецЕсли;
	
	Если ОбъектКомпоненты = Неопределено Тогда 
		ТекстЛогаСобытий = "Оператор Новый вернул Неопределено";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Ошибка"), ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

	Иначе
		ОбъектКомпоненты.ПутьККриптопровайдеру = "";
	КонецЕсли;
	    
    Возврат ОбъектКомпоненты;
	
КонецФункции

Процедура ОбъектВнешнейКомпонентыXMLDSig(Контекст) Экспорт
	
	Оповещение = Новый ОписаниеОповещения("ПослеПодключения", ЭКОМ_ОбщегоНазначенияКлиент, Контекст);
	НачатьПодключениеВнешнейКомпоненты(Оповещение, "Справочник.ЭКОМ_Сертификаты.Макет.КомпонентаXMLDSIG", "XMLDSignAddInSymbolicName");
	
КонецПроцедуры

Процедура ПослеПодключения(Подключено, Контекст) Экспорт
	
	Если Подключено Тогда
        Попытка
            Контекст.ОбъектКомпоненты = Новый("AddIn.XMLDSignAddInSymbolicName.XMLDSignAddIn");
		Исключение		
			ТекстЛогаСобытий = "Не удалось подключить внешнюю компоненту XMLDSig." + СокрЛП(ИнформацияОбОшибке());
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Ошибка"), "Подлючение к компоненте");
			Контекст.МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		КонецПопытки;  
		
	ИначеЕсли Контекст.УстановитьЕслиНеПодключено Тогда
		Контекст.УстановитьЕслиНеПодключено = Ложь;//Docrobot 1.20.0 MOD-1918
        НачатьУстановкуВнешнейКомпоненты(Новый ОписаниеОповещения("ОбъектВнешнейКомпонентыXMLDSig", ЭКОМ_ОбщегоНазначенияКлиент, Контекст),
		"Справочник.ЭКОМ_Сертификаты.Макет.КомпонентаXMLDSIG");	
		
	КонецЕсли;
	
КонецПроцедуры

Функция ЭЦП_ЗаполнитьСтруктуруСертификата(Сертификат, АлгоритмПодписи, МассивЛогаСобытий, ПустойАлгоритмПодписиЕслиНетБиблиотеки = Истина) Экспорт
	
    КомуВыдан = ЭЦП_ПолучитьПредставлениеПользователяНаКлиенте(Сертификат.Субъект);
    КемВыдан  = ЭЦП_ПолучитьПредставлениеПользователяНаКлиенте(Сертификат.Издатель);
    ДействителенДо = Сертификат.ДатаОкончания;
     
    ОтпечатокСертификата = Base64Строка(Сертификат.Отпечаток);
 
	ЭЦП_ЗаменитьНедопустимыеСимволы(КомуВыдан);
    ЭЦП_ЗаменитьНедопустимыеСимволы(КемВыдан);

    ИНН = "";
	Сертификат.Субъект.Свойство("OID1_2_643_100_4", ИНН);
	Если ИНН = Неопределено Тогда
		Сертификат.Субъект.Свойство("OID1_2_643_3_131_1_1", ИНН);
	КонецЕсли;
	ИНН_Число = ЭКОМ_ПреобразоватьВЧислоОбщегоНазначения(ИНН); 
		
	ДолжностьПодписанта = "";
	Сертификат.Субъект.Свойство("T", ДолжностьПодписанта);
	
	ФамилияПодписанта = "";
	Сертификат.Субъект.Свойство("SN", ФамилияПодписанта);
	
	ИмяОтчествоПодписанта = "";
	Сертификат.Субъект.Свойство("OID2_5_4_42", ИмяОтчествоПодписанта);
	ПерваяПозиция      = Найти(ИмяОтчествоПодписанта, " "); 
    ИмяПодписанта      = Лев(ИмяОтчествоПодписанта, ПерваяПозиция - 1);
	ОтчествоПодписанта = Прав(ИмяОтчествоПодписанта, СтрДлина(ИмяОтчествоПодписанта) - ПерваяПозиция);
	
	ИмяСертификата = Формат(ДействителенДо,"ДФ=dd.MM.yyyy") + " " + КомуВыдан;
	
	ИНН_Строка = Формат(ИНН_Число, "ЧГ=0");
	ЭЦП_ЗаменитьНедопустимыеСимволы(ИНН_Строка);
	ЭЦП_ЗаменитьНедопустимыеСимволы(ДолжностьПодписанта);
	ЭЦП_ЗаменитьНедопустимыеСимволы(ФамилияПодписанта);
	ЭЦП_ЗаменитьНедопустимыеСимволы(ИмяПодписанта);
	ЭЦП_ЗаменитьНедопустимыеСимволы(ОтчествоПодписанта);
	ЭЦП_ЗаменитьНедопустимыеСимволы(ОтпечатокСертификата);
	ЭЦП_ЗаменитьНедопустимыеСимволы(ИмяСертификата);
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("КомуВыдан"              , КомуВыдан);
	СтруктураДанных.Вставить("КемВыдан"               , КемВыдан);
	СтруктураДанных.Вставить("ДействителенДо"         , ДействителенДо);
	СтруктураДанных.Вставить("ИНН"                    , ИНН_Строка);	
	СтруктураДанных.Вставить("ДолжностьПодписанта"     , ДолжностьПодписанта);
	СтруктураДанных.Вставить("ФамилияПодписанта"       , ФамилияПодписанта);
	СтруктураДанных.Вставить("ИмяПодписанта"           , ИмяПодписанта);
	СтруктураДанных.Вставить("ОтчествоПодписанта"      , ОтчествоПодписанта); 
	СтруктураДанных.Вставить("ОтпечатокСертификата"    , ОтпечатокСертификата);   
	СтруктураДанных.Вставить("ИмяСертификата"          , ИмяСертификата);
    
    ИздательСертификата = "";
    Если Сертификат.Издатель.Свойство("O", ИздательСертификата) = Ложь Тогда
        Сертификат.Издатель.Свойство("CN", ИздательСертификата);
    КонецЕсли;
    
    СтруктураДанных.Вставить("ИздательСертификата", ИздательСертификата);	    
    СтруктураДанных.Вставить("АлгоритмПодписи", АлгоритмПодписи);
    СтруктураДанных.Вставить("СертификатЭКОМ", Сертификат);
    СтруктураДанных.Вставить("СертификатОтпечаток", Сертификат.Отпечаток);
    
	Возврат СтруктураДанных;
КонецФункции

Функция ЭЦП_ПолучитьПредставлениеПользователяНаКлиенте(СтруктураПользователя) Экспорт
    
    Представление = "";
    CN = "";
    Если СтруктураПользователя.Свойство("CN", CN) Тогда
        Представление = Представление + CN;
    КонецЕсли;	
    O = "";
    Если СтруктураПользователя.Свойство("O", O) Тогда
        Представление = Представление + ", " + O;
    КонецЕсли;	
    OU = "";
    Если СтруктураПользователя.Свойство("OU", OU) Тогда
        Представление = Представление + ", " + OU;
    КонецЕсли;	
    
    Возврат Представление;
    
КонецФункции

Функция ИдентификаторыАлгоритмовПодписи(ТолькоАлгоритмыОткрытогоКлюча)
	
	ИдентификаторыАлгоритмов = Новый Соответствие;
	
	ИдентификаторыАлгоритмов.Вставить("1.2.643.2.2.20",    ИменаАлгоритмовПодписиГОСТ_34_10_94());
	ИдентификаторыАлгоритмов.Вставить("1.2.643.2.2.19",    ИменаАлгоритмовПодписиГОСТ_34_10_2001());
	ИдентификаторыАлгоритмов.Вставить("1.2.643.7.1.1.1.1", ИменаАлгоритмовПодписиГОСТ_34_10_2012_256());
	ИдентификаторыАлгоритмов.Вставить("1.2.643.7.1.1.1.2", ИменаАлгоритмовПодписиГОСТ_34_10_2012_512());
	ИдентификаторыАлгоритмов.Вставить("1.2.840.113549.1.1.1", ИменаАлгоритмовПодписиRSA_SIGN()); // RSAEncryption.
	
	Если Не ТолькоАлгоритмыОткрытогоКлюча Тогда
		ИдентификаторыАлгоритмов.Вставить("1.2.643.2.2.4",     ИменаАлгоритмовПодписиГОСТ_34_10_94());
		ИдентификаторыАлгоритмов.Вставить("1.2.643.2.2.3",     ИменаАлгоритмовПодписиГОСТ_34_10_2001());
		ИдентификаторыАлгоритмов.Вставить("1.2.643.7.1.1.3.2", ИменаАлгоритмовПодписиГОСТ_34_10_2012_256());
		ИдентификаторыАлгоритмов.Вставить("1.2.643.7.1.1.3.3", ИменаАлгоритмовПодписиГОСТ_34_10_2012_512());
		ИдентификаторыАлгоритмов.Вставить("1.2.840.113549.1.1.2", ИменаАлгоритмовПодписиRSA_SIGN()); // md2WithRSAEncryption.
		ИдентификаторыАлгоритмов.Вставить("1.2.840.113549.1.1.3", ИменаАлгоритмовПодписиRSA_SIGN()); // md4withRSAEncryption.
		ИдентификаторыАлгоритмов.Вставить("1.2.840.113549.1.1.4", ИменаАлгоритмовПодписиRSA_SIGN()); // md5WithRSAEncryption.
		ИдентификаторыАлгоритмов.Вставить("1.2.840.113549.1.1.5", ИменаАлгоритмовПодписиRSA_SIGN()); // sha1WithRSAEncryption.
	КонецЕсли;
	
	Возврат ИдентификаторыАлгоритмов;
	
КонецФункции

