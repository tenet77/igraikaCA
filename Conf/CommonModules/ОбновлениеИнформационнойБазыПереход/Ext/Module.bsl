		Если Не ЕстьОшибкаБлокировки Тогда
			
			ЗаписьНабора = НаборЗаписей.Добавить();
			ЗаполнитьЗначенияСвойств(ЗаписьНабора, Запись);
			
			Если Индекс = ИндексовОстатков Тогда
