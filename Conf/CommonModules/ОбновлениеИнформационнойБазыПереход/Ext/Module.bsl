			ИЛИ Константы.ИспользоватьУправлениеПроизводством2_2.Получить()) Тогда
			
		Константы.ИспользоватьСтатусыЗаказовПереработчикам.Установить(Истина);
		
	КонецЕсли;
 	
	Параметры.ОбработкаЗавершена = Истина;
	
