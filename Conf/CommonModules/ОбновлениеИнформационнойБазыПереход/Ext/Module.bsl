	#Область ТекстЗапроса
	Запрос.Текст=
	"ВЫБРАТЬ
	|	УдаляемыйРегистр.Организация,
	|	УдаляемыйРегистр.Подразделение,
	|	УдаляемыйРегистр.Подразделение КАК МестоПроизводства,
	|	УдаляемыйРегистр.СтатьяРасходов,
	|	УдаляемыйРегистр.СчетУчета
	|ИЗ
	|	РегистрСведений.ПорядокОтраженияРасходов КАК УдаляемыйРегистр
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТИзмеренийРегистра КАК ВТИзмеренийРегистра
	|		ПО УдаляемыйРегистр.Организация = ВТИзмеренийРегистра.Организация
	|			И УдаляемыйРегистр.Подразделение = ВТИзмеренийРегистра.Подразделение
	|			И УдаляемыйРегистр.СтатьяРасходов = ВТИзмеренийРегистра.СтатьяРасходов";
	#КонецОбласти
	
	Результат = ОбновлениеИнформационнойБазы.СоздатьВременнуюТаблицуИзмеренийНезависимогоРегистраСведенийДляОбработки(
		Параметры.Очередь, ПолноеИмяРегистра, Запрос.МенеджерВременныхТаблиц, ДополнительныеПараметрыВыборкиДанныхДляОбработки);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВТИзмеренийРегистра", Результат.ИмяВременнойТаблицы);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		Попытка
			
			Блокировка = Новый БлокировкаДанных;
			
			ЭлементБлокировкиПорядокОтраженияРасходов = Блокировка.Добавить(ПолноеИмяРегистра);
			ЭлементБлокировкиПорядокОтраженияРасходов.Режим = РежимБлокировкиДанных.Исключительный;
			ЭлементБлокировкиПорядокОтраженияРасходов.УстановитьЗначение("Организация", Выборка.Организация);
			ЭлементБлокировкиПорядокОтраженияРасходов.УстановитьЗначение("Подразделение", Выборка.Подразделение);
			ЭлементБлокировкиПорядокОтраженияРасходов.УстановитьЗначение("СтатьяРасходов", Выборка.СтатьяРасходов);
			
			ЭлементБлокировкиПорядокОтраженияПроизводства = Блокировка.Добавить("РегистрСведений.ПорядокОтраженияПроизводства");
			ЭлементБлокировкиПорядокОтраженияПроизводства.Режим = РежимБлокировкиДанных.Исключительный;
			ЭлементБлокировкиПорядокОтраженияПроизводства.УстановитьЗначение("Организация", Выборка.Организация);
			ЭлементБлокировкиПорядокОтраженияПроизводства.УстановитьЗначение("МестоПроизводства", Выборка.МестоПроизводства);

			Блокировка.Заблокировать();
			
			НаборЗаписейПорядокОтраженияПроизводства = РегистрыСведений.ПорядокОтраженияПроизводства.СоздатьНаборЗаписей();
			НаборЗаписейПорядокОтраженияПроизводства.Отбор.Организация.Установить(Выборка.Организация);
			НаборЗаписейПорядокОтраженияПроизводства.Отбор.МестоПроизводства.Установить(Выборка.МестоПроизводства);
			СтрокаПорядокОтраженияПроизводства = НаборЗаписейПорядокОтраженияПроизводства.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаПорядокОтраженияПроизводства, Выборка);
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписейПорядокОтраженияПроизводства);
			
			НаборЗаписейПорядокОтраженияРасходов = РегистрыСведений.ПорядокОтраженияРасходов.СоздатьНаборЗаписей();
			НаборЗаписейПорядокОтраженияРасходов.Отбор.Организация.Установить(Выборка.Организация);
			НаборЗаписейПорядокОтраженияРасходов.Отбор.Подразделение.Установить(Выборка.Подразделение);
			НаборЗаписейПорядокОтраженияРасходов.Отбор.СтатьяРасходов.Установить(Выборка.СтатьяРасходов);
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписейПорядокОтраженияРасходов);
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось записать данные в регистр %ИмяРегистра%, по организации %Организация% и месту производства %МестоПроизводства%, по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Организация%", Выборка.Организация);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%МестоПроизводства%", Выборка.МестоПроизводства);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ИмяРегистра%", "РегистрСведений.ПорядокОтраженияПроизводства");
			
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), УровеньЖурналаРегистрации.Предупреждение,
				МетаданныеРегистра, , ТекстСообщения);
			
		КонецПопытки;
			
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь, ПолноеИмяРегистра);
	
КонецПроцедуры

Процедура Документы_НачислениеДивидендов_ЗарегистироватьДанныеКОбработкеДляПереходаНаНовуюВерсию_2_2_3_50(Параметры) Экспорт
	
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	НачислениеДивидендовЮридическиеЛица.Ссылка
		|ИЗ
		|	Документ.НачислениеДивидендов.ЮридическиеЛица КАК НачислениеДивидендовЮридическиеЛица
		|ГДЕ
		|	НЕ НачислениеДивидендовЮридическиеЛица.УдалитьСтавкаНалогаНаПрибыль = ЗНАЧЕНИЕ(Перечисление.НДФЛСтавки.ПустаяСсылка)
		|	И НачислениеДивидендовЮридическиеЛица.СтавкаНалогаНаПрибыль = 0";
		
	Запрос = Новый Запрос(ТекстЗапроса);
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецПроцедуры

Процедура Документы_НачислениеДивидендов_ОбработатьДанныеДляПереходаНаНовуюВерсию_2_2_3_50(Параметры) Экспорт
	
	Ставки = Новый Соответствие();
	Ставки.Вставить(Перечисления.НДФЛСтавки.ПустаяСсылка(), 0);
	Ставки.Вставить(Перечисления.НДФЛСтавки.Ставка13, 13);
	Ставки.Вставить(Перечисления.НДФЛСтавки.Ставка15, 15);
	
	ПолноеИмя = "Документ.НачислениеДивидендов";
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь,ПолноеИмя);
	Пока Выборка.Следующий() Цикл
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить(ПолноеИмя);
		ЭлементБлокировки.УстановитьЗначение("Ссылка", Выборка.Ссылка);
		НачатьТранзакцию();
		
		Попытка
			Блокировка.Заблокировать();
		Исключение
			
			ОтменитьТранзакцию();
			ОбновлениеИнформационнойБазыУТ.СообщитьОНеудачнойБлокировке(Выборка.Ссылка);
			Продолжить;
			
		КонецПопытки;
		
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			
			ОтменитьТранзакцию();
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			Продолжить;
			
		КонецЕсли;
		
		ЕстьИзменения = Ложь;
		Для Каждого СтрокаДивидендов Из Объект.ЮридическиеЛица Цикл
			Если Не СтрокаДивидендов.УдалитьСтавкаНалогаНаПрибыль = Перечисления.НДФЛСтавки.ПустаяСсылка()
				И СтрокаДивидендов.СтавкаНалогаНаПрибыль = 0 Тогда
				
				СтрокаДивидендов.СтавкаНалогаНаПрибыль = Ставки[СтрокаДивидендов.УдалитьСтавкаНалогаНаПрибыль];
				ЕстьИзменения = Истина;
				
			КонецЕсли;
		КонецЦикла;
		
		Попытка
			
			Если ЕстьИзменения Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
			Иначе
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			ОбновлениеИнформационнойБазыУТ.СообщитьОНеудачнойОбработке(Выборка.Ссылка);
			
		КонецПопытки;
		
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмя);
	
КонецПроцедуры

