// Регистрирует данные для обработчика обновления УТ 11.3.3:
// заполняет реквизит табличной части "Товары" "КоличествоОприходование".
//
Процедура Документы_ОрдерНаОтражениеПорчиТоваров_ОбработатьДанныеДляПереходаНаНовуюВерсию_11_3_3_91(Параметры) Экспорт

	ПолноеИмяОбъекта = "Документ.ОрдерНаОтражениеПорчиТоваров";
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ПараметрыОбработки      = ОбновлениеИнформационнойБазы.СоздатьВременнуюТаблицуСсылокДляОбработки(
		Параметры.Очередь, ПолноеИмяОбъекта, МенеджерВременныхТаблиц);
	
	Параметры.ОбработкаЗавершена = Не ПараметрыОбработки.ЕстьДанныеДляОбработки;
	
	Если Не ПараметрыОбработки.ЕстьДанныеДляОбработки Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПараметрыОбработки.ЕстьЗаписиВоВременнойТаблице Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	СсылкиДляОбработки.Ссылка
	|ИЗ
	|	&ВТДляОбработкиСсылка КАК СсылкиДляОбработки
	|;
	|
	|//////////////////////////////////////////////////////////////////////////////// 1
	|ВЫБРАТЬ
	|	ТоварыОрдера.Ссылка      КАК Ссылка,
	|	ТоварыОрдера.НомерСтроки КАК НомерСтроки,
	|	ВЫБОР
	|		КОГДА ТоварыОрдера.УпаковкаОприходование = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	|			ТОГДА ТоварыОрдера.Количество * ЕСТЬNULL(&ТекстЗапросаКоэффициентУпаковки, 1)
	|		ИНАЧЕ ТоварыОрдера.КоличествоУпаковок * ЕСТЬNULL(&ТекстЗапросаКоэффициентУпаковки, 1)
	|	КОНЕЦ                    КАК КоличествоОприходование
	|ИЗ
	|	&ВТДляОбработкиСсылка КАК СсылкиДляОбработки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОрдерНаОтражениеПорчиТоваров.Товары КАК ТоварыОрдера
	|		ПО СсылкиДляОбработки.Ссылка = ТоварыОрдера.Ссылка
	|ГДЕ
	|	ТоварыОрдера.Количество <> 0
	|	И ТоварыОрдера.КоличествоОприходование = 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТоварыОрдера.Ссылка,
	|	ТоварыОрдера.НомерСтроки";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВТДляОбработкиСсылка", ПараметрыОбработки.ИмяВременнойТаблицы);
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаКоэффициентУпаковки",
		Справочники.УпаковкиЕдиницыИзмерения.ТекстЗапросаКоэффициентаУпаковки(
			"ТоварыОрдера.УпаковкаОприходование",
			"ТоварыОрдера.НоменклатураОприходование"));
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
