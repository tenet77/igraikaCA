			// Перерасчет движений
			НаборЗаписей = РегистрыНакопления.ДвижениеТоваров.РассчитатьИтогиРегистраОстаткиТоваровПоГрафикуДляОбновленияИБ(Выборка.Регистратор);
			
			// Запись.
			Если ГрафикПоступленияТоваров_ЕстьИзмененияВНаборе_11_3_3_209(Выборка, НаборЗаписей) Тогда
				Попытка
					ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
					ЗафиксироватьТранзакцию();
				Исключение
					ОтменитьТранзакцию();
					
					ТекстСообщения = НСтр("ru = 'Не удалось обработать документ: %Регистратор% по причине: %Причина%'");
