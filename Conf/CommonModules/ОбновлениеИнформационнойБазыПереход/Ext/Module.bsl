Процедура Документы_СписаниеБезналичныхДенежныхСредств_ОбработатьДанныеДляПереходаНаНовуюВерсию_11_3_3_87(Параметры) Экспорт
	
	ПолноеИмяОбъекта = "Документ.СписаниеБезналичныхДенежныхСредств";
	МетаданныеОбъекта = Метаданные.Документы.СписаниеБезналичныхДенежныхСредств;
	
	МВТ = Новый МенеджерВременныхТаблиц;
	
	ПараметрыВыборкиДляОбработки = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыВыборкиДанныхДляОбработки();
	ПараметрыВыборкиДляОбработки.ИмяВременнойТаблицы = "втСсылокДляОбработки";
	Результат = ОбновлениеИнформационнойБазы.СоздатьВременнуюТаблицуСсылокДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта, МВТ, ПараметрыВыборкиДляОбработки);
	Если Не Результат.ЕстьДанныеДляОбработки Тогда
		Параметры.ОбработкаЗавершена = Истина;
		Возврат;
	КонецЕсли;
	
	Если Не Результат.ЕстьЗаписиВоВременнойТаблице Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	#Область ТекстЗапроса
	Запрос.Текст=
	"ВЫБРАТЬ
	|	втСсылокДляОбработки.Ссылка КАК Ссылка,
	|	Операция.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	|	ВЫБОР
	|		КОГДА Операция.ХозяйственнаяОперация <> ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПрочаяВыдачаДенежныхСредств)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ТребуетсяЗаполнениеНДС,
	|	ВЫБОР
	|		КОГДА Операция.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПрочаяВыдачаДенежныхСредств)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ТребуетсяЗаполнениеНаправленийДеятельности
	|ИЗ
	|	Документ.СписаниеБезналичныхДенежныхСредств КАК Операция
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втСсылокДляОбработки КАК втСсылокДляОбработки
	|		ПО Операция.Ссылка = втСсылокДляОбработки.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабличнаяЧасть.Ссылка КАК Ссылка,
	|	ТабличнаяЧасть.НомерСтроки - 1 КАК ИндексСтроки,
	|	ТабличнаяЧасть.АналитикаАктивовПассивов КАК НаправлениеДеятельности,
	|	ЗНАЧЕНИЕ(Перечисление.СтатьиБезАналитики.ПустаяСсылка) КАК АналитикаАктивовПассивов
	|ИЗ
	|	Документ.СписаниеБезналичныхДенежныхСредств КАК Операция
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СписаниеБезналичныхДенежныхСредств.РасшифровкаПлатежа КАК ТабличнаяЧасть
	|		ПО Операция.Ссылка = ТабличнаяЧасть.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втСсылокДляОбработки КАК втСсылокДляОбработки
	|		ПО Операция.Ссылка = втСсылокДляОбработки.Ссылка
	|ГДЕ
	|	Операция.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПрочаяВыдачаДенежныхСредств)
	|	И ТабличнаяЧасть.СтатьяРасходов = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.ЦелевоеФинансирование)
	|	И ТабличнаяЧасть.НаправлениеДеятельности = ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)
	|	И ТабличнаяЧасть.АналитикаАктивовПассивов ССЫЛКА Справочник.НаправленияДеятельности
	|	И ТабличнаяЧасть.АналитикаАктивовПассивов <> ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)";
	#КонецОбласти
	
	Пакет = Запрос.ВыполнитьПакет();
	
	Выборка = Пакет[Пакет.Количество()-2].Выбрать();
	ВыборкаСтрок = Пакет[Пакет.Количество()-1].Выбрать();
	СтруктураПоискаСтрок = Новый Структура("Ссылка", Неопределено);
	
	ОбработаноОбъектов = 0;
	ПроблемныхОбъектов = 0;
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		Попытка
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить(ПолноеИмяОбъекта);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			ЭлементБлокировки.УстановитьЗначение("Ссылка", Выборка.Ссылка);
			Блокировка.Заблокировать();
		Исключение
			ОтменитьТранзакцию();
			ТекстСообщения = НСтр("ru = 'Не удалось заблокировать документ: %1 по причине: %2'");
			ТекстСообщения = СтрШаблон(ТекстСообщения, Выборка.Ссылка, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				МетаданныеОбъекта,
				Выборка.Ссылка,
				ТекстСообщения);
			Продолжить;
		КонецПопытки;
		
		ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
		
		Если Выборка.ТребуетсяЗаполнениеНДС Тогда
			
			Платежи = ДокументОбъект.РасшифровкаПлатежа.Выгрузить();
			ТаблицаНДС = ДенежныеСредстваСервер.РасшифровкаПлатежаНДС(
				ДокументОбъект.Дата, ДокументОбъект.Валюта, Платежи.ВыгрузитьКолонку("Заказ"), Ложь);
			
			ДенежныеСредстваСервер.ЗаполнитьНДСВРасшифровке(Платежи, ТаблицаНДС);
			
			ДокументОбъект.РасшифровкаПлатежа.Загрузить(Платежи);
			
		КонецЕсли;

		Если ДокументОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеречислениеВБюджет
			И Не ЗначениеЗаполнено(ДокументОбъект.ТипНалога) Тогда
			
			НеобходимаЗаменаХозОперации = Ложь;
			
			ТаблицаРасшифровки = ДокументОбъект.РасшифровкаПлатежа.Выгрузить();
			
			ТаблицаРасшифровки.Свернуть("СтатьяРасходов, АналитикаАктивовПассивов, СчетУчета","Сумма");
			Если ТаблицаРасшифровки.Количество() = 1 Тогда
			
				//Заполнять будем по первой строке
				СтрокаРасшифровки = ДокументОбъект.РасшифровкаПлатежа[0];
				
				ТипНалогаОпределен = Ложь;
				
				//Пробуем заполнить ТипНалога по аналитике активов/пассивов
				Если ТипЗнч(СтрокаРасшифровки.АналитикаАктивовПассивов) = Тип("ПеречислениеСсылка.ТипыНалогов") и ЗначениеЗаполнено(СтрокаРасшифровки.АналитикаАктивовПассивов) Тогда
				    ДокументОбъект.ТипНалога = СтрокаРасшифровки.АналитикаАктивовПассивов;
					
					ТипНалогаОпределен = Истина;
				КонецЕсли; 
				
				//++ НЕ УТ
				//Пробуем заполнить ТипНалога по счету учета
				Если Не ЗначениеЗаполнено(ДокументОбъект.ТипНалога) и ЗначениеЗаполнено(СтрокаРасшифровки.СчетУчета) Тогда
				    ДокументОбъект.ТипНалога = Перечисления.ТипыНалогов.ТипНалогаПоСчетуУчета(СтрокаРасшифровки.СчетУчета);
					
					ТипНалогаОпределен = Истина;
				КонецЕсли;
				//-- НЕ УТ
				
				Если ТипНалогаОпределен Тогда
					//++ НЕ УТ
					ДокументОбъект.СчетУчета = СтрокаРасшифровки.СчетУчета;
					
					ДокументОбъект.Субконто1 = СтрокаРасшифровки.Субконто1;
					ДокументОбъект.Субконто2 = СтрокаРасшифровки.Субконто2;
					ДокументОбъект.Субконто3 = СтрокаРасшифровки.Субконто3;
					//-- НЕ УТ
					
					//В строках расшифровки очистим поля СтатьяРасходов, АналитикаАктивовПассивов, СчетУчета т.к. они заполнены в шапке
					Для Каждого ТекСтрокаРасшифровки Из ДокументОбъект.РасшифровкаПлатежа Цикл
					    ТекСтрокаРасшифровки.СтатьяРасходов = Неопределено;
					    ТекСтрокаРасшифровки.АналитикаАктивовПассивов = Неопределено;
						//++ НЕ УТ
					    ТекСтрокаРасшифровки.СчетУчета = ПланыСчетов.Хозрасчетный.ПустаяСсылка();
						//-- НЕ УТ
					КонецЦикла; 
				Иначе
					НеобходимаЗаменаХозОперации = Истина;
				КонецЕсли; 
			Иначе	
				НеобходимаЗаменаХозОперации = Истина;
			КонецЕсли; 
			
			Если НеобходимаЗаменаХозОперации Тогда
			    ДокументОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПрочаяВыдачаДенежныхСредств;
				
				//В строках расшифровки заполним поле Подразделение из шапке
				Для Каждого ТекСтрокаРасшифровки Из ДокументОбъект.РасшифровкаПлатежа Цикл
					ТекСтрокаРасшифровки.Подразделение = ДокументОбъект.Подразделение;
					
					Если ТекСтрокаРасшифровки.СтатьяРасходов = Неопределено Тогда
					    ТекСтрокаРасшифровки.СтатьяРасходов = ПланыВидовХарактеристик.СтатьиАктивовПассивов.Налоги;
					КонецЕсли; 
				КонецЦикла;
			КонецЕсли; 
			
		//++ НЕ УТ
		ИначеЕсли ДокументОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВыплатаЗарплатыНаЛицевыеСчета 
		 или ДокументОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВыплатаЗарплатыПоЗарплатномуПроекту Тогда
			
			//Перенос ведомостей в ТЧ Расшифровка платежа
			Если ДокументОбъект.УдалитьВедомостиНаВыплатуЗарплаты.Количество() Тогда
				
				Для Каждого ТекСтрокаВедомости Из ДокументОбъект.УдалитьВедомостиНаВыплатуЗарплаты Цикл
					
					НовСтрокаРасшифровки = ДокументОбъект.РасшифровкаПлатежа.Добавить();
					
					НовСтрокаРасшифровки.Ведомость = ТекСтрокаВедомости.Ведомость;
					НовСтрокаРасшифровки.Сумма = ТекСтрокаВедомости.Сумма;
					НовСтрокаРасшифровки.СтатьяДвиженияДенежныхСредств = ДокументОбъект.СтатьяДвиженияДенежныхСредств;
					
					//Перенос заявки в ТЧ Расшифровка платежа
					Если ЗначениеЗаполнено(ДокументОбъект.ЗаявкаНаРасходованиеДенежныхСредств) Тогда
						НовСтрокаРасшифровки.ЗаявкаНаРасходованиеДенежныхСредств = ДокументОбъект.ЗаявкаНаРасходованиеДенежныхСредств;
