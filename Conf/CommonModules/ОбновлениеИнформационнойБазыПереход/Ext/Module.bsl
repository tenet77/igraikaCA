Процедура Документы_РасходныйОрдерНаТовары_ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию_2_2_2_16(Параметры) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Ссылка
	|ИЗ
	|	Документ.РасходныйОрдерНаТовары.ТоварыПоРаспоряжениям КАК РасходныйОрдерНаТоварыТоварыПоРаспоряжениям
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПередачаСырьяПереработчику КАК ПередачаСырьяПереработчику
	|		ПО РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Распоряжение = ПередачаСырьяПереработчику.Ссылка
	|ГДЕ
	|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Распоряжение ССЫЛКА Документ.ПередачаСырьяПереработчику
	|	И ПередачаСырьяПереработчику.ПередачаПоЗаказам";
	СписокСсылок = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, СписокСсылок);
	
КонецПроцедуры

Процедура Документы_РасходныйОрдерНаТовары_ОбработатьДанныеДляПереходаНаНовуюВерсию_2_2_2_16(Параметры) Экспорт

	ПолноеИмяОбъекта = "Документ.РасходныйОрдерНаТовары";
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ПараметрыОбработки = ОбновлениеИнформационнойБазы.СоздатьВременнуюТаблицуСсылокДляОбработки(
							Параметры.Очередь, ПолноеИмяОбъекта, МенеджерВременныхТаблиц);
	
	Параметры.ОбработкаЗавершена = НЕ ПараметрыОбработки.ЕстьДанныеДляОбработки;
	Если НЕ ПараметрыОбработки.ЕстьДанныеДляОбработки Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ПараметрыОбработки.ЕстьЗаписиВоВременнойТаблице Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = 
 	"ВЫБРАТЬ
 	|	СсылкиДляОбработки.Ссылка
 	|ИЗ
 	|	&ВТДляОбработкиСсылка КАК СсылкиДляОбработки
 	|;
 	|
 	|////////////////////////////////////////////////////////////////////////////////
 	|ВЫБРАТЬ
 	|	СсылкиДляОбработки.Ссылка КАК Ссылка,
 	|	РасходныйОрдерТовары.Распоряжение КАК Распоряжение,
 	|	МАКСИМУМ(ПередачаСырьяТовары.ЗаказПереработчику) КАК ЗаказПереработчику
 	|ИЗ
 	|	&ВТДляОбработкиСсылка КАК СсылкиДляОбработки
 	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РасходныйОрдерНаТовары.ТоварыПоРаспоряжениям КАК РасходныйОрдерТовары
 	|		ПО (РасходныйОрдерТовары.Ссылка = СсылкиДляОбработки.Ссылка)
 	|			И (РасходныйОрдерТовары.Распоряжение ССЫЛКА Документ.ПередачаСырьяПереработчику)
 	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПередачаСырьяПереработчику КАК ПередачаСырья
 	|		ПО (ПередачаСырья.Ссылка = РасходныйОрдерТовары.Распоряжение)
 	|			И (ПередачаСырья.ПередачаПоЗаказам)
 	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПередачаСырьяПереработчику.Товары КАК ПередачаСырьяТовары
 	|		ПО (ПередачаСырьяТовары.Ссылка = ПередачаСырья.Ссылка)
 	|			И (ПередачаСырьяТовары.ЗаказПереработчику <> ЗНАЧЕНИЕ(Документ.ЗаказПереработчику.ПустаяСсылка))
 	|
 	|СГРУППИРОВАТЬ ПО
 	|	СсылкиДляОбработки.Ссылка,
 	|	РасходныйОрдерТовары.Распоряжение";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВТДляОбработкиСсылка", ПараметрыОбработки.ИмяВременнойТаблицы);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Результат = Запрос.ВыполнитьПакет();
	
	ТаблицаЗаказы = Результат[1].Выгрузить();
	ТаблицаЗаказы.Индексы.Добавить("Ссылка,Распоряжение");
	
	Выборка = Результат[0].Выбрать();
	
 	Пока Выборка.Следующий() Цикл
 		
 		НачатьТранзакцию();
		
 		Попытка
			
 			Блокировка = Новый БлокировкаДанных;
 			ЭлементБлокировки = Блокировка.Добавить("Документ.РасходныйОрдерНаТовары");
 			ЭлементБлокировки.УстановитьЗначение("Ссылка", Выборка.Ссылка);
 			Блокировка.Заблокировать();
 			
 			ДанныеОбъекта = Выборка.Ссылка.ПолучитьОбъект();
 			
			Если ДанныеОбъекта = Неопределено Тогда
 				ОтменитьТранзакцию();
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
 				Продолжить;
 			КонецЕсли;
			
			Для каждого СтрокаТовары Из ДанныеОбъекта.ТоварыПоРаспоряжениям Цикл
				Если ЗначениеЗаполнено(СтрокаТовары.Распоряжение)
					И ТипЗнч(СтрокаТовары.Распоряжение) = Тип("ДокументСсылка.ПередачаСырьяПереработчику") Тогда
					
					СтруктураПоиска = Новый Структура("Ссылка,Распоряжение", Выборка.Ссылка, СтрокаТовары.Распоряжение);
		   			СписокСтрок = ТаблицаЗаказы.НайтиСтроки(СтруктураПоиска);
					Если СписокСтрок.Количество() <> 0 Тогда
						СтрокаТовары.Распоряжение = СписокСтрок[0].ЗаказПереработчику;
					КонецЕсли; 
				КонецЕсли; 
			КонецЦикла; 
			
 			ОбновлениеИнформационнойБазы.ЗаписатьДанные(ДанныеОбъекта);
	
			ЗафиксироватьТранзакцию();
			
 		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось обработать объект: %Ссылка% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Ссылка%", Выборка.Ссылка);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
									УровеньЖурналаРегистрации.Предупреждение,
									Выборка.Ссылка.Метаданные(),
									Выборка.Ссылка,
									ТекстСообщения);
									
 		КонецПопытки;
 
 	КонецЦикла;
 		
	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры
