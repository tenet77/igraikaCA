//
Процедура Документы_ВыпускПродукции_ОбработатьДанныеДляПереходаНаНовуюВерсию_2_2_3_216(Параметры) Экспорт
	
	ПолноеИмяДокумента = "Документ.ВыпускПродукции";
	МетаданныеДокумента = Метаданные.Документы.ВыпускПродукции;
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ДополнительныеПарметрыВыборкиДокументовВыпуска = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыВыборкиДанныхДляОбработки();
	ДополнительныеПарметрыВыборкиДокументовВыпуска.ИмяВременнойТаблицы = "ВТДокументыВыпускаДляОбработки";
	ДополнительныеПарметрыВыборкиДокументовВыпуска.ДополнительныеИсточникиДанных.Вставить("Товары.Назначение");
	
	
	Результат = ОбновлениеИнформационнойБазы.СоздатьВременнуюТаблицуСсылокДляОбработки(
		Параметры.Очередь,
		ПолноеИмяДокумента,
		МенеджерВременныхТаблиц,
		ДополнительныеПарметрыВыборкиДокументовВыпуска);
	
	Если НЕ Результат.ЕстьДанныеДляОбработки Тогда
		Параметры.ОбработкаЗавершена = Истина;
		Возврат;
	КонецЕсли;
	Если НЕ Результат.ЕстьЗаписиВоВременнойТаблице Тогда
		Параметры.ОбработкаЗавершена = Ложь;
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	КОбработке.Ссылка КАК Ссылка,
		|	ДокументВыпуска.ВерсияДанных КАК СсылкаВерсия
		|ИЗ
		|	ВТДокументыВыпускаДляОбработки КАК КОбработке
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВыпускПродукции КАК ДокументВыпуска
		|		ПО ДокументВыпуска.Ссылка = КОбработке.Ссылка";
		
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ПустойКлючСвязи", Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	
	Пока Выборка.Следующий() Цикл
		
		ВерсияДокумента = Выборка.СсылкаВерсия;
		
		НачатьТранзакцию();
		
		// Установка управляемой блокировки данных.
		Попытка
			
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить(ПолноеИмяДокумента);
			ЭлементБлокировки.УстановитьЗначение("Ссылка", Выборка.Ссылка);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			
			
			Блокировка.Заблокировать();
			
		Исключение
			
			// Пропуск обработки объекта.
			ОтменитьТранзакцию();
			Продолжить;
			
		КонецПопытки;
		
		// Чтение объекта.
		ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
		Если ДокОбъект = Неопределено Тогда
		
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			ЗафиксироватьТранзакцию();
			Продолжить;
			
		КонецЕсли;
		
		// Проверка версий читаемых данных.
		Если ДокОбъект.ВерсияДанных <> ВерсияДокумента Тогда
			
			ОтменитьТранзакцию();
			Продолжить;
			
		КонецЕсли;
		
		
		// Обработка данных.
		Попытка
			
			ПараметрыЗаполненияКлючей = РегистрыСведений.АналитикаУчетаНоменклатуры.ПараметрыЗаполненияКлючейАналитики();
			МестаУчета = РегистрыСведений.АналитикаУчетаНоменклатуры.МестаУчета(
				Перечисления.ХозяйственныеОперации.ВыпускПродукции,
				ДокОбъект.Склад,
				ДокОбъект.Подразделение,
				Неопределено);
			
			ИменаПолей = РегистрыСведений.АналитикаУчетаНоменклатуры.ИменаПолейКоллекцииПоУмолчанию();
			
			Если ДокОбъект.НаправлениеВыпуска = Перечисления.ХозяйственныеОперации.ВыпускПродукцииНаСклад Тогда
				ИменаПолей.Вставить("Произвольный", "Склад");
			Иначе
				ИменаПолей.Вставить("Произвольный", "Подразделение");
				ИменаПолей.Вставить("Работа", "Подразделение");
			КонецЕсли;
			
			РегистрыСведений.АналитикаУчетаНоменклатуры.ЗаполнитьВКоллекции(
				ДокОбъект.Товары,
				МестаУчета,
				ИменаПолей,
				Ложь,
				ПараметрыЗаполненияКлючей);
			
			ИзмененРеквизитПередатьДавальцу = Ложь;
			
			
			Если ПараметрыЗаполненияКлючей.ИзмененаАналитика Или ИзмененРеквизитПередатьДавальцу Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокОбъект);
