		НаборЗаписей = РегистрыСведений.ПорядокОтраженияРасходов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Организация.Установить(Выборка.Организация); 
		НаборЗаписей.Отбор.Подразделение.Установить(Выборка.Подразделение); 
		НаборЗаписей.Отбор.СтатьяРасходов.Установить(Выборка.СтатьяРасходов); 
		НаборЗаписей.Отбор.Документ.Установить(Выборка.Документ); 
		
		Запись = НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(Запись, Выборка, , "СчетСписанияОСНО, СчетСписанияЕНВД");
		Запись.СчетСписанияЕНВД = Выборка.СчетУчета;
		Запись.СчетСписанияОСНО = Выборка.СчетУчета;
		ОбновлениеИнформационнойБазы.ЗаписатьДанные(НаборЗаписей);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьНовыеРеквизитыКА()
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаДляЗаполненияНовыхРеквизитов();
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
			
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Объект.ВидДеятельностиРасходов = Выборка.ВидДеятельностиРасходов;
		Объект.ВидДеятельностиДляНалоговогоУчетаЗатрат = Выборка.ВидДеятельностиДляНалоговогоУчетаЗатрат;
		Объект.ПравилоРаспределенияНаСебестоимость = Выборка.ПравилоРаспределенияНаСебестоимость;
		
		Если ЗначениеЗаполнено(Выборка.СчетСписанияОСНО) Тогда
			Объект.СчетСписанияОСНО = Выборка.СчетСписанияОСНО;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.СчетСписанияЕНВД) Тогда
			Объект.СчетСписанияЕНВД = Выборка.СчетСписанияЕНВД;
		КонецЕсли;
		
		ОбновлениеИнформационнойБазы.ЗаписатьДанные(Объект);
		
	КонецЦикла;
	
КонецПроцедуры

