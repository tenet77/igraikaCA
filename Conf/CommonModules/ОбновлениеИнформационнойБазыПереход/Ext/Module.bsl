			Если КлючИЗначение.Значение <> ВтораяСтруктура[КлючИЗначение.Ключ] Тогда
				Возврат Ложь;
			КонецЕсли;
		Иначе
			Возврат Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
