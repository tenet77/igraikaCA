Процедура Документы_ПринятиеКУчетуНМА_ОбработатьДанныеДляПереходаНаНовуюВерсию_2_2_3_13(Параметры) Экспорт

	ПолноеИмяОбъекта = "Документ.ПринятиеКУчетуНМА";
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ПараметрыДляОбработки = ОбновлениеИнформационнойБазы.СоздатьВременнуюТаблицуСсылокДляОбработки(
								Параметры.Очередь, ПолноеИмяОбъекта, МенеджерВременныхТаблиц);
								
	Если НЕ ПараметрыДляОбработки.ЕстьДанныеДляОбработки Тогда
		Параметры.ОбработкаЗавершена = Истина;
		Возврат;
	КонецЕсли;
	Если НЕ ПараметрыДляОбработки.ЕстьЗаписиВоВременнойТаблице Тогда
		Параметры.ОбработкаЗавершена = Ложь;
		Возврат;
	КонецЕсли; 
	
	ТекстЗапроса =
 	"ВЫБРАТЬ
 	|	СсылкиДляОбработки.Ссылка,
 	|	ПринятиеКУчетуНМА.ВерсияДанных,
 	|	ЕСТЬNULL(ПринятиеКУчетуНМА.НематериальныйАктив.ВидОбъектаУчета, ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовУчетаНМА.НематериальныйАктив)) КАК ВидОбъектаУчета,
 	|	НЕ ЗаблокированоНематериальныйАктив.Ссылка ЕСТЬ NULL КАК ЧитаемыеДанныеЗаблокированы
 	|ИЗ
 	|	&ВТДляОбработкиСсылка КАК СсылкиДляОбработки
 	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПринятиеКУчетуНМА КАК ПринятиеКУчетуНМА
 	|		ПО (ПринятиеКУчетуНМА.Ссылка = СсылкиДляОбработки.Ссылка)
 	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтЗаблокированоНематериальныеАктивы КАК ЗаблокированоНематериальныйАктив
 	|		ПО (ЗаблокированоНематериальныйАктив.Ссылка = ПринятиеКУчетуНМА.НематериальныйАктив)";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВТДляОбработкиСсылка", ПараметрыДляОбработки.ИмяВременнойТаблицы);
	
	ПараметрыВТ = ОбновлениеИнформационнойБазы.СоздатьВременнуюТаблицуЗаблокированныхДляЧтенияИИзмененияДанных(
		Параметры.Очередь, "Справочник.НематериальныеАктивы", МенеджерВременныхТаблиц);
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВтЗаблокированоНематериальныеАктивы", ПараметрыВТ.ИмяВременнойТаблицы);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
 
 	Пока Выборка.Следующий() Цикл
 		
 		НачатьТранзакцию();
		
 		Попытка
			
 			Блокировка = Новый БлокировкаДанных;
 			ЭлементБлокировки = Блокировка.Добавить("Документ.ПринятиеКУчетуНМА");
 			ЭлементБлокировки.УстановитьЗначение("Ссылка", Выборка.Ссылка);
 			Блокировка.Заблокировать();
 			
			ДанныеОбъекта = ОбновлениеИнформационнойБазыУТ.ПроверитьПолучитьОбъект(Выборка.Ссылка, Выборка.ВерсияДанных, Параметры.Очередь);
			Если ДанныеОбъекта = Неопределено Тогда
				ЗафиксироватьТранзакцию();
 				Продолжить;
 			КонецЕсли;
			
			Если Выборка.ЧитаемыеДанныеЗаблокированы Тогда
				ЗафиксироватьТранзакцию();
 				Продолжить;
			КонецЕсли; 
			
			Если Выборка.ВидОбъектаУчета = Перечисления.ВидыОбъектовУчетаНМА.НематериальныйАктив
				И НЕ ЗначениеЗаполнено(ДанныеОбъекта.ПорядокУчетаНУ) Тогда
			
				ДанныеОбъекта.ПорядокУчетаНУ = Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации;
			КонецЕсли; 
			
			Если НЕ ЗначениеЗаполнено(ДанныеОбъекта.ВидОбъектаУчета) Тогда
				ДанныеОбъекта.ВидОбъектаУчета = Выборка.ВидОбъектаУчета;
			КонецЕсли; 
			
 			ОбновлениеИнформационнойБазы.ЗаписатьДанные(ДанныеОбъекта);
	
			ЗафиксироватьТранзакцию();
			
 		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось обработать объект: %Ссылка% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Ссылка%", Выборка.Ссылка);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
									УровеньЖурналаРегистрации.Предупреждение,
									Выборка.Ссылка.Метаданные(),
									Выборка.Ссылка,
									ТекстСообщения);
									
 		КонецПопытки;
 
 	КонецЦикла;
 		
	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

