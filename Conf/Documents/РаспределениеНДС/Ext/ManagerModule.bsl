	|			ТОГДА (ЕСТЬNULL(Операция.СуммаНДСНачисленногоКорректировка, 0) - ЕСТЬNULL(Операция.СуммаНДСМетодомЗачетаКорректировка,0)) / КурсВалютыУпрУчета.Курс
