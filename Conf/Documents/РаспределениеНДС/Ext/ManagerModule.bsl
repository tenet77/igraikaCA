Функция ПолучитьНачалоРасширенногоНалоговогоПериода(Дата, Организация) Экспорт
	
	БлижайшийНалоговыйПериод = УчетНДСПереопределяемый.БлижайшийНалоговыйПериод(
		Организация,
		Дата);
	
	Если БлижайшийНалоговыйПериод.Начало <> БлижайшийНалоговыйПериод.Период Тогда
		НачалоНалоговогоПериода = БлижайшийНалоговыйПериод.Начало;
	Иначе
		НачалоНалоговогоПериода = НачалоКвартала(Дата);
	КонецЕсли;
	
	Если НачалоКвартала(Дата) < НачалоНалоговогоПериода Тогда
		НачалоПериода = НачалоКвартала(Дата);
	Иначе
		Если НачалоМесяца(Дата) = НачалоКвартала(Дата) Тогда
			// В первом месяце квартала производится распределение НДС по ОС и НМА
			// принятым к учету в этом месяце.
			// В случае расширенного налогового периода по НДС (п.2 ст.55 НК) необходимо
			// учесть ОС и НМА, приобретенные с момента регистрации до конца предыдущего квартала.
			НачалоПериода = НачалоНалоговогоПериода;
		ИначеЕсли КонецМесяца(Дата) <> КонецКвартала(Дата) Тогда
			// Во втором месяце квартала производится распределение НДС по ОС и НМА
			// принятым к учету в этом месяце. 
			// Для распределения необходимо учитывать выручку за месяц ввода в эксплуатацию.
			НачалоПериода = НачалоМесяца(Дата);
		Иначе
			НачалоПериода = НачалоНалоговогоПериода;
		КонецЕсли;
	КонецЕсли;
	
	Возврат НачалоПериода;

КонецФункции

Функция ПолучитьСуммыЗачета(Дата, Организация, ВыручкаНДС, ВыручкаНеНДС, КорректироватьРаспределениеНДСПрошлыхПериодов = Ложь,КорректировкаРаспределенияНДС = Ложь, ПериодКорректировки = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст ="ВЫБРАТЬ
	|	ТаблицаДанных.Организация КАК Организация,
	|	СУММА(ТаблицаДанных.СуммаРазрешенногоКЗачету) КАК СуммаНДСРазрешенногоКЗачету,
	|	СУММА(ТаблицаДанных.СуммаНДСОборот - ТаблицаДанных.СуммаРазрешенногоКЗачету) КАК СуммаНДСНеРазрешенногоКЗачету,
	|	СУММА(ТаблицаДанных.СуммаНДСМетодомЗачета) КАК СуммаНДСМетодомЗачета,
	|	СУММА(ТаблицаДанных.СуммаПереносимогоЗачета) КАК СуммаНДСПереносимыйЗачет
	|ИЗ
	|	(ВЫБРАТЬ
	|		НДСКВозмещению.Организация КАК Организация,
	|		ЕСТЬNULL(НДСКВозмещению.СуммаНДСОборот, 0) КАК СуммаНДСКВозмещению,
	|		ВЫБОР
	|			КОГДА НДСКВозмещению.ВидОборота = ЗНАЧЕНИЕ(Перечисление.ВидыОборотовПоРеализации.Общий)
	|				ТОГДА ЕСТЬNULL(НДСКВозмещению.СуммаНДСОборот, 0) * &ДоляОблагаемогоОборота
	|			ИНАЧЕ ВЫБОР
	|					КОГДА НДСКВозмещению.ВидОборота = ЗНАЧЕНИЕ(Перечисление.ВидыОборотовПоРеализации.Облагаемый)
	|						ТОГДА ЕСТЬNULL(НДСКВозмещению.СуммаНДСОборот, 0)
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		КОНЕЦ КАК СуммаРазрешенногоКЗачету,
	|		ЕСТЬNULL(НДСКВозмещению.СуммаНДСОборот, 0) КАК СуммаНДСОборот,
	|		0 КАК СуммаНДСМетодомЗачета,
	|		0 КАК СуммаПереносимогоЗачета
	|	ИЗ
	|		РегистрНакопления.НДСКВозмещению.Обороты(&ПериодНачало, &ПериодОкончание, Квартал, Организация В (&Организация) И &УсловиеНалоговыйПериод) КАК НДСКВозмещению
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УчетнаяПолитикаОрганизаций.СрезПоследних(&ПериодНачало, Организация В (&Организация)) КАК УчетнаяПолитикаОрганизацийСрезПоследних
	|			ПО НДСКВозмещению.Организация = УчетнаяПолитикаОрганизацийСрезПоследних.Организация
	|	ГДЕ
	|		(НЕ ЕСТЬNULL(УчетнаяПолитикаОрганизацийСрезПоследних.УчетнаяПолитика.РаспределятьНДСМетодомЗачета, ЛОЖЬ)
	|					И НДСКВозмещению.ВидОперацииПоступления.ВидНДС <> ЗНАЧЕНИЕ(Перечисление.ВидыНДС.НДСУплачиваемыйПриИмпортеМетодомЗачета)
	|				ИЛИ ЕСТЬNULL(УчетнаяПолитикаОрганизацийСрезПоследних.УчетнаяПолитика.РаспределятьНДСМетодомЗачета, ЛОЖЬ))
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		НДСКВозмещениюОбороты.Организация,
	|		0,
	|		0,
	|		0,
	|		НДСКВозмещениюОбороты.СуммаНДСОборот,
	|		0
	|	ИЗ
	|		РегистрНакопления.НДСКВозмещению.Обороты(&ПериодНачало, &ПериодОкончание, Квартал, Организация В (&Организация) И &УсловиеНалоговыйПериод) КАК НДСКВозмещениюОбороты
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УчетнаяПолитикаОрганизаций.СрезПоследних(&ПериодНачало, Организация В (&Организация)) КАК УчетнаяПолитикаОрганизацийСрезПоследних
	|			ПО НДСКВозмещениюОбороты.Организация = УчетнаяПолитикаОрганизацийСрезПоследних.Организация
	|	ГДЕ
	|		НЕ ЕСТЬNULL(УчетнаяПолитикаОрганизацийСрезПоследних.УчетнаяПолитика.РаспределятьНДСМетодомЗачета, ЛОЖЬ)
	|					И НДСКВозмещениюОбороты.ВидОперацииПоступления.ВидНДС = ЗНАЧЕНИЕ(Перечисление.ВидыНДС.НДСУплачиваемыйПриИмпортеМетодомЗачета)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ХозрасчетныйОстатки.Организация,
	|		0,
	|		0,
	|		0,
	|		0,
	|		ХозрасчетныйОстатки.СуммаОстаток
	|	ИЗ
	|		РегистрБухгалтерии.Хозрасчетный.Остатки(&ПериодНачало, Счет В(ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.НалогНаДобавленнуюСтоимостьКВозмещению)), ,  Организация В (&Организация)) КАК ХозрасчетныйОстатки) КАК ТаблицаДанных
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаДанных.Организация";
	
	ПараметрыУчетнойПолитики = РегистрыСведений.УчетнаяПолитикаОрганизаций.ПараметрыУчетнойПолитики(Организация, Дата);
	УчитыватьКорректировкуРаспределенияНДС= ?(ПараметрыУчетнойПолитики = Неопределено, Ложь, ПараметрыУчетнойПолитики.КорректироватьРаспределениеНДСПрошлыхПериодов)
												И КорректироватьРаспределениеНДСПрошлыхПериодов;

	Если УчитыватьКорректировкуРаспределенияНДС Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И &УсловиеНалоговыйПериод", "И НалоговыйПериод >= &ПериодНачало И НалоговыйПериод <= &ПериодОкончание");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И &УсловиеНалоговыйПериод", "");
	КонецЕсли;

	Если КорректировкаРаспределенияНДС Тогда
		Запрос.Текст = ПолучитьЗапросСуммыЗачетаКорректировка();
		Запрос.УстановитьПараметр("ПериодКорректировки", ПериодКорректировки);
	КонецЕсли;

	ПериодНачало = НачалоКвартала(Дата);
	ПериодОкончание = КонецКвартала(Дата);
	//++ НЕ УТ
	Если Месяц(Дата)%3 <> 0 Тогда
		ПериодНачало = НачалоМесяца(Дата);
		ПериодОкончание = КонецМесяца(Дата);
	КонецЕсли;
	//-- НЕ УТ
	
	Запрос.УстановитьПараметр("ПериодНачало", ПериодНачало);
	Запрос.УстановитьПараметр("ПериодОкончание", ПериодОкончание);
	
	ДоляОблагаемогоОборота = ?(ВыручкаНДС = 0, 1, ВыручкаНеНДС / ВыручкаНДС);
		
	Запрос.УстановитьПараметр("ДоляОблагаемогоОборота", ДоляОблагаемогоОборота);
	
	Если ТипЗнч(Организация) = Тип("СправочникСсылка.Организации") Тогда
		МассивОрганизаций = Новый Массив();
		МассивОрганизаций.Добавить(Организация);
		
		ЗапросОбособленныхПодразделений = Новый Запрос();
		ЗапросОбособленныхПодразделений.Текст = 
		"ВЫБРАТЬ
		|	Организации.Ссылка КАК Организация
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.ОбособленноеПодразделение
		|	И Организации.ГоловнаяОрганизация = &ГоловнаяОрганизация";
		ЗапросОбособленныхПодразделений.УстановитьПараметр("ГоловнаяОрганизация", Организация);
		ВыборкаПодразделений = ЗапросОбособленныхПодразделений.Выполнить().Выбрать();
		
		Пока ВыборкаПодразделений.Следующий() Цикл
			МассивОрганизаций.Добавить(ВыборкаПодразделений.Организация);
		КонецЦикла; 
		
		Запрос.УстановитьПараметр("Организация", МассивОрганизаций);
	Иначе
		Запрос.УстановитьПараметр("Организация", Организация)
	КонецЕсли;
	
	Результат = Запрос.ВыполнитьПакет();
	СуммыЗачета = Новый Структура();
	ТаблицаСуммЗачета = Результат[0].Выгрузить();
	СуммыЗачета = Новый Структура();
	СуммыЗачета.Вставить("ТаблицаСуммЗачета", ТаблицаСуммЗачета);
	СуммыЗачета.Вставить("СуммаНДСРазрешенногоКЗачету",   ТаблицаСуммЗачета.Итог("СуммаНДСРазрешенногоКЗачету"));
	СуммыЗачета.Вставить("СуммаНДСНеРазрешенногоКЗачету", ТаблицаСуммЗачета.Итог("СуммаНДСНеРазрешенногоКЗачету"));
	СуммыЗачета.Вставить("СуммаНДСМетодомЗачета", 		  ТаблицаСуммЗачета.Итог("СуммаНДСМетодомЗачета"));
	СуммыЗачета.Вставить("СуммаНДСПереносимыйЗачет", 	  ТаблицаСуммЗачета.Итог("СуммаНДСПереносимыйЗачет"));
	
	Возврат СуммыЗачета;
	
КонецФункции

Функция ПолучитьЗапросСуммыЗачетаКорректировка()
	
	ТекстЗапроса ="ВЫБРАТЬ
	|	ТаблицаДанных.Организация КАК Организация,
	|	СУММА(ТаблицаДанных.СуммаРазрешенногоКЗачету) КАК СуммаНДСРазрешенногоКЗачету,
	|	СУММА(ТаблицаДанных.СуммаНДСОборот - ТаблицаДанных.СуммаРазрешенногоКЗачету) КАК СуммаНДСНеРазрешенногоКЗачету,
	|	СУММА(ТаблицаДанных.СуммаНДСМетодомЗачета) КАК СуммаНДСМетодомЗачета,
	|	СУММА(ТаблицаДанных.СуммаПереносимогоЗачета) КАК СуммаНДСПереносимыйЗачет
	|ИЗ
	|	(ВЫБРАТЬ
	|		НДСКВозмещению.Организация КАК Организация,
	|		ЕСТЬNULL(НДСКВозмещению.СуммаНДСОборот, 0) КАК СуммаНДСКВозмещению,
	|		ВЫБОР
	|			КОГДА НДСКВозмещению.ВидОборота = ЗНАЧЕНИЕ(Перечисление.ВидыОборотовПоРеализации.Общий)
	|				ТОГДА ЕСТЬNULL(НДСКВозмещению.СуммаНДСОборот, 0) * &ДоляОблагаемогоОборота
	|			ИНАЧЕ ВЫБОР
	|					КОГДА НДСКВозмещению.ВидОборота = ЗНАЧЕНИЕ(Перечисление.ВидыОборотовПоРеализации.Облагаемый)
	|						ТОГДА ЕСТЬNULL(НДСКВозмещению.СуммаНДСОборот, 0)
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		КОНЕЦ КАК СуммаРазрешенногоКЗачету,
	|		ЕСТЬNULL(НДСКВозмещению.СуммаНДСОборот, 0) КАК СуммаНДСОборот,
	|		0 КАК СуммаНДСМетодомЗачета,
	|		0 КАК СуммаПереносимогоЗачета
	|	ИЗ
	|		РегистрНакопления.НДСКВозмещению.Обороты(, , Квартал, Организация В (&Организация)
	|												И НалоговыйПериод >= &ПериодНачало И НалоговыйПериод <= &ПериодОкончание) КАК НДСКВозмещению
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УчетнаяПолитикаОрганизаций.СрезПоследних(&ПериодНачало, Организация В (&Организация)) КАК УчетнаяПолитикаОрганизацийСрезПоследних
	|			ПО НДСКВозмещению.Организация = УчетнаяПолитикаОрганизацийСрезПоследних.Организация
	|	ГДЕ
	|		(НЕ ЕСТЬNULL(УчетнаяПолитикаОрганизацийСрезПоследних.УчетнаяПолитика.РаспределятьНДСМетодомЗачета, ЛОЖЬ)
	|					И НДСКВозмещению.ВидОперацииПоступления.ВидНДС <> ЗНАЧЕНИЕ(Перечисление.ВидыНДС.НДСУплачиваемыйПриИмпортеМетодомЗачета)
	|				ИЛИ ЕСТЬNULL(УчетнаяПолитикаОрганизацийСрезПоследних.УчетнаяПолитика.РаспределятьНДСМетодомЗачета, ЛОЖЬ))
	|		И НДСКВозмещению.Период <= &ПериодКорректировки
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		НДСКВозмещениюОбороты.Организация,
	|		0,
	|		0,
	|		0,
	|		НДСКВозмещениюОбороты.СуммаНДСОборот,
	|		0
	|	ИЗ
	|		РегистрНакопления.НДСКВозмещению.Обороты(, , Квартал, Организация В (&Организация)
	|												И НалоговыйПериод >= &ПериодНачало И НалоговыйПериод <= &ПериодОкончание) КАК НДСКВозмещениюОбороты
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УчетнаяПолитикаОрганизаций.СрезПоследних(&ПериодНачало, Организация В (&Организация)) КАК УчетнаяПолитикаОрганизацийСрезПоследних
	|			ПО НДСКВозмещениюОбороты.Организация = УчетнаяПолитикаОрганизацийСрезПоследних.Организация
	|	ГДЕ
	|		НЕ ЕСТЬNULL(УчетнаяПолитикаОрганизацийСрезПоследних.УчетнаяПолитика.РаспределятьНДСМетодомЗачета, ЛОЖЬ)
	|					И НДСКВозмещениюОбороты.ВидОперацииПоступления.ВидНДС = ЗНАЧЕНИЕ(Перечисление.ВидыНДС.НДСУплачиваемыйПриИмпортеМетодомЗачета)
	|		И НДСКВозмещениюОбороты.Период <= &ПериодКорректировки
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ХозрасчетныйОстатки.Организация,
	|		0,
	|		0,
	|		0,
	|		0,
	|		ХозрасчетныйОстатки.СуммаОстаток
	|	ИЗ
	|		РегистрБухгалтерии.Хозрасчетный.Остатки(&ПериодНачало, Счет В(ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.НалогНаДобавленнуюСтоимостьКВозмещению)), ,  Организация В (&Организация)) КАК ХозрасчетныйОстатки) КАК ТаблицаДанных
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаДанных.Организация";
		
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ПолучитьТаблицуКорректировкиНДС(Дата, НачалоПериода, Организация, КорректироватьРаспределениеНДСПрошлыхПериодов = Ложь) Экспорт
	
	ПараметрыУчетнойПолитики = РегистрыСведений.УчетнаяПолитикаОрганизаций.ПараметрыУчетнойПолитики(Организация, Дата);
	КорректироватьРаспределениеНДС 	= ?(ПараметрыУчетнойПолитики = Неопределено, Ложь, ПараметрыУчетнойПолитики.КорректироватьРаспределениеНДСПрошлыхПериодов)
										И КорректироватьРаспределениеНДСПрошлыхПериодов;
	
	Если Не КорректироватьРаспределениеНДС Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаКорректировкиНДС = Новый ТаблицаЗначений;
	ТаблицаКорректировкиНДС.Колонки.Добавить("КорректируемыйПериод", Новый ОписаниеТипов("Дата",Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ТаблицаКорректировкиНДС.Колонки.Добавить("ОписаниеПериодаКорректировки", Новый ОписаниеТипов("Строка",Новый КвалификаторыСтроки(20)));
	ТаблицаКорректировкиНДС.Колонки.Добавить("ВыручкаНДССторно", 							Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	ТаблицаКорректировкиНДС.Колонки.Добавить("ВыручкаНДСКорректировка", 					Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	ТаблицаКорректировкиНДС.Колонки.Добавить("ВыручкаНеНДССторно", 							Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	ТаблицаКорректировкиНДС.Колонки.Добавить("ВыручкаНеНДСКорректировка", 					Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	ТаблицаКорректировкиНДС.Колонки.Добавить("ВыручкаНДС0Сторно", 							Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	ТаблицаКорректировкиНДС.Колонки.Добавить("ВыручкаНДС0Корректировка", 					Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	ТаблицаКорректировкиНДС.Колонки.Добавить("СуммаНДСНачисленногоСторно", 					Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	ТаблицаКорректировкиНДС.Колонки.Добавить("СуммаНДСНачисленногоКорректировка", 			Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	ТаблицаКорректировкиНДС.Колонки.Добавить("СуммаНДСРазрешенногоКЗачетуСторно", 			Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	ТаблицаКорректировкиНДС.Колонки.Добавить("СуммаНДСРазрешенногоКЗачетуКорректировка",	Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	ТаблицаКорректировкиНДС.Колонки.Добавить("СуммаНДСНеРазрешенногоКЗачетуСторно", 		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	ТаблицаКорректировкиНДС.Колонки.Добавить("СуммаНДСНеРазрешенногоКЗачетуКорректировка", 	Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	ТаблицаКорректировкиНДС.Колонки.Добавить("СуммаНДСМетодомЗачетаСторно", 				Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	ТаблицаКорректировкиНДС.Колонки.Добавить("СуммаНДСМетодомЗачетаКорректировка", 			Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	ТаблицаКорректировкиНДС.Колонки.Добавить("СуммаНДСПереносимыйЗачетСторно", 				Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	ТаблицаКорректировкиНДС.Колонки.Добавить("СуммаНДСПереносимыйЗачетКорректировка", 		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	
	ТаблицаНДСОбособленныхПодразделений = Новый ТаблицаЗначений;
	ТаблицаНДСОбособленныхПодразделений.Колонки.Добавить("ОбособленноеПодразделение");
	ТаблицаНДСОбособленныхПодразделений.Колонки.Добавить("СчетУчетаНДС");
	ТаблицаНДСОбособленныхПодразделений.Колонки.Добавить("СуммаНДС");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(НДСОбороты.НалоговыйПериод, КВАРТАЛ) КАК КорректируемыйПериод
	|ПОМЕСТИТЬ ВТ_ПериодыРегистровККорректировке
	|ИЗ
	|	РегистрНакопления.НДС.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			Организация В (&Организация)
	|				И НалоговыйПериод < &НачалоПериода) КАК НДСОбороты
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(НДСКВозмещениюОбороты.НалоговыйПериод, КВАРТАЛ)
	|ИЗ
	|	РегистрНакопления.НДСКВозмещению.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			Организация В (&Организация)
	|				И НалоговыйПериод < &НачалоПериода) КАК НДСКВозмещениюОбороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_ПериодыРегистровККорректировке.КорректируемыйПериод КАК НачалоПериодаКорректировки,
	|	КОНЕЦПЕРИОДА(ВТ_ПериодыРегистровККорректировке.КорректируемыйПериод, КВАРТАЛ) КАК ОкончаниеПериодаКорректировки
	|ИЗ
	|	ВТ_ПериодыРегистровККорректировке КАК ВТ_ПериодыРегистровККорректировке";
	
	ПериодНачало = НачалоКвартала(Дата);
	ПериодОкончание = КонецКвартала(Дата);

	Если Месяц(Дата)%3 <> 0 Тогда
		ПериодОкончание = КонецМесяца(Дата);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",  Новый Граница(ПериодОкончание, ВидГраницы.Включая));
	
	Если ТипЗнч(Организация) = Тип("СправочникСсылка.Организации") Тогда
		МассивОрганизаций = Новый Массив();
		МассивОрганизаций.Добавить(Организация);
		Запрос.УстановитьПараметр("Организация", МассивОрганизаций);
		
		ЗапросОбособленныхПодразделений = Новый Запрос();
		ЗапросОбособленныхПодразделений.Текст = 
		"ВЫБРАТЬ
		|	Организации.Ссылка КАК Организация
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.ОбособленноеПодразделение
		|	И Организации.ГоловнаяОрганизация = &ГоловнаяОрганизация";
		ЗапросОбособленныхПодразделений.УстановитьПараметр("ГоловнаяОрганизация", Организация);
		ВыборкаПодразделений = ЗапросОбособленныхПодразделений.Выполнить().Выбрать();
		
		Пока ВыборкаПодразделений.Следующий() Цикл
			МассивОрганизаций.Добавить(ВыборкаПодразделений.Организация);
		КонецЦикла; 
		
	Иначе
		Запрос.УстановитьПараметр("Организация", Организация)
	КонецЕсли;

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрокаКорректировки = ТаблицаКорректировкиНДС.Добавить();
		НоваяСтрокаКорректировки.КорректируемыйПериод = Выборка.НачалоПериодаКорректировки;
		НоваяСтрокаКорректировки.ОписаниеПериодаКорректировки = Формат(Выборка.НачалоПериодаКорректировки, "ДФ=""к ' квартал ' гггг 'г.'"""); 
		
		//Исходные сторнируемые показатели
		ПериодСторно = КонецМесяца(ДобавитьМесяц(ПериодОкончание,-3));
		Если ПериодСторно = Выборка.ОкончаниеПериодаКорректировки Тогда
			Результат = Документы.РаспределениеНДС.ПолучитьБазуРаспределения(Выборка.ОкончаниеПериодаКорректировки, Выборка.НачалоПериодаКорректировки, Организация, , Истина);
		Иначе
			Результат = Документы.РаспределениеНДС.ПолучитьБазуРаспределения(Выборка.ОкончаниеПериодаКорректировки, Выборка.НачалоПериодаКорректировки, Организация, , , Истина, ПериодСторно);
		КонецЕсли;
		
		НоваяСтрокаКорректировки.ВыручкаНДССторно 			= -Результат.ВыручкаНДС;
		НоваяСтрокаКорректировки.ВыручкаНеНДССторно 		= -Результат.ВыручкаНеНДС;
		НоваяСтрокаКорректировки.ВыручкаНДС0Сторно 			= -Результат.ВыручкаНДС0;
		НоваяСтрокаКорректировки.СуммаНДСНачисленногоСторно = -Результат.СуммаНДСНачисленного;
		
		Для каждого СтрокаНДСОбособленныхПодразделений Из Результат.ТаблицаНДСОбособленныхПодразделений Цикл
			НоваяСтрокаНДСОбособленныхПодразделений = ТаблицаНДСОбособленныхПодразделений.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаНДСОбособленныхПодразделений, СтрокаНДСОбособленныхПодразделений);
			НоваяСтрокаНДСОбособленныхПодразделений.СуммаНДС = -СтрокаНДСОбособленныхПодразделений.СуммаНДС;
		КонецЦикла; 
		
		Если ПериодСторно = Выборка.ОкончаниеПериодаКорректировки Тогда
			ТаблицыСуммыЗачета = Документы.РаспределениеНДС.ПолучитьСуммыЗачета(Выборка.ОкончаниеПериодаКорректировки, Организация, НоваяСтрокаКорректировки.ВыручкаНДССторно, НоваяСтрокаКорректировки.ВыручкаНеНДССторно, Истина);
		Иначе
			ТаблицыСуммыЗачета = Документы.РаспределениеНДС.ПолучитьСуммыЗачета(Выборка.ОкончаниеПериодаКорректировки, Организация, НоваяСтрокаКорректировки.ВыручкаНДССторно, НоваяСтрокаКорректировки.ВыручкаНеНДССторно, , Истина, ПериодСторно);
		КонецЕсли;
		
		НоваяСтрокаКорректировки.СуммаНДСРазрешенногоКЗачетуСторно 	= -ТаблицыСуммыЗачета.СуммаНДСРазрешенногоКЗачету;
		НоваяСтрокаКорректировки.СуммаНДСНеРазрешенногоКЗачетуСторно= -ТаблицыСуммыЗачета.СуммаНДСНеРазрешенногоКЗачету;
		НоваяСтрокаКорректировки.СуммаНДСМетодомЗачетаСторно 		= -ТаблицыСуммыЗачета.СуммаНДСМетодомЗачета;
		НоваяСтрокаКорректировки.СуммаНДСПереносимыйЗачетСторно 	= -ТаблицыСуммыЗачета.СуммаНДСПереносимыйЗачет;
		
		//Показатели с учетом корректировки НДС по данным налогового периода регистров учета НДС
		РезультатКорректировка = Документы.РаспределениеНДС.ПолучитьБазуРаспределения(Выборка.ОкончаниеПериодаКорректировки, Выборка.НачалоПериодаКорректировки, Организация, , , Истина, ПериодОкончание);
		
		НоваяСтрокаКорректировки.ВыручкаНДСКорректировка 			= РезультатКорректировка.ВыручкаНДС;
		НоваяСтрокаКорректировки.ВыручкаНеНДСКорректировка 			= РезультатКорректировка.ВыручкаНеНДС;
		НоваяСтрокаКорректировки.ВыручкаНДС0Корректировка 			= РезультатКорректировка.ВыручкаНДС0;
		НоваяСтрокаКорректировки.СуммаНДСНачисленногоКорректировка 	= РезультатКорректировка.СуммаНДСНачисленного;

		Для каждого СтрокаНДСОбособленныхПодразделений Из РезультатКорректировка.ТаблицаНДСОбособленныхПодразделений Цикл
			НоваяСтрокаНДСОбособленныхПодразделений = ТаблицаНДСОбособленныхПодразделений.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаНДСОбособленныхПодразделений, СтрокаНДСОбособленныхПодразделений);
		КонецЦикла;
		
		ТаблицыСуммыЗачетаКорректировка = Документы.РаспределениеНДС.ПолучитьСуммыЗачета(Выборка.ОкончаниеПериодаКорректировки, Организация, НоваяСтрокаКорректировки.ВыручкаНДССторно, НоваяСтрокаКорректировки.ВыручкаНеНДССторно, , Истина, ПериодОкончание);
		
		НоваяСтрокаКорректировки.СуммаНДСРазрешенногоКЗачетуКорректировка 	= ТаблицыСуммыЗачетаКорректировка.СуммаНДСРазрешенногоКЗачету;
		НоваяСтрокаКорректировки.СуммаНДСНеРазрешенногоКЗачетуКорректировка	= ТаблицыСуммыЗачетаКорректировка.СуммаНДСНеРазрешенногоКЗачету;
		НоваяСтрокаКорректировки.СуммаНДСМетодомЗачетаКорректировка 		= ТаблицыСуммыЗачетаКорректировка.СуммаНДСМетодомЗачета;
		НоваяСтрокаКорректировки.СуммаНДСПереносимыйЗачетКорректировка 		= ТаблицыСуммыЗачетаКорректировка.СуммаНДСПереносимыйЗачет;

	КонецЦикла;

	ТаблицаНДСОбособленныхПодразделений.Свернуть("ОбособленноеПодразделение, СчетУчетаНДС", "СуммаНДС");
	
	СтруктураКорректировкиНДС = Новый Структура;
	СтруктураКорректировкиНДС.Вставить("ТаблицаКорректировкиНДС", ТаблицаКорректировкиНДС);
	СтруктураКорректировкиНДС.Вставить("ТаблицаНДСОбособленныхПодразделений", ТаблицаНДСОбособленныхПодразделений);
	
	Возврат  СтруктураКорректировкиНДС;
	
КонецФункции
#КонецОбласти

#Область ОбновлениеИнформационнойБазы

// Обработчик обновления УТ 11.4.2
// заполняется реквизит "Начало периода".
//
Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	РаспределениеНДС.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РаспределениеНДС КАК РаспределениеНДС
	|ГДЕ
	|	РаспределениеНДС.НачалоПериода = ДАТАВРЕМЯ(1, 1, 1)");
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	ПолноеИмяОбъекта = "Документ.РаспределениеНДС";
	МетаданныеДокумента = Метаданные.НайтиПоПолномуИмени(ПолноеИмяОбъекта);
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Результат = ОбновлениеИнформационнойБазы.СоздатьВременнуюТаблицуСсылокДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта, МенеджерВременныхТаблиц);
	
	Если НЕ Результат.ЕстьДанныеДляОбработки Тогда
		Параметры.ОбработкаЗавершена = Истина;
		Возврат;
	КонецЕсли;
	Если НЕ Результат.ЕстьЗаписиВоВременнойТаблице Тогда
		Параметры.ОбработкаЗавершена = Ложь;
		Возврат;
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	ТекстЗапроса = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РаспределениеНДС.Ссылка КАК Ссылка,
	|	РаспределениеНДС.ВерсияДанных КАК ВерсияДанных,
	|	РаспределениеНДС.Дата КАК Дата
	|ИЗ
	|	&ВТДокументыДляОбработки КАК КОбработке
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РаспределениеНДС КАК РаспределениеНДС
	|		ПО РаспределениеНДС.Ссылка = КОбработке.Ссылка
	|";
	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "&ВТДокументыДляОбработки", Результат.ИмяВременнойТаблицы);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		Попытка
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить(ПолноеИмяОбъекта);
			ЭлементБлокировки.УстановитьЗначение("Ссылка", Выборка.Ссылка);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			
			Блокировка.Заблокировать();
				
			ДокументОбъект = ОбновлениеИнформационнойБазыУТ.ПроверитьПолучитьОбъект(Выборка.Ссылка, Выборка.ВерсияДанных, Параметры.Очередь);
			Если ДокументОбъект = Неопределено Тогда
				ЗафиксироватьТранзакцию();
				Продолжить;
			КонецЕсли;
			Если Месяц(Выборка.Дата)%3 = 0 Тогда // это последний месяц квартала
				ДокументОбъект.НачалоПериода = НачалоКвартала(Выборка.Дата);
			Иначе
				ДокументОбъект.НачалоПериода = НачалоМесяца(Выборка.Дата);
			КонецЕсли;
			
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ТекстСообщения = НСтр("ru = 'Не удалось обработать документ: %Ссылка% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Ссылка%", Выборка.Ссылка);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				МетаданныеДокумента,
				Выборка.Ссылка,
				ТекстСообщения);
			Продолжить;
		КонецПопытки;
	КонецЦикла;
	Параметры.ОбработкаЗавершена = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

