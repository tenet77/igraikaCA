	|			ТОГДА ЕСТЬNULL(Операция.СуммаНДСНачисленногоКорректировка, 0) - ЕСТЬNULL(Операция.СуммаНДСМетодомЗачетаКорректировка,0)
	|		ИНАЧЕ ЕСТЬNULL(Операция.СуммаНДСРазрешенногоКЗачетуКорректировка, 0) + ЕСТЬNULL(Операция.СуммаНДСПереносимыйЗачетКорректировка,0) 
