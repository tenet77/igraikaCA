	ТекстыОтражения.Добавить(ТекстВыплатаЗарплатыНаЛицевыеСчетаСписком);
	ТекстыОтражения.Добавить(ТекстВыплатаЗарплатыПоЗарплатномуПроекту);
	ТекстыОтражения.Добавить(ТекстВыплатаНаЛицевыеСчета);
