	"ВЫБРАТЬ
	|	втПредыдущаяПереоценкаОбъектовДанные.ОбъектУчета КАК ОбъектУчета,
	|	СУММА(втПредыдущаяПереоценкаОбъектовДанные.СуммаДооценки) КАК СуммаДооценки,
	|	СУММА(втПредыдущаяПереоценкаОбъектовДанные.СуммаУценки) КАК СуммаУценки
	|ПОМЕСТИТЬ втПредыдущаяПереоценкаОбъектов
	|ИЗ
	|	втПредыдущаяПереоценкаОбъектовДанные КАК втПредыдущаяПереоценкаОбъектовДанные
	|
	|СГРУППИРОВАТЬ ПО
	|	втПредыдущаяПереоценкаОбъектовДанные.ОбъектУчета
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОбъектУчета";
	
	ТекстыЗапроса.Добавить(Текст, ИмяТаблицы);
	
КонецПроцедуры

Процедура ВременнаяТаблицаДанныеДляПроведения(ТекстыЗапроса)
	
	ИмяТаблицы = "втДанныеДляПроведения";
	
	Если ПроведениеСерверУТ.ЕстьТаблицаЗапроса(ИмяТаблицы, ТекстыЗапроса) Тогда
		Возврат;
	КонецЕсли;
	
	ВременнаяТаблицаПоДокументу(ТекстыЗапроса);
	ВременнаяТаблицаОстаткиСтоимости(ТекстыЗапроса);
	ВременнаяТаблицаАмортизацияПоДокументу(ТекстыЗапроса);
	ВременнаяТаблицаПредыдущаяПереоценкаОбъектов(ТекстыЗапроса);
	
	Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// Временная таблица втДанныеДляПроведения
	|"+
	"ВЫБРАТЬ
	|	втТаблицаПоДокументу.Ссылка,
	|	втТаблицаПоДокументу.ОбъектУчета,
	|	втТаблицаПоДокументу.Организация КАК Организация,
	|	втТаблицаПоДокументу.Подразделение КАК Подразделение,
	|	втТаблицаПоДокументу.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ЕСТЬNULL(втОстаткиСтоимости.ВосстановительнаяСтоимость, 0) КАК ВосстановительнаяСтоимость,
	|	ЕСТЬNULL(втОстаткиСтоимости.НакопленнаяАмортизация, 0) + ЕСТЬNULL(втАмортизацияПоДокументу.Сумма, 0) КАК НакопленнаяАмортизация,
	|	втТаблицаПоДокументу.Стоимость КАК НоваяСтоимость,
	|	ВЫБОР
	|		КОГДА втОстаткиСтоимости.ОбъектУчета ЕСТЬ NULL 
	|				ИЛИ втТаблицаПоДокументу.Стоимость < (втОстаткиСтоимости.ВосстановительнаяСтоимость - ЕСТЬNULL(втОстаткиСтоимости.НакопленнаяАмортизация, 0) - ЕСТЬNULL(втАмортизацияПоДокументу.Сумма, 0))
	|			ТОГДА 0
	|		ИНАЧЕ втТаблицаПоДокументу.Стоимость - (втОстаткиСтоимости.ВосстановительнаяСтоимость - ЕСТЬNULL(втОстаткиСтоимости.НакопленнаяАмортизация, 0) - ЕСТЬNULL(втАмортизацияПоДокументу.Сумма, 0))
	|	КОНЕЦ КАК СуммаДооценки,
	|	ВЫБОР
	|		КОГДА втОстаткиСтоимости.ОбъектУчета ЕСТЬ NULL 
	|				ИЛИ втОстаткиСтоимости.ВосстановительнаяСтоимость - ЕСТЬNULL(втОстаткиСтоимости.НакопленнаяАмортизация, 0) - ЕСТЬNULL(втАмортизацияПоДокументу.Сумма, 0) < втТаблицаПоДокументу.Стоимость
	|			ТОГДА 0
	|		ИНАЧЕ втОстаткиСтоимости.ВосстановительнаяСтоимость - ЕСТЬNULL(втОстаткиСтоимости.НакопленнаяАмортизация, 0) - ЕСТЬNULL(втАмортизацияПоДокументу.Сумма, 0) - втТаблицаПоДокументу.Стоимость
	|	КОНЕЦ КАК СуммаУценки,
	|	ВЫБОР
	|		КОГДА втОстаткиСтоимости.ОбъектУчета ЕСТЬ NULL 
	|				ИЛИ (втОстаткиСтоимости.ВосстановительнаяСтоимость - втОстаткиСтоимости.НакопленнаяАмортизация - втАмортизацияПоДокументу.Сумма) < втТаблицаПоДокументу.Стоимость
	|				ИЛИ (втОстаткиСтоимости.ВосстановительнаяСтоимость - втОстаткиСтоимости.НакопленнаяАмортизация - втАмортизацияПоДокументу.Сумма) = 0
	|			ТОГДА 0
	|		КОГДА втТаблицаПоДокументу.МетодПереоценки = ЗНАЧЕНИЕ(Перечисление.МетодыПереоценкиВнеоборотныхАктивов.СписаниеАмортизацииПриПереоценке)
	|			ТОГДА - втТаблицаПоДокументу.Стоимость + (ВосстановительнаяСтоимость - втОстаткиСтоимости.НакопленнаяАмортизация - втАмортизацияПоДокументу.Сумма)
	|		ИНАЧЕ - втОстаткиСтоимости.ВосстановительнаяСтоимость *(втТаблицаПоДокументу.Стоимость / (втОстаткиСтоимости.ВосстановительнаяСтоимость - втОстаткиСтоимости.НакопленнаяАмортизация - втАмортизацияПоДокументу.Сумма) - 1)
	|	КОНЕЦ КАК СуммаУценкиСтоимости,
	|	ВЫБОР
	|		КОГДА втОстаткиСтоимости.ОбъектУчета ЕСТЬ NULL 
	|				ИЛИ втТаблицаПоДокументу.Стоимость < (втОстаткиСтоимости.ВосстановительнаяСтоимость - втОстаткиСтоимости.НакопленнаяАмортизация - втАмортизацияПоДокументу.Сумма)
	|				ИЛИ (втОстаткиСтоимости.ВосстановительнаяСтоимость - втОстаткиСтоимости.НакопленнаяАмортизация - втАмортизацияПоДокументу.Сумма) = 0
	|			ТОГДА 0
	|		КОГДА втТаблицаПоДокументу.МетодПереоценки = ЗНАЧЕНИЕ(Перечисление.МетодыПереоценкиВнеоборотныхАктивов.СписаниеАмортизацииПриПереоценке)
	|			ТОГДА втТаблицаПоДокументу.Стоимость - (втОстаткиСтоимости.ВосстановительнаяСтоимость - втОстаткиСтоимости.НакопленнаяАмортизация - втАмортизацияПоДокументу.Сумма)  
	|		ИНАЧЕ втОстаткиСтоимости.ВосстановительнаяСтоимость*(втТаблицаПоДокументу.Стоимость / (втОстаткиСтоимости.ВосстановительнаяСтоимость - втОстаткиСтоимости.НакопленнаяАмортизация - втАмортизацияПоДокументу.Сумма) - 1)
	|	КОНЕЦ КАК СуммаДооценкиСтоимости,
	|	ЕСТЬNULL(втПредыдущаяПереоценкаОбъектов.СуммаДооценки, 0) КАК СуммаПрошлойДооценки,
	|	ЕСТЬNULL(втПредыдущаяПереоценкаОбъектов.СуммаУценки, 0) КАК СуммаПрошлойУценки
	|ПОМЕСТИТЬ втДанныеДляПроведения
	|ИЗ
	|	втТаблицаПоДокументу КАК втТаблицаПоДокументу
	|		ЛЕВОЕ СОЕДИНЕНИЕ втОстаткиСтоимости КАК втОстаткиСтоимости
	|		ПО втТаблицаПоДокументу.ОбъектУчета = втОстаткиСтоимости.ОбъектУчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ втАмортизацияПоДокументу КАК втАмортизацияПоДокументу
	|		ПО втТаблицаПоДокументу.ОбъектУчета = втАмортизацияПоДокументу.ОбъектУчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ втПредыдущаяПереоценкаОбъектов КАК втПредыдущаяПереоценкаОбъектов
	|		ПО втТаблицаПоДокументу.ОбъектУчета = втПредыдущаяПереоценкаОбъектов.ОбъектУчета";
	
	ТекстыЗапроса.Добавить(Текст, ИмяТаблицы);
	
