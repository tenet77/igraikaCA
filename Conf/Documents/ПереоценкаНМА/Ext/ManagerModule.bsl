Функция ТекстОтраженияВРеглУчете() Экспорт
	
	ТекстыОтражения = Новый Массив;
	ТекстыОтражения.Добавить(УчетНМА.ТекстОтраженияВРеглУчетеНачисленнойАмортизации());
	ТекстыОтражения.Добавить(ДооценкаВосстановительнойСтоимости());
	ТекстыОтражения.Добавить(ДооценкаВосстановительнойСтоимостиИзДолиУценки());
	ТекстыОтражения.Добавить(ДооценкаВосстановительнойСтоимостиИзУценки());
	ТекстыОтражения.Добавить(ДооценкаНакопленнойАмортизации());
	ТекстыОтражения.Добавить(ДооценкаНакопленнойАмортизацииИзДолиУценки());
	ТекстыОтражения.Добавить(ДооценкаНакопленнойАмортизацииИзУценки());
	ТекстыОтражения.Добавить(УценкаВосстановительнойСтоимости());
	ТекстыОтражения.Добавить(УценкаВосстановительнойСтоимостиЦФ());
	ТекстыОтражения.Добавить(УценкаВосстановительнойСтоимостиИзДолиДооценки());
	ТекстыОтражения.Добавить(УценкаВосстановительнойСтоимостиИзДооценки());
	ТекстыОтражения.Добавить(УценкаНакопленнойАмортизации());
	ТекстыОтражения.Добавить(УценкаНакопленнойАмортизацииЦФ());
	ТекстыОтражения.Добавить(УценкаНакопленнойАмортизацииИзДолиДооценки());
	ТекстыОтражения.Добавить(УценкаНакопленнойАмортизацииИзДооценки());
	ТекстыОтражения.Добавить(СписаниеНакопленнойАмортизацииПриПереоценке());
	ТекстыОтражения.Добавить(СписаниеНакопленнойАмортизацииПриПереоценкеЦФ());
	ТекстыОтражения.Добавить(ПризнаниеДоходовОтЦелевогоФинансирования());
	
	Возврат СтрСоединить(ТекстыОтражения, ОбщегоНазначенияУТ.РазделительЗапросовВОбъединении());
	
