Функция ТекстЗапросаТаблицаНДСПредъявленный(Запрос, ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "НДСПредъявленный";
	
	Если НЕ ПроведениеСерверУТ.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли; 
	
	УстановитьПараметрыЗапросаКоэффициентыВалют(Запрос);
	
	УчетНДСУТ.УстановитьПараметрТипыНалогообложенияНДСПоступления(Запрос);
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	Строки.ИдентификаторСтроки             КАК ИдентификаторСтроки,
	|	Строки.Ссылка.Дата                     КАК Период,
	|	Строки.Ссылка.Организация              КАК Организация,
	|	&Ссылка                                КАК СчетФактура,
	|	Строки.Ссылка.Контрагент                    КАК Поставщик,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыЦенностей.ПрочиеРаботыИУслуги) КАК ВидЦенности,
	|	Строки.СтавкаНДС                       КАК СтавкаНДС,
	|	Строки.Ссылка.ЗакупкаПодДеятельность        КАК ВидДеятельностиНДС,
	|	НЕОПРЕДЕЛЕНО                           КАК ИсправленныйСчетФактура,
	|	НЕОПРЕДЕЛЕНО                           КАК РеализацияЭкспорт,
	|	СУММА(ЕСТЬNULL(Суммы.БазаНДСРегл, 
	|		ВЫРАЗИТЬ(Строки.Сумма * &КоэффициентПересчетаВВалютуРегл КАК ЧИСЛО(15,2)))) КАК СуммаБезНДС,
	|	СУММА(ЕСТЬNULL(Суммы.СуммаНДСРегл, 
	|		ВЫРАЗИТЬ(Строки.СуммаНДС * &КоэффициентПересчетаВВалютуРегл КАК ЧИСЛО(15,2)))) КАК НДС,
	|	СУММА(ВЫБОР 
	|			КОГДА &УправленческийУчетОрганизаций
	|				ТОГДА ЕСТЬNULL(Суммы.СуммаНДСУпр, 
	|						ВЫРАЗИТЬ(Строки.СуммаНДС * &КоэффициентПересчетаВВалютуУпр КАК ЧИСЛО(15,2)))
	|				ИНАЧЕ 0
	|			КОНЕЦ)                         КАК НДСУпр,
	|	НЕОПРЕДЕЛЕНО                           КАК Событие,
	|	ЛОЖЬ                                   КАК РегламентнаяОперация
	|ИЗ
	|	Документ.ОтчетПереработчика.Услуги КАК Строки
	|	
	|	ЛЕВОЕ СОЕДИНЕНИЕ 
	|		РегистрСведений.СуммыДокументовВВалютеРегл КАК Суммы
	|	ПО 
	|		Строки.Ссылка = Суммы.Регистратор
	|		И Строки.ИдентификаторСтроки = Суммы.ИдентификаторСтроки
	|		И Суммы.БазаНДСРегл <> 0
	|		И (Строки.СуммаСНДС - Строки.СуммаНДС) = Суммы.СуммаБезНДС
	|		И Строки.СуммаНДС = Суммы.СуммаНДС
	|ГДЕ
	|	Строки.Ссылка = &Ссылка
	|	И Строки.Ссылка.Организация <> ЗНАЧЕНИЕ(Справочник.Организации.УправленческаяОрганизация)
	|	И Строки.Ссылка.ЗакупкаПодДеятельность В (&ТипыНалогообложенияНДСПоступления)
	|	И Строки.Ссылка.СуммаДокумента <> 0
	|СГРУППИРОВАТЬ ПО
	|	Строки.Ссылка,
	|	Строки.ИдентификаторСтроки,
	|	Строки.СтавкаНДС";
	
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	Возврат ТекстЗапроса;
	
КонецФункции

