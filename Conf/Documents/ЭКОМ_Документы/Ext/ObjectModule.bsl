Перем НеВыполнятьКодПриЗаписи Экспорт;

Функция ПолучитьДанныеРеализации(ВидДокумента, СвязанныеДокументы, ЗаказДата, ЗаказНомер, Организация, Контрагент) Экспорт  
	
	Если НЕ ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.RECADV_Входящий Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	ИмяДокументаРТУ = ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере("ЭКОМ_ВидРеализацииПоставщик");
	Если НЕ ЗначениеЗаполнено(ИмяДокументаРТУ) Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	Если СвязанныеДокументы.Количество() = 0 Тогда
		ЗапросРТУ = Новый Запрос;
		ЗапросРТУ.Текст = 
		"ВЫБРАТЬ
		|   ЭКОМ_Объекты_События.Документ_Основание
		|ИЗ
		|   РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_События
		|ГДЕ
		|   ЭКОМ_Объекты_События.ЗаказДата = &ЗаказДата
		|   И ЭКОМ_Объекты_События.ЗаказНомер = &ЗаказНомер
		|   И ЭКОМ_Объекты_События.Организация = &Организация
		|   И ЭКОМ_Объекты_События.Контрагент = &Контрагент
		|   И ЭКОМ_Объекты_События.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.DESADV_Исходящий)";
		ЗапросРТУ.УстановитьПараметр("ЗаказДата"  , ЗаказДата);
		ЗапросРТУ.УстановитьПараметр("ЗаказНомер" , ЗаказНомер);
		ЗапросРТУ.УстановитьПараметр("Организация", Организация);
		ЗапросРТУ.УстановитьПараметр("Контрагент" , Контрагент);
		РезультатЗапросаРТУ = ЗапросРТУ.Выполнить();
		ВыборкаРТУ = РезультатЗапросаРТУ.Выбрать();      
		Пока ВыборкаРТУ.Следующий() Цикл
			СтрокаСвязанныеДокументы = СвязанныеДокументы.Добавить();
			СтрокаСвязанныеДокументы.ДокументСвязанный = ВыборкаРТУ.Документ_Основание;
		КонецЦикла;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РТУТовары.Ссылка КАК Реализация,
	|	РТУТовары.Номенклатура,
	|	РТУТовары.Количество,
	|	РТУТовары.Цена,
	|	РТУТовары.Сумма
	|ИЗ
	|	&ДокументИмяДокументаРТУТовары КАК РТУТовары
	|ГДЕ
	|	РТУТовары.Ссылка В(&РТУ)";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДокументИмяДокументаРТУТовары", "Документ." + ИмяДокументаРТУ + ".Товары");     
	Запрос.УстановитьПараметр("РТУ", СвязанныеДокументы);
	РезультатЗапроса = Запрос.Выполнить();    
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции

Функция КонвертацияPDF_в_JPG(СЧФНомер, СЧФДата, ПрофильОбмена, ИдентификаторЮЗД, МассивЛогаСобытий) Экспорт
	
	РезультатВыполнения = Новый Структура;
	РезультатВыполнения.Вставить("ЕстьОшибка" , Ложь);
	РезультатВыполнения.Вставить("ТекстОшибки", ""); 
	РезультатВыполнения.Вставить("КаталогКартинкиЮЗД" , "");
	
	Если ЗначениеЗаполнено(ПрофильОбмена) Тогда
		
		Ошибка = Новый Структура;
		Ошибка.Вставить("ЕстьОшибка" , Ложь);
		Ошибка.Вставить("КодОшибки"  , "");
		Ошибка.Вставить("ТекстОшибки", "");  
		
		ИД_Документа = Прав(ИдентификаторЮЗД, 36);
		СтрокаBase64PDF_Документа = ЭКОМ_ОбщегоНазначения.ИзвлечьPDF_ЭКОМ(ПрофильОбмена, ИД_Документа, Ошибка, МассивЛогаСобытий);
		ДвоичныеДанныеPDF_Документа = Base64Значение(СтрокаBase64PDF_Документа);
		
		Если Ошибка.ЕстьОшибка = Ложь Тогда
			ВременныйКаталог = ЭКОМ_ОбщегоНазначения.ПутьВременногоКаталогаЭКОМ("pdf_to_jpg_" + ИД_Документа);
			
			КаталогСоздан = ЭКОМ_ОбщегоНазначения.ЭКОМ_СоздатьКаталогПроверитьНаЗапись(ВременныйКаталог, МассивЛогаСобытий);	
			РезультатВыполнения.ТекстОшибки = ЭКОМ_ОбщегоНазначения.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий);
			
			Если КаталогСоздан = Истина Тогда		
				ФайлПолноеИмя = ВременныйКаталог + ИД_Документа + ".pdf";
				ДвоичныеДанныеPDF_Документа.Записать(ФайлПолноеИмя);
				ДвоичныеДанныеМакета = ПолучитьМакет("КонвертаторPDF");
				ИмяФайлаКонвертатораPDF = ВременныйКаталог + "КонвертаторPDF.zip";
				ДвоичныеДанныеМакета.Записать(ИмяФайлаКонвертатораPDF);
				
				Файл = Новый ЧтениеZipФайла(ИмяФайлаКонвертатораPDF);
				Файл.ИзвлечьВсе(ВременныйКаталог);	
				
				КоманднаяСтрока = """""" + ВременныйКаталог + "gswin32c.exe""""" + " -dQUIET -dNOPROMPT -dBATCH -dNOPAUSE -sDEVICE=jpeg -r300 -sOutputFile=СЧФ.jpg " + ИД_Документа + ".pdf";
				СкриптVBS = новый ТекстовыйДокумент();	
				СкриптVBS.ДобавитьСтроку("Set WshShell = CreateObject(""WScript.Shell"")");
				СкриптVBS.ДобавитьСтроку("WshShell.Run """ + КоманднаяСтрока + """, 0");
				СкриптVBS.ДобавитьСтроку("Set WshShell = Nothing");
				СкриптVBS.Записать(ВременныйКаталог + "Скрипт.vbs", КодировкаТекста.ANSI);
				
				КодВозврата = Неопределено;
				Попытка
					ЗапуститьПриложение(ВременныйКаталог + "Скрипт.vbs", ВременныйКаталог, Истина, КодВозврата);
					
					РезультатВыполнения.Вставить("КаталогКартинкиЮЗД" , ВременныйКаталог);
					
				Исключение
					РезультатВыполнения.ЕстьОшибка = Истина;
					РезультатВыполнения.ТекстОшибки = "Отображение PDF на форме не поддерживается!";
					
				КонецПопытки;
				
			КонецЕсли;
			
		Иначе
			РезультатВыполнения.ЕстьОшибка = Истина;
			РезультатВыполнения.ТекстОшибки = "Не найден документ ЮЗД на платформе - " 
			+ СЧФНомер + " от " + СЧФДата + ". Попробуйте позже. " 
			+ "Код: " + Ошибка.КодОшибки + " - " + Ошибка.ТекстОшибки; 	
			
		КонецЕсли;
		
	Иначе
		РезультатВыполнения.ЕстьОшибка = Истина;
		РезультатВыполнения.ТекстОшибки = "Необходимо заполнить профиль обмена!"
		
	КонецЕсли;
	
	Возврат РезультатВыполнения;
	
КонецФункции  

Функция ПоказатьПечатнуюФормуЮЗД(КаталогКартинкиЮЗД) Экспорт
	
	РезультатВыполнения = Новый Структура;
	РезультатВыполнения.Вставить("ТекстОшибки", ""); 
	РезультатВыполнения.Вставить("Base64ДвоичныеДанныеСЧФ", ""); 
	
	ФайлКартинкиСЧФ = Новый Файл(КаталогКартинкиЮЗД + "СЧФ.jpg");		
	Если ФайлКартинкиСЧФ.Существует() Тогда
		
		Попытка
			ДвоичныеДанныеСЧФ = Новый ДвоичныеДанные(ФайлКартинкиСЧФ.ПолноеИмя);
			РезультатВыполнения.Вставить("Base64ДвоичныеДанныеСЧФ", Base64Строка(ДвоичныеДанныеСЧФ));
		Исключение
			РезультатВыполнения.ТекстОшибки = "Нет доступа к файлу!";						
		КонецПопытки;
	Иначе
		РезультатВыполнения.ТекстОшибки = "Файла не существует!";	
	КонецЕсли;		
	
	Если НЕ ЗначениеЗаполнено(РезультатВыполнения.ТекстОшибки) Тогда
		Попытка
			УдалитьФайлы(КаталогКартинкиЮЗД);
		Исключение				
		КонецПопытки;						
	КонецЕсли;
	
	Возврат РезультатВыполнения;
	
КонецФункции  

Функция ПолучитьДанныеПоЮЗД(ЭкомДокумент) Экспорт
	
	РезультатВыполнения = Новый Структура;
	РезультатВыполнения.Вставить("ЕстьОшибка"      , Ложь);
	РезультатВыполнения.Вставить("ПрофильОбмена"   , "");
	РезультатВыполнения.Вставить("ИдентификаторЮЗД", "");
	
	Запрос = Новый Запрос;
	Если ЭкомДокумент.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPR_01
		ИЛИ ЭкомДокумент.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPR_01_Испр
		ИЛИ ЭкомДокумент.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPRMARK_01
		ИЛИ ЭкомДокумент.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPRMARK_01_Испр
		ИЛИ ЭкомДокумент.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPRPROS_01		  
		ИЛИ ЭкомДокумент.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPRPROS_01_Испр 
		ИЛИ ЭкомДокумент.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NKORSCHFDOPPR_01
		ИЛИ ЭкомДокумент.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NKORSCHFDOPPR_01_Испр
		ИЛИ ЭкомДокумент.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NKORSCHFDOPPRMARK_01
		ИЛИ ЭкомДокумент.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NKORSCHFDOPPRMARK_01_Испр
		ИЛИ ЭкомДокумент.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NKORSCHFDOPPRPROS_01
		ИЛИ ЭкомДокумент.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NKORSCHFDOPPRPROS_01_Испр Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЭКОМ_GLN.ПрофильОбмена КАК ПрофильОбмена,
		|	ЭКОМ_GLN.Объект КАК Организация,
		|	&ИдентификаторЮЗД КАК ИдентификаторЮЗД
		|ИЗ
		|	РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN
		|ГДЕ
		|	НЕ ЭКОМ_GLN.ПрофильОбмена = ЗНАЧЕНИЕ(Справочник.ЭКОМ_ПрофилиОбмена.ПустаяСсылка)
		|	И НЕ ЭКОМ_GLN.ПрофильОбмена.ПометкаУдаления И ЭКОМ_GLN.ПрофильОбмена.Активный = ИСТИНА 
		|	И ЭКОМ_GLN.Объект = &Организация";
		Запрос.УстановитьПараметр("Организация", ЭкомДокумент.Организация);
		Запрос.УстановитьПараметр("ИдентификаторЮЗД", ЭкомДокумент.НомерТранзакции);
		
	ИначеЕсли ЭкомДокумент.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ORDER_Входящий
		ИЛИ ЭкомДокумент.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.RECADV_Входящий Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЭКОМ_GLN.ПрофильОбмена КАК ПрофильОбмена,
		|	ЭКОМ_GLN.Объект КАК Организация,
		|	ВЫБОР
		|		КОГДА ЭКОМ_ЦепочкиДокументовПоставщика.ИдентификаторСчФ_Кор = """"
		|				ИЛИ ЭКОМ_ЦепочкиДокументовПоставщика.ИдентификаторСчФ_Кор = НЕОПРЕДЕЛЕНО
		|				ИЛИ ЭКОМ_ЦепочкиДокументовПоставщика.ИдентификаторСчФ_Кор ЕСТЬ NULL
		|			ТОГДА ЭКОМ_ЦепочкиДокументовПоставщика.ИдентификаторСчФ
		|		ИНАЧЕ ЭКОМ_ЦепочкиДокументовПоставщика.ИдентификаторСчФ_Кор
		|	КОНЕЦ КАК ИдентификаторЮЗД
		|ИЗ
		|	РегистрСведений.ЭКОМ_ЦепочкиДокументовПоставщика КАК ЭКОМ_ЦепочкиДокументовПоставщика
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN
		|		ПО ЭКОМ_ЦепочкиДокументовПоставщика.Организация = ЭКОМ_GLN.Объект
		|ГДЕ
		|	НЕ ЭКОМ_GLN.ПрофильОбмена = ЗНАЧЕНИЕ(Справочник.ЭКОМ_ПрофилиОбмена.ПустаяСсылка)
		|	И НЕ ЭКОМ_GLN.ПрофильОбмена.ПометкаУдаления И ЭКОМ_GLN.ПрофильОбмена.Активный = ИСТИНА
		|	И ВЫБОР
		|			КОГДА &ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.ORDER_Входящий)
		|				ТОГДА ЭКОМ_ЦепочкиДокументовПоставщика.ORDER = &ЭкомДок
		|			КОГДА &ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.RECADV_Входящий)
		|				ТОГДА ЭКОМ_ЦепочкиДокументовПоставщика.RECADV = &ЭкомДок
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ";
		Запрос.УстановитьПараметр("ЭкомДок", ЭкомДокумент.Ссылка);
		Запрос.УстановитьПараметр("ВидДокумента", ЭкомДокумент.ВидДокумента );
		
	ИначеЕсли ЭкомДокумент.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ORDRSP_Входящий
		ИЛИ ЭкомДокумент.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DESADV_Входящий Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЭКОМ_GLN.ПрофильОбмена КАК ПрофильОбмена,
		|	ЭКОМ_GLN.Объект КАК Организация,
		|	ВЫБОР
		|		КОГДА ЭКОМ_ЦепочкиДокументовПокупателя.ИдентификаторСчФ_Основание = """"
		|				ИЛИ ЭКОМ_ЦепочкиДокументовПокупателя.ИдентификаторСчФ_Основание = НЕОПРЕДЕЛЕНО
		|				ИЛИ ЭКОМ_ЦепочкиДокументовПокупателя.ИдентификаторСчФ_Основание ЕСТЬ NULL
		|			ТОГДА ЭКОМ_ЦепочкиДокументовПокупателя.ИдентификаторСчФ
		|		ИНАЧЕ ЭКОМ_ЦепочкиДокументовПокупателя.ИдентификаторСчФ_Основание
		|	КОНЕЦ КАК ИдентификаторЮЗД
		|ИЗ
		|	РегистрСведений.ЭКОМ_ЦепочкиДокументовПокупателя КАК ЭКОМ_ЦепочкиДокументовПокупателя
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN
		|		ПО ЭКОМ_ЦепочкиДокументовПокупателя.Организация = ЭКОМ_GLN.Объект
		|ГДЕ
		|	НЕ ЭКОМ_GLN.ПрофильОбмена = ЗНАЧЕНИЕ(Справочник.ЭКОМ_ПрофилиОбмена.ПустаяСсылка)
		|	И НЕ ЭКОМ_GLN.ПрофильОбмена.ПометкаУдаления
		|	И ЭКОМ_GLN.ПрофильОбмена.Активный = ИСТИНА
		|	И ВЫБОР
		|			КОГДА &ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.ORDRSP_Входящий)
		|				ТОГДА ЭКОМ_ЦепочкиДокументовПокупателя.ORDRSP = &ЭкомДок
		|			КОГДА &ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.DESADV_Входящий)
		|				ТОГДА ЭКОМ_ЦепочкиДокументовПокупателя.DESADV = &ЭкомДок
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ";
		Запрос.УстановитьПараметр("ЭкомДок", ЭкомДокумент.Ссылка);
		Запрос.УстановитьПараметр("ВидДокумента", ЭкомДокумент.ВидДокумента );
	Иначе
		РезультатВыполнения.ЕстьОшибка = Истина;
		
	КонецЕсли;
	
	Если РезультатВыполнения.ЕстьОшибка = Ложь Тогда
		
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			РезультатВыполнения.Вставить("ПрофильОбмена", Выборка.ПрофильОбмена);
			РезультатВыполнения.Вставить("ИдентификаторЮЗД", Выборка.ИдентификаторЮЗД);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат РезультатВыполнения;
	
КонецФункции

// Статус документа из регистра ЭКОМ_Объекты_События 
Функция ДанныеПоДокументу(ЭкомДокументСсылка) Экспорт
	
	ДанныеПоДокументу = Новый Структура;
	ДанныеПоДокументу.Вставить("Статус", Перечисления.ЭКОМ_Статусы.ПустаяСсылка());
	ДанныеПоДокументу.Вставить("ТекстОшибки", "");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЭКОМ_Объекты_События.Статус,
	|	ЭКОМ_Объекты_События.ТекстОшибки
	|ИЗ
	|	РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_События
	|ГДЕ
	|	ЭКОМ_Объекты_События.Документ_Основание = &Документ_Основание
	|	И ЭКОМ_Объекты_События.ВидДокумента = &ВидДокумента";
	
	Запрос.УстановитьПараметр("ВидДокумента", ЭкомДокументСсылка.ВидДокумента);
	Запрос.УстановитьПараметр("Документ_Основание", ЭкомДокументСсылка);
	РезультатЗапроса = Запрос.Выполнить();	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();	
		ВыборкаДетальныеЗаписи.Следующий();
		
		ДанныеПоДокументу.Вставить("Статус", ВыборкаДетальныеЗаписи.Статус);
		ДанныеПоДокументу.Вставить("ТекстОшибки", ВыборкаДетальныеЗаписи.ТекстОшибки);
	КонецЕсли;
	
	Возврат ДанныеПоДокументу;
	
КонецФункции 

Процедура ЭКОМ_Объекты_События_Записать(п_Регистратор, п_ВидДокумента, п_Структура, ЗаписыватьПустыеЗначения = Ложь) Экспорт
	
	Блокировать = ПолучитьРежимУправленияБлокировкойДанныхПоУмолчанию(); 	
	// Установка блокировки
	НачатьТранзакцию();
	Попытка
		
		Если Блокировать = Истина Тогда
			БлокировкаДанных 		= Новый БлокировкаДанных;
			ЭлементБлокировки 		= БлокировкаДанных.Добавить("РегистрСведений.ЭКОМ_Объекты_События");
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			ЭлементБлокировки.УстановитьЗначение("Документ_Основание", п_Регистратор);
			ЭлементБлокировки.УстановитьЗначение("ВидДокумента", п_ВидДокумента);
			БлокировкаДанных.Заблокировать();	
		КонецЕсли;
		
		МЗ = РегистрыСведений.ЭКОМ_Объекты_События.СоздатьМенеджерЗаписи();
		МЗ.Документ_Основание  = п_Регистратор;
		МЗ.ВидДокумента        = п_ВидДокумента;
		МЗ.Прочитать();
		
		Если НЕ МЗ.Выбран() Тогда
			МЗ.Документ_Основание  = п_Регистратор;
			МЗ.ВидДокумента = п_ВидДокумента;
			МЗ.ДатаЗаписи = ТекущаяДата();	
		КонецЕсли;
		
		Для Каждого Элемент Из п_Структура Цикл
			
			Если ЗаписыватьПустыеЗначения Тогда
				МЗ[Элемент.Ключ] = Элемент.Значение; 	
			Иначе
				Если ЗначениеЗаполнено(Элемент.Значение) Тогда
					МЗ[Элемент.Ключ] = Элемент.Значение; 	
				КонецЕсли;
			КонецЕсли;	
			
		КонецЦикла;
		
		МЗ.Записать();
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();	
		ЗаписьЖурналаРегистрации("Обработка ""Интеграция ECOM""", УровеньЖурналаРегистрации.Ошибка, , , "Конфликт записи в регистр - " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры // ЭКОМ_Объекты_События_Записать()

Функция ПолучитьРежимУправленияБлокировкойДанныхПоУмолчанию() 
	
	// Автоматический - все транзакции, будут выполняться в автоматическом режиме.
	// АвтоматическийИУправляемый  - транзакции, будут выполняться в режиме, определяемом установкой соответствующего свойства объекта метаданных.
	// Управляемый - все транзакции, будут выполняться в управляемом режиме. 
	Блокировать = Ложь;
	Если Метаданные.РежимУправленияБлокировкойДанных = Метаданные.Свойстваобъектов.РежимУправленияБлокировкойДанныхПоУмолчанию.Управляемый Тогда
		Блокировать = Истина;
	КонецЕсли;
	
	Возврат Блокировать;
	
КонецФункции // ПолучитьРежимУправленияБлокировкойДанныхПоУмолчанию()

// Позволяет получить индекс картинки состояния документа из коллекции СостоянияДокумента
// по свойствам Проведен/ПометкаУдаления/РучнаяКорректировка
//
// Параметры:
// Объект - основной реквизит формы документа, с типом ДанныеФормыСтруктура
//
Функция СостояниеДокумента(Объект) Экспорт
	
	Если Объект.ПометкаУдаления Тогда
		СостояниеДокумента = 2;
	ИначеЕсли Объект.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.Обработан Тогда
		СостояниеДокумента = 1;
	Иначе
		СостояниеДокумента = 0;
	КонецЕсли;
	
	Возврат СостояниеДокумента;
	
КонецФункции

// При записи запрещается изменять содержимое объекта, так как объект уже записан в базу, есть ссылка.
Процедура ПриЗаписи(Отказ)
	
	// Отказ от выполнения действий подписки, если нужно только записать документ.
	Если НеВыполнятьКодПриЗаписи = Истина Тогда
		Возврат;
	КонецЕсли;
	
	// ORDER входящий для поставщика.
	Если ЭтотОбъект.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ORDER_Входящий Тогда
		//Docrobot 1.20.0 MOD-1602
		Если ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере("ВыполнятьПодпискиИзНастроек_ORDER_Входящий",Ложь) = Ложь Тогда 	
		
			Если ЭтотОбъект.АктуальныйДокумент Тогда
			
			ИмяЦепочки = "ЭКОМ_ЦепочкиДокументовПоставщика";
			
			ЗаписьНайдена = Ложь;
			
			// 1. Поиск по текущему документу
			НаборЗаписей = РегистрыСведений[ИмяЦепочки].СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ORDER.Установить(ЭтотОбъект.Ссылка); // поле проиндексировано
			// Выполним блокировку данных
			ЭКОМ_ПодпискаСобытий.ВыполнитьБлокировкуНабораЗаписей(НаборЗаписей.Отбор, ИмяЦепочки);				 
			НаборЗаписей.Прочитать();
			Если НЕ НаборЗаписей.Количество() = 0 Тогда
				ЗаписьНайдена = Истина;
			КонецЕсли;
			
			// 2. Для корректировок и удаленных ищем по точному совпадению даты, организации и контрагента с дальнейшим отбором по номеру заказа (полагаем, что дата заказа не менялась).
			// Обязательные
			Если НЕ ЗаписьНайдена Тогда
				КоличествоОбязательныхОтборов = 3;
				ОбязательныеДанныеОтбораЗаполнены = Новый Массив; 				
				Если ЗначениеЗаполнено(ЭтотОбъект.ЗаказДата) Тогда
					ОбязательныеДанныеОтбораЗаполнены.Добавить("ORDERDATE");
				КонецЕсли;	
				Если ЗначениеЗаполнено(ЭтотОбъект.ЗаказНомер) Тогда
					ОбязательныеДанныеОтбораЗаполнены.Добавить("ORDERNUMBER");
				КонецЕсли;
				Если ЗначениеЗаполнено(ЭтотОбъект.Контрагент) Тогда
					ОбязательныеДанныеОтбораЗаполнены.Добавить("Контрагент");
				КонецЕсли;
				
				СтруктураОтбора = Новый Структура;
				СтруктураОтбора.Вставить("ORDERDATE"    , ЭтотОбъект.ЗаказДата);
				СтруктураОтбора.Вставить("ORDERNUMBER"  , ЭтотОбъект.ЗаказНомер);
				СтруктураОтбора.Вставить("Организация"  , ЭтотОбъект.Организация);
				СтруктураОтбора.Вставить("Контрагент"   , ЭтотОбъект.Контрагент);
				СтруктураОтбора.Вставить("ТочкаДоставки", ЭтотОбъект.ТочкаДоставки);
				Если ОбязательныеДанныеОтбораЗаполнены.Количество() = КоличествоОбязательныхОтборов Тогда 
					НаборЗаписей = РегистрыСведений[ИмяЦепочки].СоздатьНаборЗаписей();
					Для каждого Данные Из СтруктураОтбора Цикл
						Если ЗначениеЗаполнено(Данные.Значение) Тогда
							НаборЗаписей.Отбор[Данные.Ключ].Установить(Данные.Значение);
						КонецЕсли;
					КонецЦикла;
					
					// Выполним блокировку данных
					ЭКОМ_ПодпискаСобытий.ВыполнитьБлокировкуНабораЗаписей(НаборЗаписей.Отбор, ИмяЦепочки);				 
					НаборЗаписей.Прочитать();
					Если НаборЗаписей.Количество() = 1 Тогда // Если запись одна, значит нет разделения заказа
						ЗаписьНайдена = Истина;
					КонецЕсли;									
				КонецЕсли;			
			КонецЕсли;
			
			// 3. Для корректировок и удаленных ищем по приблизительной дате и точным номеру, организаци и контрагенту.
			Если НЕ ЗаписьНайдена Тогда
				КоличествоОбязательныхОтборов = 3;
				ОбязательныеДанныеОтбораЗаполнены = Новый Массив; 				
				Если ЗначениеЗаполнено(ЭтотОбъект.ЗаказНомер) Тогда
					ОбязательныеДанныеОтбораЗаполнены.Добавить("ORDERNUMBER");
				КонецЕсли;	
				Если ЗначениеЗаполнено(ЭтотОбъект.Организация) Тогда
					ОбязательныеДанныеОтбораЗаполнены.Добавить("Организация");
				КонецЕсли;
				Если ЗначениеЗаполнено(ЭтотОбъект.Контрагент) Тогда
					ОбязательныеДанныеОтбораЗаполнены.Добавить("Контрагент");
				КонецЕсли;	
				
				СтруктураОтбора = Новый Структура;
				СтруктураОтбора.Вставить("ORDERNUMBER"  , ЭтотОбъект.ЗаказНомер);
				СтруктураОтбора.Вставить("Организация"  , ЭтотОбъект.Организация);
				СтруктураОтбора.Вставить("Контрагент"   , ЭтотОбъект.Контрагент);
				СтруктураОтбора.Вставить("ТочкаДоставки", ЭтотОбъект.ТочкаДоставки);
				Если ОбязательныеДанныеОтбораЗаполнены.Количество() = КоличествоОбязательныхОтборов Тогда 
					НаборЗаписей = РегистрыСведений[ИмяЦепочки].СоздатьНаборЗаписей();
					Для каждого Данные Из СтруктураОтбора Цикл
						Если ЗначениеЗаполнено(Данные.Значение) Тогда
							НаборЗаписей.Отбор[Данные.Ключ].Установить(Данные.Значение);
						КонецЕсли;
					КонецЦикла;
					
					// Выполним блокировку данных
					ЭКОМ_ПодпискаСобытий.ВыполнитьБлокировкуНабораЗаписей(НаборЗаписей.Отбор, ИмяЦепочки);				 
					НаборЗаписей.Прочитать();
					Если НЕ НаборЗаписей.Количество() = 0 Тогда
						ЗаписиДляУдаления = Новый Массив;
						Для Каждого НоваяЗапись Из НаборЗаписей Цикл
							Если НЕ ЭтотОбъект.ЗаказНомер = НоваяЗапись.ORDERNUMBER Тогда
								ЗаписиДляУдаления.Добавить(НоваяЗапись);
							КонецЕсли;
						КонецЦикла;
						
						Для Каждого ЗаписьДляУдаления Из ЗаписиДляУдаления Цикл
							НаборЗаписей.Удалить(ЗаписьДляУдаления);
						КонецЦикла;
						
						Для Каждого НоваяЗапись Из НаборЗаписей Цикл
							Если НачалоДня(ЭтотОбъект.ЗаказДата) >= ДобавитьМесяц(НачалоДня(НоваяЗапись.ORDERDATE), -2)  Тогда         
								ЗаписьНайдена = Истина;
								Прервать;
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;							
				КонецЕсли;
			КонецЕсли;
			
			// 4. Для ситуации когда загрудыем документы после сопоставления (Контрагент/ТочкаДоставки). 
			//Ищем записи по точным Организации, ORDERNUMBER и приблизительной дате, с проверкой на значение xmlКонтрагент и xmlТочкаДоставки.
			Если НЕ ЗаписьНайдена Тогда
				КоличествоОбязательныхОтборов = 2;
				ОбязательныеДанныеОтбораЗаполнены = Новый Массив; 				
				Если ЗначениеЗаполнено(ЭтотОбъект.ЗаказНомер) Тогда
					ОбязательныеДанныеОтбораЗаполнены.Добавить("ORDERNUMBER");
				КонецЕсли;	
				Если ЗначениеЗаполнено(ЭтотОбъект.Организация) Тогда
					ОбязательныеДанныеОтбораЗаполнены.Добавить("Организация");
				КонецЕсли;
				
				СтруктураОтбора = Новый Структура;
				СтруктураОтбора.Вставить("ORDERNUMBER"  , ЭтотОбъект.ЗаказНомер);
				СтруктураОтбора.Вставить("Организация"  , ЭтотОбъект.Организация);
				Если ОбязательныеДанныеОтбораЗаполнены.Количество() = КоличествоОбязательныхОтборов Тогда 
					НаборЗаписей = РегистрыСведений[ИмяЦепочки].СоздатьНаборЗаписей();
					Для каждого Данные Из СтруктураОтбора Цикл
						Если ЗначениеЗаполнено(Данные.Значение) Тогда
							НаборЗаписей.Отбор[Данные.Ключ].Установить(Данные.Значение);
						КонецЕсли;
					КонецЦикла;
					
					// Выполним блокировку данных
					ЭКОМ_ПодпискаСобытий.ВыполнитьБлокировкуНабораЗаписей(НаборЗаписей.Отбор, ИмяЦепочки);				 
					НаборЗаписей.Прочитать();
					Если НЕ НаборЗаписей.Количество() = 0 Тогда
						ЗаписиДляУдаления = Новый Массив;
						Для Каждого НоваяЗапись Из НаборЗаписей Цикл
							Если НЕ ЭтотОбъект.ЗаказНомер = НоваяЗапись.ORDERNUMBER Тогда
								ЗаписиДляУдаления.Добавить(НоваяЗапись);
							КонецЕсли;
						КонецЦикла;
						
						Для Каждого ЗаписьДляУдаления Из ЗаписиДляУдаления Цикл
							НаборЗаписей.Удалить(ЗаписьДляУдаления);
						КонецЦикла;
						
						Для Каждого НоваяЗапись Из НаборЗаписей Цикл
							Если НачалоДня(ЭтотОбъект.ЗаказДата) >= ДобавитьМесяц(НачалоДня(НоваяЗапись.ORDERDATE), -2) И (ЭтотОбъект.xmlКонтрагент = НоваяЗапись.xmlКонтрагент) И (ЭтотОбъект.xmlТочкаДоставки = НоваяЗапись.xmlТочкаДоставки) Тогда         
								ЗаписьНайдена = Истина;
								Прервать;
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;							
				КонецЕсли;
			КонецЕсли;

			ДанныеИзмерений = Новый Структура;
			ДанныеИзмерений.Вставить("ORDER"        , ЭтотОбъект.Ссылка);
			ДанныеИзмерений.Вставить("ТочкаДоставки", ЭтотОбъект.ТочкаДоставки);
			
			//Docrobot 1.20.0 MOD-1427 [Если корректировочный заказ, то переписываем дату заказа]
			Если ЭтотОбъект.ТипДокумента = "R" Тогда 
				ДанныеИзмерений.Вставить("ORDERDATE", ЭтотОбъект.ЗаказДата );	
			КонецЕсли;
			
			Если НЕ ЗаписьНайдена Тогда // Только для первичного документа, далее не меняем.
				ДанныеИзмерений.Вставить("ORDERDATE"    , ЭтотОбъект.ЗаказДата);
				ДанныеИзмерений.Вставить("ORDERNUMBER"  , ЭтотОбъект.ЗаказНомер);
				ДанныеИзмерений.Вставить("Организация"  , ЭтотОбъект.Организация);
				ДанныеИзмерений.Вставить("Контрагент"   , ЭтотОбъект.Контрагент);
			КонецЕсли;
			
			ДанныеРесурсов = Новый Структура;
			ДанныеРесурсов.Вставить("xmlОрганизация"  , ЭтотОбъект.xmlОрганизация);
			ДанныеРесурсов.Вставить("xmlКонтрагент"   , ЭтотОбъект.xmlКонтрагент);
			ДанныеРесурсов.Вставить("xmlТочкаДоставки", ЭтотОбъект.xmlТочкаДоставки);
			ДанныеРесурсов.Вставить("ДатаПоставки"    , ЭтотОбъект.ДатаПоставки);
			ДанныеРесурсов.Вставить("КоличествоORDER" , ЭтотОбъект.ТЧ_Товары.Итог("КоличествоЗаказанное"));
			ДанныеРесурсов.Вставить("СуммаORDER"      , ЭтотОбъект.ТЧ_Товары.Итог("Сумма_с_НДС"));
			ДанныеРесурсов.Вставить("ТекстОшибки"     , ЭтотОбъект.ТекстОшибки);
			ДанныеРесурсов.Вставить("Статус_ORDER"    , ПредопределенноеЗначение("Перечисление.ЭКОМ_СтатусыЭлектронныхДокументов.Получен"));
			
			Если ЗаписьНайдена Тогда // Если существует документ в регистре
				Для Каждого НоваяЗапись Из НаборЗаписей Цикл
						
					Если НЕ ЗначениеЗаполнено(НоваяЗапись.Контрагент) Тогда
						ДанныеИзмерений.Вставить("Контрагент"   , ЭтотОбъект.Контрагент);
					КонецЕсли;
					
					Если НЕ ЗначениеЗаполнено(НоваяЗапись.Организация) Тогда
						ДанныеИзмерений.Вставить("Организация"  , ЭтотОбъект.Организация);
					КонецЕсли;

