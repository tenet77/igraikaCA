				ВидыДокументовЮЗД = Новый Массив;
				ЭКОМ_ОбщегоНазначения.ПолучитьПервичныеВидыДокументовЮЗД(ВидыДокументовЮЗД);
				
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	ЭкомДокЮЗД.Ссылка КАК ЭКОМДокОснование,
				|	ЭКОМ_ЦепочкиДокументовПокупателя.Накладная КАК Накладная
				|ИЗ
				|	(ВЫБРАТЬ
				|		ЭКОМ_Документы.Ссылка КАК Ссылка
				|	ИЗ
				|		Документ.ЭКОМ_Документы КАК ЭКОМ_Документы
				|	ГДЕ
				|		ЭКОМ_Документы.СЧФДата = &СЧФДата
				|		И ЭКОМ_Документы.СЧФНомер = &СЧФНомер
				|		И ЭКОМ_Документы.ВидДокумента В(&ВидыДокументовЮЗД)) КАК ЭкомДокЮЗД
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_ЦепочкиДокументовПокупателя КАК ЭКОМ_ЦепочкиДокументовПокупателя
				|		ПО ЭкомДокЮЗД.Ссылка = ЭКОМ_ЦепочкиДокументовПокупателя.ЮЗД";
				
				Запрос.УстановитьПараметр("СЧФДата" , ЭтотОбъект.СЧФДата);
				Запрос.УстановитьПараметр("СЧФНомер", ЭтотОбъект.СЧФНомер);
				Запрос.УстановитьПараметр("ВидыДокументовЮЗД", ВидыДокументовЮЗД);
				
				РезультатЗапроса = Запрос.Выполнить();				
				Если НЕ РезультатЗапроса.Пустой() Тогда
					ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();				
					ВыборкаДетальныеЗаписи.Следующий();
					
					НаборЗаписейПоОснованию = РегистрыСведений[ИмяЦепочки].СоздатьНаборЗаписей();
					НаборЗаписейПоОснованию.Отбор.ЮЗД.Установить(ВыборкаДетальныеЗаписи.ЭКОМДокОснование); // поле проиндексировано
					// Выполним блокировку данных
					ЭКОМ_ПодпискаСобытий.ВыполнитьБлокировкуНабораЗаписей(НаборЗаписейПоОснованию.Отбор, ИмяЦепочки);		
					
					НаборЗаписейПоОснованию.Прочитать();
					Если НЕ НаборЗаписейПоОснованию.Количество() = 0 Тогда
						Для каждого ЗаписьПоОснованию Из НаборЗаписейПоОснованию Цикл
							НоваяЗапись = НаборЗаписей.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяЗапись, ЗаписьПоОснованию);
							НоваяЗапись.КоличествоКвитанций = 0;
							
							// Запись документа основания
							НоваяЗапись.ЮЗД_Основание = ВыборкаДетальныеЗаписи.ЭКОМДокОснование;
							
							// Меняем статусы
							НоваяЗапись.СтатусЮЗД = Перечисления.ЭКОМ_Статусы.ПустаяСсылка();
							
						КонецЦикла;
						ЗаписьНайдена = Истина;
					КонецЕсли;
				КонецЕсли;		
			КонецЕсли;
			
			
			ДанныеИзмерений = Новый Структура;
			ДанныеИзмерений.Вставить("ЮЗД"          , ЭтотОбъект.Ссылка);	
			ДанныеИзмерений.Вставить("Организация"  , ЭтотОбъект.Организация);
			ДанныеИзмерений.Вставить("Контрагент"   , ЭтотОбъект.Контрагент);
			ДанныеИзмерений.Вставить("ТочкаДоставки", ЭтотОбъект.ТочкаДоставки);
			ДанныеИзмерений.Вставить("СЧФ"          , ЭтотОбъект.Документ1С);
			ДанныеИзмерений.Вставить("Накладная"    , ДокументНакладная);
				
			ДанныеРесурсов = Новый Структура;
			ДанныеРесурсов.Вставить("СуммаСЧФ"      , ЭтотОбъект.ТЧ_Товары.Итог("Сумма_с_НДС"));
			ДанныеРесурсов.Вставить("ТекстОшибки"   , ЭтотОбъект.ТекстОшибки);
			
			Если ЗаписьНайдена = Ложь Тогда	
				
				// Записываем документ в первый раз
				ДанныеИзмерений.Вставить("ORDERDATE"    , ЭтотОбъект.СЧФДата);
				ДанныеИзмерений.Вставить("ORDERNUMBER"  , ЭтотОбъект.СЧФНомер);
				
				ДанныеРесурсов.Вставить("xmlОрганизация"  ,    ЭтотОбъект.xmlОрганизация);
				ДанныеРесурсов.Вставить("xmlКонтрагент"   ,    ЭтотОбъект.xmlКонтрагент);
				ДанныеРесурсов.Вставить("xmlТочкаДоставки",    ЭтотОбъект.xmlТочкаДоставки);
				ДанныеРесурсов.Вставить("КоличествоКвитанций", 0);
				
					
				ЭКОМ_ПодпискаСобытий.СформироватьЗаписьВРегистр(НаборЗаписей.Добавить(), ДанныеИзмерений, ДанныеРесурсов);
				
			Иначе
				// Если существует документ в регистре
				Для Каждого НоваяЗапись Из НаборЗаписей Цикл
					
					// Если данные уже были заполнены тогда не перезаполняем 
					Если ЗначениеЗаполнено(НоваяЗапись.xmlОрганизация) Тогда
						ДанныеРесурсов.Удалить("xmlОрганизация");
					КонецЕсли;
					Если ЗначениеЗаполнено(НоваяЗапись.xmlКонтрагент) Тогда
						ДанныеРесурсов.Удалить("xmlКонтрагент");
					КонецЕсли;
					Если ЗначениеЗаполнено(НоваяЗапись.xmlТочкаДоставки) Тогда
						ДанныеРесурсов.Удалить("xmlТочкаДоставки");
					КонецЕсли;
					
					ЭКОМ_ПодпискаСобытий.СформироватьЗаписьВРегистр(НоваяЗапись, ДанныеИзмерений, ДанныеРесурсов);					
				КонецЦикла;			
			КонецЕсли;		
			НаборЗаписей.Записать();														
		КонецЕсли;
		
    // Получатель - входящий ЭКОМ документ WHGOU_04_Входящий
	ИначеЕсли ЭтотОбъект.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.WHGOU_04_Входящий Тогда
		ИмяЦепочки = "ЭКОМ_ЦепочкиДокументовЭТРН";
		
		НаборЗаписей = РегистрыСведений[ИмяЦепочки].СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ДокументЭКОМ.Установить(ЭтотОбъект.Ссылка);
		
		ДанныеИзмерений = Новый Структура;
		ДанныеИзмерений.Вставить("ДокументЭКОМ"  , ЭтотОбъект.Ссылка);
		ДанныеИзмерений.Вставить("ИдФайлПервичн" , ЭтотОбъект.НомерТранзакции);
		ДанныеИзмерений.Вставить("ДатаЭТРН"      , ЭтотОбъект.ФайлДата);
		ДанныеИзмерений.Вставить("НомерЭТРН"     , ЭтотОбъект.ФайлНомер);		
		ДанныеИзмерений.Вставить("Организация"   , ЭтотОбъект.Организация);
		ДанныеИзмерений.Вставить("Контрагент"    , ЭтотОбъект.Контрагент);
		ДанныеИзмерений.Вставить("Перевозчик"    , ЭтотОбъект.ТочкаДоставки);
		ДанныеИзмерений.Вставить("Накладная"     , ЭтотОбъект.Документ1С);
		
		ДанныеРесурсов = Новый Структура;
		ДанныеРесурсов.Вставить("xmlОрганизация"        , ЭтотОбъект.xmlОрганизация);
		ДанныеРесурсов.Вставить("xmlКонтрагент"         , ЭтотОбъект.xmlКонтрагент);
		ДанныеРесурсов.Вставить("xmlТочкаДоставки"      , ЭтотОбъект.xmlТочкаДоставки);
		ДанныеРесурсов.Вставить("КоличествоORDER"       , ЭтотОбъект.ТЧ_Товары.Итог("КоличествоЗаказанное"));
		ДанныеРесурсов.Вставить("КоличествоГрузовыхМест", ЭтотОбъект.ТЧ_Товары.Итог("КоличествоПоставляемое"));
		ДанныеРесурсов.Вставить("Статус_WHGOU_04"       , Истина);
		ДанныеРесурсов.Вставить("ТекстОшибки"           , ЭтотОбъект.ТекстОшибки);
		
		//Выполним блокировку данных
		ЭКОМ_ПодпискаСобытий.ВыполнитьБлокировкуНабораЗаписей(НаборЗаписей.Отбор, ИмяЦепочки);
		
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() = 0 Тогда										
			// Записываем документ в первый раз
			
			НаборЗаписей = РегистрыСведений[ИмяЦепочки].СоздатьНаборЗаписей();
			Для каждого Данные Из ДанныеИзмерений Цикл
				Если ЗначениеЗаполнено(Данные.Значение) Тогда
					НаборЗаписей.Отбор[Данные.Ключ].Установить(Данные.Значение);
				КонецЕсли;
			КонецЦикла;
			// Выполним блокировку данных
			ЭКОМ_ПодпискаСобытий.ВыполнитьБлокировкуНабораЗаписей(НаборЗаписей.Отбор, ИмяЦепочки);				 
			НаборЗаписей.Прочитать();
			
			ЭКОМ_ПодпискаСобытий.СформироватьЗаписьВРегистр(НаборЗаписей.Добавить(), ДанныеИзмерений, ДанныеРесурсов);
			
		Иначе													
			// Если существует документ в регистре
			Для Каждого НоваяЗапись Из НаборЗаписей Цикл					
				ЭКОМ_ПодпискаСобытий.СформироватьЗаписьВРегистр(НоваяЗапись, ДанныеИзмерений, ДанныеРесурсов);					
			КонецЦикла;
			
		КонецЕсли;		
		НаборЗаписей.Записать();	
		
		// CONDRA 
	ИначеЕсли ЭтотОбъект.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.CONDRA_Входящий Тогда
		ИмяЦепочки = "ЭКОМ_ЦепочкиНеструктурированныхДокументов";
		
		МенеджерЗаписи = РегистрыСведений[ИмяЦепочки].СоздатьМенеджерЗаписи();
		МенеджерЗаписи.TRANSGUID = ЭтотОбъект.TRANSGUID;
		МенеджерЗаписи.Прочитать();
		
		Если НЕ МенеджерЗаписи.Выбран() Тогда // Новая запись
			МенеджерЗаписи.НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Входящий;
			МенеджерЗаписи.TRANSGUID		= ЭтотОбъект.TRANSGUID;
			МенеджерЗаписи.NUMBER			= ЭтотОбъект.ФайлНомер;
			МенеджерЗаписи.DATE				= ЭтотОбъект.ФайлДата;
			МенеджерЗаписи.DOCGUID			= ЭтотОбъект.DOCGUID;
			МенеджерЗаписи.DOCTYPE			= ЭтотОбъект.ТипДокумента;
			МенеджерЗаписи.ТипДокумента		= ЭтотОбъект.ТипДокументаCONDRA; 
			
			Разделитель = ЭКОМ_ОбщегоНазначения.ЭКОМ_Общее_ПолучитьРазделительПутиНаСервере();
			FILENAME = ЭтотОбъект.ИмяФайла;
			Позиция = 1;
			Пока Позиция > 0 Цикл 
				Позиция = Найти(FILENAME, Разделитель);  
				FILENAME = Сред(FILENAME, Позиция+1);
			КонецЦикла;         
			
			МенеджерЗаписи.FILENAME			= FILENAME;
			МенеджерЗаписи.xmlКонтрагент	= ЭтотОбъект.xmlКонтрагент;
			МенеджерЗаписи.Контрагент		= ЭтотОбъект.Контрагент;
			МенеджерЗаписи.xmlОрганизация 	= ЭтотОбъект.xmlОрганизация;
			МенеджерЗаписи.Организация		= ЭтотОбъект.Организация;
			МенеджерЗаписи.Сумма			= ЭтотОбъект.СуммаДокументаВсего;
			МенеджерЗаписи.CONTRACTNUMBER	= ЭтотОбъект.НомерДоговораНаПоставку;
			//Docrobot Сергей 
			МенеджерЗаписи.СрокПодписания	= ЭтотОбъект.СрокПодписания;
			//Docrobot Сергей
			
			Статус = Перечисления.ЭКОМ_СтатусыCONDRA.Получен;
			МенеджерЗаписи.ДокументОригинала = ЭтотОбъект.Ссылка;
		КонецЕсли;
		
		МенеджерЗаписи.ТекстОшибки 				= ЭтотОбъект.ТекстОшибки;
		МенеджерЗаписи.ДатаПоследнейТранзакции	= ЭтотОбъект.ДатаПринятияДокумента;
		
		Если ЭтотОбъект.Тип = "1" Тогда
			Статус = Перечисления.ЭКОМ_СтатусыCONDRA.Получен;
			МенеджерЗаписи.ДокументОригинала 	= ЭтотОбъект.Ссылка;
		ИначеЕсли ЭтотОбъект.Тип = "2" Тогда
			Статус = Перечисления.ЭКОМ_СтатусыCONDRA.Принят;
			МенеджерЗаписи.ДокументПринятия		= ЭтотОбъект.Ссылка;
		ИначеЕсли ЭтотОбъект.Тип = "3" Тогда
			Статус = Перечисления.ЭКОМ_СтатусыCONDRA.Отклонён;
			МенеджерЗаписи.ДокументОтклонения 	= ЭтотОбъект.Ссылка;
		ИначеЕсли ЭтотОбъект.Тип = "4" Тогда
			Статус = Перечисления.ЭКОМ_СтатусыCONDRA.Отозван;
			МенеджерЗаписи.ДокументОтзыва 		= ЭтотОбъект.Ссылка;
		КонецЕсли;
		
		МенеджерЗаписи.Статус = Статус;
		
		Если ЗначениеЗаполнено(Статус) Тогда
			МенеджерЗаписи.Действие = Перечисления.ЭКОМ_ТребуемоеДействиеCONDRA[Строка(Статус)];
		КонецЕсли;
		
		Если (МенеджерЗаписи.ДокументОригинала.Пустая() ИЛИ МенеджерЗаписи.ДокументОригинала.ПометкаУдаления)
			И (МенеджерЗаписи.ДокументПринятия.Пустая() ИЛИ МенеджерЗаписи.ДокументПринятия.ПометкаУдаления)
			И (МенеджерЗаписи.ДокументОтклонения.Пустая() ИЛИ МенеджерЗаписи.ДокументОтклонения.ПометкаУдаления)
			И (МенеджерЗаписи.ДокументОтзыва.Пустая() ИЛИ МенеджерЗаписи.ДокументОтзыва.ПометкаУдаления) Тогда
			// Удаляем запись если все документы цепочки помечены на удаление или отсутствуют.
			МенеджерЗаписи.Удалить();
		Иначе
			МенеджерЗаписи.Записать();
		КонецЕсли;
		
		// Прайс-Лист
	ИначеЕсли ЭтотОбъект.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.PRICAT_Исходящий
		ИЛИ ЭтотОбъект.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.PRICAT_Входящий Тогда 
		ИзменитьСтатусСобытияПоДокументуПрайсЛист();
		
		// RETINS входящий
	ИначеЕсли ЭтотОбъект.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.RETINS_Входящий Тогда
		//Docrobot 1.20.0 MOD-1602
		Если ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере("ВыполнятьПодпискиИзНастроек_RETINS_Входящий",Ложь) = Ложь Тогда 	

			НайденныеЗаписи = ПолучитьНаборЗаписейПоОтбору(ЭтотОбъект.Документ1С, "ВозвратнаяНакладная", "ЭКОМ_ЦепочкиДокументовПокупателя");
			Если НайденныеЗаписи.Получены Тогда
			ДанныеИзмерений = Новый Структура;
			ДанныеИзмерений.Вставить("RETINS"       , ЭтотОбъект.Ссылка);
			ДанныеИзмерений.Вставить("Организация"  , ЭтотОбъект.Организация);
			ДанныеИзмерений.Вставить("Контрагент"   , ЭтотОбъект.Контрагент);
			ДанныеИзмерений.Вставить("ТочкаДоставки", ЭтотОбъект.ТочкаДоставки);
			ДанныеИзмерений.Вставить("ORDERDATE"    , ЭтотОбъект.ЗаказДата);
			ДанныеИзмерений.Вставить("ORDERNUMBER"  , ЭтотОбъект.ЗаказНомер);
			
			ДанныеРесурсов = Новый Структура;
			ДанныеРесурсов.Вставить("КоличествоRETINS" , ЭтотОбъект.ТЧ_Товары.Итог("КоличествоПринятое"));
			ДанныеРесурсов.Вставить("СуммаRETINS"      , ЭтотОбъект.ТЧ_Товары.Итог("Сумма_с_НДС"));
			ДанныеРесурсов.Вставить("ТекстОшибки"      , ЭтотОбъект.ТекстОшибки);
			ДанныеРесурсов.Вставить("Статус_RETINS"    , Истина);
			
			Для Каждого НоваяЗапись Из НайденныеЗаписи.Записи Цикл					
				ЭКОМ_ПодпискаСобытий.СформироватьЗаписьВРегистр(НоваяЗапись, ДанныеИзмерений, ДанныеРесурсов);					
			КонецЦикла;
			
			НайденныеЗаписи.Записи.Записать();												
		КонецЕсли;  		

		КонецЕсли;
		
		//RETORD_Исходящий
	ИначеЕсли ЭтотОбъект.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.RETORD_Исходящий Тогда
		
		Если Не ЗначениеЗаполнено(ЭтотОбъект.СвязанныйDocrobotДокумент) Тогда
			//и не заполнено поле ордер
			
			ИмяЦепочки = "ЭКОМ_ЦепочкиДокументовПоставщика";
			
			ЗаписьНайдена = Ложь;
			
			// 1. Поиск по текущему документу
			НаборЗаписей = РегистрыСведений[ИмяЦепочки].СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ORDER.Установить(ЭтотОбъект.Ссылка); // поле проиндексировано
			// Выполним блокировку данных
			ЭКОМ_ПодпискаСобытий.ВыполнитьБлокировкуНабораЗаписей(НаборЗаписей.Отбор, ИмяЦепочки);				 
			НаборЗаписей.Прочитать();
			Если НЕ НаборЗаписей.Количество() = 0 Тогда
				ЗаписьНайдена = Истина;
			КонецЕсли;
			
			ДанныеИзмерений = Новый Структура;
			ДанныеИзмерений.Вставить("ORDER"        , ЭтотОбъект.Ссылка);
			ДанныеИзмерений.Вставить("ТочкаДоставки", ЭтотОбъект.ТочкаДоставки);
			
			Если НЕ ЗаписьНайдена Тогда // Только для первичного документа, далее не меняем.
				ДанныеИзмерений.Вставить("ORDERDATE"    , ЭтотОбъект.Дата);
				ДанныеИзмерений.Вставить("ORDERNUMBER"  , ЭтотОбъект.Номер);
				ДанныеИзмерений.Вставить("Организация"  , ЭтотОбъект.Организация);
				ДанныеИзмерений.Вставить("Контрагент"   , ЭтотОбъект.Контрагент);
			КонецЕсли;
			
			ДанныеРесурсов = Новый Структура;
			ДанныеРесурсов.Вставить("xmlОрганизация"  , ЭтотОбъект.xmlОрганизация);
			ДанныеРесурсов.Вставить("xmlКонтрагент"   , ЭтотОбъект.xmlКонтрагент);
			ДанныеРесурсов.Вставить("xmlТочкаДоставки", ЭтотОбъект.xmlТочкаДоставки);
			ДанныеРесурсов.Вставить("ДатаПоставки"    , ЭтотОбъект.ДатаПоставки);
			ДанныеРесурсов.Вставить("КоличествоORDER" , ЭтотОбъект.ТЧ_Товары.Итог("КоличествоЗаказанное"));
			ДанныеРесурсов.Вставить("СуммаORDER"      , ЭтотОбъект.ТЧ_Товары.Итог("Сумма_с_НДС"));
			ДанныеРесурсов.Вставить("ТекстОшибки"     , ЭтотОбъект.ТекстОшибки);
			//ДанныеРесурсов.Вставить("Статус_ORDER"    , ПредопределенноеЗначение("Перечисление.ЭКОМ_СтатусыЭлектронныхДокументов.Получен"));
			
			Если ЗаписьНайдена Тогда // Если существует документ в регистре
				Для Каждого НоваяЗапись Из НаборЗаписей Цикл
					
					Если НЕ ЗначениеЗаполнено(НоваяЗапись.Контрагент) Тогда
						ДанныеИзмерений.Вставить("Контрагент"   , ЭтотОбъект.Контрагент);
					КонецЕсли;
					
					Если НЕ ЗначениеЗаполнено(НоваяЗапись.Организация) Тогда
						ДанныеИзмерений.Вставить("Организация"  , ЭтотОбъект.Организация);
					КонецЕсли;
					
					ЭКОМ_ПодпискаСобытий.СформироватьЗаписьВРегистр(НоваяЗапись, ДанныеИзмерений, ДанныеРесурсов);					
				КонецЦикла;
			Иначе // Записываем документ в первый раз
				
				НаборЗаписей = РегистрыСведений[ИмяЦепочки].СоздатьНаборЗаписей();
				Для каждого Данные Из ДанныеИзмерений Цикл
					Если ЗначениеЗаполнено(Данные.Значение) Тогда
						НаборЗаписей.Отбор[Данные.Ключ].Установить(Данные.Значение);
					КонецЕсли;
				КонецЦикла;
				// Выполним блокировку данных
				ЭКОМ_ПодпискаСобытий.ВыполнитьБлокировкуНабораЗаписей(НаборЗаписей.Отбор, ИмяЦепочки);				 
				НаборЗаписей.Прочитать();
				
				ЭКОМ_ПодпискаСобытий.СформироватьЗаписьВРегистр(НаборЗаписей.Добавить(), ДанныеИзмерений, ДанныеРесурсов);				
			КонецЕсли;
			
			Если НаборЗаписей.Модифицированность() Тогда
				НаборЗаписей.Записать();
			КонецЕсли;
		Конецесли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ИзменитьСтатусСобытияПоДокументуПрайсЛист()
	
	Запрос = Новый Запрос;
	Если ЭтотОбъект.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.PRICAT_Исходящий 
		И НЕ ЭтотОбъект.УточнениеОПоставке = "9" Тогда				
		// Исходящий ответ на входящий прайс-лист
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЭКОМ_ДокументыВхПрайс.Ссылка,
		|	ЭКОМ_ДокументыВхПрайс.ВидДокумента,
		|	ВЫБОР
		|		КОГДА ЭКОМ_ДокументыИсхОтвет.УточнениеОПоставке = ""99""
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ЭКОМ_Статусы.ОтклоненПолностью)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ЭКОМ_Статусы.Подтвержден)
		|	КОНЕЦ КАК Статус
		|ИЗ
		|	Документ.ЭКОМ_Документы КАК ЭКОМ_ДокументыИсхОтвет
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭКОМ_Документы КАК ЭКОМ_ДокументыВхПрайс
		|		ПО ЭКОМ_ДокументыИсхОтвет.ФайлДата = ЭКОМ_ДокументыВхПрайс.ФайлДата
		|			И ЭКОМ_ДокументыИсхОтвет.ФайлНомер = ЭКОМ_ДокументыВхПрайс.ФайлНомер
		|			И (ЭКОМ_ДокументыВхПрайс.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.PRICAT_Входящий))
		|ГДЕ
		|	ЭКОМ_ДокументыИсхОтвет.Ссылка = &Ссылка";
		
	ИначеЕсли ЭтотОбъект.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.PRICAT_Входящий 
		И НЕ ЭтотОбъект.УточнениеОПоставке = "9" Тогда	
		// Входящий ответ на исходящий прайс-лист		
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЭКОМ_ДокументыИсхПрайс.Ссылка,
		|	ЭКОМ_ДокументыИсхПрайс.ВидДокумента,
		|	ВЫБОР
		|		КОГДА ЭКОМ_ДокументыВхОтвет.УточнениеОПоставке = ""99""
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ЭКОМ_Статусы.ОтклоненПолностью)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ЭКОМ_Статусы.Подтвержден)
		|	КОНЕЦ КАК Статус
		|ИЗ
		|	Документ.ЭКОМ_Документы КАК ЭКОМ_ДокументыВхОтвет
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭКОМ_Документы КАК ЭКОМ_ДокументыИсхПрайс
		|		ПО ЭКОМ_ДокументыВхОтвет.ФайлДата = ЭКОМ_ДокументыИсхПрайс.ФайлДата
		|			И ЭКОМ_ДокументыВхОтвет.ФайлНомер = ЭКОМ_ДокументыИсхПрайс.ФайлНомер
		|			И (ЭКОМ_ДокументыИсхПрайс.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.PRICAT_Исходящий))
		|ГДЕ
		|	ЭКОМ_ДокументыВхОтвет.Ссылка = &Ссылка";			
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Запрос.Текст) Тогда
		Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
		РезультатЗапроса = Запрос.Выполнить();		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Если ЗначениеЗаполнено(Выборка.Ссылка) Тогда
			Структура = Новый Структура;
			Структура.Вставить("Статус", Выборка.Статус);
			ЭКОМ_ОбщегоНазначения.ЭКОМ_Объекты_События_Записать(Выборка.Ссылка, Выборка.ВидДокумента, Структура);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Сформировать и отправить отклонение заказа (ORDRSP)

// Формирует и отправляет электронный документ ORDRSP из формы входящего ЭКОМ документа ORDER
//	Для успешной отправки обработка должна находиться либо в составе конфигурации, либо добавлена
//	в базу в качестве внешней обработки
//
// Параметры:
//  МассивЛогаСобытий  - Массив - коллекция записей лога событий
//
// Возвращаемое значение:
//   Структура   - результат отправки файла
//
Функция ОтклонитьЗаказ(МассивЛогаСобытий) Экспорт

	Ответ = Новый Структура("Успешно, АдресФайла, ИмяФайла", Ложь, "", "");
	
	СтруктураДокумента 	= СтруктураЭлектронногоДокумента();
	ЭлектронныйДокумент = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("ORDRSP", "ORDRSP"));
	МассивТегов = Новый Массив; 
	Попытка
		ЗаполнитьЭлектронныйДокумент(ЭлектронныйДокумент, СтруктураДокумента, МассивТегов);
		ЭлектронныйДокумент.Проверить();
	Исключение
		ТекстЛогаСобытий = "Ошибка при отклонении заказа " + Строка(Ссылка) + ". " + ОписаниеОшибки();
		ЗаписьСтруктурыЛога = ЭКОМ_ОбщегоНазначения.ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, "Отклонение заказа в документе Docrobot");
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		Возврат Ответ;
	КонецПопытки;

	КодировкаXML = "UTF-8";
	
	ЗаписьXML  = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку(КодировкаXML);
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ЭлектронныйДокумент);
	СтрокаXML = ЗаписьXML.Закрыть();
	
	ЭКОМ_ОбщегоНазначения.ОчиститьСтрокуXMLОтПустыхТегов(СтрокаXML, МассивТегов);
	
    Идентификатор	= "ORDRSP_" + Формат(ТекущаяДатаСеанса(), "ДФ=ггггММддЧЧммсс000") + "-OUT-"
		+ Формат(ЭКОМ_ОбщегоНазначения.НовыйНомерТранзакции(0), "ЧГ=0");
	ФайлИмя			= Идентификатор + ".xml";
	
	СтруктураEDI = Новый Структура;
	
	СтруктураEDI.Вставить("СтрокаXML", 			СтрокаXML);
	СтруктураEDI.Вставить("КодировкаФайла", 	КодировкаXML);
	СтруктураEDI.Вставить("Документ",           Ссылка);
	СтруктураEDI.Вставить("СтруктураДокумента", СтруктураДокумента);
	СтруктураEDI.Вставить("Отправлен",          Неопределено);
	СтруктураEDI.Вставить("Сообщение",          "");
	СтруктураEDI.Вставить("ЗаказДата",          ЗаказДата);					
	СтруктураEDI.Вставить("ЗаказНомер",         ЗаказНомер);
	СтруктураEDI.Вставить("Контрагент",         Контрагент);
	СтруктураEDI.Вставить("Организация",        Организация);
	СтруктураEDI.Вставить("ВидДокумента",       Перечисления.ЭКОМ_ВидыДокументов.ORDRSP_Исходящий);
	СтруктураEDI.Вставить("ИмяФайлаXML",        ФайлИмя);
	СтруктураEDI.Вставить("Статус",             Перечисления.ЭКОМ_Статусы.Отправлен);
	СтруктураEDI.Вставить("ТипФайла",           "ORDRSP");
	СтруктураEDI.Вставить("Идентификатор",      Идентификатор);
	СтруктураEDI.Вставить("НомерДокумента",     Номер);
	СтруктураEDI.Вставить("ДатаДокумента",      Дата);
	
	МассивСтруктур = Новый Массив;
	МассивСтруктур.Добавить(СтруктураEDI);
	
	ИмяХранилищаОбработки = "ХранилищеВнешнейОбработки";
	
	ОбработкаМетаданные = Метаданные.Обработки.Найти("ЭКОМ_Интеграция_EDI_ЮЗД");
	Если Метаданные.Справочники.Найти("ВнешниеОбработки") <> Неопределено Тогда 
		ВнешняяОбработка = Справочники.ВнешниеОбработки.НайтиПоНаименованию("Docrobot: Интеграция EDI", Истина);
	ИначеЕсли Метаданные.Справочники.Найти("ДополнительныеОтчетыИОбработки") <> Неопределено Тогда
		ВнешняяОбработка = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоНаименованию("Docrobot: Интеграция EDI", Истина);
		ИмяХранилищаОбработки = "ХранилищеОбработки";
	Иначе
		ВнешняяОбработка = Неопределено;
	КонецЕсли;
	СтруктураЛога		= ЭКОМ_ОбщегоНазначения.ПолучитьСтруктуруЛогаНаСервере();
	Если ОбработкаМетаданные <> Неопределено Тогда
		ОбработкаОбъект = Обработки.ЭКОМ_Интеграция_EDI_ЮЗД.Создать();
		ОбработкаОбъект.ОтправитьФайлы(МассивСтруктур, "ORDRSP", МассивЛогаСобытий, Ложь, Истина, СтруктураЛога);
		Ответ.Успешно = НЕ СтруктураЛога.ЕстьОшибка;
	ИначеЕсли ЗначениеЗаполнено(ВнешняяОбработка) Тогда
		ИмяФайла 	= ПолучитьИмяВременногоФайла(); 
		ДвоичныеДанные = ВнешняяОбработка[ИмяХранилищаОбработки].Получить(); 
		ДвоичныеДанные.Записать(ИмяФайла);
		ОбработкаОбъект = ВнешниеОбработки.Создать(ИмяФайла, Ложь);
		ОбработкаОбъект.ОтправитьФайлы(МассивСтруктур, "ORDRSP", МассивЛогаСобытий, Ложь, Истина, СтруктураЛога);
		УдалитьФайлы(ИмяФайла);
		Ответ.Успешно = НЕ СтруктураЛога.ЕстьОшибка;
	Иначе
		ТекстЛогаСобытий = "Обработка - 'Docrobot: Интеграция EDI' не найдена! Для успешного выполнения обработка должна быть либо в составе конфигурации, либо в числе внешних обработок базы.";
		ЗаписьСтруктурыЛога = ЭКОМ_ОбщегоНазначения.ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Информация, "Отклонение заказа в документе Docrobot");
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
	КонецЕсли;
	
	Если Ответ.Успешно Тогда
		
		Ответ.АдресФайла 	= ПоместитьВоВременноеХранилище(ПолучитьДвоичныеДанныеФайла(СтрокаXML), Новый УникальныйИдентификатор);
		Каталог = ОбработкаОбъект.Настройка_Параметр_Прочитать("ЭКОМ_Локальный_Каталог_OUTBOX_Архив",,,Истина);
		РазделительПути = ЭКОМ_ОбщегоНазначения.ЭКОМ_Общее_ПолучитьРазделительПутиНаСервере();
		Если Прав(Каталог, 1) <> РазделительПути Тогда
			Каталог = Каталог + РазделительПути;
		КонецЕсли;
		Ответ.ИмяФайла = Каталог + "ORDRSP" + РазделительПути + Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd") + РазделительПути + ФайлИмя;
		
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции // ОтклонитьЗаказ()

// <Описание функции>
//
// Параметры:
//  <Параметр1>  - <Тип.Вид> - <описание параметра>
//                 <продолжение описания параметра>
//  <Параметр2>  - <Тип.Вид> - <описание параметра>
//                 <продолжение описания параметра>
//
// Возвращаемое значение:
//   <Тип.Вид>   - <описание возвращаемого значения>
//
Функция ПолучитьДвоичныеДанныеФайла(ТекстФайла)

	ДвоиченыеДанные = Неопределено;
	
	Если ЭКОМ_ОбщегоНазначения.ВерсияПлатформыНаСервере() >= 8390 Тогда
	
		ПотокВПамяти = Новый ПотокВПамяти();
		ЗаписьДанных = Новый ЗаписьДанных(ПотокВПамяти);
		
		ЗаписьДанных.ЗаписатьСтроку(ТекстФайла);
		ЗаписьДанных.Закрыть();
		ДвоиченыеДанные = ПотокВПамяти.ЗакрытьИПолучитьДвоичныеДанные();
		
	Иначе
		
		Файл = Новый ТекстовыйДокумент;
		Файл.УстановитьТекст(ТекстФайла);
		ИмяФайла = ПолучитьИмяВременногоФайла();
		Файл.Записать(ИмяФайла);
		ДвоиченыеДанные = Новый ДвоичныеДанные(ИмяФайла);
		УдалитьФайлы(ИмяФайла);
		
	КонецЕсли;

	Возврат ДвоиченыеДанные;
	
КонецФункции // ПолучитьДвоичныеДанныеФайла()

// Рекурсивный метод для заполнения объекта XDTO по данным структуры исходящего электронного документа
//
// Параметры:
//  ОбъектXDTO  - ОбъектXDTO - объект для заполнения
//  Данные  - Структура - данные формируемого электронного документа
//
Процедура ЗаполнитьЭлектронныйДокумент(ОбъектXDTO, Данные, МассивТегов)

	Включить = "";
	Исключить = "";
	// Разделение значений на примитивные и комплексные типы.
	Для Каждого Элемент Из Данные Цикл
		Если ТипЗнч(Элемент.Значение) = Тип("Строка") Тогда
			Включить = Включить + ?(ПустаяСтрока(Включить), "", ", ") + Элемент.Ключ;
			МассивТегов.Добавить(Элемент.Ключ);
		Иначе
			Исключить = Исключить + ?(ПустаяСтрока(Исключить), "", ", ") + Элемент.Ключ;
		КонецЕсли;
	КонецЦикла;
	// Заполнение примитивных типов.
	ЗаполнитьЗначенияСвойств(ОбъектXDTO, Данные, Включить, Исключить);
	//Заполнение комплексных типов.
	Имена = СтрЗаменить(Исключить, ", " , Символы.ПС);
	Для НомерСтроки = 1 По СтрЧислоСтрок(Имена) Цикл
		Имя = СтрПолучитьСтроку(Имена, НомерСтроки);
		
		Значение = Неопределено;
		
		Если ПустаяСтрока(Имя)
			ИЛИ НЕ Данные.Свойство(Имя, Значение)
			ИЛИ Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		МассивТегов.Добавить(Имя);
		
		Если ТипЗнч(Значение) = Тип("Структура") Тогда // Подветви документа.
			ДочернийОбъектXDTO = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("ORDRSP", Имя));
			ЗаполнитьЭлектронныйДокумент(ДочернийОбъектXDTO, Значение, МассивТегов);
			ОбъектXDTO[Имя] = ДочернийОбъектXDTO;
		ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда // Списки документа.
			Для Каждого Строка Из Значение Цикл
				ДочернийОбъектXDTO = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("ORDRSP", Имя));
				ЗаполнитьЭлектронныйДокумент(ДочернийОбъектXDTO, Строка, МассивТегов);
				ОбъектXDTO[Имя].Добавить(ДочернийОбъектXDTO);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры // ЗаполнитьЭлектронныйДокумент()

// Возвращает структуру ORDRSP для отправки из ЭКОМ документа
//
// Возвращаемое значение:
//   Структура   - данные для создания электронного документа
//
Функция СтруктураЭлектронногоДокумента()

	POSITION = Новый Массив;
	
	Для Каждого Строка Из ТЧ_Товары Цикл
		
		СтруктураPOSITION = Новый Структура;
		
		СтруктураPOSITION.Вставить("POSITIONNUMBER", 		XMLСтрока(Строка.НомерСтроки));
		СтруктураPOSITION.Вставить("PRODUCT", 				XMLСтрока(Строка.НомерПродукта));
		СтруктураPOSITION.Вставить("DESCRIPTION", 			XMLСтрока(Строка.ОписаниеПродукта));
		СтруктураPOSITION.Вставить("PRODUCTTYPE", 			XMLСтрока(3));
		СтруктураPOSITION.Вставить("ORDEREDQUANTITY",		XMLСтрока(Строка.КоличествоЗаказанное));
		СтруктураPOSITION.Вставить("ACCEPTEDQUANTITY", 		XMLСтрока(0));
		СтруктураPOSITION.Вставить("REASONDECREACEQUANTITY",XMLСтрока(Строка.ПричинаОтказаТЧ));
		СтруктураPOSITION.Вставить("PACKINGQUANTITY",		XMLСтрока(Строка.КоличествоВФасовке));
		СтруктураPOSITION.Вставить("ORDRSPUNIT",			XMLСтрока(Строка.xmlЕдиницаИзмерения));
		
		POSITION.Добавить(СтруктураPOSITION);
		
	КонецЦикла;
	
	СтруктураHEAD = Новый Структура;
	
	СтруктураHEAD.Вставить("BUYER", 		XMLСтрока(xmlКонтрагент));
	СтруктураHEAD.Вставить("SUPPLIER", 		XMLСтрока(xmlОрганизация));
	СтруктураHEAD.Вставить("DELIVERYPLACE", XMLСтрока(xmlТочкаДоставки));
	СтруктураHEAD.Вставить("SENDER", 		XMLСтрока(xmlОрганизация));
	СтруктураHEAD.Вставить("RECIPIENT", 	XMLСтрока(xmlКонтрагент));
	СтруктураHEAD.Вставить("POSITION", 		POSITION);
	
	СтруктураЭД = Новый Структура;
	
	СтруктураЭД.Вставить("NUMBER", 						XMLСтрока(Номер));
	СтруктураЭД.Вставить("DATE", 						Формат(Дата, "ДФ=yyyy-MM-dd"));
	СтруктураЭД.Вставить("ORDERNUMBER", 				XMLСтрока(ЗаказНомер));
	СтруктураЭД.Вставить("ORDERDATE", 					Формат(ЗаказДата, "ДФ=yyyy-MM-dd"));
	СтруктураЭД.Вставить("ACTION", 						XMLСтрока(27));
	СтруктураЭД.Вставить("REASONDECREACEQUANTITYALL", 	XMLСтрока(ПричинаОтказа));
	СтруктураЭД.Вставить("HEAD", 						СтруктураHEAD);
	
	Возврат СтруктураЭД;
	
КонецФункции // СтруктураЭлектронногоДокумента()

// Проверяет, отправлялся ли ранее документ ORDRSP
//
// Возвращаемое значение:
//   Булево   - Истина, если отправка была
//
Функция ПодтверждениеЗаказаРанееОтправлялось() Экспорт
	
	НачатьТранзакцию();
	НайденныеЗаписи = ПолучитьНаборЗаписейПоОтбору(Ссылка, "ORDER", "ЭКОМ_ЦепочкиДокументовПоставщика");
	ЗафиксироватьТранзакцию();
	
	Если НЕ НайденныеЗаписи.Получены Тогда
		Возврат Ложь;
	Иначе
		Статус = НайденныеЗаписи.Записи.Получить(0).Статус_ORDRSP;
		Возврат Статус <> Перечисления.ЭКОМ_СтатусыЭлектронныхДокументов.ПустаяСсылка()
			И 	Статус <> Неопределено;
	КонецЕсли;

КонецФункции // ПодтверждениеЗаказаРанееОтправлялось()

Функция ПолучитьНаборЗаписейПоОтбору(ДокументПоискаСсылка, ИмяИзмеренияОтбора, ИмяЦепочки)
	Результат = Новый Структура;
	Результат.Вставить("Получены", Ложь);  	
	
	ДокументПоиска = Неопределено;
	Если ЗначениеЗаполнено(ДокументПоискаСсылка) Тогда
		ДокументПоиска = ДокументПоискаСсылка;
	КонецЕсли;
	
	
	НаборЗаписей = РегистрыСведений[ИмяЦепочки].СоздатьНаборЗаписей();      
	
	ЗаписьНайдена = Ложь;
	
	// 1. Поиск по документу
	Если ЗначениеЗаполнено(ДокументПоиска) Тогда
		НаборЗаписей.Отбор[ИмяИзмеренияОтбора].Установить(ДокументПоиска); //TODO: проверить индексируемость измерения ВозвратнаяНакладная /mod-1129
		
		ЭКОМ_ПодпискаСобытий.ВыполнитьБлокировкуНабораЗаписей(НаборЗаписей.Отбор, ИмяЦепочки);		
		
		НаборЗаписей.Прочитать();
		Если НЕ НаборЗаписей.Количество() = 0 Тогда
			ЗаписьНайдена = Истина;
		КонецЕсли;
	КонецЕсли;
	
	// 2. Поиск по дате и номеру заказа
	Если ЗаписьНайдена = Ложь Тогда		
		КоличествоОбязательныхОтборов = 2;
		ОбязательныеДанныеОтбораЗаполнены = Новый Массив; 				
		Если ЗначениеЗаполнено(ЭтотОбъект.ЗаказДата) Тогда
			ОбязательныеДанныеОтбораЗаполнены.Добавить("ORDERDATE");
		КонецЕсли;	
		Если ЗначениеЗаполнено(ЭтотОбъект.ЗаказНомер) Тогда
			ОбязательныеДанныеОтбораЗаполнены.Добавить("ORDERNUMBER");
		КонецЕсли;	
		
		// Обязательные отборы
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("ORDERDATE"    , ЭтотОбъект.ЗаказДата);
		СтруктураОтбора.Вставить("ORDERNUMBER"  , ЭтотОбъект.ЗаказНомер);
		СтруктураОтбора.Вставить("Организация"  , ЭтотОбъект.Организация);
		СтруктураОтбора.Вставить("Контрагент"   , ЭтотОбъект.Контрагент);
		СтруктураОтбора.Вставить("ТочкаДоставки", ЭтотОбъект.ТочкаДоставки);
		Если ОбязательныеДанныеОтбораЗаполнены.Количество() = КоличествоОбязательныхОтборов Тогда 
			НаборЗаписей = РегистрыСведений[ИмяЦепочки].СоздатьНаборЗаписей();
			Для каждого Данные Из СтруктураОтбора Цикл
				Если ЗначениеЗаполнено(Данные.Значение) Тогда
					НаборЗаписей.Отбор[Данные.Ключ].Установить(Данные.Значение);
				КонецЕсли;
			КонецЦикла;
			
			// Выполним блокировку данных
			ЭКОМ_ПодпискаСобытий.ВыполнитьБлокировкуНабораЗаписей(НаборЗаписей.Отбор, ИмяЦепочки);				 
			НаборЗаписей.Прочитать();
			Если НаборЗаписей.Количество() = 1 Тогда // Если запись одна, значит нет разделения заказа
				ЗаписьНайдена = Истина;
			КонецЕсли;											
		КонецЕсли;				
	КонецЕсли;
	
	Если ЗаписьНайдена Тогда
		Результат.Получены = Истина;
		Результат.Вставить("Записи", НаборЗаписей);
	КонецЕсли;
	
	Возврат Результат;
КонецФункции


