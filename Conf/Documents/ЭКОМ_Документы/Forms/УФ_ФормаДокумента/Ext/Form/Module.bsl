Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница.Имя = "ГруппаПредпросмотрДокументаCONDRA" 
		И НЕ Объект.ВидДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.CONDRA_Входящий") Тогда
		ПоказатьИндикаторНТМL("");
		ПодключитьОбработчикОжидания("ОбновитьПечатнуюФормуЮЗД", 3, Истина); // однократно
		
	// MOD-1455	
	ИначеЕсли  ТекущаяСтраница.Имя = "ГруппаТовары" 
		И Объект.ВидДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.ORDER_Входящий") Тогда 

		Для каждого Колонка из ТекущаяСтраница.ПодчиненныеЭлементы.ТЧ_Товары.ПодчиненныеЭлементы Цикл
			Если Колонка.Имя = "ТЧ_ТоварыКоличествоПоставляемое" Тогда
			Иначе
				Колонка.Доступность = Ложь;	
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли; 

