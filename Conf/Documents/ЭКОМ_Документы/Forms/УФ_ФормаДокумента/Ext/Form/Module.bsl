//Docrobot 1.21.0 MOD-1648
&НаКлиенте
Процедура ТЧ_ТоварыОбратныйЗаказСтрокаПриИзменении(Элемент)
	СтрокаТЧ = Элементы.ТЧ_ТоварыОбратныйЗаказ.ТекущиеДанные;
	СтрокаТЧ.Сумма = СтрокаТЧ.КоличествоПоставляемое * СтрокаТЧ.Цена;
	СтрокаТЧ.ЦенаСНДС = СтрокаТЧ.Цена * (100 + СтрокаТЧ.СтавкаНДС)/100;
	СтрокаТЧ.Сумма_с_НДС = СтрокаТЧ.КоличествоПоставляемое * СтрокаТЧ.ЦенаСНДС;
	СтрокаТЧ.СуммаНДС = СтрокаТЧ.Сумма_с_НДС - СтрокаТЧ.Сумма;
КонецПроцедуры

&НаСервере
Процедура СогласованоПриИзмененииНаСервере()
	
	Если Объект.Согласовано = Истина Тогда 
		Объект.ОтветственныйCondra = Пользователи.ТекущийПользователь();
	Иначе
		Объект.ОтветственныйCondra = Справочники.Пользователи.ПустаяСсылка();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СогласованоПриИзменении(Элемент)
	СогласованоПриИзмененииНаСервере();
КонецПроцедуры

