&НаКлиенте
Процедура ВыполнитьПослеВыбора(ВыбранныйЭлемент, ПараметрыОповещения) Экспорт 
	
	Элемент = ПараметрыОповещения.Элемент;
	
	Если НЕ ВыбранныйЭлемент = Неопределено Тогда
		
		Если Элемент.Имя = "ТЧ_ТоварыПричинаОтказаТЧ" Тогда			
			ЭтаФорма.Элементы.ТЧ_Товары.ТекущиеДанные.ПричинаОтказаТЧ = ВыбранныйЭлемент.Значение;
			 
		ИначеЕсли Элемент.Имя = "ПричинаОтказа" Тогда			
			Объект.ПричинаОтказа = ВыбранныйЭлемент.Значение;
			
		ИначеЕсли Элемент.Имя = "ПрайсЛистТребуемоеДействие" Тогда			
			ЭтаФорма.Элементы.ПрайсЛист.ТекущиеДанные.ТребуемоеДействие = ВыбранныйЭлемент.Значение;

		ИначеЕсли Элемент.Имя = "УточнениеОПоставкеПрайсЛист" Тогда			
			Объект.УточнениеОПоставке = ВыбранныйЭлемент.Значение;
            Элементы.НадписьТипДействияПрайсЛиста.Заголовок = ПолучитьИмяТипДействияПрайсЛиста(ВыбранныйЭлемент);;
			
		КонецЕсли;
           
	КонецЕсли;
	
КонецПроцедуры
 
&НаСервере
Функция ЭКОМ_GLN_Прочитать(п_Объект) Экспорт 
	Структура = Новый Структура;
	МенеджерЗаписи        = РегистрыСведений.ЭКОМ_GLN.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Объект = п_Объект;
	МенеджерЗаписи.Прочитать();

	Если МенеджерЗаписи.Выбран() Тогда	
		Структура.Вставить("СведенияЕсть", Истина);
		Для каждого Данные Из Метаданные.РегистрыСведений.ЭКОМ_GLN.Ресурсы  Цикл
			        Структура.Вставить(Данные.Имя, МенеджерЗаписи[Данные.Имя]);		
		КонецЦикла;
		Структура.Вставить("Комментарий"                 , МенеджерЗаписи.Комментарий);		
	Иначе
		Структура.Вставить("СведенияЕсть"                , Ложь);
	КонецЕсли;
		
	Возврат Структура;
	
КонецФункции

&НаКлиенте
Процедура ОтчетПоМаркировке(Команда)
	
    Результат = ОтчетПоМаркировкеНаСервере();

	Результат.ОтображатьЗаголовки = Ложь;
	Результат.ОтображатьСетку = Ложь;
	Результат.Показать();

КонецПроцедуры

&НаСервере
Функция ОтчетПоМаркировкеНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");

	//Получаем схему из макета
	СхемаКомпоновкиДанных = ОбработкаОбъект.ПолучитьМакет("ОтчетПоМаркировке");
	
	//создадим компоновщик настроек и загрузим настройки по умолчанию, вместо настроек по умолчанию можно использовать восстановленные настройки
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных();
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных));
	КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	Настройки = КомпоновщикНастроек.Настройки;
	
	//установка параметров отчета, без КомпоновщикНастроекКомпоновкиДанных делать это гораздо сложнее
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Ссылка", Объект.Ссылка);
	Настройки.ПараметрыВывода.УстановитьЗначениеПараметра("Заголовок"  , "Отчет по маркировке");
	
	//Помещаем в переменную данные о расшифровке данных - здесь ненужный пункт, но пусть будет.
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	
	//Формируем макет, с помощью компоновщика макета
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	//Передаем в макет компоновки схему, настройки и данные расшифровки
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);
	
	//Выполним компоновку с помощью процессора компоновки
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки);
	
	//Очищаем поле табличного документа
	Результат = Новый ТабличныйДокумент();
	//Выводим результат в табличный документ
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(Результат);	
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура КомандаОткрытьКаталогCONDRA(Команда)
	
    Файл = Новый Файл(Объект.ИмяФайла);
	
	Если Файл.Существует() И Файл.ЭтоФайл() Тогда
		ЗапуститьПриложение("C:\Windows\explorer.exe /select, " + Файл.ПолноеИмя);
	Иначе
		Элементы.КомандаОткрытьКаталогCONDRA.Доступность = Ложь;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Файл не найден";
		Сообщение.Поле = "Объект.ИмяФайла";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзмененитьИмяВидимостьКолонокТабличнойЧасти()
	
	Элементы.ТЧ_ТоварыКоличествоПринятое.Видимость = Истина;
	
	// Видимость колонок при маркировке
	Если Элементы.ГруппаМаркировка.Видимость = Истина Тогда
		Если Объект.ВидДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.ON_KORSCHFDOPPR_01") 
			ИЛИ Объект.ВидДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.ON_KORSCHFDOPPR_01_Испр")
			ИЛИ Объект.ВидДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.ON_NKORSCHFDOPPRMARK_01") 
			ИЛИ Объект.ВидДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.ON_NKORSCHFDOPPRMARK_01_Испр") Тогда   
			Элементы.ТЧ_Маркировка.ПодчиненныеЭлементы.ТЧ_МаркировкаГруппаКИН.ПодчиненныеЭлементы.ТЧ_МаркировкаНомУпак_До.Видимость         = Истина;
			Элементы.ТЧ_Маркировка.ПодчиненныеЭлементы.ТЧ_МаркировкаГруппаКИЗ.ПодчиненныеЭлементы.ТЧ_МаркировкаКИЗ_До.Видимость             = Истина;
			Элементы.ТЧ_Маркировка.ПодчиненныеЭлементы.ТЧ_МаркировкаГруппаКИТУ.ПодчиненныеЭлементы.ТЧ_МаркировкаИдентТрансУпак_До.Видимость = Истина;		
		Иначе
			Элементы.ТЧ_Маркировка.ПодчиненныеЭлементы.ТЧ_МаркировкаГруппаКИН.ПодчиненныеЭлементы.ТЧ_МаркировкаНомУпак_До.Видимость         = Ложь;
			Элементы.ТЧ_Маркировка.ПодчиненныеЭлементы.ТЧ_МаркировкаГруппаКИЗ.ПодчиненныеЭлементы.ТЧ_МаркировкаКИЗ_До.Видимость             = Ложь;
			Элементы.ТЧ_Маркировка.ПодчиненныеЭлементы.ТЧ_МаркировкаГруппаКИТУ.ПодчиненныеЭлементы.ТЧ_МаркировкаИдентТрансУпак_До.Видимость = Ложь;
		КонецЕсли;
	КонецЕсли;
	 
	Если Объект.ВидДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.ORDER_Входящий") Тогда
		Элементы.ТЧ_ТоварыКоличествоЗаказанное.Заголовок   = "Заказанное"; // Количество заказанное покупателем 
		Элементы.ТЧ_ТоварыКоличествоПринятое.Видимость     = Ложь;
		Элементы.ТЧ_ТоварыКоличествоПоставляемое.Заголовок = "К отгрузке"; // Указываем количество для отгрузки покупателю		 
		
	ИначеЕсли Объект.ВидДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.ORDRSP_Входящий") Тогда
		Элементы.ТЧ_ТоварыКоличествоЗаказанное.Заголовок   = "Заказанное";     // Количество заказанное ORDEREDQUANTITY  
		Элементы.ТЧ_ТоварыКоличествоПринятое.Видимость     = Ложь;           
		Элементы.ТЧ_ТоварыКоличествоПоставляемое.Заголовок = "Подтвержденное"; // Подтверженное количество поставщиком ACCEPTEDQUANTITY		
		
	ИначеЕсли Объект.ВидДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.DESADV_Входящий") Тогда
		Элементы.ТЧ_ТоварыКоличествоЗаказанное.Заголовок   = "Заказанное";     // Количество заказанное ORDEREDQUANTITY  
		Элементы.ТЧ_ТоварыКоличествоПринятое.Видимость     = Ложь;          
		Элементы.ТЧ_ТоварыКоличествоПоставляемое.Заголовок = "Поставляемое"; // Поставляемое количество поставщиком DELIVEREDQUANTITY		
		
	ИначеЕсли Объект.ВидДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.RECADV_Входящий") Тогда
		Элементы.ТЧ_ТоварыКоличествоЗаказанное.Заголовок = "Заказанное";     // Количество заказанное покупателем ORDEREDQUANTITY  
		Элементы.ТЧ_ТоварыКоличествоПринятое.Заголовок = "Принятое";         // Количество принятое покупателем ACCEPTEDQUANTITY
		Элементы.ТЧ_ТоварыКоличествоПоставляемое.Заголовок = "Поставляемое"; // Поставляемое количество поставщиком DELIVEREDQUANTITY	
		
	ИначеЕсли Объект.ВидДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.RETORD_Исходящий") Тогда
		Элементы.ГруппаЭДО.Видимость = Ложь;
		Элементы.ГруппаТовары.Видимость = Ложь;
		Элементы.ГруппаДополнительно.Видимость = Ложь;
		Элементы.ГруппаДокументыСвязанные.Видимость = Ложь;
		
	Иначе	
		Элементы.ТЧ_ТоварыКоличествоЗаказанное.Заголовок = "Заказанное";
		Элементы.ТЧ_ТоварыКоличествоПринятое.Заголовок = "Принятое";          
		Элементы.ТЧ_ТоварыКоличествоПоставляемое.Заголовок = "Поставляемое"; 	
		
	КонецЕсли;
	
КонецПроцедуры

