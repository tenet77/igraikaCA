&НаКлиенте
Процедура Отклонить(Команда)
	
	Если ЭтаФорма.Модифицированность Тогда
		Записать();
	КонецЕсли;
	
	Если ПодтверждениеЗаказаРанееОтправлялось() Тогда
		Оповещение = Новый ОписаниеОповещения("ОтклонитьПродолжить", ЭтаФорма);
        ПоказатьВопрос(Оповещение, "Документ ORDRSP уже был отправлен. Отправить повторно?", РежимДиалогаВопрос.ДаНет, 0);
	Иначе
		ОтклонитьПродолжить(КодВозвратаДиалога.Да, Неопределено);
	КонецЕсли;
	
КонецПроцедуры

// Продолжение отправки ORDRSP из ORDER после вопроса о повторной отправке
//
&НаКлиенте
Процедура ОтклонитьПродолжить(Результат, Данные) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	МассивЛогаСобытий = Новый Массив;
	Ответ = ОтклонитьНаСервере(МассивЛогаСобытий);
	Сообщение = Новый СообщениеПользователю;
	
	Если Ответ.Успешно Тогда
		ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(Ответ.АдресФайла);
		ДвоичныеДанныеФайла.Записать(Ответ.ИмяФайла);
		Сообщение.Текст = "Документ успешно отправлен";
		Объект.ПометкаУдаления = Истина;
		Записать();
	Иначе
		Сообщение.Текст = "Документ не отправлен.";
	КонецЕсли;
	
	Если МассивЛогаСобытий.Количество() > 0  Тогда
		ЭКОМ_ОбщегоНазначения.ЗаписатьЛогСобытийвРегистрЛогирование(МассивЛогаСобытий);
	КонецЕсли;
	
	Сообщение.Сообщить();
	
КонецПроцедуры // ОтклонитьПродолжить()


