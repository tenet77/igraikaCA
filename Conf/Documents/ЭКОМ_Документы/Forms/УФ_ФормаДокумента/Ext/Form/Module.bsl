&НаКлиенте
Процедура ПоказатьПечатнуюФормуЮЗД(Команда)
	
	ОбновитьПечатнуюФормуЮЗД();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПечатнуюФормуЮЗД()
	
	МассивЛогаСобытий = Новый Массив;
	
	ПоказатьИндикаторНТМL("");
	
	ТекстОшибкиПриПолученииЮЗД = "";	
	Если НЕ ЗначениеЗаполнено(ЭтаФорма.КаталогКартинкиЮЗД) Тогда
		РезультатВыполнения = КонвертацияPDF_в_JPGНаСервере(МассивЛогаСобытий);
		ТекстОшибкиПриПолученииЮЗД = РезультатВыполнения.ТекстОшибки;
		ЭтаФорма.КаталогКартинкиЮЗД  = РезультатВыполнения.КаталогКартинкиЮЗД;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстОшибкиПриПолученииЮЗД) Тогда
		ПоказатьИндикаторНТМL(ТекстОшибкиПриПолученииЮЗД);
	КонецЕсли;
	
	Если МассивЛогаСобытий.Количество() > 0  Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ЭКОМ_ОбщегоНазначенияКлиент.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий);
		Сообщение.Сообщить();
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ОтобразитьЮЗД", 3);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобразитьЮЗД()
	
	ТекстОшибкиПриПолученииЮЗД = "";
	Если НЕ ЗначениеЗаполнено(ЭтаФорма.Base64ДвоичныеДанныеСЧФ) Тогда
		РезультатВыполнения = ПоказатьПечатнуюФормуЮЗДНаСервере(ЭтаФорма.КаталогКартинкиЮЗД);	
		ЭтаФорма.Base64ДвоичныеДанныеСЧФ = РезультатВыполнения.Base64ДвоичныеДанныеСЧФ;
		ТекстОшибкиПриПолученииЮЗД = РезультатВыполнения.ТекстОшибки;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстОшибкиПриПолученииЮЗД) Тогда
		 ПоказатьИндикаторНТМL(ТекстОшибкиПриПолученииЮЗД);
	Иначе
		 ПоказатьКартинкуЮЗДНТМL(Base64ДвоичныеДанныеСЧФ);
		 ОтключитьОбработчикОжидания("ОтобразитьЮЗД");
	 КонецЕсли;
	 
	 ЭтаФорма.Модифицированность = Ложь;
	 
КонецПроцедуры
 
&НаСервере
Функция КонвертацияPDF_в_JPGНаСервере(МассивЛогаСобытий)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    РезультатВыполнения = ОбработкаОбъект.КонвертацияPDF_в_JPG(Объект.СЧФНомер, Объект.СЧФДата, ЭтаФорма.ПрофильОбмена, ЭтаФорма.ИдентификаторЮЗД, МассивЛогаСобытий);

	Возврат РезультатВыполнения;    

КонецФункции

&НаСервере
Функция ПоказатьПечатнуюФормуЮЗДНаСервере(КаталогКартинкиЮЗД)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    РезультатВыполнения = ОбработкаОбъект.ПоказатьПечатнуюФормуЮЗД(КаталогКартинкиЮЗД);

	Возврат РезультатВыполнения;    

КонецФункции

&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	Если ТекущаяСтраница.Имя = "ГруппаПредпросмотрДокументаCONDRA" 
		И НЕ Объект.ВидДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.CONDRA_Входящий") Тогда
		
		ПоказатьИндикаторНТМL("");
		    
		ПодключитьОбработчикОжидания("ОбновитьПечатнуюФормуЮЗД", 3, Истина); // однократно
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИндикаторНТМL(ТекстОшибки)
	
	СтрокаНТМL = ПолучитьМакетНТМLНаСервере("ИндикаторHTML");
	
	СтрокаНТМL = СтрЗаменить(СтрокаНТМL,
		"<p style=""display: none; color: red; margin: 10px"">ТекстОшибки</p>"
		, "<p style=""color: red; margin: 10px"">" + ТекстОшибки + "</p>");

	ЭтаФорма.ПолеHTMLДокумента = СтрокаНТМL;
	Элементы.ПолеHTMLДокумента.Документ.body.innerHTML = СтрокаНТМL;
	ЭтаФорма.ОбновитьОтображениеДанных(Элементы.ПолеHTMLДокумента);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьКартинкуЮЗДНТМL(Base64ДвоичныеДанныеСЧФ)
		
	СтрокаНТМL = "
	|<!DOCTYPE html>
	|<html> 
	|<center> 
	|<img src=""data:image/jpeg;base64, " + Base64ДвоичныеДанныеСЧФ + """ 
	|style=""max-width:100%; height:auto""; align-items:center; alt=""Счет-фактура"" />
	|</center> 
	|</html>
	|";
	
