&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	// Получаем данные по счет-фактуре
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЭКОМ_ЦепочкиДокументовПокупателя.СтатусЮЗД
		|ИЗ
		|	РегистрСведений.ЭКОМ_ЦепочкиДокументовПокупателя КАК ЭКОМ_ЦепочкиДокументовПокупателя
		|ГДЕ
		|	ЭКОМ_ЦепочкиДокументовПокупателя.ЮЗД = &ЮЗД";		
		Запрос.УстановитьПараметр("ЮЗД", Объект.Ссылка);	
		РезультатЗапроса = Запрос.Выполнить();		
		Если НЕ РезультатЗапроса.Пустой() Тогда
			 ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			 ВыборкаДетальныеЗаписи.Следующий();
		     ЭтаФорма.СтатусЮЗД = ВыборкаДетальныеЗаписи.СтатусЮЗД;
		КонецЕсли;
	
		РезультатВыполнения = ОбработкаОбъект.ПолучитьДанныеПоЮЗД(Объект.Ссылка);
		ЭтаФорма.ИдентификаторЮЗД = РезультатВыполнения.ИдентификаторЮЗД;
		ЭтаФорма.ПрофильОбмена    = РезультатВыполнения.ПрофильОбмена;
		
	КонецЕсли;
	
	Если Объект.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.RECADV_Входящий  Тогда
	     // 1С документ - реализация
		 
		 СвязанныеДокументы = Объект.ДокументыСвязанные.Выгрузить(, "ДокументСвязанный");
		 ДокументыНеЗаполнены = СвязанныеДокументы.Количество() = 0;
		 
		 ТЗ_ДанныеРеализаций = ОбработкаОбъект.ПолучитьДанныеРеализации(Объект.ВидДокумента, СвязанныеДокументы, Объект.ЗаказДата, Объект.ЗаказНомер, Объект.Организация, Объект.Контрагент);
		 Если ДокументыНеЗаполнены = Истина Тогда
			 Для каждого Стр Из СвязанныеДокументы Цикл
				 СтрокаТЧ = Объект.ДокументыСвязанные.Добавить();
				 СтрокаТЧ.ДокументСвязанный = Стр.ДокументСвязанный;
			 КонецЦикла;
		 КонецЕсли;
		 
		 Если ТЗ_ДанныеРеализаций.Количество() > 0 Тогда
			 Для каждого СтрокаТовара Из Объект.ТЧ_Товары Цикл
				 НайденнаяСтрока = ТЗ_ДанныеРеализаций.Найти(СтрокаТовара.Номенклатура, "Номенклатура");
				 Если НЕ НайденнаяСтрока = Неопределено  Тогда
					 СтрокаТовара.НоменклатураИз1С = НайденнаяСтрока.Номенклатура;
					 СтрокаТовара.КоличествоИз1С   = НайденнаяСтрока.Количество;
					 СтрокаТовара.ЦенаИз1С 	       = НайденнаяСтрока.Цена;
				 КонецЕсли;
			 КонецЦикла;		 
		 КонецЕсли;
		 
		 ИмяДокумента = " (РТУ)";
		 Элементы.ТЧ_Товары.ПодчиненныеЭлементы.ТЧ_ТоварыНоменклатураИз1С.Видимость = Истина;
		 Элементы.ТЧ_Товары.ПодчиненныеЭлементы.ТЧ_ТоварыКоличествоИз1С.Видимость = Истина;
		 Элементы.ТЧ_Товары.ПодчиненныеЭлементы.ТЧ_ТоварыЦенаИз1С.Видимость = Истина;
		 
		 Элементы.ТЧ_Товары.ПодчиненныеЭлементы.ТЧ_ТоварыНоменклатураИз1С.Заголовок = "Номенклатура из 1С" + ИмяДокумента;
		 Элементы.ТЧ_Товары.ПодчиненныеЭлементы.ТЧ_ТоварыКоличествоИз1С.Заголовок = "Количество из 1С" + ИмяДокумента;
		 Элементы.ТЧ_Товары.ПодчиненныеЭлементы.ТЧ_ТоварыЦенаИз1С.Заголовок = "Цена из 1С" + ИмяДокумента;
		  
		 Записать();
		 
	КонецЕсли;
	
	СостояниеДокумента = ОбработкаОбъект.СостояниеДокумента(Объект);
	
	

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Валюта
	Если ЗначениеЗаполнено(Объект.Валюта) Тогда	
		Элементы.ДекорацияВалюта.Заголовок = СокрЛП(Объект.Валюта);	
	КонецЕсли;
	
	// Товары
	КоличествоТоваров = Объект.ТЧ_Товары.Количество();
	Если КоличествоТоваров > 0 Тогда	
		Элементы.ГруппаТовары.Заголовок = "Товары (" + КоличествоТоваров + ")";	
	КонецЕсли;

	// Документы связанные
	КоличествоДокументов = Объект.ДокументыСвязанные.Количество() + ?(ЗначениеЗаполнено(Объект.Документ1С), 1, 0);
	Если КоличествоДокументов > 0 Тогда	
		Элементы.ГруппаДокументыСвязанные.Заголовок = "Документы связанные (" + КоличествоДокументов + ")";	
	КонецЕсли;

	// Прайс-лист
	КоличествоТоваров = Объект.ПрайсЛист.Количество();
	Если КоличествоТоваров > 0 Тогда	
		Элементы.ГруппаПрайсЛист.Заголовок = "Прайс-лист (" + КоличествоТоваров + ")";	
	КонецЕсли;

    УправлениеВидимостьюПредставлением();  
	ИзмененитьИмяВидимостьКолонокТабличнойЧасти();

	ТипПрайсЛиста = ПолучитьТипПрайсЛиста();	   
	НайденноеЗначение = ТипПрайсЛиста.НайтиПоЗначению(Объект.УточнениеОПоставке);
	Элементы.НадписьТипДействияПрайсЛиста.Заголовок = ПолучитьИмяТипДействияПрайсЛиста(НайденноеЗначение);

КонецПроцедуры

&НаКлиенте
Функция ПолучитьИмяТипДействияПрайсЛиста(НайденноеЗначение)
	
	ИмяТипДействияПрайсЛиста = "";
	Если НЕ НайденноеЗначение = Неопределено Тогда
	     ИмяТипДействияПрайсЛиста = СтрЗаменить(НайденноеЗначение.Представление, НайденноеЗначение.Значение, "");
	     ИмяТипДействияПрайсЛиста = СтрЗаменить(ИмяТипДействияПрайсЛиста, "—", "");
	КонецЕсли;
		
	Возврат СокрЛП(ИмяТипДействияПрайсЛиста);
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьРасхожение(Команда)
	
	Элементы.ТЧ_Уточнение.Очистить();
	Для Каждого Стр Из Элементы.ТЧ_Товары Цикл
		НовСтр = Элементы.ТЧ_Уточнение.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, Стр);
		НовСтр.ЦенаДо                = Стр.Цена;
		НовСтр.СумБезНДСДо           = Стр.Сумма;
		НовСтр.СтавкаНДСДо           = Стр.СтавкаНДС;
		НовСтр.СтавкаНДСПосле        = Стр.СтавкаНДС;
		НовСтр.СумУчНДСДо            = Стр.Сумма_с_НДС;
		НовСтр.КоличествоФактическое = Стр.КоличествоПоставляемое;
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяФайлаОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ИмяФайлаОткрытиеНаСервере(Элемент.ТекстРедактирования);
	
КонецПроцедуры

&НаСервере
Процедура ИмяФайлаОткрытиеНаСервере(пИмяКаталога)
	
	Если Не ЗначениеЗаполнено(пИмяКаталога) Тогда
		Возврат;
	КонецЕсли;
	
	Файл = Новый Файл(пИмяКаталога);
	Если Не Файл.Существует() Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Файл.ЭтоКаталог() Тогда
		Возврат;
	КонецЕсли;
	
	ЗапуститьПриложение(пИмяКаталога);
	
КонецПроцедуры

&НаКлиенте
Процедура ТЧ_УточнениеКоличествоФактическоеПриИзменении(Элемент)
	СтрокаТабличнойЧасти = Элементы.ТЧ_Уточнение.ТекущиеДанные;
	Если НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.ЦенаПосле) Тогда
	        СтрокаТабличнойЧасти.ЦенаПосле = СтрокаТабличнойЧасти.ЦенаДо;	
	КонецЕсли;
	РассчитатьСуммуТабЧасти(СтрокаТабличнойЧасти);   
КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммуТабЧасти(СтрТабЧасти)
	СтрТабЧасти.СумБезНДСПосле = СтрТабЧасти.ЦенаПосле * СтрТабЧасти.КоличествоФактическое;
	СуммаНДС = СтрТабЧасти.СтавкаНДСПосле * СтрТабЧасти.СумБезНДСПосле / 100;
	СтрТабЧасти.СумУчНДСПосле  = СуммаНДС + СтрТабЧасти.СумБезНДСПосле;
КонецПроцедуры

&НаКлиенте
Процедура ТЧ_УточнениеЦенаПослеПриИзменении(Элемент)
	СтрокаТабличнойЧасти = Элементы.ТЧ_Уточнение.ТекущиеДанные;
    РассчитатьСуммуТабЧасти(СтрокаТабличнойЧасти); 
КонецПроцедуры

&НаКлиенте
Процедура ТЧ_УточнениеСтавкаНДСПослеПриИзменении(Элемент)
	СтрокаТабличнойЧасти = Элементы.ТЧ_Уточнение.ТекущиеДанные;
    РассчитатьСуммуТабЧасти(СтрокаТабличнойЧасти); 
КонецПроцедуры

&НаКлиенте
Процедура ТЧ_УточнениеСумБезНДСПослеПриИзменении(Элемент)
	СтрокаТабличнойЧасти = Элементы.ТЧ_Уточнение.ТекущиеДанные;
	СтрокаТабличнойЧасти.ЦенаПосле = Элемент.Значение / СтрокаТабличнойЧасти.КоличествоФактическое;
КонецПроцедуры

&НаКлиенте
Процедура ТЧ_УточнениеСумУчНДСПослеПриИзменении(Элемент)
	СтрокаТабличнойЧасти = Элементы.ТЧ_Уточнение.ТекущиеДанные;
	СуммаНДС = СтрокаТабличнойЧасти.СтавкаНДСПосле * СтрокаТабличнойЧасти.СумУчНДСПосле / (100 + СтрокаТабличнойЧасти.СтавкаНДСПосле);
    СтрокаТабличнойЧасти.СумБезНДСПосле = СтрокаТабличнойЧасти.СумУчНДСПосле - СуммаНДС;	
	СтрокаТабличнойЧасти.ЦенаПосле = СтрокаТабличнойЧасти.СумБезНДСПосле / СтрокаТабличнойЧасти.КоличествоФактическое;
КонецПроцедуры

&НаКлиенте
Процедура УправлениеВидимостьюПредставлением()
	
	Если ЗначениеЗаполнено(Объект.ТекстОшибки) Тогда
	     Элементы.ТекстОшибки.Видимость = Истина;
	Иначе	
	     Элементы.ТекстОшибки.Видимость = Ложь;
	КонецЕсли;

	ПредпросмотрДокумента = Элементы.ГруппаСтраницы.ПодчиненныеЭлементы.Найти("ГруппаПредпросмотрДокументаCONDRA");			
	Если НЕ ПредпросмотрДокумента = Неопределено Тогда
		Если ЗначениеЗаполнено(ЭтаФорма.ИдентификаторЮЗД) Тогда
			ПредпросмотрДокумента.Видимость = Истина;
		Иначе	 
			ПредпросмотрДокумента.Видимость = Ложь;		
		КонецЕсли;		
	КонецЕсли;

	// По умолчанию
	Элементы.ГруппаМаркировка.Видимость = Ложь;
	Элементы.ГруппаУточнение.Видимость = Ложь;
	Элементы.ПричинаОтказа.Видимость = Ложь;
	Элементы.ТЧ_Товары.ПодчиненныеЭлементы.ТЧ_ТоварыПричинаОтказаТЧ.Видимость = Ложь;
	Элементы.ФормаСформироватьОтвет.Видимость = Ложь;
	Элементы.ФормаОтправить.Видимость = Ложь;
	Элементы.ФормаОтклонить.Видимость = Объект.ВидДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.ORDER_Входящий");
	Элементы.ГруппаПрайсЛист.Видимость = Ложь;
	//Docrobot 1.21.0 MOD-1648
	Элементы.ГруппаТоварыОбратныйЗаказ.Видимость = Объект.ВидДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.RETORD_Исходящий");
	
	Если ЗначениеЗаполнено(Объект.СобытиеПоДокументу) Тогда
		Элементы.СобытиеПоДокументу.Видимость = Истина;
	Иначе	
		Элементы.СобытиеПоДокументу.Видимость = Ложь;
	КонецЕсли;

	// Отображение шапки
	Элементы.ГруппаНеструктурированныйДокумент.Видимость = Ложь;
	Элементы.ГруппаПрайсЛистШапка.Видимость = Ложь;
	Элементы.ГруппаЭДО.Видимость = Ложь;
	Если Объект.ВидДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.CONDRA_Входящий") Тогда
		Элементы.ГруппаНеструктурированныйДокумент.Видимость = Истина;
		ГруппаДокументыСвязанные = Элементы.ГруппаСтраницы.ПодчиненныеЭлементы.Найти("ГруппаДокументыСвязанные");
		Если НЕ ГруппаДокументыСвязанные = Неопределено Тогда
			ГруппаДокументыСвязанные.Видимость = Ложь;
		КонецЕсли;
		
		Группа2 = Элементы.Найти("Группа2");
		Если НЕ Группа2 = Неопределено Тогда
			Группа2.Видимость = Ложь;
		КонецЕсли;
		
		Группа3 = Элементы.Найти("Группа3");
		Если НЕ Группа3 = Неопределено Тогда
			Группа3.Видимость = Истина;
		КонецЕсли;
		
		Если НЕ ПредпросмотрДокумента = Неопределено Тогда
			
			ПредпросмотрДокумента.Заголовок = "Предпросмотр документа CONDRA";
			ГруппаПолеHTML = ПредпросмотрДокумента.ПодчиненныеЭлементы.ГруппаПолеHTML;
			ГруппаПолеHTML.Видимость = Ложь;
			
			ТипЗаголовок = "";
			Если Объект.Тип = "1" Тогда
				ТипЗаголовок = "1 - оригинал";
			ИначеЕсли Объект.Тип = "2" Тогда
				ТипЗаголовок = "2 - принятие";
			ИначеЕсли Объект.Тип = "3" Тогда
				ТипЗаголовок = "3 - отклонение";
			ИначеЕсли Объект.Тип = "4" Тогда
				ТипЗаголовок = "4 - отзыв";
			КонецЕсли;
			
			Элементы.НадписьТипCONDRA.Заголовок 	= Элементы.НадписьТипCONDRA.Заголовок + " " + ТипЗаголовок;
			
			Элементы.НадписьТипCONDRA.Видимость = Истина;
			Элементы.ТочкаДоставки.Видимость 	= Ложь;
			Элементы.INVOICEPARTNER.Видимость = Ложь;
			Элементы.ГруппаТовары.Видимость 	= Ложь;
			
			// Заказ
			Элементы.ДекорацияЗаказ.Видимость = Ложь;
			Элементы.ЗаказНомер.Видимость 	  = Ложь;
			Элементы.ЗаказДата.Видимость 	  = Ложь;
				
			Элементы.ГруппаПравоCONDRA.Видимость 	= Истина;
			
			Элементы.Согласовано.Видимость         = Истина;
			Элементы.ОтветственныйCondra.Видимость = Истина;
			
			Если ЗначениеЗаполнено(Объект.ОтветственныйCondra) Тогда
				ДоступностьСогласовано = Ложь;
				ДоступностьСогласовано = ПроверитьНаДоступностьСогласовано();	
				Если ДоступностьСогласовано Тогда
					Элементы.Согласовано.Доступность = Истина;
				Иначе
					Элементы.Согласовано.Доступность = Ложь;
				КонецЕсли;
			КонецЕсли;
				
		КонецЕсли;
		
	ИначеЕсли Объект.ВидДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.PRICAT_Входящий") 
		ИЛИ Объект.ВидДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.PRICAT_Исходящий") Тогда		
		Элементы.ГруппаПрайсЛистШапка.Видимость = Истина;
		Элементы.ГруппаПрайсЛист.Видимость = Истина;
		Элементы.ГруппаТовары.Видимость = Ложь;
		Элементы.ГруппаИтогоРасчеты.Видимость = Ложь;
		
		Элементы.ДекорацияНомерФайла.Заголовок = "Прайс-лист №";
		Элементы.ДекорацияНомерНакладной.Заголовок = "Файл №";
		
	Иначе
		Элементы.ГруппаЭДО.Видимость = Истина;
		
		Элементы.ГруппаСчетФактура.Видимость = Ложь;
		Элементы.СЧФДата.Видимость = Ложь;
		
		Элементы.ГруппаИсправления.Видимость = Ложь;
		Элементы.ДатаИсправления.Видимость = Ложь;
		Элементы.СтатусЮЗД.Видимость = Ложь;
			
	КонецЕсли;
	Элементы.ГруппаСтраницыШапка.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;

	// Видимость по видам документов
	// Счет-фактура
	Если Найти(СокрЛП(Объект.ВидДокумента), "ON_") > 0 Тогда		
		Элементы.ГруппаСчетФактура.Видимость = Истина;
		Элементы.СЧФДата.Видимость = Истина;
		Элементы.СтатусЮЗД.Видимость = Истина;
		
	КонецЕсли; 

	// Исправление
	Если Найти(СокрЛП(Объект.ВидДокумента), "Испр") > 0 Тогда		
		Элементы.ГруппаИсправления.Видимость = Истина;
		Элементы.ДатаИсправления.Видимость = Истина;
		
	КонецЕсли; 
		
	// Корректировка
	Если Найти(СокрЛП(Объект.ВидДокумента), "ON_KORSCHFDOPPR") > 0 
		ИЛИ Найти(СокрЛП(Объект.ВидДокумента), "ON_NKORSCHFDOPPR") > 0 Тогда	
		Элементы.ГруппаУточнение.Видимость = Истина;

	КонецЕсли;
	
	// Маркировка
	Если Найти(СокрЛП(Объект.ВидДокумента), "ON_KORSCHFDOPPR") > 0 
		ИЛИ Найти(СокрЛП(Объект.ВидДокумента), "MARK") > 0 Тогда	
		Элементы.ГруппаМаркировка.Видимость = Истина;

	КонецЕсли;

	Если Объект.ВидДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.ORDER_Входящий") Тогда
		Элементы.ПричинаОтказа.Видимость = Истина;
		Элементы.ТЧ_Товары.ПодчиненныеЭлементы.ТЧ_ТоварыПричинаОтказаТЧ.Видимость = Истина;
		Элементы.АктуальныйДокумент.Видимость = Истина;
		
	ИначеЕсли Объект.ВидДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.PRICAT_Входящий") Тогда	
		//Docrobot 1.20.0 MOD-1574
		Если Объект.УточнениеОПоставке = "9" или Объект.УточнениеОПоставке = "13" Тогда
			Элементы.ФормаСформироватьОтвет.Видимость = Истина;
		КонецЕсли;
		Элементы.ПрайсЛистПринятьВсе.Видимость = Ложь;
		Элементы.ПрайсЛистОтклонитьВсе.Видимость = Ложь;
		//Docrobot 1.20.0 MOD-1576
		Элементы.УточнениеОПоставкеПрайсЛист.Доступность = Ложь;
		
	ИначеЕсли Объект.ВидДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.PRICAT_Исходящий") Тогда	
		Элементы.ФормаОтправить.Видимость = Истина;	
		Элементы.ПрайсЛистПринятьВсе.Видимость = Истина;
		Элементы.ПрайсЛистОтклонитьВсе.Видимость = Истина;

	КонецЕсли;	
		
КонецПроцедуры

