&НаКлиенте
Процедура СохранитьФормуЮЗД(Команда)
	
	ИмяСобытия = "Сохранение формы ЮЗД";

	Ошибка = Новый Структура;
	Ошибка.Вставить("ЕстьОшибка" , Ложь);
	Ошибка.Вставить("КодОшибки"  , "");
	Ошибка.Вставить("ТекстОшибки", "");  
	
	МассивЛогаСобытий = Новый Массив;

	ИД_Документа = Прав(ИдентификаторЮЗД, 36);
	СтрокаBase64PDF_Документа = ЭКОМ_ОбщегоНазначения.ИзвлечьPDF_ЭКОМ(ПрофильОбмена, ИД_Документа, Ошибка, МассивЛогаСобытий);
	ДвоичныеДанныеPDF_Документа = Base64Значение(СтрокаBase64PDF_Документа);
	АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанныеPDF_Документа, Новый УникальныйИдентификатор);
	
	Если Ошибка.ЕстьОшибка = Истина Тогда
		ТекстЛогаСобытий = "Не удлалось получить форму ЮЗД - " + Ошибка.КодОшибки + " - " + Ошибка.ТекстОшибки;
		ЗаписьСтруктурыЛога = ЭКОМ_ОбщегоНазначенияКлиент.ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Ошибка"), ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

	Иначе
		ИмяСохранения = "Счет-фактура № " +  Объект.СЧФНомер +" от " + Формат(Объект.СЧФДата, "ДФ=dd.MM.yyyy");;		
		СохранениеФайла(АдресВоВременномХранилище, ИмяСохранения);
	КонецЕсли;
	
	Если МассивЛогаСобытий.Количество() > 0  Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ЭКОМ_ОбщегоНазначенияКлиент.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий);
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранениеФайла(АдресВоВременномХранилище, ИмяСохранения)
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресВоВременномХранилище);
	// создаем на клиенте текстовый файл
	ИмяВременногоФайлаXML = ПолучитьИмяВременногоФайла("pdf");
	
    Если ДвоичныеДанные = Неопределено Тогда
        ПоказатьПредупреждение(Новый ОписаниеОповещения, "Не удалось получить данные ЮЗД", , "Сохранение в файл");
        Возврат;
    КонецЕсли;
	// создаем диалог сохранения файла
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДиалогОткрытияФайла.Заголовок          = "Сохраните файл";
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.Расширение         = "pdf";
    ДиалогОткрытияФайла.Фильтр             = "(*.pdf)|*.pdf";
	ДиалогОткрытияФайла.ИндексФильтра      = 0; //укажем фильтр по умолчанию (нумерация с нуля)	
	ДиалогОткрытияФайла.ПолноеИмяФайла = ИмяСохранения + ".pdf";;	
	ДиалогОткрытияФайла.Показать(Новый ОписаниеОповещения("ЗавершениеДиалогаВыбораФайлаСохранение", ЭтаФорма, ДвоичныеДанные));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеДиалогаВыбораФайлаСохранение(ВыбранныеФайлы, ДвоичныеДанные) Экспорт
    
    Если ВыбранныеФайлы = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    ВсегоФайлов = ВыбранныеФайлы.Количество();
    Прогресс = 0;
    ТекущийНомерФайла = 0;
	Если ВыбранныеФайлы <> Неопределено Или ТипЗнч(ВыбранныеФайлы) = Тип("Массив") Тогда
        Для каждого ИмяФайла Из ВыбранныеФайлы Цикл
            ТекущийНомерФайла = ТекущийНомерФайла + 1;
            Попытка
                Прогресс = Окр(ТекущийНомерФайла * 100 / ВсегоФайлов, 0);
                ДвоичныеДанные.Записать(ИмяФайла);
				ЗапуститьПриложение(ИмяФайла);

            Исключение
                Сообщить("Ошибка записи в файл [" + "] " + ИмяФайла);
            КонецПопытки;
            Состояние("Сохранено в " + ИмяФайла, Прогресс,, БиблиотекаКартинок.ЭКОМ_Информация);		
        КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

