КонецПроцедуры

Функция ПолучитьДанныеДляПечатнойФормыОС1(ПараметрыПечати, МассивОбъектов) Экспорт
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ДанныеДокументов.Ссылка КАК Ссылка
	|
	|ПОМЕСТИТЬ ТаблицаДанныхДокументов
	|ИЗ
	|	Документ.ПринятиеКУчетуНМА2_4 КАК ДанныеДокументов
	|
	|ГДЕ
	|	ДанныеДокументов.Ссылка В (&МассивОбъектов)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОтветственныеЛицаОрганизаций.ФизическоеЛицо КАК ФИО_директора,
	|	ОтветственныеЛицаОрганизаций.Должность КАК Должность_Директора,
	|	ОтветственныеЛицаОрганизаций.Владелец КАК Организация,
	|	"""" КАК ФИО_ГлБух,
	|	"""" КАК Должность_ГлБух
	|ПОМЕСТИТЬ вт_ОтветственныеЛицаОбщ
	|ИЗ
	|	ТаблицаДанныхДокументов КАК ТаблицаДанныхДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОтветственныеЛицаОрганизаций КАК ОтветственныеЛицаОрганизаций
	|		ПО (ОтветственныеЛицаОрганизаций.Владелец = ТаблицаДанныхДокументов.Ссылка.Организация)
	|			И (ОтветственныеЛицаОрганизаций.ДатаНачала <= ТаблицаДанныхДокументов.Ссылка.Дата)
	|ГДЕ
	|	ОтветственныеЛицаОрганизаций.ОтветственноеЛицо = ЗНАЧЕНИЕ(Перечисление.ОтветственныеЛицаОрганизаций.Руководитель)
	|	И (ТаблицаДанныхДокументов.Ссылка.Дата <= КОНЕЦПЕРИОДА(ОтветственныеЛицаОрганизаций.ДатаОкончания, ДЕНЬ)
	|			ИЛИ ОтветственныеЛицаОрганизаций.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	"""",
	|	"""",
	|	ОтветственныеЛицаОрганизаций.Владелец,
	|	ОтветственныеЛицаОрганизаций.ФизическоеЛицо,
	|	ОтветственныеЛицаОрганизаций.Должность
	|ИЗ
	|	ТаблицаДанныхДокументов КАК ТаблицаДанныхДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОтветственныеЛицаОрганизаций КАК ОтветственныеЛицаОрганизаций
	|		ПО (ОтветственныеЛицаОрганизаций.Владелец = ТаблицаДанныхДокументов.Ссылка.Организация)
	|			И (ОтветственныеЛицаОрганизаций.ДатаНачала <= ТаблицаДанныхДокументов.Ссылка.Дата)
	|ГДЕ
	|	ОтветственныеЛицаОрганизаций.ОтветственноеЛицо = ЗНАЧЕНИЕ(Перечисление.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер)
	|	И (ТаблицаДанныхДокументов.Ссылка.Дата <= КОНЕЦПЕРИОДА(ОтветственныеЛицаОрганизаций.ДатаОкончания, ДЕНЬ)
	|			ИЛИ ОтветственныеЛицаОрганизаций.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(вт_ОтветственныеЛицаОбщ.ФИО_директора) КАК ФИО_директора,
	|	МАКСИМУМ(вт_ОтветственныеЛицаОбщ.Должность_Директора) КАК Должность_Директора,
	|	вт_ОтветственныеЛицаОбщ.Организация КАК Организация,
	|	МАКСИМУМ(вт_ОтветственныеЛицаОбщ.ФИО_ГлБух) КАК ФИО_ГлБух,
	|	МАКСИМУМ(вт_ОтветственныеЛицаОбщ.Должность_ГлБух) КАК Должность_ГлБух
	|ПОМЕСТИТЬ вт_ОтветственныеЛица
	|ИЗ
	|	вт_ОтветственныеЛицаОбщ КАК вт_ОтветственныеЛицаОбщ
	|
	|СГРУППИРОВАТЬ ПО
	|	вт_ОтветственныеЛицаОбщ.Организация
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Организация
	|;";
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
		
	Запрос.Выполнить();
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Шапка.Ссылка КАК Ссылка,
	|	Шапка.Номер КАК НомерДокумента,
	|	Шапка.Дата КАК ДатаДокумента,
	|	Шапка.Дата КАК ДатаВвода,
	|	НЕОПРЕДЕЛЕНО КАК ДатаПередачи,
	|	Шапка.Организация.Префикс КАК Префикс,
	|	НЕОПРЕДЕЛЕНО КАК Сдатчик,
	|	НЕОПРЕДЕЛЕНО КАК ПодразделениеСдатчика,
	|	Шапка.Организация КАК Получатель,
	|	Шапка.Подразделение КАК ПодразделениеПолучателя,
	|	Шапка.Подразделение КАК МестонахождениеОС,
	|	НЕОПРЕДЕЛЕНО КАК БанковскийСчетСдатчика,
	|	НЕОПРЕДЕЛЕНО КАК Руководитель,
	|	НЕОПРЕДЕЛЕНО КАК ДолжностьРуководителя,
	|	НЕОПРЕДЕЛЕНО КАК БанковскийСчетПолучателя,
	|	ЕСТЬNULL(вт_ОтветственныеЛица.ФИО_директора, НЕОПРЕДЕЛЕНО) КАК РуководительПолучателя,
	|	ЕСТЬNULL(вт_ОтветственныеЛица.Должность_Директора, НЕОПРЕДЕЛЕНО) КАК ДолжностьРуководителяПолучателя,
	|	НЕОПРЕДЕЛЕНО КАК ГлавныйБухгалтер,
	|	ЕСТЬNULL(вт_ОтветственныеЛица.ФИО_ГлБух, НЕОПРЕДЕЛЕНО) КАК ГлавныйБухгалтерПолучателя,
	|	ЕСТЬNULL(вт_ОтветственныеЛица.Должность_ГлБух, НЕОПРЕДЕЛЕНО) КАК ДолжностьГлБухгалтера,
	|	Шапка.Ответственный.ФизическоеЛицо КАК Принял,
	|	НЕОПРЕДЕЛЕНО КАК ДолжностьПринял,
	|	"""" КАК ДокументОснованиеДата,
	|	"""" КАК Кладовщик,
	|	"""" КАК ДолжностьКладовщика
	|ИЗ
	|	Документ.ПринятиеКУчетуНМА2_4 КАК Шапка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаДанныхДокументов КАК ТаблицаДанныхДокументов
	|		ПО Шапка.Ссылка = ТаблицаДанныхДокументов.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ вт_ОтветственныеЛица КАК вт_ОтветственныеЛица
	|		ПО Шапка.Организация = вт_ОтветственныеЛица.Организация
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеНМА.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА ДанныеНМА.НематериальныйАктив.НаименованиеПолное = """"
	|			ТОГДА ДанныеНМА.НематериальныйАктив
	|		ИНАЧЕ ДанныеНМА.НематериальныйАктив.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеОС,
	|	ДанныеНМА.НематериальныйАктив.Код КАК НомерИнвентарный,
	|	"""" КАК НомерЗаводской,
	|	"""" КАК ДатаВыпуска,
	|	ДанныеНМА.Дата КАК ДатаВводаВЭксплуатацию,
	|	ДанныеНМА.СрокИспользованияБУ КАК СрокИспользования,
	|	ДанныеНМА.СрокИспользованияБУ КАК СрокСлужбыПолезной,
	|	ПервоначальныеСведенияНМА.ПервоначальнаяСтоимостьБУ КАК СтоимостьПервоначальная,
	|	ПервоначальныеСведенияНМА.ПервоначальнаяСтоимостьБУ КАК СтоимостьОстаточная,
	|	0 КАК АмортизацияСумма,
	|	ДанныеНМА.СпособНачисленияАмортизацииБУ КАК АмортизацияСпособ,
	|	ДанныеНМА.ГруппаФинансовогоУчета.СчетУчета КАК СчетДт,
	|	"""" КАК СчетКт
	|	
	|ИЗ
	|	Документ.ПринятиеКУчетуНМА2_4 КАК ДанныеНМА
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаДанныхДокументов КАК ТаблицаДанныхДокументов
	|		ПО ДанныеНМА.Ссылка = ТаблицаДанныхДокументов.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПервоначальныеСведенияНМА КАК ПервоначальныеСведенияНМА
	|		ПО ДанныеНМА.Ссылка = ПервоначальныеСведенияНМА.Регистратор
	|			И ДанныеНМА.НематериальныйАктив = ПервоначальныеСведенияНМА.НематериальныйАктив
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка
	|ИТОГИ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НЕОПРЕДЕЛЕНО КАК Ссылка
	|ИТОГИ ПО
	|	Ссылка";
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	Возврат Новый Структура(
		"РезультатПоШапке, РезультатПоТабличнойЧасти, РезультатПоДрагоценнымМатериалам",
		РезультатыЗапроса[0],
		РезультатыЗапроса[1],
		РезультатыЗапроса[2]);
	
КонецФункции

