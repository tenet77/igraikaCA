Процедура СоздатьКлючиАналитикиУчетаВА(ДокументСсылка) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "
	|ВЫБРАТЬ
   	|	ПринятиеКУчетуНМА.ПорядокУчетаНУ
   	|ИЗ
   	|	Документ.ПринятиеКУчетуНМА2_4 КАК ПринятиеКУчетуНМА
   	|ГДЕ
   	|	ПринятиеКУчетуНМА.Ссылка = &Ссылка
	|";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Результат = Запрос.Выполнить().Выгрузить();
	
	ВидыДвижения = Новый Массив;
	ВидыАктива = Новый Массив;
	
	Для Каждого СтрокаТаблицы ИЗ Результат Цикл
		ВидыАктива.Добавить(УчетФиксированныхАктивов.ОпределитьВидаАктиваНУ(СтрокаТаблицы.ПорядокУчетаНУ));
		
		Если СтрокаТаблицы.ПорядокУчетаНУ = Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.ВключениеВРасходыПриПринятииКУчету Тогда
			ВидыДвижения.Добавить(Перечисления.ВидыДвиженияСтоимостиФА.ЕдиновременноеСписаниеСтоимостиОбъектаПреференций);
		Иначе
			ВидыДвижения.Добавить(Перечисления.ВидыДвиженияСтоимостиФА.Поступление);
		КонецЕсли;
	КонецЦикла;
	
	УчетФиксированныхАктивов.СоздатьКлючиАналитикиУчетаВА(ВидыАктива, ВидыДвижения);
	
КонецПроцедуры

