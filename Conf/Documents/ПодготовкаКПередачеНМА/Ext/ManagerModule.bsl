Функция ПолучитьДанныеДляПечатнойФормыОС1(ПараметрыПечати, МассивОбъектов) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
		
	#Область ТекстЗапроса
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ДанныеДокументов.Ссылка КАК Ссылка,
	|	ДанныеДокументов.Дата,
	|	ДанныеДокументов.НематериальныйАктив,
	|	ДанныеДокументов.Организация
	|
	|ПОМЕСТИТЬ втОбъектыДокументов
	|ИЗ
	|	Документ.ПодготовкаКПередачеНМА КАК ДанныеДокументов
	|
	|ГДЕ
	|	ДанныеДокументов.Ссылка В (&МассивОбъектов)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОтветственныеЛицаОрганизаций.ФизическоеЛицо КАК ФИО_директора,
	|	ОтветственныеЛицаОрганизаций.Должность КАК Должность_Директора,
	|	ОтветственныеЛицаОрганизаций.Владелец КАК Организация,
	|	"""" КАК ФИО_ГлБух,
	|	"""" КАК Должность_ГлБух
	|ПОМЕСТИТЬ вт_ОтветственныеЛицаОбщ
	|ИЗ
	|	втОбъектыДокументов КАК втОбъектыДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОтветственныеЛицаОрганизаций КАК ОтветственныеЛицаОрганизаций
	|		ПО (ОтветственныеЛицаОрганизаций.Владелец = втОбъектыДокументов.Ссылка.Организация)
	|			И (ОтветственныеЛицаОрганизаций.ДатаНачала <= втОбъектыДокументов.Ссылка.Дата)
	|ГДЕ
	|	ОтветственныеЛицаОрганизаций.ОтветственноеЛицо = ЗНАЧЕНИЕ(Перечисление.ОтветственныеЛицаОрганизаций.Руководитель)
	|	И (втОбъектыДокументов.Ссылка.Дата <= КОНЕЦПЕРИОДА(ОтветственныеЛицаОрганизаций.ДатаОкончания, ДЕНЬ)
	|			ИЛИ ОтветственныеЛицаОрганизаций.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	"""",
	|	"""",
	|	ОтветственныеЛицаОрганизаций.Владелец,
	|	ОтветственныеЛицаОрганизаций.ФизическоеЛицо,
	|	ОтветственныеЛицаОрганизаций.Должность
	|ИЗ
	|	втОбъектыДокументов КАК втОбъектыДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОтветственныеЛицаОрганизаций КАК ОтветственныеЛицаОрганизаций
	|		ПО (ОтветственныеЛицаОрганизаций.Владелец = втОбъектыДокументов.Ссылка.Организация)
	|			И (ОтветственныеЛицаОрганизаций.ДатаНачала <= втОбъектыДокументов.Ссылка.Дата)
	|ГДЕ
	|	ОтветственныеЛицаОрганизаций.ОтветственноеЛицо = ЗНАЧЕНИЕ(Перечисление.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер)
	|	И (втОбъектыДокументов.Ссылка.Дата <= КОНЕЦПЕРИОДА(ОтветственныеЛицаОрганизаций.ДатаОкончания, ДЕНЬ)
	|			ИЛИ ОтветственныеЛицаОрганизаций.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(вт_ОтветственныеЛицаОбщ.ФИО_директора) КАК ФИО_директора,
	|	МАКСИМУМ(вт_ОтветственныеЛицаОбщ.Должность_Директора) КАК Должность_Директора,
	|	вт_ОтветственныеЛицаОбщ.Организация КАК Организация,
	|	МАКСИМУМ(вт_ОтветственныеЛицаОбщ.ФИО_ГлБух) КАК ФИО_ГлБух,
	|	МАКСИМУМ(вт_ОтветственныеЛицаОбщ.Должность_ГлБух) КАК Должность_ГлБух
	|ПОМЕСТИТЬ вт_ОтветственныеЛица
	|ИЗ
	|	вт_ОтветственныеЛицаОбщ КАК вт_ОтветственныеЛицаОбщ
	|
	|СГРУППИРОВАТЬ ПО
	|	вт_ОтветственныеЛицаОбщ.Организация
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Организация
	|;";
	
	Запрос.Выполнить();
	
	СоздатьВременнуюТаблицуСостоянияНМА(Запрос.МенеджерВременныхТаблиц);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Шапка.Ссылка КАК Ссылка,
	|	Шапка.Номер КАК НомерДокумента,
	|	Шапка.Дата КАК ДатаДокумента,
	|	Шапка.Организация.Префикс КАК Префикс,
	|	Шапка.Организация КАК Сдатчик,
	|	Шапка.Подразделение КАК ПодразделениеСдатчика,
	|	Шапка.Подразделение КАК МестонахождениеОС,
	|	НЕОПРЕДЕЛЕНО КАК БанковскийСчетСдатчика,
	|	Шапка.Контрагент КАК Получатель,
	|	НЕОПРЕДЕЛЕНО КАК ПодразделениеПолучателя,
	|	НЕОПРЕДЕЛЕНО КАК БанковскийСчетПолучателя,
	|	ЕСТЬNULL(вт_ОтветственныеЛица.ФИО_директора, НЕОПРЕДЕЛЕНО) КАК Руководитель,
	|	ЕСТЬNULL(вт_ОтветственныеЛица.Должность_Директора, НЕОПРЕДЕЛЕНО) КАК ДолжностьРуководителя,
	|	ЕСТЬNULL(вт_ОтветственныеЛица.ФИО_ГлБух, НЕОПРЕДЕЛЕНО) КАК ГлавныйБухгалтер,
	|	НЕОПРЕДЕЛЕНО КАК ГлавныйБухгалтерПолучателя,
	|	Шапка.Ответственный.ФизическоеЛицо КАК Кладовщик,
	|	НЕОПРЕДЕЛЕНО КАК ДолжностьКладовщика,
	|	НЕОПРЕДЕЛЕНО КАК РуководительПолучателя,
	|	НЕОПРЕДЕЛЕНО КАК ДолжностьРуководителяПолучателя,
	|	НЕОПРЕДЕЛЕНО КАК Принял,
	|	НЕОПРЕДЕЛЕНО КАК ДолжностьПринял,
	|	"""" КАК ДокументОснованиеДата
	|ИЗ
	|	Документ.ПодготовкаКПередачеНМА КАК Шапка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втОбъектыДокументов КАК втОбъектыДокументов
	|		ПО Шапка.Ссылка = втОбъектыДокументов.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ вт_ОтветственныеЛица КАК вт_ОтветственныеЛица
	|		ПО Шапка.Организация = вт_ОтветственныеЛица.Организация
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втНематериальныеАктивы.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА втНематериальныеАктивы.НематериальныйАктив.НаименованиеПолное = """"
	|			ТОГДА втНематериальныеАктивы.НематериальныйАктив
	|		ИНАЧЕ втНематериальныеАктивы.НематериальныйАктив.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеОС,
	|	втСведенияОбъектовДокументов.ИнвентарныйНомер КАК НомерИнвентарный,
	|	втСведенияОбъектовДокументов.ДатаПринятияКУчету КАК ДатаВыпуска,
	|	втСведенияОбъектовДокументов.ДатаПринятияКУчету КАК ДатаВводаВЭксплуатацию,
	|	втСведенияОбъектовДокументов.СрокПолезногоИспользования КАК СрокИспользования,
	|	втСведенияОбъектовДокументов.НакопленнаяСтоимость КАК СтоимостьПервоначальная,
	|	втСведенияОбъектовДокументов.ОстаточнаяСтоимость КАК СтоимостьОстаточная,
	|	втСведенияОбъектовДокументов.НакопленнаяАмортизация КАК АмортизацияСумма,
	|	втСведенияОбъектовДокументов.СпособНачисленияАмортизации КАК АмортизацияСпособ,
	|	втСведенияОбъектовДокументов.КоэффициентАмортизации КАК АмортизацияНорма
	|ИЗ
	|	втОбъектыДокументов КАК втНематериальныеАктивы
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСведенияОбъектовДокументов КАК втСведенияОбъектовДокументов
	|		ПО втНематериальныеАктивы.Ссылка = втСведенияОбъектовДокументов.Ссылка
	|			И втНематериальныеАктивы.НематериальныйАктив = втСведенияОбъектовДокументов.НематериальныйАктив
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка
	|ИТОГИ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НЕОПРЕДЕЛЕНО КАК Ссылка
	|ИТОГИ ПО
	|	Ссылка";
	#КонецОбласти
	
