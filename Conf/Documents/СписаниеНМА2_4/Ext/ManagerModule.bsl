Функция ДанныеПечатнойФормыОС4(МассивОбъектов) Экспорт
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	СоздатьВременныеТаблицыРегистров(МенеджерВременныхТаблиц, МассивОбъектов);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Запрос.Текст =
	"
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаНМА.Ссылка КАК Ссылка,
	|	ТаблицаНМА.Ссылка.Номер КАК Номер,
	|	ТаблицаНМА.Ссылка.Дата КАК Дата,
	|	"""" КАК Состояние,
	|	"""" КАК ПричинаСписания,
	|	ТаблицаНМА.Ссылка.Организация КАК Организация,
	|	ТаблицаНМА.Ссылка.Подразделение КАК ПодразделениеОрганизации,
	|	ТаблицаНМА.Ссылка.МоментВремени КАК МоментВремени,
	|	1 КАК НомерСтроки,
	|	ТаблицаНМА.НематериальныйАктив КАК ОС,
	|	"""" КАК ЗаводскойНомер,
	|	ЛОЖЬ КАК Автотранспорт,
	|	"""" КАК ГодВыпуска,
	|	ВЫБОР
	|		КОГДА ТаблицаНМА.НематериальныйАктив.НаименованиеПолное = """"
	|			ТОГДА ТаблицаНМА.НематериальныйАктив.Наименование
	|		ИНАЧЕ ТаблицаНМА.НематериальныйАктив.НаименованиеПолное
	|	КОНЕЦ КАК НаимОС,
	|	ВТ_ПервоначальныеСведенияНМА.ПервоначальнаяСтоимость КАК НачСтоимость,
	|	"""" КАК ИнвНомер,
	|	0 КАК ПорядокПогашенияСтоимости,
	|	"""" КАК Подразделение,
	|	ТаблицаНМА.Ссылка.Ответственный КАК МОЛ,
	|	ЕСТЬNULL(ВТ_СтоимостьНМА.СуммаОборот, 0) - ЕСТЬNULL(ВТ_АмортизацияНМА.СуммаОборот, 0) КАК БалансоваяСтоимость,
	|	ЕСТЬNULL(ВТ_АмортизацияНМА.СуммаОборот, 0) КАК НачАмортизация,
	|	NULL КАК ДрагоценныеМатериалы,
	|	ВТ_ПервоначальныеСведенияНМА.ДатаНачала КАК ДатаВводаВЭксплуатацию
	|ИЗ
	|	Документ.СписаниеНМА2_4.НМА КАК ТаблицаНМА
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПервоначальныеСведенияНМА КАК ВТ_ПервоначальныеСведенияНМА
	|		ПО (ТаблицаНМА.Ссылка.Дата МЕЖДУ ВТ_ПервоначальныеСведенияНМА.ДатаНачала И ВТ_ПервоначальныеСведенияНМА.ДатаОкончания)
	|			И ТаблицаНМА.НематериальныйАктив = ВТ_ПервоначальныеСведенияНМА.НематериальныйАктив
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПорядокУчетаНМА КАК ВТ_ПорядокУчетаНМА
	|		ПО (ТаблицаНМА.Ссылка.Дата МЕЖДУ ВТ_ПорядокУчетаНМА.ДатаНачала И ВТ_ПорядокУчетаНМА.ДатаОкончания)
	|			И ТаблицаНМА.Ссылка.Организация = ВТ_ПорядокУчетаНМА.Организация
	|			И ТаблицаНМА.НематериальныйАктив = ВТ_ПорядокУчетаНМА.НематериальныйАктив
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СтоимостьНМА КАК ВТ_СтоимостьНМА
	|		ПО (ВТ_ПорядокУчетаНМА.СчетУчета = ВТ_СтоимостьНМА.СчетКт)
	|			И ТаблицаНМА.Ссылка = ВТ_СтоимостьНМА.Регистратор
	|			И ТаблицаНМА.НематериальныйАктив = ВТ_СтоимостьНМА.СубконтоКт1
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_АмортизацияНМА КАК ВТ_АмортизацияНМА
	|		ПО (ВТ_ПорядокУчетаНМА.СчетНачисленияИзносаАмортизации = ВТ_АмортизацияНМА.СчетДт)
	|			И ТаблицаНМА.Ссылка = ВТ_АмортизацияНМА.Регистратор
	|			И ТаблицаНМА.НематериальныйАктив = ВТ_АмортизацияНМА.СубконтоДт1
	|ГДЕ
	|	ТаблицаНМА.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТаблицаНМА.Ссылка.Дата,
	|	ТаблицаНМА.Ссылка,
	|	НомерСтроки
	|ИТОГИ ПО
	|	Ссылка";
	
	Пакет = Запрос.ВыполнитьПакет();
	
	Возврат Новый Структура(
		"ПоДокументам, ПоПрочимОприходованиям",		
		Пакет[0],  
		Неопределено);

	
