#КонецОбласти

#Область Печать

Процедура СоздатьВременныеТаблицыРегистров(МВТ, МассивОбъектов)
	
	УстановитьПривилегированныйРежим(Истина);
	
	// 1. Определим "границы" регистров сведений - список организаций, ОС, период, ...
	//    чтобы ограничить выборку из регистров сведений
	Запрос = Новый Запрос(
		"
		|// 1. Период дат
		|ВЫБРАТЬ
		|	МИНИМУМ(Док.Дата)  КАК ДатаОТ,
		|	МАКСИМУМ(Док.Дата) КАК ДатаДО
		|ИЗ
		|	Документ.СписаниеНМА2_4 КАК Док
		|ГДЕ
		|	Док.Ссылка В (&МассивОбъектов)
		|;
		|
		|// 2. Список организаций
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Док.Организация КАК Организация
		|ИЗ
		|	Документ.СписаниеНМА2_4 КАК Док
		|ГДЕ
		|	Док.Ссылка В (&МассивОбъектов)
		|;
		|
		|// 3. Список НМА
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Док.НематериальныйАктив КАК НематериальныйАктив
		|ИЗ
		|	Документ.СписаниеНМА2_4.НМА КАК Док
		|ГДЕ
		|	Док.Ссылка В (&МассивОбъектов)
		|
		|");
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Результат = Запрос.ВыполнитьПакет();
	// 1.1. Интервал дат
	Выборка = Результат[0].Выбрать(ОбходРезультатаЗапроса.Прямой);
	Выборка.Следующий();
	ДатаОТ = Выборка.ДатаОТ;
	ДатаДО = Выборка.ДатаДО;
	
	// 1.2. Список организаций
	МассивОрганизаций = Результат[1].Выгрузить(ОбходРезультатаЗапроса.Прямой).ВыгрузитьКолонку("Организация");
	
	// 1.3. Список НМА
	МассивНМА = Результат[2].Выгрузить(ОбходРезультатаЗапроса.Прямой).ВыгрузитьКолонку("НематериальныйАктив");
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаНМА.Ссылка КАК Ссылка,
	|	ТаблицаНМА.НематериальныйАктив КАК НематериальныйАктив
	|ПОМЕСТИТЬ ВТ_ВсеНМА
	|ИЗ
	|	Документ.СписаниеНМА2_4.НМА КАК ТаблицаНМА
	|ГДЕ
	|	ТаблицаНМА.Ссылка В(&МассивОбъектов)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка,
	|	НематериальныйАктив
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Рег1.Период КАК Период,
	|	МИНИМУМ(Рег2.Период) КАК ПервыйПериод,
	|	Рег1.НематериальныйАктив КАК НематериальныйАктив
	|ПОМЕСТИТЬ ВТ_ПервоначальныеСведенияНМА_Рег2
	|ИЗ
	|	РегистрСведений.ПервоначальныеСведенияНМА КАК Рег1
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПервоначальныеСведенияНМА КАК Рег2
	|		ПО Рег1.НематериальныйАктив = Рег2.НематериальныйАктив
	|			И Рег1.Период < Рег2.Период
	|ГДЕ
	|	Рег1.Период <= &ДатаДО
	|	И Рег1.НематериальныйАктив В(&МассивНМА)
	|	И Рег2.Период <= &ДатаДО
	|	И Рег2.НематериальныйАктив В(&МассивНМА)
	|
	|СГРУППИРОВАТЬ ПО
	|	Рег1.Период,
	|	Рег1.НематериальныйАктив
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Рег1.Период,
	|	Рег1.НематериальныйАктив
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА Рег2.ПервыйПериод ЕСТЬ NULL 
	|			ТОГДА ДАТАВРЕМЯ(3999, 12, 31)
	|		ИНАЧЕ ДОБАВИТЬКДАТЕ(Рег2.ПервыйПериод, СЕКУНДА, -1)
	|	КОНЕЦ КАК ДатаОкончания,
	|	Рег1.Период КАК ДатаНачала,
	|	Рег1.НематериальныйАктив КАК НематериальныйАктив,
	|	Рег1.Организация КАК Организация,
	|	"""" КАК ИнвентарныйНомер,
	|	Рег1.СпособПоступления КАК СпособПоступления,
	|	Рег1.ПервоначальнаяСтоимостьБУ КАК ПервоначальнаяСтоимость,
	|	Рег1.МетодНачисленияАмортизацииБУ КАК СпособНачисленияАмортизации,
	|	0 КАК ПоказательНаработки,
	|	0 КАК ПорядокПогашенияСтоимости
	|ПОМЕСТИТЬ ВТ_ПервоначальныеСведенияНМА
	|ИЗ
	|	РегистрСведений.ПервоначальныеСведенияНМА КАК Рег1
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПервоначальныеСведенияНМА_Рег2 КАК Рег2
	|		ПО Рег1.НематериальныйАктив = Рег2.НематериальныйАктив
	|			И Рег1.Период = Рег2.Период
	|ГДЕ
	|	Рег1.Период <= &ДатаДО
	|	И Рег1.НематериальныйАктив В(&МассивНМА)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДатаНачала,
	|	ДатаОкончания,
	|	НематериальныйАктив
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Рег1.Период КАК Период,
	|	МИНИМУМ(Рег2.Период) КАК ПервыйПериод,
	|	Рег1.Организация КАК Организация,
	|	Рег1.НематериальныйАктив КАК НематериальныйАктив
