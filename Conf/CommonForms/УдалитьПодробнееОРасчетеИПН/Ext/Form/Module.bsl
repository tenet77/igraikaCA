
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	 	
	Организация = Параметры.Организация;
	МесяцНачисления = Параметры.МесяцНачисления;
	ОписаниеДокумента = Новый ФиксированнаяСтруктура(Параметры.ОписаниеДокумента);
	
	СписокСотрудников = Параметры.УчитываемыеСотрудники;
	Если ТипЗнч(СписокСотрудников) = Тип("Строка")
		И Не ПустаяСтрока(СписокСотрудников) Тогда
		
		СписокСотрудников = ПолучитьИзВременногоХранилища(СписокСотрудников);
		
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(СписокСотрудников) Тогда
		
		Если ТипЗнч(СписокСотрудников) <> Тип("Массив") Тогда
			СписокСотрудников = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СписокСотрудников);
		КонецЕсли;
		
		Если СписокСотрудников.Количество() > 0 Тогда
			
			Если ТипЗнч(СписокСотрудников[0]) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
				УчитываемыеСотрудники = Новый ФиксированныйМассив(СписокСотрудников);
			Иначе
				
				Запрос = Новый Запрос;
				Запрос.УстановитьПараметр("СписокСотрудников", СписокСотрудников);
				Запрос.Текст =
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
					|	Сотрудники.ФизическоеЛицо
					|ИЗ
					|	Справочник.Сотрудники КАК Сотрудники
					|ГДЕ
					|	Сотрудники.Ссылка В(&СписокСотрудников)
					|
					|ОБЪЕДИНИТЬ ВСЕ
					|
					|ВЫБРАТЬ РАЗЛИЧНЫЕ
					|	ФизическиеЛица.Ссылка
					|ИЗ
					|	Справочник.ФизическиеЛица КАК ФизическиеЛица
					|ГДЕ
					|	ФизическиеЛица.Ссылка В(&СписокСотрудников)";
					
				УчитываемыеСотрудники = Новый ФиксированныйМассив(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ФизическоеЛицо"));
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли; 
	
	УстановитьВидимость();
	
	ЗаполнитьФормуНаСервере(Параметры.СведенияОбИПН,Параметры.ВычетыИПН, Истина);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыНалогиВзносыОтчисления

&НаКлиенте
Процедура НалогиВзносыОтчисленияПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанны = Элементы.НалогиВзносыОтчисления.ТекущиеДанные;
	Если ТекущиеДанны = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый ФиксированнаяСтруктура(Новый Структура("ИдентификаторСтрокиНалогиВзносыОтчисления", ТекущиеДанны.ИдентификаторСтрокиНалогиВзносыОтчисления));
	Элементы.ВычетыИПН.ОтборСтрок = Отбор;
	
	Элементы.ДекорацияФизЛицо.Заголовок = ТекущиеДанны.ФизическоеЛицо;
	
КонецПроцедуры


#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьВидимость()
	
	ДатаКонтроля = '2018-01-01';
	ДатаИспользованияКорректировки = '2019-01-01';
	ДатаУменьшенияОблагаемогоДохода = '2021-01-01';
	ВидимостьВычетов = МесяцНачисления >= ДатаКонтроля;
	ВидимостьКорректировкиДохода = МесяцНачисления >= ДатаИспользованияКорректировки;
	ВидимостьУменьшениеОблагаемогоДохода = МесяцНачисления >= ДатаУменьшенияОблагаемогоДохода;
	
	Элементы.ГруппаВычеты.Видимость = ВидимостьВычетов;
	Элементы.НалогиВзносыОтчисленияРазрешенныйВычет.Видимость  = НЕ ВидимостьВычетов;
	Элементы.НалогиВзносыОтчисленияПримененныйВычет.Видимость  = НЕ ВидимостьВычетов;
	Элементы.НалогиВзносыОтчисленияПримененнаяЛьгота.Видимость = НЕ ВидимостьВычетов ИЛИ ВидимостьКорректировкиДохода ИЛИ ВидимостьУменьшениеОблагаемогоДохода;
	Элементы.НалогиВзносыОтчисленияПрочиеВычеты.Видимость      = НЕ ВидимостьВычетов;
	Элементы.НалогиВзносыОтчисленияОПВ.Видимость               = НЕ ВидимостьВычетов;
	Элементы.НалогиВзносыОтчисленияВОСМС.Видимость             = НЕ ВидимостьВычетов;
	
	Если ВидимостьУменьшениеОблагаемогоДохода Тогда
		Элементы.НалогиВзносыОтчисленияПримененнаяЛьгота.Заголовок = НСтр("ru= 'Сумма уменьшения облагаемого дохода'");	
	ИначеЕсли ВидимостьКорректировкиДохода Тогда
		Элементы.НалогиВзносыОтчисленияПримененнаяЛьгота.Заголовок = НСтр("ru= 'Примененная корректировка дохода'");	
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьФормуНаСервере(Знач СведенияОбИПН,Знач СведенияОВычетахИПН, Знач ПервичноеЗаполнение)
	
	ТабличныеЧастиНалогиВзносыОтчисления = ПолучитьИзВременногоХранилища(СведенияОбИПН);
	ТабличныеЧастиНалогиВзносыОтчисления.Свойство("АдресРаспределенияРезультатовВХранилище", АдресРаспределенияРезультатовВХранилище);
	
	ТабличныеЧастиВычетыИПН = ПолучитьИзВременногоХранилища(СведенияОВычетахИПН);
	
	Если ТолькоПросмотр И ТабличныеЧастиНалогиВзносыОтчисления.НалогиВзносыОтчисления.Количество() = 0
		Или УчитываемыеСотрудники = Неопределено ИЛИ УчитываемыеСотрудники.Количество() = 0 Тогда
		
		ВызватьИсключение  НСтр("ru='Нет сведений о расчете налогов, взносов и отчислений'");
		
	КонецЕсли; 

	ЕдинственныйСотрудник = УчитываемыеСотрудники.Количество() < 2;
	Если ПервичноеЗаполнение Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы,
			"НалогиВзносыОтчисленияФизическоеЛицо",
			"ПараметрыВыбора",
			Новый ФиксированныйМассив(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Новый ПараметрВыбора("Отбор.Ссылка", УчитываемыеСотрудники))));
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы,
			"НалогиВзносыОтчисленияФизическоеЛицо",
			"Видимость",
			Не ЕдинственныйСотрудник);
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы,
			"НалогиВзносыОтчисленияПодразделение",
			"ПараметрыВыбора",
			Новый ФиксированныйМассив(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Новый ПараметрВыбора("Отбор.Владелец", Организация))));
		
		Элементы.НалогиВзносыОтчисления.ТекущаяСтрока	= 0;
		
		Если ТолькоПросмотр Тогда
			Элементы.НалогиВзносыОтчисления.ПоложениеКоманднойПанели	= ПоложениеКоманднойПанелиЭлементаФормы.Нет;
			Элементы.НалогиВзносыОтчисления.ИзменятьСоставСтрок		= Ложь;
		КонецЕсли;
			
	КонецЕсли; 
	
	// Инициализация табличных частей
	НалогиВзносыОтчисления.Загрузить(ТабличныеЧастиНалогиВзносыОтчисления.НалогиВзносыОтчисления);
	
	ВычетыИПН.Загрузить(ТабличныеЧастиВычетыИПН.ВычетыИПН);
	Если ЕдинственныйСотрудник Тогда
		Элементы.НалогиВзносыОтчисления.ОтборСтрок = Новый ФиксированнаяСтруктура("ФизическоеЛицо", УчитываемыеСотрудники[0]);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
