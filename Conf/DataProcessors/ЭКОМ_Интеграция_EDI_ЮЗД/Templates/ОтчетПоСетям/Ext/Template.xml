				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ЭКОМ_GLN.Контрагент_ФорматЭСФ,
	ЭКОМ_Объекты_События.Контрагент,
	ЭКОМ_ЦепочкиДокументовПокупателя.ТочкаДоставки,
	ЭКОМ_Объекты_События.ЗаказНомер
ПОМЕСТИТЬ ВТ
ИЗ
	РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_События
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_ЦепочкиДокументовПокупателя КАК ЭКОМ_ЦепочкиДокументовПокупателя
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN
			ПО ЭКОМ_ЦепочкиДокументовПокупателя.Контрагент = ЭКОМ_GLN.Объект
		по ЭКОМ_ЦепочкиДокументовПокупателя.Заказ = ЭКОМ_Объекты_События.Документ_Основание
ГДЕ
	ЭКОМ_Объекты_События.ЗаказДата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
	И ЭКОМ_Объекты_События.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.ORDER_Исходящий)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ.Контрагент_ФорматЭСФ,
	ВТ.Контрагент,
	ВТ.ТочкаДоставки КАК ТочкаДоставки,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ.ЗаказНомер) КАК КоличествоЗаказов
ИЗ
	ВТ КАК ВТ

СГРУППИРОВАТЬ ПО
	ВТ.Контрагент,
	ВТ.Контрагент_ФорматЭСФ,
	ВТ.ТочкаДоставки</query>
