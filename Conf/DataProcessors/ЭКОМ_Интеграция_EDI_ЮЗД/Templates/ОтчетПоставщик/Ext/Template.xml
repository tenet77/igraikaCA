		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ЭКОМ_ДокументыТЧ_ТоварыORDER.Номенклатура КАК Номенклатура,
	ЭКОМ_ЦепочкиДокументовПоставщика.ORDER КАК DocrobotORDER,
	ЭКОМ_ЦепочкиДокументовПоставщика.Заказ КАК Заказ,
	ЭКОМ_ЦепочкиДокументовПоставщика.RECADV КАК DocrobotRECADV,
	ЭКОМ_ЦепочкиДокументовПоставщика.Накладная КАК Накладная,
	ЕСТЬNULL(ЭКОМ_ДокументыТЧ_ТоварыORDER.КоличествоЗаказанное, 0) КАК Заказано,
	ЕСТЬNULL(ЭКОМ_ДокументыТЧ_ТоварыRECADV.КоличествоПоставляемое, 0) КАК Отправлено,
	ЕСТЬNULL(ЭКОМ_ДокументыТЧ_ТоварыRECADV.КоличествоПринятое, 0) КАК Принято
ИЗ
	РегистрСведений.ЭКОМ_ЦепочкиДокументовПоставщика КАК ЭКОМ_ЦепочкиДокументовПоставщика
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭКОМ_Документы.ТЧ_Товары КАК ЭКОМ_ДокументыТЧ_ТоварыORDER
		ПО ЭКОМ_ЦепочкиДокументовПоставщика.ORDER = ЭКОМ_ДокументыТЧ_ТоварыORDER.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭКОМ_Документы.ТЧ_Товары КАК ЭКОМ_ДокументыТЧ_ТоварыRECADV
		ПО ЭКОМ_ЦепочкиДокументовПоставщика.RECADV = ЭКОМ_ДокументыТЧ_ТоварыRECADV.Ссылка
			И (ЭКОМ_ДокументыТЧ_ТоварыORDER.Номенклатура = ЭКОМ_ДокументыТЧ_ТоварыRECADV.Номенклатура)
ГДЕ
	ЭКОМ_ЦепочкиДокументовПоставщика.ORDER = &amp;Регистратор
	И ЭКОМ_ЦепочкиДокументовПоставщика.Заказ = &amp;Заказ
	И ЭКОМ_ЦепочкиДокументовПоставщика.Накладная = &amp;Накладная
</query>
