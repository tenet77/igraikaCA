					Продолжить;
					
				КонецЕсли;
				
				МассивСтрок = Новый Массив;
				
				//Docrobot 1.19.0 MOD-1511 [Получаем данные для отправки из запроса]
				Если ТипДокумента = "DP_UVUTOCH_09" И ЭтоРегламентноеЗадание Тогда			
					МассивСтрок = ОтправитьАвто_Уточнения();
