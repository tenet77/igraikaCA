			|	ЭКОМ_ЦепочкиДокументовПоставщика.СтатусЮЗД = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_Статусы.ПустаяСсылка)";
			
			РезультатЗапроса = Запрос.Выполнить();	
			Выборка = РезультатЗапроса.Выбрать();		
			Пока Выборка.Следующий() Цикл
				МЗ = РегистрыСведений.ЭКОМ_ЦепочкиДокументовПоставщика.СоздатьМенеджерЗаписи();
				МЗ.ORDERDATE = Выборка.ORDERDATE;
				МЗ.Организация = Выборка.Организация;
				МЗ.Контрагент = Выборка.Контрагент;
				МЗ.ТочкаДоставки = Выборка.ТочкаДоставки;
				МЗ.ORDERNUMBER = Выборка.ORDERNUMBER;
				МЗ.ORDER = Выборка.ORDER;
				МЗ.Заказ = Выборка.Заказ;
				МЗ.Накладная = Выборка.Накладная;
				МЗ.DESADVNUMBER = Выборка.DESADVNUMBER;
				МЗ.DESADVDATE = Выборка.DESADVDATE;
				МЗ.RECADV = Выборка.RECADV;
				МЗ.СЧФ = Выборка.СЧФ;
				МЗ.ДатаСЧФ = Выборка.ДатаСЧФ;
				МЗ.НомерСЧФ = Выборка.НомерСЧФ;
				МЗ.Накладная_Кор = Выборка.Накладная_Кор;
				МЗ.СЧФ_Кор = Выборка.СЧФ_Кор;
				МЗ.RETANN = Выборка.RETANN;
				МЗ.ВозвратнаяНакладная = Выборка.ВозвратнаяНакладная;
				МЗ.INSDES = Выборка.INSDES;
				МЗ.Прочитать();
				
				МЗ.СтатусЮЗД = Выборка.Статус_УПД;
				
				МЗ.Записать();
				
			КонецЦикла;	
			
			// Смена номера элемента справочника после ввода предопределенного элемента.
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ЭКОМ_ТипыНеструктДокументов.Ссылка,
			|	ЭКОМ_ТипыНеструктДокументов.Код КАК Код,
			|	ЭКОМ_ТипыНеструктДокументов.Предопределенный КАК Предопределенный
			|ИЗ
			|	Справочник.ЭКОМ_ТипыНеструктДокументов КАК ЭКОМ_ТипыНеструктДокументов
			|
			|УПОРЯДОЧИТЬ ПО
			|	Код,
			|	Предопределенный УБЫВ";
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выгрузить();
			
			ТекущийКод 		= "";
			МаксимальныйКод = ?(ВыборкаДетальныеЗаписи.Количество() = 0, "0", ВыборкаДетальныеЗаписи.Получить(ВыборкаДетальныеЗаписи.Количество() - 1).Код);
			Для Каждого ЭлементСправочника Из ВыборкаДетальныеЗаписи Цикл
				
				Если ТекущийКод = ЭлементСправочника.Код
					И НЕ ЭлементСправочника.Предопределенный Тогда
					СправочникОбъект = ЭлементСправочника.Ссылка.ПолучитьОбъект();
					МаксимальныйКод = Формат(Число(МаксимальныйКод) + 1, "ЧЦ=5; ЧВН=; ЧГ=0");
					СправочникОбъект.Код = МаксимальныйКод;
					СправочникОбъект.Записать();        
				КонецЕсли;
				
				ТекущийКод = ЭлементСправочника.Код;
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если ОсновнаяВерсияОбработки >= 115 
			И ОсновнаяВерсияДоЗапуска < 115 Тогда
			// В версии 1.15 добавились статусные файлы для EDI, в связи с чем поменялся тип
			//	полей "Статус_*" для EDI в РС цепочек поставщика и покупателя.
			
			Отправлен 	= ПредопределенноеЗначение("Перечисление.ЭКОМ_СтатусыЭлектронныхДокументов.Отправлен");
			Получен		= ПредопределенноеЗначение("Перечисление.ЭКОМ_СтатусыЭлектронныхДокументов.Получен");
			СтатусПустой = ПредопределенноеЗначение("Перечисление.ЭКОМ_СтатусыЭлектронныхДокументов.ПустаяСсылка");
			
			СтатусыДляЗамены = Новый Структура("ЭКОМ_ЦепочкиДокументовПокупателя, ЭКОМ_ЦепочкиДокументовПоставщика",
				Новый Структура("Статус_ORDER, Статус_ORDRSP, Статус_DESADV, Статус_DESSCC, Статус_RECADV, Статус_INSDES, Статус_INVOICE, Статус_RETANN, Статус_RETINS, Статус_STATUS",
								Отправлен, Получен, Получен, Получен, Отправлен, Отправлен, Получен, Отправлен, Получен, Получен),
				Новый Структура("Статус_ORDER, Статус_ORDRSP, Статус_DESADV, Статус_DESSCC, Статус_RECADV, Статус_INSDES, Статус_INVOICE, Статус_RETANN, Статус_RETINS, Статус_STATUS",
								Получен, Отправлен, Отправлен, Отправлен, Получен, Получен, Отправлен, Получен, Отправлен, Получен));
								
			Для Каждого НаборСтатусов Из СтатусыДляЗамены Цикл
				НачатьТранзакцию();
				НаборЗаписей = РегистрыСведений[НаборСтатусов.Ключ].СоздатьНаборЗаписей();
				Выполнить("ЭКОМ_ПодпискаСобытий.ВыполнитьБлокировкуНабораЗаписей(НаборЗаписей.Отбор, НаборСтатусов.Ключ);");
				НаборЗаписей.Прочитать();
				
				Для Каждого Запись Из НаборЗаписей Цикл
					Для Каждого Статус Из НаборСтатусов.Значение Цикл
						Попытка
							Если Запись[Статус.Ключ] = Истина Тогда
								Запись[Статус.Ключ] = Статус.Значение;
							ИначеЕсли Запись[Статус.Ключ] = Ложь Тогда
								Запись[Статус.Ключ] = СтатусПустой;
							КонецЕсли;
						Исключение КонецПопытки;
					КонецЦикла;
				КонецЦикла;
				
				Если НаборЗаписей.Модифицированность() Тогда
					НаборЗаписей.Записать();
				КонецЕсли;
				ЗафиксироватьТранзакцию();
			КонецЦикла;
								
		КонецЕсли;
		
		
		Если ТребуетсяИзменение Тогда
			
			// Сохранение бекапа настроек.
			Отбор = Новый Массив;
			Отбор = Новый Массив;
			Отбор.Добавить("СтруктураФайлаXMLВходящие");
			Отбор.Добавить("СтруктураФайлаXMLИсходящие");
			Отбор.Добавить("СтруктураФайлаXMLДокументы");
			АдресВоВременномХранилище = ВыгрузитьНастройки(Новый Структура("ЭКОМ_ЗначениеДополнительныхКонстант", Истина), Отбор, МассивЛогаСобытий);
			
			РазделительПути = ЭКОМ_ПолучитьРазделительПути();
			Каталог = Настройка_Параметр_Прочитать("ЭКОМ_Локальный_Каталог_UPDATE", КаталогВременныхФайлов());
			Если НЕ Прав(Каталог, 1) = РазделительПути Тогда
				Каталог = Каталог + РазделительПути;
			КонецЕсли;
			
			Результат.ЕстьИзменения = Истина;
			Результат.ИмяФайлаНастроек = Каталог + "Настройки шаблонов документов от " + Формат(ТекущаяДата(), "ДФ=dd.MM.yy") + ", " + Метаданные.КраткаяИнформация + ".xml";
			Результат.ФайлНастроек = АдресВоВременномХранилище;
			
			
			// Добавление новой колонки.
			Если ЭКОМ_СтруктураФайлаXMLИсходящие.Колонки.Найти("Обязательный") = Неопределено Тогда
				ЭКОМ_СтруктураФайлаXMLИсходящие.Колонки.Добавить("Обязательный", Новый ОписаниеТипов("Булево"));
			КонецЕсли;
			
			
			// Изменение значения, хранящего атрибуты.
			АтрибутыСтруктураВСписокЗначений(ЭКОМ_СтруктураФайлаXMLИсходящие);
			
			
			// Перенос транзакций "Создать..." в отдельный шаблон.
			ЭКОМ_СтруктураФайлаXMLДокументы	= Настройка_Параметр_Прочитать("СтруктураФайлаXMLДокументы");
			
			Если ЭКОМ_СтруктураФайлаXMLДокументы = Неопределено
				ИЛИ НЕ ТипЗнч(ЭКОМ_СтруктураФайлаXMLДокументы) = Тип("ДеревоЗначений")
				ИЛИ ЭКОМ_СтруктураФайлаXMLДокументы.Колонки.Количество() = 0 Тогда
				
				ЭКОМ_СтруктураФайлаXMLДокументы = Новый ДеревоЗначений;
				ЭКОМ_СтруктураФайлаXMLДокументы.Колонки.Добавить("Использовать");
				ЭКОМ_СтруктураФайлаXMLДокументы.Колонки.Добавить("Кнопка");
				ЭКОМ_СтруктураФайлаXMLДокументы.Колонки.Добавить("КолонкаИсточника");
				ЭКОМ_СтруктураФайлаXMLДокументы.Колонки.Добавить("Источник");
				ЭКОМ_СтруктураФайлаXMLДокументы.Колонки.Добавить("Приемник");
				ЭКОМ_СтруктураФайлаXMLДокументы.Колонки.Добавить("СлужебныеТекст");
				ЭКОМ_СтруктураФайлаXMLДокументы.Колонки.Добавить("Формула");
				ЭКОМ_СтруктураФайлаXMLДокументы.Колонки.Добавить("Служебные");
				
			КонецЕсли;
			
			Колонки = Новый Массив;
			Колонки.Добавить("Источник");
			Колонки.Добавить("Приемник");
			Колонки.Добавить("СлужебныеТекст");
			Колонки.Добавить("Формула");
			Колонки.Добавить("Служебные");
			Колонки.Добавить("Использовать");
			
			СтрокиДляУдаления = Новый Массив;
			
			Для Каждого Строка Из ЭКОМ_СтруктураФайлаXMLВходящие.Строки Цикл
				Если Найти(Строка.ТипТранзакции, "Создать") = 1 Тогда
					
					НоваяСтрока = ЭКОМ_СтруктураФайлаXMLДокументы.Строки.Добавить();
					СкопироватьСтрокуДереваЗначений(Строка, НоваяСтрока, Колонки);
					НоваяСтрока.Кнопка = Строка.ТипТранзакции;
					
					// Определение колонки источника.
					Если НоваяСтрока.Кнопка = "Создать заказ" Тогда // Поставщик
						НоваяСтрока.КолонкаИсточника = "ЭКОМ_Документ_ORDER";
					ИначеЕсли НоваяСтрока.Кнопка = "Создать реализацию"
						ИЛИ НоваяСтрока.Кнопка = "Создать счет-фактуру выданный" Тогда
						Источник 		= СтрЗаменить((ПолучитьПутьКОбъектуКонфигурации(Строка, 1, "КолонкаИсточника", МассивЛогаСобытий)), "Документ.", "");
						ТипЗаказа		= ПолучитьТипДокументаЗаказаПокупателя(МассивЛогаСобытий);
						ТипРеализации 	= ПолучитьТипДокументаРеализации(МассивЛогаСобытий);
						Если Источник = ТипЗаказа Тогда
							НоваяСтрока.КолонкаИсточника = "ДокументЗаказа";
						ИначеЕсли Источник = ТипРеализации Тогда
							НоваяСтрока.КолонкаИсточника = "ДокументРеализации";
						Иначе
							НоваяСтрока.КолонкаИсточника = "ЭКОМ_Документ_ORDER";
						КонецЕсли;
					ИначеЕсли НоваяСтрока.Кнопка = "Создать возврат от покупателя" Тогда
						НоваяСтрока.КолонкаИсточника = "ЭКОМ_Документ_RETANN";
					ИначеЕсли НоваяСтрока.Кнопка = "Создать поступление" // Сеть
						ИЛИ НоваяСтрока.Кнопка = "Создать счет-фактуру полученный" Тогда
						Источник 		= СтрЗаменить((ПолучитьПутьКОбъектуКонфигурации(Строка, 1, "КолонкаИсточника", МассивЛогаСобытий)), "Документ.", "");
						ТипЗаказа		= ПолучитьТипДокументаЗаказаПоставщика(МассивЛогаСобытий);
						ТипПоступления 	= ПолучитьТипДокументаПоступления(МассивЛогаСобытий);
						Если Источник = ТипЗаказа Тогда
							НоваяСтрока.КолонкаИсточника = "ДокументЗаказа";
						ИначеЕсли Источник = ТипПоступления Тогда
							НоваяСтрока.КолонкаИсточника = "ДокументПоступления";
						ИначеЕсли Источник = "ЭКОМ_Документы" Тогда
							НоваяСтрока.КолонкаИсточника = "ЭКОМ_Документ_DESADV";
						КонецЕсли;
					КонецЕсли;
					
					СтрокиДляУдаления.Добавить(Строка);
					
				КонецЕсли;
			КонецЦикла;
			
			// Удаление перенесенных строк из дерева-донора.
			Для Каждого Строка Из СтрокиДляУдаления Цикл
				ЭКОМ_СтруктураФайлаXMLВходящие.Строки.Удалить(Строка);
			КонецЦикла;
			
			Если ЭКОМ_СтруктураФайлаXMLВходящие.Колонки.Найти("Кнопка") = Неопределено Тогда
				// Добавление колонки "Кнопка".
				ЭКОМ_СтруктураФайлаXMLВходящие.Колонки.Добавить("Кнопка", Новый ОписаниеТипов("Строка"));
				// Соответствие имен транзакций кнопкам.
				Соответствие = Новый Соответствие;
				Соответствие.Вставить("Входящий ORDER", 							"Заказы покупателей (ORDER)");
				Соответствие.Вставить("Входящий RECADV", 							"Уведомление о приемке (RECADV)");
				Соответствие.Вставить("Входящий RETANN (уведомление о возврате)", 	"Возвраты (RETANN)");
				Соответствие.Вставить("Входящий DPOTORG1 (акт о приемке товаров)", 	"Акты о приемке товаров ТОРГ-1 (DPOTORG1)");
				Соответствие.Вставить("Входящий DPOTORG2 (акт о расхождении)", 		"Акты о расхождении ТОРГ-2 (DPOTORG2)");
				Соответствие.Вставить("Входящий INSDES", 							"Инструкция о доставке (INSDES)");
				Соответствие.Вставить("Входящий DESADV", 							"Уведомление об отгрузке (DESADV)");
				Соответствие.Вставить("Входящий ORDRSP", 							"Подтверждения заказов (ORDRSP)");
				Соответствие.Вставить("Входящий RETINS (инструкция о возврате)", 	"Инструкция о возврате (RETINS)");
				Соответствие.Вставить("Входящий ЮЗД - универсальный передаточный документ", "ЮЗД (УПД / УКД / иУПД)");
				// Формирование названий кнопок.
				Для Каждого Строка Из ЭКОМ_СтруктураФайлаXMLВходящие.Строки Цикл
					Если НЕ ЗначениеЗаполнено(Строка.Кнопка) Тогда
						Строка.Кнопка = Соответствие.Получить(Строка.ТипТранзакции);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Если ЭКОМ_СтруктураФайлаXMLИсходящие.Колонки.Найти("Кнопка") = Неопределено Тогда
				// Добавление колонки "Кнопка".
				ЭКОМ_СтруктураФайлаXMLИсходящие.Колонки.Добавить("Кнопка", Новый ОписаниеТипов("Строка"));
				// Соответствие имен транзакций кнопкам.
				Соответствие = Новый Соответствие;
				Соответствие.Вставить("Исходящий RETORD (обратный заказ)", 								"Обратный заказ RETORD (ORDER)");
				Соответствие.Вставить("Исходящий ORDRSP (подтверждение заказа)", 						"Подтверждение заказа (ORDRSP)");
				Соответствие.Вставить("Исходящий DESADV (подтверждение отгрузки)", 						"Уведомление об отгрузке (DESADV)");
				Соответствие.Вставить("Исходящий DESSCC (уведомление об отгрузке)", 					"Уведомление об отгрузке (DESSCC)");
				Соответствие.Вставить("Исходящий INVOICE (счёт)", 										"Счет (INVOICE)");
				Соответствие.Вставить("Исходящий RETINS (инструкция о возврате)", 						"Инструкция о возврате (RETINS)");
				Соответствие.Вставить("Исходящий ЮЗД - универсальный передаточный документ", 			"ЮЗД (УПД / УКД / иУПД)");
				Соответствие.Вставить("Исходящий ORDER (заказ поставщику)", 							"Заказ (ORDER)");
				Соответствие.Вставить("Исходящий RECADV (уведомление о приеме)", 						"Уведомление о приемке (RECADV)");
				Соответствие.Вставить("Исходящий RETANN (уведомление о возврате)", 						"Возвраты (RETANN)");
				Соответствие.Вставить("Исходящий WHGOV_01 (Отгрузка - сообщение ГО) - ПЭП Кладовщика", 	"ПЭП Кладовщика (WHGOV 01)");
				Соответствие.Вставить("Исходящий WHGOU_04 (Отгрузка - титул ГО) - КЭП ГО", 				"Титул ГО (WHGOU 04)");
				Соответствие.Вставить("Исходящий WHGPV_05 (Приемка - сообщение ГП) - ПЭП", 				"ПЭП Приемщика (WHGPV 05)");
				Соответствие.Вставить("Исходящий WHGPU_08 (Приемка - титул ГП) - Титул ГП", 			"Титул ГП (WHGPU 08)");
				// Формирование названий кнопок.
				Для Каждого Строка Из ЭКОМ_СтруктураФайлаXMLИсходящие.Строки Цикл
					Если НЕ ЗначениеЗаполнено(Строка.Кнопка) Тогда
						Строка.Кнопка = Соответствие.Получить(Строка.ТипТранзакции);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			// Добавление и сохранение настроек для работы фильтра Condra.
			Если НЕ СлужебныйНастройкиФильтров = Неопределено И НЕ НастройкаФильтров.Свойство("ФильтрыCondra") Тогда
				НастройкаФильтров.Вставить("ФильтрыCondra", Новый ДеревоЗначений);
				Настройка_Параметр_Записать("_СлужебныйНастройкиФильтров", 	СлужебныйНастройкиФильтров, ТекущийПользователь);
			КонецЕсли;
			
			// Сохранение изменений.
			Настройка_Параметр_Записать("_СтруктураФайлаXMLВходящие", 	ЭКОМ_СтруктураФайлаXMLВходящие);
			Настройка_Параметр_Записать("_СтруктураФайлаXMLИсходящие", 	ЭКОМ_СтруктураФайлаXMLИсходящие);
			Настройка_Параметр_Записать("_СтруктураФайлаXMLДокументы", 	ЭКОМ_СтруктураФайлаXMLДокументы);
			
		КонецЕсли;
		
		// Первый запуск (или запуск на более ранних релизах до сохранения версии).
		Если ПустаяСтрока(ВерсияДоЗапуска) Тогда
			// Конвертация ролей.
			
			// Заполнение роли по умолчанию. 
			Попытка
				Роль = Справочники.ЭКОМ_Роли.ПоУмолчанию;
			Исключение // Для расширений.
				Роль = Справочники.ЭКОМ_Роли.НайтиПоНаименованию("По умолчанию");
			КонецПопытки;
			
			Если НЕ Роль = Неопределено Тогда
				Роль = Роль.ПолучитьОбъект();
				Роль.ОбновитьКнопки(ЭтоОФ);
				Роль.ОбновитьКолонки();
				Роль.Записать();
			КонецЕсли;
			
			// Перенос старых настроек пользователей в новые справочники.
			СтарыеНастройкиПользователей = Настройка_Параметр_Прочитать("ТЧПользователи", Неопределено);
			
			Если ТипЗнч(СтарыеНастройкиПользователей) = Тип("ТаблицаЗначений")
				И НЕ (СтарыеНастройкиПользователей.Колонки.Найти("Пользователь") = Неопределено
				ИЛИ СтарыеНастройкиПользователей.Колонки.Найти("Роль") = Неопределено) Тогда
				
				втСтарыеНастройкиПользователей = Новый ТаблицаЗначений;
				// Ограничение длины строки в типах колонок.
				Для Каждого Колонка Из СтарыеНастройкиПользователей.Колонки Цикл
					Тип = ?(Колонка.ТипЗначения.СодержитТип(Тип("Строка")), Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(300)), Колонка.ТипЗначения);
					втСтарыеНастройкиПользователей.Колонки.Добавить(Колонка.Имя, Тип);
				КонецЦикла;
				
				Для Каждого Строка Из СтарыеНастройкиПользователей Цикл
					ЗаполнитьЗначенияСвойств(втСтарыеНастройкиПользователей.Добавить(), Строка);
				КонецЦикла;
				
				СтарыеНастройкиПользователей = Неопределено;
				
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ РАЗЛИЧНЫЕ
				|	вт.Пользователь
				|ПОМЕСТИТЬ вт
				|ИЗ
				|	&Пользователи КАК вт
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	вт.Пользователь КАК Пользователь,
				|	ЕСТЬNULL(ЭКОМ_Пользователи.Ссылка, ЗНАЧЕНИЕ(Справочник.ЭКОМ_Пользователи.ПустаяСсылка)) КАК Ссылка
				|ИЗ
				|	вт КАК вт
				|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭКОМ_Пользователи КАК ЭКОМ_Пользователи
				|		ПО (вт.Пользователь = ЭКОМ_Пользователи.Пользователь)";
				
				Запрос.УстановитьПараметр("Пользователи", втСтарыеНастройкиПользователей);
				РезультатЗапроса = Запрос.Выполнить();
				ТЧПользователи = РезультатЗапроса.Выгрузить();
				
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ РАЗЛИЧНЫЕ
				|	вт.Роль,
				|	вт.Идентификатор
				|ПОМЕСТИТЬ вт
				|ИЗ
				|	&Роли КАК вт
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	вт.Роль КАК Роль,
				|	ЕСТЬNULL(ЭКОМ_Роли.Ссылка, ЗНАЧЕНИЕ(Справочник.ЭКОМ_Роли.ПустаяСсылка)) КАК Ссылка,
				|	ЭКОМ_ЗначениеДополнительныхКонстант.ЗначениеДополнительногоХранилища
				|ИЗ
				|	вт КАК вт
				|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭКОМ_Роли КАК ЭКОМ_Роли
				|		ПО (вт.Роль ПОДОБНО ЭКОМ_Роли.Наименование)
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_ЗначениеДополнительныхКонстант КАК ЭКОМ_ЗначениеДополнительныхКонстант
				|		ПО вт.Идентификатор = ЭКОМ_ЗначениеДополнительныхКонстант.Измерение
				|			И (ЭКОМ_ЗначениеДополнительныхКонстант.ДополнительнаяКонстанта = ""Роль"")";
				
				Запрос.УстановитьПараметр("Роли", втСтарыеНастройкиПользователей);
				РезультатЗапроса = Запрос.Выполнить();
				ТЧРоли = РезультатЗапроса.Выгрузить();
				
				СопоставлениеПути = Новый Соответствие;
				СопоставлениеПути.Вставить("ЗагрузитьДокументы", "__Входящие");
				СопоставлениеПути.Вставить("Отправить", "__Исходящие");
				СопоставлениеПути.Вставить("Документы", "__Документы");
				
				СозданныеПользователи 	= Новый Соответствие;
				СозданныеРоли 			= Новый Соответствие;
				
				Для Каждого Строка Из ТЧПользователи Цикл
					
					Пользователь 		= СозданныеПользователи.Получить(Строка.Пользователь);
					Если Пользователь 	= Неопределено Тогда 
						Пользователь 	= ?(Строка.Ссылка.Пустая(), Справочники.ЭКОМ_Пользователи.СоздатьЭлемент(), Строка.Ссылка.ПолучитьОбъект());
						Пользователь.Пользователь = Строка.Пользователь;
						Пользователь.Наименование = Строка(Строка.Пользователь);
					Иначе
						Пользователь 	= Пользователь.ПолучитьОбъект();
					КонецЕсли;
					
					РолиИмена		= втСтарыеНастройкиПользователей.НайтиСтроки(Новый Структура("Пользователь", Строка.Пользователь));
					Для Каждого СтрокаРоли Из РолиИмена Цикл
						РольИзЗапроса = ТЧРоли.Найти(СтрокаРоли.Роль, "Роль");
						Роль 		= СозданныеРоли.Получить(СтрокаРоли.Роль);
						Если Роль 	= Неопределено Тогда
							Роль 	= ?(НЕ РольИзЗапроса = Неопределено И НЕ РольИзЗапроса.Ссылка.Пустая(), РольИзЗапроса.Ссылка.ПолучитьОбъект(), Справочники.ЭКОМ_Роли.СоздатьЭлемент());
							Роль.Наименование = СтрокаРоли.Роль;
							Роль.ОбновитьКнопки();
							Роль.ОбновитьКолонки();
						Иначе
							Роль = Роль.ПолучитьОбъект();
						КонецЕсли;
						
						СтараяРоль = ?(ТипЗнч(РольИзЗапроса.ЗначениеДополнительногоХранилища) = Тип("ХранилищеЗначения"), РольИзЗапроса.ЗначениеДополнительногоХранилища.Получить(), Неопределено);
						
						Если НЕ ТипЗнч(Роль) = Тип("СправочникОбъект.ЭКОМ_Роли")
							ИЛИ НЕ ТипЗнч(СтараяРоль) = Тип("Структура") Тогда
							Продолжить;
						КонецЕсли;
						
						ТабличнаяЧасть = Неопределено;
						Если СтараяРоль.Свойство("ТабличнаяЧасть", ТабличнаяЧасть)
							И ТипЗнч(ТабличнаяЧасть) = Тип("ТаблицаЗначений") Тогда
							Для Каждого СтрокаТаблицыКолонок Из ТабличнаяЧасть Цикл
								СтрокиРоли = Роль.Колонки.НайтиСтроки(Новый Структура("Имя, Путь", СтрокаТаблицыКолонок.Имя, "Поставщик"));
								Для Каждого СтрокаРолиНов Из СтрокиРоли Цикл
									СтрокаРолиНов.Доступность = СтрокаТаблицыКолонок.Доступность;
								КонецЦикла;
							КонецЦикла;
						КонецЕсли;
						
						КнопкиКоманднойПанели = Неопределено;
						Если СтараяРоль.Свойство("ПанельОсновнойФормы", КнопкиКоманднойПанели)
							И ТипЗнч(КнопкиКоманднойПанели) = Тип("ТаблицаЗначений") Тогда
							Для Каждого КнопкаКоманднойПанели Из КнопкиКоманднойПанели Цикл
								КнопкиРоли = Роль.Кнопки.НайтиСтроки(Новый Структура("Синоним", КнопкаКоманднойПанели.Синоним));
								
								Для Каждого КнопкаРоли Из КнопкиРоли Цикл
									Если НЕ Найти(КнопкаРоли.Путь, СопоставлениеПути.Получить(КнопкаКоманднойПанели.Имя)) = Неопределено Тогда
										КнопкаРоли.Доступность = КнопкаКоманднойПанели.Доступность;
									КонецЕсли;
								КонецЦикла;
							КонецЦикла;
						КонецЕсли;
						
						Роль.Записать();
						СозданныеРоли.Вставить(СтрокаРоли.Роль, Роль.Ссылка);
						
						Если Пользователь.Роли.Найти(Роль.Ссылка, "Роль") = Неопределено Тогда
							СтрокаПользователя 		= Пользователь.Роли.Добавить();
							СтрокаПользователя.Роль = Роль.Ссылка;
						КонецЕсли;
						
						Пользователь.Записать();
						СозданныеПользователи.Вставить(Строка.Пользователь, Пользователь.Ссылка);
						// Удаление старых настроек для ролей (без архивирования).
						Роли = РегистрыСведений.ЭКОМ_ЗначениеДополнительныхКонстант.СоздатьМенеджерЗаписи();
						Роли.ДополнительнаяКонстанта = "Роль";
						Роли.Измерение = СтрокаРоли.Идентификатор;
						Роли.Прочитать();
						Роли.Удалить();
					КонецЦикла;
					
				КонецЦикла;		
			КонецЕсли;
			
			// Удаление старых настроек для ролей (без архивирования).
			ТЧПользователи = РегистрыСведений.ЭКОМ_ЗначениеДополнительныхКонстант.СоздатьМенеджерЗаписи();
			ТЧПользователи.ДополнительнаяКонстанта  = "ТЧПользователи";
			ТЧПользователи.Удалить();
			
			// Обновление инфополей.
			Справочники.ЭКОМ_ИнфоПоля.ОбновитьСправочникиИнфополей();
			
			// Обновление типов кондра.
			Справочники.ЭКОМ_ТипыНеструктДокументов.ОбновитьСправочникТиповНеструктурированныхДокументов();
		КонецЕсли;
		
		// Запись текущей версии.
		Настройка_Параметр_Записать("СлужебныйТекущаяВерсияОбработки", СтаршаяВерсия);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

// Процедура изменяет тип колонки Атрибут в дереве значений со структуры на список значений
//
Процедура АтрибутыСтруктураВСписокЗначений(ДеревоЗначений)
	
	Для Каждого СтрокаДерева Из ДеревоЗначений.Строки Цикл
		Если НЕ ТипЗнч(СтрокаДерева.Атрибуты) = Тип("СписокЗначений") Тогда
			
			СписокАтрибутов = Новый СписокЗначений;
			
			Если ТипЗнч(СтрокаДерева.Атрибуты) = Тип("Структура") Тогда
				Для Каждого СтрокаАтрибут Из СтрокаДерева.Атрибуты Цикл
					СписокАтрибутов.Добавить(СтрокаАтрибут.Ключ, СтрокаАтрибут.Значение);
				КонецЦикла;
			КонецЕсли;
			
			СтрокаДерева.Атрибуты = СписокАтрибутов;
			
		КонецЕсли;
		
		АтрибутыСтруктураВСписокЗначений(СтрокаДерева);
		
	КонецЦикла;
	
КонецПроцедуры // АтрибутыСтруктураВСписокЗначений()

Функция СформироватьDP_IZVPOL(ТипИзвещения, МассивЛогаСобытий) Экспорт
	
	ВидыДокументовЮЗД = Новый Массив;
	Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьПервичныеВидыДокументовЮЗД(ВидыДокументовЮЗД);");
	Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьИсправительныеВидыДокументовЮЗД(ВидыДокументовЮЗД);");
	Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьКорректировочныеВидыДокументовЮЗД(ВидыДокументовЮЗД);");

	ТипФайла     = "DP_IZVPOL";	
	Если ТипИзвещения = "DP_IZVPOL_04" Тогда
		
		ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_IZVPOL_04;
		// Отправитель квитаници - Организация
		// Получатель квитаници  - Оператор организации
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	DP_PDPOL_02.СчетФактура КАК СчетФактура,
		|	DP_PDPOL_02.СчетФактура.Представление КАК СчетФактураПредставление,
		|	DP_PDPOL_02.Идентификатор КАК ОснованиеИмяФайла,
		|	DP_PDPOL_02.ЭЦП КАК ОснованиеЭЦП,
		|	DP_PDPOL_02.ДатаЗаписи КАК ОснованиеДатаТранзакции,
		|	""DP_IZVPOL_04"" КАК ТипИзвещения,
		|	""DP_PDPOL_02"" КАК ТипОснованияИзвещения,
		|	DP_PDPOL_02.Организация КАК Организация,
		|	ЭКОМ_GLN_Организация.Сертификат.ИмяПодписанта КАК ОрганизацияИмяПодписанта,
		|	ЭКОМ_GLN_Организация.Сертификат.ФамилияПодписанта КАК ОрганизацияФамилияПодписанта,
		|	ЭКОМ_GLN_Организация.Сертификат.ДолжностьПодписанта КАК ОрганизацияДолжностьПодписанта,
		|	ЭКОМ_GLN_Организация.Сертификат.ОтчествоПодписанта КАК ОрганизацияОтчествоПодписанта,
		|	ЭКОМ_GLN_Организация.Сертификат КАК ОрганизацияСертификат,
		|	""ЮЛ"" КАК ПолучательТип,
		|	"""" КАК ПолучательИдОЭД,
		|	ЭКОМ_GLN_Организация.Партнер.Идентификатор КАК ПолучательОператорИд,
		|	ЭКОМ_GLN_Организация.Партнер.Наименование КАК ПолучательНаименование,
		|	ЭКОМ_GLN_Организация.Партнер.ИНН КАК ПолучательИНН,
		|	ЭКОМ_GLN_Организация.Партнер.КПП КАК ПолучательКПП,
		|	"""" КАК ОтправительТип,
		|	ЭКОМ_GLN_Организация.Ид_ОЭД КАК ОтправительИдОЭД,
		|	ЭКОМ_GLN_Организация.Партнер.Идентификатор КАК ОтправительОператорИд,
		|	DP_PDPOL_02.Организация.Наименование КАК ОтправительНаименование,
		|	DP_PDPOL_02.Организация.ИНН КАК ОтправительИНН,
		|	"""" КАК ОтправительКПП,
		|	ЭКОМ_GLN_Организация.Сертификат.ИмяПодписанта КАК ОтправительИмяПодписанта,
		|	ЭКОМ_GLN_Организация.Сертификат.ФамилияПодписанта КАК ОтправительФамилияПодписанта,
		|	ЭКОМ_GLN_Организация.Сертификат.ОтчествоПодписанта КАК ОтправительОтчествоПодписанта,
		|	DP_PDPOL_02.ЗаказДата,
		|	DP_PDPOL_02.ЗаказНомер,
		|	DP_PDPOL_02.Контрагент,
		|	ЭКОМ_Объекты_СобытияЮЗД.ЭЦП КАК ЭЦПотЮЗД,
		|	DP_PDPOL_02.НомерДокумента,
		|	DP_PDPOL_02.ДатаДокумента
		|ИЗ
		|	(ВЫБРАТЬ
		|		ЭКОМ_Объекты_СобытияDP_PDPOL_02.Документ_Основание КАК СчетФактура,
		|		ЭКОМ_Объекты_СобытияDP_PDPOL_02.Идентификатор КАК Идентификатор,
		|		ЭКОМ_Объекты_СобытияDP_PDPOL_02.ДатаЗаписи КАК ДатаЗаписи,
		|		ЭКОМ_Объекты_СобытияDP_PDPOL_02.Организация КАК Организация,
		|		ЭКОМ_Объекты_СобытияDP_PDPOL_02.ЭЦП КАК ЭЦП,
		|		ЭКОМ_Объекты_СобытияDP_PDPOL_02.ЗаказДата КАК ЗаказДата,
		|		ЭКОМ_Объекты_СобытияDP_PDPOL_02.ЗаказНомер КАК ЗаказНомер,
		|		ЭКОМ_Объекты_СобытияDP_PDPOL_02.Контрагент КАК Контрагент,
		|		ЭКОМ_Объекты_СобытияDP_PDPOL_02.НомерДокумента КАК НомерДокумента,
		|		ЭКОМ_Объекты_СобытияDP_PDPOL_02.ДатаДокумента КАК ДатаДокумента
		|	ИЗ
		|		РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_СобытияDP_PDPOL_02
		|	ГДЕ
		|		ЭКОМ_Объекты_СобытияDP_PDPOL_02.НаправлениеОбмена = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_НаправлениеОбмена.Входящий)
		|		И ЭКОМ_Объекты_СобытияDP_PDPOL_02.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.DP_PDPOL_02)
		|		И ЭКОМ_Объекты_СобытияDP_PDPOL_02.ДатаЗаписи < ДАТАВРЕМЯ(2021, 7, 1)) КАК DP_PDPOL_02
