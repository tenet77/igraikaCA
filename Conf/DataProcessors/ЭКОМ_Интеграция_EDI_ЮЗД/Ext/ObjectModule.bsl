Функция ПолучитьСписокСтран() Экспорт   
	Список = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЭКОМ_ПрофилиОбмена.Страна КАК Страна,
		|	ЭКОМ_ПрофилиОбмена.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ЭКОМ_ПрофилиОбмена КАК ЭКОМ_ПрофилиОбмена";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Список.Добавить(Выборка.Страна,Выборка.Ссылка);
		Список.Добавить("ru\kz",Выборка.Ссылка);
	КонецЕсли;
	
	Возврат Список;
КонецФункции
// Процедура для УФ и ОФ - отправка документов по кнопке 
Функция ДинамическаяКнопкаОтправить(ДанныеСписка, ИмяКнопки, СоответствиеКолонок, МассивЛогаСобытий) Экспорт
	
	ИмяСобытия = "Отправка документов";
	ЕстьОшибка            = Ложь;
	ИмяСтатуса            = "";
	НужнаПодпись          = Ложь;
	ТипДокумента          = "";
	ИмяДокументаИсточника = "";
	
	// Заполнение параметров для вызова процедуры отправки документов.	
	Заглавные = "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЧЦШЩЪЫЬЭЮЯABCDEFGHIJKLMNOPQRSTUVWXYZ";
	ПозицииЗаглавных = Новый Массив;
	Для Номер = 1 По СтрДлина(ИмяКнопки) Цикл
		Символ = Сред(ИмяКнопки, Номер, 1);
		Если НЕ Найти(Заглавные, Символ) = 0 Тогда
			ПозицииЗаглавных.Добавить(Номер);
		КонецЕсли;
	КонецЦикла;
	ИмяОперации = "";
	Если ПозицииЗаглавных.Количество() = 2 Тогда
		ИмяОперации = Прав(ИмяКнопки, СтрДлина(ИмяКнопки) - (ПозицииЗаглавных.Получить(1) - 1));
	ИначеЕсли ПозицииЗаглавных.Количество() > 2 Тогда
		ИмяОперации = Сред(ИмяКнопки, ПозицииЗаглавных.Получить(1), ПозицииЗаглавных.Получить(2) - ПозицииЗаглавных.Получить(1));
		// Если есть "CONDRA", значит берем в имя операции и 3-е слово.
		Если НЕ Найти(ВРег(ИмяКнопки), "CONDRA") = 0 Тогда
			ИмяОперации = ИмяОперации + Прав(ИмяКнопки, СтрДлина(ИмяКнопки) - ПозицииЗаглавных.Получить(2) + 1);
		КонецЕсли;
	Иначе
		ТекстЛогаСобытий = "Непредвиденное имя кнопки: " + ИмяКнопки;
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
				
		ЕстьОшибка = Истина;
	КонецЕсли;
	ИмяОперации = ВРег(ИмяОперации);
	Если ПустаяСтрока(ИмяОперации) 
		И ЕстьОшибка = Ложь Тогда
		ТекстЛогаСобытий = "Не определен вид операции";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
		ЕстьОшибка = Истина;
	КонецЕсли;
	
	Если ЕстьОшибка = Ложь Тогда
		СоответсвиеСтатусов = Новый Соответствие;
		КлючиСтруктуры = "Статус, НужнаПодпись";
		// Поставщик
		СоответсвиеСтатусов.Вставить("RETORD"       , Новый Структура(КлючиСтруктуры, "Статус_RETORD", Ложь)); // обратный заказ
		СоответсвиеСтатусов.Вставить("ORDRSP"       , Новый Структура(КлючиСтруктуры, "Статус_ORDRSP", Ложь));
		СоответсвиеСтатусов.Вставить("DESADV",        Новый Структура(КлючиСтруктуры, "Статус_DESADV", Ложь));
		СоответсвиеСтатусов.Вставить("DESSCC",        Новый Структура(КлючиСтруктуры, "Статус_DESSCC", Ложь));
		СоответсвиеСтатусов.Вставить("RETINS",        Новый Структура(КлючиСтруктуры, "Статус_RETINS", Ложь)); // инструкция о возврате
		СоответсвиеСтатусов.Вставить("INVOICE",       Новый Структура(КлючиСтруктуры, "Статус_INVOICE", Ложь));
		//СоответсвиеСтатусов.Вставить("ON_SCHFDOPPR",  Новый Структура(КлючиСтруктуры, "Статус_УПД", Истина));
		СоответсвиеСтатусов.Вставить("ON_NSCHFDOPPR", Новый Структура(КлючиСтруктуры, "Статус_УПД", Истина));
		СоответсвиеСтатусов.Вставить("ЮЗД",           Новый Структура(КлючиСтруктуры, "Статус_УПД", Истина));
		
		// Покупатель
		СоответсвиеСтатусов.Вставить("ORDER" , Новый Структура(КлючиСтруктуры,"Статус_ORDER", Ложь));
		СоответсвиеСтатусов.Вставить("RECADV", Новый Структура(КлючиСтруктуры,"Статус_RECADV", Ложь));
		СоответсвиеСтатусов.Вставить("RETANN", Новый Структура(КлючиСтруктуры,"Статус_RETANN", Ложь)); // уведомление о возврате
		СоответсвиеСтатусов.Вставить("STATUS", Новый Структура(КлючиСтруктуры,"Статус_STATUS", Ложь)); // служебный документ
		
		// Аннулирование
		СоответсвиеСтатусов.Вставить("DP_PRANNUL_22", Новый Структура(КлючиСтруктуры,"Статус_УПД", Истина)); //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _22]
		СоответсвиеСтатусов.Вставить("DP_IZVPOL_23" , Новый Структура(КлючиСтруктуры,"Статус_УПД", Истина)); // подтверждение аннулирования
		СоответсвиеСтатусов.Вставить("DP_UVUTOCH_24", Новый Структура(КлючиСтруктуры,"Статус_УПД", Истина)); // отклонение аннулирования
		
		// ЭТРН
		// Отправитель
		СоответсвиеСтатусов.Вставить("WHGOV_01", Новый Структура(КлючиСтруктуры,"Статус_WHGOV_01", Ложь));
		СоответсвиеСтатусов.Вставить("WHGOU_04", Новый Структура(КлючиСтруктуры,"Статус_WHGOU_04", Истина));	
		// Получатель
		СоответсвиеСтатусов.Вставить("WHGPV_05", Новый Структура(КлючиСтруктуры,"Статус_WHGPV_05", Ложь));
		СоответсвиеСтатусов.Вставить("WHGPU_08", Новый Структура(КлючиСтруктуры,"Статус_WHGPU_08", Истина));
		
		// Прочие
		СоответсвиеСтатусов.Вставить("CONDRA"          , Новый Структура(КлючиСтруктуры,"Статус", Истина));
		СоответсвиеСтатусов.Вставить("CONDRA_ПРИНЯТЬ"  , Новый Структура(КлючиСтруктуры,"Статус", Истина));
		СоответсвиеСтатусов.Вставить("CONDRA_ОТКЛОНИТЬ", Новый Структура(КлючиСтруктуры,"Статус", Истина));
		СоответсвиеСтатусов.Вставить("CONDRA_ОТПРАВИТЬ"  , Новый Структура(КлючиСтруктуры,"Статус", Истина));
		СоответсвиеСтатусов.Вставить("DP_REZRUISP"     , Новый Структура(КлючиСтруктуры,"Статус_УПД", Истина));
		
		ЭКОМ_ПодписыватьПрайсЛист = Настройка_Параметр_Прочитать("ЭКОМ_ПодписыватьПрайсЛист", Ложь);
		Если ЭКОМ_ПодписыватьПрайсЛист = Истина Тогда
			СоответсвиеСтатусов.Вставить("PRICAT"          , Новый Структура(КлючиСтруктуры,"СтатусОбработкиДокумента", Истина));   
		Иначе	
			СоответсвиеСтатусов.Вставить("PRICAT"          , Новый Структура(КлючиСтруктуры,"СтатусОбработкиДокумента", Ложь));
		КонецЕсли;
		
		ДанныеПоОперации = СоответсвиеСтатусов.Получить(ИмяОперации);
		Если ДанныеПоОперации = Неопределено Тогда
			ТекстЛогаСобытий = "Ошибка отправки документа! - имя операции " + ИмяОперации;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			ЕстьОшибка = Истина;
		КонецЕсли;		
	КонецЕсли;
	
	Если ЕстьОшибка = Ложь Тогда
		НужнаПодпись = ДанныеПоОперации.НужнаПодпись;
		ИмяСтатуса   = ДанныеПоОперации.Статус;	
		Если ДанныеСписка.ИмяСписка = "СписокДляПокупателя"
			И (Найти(ИмяОперации, "ON_SCHFDOPPR") > 0 
			ИЛИ Найти(ИмяОперации, "ON_NSCHFDOPPR") > 0
			ИЛИ Найти(ИмяОперации, "DP_REZRUISP") > 0) Тогда		
			ИмяСтатуса 		= ИмяСтатуса 	+ "_Исходящий";
			
		ИначеЕсли Найти(ИмяСтатуса, "WHGOV_01") > 0
			ИЛИ Найти(ИмяСтатуса, "WHGOU_04") > 0  
			ИЛИ Найти(ИмяСтатуса, "WHGPV_05") > 0
			ИЛИ Найти(ИмяСтатуса, "WHGPU_08") > 0 Тогда	
			ИмяОперации = ИмяОперации + "_Исходящий";
			
		ИначеЕсли ИмяОперации = "DP_PRANNUL_22" Тогда //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _22]		
			ИмяОперации = ИмяОперации + "_" + ДанныеСписка.ТипОбмена;                                
			
		КонецЕсли;
		
		Если ИмяОперации = "ON_SCHFDOPPR"
			ИЛИ ИмяОперации = "ON_NSCHFDOPPR" Тогда
			ТипДокумента = "ЮЗД";
		Иначе	
			ТипДокумента = ИмяОперации;
		КонецЕсли;
		
		ИмяДокументаИсточника = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьИмяДокументаИсточника(СоответствиеКолонок, ТипДокумента, МассивЛогаСобытий)");
			
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("ЕстьОшибка",            ЕстьОшибка);
	Результат.Вставить("ИмяСтатуса",            ИмяСтатуса);
	Результат.Вставить("ИмяДокументаИсточника", ИмяДокументаИсточника);
	Результат.Вставить("ТипДокумента",          ТипДокумента);
	Результат.Вставить("НужнаПодпись",          НужнаПодпись);
	
	Возврат Результат;
	
КонецФункции 

Функция ДинамическаяКнопкаПолучить(ДанныеСписка, ИмяКнопки, МассивЛогаСобытий) Экспорт
	
	СписокОпераций = Новый Массив;
	ИмяСобытия     = "Проверка/загрузка документов";
	
	Если НЕ ДанныеСписка.ТипОбмена = "ЭТРН" Тогда
		// Все входящие EDI.
		
		Заглавные = "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЧЦШЩЪЫЬЭЮЯABCDEFGHIJKLMNOPQRSTUVWXYZ";
		ПозицииЗаглавных = Новый Массив;
		Для Номер = 1 По СтрДлина(ИмяКнопки) Цикл
			Символ = Сред(ИмяКнопки, Номер, 1);
			Если НЕ Найти(Заглавные, Символ) = 0 Тогда
				ПозицииЗаглавных.Добавить(Номер);
			КонецЕсли;
		КонецЦикла;
		ИмяОперации = "";
		Если ПозицииЗаглавных.Количество() = 2 Тогда
			ИмяОперации = Прав(ИмяКнопки, СтрДлина(ИмяКнопки) - (ПозицииЗаглавных.Получить(1) - 1));
		ИначеЕсли ПозицииЗаглавных.Количество() > 2 Тогда
			ИмяОперации = Сред(ИмяКнопки, ПозицииЗаглавных.Получить(1), ПозицииЗаглавных.Получить(2) - ПозицииЗаглавных.Получить(1));
		Иначе				
			ТекстЛогаСобытий = "Непредвиденное имя кнопки: " + ИмяКнопки; 
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);			
						
			Возврат СписокОпераций;
			
		КонецЕсли;
		ИмяОперации = ВРег(ИмяОперации);
		Если ПустаяСтрока(ИмяОперации) Тогда			
			ТекстЛогаСобытий = "Не определен вид операции"; 
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);			
					
			Возврат СписокОпераций;
			
		КонецЕсли;
		
		Если ИмяОперации = "ON_SCHFDOPPR" Тогда  //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _01. 2 этап]
			ИмяОперации = "ON_SCHFDOPPR_01";		
		КонецЕсли;
		
		СписокОпераций.Добавить(ИмяОперации);
		
		// Дополнительные операции для ЮЗД.
		ИндексЭлемента = СписокОпераций.Найти("ЮЗД");
		Если НЕ ИндексЭлемента = Неопределено 
			ИЛИ НЕ СписокОпераций.Найти("ON_SCHFDOPPR") = Неопределено Тогда		
			
		    Если НЕ ИндексЭлемента = Неопределено Тогда
			     СписокОпераций.Удалить(ИндексЭлемента);	
			КонецЕсли;

			СписокОпераций.Добавить("ON_NSCHFDOPPR_01");        //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _01. 2 этап]
			СписокОпераций.Добавить("ON_NSCHFDOPPRPROS_01");    //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _01. 2 этап]
			СписокОпераций.Добавить("ON_NSCHFDOPPRMARK_01");    //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _01. 2 этап]
			СписокОпераций.Добавить("ON_NKORSCHFDOPPR_01");     //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _01. 2 этап]
			СписокОпераций.Добавить("ON_NKORSCHFDOPPRMARK_01"); //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _01. 2 этап]
			СписокОпераций.Добавить("ON_NKORSCHFDOPPRPROS_01"); //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _01. 2 этап]
			
		КонецЕсли;

	Иначе
		// Операции для ЭТРН.
		ЭКОМ_ТипОбменаЭТРН_Отправитель = Настройка_Параметр_Прочитать("ЭКОМ_ТипОбменаЭТРН_Отправитель", Ложь);
		ЭКОМ_ТипОбменаЭТРН_Получатель  = Настройка_Параметр_Прочитать("ЭКОМ_ТипОбменаЭТРН_Получатель", Ложь);
		
		СписокОпераций.Добавить("DRVGOV_02_Входящий");
		СписокОпераций.Добавить("DRVGOU_03_Входящий");
		Если ЭКОМ_ТипОбменаЭТРН_Получатель = Истина Тогда
			СписокОпераций.Добавить("WHGOU_04_Входящий");
		КонецЕсли;
		СписокОпераций.Добавить("DRVGPV_06_Входящий");
		СписокОпераций.Добавить("DRVGPU_07_Входящий");	
		Если ЭКОМ_ТипОбменаЭТРН_Отправитель = Истина Тогда
			СписокОпераций.Добавить("WHGPU_08_Входящий");
		КонецЕсли;
		СписокОпераций.Добавить("DP_Статусы");
	КонецЕсли;
	
	Если Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_ПолучатьСтатусФайлы"", Ложь, Неопределено, Ложь)") Тогда
		СписокОпераций.Добавить("STATUS");
	КонецЕсли;
	
	Возврат СписокОпераций;
	
КонецФункции 

// Создает и заполняет табличный документ по макету ШК_Паллеты для вывода на печать
//
// Параметры:
//  ДокументСсылка  - ДокументСсылка - ссылка на документ реализации
//  ТаблицаПалеты  - ТаблицаЗначений - табличная часть формы DESSCC с информацией о данных PACKINGSEQUENCE
//
// Возвращаемое значение:
//   ТабличныйДокумент   - документ для вывода на печать
//
Функция ЗаполнитьМакетШК_Паллеты(ДокументСсылка, ТаблицаПалеты, МассивЛогаСобытий) Экспорт

	КомпонентаПечатиШтрихкодов = ПолучитьВнешнююКомпонентуГенерацииШтрихкода(МассивЛогаСобытий);
	
	ПараметрыШтрихкода = Новый Структура;
	
	ПараметрыШтрихкода.Вставить("Масштабировать", Истина);
	КоличествоМиллиметровВПикселе = 0.26454;
	ПараметрыШтрихкода.Вставить("Ширина", 0);
	ПараметрыШтрихкода.Вставить("Высота", 0);
	ПараметрыШтрихкода.Вставить("Штрихкод", "");
	ПараметрыШтрихкода.Вставить("ТипКода", 2);
	ПараметрыШтрихкода.Вставить("РазмерШрифта", 8);
	ПараметрыШтрихкода.Вставить("ОтображатьТекст", Ложь);
	ПараметрыШтрихкода.Вставить("УголПоворота", 0);
	ПараметрыШтрихкода.Вставить("GS1DatabarКоличествоСтрок", 2);
	
	Данные = ПолучитьДанныеДляПечати(ДокументСсылка, МассивЛогаСобытий);
	
	Если Данные.Шапка.НетINSDES Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Макет = ПолучитьМакет("ШК_Паллеты");
	
	ТабДок = Новый ТабличныйДокумент;

	ПерваяСтрока = Истина;
	
	Для Каждого Палета из ТаблицаПалеты Цикл
		
		ТоварыНаПалете = Данные.Товары.НайтиСтроки(Новый Структура("SSCC", Палета.SSCC));
		Если ТоварыНаПалете.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ПерваяСтрока Тогда
			ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ВыводСПроверкой = Новый Массив;
		
		// Вывод группы Шапка.
		Если Найти(Данные.Шапка.ФорматЭСФ, "УПД Лента") = 0 Тогда // Все кроме Ленты
			
			ОбластьМакета = Макет.ПолучитьОбласть("ШапкаX5");
			ОбластьМакета.Параметры.Заполнить(Данные.Шапка);
			ТабДок.Вывести(ОбластьМакета);
			
			Для НомерСтроки = 1 По ТоварыНаПалете.Количество() Цикл
				
				ВыводСПроверкой.Очистить();
				
				ОбластьМакета = Макет.ПолучитьОбласть("СтрокаТоваровX5");
				ОбластьМакета.Параметры.Заполнить(ТоварыНаПалете.Получить(НомерСтроки - 1));
				
				Если НомерСтроки = 1 Тогда // Шапка и первая строка
					ВыводСПроверкой.Добавить(Макет.ПолучитьОбласть("ШапкаТоваров"));
					ВыводСПроверкой.Добавить(ОбластьМакета);
					Если ТоварыНаПалете.Количество() = 1 Тогда 
						ВыводСПроверкой.Добавить(Макет.ПолучитьОбласть("ЛинияВнизуТаблицы"));
					КонецЕсли;
				ИначеЕсли НомерСтроки = ТоварыНаПалете.Количество() Тогда // Последняя строка и окончание таблицы
					ВыводСПроверкой.Добавить(ОбластьМакета);
					ВыводСПроверкой.Добавить(Макет.ПолучитьОбласть("ЛинияВнизуТаблицы"));
				Иначе // Отдельные строки
					ВыводСПроверкой.Добавить(ОбластьМакета);
				КонецЕсли;	
				
				// Переход на новую строаницу, если не помещаемся.
				Если НЕ ТабДок.ПроверитьВывод(ВыводСПроверкой) Тогда
					ТабДок.ВывестиГоризонтальныйРазделительСтраниц(); 
				КонецЕсли;
				
				Для Каждого Вывод Из ВыводСПроверкой Цикл
					ТабДок.Вывести(Вывод);
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЕсли;
		
		// Вывод группы Контрагенты.
		ВыводСПроверкой.Очистить();
		ОбластьМакета = Макет.ПолучитьОбласть("Контрагенты");
		ОбластьМакета.Параметры.Заполнить(?(Найти(Данные.Шапка.ФорматЭСФ, "УПД Лента") = 0, Данные.Шапка, ТоварыНаПалете.Получить(НомерСтроки - 1)));
		ВыводСПроверкой.Добавить(ОбластьМакета);
		
		Если Найти(Данные.Шапка.ФорматЭСФ, "УПД Лента") = 0 Тогда // Все кроме Ленты
			ОбластьМакета = Макет.ПолучитьОбласть("КонтрагентыНеЛента");
			ОбластьМакета.Параметры.Заполнить(Данные.Шапка);
			ВыводСПроверкой.Добавить(ОбластьМакета);
		Иначе
			ВыводСПроверкой.Добавить(Макет.ПолучитьОбласть("ЛинияВнизуТаблицы"));
		КонецЕсли;
		
		Если НЕ ТабДок.ПроверитьВывод(ВыводСПроверкой) Тогда
			ТабДок.ВывестиГоризонтальныйРазделительСтраниц(); 
		КонецЕсли;
		
		Для Каждого Вывод Из ВыводСПроверкой Цикл
			ТабДок.Вывести(Вывод);
		КонецЦикла;
		
		// Вывод группы SSCC.
		Для НомерСтроки = 1 По ТоварыНаПалете.Количество() Цикл
			
			ВыводСПроверкой.Очистить();
			
			ОбластьМакета = Макет.ПолучитьОбласть("СтрокаКонтейнеры");
			ОбластьМакета.Параметры.Заполнить(ТоварыНаПалете.Получить(НомерСтроки - 1));
			
			Если НомерСтроки = 1 Тогда // Шапка и первая строка
				
				ВыводСПроверкой.Добавить(Макет.ПолучитьОбласть("ШапкаКонтейнерыSSCC"));
				ВыводСПроверкой.Получить(0).Параметры.Заполнить(ТоварыНаПалете.Получить(НомерСтроки - 1));
				РисунокШтрихкод = ВыводСПроверкой.Получить(0).Рисунки.Штрихкод;
				
				ПараметрыШтрихкода.Ширина = Окр(РисунокШтрихкод.Ширина / КоличествоМиллиметровВПикселе);
				ПараметрыШтрихкода.Высота = Окр(РисунокШтрихкод.Высота / КоличествоМиллиметровВПикселе);
	            ПараметрыШтрихкода.Штрихкод = СокрЛП(Палета.SSCC);
				
				РисунокШтрихкод.Картинка = ПолучитьКартинкуШтрихкода(КомпонентаПечатиШтрихкодов, ПараметрыШтрихкода);
				
				Если Данные.Шапка.ФорматЭСФ = "УПД Тандер" Тогда // Для Тандера
					ВыводСПроверкой.Добавить(Макет.ПолучитьОбласть("ШапкаКонтейнерыТандер"));
					ВыводСПроверкой.Получить(1).Параметры.Заполнить(ТоварыНаПалете.Получить(НомерСтроки - 1));
				КонецЕсли;
				
				ВыводСПроверкой.Добавить(Макет.ПолучитьОбласть("ШапкаКонтейнерыТаблица"));
				ВыводСПроверкой.Добавить(ОбластьМакета);
				Если ТоварыНаПалете.Количество() = 1 Тогда 
					ВыводСПроверкой.Добавить(Макет.ПолучитьОбласть("ЛинияВнизуТаблицы"));
				КонецЕсли;
			ИначеЕсли НомерСтроки = ТоварыНаПалете.Количество() Тогда // Последняя строка и окончание таблицы
				ВыводСПроверкой.Добавить(ОбластьМакета);
				ВыводСПроверкой.Добавить(Макет.ПолучитьОбласть("ЛинияВнизуТаблицы"));
			Иначе // Отдельные строки
				ВыводСПроверкой.Добавить(ОбластьМакета);
			КонецЕсли;	
			
			// Переход на новую строаницу, если не помещаемся.
			Если НЕ ТабДок.ПроверитьВывод(ВыводСПроверкой) Тогда
				ТабДок.ВывестиГоризонтальныйРазделительСтраниц(); 
			КонецЕсли;
			
			Для Каждого Вывод Из ВыводСПроверкой Цикл
				ТабДок.Вывести(Вывод);
			КонецЦикла;
			
		КонецЦикла;
		
		Если ПерваяСтрока Тогда
			ПерваяСтрока = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	//ТабДок.ТолькоПросмотр		= Истина;
	ТабДок.ОриентацияСтраницы 	= ОриентацияСтраницы.Ландшафт;
	ТабДок.ОтображатьСетку     	= Ложь;
	ТабДок.ОтображатьЗаголовки 	= Ложь;

	Возврат ТабДок;
	
КонецФункции // ЗаполнитьМакетШК_Паллеты()

// Получает данные для вывода на печатную форму ШК_Паллеты
//
// Параметры:
//  ДокументСсылка  - ДокументСсылка - ссылка на документ реализации
//
// Возвращаемое значение:
//   Структура   - данные для заполнения шапки и табличных частей
//
Функция ПолучитьДанныеДляПечати(ДокументСсылка, МассивЛогаСобытий)

	// ЗАПОЛНЕНИЕ ШАПКИ ПЕЧАТНОЙ ФОРМЫ.
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ЭКОМ_ЦепочкиДокументовПоставщика.Накладная.Номер КАК Номер,
	               |	ЭКОМ_ЦепочкиДокументовПоставщика.Накладная.Дата КАК _Дата,
	               |	ВЫРАЗИТЬ("""" КАК СТРОКА(10)) КАК Дата,
	               |	ЭКОМ_ЦепочкиДокументовПоставщика.ORDERNUMBER,
	               |	ЭКОМ_ЦепочкиДокументовПоставщика.ORDERDATE КАК _ORDERDATE,
	               |	ВЫРАЗИТЬ("""" КАК СТРОКА(10)) КАК ORDERDATE,
	               |	ВЫБОР
	               |		КОГДА ПОДСТРОКА(ЭКОМ_GLN_Покупатель.Контрагент_ФорматЭСФ, 1, 9) = ""УПД Лента""
	               |			ТОГДА ЭКОМ_ЦепочкиДокументовПоставщика.INSDES.ДатаПоставки
	               |		ИНАЧЕ ЭКОМ_ЦепочкиДокументовПоставщика.ДатаПоставки
	               |	КОНЕЦ КАК _ДатаПоставки,
	               |	ВЫРАЗИТЬ("""" КАК СТРОКА(10)) КАК ДатаПоставки,
	               |	ЭКОМ_ЦепочкиДокументовПоставщика.xmlОрганизация КАК ПоставщикGLN,
	               |	ЭКОМ_ЦепочкиДокументовПоставщика.Организация.Наименование КАК ПоставщикНаименование,
	               |	ЭКОМ_GLN_Поставщик.eXiteАдр_Индекс КАК _ПоставщикАдрИндекс,
	               |	ЭКОМ_GLN_Поставщик.eXiteАдр_КодРегиона КАК _ПоставщикАдрКодРегиона,
	               |	ЭКОМ_GLN_Поставщик.eXiteАдр_Район КАК _ПоставщикАдрРайон,
	               |	ЭКОМ_GLN_Поставщик.eXiteАдр_Город КАК _ПоставщикАдрГород,
	               |	ЭКОМ_GLN_Поставщик.eXiteАдр_НаселПункт КАК _ПоставщикАдрНаселенныйПункт,
	               |	ЭКОМ_GLN_Поставщик.eXiteАдр_Улица КАК _ПоставщикАдрУлица,
	               |	ЭКОМ_GLN_Поставщик.eXiteАдр_Дом КАК _ПоставщикАдрДом,
	               |	ЭКОМ_GLN_Поставщик.eXiteАдр_Корпус КАК _ПоставщикАдрКорпус,
	               |	ЭКОМ_GLN_Поставщик.eXiteАдр_Кварт КАК _ПоставщикАдрКвартира,
	               |	ВЫРАЗИТЬ("""" КАК СТРОКА(300)) КАК ПоставщикАдр,
	               |	ЭКОМ_ЦепочкиДокументовПоставщика.xmlКонтрагент КАК ПокупательGLN,
	               |	ЭКОМ_ЦепочкиДокументовПоставщика.Контрагент.Наименование КАК ПокупательНаименование,
	               |	ЭКОМ_GLN_Покупатель.eXiteАдр_Индекс КАК _ПокупательАдрИндекс,
	               |	ЭКОМ_GLN_Покупатель.eXiteАдр_КодРегиона КАК _ПокупательАдрКодРегиона,
	               |	ЭКОМ_GLN_Покупатель.eXiteАдр_Район КАК _ПокупательАдрРайон,
	               |	ЭКОМ_GLN_Покупатель.eXiteАдр_Город КАК _ПокупательАдрГород,
	               |	ЭКОМ_GLN_Покупатель.eXiteАдр_НаселПункт КАК _ПокупательАдрНаселенныйПункт,
	               |	ЭКОМ_GLN_Покупатель.eXiteАдр_Улица КАК _ПокупательАдрУлица,
	               |	ЭКОМ_GLN_Покупатель.eXiteАдр_Дом КАК _ПокупательАдрДом,
	               |	ЭКОМ_GLN_Покупатель.eXiteАдр_Корпус КАК _ПокупательАдрКорпус,
	               |	ЭКОМ_GLN_Покупатель.eXiteАдр_Кварт КАК _ПокупательАдрКвартира,
	               |	ВЫРАЗИТЬ("""" КАК СТРОКА(300)) КАК ПокупательАдр,
	               |	ЭКОМ_ЦепочкиДокументовПоставщика.xmlТочкаДоставки КАК ТочкаДоставкиGLN,
	               |	ЭКОМ_ТочкиДоставки.Наименование КАК ТочкаДоставкиНаименование,
	               |	ЭКОМ_ТочкиДоставки.Адр_Индекс КАК _ТочкаДоставкиАдрИндекс,
	               |	ЭКОМ_ТочкиДоставки.Адр_КодРегиона КАК _ТочкаДоставкиАдрКодРегиона,
	               |	ЭКОМ_ТочкиДоставки.Адр_Район КАК _ТочкаДоставкиАдрРайон,
	               |	ЭКОМ_ТочкиДоставки.Адр_Город КАК _ТочкаДоставкиАдрГород,
	               |	ЭКОМ_ТочкиДоставки.Адр_НаселПункт КАК _ТочкаДоставкиАдрНаселенныйПункт,
	               |	ЭКОМ_ТочкиДоставки.Адр_Улица КАК _ТочкаДоставкиАдрУлица,
	               |	ЭКОМ_ТочкиДоставки.Адр_Дом КАК _ТочкаДоставкиАдрДом,
	               |	ЭКОМ_ТочкиДоставки.Адр_Корпус КАК _ТочкаДоставкиАдрКорпус,
	               |	ЭКОМ_ТочкиДоставки.Адр_Кварт КАК _ТочкаДоставкиАдрКвартира,
	               |	ВЫРАЗИТЬ("""" КАК СТРОКА(300)) КАК ТочкаДоставкиАдр,
	               |	ВЫБОР
	               |		КОГДА ПОДСТРОКА(ЭКОМ_GLN_Покупатель.Контрагент_ФорматЭСФ, 1, 9) = ""УПД Лента""
	               |			ТОГДА ЭКОМ_ЦепочкиДокументовПоставщика.INSDES.НомерДоговораНаПоставку
	               |		ИНАЧЕ ЭКОМ_ЦепочкиДокументовПоставщика.ORDER.НомерДоговораНаПоставку
	               |	КОНЕЦ КАК НомерПоставщика,
	               |	ЭКОМ_GLN_Поставщик.SAPкод,
	               |	ЭКОМ_GLN_Покупатель.Контрагент_ФорматЭСФ КАК ФорматЭСФ,
	               |	ВЫБОР
	               |		КОГДА ПОДСТРОКА(ЭКОМ_GLN_Покупатель.Контрагент_ФорматЭСФ, 1, 9) = ""УПД Лента""
	               |			ТОГДА ЭКОМ_ЦепочкиДокументовПоставщика.INSDES = ЗНАЧЕНИЕ(Документ.ЭКОМ_Документы.ПустаяСсылка)
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК НетINSDES
	               |ИЗ
	               |	РегистрСведений.ЭКОМ_ЦепочкиДокументовПоставщика КАК ЭКОМ_ЦепочкиДокументовПоставщика
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Поставщик
	               |		ПО ЭКОМ_ЦепочкиДокументовПоставщика.Организация = ЭКОМ_GLN_Поставщик.Объект
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Покупатель
	               |		ПО ЭКОМ_ЦепочкиДокументовПоставщика.Контрагент = ЭКОМ_GLN_Покупатель.Объект
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_ТочкиДоставки КАК ЭКОМ_ТочкиДоставки
	               |		ПО ЭКОМ_ЦепочкиДокументовПоставщика.ТочкаДоставки = ЭКОМ_ТочкиДоставки.Объект
	               |ГДЕ
	               |	ЭКОМ_ЦепочкиДокументовПоставщика.Накладная = &ДокументРеализации";
	
	Запрос.УстановитьПараметр("ДокументРеализации", ДокументСсылка);	
	РезультатЗапроса = Запрос.Выполнить();
	Шапка = РезультатЗапроса.Выгрузить();
	
	ИмяСобытия = "Получение данных для печати";
	Для Каждого Строка Из Шапка Цикл              
		
		// Формат номера.
		Строка.Номер = ПолучитьНомерБезПрефиксовИНулей(Строка.Номер);
		
		// Формат дат.
		Для Каждого Колонка Из Шапка.Колонки Цикл
			СлужебнаяКолонка = Колонка.Имя;
			Если НЕ Найти(СлужебнаяКолонка, "_") = 1
				ИЛИ НЕ ТипЗнч(Строка[СлужебнаяКолонка]) = Тип("Дата") Тогда
				Продолжить;
			КонецЕсли;
			Строка[Сред(СлужебнаяКолонка, 2)] = Формат(Строка[СлужебнаяКолонка], "ДФ=dd.MM.yyyy");
		КонецЦикла;
		
		// Заполнение адреса.
		Адреса = Новый Массив;
		Адреса.Добавить("ПоставщикАдр");
		Адреса.Добавить("ПокупательАдр");
		Адреса.Добавить("ТочкаДоставкиАдр");
		Для Каждого Адрес Из Адреса Цикл
			Строка[Адрес] =
				?(ПустаяСтрока(Строка["_" + Адрес + "Индекс"]), 			"", Строка["_" + Адрес + "Индекс"] + 		", ") +
				?(ПустаяСтрока(Строка["_" + Адрес + "КодРегиона"]), 		"", Строка["_" + Адрес + "КодРегиона"] + 	", ") +
				?(ПустаяСтрока(Строка["_" + Адрес + "Район"]), 				"", Строка["_" + Адрес + "Район"] + 		", ") +
				?(ПустаяСтрока(Строка["_" + Адрес + "Город"]), 				"", Строка["_" + Адрес + "Город"] + 		", ") +
				?(ПустаяСтрока(Строка["_" + Адрес + "НаселенныйПункт"]), 	"", Строка["_" + Адрес + "НаселенныйПункт"] + ", ") +
				?(ПустаяСтрока(Строка["_" + Адрес + "Улица"]), 				"", Строка["_" + Адрес + "Улица"] + 		", ") +
				?(ПустаяСтрока(Строка["_" + Адрес + "Дом"]), 				"", Строка["_" + Адрес + "Дом"] + 			", ") +
				?(ПустаяСтрока(Строка["_" + Адрес + "Корпус"]), 			"", Строка["_" + Адрес + "Корпус"] + 		", ") +
				?(ПустаяСтрока(Строка["_" + Адрес + "Квартира"]), 			"", Строка["_" + Адрес + "Квартира"] + 		", ");
			Строка[Адрес] = Сред(Строка[Адрес], 1, СтрДлина(Строка[Адрес]) - 2);
		КонецЦикла;
		
		// Отсечение пробелов.
		Для Каждого Колонка Из Шапка.Колонки Цикл
			Если НЕ ТипЗнч(Строка[Колонка.Имя]) = Тип("Строка") Тогда
				Продолжить;
			КонецЕсли;
			Строка[Колонка.Имя] = СокрЛП(Строка[Колонка.Имя]);
		КонецЦикла;
		
	КонецЦикла;
	
	// Удаление служебных полей.
	КоличествоПолей = Шапка.Колонки.Количество();
	ШапкаСтруктура = Новый Структура;
	Для Счетчик = 1 По КоличествоПолей Цикл
		Индекс = КоличествоПолей - Счетчик;
		ИмяКолонки = Шапка.Колонки.Получить(Индекс).Имя;
		Если НЕ Найти(ИмяКолонки, "_") = 1 Тогда
			ШапкаСтруктура.Вставить(ИмяКолонки);
			Продолжить;
		КонецЕсли;
		Шапка.Колонки.Удалить(Индекс);
	КонецЦикла;
	
	Если НЕ Шапка.Количество() = 0 Тогда
		ЗаполнитьЗначенияСвойств(ШапкаСтруктура, Шапка.Получить(0));	
	КонецЕсли;
	
	Если ШапкаСтруктура.НетINSDES Тогда
		ТекстЛогаСобытий = "Для печати обязательно наличие полученного документа INSDES";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		Возврат Новый Структура("Шапка", ШапкаСтруктура);
	КонецЕсли;
	
	// ЗАПОЛНЕНИЕ ТАБЛИЦЫ ТОВАРОВ ПЕЧАТНОЙ ФОРМЫ.
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	    "ВЫБРАТЬ
	    |	"""" КАК Номер,
	    |	ЭКОМ_НоменклатураКонтрагентов.ШтрихКодНоменклатурыКонтрагента КАК Штрихкод,
	    |	ЭКОМ_НоменклатураКонтрагентов.НаименованиеНоменклатурыКонтрагента КАК Наименование,
	    |	ПРЕДСТАВЛЕНИЕ(ЭКОМ_Палеты.Единица_Измерения) КАК ЕдиницаИзмерения,
	    |	ЭКОМ_Палеты.Номенклатура КАК _Номенклатура,
	    |	&СтранаПроисхождения КАК СтранаПроисхождения,
	    |	ЭКОМ_Палеты.SSCC КАК SSCC,
	    |	ЭКОМ_Палеты.Ключ_Строки КАК _НомерСтроки,
	    |	ЭКОМ_Палеты.Количество КАК _Количество,
	    |	ВЫРАЗИТЬ("""" КАК СТРОКА(15)) КАК Количество,
	    |	ЭКОМ_Палеты.ДатаПроизводства КАК _ДатаПроизводства,
	    |	ЭКОМ_Палеты.ДатаОкончанияСрокаГодности КАК _СрокГодности,
	    |	ВЫРАЗИТЬ("""" КАК СТРОКА(10)) КАК ДатаПроизводства,
	    |	ВЫРАЗИТЬ("""" КАК СТРОКА(10)) КАК СрокГодности,
	    |	ЭКОМ_Палеты.Европаллета КАК _Европаллета,
