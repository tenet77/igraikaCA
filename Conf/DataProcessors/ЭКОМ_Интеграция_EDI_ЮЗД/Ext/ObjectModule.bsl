Процедура ОтправитьВсеФайлыНаСервере(МассивСтрок, ТипДокумента, ЭтоРегламентноеЗадание, ПодписатьФайл, ЭтоНовыеДокументы, СтруктураЛога)
	МассивЛогаСобытий = Новый Массив;
	МассивСтруктур = ОтправитьВсеФайлы(МассивСтрок, ТипДокумента, МассивЛогаСобытий, "", ЭтоРегламентноеЗадание, ПодписатьФайл, ЭтоНовыеДокументы, СтруктураЛога);
	Если ПодписатьФайл Тогда
		СформироватьПодписьНаСервере(МассивСтруктур, ТипДокумента, МассивЛогаСобытий);			
	КонецЕсли;			
	ОтправитьФайлы(МассивСтруктур, ТипДокумента, МассивЛогаСобытий, ЭтоРегламентноеЗадание, ЭтоНовыеДокументы, СтруктураЛога);
	
	Если МассивЛогаСобытий.Количество() > 0 Тогда
		Выполнить("ЭКОМ_ОбщегоНазначения.ЗаписатьЛогСобытийвРегистрЛогирование(МассивЛогаСобытий);");
	КонецЕсли;
	
КонецПроцедуры

Процедура АвтоматическийОбменEDI(ИдентификаторКоманды = "") Экспорт
	
	АвтоматическиОтправлятьУточнения = Неопределено;
	АвтоматическиОтправлятьТитул = Неопределено;
	
	Если ИдентификаторКоманды = "ДляОбменаЭлектроннымиДокументами" Или ИдентификаторКоманды = "" Тогда
		ЭКОМ_АвтоПроверкаСтатусовЮЗД   = Настройка_Параметр_Прочитать("ЭКОМ_АвтоПроверкаСтатусовЮЗД"   , Ложь);
		ЭКОМ_АвтоОбменORDER            = Настройка_Параметр_Прочитать("ЭКОМ_АвтоОбменORDER"            , Ложь);
		ЭКОМ_АвтоОбменORDRSP           = Настройка_Параметр_Прочитать("ЭКОМ_АвтоОбменORDRSP"           , Ложь);
		ЭКОМ_АвтоОбменDESADV           = Настройка_Параметр_Прочитать("ЭКОМ_АвтоОбменDESADV"           , Ложь);
		ЭКОМ_АвтоОбменRECADV           = Настройка_Параметр_Прочитать("ЭКОМ_АвтоОбменRECADV"           , Ложь);
		ЭКОМ_АвтоОбменORDER_входящий   = Настройка_Параметр_Прочитать("ЭКОМ_АвтоОбменORDER_входящий"   , Ложь);
		ЭКОМ_АвтоОбменORDRSP_исходящий = Настройка_Параметр_Прочитать("ЭКОМ_АвтоОбменORDRSP_исходящий" , Ложь);
		ЭКОМ_АвтоОбменDESADV_исходящий = Настройка_Параметр_Прочитать("ЭКОМ_АвтоОбменDESADV_исходящий" , Ложь);
		ЭКОМ_АвтоОбменRECADV_входящий  = Настройка_Параметр_Прочитать("ЭКОМ_АвтоОбменRECADV_входящий"  , Ложь);
		ЭКОМ_АвтоОбменRETINS_исходящий = Настройка_Параметр_Прочитать("ЭКОМ_АвтоОбменRETINS_исходящий" , Ложь);
		ЭКОМ_АвтоОбменУПД_исходящий    = Настройка_Параметр_Прочитать("ЭКОМ_АвтоОбменУПД_исходящий"    , Ложь);
		ЭКОМ_АвтоОбменУПД_входящий     = Настройка_Параметр_Прочитать("ЭКОМ_АвтоОбменУПД_входящий"     , Ложь);
		ЭКОМ_АвтоОбменSTATUS_исходящий = Настройка_Параметр_Прочитать("ЭКОМ_АвтоОбменИсходящийSTATUS"  , Ложь);
		ЭКОМ_АвтоОбменINVOICE_исходящий= Настройка_Параметр_Прочитать("ЭКОМ_АвтоОбменINVOICE_исходящий", Ложь);
		ЭКОМ_АвтоОбменDESSCC_исходящий = Настройка_Параметр_Прочитать("ЭКОМ_АвтоОбменDESSCC_исходящий" , Ложь);
	Иначе
		ЭКОМ_АвтоПроверкаСтатусовЮЗД   = Ложь;
		ЭКОМ_АвтоОбменORDER            = Ложь;
		ЭКОМ_АвтоОбменORDRSP           = Ложь;
		ЭКОМ_АвтоОбменDESADV           = Ложь;
		ЭКОМ_АвтоОбменRECADV           = Ложь;
		ЭКОМ_АвтоОбменORDER_входящий   = Ложь;
		ЭКОМ_АвтоОбменORDRSP_исходящий = Ложь;
		ЭКОМ_АвтоОбменDESADV_исходящий = Ложь;
		ЭКОМ_АвтоОбменRECADV_входящий  = Ложь;
		ЭКОМ_АвтоОбменRETINS_исходящий = Ложь;
		ЭКОМ_АвтоОбменУПД_исходящий    = Ложь;
		ЭКОМ_АвтоОбменУПД_входящий     = Ложь;
		ЭКОМ_АвтоОбменSTATUS_исходящий = Ложь;
		ЭКОМ_АвтоОбменINVOICE_исходящий = Ложь;
		ЭКОМ_АвтоОбменDESSCC_исходящий = Ложь;
		ОбщийОбмен = Ложь;
		АвтоматическиОтправлятьУточнения = Ложь;
		АвтоматическиОтправлятьТитул = Ложь;
		
		Если НЕ ЭКОМ_ОбщегоНазначения.ПоискВСтроке(ИдентификаторКоманды, "ORDER_входящий") = 0 Тогда
			ЭКОМ_АвтоОбменORDER_входящий = Истина;
		ИначеЕсли НЕ ЭКОМ_ОбщегоНазначения.ПоискВСтроке(ИдентификаторКоманды, "ORDRSP_исходящий") = 0 Тогда
			ЭКОМ_АвтоОбменORDRSP_исходящий = Истина;
		ИначеЕсли НЕ ЭКОМ_ОбщегоНазначения.ПоискВСтроке(ИдентификаторКоманды, "RECADV_входящий") = 0 Тогда
			ЭКОМ_АвтоОбменRECADV_входящий = Истина;					
		ИначеЕсли НЕ ЭКОМ_ОбщегоНазначения.ПоискВСтроке(ИдентификаторКоманды, "DESADV_исходящий") = 0 Тогда
			ЭКОМ_АвтоОбменDESADV_исходящий = Истина;		
		ИначеЕсли НЕ ЭКОМ_ОбщегоНазначения.ПоискВСтроке(ИдентификаторКоманды, "RETINS") = 0 Тогда
			ЭКОМ_АвтоОбменRETINS_исходящий = Истина;	
		ИначеЕсли НЕ ЭКОМ_ОбщегоНазначения.ПоискВСтроке(ИдентификаторКоманды, "INVOICE") = 0 Тогда
			ЭКОМ_АвтоОбменINVOICE_исходящий = Истина;
		ИначеЕсли НЕ ЭКОМ_ОбщегоНазначения.ПоискВСтроке(ИдентификаторКоманды, "DESSCC") = 0 Тогда
