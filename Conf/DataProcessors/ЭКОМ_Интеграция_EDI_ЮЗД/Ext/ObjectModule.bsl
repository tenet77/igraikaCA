Процедура СоздатьЗаписьDP_PDOTPR(ТЗСтруктур, ДокументыШапка, МассивЛогаСобытий, НеНайденныеКвитанции, ТЗНеобработанных) Экспорт //Docrobot 1.19.0 MOD-1377 [ТЗНеобработанных]
	
	// Запрос по шапке документов
	Запрос = Новый Запрос;	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДокументыШапка.ВидДокумента КАК ВидДокумента,
	|	ДокументыШапка.НаправлениеОбменаДокументаОснования КАК НаправлениеОбменаДокументаОснования,
	|	ПОДСТРОКА(ДокументыШапка.Документ_СведПодтв_СведОтпрФайл_ИмяПостФайла, 1, 256) КАК ИмяПостФайла,
	|	ПОДСТРОКА(ДокументыШапка.ИдФайл, 1, 256) КАК ИдФайл
	|ПОМЕСТИТЬ ДокументыШапка
	|ИЗ
	|	&ДокументыШапка КАК ДокументыШапка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЭКОМ_Объекты_События.Контрагент КАК Контрагент,
	|	ЭКОМ_Объекты_События.Организация КАК Организация,
	|	ЕСТЬNULL(ЭКОМ_Объекты_События.Документ_Основание, НЕОПРЕДЕЛЕНО) КАК ДокЭКОМ,
	|	ДокументыШапка.ИдФайл КАК ИдФайл,
	|	ЭКОМ_Объекты_События.ВидДокумента КАК ВидДокументаОснования,
	|	ДокументыШапка.ВидДокумента КАК ВидДокумента,
	|	ДокументыШапка.ИмяПостФайла КАК ИмяПостФайла,
	|	ЭКОМ_Объекты_События.ЗаказДата КАК ЗаказДата,
	|	ЭКОМ_Объекты_События.ЗаказНомер КАК ЗаказНомер,
	|	ЭКОМ_Объекты_События.НомерДокумента,
	|	ЭКОМ_Объекты_События.ДатаДокумента
	|ИЗ
	|	ДокументыШапка КАК ДокументыШапка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_События
	|		ПО ДокументыШапка.ИмяПостФайла = ЭКОМ_Объекты_События.Идентификатор
	|			И (ЭКОМ_Объекты_События.НаправлениеОбмена = ДокументыШапка.НаправлениеОбменаДокументаОснования)";
	
	Запрос.УстановитьПараметр("ДокументыШапка", ДокументыШапка);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СтрокаТЗСтруктур = ТЗСтруктур.Найти(Выборка.ИдФайл, "ИдентификаторФайла");
		
		СтруктураРегистраСобытий = Новый Структура;
		СтруктураРегистраСобытий.Вставить("НомерДокумента"   , Выборка.НомерДокумента);
		СтруктураРегистраСобытий.Вставить("ДатаДокумента"    , Выборка.ДатаДокумента);
		СтруктураРегистраСобытий.Вставить("ЗаказДата"        , Выборка.ЗаказДата);
		СтруктураРегистраСобытий.Вставить("ЗаказНомер"       , Выборка.ЗаказНомер);
		СтруктураРегистраСобытий.Вставить("Контрагент"       , Выборка.Контрагент);
		СтруктураРегистраСобытий.Вставить("Организация"      , Выборка.Организация);
		СтруктураРегистраСобытий.Вставить("ФайлИмя"          , СтрокаТЗСтруктур.ИмяФайлаXML);
		СтруктураРегистраСобытий.Вставить("ЭЦП"              , СтрокаТЗСтруктур.ЭЦП);
		СтруктураРегистраСобытий.Вставить("Идентификатор"    , Выборка.ИдФайл);
		СтруктураРегистраСобытий.Вставить("ИдентификаторИспр", Выборка.ИмяПостФайла);
		СтруктураРегистраСобытий.Вставить("Статус"           , Перечисления.ЭКОМ_Статусы.Загружен);
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("ДокументОснование"    , Выборка.ДокЭКОМ);
		СтруктураПараметров.Вставить("ВидДокумента"         , Выборка.ВидДокумента);
		СтруктураПараметров.Вставить("ВидДокументаОснования", Выборка.ВидДокументаОснования);
