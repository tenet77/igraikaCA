									ТекстЛогаСобытий = "Найдено " + (МассивФайловСПлатформыДляЗагрузки.Количество()) + " новых файлов на веб-платформе на дату :" 
									+ Формат(ТекущаяДата(),"ДФ='dd.MM.yyyy ""г.""'" ) + " (240)";
									ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Успешно, ИмяСобытия);
