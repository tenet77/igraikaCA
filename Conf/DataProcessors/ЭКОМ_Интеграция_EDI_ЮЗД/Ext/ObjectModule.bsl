Процедура API_АрхивироватьДокументы(ПрофильОбмена, ИменаФайлов, МассивЛогаСобытий) Экспорт 
	
	КоличествоАрхивированныхФайлов = 0;
	Если ПрофильОбмена.Страна = "kz" Тогда
		Для каждого ИмяФайла Из ИменаФайлов Цикл
			
			Если ЗначениеЗаполнено(ИмяФайла) Тогда
				ОдноИмяФайла = Новый Массив;
				ОдноИмяФайла.Добавить(ИмяФайла);
				Рез = Вычислить("ЭКОМ_ОбщегоНазначения.НовыйSOAPОбращение(ПрофильОбмена, ""archiveDoc"", ОдноИмяФайла, , МассивЛогаСобытий)");
				Если Рез.errorCode = "0" Тогда
					КоличествоАрхивированныхФайлов = КоличествоАрхивированныхФайлов + 1;
				КонецЕсли;			
			КонецЕсли;
			
		КонецЦикла;
	Иначе
		Рез = Вычислить("ЭКОМ_ОбщегоНазначения.НовыйSOAPОбращение(ПрофильОбмена, ""archiveDocumentsRequest"", ИменаФайлов, , МассивЛогаСобытий)");
		Если Рез.errorCode = "0" Тогда
			КоличествоАрхивированныхФайлов = КоличествоАрхивированныхФайлов + 1;
		КонецЕсли;       
		
	КонецЕсли;
	
	Если КоличествоАрхивированныхФайлов > 0 Тогда
		ТекстЛогаСобытий = "API - Успешно архивированных документов - " + Строка(КоличествоАрхивированныхФайлов);
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Успешно, "Архивирование документов по API"); //Docrobot 1.21.0 MOD-1272 [уровень логирования изменен с "Информация" на "Успешно"]
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
	КонецЕсли;
	
КонецПроцедуры 

Процедура FTP_АрхивироватьДокументы(ПрофильОбмена, ИменаФайлов, ОписаниеОперации = "Помещаю в архив", МассивЛогаСобытий, ТипОбменаЭТРН) Экспорт 
	
	Сервер = ПолучитьFTPСоединениеВОбработке(ПрофильОбмена, ТипОбменаЭТРН, МассивЛогаСобытий);
	КоличествоАрхивированныхФайлов = 0;
	Если НЕ Сервер = Неопределено Тогда	
		Для Каждого ЭлИмяФайла Из ИменаФайлов Цикл
			
			Если ЗначениеЗаполнено(ЭлИмяФайла) Тогда
				Попытка				
					Сервер.Удалить(ПрофильОбмена.ВходящийПутьFTP + ЭлИмяФайла);
					КоличествоАрхивированныхФайлов = КоличествоАрхивированныхФайлов + 1;
				Исключение
					Сервер = ПолучитьFTPСоединениеВОбработке(ПрофильОбмена, ТипОбменаЭТРН, МассивЛогаСобытий);
					Попытка
						НайденныеФайлы = Сервер.НайтиФайлы(ПрофильОбмена.ВходящийПутьFTP, ЭлИмяФайла);
						Если НайденныеФайлы.Количество() > 0 Тогда
							Сервер.Удалить(ПрофильОбмена.ВходящийПутьFTP + ЭлИмяФайла);
							КоличествоАрхивированныхФайлов = КоличествоАрхивированныхФайлов + 1;
						КонецЕсли;
						
					Исключение
						
						Продолжить;
						
					КонецПопытки;
				КонецПопытки;		
			КонецЕсли;
			
		КонецЦикла; 
	КонецЕсли;
	
	Если КоличествоАрхивированныхФайлов > 0 Тогда
		ТекстЛогаСобытий = "FTP - Успешно архивированных документов - " + Строка(КоличествоАрхивированныхФайлов);
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Успешно, "Архивирование документов по FTP");
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

	КонецЕсли;
	
КонецПроцедуры 

Функция СоздатьЭКОМ_ДокПодтверждениеЗаказаORDRSP(ТЗСтруктур, ДокументыШапка, пДокументыТабличнаяЧасть, МассивЛогаСобытий) Экспорт
	
	// Табличная часть заполняется в гибких настройках
	
	// Запрос по шапке документов
	Запрос = Новый Запрос;	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДокументыШапка.DATE КАК ФайлДата,
	|	ПОДСТРОКА(ДокументыШапка.NUMBER, 1, 100) КАК ФайлНомер,
	|	ДокументыШапка.ORDERDATE КАК ЗаказДата,
	|	ПОДСТРОКА(ДокументыШапка.ORDERNUMBER, 1, 100) КАК ЗаказНомер,
	|	ПОДСТРОКА(ДокументыШапка.HEAD_RECIPIENT, 1, 100) КАК xmlОрганизацияGLN,
	|	ПОДСТРОКА(ДокументыШапка.xmlКонтрагентGLN, 1, 100) КАК xmlКонтрагентGLN,
	|	ПОДСТРОКА(ДокументыШапка.HEAD_DELIVERYPLACE, 1, 100) КАК xmlТочкаДоставкиGLN,
	|	ДокументыШапка.ВидДокумента КАК ВидДокумента,
	|	ПОДСТРОКА(ДокументыШапка.DOCTYPE, 0, 100) КАК DOCTYPE,
	|	ПОДСТРОКА(ДокументыШапка.ИдФайл, 1, 250) КАК ИдФайл,
	|	ДокументыШапка.ДатаЧислоПолученияДокумента КАК ДатаЧислоПолученияДокумента
	|ПОМЕСТИТЬ ДокументыШапка
	|ИЗ
	|	&ДокументыШапка КАК ДокументыШапка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ЭКОМ_Документы.Ссылка, НЕОПРЕДЕЛЕНО) КАК ЭКОМДок,
	|	ЭКОМ_Документы.ПометкаУдаления КАК ПометкаУдаления,
	|	ЭКОМ_Документы.СтатусОбработкиДокумента КАК СтатусОбработкиДокумента,
	|	ЭКОМ_GLN_Организация.Объект КАК Организация,
	|	ЭКОМ_GLN_Контрагент.Объект КАК Контрагент,
	|	ЭКОМ_ТочкиДоставки.Объект КАК ТочкаДоставки,
	|	ДокументыШапка.ИдФайл КАК ИдФайл,
	|	ЭКОМ_ЦепочкиДокументовПокупателя.Заказ КАК Заказ,
	|	ДокументыШапка.ДатаЧислоПолученияДокумента КАК ДатаЧислоПолученияДокумента,
	|	ЕСТЬNULL(КОЛИЧЕСТВО(ЭКОМ_ДокументыПовторный.Ссылка), 0) КАК КоличествоЭКОМДокПовторных,
	|	ДокументыШапка.ВидДокумента,
	|	ДокументыШапка.ФайлДата,
	|	ДокументыШапка.ФайлНомер,
	|	ДокументыШапка.ЗаказДата,
	|	ДокументыШапка.ЗаказНомер,
	|	ДокументыШапка.xmlОрганизацияGLN,
	|	ДокументыШапка.xmlКонтрагентGLN,
	|	ДокументыШапка.xmlТочкаДоставкиGLN
	|ИЗ
	|	ДокументыШапка КАК ДокументыШапка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭКОМ_Документы КАК ЭКОМ_Документы
	|		ПО ДокументыШапка.ЗаказДата = ЭКОМ_Документы.ЗаказДата
	|			И ДокументыШапка.ЗаказНомер = ЭКОМ_Документы.ЗаказНомер
	|			И ДокументыШапка.ВидДокумента = ЭКОМ_Документы.ВидДокумента
	//Docrobot 2021.11.25 MOD-1499 [было:|			И ДокументыШапка.ИдФайл = ЭКОМ_Документы.НомерТранзакции]
	|			И (ДокументыШапка.ИдФайл + "".xml"" = ПОДСТРОКА(ЭКОМ_Документы.ИмяФайла, 0, 200))
	|			И ДокументыШапка.xmlКонтрагентGLN = ЭКОМ_Документы.xmlКонтрагент
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Организация
	|		ПО ДокументыШапка.xmlОрганизацияGLN = ЭКОМ_GLN_Организация.GLN
	|			И (НЕ ЭКОМ_GLN_Организация.Объект ССЫЛКА Справочник.Контрагенты)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Контрагент
	|		ПО ДокументыШапка.xmlКонтрагентGLN = ЭКОМ_GLN_Контрагент.GLN
	|			И (ЭКОМ_GLN_Контрагент.Объект ССЫЛКА Справочник.Контрагенты)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_ТочкиДоставки КАК ЭКОМ_ТочкиДоставки
	|		ПО ДокументыШапка.xmlТочкаДоставкиGLN = ЭКОМ_ТочкиДоставки.GLN
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_ЦепочкиДокументовПокупателя КАК ЭКОМ_ЦепочкиДокументовПокупателя
	|		ПО ДокументыШапка.ЗаказДата = ЭКОМ_ЦепочкиДокументовПокупателя.ORDERDATE
	|			И ДокументыШапка.ЗаказНомер = ЭКОМ_ЦепочкиДокументовПокупателя.ORDERNUMBER
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭКОМ_Документы КАК ЭКОМ_ДокументыПовторный
	|		ПО (НЕ ЭКОМ_ДокументыПовторный.ПометкаУдаления)
	|			И ДокументыШапка.ЗаказДата = ЭКОМ_ДокументыПовторный.ЗаказДата
	|			И ДокументыШапка.ЗаказНомер = ЭКОМ_ДокументыПовторный.ЗаказНомер
	|			И ДокументыШапка.ВидДокумента = ЭКОМ_ДокументыПовторный.ВидДокумента
	|			И ДокументыШапка.DOCTYPE = ЭКОМ_ДокументыПовторный.ТипДокумента
	//Docrobot 1.19.0 MOD-1493 [Добавлено: И ДокументыШапка.DOCTYPE = ЭКОМ_ДокументыПовторный.ТипДокумента]
	|
	|СГРУППИРОВАТЬ ПО
	|	ЭКОМ_Документы.ПометкаУдаления,
	|	ЭКОМ_Документы.СтатусОбработкиДокумента,
	|	ЭКОМ_GLN_Организация.Объект,
	|	ЭКОМ_GLN_Контрагент.Объект,
	|	ЭКОМ_ТочкиДоставки.Объект,
	|	ДокументыШапка.ИдФайл,
	|	ЭКОМ_ЦепочкиДокументовПокупателя.Заказ,
	|	ДокументыШапка.ДатаЧислоПолученияДокумента,
	|	ЕСТЬNULL(ЭКОМ_Документы.Ссылка, НЕОПРЕДЕЛЕНО),
	|	ДокументыШапка.ВидДокумента,
	|	ДокументыШапка.ФайлДата,
	|	ДокументыШапка.ФайлНомер,
	|	ДокументыШапка.ЗаказДата,
	|	ДокументыШапка.ЗаказНомер,
	|	ДокументыШапка.xmlОрганизацияGLN,
	|	ДокументыШапка.xmlКонтрагентGLN,
	|	ДокументыШапка.xmlТочкаДоставкиGLN
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаЧислоПолученияДокумента";
	
	Запрос.УстановитьПараметр("ДокументыШапка", ДокументыШапка);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ПроверкаНаПовтор       = Новый Соответствие; // В случае нескольких одинаковых документов с одним и тем же номером и датой
	ПроверкаНаДублирование = Новый Соответствие;
	
	СоответствиеПоОрганизации      = Новый Соответствие;
	СоответствиеПоКонтрагенту      = Новый Соответствие;
	СоответствиеПоТочкамДоставки   = Новый Соответствие;
	
	Пользователь = НайтиТекущегоПользователя();
	
	КэшированныеЗначения = Новый Соответствие;;
	
	ИмяСобытия = "Создание документа Docrobot-ORDRSP";
	Пока Выборка.Следующий() Цикл
		
		// Для проверки дублирования строк
		Если ПроверкаНаДублирование.Получить(Выборка.ИдФайл) = Неопределено Тогда
			ПроверкаНаДублирование.Вставить(Выборка.ИдФайл, "Строка добавлена");
		Иначе		
			ТекстЛогаСобытий = "Дубль данных, проверьте GLN организации, контрагента, точки доставки ИД документа - " + Выборка.ИдФайл;	
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

			Продолжить;
			
		КонецЕсли;
		
		// Получаем структуру документа
		СтруктураДокумента = Неопределено;
		СтрокаТЗСтруктур = ТЗСтруктур.Найти(Выборка.ИдФайл, "ИдентификаторФайла");
		Если СтрокаТЗСтруктур = Неопределено Тогда			
			ТекстЛогаСобытий = "Не найдена структура документа с ИД = " + Выборка.ИдФайл;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

			Продолжить;
			
		Иначе	
			СтруктураДокумента = СтрокаТЗСтруктур.СтруктураДокумента;
			
		КонецЕсли;
		
		ПредставлениеДокументаXML = Строка(Выборка.ВидДокумента) + " № " + Выборка.ФайлНомер 
		+ " от " + Формат(Выборка.ФайлДата, "ДФ=dd.MM.yy")  
		+ " для заказа № " + Выборка.ЗаказНомер + " от " + Формат(Выборка.ЗаказДата, "ДФ=dd.MM.yy");
		
		Если Выборка.ЭКОМДок = Неопределено Тогда
			ЭКОМДок = Документы.ЭКОМ_Документы.СоздатьДокумент();
		ИначеЕсли (Выборка.ПометкаУдаления = Истина 
			ИЛИ Выборка.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.НеОбработан) 
			ИЛИ НЕ СтруктураДокумента.DOCTYPE = "O" Тогда // Тип документа: O — оригинал, R — замена, D — удаление
			ЭКОМДок = Выборка.ЭКОМДок.ПолучитьОбъект();
			ЭКОМДок.ПометкаУдаления = ЛОЖЬ;
			ЭКОМДок.ТЧ_Товары.Очистить();
			// Очищение документов в гибких настроках при необходимости	
		Иначе
			ТекстЛогаСобытий = Строка(Выборка.ВидДокумента) + " - ЭКОМ документ уже существует в 1С, номер = " 
			+ Выборка.ЭКОМДок.Номер + " от " + Выборка.ЭКОМДок.Дата;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Продолжить;
			
		КонецЕсли;
		
		// Для проверки повтора 
		// 1 случай - когда грузим впервые (ЭКОМ документы еще не созданы)
		КлючПовтора = Строка(Выборка.ВидДокумента) + Строка(Выборка.ЗаказНомер) 
		+ Формат(Выборка.ЗаказДата, "ДФ=ddMMyy") + СтруктураДокумента.DOCTYPE;
		Если ПроверкаНаПовтор.Получить(КлючПовтора) = Неопределено Тогда
			ПроверкаНаПовтор.Вставить(КлючПовтора, "Строка добавлена");					
		Иначе
			
			Если ЭКОМДок.ЭтоПовторныйДокумент = Истина 
				ИЛИ ЭКОМДок.ЭтоНовый() = Истина Тогда // Признак документа повторный или это новый ЭКОМ документ 				 
				
				ЭКОМДок.ЭтоПовторныйДокумент = Истина;
				
			КонецЕсли;	
			
		КонецЕсли;
		
		// Для проверки повтора 
		// 2 случай - когда повторный документ пришел позже
		Если Выборка.КоличествоЭКОМДокПовторных > 0 
			И (ЭКОМДок.ЭтоПовторныйДокумент = Истина 
			ИЛИ ЭКОМДок.ЭтоНовый() = Истина) Тогда // Есть повторные ЭКОМ документы 			 
			
			ЭКОМДок.ЭтоПовторныйДокумент = Истина;	
			
		КонецЕсли;
		
		//Docrobot 1.19.0 MOD-1493 [Вывод в Лог информации]
		Если НЕ ЭКОМДок.ЭтоПовторныйДокумент 
			И (ВРег(СтруктураДокумента.DOCTYPE) = "R"
				ИЛИ ВРег(СтруктураДокумента.DOCTYPE) = "D") Тогда
			
			ТекстЛогаСобытий = "Подтверждение заказа № %ORDERNUMBER% от %ORDERDATE% было %DOCTYPE%!";
			Если ВРег(СтруктураДокумента.DOCTYPE) = "R" Тогда
				ВывестиВКомментарий = Истина;
				ТекстЛогаСобытий = СтрЗаменить(ТекстЛогаСобытий, "%DOCTYPE%", "скорректировано");
			ИначеЕсли ВРег(СтруктураДокумента.DOCTYPE) = "D" Тогда
				ВывестиВКомментарий = Истина;
				ТекстЛогаСобытий = СтрЗаменить(ТекстЛогаСобытий, "%DOCTYPE%", "аннулировано");
			КонецЕсли;
			ТекстЛогаСобытий = СтрЗаменить(ТекстЛогаСобытий, "%ORDERNUMBER%", Выборка.ЗаказНомер);
			ТекстЛогаСобытий = СтрЗаменить(ТекстЛогаСобытий, "%ORDERDATE%", Формат(Выборка.ЗаказДата, "ДФ=dd.MM.yyyy"));
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
		КонецЕсли;
		//Docrobot 1.19.0 MOD-1493 []
		
		Если НЕ ЗначениеЗаполнено(Выборка.Организация) Тогда
			СоответствиеПоОрганизации.Вставить("Организация_" + Выборка.xmlОрганизацияGLN, Выборка.xmlОрганизацияGLN);	
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Выборка.Контрагент) Тогда
			СоответствиеПоКонтрагенту.Вставить("Контрагент_" + Выборка.xmlКонтрагентGLN, Выборка.xmlКонтрагентGLN);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Выборка.ТочкаДоставки) Тогда
			СоответствиеПоТочкамДоставки.Вставить("ТочкаДоставки_" + Выборка.xmlТочкаДоставкиGLN, Выборка.xmlТочкаДоставкиGLN);
		КонецЕсли;
		
		xmlВалюта = "RUB";
		Если ЗначениеЗаполнено(СтруктураДокумента.CURRENCY) Тогда
			xmlВалюта = СтруктураДокумента.CURRENCY;
		КонецЕсли;
		
		ВалютаСсылка = КэшированныеЗначения.Получить(xmlВалюта);
		Если ВалютаСсылка = Неопределено Тогда
			ВалютаСсылка = ПолучитьСсылкуВалютыДокумента(xmlВалюта);
			КэшированныеЗначения.Вставить(xmlВалюта, ВалютаСсылка);
		КонецЕсли;
		
		// Шапка
		ЭКОМДок.ВидДокумента              = Выборка.ВидДокумента; 
		ЭКОМДок.Организация               = Выборка.Организация;
		ЭКОМДок.xmlОрганизация            = Выборка.xmlОрганизацияGLN;
		ЭКОМДок.Контрагент                = Выборка.Контрагент;
		ЭКОМДок.xmlКонтрагент             = Выборка.xmlКонтрагентGLN;
		ЭКОМДок.ФайлНомер                 = Выборка.ФайлНомер;
		ЭКОМДок.ФайлДата                  = Выборка.ФайлДата;
		ЭКОМДок.Дата                      = ТекущаяДата();
		ЭКОМДок.ЗаказНомер                = Выборка.ЗаказНомер;
		ЭКОМДок.ЗаказДата                 = Выборка.ЗаказДата;
		ЭКОМДок.Валюта                    = ВалютаСсылка;
		ЭКОМДок.xmlВалюта                 = xmlВалюта;
		ЭКОМДок.ИмяФайла                  = СтрокаТЗСтруктур.ИмяФайлаXML;	
		ЭКОМДок.Ответственный             = Пользователь;
		ЭКОМДок.ТочкаДоставки             = Выборка.ТочкаДоставки;
		ЭКОМДок.xmlТочкаДоставки          = Выборка.xmlТочкаДоставкиGLN;
		ЭКОМДок.УточнениеОПоставке        = СтруктураДокумента.ACTION;
		ЭКОМДок.Документ1С                = Выборка.Заказ;
		ЭКОМДок.ДатаПоставки              = СтруктураДокумента.DELIVERYDATE;
		ЭКОМДок.НомерТранзакции           = СтруктураДокумента.HEAD_EDIINTERCHANGEID;
		ЭКОМДок.ТипДокумента              = СтруктураДокумента.DOCTYPE;
		
		// ТЧ товары
		СуммаВсего           = 0;
		СуммаВсегоНДС        = 0;
		ТекстОшибки          = "";
		ТекстКомментария     = "";
		
		Для Каждого СтруктСтрока Из СтруктураДокумента.ДокументТЧ Цикл	
			
			ЦенаБезНДС   = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.HEAD_POSITION_PRICE); // обязательный тег
			ЦенаСНДС     = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.HEAD_POSITION_PRICEWITHVAT);			
			СтавкаНДСДок = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.HEAD_POSITION_VAT);
			знКоличество = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.HEAD_POSITION_ACCEPTEDQUANTITY);
					
			Если НЕ ЗначениеЗаполнено(СтавкаНДСДок) Тогда
				Если ЦенаБезНДС <> ЦенаСНДС	
					И ЦенаБезНДС <> 0
					И ЦенаСНДС   <> 0 Тогда
					СтавкаНДСДок = Окр(((ЦенаСНДС - ЦенаБезНДС) / ЦенаБезНДС) * 100);
				Иначе
					СтавкаНДСДок = 0;
				КонецЕсли;		
			КонецЕсли;
			
			СуммаСНДС = ЦенаСНДС * знКоличество;
			
			Если ЦенаБезНДС = 0 Тогда
				Если (СуммаСНДС > 0) И (знКоличество > 0) Тогда
					ЦенаСНДС      = Окр(СуммаСНДС/знКоличество, 4);			
					ЦенаБезНДС    = Окр( (ЦенаСНДС * 100) / (100 + СтавкаНДСДок) , 4);
				КонецЕсли;
			КонецЕсли;
			
			Если ЦенаСНДС = 0 Тогда
				ЦенаСНДС  = Окр( (ЦенаБезНДС * (100 + СтавкаНДСДок)) / 100 , 4);
				СуммаСНДС = ЦенаСНДС * знКоличество;
			КонецЕсли;	
			
			СуммаБезНДС = ЦенаБезНДС * знКоличество;		
			Если СуммаБезНДС = 0 Тогда
				Если (СуммаСНДС > 0) Тогда 
					СуммаБезНДС = Окр( (СуммаСНДС * 100) / (100 + СтавкаНДСДок) , 4);	
				КонецЕсли;
			КонецЕсли;
			
			Если СуммаСНДС = 0 И СтавкаНДСДок <> 0 Тогда
				СуммаСНДС = Окр((СуммаБезНДС * (100 + СтавкаНДСДок)) / 100 , 2);
			КонецЕсли;
			
			СуммаНДС = СуммаСНДС - СуммаБезНДС;
			
			ОписаниеПродукта = СтруктСтрока.HEAD_POSITION_DESCRIPTION;
			ОписаниеПродуктаИзХарактеристики = СтруктСтрока.HEAD_POSITION_CHARACTERISTIC_DESCRIPTION; 
			
			НовСтрока                         = ЭКОМДок.ТЧ_Товары.Добавить();
			НовСтрока.xmlЕдиницаИзмерения     = СтруктСтрока.HEAD_POSITION_ORDRSPUNIT;
			НовСтрока.Цена                    = ЦенаБезНДС;
			НовСтрока.ЦенаСНДС                = ЦенаСНДС;
			НовСтрока.ОписаниеПродукта        = ?(ЗначениеЗаполнено(ОписаниеПродукта), ОписаниеПродукта, ОписаниеПродуктаИзХарактеристики);
			НовСтрока.КоличествоЗаказанное    = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.HEAD_POSITION_ORDEREDQUANTITY); // Заказали у поставщика ORDEREDQUANTITY   
			НовСтрока.КоличествоПоставляемое  = знКоличество;  // Подтверженное количество у поставщика ACCEPTEDQUANTITY 
			НовСтрока.Сумма                   = СуммаБезНДС;
			НовСтрока.СтавкаНДС               = СтавкаНДСДок;
			НовСтрока.СуммаНДС                = СуммаНДС;
			НовСтрока.Сумма_с_НДС             = СуммаСНДС;
			НовСтрока.НомерПродукта           = СтруктСтрока.HEAD_POSITION_PRODUCT;
			НовСтрока.НомерПродуктаПоставщика = СтруктСтрока.HEAD_POSITION_PRODUCTIDSUPPLIER;
			НовСтрока.НомерПродуктаПокупателя = СтруктСтрока.HEAD_POSITION_PRODUCTIDBUYER;
			НовСтрока.УточнениеОПоставке      = СтруктСтрока.HEAD_POSITION_PRODUCTTYPE;
			НовСтрока.НомерСтрокиXML          = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.HEAD_POSITION_POSITIONNUMBER);
			
			СуммаВсегоНДС = СуммаВсегоНДС + СуммаНДС;
			СуммаВсего = СуммаВсего + СуммаБезНДС + СуммаНДС;
			
			// Сравниваем количество заказанное с поставляемым
			Если НЕ НовСтрока.КоличествоЗаказанное = НовСтрока.КоличествоПоставляемое Тогда
				ТекстКомментария = ТекстКомментария + ?(ЗначениеЗаполнено(ТекстКомментария), Символы.ПС, "")
				//Docrobot 1.20.0 MOD-1738 [добавлен формат чисел]
				+ "По штрихкоду " + НовСтрока.НомерПродукта + " (" + НовСтрока.ОписаниеПродукта + ")" + " есть расхождения, заказано - " + Формат(НовСтрока.КоличествоЗаказанное,"ЧДЦ=3; ЧРД=.; ЧН=0; ЧГ=0") 
				+ ", будет поставлено - " + Формат(НовСтрока.КоличествоПоставляемое,"ЧДЦ=3; ЧРД=.; ЧН=0; ЧГ=0");			
			КонецЕсли;
			
		КонецЦикла;
		
		ЭКОМДок.СуммаДокументаВсего = СуммаВсего; // С НДС
		ЭКОМДок.СуммаНДСВсего       = СуммаВсегоНДС;
		ЭКОМДок.Комментарий         = ?(СокрЛП(ЭКОМДок.УточнениеОПоставке) = "27", "Поставка отменена" +  ?(ПустаяСтрока(ТекстКомментария), "", Символы.ПС), "") + ТекстКомментария;
		
		ЭКОМДок.ТекстОшибки = ""; // Очищаем ошибки документа
		ЭКОМДок.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.ПустаяСсылка(); // Обнуляем статус документ
		
		// Номенклатура, ЕдиницаИзмерения - необходимо заполнять в гибких настройках
		ВыполнитьДополнительныеДействия(ЭКОМДок, "Входящий ORDRSP", 
		СтруктураДокумента,
		МассивЛогаСобытий, 
		ТекстОшибки,
		,
		,
		,
		,
		КэшированныеЗначения);	
				
		ЭКОМДок.ТЧ_Товары.Сортировать("НомерСтрокиXML Возр");
		
		// По умолчанию документ загружается и записывается, если ЭКОМ документ не нужен в гибких настройках необходимо поставить НеЗагружатьДокумент = Истина 
		Если ЭКОМДок.НеЗагружатьДокумент = Ложь Тогда
			
			СтруктураРегистраСобытий = Новый Структура; 
			СтруктураРегистраСобытий.Вставить("ДатаЗаписи"                  , ТекущаяДата());
			СтруктураРегистраСобытий.Вставить("Контрагент"                  , ЭКОМДок.Контрагент);
			СтруктураРегистраСобытий.Вставить("Организация"                 , ЭКОМДок.Организация);
			СтруктураРегистраСобытий.Вставить("НаправлениеОбмена"           , Перечисления.ЭКОМ_НаправлениеОбмена.Входящий);
			СтруктураРегистраСобытий.Вставить("ФайлИмя"                     , СтрокаТЗСтруктур.ИмяФайлаXML);
			СтруктураРегистраСобытий.Вставить("ЗаказДата"                   , ЭКОМДок.ЗаказДата);					
			СтруктураРегистраСобытий.Вставить("ЗаказНомер"                  , ЭКОМДок.ЗаказНомер);
			СтруктураРегистраСобытий.Вставить("СтруктураФайла"              , Новый ХранилищеЗначения(СтруктураДокумента,  Новый СжатиеДанных(9)));
			СтруктураРегистраСобытий.Вставить("Идентификатор"               , СтруктураДокумента.ИдФайл);
			
			Н = 1;
			
			Для Каждого Стр Из ЭКОМДок.ТЧ_Товары Цикл			
				// Проверка заполнения документа
				Если НЕ ЗначениеЗаполнено(Стр.ЕдиницаИзмерения) Тогда	
					ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "") 
					+ "В строке № " + Н + " " + "не заполнена единица измерения. (смотрите гибкие настройки или регистр сведений ЭКОМ_НоменклатураКонтрагентов)" 
					+ "(" + Стр.xmlЕдиницаИзмерения + ")"; 
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(Стр.Номенклатура) Тогда
					ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
					+ "В строке № " + Н + " " + "не заполнена номенклатура." 
					+ "(" + Стр.НомерПродукта + ")";
				КонецЕсли;
				
				Н = Н + 1;	
			КонецЦикла;
			
			Если НЕ ЗначениеЗаполнено(ЭКОМДок.Организация) Тогда
				ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
				+ "Не заполнена организация." + "(" + ЭКОМДок.xmlОрганизация + ")"; 
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ЭКОМДок.Контрагент) Тогда
				ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
				+ "Не заполнен контрагент." + "(" + ЭКОМДок.xmlКонтрагент + ")";
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ЭКОМДок.ТочкаДоставки) Тогда
				ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
				+ "Не заполнена точка доставки." + "(" + ЭКОМДок.xmlТочкаДоставки + ")";
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ЭКОМДок.Валюта) Тогда
				ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
				+ "Не заполнена валюта." + "(" + ЭКОМДок.xmlВалюта + ")";
			КонецЕсли;
			
			ДокументОбработан = ПроверитьОбработкуДокумента(ТекстОшибки, ЭКОМДок, СтруктураДокумента, СтруктураРегистраСобытий, ПредставлениеДокументаXML, МассивЛогаСобытий);
			Если ДокументОбработан = Ложь Тогда
				Продолжить;			
			КонецЕсли;
			
		Иначе 		
			СтруктураДокумента.Вставить("Обработан", Ложь);
			ТекстЛогаСобытий = "В гибких настройках указано не загружать документ - " + ПредставлениеДокументаXML;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ СоответствиеПоОрганизации.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоОрганизации     , "Организация_");
	КонецЕсли;
	Если НЕ СоответствиеПоКонтрагенту.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоКонтрагенту     , "Контрагент_");
	КонецЕсли;
	Если НЕ СоответствиеПоТочкамДоставки.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоТочкамДоставки  , "ТочкаДоставки_");
	КонецЕсли;
	
КонецФункции

