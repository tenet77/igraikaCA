					КонецЕсли;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Верс1Массив = Эком_РазложитьСтрокуВМассивПодстрок(ВерсияДоЗапуска, ".");    
		Если Верс1Массив.Количество() >= 2 Тогда
			ОсновнаяВерсияДоЗапуска = ЭКОМ_ПреобразоватьВЧисло(СокрЛП(Верс1Массив[0]) + СокрЛП(Верс1Массив[1]));
		Иначе	
			ОсновнаяВерсияДоЗапуска = 0;
		КонецЕсли;
		
		Верс2Массив = Эком_РазложитьСтрокуВМассивПодстрок(ВерсияОбработки, ".");
		Если Верс2Массив.Количество() >= 2 Тогда
			ОсновнаяВерсияОбработки = ЭКОМ_ПреобразоватьВЧисло(СокрЛП(Верс2Массив[0]) + СокрЛП(Верс2Массив[1]));
		Иначе	
			ОсновнаяВерсияОбработки = 0;
