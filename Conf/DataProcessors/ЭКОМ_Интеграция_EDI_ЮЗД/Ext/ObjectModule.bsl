Функция НайтиПеременныеПоТипу(ТекстКода, ТипПеременных = "Новый Запрос", МассивЛогаСобытий, Результат = Неопределено) Экспорт
	
	Результат = Новый Массив;
	
	ТекстовыйДокументКода = Новый ТекстовыйДокумент;
	ТекстовыйДокументКода.УстановитьТекст(ТекстКода);
	
	КоличествоСтрок = ТекстовыйДокументКода.КоличествоСтрок();
	
	ТекСтрока = 0;
	
	Для ТекСтрока = 1 По КоличествоСтрок Цикл
		СтрокаКода             = ТекстовыйДокументКода.ПолучитьСтроку(ТекСтрока);
		ПозицияНачалаВхождения = Найти(СтрокаКода, ТипПеременных);
		Если ПозицияНачалаВхождения = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаСПеременнойИРавно = СокрЛП(Лев(СтрокаКода, Найти(СтрокаКода, "=")));
		
		ПозицияРавно = Найти(СтрокаСПеременнойИРавно, "=");
		ИмяПеременнойБезРавно = СокрЛП(Сред(СтрокаСПеременнойИРавно, 1, ПозицияРавно - 1));
		
		Если ЗначениеЗаполнено(ИмяПеременнойБезРавно) Тогда
			Если Результат.Найти(ИмяПеременнойБезРавно) = Неопределено Тогда
				Результат.Добавить(ИмяПеременнойБезРавно);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции 

Функция ЗакомментироватьВТекстеКодаЗаписатьДляПеременной(Знач ТекстКода, ИмяПеременной = "Приемник")
	Перем Результат;
	
	ПозицияНачала = Найти(ТекстКода, ИмяПеременной + ".Записать(");
	Если ПозицияНачала = 0 Тогда
