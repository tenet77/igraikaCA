			КонецЦикла;
			
			ЭлементМассива.Документ_СвТНО_ТН_Таблица_СвТов_ИнфПолСтр = ИнфоПоля;
			
		КонецЦикла;
		
		СтруктураДокумента.Вставить("ДокументТЧ", СтруктураДокумента.Документ_СвТНО_ТН_Таблица_СвТов_);
		
		// Обязательные атрибуты для шапки. 
		Соответствие = Новый Соответствие;
		Соответствие.Вставить("Документ_ДатаДок"              				, Дата(0001, 01, 01));       
		Соответствие.Вставить("Документ_КНД"    							, "");
		Соответствие.Вставить("Документ_Подписант_ЮЛ_Должн"       			, "");
		Соответствие.Вставить("Документ_Подписант_ЮЛ_ИННЮЛ"					, "");
		Соответствие.Вставить("Документ_Подписант_ЮЛ_ФИО_Имя"        		, "");
		Соответствие.Вставить("Документ_Подписант_ЮЛ_ФИО_Фамилия"      		, "");
		Соответствие.Вставить("Документ_СвТНО_НомФорм"        				, "");
		Соответствие.Вставить("Документ_СвТНО_ОКУДПервДок"     				, "");
		Соответствие.Вставить("Документ_СвТНО_Плательщик_ИдСв_СвЮЛ_ИННЮЛ"	, "");
		Соответствие.Вставить("Документ_СвТНО_Плательщик_ИдСв_СвЮЛ_КПП"		, "");
		Соответствие.Вставить("Документ_СвТНО_Плательщик_ИдСв_СвЮЛ_НаимОрг"	, "");
		Соответствие.Вставить("Документ_СвТНО_Поставщик_ИдСв_СвЮЛ_ИННЮЛ"	, "");
		Соответствие.Вставить("Документ_СвТНО_Поставщик_ИдСв_СвЮЛ_КПП"		, "");
		Соответствие.Вставить("Документ_СвТНО_Поставщик_ИдСв_СвЮЛ_НаимОрг"	, "");
		Соответствие.Вставить("Документ_СвТНО_ТН_ДатаТН"        			, Дата(0001, 01, 01));
		Соответствие.Вставить("Документ_СвТНО_ТН_НомТН"              		, "");
		Соответствие.Вставить("Документ_СвТНО_ТН_ТНОбщ_КолНомЗап"			, "");
		Соответствие.Вставить("Документ_СвТНО_ТН_ТНОбщ_КолНомЗапПр"     	, "");
		Соответствие.Вставить("ИдФайл"            							, "");
		Соответствие.Вставить("СвУчДокОбор_ИдОтпр"            				, "");
		Соответствие.Вставить("СвУчДокОбор_ИдПок"            				, "");
		Соответствие.Вставить("СвУчДокОбор_СвОЭДОтпр_ИННЮЛ"            		, "");
		Соответствие.Вставить("СвУчДокОбор_СвОЭДОтпр_ИдЭДО"            		, "");
		Соответствие.Вставить("СвУчДокОбор_СвОЭДОтпр_НаимОрг"            	, "");
		
		Для каждого Элемент Из Соответствие Цикл
			Если СтруктураДокумента.Свойство(Элемент.Ключ) = Ложь Тогда
				СтруктураДокумента.Вставить(Элемент.Ключ, Элемент.Значение);			
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат СтруктураДокумента;
	
КонецФункции

Процедура ЭКОМ_ИсторияОбмена_Записать(НаправлениеОбмена, ВидДокумента, ИмяФайлаБезРасширения, ДанныеРесурсов) Экспорт
	
	МЗ = РегистрыСведений.ЭКОМ_ИсторияОбмена.СоздатьМенеджерЗаписи();
	
	МЗ.НаправлениеОбмена = НаправлениеОбмена;
	МЗ.ВидДокумента      = ВидДокумента;
	МЗ.Идентификатор     = ИмяФайлаБезРасширения;	
	МЗ.Прочитать();
	
	Если НЕ МЗ.Выбран() Тогда
		МЗ.НаправлениеОбмена  = НаправлениеОбмена;
		МЗ.ВидДокумента       = ВидДокумента;
		МЗ.Идентификатор      = ИмяФайлаБезРасширения;
		МЗ.ДатаЗаписи = ТекущаяДата();
	КонецЕсли;
	
	Для Каждого Элемент Из ДанныеРесурсов Цикл
		Если ЗначениеЗаполнено(Элемент.Значение) Тогда
			МЗ[Элемент.Ключ] = Элемент.Значение; 	
		КонецЕсли;	
	КонецЦикла;
	МЗ.Записать();
	
КонецПроцедуры

Процедура ЭКОМ_ИсторияОбмена_УдалитьЗапись(ИмяФайлаБезРасширения, МассивЛогаСобытий) Экспорт
	
	мРегистр = РегистрыСведений.ЭКОМ_ИсторияОбмена.СоздатьНаборЗаписей();
	мРегистр.Отбор.Идентификатор.Установить(ИмяФайлаБезРасширения);
	мРегистр.Прочитать();
	
	Если НЕ мРегистр.Количество() = 0 Тогда
		Попытка
			мРегистр.Очистить();
			мРегистр.Записать();
		Исключение
			ТекстЛогаСобытий = ОписаниеОшибки();
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, "Удаление записи из регистра история обмена");
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

Функция ЗаписатьФайлDP_UVUTOCH_УведОбУточЭлДок(СтруктураДокумента, пПолноеИмяФайла) Экспорт
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку("windows-1251");
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	// <<< Файл
	ЗаписьXML.ЗаписатьНачалоЭлемента("Файл");
	ЗаписьXML.ЗаписатьАтрибут("ИдФайл"  , СтруктураДокумента.ИдФайл);
	ЗаписьXML.ЗаписатьАтрибут("ВерсПрог", "Docrobot 1С: Integration");
	ЗаписьXML.ЗаписатьАтрибут("ВерсФорм", "1.02");
	
	// <<< Документ
	ЗаписьXML.ЗаписатьНачалоЭлемента("Документ");
	ЗаписьXML.ЗаписатьАтрибут("КНД", "1115113"); // Код формы по коду налоговой декларации (КНД)
	
	// <<< УчастЭДО
	ЗаписьXML.ЗаписатьНачалоЭлемента( "УчастЭДО" );
	ЗаписьXML.ЗаписатьАтрибут("ИдУчастЭДО", СтруктураДокумента.ИдОтпр);
	
	Если СтруктураДокумента.ТипПолучателя = "ЮЛ" Тогда
		
		// <<< ЮЛ
		ЗаписьXML.ЗаписатьНачалоЭлемента("ЮЛ");
		ЗаписьXML.ЗаписатьАтрибут("НаимОрг", 	СтруктураДокумента.ПлательщикНаимОрг);
		ЗаписьXML.ЗаписатьАтрибут("ИННЮЛ", 		СтруктураДокумента.ПлательщикИННЮЛ);
		ЗаписьXML.ЗаписатьАтрибут("КПП", 		СтруктураДокумента.ПлательщикКПП);
		ЗаписьXML.ЗаписатьКонецЭлемента(); // >>> ЮЛ
		
	ИначеЕсли СтруктураДокумента.ТипПолучателя = "ФЛ" Тогда
		
		// <<< ИП
		ЗаписьXML.ЗаписатьНачалоЭлемента("ИП");
		ЗаписьXML.ЗаписатьАтрибут("ИННФЛ", СтруктураДокумента.ПоставщикИННФЛ);
		// <<< ФИО
		ЗаписьXML.ЗаписатьНачалоЭлемента("ФИО");
		ЗаписьXML.ЗаписатьАтрибут("Фамилия", 	СтруктураДокумента.ПоставщикФамилияФЛ);
		ЗаписьXML.ЗаписатьАтрибут("Имя", 		СтруктураДокумента.ПоставщикИмяФЛ);
		ЗаписьXML.ЗаписатьАтрибут("Отчество", 	СтруктураДокумента.ПоставщикОтчествоФЛ);
		ЗаписьXML.ЗаписатьКонецЭлемента(); // >>> ФИО
		ЗаписьXML.ЗаписатьКонецЭлемента(); // >>> ИП
		
	КонецЕсли;
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // >>> УчастЭДО
	
	// <<< СвУведУточ
	ЗаписьXML.ЗаписатьНачалоЭлемента("СвУведУточ");
	ЗаписьXML.ЗаписатьАтрибут("ДатаПол" , СтруктураДокумента.ДатаДок);
	ЗаписьXML.ЗаписатьАтрибут("ВремяПол", СтруктураДокумента.ВремДок);
	
	// <<< СведПолФайл
	ЗаписьXML.ЗаписатьНачалоЭлемента("СведПолФайл");
	ЗаписьXML.ЗаписатьАтрибут("ИмяПостФайла", СтруктураДокумента.ИмяПостФайла);
	
	// <<< ЭЦППолФайл
	ЗаписьXML.ЗаписатьНачалоЭлемента("ЭЦППолФайл");
	ЗаписьXML.ЗаписатьТекст(СтруктураДокумента.ЭЦППолФайл);
	ЗаписьXML.ЗаписатьКонецЭлемента(); // >>> ЭЦППолФайл
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // >>> СведПолФайл
	
	// <<< ТекстУведУточ
	ЗаписьXML.ЗаписатьНачалоЭлемента("ТекстУведУточ");
	ЗаписьXML.ЗаписатьТекст(СтруктураДокумента.ТекстУведУточ);
	ЗаписьXML.ЗаписатьКонецЭлемента(); // >>> ТекстУведУточ
	
	// <<< ДанПолучДок
	ЗаписьXML.ЗаписатьНачалоЭлемента("ДанПолучДок");
	ЗаписьXML.ЗаписатьАтрибут("НаимДок", СтруктураДокумента.ИдФайл);
	ЗаписьXML.ЗаписатьАтрибут("НомСФ"  , СтруктураДокумента.НомСФ);
	ЗаписьXML.ЗаписатьАтрибут("ДатаСФ" , СтруктураДокумента.ДатаСФ);
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // >>> ДанПолучДок
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // >>> СвУведУточ
	
	// <<< ОтпрДок
	ЗаписьXML.ЗаписатьНачалоЭлемента("ОтпрДок"); // Отправитель документа указанный в СведПолФайл, в данном случае это поставщик отправлял ЮЗД
	ЗаписьXML.ЗаписатьАтрибут("ИдУчастЭДО", СтруктураДокумента.ИдПок);
	
	// <<< ЮЛ
	ЗаписьXML.ЗаписатьНачалоЭлемента("ЮЛ");
	ЗаписьXML.ЗаписатьАтрибут("НаимОрг", СтруктураДокумента.ПоставщикНаимОрг);
	ЗаписьXML.ЗаписатьАтрибут("ИННЮЛ"  , СтруктураДокумента.ПоставщикИННЮЛ);
	ЗаписьXML.ЗаписатьАтрибут("КПП"    , СтруктураДокумента.ПоставщикКПП);
	ЗаписьXML.ЗаписатьКонецЭлемента(); // >>> ЮЛ
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // >>> ОтпрДок
	
	// <<< Подписант
	ЗаписьXML.ЗаписатьНачалоЭлемента("Подписант");
	ЗаписьXML.ЗаписатьАтрибут("Должность", СтруктураДокумента.ПодписантДолжн);
	
	// <<< ФИО
	ЗаписьXML.ЗаписатьНачалоЭлемента("ФИО");
	ЗаписьXML.ЗаписатьАтрибут("Имя"    , СтруктураДокумента.ПодписантИмя);
	ЗаписьXML.ЗаписатьАтрибут("Фамилия", СтруктураДокумента.ПодписантФамилия);	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // >>> ФИО
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // >>> Подписант
	
	ЗаписьXML.ЗаписатьКонецЭлемента();//Документ
	ЗаписьXML.ЗаписатьКонецЭлемента();//файл
	
	Возврат ЗаписьXML.Закрыть();
	
КонецФункции

Функция ОтправитьФайлDP_UVUTOCH_УведОбУточЭлДок(МассивДок, МассивЛогаСобытий) Экспорт
	
	ИмяСобытия = "Формирование DP_UVUTOCH_09"; //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _09]
	МассивСтруктур = Новый Массив;
	ВидыДокументовЮЗД = Новый Массив;
	
	Если МассивДок.Количество() = 0 Тогда //Docrobot 1.19.0 MOD-1511 [Сразу проверим на количество, чтобы не выполнять кучу процедур]
		ТекстЛогаСобытий = "Новые документы для обработки отсутствуют.";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Информация, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
		Возврат МассивСтруктур;
	КонецЕсли;
	
	Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьПервичныеВидыДокументовЮЗД(ВидыДокументовЮЗД);");
	Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьИсправительныеВидыДокументовЮЗД(ВидыДокументовЮЗД);");
	Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьКорректировочныеВидыДокументовЮЗД(ВидыДокументовЮЗД);");
	
	МассивПодписейВидовДокументовЮЗД = Новый Массив;
	Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьПодписьВидовДокументовЮЗД(МассивПодписейВидовДокументовЮЗД);");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЭКОМ_Документы.Ссылка КАК Ссылка,
	               |	ЭКОМ_Документы.Организация КАК Организация,
	               |	ЭКОМ_Документы.Контрагент КАК Контрагент,
	               |	ЭКОМ_Объекты_СобытияЮЗД.ЭЦП КАК ЭЦП,
	               |	ЭКОМ_Объекты_СобытияЮЗД.Идентификатор КАК ИмяПостФайла,
	               |	ЭКОМ_Объекты_СобытияЮЗД.ВидДокумента КАК ВидДокумента,
	               |	ЭКОМ_Документы.Комментарий,
	               |	ЭКОМ_Документы.Номер КАК Номер,
	               |	ЭКОМ_Документы.Дата КАК Дата,
	               |	ЭКОМ_Документы.ТочкаДоставки КАК ТочкаДоставки,
	               |	ЭКОМ_Объекты_СобытияЮЗД.ЗаказДата КАК ЗаказДата,
	               |	ЭКОМ_Объекты_СобытияЮЗД.ЗаказНомер КАК ЗаказНомер,
	               |	ЭКОМ_GLN_Организация.Сертификат КАК СертификатОрганизации,
	               |	ЭКОМ_GLN_Организация.Партнер КАК ОператорОрганизации,
	               |	ЭКОМ_GLN_Контрагенты.Партнер КАК ОператорКонтрагента,
	               |	ЭКОМ_GLN_Организация.Ид_ОЭД КАК Ид_ОЭД_Организации,
	               |	ЭКОМ_GLN_Контрагенты.Ид_ОЭД КАК Ид_ОЭД_Контрагента,
	               |	ЭКОМ_Документы.СЧФНомер,
	               |	ЭКОМ_Документы.СЧФДата,
	               |	ЭКОМ_Объекты_СобытияПоУточнению.ВидДокумента КАК ПроверкаНаУточнение,
	               |	ЭКОМ_Объекты_СобытияПодпись.ВидДокумента КАК ПроверкаНаПодпись,
	               |	ЭКОМ_Объекты_СобытияЮЗД.НомерДокумента,
	               |	ЭКОМ_Объекты_СобытияЮЗД.ДатаДокумента
	               |ПОМЕСТИТЬ ВТ
	               |ИЗ
	               |	Документ.ЭКОМ_Документы КАК ЭКОМ_Документы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_СобытияЮЗД
	               |		ПО ЭКОМ_Документы.Ссылка = ЭКОМ_Объекты_СобытияЮЗД.Документ_Основание
	               |			И ЭКОМ_Документы.ВидДокумента = ЭКОМ_Объекты_СобытияЮЗД.ВидДокумента
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Организация
	               |		ПО ЭКОМ_Документы.Организация = ЭКОМ_GLN_Организация.Объект
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Контрагенты
	               |		ПО ЭКОМ_Документы.Контрагент = ЭКОМ_GLN_Контрагенты.Объект
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_СобытияПоУточнению
	               |		ПО ЭКОМ_Документы.Ссылка = ЭКОМ_Объекты_СобытияПоУточнению.Документ_Основание
	               |			И (ЭКОМ_Объекты_СобытияПоУточнению.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.DP_UVUTOCH_09))
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_СобытияПодпись
	               |		ПО ЭКОМ_Документы.Ссылка = ЭКОМ_Объекты_СобытияПодпись.Документ_Основание
	               |			И (ЭКОМ_Объекты_СобытияПодпись.ВидДокумента В (&МассивПодписейВидовДокументовЮЗД))
	               |ГДЕ
	               |	НЕ ПОДСТРОКА(ЭКОМ_Документы.Комментарий, 0, 250) = """"
	               |	И ЭКОМ_Документы.Ссылка В(&МассивДок)
	               |	И ЭКОМ_Документы.СтатусОбработкиДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_Статусы.Обработан)
	               |	И ЭКОМ_Документы.ВидДокумента В(&ВидыДокументовЮЗД)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ.ВидДокумента,
	               |	ВТ.Дата,
	               |	ВТ.ЗаказДата,
	               |	ВТ.ЗаказНомер,
	               |	ВТ.Ид_ОЭД_Контрагента,
	               |	ВТ.Ид_ОЭД_Организации,
	               |	ВТ.ИмяПостФайла,
	               |	ВТ.Комментарий,
	               |	ВТ.Контрагент,
	               |	ВТ.Номер,
	               |	ВТ.ОператорКонтрагента,
	               |	ВТ.ОператорОрганизации,
	               |	ВТ.Организация,
	               |	ВТ.ПроверкаНаУточнение,
	               |	ВТ.СертификатОрганизации,
	               |	ВТ.Ссылка,
	               |	ВТ.СЧФДата,
	               |	ВТ.СЧФНомер,
	               |	ВТ.ТочкаДоставки,
	               |	ВТ.ЭЦП,
	               |	ВТ.ПроверкаНаПодпись,
	               |	ВТ.НомерДокумента,
	               |	ВТ.ДатаДокумента
	               |ИЗ
	               |	ВТ КАК ВТ
	               |ГДЕ
	               |	(ВТ.ПроверкаНаУточнение ЕСТЬ NULL
	               |			ИЛИ ВТ.ПроверкаНаУточнение = НЕОПРЕДЕЛЕНО
	               |			ИЛИ ВТ.ПроверкаНаУточнение = """")
	               |	И (ВТ.ПроверкаНаПодпись ЕСТЬ NULL
	               |			ИЛИ ВТ.ПроверкаНаПодпись = НЕОПРЕДЕЛЕНО
	               |			ИЛИ ВТ.ПроверкаНаПодпись = """"
	               |			ИЛИ ВТ.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPRMARK_01)
	               |			ИЛИ ВТ.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPRMARK_01_Испр)
	               |			ИЛИ ВТ.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.ON_NKORSCHFDOPPRMARK_01)
	               |			ИЛИ ВТ.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.ON_NKORSCHFDOPPRMARK_01_Испр))";		
	
	Запрос.УстановитьПараметр("ВидыДокументовЮЗД", ВидыДокументовЮЗД);
	Запрос.УстановитьПараметр("МассивПодписейВидовДокументовЮЗД", МассивПодписейВидовДокументовЮЗД);
	
	//Docrobot 1.19.0 MOD-1511 [Теперь всегда должен передаваться массив документов и для регалмента, и вручную. Провекрка на пустой массив выше]

	// По регламенту
	//Если МассивДок.Количество() = 0 Тогда
	//	Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ЭКОМ_Документы.Ссылка В(&МассивДок)", "");	
	//Иначе
		// В ручную
	Запрос.УстановитьПараметр("МассивДок", МассивДок);
	//КонецЕсли;	
	
	ВременныйКаталог = ПутьВременногоКаталогаЭКОМ("DP_UVUTOCH_out");
	КаталогВременный = ЭКОМ_СоздатьКаталогПроверитьНаЗапись(ВременныйКаталог, МассивЛогаСобытий);	
	Если КаталогВременный = Неопределено Тогда		
		Возврат МассивСтруктур;		
	КонецЕсли;
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		ТекстЛогаСобытий = "Уточнение не сформировано! Возможно уточнение уже отправлено или документ подписан ранее.";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

	Иначе	
		ВыборкаДок 			= Результат.Выбрать();
		СтруктураМетаДанных = ЮрФизЛицоОпределитьМетаданные();
		
		Пока ВыборкаДок.Следующий() Цикл	
			
			Если НЕ ЗначениеЗаполнено(ВыборкаДок.СертификатОрганизации) Тогда	
				ТекстЛогаСобытий = "Данные для организации не определены, заполните регистр ЭКОМ GLN!";
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
				
				Продолжить;
			КонецЕсли; 
			
			Если НЕ ЗначениеЗаполнено(ВыборкаДок.СертификатОрганизации) Тогда
				Продолжить;			
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ВыборкаДок.ОператорОрганизации) Тогда		
				ТекстЛогаСобытий = "Нет данных по организации! - " + Строка(ВыборкаДок.Организация);
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

				Продолжить;			
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ВыборкаДок.ОператорКонтрагента) Тогда
				ТекстЛогаСобытий = "Нет данных по контрагенту! - " + Строка(ВыборкаДок.Контрагент 
					+ ". ЭКОМ Документ № " + СокрЛП(ВыборкаДок.Номер) + " от " + ВыборкаДок.Дата); //Docrobot 1.19.0 MOD-1511 [Вывод документа, т.к. возникла ситуация, когда контрагент был пустой]
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

				Продолжить;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ВыборкаДок.ЭЦП) Тогда	
				ТекстЛогаСобытий = "Не найдена ЭЦП для входящего ЮЗД документа (не найдена запись в РС ""Docrobot События по документам"" документ: " + ВыборкаДок.Ссылка + ")";
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
				
				Продолжить;
			КонецЕсли; 
			
			ПредставлениеДок = "ЭКОМ Документ (" + СокрЛП(ВыборкаДок.ВидДокумента) + ") № " + СокрЛП(ВыборкаДок.Номер) + " от " + ВыборкаДок.Дата;
			
			СтруктураДокумента = Новый Структура;	
			ЭЦППолФайл         = ВыборкаДок.ЭЦП.Получить();
			
			// Оператор ОЭД контрагента
			КонтрагентСвОЭДОтпрНаимОрг = ВыборкаДок.ОператорКонтрагента.Наименование;
			КонтрагентСвОЭДОтпрИННЮЛ   = ВыборкаДок.ОператорКонтрагента.ИНН; 
			КонтрагентСвОЭДОтпрИдЭДО   = ВыборкаДок.ОператорКонтрагента.Идентификатор; 		
			
			// Оператор ОЭД организации
			ОрганизацияСвОЭДОтпрНаимОрг = ВыборкаДок.ОператорОрганизации.Наименование;
			ОрганизацияСвОЭДОтпрИННЮЛ   = ВыборкаДок.ОператорОрганизации.ИНН; 
			ОрганизацияСвОЭДОтпрИдЭДО   = ВыборкаДок.ОператорОрганизации.Идентификатор; 		
			
			Если НЕ ЗначениеЗаполнено(ВыборкаДок.Ид_ОЭД_Организации) Тогда
				Сообщить("Не заполнен Ид_ОЭД для организации <" + СокрЛП(ВыборкаДок.Организация.Наименование) + "> для документа " + ПредставлениеДок + "!", СтатусСообщения.Важное);
				Продолжить;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ВыборкаДок.Ид_ОЭД_Контрагента) Тогда
				Сообщить("Не заполнен Ид_ОЭД для контрагента <" + СокрЛП(ВыборкаДок.Контрагент.Наименование) + "> для документа " + ПредставлениеДок + "!", СтатусСообщения.Важное);
				Продолжить;
			КонецЕсли;
			
			ЭтоЮрЛицоКонтрагент = ЮрФизЛицоОпределитьТипОбъекта(ВыборкаДок.Контрагент, СтруктураМетаДанных.ИмяРеквизитаКонтрагента, СтруктураМетаДанных.ПеречислениеЮрЛицо);
			Идентификатор = Новый УникальныйИдентификатор;
			
			ИдФайл = "DP_UVUTOCH_" + КонтрагентСвОЭДОтпрИдЭДО + ВыборкаДок.Ид_ОЭД_Контрагента + "_" + ОрганизацияСвОЭДОтпрИдЭДО + ВыборкаДок.Ид_ОЭД_Организации + "_" 
			+ Формат(ВыборкаДок.Дата, "ДФ=yyyyMMdd") + "_" + Идентификатор;
			
			СтруктураДокумента = Новый Структура;
			СтруктураДокумента.Вставить("ИдФайл"           , ИдФайл); 
			СтруктураДокумента.Вставить("ИдОтпр"           , ОрганизацияСвОЭДОтпрИдЭДО + ВыборкаДок.Ид_ОЭД_Организации); 
			СтруктураДокумента.Вставить("ИдПок"            , КонтрагентСвОЭДОтпрИдЭДО  + ВыборкаДок.Ид_ОЭД_Контрагента);
			СтруктураДокумента.Вставить("СвОЭДОтпрНаимОрг" , ОрганизацияСвОЭДОтпрНаимОрг);
			СтруктураДокумента.Вставить("СвОЭДОтпрИННЮЛ"   , ОрганизацияСвОЭДОтпрИННЮЛ); 
			СтруктураДокумента.Вставить("СвОЭДОтпрИдЭДО"   , ОрганизацияСвОЭДОтпрИдЭДО); 
			СтруктураДокумента.Вставить("ДатаДок"          , Формат(ВыборкаДок.Дата, "ДФ=dd.MM.yyyy"));
			СтруктураДокумента.Вставить("ВремДок"          , Формат(ВыборкаДок.Дата, "ДФ=HH.mm.ss")); 
			СтруктураДокумента.Вставить("НаимПервДок"      , "Акт об установленном расхождении по количеству и качеству при приемке товарно-материальных ценностей");
			
			Если ЭтоЮрЛицоКонтрагент Тогда
				
				СтруктураДокумента.Вставить("ТипПолучателя", 	"ЮЛ");
				СтруктураДокумента.Вставить("ПоставщикНаимОрг", СокрЛП(ВыборкаДок.Контрагент.Наименование)); 
				СтруктураДокумента.Вставить("ПоставщикИННЮЛ", 	СокрЛП(ВыборкаДок.Контрагент.ИНН));     
				СтруктураДокумента.Вставить("ПоставщикКПП",		СокрЛП(ВыборкаДок.Контрагент.КПП));
				
			Иначе
				
				СтруктураДокумента.Вставить("ТипПолучателя", 	"ФЛ");
				СтруктураДокумента.Вставить("ПоставщикИННФЛ", 	СокрЛП(ВыборкаДок.Контрагент.ИНН));
				СтруктураДокумента.Вставить("ПоставщикФамилияФЛ", "");
				СтруктураДокумента.Вставить("ПоставщикИмяФЛ", 	"");
				СтруктураДокумента.Вставить("ПоставщикОтчествоФЛ", "");
				
				НаименованиеФЛ = ВыборкаДок.Контрагент.Наименование;
				Если Найти(ВРег(НаименованиеФЛ), "ИП ") = 1 Тогда
					НаименованиеФЛ = Прав(НаименованиеФЛ, СтрДлина(НаименованиеФЛ) - 3);
				КонецЕсли;
				
				МассивИмяФЛ = Эком_РазложитьСтрокуВМассивПодстрок(НаименованиеФЛ, " ");
				
				Если МассивИмяФЛ.Количество() 		>= 3 Тогда
					СтруктураДокумента.ПоставщикФамилияФЛ 	= СокрЛП(МассивИмяФЛ.Получить(0));
					СтруктураДокумента.ПоставщикИмяФЛ 		= СокрЛП(МассивИмяФЛ.Получить(1));
					СтруктураДокумента.ПоставщикОтчествоФЛ 	= СокрЛП(МассивИмяФЛ.Получить(2));
				ИначеЕсли МассивИмяФЛ.Количество() 	= 2 Тогда
					СтруктураДокумента.ПоставщикФамилияФЛ 	= СокрЛП(МассивИмяФЛ.Получить(0));
					СтруктураДокумента.ПоставщикИмяФЛ 		= СокрЛП(МассивИмяФЛ.Получить(1));
				ИначеЕсли МассивИмяФЛ.Количество() 	= 1 Тогда
					СтруктураДокумента.ПоставщикФамилияФЛ 	= СокрЛП(МассивИмяФЛ.Получить(0));
				КонецЕсли;
				
			КонецЕсли;
			
			СтруктураДокумента.Вставить("ПлательщикНаимОрг", СокрЛП(ВыборкаДок.Организация.Наименование)); 
			СтруктураДокумента.Вставить("ПлательщикИННЮЛ"  , СокрЛП(ВыборкаДок.Организация.ИНН)); 	
			СтруктураДокумента.Вставить("ПлательщикКПП"    , СокрЛП(ВыборкаДок.Организация.КПП));
			СтруктураДокумента.Вставить("НомСФ"            , ВыборкаДок.СЧФНомер);
			СтруктураДокумента.Вставить("ДатаСФ"           , Формат(ВыборкаДок.СЧФДата, "ДФ=dd.MM.yyyy"));
			СтруктураДокумента.Вставить("ИмяПостФайла"     , ВыборкаДок.ИмяПостФайла);
			СтруктураДокумента.Вставить("ТекстУведУточ"    , ВыборкаДок.Комментарий);
			СтруктураДокумента.Вставить("ЭЦППолФайл"       , Base64Строка(ЭЦППолФайл));
			
			СтруктураДокумента.Вставить("ПодписантИННЮЛ"  , СокрЛП(ВыборкаДок.Организация.ИНН));
			СтруктураДокумента.Вставить("ПодписантДолжн"  , ВыборкаДок.СертификатОрганизации.ДолжностьПодписанта);
			СтруктураДокумента.Вставить("ПодписантФамилия", ВыборкаДок.СертификатОрганизации.ФамилияПодписанта);
			СтруктураДокумента.Вставить("ПодписантИмя"    , ВыборкаДок.СертификатОрганизации.ИмяПодписанта);
			
			ФайлXMLПолноеИмя = ВременныйКаталог + СтруктураДокумента.ИдФайл + ".xml"; 
			СтрокаXML = ЗаписатьФайлDP_UVUTOCH_УведОбУточЭлДок(СтруктураДокумента, ФайлXMLПолноеИмя);  
			
			СтрокаСтруктура = Новый Структура;			
			СтрокаСтруктура.Вставить("ИмяФайлаXML"          , СтруктураДокумента.ИдФайл + ".xml");
			СтрокаСтруктура.Вставить("СтруктураДокумента"   , СтруктураДокумента);
			СтрокаСтруктура.Вставить("ДанныеСертификатаЭКОМ", ВыборкаДок.СертификатОрганизации);
			СтрокаСтруктура.Вставить("СертификатНаСервере"  , ВыборкаДок.СертификатОрганизации.СертификатНаСервере);
			СтрокаСтруктура.Вставить("Документ"             , ВыборкаДок.Ссылка);
			СтрокаСтруктура.Вставить("Организация"          , ВыборкаДок.Организация);
			СтрокаСтруктура.Вставить("Контрагент"           , ВыборкаДок.Контрагент);
			СтрокаСтруктура.Вставить("ВидДокументаУПД"      , ВыборкаДок.ВидДокумента);
			СтрокаСтруктура.Вставить("ЗаказДата"            , ВыборкаДок.ЗаказДата);
			СтрокаСтруктура.Вставить("ЗаказНомер"           , ВыборкаДок.ЗаказНомер);
			СтрокаСтруктура.Вставить("Статус"               , Перечисления.ЭКОМ_Статусы.Отправлен);
			СтрокаСтруктура.Вставить("ВидДокумента"         , Перечисления.ЭКОМ_ВидыДокументов.DP_UVUTOCH_09);
			СтрокаСтруктура.Вставить("ИдентификаторИспр"    , СтруктураДокумента.ИмяПостФайла);
			СтрокаСтруктура.Вставить("СтрокаXML"            , СтрокаXML);
			СтрокаСтруктура.Вставить("КодировкаФайла"       , "windows-1251");
			СтрокаСтруктура.Вставить("НомерДокумента"       , ВыборкаДок.НомерДокумента);
			СтрокаСтруктура.Вставить("ДатаДокумента"        , ВыборкаДок.ДатаДокумента);
			
			МассивСтруктур.Добавить(СтрокаСтруктура);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат МассивСтруктур;
	
КонецФункции

Функция ОтправитьАвто_ORDER(ЭтоРегламентноеЗадание) Экспорт
	
	МассивДок = Новый Массив;
	Запрос = Новый Запрос;	
	Запрос.Текст = Настройка_Параметр_Прочитать("ЗапросНаАвтоОбменПокупательORDERИсходящий", , "Служебный");
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	Попытка
		РезультатЗапроса = Запрос.Выполнить();	
		Выборка = РезультатЗапроса.Выбрать();	
		Пока Выборка.Следующий() Цикл
			
			СтруктураДляОтправки = Новый Структура;
			СтруктураДляОтправки.Вставить("ДокументЗаказа"      , Выборка.ДокументЗаказа);
			СтруктураДляОтправки.Вставить("ДокументПоступления" , Выборка.ДокументПоступления);
			
			СтруктураСтроки = Новый Структура;
			СтруктураСтроки.Вставить("Строка", СтруктураДляОтправки); 
			
			МассивДок.Добавить(СтруктураСтроки);	
		КонецЦикла;
	Исключение	
	КонецПопытки;
	
	Возврат МассивДок;	
	
КонецФункции

Функция ОтправитьАвто_RECADV(ЭтоРегламентноеЗадание) Экспорт
	
	МассивДок = Новый Массив;
