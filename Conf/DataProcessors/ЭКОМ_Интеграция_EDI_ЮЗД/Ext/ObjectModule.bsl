	|  _Exite_Spr_Kontragenty.eXite_Otchet_Ob_Otgruzke,
	|  _Exite_Spr_Kontragenty.eXite_Schet,                             
	|  _Exite_Spr_Kontragenty.eXite_Podtverjdenie_Zakaza,
	|  _Exite_Spr_Kontragenty.eXite_Price_From_Base1C,
	|  _Exite_Spr_Kontragenty.eXite_Price_Incl_NDS,
	|  _Exite_Spr_Kontragenty.eXite_ESF, 
	|  _Exite_Spr_Kontragenty.eXite_ESF_INFPOL_WITHOUT, 
