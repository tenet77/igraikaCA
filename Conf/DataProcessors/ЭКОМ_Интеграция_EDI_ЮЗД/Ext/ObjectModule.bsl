// Отправка файлов
// Параметры
// ЭтоНовыеДокументы - признак повторно или впервые отправляется документ
Функция ОтправитьВсеФайлы(МассивСтрок, ТипДокумента, МассивЛогаСобытий, НомерИсправления, ЭтоРегламентноеЗадание, ПодписатьФайл, ЭтоНовыеДокументы, СтруктураЛога) Экспорт
	
	ИмяСобытия = "Получить список документов для отправки";
	МассивСтруктур = Новый Массив;
	
	НаправлениеОбмена = "Исходящий";
	Если ЭтоНовыеДокументы = Ложь Тогда
	     НаправлениеОбмена = "Исходящий_Повторно";
	КонецЕсли;
	ПродолжитьОбмен = ПроверитьУстановитьБлокировкуОперации(ТипДокумента, НаправлениеОбмена, МассивЛогаСобытий);
	
	Если ПродолжитьОбмен = Ложь Тогда
		Возврат Новый Массив;	
	КонецЕсли;
	
	Если ТипДокумента = "DP_UVUTOCH_09" Тогда //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _09]
		
		МассивДокументов = Новый Массив;
		Для каждого Эл Из МассивСтрок Цикл
			ДокументЭКОМ_ЮЗД = Неопределено;
			Если Эл.Строка.Свойство("ДокументЭКОМ_ЮЗД", ДокументЭКОМ_ЮЗД) = Истина Тогда
				
				Если ЗначениеЗаполнено(ДокументЭКОМ_ЮЗД.Комментарий) 
					И ДокументЭКОМ_ЮЗД.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.Обработан Тогда         
					МассивДокументов.Добавить(Эл.Строка["ДокументЭКОМ_ЮЗД"]);
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(ДокументЭКОМ_ЮЗД.Комментарий) Тогда         		
					ТекстЛогаСобытий = "Уточнение не сформировано - не заполнен комментарий(уточнение)! Документ - " + СокрЛП(ДокументЭКОМ_ЮЗД) + " ";
					ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
					МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
					
				КонецЕсли;
				Если НЕ ДокументЭКОМ_ЮЗД.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.Обработан Тогда         
					ТекстЛогаСобытий = "Уточнение не сформировано - документ в статусе не обработан! Документ - " + СокрЛП(ДокументЭКОМ_ЮЗД) + " ";
					ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
					МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

				КонецЕсли;
				
			КонецЕсли;		   
		КонецЦикла;	
		
		МассивСтруктур = ОтправитьФайлDP_UVUTOCH_УведОбУточЭлДок(МассивДокументов, МассивЛогаСобытий);		
		
	ИначеЕсли ТипДокумента = "DP_IZVPOL_04" 
		ИЛИ ТипДокумента = "DP_IZVPOL_05"
		ИЛИ ТипДокумента = "DP_IZVPOL_06"
		ИЛИ ТипДокумента = "DP_IZVPOL_08"
		ИЛИ ТипДокумента = "DP_IZVPOL_10" Тогда
		
		МассивСтруктур = СформироватьDP_IZVPOL(ТипДокумента, МассивЛогаСобытий);
		
	ИначеЕсли ТипДокумента = "ПодписьЮЗД" Тогда
		
		МассивДокументов = Новый Массив;
		Для каждого Эл Из МассивСтрок Цикл
			МассивДокументов.Добавить(Эл.Строка["ДокументЭКОМ_ЮЗД"]);
		КонецЦикла;
		
		МассивСтруктур = Отправить_ПодписьЮЗД(МассивДокументов, МассивЛогаСобытий); 
		
	ИначеЕсли ТипДокумента = "DP_PTORG1" 
		ИЛИ ТипДокумента = "DP_PTORG2" Тогда
		
		МассивСтруктур = DP_PTORG1_DP_PTORG2_ТитулПродавцаСформировать(ТипДокумента, МассивЛогаСобытий);
		
		// Поддерживаемые модулем типы
	ИначеЕсли ТипДокумента = "ORDRSP"
		ИЛИ ТипДокумента = "DESADV" 
		ИЛИ ТипДокумента = "INVOICE" 
		ИЛИ ТипДокумента = "DESSCC"
		ИЛИ ТипДокумента = "RETINS"
		ИЛИ ТипДокумента = "ORDER"
		ИЛИ ТипДокумента = "ORDERS"
		ИЛИ	ТипДокумента = "RETORD"
		ИЛИ	ТипДокумента = "RECADV"
		ИЛИ ТипДокумента = "WHGOV_01_Исходящий" 
		ИЛИ ТипДокумента = "WHGPV_05_Исходящий" 
		ИЛИ ТипДокумента = "STATUS" 
		ИЛИ ТипДокумента = "ЮЗД" 
		ИЛИ ТипДокумента = "WHGOU_04_Исходящий"
		ИЛИ ТипДокумента = "WHGPU_08_Исходящий"
		ИЛИ Найти(ТипДокумента, "CONDRA") > 0
		ИЛИ Найти(ТипДокумента, "DP_PRANNUL_22") > 0 //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _22] / MOD-1694 [исправлено определение типа документа]
		ИЛИ ТипДокумента = "DP_IZVPOL_23"
		ИЛИ ТипДокумента = "DP_UVUTOCH_24"
		ИЛИ ТипДокумента = "DP_REZRUISP" 
		ИЛИ ТипДокумента = "PRICAT"
		ИЛИ ТипДокумента = "RETANN" Тогда 		                                    
		
		МассивСтруктур = СформироватьДокументыXML(МассивСтрок, МассивЛогаСобытий, ЭтоРегламентноеЗадание, ТипДокумента, ПодписатьФайл, НомерИсправления);
		
	Иначе
		
		ТекстЛогаСобытий = "!!! Данный тип файла не поддерживается для отправки.";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

	КонецЕсли;
	
	Если МассивСтруктур.Количество() = 0 Тогда
		Выполнить("ЭКОМ_ОбщегоНазначения.СнятьБлокировкуОперации(ТипДокумента, НаправлениеОбмена, МассивЛогаСобытий);");	
	КонецЕсли;
	
	Возврат МассивСтруктур;
	
КонецФункции

Функция ПолучитьРежимУправленияБлокировкойДанныхПоУмолчанию() Экспорт
	
	// Автоматический - все транзакции, будут выполняться в автоматическом режиме.
	// АвтоматическийИУправляемый  - транзакции, будут выполняться в режиме, определяемом установкой соответствующего свойства объекта метаданных.
	// Управляемый - все транзакции, будут выполняться в управляемом режиме. 
	Блокировать = Ложь;
	Если Метаданные.РежимУправленияБлокировкойДанных = Метаданные.Свойстваобъектов.РежимУправленияБлокировкойДанныхПоУмолчанию.Управляемый Тогда
		Блокировать = Истина;
	КонецЕсли;
	
	Возврат Блокировать;
	
КонецФункции // ПолучитьРежимУправленияБлокировкойДанныхПоУмолчанию()

// Процедура записывает в регистр сведений указанную причину отклонения для выбранных Эком документов с типом CONDRA
//
// Параметры:
//  Документы  - Массив - коллекция документов, требующих отклонения
//  ПричинаОтклонения  - Строка - текст причины отклонения для указанных докумнетов
//
Процедура ДобавитьПричинуОтклоненияCONDRA(Документы, ПричинаОтклонения) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЭКОМ_Документы.TRANSGUID
	|ИЗ
	|	Документ.ЭКОМ_Документы КАК ЭКОМ_Документы
	|ГДЕ
	|	ЭКОМ_Документы.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.CONDRA_Входящий)
	|	И НЕ ЭКОМ_Документы.TRANSGUID = """"
	|	И ЭКОМ_Документы.Ссылка В(&Документы)";
	
	Запрос.УстановитьПараметр("Документы", Документы);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		МенеджерЗаписи = РегистрыСведений.ЭКОМ_ЦепочкиНеструктурированныхДокументов.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.TRANSGUID 			= ВыборкаДетальныеЗаписи.TRANSGUID;
		//МенеджерЗаписи.НаправлениеОбмена 	= ПредопределенноеЗНАЧЕНИЕ(Перечисление.ЭКОМ_НаправлениеОбмена.Входящий);
		МенеджерЗаписи.Прочитать();
		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.INFO = ПричинаОтклонения;
			МенеджерЗаписи.Записать();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры // ДобавитьПричинуОтклоненияCONDRA()

// Процедура записывает в регистр сведений указанную причину отклонения для выбранных Эком документов с типом CONDRA
//
// Параметры:
//  Документы  - Массив - коллекция документов, требующих отклонения
//  ПричинаОтклонения  - Строка - текст причины отклонения для указанных докумнетов
//
Процедура ДобавитьТекстАннулирования(Документы, Текст, ИмяКолонкиТекста) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЭКОМ_Объекты_События.Документ_Основание,
	|	ЭКОМ_Объекты_События.ВидДокумента,
	|	ЭКОМ_Объекты_События.ЗаказДата,
	|	ЭКОМ_Объекты_События.ЗаказНомер,
	|	ЭКОМ_Объекты_События.Контрагент,
	|	ЭКОМ_Объекты_События.Организация,
	|	ЭКОМ_Объекты_События.НаправлениеОбмена
	|ИЗ
	|	РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_События
	|ГДЕ
	|	ЭКОМ_Объекты_События.Документ_Основание В(&Документы)";
	
	Запрос.УстановитьПараметр("Документы", Документы);
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		ДанныеОтбора = Новый Структура;
		Если Выборка.НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Входящий Тогда
			ИмяРегистра = "ЭКОМ_ЦепочкиДокументовПокупателя";
			ДанныеОтбора.Вставить("ЮЗД"  , Выборка.Документ_Основание);
		Иначе	
			ИмяРегистра = "ЭКОМ_ЦепочкиДокументовПоставщика";
			
			ВидДокументаСтрока = Строка(Выборка.ВидДокумента);
			Если ЭКОМ_ОбщегоНазначения.ПоискВСтроке(ВидДокументаСтрока, "KOR") > 0 ИЛИ ЭКОМ_ОбщегоНазначения.ПоискВСтроке(ВидДокументаСтрока, "Испр") > 0 Тогда
				ДанныеОтбора.Вставить("СЧФ_Кор", Выборка.Документ_Основание);
			Иначе
				ДанныеОтбора.Вставить("СЧФ"  , Выборка.Документ_Основание);
			КонецЕсли;
		КонецЕсли;
		
		НаборЗаписей = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
		ДанныеОтбора.Вставить("ORDERDATE"  , Выборка.ЗаказДата);
		ДанныеОтбора.Вставить("ORDERNUMBER", Выборка.ЗаказНомер);
		ДанныеОтбора.Вставить("Организация", Выборка.Организация);
		ДанныеОтбора.Вставить("Контрагент" , Выборка.Контрагент);
		Для каждого Стр Из ДанныеОтбора Цикл
			Если ЗначениеЗаполнено(Стр.Значение) Тогда
				НаборЗаписей.Отбор[Стр.Ключ].Установить(Стр.Значение);
			КонецЕсли;
		КонецЦикла;
		
		//Выполним блокировку данных
		Выполнить("ЭКОМ_ПодпискаСобытий.ВыполнитьБлокировкуНабораЗаписей(НаборЗаписей.Отбор, ИмяРегистра)");
		
		НаборЗаписей.Прочитать();
		
		// Если существует документ в регистре
		Для Каждого НоваяЗапись Из НаборЗаписей Цикл						
			НоваяЗапись[ИмяКолонкиТекста] = Текст;
		КонецЦикла;	
		
		НаборЗаписей.Записать();	
		
		ЗафиксироватьТранзакцию();
		
	КонецЦикла;
	
КонецПроцедуры // ДобавитьПричинуОтклоненияCONDRA()

