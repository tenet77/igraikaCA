			СтруктураСтроки.Вставить("СтрокаXML"            , СтрокаXML);
			СтруктураСтроки.Вставить("КодировкаФайла"       , "windows-1251");
			СтруктураСтроки.Вставить("НомерДокумента"       , Выборка.НомерДокумента);
			СтруктураСтроки.Вставить("ДатаДокумента"        , Выборка.ДатаДокумента);
			
			МассивСтруктур.Добавить(СтруктураСтроки);
			
		КонецЦикла;
		
	Иначе		
		ТекстЛогаСобытий = "Нет документов для подписания. Возможно документ уже подписан или не обработан или по нему отправлено уточнение!";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
	КонецЕсли;
	
	Возврат МассивСтруктур;
	
КонецФункции

//возвращает новым или старым методом данные сертификата ЭКОМ оставлена и дополнена для обеспечения совместимости с необновленными конфигурациями
Функция ДанныеСертификатаЭКОМ(СертификатЭКОМ) Экспорт
	
	Возврат Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьДанныеСертификатаЭКОМ(СертификатЭКОМ)");
	
КонецФункции//Функция ДанныеСертификатаЭКОМ()

Функция ПапкаНаСервереДляОбновлений(МассивЛогаСобытий) Экспорт
	
	ЭКОМ_ОбновленияИзВеткиDev = Настройка_Параметр_Прочитать("ЭКОМ_ОбновленияИзВеткиDev", Ложь);
	
	Если ЭКОМ_ОбновленияИзВеткиDev = Истина Тогда
		Результат = "/updates/dev/";
	Иначе
		Результат = "/updates/";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

Функция ПроверитьОбновление(ЭКОМОбъектыАктуальны, МассивЛогаСобытий) Экспорт
	
	ИмяСобытия = "Проверка обновлений";
	ДанныеОбработки = Новый Структура;
	ДанныеОбработки.Вставить("ВерсияМодуля"    , "");
	ДанныеОбработки.Вставить("ДатаОбработки"   , ТекущаяДата());
	ДанныеОбработки.Вставить("Описание"        , "");
	ДанныеОбработки.Вставить("ДатаУстановки"   , ТекущаяДата());
	ДанныеОбработки.Вставить("ФайлОбновленияИмя"  , "");
	ДанныеОбработки.Вставить("ФайлКонфигурацииИмя", "");
	ДанныеОбработки.Вставить("АдресВоВременномХранилище", "");
	ДанныеОбработки.Вставить("СтатусОбработки", "");
	
	СтруктураРезультата = Новый Структура;
	СтруктураРезультата.Вставить("ОбновлениеЗагружено", Ложь);
	СтруктураРезультата.Вставить("НеобходимоОбновление", Ложь);
	СтруктураРезультата.Вставить("ДанныеОбработки"    , ДанныеОбработки);
	
	ПараметрыFTP = ПолучитьНастройкиОбновленийСервераFTP();			
	Если ЭКОМОбъектыАктуальны = Истина Тогда		
		МассивНастроек = Новый Массив;
		МассивНастроек.Добавить("ЭКОМ_ИспользуетсяПрокси");
		МассивНастроек.Добавить("ЭКОМ_ИмяПользователяПрокси");
		МассивНастроек.Добавить("ЭКОМ_ПарольПользователяПрокси");
		
		НастройкиЭКОМ = ПолучитьСписокНастроек(МассивНастроек);	
		
		ПараметрыFTP.Вставить("ИспользуетсяПрокси"           , НастройкиЭКОМ.Получить("ЭКОМ_ИспользуетсяПрокси"));
		ПараметрыFTP.Вставить("ИмяПользователяПрокси"        , НастройкиЭКОМ.Получить("ЭКОМ_ИмяПользователяПрокси"));
		ПараметрыFTP.Вставить("ПарольПользователяПрокси"     , НастройкиЭКОМ.Получить("ЭКОМ_ПарольПользователяПрокси"));
	КонецЕсли;
	
	СерверFTP = ПолучитьСерверFTP(ПараметрыFTP, МассивЛогаСобытий);
	Если НЕ СерверFTP = Неопределено Тогда
		
		ДатаОбработки = ТекущаяДата();
		
		ОбновлениеЗагружено = Ложь;
		НеобходимоОбновление = Ложь;
		ФайлНаFTP = FTP_НайтиФайлПоМаскеПоиска(СерверFTP, ЭКОМОбъектыАктуальны, "*.zip", МассивЛогаСобытий);	
		Если ФайлНаFTP = Неопределено Тогда		
			ТекстЛогаСобытий = "Ошибка соединения с сервером - update1c.e-vo.ru";
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
		Иначе 
			
			ОбновлениеЗагружено = Ложь;
			
			Если ЭКОМОбъектыАктуальны = Истина Тогда
				ВерсияТекущейКонфигурации = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьВерсиюКонфигурации()");				
			Иначе	
				ВерсияТекущейКонфигурации = "0.0.0";			
			КонецЕсли;
			
			ВерсияТекущейОбработки      = ПолучитьВерсиюОбработки();
			ВерсияМодуляОбновленияНаFTP = ВерсияОбновленияОбработки(ФайлНаFTP);
			
			СтаршаяВерсия          = СверитьВерсии(ВерсияМодуляОбновленияНаFTP, ВерсияТекущейОбработки);
			НеобходимоОбновление    = (НЕ СтаршаяВерсия = ВерсияТекущейОбработки ИЛИ ЭКОМОбъектыАктуальны = Ложь);
			
			ДанныеОбработки.Вставить("ВерсияМодуля", ВерсияМодуляОбновленияНаFTP);
			
			ДанныеСкачивания = СкачатьОбновление(СерверFTP, ЭКОМОбъектыАктуальны, МассивЛогаСобытий);
			Если НЕ ДанныеСкачивания = Неопределено Тогда
				
				ДанныеОбработки.Вставить("АдресВоВременномХранилище", ДанныеСкачивания.АдресВоВременномХранилище);
				ДанныеОбработки.Вставить("ФайлОбновленияИмя"        , ДанныеСкачивания.ИмяФайлаНаFTP);
				
				ДатаОбработкиТекст = Строка(ФайлНаFTP.ПолучитьВремяИзменения());
				ДатаОбработкиТекст = СтрЗаменить(ДатаОбработкиТекст, "00", "20");
				ДатаОбработки      = Дата(ДатаОбработкиТекст);
				
				ЧтениеZIP 		= Новый ЧтениеZipФайла(ДанныеСкачивания.ПолныйПутьКФайлу);
				СтруктураФайла 	= Новый Структура;
				
				Для Каждого Элемент Из ЧтениеZIP.Элементы Цикл	
					
					Ключ = НРег(Элемент.ИсходноеРасширение);
					Если НЕ СтруктураФайла.Свойство(Ключ) Тогда
						СтруктураФайла.Вставить(Ключ, Элемент.ПолноеИмя);
					КонецЕсли;
					
				КонецЦикла;
				
				// Описание изменений
				Если СтруктураФайла.Свойство("txt") Тогда
					
					Элемент = ЧтениеZIP.Элементы.Найти(СтруктураФайла.txt);
					
					Если НЕ Элемент = Неопределено Тогда
						ЧтениеZIP.Извлечь(Элемент, ДанныеСкачивания.ВременныйКаталог, РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
						ФайлЭлемента = Новый Файл(ДанныеСкачивания.ВременныйКаталог + Элемент.Имя);
						ТекстовыйФайл   = Новый ЧтениеТекста(ФайлЭлемента.ПолноеИмя);
						Описание        = ТекстовыйФайл.Прочитать();
						ТекстовыйФайл.Закрыть();
						ДанныеОбработки.Описание = Описание;
						УдалитьФайлы(ФайлЭлемента.ПолноеИмя);
					КонецЕсли;
					
				КонецЕсли;
				
				ЧтениеZIP.Закрыть();
				
				// Удаление файла обновления во временном каталоге.
				Попытка
					УдалитьФайлы(ДанныеСкачивания.ПолныйПутьКФайлу);
				Исключение
					ТекстЛогаСобытий = "Ошибка удаления файла с обновлениями из временного каталога";
					ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Информация, ИмяСобытия);
					МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
				КонецПопытки;
				
				
				// Поставка модуля - объекты ЭКОМ
				ФайлКонфигурацииИмя = "";
				Если СтруктураФайла.Свойство("cf") Тогда
					ВерсияCfФайла = СтрЗаменить(ВРег(СтруктураФайла.cf), "E_COM_", "");
					ВерсияCfФайла = СтрЗаменить(ВРег(ВерсияCfФайла), "_SF", "");
					ВерсияCfФайла = СтрЗаменить(ВРег(ВерсияCfФайла), ".CF", "");
					
					ФайлКонфигурацииИмя = СтруктураФайла.cf;
					
					СтаршаяВерсия     = СверитьВерсии(ВерсияТекущейКонфигурации, ВерсияCfФайла);
					ЕстьНоваяВерсияCf = (СтаршаяВерсия = ВерсияCfФайла И НЕ СтаршаяВерсия = ВерсияТекущейКонфигурации);
					
					Если ЕстьНоваяВерсияCf Тогда
						СтатусОбработки = "Требуется помощь программиста для обновления объектов конфигурации";
					Иначе
						СтатусОбработки = "Обработка получена с сервера";
					КонецЕсли;
					
				Иначе
					СтатусОбработки = "Обработка получена с сервера";
				КонецЕсли;
				
				СтатусОбработки = ?(НеобходимоОбновление, СтатусОбработки, "Установлена");
				
				ДанныеОбработки.Вставить("ФайлКонфигурацииИмя", ФайлКонфигурацииИмя);
				ДанныеОбработки.Вставить("ДатаОбработки"      , ДатаОбработки);
				ДанныеОбработки.Вставить("СтатусОбработки"    , СтатусОбработки);
				
				Если ЭКОМОбъектыАктуальны = Истина Тогда
					МЗ = РегистрыСведений.ЭКОМ_ИсторияОбмена.СоздатьМенеджерЗаписи();
					Если НЕ Метаданные.РегистрыСведений.ЭКОМ_ИсторияОбмена.Измерения.Найти("НаправлениеОбмена") = Неопределено Тогда
						МЗ.НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Входящий;
					КонецЕсли;
					Если НЕ Метаданные.РегистрыСведений.ЭКОМ_ИсторияОбмена.Измерения.Найти("ВидДокумента") = Неопределено Тогда
						МЗ.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ПустаяСсылка();
					КонецЕсли;
					МЗ.Идентификатор     = ВерсияМодуляОбновленияНаFTP;	
					
					МЗ.Прочитать();
					
					Если НЕ Метаданные.РегистрыСведений.ЭКОМ_ИсторияОбмена.Измерения.Найти("НаправлениеОбмена") = Неопределено Тогда
						МЗ.НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Входящий;
					КонецЕсли;
					Если НЕ Метаданные.РегистрыСведений.ЭКОМ_ИсторияОбмена.Измерения.Найти("ВидДокумента") = Неопределено Тогда
						МЗ.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ПустаяСсылка();
					КонецЕсли;
					
					МЗ.Идентификатор     = ВерсияМодуляОбновленияНаFTP;
					МЗ.Причина           = СтатусОбработки;
					
					Если НЕ Метаданные.РегистрыСведений.ЭКОМ_ИсторияОбмена.Ресурсы.Найти("ДатаЗаписи") = Неопределено Тогда
						МЗ.ДатаЗаписи = ДанныеОбработки.ДатаУстановки;
					КонецЕсли;
					
					МЗ.Комментарий       = ДанныеОбработки.Описание;
					МЗ.ДатаПолучения     = ДатаОбработки;
					МЗ.Период            = ТекущаяДата();
					МЗ.Записать();		
				КонецЕсли;
				ОбновлениеЗагружено = Истина;
			КонецЕсли;			
		КонецЕсли;
		
		СтруктураРезультата.Вставить("ОбновлениеЗагружено", ОбновлениеЗагружено);
		СтруктураРезультата.Вставить("НеобходимоОбновление", НеобходимоОбновление);
		СтруктураРезультата.Вставить("ДанныеОбработки"    , ДанныеОбработки);
		
	КонецЕсли;
	
	Возврат СтруктураРезультата;
	
КонецФункции

Функция ПолучитьНастройкиОбновленийСервераFTP() Экспорт
	
	ПараметрыFTP = Новый Структура;
	ПараметрыFTP.Вставить("Сервер"                       , "update1c.e-vo.ru");
	ПараметрыFTP.Вставить("Порт"                         , 21);
	ПараметрыFTP.Вставить("ИмяПользователя"              , "FTPUserR");
	ПараметрыFTP.Вставить("ПарольПользователя"           , "Deu1420ZeD");
	ПараметрыFTP.Вставить("ПассивноеСоединение"          , Ложь);
	ПараметрыFTP.Вставить("Таймаут"                      , 10);
	ПараметрыFTP.Вставить("ЗащищенноеСоединение"         , Неопределено);
	ПараметрыFTP.Вставить("УровеньИспользованияЗащитыFTP", УровеньИспользованияЗащищенногоСоединенияFTP.НеИспользовать);
	ПараметрыFTP.Вставить("ИспользуетсяПрокси"           , Ложь);
	ПараметрыFTP.Вставить("ИмяПользователяПрокси"        , Ложь);
	ПараметрыFTP.Вставить("ПарольПользователяПрокси"     , Ложь);	
	
	Возврат ПараметрыFTP;
	
КонецФункции

Функция СкачатьОбновление(СерверFTP, ЭКОМОбъектыАктуальны, МассивЛогаСобытий) Экспорт
	
	ИмяСобытия = "Скачивание файла обновления по FTP";
	ФайлОбновленияZIPНаFTP = FTP_НайтиФайлПоМаскеПоиска(СерверFTP, ЭКОМОбъектыАктуальны, "*.zip", МассивЛогаСобытий);	
	Если ФайлОбновленияZIPНаFTP = Неопределено Тогда
		ДанныеСкачивания = Неопределено;
		
	Иначе	
		ВременныйКаталог = ПутьВременногоКаталогаЭКОМ("Update");
		КаталогВременный = ЭКОМ_СоздатьКаталогПроверитьНаЗапись(ВременныйКаталог, МассивЛогаСобытий);			
		ПолныйПутьКФайлу = ВременныйКаталог + ФайлОбновленияZIPНаFTP.Имя;  
		Попытка
			СерверFTP.Получить(ФайлОбновленияZIPНаFTP.ПолноеИмя, ПолныйПутьКФайлу);
			
			ДвоичныеДанныеФайла = Новый ДвоичныеДанные(ПолныйПутьКФайлу);
			АдресФайла          = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла);
			
			ДанныеСкачивания = Новый Структура;
			ДанныеСкачивания.Вставить("АдресВоВременномХранилище", АдресФайла);
			ДанныеСкачивания.Вставить("ИмяФайлаНаFTP"            , ФайлОбновленияZIPНаFTP.Имя);
			ДанныеСкачивания.Вставить("ПолныйПутьКФайлу"         , ПолныйПутьКФайлу);
			ДанныеСкачивания.Вставить("ВременныйКаталог"         , ВременныйКаталог);
		Исключение
			ТекстЛогаСобытий = "Ошибка при получении файла обновления по FTP : " + ОписаниеОшибки();
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат ДанныеСкачивания;
	
КонецФункции

Функция ПолучитьСерверFTP(ПараметрыFTP, МассивЛогаСобытий) Экспорт
	
	ЕстьОбщийМодуль = Неопределено;
	ИмяСобытия 		= "Получить сервер FTP";
	СерверFTP    	= Неопределено;
	ПроксиСервер 	= Новый ИнтернетПрокси();	     			
	Если ПараметрыFTP.ИспользуетсяПрокси = Истина Тогда	
		ПроксиСервер.Пользователь = СокрЛП(ПараметрыFTP.ИмяПользователяПрокси);
		ПроксиСервер.Пароль       = СокрЛП(ПараметрыFTP.ПарольПользователяПрокси);
		ПараметрыFTP.Вставить("Прокси", ПроксиСервер);
	КонецЕсли;
	
	знПорт = ?(ТипЗнч(ПараметрыFTP.Порт) = Тип("Число"), ПараметрыFTP.Порт, ЭКОМ_ПреобразоватьВЧисло(ПараметрыFTP.Порт));
	ПараметрыFTP.Вставить("Порт"  , знПорт);
	ПараметрыFTP.Вставить("Прокси", ПроксиСервер);
	
	Если ВерсияПлатформы() >= 8309 Тогда
		Попытка
			Выполнить("СерверFTP = Новый FTPСоединение(
			|ПараметрыFTP.Сервер, 
			|ПараметрыFTP.Порт, 
			|ПараметрыFTP.ИмяПользователя, 
			|ПараметрыFTP.ПарольПользователя,
			|ПараметрыFTP.Прокси,
			|ПараметрыFTP.ПассивноеСоединение,
			|ПараметрыFTP.Таймаут,
			|ПараметрыFTP.ЗащищенноеСоединение,
			|ПараметрыFTP.УровеньИспользованияЗащитыFTP);");					
		Исключение
			
			Если ЕстьОбщийМодуль = Неопределено Тогда
				ЕстьОбщийМодуль = Метаданные.ОбщиеМодули.Найти("ЭКОМ_ОбщегоНазначения") <> Неопределено;
			КонецЕсли;
			
			ОписаниеОшибкиТекст = ОписаниеОшибки();
			Если ЕстьОбщийМодуль Тогда
				Ошибка = Вычислить("ЭКОМ_ОбщегоНазначения.ДатьОписаниеОшибкиПоТекстуОшибки(ОписаниеОшибкиТекст)");
				ТекстЛогаСобытий = "Не удается подключиться к серверу: " + ПараметрыFTP.Сервер + Символы.ПС + Ошибка;
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			Иначе
				Сообщить(ОписаниеОшибкиТекст);
			КонецЕсли;
			
		КонецПопытки;	
	Иначе
		Попытка
			СерверFTP = Новый FTPСоединение(
			ПараметрыFTP.Сервер, 
			ПараметрыFTP.Порт, 
			ПараметрыFTP.ИмяПользователя, 
			ПараметрыFTP.ПарольПользователя,
			ПараметрыFTP.Прокси,
			ПараметрыFTP.ПассивноеСоединение,
			ПараметрыFTP.Таймаут);			
		Исключение
			
			Если ЕстьОбщийМодуль = Неопределено Тогда
				ЕстьОбщийМодуль = Метаданные.ОбщиеМодули.Найти("ЭКОМ_ОбщегоНазначения") <> Неопределено;
			КонецЕсли;
			
			ТекстЛогаСобытий = "Не удается подключиться к серверу: " + ПараметрыFTP.Сервер;
			Если ЕстьОбщийМодуль Тогда
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			Иначе
				Сообщить(ТекстЛогаСобытий);
			КонецЕсли;
			
		КонецПопытки;
	КонецЕсли;
	
	Если СерверFTP = Неопределено Тогда
		
		Если ЕстьОбщийМодуль = Неопределено Тогда
			ЕстьОбщийМодуль = Метаданные.ОбщиеМодули.Найти("ЭКОМ_ОбщегоНазначения") <> Неопределено;
		КонецЕсли;
		
		ТекстЛогаСобытий = "Отсутствует подключение к FTP (Неопределено)!";
		Если ЕстьОбщийМодуль Тогда
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		Иначе
			Сообщить(ТекстЛогаСобытий);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СерверFTP;
	
КонецФункции

//возращает первый найденный по маске файл
Функция FTP_НайтиФайлПоМаскеПоиска(СерверFTP, ЭКОМОбъектыАктуальны, МаскаПоиска = "*.epf", МассивЛогаСобытий)
	
	НайденныйФайл = Неопределено;
	
	Попытка
		Если ЭКОМОбъектыАктуальны Тогда
			ФайлыНаFTP = СерверFTP.НайтиФайлы(ПапкаНаСервереДляОбновлений(МассивЛогаСобытий), МаскаПоиска);
		Иначе	
			ФайлыНаFTP = СерверFTP.НайтиФайлы("/updates/", МаскаПоиска);
		КонецЕсли;
		
	Исключение
		ФайлыНаFTP = Неопределено;
	КонецПопытки;
	
	Если ТипЗнч(ФайлыНаFTP) = Тип("Массив") Тогда
		Если НЕ ФайлыНаFTP.Количество() = 0 Тогда
			НайденныйФайл = ФайлыНаFTP[0];
		КонецЕсли;
	КонецЕсли;
	
	Возврат НайденныйФайл;
	
КонецФункции

Функция ВерсияОбновленияБылаЗагруженаРанее(Версия)
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЭКОМ_ИсторияОбмена.Идентификатор КАК Версия
	|ИЗ
	|	РегистрСведений.ЭКОМ_ИсторияОбмена КАК ЭКОМ_ИсторияОбмена
	|ГДЕ
	|	(ЭКОМ_ИсторияОбмена.Причина = ""Установлена""
	|			ИЛИ ЭКОМ_ИсторияОбмена.Причина = ""Обработка получена с сервера""
	|			ИЛИ ЭКОМ_ИсторияОбмена.Причина = ""Требуется помощь программиста для обновления объектов конфигурации"")
	|	И ЭКОМ_ИсторияОбмена.Идентификатор = &Версия";
	
	Запрос.УстановитьПараметр("Версия", Версия);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Результат = Ложь;
	Иначе
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ВерсияОбновленияОбработки(ФайлEPF)
	Результат = СтрЗаменить(ФайлEPF.ИмяБезРасширения, "E_COM_", "");
	Результат = СтрЗаменить(Результат, "_SF", "");
	
	Возврат Результат;
КонецФункции

Функция ПроверкаНаличияОбъектовЭКОМ() Экспорт 
	
	ОтсутствующиеОбъекты = Новый Соответствие;
	
	ЭтоРасширение        = Ложь;
	
	// Проверка документов
	Если Метаданные.Документы.Найти("ЭКОМ_Документы") = Неопределено Тогда
		ОтсутствующиеОбъекты.Вставить("Документ: ЭКОМ_Документы", "");
	ИначеЕсли НЕ Метаданные.Документы.ЭКОМ_Документы.РасширениеКонфигурации() = Неопределено Тогда
		ЭтоРасширение = Истина;
	КонецЕсли;
	
	СписокОбъектовЭКОМ = Новый Соответствие;
	
	// Проверка общих модулей
	СписокОбъектовЭКОМ.Вставить("ЭКОМ_РегламентныеЗадания"   , "ОбщиеМодули");
	СписокОбъектовЭКОМ.Вставить("ЭКОМ_ОбщегоНазначения"      , "ОбщиеМодули");
	СписокОбъектовЭКОМ.Вставить("ЭКОМ_ОбщегоНазначенияКлиент", "ОбщиеМодули");
	СписокОбъектовЭКОМ.Вставить("ЭКОМ_ПодпискаСобытий"       , "ОбщиеМодули");
	
	Попытка
		СлужебныйТипФормы    = Настройка_Параметр_Прочитать("СлужебныйТипФормы", "ОбычнаяФорма", "Служебный");	
		Если СлужебныйТипФормы = "ОбычнаяФорма" Тогда
			// Проверка регламентных заданий
			СписокОбъектовЭКОМ.Вставить("ЭКОМ_АвтоматическиОбменEDI", "РегламентныеЗадания");
			// Проверка интерфейсов
			СписокОбъектовЭКОМ.Вставить("ЭКОМ_Интерфейс", "Интерфейсы");
		КонецЕсли;
	Исключение КонецПопытки;
	
	// Проверка справочников
	СписокОбъектовЭКОМ.Вставить("ЭКОМ_ОператорыЭДО"          , "Справочники");
	СписокОбъектовЭКОМ.Вставить("ЭКОМ_Сертификаты"           , "Справочники");
	СписокОбъектовЭКОМ.Вставить("ЭКОМ_ТипыНеструктДокументов", "Справочники");
	СписокОбъектовЭКОМ.Вставить("ЭКОМ_ИнфоПоля"              , "Справочники");
	СписокОбъектовЭКОМ.Вставить("ЭКОМ_ПрофилиОбмена"         , "Справочники");
	СписокОбъектовЭКОМ.Вставить("ЭКОМ_Роли"                  , "Справочники");
	СписокОбъектовЭКОМ.Вставить("ЭКОМ_Пользователи"          , "Справочники");
	
	// Проверка перечислений
	СписокОбъектовЭКОМ.Вставить("ЭКОМ_Статусы"                , "Перечисления");
	СписокОбъектовЭКОМ.Вставить("ЭКОМ_ВидыДокументов"         , "Перечисления");
	СписокОбъектовЭКОМ.Вставить("ЭКОМ_НаправлениеОбмена"      , "Перечисления");
	СписокОбъектовЭКОМ.Вставить("ЭКОМ_ТребуемоеДействиеCONDRA", "Перечисления");
	СписокОбъектовЭКОМ.Вставить("ЭКОМ_СтатусыCONDRA"          , "Перечисления");
	СписокОбъектовЭКОМ.Вставить("ЭКОМ_СтатусыСостоянияЭТРН"   , "Перечисления");
	
	// Проверка регистров сведений
	СписокОбъектовЭКОМ.Вставить("ЭКОМ_GLN"                                 , "РегистрыСведений");
	СписокОбъектовЭКОМ.Вставить("ЭКОМ_ЗначениеДополнительныхКонстант"      , "РегистрыСведений");
	СписокОбъектовЭКОМ.Вставить("ЭКОМ_ИсторияОбмена"                       , "РегистрыСведений");
	СписокОбъектовЭКОМ.Вставить("ЭКОМ_НоменклатураКонтрагентов"            , "РегистрыСведений");
	СписокОбъектовЭКОМ.Вставить("ЭКОМ_Объекты_События"                     , "РегистрыСведений");
	СписокОбъектовЭКОМ.Вставить("ЭКОМ_Палеты"                              , "РегистрыСведений");
	СписокОбъектовЭКОМ.Вставить("ЭКОМ_ТочкиДоставки"                       , "РегистрыСведений");
	СписокОбъектовЭКОМ.Вставить("ЭКОМ_ТранспортнаяИнформация"              , "РегистрыСведений");
	СписокОбъектовЭКОМ.Вставить("ЭКОМ_ЦепочкиДокументовПоставщика"         , "РегистрыСведений");
	СписокОбъектовЭКОМ.Вставить("ЭКОМ_ЦепочкиДокументовПокупателя"         , "РегистрыСведений");
	СписокОбъектовЭКОМ.Вставить("ЭКОМ_ЦепочкиДокументовЭТРН"               , "РегистрыСведений");
	СписокОбъектовЭКОМ.Вставить("ЭКОМ_Маркировка"                          , "РегистрыСведений");
	СписокОбъектовЭКОМ.Вставить("ЭКОМ_ЦепочкиНеструктурированныхДокументов", "РегистрыСведений");
	СписокОбъектовЭКОМ.Вставить("ЭКОМ_Квитанции"                           , "РегистрыСведений");
	
	Для каждого ЭлСтр Из СписокОбъектовЭКОМ Цикл
		Если Метаданные[ЭлСтр.Значение].Найти(ЭлСтр.Ключ) = Неопределено Тогда
			ОтсутствующиеОбъекты.Вставить(ЭлСтр.Значение + ": " + ЭлСтр.Ключ, "");	
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат ОтсутствующиеОбъекты;
	
КонецФункции	

// + Возвращает список необработанных событий // Тест пройден
//	- Ошибка - Стандартный параметр см. ПолучитьСтруктуруОшибки
Функция ПолучитьНеобработанныеСобытия(ПрофильОбмена, Ошибка = Неопределено, Количество = 0, МассивЛогаСобытий) Экспорт
	
	Если Ошибка = Неопределено Тогда
		Ошибка = ПолучитьСтруктуруОшибки();
	КонецЕсли;
	
	// Шаблон таблицы квитанций. Изменение состава колонок может привести к ошибке.
	ТаблицаСобытий = ПолучитьТаблицуСобытий(); 
	///////////////////////////////
	//Реализация 	
	
	ТокенАвторизации = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьТокенАвторизации(ПрофильОбмена, Ошибка, МассивЛогаСобытий)");	
	Если Ошибка.ЕстьОшибка Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	ТекстКоманды =  "/Api/V1/Edo/TimeLine/GetUnreadTimeLine";
	
	ДанныеЗапроса = Новый Структура;
	ДанныеЗапроса.Вставить("mode"    , "UPD");
	ДанныеЗапроса.Вставить("varToken", ТокенАвторизации);
	
	ЗаголовокHTTP = Новый Соответствие;
	ЗаголовокHTTP.Вставить("Content-type", "application/json");
	ЗаголовокHTTP.Вставить("Accept"      , "application/json");	
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("МетодHTTP"    , "POST");
	ПараметрыЗапроса.Вставить("ЗаголовокHTTP", ЗаголовокHTTP);
	
	Результат  = Вычислить("ЭКОМ_ОбщегоНазначения.ВыполнитьЗапрос(ТекстКоманды, ПрофильОбмена, ДанныеЗапроса, ПараметрыЗапроса , Ошибка, МассивЛогаСобытий)");
	
	Если Ошибка.ЕстьОшибка Тогда
		Сообщить("При получении необработанных событий возникла ошибка - Код: " + Ошибка.КодОшибки + " - " + Ошибка.ТекстОшибки);
		Возврат Неопределено;	
	КонецЕсли;
	
	Соответствие = UnJSON(Результат.Текст);
	МассивРезультат = Соответствие.Получить("timeline");
	Если НЕ МассивРезультат = Неопределено Тогда
		
		// Квитанции
		Для Каждого ТекЭлемент Из МассивРезультат Цикл
			
			// "УПДSENT"                                       - ON_SCHFDOPPR-01 (поставщик)
			// "УПДRECIEVED"                                   - ON_SCHFDOPPR-01 (покупатель)   +
			// "ПодтверждениеДатыПоступленияУПДRECIEVED"       - DP_PDPOL-02  (поставщик)
			// "ПодтверждениеДатыОтправкиУПДRECIEVED"          - DP_PDOTPR-03 (покупатель)      +
			// "ДатаПоступленияУПДПродавецSENT"                - DP_IZVPOL-04 (поставщик)
			// "ДатаОтправкиУПДПокупательSENT"                 - DP_IZVPOL-05 (покупатель)		+ Квитанция ИОП ПДО     //"КвитанцияПолученаПДО"
			// "ИзвещениеПолученияУПДПокупательSENT"           - DP_IZVPOL-06 (покупатель)      + Квитанция ИОП         //"КвитанцияПолученаДокумент"
			// "ИзвещениеПолученияУПДПокупательRECIEVED"       - DP_IZVPOL-06 (поставщик)
			// "ПодтверждениеДатыОтправкиИзвещенияRECIEVED"    - DP_PDOTPR-07 (покупатель)      +
			// "ДатаОтправкиИзвещенияПокупательSENT"           - DP_IZVPOL-08 (покупатель)      + Квитанция ИОП ПДО ИОП //"КвитанцияПолученаПДО_ИОП" 
			// "УведомлениеОбУточненииПокупательSENT"          - DP_UVUTOCH-09 (покупатель)     + 
			// "УведомлениеОбУточненииПокупательRECIEVED"      - DP_UVUTOCH-09 (поставщик)
			// "ИзвещениеПолученияУведомленияПродавецSENT"     - DP_IZVPOL-10 (поставщик)
			// "ИзвещениеПолученияУведомленияПродавецRECIEVED" - DP_IZVPOL-10 (покупатель)	    +
			// "ИнформацияПокупателяSENT"                      - ON_SCHFDOPPOK-11 (покупатель)  +
			// "ИнформацияПокупателяRECIEVED"                  - ON_SCHFDOPPOK-11 (поставщик)
			// "АннулированиеУПДRECIEVED" // "АннулированиеУКДRECIEVED"                         + //"АннулированиеДокумента"
			
			//      - "КвитанцияПолученаПредложениеОбАннулировании" - DP_PRANNUL
			//		- "КвитанцияПолученаУОУ_Аннулирования"          - DP_PRANNUL - UVUTOCH отклоняю
			//		- "АннулированиеДокумента"                      - DP_PRANNUL - IZVPOL  подтверждаю
			//      - "КвитанцияПолученаДокумент" - ON_SCHFDOPPR-01 // IZVPOL-06
			//      - "КвитанцияПолученаПДО"      - DP_PDOTPR-03    // IZVPOL-05
			//      - "КвитанцияПолученаПДО_ИОП"  - DP_PDOTPR-07    // IZVPOL-08
			
			
			ИД_Обмена = ТекЭлемент.Получить("exchangeid");
			
			ТипКвитанции = "";
			ИД_Документа = 0;
			ИД_Квитанции = 0;
			Статус = ТекЭлемент.Получить("event_status");
			
			// Сеть - предлагает аннулировать, поставщик - отклоняет // DP_PRANNUL - UVUTOCH 
			Если Статус = "УведомлениеОбУточненииАннулированиеУПДRECIEVED" 
				ИЛИ Статус = "УведомлениеОбУточненииАннулированиеУКДRECIEVED" Тогда
				
				ТипКвитанции = "КвитанцияПолученаУОУ_Аннулирования";
				
				
				// Сеть - предлагает аннулировать, поставщик - подтверждает // DP_PRANNUL - IZVPOL 
			ИначеЕсли Статус = "ИзвещениеПолученияАннулированиеУПДRECIEVED" 
				ИЛИ Статус = "ИзвещениеПолученияАннулированиеУКДRECIEVED" Тогда
				
				ТипКвитанции = "АннулированиеДокумента";
				
				// Поставщик - предлагает аннулировать, сеть принимает решение // DP_PRANNUL
			ИначеЕсли Статус = "АннулированиеУПДRECIEVED" 
				ИЛИ Статус = "АннулированиеУКДRECIEVED" Тогда
				
				ТипКвитанции = "КвитанцияПолученаПредложениеОбАннулировании";
				
				//      - "КвитанцияПолученаДокумент" - ON_SCHFDOPPR-01 // IZVPOL-06
			ИначеЕсли Статус = "УПДRECIEVED" 
				ИЛИ Статус = "УПДRECIEVED" Тогда
				
				//      - "КвитанцияПолученаДокумент" - ON_SCHFDOPPR-01 // IZVPOL-06
			ИначеЕсли Статус = "УПДRECIEVED" 
				ИЛИ Статус = "УПДRECIEVED" Тогда
				
				ТипКвитанции = "КвитанцияПолученаДокумент";
				
				//      - "КвитанцияПолученаПДО"      - DP_PDOTPR-03    // IZVPOL-05
			ИначеЕсли Статус = "ПодтверждениеДатыОтправкиУПДRECIEVED" 
				ИЛИ Статус = "ПодтверждениеДатыОтправкиУКДRECIEVED" Тогда
				
				ТипКвитанции = "КвитанцияПолученаПДО";
				
				//      - "КвитанцияПолученаПДО_ИОП"  - DP_PDOTPR-07    // IZVPOL-08
			ИначеЕсли Статус = "ПодтверждениеДатыОтправкиИзвещенияRECIEVED" Тогда
				
				ТипКвитанции = "КвитанцияПолученаПДО_ИОП";
				
			КонецЕсли;
			
			ИД_Квитанции = ТекЭлемент.Получить("document_id");
			ИД_Документа = ТекЭлемент.Получить("host_document_id");
			
			ДатаВремя  = ТекЭлемент.Получить("event_date");
			ТолькоДата = Лев(ДатаВремя, 10);
			
			СтрокаТаблицы = ТаблицаСобытий.Добавить();
			СтрокаТаблицы.ДатаСобытия 	    = Дата(Прав(ТолькоДата,2)+"."+Сред(ТолькоДата,6,2)+"."+Лев(ТолькоДата,4)+" " + Прав(ДатаВремя, 8));
			СтрокаТаблицы.ИД_Документа 		= ИД_Документа; 
			СтрокаТаблицы.ИД_Квитанции      = ИД_Квитанции;
			СтрокаТаблицы.ИД_События 		= ТекЭлемент.Получить("event_id");
			СтрокаТаблицы.ТехническиеДанные = ТекЭлемент.Получить("exchangeid");
			СтрокаТаблицы.ТипКвитанции 		= ТипКвитанции;
		КонецЦикла;	
	КонецЕсли;	
	
	///////////////////////////////
	
	Возврат ТаблицаСобытий; // Заполненая таблица
	
КонецФункции

Функция ПолучитьДанныеДокументаWEB(ПрофильОбмена, Идентификатор, Ошибка = Неопределено, МассивЛогаСобытий)
	Ошибка = ПолучитьСтруктуруОшибки();
	
	ТокенАвторизации = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьТокенАвторизации(ПрофильОбмена, Ошибка, МассивЛогаСобытий)");	
	Если Ошибка.ЕстьОшибка Тогда
		ТекстЛогаСобытий = Ошибка.ТекстОшибки;
		ЗаписьСтруктурыЛога = Вычислить("ЭКОМ_ОбщегоНазначения.ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ""Получение данных документов по API"")");
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		Возврат Неопределено;
	КонецЕсли;
	
	ТекстКоманды =  "/Api/V1/Edo/TimeLine/GetDocData";
	
	ДанныеЗапроса = Новый Структура;
	ДанныеЗапроса.Вставить("identifier", Идентификатор);
	ДанныеЗапроса.Вставить("varToken"  , ТокенАвторизации);
	
	ЗаголовокHTTP = Новый Соответствие;
	ЗаголовокHTTP.Вставить("Content-type", "application/json");
	ЗаголовокHTTP.Вставить("Accept"      , "application/json");	
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("МетодHTTP"    , "POST");
	ПараметрыЗапроса.Вставить("ЗаголовокHTTP", ЗаголовокHTTP);
	
	Ошибка = ПолучитьСтруктуруОшибки();
	
	Результат = Вычислить("ЭКОМ_ОбщегоНазначения.ВыполнитьЗапрос(ТекстКоманды, ПрофильОбмена, ДанныеЗапроса, ПараметрыЗапроса, Ошибка, МассивЛогаСобытий)");
	
	Если Ошибка.ЕстьОшибка Тогда		
		Возврат Неопределено;		
	КонецЕсли;
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ДоговорДата"      , Результат.document.contract_date);
	СтруктураДанных.Вставить("ДоговорНомер"     , Результат.document.contract_number);
	СтруктураДанных.Вставить("Дата"             , Результат.document.date);
	СтруктураДанных.Вставить("ТипДокумента"     , Результат.document.doc_type);
	СтруктураДанных.Вставить("Идентификатор"    , Результат.document.document_id);
	СтруктураДанных.Вставить("ДатаСобытия"      , Результат.document.event_date);
	СтруктураДанных.Вставить("Событие"          , Результат.document.event_direction);
	СтруктураДанных.Вставить("ИД_документа"     , Результат.document.exite_document_id);
	СтруктураДанных.Вставить("ИмяФайла"         , Результат.document.file_name);
	СтруктураДанных.Вставить("Комментарий"      , Результат.document.info);
	СтруктураДанных.Вставить("Сообщение"        , Результат.document.message);
	СтруктураДанных.Вставить("Номер"            , Результат.document.number);
	СтруктураДанных.Вставить("ИД_Получатель"    , Результат.document.recipient_id);
	СтруктураДанных.Вставить("ИД_Отправитель"   , Результат.document.sender_id);
	СтруктураДанных.Вставить("ИД_ДокОтправителя", Результат.document.sender_internal_id);
	СтруктураДанных.Вставить("Сумма"            , Результат.document.summ);                 
	
	Возврат СтруктураДанных;
	
КонецФункции

Функция ИзвлечьPDF_ЭКОМ(ПрофильОбмена, ИД_Документа, Ошибка, МассивЛогаСобытий, ОриентацияСтраницы = "Альбомная") Экспорт
	
	ТокенАвторизации = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьТокенАвторизации(ПрофильОбмена, Ошибка, МассивЛогаСобытий)");	
	Если Ошибка.ЕстьОшибка Тогда
		ТекстЛогаСобытий = Ошибка.ТекстОшибки;
		ЗаписьСтруктурыЛога = Вычислить("ЭКОМ_ОбщегоНазначения.ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ""Извлечение PDF"")");
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		Возврат Неопределено;
	КонецЕсли;
	
	ТекстКоманды = "/Api/V1/Edo/PrintForm/Generate";
	
	ДанныеЗапроса = Новый Структура;
	ДанныеЗапроса.Вставить("identifier", ИД_Документа);
	Если ОриентацияСтраницы = "Альбомная" Тогда
		ДанныеЗапроса.Вставить("album", "true");
	ИначеЕсли ОриентацияСтраницы = "Книжная" Тогда
		ДанныеЗапроса.Вставить("album", "false");
	КонецЕсли;
	ДанныеЗапроса.Вставить("varToken"  , ТокенАвторизации);
	
	ЗаголовокHTTP = Новый Соответствие;
	ЗаголовокHTTP.Вставить("Content-type", "application/json");
	ЗаголовокHTTP.Вставить("Accept"      , "application/json");	
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("МетодHTTP"    , "POST");
	ПараметрыЗапроса.Вставить("ЗаголовокHTTP", ЗаголовокHTTP);
	
	Результат = Вычислить("ЭКОМ_ОбщегоНазначения.ВыполнитьЗапрос(ТекстКоманды, ПрофильОбмена, ДанныеЗапроса, ПараметрыЗапроса, Ошибка, МассивЛогаСобытий)");
	
	Если Ошибка.ЕстьОшибка Тогда						
		Возврат Неопределено;		
	КонецЕсли;
	
	Текст = Результат.Текст;
	
	Информация = Сред(Текст, 10, Найти(Текст, ",""varMessage""") - 10);
	Информация = СтрЗаменить(Информация,"\/","/");  
	
	СтрокаBase64PDF_Документа = Информация;
	Если Base64Значение(Информация) = Неопределено Тогда
		
		Ошибка.Вставить("ЕстьОшибка" , Истина); 
		Ошибка.Вставить("КодОшибки"  , "");
		Ошибка.Вставить("ТекстОшибки", Текст);
		
	КонецЕсли;
	
	///////////////////////////////
	
	Возврат СтрокаBase64PDF_Документа; // СтрокаBase64 файла PDF
	
КонецФункции

Функция ЗагрузитьСвязанныеДокументыЮЗД(ПрофильОбмена, ИД_Документа, Ошибка, МассивЛогаСобытий) Экспорт
	
	ТокенАвторизации = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьТокенАвторизации(ПрофильОбмена, Ошибка, МассивЛогаСобытий)");	
	Если Ошибка.ЕстьОшибка Тогда
		ТекстЛогаСобытий = Ошибка.ТекстОшибки;
		ЗаписьСтруктурыЛога = Вычислить("ЭКОМ_ОбщегоНазначения.ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ""Извлечение PDF"")");
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		Возврат Неопределено;
	КонецЕсли;
	               
	ТекстКоманды = "Api/V1/Edo/TimeLine/GetTimeLine";
	
	ДанныеЗапроса = Новый Структура;
	ДанныеЗапроса.Вставить("varDocGUID", ИД_Документа);
	ДанныеЗапроса.Вставить("varToken"  , ТокенАвторизации);
	
	ЗаголовокHTTP = Новый Соответствие;
	ЗаголовокHTTP.Вставить("Content-type", "application/json");
	ЗаголовокHTTP.Вставить("Accept"      , "application/json");	
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("МетодHTTP"    , "POST");
	ПараметрыЗапроса.Вставить("ЗаголовокHTTP", ЗаголовокHTTP);
	
	Результат = Вычислить("ЭКОМ_ОбщегоНазначения.ВыполнитьЗапрос(ТекстКоманды, ПрофильОбмена, ДанныеЗапроса, ПараметрыЗапроса, Ошибка, МассивЛогаСобытий)");
	
	Если Ошибка.ЕстьОшибка Тогда						
		Возврат Неопределено;		
	КонецЕсли;
	
	СоответствиеОтветСвязанныеДокументы = Вычислить("ЭКОМ_ОбщегоНазначения.ЗаполнитьСтруктуруИзОтветаJSON(Результат.Текст, МассивЛогаСобытий)");
	
	МассивИДДокументов = СоответствиеОтветСвязанныеДокументы.Получить("timeline");
	
	ДанныеПоЦепочкеЮЗДBase64 = Новый Структура;
	
	Если МассивИДДокументов.Количество()>1 Тогда
		Для Каждого СвязанныйДокументЮЗД ИЗ МассивИДДокументов Цикл
			
			ТекстКоманды = "Api/V1/Edo/Content/GetDocWithSignContent";
			
			ДанныеЗапроса = Новый Структура;
			ДанныеЗапроса.Вставить("identifier", СвязанныйДокументЮЗД.Получить("document_id"));
			ДанныеЗапроса.Вставить("varToken"  , ТокенАвторизации);
			
			ЗаголовокHTTP = Новый Соответствие;
			ЗаголовокHTTP.Вставить("Content-type", "application/json");
			ЗаголовокHTTP.Вставить("Accept"      , "application/json");	
			
			ПараметрыЗапроса = Новый Структура;
			ПараметрыЗапроса.Вставить("МетодHTTP"    , "POST");
			ПараметрыЗапроса.Вставить("ЗаголовокHTTP", ЗаголовокHTTP);
			
			ДокументРезультат = Вычислить("ЭКОМ_ОбщегоНазначения.ВыполнитьЗапрос(ТекстКоманды, ПрофильОбмена, ДанныеЗапроса, ПараметрыЗапроса, Ошибка, МассивЛогаСобытий)");
			
			Если Ошибка.ЕстьОшибка Тогда						
				Возврат Неопределено;		
			КонецЕсли;
			
			СоответствиеДокументРезультат = Вычислить("ЭКОМ_ОбщегоНазначения.ЗаполнитьСтруктуруИзОтветаJSON(ДокументРезультат.Текст, МассивЛогаСобытий)");
						
			ФайлыДокумента = Новый Соответствие;
			ФайлыДокумента.Вставить(СвязанныйДокументЮЗД.Получить("event_status") + "_" + СвязанныйДокументЮЗД.Получить("document_id") + ".xml", СоответствиеДокументРезультат.Получить("body"));
			ФайлыДокумента.Вставить(СвязанныйДокументЮЗД.Получить("event_status") + "_" + СвязанныйДокументЮЗД.Получить("document_id") + ".bin", СоответствиеДокументРезультат.Получить("sign")[0].Получить("body"));
			
			ДанныеПоЦепочкеЮЗДBase64.Вставить(СвязанныйДокументЮЗД.Получить("event_status"),ФайлыДокумента);
			
		КонецЦикла;		
	Иначе
		Ошибка.Вставить("ЕстьОшибка" , Истина); 
		Ошибка.Вставить("КодОшибки"  , "");
		Ошибка.Вставить("ТекстОшибки", "Отсутствуют связанные документы для загрузки");
	КонецЕсли;
	
	Возврат ДанныеПоЦепочкеЮЗДBase64;
	
КонецФункции

Функция ДанныеКонтрагентаПоAPI(GLN, МассивЛогаСобытий) Экспорт
	
	ИмяСобытия = "Получение данных контрагента по API";
	ПрофильОбмена = ОсновнойПрофильОбмена(Неопределено, МассивЛогаСобытий);
	Если ПрофильОбмена = Неопределено Тогда
		ТекстЛогаСобытий = "Не заполнен Активный профиль обмена в справочнике <<<ЭКОМ Профили обмена>>>!";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
		Возврат Неопределено;
	КонецЕсли;
	
	Ошибка = ПолучитьСтруктуруОшибки();
	ТокенАвторизации = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьТокенАвторизации(ПрофильОбмена, Ошибка, МассивЛогаСобытий)");	
	Если Ошибка.ЕстьОшибка Тогда
		ТекстЛогаСобытий = Ошибка.ТекстОшибки;
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
		Возврат Неопределено;
	КонецЕсли;
	
	ЗаголовокHTTP = Новый Соответствие;
	ЗаголовокHTTP.Вставить("Content-type", "application/json");
	ЗаголовокHTTP.Вставить("Accept"      , "application/json");	
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("МетодHTTP"    , "POST");
	ПараметрыЗапроса.Вставить("ЗаголовокHTTP", ЗаголовокHTTP);
	
	// Переключения между шардами (GLNами)
	ДанныеЗапроса = Новый Структура;
	ДанныеЗапроса.Вставить("GLN"     , GLN);      		
	ДанныеЗапроса.Вставить("varToken", ТокенАвторизации);
	Ошибка = ПолучитьСтруктуруОшибки();
	
	Ответ = Вычислить("ЭКОМ_ОбщегоНазначения.ВыполнитьЗапрос(""/Api/V1/User/ChangeApiGln"", ПрофильОбмена, ДанныеЗапроса, ПараметрыЗапроса, Ошибка, МассивЛогаСобытий)");
	
	//Выполняем запрос по данным контрагента
	ДанныеЗапроса = Новый Структура;
	ДанныеЗапроса.Вставить("identifier", GLN);      		
	ДанныеЗапроса.Вставить("varToken"  , ТокенАвторизации);
	Ошибка = ПолучитьСтруктуруОшибки();
	Ответ = Вычислить("ЭКОМ_ОбщегоНазначения.ВыполнитьЗапрос(""/Api/V1/Edo/CompanyInfo/getData"", ПрофильОбмена, ДанныеЗапроса, ПараметрыЗапроса, Ошибка, МассивЛогаСобытий)");	
		
	Если Ошибка.ЕстьОшибка Тогда
		ТекстЛогаСобытий = Ошибка.КодОшибки + ": " + Ошибка.ТекстОшибки;
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		Возврат Неопределено;	
	КонецЕсли; 
	
	МассивСтруктур = Новый Массив;
	Если НЕ Ответ = Неопределено Тогда
		ОбработанныйРезультат = Вычислить("ЭКОМ_ОбщегоНазначения.ЗаполнитьСтруктуруИзОтветаJSON(Ответ.Текст, МассивЛогаСобытий)");
		COMPANIES = ОбработанныйРезультат.Получить("COMPANIES");
		Если НЕ COMPANIES = Неопределено Тогда
			Для Каждого СтрокаМассива Из COMPANIES Цикл
				МассивGUIDS = СтрокаМассива.Получить("GUIDS");
				Оператор    = Неопределено;
				varPrefix   = "";
				varGUID     = "";				
				Если ТипЗнч(МассивGUIDS) = Тип("Массив") Тогда
					Если МассивGUIDS.Количество() = 1 Тогда
						Для каждого Стр Из МассивGUIDS Цикл
							varGUID = Стр.Получить("varGUID");
							varPrefix = Стр.Получить("varPrefix");
							Если НЕ ЗначениеЗаполнено(varGUID) Тогда
								Стр.Вставить("varGUID_39", varGUID);
							КонецЕсли;
						КонецЦикла;
						
						Запрос = Новый Запрос;
						Запрос.Текст = 
						"ВЫБРАТЬ
						|	ЭКОМ_ОператорыЭДО.Ссылка
						|ИЗ
						|	Справочник.ЭКОМ_ОператорыЭДО КАК ЭКОМ_ОператорыЭДО
						|ГДЕ
						|	ЭКОМ_ОператорыЭДО.Идентификатор = &Идентификатор
						|	И НЕ ЭКОМ_ОператорыЭДО.ПометкаУдаления";
						
						Запрос.УстановитьПараметр("Идентификатор", varPrefix);						
						РезультатЗапроса = Запрос.Выполнить();														
						Если НЕ РезультатЗапроса.Пустой() Тогда
							ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
							ВыборкаДетальныеЗаписи.Следующий();
							Оператор = ВыборкаДетальныеЗаписи.Ссылка;	
						КонецЕсли;
					КонецЕсли;
					
				КонецЕсли;
				
				varInnCode = СтрокаМассива.Получить("varInnCode");
				varName = СтрокаМассива.Получить("varName");
				varGln = СтрокаМассива.Получить("varGln");
				varSapCode = СтрокаМассива.Получить("varSapCode");
				varRURegion = СтрокаМассива.Получить("varRURegion");
				varEdrpouCode = СтрокаМассива.Получить("varEdrpouCode");
				varStreet = СтрокаМассива.Получить("varStreet");
				varHouseNumber = СтрокаМассива.Получить("varHouseNumber");
				varDistrict = СтрокаМассива.Получить("varDistrict");
				varLocality = СтрокаМассива.Получить("varLocality");
				varCorps = СтрокаМассива.Получить("varCorps");
				varApartment = СтрокаМассива.Получить("varApartment");
				varCity = СтрокаМассива.Получить("varCity");
				varZip = СтрокаМассива.Получить("varZip");
				
				Данные = Новый Структура;
				Данные.Вставить("ИНН"         , varInnCode);
				Данные.Вставить("Наименование", varName);
				Данные.Вставить("GLN"         , varGln);
				Данные.Вставить("GUID"        , varGUID);
				Данные.Вставить("SAPкод"      , varSapCode);
				Данные.Вставить("Оператор"    , Оператор);
				Данные.Вставить("МассивGUIDS" , МассивGUIDS);
				Данные.Вставить("Регион"      , varRURegion);
				Данные.Вставить("КПП"         , varEdrpouCode);		 
				Данные.Вставить("Улица"       , varStreet);	 
				Данные.Вставить("НомерДома"   , varHouseNumber);	 
				Данные.Вставить("Район"       , varDistrict);	 
				Данные.Вставить("Население"   , varLocality);
				Данные.Вставить("Корпус"      , varCorps);
				Данные.Вставить("Квартира"    , varApartment);
				Данные.Вставить("Город"       , varCity);
				Данные.Вставить("Индекс"      , varZip);
				МассивСтруктур.Добавить(Данные);
			КонецЦикла;
		КонецЕсли;		
	КонецЕсли;
	
	Возврат МассивСтруктур;
	
КонецФункции

Функция ПолучениеСпискаGLNРозничнойСети(ПрофильОбмена, GLN, МассивЛогаСобытий) Экспорт
	
	ИмяСобытия = "Получение списка GLN";
	Ошибка = ПолучитьСтруктуруОшибки();
	
	ТокенАвторизации = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьТокенАвторизации(ПрофильОбмена, Ошибка, МассивЛогаСобытий)");	
	Если Ошибка.ЕстьОшибка Тогда
		МассивЛогаСобытий.Добавить(Ошибка.ТекстОшибки);
		Возврат Неопределено;
	КонецЕсли;
	
	ДанныеЗапроса = Новый Структура;
	ДанныеЗапроса.Вставить("retailer_gln", GLN);      		
	ДанныеЗапроса.Вставить("varToken"    , ТокенАвторизации);
	
	ЗаголовокHTTP = Новый Соответствие;
	ЗаголовокHTTP.Вставить("Content-type", "application/json");
	ЗаголовокHTTP.Вставить("Accept"      , "application/json");	
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("МетодHTTP"    , "POST");
	ПараметрыЗапроса.Вставить("ЗаголовокHTTP", ЗаголовокHTTP);
	
	Ошибка = ПолучитьСтруктуруОшибки();
	
	//Выполняем запрос.
	Ответ = Вычислить("ЭКОМ_ОбщегоНазначения.ВыполнитьЗапрос(""/Api/V1/Edo/CompanyInfo/GetRetailersCompanies"", ПрофильОбмена, ДанныеЗапроса, ПараметрыЗапроса, Ошибка, МассивЛогаСобытий)");	
	
	// Проверяем ответ.
	Если Ошибка.ЕстьОшибка Тогда
		ТекстЛогаСобытий    = Вычислить("ЭКОМ_ОбщегоНазначения.ДатьОписаниеОшибкиПоТекстуОшибки(Ошибка.ТекстОшибки)");
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		Отказ = Истина;
	КонецЕсли;
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("ИНН", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(50)));
	ТЗ.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(200)));
	ТЗ.Колонки.Добавить("GLN", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(50)));
	ТЗ.Колонки.Добавить("Регион", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(100)));
	ТЗ.Колонки.Добавить("КПП", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(50)));
	ТЗ.Колонки.Добавить("Улица", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(100)));
	ТЗ.Колонки.Добавить("НомерДома", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(50)));
	ТЗ.Колонки.Добавить("Район", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(100)));
	ТЗ.Колонки.Добавить("Население", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(100)));
	ТЗ.Колонки.Добавить("Корпус", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(100)));
	ТЗ.Колонки.Добавить("Квартира", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(50)));
	ТЗ.Колонки.Добавить("Город", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(100)));
	ТЗ.Колонки.Добавить("Индекс", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(100)));
	
	Если НЕ Ответ = Неопределено Тогда		
		ОбработанныйРезультат = ОбработатьJSON(Ответ, МассивЛогаСобытий);
		Если НЕ ОбработанныйРезультат = Неопределено Тогда
			Если ОбработанныйРезультат.Свойство("COMPANIES") Тогда
				Для Каждого СтрокаМассива Из ОбработанныйРезультат.COMPANIES Цикл
					НовСтр = ТЗ.Добавить();
					varInnCode    = "";
					varName       = "";
					varGln        = "";
					varRURegion   = "";
					varEdrpouCode = "";
					varStreet     = "";
					
					varHouseNumber = "";
					varDistrict    = "";
					varLocality    = "";
					varCorps       = "";
					varApartment   = "";
					varCity        = "";
					varZip         = "";			
					
					СтрокаМассива.Свойство("varInnCode", varInnCode);
					СтрокаМассива.Свойство("varName", varName);
					СтрокаМассива.Свойство("varGln", varGln);
					СтрокаМассива.Свойство("varRURegion", varRURegion);
					СтрокаМассива.Свойство("varEdrpouCode", varEdrpouCode);
					СтрокаМассива.Свойство("varStreet", varStreet);
					СтрокаМассива.Свойство("varHouseNumber", varHouseNumber);
					СтрокаМассива.Свойство("varDistrict", varDistrict);
					СтрокаМассива.Свойство("varLocality", varLocality);
					СтрокаМассива.Свойство("varCorps", varCorps);
					СтрокаМассива.Свойство("varApartment", varApartment);
					СтрокаМассива.Свойство("varCity", varCity);
					СтрокаМассива.Свойство("varZip", varZip);
					
					НовСтр.ИНН          = varInnCode;
					НовСтр.Наименование = varName;
					НовСтр.GLN          = varGln;
					НовСтр.Регион       = varRURegion;
					НовСтр.КПП          = varEdrpouCode;
					НовСтр.Улица        = varStreet;
					НовСтр.НомерДома    = varHouseNumber;
					НовСтр.Район        = varDistrict;
					НовСтр.Население    = varLocality;
					НовСтр.Корпус       = varCorps;
					НовСтр.Квартира     = varApartment;
					НовСтр.Город        = varCity;
					НовСтр.Индекс       = varZip;				
				КонецЦикла;	 
			КонецЕсли;
		КонецЕсли;		
	КонецЕсли;
	
	Возврат ТЗ;
	
КонецФункции

Функция ЗагрузкаТочекДоставкиПоGLNРозничнойСети(ПрофильОбмена, Владелец, GLN, МассивЛогаСобытий) Экспорт
	
	ТЗ = ПолучениеСпискаGLNРозничнойСети(ПрофильОбмена, GLN, МассивЛогаСобытий);
	
	Индекс = ТЗ.Количество() - 1; 
      
	Пока Индекс >= 0 Цикл  
		Если СтрДлина(ТЗ[Индекс].ИНН) < 10 Или  СтрДлина(ТЗ[Индекс].КПП) < 9 Тогда 
			ТЗ.Удалить(Индекс); 
		КонецЕсли; 
		Индекс = Индекс - 1; 
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПОДСТРОКА(ТЗ.ИНН, 0, 50) КАК ИНН,
	|	ПОДСТРОКА(ТЗ.Наименование, 0, 200) КАК Наименование,
	|	ПОДСТРОКА(ТЗ.GLN, 0, 50) КАК GLN,
	|	ПОДСТРОКА(ТЗ.Регион, 0, 100) КАК Регион,
	|	ПОДСТРОКА(ТЗ.КПП, 0, 100) КАК КПП,
	|	ПОДСТРОКА(ТЗ.Улица, 0, 100) КАК Улица,
	|	ПОДСТРОКА(ТЗ.НомерДома, 0, 100) КАК НомерДома,
	|	ПОДСТРОКА(ТЗ.Район, 0, 100) КАК Район,
	|	ПОДСТРОКА(ТЗ.Население, 0, 100) КАК Население,
	|	ПОДСТРОКА(ТЗ.Корпус, 0, 100) КАК Корпус,
	|	ПОДСТРОКА(ТЗ.Квартира, 0, 100) КАК Квартира,
	|	ПОДСТРОКА(ТЗ.Город, 0, 100) КАК Город,
	|	ПОДСТРОКА(ТЗ.Индекс, 0, 100) КАК Индекс
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&ТЗ КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Контрагент,
	|	ВТ.ИНН,
	|	ВТ.Наименование,
	|	ВТ.GLN,
	|	ВТ.Регион,
	|	ВТ.КПП,
	|	ВТ.Улица,
	|	ВТ.НомерДома,
	|	ВТ.Район,
	|	ВТ.Население,
	|	ВТ.Корпус,
	|	ВТ.Квартира,
	|	ВТ.Город,
	|	ВТ.Индекс
	|ИЗ
	|	ВТ КАК ВТ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО ВТ.ИНН = Контрагенты.ИНН
	|			И ВТ.КПП = Контрагенты.КПП
	|			И (НЕ Контрагенты.ПометкаУдаления)";
	
	Запрос.УстановитьПараметр("ТЗ", ТЗ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	ДобавленоЗаписей = 0;
	ИмяСобытия = "Загрузка точек доставки по GLN";
	Пока Выборка.Следующий() Цикл
		ЭКОМ_ТочкиДоставки = РегистрыСведений.ЭКОМ_ТочкиДоставки.СоздатьНаборЗаписей();
		ЭКОМ_ТочкиДоставки.Отбор.Объект.Установить(Выборка.Контрагент);
		ЭКОМ_ТочкиДоставки.Прочитать();
		Если ЭКОМ_ТочкиДоставки.Количество() = 0 Тогда
			НоваяЗапись = ЭКОМ_ТочкиДоставки.Добавить();
			НоваяЗапись.Объект = Выборка.Контрагент;
		Иначе
			НоваяЗапись = ЭКОМ_ТочкиДоставки[0];
		КонецЕсли;
		НоваяЗапись.GLN            = Выборка.GLN;
		НоваяЗапись.Владелец       = Владелец;
		НоваяЗапись.КПП            = Выборка.КПП;
		НоваяЗапись.ИНН            = Выборка.ИНН;
		НоваяЗапись.Адр_Город      = Выборка.Город;
		НоваяЗапись.Адр_Индекс     = Выборка.Индекс;
		НоваяЗапись.Адр_КодРегиона = Выборка.Регион;
		НоваяЗапись.Адр_Улица      = Выборка.Улица;
		НоваяЗапись.Адр_Дом        = Выборка.НомерДома;
		НоваяЗапись.Адр_Корпус     = Выборка.Корпус;
		НоваяЗапись.Адр_Кварт      = Выборка.Квартира;
		Попытка
			ЭКОМ_ТочкиДоставки.Записать();
			ТекстЛогаСобытий = "Записана точка доставки по GLN: " + Строка(Выборка.GLN) + " для контрагента: " + Строка(Выборка.Контрагент);	
			ДобавленоЗаписей = ДобавленоЗаписей + 1;
			УровеньЛогирования = Перечисления.ЭКОМ_УровниЛогирования.Успешно;
			
		Исключение
			Ошибка = ОписаниеОшибки();
			ТекстЛогаСобытий = "Ошибка записи точки доставки по GLN: " + Строка(Выборка.GLN) + " для контрагента: " + Строка(Выборка.Контрагент);	
			Результат = Ложь;
			УровеньЛогирования = Перечисления.ЭКОМ_УровниЛогирования.Ошибка;

		КонецПопытки;
		
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, УровеньЛогирования, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
	КонецЦикла;
	
	ТекстЛогаСобытий = "Загрузка завершена. Найдено контрагентов по ИНН и КПП: " + Строка(ДобавленоЗаписей);	
	ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Информация, ИмяСобытия);
	МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
	
	Возврат ДобавленоЗаписей;
	
КонецФункции

