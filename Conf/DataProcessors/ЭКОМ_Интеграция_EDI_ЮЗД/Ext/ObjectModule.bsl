Функция API_ЗавершитьСоединение(ПрофильОбмена, МассивЛогаСобытий)
	
	Ошибка = ПолучитьСтруктуруОшибки();
	ТокенАвторизации = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьТокенАвторизации(ПрофильОбмена, Ошибка, МассивЛогаСобытий)");
	
	ДанныеЗапроса 			= Новый Структура;
	ДанныеЗапроса.Вставить("varToken", 	ТокенАвторизации);
	
	ЗаголовокHTTP = Новый Соответствие;
	ЗаголовокHTTP.Вставить("Content-type", "application/json");
	ЗаголовокHTTP.Вставить("Accept"      , "application/json");	
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("МетодHTTP"    , "POST");
	ПараметрыЗапроса.Вставить("ЗаголовокHTTP", ЗаголовокHTTP);
	
	Ошибка = ПолучитьСтруктуруОшибки();
	
	Ответ = Вычислить("ЭКОМ_ОбщегоНазначения.ВыполнитьЗапрос(""/Api/V1/User/Deauthorize"", ПрофильОбмена, ДанныеЗапроса, ПараметрыЗапроса, Ошибка, МассивЛогаСобытий)");
	
	Возврат НЕ Ошибка.ЕстьОшибка;
	
КонецФункции // API_ЗавершитьСоединение()

Функция ОбработатьJSON(РезультатЗапроса, МассивЛогаСобытий) Экспорт
	
	ЧтениеJSON = "";
	Если ВерсияПлатформы() >= 8360 Тогда
		Выполнить("ЧтениеJSON = Новый ЧтениеJSON;");
		ЧтениеJSON.УстановитьСтроку(РезультатЗапроса.Текст);
		Выполнить("ОбработанныйРезультат = ПрочитатьJSON(ЧтениеJSON);");
	Иначе 
		ОбработанныйРезультат = Вычислить("ЭКОМ_ОбщегоНазначения.ЗаполнитьСтруктуруИзОтветаJSON(РезультатЗапроса.Текст, МассивЛогаСобытий)");
	КонецЕсли; 
	
	Возврат ОбработанныйРезультат;
КонецФункции

Функция ПолучитьСтруктуруОшибки()
	
	Структура = Новый Структура;
	Структура.Вставить("ЕстьОшибка" , Ложь);
	Структура.Вставить("КодОшибки"  , "");
	Структура.Вставить("ТекстОшибки", "");
	Возврат Структура;
	
КонецФункции

Функция ПолучитьIPПК() Экспорт
	
	strComputer = ".";
	SWBemlocator = Новый COMОбъект("WbemScripting.SWbemLocator");
	objWMIService = SWBemlocator.ConnectServer(strComputer, "root\CIMV2");
	IPConfigSet = objWMIService.ExecQuery("Select IPAddress from Win32_NetworkAdapterConfiguration where ipenabled = true");
	
	Для Каждого Конфигурация Из IPConfigSet Цикл
		Для Каждого СтрПараметр Из Конфигурация.IPAddress Цикл 
			Возврат СтрПараметр;
		КонецЦикла;
	КонецЦикла;
	
КонецФункции

// Функция возвращает доступные форматы УПД
//
// Возвращаемое значение:
//   СписокЗначений, Массив   - коллекция форматов УПД. При параметре НуженМассив = Истина возвращается Массив
//
Функция ПолучитьФорматыУПД(НуженМассив = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЭКОМ_ИнфоПоля.Наименование
	|ИЗ
	|	Справочник.ЭКОМ_ИнфоПоля КАК ЭКОМ_ИнфоПоля";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	СписокФорматовЮЗД = Новый СписокЗначений;
	Пока Выборка.Следующий() Цикл
		СписокФорматовЮЗД.Добавить(Выборка.Наименование);
	КонецЦикла;
	
	Возврат ?(НуженМассив, СписокФорматовЮЗД.ВыгрузитьЗначения(), СписокФорматовЮЗД);
	
КонецФункции

// Заполняет массив ДанныеПоМаркировке данными элементов входящего УКД НомСредИдентТовДо\НомСредИдентТовПосле
// Параметры:
// 	МассивМаркировкаУКД - Массив - данные на основе элементов входящего УКД НомСредИдентТовДо\НомСредИдентТовПосле
// 	ИмяЭлементаXML      - Строка - имя элемента входящего XML присвоенное модулем при разборе файла,  
// 								   в котором расположены элементы НомСредИдентТов, например - "Документ_ТаблКСчФ_СведТов_НомСредИдентТов"
//	Состояние			- Строка - допустимые значения "До" и "После", указывают на то какой именно элемент обрабатывается (НомСредИдентТовДо\НомСредИдентТовПосле)
//	ДанныеПоМаркировке 	- Массив - приемник обработанных данных, результата работы процедуры
//	НомерСтрокиXML		- Строка - информация из входящего XML
//	ОписаниеПродукта	- Строка - информация из входящего XML
Процедура ЗаполнитьДанныеПоМаркировкеИзДокумена(МассивМаркировкаУКД, ИмяЭлементаXML, Состояние, ДанныеПоМаркировке, НомерСтрокиXML, ОписаниеПродукта)
	Если Не Состояние = "До" И Не Состояние = "После" Тогда
		Возврат;
	КонецЕсли;
	
	// выполняется обход массива входящих данных о кодах маркировки:
	// осуществляется проверка - является ли код транспортной упаковкой, групповой упаковкой или КИЗ
	// в зависимости от результата проверки осуществляется запись соответствующего ключа структуры Данные \ НовДанные
	Для Каждого Элемент Из МассивМаркировкаУКД Цикл
		Данные = СтруктураДанныхПоМаркировке();				
		Данные.НомерСтрокиXML   = НомерСтрокиXML;
		Данные.ОписаниеПродукта = ОписаниеПродукта;
		
		Если Элемент.Свойство(ИмяЭлементаXML + Состояние + "_ИдентТрансУпак") Тогда
			НовДанные = СтруктураДанныхПоМаркировке();
			НовДанные.НомерСтрокиXML    = НомерСтрокиXML;
			НовДанные.ОписаниеПродукта  = ОписаниеПродукта;
			НовДанные["ИдентТрансУпак_" + Состояние] = Элемент[ИмяЭлементаXML + Состояние + "_ИдентТрансУпак"]; 
			
			ДанныеПоМаркировке.Добавить(НовДанные);	
		КонецЕсли;
		
		// искомые элементы НомУпак\КИЗ могут быть представлены как элементом структуры так и массивом
		// осуществляется соответствующая проверка
		Если Элемент.Свойство(ИмяЭлементаXML + Состояние + "_НомУпак") Тогда
			Данные["НомУпак_" + Состояние] = Элемент[ИмяЭлементаXML +  Состояние + "_НомУпак"];
		ИначеЕсли  Элемент.Свойство(ИмяЭлементаXML + Состояние + "_НомУпак_") Тогда
			Для Каждого НомУпак Из Элемент[ИмяЭлементаXML +  Состояние + "_НомУпак_"] Цикл
				НовДанные = СтруктураДанныхПоМаркировке();
				НовДанные.НомерСтрокиXML    	  = НомерСтрокиXML;
				НовДанные.ОписаниеПродукта 		  = ОписаниеПродукта;
				НовДанные["НомУпак_" + Состояние] = НомУпак; 
				
				ДанныеПоМаркировке.Добавить(НовДанные);	
			КонецЦикла;
			Продолжить;
		ИначеЕсли Элемент.Свойство(ИмяЭлементаXML +  Состояние + "_КИЗ") Тогда
			Данные["КИЗ_" + Состояние] = Элемент[ИмяЭлементаXML +  Состояние + "_КИЗ"];
		ИначеЕсли  Элемент.Свойство(ИмяЭлементаXML + Состояние + "_КИЗ_") Тогда
			Для Каждого КИЗ Из Элемент[ИмяЭлементаXML +  Состояние + "_КИЗ_"] Цикл
				НовДанные = СтруктураДанныхПоМаркировке();
				НовДанные.НомерСтрокиXML      = НомерСтрокиXML;
				НовДанные.ОписаниеПродукта    = ОписаниеПродукта;
				НовДанные["КИЗ_" + Состояние] = КИЗ; 
				
				ДанныеПоМаркировке.Добавить(НовДанные);	
			КонецЦикла;
			Продолжить;
		Иначе
			Продолжить;
		КонецЕсли;  
		
		ДанныеПоМаркировке.Добавить(Данные);	
	КонецЦикла;
КонецПроцедуры

// Получает Массив структур определенного элемента из структуры входящего XML документа 
Функция ПолучитьМассивИзВходящегоДокумента(ПолноеИмяЭлемента, СтрокаДокумента)
	Результат = Новый Массив;
	// Несколько строк
	Если СтрокаДокумента.Свойство(ПолноеИмяЭлемента+"_") Тогда
		Результат = СтрокаДокумента[ПолноеИмяЭлемента+"_"];
	КонецЕсли;
	
	// Одна строка
	Если СтрокаДокумента.Свойство(ПолноеИмяЭлемента) Тогда
		Результат = СтрокаДокумента[ПолноеИмяЭлемента];	
	КонецЕсли;
	
	Возврат Результат;	
КонецФункции

Функция СтруктураДанныхПоМаркировке()
	Данные = Новый Структура;
	Данные.Вставить("НомерСтрокиXML"      , "");
	Данные.Вставить("ОписаниеПродукта"    , "");
	Данные.Вставить("ИдентТрансУпак_До"   , "");
	Данные.Вставить("ИдентТрансУпак_После", "");						
	Данные.Вставить("КИЗ_До"              , "");
	Данные.Вставить("КИЗ_После"           , "");
	Данные.Вставить("НомУпак_До"          , "");
	Данные.Вставить("НомУпак_После"       , "");
	
	Возврат Данные;	
КонецФункции

