Функция ЭКОМ_GLN_Запись(п_Объект, п_Структура) Экспорт
	
	// Пример
	// п_Структура = Новый Структура;
	// п_Структура.Вставить("GLN",   1234567890);
	
	МенеджерЗаписи = РегистрыСведений.ЭКОМ_GLN.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Объект = п_Объект;	
	МенеджерЗаписи.Прочитать();
	
	Если НЕ МенеджерЗаписи.Выбран() Тогда // Если запись не существует то записать	
		МенеджерЗаписи.Объект = п_Объект;
	КонецЕсли;
	
	Для Каждого Элемент Из п_Структура Цикл
		МенеджерЗаписи[Элемент.Ключ] = Элемент.Значение; 	
	КонецЦикла;
	
	Результат = Неопределено;
	Попытка
		МенеджерЗаписи.Записать();
		Результат = Истина;
	Исключение
		Ошибка = ОписаниеОшибки();
		Результат = "Ошибка записи в [РегистрыСведений.ЭКОМ_GLN] " + Символы.ПС + Ошибка;
	КонецПопытки;
	
	Возврат Результат;
КонецФункции

Функция ЭКОМ_ТранспортнаяИнформация_РегСв_Прочитать(п_Документ) Экспорт 
	Структура = новый Структура;
	МенеджерЗаписи = РегистрыСведений.ЭКОМ_ТранспортнаяИнформация.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Документ = п_Документ;
	МенеджерЗаписи.Прочитать();
	
	Если МенеджерЗаписи.Выбран() Тогда	
		Структура.Вставить("СведенияЕсть", Истина);
		Для каждого Данные Из Метаданные.РегистрыСведений.ЭКОМ_ТранспортнаяИнформация.Ресурсы  Цикл
			Структура.Вставить(Данные.Имя, МенеджерЗаписи[Данные.Имя]);		
		КонецЦикла;
		Структура.Вставить("Документ"      , п_Документ);
	Иначе
		Структура.Вставить("СведенияЕсть", Ложь);
	КонецЕсли;
	
	Возврат Структура;
	
КонецФункции

Функция ЭКОМ_ТранспортнаяИнформация_РегСв_Записать(ДокументСсылка, СтруктураДанных, ЗаписыватьПустыеЗначения = Ложь) Экспорт 
	
	МЗ = РегистрыСведений.ЭКОМ_ТранспортнаяИнформация.СоздатьМенеджерЗаписи();
	МЗ.Документ  = ДокументСсылка;
	МЗ.Прочитать();
	
	Если НЕ МЗ.Выбран() Тогда
		МЗ.Документ  = ДокументСсылка;
	КонецЕсли;
	
	Для Каждого Элемент Из СтруктураДанных Цикл
		
		Если ЗаписыватьПустыеЗначения Тогда
			МЗ[Элемент.Ключ] = Элемент.Значение; 	
		Иначе
			Если ЗначениеЗаполнено(Элемент.Значение) Тогда
				МЗ[Элемент.Ключ] = Элемент.Значение; 	
			КонецЕсли;
		КонецЕсли;	
		
	КонецЦикла;
	
	МЗ.Записать();
	
КонецФункции

