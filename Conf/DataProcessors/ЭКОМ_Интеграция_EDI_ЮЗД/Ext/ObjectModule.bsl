	Выборка = РезультатЗапроса.Выбрать();
	
	ИмяСобытия = "Создание записи по квитанции DP_UVUTOCH_24";
	Пока Выборка.Следующий() Цикл
		
		ПредставлениеДокумента = СокрЛП(Выборка.ВидДокумента) + " с ИД = " + Выборка.ИдФайл + " для документа с ИД = " + Выборка.ИмяПостФайла;
		СтруктураДокумента = Неопределено;
		СтрокаТЗСтруктур = ТЗСтруктур.Найти(Выборка.ИдФайл, "ИдентификаторФайла");
		Если СтрокаТЗСтруктур = Неопределено Тогда		
			ТекстЛогаСобытий = "Не найдена структура документа - " + ПредставлениеДокумента;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Продолжить;
			
		Иначе		
			СтруктураДокумента = СтрокаТЗСтруктур.СтруктураДокумента;		
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Выборка.ДокСЧФ) Тогда	
			
			СтруктураДокумента.Вставить("Обработан"   , Ложь);
			СтруктураДокумента.Вставить("ТекстПричины", ""); // Текст причины не указываем, в итоговом сообщении укажем количество записанных квитанций в регистр ЭКОМ_Квитанции
			
			// Сохраняем в регистре ЭКОМ_Квитанции 
			МЗ = РегистрыСведений.ЭКОМ_Квитанции.СоздатьМенеджерЗаписи();
			МЗ.ВидДокумента  = СтруктураДокумента.ВидДокумента;
			МЗ.Идентификатор = СтруктураДокумента.ИдФайл;
			МЗ.Прочитать();
			
			Если НЕ МЗ.Выбран() Тогда
				МЗ.ВидДокумента  = СтруктураДокумента.ВидДокумента;
				МЗ.Идентификатор = СтруктураДокумента.ИдФайл;
			КонецЕсли;
			
			МЗ.ИдентификаторОснования = Выборка.ИмяПостФайла;		
			МЗ.СтруктураФайла = Новый ХранилищеЗначения(СтруктураДокумента, Новый СжатиеДанных(9));
			МЗ.ЭЦП            = СтрокаТЗСтруктур.ЭЦП;
			МЗ.ДатаЗаписи     = ТекущаяДата();
			МЗ.Записать();
			
			// Для архивирования добавляем в массив
			НеНайденныеКвитанции.Добавить(СтрокаТЗСтруктур.ИмяФайлаXML);
			НеНайденныеКвитанции.Добавить(СтрокаТЗСтруктур.ИмяФайлаПодписи);
			
		Иначе
			
			СтруктураДокумента.Вставить("Обработан", Истина);
			
			СтруктураРегистраСобытий = Новый Структура;
			СтруктураРегистраСобытий.Вставить("ЗаказДата"        , Выборка.ЗаказДата);
			СтруктураРегистраСобытий.Вставить("ЗаказНомер"       , Выборка.ЗаказНомер);
			СтруктураРегистраСобытий.Вставить("ДатаЗаписи"       , ТекущаяДата());
			СтруктураРегистраСобытий.Вставить("НаправлениеОбмена", Перечисления.ЭКОМ_НаправлениеОбмена.Входящий);
			СтруктураРегистраСобытий.Вставить("ФайлИмя"          , СтрокаТЗСтруктур.ИмяФайлаXML);
			СтруктураРегистраСобытий.Вставить("ЭЦП"              , СтрокаТЗСтруктур.ЭЦП);
			СтруктураРегистраСобытий.Вставить("Контрагент"       , Выборка.Контрагент);
			СтруктураРегистраСобытий.Вставить("Организация"      , Выборка.Организация);
			СтруктураРегистраСобытий.Вставить("Идентификатор"    , СтруктураДокумента.ИдФайл);
			СтруктураРегистраСобытий.Вставить("ИдентификаторИспр", Выборка.ИмяПостФайла);
			СтруктураРегистраСобытий.Вставить("СтруктураФайла"   , Новый ХранилищеЗначения(СтруктураДокумента, Новый СжатиеДанных(9)));	
			СтруктураРегистраСобытий.Вставить("Статус"           , Перечисления.ЭКОМ_Статусы.Загружен);
