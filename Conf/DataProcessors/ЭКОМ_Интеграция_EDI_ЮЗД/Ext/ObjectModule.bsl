Функция м_ADO_Получить_Контрагента_по_Грузополучателю( пADO_Строка_Подключения, п_ID, пТЗ_Данные ) Экспорт
	лСоединение = "";
	Если м_ADO_Подключить( пADO_Строка_Подключения, 5, 30, лСоединение ) <> 1 Тогда
		Сообщить( "Ошибка при подключении к ADO (121_1).", СтатусСообщения.Важное );
		Возврат 0;
	КонецЕсли;
	
	лТекст_Запроса = "SELECT
	|  _Exite_Spr_Tochki_Dostavki._ID,
	|  _Exite_Spr_Tochki_Dostavki.Kontragent,
	|  _Exite_Spr_Tochki_Dostavki.Adres,
	|  _Exite_Spr_Tochki_Dostavki.GLN,
	|  _Exite_Spr_Tochki_Dostavki.KPP_GRUZOPOLUCHATEL,
	|  _Exite_Spr_Tochki_Dostavki.NAME_GRUZOPOLUCHATEL,
	|  _Exite_Spr_Tochki_Dostavki.GRUZOPOLUCHATEL
	|
	|FROM
	|  _Exite_Spr_Tochki_Dostavki
	|WHERE
	|     _Exite_Spr_Tochki_Dostavki.GRUZOPOLUCHATEL = '" + п_ID + "'             
	|";
	
	лРекордСет = Неопределено;
	Если м_ADO_Запрос_Выполнить( лСоединение, лТекст_Запроса, лРекордСет ) <> 1 Тогда
		Сообщить( "Ошибка при выполнении запроса при поиске точек доставки (122_1).", СтатусСообщения.Важное );
		Возврат 0;
	КонецЕсли;
	
	лТЗ_Данные = "";
	Если м_ADO_RS_ТЗ( лРекордСет, лТЗ_Данные ) <> 1 Тогда
		Сообщить( "Ошибка при заполнении ТЗ при поиске точек доставки (123_1).", СтатусСообщения.Важное );
		Возврат 0;
	КонецЕсли;
	
	Если лТЗ_Данные.Количество() = 0 Тогда
		пТЗ_Точки_Доставки = лТЗ_Данные;
		Возврат 0;
	КонецЕсли;
	
	лТЗ_Структура_Соответствий = "";
	Если м_Структура_Соответствий_Получить( "КОНТРАГЕНТЫ_ТОЧКИ_ДОСТАВКИ", лТЗ_Структура_Соответствий ) <> 1 Тогда
		Сообщить( "Ошибка при получении структуры соответствий при поиске точек доставки (124_1).", СтатусСообщения.Важное );
		Возврат 0;
	КонецЕсли;
	
	Если м_ADO_ТЗ_Данные_Значения_Реквизитов_1С_Присоединить( лТЗ_Данные, лТЗ_Структура_Соответствий ) <> 1 Тогда
		Сообщить( "Ошибка при присоединении данных 1С при поиске точек доставки (125_1).", СтатусСообщения.Важное );
		Возврат 0;
	КонецЕсли;
	
	Если м_ADO_Отключить( лСоединение ) <> 1 Тогда
		Сообщить( "Ошибка при отключении ADO (126_1).", СтатусСообщения.Важное );
		Возврат 0;
	КонецЕсли;
	
	пТЗ_Данные = лТЗ_Данные;
	
	Возврат 1;
КонецФункции

Функция ДокументЗаполнитьПоУмолчанию(пДок) Экспорт
	
	МетаданныеДокумента          = пДок.Метаданные();	
	
	Пользователь = НайтиТекущегоПользователя();
	
	Если мЕсть_Реквизит( МетаданныеДокумента, "ДоговорКонтрагента" ) = 1 Тогда
		Если НЕ ЗначениеЗаполнено(пДок.ДоговорКонтрагента) Тогда
			ДоговорСсылка = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
			Если ЗначениеЗаполнено(пДок.Контрагент.ОсновнойДоговорКонтрагента) Тогда
				ДоговорСсылка = пДок.Контрагент.ОсновнойДоговорКонтрагента;
			Иначе	
				Выборка = Справочники.ДоговорыКонтрагентов.Выбрать(,пДок.Контрагент,,);
				Пока Выборка.Следующий() Цикл
					Если Выборка.ВидДоговора <> Перечисления.ВидыДоговоровКонтрагентов.Прочее Тогда
						ДоговорСсылка = Выборка.Ссылка;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;	
			пДок.ДоговорКонтрагента = ДоговорСсылка;
		КонецЕсли;
	КонецЕсли;	
	
	Если мЕсть_Реквизит(МетаданныеДокумента, "ВалютаДокумента" ) = 1 Тогда
		Если ЗначениеЗаполнено( пДок.ДоговорКонтрагента ) Тогда
			// Валюта документа
			пДок.ВалютаДокумента = пДок.ДоговорКонтрагента.ВалютаВзаиморасчетов;
			// Тип цен
			Если ЗначениеЗаполнено(пДок.ДоговорКонтрагента.ТипЦен) Тогда
				пДок.ТипЦен = пДок.ДоговорКонтрагента.ТипЦен;
			Иначе
				пДок.ТипЦен = Неопределено;
			КонецЕсли;
		Иначе
			пДок.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(пДок) = Тип("ДокументОбъект.ПоступлениеТоваровУслуг") Тогда
		_ТипОперации = "Покупка";
	Иначе
		_ТипОперации = "Продажа";
	КонецЕсли;
	
	Выполнить("ЗаполнениеДокументов.ЗаполнитьШапкуДокумента(пДок, Пользователь, Константы.ВалютаРегламентированногоУчета.Получить(), _ТипОперации);");
	
	Если мЕсть_Реквизит( МетаданныеДокумента, "СпособЗачетаАвансов" ) = 1 Тогда
		Если Не ЗначениеЗаполнено( пДок.СпособЗачетаАвансов ) Тогда
			Попытка
				пДок.СпособЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.Автоматически;
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	Попытка
		пДок.ЗаполнитьСчетаУчетаРасчетов();		
	Исключение
	КонецПопытки;
	
	Если мЕсть_Реквизит(МетаданныеДокумента, "ТипЦен" ) = 1 Тогда	
		Если Не ЗначениеЗаполнено( пДок.ТипЦен ) Тогда
			Попытка
				пДок.ТипЦен = Вычислить("УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(Пользователь, ""ОсновнойТипЦенПродажи"")");		
			Исключение
			КонецПопытки;	
		КонецЕсли;
	КонецЕсли;
	
	Если мЕсть_Реквизит(МетаданныеДокумента, "ОтражатьВУправленческомУчете") = 1 Тогда
		Попытка
			Если Не ЗначениеЗаполнено( пДок.ОтражатьВУправленческомУчете ) Тогда
				пДок.ОтражатьВУправленческомУчете = Вычислить("УправлениеПользователями.ПолучитьЗначениеПоУмолчанию( Пользователь, ""ОтражатьДокументыВУправленческомУчете"")");
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Если мЕсть_Реквизит( МетаданныеДокумента, "ВалютаДокумента" ) = 1 Тогда
		Если Не ЗначениеЗаполнено( пДок.ВалютаДокумента ) Тогда
			пДок.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();	
		КонецЕсли;
	КонецЕсли;
	
	Если мЕсть_Реквизит(МетаданныеДокумента, "КурсВзаиморасчетов" ) = 1 И мЕсть_Реквизит( МетаданныеДокумента, "КратностьВзаиморасчетов" ) = 1 И мЕсть_Реквизит( МетаданныеДокумента, "ВалютаДокумента" ) = 1 Тогда
		лСтруктура_Курса = Вычислить("МодульВалютногоУчета.ПолучитьКурсВалюты( пДок.ВалютаДокумента, пДок.Дата)");
		пДок.КурсВзаиморасчетов      = лСтруктура_Курса.Курс;
		пДок.КратностьВзаиморасчетов = лСтруктура_Курса.Кратность;		
	КонецЕсли;
	
	Если мЕсть_Реквизит( МетаданныеДокумента, "Склад" ) Тогда
		Если Не ЗначениеЗаполнено(пДок.Склад) Тогда
			пДок.Склад = Вычислить("УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(Пользователь, ""ОсновнойСклад"")");
		КонецЕсли;
	КонецЕсли;
	
	Если мЕсть_Реквизит( МетаданныеДокумента, "СкладГруппа" ) Тогда
		Если Не ЗначениеЗаполнено( пДок.СкладГруппа ) Тогда
			пДок.СкладГруппа = Вычислить("УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(Пользователь, ""ОсновнойСклад"")");
		КонецЕсли;
	КонецЕсли;
	
	Если мЕсть_Реквизит( МетаданныеДокумента, "СкладОрдер" ) Тогда
		Если Не ЗначениеЗаполнено( пДок.СкладОрдер ) Тогда
			пДок.СкладОрдер = Вычислить("УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(Пользователь, ""ОсновнойСклад"")");
		КонецЕсли;
	КонецЕсли;
	
	Если мЕсть_Реквизит( МетаданныеДокумента, "Ответственный" ) = 1 Тогда
		Если Не ЗначениеЗаполнено( пДок.Ответственный ) Тогда
			пДок.Ответственный = Вычислить("УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(Пользователь, ""ОсновнойОтветственный"")");	
		КонецЕсли;
	КонецЕсли;
	
	Если мЕсть_Реквизит( МетаданныеДокумента, "Подразделение" ) = 1 Тогда
		Если Не ЗначениеЗаполнено( пДок.Подразделение ) Тогда
			пДок.Подразделение = Вычислить("УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(Пользователь, ""ОсновноеПодразделение"")");		
		КонецЕсли;
	КонецЕсли;
	
	Если мЕсть_Реквизит( МетаданныеДокумента, "СтруктурнаяЕдиница" ) = 1 Тогда
		Если НЕ ЗначениеЗаполнено(пДок.СтруктурнаяЕдиница) Тогда
			пДок.СтруктурнаяЕдиница = пДок.Организация.ОсновнойБанковскийСчет;
		ИначеЕсли пДок.СтруктурнаяЕдиница.Владелец <> пДок.Организация Тогда
			пДок.СтруктурнаяЕдиница = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Если мЕсть_Реквизит( МетаданныеДокумента, "БанковскийСчетОрганизации" ) = 1 Тогда
		Если НЕ ЗначениеЗаполнено(пДок.БанковскийСчетОрганизации) Тогда
			пДок.БанковскийСчетОрганизации = пДок.Организация.ОсновнойБанковскийСчет;
		ИначеЕсли пДок.БанковскийСчетОрганизации.Владелец <> пДок.Организация Тогда
			пДок.БанковскийСчетОрганизации = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Возврат 1;
	
КонецФункции

Функция ДокументЗаполнитьТабЧастьПоУмолчанию( пДок , пДокТоварыСтрока) Экспорт 
	
	МетаданныеДокумента = пДок.Метаданные();
	
	//ТЧ Товары 
	Если мЕсть_Реквизит( МетаданныеДокумента, "ЕдиницаИзмеренияМест", "Товары" ) = 1 И мЕсть_Реквизит( МетаданныеДокумента, "КоличествоМест", "Товары" ) = 1 Тогда
		Если Не ЗначениеЗаполнено( пДокТоварыСтрока.ЕдиницаИзмеренияМест ) Тогда
			лЕдМест = пДокТоварыСтрока.Номенклатура.ЕдиницаИзмеренияМест;
			Если ЗначениеЗаполнено( лЕдМест ) Тогда
				пДокТоварыСтрока.ЕдиницаИзмеренияМест = лЕдМест;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено( пДокТоварыСтрока.ЕдиницаИзмеренияМест ) Тогда
			Если Не ЗначениеЗаполнено( пДокТоварыСтрока.КоличествоМест ) Тогда
				Выполнить("ОбработкаТабличныхЧастей.РассчитатьКоличествоМестТабЧасти(пДокТоварыСтрока, пДок);");	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	////++++нач++++++++++++++++++++++++++++
	//конф УТ
	Если мЕсть_Реквизит( МетаданныеДокумента, "СпособСписанияОстаткаТоваров", "Товары" ) = 1 Тогда
		Если НЕ ЗначениеЗаполнено( пДокТоварыСтрока.СпособСписанияОстаткаТоваров ) Тогда
			Попытка
				Выполнить("ОбработкаТабличныхЧастей.ЗаполнитьСпособСписанияОстаткаТоваровТабЧасти(пДокТоварыСтрока, пДок);");
			Исключение
			КонецПопытки;			
		КонецЕсли;
	КонецЕсли;
	
	Если мЕсть_Реквизит( МетаданныеДокумента, "ЗаказПокупателя", "Товары" ) = 1 Тогда
		Если НЕ ЗначениеЗаполнено(пДокТоварыСтрока.ЗаказПокупателя)
			И ТипЗнч(пДок.Сделка) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
			пДокТоварыСтрока.ЗаказПокупателя = пДок.Сделка;
		КонецЕсли;
	КонецЕсли;
	
	Попытка
		Выполнить("ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(пДокТоварыСтрока, пДок);");
		Выполнить("ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(пДокТоварыСтрока, пДок);");
	Исключение	
	КонецПопытки;
	
	Возврат 1;
	
КонецФункции

Функция ЭКОМ_ПреобразоватьВЧисло(ЧислоСтрока) Экспорт
	
	Если ТипЗнч(ЧислоСтрока) = Тип("Число") Тогда
		Возврат ЧислоСтрока;
	КонецЕсли;
	
	ЧислоСтрокаПреобразование = СокрЛП(Строка(ЧислоСтрока));
	ЧислоСтрокаПреобразование = СтрЗаменить(ЧислоСтрокаПреобразование, " ", "");
	ЧислоСтрокаПреобразование = СтрЗаменить(ЧислоСтрокаПреобразование, Символы.НПП, "");
	
	НомерРазделителяДробнойЧасти = 0;    
	ЧислоСтрокаРезультат         = "";
	КоличествоСимволов           = СтрДлина(ЧислоСтрокаПреобразование);
	Для НомерСимвола = 1 По КоличествоСимволов Цикл
		
		// 0 в кодировке Unicode это 48
		// 9 в кодировке Unicode это 57
		СимволЧисла = Сред(ЧислоСтрокаПреобразование, НомерСимвола, 1);
		Если (КодСимвола(СимволЧисла) >= 48) 
			И (КодСимвола(СимволЧисла) <= 57) Тогда
			ЧислоСтрокаРезультат = ЧислоСтрокаРезультат + СимволЧисла;
			
		ИначеЕсли (НомерСимвола = 1) 
			И ((СимволЧисла = "-") 
			ИЛИ (СимволЧисла = "+" )) Тогда
			ЧислоСтрокаРезультат = ЧислоСтрокаРезультат + СимволЧисла;
			
		ИначеЕсли (СимволЧисла = ",") 
			ИЛИ (СимволЧисла = ".") Тогда
			НомерРазделителяДробнойЧасти = НомерРазделителяДробнойЧасти + 1;
			
			Если НомерРазделителяДробнойЧасти > 1 Тогда
				Прервать;
			КонецЕсли;
			ЧислоСтрокаРезультат = ЧислоСтрокаРезультат + ".";
			
		Иначе
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	ЧислоРезультат = 0;
	
	Если НЕ ЧислоСтрокаРезультат = "" Тогда	
		ЧислоРезультат = Число(ЧислоСтрокаРезультат);
	КонецЕсли;
	
	Возврат ЧислоРезультат;
	
КонецФункции

Функция ЗаменитьСимволы(ТекНомер)
	ТекНомер = СокрЛП(ТекНомер);
	Для Инд=1 По СтрДлина(ТекНомер) Цикл
		Если КодСимвола(Сред(ТекНомер,Инд,1))>126 Тогда
			ТекНомер=СтрЗаменить(ТекНомер,Сред(ТекНомер,Инд,1),Символ(32));
		КонецЕсли;
	КонецЦикла;
	ТекНомер = СтрЗаменить(ТекНомер, "-", "");
	Возврат СокрЛП(ТекНомер);
КонецФункции

