Функция ОчиститьИБ_ОтДанныхЭКОМ_ЭКОМ_Документы(НачДатаОчистки, КонДатаОчистки, МассивЛогаСобытий) Экспорт
	
	ИмяСобытия = "Очистка Документов";
	ОчисткаУспешна = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|   док.Ссылка,
	|   док.ЗаказДата КАК Дата
	|ИЗ
	|   Документ.ЭКОМ_Документы КАК док
	|ГДЕ
	|   док.ЗаказДата МЕЖДУ &НачДатаОчистки И &КонДатаОчистки
	|";
	
	Запрос.УстановитьПараметр("НачДатаОчистки", НачалоДня(НачДатаОчистки));
	Запрос.УстановитьПараметр("КонДатаОчистки", КонецДня(КонДатаОчистки));
	
