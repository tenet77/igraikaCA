Процедура ДобавитьЗаписьВМассивЛога(МассивЛогаСобытий, ТекстЛогаСобытий, УровеньЛогирования, ИмяСобытия) Экспорт
	ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, УровеньЛогирования, ИмяСобытия);
	МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
КонецПроцедуры

Функция ФормированиеМикспалетыЗапрещено(Контрагент, ЭКОМ_Документ_ORDER) Экспорт
	
	СтруктураРезультат = Новый Структура;
	СтруктураРезультат.Вставить("Тандер", Ложь);
	СтруктураРезультат.Вставить("ФормированиеЗапрещено", Ложь);
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат СтруктураРезультат;
	КонецЕсли;
	
	СведенияОКонтрагенте = ЭКОМ_GLN_Прочитать(Контрагент);
	Если Не СведенияОКонтрагенте.СведенияЕсть Тогда
		Возврат СтруктураРезультат;
	КонецЕсли;
	
	ФорматУПД = СведенияОКонтрагенте.Контрагент_ФорматЭСФ;
	Если Не ФорматУПД = "УПД Тандер" Тогда
		Возврат СтруктураРезультат;
	КонецЕсли;
	
	ЗапретитьФормированиеМиксПалет = Настройка_Параметр_Прочитать("ЭКОМ_ЗапретитьФормированиеМиксПалетТандер", Ложь);
	СтруктураРезультат.Тандер = Истина;
	СтруктураРезультат.ФормированиеЗапрещено = ЗапретитьФормированиеМиксПалет;
	Если Не ЗапретитьФормированиеМиксПалет Тогда
		Возврат СтруктураРезультат;
	КонецЕсли;
		
	Если Не ЗначениеЗаполнено(ЭКОМ_Документ_ORDER) Тогда
		Возврат СтруктураРезультат;
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.ЭКОМ_Объекты_События.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Документ_Основание = ЭКОМ_Документ_ORDER;
	МенеджерЗаписи.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ORDER_Входящий;
	МенеджерЗаписи.Прочитать();
	
	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат СтруктураРезультат;
	КонецЕсли;
	
	СтруктураФайлаИзХранилища = МенеджерЗаписи.СтруктураФайла.Получить();
	Если СтруктураФайлаИзХранилища = Неопределено Тогда
		Возврат СтруктураРезультат;
	КонецЕсли;
	
	Для Каждого ЭлементСтруктуры Из СтруктураФайлаИзХранилища Цикл
		Если ЭлементСтруктуры.Ключ = "MIXPALLET" Тогда
			Если ЭлементСтруктуры.Значение = "1" Тогда
				СтруктураРезультат.ФормированиеЗапрещено = Ложь;
				Возврат СтруктураРезультат;
			КонецЕсли;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтруктураРезультат;
	
КонецФункции

Процедура ОтметитьДокументОбработанным(СтруктураДокумента, ИмяФайлаXML, Контрагент, Организация, ЗаказДата, ЗаказНомер, ДокументСсылка)
	
	СтруктураРегистраСобытий = Новый Структура; 
	СтруктураРегистраСобытий.Вставить("ДатаЗаписи"                  , ТекущаяДата());
	СтруктураРегистраСобытий.Вставить("Контрагент"                  , Контрагент);
	СтруктураРегистраСобытий.Вставить("Организация"                 , Организация);
	СтруктураРегистраСобытий.Вставить("НаправлениеОбмена"           , Перечисления.ЭКОМ_НаправлениеОбмена.Входящий);
	СтруктураРегистраСобытий.Вставить("ФайлИмя"                     , ИмяФайлаXML);
	СтруктураРегистраСобытий.Вставить("ЗаказДата"                   , ЗаказДата);					
	СтруктураРегистраСобытий.Вставить("ЗаказНомер"                  , ЗаказНомер);
	СтруктураРегистраСобытий.Вставить("СтруктураФайла"              , Новый ХранилищеЗначения(СтруктураДокумента,  Новый СжатиеДанных(9)));
	СтруктураРегистраСобытий.Вставить("Идентификатор"               , СтруктураДокумента.ИдФайл);
	СтруктураРегистраСобытий.Вставить("Статус"						, Перечисления.ЭКОМ_Статусы.Обработан);
	
	ЭКОМ_Объекты_События_Записать(ДокументСсылка ,  СтруктураДокумента.ВидДокумента, СтруктураРегистраСобытий, Истина);
	
КонецПроцедуры

//Docrobot 1.21.1 MOD-2127 [Подпись Казахстан. UUID генерируемый платформой 1С не принимается на платформе docrobot.kz. Пишем свою генерацию]
// Функция генерирует UUID по варианту 1 (на основании MAC-адреса и текущего времени)
//
// Параметры:
//  МеткаВремени  - Дата - время UTC
//  АдресСетевойКарты  - Строка - MAC-адрес сетевой карты формата "XX:XX:XX:XX:XX:XX"
//
// Возвращаемое значение:
//   Строка   - уникальный идентификатор в формате "XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"
Функция _СгенерироватьUUIDv1(МеткаВремени, АдресСетевойКарты) Экспорт
			
	//Генерируем случайное 14-битное число для временной последовательности, значение 16383 является максимальным беззнаковым 14-битным десятичным числом. 
	//Так как рассматриваем упрощенный алгоритм, то при каждой генерации нового уникального идентификатора будем генерировать случайное число для временной последовательности.
	ГЧ = Новый ГенераторСлучайныхЧисел;
	СлучайноеЧисло = ГЧ.СлучайноеЧисло(0, 16383);
	
	//Время должно быть 60-битовым значением, отсчитываем в 100 наносекундных интервалах всемирного скоординированного времени (UTC), начиная от полуночи 15 октября 1582 года 
	//(дата григорианской реформы христианского календаря). Внимание, так как время отсчитываем в 100 наносекундных интервалах UTC, то переменная МеткаВремени должна содержать время UTC.
	
	ДатаГригорианскойРеформы = Дата("15821015");
	РазностьДатВСек = МеткаВремени - ДатаГригорианскойРеформы;
	НаносекундныхИнтервалов = РазностьДатВСек * 1000 * 10000;
	
	//Помещаем время, отсчитанное в 100 наносекундных интервалах, в буфер двоичных данных. В байте, который находится в нулевой позиции буфера для бита под номером 4 
	//устанавливаем значение Истина (1), тем самым указываем версию алгоритма.
	
	БДДН = Новый БуферДвоичныхДанных(8, ПорядокБайтов.BigEndian);
	БДДН.ЗаписатьЦелое64(0, НаносекундныхИнтервалов);
	//БДДН.Установить(0, УстановитьБит(БДДН[0], 4, Истина));
	Выполнить("БДДН.Установить(0, УстановитьБит(БДДН[0], 4, Истина));");
	
	//Помещаем случайное 14-битное число в буфер двоичных данных. В байте, который находится в нулевой позиции буфера для бита под номером 7 устанавливаем значение Истина (1), 
	//так требует алгоритм.
	
	БДДС = Новый БуферДвоичныхДанных(2, ПорядокБайтов.BigEndian);    
	БДДС.ЗаписатьЦелое16(0, СлучайноеЧисло);
	//БДДС.Установить(0, УстановитьБит(БДДС[0], 7, Истина));
	Выполнить("БДДС.Установить(0, УстановитьБит(БДДС[0], 7, Истина));");
	
	//Получаем HEX-строки для полей уникального идентификатора: TimeLow, TimeMid, VersionAndTimeHigh, VariantAndClockSeqHigh, ClockSeqLow.
	
	TimeLow             = ПолучитьHexСтрокуИзБуфераДвоичныхДанных(БДДН.ПолучитьСрез(4));
	TimeMid             = ПолучитьHexСтрокуИзБуфераДвоичныхДанных(БДДН.ПолучитьСрез(2, 2));
	VersionAndTimeHigh  = ПолучитьHexСтрокуИзБуфераДвоичныхДанных(БДДН.ПолучитьСрез(0, 2));
	
	VariantAndClockSeqHigh = ПолучитьHexСтрокуИзБуфераДвоичныхДанных(БДДС.ПолучитьСрез(0, 1));
	ClockSeqLow            = ПолучитьHexСтрокуИзБуфераДвоичныхДанных(БДДС.ПолучитьСрез(1));
	
	Node = СтрЗаменить(АдресСетевойКарты, ":", "");
	
	Возврат НРег(TimeLow + "" + TimeMid + "" + VersionAndTimeHigh + "" + VariantAndClockSeqHigh + ClockSeqLow + "" + Node);
	
КонецФункции

//Старый алгоритм не поддерживается на совместимости ниже 8.3.11, используем альтернативный
Функция СгенерироватьUUIDv1() Экспорт
	
	НовыйДок = Документы.ЭКОМ_Документы.СоздатьДокумент(); 
	НовыйДок.Дата = ТекущаяДата();	
	НовыйДок.Записать();
	
	UUID1 = НовыйДок.Ссылка.УникальныйИдентификатор();  
	НовыйДок.Удалить();
	UUID1 = СтрЗаменить(UUID1,"-","");
	Возврат UUID1;
	
КонецФункции

Функция ПодключитьВнешнююКомпонентуRPCRT4(МассивЛогаСобытий) экспорт
	
	ИмяСобытия = "Объект внешней компоненты";
	ОбъектКомпоненты = Неопределено;
	Если ПодключитьВнешнююКомпоненту("Документ.ЭКОМ_Документы.Макет.ГенераторUUIDv1", "rpcrt4", ТипВнешнейКомпоненты.Native) Тогда
        Попытка
            ОбъектКомпоненты = Новый("AddIn.rpcrt4.XMLDSignAddIn");
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
            ТекстЛогаСобытий = "Не удалось подключить внешнюю компоненту XMLDSig.";
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, "Ошибка", ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
        КонецПопытки;        
    КонецЕсли;
	
	Если ОбъектКомпоненты = Неопределено Тогда ;
		ТекстЛогаСобытий = "Оператор Новый вернул Неопределено";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, "Ошибка", ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
	Иначе
		ОбъектКомпоненты.ПутьККриптопровайдеру = "";
	КонецЕсли;
	    
    Возврат ОбъектКомпоненты;	
	
КонецФункции