// Функция выполняет код, указанный в колонке Данные и заполняет результатом колонку ДанныеЗначения
//
// Параметры:
//  xstocuav9a  - ДеревоЗначений - шаблон документа (Дерево)
//  МассивДокументов  - Массив - коллекция отправляемых документов (Документ)
//  xjq6vt118r  - Строка - номер исправления УПД с формы (НомерИсправления)
//
// sksa17twrs = Строка
// x9b4sfry2s = Результат
// kpbnmbyjuh = Код
//
Процедура ПолучитьДанныеДокументов(Шаблон_xstocuav9a, Источник, НомерИсправления_xjq6vt118r, МассивЛогаСобытий, Ошибка)
	
	ИмяСобытия = "Получение данных документов";
	Если Ошибка = Неопределено Тогда
		Ошибка = ПолучитьСтруктуруОшибки();
	КонецЕсли;
	
	Для Каждого Строка_sksa17twrs Из Шаблон_xstocuav9a.Строки Цикл
		
		Если Строка_sksa17twrs.Использовать = Истина И НЕ Строка_sksa17twrs.Строки.Количество() = 0 Тогда // Может быть код для выполнения
			
			Если ЗначениеЗаполнено(Строка_sksa17twrs.Данные) 
				И Найти(Строка_sksa17twrs.Данные, "Возврат") > 0 Тогда // Есть код для выполнения и есть возврат
				
				Возврат_x9b4sfry2s = Неопределено;
				kpbnmbyjuh = ?(ЗначениеЗаполнено(НомерИсправления_xjq6vt118r), 
				"НомерИсправления = " + НомерИсправления_xjq6vt118r + ";" + Символы.ПС + Строка_sksa17twrs.Данные,
				"НомерИсправления = """";" + Символы.ПС + Строка_sksa17twrs.Данные);  ;
				kpbnmbyjuh = СтрЗаменить(kpbnmbyjuh, "¶" 			          , Символы.ПС);
				kpbnmbyjuh = СтрЗаменить(kpbnmbyjuh, "Возврат "               , "Возврат_x9b4sfry2s = ");
				
				ЛогСобытий = ""; // Используется в гибких
				Отказ = Ложь;
				Попытка
					Выполнить(kpbnmbyjuh);
					Если НЕ ТипЗнч(Возврат_x9b4sfry2s) = Тип("ТаблицаЗначений") Тогда 						
						ТекстЛогаСобытий = "Критическая ошибка таблица значений не сформирована. Обработка документов остановлена.";			
						ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
						МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

						Ошибка.ЕстьОшибка  = Истина;
						Ошибка.ТекстОшибки = ТекстЛогаСобытий;
						
						Возврат;
						
					КонецЕсли;
					Строка_sksa17twrs.ДанныеЗначения = Возврат_x9b4sfry2s.Скопировать();
					Если ЗначениеЗаполнено(ЛогСобытий) Тогда
						ТекстЛогаСобытий = ЛогСобытий; 
						ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Информация, ИмяСобытия);
						МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

					КонецЕсли;
					
					Если Отказ = Истина Тогда 						
						ТекстЛогаСобытий = "Отказ обработки документов, обработка документов остановлена.";			
						ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
						МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
						
						Ошибка.ЕстьОшибка  = Истина;
						Ошибка.ТекстОшибки = ТекстЛогаСобытий;

						Возврат;
						
					КонецЕсли;
										
				Исключение	
					Ошибка.ЕстьОшибка  = Истина;
					Ошибка.ТекстОшибки = ОписаниеОшибки();
					
					ТекстЛогаСобытий    = "Критическая ошибка. Обработка документов остановлена. Ошибка выполнения кода из шаблона документа.";
					ТекстЛогаСобытий 	= ТекстЛогаСобытий + Символы.ПС + Ошибка.ТекстОшибки + Символы.ПС + ОписаниеСтрокиГибкихНастроек(Строка_sksa17twrs);
					ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
					МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
									
					Возврат;
					
				КонецПопытки;
				
			КонецЕсли;
			
			ПолучитьДанныеДокументов(Строка_sksa17twrs, Источник, НомерИсправления_xjq6vt118r, МассивЛогаСобытий, Ошибка);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // ПолучитьДанныеДокуменов()

// Функция сверяет значения двух версий. Все разряды версий сверяются по ASCII кодам (доступны любые символы в версиях).
//
// Параметры:
//  Версия1	- Строка - первое значение
//  Версия2	- Строка - второе значение
//
// Возвращаемое значение:
//   Строка	- значение старшей версии
//
Функция СверитьВерсии(Версия1, Версия2) Экспорт
	
	Верс1Массив = Эком_РазложитьСтрокуВМассивПодстрок(Версия1, ".");
	Верс2Массив = Эком_РазложитьСтрокуВМассивПодстрок(Версия2, ".");
	
	// Находим минимальный индекс версии.
	МаксИндексВ = ?(Верс1Массив.ВГраница() > Верс2Массив.ВГраница(), Верс1Массив.ВГраница(), Верс2Массив.ВГраница());
	
	Для Счетчик = 0 По МаксИндексВ Цикл
		
		// Если длина одной из версий меньше текущего индекса и ранее не сработал 
		// возврат при сравнении посимвольно, считаем, что это меньшая версия.
		Если 		Верс1Массив.ВГраница() < Счетчик Тогда
			Возврат Версия2;
		ИначеЕсли 	Верс2Массив.ВГраница() < Счетчик Тогда
			Возврат Версия1;
		КонецЕсли;
		
		СимвВерс1 = ЭКОМ_ПреобразоватьВЧисло(Верс1Массив.Получить(Счетчик));
		СимвВерс2 = ЭКОМ_ПреобразоватьВЧисло(Верс2Массив.Получить(Счетчик));
		
		Если СимвВерс1 > СимвВерс2 Тогда
			Возврат Версия1;
		ИначеЕсли СимвВерс1 < СимвВерс2 Тогда
			Возврат Версия2;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Версия1; // Версии идентичны. Возвращаем значение Версия1
	
КонецФункции // СверитьВерсии()

Функция ЭтаОрганизацияФизЛицоИлиИП(Организация) Экспорт
	Перем Результат;
	
	СтруктураМетаДанных = ЮрФизЛицоОпределитьМетаданные();
	Если СтруктураМетаДанных.ПеречислениеЮрЛицо = Неопределено Тогда //в организации какой-то другой способ определения физ лиц чем мы поддерживаем
		Результат = "Для этой конфигурации определение физ. лица не поддерживается";
	Иначе
		Результат = ЮрФизЛицоОпределитьТипОбъекта(Организация, СтруктураМетаДанных.ИмяРеквизитаорганизации, СтруктураМетаДанных.ПеречислениеЮрЛицо);
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

// Функция определяет у организации/контрагента вариант регистрации.
//
// Параметры:
//  Объект	           - Организация или контрагент
//  ИмяРеквизита       - "ЮридическоеФизическоеЛицо"
//  ПеречислениеЮрЛицо - Перечисление юридическое лицо
//
//  Возвращаемое значение:
//    Булево	- истина если юр лицо и Ложь если физ лицо
//
Функция ЮрФизЛицоОпределитьТипОбъекта(Объект, ИмяРеквизита, ПеречислениеЮрФизЛицо) Экспорт 
	
	ЭтоЮрЛицо = Истина;
	
	Если НЕ ИмяРеквизита = Неопределено 
		И НЕ ПеречислениеЮрФизЛицо = Неопределено Тогда
		
		Если НЕ Объект[ИмяРеквизита] = ПеречислениеЮрФизЛицо Тогда
			ЭтоЮрЛицо = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ЭтоЮрЛицо;
	
КонецФункции 

// Функция определяет типы для определения вариантов регистрации организации/контрагента.
//
//  Возвращаемое значение:
//    СтруктураДанных	- Структура
//    ИмяРеквизитаорганизации
//    ИмяРеквизитаКонтрагента
//    ПеречислениеЮрЛицо
Функция ЮрФизЛицоОпределитьМетаданные() Экспорт
	
	ИмяТипаОрганизации = "Организации";  	
	РеквизитОрганизация = Метаданные.Документы.ЭКОМ_Документы.Реквизиты.Организация;
	ИмяТипаОрганизации  = СтрЗаменить(Метаданные.НайтиПоТипу(РеквизитОрганизация.Тип.Типы()[0]).ПолноеИмя(), "Справочник.", "");	
	
	МетаданныеОрганизацииЮридическоеФизическоеЛицо  = Метаданные.Справочники[ИмяТипаОрганизации].Реквизиты.Найти("ЮридическоеФизическоеЛицо"); 	
	МетаданныеОрганизацииЮрФизЛицо                  = Метаданные.Справочники[ИмяТипаОрганизации].Реквизиты.Найти("ЮрФизЛицо");
	Если НЕ МетаданныеОрганизацииЮридическоеФизическоеЛицо = Неопределено Тогда
		ИмяРеквизитаорганизации = "ЮридическоеФизическоеЛицо";
	ИначеЕсли НЕ МетаданныеОрганизацииЮрФизЛицо = Неопределено Тогда	
		ИмяРеквизитаорганизации = "ЮрФизЛицо";
	Иначе
		ИмяРеквизитаорганизации = Неопределено;	
	КонецЕсли; 
	
	ИмяТипаКонтрагент  = "Контрагенты";	
	РеквизитКонтрагент = Метаданные.Документы.ЭКОМ_Документы.Реквизиты.Контрагент;
	ИмяТипаКонтрагент  = СтрЗаменить(Метаданные.НайтиПоТипу(РеквизитКонтрагент.Тип.Типы()[0]).ПолноеИмя(), "Справочник.", "");	
	
	МетаданныеКонтрагентыЮридическоеФизическоеЛицо  = Метаданные.Справочники[ИмяТипаКонтрагент].Реквизиты.Найти("ЮридическоеФизическоеЛицо");
	МетаданныеКонтрагентыЮрФизЛицо                  = Метаданные.Справочники[ИмяТипаКонтрагент].Реквизиты.Найти("ЮрФизЛицо"); 
	Если НЕ МетаданныеКонтрагентыЮридическоеФизическоеЛицо = Неопределено Тогда
		ИмяРеквизитаКонтрагента = "ЮридическоеФизическоеЛицо";
	ИначеЕсли НЕ МетаданныеКонтрагентыЮрФизЛицо = Неопределено Тогда	
		ИмяРеквизитаКонтрагента = "ЮрФизЛицо";
	Иначе
		ИмяРеквизитаКонтрагента = Неопределено;	
	КонецЕсли; 
	
	МетаданныеПеречисленияЮридическоеФизическоеЛицо = Метаданные.Перечисления.Найти("ЮридическоеФизическоеЛицо");
	МетаданныеПеречисленияЮрФизЛицо                 = Метаданные.Перечисления.Найти("ЮрФизЛицо"); 
	Если НЕ МетаданныеПеречисленияЮридическоеФизическоеЛицо = Неопределено Тогда
		ПеречислениеЮрЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
	ИначеЕсли НЕ МетаданныеПеречисленияЮрФизЛицо = Неопределено Тогда	
		ПеречислениеЮрЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо;
	Иначе
		ПеречислениеЮрЛицо = Неопределено;
	КонецЕсли;
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ИмяРеквизитаорганизации", ИмяРеквизитаорганизации);
	СтруктураДанных.Вставить("ИмяРеквизитаКонтрагента", ИмяРеквизитаКонтрагента);
	СтруктураДанных.Вставить("ПеречислениеЮрЛицо"     , ПеречислениеЮрЛицо);
	
	Возврат СтруктураДанных;
	
КонецФункции // ЮрФизЛицоОпределитьМетаданные()

// Функция возвращает запрос для табличной части обновлений в настройках используется в формах ОФ и УФ
//
//  Возвращаемое значение:
//    Текст запроса	- текст
Функция ЗапросДляТаблицыОбновлений() Экспорт
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	ЭКОМ_ИсторияОбмена.Идентификатор КАК ВерсияМодуля,
	|	ЭКОМ_ИсторияОбмена.ДатаПолучения КАК ДатаОбработки,
	|	ЭКОМ_ИсторияОбмена.Комментарий КАК Описание,
	|	ВЫБОР
	|		КОГДА ЭКОМ_ИсторияОбмена.Причина = ""Установлена""
	|			ТОГДА ЭКОМ_ИсторияОбмена.ДатаЗаписи
	|		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
	|	КОНЕЦ КАК ДатаУстановки,
	|	ЭКОМ_ИсторияОбмена.Причина КАК СтатусОбработки
	|ИЗ
	|	РегистрСведений.ЭКОМ_ИсторияОбмена КАК ЭКОМ_ИсторияОбмена
	|ГДЕ
	|	(ЭКОМ_ИсторияОбмена.Причина = ""Установлена""
	|			ИЛИ ЭКОМ_ИсторияОбмена.Причина = ""Обработка получена с сервера""
	|			ИЛИ ЭКОМ_ИсторияОбмена.Причина = ""Требуется помощь программиста для обновления объектов конфигурации"")
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаОбработки УБЫВ";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ОписаниеЭкомДокумента(ЭКОМ_Документ, ВыводитьОрганизацию = Ложь, ВыводитьКонтрагента = Истина, ВыводитьТочкуДоставки = Истина) Экспорт
	Если НЕ ТипЗнч(ЭКОМ_Документ) = Тип("ДокументОбъект.ЭКОМ_Документы") Тогда
		Если НЕ ЗначениеЗаполнено(ЭКОМ_Документ) Тогда
			Возврат "";
		КонецЕсли;
	КонецЕсли;
	
	ДанныеЗаказа = ?(ЗначениеЗаполнено(ЭКОМ_Документ.ЗаказНомер), ", данные заказа: № [" + Строка(ЭКОМ_Документ.ЗаказНомер) + "] от " + Формат(ЭКОМ_Документ.ЗаказДата  , "ДЛФ=Д" + " "), "");
	ДанныеСчФ    = ?(ЗначениеЗаполнено(ЭКОМ_Документ.СЧФНомер)  , ", данные счет-фактуры: № [" + Строка(ЭКОМ_Документ.СЧФНомер) + "] от " + Формат(ЭКОМ_Документ.СЧФДата, "ДЛФ=Д" + " "), "");
	
	ДанныеИсправления = ?(ЗначениеЗаполнено(ЭКОМ_Документ.НомерИсправления), ЭКОМ_Документ.НомерИсправления   , "")
	+ ?(ЗначениеЗаполнено(ЭКОМ_Документ.ДатаИсправления) , ЭКОМ_Документ.ДатаИсправления    , "")
	;
	ДанныеИсправления = ?(ПустаяСтрока(ДанныеИсправления), "", ДанныеИсправления + " ");                    
	
	ДанныеОрганизации   = ?(ВыводитьОрганизацию   = Истина, ", организация: [" + ЭКОМ_Документ.Организация      + "]", "");
	ДанныеКонтрагента   = ?(ВыводитьКонтрагента   = Истина, ", контрагент: [" + ЭКОМ_Документ.Контрагент        + "]", "");
	ДанныеТочкиДоставки = ?(ВыводитьТочкуДоставки = Истина, ", точка доставки: [" + ЭКОМ_Документ.ТочкаДоставки + "]", "");
	
	ДанныеНакладной = ?(ЗначениеЗаполнено(ЭКОМ_Документ.НакладнаяНомер), " № ["  + ЭКОМ_Документ.НакладнаяНомер + "]", "")
	+ ?(ЗначениеЗаполнено(ЭКОМ_Документ.НакладнаяДата) , " от " + Формат(ЭКОМ_Документ.НакладнаяДата, "ДЛФ=Д"), "")
	;
	ДанныеНакладной = ?(ПустаяСтрока(ДанныеНакладной), "", ", накладная:" + ДанныеНакладной + " ");
	
	Результат = "[" + Строка(ЭКОМ_Документ) + "]"
	+ " вид документа: [" + Строка(ЭКОМ_Документ.ВидДокумента) + "]"
	
	+ ДанныеОрганизации
	+ ДанныеКонтрагента
	+ ДанныеТочкиДоставки
	
	+ ДанныеЗаказа 
	+ ДанныеНакладной
	+ ДанныеСчФ
	+ ДанныеИсправления
	;
	
	Возврат Результат;
КонецФункции 

Функция НайтиТекущегоПользователя() Экспорт
	
	Если ЗначениеЗаполнено(ТекущийПользователь) Тогда
		Возврат ТекущийПользователь;
	КонецЕсли;
	
	Если НЕ Метаданные.ПараметрыСеанса.Найти("ТекущийПользователь") = Неопределено Тогда
		Результат = ПараметрыСеанса.ТекущийПользователь;
	ИначеЕсли НЕ Метаданные.ПараметрыСеанса.Найти("ТекущийВнешнийПользователь") = Неопределено Тогда
		Результат = ПараметрыСеанса.ТекущийВнешнийПользователь;	 
	Иначе	
		Попытка
			Результат = Вычислить("глЗначениеПеременной(""глТекущийПользователь"")")
		Исключение
			Ошибка = ОписаниеОшибки();
			Результат = "ТекущийПользователь";
		КонецПопытки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

