						ИначеЕсли ТипДокумента = "DP_Статусы" Тогда					
							ЭТРН_ОбработатьСтатусы(ТЗСтруктур, ДокументыШапка, МассивЛогаСобытий, НеНайденныеКвитанции);
							
						ИначеЕсли ТипДокумента = "DP_PRANNUL_22" Тогда//Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _22]					
							СоздатьЗаписьDP_PRANNUL(ТЗСтруктур, ДокументыШапка, МассивЛогаСобытий, НеНайденныеКвитанции);
							
						ИначеЕсли ТипДокумента = "DP_IZVPOL_23" Тогда			
							СоздатьЗаписьDP_IZVPOL_23(ТЗСтруктур, ДокументыШапка, МассивЛогаСобытий, НеНайденныеКвитанции);
							
						ИначеЕсли ТипДокумента = "DP_UVUTOCH_24" Тогда					
							СоздатьЗаписьDP_UVUTOCH_24(ТЗСтруктур, ДокументыШапка, МассивЛогаСобытий, НеНайденныеКвитанции);
							
						ИначеЕсли ТипДокумента = "DP_REZRUZAK" Тогда		
							СоздатьЗаписьDP_REZRUZAK(ТЗСтруктур, ДокументыШапка, МассивЛогаСобытий, НеНайденныеКвитанции);
							
						ИначеЕсли ТипДокумента = "STATUS" Тогда
							СоздатьЗаписьSTATUS(ТЗСтруктур, ДокументыШапка, МассивЛогаСобытий);
							
						КонецЕсли;						
					КонецЕсли;
					
					ТипОбмена = "Локально";
					Если ИспользоватьЛокальный_FTP_Клиент = Ложь Тогда
						Если знИспользоватьАПИ Тогда
							ТипОбмена = "API";
						Иначе
							ТипОбмена = "FTP";
						КонецЕсли;	
					КонецЕсли;
										
					Для каждого Стр Из ТЗСтруктур Цикл
						
						Обработан = Неопределено;
						Стр.СтруктураДокумента.Свойство("Обработан", Обработан);
						
						Если Обработан = Ложь Тогда	
							
							ТекстПричины = Неопределено;
							Стр.СтруктураДокумента.Свойство("ТекстПричины", ТекстПричины);
							
							ЭтоПовторныйДокумент = Неопределено;
							Стр.СтруктураДокумента.Свойство("ЭтоПовторныйДокумент", ЭтоПовторныйДокумент);
							
							Если НЕ ТекстПричины = Неопределено Тогда				
								ТекстЛогаСобытий = ТекстПричины;
								УровеньЛогирования = Перечисления.ЭКОМ_УровниЛогирования.Предупреждение;
								
							ИначеЕсли ЭтоПовторныйДокумент = Истина Тогда
								ТекстЛогаСобытий = "Повторный документ - " + " [" + Стр.ИмяФайлаXML + "]";
								УровеньЛогирования = Перечисления.ЭКОМ_УровниЛогирования.Предупреждение;
								
							Иначе	
								ТекстЛогаСобытий = "Документ не обработан. Посмотрите текст ошибки в регистре ЭКОМ события [" + Стр.ИмяФайлаXML + "]";
								УровеньЛогирования = Перечисления.ЭКОМ_УровниЛогирования.Ошибка;
								
							КонецЕсли;
							
							Если ЗначениеЗаполнено(ТекстЛогаСобытий) Тогда
								ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, УровеньЛогирования, ИмяСобытия);
								МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
							КонецЕсли;
							
						КонецЕсли;
						
						СтруктураФайла = Новый Структура;
						СтруктураФайла.Вставить("СтруктураДок", Стр.СтруктураДокумента);
						
						Если ТипДокумента = "CONDRA" Тогда
							
							Для Каждого Расширение Из ПоддерживаемыеРасширенияCONDRA() Цикл
								Если ЗначениеЗаполнено(Стр["ИмяФайла" + Расширение]) Тогда
									СтруктураФайла.Вставить("ИмяФайла" + Расширение,	Стр["ИмяФайла" + Расширение]);
									СтруктураФайла.Вставить("АдресФайла" + Расширение,	Стр["АдресФайла" + Расширение]);
								КонецЕсли;
							КонецЦикла;
							
						КонецЕсли;
						
						Если ОбработатьФайлыНаКлиенте Тогда
							
							СтруктураФайла.Вставить("АдресФайлаXML", Стр.АдресФайлаXML);
							Если ЗначениеЗаполнено(Стр.ИмяФайлаПодписи) Тогда
								СтруктураФайла.Вставить("АдресBIN", Стр.АдресBIN);
							КонецЕсли;
							
						Иначе
							
							СтруктураФайла.Вставить("ФайлXML", Стр.ФайлXML);
							Если ЗначениеЗаполнено(Стр.ИмяФайлаПодписи) Тогда
								СтруктураФайла.Вставить("ФайлBIN", Стр.ФайлBIN);
							КонецЕсли;
							
						КонецЕсли;
						
						Стр.СтруктураДокумента.Вставить("ПодписьПроверена", Ложь);  // для совместимости кода		
						Если ЗначениеЗаполнено(Стр.ИмяФайлаПодписи) Тогда
							СтруктураФайла.Вставить("ИмяФайлаПодписи", Стр.ИмяФайлаПодписи);
						КонецЕсли;
						
						СтруктураФайла.Вставить("ИмяФайлаXML", Стр.ИмяФайлаXML);
						СтруктураФайла.Вставить("ПовторнаяОбработка", Стр.ПовторнаяОбработка);
						
						МассивСтруктурыФайлов.Добавить(СтруктураФайла);	
						
						ПодписьНеобходима = Вычислить("ЭКОМ_ОбщегоНазначения.ПроверитьНеобходимостьПодписи(ТипДокумента)");
						
						// Определяем имя файла на платформе для каждого типа документа		
						// Файлы в архиве	
						Если ТипДокумента = "ON_SCHFDOPPR_01"            //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _01. 2 этап]
							ИЛИ ТипДокумента = "ON_KORSCHFDOPPR_01"      //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _01. 2 этап]
							ИЛИ ТипДокумента = "ON_NSCHFDOPPR_01"        //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _01. 2 этап]
							ИЛИ ТипДокумента = "ON_NSCHFDOPPRMARK_01"    //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _01. 2 этап]
							ИЛИ ТипДокумента = "ON_NSCHFDOPPRPROS_01"    //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _01. 2 этап]
							ИЛИ ТипДокумента = "ON_NKORSCHFDOPPR_01"     //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _01. 2 этап]
							ИЛИ ТипДокумента = "ON_NKORSCHFDOPPRMARK_01" //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _01. 2 этап]
							ИЛИ ТипДокумента = "ON_NKORSCHFDOPPRPROS_01" //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _01. 2 этап]
							ИЛИ ТипДокумента = "CONDRA" 
							ИЛИ ТипДокумента = "DRVGOV_02_Входящий" 
							ИЛИ ТипДокумента = "DRVGOU_03_Входящий"
							ИЛИ ТипДокумента = "DRVGPV_06_Входящий" 
							ИЛИ ТипДокумента = "DRVGPU_07_Входящий"
							ИЛИ ТипДокумента = "WHGPU_08_Входящий"
							ИЛИ ТипДокумента = "DP_Статусы" Тогда 
							
							Если Обработан = Истина Тогда				
								СтрСтруктура = Новый  Структура;
								СтрСтруктура.Вставить("Имя", ?(ЗначениеЗаполнено(Стр.ИмяФайлаАрхива), Стр.ИмяФайлаАрхива, Стр.ИдентификаторФайла + ".zip"));
								МассивОбработанныхФайловСПлатформы.Добавить(СтрСтруктура);
							КонецЕсли;	
							
						// Файлы с подписью
						ИначеЕсли ПодписьНеобходима Тогда   				
							
							Если Обработан = Истина Тогда
								СтрСтруктура = Новый  Структура;
								СтрСтруктура.Вставить("Имя", Стр.ИмяФайлаXML);
								МассивОбработанныхФайловСПлатформы.Добавить(СтрСтруктура);
								
								СтрСтруктура = Новый  Структура;
								СтрСтруктура.Вставить("Имя", Стр.ИмяФайлаПодписи);
								МассивОбработанныхФайловСПлатформы.Добавить(СтрСтруктура);
							КонецЕсли;
							
							// Файлы без подписи	
						Иначе
							Если Обработан = Истина Тогда		
								СтрСтруктура = Новый  Структура;
								СтрСтруктура.Вставить("Имя", Стр.ИмяФайлаXML);
								МассивОбработанныхФайловСПлатформы.Добавить(СтрСтруктура);
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
					
					// Переместить файлы в архив на платформе
					Если ЭКОМ_ОставитьДокументыНаПлатформеПослеЗагрузки = Ложь
						И ИспользоватьЛокальный_FTP_Клиент = Ложь Тогда
						
						// Отработанные файлы
						Если МассивОбработанныхФайловСПлатформы.Количество() > 0 Тогда	
							
							Если знИспользоватьАПИ Тогда
								
								СтруктураСоответствий = РазбитьМассивПоЧастям(МассивОбработанныхФайловСПлатформы);    
								
								Для Каждого Эл Из СтруктураСоответствий Цикл
									ИменаФайлов = Новый Массив;
									Для каждого ЭлИменаФайлов Из Эл.Значение Цикл
										ИменаФайлов.Добавить(ЭлИменаФайлов.Ключ);
									КонецЦикла;
									
									API_АрхивироватьДокументы(ПрофильОбмена, ИменаФайлов, МассивЛогаСобытий);
									
								КонецЦикла;
							ИначеЕсли ИспользоватьREST Тогда
								ОтметитьДокументыАтоллПрочитанными(МассивОбработанныхФайловСПлатформы, ПрофильОбмена, ТипДокумента);
							Иначе
								МассивИмен = Новый Массив;
								Для Каждого ЭлИмяФайла Из МассивОбработанныхФайловСПлатформы Цикл		
									МассивИмен.Добавить(ЭлИмяФайла.Имя);
								КонецЦикла;
								
								FTP_АрхивироватьДокументы(ПрофильОбмена, МассивИмен, "Архивирую обработанные файлы", МассивЛогаСобытий, ТипОбменаЭТРН);
								
							КонецЕсли;		
							
						КонецЕсли;
						
						
						// Не найденные квитанции
						Если НеНайденныеКвитанции.Количество() > 0 Тогда	
							
							//Docrobot 1.19.0 MOD-1377 [Начало. Для PDPOL и PDOTPR. 2 этап]
							Если ТЗНеобработанных.Количество() > 0 Тогда
								
								Для Каждого СтрокаКвитанция Из ТЗНеобработанных Цикл
									ИмяСобытияКвит = "Обработка документов " + СтрокаКвитанция.ВидДокумента;
									
									ТекстЛогаСобытий = "Не найдены цепочки документов для квитанций " + СтрокаКвитанция.ВидДокумента + " (" + СтрокаКвитанция.КоличествоОбщее + " шт.) - квитанции записаны в регистр ЭКОМ_Квитанции.";
									ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытияКвит);
									МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
									
								КонецЦикла;
							Иначе	
								ТекстЛогаСобытий = "Не найдены цепочки документов для квитанций " + ТипДокумента + " (" + НеНайденныеКвитанции.Количество()/2 + " шт.) - квитанции записаны в регистр ЭКОМ_Квитанции.";
								ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
								МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
							КонецЕсли;
							//Docrobot 1.19.0 MOD-1377 [Конец. Для PDPOL и PDOTPR. 2 этап]
							
							Если знИспользоватьАПИ Тогда
								
								МассивИмен = Новый Массив;
								Для Каждого ЭлИмяФайла Из НеНайденныеКвитанции Цикл		
									Структура = Новый Структура;
									Структура.Вставить("Имя", ЭлИмяФайла);
									МассивИмен.Добавить(Структура);
								КонецЦикла;
								
								СтруктураСоответствий = РазбитьМассивПоЧастям(МассивИмен);    
								
								Для Каждого Эл Из СтруктураСоответствий Цикл
									ИменаФайлов = Новый Массив;
									Для каждого ЭлИменаФайлов Из Эл.Значение Цикл
										ИменаФайлов.Добавить(ЭлИменаФайлов.Ключ);
									КонецЦикла;
									
									API_АрхивироватьДокументы(ПрофильОбмена, ИменаФайлов, МассивЛогаСобытий);
									
								КонецЦикла;
							Иначе
								
								FTP_АрхивироватьДокументы(ПрофильОбмена, НеНайденныеКвитанции, "Архивирую файлы с ошибками", МассивЛогаСобытий, ТипОбменаЭТРН);
								
							КонецЕсли;		
							
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
				
				
				
				
			КонецЦикла;
		Иначе
			ТекстЛогаСобытий = "Выберите в настройках профиль обмена по организации.
			                   |Не заполнен Активный профиль обмена в справочнике <<<ЭКОМ Профили обмена>>>!";
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		КонецЕсли;
		
		Выполнить("ЭКОМ_ОбщегоНазначения.СнятьБлокировкуОперации(ТипДокумента, ""Входящий"", МассивЛогаСобытий);");
		
	КонецЕсли;
	
	ЭКОМ_ВзаимодействиеREST_API.ЗаполнитьИдентификаторыЦепочекСредствамиRESTv2();
	
	Возврат МассивСтруктурыФайлов;
	
КонецФункции

// Убирает из соответствия файлы, которые предназначаются другим получателям
//
// Параметры:
//  ФайлыНаСервере  - Соответствие - коллекция входящих файлов
//
Процедура ИсключитьЧужиеФайлы(ФайлыНаСервере)
	
	ТипыОрганизации = Новый Массив;
	ВозможныеОрганизации = Новый Массив;
	ВозможныеОрганизации.Добавить("Организации");
	ВозможныеОрганизации.Добавить("Фирмы");
	КоллекцияОбъектовСправочники = Метаданные.Справочники;
	
	Для Каждого Имя Из ВозможныеОрганизации Цикл
		Если НЕ КоллекцияОбъектовСправочники.Найти(Имя) = Неопределено Тогда
			ТипыОрганизации.Добавить(Тип("СправочникСсылка." + Имя));
		КонецЕсли;
	КонецЦикла;
	
	Если ВозможныеОрганизации.Количество() = 0 Тогда
		Возврат; // Нет предполагаемых организаций в дереве конфигурации.
	КонецЕсли;
	
	ТипыДокументовДляПроверки = Новый Массив;
	ТипыДокументовДляПроверки.Добавить("DP_PDOTPR");
	ТипыДокументовДляПроверки.Добавить("DP_PDPOL");
	ТипыДокументовДляПроверки.Добавить("DP_IZVPOL");
	ТипыДокументовДляПроверки.Добавить("ON_NSCHFDOPPR");
	ТипыДокументовДляПроверки.Добавить("ON_NKORSCHFDOPPR");
	// Проверить и добавить остальные.
	
	// Ищем хотя бы один файл с типом документа, для которого данная проверка релевантна.
	ПродолжитьПроверку = Ложь;
	Для Каждого ЭлементФайлыНаСервере Из ФайлыНаСервере Цикл
		Для Каждого ТипДокумента Из ТипыДокументовДляПроверки Цикл
			Если Найти(ЭлементФайлыНаСервере.Ключ, ТипДокумента) = 1 Тогда
				ПродолжитьПроверку = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ПродолжитьПроверку Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	// Если таковых нет, дальше выполнять код не стоит.
	Если НЕ ПродолжитьПроверку Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЭКОМ_GLN.Партнер.Идентификатор + ЭКОМ_GLN.Ид_ОЭД КАК Получатель
		|ИЗ
		|	РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN
		|ГДЕ
		|	ТИПЗНАЧЕНИЯ(ЭКОМ_GLN.Объект) В (&ТипыОрганизации)";
	
	Запрос.УстановитьПараметр("ТипыОрганизации", ТипыОрганизации);
	
	Получатели = Запрос.Выполнить().Выгрузить();
	КлючиДляУдаления = Новый Массив;
	
	Для Каждого ЭлементФайлыНаСервере Из ФайлыНаСервере Цикл
		
		ТипТекущегоДокумента = "";
		Для Каждого ТипДокумента Из ТипыДокументовДляПроверки Цикл
			Если Найти(ЭлементФайлыНаСервере.Ключ, ТипДокумента) = 1 Тогда
				
				ТипТекущегоДокумента = ТипДокумента;

				Если ТипДокумента = "ON_NSCHFDOPPR" Или ТипДокумента = "ON_NKORSCHFDOPPR" Тогда
					Если Найти(ЭлементФайлыНаСервере.Ключ, "MARK") > 0 Тогда
						ТипТекущегоДокумента = ТипТекущегоДокумента + "MARK";
					ИначеЕсли Найти(ЭлементФайлыНаСервере.Ключ, "PROS") > 0 Тогда
						ТипТекущегоДокумента = ТипТекущегоДокумента + "PROS";
					КонецЕсли;					
				КонецЕсли;
				
				Прервать;
				
			КонецЕсли;
		КонецЦикла;
		
		Если ПустаяСтрока(ТипТекущегоДокумента) Тогда
			Продолжить;
		КонецЕсли;
		
		Получатель = СтрЗаменить(ЭлементФайлыНаСервере.Ключ, ТипТекущегоДокумента + "_", "");
		Получатель = Лев(Получатель, Найти(Получатель, "_") - 1);
		
		Если Получатели.Найти(Получатель, "Получатель") = Неопределено Тогда
			// Добавляем к удалению.
			КлючиДляУдаления.Добавить(ЭлементФайлыНаСервере.Ключ);
		КонецЕсли;
			
	КонецЦикла;

	// Удаляем элементы из структуры. Это не наши документы.
	Для Каждого Ключ Из КлючиДляУдаления Цикл 
		Значение = ФайлыНаСервере.Получить(Ключ);
		Если НЕ Значение = Неопределено Тогда
			// Удаление темп файлов.
			Для Каждого Элемент Из Значение Цикл
				Если Найти(Элемент.Ключ, "Файл") = 1
					И ТипЗнч(Элемент.Значение) = Тип("Файл") Тогда
					
					УдалитьФайлы(Элемент.Значение.ПолноеИмя);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		ФайлыНаСервере.Удалить(Ключ);
	КонецЦикла;
	
КонецПроцедуры

