Процедура ДобавитьИсточникВПриемникСтрокой(Источник, Приемник, Разделитель = ",", ПробелПослеРазделителя = Истина) Экспорт 
	Приемник = Приемник + ?(Приемник = "", "", Разделитель + ?(ПробелПослеРазделителя = Истина, " ", "")) + Строка(Источник);
КонецПроцедуры

Функция ОписаниеИзмененияСтрокой(Было, Стало, Описание = "", ОписаниеПослеОписанияПередБыло = "поле", ОписаниеБыло = "было", ОписаниеСтало = "стало", ДобавитьСправаКОписанию = ":", ДлинныеСтрокиОбрезатьДо = 100) Экспорт
	
	БылоСтрокой  = ПредставитьЗначениеСтрокой(Было ,, ДлинныеСтрокиОбрезатьДо);
	СталоСтрокой = ПредставитьЗначениеСтрокой(Стало,, ДлинныеСтрокиОбрезатьДо);
	
	Результат = ОписаниеПослеОписанияПередБыло + ДобавитьСправаКОписанию + " " + Строка(Описание) + ", " + ОписаниеБыло + ДобавитьСправаКОписанию + " " + БылоСтрокой + ", " + ОписаниеСтало + ДобавитьСправаКОписанию + " " + СталоСтрокой;
	Возврат Результат;
КонецФункции 

Функция ПредставитьЗначениеСтрокой(ЗначениеДляПредставления, УбратьПереносыСтрок = Истина, ДлинныеСтрокиОбрезатьДо = 100, ДобавитьТипЗначения = Истина) Экспорт 
	Перем Результат;    
	
	Если ЗначениеДляПредставления = NULL Тогда
		Результат = "NULL";
	ИначеЕсли ЗначениеДляПредставления = Неопределено Тогда
		Результат = "Неопределено";
	ИначеЕсли ТипЗнч(ЗначениеДляПредставления) = Тип("ЭлементСпискаЗначений") Тогда
		Результат = "Пометка " + ?(ЗначениеДляПредставления.Пометка, "✅ ","нет ")
		+ "Представление [" + Строка(ЗначениеДляПредставления.Представление) + "]"
		+ ", " 
		+ "Значение [" + Строка(ЗначениеДляПредставления.Значение) + "], тип " + Строка(ТипЗнч(ЗначениеДляПредставления))
		;
	ИначеЕсли ТипЗнч(ЗначениеДляПредставления) = Тип("КлючИЗначение") Тогда
		Результат = "Ключ [" + Строка(ЗначениеДляПредставления.Ключ) + "]"
		+ ", " 
		+ "Значение [" + Строка(ЗначениеДляПредставления.Значение) + "]"
		;
	Иначе
		Результат = Строка(ЗначениеДляПредставления);
		Результат = ?(ПустаяСтрока(Результат), "[]", Результат);
		Если ДобавитьТипЗначения = Истина Тогда
			Результат = Результат + ". Тип: " + Строка(ТипЗнч(ЗначениеДляПредставления));
		КонецЕсли;
	КонецЕсли;
	
	Если ДлинныеСтрокиОбрезатьДо = Неопределено Или ДлинныеСтрокиОбрезатьДо = 0 Тогда
	Иначе
		Результат = Лев(Результат, ДлинныеСтрокиОбрезатьДо) + ?(СтрДлина(Результат) > ДлинныеСтрокиОбрезатьДо, "...(длинный текст)", "");
	КонецЕсли;
	
	Если УбратьПереносыСтрок = Истина Тогда
		Результат = СтрЗаменить(Результат, Символы.ПС, " ");;    
	КонецЕсли;
	
	Возврат  Результат;
КонецФункции

Функция ОписаниеЭлементаКоллекции(Элемент)
	Если ТипЗнч(Элемент) <> Тип("КлючИЗначение") Тогда
		Возврат "";    
	КонецЕсли;
	
	Результат = "Ключ: [" + ПредставитьЗначениеСтрокой(Элемент.Ключ,,, Ложь) + "], значение: " + ПредставитьЗначениеСтрокой(Элемент.Значение);
	Возврат Результат;
КонецФункции

Функция РезультатПоТекущемуРезультату(Знач ТекущийРезультат, Знач РезультатДо, Знач ЗначениеТекущийРезультатДляЗаменыРезультат = Ложь)
	
	Возврат ?(ТекущийРезультат = ЗначениеТекущийРезультатДляЗаменыРезультат, ТекущийРезультат, РезультатДо); 
КонецФункции

Функция НастройкаПараметрУсловиеПоСтрокеИлиМассиву(Знач ПеременнаяЗначенияУсловия, ИмяПараметраЗапроса, УсловиеСравненияЕдиничныхЗначений = "=") Экспорт
	
	ПеременнаяЗначенияУсловия = ВернутьТемЖеЗначениемИлиМассивомИзЭтогоЗначения(ПеременнаяЗначенияУсловия);
	
	Если ТипЗнч(ПеременнаяЗначенияУсловия) = Тип("Массив") Тогда
		Результат = " В (&" + ИмяПараметраЗапроса + ")";
	Иначе
		Результат = " " + УсловиеСравненияЕдиничныхЗначений + " &" + ИмяПараметраЗапроса;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ВернутьТемЖеЗначениемИлиМассивомИзЭтогоЗначения(ЗначениеДляАнализаВозврата, Разделитель = ",", ОбязательноМассивом = Ложь, ДобавитьВМассивНеопределено = Ложь) Экспорт
	Результат = Неопределено;
	
	Если ТипЗнч(ЗначениеДляАнализаВозврата) = Тип("Строка") Тогда
		Если Найти(ЗначениеДляАнализаВозврата, Разделитель) > 0 Тогда
			ЗначениеМассивом = ЭКОМ_РазложитьСтрокуВМассивПодстрок(ЗначениеДляАнализаВозврата, Разделитель, Истина);
			Результат = Новый Массив;
			Для Каждого ЗначениеРезультата Из ЗначениеМассивом Цикл
				Результат.Добавить(СокрЛП(ЗначениеРезультата));
			КонецЦикла;
			Если ДобавитьВМассивНеопределено = Истина Тогда
				Результат.Добавить(Неопределено);
			КонецЕсли;
		Иначе
			Если ОбязательноМассивом = Истина Тогда
				Результат = Новый Массив;
				Результат.Добавить(ЗначениеДляАнализаВозврата);
				Если ДобавитьВМассивНеопределено = Истина Тогда
					Результат.Добавить(Неопределено);
				КонецЕсли;
			Иначе
				Результат = ЗначениеДляАнализаВозврата;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Результат = ЗначениеДляАнализаВозврата;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

//ищет как выражение ПОДОБНО в запросах в переданной строке      
Функция СтрНайтиПоШаблону(СтрокаГдеИскать, ШаблонПоиска) Экспорт
	Перем Результат;
	
	Если (Прав(ШаблонПоиска, 1) = "%" И Лев(ШаблонПоиска, 1) = "%") Тогда //ищет вхождение в любом месте
		
		ШаблонПоискаБезСпецСимволов = СтрЗаменить(ШаблонПоиска, "%", "");
		Если Найти(СтрокаГдеИскать, ШаблонПоискаБезСпецСимволов) = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		
	ИначеЕсли Лев(ШаблонПоиска, 1) = "%" Или Найти(ШаблонПоиска, "%") = 0 Тогда //Ищет только сначала строки
		
		ШаблонПоискаБезСпецСимволов = СтрЗаменить(ШаблонПоиска, "%", "");
		ФрагментТекста              = Лев(СтрокаГдеИскать, СтрДлина(ШаблонПоискаБезСпецСимволов));
		Результат                   = (ФрагментТекста = ШаблонПоискаБезСпецСимволов);
	КонецЕсли;
	
	Возврат Результат;
КонецФункции 

//возвращает истину если шаблон поиска найден ложь если не найден
Функция СтрНайденШаблонПоискаВСтроке(СтрокаГдеИскать, ШаблонПоиска) Экспорт
	Перем Результат;
	
	ПозицияВхождения = СтрНайтиПоШаблону(СтрокаГдеИскать, ШаблонПоиска);
	Если ПозицияВхождения <> Неопределено И ПустаяСтрока(ПозицияВхождения) = Ложь Тогда
		Результат = ?(ПозицияВхождения > 0, Истина, Ложь);
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ЭКОМ_ПолучитьРазделительПути()
	
	РазделительПути = "";
	
	Если ВерсияПлатформы() >= 8330 Тогда
		РазделительПути = ПолучитьРазделительПути();
	Иначе
		
		СистемнаяИнформация = Новый СистемнаяИнформация;	
		ЭтоLinuxКлиент = СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86 
		ИЛИ СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86_64;
		
		Если ЭтоLinuxКлиент Тогда 
			РазделительПути = "/"; // Linux
			
		Иначе
			РазделительПути = "\";  // Windows
			
		КонецЕсли;
	КонецЕсли;
	
	Возврат РазделительПути;
	
КонецФункции

