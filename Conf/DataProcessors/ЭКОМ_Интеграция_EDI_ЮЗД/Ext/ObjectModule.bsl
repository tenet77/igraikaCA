Процедура ПодписатьДокументНаСервере(мСтрока, API_DLL, API_Авторизация, COM_Объект_Сертификат, мСоответствиеОрганизацииСтатусамПодписей, COM_UZDORecipientAnswerInfo)
	
	Если ТипЗнч(мСтрока) = Тип("Структура") Тогда
		мОтправитьИзвещение = мСтрока.СтруктураСобытияОбъекта.НеобходимоОтправитьИзвещение;
		мОтправитьУточнение = мСтрока.СтруктураСобытияОбъекта.НеобходимоОтправитьУточнение;
	Иначе
		мОтправитьИзвещение = (НЕ Найти(нрег(СокрЛП(мСтрока.СтатусСчФ)), "загружен") = 0) ИЛИ (НЕ Найти(нрег(СокрЛП(мСтрока.СтатусСчФ)), "требуется подписать упд/укд") = 0) ИЛИ (НЕ Найти(СокрЛП(мСтрока.СтатусСчФ), "Ожидается подтверждение") = 0);
		мОтправитьУточнение = (НЕ Найти(нрег(СокрЛП(мСтрока.СтатусСчФ)), "уточнен") = 0);
	КонецЕсли;
	
	Если мОтправитьИзвещение Тогда
		
		Если COM_UZDORecipientAnswerInfo = Неопределено Тогда
			COM_UZDORecipientAnswerInfo = API_DLL.DraftUZDORecipientAnswerInfo(COM_Объект_Сертификат);
		КонецЕсли;
		
		Если ТипЗнч(мСтрока) = Тип("Структура") Тогда
			Если НЕ Найти(мСтрока.Функция, "ДИС") = 0 ИЛИ НЕ Найти(мСтрока.Функция, "КСЧФ") = 0 Тогда
				COM_UZDORecipientAnswerInfo.SetOperationContent("Изменение сумм согласовано");
			Иначе
				COM_UZDORecipientAnswerInfo.SetOperationContent("Товар принят полностью");
			КонецЕсли;
		Иначе
			Если НЕ Найти(мСтрока.СтатусУПД, "ДИС") = 0 ИЛИ НЕ Найти(мСтрока.СтатусУПД, "КСЧФ") = 0 Тогда
				COM_UZDORecipientAnswerInfo.SetOperationContent("Изменение сумм согласовано");
			Иначе
				COM_UZDORecipientAnswerInfo.SetOperationContent("Товар принят полностью");
			КонецЕсли;			
		КонецЕсли;
		
		мСтатусыПоОрганизации = мСоответствиеОрганизацииСтатусамПодписей.Получить(мСтрока.Организация);	
		COM_UZDORecipientAnswerInfo.SetAuthorityBasis(?(мСтатусыПоОрганизации.Свойство("лПодписантОснПолн"), мСтатусыПоОрганизации.лПодписантОснПолн, "Должностные обязанности"));
		
		счт = 0; 
		Удачно = API_DLL.acceptUZDODocument(API_Авторизация, COM_UZDORecipientAnswerInfo, мСтрока.ИД_Документа);
		//Пока НЕ Удачно И счт < 3 Цикл
		//	счт = счт + 1;
		//	Удачно = API_DLL.acceptUZDODocument(API_Авторизация, COM_UZDORecipientAnswerInfo, мСтрока.ИД_Документа);	
		//КонецЦикла;
		
	ИначеЕсли мОтправитьУточнение Тогда	
		
		Удачно = API_DLL.rejectUZDODocument(API_Авторизация, COM_Объект_Сертификат, СокрЛП(мСтрока.ПричинаУточнения), мСтрока.ИД_Документа);
		счт = 0;
		//Пока НЕ Удачно И счт < 3 Цикл
		//	счт = счт + 1;
		//	Удачно = API_DLL.rejectUZDODocument(API_Авторизация, COM_Объект_Сертификат, СокрЛП(мСтрока.ПричинаУточнения), мСтрока.ИД_Документа);	
		//КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьАдресОбъекта(п_Объект, Вид) Экспорт
	МенЗаписи = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
	МенЗаписи.Объект = п_Объект;
	МенЗаписи.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
	МенЗаписи.Вид = Вид;
	МенЗаписи.Прочитать();
	
	Если МенЗаписи.Выбран() Тогда
		СтруктураАдреса =  Новый Структура;
		СтруктураАдреса.Вставить("Вид"          , МенЗаписи.Вид);
		СтруктураАдреса.Вставить("ТипАдреса"    , "АдрРФ");
		СтруктураАдреса.Вставить("Индекс"       , МенЗаписи.Поле1);  
		СтруктураАдреса.Вставить("КодРегион"    , МенЗаписи.Поле2);  
		СтруктураАдреса.Вставить("Район"        , МенЗаписи.Поле3);  
		СтруктураАдреса.Вставить("Город"        , МенЗаписи.Поле4);  
		СтруктураАдреса.Вставить("НаселПункт"   , МенЗаписи.Поле5);  
		СтруктураАдреса.Вставить("Улица"        , МенЗаписи.Поле6);  
		СтруктураАдреса.Вставить("Дом"          , МенЗаписи.Поле7);  
		СтруктураАдреса.Вставить("Корпус"       , МенЗаписи.Поле8);  
		СтруктураАдреса.Вставить("Кварт"        , МенЗаписи.Поле9); 
		СтруктураАдреса.Вставить("Представление", МенЗаписи.Представление);  
	Иначе
		СтруктураАдреса =  Неопределено;
	КонецЕсли;
	
	Возврат СтруктураАдреса;
	
КонецФункции 

Процедура ЭКОМ_Объекты_События_Записать(п_Регистратор, п_ВидДокумента, п_Структура, ЗаписыватьПустыеЗначения = Ложь) Экспорт
	
	Блокировать = ПолучитьРежимУправленияБлокировкойДанныхПоУмолчанию(); 	
	// Установка блокировки
	НачатьТранзакцию();
	Попытка
		
		Если Блокировать = Истина Тогда
			БлокировкаДанных 		= Новый БлокировкаДанных;
			ЭлементБлокировки 		= БлокировкаДанных.Добавить("РегистрСведений.ЭКОМ_Объекты_События");
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			ЭлементБлокировки.УстановитьЗначение("Документ_Основание", п_Регистратор);
			ЭлементБлокировки.УстановитьЗначение("ВидДокумента", п_ВидДокумента);
			БлокировкаДанных.Заблокировать();	
		КонецЕсли;
		
		НЗ = РегистрыСведений.ЭКОМ_Объекты_События.СоздатьНаборЗаписей();
		НЗ.Отбор.Документ_Основание.Установить(п_Регистратор);
		НЗ.Отбор.ВидДокумента.Установить(п_ВидДокумента);
		НЗ.Прочитать();
		
		Если НЗ.Количество() = 0 Тогда
			НоваяЗапись = НЗ.Добавить();
			НоваяЗапись.Документ_Основание = п_Регистратор;
			НоваяЗапись.ВидДокумента       = п_ВидДокумента;
			НоваяЗапись.ДатаЗаписи         = ТекущаяДата();	
		Иначе
			НоваяЗапись = НЗ[0];
		КонецЕсли;
		
		Для Каждого Элемент Из п_Структура Цикл			
			Если ЗаписыватьПустыеЗначения Тогда
				НоваяЗапись[Элемент.Ключ] = Элемент.Значение; 	
			Иначе
				Если ЗначениеЗаполнено(Элемент.Значение) Тогда
					НоваяЗапись[Элемент.Ключ] = Элемент.Значение; 	
				КонецЕсли;
			КонецЕсли;			
		КонецЦикла;
		
		НЗ.ДополнительныеСвойства.Вставить("ПерваяЗапись", Истина);
		НЗ.Записать();
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();	
		ЗаписьЖурналаРегистрации("Обработка ""Интеграция Docrobot""", УровеньЖурналаРегистрации.Ошибка, , , "Конфликт записи в регистр - " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры // ЭКОМ_Объекты_События_Записать()

// Процедура выполняет действие, заложенное в шаблоне из вкладки Документы (форма Настройки - Настройка документов)
//
// Параметры:
//  ТаблицаЗначений  - ТаблицаЗначений - данные по документам-источникам
//  ИмяКнопки  - Строка - имя нажимаемой кнопки. Необходимо, чтобы идентифицировать шаблон, по которому нужно отработать действие
//  МассивЛогаСобытий  - Массив - данные лога событий по выполняемой операции
//
Процедура СоздатьДокументПоДинамическойКнопке(ТаблицаЗначений, ИмяКнопки, Роль, МассивЛогаСобытий) Экспорт
	
	ТекущаяДата = ТекущаяДатаСеанса();
	
	ИмяСобытия = "Создание документов по кнопке <<<" + ИмяКнопки + ">>>";
	
	// Для совместимости со старыми гибкими настройками
	ИзменениеТипаОбъекта = Ложь; 
	Если ТипЗнч(МассивЛогаСобытий) = Тип("Строка") Тогда
		ТекстЛогаСобытий = МассивЛогаСобытий;
		
		МассивЛогаСобытий = Новый Массив;		
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Информация, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		ИзменениеТипаОбъекта = Истина;
	КонецЕсли;
		
	ПродолжитьСозданиеДокументов = ПроверитьУстановитьБлокировкуОперации(ИмяКнопки, Роль, МассивЛогаСобытий);	
	Если ПродолжитьСозданиеДокументов = Ложь Тогда
		Возврат;	
	КонецЕсли;
	
	ИмяКолонки = "";
	СтруктураФайлаДанных = Неопределено;
	// Получение нужных нам колонок.
	ЭКОМ_СтруктураФайлаXMLДокументы	= Настройка_Параметр_Прочитать("СтруктураФайлаXMLДокументы");
	Для Каждого jp7whb_Строка Из ЭКОМ_СтруктураФайлаXMLДокументы.Строки Цикл
		Если Не jp7whb_Строка.Использовать Тогда
			Продолжить;
		КонецЕсли;
		
		Если jp7whb_Строка.Кнопка = ИмяКнопки Тогда
			СтруктураФайлаДанных = jp7whb_Строка;		
			Если ТипЗнч(СтруктураФайлаДанных) = Тип("СтрокаДереваЗначений") Тогда
				ЕстьКолонка = НЕ СтруктураФайлаДанных.Владелец().Колонки.Найти("КолонкаИсточника") = Неопределено;
				Если ЕстьКолонка Тогда
					ИмяКолонки = СтруктураФайлаДанных.КолонкаИсточника;
				КонецЕсли;
			КонецЕсли;
			
			Прервать;
			
		КонецЕсли;
	КонецЦикла;
	
	Если ПустаяСтрока(Роль) Тогда
		ТекстЛогаСобытий = "Роль для создания документа не указана. Возможно нажатие кнопки выполнено из роли ЭТРН.";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		Возврат;
	КонецЕсли;
	
	ИмяОбъектаКонфигурации = "";
	Если ТаблицаЗначений.Количество() > 0 
		И ЗначениеЗаполнено(ИмяКолонки)
		И ТаблицаЗначений.Колонки.Найти(ИмяКолонки) <> Неопределено Тогда  
			СтрокаТаблицы    = ТаблицаЗначений[0];
			ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(СтрокаТаблицы[ИмяКолонки]));
			Если НЕ ОбъектМетаданных = Неопределено Тогда
				ИмяОбъектаКонфигурации = ОбъектМетаданных.ПолноеИмя();
				СтруктураФайлаДанных.Источник = ОбъектМетаданных.Синоним;
			КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ИмяОбъектаКонфигурации)  Тогда
		ИмяОбъектаКонфигурации 		= ПолучитьПутьКОбъектуКонфигурации(СтруктураФайлаДанных, 1, "КолонкаИсточника", МассивЛогаСобытий);
	КонецЕсли;
	
	// Получаем имя документа приемника.
	МассивОтправленныхФайлов 	= Новый Массив;
	ИмяОбъектаТЧДокумента		= ПолучитьПутьКОбъектуКонфигурации(СтруктураФайлаДанных, 2, "Источник", МассивЛогаСобытий);
	ИмяПриемника 				= ПолучитьПутьКОбъектуКонфигурации(СтруктураФайлаДанных, 1, "Приемник", МассивЛогаСобытий);
	ПоляЗапроса 				= Новый Соответствие;
	
	ОбходСтруктурыФайлаДанных(СтруктураФайлаДанных, ПоляЗапроса, Истина, ИмяКолонки, МассивЛогаСобытий); // Получение полей запроса и подстановка реквизитов выборки из запроса в код
	
	ky4wg8ec4e_Выборка				= СоздатьЗапросNew(ПоляЗапроса, ТаблицаЗначений, ИмяОбъектаКонфигурации, 3, ИмяКолонки, Роль, МассивЛогаСобытий); // Создание запроса
	Если ЕстьТабличнаяЧасть(СтруктураФайлаДанных.Строки) Тогда
		sou1u88nwm_ВыборкаСтроки 	= СоздатьЗапросNew(ПоляЗапроса, ТаблицаЗначений, ИмяОбъектаТЧДокумента , 4, ИмяКолонки, Роль, МассивЛогаСобытий);
	Иначе
		sou1u88nwm_ВыборкаСтроки	= Новый ТаблицаЗначений;
	КонецЕсли;
	
	КоличествоСозданныхДокументов = 0;
	КэшированныеЗначения = Неопределено;
	
	Если Не ky4wg8ec4e_Выборка = Неопределено Тогда  //Docrobot 1.20.0 MOD-973 [Если результат выполнения СоздатьЗапросNew = Неопредедено, то падает с ошибкой]
		Для Каждого ky4wg8ec4e_Строка Из ky4wg8ec4e_Выборка Цикл // Обход документов
			ОперацияЗапись = Ложь;
			
			Если ЗначениеЗаполнено(ИмяПриемника) Тогда
				Приемник = Документы[СтрЗаменить(ИмяПриемника, "Документ.", "")].СоздатьДокумент();
				ЗаполнитьДокумент(СтруктураФайлаДанных, ТаблицаЗначений, Приемник, ky4wg8ec4e_Строка, sou1u88nwm_ВыборкаСтроки, МассивЛогаСобытий);
			КонецЕсли;
			
			// Запись документа.
			ЭлектронныйДокумент = ky4wg8ec4e_Строка.ЭлектронныйДокумент;
			Источник = ky4wg8ec4e_Строка.Источник;
			Цепочка  = ky4wg8ec4e_Строка;
			
			ЛогСобытий = ""; // Используется в гибких
			Попытка
				//ВыполнитьГибкиеНастройки(Приемник, Источник); // Расскоментировать для тестирования
				Выполнить(СтруктураФайлаДанных.Служебные);
				
				Если ЗначениеЗаполнено(Приемник.Ссылка) И Не ОперацияЗапись Тогда
					КоличествоСозданныхДокументов = КоличествоСозданныхДокументов + 1;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ЛогСобытий) Тогда
					ТекстЛогаСобытий = ЛогСобытий;
					ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Информация, ИмяСобытия);
					МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
					
				КонецЕсли;
				
			Исключение
				ТекстЛогаСобытий = "Ошибка в выполнении кода кнопки """ + jp7whb_Строка.Кнопка + """: ";
				Описание  = ОписаниеСтрокиГибкихНастроек(jp7whb_Строка,,, "Кнопка");
				Ошибка    = ОписаниеОшибки();
				ТекстЛогаСобытий = ТекстЛогаСобытий + Символы.ПС + Ошибка + Символы.ПС + Описание;
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
				
				Возврат;
			КонецПопытки;
			
		КонецЦикла;
	КонецЕсли;
	
	Если КоличествоСозданныхДокументов > 0 Тогда
		УровеньЛогирования = Перечисления.ЭКОМ_УровниЛогирования.Успешно;
	Иначе	
		УровеньЛогирования = Перечисления.ЭКОМ_УровниЛогирования.Предупреждение;
	КонецЕсли;
	
	ТекстЛогаСобытий = "Количество созданных документов = " + КоличествоСозданныхДокументов + ".";
	ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, УровеньЛогирования, ИмяСобытия);
	МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
	
	Выполнить("ЭКОМ_ОбщегоНазначения.СнятьБлокировкуОперации(ИмяКнопки, Роль, МассивЛогаСобытий);");
	
	// Для совместимости со старыми гибкими настройками
	Если ИзменениеТипаОбъекта = Истина Тогда
		ТекстСообщения = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий)");
		МассивЛогаСобытий = ТекстСообщения;	
	КонецЕсли;
	
КонецПроцедуры

// Функция определяет наличие табличной части в шаблоне входящего документа.
//
// Параметры:
//  Дерево  - ДеревоЗначений - шаблон документа
//
// Возвращаемое значение:
//   Булево   - признак наличия табличной части
//
Функция ЕстьТабличнаяЧасть(Дерево)
	
	ЕстьТабличнаяЧасть = Ложь;
	
	Для Каждого Строка Из Дерево Цикл
		ЕстьТабличнаяЧасть = ?(Строка.Строки.Количество() > 0, Истина, ЕстьТабличнаяЧасть);
	КонецЦикла;
	
	Возврат ЕстьТабличнаяЧасть;
	
КонецФункции // ЕстьТабличнаяЧасть()

Процедура РекурсияОбъектXDTO(ОбъектXDTO, СтруктураДокумента, ИмяРодителя)
	
	Если ЗначениеЗаполнено(ИмяРодителя) 
		И НЕ Прав(ИмяРодителя, 1) = "_" Тогда
		ИмяРодителя = ИмяРодителя + "_";
	КонецЕсли;
	
	Если ТипЗнч(ОбъектXDTO) = Тип("ОбъектXDTO") Тогда
		
		Для каждого Свойство Из ОбъектXDTO.Свойства() Цикл
			
			Если Свойство.Форма = ФормаXML.Атрибут Тогда
				
				Если НЕ Найти(Свойство.Имя, "Дата") = 0 Тогда
					СтруктураДокумента.Вставить(ИмяРодителя + Свойство.Имя, ДатаИзXML_в_1С(ОбъектXDTO[Свойство.Имя]));
				Иначе
					СтруктураДокумента.Вставить(ИмяРодителя + Свойство.Имя, ОбъектXDTO[Свойство.Имя]);		
				КонецЕсли;
				
				
			ИначеЕсли Свойство.Форма = ФормаXML.Элемент 
				И ТипЗнч(ОбъектXDTO[Свойство.Имя]) = Тип("Строка") Тогда
				
				Если НЕ Найти(Свойство.Имя, "DATE") = 0 Тогда
					СтруктураДокумента.Вставить(ИмяРодителя + Свойство.Имя, ДатаИзXML_в_1С(ОбъектXDTO[Свойство.Имя]));
				Иначе
					СтруктураДокумента.Вставить(ИмяРодителя + Свойство.Имя, ОбъектXDTO[Свойство.Имя]);		
				КонецЕсли;
				
			ИначеЕсли Свойство.Форма = ФормаXML.Элемент 
				И ТипЗнч(ОбъектXDTO[Свойство.Имя]) = Тип("ОбъектXDTO") Тогда 
				РекурсияОбъектXDTO(ОбъектXDTO[Свойство.Имя], СтруктураДокумента, ИмяРодителя + Свойство.Имя);	
			КонецЕсли;
			
		КонецЦикла; 
		
	КонецЕсли;
	
	Если ТипЗнч(ОбъектXDTO) = Тип("СписокXDTO") Тогда 
		Массив = Новый Массив;
		Для Каждого Ст ИЗ ОбъектXDTO Цикл 
			Если ТипЗнч(Ст) = Тип("СписокXDTO") Тогда
				РекурсияОбъектXDTO(Ст, СтруктураДокумента, ИмяРодителя);
			ИначеЕсли ТипЗнч(Ст) = Тип("ОбъектXDTO") Тогда
				СтруктураСтрока = Новый Структура;
				РекурсияОбъектXDTO(Ст, СтруктураСтрока, ИмяРодителя);
				Массив.Добавить(СтруктураСтрока);						
			ИначеЕсли ТипЗнч(Ст) = Тип("Строка") 
				ИЛИ ТипЗнч(Ст) = Тип("Число") Тогда	
				Массив.Добавить(Ст);
			КонецЕсли;
		КонецЦикла;
		СтруктураДокумента.Вставить(ИмяРодителя, Массив);
	Иначе
		Для Каждого Свойство ИЗ ОбъектXDTO.Свойства() Цикл
			
			Если ТипЗнч(ОбъектXDTO[Свойство.Имя]) = Тип("ОбъектXDTO") Тогда
				РекурсияОбъектXDTO(ОбъектXDTO[Свойство.Имя], СтруктураДокумента, ИмяРодителя + Свойство.Имя);
			ИначеЕсли ТипЗнч(ОбъектXDTO[Свойство.Имя]) = Тип("СписокXDTO") Тогда 
				РекурсияОбъектXDTO(ОбъектXDTO[Свойство.Имя], СтруктураДокумента, ИмяРодителя + Свойство.Имя);	
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;	
	
КонецПроцедуры

Функция ПолучитьСтруктуруДокумента(ОбъектXDTO, МассивЛогаСобытий) Экспорт
	
	СтруктураДокумента = Новый Структура;
	РекурсияОбъектXDTO(ОбъектXDTO, СтруктураДокумента , "");
	
	// Создаем вручную ТЗ для документа с одной позицией товара.
	Если НЕ СтруктураДокумента.Свойство("HEAD_POSITION_") // Вариант для всех EDI документов
		И СтруктураДокумента.Свойство("HEAD_SENDER")
		И НЕ ОбъектXDTO.HEAD.Свойства().Получить("POSITION") = Неопределено Тогда
		
		ИмяТабличнойЧастиТоваров = "HEAD_POSITION_";
		МассивСтрок     = Новый Массив;
		СтруктураСтрока = Новый Структура;	
		РекурсияОбъектXDTO(ОбъектXDTO.HEAD.POSITION, СтруктураСтрока, ИмяТабличнойЧастиТоваров);
		
		МассивСтрок.Добавить(СтруктураСтрока);
		
		СтруктураДокумента.Вставить(ИмяТабличнойЧастиТоваров, МассивСтрок);
		
	ИначеЕсли НЕ СтруктураДокумента.Свойство("HEAD_PACKINGSEQUENCE_POSITION_") // Вариант для всех EDI документов
		И СтруктураДокумента.Свойство("HEAD_SENDER")
		И НЕ ОбъектXDTO.HEAD.Свойства().Получить("PACKINGSEQUENCE") = Неопределено Тогда
		
		ИмяТабличнойЧастиТоваров = "HEAD_PACKINGSEQUENCE_POSITION_";
		МассивСтрок     = Новый Массив;
		СтруктураСтрока = Новый Структура;	
		РекурсияОбъектXDTO(ОбъектXDTO.HEAD.PACKINGSEQUENCE.POSITION, СтруктураСтрока, ИмяТабличнойЧастиТоваров);
		
		МассивСтрок.Добавить(СтруктураСтрока);
		
		СтруктураДокумента.Вставить(ИмяТабличнойЧастиТоваров, МассивСтрок);		
		
	ИначеЕсли НЕ СтруктураДокумента.Свойство("CATALOGUE_POSITION_") // Для PRICAT
		И СтруктураДокумента.Свойство("SENDER")
		И НЕ ОбъектXDTO.CATALOGUE.Свойства().Получить("POSITION") = Неопределено Тогда
		
		ИмяТабличнойЧастиТоваров = "CATALOGUE_POSITION_";
		МассивСтрок     = Новый Массив;
		СтруктураСтрока = Новый Структура;	
		РекурсияОбъектXDTO(ОбъектXDTO.CATALOGUE.POSITION, СтруктураСтрока, ИмяТабличнойЧастиТоваров);
		
		МассивСтрок.Добавить(СтруктураСтрока);
		
		СтруктураДокумента.Вставить(ИмяТабличнойЧастиТоваров, МассивСтрок);
		
	ИначеЕсли НЕ СтруктураДокумента.Свойство("Документ_ТаблСчФакт_СведТов_") // Для УПД
		И СтруктураДокумента.Свойство("Документ_СвСчФакт_НомерСчФ") Тогда	
		
		ИмяТабличнойЧастиТоваров = "Документ_ТаблСчФакт_СведТов_";
		МассивСтрок     = Новый Массив;
		СтруктураСтрока = Новый Структура;	
		РекурсияОбъектXDTO(ОбъектXDTO.Документ.ТаблСчФакт.СведТов, СтруктураСтрока , ИмяТабличнойЧастиТоваров);
		
		МассивСтрок.Добавить(СтруктураСтрока);
		
		СтруктураДокумента.Вставить(ИмяТабличнойЧастиТоваров, МассивСтрок);
		
	ИначеЕсли НЕ СтруктураДокумента.Свойство("Документ_ТаблКСчФ_СведТов_") // Для УКД
		И СтруктураДокумента.Свойство("Документ_СвКСчФ_НомерКСчФ") Тогда	
		
		ИмяТабличнойЧастиТоваров = "Документ_ТаблКСчФ_СведТов_";
		МассивСтрок     = Новый Массив;
		СтруктураСтрока = Новый Структура;	
		РекурсияОбъектXDTO(ОбъектXDTO.Документ.ТаблКСчФ.СведТов, СтруктураСтрока , ИмяТабличнойЧастиТоваров);
		
		МассивСтрок.Добавить(СтруктураСтрока);
		
		СтруктураДокумента.Вставить(ИмяТабличнойЧастиТоваров, МассивСтрок);
		
	ИначеЕсли НЕ СтруктураДокумента.Свойство("Документ_СвТНО_ТН_Таблица_СвТов_") // Для ТОРГ-1
		И СтруктураДокумента.Свойство("Документ_СвТНО_НомФорм")
		И ВРег(СтруктураДокумента.Документ_СвТНО_НомФорм) = "ТОРГ-1" Тогда
		
		ИмяТабличнойЧастиТоваров = "Документ_СвТНО_ТН_Таблица_СвТов_";
		МассивСтрок     = Новый Массив;
		СтруктураСтрока = Новый Структура;	
		РекурсияОбъектXDTO(ОбъектXDTO.Документ.СвТНО.ТН.Таблица.СвТов, СтруктураСтрока , ИмяТабличнойЧастиТоваров);
		
		МассивСтрок.Добавить(СтруктураСтрока);
		
		СтруктураДокумента.Вставить(ИмяТабличнойЧастиТоваров, МассивСтрок);
		
	ИначеЕсли НЕ СтруктураДокумента.Свойство("Документ_СвТНО_ТН_Таблица_СвТов_") // Для ТОРГ-2
		И СтруктураДокумента.Свойство("Документ_СвТНО_НомФорм")
		И ВРег(СтруктураДокумента.Документ_СвТНО_НомФорм) = "ТОРГ-2" Тогда
		
		ИмяТабличнойЧастиТоваров = "Документ_СвТНО_ТН_Таблица_СвТов_";
		МассивСтрок     = Новый Массив;
		СтруктураСтрока = Новый Структура;	
		РекурсияОбъектXDTO(ОбъектXDTO.Документ.СвТНО.ТН.Таблица.СвТов, СтруктураСтрока , ИмяТабличнойЧастиТоваров);
		
		МассивСтрок.Добавить(СтруктураСтрока);
		
		СтруктураДокумента.Вставить(ИмяТабличнойЧастиТоваров, МассивСтрок);
		
	КонецЕсли;
	
	// Проверяем на обязательные реквизиты ТЧ - если нету добавляем пустые значения.
	Если СтруктураДокумента.Свойство("HEAD_SENDER")
		И СтруктураДокумента.Свойство("HEAD_POSITION_") Тогда
		
		// Обязательные атрибуты для ТЧ.
		Соответствие = Новый Соответствие;
		Соответствие.Вставить("HEAD_POSITION_PRODUCTIDSUPPLIER"    , "");
		Соответствие.Вставить("HEAD_POSITION_PRODUCTIDBUYER"       , "");
		Соответствие.Вставить("HEAD_POSITION_VAT"                  , "");
		Соответствие.Вставить("xmlКонтрагентGLN"                   , ОбъектXDTO.HEAD.SENDER);
		Соответствие.Вставить("HEAD_POSITION_ACTION_CODE"          , "");
		Соответствие.Вставить("HEAD_POSITION_CURRENCY"             , "");
