// РАБОТА СО СТРУКТУРОЙ ВХОДЯЩИХ ДОКУМЕНТОВ

// совпадает для RETANN, RETINS , INVOICE
Процедура ДополнитьСтруктуруДокумента(СтруктураДокумента, ОбязательныеПоляТЧ, ИмяФайлаБезРасширения, ВидДокумента)
	Если СтруктураДокумента.Свойство("HEAD_SENDER") Тогда
		ОбязательныеПоляТЧ.Вставить("xmlКонтрагентGLN", СтруктураДокумента.HEAD_SENDER);
	КонецЕсли;
	
	Если СтруктураДокумента.Свойство("ДокументТЧ") = Ложь И СтруктураДокумента.Свойство("HEAD_POSITION_") = Истина Тогда
		СтруктураДокумента.Вставить("ДокументТЧ", СтруктураДокумента.HEAD_POSITION_);
	КонецЕсли;    
	
	ЭлементыСтроки = ЭКОМ_ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(ИмяФайлаБезРасширения, "_");
	ДатаЧислоПолученияДокумента = ЭКОМ_ОбщегоНазначения.ЭКОМ_ПреобразоватьВЧислоОбщегоНазначения(ЭлементыСтроки.Получить(1));				
	СтруктураДокумента.Вставить("ДатаЧислоПолученияДокумента", ДатаЧислоПолученияДокумента);
	СтруктураДокумента.Вставить("ВидДокумента", ВидДокумента);   	
КонецПроцедуры

// совпадает для RETANN, RETINS , INVOICE
Процедура ЗаполнитьОбязательныеПоляШапкиДокумента(СтруктураДокумента, ОбязательныеПоля)
	ОбязательныеПоля.Вставить("INFO"              , "");
	ОбязательныеПоля.Вставить("HEAD_RECIPIENT"    , "");
	ОбязательныеПоля.Вставить("HEAD_SENDER"       , "");
	ОбязательныеПоля.Вставить("HEAD_DELIVERYPLACE", "");
	ОбязательныеПоля.Вставить("RECADVDATE"        , Дата(0001, 01, 01));
	ОбязательныеПоля.Вставить("RECADVNUMBER"      , "");
	ОбязательныеПоля.Вставить("DESADVDATE"        , Дата(0001, 01, 01));
	ОбязательныеПоля.Вставить("DESADVNUMBER"      , "");
	ОбязательныеПоля.Вставить("ORDERDATE"         , Дата(0001, 01, 01));
	ОбязательныеПоля.Вставить("ORDERNUMBER"       , ""); 							
	ОбязательныеПоля.Вставить("ACTION"            , "");
	ОбязательныеПоля.Вставить("RETURNDATE"        , Дата(0001, 01, 01));
	ОбязательныеПоля.Вставить("DATE"              , Дата(0001, 01, 01));
	ОбязательныеПоля.Вставить("NUMBER"            , "");
	ОбязательныеПоля.Вставить("ВидДокумента"      , Перечисления.ЭКОМ_ВидыДокументов.ПустаяСсылка()); 
	ОбязательныеПоля.Вставить("ИдФайл"       	  , "");
	
	Для Каждого Поле Из ОбязательныеПоля Цикл
		Если СтруктураДокумента.Свойство(Поле.Ключ) = Ложь Тогда
			СтруктураДокумента.Вставить(Поле.Ключ, Поле.Значение);			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

