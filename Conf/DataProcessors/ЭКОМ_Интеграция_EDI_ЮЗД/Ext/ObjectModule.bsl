	|			И (ЭКОМ_GLN_Контрагент.Объект ССЫЛКА Справочник.Контрагенты)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_ТочкиДоставки КАК ЭКОМ_ТочкиДоставки
	|		ПО ДокументыШапка.xmlТочкаДоставкиGLN = ЭКОМ_ТочкиДоставки.GLN
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_События_ORDER
	|		ПО ДокументыШапка.ЗаказДата = ЭКОМ_Объекты_События_ORDER.ЗаказДата
	|			И ДокументыШапка.ЗаказНомер = ЭКОМ_Объекты_События_ORDER.ЗаказНомер
	|			И (ЭКОМ_Объекты_События_ORDER.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.ORDER_Исходящий))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭКОМ_Документы КАК ЭКОМ_Документы_ORDRSP
				//Docrobot 1.19.0 MOD-1493 [ORDRSP из цепочки, если по номеру и дате заказа их больше 1]
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_ЦепочкиДокументовПокупателя КАК ЭКОМ_ЦепочкиДокументовПокупателя
	|			ПО ЭКОМ_Документы_ORDRSP.Ссылка = ЭКОМ_ЦепочкиДокументовПокупателя.ORDRSP	
	|		ПО ДокументыШапка.ЗаказДата = ЭКОМ_Документы_ORDRSP.ЗаказДата
	|			И (ЭКОМ_Документы_ORDRSP.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.ORDRSP_Входящий))
	|			И ДокументыШапка.ЗаказНомер = ЭКОМ_Документы_ORDRSP.ЗаказНомер
	|			И (ЭКОМ_Документы_ORDRSP.СтатусОбработкиДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_Статусы.Обработан))
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
	|			ЭКОМ_ЦепочкиДокументовПокупателя.ORDERDATE КАК ORDERDATE,
	|			ЭКОМ_ЦепочкиДокументовПокупателя.ORDERNUMBER КАК ORDERNUMBER,
	|			ЭКОМ_ЦепочкиДокументовПокупателя.Заказ КАК Заказ,
	|			ДокументыШапка.ИдФайл КАК ИдФайл,
	|			ЭКОМ_ЦепочкиДокументовПокупателя.ТочкаДоставки КАК ТочкаДоставки
	|		ИЗ
	|			ДокументыШапка КАК ДокументыШапка
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_ЦепочкиДокументовПокупателя КАК ЭКОМ_ЦепочкиДокументовПокупателя
	|				ПО ДокументыШапка.ЗаказДата = ЭКОМ_ЦепочкиДокументовПокупателя.ORDERDATE
	|					И ДокументыШапка.ЗаказНомер = ЭКОМ_ЦепочкиДокументовПокупателя.ORDERNUMBER
	|					И ДокументыШапка.xmlКонтрагентGLN = ЭКОМ_ЦепочкиДокументовПокупателя.xmlКонтрагент
	|					И ДокументыШапка.xmlОрганизацияGLN = ЭКОМ_ЦепочкиДокументовПокупателя.xmlОрганизация) КАК ЦепочкаДокументов
	|		ПО ДокументыШапка.ЗаказДата = ЦепочкаДокументов.ORDERDATE
	|			И ДокументыШапка.ЗаказНомер = ЦепочкаДокументов.ORDERNUMBER
	|			И ДокументыШапка.ИдФайл = ЦепочкаДокументов.ИдФайл
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭКОМ_Документы КАК ЭКОМ_ДокументыПовторный
	|		ПО ДокументыШапка.ЗаказДата = ЭКОМ_ДокументыПовторный.ЗаказДата
	|			И ДокументыШапка.ЗаказНомер = ЭКОМ_ДокументыПовторный.ЗаказНомер
	|			И ДокументыШапка.ВидДокумента = ЭКОМ_ДокументыПовторный.ВидДокумента
	|			И (НЕ ЭКОМ_ДокументыПовторный.ПометкаУдаления)
	|			И ДокументыШапка.НомерНакладной = ЭКОМ_ДокументыПовторный.НакладнаяНомер
	|			И ДокументыШапка.DOCTYPE = ЭКОМ_ДокументыПовторный.ТипДокумента
		//Docrobot 1.19.0 MOD-1493 [Добавлено: И ДокументыШапка.DOCTYPE = ЭКОМ_ДокументыПовторный.ТипДокумента]
	|ГДЕ
		//Docrobot 1.19.0 MOD-1493 [Проверка на ORDRSP из цепочки]
	|	НЕ ЭКОМ_ЦепочкиДокументовПокупателя.ORDRSP ЕСТЬ NULL	
	|СГРУППИРОВАТЬ ПО
	|	ДокументыШапка.ЗаказДата,
	|	ДокументыШапка.ЗаказНомер,
	|	ДокументыШапка.xmlОрганизацияGLN,
	|	ДокументыШапка.xmlКонтрагентGLN,
	|	ДокументыШапка.xmlТочкаДоставкиGLN,
	|	ДокументыШапка.ВидДокумента,
	|	ЭКОМ_Документы.ПометкаУдаления,
	|	ЭКОМ_Документы.СтатусОбработкиДокумента,
	|	ЭКОМ_GLN_Организация.Объект,
	|	ЭКОМ_GLN_Контрагент.Объект,
	|	ЭКОМ_ТочкиДоставки.Объект,
	|	ДокументыШапка.ИдФайл,
	|	ЭКОМ_Объекты_События_ORDER.Документ_Основание,
	|	ЭКОМ_ЦепочкиДокументовПокупателя.ORDRSP.Валюта,
	|	ЦепочкаДокументов.Заказ,
	|	ЦепочкаДокументов.ТочкаДоставки,
	|	ДокументыШапка.ДатаЧислоПолученияДокумента,
	|	ЕСТЬNULL(ЭКОМ_Документы.Ссылка, НЕОПРЕДЕЛЕНО),
	|	ЭКОМ_ЦепочкиДокументовПокупателя.ORDRSP.Ссылка,
	|	ДокументыШапка.ФайлДата,
	|	ДокументыШапка.ФайлНомер,
	|	ДокументыШапка.НомерНакладной,
	|	ДокументыШапка.ДатаНакладной
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаЧислоПолученияДокумента";
	
	Запрос.УстановитьПараметр("ДокументыШапка", ДокументыШапка);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ПроверкаНаПовтор       = Новый Соответствие; // В случае нескольких одинаковых документов с одним и тем же номером и датой
	ПроверкаНаДублирование = Новый Соответствие;
	
	СоответствиеПоОрганизации      = Новый Соответствие;
	СоответствиеПоКонтрагенту      = Новый Соответствие;
	СоответствиеПоТочкамДоставки   = Новый Соответствие;
	
	КэшированныеЗначения = Новый Соответствие;
	Пользователь = НайтиТекущегоПользователя();
	
	ИмяСобытия = "Создание документа Docrobot-DESADV";
	Пока Выборка.Следующий() Цикл
		
		// Для проверки дублирования строк
		Если ПроверкаНаДублирование.Получить(Выборка.ИдФайл) = Неопределено Тогда
			ПроверкаНаДублирование.Вставить(Выборка.ИдФайл, "Строка добавлена");
		Иначе		
			ТекстЛогаСобытий = "Дубль данных, проверьте GLN организации, контрагента, точки доставки ИД документа - " + Выборка.ИдФайл;	
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

			Продолжить;
			
		КонецЕсли;
		
		// Получаем структуру документа
		СтруктураДокумента = Неопределено;
		СтрокаТЗСтруктур = ТЗСтруктур.Найти(Выборка.ИдФайл, "ИдентификаторФайла");
		Если СтрокаТЗСтруктур = Неопределено Тогда		
			ТекстЛогаСобытий = "Не найдена структура документа с ИД = " + Выборка.ИдФайл;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

			Продолжить;
			
		Иначе
			
			СтруктураДокумента = СтрокаТЗСтруктур.СтруктураДокумента;
			
		КонецЕсли;
		
		ПредставлениеДокументаXML = "DESADV № " + Выборка.ФайлНомер + " от " + Формат(Выборка.ФайлДата, "ДФ='dd.MM.yyyy г.'");
		
		Если Выборка.ЭКОМДок = Неопределено Тогда
			ЭКОМДок = Документы.ЭКОМ_Документы.СоздатьДокумент();
		ИначеЕсли (Выборка.ПометкаУдаления = Истина 
			ИЛИ Выборка.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.НеОбработан) 
			ИЛИ НЕ СтруктураДокумента.DOCTYPE = "O" Тогда // Тип документа: O — оригинал, R — замена, D — удаление 
			ЭКОМДок = Выборка.ЭКОМДок.ПолучитьОбъект();
			ЭКОМДок.ПометкаУдаления = ЛОЖЬ;
			ЭКОМДок.ТЧ_Товары.Очистить();
			// Очищение остальных табличных частей документов в гибких настроках при необходимости
			
		Иначе
			ТекстЛогаСобытий = "ЭКОМ документ DESADV уже существует в 1С, номер = " + Выборка.ЭКОМДок.Номер + " от " + Выборка.ЭКОМДок.Дата;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Продолжить;
			
		КонецЕсли;
		
		// Для проверки повтора 
		// 1 случай - когда грузим впервые (ЭКОМ документы еще не созданы)
		КлючПовтора = Строка(Выборка.ВидДокумента) + Строка(Выборка.ФайлНомер) 
		+ Формат(Выборка.ФайлДата, "ДФ=ddMMyy") + СтруктураДокумента.DOCTYPE;
		Если ПроверкаНаПовтор.Получить(КлючПовтора) = Неопределено Тогда
			ПроверкаНаПовтор.Вставить(КлючПовтора, "Строка добавлена");					
		Иначе
			
			Если ЭКОМДок.ЭтоПовторныйДокумент = Истина 
				ИЛИ ЭКОМДок.ЭтоНовый() = Истина Тогда // Признак документа повторный или это новый ЭКОМ документ 				 
				
				ЭКОМДок.ЭтоПовторныйДокумент = Истина;
				
			КонецЕсли;	
			
		КонецЕсли;
		
		// Для проверки повтора 
		// 2 случай - когда повторный документ пришел позже
		Если Выборка.КоличествоЭКОМДокПовторных > 0 
			И (ЭКОМДок.ЭтоПовторныйДокумент = Истина 
			ИЛИ ЭКОМДок.ЭтоНовый() = Истина) Тогда // Есть повторные ЭКОМ документы 			 
			
			ЭКОМДок.ЭтоПовторныйДокумент = Истина;	
			
		КонецЕсли;
		
		//Docrobot 1.19.0 MOD-1493 [Для вывода информации в лог]
		Если НЕ ЭКОМДок.ЭтоПовторныйДокумент 
			И (ВРег(СтруктураДокумента.DOCTYPE) = "R"
				ИЛИ ВРег(СтруктураДокумента.DOCTYPE) = "D") Тогда
			
			ТекстЛогаСобытий = "Уведомление об отгрузке № %ORDERNUMBER% от %ORDERDATE% было %DOCTYPE%!";
			Если ВРег(СтруктураДокумента.DOCTYPE) = "R" Тогда
				ВывестиВКомментарий = Истина;
				ТекстЛогаСобытий = СтрЗаменить(ТекстЛогаСобытий, "%DOCTYPE%", "скорректировано");
			ИначеЕсли ВРег(СтруктураДокумента.DOCTYPE) = "D" Тогда
				ВывестиВКомментарий = Истина;
				ТекстЛогаСобытий = СтрЗаменить(ТекстЛогаСобытий, "%DOCTYPE%", "аннулировано");
			КонецЕсли;
			ТекстЛогаСобытий = СтрЗаменить(ТекстЛогаСобытий, "%ORDERNUMBER%", Выборка.ЗаказНомер);
			ТекстЛогаСобытий = СтрЗаменить(ТекстЛогаСобытий, "%ORDERDATE%", Формат(Выборка.ЗаказДата, "ДФ=dd.MM.yyyy"));
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
		КонецЕсли;
		//Docrobot 1.19.0 MOD-1493 []

		
		Если НЕ ЗначениеЗаполнено(Выборка.Организация) Тогда
			СоответствиеПоОрганизации.Вставить("Организация_" + Выборка.xmlОрганизацияGLN, Выборка.xmlОрганизацияGLN);	
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Выборка.Контрагент) Тогда
			СоответствиеПоКонтрагенту.Вставить("Контрагент_" + Выборка.xmlКонтрагентGLN, Выборка.xmlКонтрагентGLN);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Выборка.ТочкаДоставки) Тогда
			СоответствиеПоТочкамДоставки.Вставить("ТочкаДоставки_" + Выборка.xmlТочкаДоставкиGLN, Выборка.xmlТочкаДоставкиGLN);
		КонецЕсли;
		
		xmlВалюта = "RUB";
		Если ЗначениеЗаполнено(СтруктураДокумента.CURRENCY) Тогда
			xmlВалюта = СтруктураДокумента.CURRENCY;
		КонецЕсли;
		
		ЗаказПоставщику = Выборка.ЗаказПоставщику;
		Если НЕ ЗначениеЗаполнено(ЗаказПоставщику) Тогда
			ЗаказПоставщику = Выборка.ЦепочкаЗаказ;
		КонецЕсли; 
		
		ТочкаДоставки = Выборка.ТочкаДоставки;
		Если НЕ ЗначениеЗаполнено(ТочкаДоставки) Тогда
			ТочкаДоставки = Выборка.ЦепочкаТочкаДоставки;
		КонецЕсли;
		
	    ВалютаСсылка = КэшированныеЗначения.Получить(xmlВалюта);
		Если ВалютаСсылка = Неопределено Тогда
			ВалютаСсылка = ПолучитьСсылкуВалютыДокумента(xmlВалюта);
			КэшированныеЗначения.Вставить(xmlВалюта, ВалютаСсылка);
		КонецЕсли;

		// Шапка
		ЭКОМДок.Организация               = Выборка.Организация;
		ЭКОМДок.xmlОрганизация            = Выборка.xmlОрганизацияGLN;
		ЭКОМДок.ВидДокумента              = Перечисления.ЭКОМ_ВидыДокументов.DESADV_Входящий;
		ЭКОМДок.Контрагент                = Выборка.Контрагент;
		ЭКОМДок.xmlКонтрагент             = Выборка.xmlКонтрагентGLN;
		ЭКОМДок.ФайлНомер                 = Выборка.ФайлНомер;
		ЭКОМДок.ФайлДата                  = Выборка.ФайлДата;
		ЭКОМДок.Дата                      = ТекущаяДата();
		ЭКОМДок.ЗаказНомер                = Выборка.ЗаказНомер;
		ЭКОМДок.ЗаказДата                 = Выборка.ЗаказДата;
		ЭКОМДок.xmlВалюта                 = xmlВалюта;
		ЭКОМДок.ИмяФайла                  = СтрокаТЗСтруктур.ИмяФайлаXML;	
		ЭКОМДок.ДатаПоставки              = СтруктураДокумента.DELIVERYDATE;
		ЭКОМДок.Документ1С                = ЗаказПоставщику;
		ЭКОМДок.ТочкаДоставки             = ТочкаДоставки;
		ЭКОМДок.xmlТочкаДоставки          = Выборка.xmlТочкаДоставкиGLN;
		ЭКОМДок.ИнформацияПоДокументу     = СтруктураДокумента.INFO;
		ЭКОМДок.НомерТранзакции           = СтруктураДокумента.HEAD_EDIINTERCHANGEID;
		ЭКОМДок.НакладнаяДата             = Выборка.ДатаНакладной;
		ЭКОМДок.НакладнаяНомер            = Выборка.НомерНакладной;
		ЭКОМДок.Ответственный             = Пользователь;
		ЭКОМДок.Валюта                    = ВалютаСсылка;
		ЭКОМДок.ТипДокумента              = СтруктураДокумента.DOCTYPE;
		ЭКОМДок.Версия                    = СтруктураДокумента.VERSION;
		ЭКОМДок.НомерДоговораНаПоставку   = СтруктураДокумента.CAMPAIGNINFO_CAMPAIGNNUMBER;
		
		// ТЧ товары                            
		СуммаВсего       = 0;
		СуммаВсегоНДС    = 0;
		ТекстОшибки      = "";
		ТекстКомментария = "";
		ПроверкаНаДублированиеТЧ = Новый Соответствие;
		
		Отбор = Новый Структура();
		Отбор.Вставить("ИдентификаторФайла", Выборка.ИдФайл);
		МассивСтрок = ДокументыТабличнаяЧасть.НайтиСтроки(Отбор);
		
		Для Каждого СтруктСтрока Из МассивСтрок Цикл
			
			СоставнойШтрихКод = СокрЛП(СтруктСтрока.НомерСтрокиТЧ) + "_" + СокрЛП(СтруктСтрока.ШтрихКод);
			Если ЗначениеЗаполнено(СтруктСтрока.ШтрихКод) Тогда
				Если ПроверкаНаДублированиеТЧ.Получить(СоставнойШтрихКод) = Неопределено Тогда
					ПроверкаНаДублированиеТЧ.Вставить(СоставнойШтрихКод, "Строка добавлена");
				Иначе
					
					ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
					+ "Дубль данных, проверьте номенклатуру - " + СтруктСтрока.ШтрихКод + ", строка - " + СокрЛП(СтруктСтрока.НомерСтрокиТЧ);
					
					Продолжить;
					
				КонецЕсли;		
			КонецЕсли;
			
			ЦенаБезНДС   = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.PRICE);
			ЦенаСНДС     = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.PRICEWITHVAT);
			знКоличество = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.DELIVEREDQUANTITY);
			
			СтавкаНДСДок = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.TAXRATE);
			Если НЕ ЗначениеЗаполнено(СтавкаНДСДок) Тогда
				Если ЦенаБезНДС <> ЦенаСНДС	
					И ЦенаБезНДС <> 0
					И ЦенаСНДС   <> 0 Тогда
					СтавкаНДСДок = Окр(((ЦенаСНДС - ЦенаБезНДС) / ЦенаБезНДС) * 100);
				Иначе
					СтавкаНДСДок = 0;
				КонецЕсли;		
			КонецЕсли;
			
			СуммаСНДС = ЦенаСНДС * знКоличество;
			
			Если ЦенаБезНДС = 0 Тогда
				Если (СуммаСНДС > 0) И (знКоличество > 0) Тогда
					ЦенаСНДС      = Окр(СуммаСНДС/ ?(знКоличество = 0, 1, знКоличество), 4);
					ЦенаБезНДС    = Окр( (ЦенаСНДС * 100) / (100 + СтавкаНДСДок) , 4);
				КонецЕсли;
			КонецЕсли;
			
			Если ЦенаСНДС = 0 Тогда
				ЦенаСНДС  = Окр( (ЦенаБезНДС * (100 + СтавкаНДСДок)) / 100 , 4);
				СуммаСНДС = ЦенаСНДС * знКоличество;
			КонецЕсли;	
			
			СуммаБезНДС = ЦенаБезНДС * знКоличество;		
			Если СуммаБезНДС = 0 Тогда
				Если (СуммаСНДС > 0) Тогда 
					СуммаБезНДС = Окр( (СуммаСНДС * 100) / (100 + СтавкаНДСДок) , 4);	
				КонецЕсли;
			КонецЕсли;
			
			Если СуммаСНДС = 0 И СтавкаНДСДок <> 0 Тогда
				СуммаСНДС = Окр((СуммаБезНДС * (100 + СтавкаНДСДок)) / 100 , 2);
			КонецЕсли;
			
			СуммаНДС = СуммаСНДС - СуммаБезНДС;
			
			НовСтрока                         = ЭКОМДок.ТЧ_Товары.Добавить();
			НовСтрока.xmlЕдиницаИзмерения     = СтруктСтрока.DELIVEREDUNIT;
			НовСтрока.Цена                    = ЦенаБезНДС;
			НовСтрока.ЦенаСНДС                = ЦенаСНДС;
			НовСтрока.ОписаниеПродукта        = ?(ЗначениеЗаполнено(СтруктСтрока.ОписаниеПродукта), СтруктСтрока.ОписаниеПродукта, СтруктСтрока.ОписаниеПродуктаИзХарактеристики);
			НовСтрока.КоличествоЗаказанное    = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.ORDEREDQUANTITY);
			НовСтрока.КоличествоПоставляемое  = знКоличество;
			НовСтрока.Сумма                   = СуммаБезНДС;
			НовСтрока.СтавкаНДС               = СтавкаНДСДок;
			НовСтрока.СуммаНДС                = СуммаНДС;
			НовСтрока.Сумма_с_НДС             = СуммаСНДС;
			НовСтрока.НомерПродукта           = СтруктСтрока.ШтрихКод;
			НовСтрока.НомерПродуктаПоставщика = СтруктСтрока.КодПоставщика;
			НовСтрока.НомерПродуктаПокупателя = СтруктСтрока.КодПокупателя;
			НовСтрока.Номенклатура            = СтруктСтрока.Номенклатура;
			НовСтрока.ЕдиницаИзмерения        = СтруктСтрока.ЕдиницаИзмерения;
			НовСтрока.ХарактеристикиНоменклатуры = СтруктСтрока.ХарактеристикиНоменклатуры;
			НовСтрока.НомерСтрокиXML             = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.НомерСтрокиТЧ);
			НовСтрока.КоличествоВУпаковке        = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.QUANTITYOFCUINTU); 
			НовСтрока.КалибрУпаковки          = СтруктСтрока.CALIBRE;
            НовСтрока.ТипФасовки              = СтруктСтрока.PACKINGTYPE;
            НовСтрока.КоличествоВФасовке      = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.PACKINGQUANTITY);
			НовСтрока.БазоваяЕдиницаТовара    = СтруктСтрока.PACKINGUNIT;

			СуммаВсегоНДС = СуммаВсегоНДС + СуммаНДС;
			СуммаВсего    = СуммаВсего + СуммаБезНДС + СуммаНДС;
			
			// Сравниваем количество заказанное с поставляемым
			Если НЕ НовСтрока.КоличествоЗаказанное = НовСтрока.КоличествоПоставляемое Тогда
				ТекстКомментария = ТекстКомментария + ?(ЗначениеЗаполнено(ТекстКомментария), Символы.ПС, "")
				//Docrobot 1.20.0 MOD-1738 [добавлен формат чисел]
				+ "По штрихкоду " + НовСтрока.НомерПродукта + " (" + НовСтрока.ОписаниеПродукта + ")" + " есть расхождения, заказано - " + Формат(НовСтрока.КоличествоЗаказанное,"ЧДЦ=3; ЧРД=.; ЧН=0; ЧГ=0") 
				+ ", будет поставлено - " + Формат(НовСтрока.КоличествоПоставляемое,"ЧДЦ=3; ЧРД=.; ЧН=0; ЧГ=0");			
			КонецЕсли;
			
		КонецЦикла;
		
		ЭКОМДок.СуммаДокументаВсего = СуммаВсего;
		ЭКОМДок.СуммаНДСВсего       = СуммаВсегоНДС;
		ЭКОМДок.Комментарий         = ТекстКомментария;
		
		ЭКОМДок.ТекстОшибки = ""; // Очищаем ошибки документа
		ЭКОМДок.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.ПустаяСсылка(); // Обнуляем статус документ
		
		// Номенклатура, ЕдиницаИзмерения - необходимо заполнять в гибких настройках
		ВыполнитьДополнительныеДействия(ЭКОМДок, "Входящий DESADV",
		СтруктураДокумента,
		МассивЛогаСобытий,
		ТекстОшибки,
		,
		,
		,
		,
		КэшированныеЗначения);
		
		ЭКОМДок.ТЧ_Товары.Сортировать("НомерСтрокиXML Возр");
		
		// По умолчанию документ загружается и записывается, если ЭКОМ документ не нужен в гибких настройках необходимо поставить НеЗагружатьДокумент = Истина 
		Если ЭКОМДок.НеЗагружатьДокумент = Ложь Тогда
			
			СтруктураРегистраСобытий = Новый Структура; 
			СтруктураРегистраСобытий.Вставить("ДатаЗаписи"                  , ТекущаяДата());
			СтруктураРегистраСобытий.Вставить("Контрагент"                  , ЭКОМДок.Контрагент);
			СтруктураРегистраСобытий.Вставить("Организация"                 , ЭКОМДок.Организация);
			СтруктураРегистраСобытий.Вставить("НаправлениеОбмена"           , Перечисления.ЭКОМ_НаправлениеОбмена.Входящий);
			СтруктураРегистраСобытий.Вставить("ФайлИмя"                     , СтрокаТЗСтруктур.ИмяФайлаXML);
			СтруктураРегистраСобытий.Вставить("ЗаказДата"                   , ЭКОМДок.ЗаказДата);					
			СтруктураРегистраСобытий.Вставить("ЗаказНомер"                  , ЭКОМДок.ЗаказНомер);
			СтруктураРегистраСобытий.Вставить("СтруктураФайла"              , Новый ХранилищеЗначения(СтруктураДокумента,  Новый СжатиеДанных(9)));
			СтруктураРегистраСобытий.Вставить("Идентификатор"               , СтруктураДокумента.ИдФайл);
			
			Для Каждого Стр Из ЭКОМДок.ТЧ_Товары Цикл			
				// Проверка заполнения документа		
				Если НЕ ЗначениеЗаполнено(Стр.ЕдиницаИзмерения) Тогда	
					ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "") 
					+ "В строке № " + СокрЛП(Стр.НомерСтроки )+ " " + "не заполнена единица измерения. (смотрите гибкие настройки или регистр сведений ЭКОМ_НоменклатураКонтрагентов)" 
					+ "(" + Стр.xmlЕдиницаИзмерения + ")"; 
				КонецЕсли;			
				Если НЕ ЗначениеЗаполнено(Стр.Номенклатура) Тогда
					ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
					+ "В строке № " + СокрЛП(Стр.НомерСтроки) + " " + "не заполнена номенклатура." 
					+ "(" + Стр.НомерПродукта + ")";
				КонецЕсли;
				
			КонецЦикла;
			
			// Проверяем количество заказнное с количеством поставляемым 
			Если ЗначениеЗаполнено(Выборка.ORDRSP) Тогда
				Для каждого Стр Из Выборка.ORDRSP.ТЧ_Товары  Цикл
					НайденнаяСтрока = ЭКОМДок.ТЧ_Товары.Найти(Стр.Номенклатура, "Номенклатура");
					Если НайденнаяСтрока = Неопределено Тогда
						ЭКОМДок.Комментарий = СокрЛП(ЭКОМДок.Комментарий) + ?(ЗначениеЗаполнено(ЭКОМДок.Комментарий), Символы.ПС, "")
						//Docrobot 1.20.0 MOD-1738 [добавлен формат чисел]
						+ "По штрихкоду " + Стр.НомерПродукта + " (" + Стр.ОписаниеПродукта + ")" + " есть расхождения, заказано - " 
						+ Формат(Стр.КоличествоЗаказанное,"ЧДЦ=3; ЧРД=.; ЧН=0; ЧГ=0")+ ", будет поставлено - 0"; 				
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ЭКОМДок.Организация) Тогда
				ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
				+ "Не заполнена организация." + "(" + ЭКОМДок.xmlОрганизация + ")"; 
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ЭКОМДок.Контрагент) Тогда
				ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
				+ "Не заполнен контрагент." + "(" + ЭКОМДок.xmlКонтрагент + ")";
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ЭКОМДок.ТочкаДоставки) Тогда
				ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
				+ "Не заполнена точка доставки." + "(" + ЭКОМДок.xmlТочкаДоставки + ")";
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ЭКОМДок.Валюта) Тогда
				ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
				+ "Не заполнена валюта." + "(" + ЭКОМДок.xmlВалюта + ")";
			КонецЕсли;
			
			ДокументОбработан = ПроверитьОбработкуДокумента(ТекстОшибки, ЭКОМДок, СтруктураДокумента, СтруктураРегистраСобытий, ПредставлениеДокументаXML, МассивЛогаСобытий);
			Если ДокументОбработан = Ложь Тогда
				Продолжить;			
			КонецЕсли;
			
		Иначе 			
			СтруктураДокумента.Вставить("Обработан", Ложь);
			ТекстЛогаСобытий = "В гибких настройках указано не загружать документ - " + ПредставлениеДокументаXML;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ СоответствиеПоОрганизации.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоОрганизации     , "Организация_");
	КонецЕсли;
	Если НЕ СоответствиеПоКонтрагенту.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоКонтрагенту     , "Контрагент_");
	КонецЕсли;
	Если НЕ СоответствиеПоТочкамДоставки.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоТочкамДоставки  , "ТочкаДоставки_");
	КонецЕсли;
	
КонецПроцедуры

Процедура СоздатьЭКОМ_ДокЗаказПокупателяORDER(ТЗСтруктур, ДокументыШапка, пДокументыТабличнаяЧасть, МассивЛогаСобытий) Экспорт
	
	// Запрос к табличной части
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	пДокументыТабличнаяЧасть.HEAD_POSITION_POSITIONNUMBER КАК НомерСтрокиТЧ,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_PRODUCT, 0, 100) КАК ШтрихКод,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_PRODUCTIDSUPPLIER, 0, 100) КАК КодПоставщика,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_PRODUCTIDBUYER, 0, 100) КАК КодПокупателя,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.xmlКонтрагентGLN, 0, 100) КАК xmlКонтрагентGLN,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_ORDERUNIT, 0, 100) КАК xmlЕдиницаИзмерения,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.ИдентификаторФайла, 0, 250) КАК ИдентификаторФайла,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_CHARACTERISTIC_DESCRIPTION, 0, 250) КАК ОписаниеПродуктаИзХарактеристики,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_DESCRIPTION, 0, 250) КАК ОписаниеПродукта,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_ORDERPRICE, 0, 250) КАК ORDERPRICE,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_PRICEWITHVAT, 0, 250) КАК PRICEWITHVAT,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_VAT, 0, 250) КАК VAT,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_ORDEREDQUANTITY, 0, 250) КАК ORDEREDQUANTITY,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_QUANTITYOFCUINTU, 0, 250) КАК QUANTITYOFCUINTU,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_CALIBRE, 0, 250) КАК CALIBRE,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_PACKING_PACKINGTYPE, 0, 250) КАК PACKINGTYPE,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_PACKING_PACKINGQUANTITY, 0, 250) КАК PACKINGQUANTITY,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_PACKING_PACKINGUNIT, 0, 250) КАК PACKINGUNIT
	|ПОМЕСТИТЬ пДокументыТабличнаяЧасть
	|ИЗ
	|	&пДокументыТабличнаяЧасть КАК пДокументыТабличнаяЧасть
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	пДокументыТабличнаяЧасть.xmlКонтрагентGLN КАК xmlКонтрагентGLN,
	|	пДокументыТабличнаяЧасть.НомерСтрокиТЧ КАК НомерСтрокиТЧ,
	|	пДокументыТабличнаяЧасть.ШтрихКод КАК ШтрихКод,
	|	пДокументыТабличнаяЧасть.КодПоставщика КАК КодПоставщика,
	|	пДокументыТабличнаяЧасть.КодПокупателя КАК КодПокупателя,
	|	ЭКОМ_GLN.Объект КАК Контрагент,
	|	пДокументыТабличнаяЧасть.xmlЕдиницаИзмерения КАК xmlЕдиницаИзмерения,
	|	пДокументыТабличнаяЧасть.ИдентификаторФайла,
	|	пДокументыТабличнаяЧасть.ОписаниеПродукта,
	|	пДокументыТабличнаяЧасть.ОписаниеПродуктаИзХарактеристики,
	|	пДокументыТабличнаяЧасть.ORDERPRICE,
	|	пДокументыТабличнаяЧасть.PRICEWITHVAT,
	|	пДокументыТабличнаяЧасть.VAT,
	|	пДокументыТабличнаяЧасть.ORDEREDQUANTITY,
	|	пДокументыТабличнаяЧасть.QUANTITYOFCUINTU,
	|	пДокументыТабличнаяЧасть.CALIBRE,
	|	пДокументыТабличнаяЧасть.PACKINGTYPE,
	|	пДокументыТабличнаяЧасть.PACKINGQUANTITY,
	|	пДокументыТабличнаяЧасть.PACKINGUNIT
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	пДокументыТабличнаяЧасть КАК пДокументыТабличнаяЧасть
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN
	|		ПО пДокументыТабличнаяЧасть.xmlКонтрагентGLN = ЭКОМ_GLN.GLN
	|			И (ЭКОМ_GLN.Объект ССЫЛКА Справочник.Контрагенты)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ЭКОМ_НоменклатураКонтрагентов.Номенклатура, НЕОПРЕДЕЛЕНО) КАК Номенклатура,
	|	ЕСТЬNULL(ЭКОМ_НоменклатураКонтрагентов.ХарактеристикаНоменклатуры, НЕОПРЕДЕЛЕНО) КАК ХарактеристикаНоменклатуры,
	|	ЭКОМ_НоменклатураКонтрагентов.ЕдиницаНоменклатурыКонтрагента КАК ЕдиницаИзмерения,
	|	ЭКОМ_ЗначениеДополнительныхКонстант.ЗначениеДополнительнойКонстанты КАК ЕдиницаИзмеренияПоУмолчанию,
	|	ВТ.ИдентификаторФайла,
	|	ВТ.НомерСтрокиТЧ,
	|	ВТ.ШтрихКод,
	|	ВТ.КодПоставщика,
	|	ВТ.КодПокупателя,
	|	ВТ.xmlЕдиницаИзмерения,
	|	ВТ.ОписаниеПродукта,
	|	ВТ.ОписаниеПродуктаИзХарактеристики,
	|	ВТ.ORDERPRICE,
	|	ВТ.PRICEWITHVAT,
	|	ВТ.VAT,
	|	ВТ.ORDEREDQUANTITY,
	|	ВТ.QUANTITYOFCUINTU,
	|	ВТ.CALIBRE,
	|	ВТ.PACKINGTYPE,
	|	ВТ.PACKINGQUANTITY,
	|	ВТ.PACKINGUNIT
	|ИЗ
	|	ВТ КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_НоменклатураКонтрагентов КАК ЭКОМ_НоменклатураКонтрагентов
	|		ПО ВТ.ШтрихКод = ЭКОМ_НоменклатураКонтрагентов.ШтрихКодНоменклатурыКонтрагента
	|			И ВТ.Контрагент = ЭКОМ_НоменклатураКонтрагентов.Контрагент
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_ЗначениеДополнительныхКонстант КАК ЭКОМ_ЗначениеДополнительныхКонстант
	|		ПО (ЭКОМ_ЗначениеДополнительныхКонстант.ДополнительнаяКонстанта = ""ЕдиницаИзмерения_"" + ВТ.xmlЕдиницаИзмерения)
	|			И (ЭКОМ_ЗначениеДополнительныхКонстант.Измерение = ""Единица измерения"")";
	Запрос.УстановитьПараметр("пДокументыТабличнаяЧасть", пДокументыТабличнаяЧасть);
	РезультатЗапроса = Запрос.Выполнить();
	ДокументыТабличнаяЧасть = РезультатЗапроса.Выгрузить();
	ДокументыТабличнаяЧасть.Индексы.Добавить("ИдентификаторФайла"); 
	
	// Запрос по шапке документов
	Запрос = Новый Запрос;	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПОДСТРОКА(ДокументыШапка.SUPORDER, 1, 100) КАК SUPORDER,
	|	ДокументыШапка.DATE КАК ЗаказДата,
	|	ПОДСТРОКА(ДокументыШапка.NUMBER, 1, 100) КАК ЗаказНомер,
	|	ПОДСТРОКА(ДокументыШапка.HEAD_RECIPIENT, 1, 100) КАК xmlОрганизацияGLN,
	|	ПОДСТРОКА(ДокументыШапка.xmlКонтрагентGLN, 1, 100) КАК xmlКонтрагентGLN,
	|	ПОДСТРОКА(ДокументыШапка.HEAD_DELIVERYPLACE, 1, 100) КАК xmlТочкаДоставкиGLN,
	|	ПОДСТРОКА(ДокументыШапка.HEAD_INVOICEPARTNER, 1, 100) КАК INVOICEPARTNER,
	|	ДокументыШапка.ВидДокумента КАК ВидДокумента,
	|	ПОДСТРОКА(ДокументыШапка.DOCTYPE, 0, 100) КАК DOCTYPE,
	|	ПОДСТРОКА(ДокументыШапка.ИдФайл, 1, 250) КАК ИдФайл,
	|	ДокументыШапка.ДатаЧислоПолученияДокумента КАК ДатаЧислоПолученияДокумента
	|ПОМЕСТИТЬ ДокументыШапка
	|ИЗ
	|	&ДокументыШапка КАК ДокументыШапка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ЭКОМ_Документы.Ссылка) КАК Ссылка,
	|	ДокументыШапка.ЗаказНомер КАК ЗаказНомер
	|ПОМЕСТИТЬ АктуальныйДокументЭКОМ
	|ИЗ
	|	ДокументыШапка КАК ДокументыШапка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭКОМ_Документы КАК ЭКОМ_Документы
	|		ПО (ВЫБОР
	|				КОГДА ДокументыШапка.DOCTYPE = ""O""
	|					ТОГДА ДокументыШапка.ЗаказДата = ЭКОМ_Документы.ЗаказДата
	|				ИНАЧЕ НАЧАЛОПЕРИОДА(ДокументыШапка.ЗаказДата, ДЕНЬ) >= НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(ЭКОМ_Документы.ЗаказДата, МЕСЯЦ, -1), ДЕНЬ)
	|			КОНЕЦ)
	|			И ДокументыШапка.ЗаказНомер = ЭКОМ_Документы.ЗаказНомер
	|			И ДокументыШапка.ВидДокумента = ЭКОМ_Документы.ВидДокумента
	|			И ДокументыШапка.xmlКонтрагентGLN = ЭКОМ_Документы.xmlКонтрагент
	|			И ДокументыШапка.xmlОрганизацияGLN = ЭКОМ_Документы.xmlОрганизация
	|ГДЕ
	|	ЭКОМ_Документы.АктуальныйДокумент
	|
	|СГРУППИРОВАТЬ ПО
	|	ДокументыШапка.ЗаказНомер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДокументыШапка.SUPORDER,
	|	ЕСТЬNULL(АктуальныйДокументЭКОМ.Ссылка, НЕОПРЕДЕЛЕНО) КАК ЭКОМДок,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(АктуальныйДокументЭКОМ.Ссылка.ПометкаУдаления, ЛОЖЬ)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ПометкаУдаления,
	|	ЕСТЬNULL(АктуальныйДокументЭКОМ.Ссылка.СтатусОбработкиДокумента, ЗНАЧЕНИЕ(Перечисление.ЭКОМ_Статусы.НеОбработан)) КАК СтатусОбработкиДокумента,
	|	ЕСТЬNULL(АктуальныйДокументЭКОМ.Ссылка.ИмяФайла, ВЫРАЗИТЬ("""" КАК СТРОКА(300))) КАК ИмяФайла,
	|	ЭКОМ_GLN_Организация.Объект КАК Организация,
	|	ЭКОМ_GLN_Контрагент.Объект КАК Контрагент,
	|	ЭКОМ_ТочкиДоставки.Объект КАК ТочкаДоставки,
	|	ЭКОМ_ИнфоПоля.Ссылка КАК ЭКОМ_ИнфоПоля,
	|	ДокументыШапка.ИдФайл КАК ИдФайл,
	|	ДокументыШапка.ВидДокумента КАК ВидДокумента,
	|	ДокументыШапка.ЗаказДата КАК ЗаказДата,
	|	ДокументыШапка.ЗаказНомер КАК ЗаказНомер,
	|	ДокументыШапка.xmlКонтрагентGLN КАК xmlКонтрагентGLN,
	|	ДокументыШапка.DOCTYPE КАК DOCTYPE,
	|	ДокументыШапка.xmlТочкаДоставкиGLN КАК xmlТочкаДоставкиGLN,
	|	ДокументыШапка.INVOICEPARTNER КАК INVOICEPARTNER,
	|	ДокументыШапка.xmlОрганизацияGLN КАК xmlОрганизацияGLN,
	|	ВЫБОР
	|		КОГДА НЕ ЭКОМ_Документы.Ссылка ЕСТЬ NULL
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ПовторнаяЗагрузкаФайла,
	|	ЭКОМ_Документы.Ссылка КАК ПовторнаяЗагрузкаСсылка,
	|	ЭКОМ_Документы.СтатусОбработкиДокумента КАК ПовторнаяЗагрузкаСтатусОбработки
	|ИЗ
	|	ДокументыШапка КАК ДокументыШапка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Организация
	|		ПО ДокументыШапка.xmlОрганизацияGLN = ЭКОМ_GLN_Организация.GLN
	|			И (НЕ ЭКОМ_GLN_Организация.Объект ССЫЛКА Справочник.Контрагенты)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Контрагент
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭКОМ_ИнфоПоля КАК ЭКОМ_ИнфоПоля
	|			ПО ЭКОМ_GLN_Контрагент.Контрагент_ФорматЭСФ = ЭКОМ_ИнфоПоля.ФорматУПД
	|		ПО ДокументыШапка.xmlКонтрагентGLN = ЭКОМ_GLN_Контрагент.GLN
	|			И (ЭКОМ_GLN_Контрагент.Объект ССЫЛКА Справочник.Контрагенты)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_ТочкиДоставки КАК ЭКОМ_ТочкиДоставки
	|		ПО ДокументыШапка.xmlТочкаДоставкиGLN = ЭКОМ_ТочкиДоставки.GLN
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭКОМ_Документы КАК ЭКОМ_Документы
	|		ПО (ВЫБОР
	|				КОГДА ДокументыШапка.DOCTYPE = ""O""
	|					ТОГДА ДокументыШапка.ЗаказДата = ЭКОМ_Документы.ЗаказДата
	|				ИНАЧЕ НАЧАЛОПЕРИОДА(ДокументыШапка.ЗаказДата, ДЕНЬ) >= НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(ЭКОМ_Документы.ЗаказДата, МЕСЯЦ, -1), ДЕНЬ)
	|			КОНЕЦ)
	|			И ДокументыШапка.ЗаказНомер = ЭКОМ_Документы.ЗаказНомер
	|			И ДокументыШапка.ВидДокумента = ЭКОМ_Документы.ВидДокумента
	|			И ДокументыШапка.xmlКонтрагентGLN = ЭКОМ_Документы.xmlКонтрагент
	|			И ДокументыШапка.xmlОрганизацияGLN = ЭКОМ_Документы.xmlОрганизация
	|			И (ДокументыШапка.ИдФайл + "".xml"" = (ВЫРАЗИТЬ(ЭКОМ_Документы.ИмяФайла КАК СТРОКА(300))))
	|		ЛЕВОЕ СОЕДИНЕНИЕ АктуальныйДокументЭКОМ КАК АктуальныйДокументЭКОМ
	|		ПО ДокументыШапка.ЗаказНомер = АктуальныйДокументЭКОМ.ЗаказНомер
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДокументыШапка.ДатаЧислоПолученияДокумента";
	//Docrobot 1.19.0 MOD-1676 Добавлено соединение в запрос для шапки, для исключения дублирования строк в выборке
	Запрос.УстановитьПараметр("ДокументыШапка", ДокументыШапка);
	РезультатЗапроса = Запрос.Выполнить();
	
	ПроверкаНаДублирование = Новый Соответствие;
	
	СоответствиеПоОрганизации      = Новый Соответствие;
	СоответствиеПоКонтрагенту      = Новый Соответствие;
	СоответствиеПоТочкамДоставки   = Новый Соответствие;
	СоответствиеПоНоменклатуре     = Новый Соответствие;
	
	Пользователь = НайтиТекущегоПользователя();
	
	КэшированныеЗначенияЗапроса = Новый ТаблицаЗначений;
	КэшированныеЗначенияЗапроса.Колонки.Добавить("ЗаказНомер", 		 Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(100)));
	КэшированныеЗначенияЗапроса.Колонки.Добавить("ЗаказДата", 		 Новый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	КэшированныеЗначенияЗапроса.Колонки.Добавить("DOCTYPE", 		 Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(100)));
	КэшированныеЗначенияЗапроса.Колонки.Добавить("xmlКонтрагентGLN", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(100)));
	КэшированныеЗначенияЗапроса.Колонки.Добавить("ЭКОМДок", 		 Новый ОписаниеТипов("ДокументСсылка.ЭКОМ_Документы"));
	КэшированныеЗначенияЗапроса.Колонки.Добавить("ПометкаУдаления",  Новый ОписаниеТипов("Булево"));
	КэшированныеЗначенияЗапроса.Колонки.Добавить("ИмяФайла", 		 Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(300)));	
	КэшированныеЗначенияЗапроса.Индексы.Добавить("ЗаказНомер, xmlКонтрагентGLN");
	КэшированныеЗначенияЗапроса.Индексы.Добавить("ЭКОМДок");
	
	КэшированныеЗначения = Новый Соответствие;
	
	ИмяСобытия     = "Создание документа Docrobot-ORDER";
	ДокументыШапка = РезультатЗапроса.Выгрузить();
	
	ОбрабатыватьПовторные = Настройка_Параметр_Прочитать("ЭКОМ_ОбрабатыватьПовторныеORDER", Ложь);		
	Для Каждого Выборка ИЗ ДокументыШапка Цикл
		// Для проверки дублирования строк
		Если ПроверкаНаДублирование.Получить(Выборка.ИдФайл) = Неопределено Тогда
			ПроверкаНаДублирование.Вставить(Выборка.ИдФайл, "Строка добавлена");
		Иначе
			
			ТекстЛогаСобытий = "Дубль данных, проверьте GLN организации, контрагента, точки доставки ИД документа - " + Выборка.ИдФайл;	
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			Продолжить;
			
		КонецЕсли;
		
		// Получаем структуру документа
		СтруктураДокумента = Неопределено;
		СтрокаТЗСтруктур = ТЗСтруктур.Найти(Выборка.ИдФайл, "ИдентификаторФайла");
		Если СтрокаТЗСтруктур = Неопределено Тогда		
			ТекстЛогаСобытий = "Не найдена структура документа с ИД = " + Выборка.ИдФайл;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Продолжить;
			
		Иначе
			
			СтруктураДокумента = СтрокаТЗСтруктур.СтруктураДокумента;
			
		КонецЕсли; 			
			
		ПредставлениеДокументаXML = Строка(Выборка.ВидДокумента) + " № " + Выборка.ЗаказНомер + " от " + Формат(Выборка.ЗаказДата, "ДФ='dd.MM.yyyy ""г.""'");
		
		Если Выборка.ПовторнаяЗагрузкаФайла Тогда
			ЭКОМДок = Выборка.ПовторнаяЗагрузкаСсылка;
		Иначе
			ЭКОМДок = Выборка.ЭКОМДок;
		КонецЕсли;
		
		Если ЭКОМДок = Неопределено Тогда
			ОтборДляКэша = Новый Структура("ЗаказНомер, xmlКонтрагентGLN", Выборка.ЗаказНомер, Выборка.xmlКонтрагентGLN);
			СтрокиКэша = КэшированныеЗначенияЗапроса.НайтиСтроки(ОтборДляКэша);
			Если НЕ СтрокиКэша.Количество() = 0 Тогда
				
				Для Каждого СтрокаКэша Из СтрокиКэша Цикл
					Если ?(ВРег(Выборка.DOCTYPE) = "O" И ВРег(СтрокаКэша.DOCTYPE) = "O",
						Выборка.ЗаказДата = СтрокаКэша.ЗаказДата, Выборка.ЗаказДата >= ДобавитьМесяц(СтрокаКэша.ЗаказДата, -2)) Тогда
						
						ЭКОМДок = СтрокаКэша.ЭКОМДок;
						Выборка.ПометкаУдаления = СтрокаКэша.ПометкаУдаления;
						Выборка.ИмяФайла 		= СтрокаКэша.ИмяФайла;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		Если ЭКОМДок = Неопределено Тогда
			Если ВРег(СтруктураДокумента.DOCTYPE) = "D" Тогда// Принимается отмена при отсутствии оригинала. Такой документ пропускаем и удаляем на платформе
				ТекстЛогаСобытий = "Не найден заказ-основание для аннулирования %ORDERNUMBER% от %ORDERDATE%";
				ТекстЛогаСобытий = СтрЗаменить(ТекстЛогаСобытий, "%ORDERNUMBER%", Выборка.ЗаказНомер);
				ТекстЛогаСобытий = СтрЗаменить(ТекстЛогаСобытий, "%ORDERDATE%", Формат(Выборка.ЗаказДата, "ДФ=dd.MM.yyyy"));
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
				
				СтруктураДокумента.Вставить("Обработан", Истина);
				
				Продолжить;
			Иначе // Создание нового документа (O или R при отсутствии O)
				ЭКОМДок = Документы.ЭКОМ_Документы.СоздатьДокумент();
				ЭКОМДок.АктуальныйДокумент = Истина;
			КонецЕсли;
		ИначеЕсли Выборка.ПовторнаяЗагрузкаФайла  // Редактирование ранее принятого документа (полностью очищаем текущий документ)
			И Выборка.ПовторнаяЗагрузкаСтатусОбработки = Перечисления.ЭКОМ_Статусы.НеОбработан Тогда
			ЭКОМДок = ЭКОМДок.ПолучитьОбъект();
			АктуальныйДокумент   = ЭКОМДок.АктуальныйДокумент;
			ЭтоПовторныйДокумент = ЭКОМДок.ЭтоПовторныйДокумент;
			
			ЗаполнитьЗначенияСвойств(ЭКОМДок, Документы.ЭКОМ_Документы.ПустаяСсылка(), , "Номер, Дата");
			
			ЭКОМДок.ПометкаУдаления		 = Ложь;
			ЭКОМДок.АктуальныйДокумент   = АктуальныйДокумент;
			ЭКОМДок.ЭтоПовторныйДокумент = ЭтоПовторныйДокумент;
			ЭКОМДок.ТЧ_Товары.Очистить();
			// Очищение остальных табличных частей документов в гибких настроках при необходимости
			
		ИначеЕсли НЕ Выборка.ПовторнаяЗагрузкаФайла Тогда // Сюда попадают варианты с повтором О и D (если у них разыне имена), а также R, если предыдущий документ этой цепочки найден
			ЭтоПовторныйДокумент = ВРег(ЭКОМДок.ТипДокумента) = ВРег(СтруктураДокумента.DOCTYPE)
			И НЕ ВРег(СтруктураДокумента.DOCTYPE) = "R"
			И (НЕ Выборка.ПометкаУдаления ИЛИ ВРег(СтруктураДокумента.DOCTYPE) = "D");
			Документ1С = ЭКОМДок.Документ1С; // Переносим документ 1С к следующему ЭКОМ документу.
			ТабЧастьДокументыСвязанные = ЭКОМДок.ДокументыСвязанные.Выгрузить();
			ВывестиВКомментарий = Ложь;
			Если НЕ ЭтоПовторныйДокумент Тогда
				ТекстЛогаСобытий = "ORDER № %ORDERNUMBER% от %ORDERDATE% был %DOCTYPE%!";
				Если ВРег(СтруктураДокумента.DOCTYPE) = "O" Тогда
					ТекстЛогаСобытий = СтрЗаменить(ТекстЛогаСобытий, "%DOCTYPE%", "заменен");
				ИначеЕсли ВРег(СтруктураДокумента.DOCTYPE) = "R" Тогда
					ВывестиВКомментарий = Истина;
					ТекстЛогаСобытий = СтрЗаменить(ТекстЛогаСобытий, "%DOCTYPE%", "скорректирован");
				ИначеЕсли ВРег(СтруктураДокумента.DOCTYPE) = "D" Тогда
					ВывестиВКомментарий = Истина;
					ТекстЛогаСобытий = СтрЗаменить(ТекстЛогаСобытий, "%DOCTYPE%", "аннулирован");
				КонецЕсли;
				ТекстЛогаСобытий = СтрЗаменить(ТекстЛогаСобытий, "%ORDERNUMBER%", Выборка.ЗаказНомер);
				ТекстЛогаСобытий = СтрЗаменить(ТекстЛогаСобытий, "%ORDERDATE%", Формат(Выборка.ЗаказДата, "ДФ=dd.MM.yyyy"));
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			КонецЕсли;
			
			Если ОбрабатыватьПовторные ИЛИ Не ЭтоПовторныйДокумент Тогда
				// у предыдущего документа снимается отметка актуальности, 
				// чтобы при его записи не выполнялась актуализация цепочки поставщика 			
				СтарыйДокументОбъект = ЭКОМДок.ПолучитьОбъект();
				СтарыйДокументОбъект.АктуальныйДокумент = Ложь;
				СтарыйДокументОбъект.ДокументыСвязанные.Очистить();
				Если СтарыйДокументОбъект.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.НеОбработан Тогда
					// предыдущие необработанные документы т.к. становятся не актуальными отмечаются как обработанные
					// для того что бы исключить повторную загрузку неактуальных документов
					СтарыйДокументОбъект.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.Обработан;
					ОтметитьДокументОбработанным(СтруктураДокумента, СтарыйДокументОбъект.ИмяФайла, Выборка.Контрагент, 
													Выборка.Организация, Выборка.ЗаказДата, Выборка.ЗаказНомер, СтарыйДокументОбъект.Ссылка);
				КонецЕсли;
				СтарыйДокументОбъект.Записать();
			КонецЕсли;
			
			// новый документ становится актуальным и отмечается повторным
			// только актуальный ORDER_Входящий выполняет изменения в цепочке ПриЗаписи документа
			ЭКОМДок = Документы.ЭКОМ_Документы.СоздатьДокумент();  
			ЭКОМДок.ЭтоПовторныйДокумент = ЭтоПовторныйДокумент;
			ЭКОМДок.Документ1С = Документ1С;
			Если ВывестиВКомментарий Тогда
				ЭКОМДок.Комментарий = ТекстЛогаСобытий;
			КонецЕсли;
			Если ОбрабатыватьПовторные ИЛИ Не ЭтоПовторныйДокумент Тогда
				ЭКОМДок.АктуальныйДокумент = Истина;
				ЭКОМДок.ДокументыСвязанные.Загрузить(ТабЧастьДокументыСвязанные);
			КонецЕсли;
			
		Иначе // Остальыне ситуации. Предполагается, что документ уже есть и изменять его запрещено
			ТекстЛогаСобытий = ПредставлениеДокументаXML + " - ЭКОМ документ уже существует в 1С, номер = " 
			+ ЭКОМДок.Номер + " от " + ЭКОМДок.Дата;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Продолжить;
			
		КонецЕсли; 
		
		Если НЕ ЗначениеЗаполнено(Выборка.Организация) Тогда
			СоответствиеПоОрганизации.Вставить("Организация_" + Выборка.xmlОрганизацияGLN, Выборка.xmlОрганизацияGLN);	
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Выборка.Контрагент) Тогда
			СоответствиеПоКонтрагенту.Вставить("Контрагент_" + Выборка.xmlКонтрагентGLN, Выборка.xmlКонтрагентGLN);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Выборка.ТочкаДоставки) Тогда
			СоответствиеПоТочкамДоставки.Вставить("ТочкаДоставки_" + Выборка.xmlТочкаДоставкиGLN, Выборка.xmlТочкаДоставкиGLN);
		КонецЕсли;
		
		xmlВалюта = "RUB";
		Если ЗначениеЗаполнено(СтруктураДокумента.CURRENCY) Тогда
			xmlВалюта = СтруктураДокумента.CURRENCY;
		КонецЕсли;
		
		ВалютаСсылка = КэшированныеЗначения.Получить(xmlВалюта);
		Если ВалютаСсылка = Неопределено Тогда
			ВалютаСсылка = ПолучитьСсылкуВалютыДокумента(xmlВалюта);
			КэшированныеЗначения.Вставить(xmlВалюта, ВалютаСсылка);
		КонецЕсли;
		
		//Docrobot 1.21.0 MOD-1648
		Если Выборка.SUPORDER <> "" Тогда
			Запрос = Новый Запрос("Выбрать Первые 1 Ссылка Из Документ.Эком_документы Где Номер Подобно &SUPORDER 
			|И ВидДокумента = Значение(Перечисление.ЭКОМ_ВидыДокументов.RETORD_Исходящий) Упорядочить По Дата УБЫВ");
			Запрос.УстановитьПараметр("SUPORDER", Формат(Число(Выборка.SUPORDER),"ЧЦ=9; ЧВН=; ЧГ=0"));
			RETORD = Запрос.Выполнить().Выбрать();
			Если RETORD.Следующий() Тогда
				ЭКОМДок.СвязанныйDocrobotДокумент = RETORD.Ссылка;
				//Удалить запись из цепочки если есть
				НЗ = РегистрыСведений.ЭКОМ_ЦепочкиДокументовПоставщика.СоздатьНаборЗаписей();
				НЗ.Отбор.ORDER.Установить(RETORD.Ссылка);
				НЗ.Прочитать();
				Если НЗ.Количество() <> 0 Тогда
					НЗ.Очистить();
					НЗ.Записать();
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		// Шапка
		ЭКОМДок.Организация               = Выборка.Организация;
		ЭКОМДок.xmlОрганизация            = Выборка.xmlОрганизацияGLN;
		ЭКОМДок.ВидДокумента              = Перечисления.ЭКОМ_ВидыДокументов.ORDER_Входящий;
		ЭКОМДок.Контрагент                = Выборка.Контрагент;
		ЭКОМДок.xmlКонтрагент             = Выборка.xmlКонтрагентGLN;
		ЭКОМДок.Дата                      = ТекущаяДата();
		ЭКОМДок.ЗаказНомер                = Выборка.ЗаказНомер;
		ЭКОМДок.ЗаказДата                 = Выборка.ЗаказДата;
		ЭКОМДок.xmlВалюта                 = xmlВалюта;
		ЭКОМДок.Валюта                    = ВалютаСсылка;
		ЭКОМДок.ИмяФайла                  = СтрокаТЗСтруктур.ИмяФайлаXML;	
		ЭКОМДок.ДатаПоставки              = СтруктураДокумента.DELIVERYDATE;
		ЭКОМДок.ТочкаДоставки             = Выборка.ТочкаДоставки;
		ЭКОМДок.xmlТочкаДоставки          = Выборка.xmlТочкаДоставкиGLN;	
		ЭКОМДок.INVOICEPARTNER            = Выборка.INVOICEPARTNER;
		ЭКОМДок.ИнформацияПоДокументу     = СтруктураДокумента.INFO;
		ЭКОМДок.НомерТранзакции           = СтруктураДокумента.HEAD_EDIINTERCHANGEID;
		ЭКОМДок.Ответственный             = Пользователь;
		ЭКОМДок.ТипДокумента              = СтруктураДокумента.DOCTYPE;
		ЭКОМДок.Версия                    = СтруктураДокумента.VERSION;
		ЭКОМДок.ФайлНомер                 = Выборка.ЗаказНомер;
		ЭКОМДок.ФайлДата                  = Выборка.ЗаказДата;     
		ЭКОМДок.НомерДоговораНаПоставку   = ?(ПустаяСтрока(СтруктураДокумента.CAMPAIGNNUMBER), СтруктураДокумента.CAMPAIGNINFO_CAMPAIGNNUMBER, СтруктураДокумента.CAMPAIGNNUMBER);
		
		// ТЧ товары
		СуммаВсего    = 0;
		СуммаВсегоНДС = 0;
		ТекстОшибки   = "";
		ПроверкаНаДублированиеТЧ = Новый Соответствие;
		
		Отбор = Новый Структура();
		Отбор.Вставить("ИдентификаторФайла", Выборка.ИдФайл);
		МассивСтрок = ДокументыТабличнаяЧасть.НайтиСтроки(Отбор);
		
		Для Каждого СтруктСтрока Из МассивСтрок Цикл	
			
			СоставнойШтрихКод = СокрЛП(СтруктСтрока.НомерСтрокиТЧ) + "_" + СокрЛП(СтруктСтрока.ШтрихКод);
			Если ЗначениеЗаполнено(СтруктСтрока.ШтрихКод) Тогда
				Если ПроверкаНаДублированиеТЧ.Получить(СоставнойШтрихКод) = Неопределено Тогда
					ПроверкаНаДублированиеТЧ.Вставить(СоставнойШтрихКод, "Строка добавлена");
				Иначе
					
					ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
					+ "Дубль данных, проверьте номенклатуру - " + СтруктСтрока.ШтрихКод + ", строка - " + СокрЛП(СтруктСтрока.НомерСтрокиТЧ);
					
					Продолжить;
					
				КонецЕсли;		
			КонецЕсли;
			
			Номенклатура     = СтруктСтрока.Номенклатура; 
			ЕдиницаИзмерения = СтруктСтрока.ЕдиницаИзмерения;
			
			Если НЕ ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда			 							
				ЕдиницаИзмерения = СтруктСтрока.ЕдиницаИзмеренияПоУмолчанию;			
			КонецЕсли;
						
			ЦенаБезНДС   = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.ORDERPRICE); // обязательный тег
			ЦенаСНДС     = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.PRICEWITHVAT);			
			СтавкаНДСДок = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.VAT);
			знКоличество = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.ORDEREDQUANTITY);
			
			Если НЕ ЗначениеЗаполнено(СтавкаНДСДок) Тогда
				Если ЦенаБезНДС <> ЦенаСНДС	
					И ЦенаБезНДС <> 0
					И ЦенаСНДС   <> 0 Тогда
					СтавкаНДСДок = Окр(((ЦенаСНДС - ЦенаБезНДС) / ЦенаБезНДС) * 100);
				Иначе
					СтавкаНДСДок = 0;
				КонецЕсли;		
			КонецЕсли;			
					
			Если ЦенаБезНДС = 0 
				И СтавкаНДСДок > 0
				И ЦенаСНДС > 0 Тогда				
				ЦенаБезНДС = Окр((ЦенаСНДС * 100) / (100 + СтавкаНДСДок) , 4);
				
			КонецЕсли;
			
			Если ЦенаСНДС = 0 
				И СтавкаНДСДок > 0 Тогда	
				ЦенаСНДС  = Окр((ЦенаБезНДС * (100 + СтавкаНДСДок)) / 100 , 4);
				
			КонецЕсли;	
			
			// Для каждой сети свой порядок расчета НДС
			Если ЗначениеЗаполнено(Выборка.ЭКОМ_ИнфоПоля) Тогда
				
				// Обратная (от цены с НДС)
				Если Выборка.ЭКОМ_ИнфоПоля.СхемаПодсчета = Истина Тогда 
					СуммаСНДС   = ЦенаСНДС * знКоличество; 
					СуммаНДС    = Окр(СуммаСНДС / (100 + СтавкаНДСДок) * СтавкаНДСДок, 4);
					СуммаБезНДС = СуммаСНДС - СуммаНДС;
					
					// Прямая (от цены без НДС)
				ИначеЕсли Выборка.ЭКОМ_ИнфоПоля.СхемаПодсчета = Ложь Тогда	
					СуммаБезНДС = ЦенаБезНДС * знКоличество;
					СуммаСНДС   = СуммаБезНДС * (100 + СтавкаНДСДок)/100;
					СуммаНДС    = Окр(СуммаСНДС - СуммаБезНДС, 4);
					
				КонецЕсли;
				
			Иначе
				СуммаСНДС   = ЦенаСНДС * знКоличество;
				СуммаБезНДС = ЦенаБезНДС * знКоличество;
				СуммаНДС    = Окр(СуммаБезНДС * (СтавкаНДСДок/100), 4);
			КонецЕсли;
			
			НовСтрока                         = ЭКОМДок.ТЧ_Товары.Добавить();
			НовСтрока.Номенклатура            = Номенклатура;
			НовСтрока.ЕдиницаИзмерения        = ЕдиницаИзмерения;
			НовСтрока.xmlЕдиницаИзмерения     = СтруктСтрока.xmlЕдиницаИзмерения;
			НовСтрока.Цена                    = ЦенаБезНДС;
			НовСтрока.ЦенаСНДС                = ЦенаСНДС;
			НовСтрока.ОписаниеПродукта        = ?(ЗначениеЗаполнено(СтруктСтрока.ОписаниеПродукта), СтруктСтрока.ОписаниеПродукта, СтруктСтрока.ОписаниеПродуктаИзХарактеристики);
			НовСтрока.КоличествоЗаказанное    = знКоличество;
			НовСтрока.КоличествоПоставляемое  = знКоличество; // Поставщик редактирует поле, проставляет фактическую отгрузку
			НовСтрока.Сумма                   = СуммаБезНДС;
			НовСтрока.СтавкаНДС               = СтавкаНДСДок;
			НовСтрока.СуммаНДС                = СуммаНДС;
			НовСтрока.Сумма_с_НДС             = СуммаСНДС;
			НовСтрока.НомерПродукта           = СтруктСтрока.ШтрихКод;
			НовСтрока.НомерПродуктаПокупателя = СтруктСтрока.КодПокупателя;
			НовСтрока.КоличествоВУпаковке     = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.QUANTITYOFCUINTU); 
			НовСтрока.НомерСтрокиXML          = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.НомерСтрокиТЧ);
			НовСтрока.КалибрУпаковки          = СтруктСтрока.CALIBRE;
            НовСтрока.ТипФасовки              = СтруктСтрока.PACKINGTYPE;
            НовСтрока.КоличествоВФасовке      = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.PACKINGQUANTITY);
			НовСтрока.БазоваяЕдиницаТовара    = СтруктСтрока.PACKINGUNIT;
			
			СуммаВсегоНДС = СуммаВсегоНДС + СуммаНДС;
			СуммаВсего    = СуммаВсего + СуммаБезНДС + СуммаНДС;		
		КонецЦикла;
		
		ЭКОМДок.СуммаДокументаВсего = СуммаВсего;
		ЭКОМДок.СуммаНДСВсего       = СуммаВсегоНДС;
					
		ЭКОМДок.ТекстОшибки = ""; // Очищаем ошибки документа
		ЭКОМДок.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.ПустаяСсылка(); // Обнуляем статус документ
		
		ВыполнитьДополнительныеДействия(ЭКОМДок, "Входящий ORDER", СтруктураДокумента, МассивЛогаСобытий, ТекстОшибки, 
		СоответствиеПоОрганизации,
		СоответствиеПоКонтрагенту,
		СоответствиеПоТочкамДоставки,
		СоответствиеПоНоменклатуре,
		КэшированныеЗначения);
				
		ЭКОМДок.ТЧ_Товары.Сортировать("НомерСтрокиXML Возр");
		
		// По умолчанию документ загружается и записывается, если ЭКОМ документ не нужен в гибких настройках необходимо поставить НеЗагружатьДокумент = Истина 
		Если ЭКОМДок.НеЗагружатьДокумент = Ложь Тогда
			
			СтруктураРегистраСобытий = Новый Структура; 
			СтруктураРегистраСобытий.Вставить("ДатаЗаписи"                  , ТекущаяДата());
			СтруктураРегистраСобытий.Вставить("Контрагент"                  , ЭКОМДок.Контрагент);
			СтруктураРегистраСобытий.Вставить("Организация"                 , ЭКОМДок.Организация);
			СтруктураРегистраСобытий.Вставить("НаправлениеОбмена"           , Перечисления.ЭКОМ_НаправлениеОбмена.Входящий);
			СтруктураРегистраСобытий.Вставить("ФайлИмя"                     , СтрокаТЗСтруктур.ИмяФайлаXML);
			СтруктураРегистраСобытий.Вставить("ЗаказДата"                   , ЭКОМДок.ЗаказДата);					
			СтруктураРегистраСобытий.Вставить("ЗаказНомер"                  , ЭКОМДок.ЗаказНомер);
			СтруктураРегистраСобытий.Вставить("СтруктураФайла"              , Новый ХранилищеЗначения(СтруктураДокумента,  Новый СжатиеДанных(9)));
			СтруктураРегистраСобытий.Вставить("Идентификатор"               , СтруктураДокумента.ИдФайл);
			
			Н = 1;		
			Для Каждого Стр Из ЭКОМДок.ТЧ_Товары Цикл
				
				Если НЕ ЗначениеЗаполнено(Стр.Номенклатура)
					И ЗначениеЗаполнено(ЭКОМДок.Контрагент) Тогда
					НомерПродуктаПокупателя = ?(ЗначениеЗаполнено(Стр.НомерПродуктаПокупателя) , "_" + Стр.НомерПродуктаПокупателя, "");
					Код = ?(ЗначениеЗаполнено(Стр.НомерПродукта), Стр.НомерПродукта + НомерПродуктаПокупателя, Стр.НомерПродуктаПокупателя) + "_" + ЭКОМДок.xmlКонтрагент;
					СоответствиеПоНоменклатуре.Вставить("АртикулНоменклатурыКонтрагента_"      + Код, Стр.НомерПродуктаПоставщика); // PRODUCTIDSUPPLIER
					СоответствиеПоНоменклатуре.Вставить("КодНоменклатурыКонтрагента_"          + Код, Стр.НомерПродуктаПокупателя); // PRODUCTIDBUYER
					СоответствиеПоНоменклатуре.Вставить("ШтрихКодНоменклатурыКонтрагента_"     + Код, Стр.НомерПродукта);           // PRODUCT
					СоответствиеПоНоменклатуре.Вставить("НаименованиеНоменклатурыКонтрагента_" + Код, Стр.ОписаниеПродукта);
					СоответствиеПоНоменклатуре.Вставить("ЕдиницаНоменклатурыКонтрагента_"      + Код, Стр.ЕдиницаИзмерения);
					СоответствиеПоНоменклатуре.Вставить("Контрагент_"                          + Код, ЭКОМДок.Контрагент);
					СоответствиеПоНоменклатуре.Вставить("xmlЕдиницаИзмерения_"                 + Код, Стр.xmlЕдиницаИзмерения); // Информация при выборе ед. измерения из справочника
				КонецЕсли;
				
				// Проверка заполнения документа
				Если НЕ ЗначениеЗаполнено(Стр.ЕдиницаИзмерения) Тогда	
					ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "") 
					+ "В строке № " + Н + " " + "не заполнена единица измерения. (смотрите гибкие настройки или регистр сведений ЭКОМ_НоменклатураКонтрагентов)" 
					+ "(" + Стр.xmlЕдиницаИзмерения + ")"; 
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(Стр.Номенклатура) Тогда
					ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
					+ "В строке № " + Н + " " + "не заполнена номенклатура." 
					+ "(" + Стр.НомерПродукта + ")";
				КонецЕсли;
				
				Н = Н + 1;	
			КонецЦикла;
			
			Если НЕ ЗначениеЗаполнено(ЭКОМДок.Организация) Тогда
				ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
				+ "Не заполнена организация." + "(" + ЭКОМДок.xmlОрганизация + ")"; 
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ЭКОМДок.Контрагент) Тогда
				ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
				+ "Не заполнен контрагент." + "(" + ЭКОМДок.xmlКонтрагент + ")";
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ЭКОМДок.ТочкаДоставки) Тогда
				ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
				+ "Не заполнена точка доставки." + "(" + ЭКОМДок.xmlТочкаДоставки + ")";
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ЭКОМДок.Валюта) Тогда
				ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
				+ "Не заполнена валюта." + "(" + ЭКОМДок.xmlВалюта + ")";
			КонецЕсли;
			
			ДокументОбработан = ПроверитьОбработкуДокумента(ТекстОшибки, ЭКОМДок, СтруктураДокумента, СтруктураРегистраСобытий, ПредставлениеДокументаXML, МассивЛогаСобытий);
			Если Не ЭКОМДок.ЭтоНовый() И ЭКОМДок.АктуальныйДокумент Тогда
				Отбор = Новый Структура("ЗаказНомер, ЗаказДата, xmlКонтрагентGLN");
				ЗаполнитьЗначенияСвойств(Отбор, Выборка);
				НайденныеСтроки = ДокументыШапка.НайтиСтроки(Отбор);
				
				Для Каждого СтрокаШапка Из НайденныеСтроки Цикл
					ЗаполнитьЗначенияСвойств(СтрокаШапка, ЭКОМДок, "ПометкаУдаления, СтатусОбработкиДокумента, ИмяФайла");	
					СтрокаШапка.ЭКОМДок = ЭКОМДок.Ссылка;
					
					// если в пакете есть другие документы по тому же ORDER
					// все ORDER по данному пакету, кроме текущего будут отмечены как Обработанные. 
					// статус отмеченных обработанными документов, которые фактически еще не обходились в цикле
					// будет актуализирован в процедуре ПроверитьОбработкуДокумента, а предыдущие не будут повторно обрабатываться
					НайденнаяСтрокаТЗСтруктур = ТЗСтруктур.Найти(СтрокаШапка.ИдФайл, "ИдентификаторФайла");
					Если Не НайденнаяСтрокаТЗСтруктур = Неопределено И НайденнаяСтрокаТЗСтруктур.ИмяФайлаXML <> ЭКОМДок.ИмяФайла Тогда	
						СтруктураСтарогоДокумента = НайденнаяСтрокаТЗСтруктур.СтруктураДокумента;
						СтруктураСтарогоДокумента.Вставить("Обработан", Истина);
					КонецЕсли;
				КонецЦикла;				
			КонецЕсли;
			
			//Docrobot 1.21.0 MOD-1648
			Если Выборка.SUPORDER <> "" И ДокументОбработан = Истина И ЗначениеЗаполнено(ЭКОМДок.СвязанныйDocrobotДокумент) Тогда
				оRETORD = ЭКОМДок.СвязанныйDocrobotДокумент.ПолучитьОбъект();
				оRETORD.СвязанныйDocrobotДокумент = ЭКОМДок.Ссылка;
				оRETORD.НеВыполнятьКодПриЗаписи = Истина;
				оRETORD.Записать();
			КонецЕсли;
			
			Если КэшированныеЗначенияЗапроса.Найти(ЭКОМДок.Ссылка, "ЭКОМДок") = Неопределено Тогда
				СтрокаКэша = КэшированныеЗначенияЗапроса.Добавить();
				СтрокаКэша.ЗаказНомер = ЭКОМДок.ЗаказНомер;
				СтрокаКэша.ЗаказДата = ЭКОМДок.ЗаказДата;
				СтрокаКэша.DOCTYPE = ВРег(ЭКОМДок.ТипДокумента);
				СтрокаКэша.xmlКонтрагентGLN = ЭКОМДок.xmlКонтрагент;
				СтрокаКэша.ЭКОМДок = ЭКОМДок.Ссылка;
				СтрокаКэша.ПометкаУдаления = ЭКОМДок.ПометкаУдаления;
				СтрокаКэша.ИмяФайла = ЭКОМДок.ИмяФайла;
			КонецЕсли;
			
		Иначе 			
			СтруктураДокумента.Вставить("Обработан", Ложь);
			ТекстЛогаСобытий = "В гибких настройках указано не загружать документ - " + ПредставлениеДокументаXML;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ СоответствиеПоОрганизации.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоОрганизации     , "Организация_");
	КонецЕсли;
	Если НЕ СоответствиеПоКонтрагенту.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоКонтрагенту     , "Контрагент_");
	КонецЕсли;
	Если НЕ СоответствиеПоТочкамДоставки.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоТочкамДоставки  , "ТочкаДоставки_");
	КонецЕсли;
	Если НЕ СоответствиеПоНоменклатуре.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоНоменклатуре    , "Номенклатура_");
	КонецЕсли;
	
КонецПроцедуры

Процедура СоздатьЭКОМ_ДокИнструкцияОДоставкеINSDES(ТЗСтруктур, ДокументыШапка, пДокументыТабличнаяЧасть, МассивЛогаСобытий) Экспорт

	// Запрос к табличной части
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	пДокументыТабличнаяЧасть.HEAD_POSITION_POSITIONNUMBER КАК НомерСтрокиТЧ,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_PRODUCT, 0, 100) КАК ШтрихКод,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_PRODUCTIDSUPPLIER, 0, 100) КАК КодПоставщика,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_PRODUCTIDBUYER, 0, 100) КАК КодПокупателя,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.xmlКонтрагентGLN, 0, 100) КАК xmlКонтрагентGLN,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_ORDERUNIT, 0, 100) КАК xmlЕдиницаИзмерения,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.ИдентификаторФайла, 0, 250) КАК ИдентификаторФайла,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_CHARACTERISTIC_DESCRIPTION, 0, 250) КАК ОписаниеПродуктаИзХарактеристики,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_DESCRIPTION, 0, 250) КАК ОписаниеПродукта,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_ORDERPRICE, 0, 250) КАК ORDERPRICE,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_PRICEWITHVAT, 0, 250) КАК PRICEWITHVAT,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_VAT, 0, 250) КАК VAT,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_ORDEREDQUANTITY, 0, 250) КАК ORDEREDQUANTITY,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_QUANTITYOFCUINTU, 0, 250) КАК QUANTITYOFCUINTU,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_CALIBRE, 0, 250) КАК CALIBRE,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_PACKING_PACKINGTYPE, 0, 250) КАК PACKINGTYPE,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_PACKING_PACKINGQUANTITY, 0, 250) КАК PACKINGQUANTITY,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_PACKING_PACKINGUNIT, 0, 250) КАК PACKINGUNIT
	|ПОМЕСТИТЬ пДокументыТабличнаяЧасть
	|ИЗ
	|	&пДокументыТабличнаяЧасть КАК пДокументыТабличнаяЧасть
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	пДокументыТабличнаяЧасть.xmlКонтрагентGLN КАК xmlКонтрагентGLN,
	|	пДокументыТабличнаяЧасть.НомерСтрокиТЧ КАК НомерСтрокиТЧ,
	|	пДокументыТабличнаяЧасть.ШтрихКод КАК ШтрихКод,
	|	пДокументыТабличнаяЧасть.КодПоставщика КАК КодПоставщика,
	|	пДокументыТабличнаяЧасть.КодПокупателя КАК КодПокупателя,
	|	ЭКОМ_GLN.Объект КАК Контрагент,
	|	пДокументыТабличнаяЧасть.xmlЕдиницаИзмерения КАК xmlЕдиницаИзмерения,
	|	пДокументыТабличнаяЧасть.ИдентификаторФайла,
	|	пДокументыТабличнаяЧасть.ОписаниеПродукта,
	|	пДокументыТабличнаяЧасть.ORDERPRICE,
	|	пДокументыТабличнаяЧасть.PRICEWITHVAT,
	|	пДокументыТабличнаяЧасть.VAT,
	|	пДокументыТабличнаяЧасть.ORDEREDQUANTITY,
	|	пДокументыТабличнаяЧасть.QUANTITYOFCUINTU,
	|	пДокументыТабличнаяЧасть.CALIBRE,
	|	пДокументыТабличнаяЧасть.PACKINGTYPE,
	|	пДокументыТабличнаяЧасть.PACKINGQUANTITY,
	|	пДокументыТабличнаяЧасть.PACKINGUNIT
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	пДокументыТабличнаяЧасть КАК пДокументыТабличнаяЧасть
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN
	|		ПО пДокументыТабличнаяЧасть.xmlКонтрагентGLN = ЭКОМ_GLN.GLN
	|			И (ЭКОМ_GLN.Объект ССЫЛКА Справочник.Контрагенты)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ЭКОМ_НоменклатураКонтрагентов.Номенклатура, НЕОПРЕДЕЛЕНО) КАК Номенклатура,
	|	ЕСТЬNULL(ЭКОМ_НоменклатураКонтрагентов.ХарактеристикаНоменклатуры, НЕОПРЕДЕЛЕНО) КАК ХарактеристикаНоменклатуры,
	|	ЭКОМ_НоменклатураКонтрагентов.ЕдиницаНоменклатурыКонтрагента КАК ЕдиницаИзмерения,
	|	ЭКОМ_ЗначениеДополнительныхКонстант.ЗначениеДополнительнойКонстанты КАК ЕдиницаИзмеренияПоУмолчанию,
	|	ВТ.ИдентификаторФайла,
	|	ВТ.НомерСтрокиТЧ,
	|	ВТ.ШтрихКод,
	|	ВТ.КодПоставщика,
	|	ВТ.КодПокупателя,
	|	ВТ.xmlЕдиницаИзмерения,
	|	ВТ.ОписаниеПродукта,
	|	ВТ.ORDERPRICE,
	|	ВТ.PRICEWITHVAT,
	|	ВТ.VAT,
	|	ВТ.ORDEREDQUANTITY,
	|	ВТ.QUANTITYOFCUINTU,
	|	ВТ.CALIBRE,
	|	ВТ.PACKINGTYPE,
	|	ВТ.PACKINGQUANTITY,
	|	ВТ.PACKINGUNIT,
	|	ВТ.xmlКонтрагентGLN
	|ИЗ
	|	ВТ КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_НоменклатураКонтрагентов КАК ЭКОМ_НоменклатураКонтрагентов
	|		ПО ВТ.ШтрихКод = ЭКОМ_НоменклатураКонтрагентов.ШтрихКодНоменклатурыКонтрагента
	|			И ВТ.Контрагент = ЭКОМ_НоменклатураКонтрагентов.Контрагент
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_ЗначениеДополнительныхКонстант КАК ЭКОМ_ЗначениеДополнительныхКонстант
	|		ПО (ЭКОМ_ЗначениеДополнительныхКонстант.ДополнительнаяКонстанта = ""ЕдиницаИзмерения_"" + ВТ.xmlЕдиницаИзмерения)
	|			И (ЭКОМ_ЗначениеДополнительныхКонстант.Измерение = ""Единица измерения"")";
	Запрос.УстановитьПараметр("пДокументыТабличнаяЧасть", пДокументыТабличнаяЧасть);
	РезультатЗапроса = Запрос.Выполнить();
	ДокументыТабличнаяЧасть = РезультатЗапроса.Выгрузить();
	ДокументыТабличнаяЧасть.Индексы.Добавить("ИдентификаторФайла"); 
	
	// Запрос по шапке документов
	Запрос = Новый Запрос;	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДокументыШапка.ORDERDATE КАК ЗаказДата,
	|	ПОДСТРОКА(ДокументыШапка.ORDERNUMBER, 1, 100) КАК ЗаказНомер,
	|	ДокументыШапка.DATE КАК Дата,
	|	ПОДСТРОКА(ДокументыШапка.NUMBER, 1, 100) КАК Номер,
	|	ПОДСТРОКА(ДокументыШапка.HEAD_RECIPIENT, 1, 100) КАК xmlОрганизацияGLN,
	|	ПОДСТРОКА(ДокументыШапка.xmlКонтрагентGLN, 1, 100) КАК xmlКонтрагентGLN,
	|	ПОДСТРОКА(ДокументыШапка.HEAD_DELIVERYPLACE, 1, 100) КАК xmlТочкаДоставкиGLN,
	|	ДокументыШапка.ВидДокумента КАК ВидДокумента,
	|	ПОДСТРОКА(ДокументыШапка.DOCTYPE, 0, 100) КАК DOCTYPE,
	|	ПОДСТРОКА(ДокументыШапка.ИдФайл, 1, 250) КАК ИдФайл,
	|	ДокументыШапка.ДатаЧислоПолученияДокумента КАК ДатаЧислоПолученияДокумента
	|ПОМЕСТИТЬ ДокументыШапка
	|ИЗ
	|	&ДокументыШапка КАК ДокументыШапка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ЭКОМ_ЦепочкиДокументовПоставщика.ORDER, НЕОПРЕДЕЛЕНО) КАК ЭКОМДок,
	|	ЕСТЬNULL(ЭКОМ_ЦепочкиДокументовПоставщика.ORDER.ПометкаУдаления, ЛОЖЬ) КАК ПометкаУдаления,
	|	ЕСТЬNULL(ЭКОМ_ЦепочкиДокументовПоставщика.ORDER.СтатусОбработкиДокумента, ЗНАЧЕНИЕ(Перечисление.ЭКОМ_Статусы.НеОбработан)) КАК СтатусОбработкиДокумента,
	|	ЕСТЬNULL(ЭКОМ_ЦепочкиДокументовПоставщика.ORDER.ИмяФайла, ВЫРАЗИТЬ("""" КАК СТРОКА(300))) КАК ИмяФайла,
	|	ЭКОМ_GLN_Организация.Объект КАК Организация,
	|	ЭКОМ_GLN_Контрагент.Объект КАК Контрагент,
	|	ЭКОМ_ТочкиДоставки.Объект КАК ТочкаДоставки,
	|	ЭКОМ_ИнфоПоля.Ссылка КАК ЭКОМ_ИнфоПоля,
	|	ДокументыШапка.ИдФайл,
	|	ДокументыШапка.ВидДокумента,
	|	ДокументыШапка.ЗаказДата,
	|	ДокументыШапка.ЗаказНомер,
	|	ДокументыШапка.xmlКонтрагентGLN,
	|	ДокументыШапка.DOCTYPE,
	|	ДокументыШапка.xmlТочкаДоставкиGLN,
	|	ДокументыШапка.xmlОрганизацияGLN,
	|	ДокументыШапка.Дата,
	|	ДокументыШапка.Номер
	|ИЗ
	|	ДокументыШапка КАК ДокументыШапка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Организация
	|		ПО ДокументыШапка.xmlОрганизацияGLN = ЭКОМ_GLN_Организация.GLN
	|			И (НЕ ЭКОМ_GLN_Организация.Объект ССЫЛКА Справочник.Контрагенты)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Контрагент
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭКОМ_ИнфоПоля КАК ЭКОМ_ИнфоПоля
	|			ПО ЭКОМ_GLN_Контрагент.Контрагент_ФорматЭСФ = ЭКОМ_ИнфоПоля.ФорматУПД
	|		ПО ДокументыШапка.xmlКонтрагентGLN = ЭКОМ_GLN_Контрагент.GLN
	|			И (ЭКОМ_GLN_Контрагент.Объект ССЫЛКА Справочник.Контрагенты)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_ТочкиДоставки КАК ЭКОМ_ТочкиДоставки
	|		ПО ДокументыШапка.xmlТочкаДоставкиGLN = ЭКОМ_ТочкиДоставки.GLN
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_ЦепочкиДокументовПоставщика КАК ЭКОМ_ЦепочкиДокументовПоставщика
	|		ПО (ВЫБОР
	|				КОГДА ДокументыШапка.DOCTYPE = ""O""
	|					ТОГДА ДокументыШапка.ЗаказДата = ЭКОМ_ЦепочкиДокументовПоставщика.ORDER.ЗаказДата
	|				ИНАЧЕ НАЧАЛОПЕРИОДА(ДокументыШапка.ЗаказДата, ДЕНЬ) >= НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(ЭКОМ_ЦепочкиДокументовПоставщика.ORDERDATE, МЕСЯЦ, -1), ДЕНЬ)
	|			КОНЕЦ)
	|			И ДокументыШапка.ЗаказНомер = ЭКОМ_ЦепочкиДокументовПоставщика.ORDER.ЗаказНомер
	|			И ДокументыШапка.ВидДокумента = ЭКОМ_ЦепочкиДокументовПоставщика.ORDER.ВидДокумента
	|			И ДокументыШапка.xmlКонтрагентGLN = ЭКОМ_ЦепочкиДокументовПоставщика.ORDER.xmlКонтрагент
	|			И ДокументыШапка.xmlОрганизацияGLN = ЭКОМ_ЦепочкиДокументовПоставщика.ORDER.xmlОрганизация
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДокументыШапка.ДатаЧислоПолученияДокумента";	
	Запрос.УстановитьПараметр("ДокументыШапка", ДокументыШапка);
	РезультатЗапроса = Запрос.Выполнить();
	
	ПроверкаНаДублирование = Новый Соответствие;
	
	СоответствиеПоОрганизации      = Новый Соответствие;
	СоответствиеПоКонтрагенту      = Новый Соответствие;
	СоответствиеПоТочкамДоставки   = Новый Соответствие;
	СоответствиеПоНоменклатуре     = Новый Соответствие;
	
	КэшированныеЗначения = Новый Соответствие;

	ИмяСобытия = "Создание документа Docrobot-INSDES";
	Пользователь = НайтиТекущегоПользователя();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		// Для проверки дублирования строк
		Если ПроверкаНаДублирование.Получить(Выборка.ИдФайл) = Неопределено Тогда
			ПроверкаНаДублирование.Вставить(Выборка.ИдФайл, "Строка добавлена");
		Иначе
			
			ТекстЛогаСобытий = "Дубль данных, проверьте GLN организации, контрагента, точки доставки ИД документа - " + Выборка.ИдФайл;	
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			Продолжить;
			
		КонецЕсли;
		
		// Получаем структуру документа
		СтруктураДокумента = Неопределено;
		СтрокаТЗСтруктур = ТЗСтруктур.Найти(Выборка.ИдФайл, "ИдентификаторФайла");
		Если СтрокаТЗСтруктур = Неопределено Тогда			
			ТекстЛогаСобытий = "Не найдена структура документа с ИД = " + Выборка.ИдФайл;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Продолжить;
			
		Иначе
			
			СтруктураДокумента = СтрокаТЗСтруктур.СтруктураДокумента;
			
		КонецЕсли;
		
		ПредставлениеДокументаXML = "INSDES № " + СтруктураДокумента.Номер + " от " + Формат(СтруктураДокумента.Дата, "ДФ='dd.MM.yyyy'" + "г.");
		
		ЭКОМДок = Выборка.ЭКОМДок;
		Если ЭКОМДок = Неопределено Тогда
			ЭКОМДок = Документы.ЭКОМ_Документы.СоздатьДокумент();
		Иначе
			ТекстЛогаСобытий = "ЭКОМ документ INSDES уже существует в 1С, номер = " + Выборка.ЭКОМДок.Номер + " от " + Выборка.ЭКОМДок.Дата + ". Для повторного заполнения измените статус документа.";
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Продолжить;
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Выборка.Организация) Тогда
			СоответствиеПоОрганизации.Вставить("Организация_" + Выборка.xmlОрганизацияGLN, Выборка.xmlОрганизацияGLN);	
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Выборка.Контрагент) Тогда
			СоответствиеПоКонтрагенту.Вставить("Контрагент_" + Выборка.xmlКонтрагентGLN, Выборка.xmlКонтрагентGLN);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Выборка.ТочкаДоставки) Тогда
			СоответствиеПоТочкамДоставки.Вставить("ТочкаДоставки_" + Выборка.xmlТочкаДоставкиGLN, Выборка.xmlТочкаДоставкиGLN);
		КонецЕсли;
		
		xmlВалюта = "RUB";
		Если ЗначениеЗаполнено(СтруктураДокумента.CURRENCY) Тогда
			xmlВалюта = СтруктураДокумента.CURRENCY;
		КонецЕсли;
		
		ВалютаСсылка = КэшированныеЗначения.Получить(xmlВалюта);
		Если ВалютаСсылка = Неопределено Тогда
			ВалютаСсылка = ПолучитьСсылкуВалютыДокумента(xmlВалюта);
			КэшированныеЗначения.Вставить(xmlВалюта, ВалютаСсылка);
		КонецЕсли;

		// Шапка
		ЭКОМДок.Организация               = Выборка.Организация;
		ЭКОМДок.xmlОрганизация            = Выборка.xmlОрганизацияGLN;
		ЭКОМДок.ВидДокумента              = Перечисления.ЭКОМ_ВидыДокументов.INSDES_Входящий;
		ЭКОМДок.Контрагент                = Выборка.Контрагент;
		ЭКОМДок.xmlКонтрагент             = Выборка.xmlКонтрагентGLN;
		ЭКОМДок.Дата                      = ТекущаяДата();
		ЭКОМДок.ЗаказНомер                = Выборка.ЗаказНомер;
		ЭКОМДок.ЗаказДата                 = Выборка.ЗаказДата;
		ЭКОМДок.Валюта                    = ВалютаСсылка;
		ЭКОМДок.xmlВалюта                 = xmlВалюта;
		ЭКОМДок.ИмяФайла                  = СтрокаТЗСтруктур.ИмяФайлаXML;	
		ЭКОМДок.ДатаПоставки              = СтруктураДокумента.DELIVERYDATE;
		ЭКОМДок.ТочкаДоставки             = Выборка.ТочкаДоставки;
		ЭКОМДок.xmlТочкаДоставки          = Выборка.xmlТочкаДоставкиGLN;
		ЭКОМДок.ИнформацияПоДокументу     = СтруктураДокумента.INFO;
		ЭКОМДок.НомерТранзакции           = СтруктураДокумента.HEAD_EDIINTERCHANGEID;
		ЭКОМДок.Ответственный             = Пользователь;
		ЭКОМДок.ФайлНомер                 = Выборка.Номер;
		ЭКОМДок.ФайлДата                  = Выборка.Дата;
		ЭКОМДок.НомерДоговораНаПоставку   = СтруктураДокумента.CAMPAIGNINFO_CAMPAIGNNUMBER;
		ЭКОМДок.ТипДокумента              = СтруктураДокумента.DOCTYPE;
		ЭКОМДок.Версия                    = СтруктураДокумента.VERSION;

		// ТЧ товары
		лСумма_Всего         = 0;
		лСумма_НДС_Всего     = 0;
		ТекстОшибки          = "";
		ПроверкаНаДублированиеТЧ = Новый Соответствие;
		
		Отбор = Новый Структура();
		Отбор.Вставить("ИдентификаторФайла", Выборка.ИдФайл);
		МассивСтрок = ДокументыТабличнаяЧасть.НайтиСтроки(Отбор);
		
		Для Каждого СтруктСтрока Из МассивСтрок Цикл	
			
			СоставнойШтрихКод = СокрЛП(СтруктСтрока.НомерСтрокиТЧ) + "_" + СокрЛП(СтруктСтрока.ШтрихКод);
			Если ЗначениеЗаполнено(СтруктСтрока.ШтрихКод) Тогда
				Если ПроверкаНаДублированиеТЧ.Получить(СоставнойШтрихКод) = Неопределено Тогда
					ПроверкаНаДублированиеТЧ.Вставить(СоставнойШтрихКод, "Строка добавлена");
				Иначе
					
					ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
					+ "Дубль данных, проверьте номенклатуру - " + СтруктСтрока.ШтрихКод + ", строка - " + СокрЛП(СтруктСтрока.НомерСтрокиТЧ);
					
					Продолжить;
					
				КонецЕсли;		
			КонецЕсли;
			
			Номенклатура     = СтруктСтрока.Номенклатура; 
			ЕдиницаИзмерения = СтруктСтрока.ЕдиницаИзмерения;
			
			Если НЕ ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда			 							
				ЕдиницаИзмерения = СтруктСтрока.ЕдиницаИзмеренияПоУмолчанию;			
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Номенклатура) 
				И ЗначениеЗаполнено(Выборка.Контрагент) Тогда
				Код = ?(ЗначениеЗаполнено(СтруктСтрока.ШтрихКод), СтруктСтрока.ШтрихКод, СтруктСтрока.КодПокупателя) + "_" + ЭКОМДок.xmlКонтрагент;;
				СоответствиеПоНоменклатуре.Вставить("АртикулНоменклатурыКонтрагента_"      + Код, СтруктСтрока.КодПоставщика); // PRODUCTIDSUPPLIER
				СоответствиеПоНоменклатуре.Вставить("КодНоменклатурыКонтрагента_"          + Код, СтруктСтрока.КодПокупателя); // PRODUCTIDBUYER
				СоответствиеПоНоменклатуре.Вставить("ШтрихКодНоменклатурыКонтрагента_"     + Код, СтруктСтрока.ШтрихКод);      // PRODUCT
				СоответствиеПоНоменклатуре.Вставить("НаименованиеНоменклатурыКонтрагента_" + Код, СтруктСтрока.ОписаниеПродукта);
				СоответствиеПоНоменклатуре.Вставить("ЕдиницаНоменклатурыКонтрагента_"      + Код, ЕдиницаИзмерения);
				СоответствиеПоНоменклатуре.Вставить("Контрагент_"                          + Код, Выборка.Контрагент);
				СоответствиеПоНоменклатуре.Вставить("xmlЕдиницаИзмерения_"                 + Код, СтруктСтрока.xmlЕдиницаИзмерения); // Информация при выборе ед. измерения из справочника
			КонецЕсли;
			
			ЦенаБезНДС = СтруктСтрока.ЦенаБезНДС;
			ЦенаСНДС   = СтруктСтрока.ЦенаСНДС;
			
			СтавкаНДСДок = СтруктСтрока.СтавкаНДС;
			Если НЕ ЗначениеЗаполнено(СтавкаНДСДок) Тогда
				Если ЦенаБезНДС <> ЦенаСНДС	
					И ЦенаБезНДС <> 0
					И ЦенаСНДС   <> 0 Тогда
					СтавкаНДСДок = Окр(((ЦенаСНДС - ЦенаБезНДС) / ЦенаБезНДС) * 100);
				Иначе
					СтавкаНДСДок = 0;
				КонецЕсли;		
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтруктСтрока.КоличествоЗаказанное) Тогда
				знКоличество = СтруктСтрока.КоличествоЗаказанное;	
			Иначе
				знКоличество = СтруктСтрока.Количество;
			КонецЕсли;
			СуммаСНДС = ЦенаСНДС * знКоличество;
			
			Если ЦенаБезНДС = 0 И СтавкаНДСДок > 0 Тогда
				Если (СуммаСНДС > 0) И (знКоличество > 0) Тогда
					ЦенаСНДС      = Окр(СуммаСНДС/знКоличество, 2);			
					ЦенаБезНДС    = Окр( (ЦенаСНДС * 100) / (100 + СтавкаНДСДок) , 2);
				КонецЕсли;
			КонецЕсли;
			
			Если ЦенаСНДС = 0 И СтавкаНДСДок > 0 Тогда
				ЦенаСНДС  = Окр( (ЦенаБезНДС * (100 + СтавкаНДСДок)) / 100 , 2);
				СуммаСНДС = ЦенаСНДС * знКоличество;
			КонецЕсли;	
			
			лСуммаБезНДС 	= ЦенаБезНДС * знКоличество;
			лСумма_НДС 		= Окр(лСуммаБезНДС * (СтавкаНДСДок/100), 2);	
			
			НовСтрока                         = ЭКОМДок.ТЧ_Товары.Добавить();
			НовСтрока.Номенклатура            = Номенклатура;
			НовСтрока.ЕдиницаИзмерения        = ЕдиницаИзмерения;
			НовСтрока.xmlЕдиницаИзмерения     = СтруктСтрока.xmlЕдиницаИзмерения;
			НовСтрока.Цена                    = ЦенаБезНДС;
			НовСтрока.ЦенаСНДС                = ЦенаСНДС;
			НовСтрока.ОписаниеПродукта        = СтруктСтрока.ОписаниеПродукта;
			НовСтрока.КоличествоЗаказанное    = знКоличество;
			НовСтрока.Сумма                   = лСуммаБезНДС;
			НовСтрока.СтавкаНДС               = СтавкаНДСДок;
			НовСтрока.СуммаНДС                = лСумма_НДС;
			НовСтрока.Сумма_с_НДС             = СуммаСНДС;
			НовСтрока.НомерПродукта           = СтруктСтрока.ШтрихКод;
			НовСтрока.НомерПродуктаПокупателя = СтруктСтрока.КодПокупателя;
			НовСтрока.КоличествоВУпаковке     = СтруктСтрока.КоличествоВУпаковке;
			
			//Для INSDES
			ТочкаДоставки = Неопределено;
			xmlТочкаДоставки = СокрЛП(СтруктСтрока.xmlТЧдоставкаGLN);
			НовСтрока.xmlТочкаДоставки = xmlТочкаДоставки;
			Результат = ЭКОМ_ТочкиДоставки_Найти("GLN", xmlТочкаДоставки, ТочкаДоставки);
			Если Результат = 1 Тогда
				НовСтрока.ТочкаДоставки = ТочкаДоставки;
			Иначе
				СоответствиеПоТочкамДоставки.Вставить("ТочкаДоставки_" + xmlТочкаДоставки, xmlТочкаДоставки);
			КонецЕсли;
			
			лСумма_НДС_Всего     = лСумма_НДС_Всего + лСумма_НДС;
			лСумма_Всего         = лСумма_Всего + лСуммаБезНДС + лСумма_НДС;		
		КонецЦикла;
		
		ЭКОМДок.СуммаДокументаВсего = лСумма_Всего;
		ЭКОМДок.СуммаНДСВсего       = лСумма_НДС_Всего;
			
		ЭКОМДок.ТекстОшибки = ""; // Очищаем ошибки документа
		ЭКОМДок.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.ПустаяСсылка(); // Обнуляем статус документ
		
		ВыполнитьДополнительныеДействия(ЭКОМДок, "Входящий INSDES", СтруктураДокумента, МассивЛогаСобытий, ТекстОшибки, 
		СоответствиеПоОрганизации,
		СоответствиеПоКонтрагенту,
		СоответствиеПоТочкамДоставки,
		СоответствиеПоНоменклатуре,
		КэшированныеЗначения);
				
		ЭКОМДок.ТЧ_Товары.Сортировать("НомерСтрокиXML Возр");
		
		// По умолчанию документ загружается и записывается, если ЭКОМ документ не нужен в гибких настройках необходимо поставить НеЗагружатьДокумент = Истина 
		Если ЭКОМДок.НеЗагружатьДокумент = Ложь Тогда
			
			СтруктураРегистраСобытий = Новый Структура; 
			СтруктураРегистраСобытий.Вставить("ДатаЗаписи"                  , ТекущаяДата());
			СтруктураРегистраСобытий.Вставить("Контрагент"                  , ЭКОМДок.Контрагент);
			СтруктураРегистраСобытий.Вставить("Организация"                 , ЭКОМДок.Организация);
			СтруктураРегистраСобытий.Вставить("НаправлениеОбмена"           , Перечисления.ЭКОМ_НаправлениеОбмена.Входящий);
			СтруктураРегистраСобытий.Вставить("ФайлИмя"                     , СтрокаТЗСтруктур.ИмяФайлаXML);
			СтруктураРегистраСобытий.Вставить("ЗаказДата"                   , ЭКОМДок.ЗаказДата);					
			СтруктураРегистраСобытий.Вставить("ЗаказНомер"                  , ЭКОМДок.ЗаказНомер);
			СтруктураРегистраСобытий.Вставить("СтруктураФайла"              , Новый ХранилищеЗначения(СтруктураДокумента,  Новый СжатиеДанных(9)));
			СтруктураРегистраСобытий.Вставить("Идентификатор"               , СтруктураДокумента.ИдФайл);
			
			Н = 1;
			
			Для Каждого Стр Из ЭКОМДок.ТЧ_Товары Цикл			
				// Проверка заполнения документа
				Если НЕ ЗначениеЗаполнено(Стр.ЕдиницаИзмерения) Тогда	
					ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "") 
					+ "В строке № " + Н + " " + "не заполнена единица измерения. (смотрите гибкие настройки или регистр сведений ЭКОМ_НоменклатураКонтрагентов)" 
					+ "(" + Стр.xmlЕдиницаИзмерения + ")"; 
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(Стр.Номенклатура) Тогда
					ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
					+ "В строке № " + Н + " " + "не заполнена номенклатура." 
					+ "(" + Стр.НомерПродукта + ")";
				КонецЕсли;
				
				Н = Н + 1;	
			КонецЦикла;
			
			Если НЕ ЗначениеЗаполнено(ЭКОМДок.Организация) Тогда
				ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
				+ "Не заполнена организация." + "(" + ЭКОМДок.xmlОрганизация + ")"; 
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ЭКОМДок.Контрагент) Тогда
				ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
				+ "Не заполнен контрагент." + "(" + ЭКОМДок.xmlКонтрагент + ")";
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ЭКОМДок.ТочкаДоставки) Тогда
				ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
				+ "Не заполнена точка доставки." + "(" + ЭКОМДок.xmlТочкаДоставки + ")";
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ЭКОМДок.Валюта) Тогда
				ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
				+ "Не заполнена валюта." + "(" + ЭКОМДок.xmlВалюта + ")";
			КонецЕсли;
			
			ДокументОбработан = ПроверитьОбработкуДокумента(ТекстОшибки, ЭКОМДок, СтруктураДокумента, СтруктураРегистраСобытий, ПредставлениеДокументаXML, МассивЛогаСобытий);
			Если ДокументОбработан = Ложь Тогда
				Продолжить;			
			КонецЕсли;
			
		Иначе 
			СтруктураДокумента.Вставить("Обработан", Ложь);
			ТекстЛогаСобытий = "В гибких настройках указано не загружать документ - " + ПредставлениеДокументаXML;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ СоответствиеПоОрганизации.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоОрганизации     , "Организация_");
	КонецЕсли;
	Если НЕ СоответствиеПоКонтрагенту.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоКонтрагенту     , "Контрагент_");
	КонецЕсли;
	Если НЕ СоответствиеПоТочкамДоставки.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоТочкамДоставки  , "ТочкаДоставки_");
	КонецЕсли;
	Если НЕ СоответствиеПоНоменклатуре.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоНоменклатуре    , "Номенклатура_");
	КонецЕсли;
	
КонецПроцедуры

Функция СоздатьЭКОМ_ДокУведомленияОПриемеRECADV(ТЗСтруктур, ДокументыШапка, пДокументыТабличнаяЧасть, МассивЛогаСобытий) Экспорт
	       
	// Запрос к табличной части
	Запрос = Новый Запрос;	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	пДокументыТабличнаяЧасть.HEAD_PACKINGSEQUENCE_POSITION_POSITIONNUMBER КАК НомерСтрокиТЧ,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_PACKINGSEQUENCE_POSITION_PRODUCT, 0, 100) КАК ШтрихКод,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_PACKINGSEQUENCE_POSITION_PRODUCTIDSUPPLIER, 0, 100) КАК КодПоставщика,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_PACKINGSEQUENCE_POSITION_PRODUCTIDBUYER, 0, 100) КАК КодПокупателя,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.xmlКонтрагентGLN, 0, 100) КАК xmlКонтрагентGLN,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_PACKINGSEQUENCE_POSITION_ACCEPTEDUNIT, 0, 100) КАК xmlЕдиницаИзмерения,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.ИдентификаторФайла, 0, 250) КАК ИдентификаторФайла,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_PACKINGSEQUENCE_POSITION_CHARACTERISTIC_DESCRIPTION, 0, 250) КАК ОписаниеПродуктаИзХарактеристики,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_PACKINGSEQUENCE_POSITION_DESCRIPTION, 0, 250) КАК ОписаниеПродукта,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_PACKINGSEQUENCE_POSITION_PRICE, 0, 250) КАК PRICE,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_PACKINGSEQUENCE_POSITION_PRICEWITHVAT, 0, 250) КАК PRICEWITHVAT,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_PACKINGSEQUENCE_POSITION_TAXRATE, 0, 250) КАК TAXRATE,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_PACKINGSEQUENCE_POSITION_ORDEREDQUANTITY, 0, 250) КАК ORDEREDQUANTITY,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_PACKINGSEQUENCE_POSITION_QUANTITYOFCUINTU, 0, 250) КАК QUANTITYOFCUINTU,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_PACKINGSEQUENCE_POSITION_CALIBRE, 0, 250) КАК CALIBRE,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_PACKINGSEQUENCE_POSITION_PACKING_PACKINGTYPE, 0, 250) КАК PACKINGTYPE,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_PACKINGSEQUENCE_POSITION_PACKING_PACKINGQUANTITY, 0, 250) КАК PACKINGQUANTITY,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_PACKINGSEQUENCE_POSITION_ACCEPTEDQUANTITY, 0, 250) КАК ACCEPTEDQUANTITY,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_PACKINGSEQUENCE_POSITION_DELIVERQUANTITY, 0, 250) КАК DELIVERQUANTITY,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_PACKINGSEQUENCE_POSITION_ORDERQUANTITY, 0, 250) КАК ORDERQUANTITY,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_PACKINGSEQUENCE_POSITION_PACKING_PACKINGUNIT, 0, 250) КАК PACKINGUNIT
	|ПОМЕСТИТЬ пДокументыТабличнаяЧасть
	|ИЗ
	|	&пДокументыТабличнаяЧасть КАК пДокументыТабличнаяЧасть
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	пДокументыТабличнаяЧасть.ИдентификаторФайла,
	|	пДокументыТабличнаяЧасть.ОписаниеПродуктаИзХарактеристики,
	|	пДокументыТабличнаяЧасть.ОписаниеПродукта,
	|	пДокументыТабличнаяЧасть.PRICE,
	|	пДокументыТабличнаяЧасть.PRICEWITHVAT,
	|	пДокументыТабличнаяЧасть.TAXRATE,
	|	пДокументыТабличнаяЧасть.ORDEREDQUANTITY,
	|	пДокументыТабличнаяЧасть.QUANTITYOFCUINTU,
	|	пДокументыТабличнаяЧасть.CALIBRE,
	|	пДокументыТабличнаяЧасть.PACKINGTYPE,
	|	пДокументыТабличнаяЧасть.PACKINGQUANTITY,
	|	пДокументыТабличнаяЧасть.PACKINGUNIT,
	|	пДокументыТабличнаяЧасть.xmlКонтрагентGLN КАК xmlКонтрагентGLN,
	|	пДокументыТабличнаяЧасть.НомерСтрокиТЧ КАК НомерСтрокиТЧ,
	|	пДокументыТабличнаяЧасть.ШтрихКод КАК ШтрихКод,
	|	пДокументыТабличнаяЧасть.КодПоставщика КАК КодПоставщика,
	|	пДокументыТабличнаяЧасть.КодПокупателя КАК КодПокупателя,
	|	ЭКОМ_GLN.Объект КАК Контрагент,
	|	пДокументыТабличнаяЧасть.xmlЕдиницаИзмерения КАК xmlЕдиницаИзмерения,
	|	пДокументыТабличнаяЧасть.ACCEPTEDQUANTITY,
	|	пДокументыТабличнаяЧасть.ORDERQUANTITY,
	|	пДокументыТабличнаяЧасть.DELIVERQUANTITY
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	пДокументыТабличнаяЧасть КАК пДокументыТабличнаяЧасть
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN
	|		ПО пДокументыТабличнаяЧасть.xmlКонтрагентGLN = ЭКОМ_GLN.GLN
	|			И (ЭКОМ_GLN.Объект ССЫЛКА Справочник.Контрагенты)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.ИдентификаторФайла,
	|	ВТ.ОписаниеПродуктаИзХарактеристики,
	|	ВТ.ОписаниеПродукта,
	|	ВТ.PRICE,
	|	ВТ.PRICEWITHVAT,
	|	ВТ.TAXRATE,
	|	ВТ.ORDEREDQUANTITY,
	|	ВТ.QUANTITYOFCUINTU,
	|	ВТ.CALIBRE,
	|	ВТ.PACKINGTYPE,
	|	ВТ.PACKINGQUANTITY,
	|	ВТ.PACKINGUNIT,
	|	ВТ.xmlКонтрагентGLN,
	|	ВТ.НомерСтрокиТЧ,
	|	ВТ.ШтрихКод,
	|	ВТ.КодПоставщика,
	|	ВТ.КодПокупателя,
	|	ВТ.Контрагент,
	|	ВТ.xmlЕдиницаИзмерения,
	|	ЕСТЬNULL(ЭКОМ_НоменклатураКонтрагентов.Номенклатура, НЕОПРЕДЕЛЕНО) КАК Номенклатура,
	|	ЕСТЬNULL(ЭКОМ_НоменклатураКонтрагентов.ХарактеристикаНоменклатуры, НЕОПРЕДЕЛЕНО) КАК ХарактеристикаНоменклатуры,
	|	ЭКОМ_НоменклатураКонтрагентов.ЕдиницаНоменклатурыКонтрагента КАК ЕдиницаИзмерения,
	|	ЭКОМ_ЗначениеДополнительныхКонстант.ЗначениеДополнительнойКонстанты КАК ЕдиницаИзмеренияПоУмолчанию,
	|	ВТ.ACCEPTEDQUANTITY,
	|	ВТ.ORDERQUANTITY,
	|	ВТ.DELIVERQUANTITY
	|ИЗ
	|	ВТ КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_НоменклатураКонтрагентов КАК ЭКОМ_НоменклатураКонтрагентов
	|		ПО ВТ.ШтрихКод = ЭКОМ_НоменклатураКонтрагентов.ШтрихКодНоменклатурыКонтрагента
	|			И ВТ.Контрагент = ЭКОМ_НоменклатураКонтрагентов.Контрагент
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_ЗначениеДополнительныхКонстант КАК ЭКОМ_ЗначениеДополнительныхКонстант
	|		ПО (ЭКОМ_ЗначениеДополнительныхКонстант.ДополнительнаяКонстанта = ""ЕдиницаИзмерения_"" + ВТ.xmlЕдиницаИзмерения)
	|			И (ЭКОМ_ЗначениеДополнительныхКонстант.Измерение = ""Единица измерения"")";
	Запрос.УстановитьПараметр("пДокументыТабличнаяЧасть", пДокументыТабличнаяЧасть);
	РезультатЗапроса = Запрос.Выполнить();
	ДокументыТабличнаяЧасть = РезультатЗапроса.Выгрузить();
	ДокументыТабличнаяЧасть.Индексы.Добавить("ИдентификаторФайла");
	
	// Запрос по шапке документов
	Запрос = Новый Запрос;	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДокументыШапка.DATE КАК ФайлДата,
	|	ПОДСТРОКА(ДокументыШапка.NUMBER, 1, 100) КАК ФайлНомер,
	|	ПОДСТРОКА(ДокументыШапка.HEAD_RECIPIENT, 1, 100) КАК xmlОрганизацияGLN,
	|	ПОДСТРОКА(ДокументыШапка.xmlКонтрагентGLN, 1, 100) КАК xmlКонтрагентGLN,
	|	ПОДСТРОКА(ДокументыШапка.HEAD_DELIVERYPLACE, 1, 100) КАК xmlТочкаДоставкиGLN,
	|	ДокументыШапка.ВидДокумента КАК ВидДокумента,
	|	ПОДСТРОКА(ДокументыШапка.ИдФайл, 1, 250) КАК ИдФайл,
	|	ПОДСТРОКА(ДокументыШапка.ORDERNUMBER, 1, 100) КАК ЗаказНомер,
	|	ДокументыШапка.ORDERDATE КАК ЗаказДата,
	|	ПОДСТРОКА(ДокументыШапка.DESADVNUMBER, 1, 100) КАК НомерУведомленияОбОтгрузке,
	|	ДокументыШапка.DESADVDATE КАК ДатаУведомленияОбОтгрузке,
	|	ПОДСТРОКА(ДокументыШапка.DELIVERYNOTENUMBER, 1, 100) КАК НомерНакладной,
	|	ДокументыШапка.DELIVERYNOTEDATE КАК ДатаНакладной,
	|	ДокументыШапка.ДатаЧислоПолученияДокумента КАК ДатаЧислоПолученияДокумента
	|ПОМЕСТИТЬ ДокументыШапка
	|ИЗ
	|	&ДокументыШапка КАК ДокументыШапка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДокументыШапка.ФайлДата КАК ФайлДата,
	|	ДокументыШапка.ФайлНомер КАК ФайлНомер,
	|	ДокументыШапка.xmlОрганизацияGLN КАК xmlОрганизацияGLN,
	|	ДокументыШапка.xmlКонтрагентGLN КАК xmlКонтрагентGLN,
	|	ДокументыШапка.xmlТочкаДоставкиGLN КАК xmlТочкаДоставкиGLN,
	|	ДокументыШапка.ВидДокумента КАК ВидДокумента,
	|	ДокументыШапка.ИдФайл КАК ИдФайл,
	|	ДокументыШапка.ЗаказНомер КАК ЗаказНомер,
	|	ДокументыШапка.ЗаказДата КАК ЗаказДата,
	|	ДокументыШапка.НомерУведомленияОбОтгрузке КАК НомерУведомленияОбОтгрузке,
	|	ДокументыШапка.ДатаУведомленияОбОтгрузке КАК ДатаУведомленияОбОтгрузке,
	|	ДокументыШапка.НомерНакладной КАК НомерНакладной,
	|	ДокументыШапка.ДатаНакладной КАК ДатаНакладной,
	|	ДокументыШапка.ДатаЧислоПолученияДокумента КАК ДатаЧислоПолученияДокумента,
	|	ЕСТЬNULL(ЭКОМ_ЦепочкиДокументовПоставщика.RECADV, НЕОПРЕДЕЛЕНО) КАК ЭКОМДок,
	|	ЕСТЬNULL(ЭКОМ_ЦепочкиДокументовПоставщика.RECADV.ПометкаУдаления, ЛОЖЬ) КАК ПометкаУдаления,
	|	ЕСТЬNULL(ЭКОМ_ЦепочкиДокументовПоставщика.RECADV.СтатусОбработкиДокумента, ЗНАЧЕНИЕ(Перечисление.ЭКОМ_Статусы.НеОбработан)) КАК СтатусОбработкиДокумента,
	|	ЭКОМ_GLN_Организация.Объект КАК Организация,
	|	ЭКОМ_GLN_Контрагент.Объект КАК Контрагент,
	|	ЭКОМ_ТочкиДоставки.Объект КАК ТочкаДоставки,
	|	ЕСТЬNULL(ЭКОМ_ЦепочкиДокументовПоставщика.Накладная, НЕОПРЕДЕЛЕНО) КАК ДокРеализации,
	|	ЕСТЬNULL(ЭКОМ_ЦепочкиДокументовПоставщика.ORDER, НЕОПРЕДЕЛЕНО) КАК ORDER,
	|	ЕСТЬNULL(ЭКОМ_ЦепочкиДокументовПоставщика.Заказ, НЕОПРЕДЕЛЕНО) КАК ДокЗаказа
	|ИЗ
	|	ДокументыШапка КАК ДокументыШапка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭКОМ_Документы КАК ЭКОМ_Документы
	|		ПО ДокументыШапка.ФайлДата = ЭКОМ_Документы.ФайлДата
	|			И ДокументыШапка.ФайлНомер = ЭКОМ_Документы.ФайлНомер
	|			И ДокументыШапка.ВидДокумента = ЭКОМ_Документы.ВидДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Организация
	|		ПО ДокументыШапка.xmlОрганизацияGLN = ЭКОМ_GLN_Организация.GLN
	|			И (НЕ ЭКОМ_GLN_Организация.Объект ССЫЛКА Справочник.Контрагенты)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Контрагент
	|		ПО ДокументыШапка.xmlКонтрагентGLN = ЭКОМ_GLN_Контрагент.GLN
	|			И (ЭКОМ_GLN_Контрагент.Объект ССЫЛКА Справочник.Контрагенты)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_ТочкиДоставки КАК ЭКОМ_ТочкиДоставки
	|		ПО ДокументыШапка.xmlТочкаДоставкиGLN = ЭКОМ_ТочкиДоставки.GLN
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_ЦепочкиДокументовПоставщика КАК ЭКОМ_ЦепочкиДокументовПоставщика
	|		ПО ДокументыШапка.xmlКонтрагентGLN = ЭКОМ_ЦепочкиДокументовПоставщика.xmlКонтрагент
	|			И (ЭКОМ_ЦепочкиДокументовПоставщика.ORDERDATE <= ДокументыШапка.ФайлДата <= ДОБАВИТЬКДАТЕ(ЭКОМ_ЦепочкиДокументовПоставщика.ORDERDATE, МЕСЯЦ, 2))
	|			И (ВЫБОР
	|				КОГДА ДокументыШапка.ЗаказНомер = """"
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ДокументыШапка.ЗаказНомер = ПОДСТРОКА(ЭКОМ_ЦепочкиДокументовПоставщика.ORDERNUMBER, 1, 100)
	|			КОНЕЦ)
	|			И (ВЫБОР
	|				КОГДА ДокументыШапка.ЗаказДата = ДАТАВРЕМЯ(1, 1, 1)
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ДокументыШапка.ЗаказДата = ЭКОМ_ЦепочкиДокументовПоставщика.ORDERDATE
	|			КОНЕЦ)
	|			И (ВЫБОР
	|				КОГДА ДокументыШапка.НомерУведомленияОбОтгрузке = """"
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ДокументыШапка.НомерУведомленияОбОтгрузке = ПОДСТРОКА(ЭКОМ_ЦепочкиДокументовПоставщика.Накладная.Номер, 1, 100)
	|			КОНЕЦ)
	|			И (ВЫБОР
	|				КОГДА ДокументыШапка.ДатаУведомленияОбОтгрузке = ДАТАВРЕМЯ(1, 1, 1)
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ДокументыШапка.ДатаУведомленияОбОтгрузке = НАЧАЛОПЕРИОДА(ЭКОМ_ЦепочкиДокументовПоставщика.Накладная.Дата, ДЕНЬ)
	|			КОНЕЦ)
	|			И (ВЫБОР
	|				КОГДА ДокументыШапка.НомерНакладной = """"
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ДокументыШапка.НомерНакладной = ПОДСТРОКА(ЭКОМ_ЦепочкиДокументовПоставщика.Накладная.Номер, 1, 100)
	|			КОНЕЦ)
	|			И (ВЫБОР
	|				КОГДА ДокументыШапка.ДатаНакладной = ДАТАВРЕМЯ(1, 1, 1)
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ДокументыШапка.ДатаНакладной = НАЧАЛОПЕРИОДА(ЭКОМ_ЦепочкиДокументовПоставщика.Накладная.Дата, ДЕНЬ)
	|			КОНЕЦ)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДокументыШапка.ДатаЧислоПолученияДокумента";
	
	Запрос.УстановитьПараметр("ДокументыШапка", ДокументыШапка);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ПроверкаНаДублирование = Новый Соответствие;
	
	СоответствиеПоОрганизации      = Новый Соответствие;
	СоответствиеПоКонтрагенту      = Новый Соответствие;
	СоответствиеПоТочкамДоставки   = Новый Соответствие;
	СоответствиеПоНоменклатуре     = Новый Соответствие;
	
	Пользователь = НайтиТекущегоПользователя();
	
	КэшированныеЗначенияЗапроса = Новый ТаблицаЗначений;
	КэшированныеЗначенияЗапроса.Колонки.Добавить("НомерУведомленияОбОтгрузке", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(100)));
	КэшированныеЗначенияЗапроса.Колонки.Добавить("DOCTYPE", 			Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(100)));
	КэшированныеЗначенияЗапроса.Колонки.Добавить("xmlКонтрагентGLN", 	Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(100)));
	КэшированныеЗначенияЗапроса.Колонки.Добавить("ЭКОМДок", 			Новый ОписаниеТипов("ДокументСсылка.ЭКОМ_Документы"));
	КэшированныеЗначенияЗапроса.Колонки.Добавить("ПометкаУдаления", 	Новый ОписаниеТипов("Булево"));
	КэшированныеЗначенияЗапроса.Колонки.Добавить("ИмяФайла", 			Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(300)));	
	КэшированныеЗначенияЗапроса.Индексы.Добавить("НомерУведомленияОбОтгрузке, xmlКонтрагентGLN");
	КэшированныеЗначенияЗапроса.Индексы.Добавить("ЭКОМДок");
	
	КэшированныеЗначения = Новый Соответствие;
	ИмяСобытия = "Создание документа Docrobot-RECADV";
	Пока Выборка.Следующий() Цикл
		
		// Для проверки дублирования строк
		Если ПроверкаНаДублирование.Получить(Выборка.ИдФайл) = Неопределено Тогда
			ПроверкаНаДублирование.Вставить(Выборка.ИдФайл, "Строка добавлена");
		Иначе			
			ТекстЛогаСобытий = "Дублирование данных, проверьте GLN организации, контрагента, точки доставки ИД документа - " + Выборка.ИдФайл;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Продолжить;
			
		КонецЕсли;
		
		// Получаем структуру документа
		СтруктураДокумента = Неопределено;
		СтрокаТЗСтруктур = ТЗСтруктур.Найти(Выборка.ИдФайл, "ИдентификаторФайла");
		Если СтрокаТЗСтруктур = Неопределено Тогда			
			ТекстЛогаСобытий = "Не найдена структура документа с ИД = " + Выборка.ИдФайл;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
	
			Продолжить;
			
		Иначе
			
			СтруктураДокумента = СтрокаТЗСтруктур.СтруктураДокумента;
			
		КонецЕсли;
		
		ПредставлениеДокументаXML = "RECADV № " + Выборка.ФайлНомер + " от " + Формат(Выборка.ФайлДата, "ДФ='dd.MM.yyyy г.'");
		
		ЭКОМДок = Выборка.ЭКОМДок;
		
		Если ЭКОМДок = Неопределено
			ИЛИ ЭКОМДок = ПредопределенноеЗначение("Документ.ЭКОМ_Документы.ПустаяСсылка") Тогда
			ОтборДляКэша = Новый Структура("НомерУведомленияОбОтгрузке, xmlКонтрагентGLN", Выборка.НомерУведомленияОбОтгрузке, Выборка.xmlКонтрагентGLN);
			СтрокиКэша = КэшированныеЗначенияЗапроса.НайтиСтроки(ОтборДляКэша);
			Если НЕ СтрокиКэша.Количество() = 0 Тогда
				ЭКОМДок 				= СтрокиКэша.Получить(0).ЭКОМДок;
				Выборка.ПометкаУдаления = СтрокиКэша.Получить(0).ПометкаУдаления;
				Выборка.ИмяФайла 		= СтрокиКэша.Получить(0).ИмяФайла;
			КонецЕсли;
		КонецЕсли;
		
		Если ЭКОМДок = Неопределено
			ИЛИ ЭКОМДок = ПредопределенноеЗначение("Документ.ЭКОМ_Документы.ПустаяСсылка") Тогда
			Если ВРег(СтруктураДокумента.DOCTYPE) = "D" Тогда// Принимается отмена при отсутствии оригинала. Такой документ пропускаем и удаляем на платформе
				ТекстЛогаСобытий = "Не найдено уведомление о приёме-основание для аннулирования %RECADVNUMBER% от %RECADVDATE%";
				ТекстЛогаСобытий = СтрЗаменить(ТекстЛогаСобытий, "%RECADVNUMBER%", Выборка.ФайлНомер);
				ТекстЛогаСобытий = СтрЗаменить(ТекстЛогаСобытий, "%RECADVDATE%", Формат(Выборка.ФайлДата, "ДФ=dd.MM.yyyy"));
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
				
				СтруктураДокумента.Вставить("Обработан", Истина);
				
				Продолжить;
			Иначе // Создание нового документа (O или R при отсутствии O)
				ЭКОМДок = Документы.ЭКОМ_Документы.СоздатьДокумент();
			КонецЕсли;
		ИначеЕсли ЭКОМДок.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.НеОбработан // Редактирование ранее принятого документа (полностью очищаем текущий документ)
			И СтрокаТЗСтруктур.ИмяФайлаXML = ЭКОМДок.ИмяФайла Тогда
			ЭКОМДок = ЭКОМДок.ПолучитьОбъект();
			ЗаполнитьЗначенияСвойств(ЭКОМДок, Документы.ЭКОМ_Документы.ПустаяСсылка());
			ЭКОМДок.ПометкаУдаления = Ложь;
			ЭКОМДок.ТЧ_Товары.Очистить();
			ЭКОМДок.ДокументыСвязанные.Очистить();
			// Очищение остальных табличных частей документов в гибких настроках при необходимости
			
		ИначеЕсли НЕ СтрокаТЗСтруктур.ИмяФайлаXML = ЭКОМДок.ИмяФайла Тогда // Сюда попадают варианты с повтором О и D (если у них разыне имена), а также R, если предыдущий документ этой цепочки найден
			ЭтоПовторныйДокумент = ВРег(ЭКОМДок.ТипДокумента) = ВРег(СтруктураДокумента.DOCTYPE)
			И НЕ ВРег(СтруктураДокумента.DOCTYPE) = "R"
			И (НЕ Выборка.ПометкаУдаления ИЛИ ВРег(СтруктураДокумента.DOCTYPE) = "D");
			Документ1С = ЭКОМДок.Документ1С; // Переносим документ 1С к следующему ЭКОМ документу.
			Реализации = ЭКОМДок.ДокументыСвязанные.Выгрузить(); // Переносим реализации к следущему ЭКОМ документу.
			Если НЕ ЭтоПовторныйДокумент Тогда
				ТекстЛогаСобытий = "Уведомление о приёме № %RECADVNUMBER% от %RECADVDATE% было %DOCTYPE%!";
				Если ВРег(СтруктураДокумента.DOCTYPE) = "O" Тогда
					ТекстЛогаСобытий = СтрЗаменить(ТекстЛогаСобытий, "%DOCTYPE%", "заменено");
				ИначеЕсли ВРег(СтруктураДокумента.DOCTYPE) = "R" Тогда
					ТекстЛогаСобытий = СтрЗаменить(ТекстЛогаСобытий, "%DOCTYPE%", "скорректировано");
				ИначеЕсли ВРег(СтруктураДокумента.DOCTYPE) = "D" Тогда
					ТекстЛогаСобытий = СтрЗаменить(ТекстЛогаСобытий, "%DOCTYPE%", "аннулировано");
				КонецЕсли;
				ТекстЛогаСобытий = СтрЗаменить(ТекстЛогаСобытий, "%RECADVNUMBER%", Выборка.ФайлНомер);
				ТекстЛогаСобытий = СтрЗаменить(ТекстЛогаСобытий, "%RECADVDATE%", Формат(Выборка.ФайлДата, "ДФ=dd.MM.yyyy"));
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

			КонецЕсли;
			ЭКОМДок = Документы.ЭКОМ_Документы.СоздатьДокумент();
			ЭКОМДок.ЭтоПовторныйДокумент = ЭтоПовторныйДокумент;
			ЭКОМДок.Документ1С = Документ1С;
			ЭКОМДок.ДокументыСвязанные.Загрузить(Реализации);
			
		Иначе // Остальыне ситуации. Предполагается, что документ уже есть и изменять его запрещено
			ТекстЛогаСобытий = Строка(Выборка.ВидДокумента) + " - ЭКОМ документ уже существует в 1С, номер = " 
			+ ЭКОМДок.Номер + " от " + ЭКОМДок.Дата;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Продолжить;
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Выборка.Организация) Тогда
			СоответствиеПоОрганизации.Вставить("Организация_" + Выборка.xmlОрганизацияGLN, Выборка.xmlОрганизацияGLN);	
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Выборка.Контрагент) Тогда
			СоответствиеПоКонтрагенту.Вставить("Контрагент_" + Выборка.xmlКонтрагентGLN, Выборка.xmlКонтрагентGLN);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Выборка.ТочкаДоставки) Тогда
			СоответствиеПоТочкамДоставки.Вставить("ТочкаДоставки_" + Выборка.xmlТочкаДоставкиGLN, Выборка.xmlТочкаДоставкиGLN);
		КонецЕсли;
		
		Если ЭКОМДок.ДокументыСвязанные.Количество() = 0
			И ЗначениеЗаполнено(Выборка.ДокРеализации) Тогда
			НовДок = ЭКОМДок.ДокументыСвязанные.Добавить();
			НовДок.ДокументСвязанный = Выборка.ДокРеализации;
		КонецЕсли;
		
		xmlВалюта = "RUB";
		Если ЗначениеЗаполнено(СтруктураДокумента.CURRENCY) Тогда
			xmlВалюта = СтруктураДокумента.CURRENCY;
		КонецЕсли;
		
		xmlКонтрагентORDER = Выборка.xmlКонтрагентGLN;
		КонтрагентORDER    = Выборка.Контрагент;	
		Валюта             = Неопределено;
		Если ЗначениеЗаполнено(Выборка.ORDER) Тогда	 
			Валюта    = Выборка.ORDER.Валюта;
			xmlВалюта = ?(ЗначениеЗаполнено(Выборка.ORDER.xmlВалюта), Выборка.ORDER.xmlВалюта, "RUB");
			КонтрагентORDER    = Выборка.ORDER.Контрагент;
			xmlКонтрагентORDER = Выборка.ORDER.xmlКонтрагент;
		КонецЕсли;
		
		// Шапка
		ЭКОМДок.Организация               = Выборка.Организация;
		ЭКОМДок.xmlОрганизация            = Выборка.xmlОрганизацияGLN;
		ЭКОМДок.ВидДокумента              = Перечисления.ЭКОМ_ВидыДокументов.RECADV_Входящий;
		ЭКОМДок.Контрагент                = Выборка.Контрагент;
		ЭКОМДок.xmlКонтрагент             = Выборка.xmlКонтрагентGLN;
		ЭКОМДок.Дата                      = ТекущаяДата();
		ЭКОМДок.ЗаказНомер                = Выборка.ЗаказНомер;
		ЭКОМДок.ЗаказДата                 = Выборка.ЗаказДата;
		ЭКОМДок.xmlВалюта                 = xmlВалюта;
		ЭКОМДок.ИмяФайла                  = СтрокаТЗСтруктур.ИмяФайлаXML;	
		ЭКОМДок.ДатаПоставки              = СтруктураДокумента.DELIVERYDATE;
		ЭКОМДок.Документ1С                = Выборка.ДокЗаказа;
		ЭКОМДок.ТочкаДоставки             = Выборка.ТочкаДоставки;
		ЭКОМДок.xmlТочкаДоставки          = Выборка.xmlТочкаДоставкиGLN;
		ЭКОМДок.ИнформацияПоДокументу     = СтруктураДокумента.INFO;
		ЭКОМДок.ТипДокумента              = СтруктураДокумента.DOCTYPE;
		ЭКОМДок.НомерТранзакции           = СтруктураДокумента.HEAD_EDIINTERCHANGEID;
		ЭКОМДок.НакладнаяДата             = ?(ЗначениеЗаполнено(Выборка.ДатаНакладной), Выборка.ДатаНакладной, Выборка.ДатаУведомленияОбОтгрузке);
		ЭКОМДок.НакладнаяНомер            = ?(ЗначениеЗаполнено(Выборка.НомерНакладной), Выборка.НомерНакладной, Выборка.НомерУведомленияОбОтгрузке);
		ЭКОМДок.Ответственный             = Пользователь;
		ЭКОМДок.ФайлНомер                 = Выборка.ФайлНомер;
		ЭКОМДок.ФайлДата                  = Выборка.ФайлДата;
		ЭКОМДок.Валюта                    = Валюта;
		ЭКОМДок.ORDERVID                  = СтруктураДокумента.ORDERVID;
			
		// Точка доставки = Контрагенту
		Если ЗначениеЗаполнено(Выборка.xmlТочкаДоставкиGLN) 
			И Выборка.xmlКонтрагентGLN = Выборка.xmlТочкаДоставкиGLN Тогда
			ЭКОМДок.Контрагент    = КонтрагентORDER;
			ЭКОМДок.xmlКонтрагент = xmlКонтрагентORDER;
		КонецЕсли;
		
		// ТЧ товары
		СуммаВсегоБезНДС = 0;
		СуммаВсегоНДС    = 0;
		ТекстОшибки      = "";
		
		ПроверкаНаДублированиеТЧ = Новый Соответствие;
		
		Отбор = Новый Структура();
		Отбор.Вставить("ИдентификаторФайла", Выборка.ИдФайл);
		МассивСтрок = ДокументыТабличнаяЧасть.НайтиСтроки(Отбор);		
		Для Каждого СтруктСтрока Из МассивСтрок Цикл	
			
			СоставнойШтрихКод = СокрЛП(СтруктСтрока.НомерСтрокиТЧ) + "_" + СокрЛП(СтруктСтрока.ШтрихКод);
			Если ЗначениеЗаполнено(СтруктСтрока.ШтрихКод) Тогда
				Если ПроверкаНаДублированиеТЧ.Получить(СоставнойШтрихКод) = Неопределено Тогда
					ПроверкаНаДублированиеТЧ.Вставить(СоставнойШтрихКод, "Строка добавлена");
				Иначе
					
					ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
					+ "Дубль данных, проверьте номенклатуру - " + СтруктСтрока.ШтрихКод + ", строка - " + СокрЛП(СтруктСтрока.НомерСтрокиТЧ);
					
					Продолжить;
					
				КонецЕсли;		
			КонецЕсли;
			
			Номенклатура     = СтруктСтрока.Номенклатура; 
			ЕдиницаИзмерения = СтруктСтрока.ЕдиницаИзмерения;
			
			Если НЕ ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда			 							
				ЕдиницаИзмерения = СтруктСтрока.ЕдиницаИзмеренияПоУмолчанию;			
			КонецЕсли;
						
			ЦенаБезНДС   = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.PRICE);
			ЦенаСНДС     = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.PRICEWITHVAT);		
			СтавкаНДСДок = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.TAXRATE);
			знКоличество = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.ACCEPTEDQUANTITY);
			
			Если НЕ ЗначениеЗаполнено(СтавкаНДСДок) Тогда
				Если ЦенаБезНДС <> ЦенаСНДС 
					И ЦенаБезНДС <> 0
					И ЦенаСНДС   <> 0 Тогда
					СтавкаНДСДок = Окр(((ЦенаСНДС - ЦенаБезНДС) / ЦенаБезНДС) * 100);
				Иначе
					СтавкаНДСДок = 0;
				КонецЕсли;  
			КонецЕсли;
			
			СуммаСНДС = ЦенаСНДС * знКоличество;	
			Если ЦенаБезНДС = 0 Тогда
				Если (СуммаСНДС > 0) И (знКоличество > 0) Тогда
					ЦенаСНДС      = Окр(СуммаСНДС/знКоличество, 4);			
					ЦенаБезНДС    = Окр( (ЦенаСНДС * 100) / (100 + СтавкаНДСДок) , 4);
				КонецЕсли;
			КонецЕсли;
			
			Если ЦенаСНДС = 0 Тогда
				ЦенаСНДС  = Окр( (ЦенаБезНДС * (100 + СтавкаНДСДок)) / 100 , 4);
				СуммаСНДС = ЦенаСНДС * знКоличество;
			КонецЕсли;	
			
			СуммаБезНДС     = ЦенаБезНДС * знКоличество;		 
			Если СуммаБезНДС = 0  Тогда
				Если (СуммаСНДС > 0) Тогда 
					СуммаБезНДС = Окр((СуммаСНДС * 100) / (100 + СтавкаНДСДок) ,2);	
				КонецЕсли;
			КонецЕсли;
			
			Если СуммаСНДС = 0 Тогда
				СуммаСНДС = СуммаБезНДС + Окр((СуммаБезНДС * СтавкаНДСДок)/ 100, 2); 	
			КонецЕсли; 
			
			//СуммаНДС = Окр(СуммаБезНДС * (СтавкаНДСДок/100), 4);	
			СуммаНДС = СуммаСНДС - СуммаБезНДС;
			
			НовСтрока                         = ЭКОМДок.ТЧ_Товары.Добавить();
			НовСтрока.Цена                    = ЦенаБезНДС;
			НовСтрока.ЦенаСНДС                = ЦенаСНДС;
			НовСтрока.Сумма                   = СуммаБезНДС;
			НовСтрока.СтавкаНДС               = СтавкаНДСДок;
			НовСтрока.СуммаНДС                = СуммаНДС;
			НовСтрока.Сумма_с_НДС             = СуммаСНДС;
			НовСтрока.Номенклатура            = Номенклатура;
			НовСтрока.НомерПродукта           = СтруктСтрока.ШтрихКод;
			НовСтрока.НомерПродуктаПоставщика = СтруктСтрока.КодПоставщика;
			НовСтрока.НомерПродуктаПокупателя = СтруктСтрока.КодПокупателя;
			НовСтрока.ОписаниеПродукта        = ?(ЗначениеЗаполнено(СтруктСтрока.ОписаниеПродукта), СтруктСтрока.ОписаниеПродукта, СтруктСтрока.ОписаниеПродуктаИзХарактеристики);
			НовСтрока.ЕдиницаИзмерения        = ЕдиницаИзмерения;
			НовСтрока.xmlЕдиницаИзмерения     = СтруктСтрока.xmlЕдиницаИзмерения;
			НовСтрока.КоличествоПоставляемое  = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.DELIVERQUANTITY);
			НовСтрока.КоличествоЗаказанное    = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.ORDERQUANTITY);
			НовСтрока.КоличествоПринятое      = знКоличество;
			НовСтрока.НомерСтрокиXML          = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.НомерСтрокиТЧ);
			
			СуммаВсегоБезНДС = СуммаВсегоБезНДС + СуммаБезНДС;
			СуммаВсегоНДС = СуммаВсегоНДС + СуммаНДС;
			
		КонецЦикла;
		
		ЭКОМДок.СуммаДокументаВсего = СуммаВсегоБезНДС + СуммаВсегоНДС;
		ЭКОМДок.СуммаНДСВсего       = СуммаВсегоНДС;
		
		ЭКОМДок.ТекстОшибки = ""; // Очищаем ошибки документа
		ЭКОМДок.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.ПустаяСсылка(); // Обнуляем статус документ
		
		ВыполнитьДополнительныеДействия(ЭКОМДок, "Входящий RECADV",
		СтруктураДокумента,
		МассивЛогаСобытий,
		ТекстОшибки,
		,
		,
		,
		,
		КэшированныеЗначения);		
				
		ЭКОМДок.ТЧ_Товары.Сортировать("НомерСтрокиXML Возр");
		
		// По умолчанию документ загружается и записывается, если ЭКОМ документ не нужен в гибких настройках необходимо поставить НеЗагружатьДокумент = Истина 
		Если ЭКОМДок.НеЗагружатьДокумент = Ложь Тогда
			
			СтруктураРегистраСобытий = Новый Структура; 
			СтруктураРегистраСобытий.Вставить("ДатаЗаписи"                  , ТекущаяДата());
			СтруктураРегистраСобытий.Вставить("Контрагент"                  , ЭКОМДок.Контрагент);
			СтруктураРегистраСобытий.Вставить("Организация"                 , ЭКОМДок.Организация);
			СтруктураРегистраСобытий.Вставить("НаправлениеОбмена"           , Перечисления.ЭКОМ_НаправлениеОбмена.Входящий);
			СтруктураРегистраСобытий.Вставить("ФайлИмя"                     , ЭКОМДок.ИмяФайла);
			СтруктураРегистраСобытий.Вставить("ЗаказДата"                   , ЭКОМДок.ЗаказДата);					
			СтруктураРегистраСобытий.Вставить("ЗаказНомер"                  , ЭКОМДок.ЗаказНомер);
			СтруктураРегистраСобытий.Вставить("СтруктураФайла"              , Новый ХранилищеЗначения(СтруктураДокумента,  Новый СжатиеДанных(9)));
			СтруктураРегистраСобытий.Вставить("Идентификатор"               , СтруктураДокумента.ИдФайл);
			
			// Проверяем количество заказнное с количеством поставляемым 
			Если ЗначениеЗаполнено(Выборка.ORDER) Тогда
				Для каждого Стр Из Выборка.ORDER.ТЧ_Товары  Цикл
					НайденнаяСтрока = ЭКОМДок.ТЧ_Товары.Найти(Стр.Номенклатура, "Номенклатура");
					Если НайденнаяСтрока = Неопределено Тогда
						ЭКОМДок.Комментарий = СокрЛП(ЭКОМДок.Комментарий) + ?(ЗначениеЗаполнено(ЭКОМДок.Комментарий), Символы.ПС, "")
						//Docrobot 1.20.0 MOD-1738 [добавлен формат чисел]
						+ "По штрихкоду " + Стр.НомерПродукта + " (" + Стр.ОписаниеПродукта + ")" + " есть расхождения, заказано - " 
						+ Формат(Стр.КоличествоЗаказанное,"ЧДЦ=3; ЧРД=.; ЧН=0; ЧГ=0") + ", принято - 0";
					Иначе
						Если НЕ НайденнаяСтрока.КоличествоПоставляемое = НайденнаяСтрока.КоличествоПринятое Тогда
							ЭКОМДок.Комментарий = СокрЛП(ЭКОМДок.Комментарий) + ?(ЗначениеЗаполнено(ЭКОМДок.Комментарий), Символы.ПС, "")
							+ "По штрихкоду " + НайденнаяСтрока.НомерПродукта + " (" + НайденнаяСтрока.ОписаниеПродукта + ")" + " есть расхождения, отгружено - " 
							+ Формат(НайденнаяСтрока.КоличествоПоставляемое,"ЧДЦ=3; ЧРД=.; ЧН=0; ЧГ=0") + ", принято - " + Формат(НайденнаяСтрока.КоличествоПринятое,"ЧДЦ=3; ЧРД=.; ЧН=0; ЧГ=0");
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Для Каждого Стр Из ЭКОМДок.ТЧ_Товары Цикл
				
				Если НЕ ЗначениеЗаполнено(Стр.Номенклатура)
					И ЗначениеЗаполнено(ЭКОМДок.Контрагент) Тогда
					НомерПродуктаПокупателя = ?(ЗначениеЗаполнено(Стр.НомерПродуктаПокупателя) , "_" + Стр.НомерПродуктаПокупателя, "");
					Код = ?(ЗначениеЗаполнено(Стр.НомерПродукта), Стр.НомерПродукта + НомерПродуктаПокупателя, Стр.НомерПродуктаПокупателя) + "_" + ЭКОМДок.xmlКонтрагент;
					СоответствиеПоНоменклатуре.Вставить("АртикулНоменклатурыКонтрагента_"      + Код, Стр.НомерПродуктаПоставщика); // PRODUCTIDSUPPLIER
					СоответствиеПоНоменклатуре.Вставить("КодНоменклатурыКонтрагента_"          + Код, Стр.НомерПродуктаПокупателя); // PRODUCTIDBUYER
					СоответствиеПоНоменклатуре.Вставить("ШтрихКодНоменклатурыКонтрагента_"     + Код, Стр.НомерПродукта);           // PRODUCT
					СоответствиеПоНоменклатуре.Вставить("НаименованиеНоменклатурыКонтрагента_" + Код, Стр.ОписаниеПродукта);
					СоответствиеПоНоменклатуре.Вставить("ЕдиницаНоменклатурыКонтрагента_"      + Код, Стр.ЕдиницаИзмерения);
					СоответствиеПоНоменклатуре.Вставить("Контрагент_"                          + Код, ЭКОМДок.Контрагент);
					СоответствиеПоНоменклатуре.Вставить("xmlЕдиницаИзмерения_"                 + Код, Стр.xmlЕдиницаИзмерения); // Информация при выборе ед. измерения из справочника
				КонецЕсли;

				// Проверка заполнения документа
				Если НЕ ЗначениеЗаполнено(Стр.ЕдиницаИзмерения) Тогда	
					ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
					+ "В строке № " + Строка(стр.НомерСтроки) + " не заполнена единица измерения. (смотрите гибкие настройки или регистр сведений ЭКОМ_НоменклатураКонтрагентов)" 
					+ "(" + Стр.xmlЕдиницаИзмерения + ")"; 
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(Стр.Номенклатура) Тогда
					ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
					+ "В строке № " + Строка(стр.НомерСтроки) + " не заполнена номенклатура." 
					+ "(" + Стр.НомерПродукта + ")";
				КонецЕсли;
				
			КонецЦикла;
			
			Если НЕ ЗначениеЗаполнено(ЭКОМДок.Организация) Тогда
				ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
				+ "Не заполнена организация." + "(" + ЭКОМДок.xmlОрганизация + ")"; 
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ЭКОМДок.Контрагент) Тогда
				ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
				+ "Не заполнен контрагент." + "(" + ЭКОМДок.xmlКонтрагент + ")";
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ЭКОМДок.ТочкаДоставки) Тогда
				ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
				+ "Не заполнена точка доставки." + "(" + ЭКОМДок.xmlТочкаДоставки + ")";
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ЭКОМДок.Валюта) Тогда
				ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
				+ "Не заполнена валюта." + "(" + ЭКОМДок.xmlВалюта + ")";
			КонецЕсли;
			
			ДокументОбработан = ПроверитьОбработкуДокумента(ТекстОшибки, ЭКОМДок, СтруктураДокумента, СтруктураРегистраСобытий, ПредставлениеДокументаXML, МассивЛогаСобытий);
			Если ДокументОбработан = Ложь Тогда
				Продолжить;			
			КонецЕсли;
			
			Если КэшированныеЗначенияЗапроса.Найти(ЭКОМДок.Ссылка, "ЭКОМДок") = Неопределено Тогда
				СтрокаКэша = КэшированныеЗначенияЗапроса.Добавить();
				СтрокаКэша.НомерУведомленияОбОтгрузке = Выборка.НомерУведомленияОбОтгрузке;
				СтрокаКэша.DOCTYPE = ВРег(ЭКОМДок.ТипДокумента);
				СтрокаКэша.xmlКонтрагентGLN = ЭКОМДок.xmlКонтрагент;
				СтрокаКэша.ЭКОМДок = ЭКОМДок.Ссылка;
				СтрокаКэша.ПометкаУдаления = ЭКОМДок.ПометкаУдаления;
				СтрокаКэша.ИмяФайла = ЭКОМДок.ИмяФайла;
			КонецЕсли;
			
		Иначе 			
			СтруктураДокумента.Вставить("Обработан", Ложь);
			ТекстЛогаСобытий = "В гибких настройках указано не загружать документ - " + ПредставлениеДокументаXML;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
		КонецЕсли;	
		
	КонецЦикла;
	
	Если НЕ СоответствиеПоОрганизации.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоОрганизации     , "Организация_");
	КонецЕсли;
	Если НЕ СоответствиеПоКонтрагенту.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоКонтрагенту     , "Контрагент_");
	КонецЕсли;
	Если НЕ СоответствиеПоТочкамДоставки.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоТочкамДоставки  , "ТочкаДоставки_");
	КонецЕсли;
	Если НЕ СоответствиеПоНоменклатуре.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоНоменклатуре    , "Номенклатура_");
	КонецЕсли;
	
КонецФункции

Процедура СоздатьЭКОМ_ДокПрайсЛистPRICAT(ТЗСтруктур, ДокументыШапка, пДокументыТабличнаяЧасть, МассивЛогаСобытий)
	
	// Запрос к табличной части заполняем в гибких настройках
	
	// Запрос по шапке документов
	Запрос = Новый Запрос;	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДокументыШапка.PRICATDATE КАК ДатаПрайса,
	|	ПОДСТРОКА(ДокументыШапка.PRICATNUMBER, 1, 100) КАК НомерПрайса,
	|	ПОДСТРОКА(ДокументыШапка.RECIPIENT, 1, 100) КАК xmlОрганизацияGLN,
	|	ПОДСТРОКА(ДокументыШапка.SENDER, 1, 100) КАК xmlКонтрагентGLN,
	|	ДокументыШапка.ВидДокумента КАК ВидДокумента,
	|	ПОДСТРОКА(ДокументыШапка.ИдФайл, 1, 250) КАК ИдФайл,
	|	ДокументыШапка.ДатаЧислоПолученияДокумента КАК ДатаЧислоПолученияДокумента
	|ПОМЕСТИТЬ ДокументыШапка
	|ИЗ
	|	&ДокументыШапка КАК ДокументыШапка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДокументыШапка.ДатаПрайса,
	|	ДокументыШапка.НомерПрайса,
	|	ДокументыШапка.xmlОрганизацияGLN,
	|	ДокументыШапка.xmlКонтрагентGLN,
	|	ДокументыШапка.ВидДокумента,
	|	ЕСТЬNULL(ЭКОМ_Документы.Ссылка, НЕОПРЕДЕЛЕНО) КАК ЭКОМДок,
	|	ЭКОМ_Документы.ПометкаУдаления КАК ПометкаУдаления,
	|	ЭКОМ_Документы.СтатусОбработкиДокумента КАК СтатусОбработкиДокумента,
	|	ЭКОМ_GLN_Организация.Объект КАК Организация,
	|	ЭКОМ_GLN_Контрагент.Объект КАК Контрагент,
	|	ДокументыШапка.ИдФайл КАК ИдФайл,
	|	ДокументыШапка.ДатаЧислоПолученияДокумента КАК ДатаЧислоПолученияДокумента,
	|	ЕСТЬNULL(КОЛИЧЕСТВО(ЭКОМ_ДокументыПовторный.Ссылка), 0) КАК КоличествоЭКОМДокПовторных,
	|	ЭКОМ_ДокументыИсходящий.Ссылка КАК ЭКОМ_ДокументыИсходящий
	|ИЗ
	|	ДокументыШапка КАК ДокументыШапка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭКОМ_Документы КАК ЭКОМ_Документы
	|		ПО ДокументыШапка.ДатаПрайса = ЭКОМ_Документы.ФайлДата
	|			И ДокументыШапка.НомерПрайса = ЭКОМ_Документы.ФайлНомер
	|			И ДокументыШапка.ВидДокумента = ЭКОМ_Документы.ВидДокумента
	|			И ДокументыШапка.xmlКонтрагентGLN = ЭКОМ_Документы.xmlКонтрагент
	|			И (ДокументыШапка.ИдФайл + "".xml"" = ПОДСТРОКА(ЭКОМ_Документы.ИмяФайла, 0, 200))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Организация
	|		ПО ДокументыШапка.xmlОрганизацияGLN = ЭКОМ_GLN_Организация.GLN
	|			И (НЕ ЭКОМ_GLN_Организация.Объект ССЫЛКА Справочник.Контрагенты)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Контрагент
	|		ПО ДокументыШапка.xmlКонтрагентGLN = ЭКОМ_GLN_Контрагент.GLN
	|			И (ЭКОМ_GLN_Контрагент.Объект ССЫЛКА Справочник.Контрагенты)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭКОМ_Документы КАК ЭКОМ_ДокументыПовторный
	|		ПО ДокументыШапка.ДатаПрайса = ЭКОМ_ДокументыПовторный.ФайлДата
	|			И ДокументыШапка.НомерПрайса = ЭКОМ_ДокументыПовторный.ФайлНомер
	|			И ДокументыШапка.ВидДокумента = ЭКОМ_ДокументыПовторный.ВидДокумента
	|			И (НЕ ЭКОМ_ДокументыПовторный.ПометкаУдаления)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭКОМ_Документы КАК ЭКОМ_ДокументыИсходящий
	|		ПО ДокументыШапка.ДатаПрайса = ЭКОМ_ДокументыИсходящий.ФайлДата
	|			И ДокументыШапка.НомерПрайса = ЭКОМ_ДокументыИсходящий.ФайлНомер
	|			И (ЭКОМ_ДокументыИсходящий.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.PRICAT_Исходящий))
	|
	|СГРУППИРОВАТЬ ПО
	|	ДокументыШапка.ДатаПрайса,
	|	ДокументыШапка.НомерПрайса,
	|	ДокументыШапка.xmlОрганизацияGLN,
	|	ДокументыШапка.xmlКонтрагентGLN,
	|	ДокументыШапка.ВидДокумента,
	|	ЭКОМ_Документы.ПометкаУдаления,
	|	ЭКОМ_Документы.СтатусОбработкиДокумента,
	|	ЭКОМ_GLN_Организация.Объект,
	|	ЭКОМ_GLN_Контрагент.Объект,
	|	ДокументыШапка.ИдФайл,
	|	ДокументыШапка.ДатаЧислоПолученияДокумента,
	|	ЕСТЬNULL(ЭКОМ_Документы.Ссылка, НЕОПРЕДЕЛЕНО),
	|	ЭКОМ_ДокументыИсходящий.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаЧислоПолученияДокумента";
	
	Запрос.УстановитьПараметр("ДокументыШапка", ДокументыШапка);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ПроверкаНаПовтор       = Новый Соответствие; // В случае нескольких одинаковых документов с одним и тем же номером и датой
	ПроверкаНаДублирование = Новый Соответствие;
	
	СоответствиеПоОрганизации      = Новый Соответствие;
	СоответствиеПоКонтрагенту      = Новый Соответствие;
	Пользователь = НайтиТекущегоПользователя();
	
	КэшированныеЗначения = Новый Соответствие;
	
	ИмяСобытия = "Создание документа Docrobot-PRICAT";
	Пока Выборка.Следующий() Цикл
		
		// Для проверки дублирования строк
		Если ПроверкаНаДублирование.Получить(Выборка.ИдФайл) = Неопределено Тогда
			ПроверкаНаДублирование.Вставить(Выборка.ИдФайл, "Строка добавлена");
		Иначе			
			ТекстЛогаСобытий = "Дубль данных, проверьте GLN организации, контрагента, точки доставки ИД документа - " + Выборка.ИдФайл;	
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

			Продолжить;
			
		КонецЕсли;
		
		// Получаем структуру документа
		пСтруктураДокумента = Неопределено;
		СтрокаТЗСтруктур = ТЗСтруктур.Найти(Выборка.ИдФайл, "ИдентификаторФайла");
		Если СтрокаТЗСтруктур = Неопределено Тогда		
			ТекстЛогаСобытий = "Не найдена структура документа с ИД = " + Выборка.ИдФайл;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
	
			Продолжить;
			
		Иначе
			
			пСтруктураДокумента = СтрокаТЗСтруктур.СтруктураДокумента;
			
		КонецЕсли;
		
		ПредставлениеДокументаXML = "PRICAT № " + пСтруктураДокумента.PRICATNUMBER + " от " + Формат(пСтруктураДокумента.PRICATDATE, "ДФ='dd.MM.yy ""г.""'");
		
		Если Выборка.ЭКОМДок = Неопределено Тогда
			ЭКОМДок = Документы.ЭКОМ_Документы.СоздатьДокумент();
		ИначеЕсли (Выборка.ПометкаУдаления = Истина 
			ИЛИ Выборка.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.НеОбработан) Тогда  
			ЭКОМДок = Выборка.ЭКОМДок.ПолучитьОбъект();
			ЭКОМДок.ПометкаУдаления = ЛОЖЬ;
			ЭКОМДок.ПрайсЛист.Очистить();
			ЭКОМДок.Комментарий = "";
			// Очищение остальных табличных частей документов в гибких настроках при необходимости
			
		Иначе
			ТекстЛогаСобытий = "Для " + ПредставлениеДокументаXML + " электронный документ уже существует в 1С - " + СокрЛП(Выборка.ЭКОМДок);
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Продолжить;
			
		КонецЕсли;
		
		// Для проверки повтора 
		// 1 случай - когда грузим впервые (ЭКОМ документы еще не созданы)
		КлючПовтора = СокрЛП(пСтруктураДокумента.ВидДокумента) + СокрЛП(пСтруктураДокумента.PRICATNUMBER) 
		+ Формат(пСтруктураДокумента.PRICATDATE, "ДФ=ddMMyy") + СокрЛП(пСтруктураДокумента.SENDER);
		Если ПроверкаНаПовтор.Получить(КлючПовтора) = Неопределено Тогда
			ПроверкаНаПовтор.Вставить(КлючПовтора, "Строка добавлена");					
		Иначе
			
			Если ЭКОМДок.ЭтоПовторныйДокумент = Истина 
				ИЛИ ЭКОМДок.ЭтоНовый() = Истина Тогда // Признак документа повторный или это новый ЭКОМ документ 				 
				
				ЭКОМДок.ЭтоПовторныйДокумент = Истина;
				
			КонецЕсли;	
			
		КонецЕсли;
		
		// Для проверки повтора 
		// 2 случай - когда повторный документ пришел позже
		Если Выборка.КоличествоЭКОМДокПовторных > 0 
			И (ЭКОМДок.ЭтоПовторныйДокумент = Истина 
			ИЛИ ЭКОМДок.ЭтоНовый() = Истина) Тогда // Есть повторные ЭКОМ документы 			 
			
			ЭКОМДок.ЭтоПовторныйДокумент = Истина;	
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Выборка.Организация) Тогда
			СоответствиеПоОрганизации.Вставить("Организация_" + пСтруктураДокумента.RECIPIENT, пСтруктураДокумента.RECIPIENT);	
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Выборка.Контрагент) Тогда
			СоответствиеПоКонтрагенту.Вставить("Контрагент_" + пСтруктураДокумента.SENDER, пСтруктураДокумента.SENDER);
		КонецЕсли;
		
		xmlВалюта = "RUB";
		Если ЗначениеЗаполнено(пСтруктураДокумента.CURRENCY) Тогда
			xmlВалюта = пСтруктураДокумента.CURRENCY;
		КонецЕсли;
		
		ВалютаСсылка = КэшированныеЗначения.Получить(xmlВалюта);
		Если ВалютаСсылка = Неопределено Тогда
			ВалютаСсылка = ПолучитьСсылкуВалютыДокумента(xmlВалюта);
			КэшированныеЗначения.Вставить(xmlВалюта, ВалютаСсылка);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.ЭКОМ_ДокументыИсходящий) Тогда
			ЭКОМДок.Документ1С = Выборка.ЭКОМ_ДокументыИсходящий.Документ1С;
		КонецЕсли;
		
		// Шапка
		ЭКОМДок.Организация               = Выборка.Организация;
		ЭКОМДок.xmlОрганизация            = пСтруктураДокумента.RECIPIENT;
		ЭКОМДок.ВидДокумента              = Перечисления.ЭКОМ_ВидыДокументов.PRICAT_Входящий;
		ЭКОМДок.Контрагент                = Выборка.Контрагент;
		ЭКОМДок.xmlКонтрагент             = пСтруктураДокумента.SENDER;
		ЭКОМДок.ФайлНомер                 = пСтруктураДокумента.PRICATNUMBER; // Номер прайс-листа
		ЭКОМДок.ФайлДата                  = пСтруктураДокумента.PRICATDATE;   // Дата прайс-листа
		ЭКОМДок.НакладнаяДата             = пСтруктураДокумента.DATE;
		ЭКОМДок.НакладнаяНомер            = пСтруктураДокумента.NUMBER;
		ЭКОМДок.Дата                      = ТекущаяДата();
		ЭКОМДок.xmlВалюта                 = xmlВалюта;
		ЭКОМДок.Валюта                    = ВалютаСсылка;
		ЭКОМДок.ИмяФайла                  = СтрокаТЗСтруктур.ИмяФайлаXML;	
		ЭКОМДок.ИнформацияПоДокументу     = пСтруктураДокумента.PRICATINFO;
		ЭКОМДок.НомерТранзакции           = пСтруктураДокумента.EDIINTERCHANGEID;
		ЭКОМДок.Ответственный             = Пользователь;
		ЭКОМДок.УточнениеОПоставке        = пСтруктураДокумента.ACTION;            // Действие прайс-листа
		ЭКОМДок.ДействуетС                = пСтруктураДокумента.DATEFROM;          // Дата действия с
		ЭКОМДок.ДействуетПо               = пСтруктураДокумента.DATETO;            // Дата действия по
		ЭКОМДок.НомерДоговораНаПоставку   = пСтруктураДокумента.CAMPAIGNNUMBER;    // Договор №
		ЭКОМДок.НомерПриложения           = пСтруктураДокумента.CUSTOMERREFNUMBER; // Приложение №
		ЭКОМДок.КонтактноеЛицоФИО         = пСтруктураДокумента.ORDERCONTACT_CONTACTFACE; 
		ЭКОМДок.Телефон                   = пСтруктураДокумента.ORDERCONTACT_TELEPHON; 
		ЭКОМДок.ЭлектроннаяПочта          = пСтруктураДокумента.ORDERCONTACT_EMAIL; 
		
		// ТЧ товары                            
		СуммаВсего    = 0;
		СуммаВсегоНДС = 0;
		ТекстОшибки   = "";
		
		ПроверкаНаДублированиеТЧ = Новый Соответствие;				
		Для Каждого СтруктСтрока Из пСтруктураДокумента.ДокументТЧ Цикл
			
			СоставнойШтрихКод = СокрЛП(СтруктСтрока.CATALOGUE_POSITION_POSITIONNUMBER) + "_" + СокрЛП(СтруктСтрока.CATALOGUE_POSITION_PRODUCT);
			Если ЗначениеЗаполнено(СтруктСтрока.CATALOGUE_POSITION_PRODUCT) Тогда
				Если ПроверкаНаДублированиеТЧ.Получить(СоставнойШтрихКод) = Неопределено Тогда
					ПроверкаНаДублированиеТЧ.Вставить(СоставнойШтрихКод, "Строка добавлена");
				Иначе
					
					ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
					+ "Дубль данных, проверьте номенклатуру - " + СтруктСтрока.CATALOGUE_POSITION_PRODUCT + ", строка - " + СокрЛП(СтруктСтрока.CATALOGUE_POSITION_POSITIONNUMBER);
					
					Продолжить;
					
				КонецЕсли;		
			КонецЕсли;
			
			НовСтрока                                 = ЭКОМДок.ПрайсЛист.Добавить();
			НовСтрока.БонуснаяСтавка                  = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.CATALOGUE_POSITION_BONUSRATE);
			НовСтрока.Бренд                           = СтруктСтрока.CATALOGUE_POSITION_BRAND;
			НовСтрока.ВариантНазвания                 = СтруктСтрока.CATALOGUE_POSITION_VARIATY;
			НовСтрока.Вес                             = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.CATALOGUE_POSITION_WEIGHT);
			НовСтрока.Высота                          = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.CATALOGUE_POSITION_HEIGHT);
			НовСтрока.Глубина                         = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.CATALOGUE_POSITION_DEPTH);
			НовСтрока.ГоденДо                         = СтруктСтрока.CATALOGUE_POSITION_BESTBEFORDATE;
			НовСтрока.ЕдиницаИзмерения                = СтруктСтрока.CATALOGUE_POSITION_UNIT;
			НовСтрока.ЕдиницаИзмеренияВеса            = СтруктСтрока.CATALOGUE_POSITION_WEIGHTUNIT;
			НовСтрока.ЕдиницаИзмеренияВУпаковке       = СтруктСтрока.CATALOGUE_POSITION_QUANTITYOFCUINTUUNIT;
			НовСтрока.ЕдиницаИзмеренияВысоты          = СтруктСтрока.CATALOGUE_POSITION_HEIGHTUNIT;
			НовСтрока.ЕдиницаИзмеренияГлубины         = СтруктСтрока.CATALOGUE_POSITION_DEPTHUNIT;
			НовСтрока.ЕдиницаИзмеренияМакЗаказа       = СтруктСтрока.CATALOGUE_POSITION_MAXORDERQUANTITYUNIT;
			НовСтрока.ЕдиницаИзмеренияМинЗаказа       = СтруктСтрока.CATALOGUE_POSITION_MINORDERQUANTITYUNIT;
			НовСтрока.ЕдиницаИзмеренияОбъема          = СтруктСтрока.CATALOGUE_POSITION_VOLUMEUNIT;
			НовСтрока.ЕдиницаИзмеренияШирины          = СтруктСтрока.CATALOGUE_POSITION_WIDTHUNIT;
			НовСтрока.КодТовараПоGPC                  = СтруктСтрока.CATALOGUE_POSITION_IDGPC;
			НовСтрока.КодТовараПоМеждународномуКлассификатору = СтруктСтрока.CATALOGUE_POSITION_IDINTERNATIONAL;
			НовСтрока.КодТовараПоНациональномуКлассификатору  = СтруктСтрока.CATALOGUE_POSITION_IDNATIONAL;
			НовСтрока.КоличествоВУпаковке             = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.CATALOGUE_POSITION_QUANTITYOFCUINTU);
			НовСтрока.КоличествоКоробок               = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.CATALOGUE_POSITION_QUANTITYOFBOX);
			НовСтрока.КоличествоМаксимальногоЗаказа   = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.CATALOGUE_POSITION_MAXORDERQUANTITY);
			НовСтрока.КоличествоМинимальногоЗаказа    = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.CATALOGUE_POSITION_MINORDERQUANTITY);
			НовСтрока.КоличествоПаллет                = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.CATALOGUE_POSITION_QUANTITYOFPALLET);
			НовСтрока.КратностьУпаковки               = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.CATALOGUE_POSITION_PACKINGMULTIPLENESS);
			НовСтрока.МаксимальнаяРозничнаяЦена       = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.CATALOGUE_POSITION_MAXORDERPRICE);
			НовСтрока.МинимальнаяРозничнаяЦена        = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.CATALOGUE_POSITION_MINORDERPRICE);
			НовСтрока.НомерГигиеническогоСертификата  = СтруктСтрока.CATALOGUE_POSITION_HYGIENICCERTIFICATE;
			НовСтрока.НомерПродуктаПокупателя         = СтруктСтрока.CATALOGUE_POSITION_IDBUYER;
			НовСтрока.НомерПродуктаПоставщика         = СтруктСтрока.CATALOGUE_POSITION_IDSUPPLIER;
			НовСтрока.НомерСертификатаСоответствия    = СтруктСтрока.CATALOGUE_POSITION_CERTIFICATEOFCONFORMITY;
			НовСтрока.НомерСтрокиXML                  = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.CATALOGUE_POSITION_POSITIONNUMBER);
			НовСтрока.Объем                           = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.CATALOGUE_POSITION_VOLUME);
			НовСтрока.ПолноеНазваниеПродукта          = СтруктСтрока.CATALOGUE_POSITION_PRODUCTNAME;
			НовСтрока.РекомендованнаяЦенаГосударством = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.CATALOGUE_POSITION_ADVICEPRICE);
			НовСтрока.РекомендованнаяЦенаРозница      = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.CATALOGUE_POSITION_RETAILPRICE);
			НовСтрока.СкидкаВПроцентах                = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.CATALOGUE_POSITION_PERCENT);
			НовСтрока.СкидкаЗаЕдиницу                 = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.CATALOGUE_POSITION_PERUNIT);
			НовСтрока.СтавкаНДС                       = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.CATALOGUE_POSITION_TAXRATE);
			НовСтрока.СтранаПроизводитель             = СтруктСтрока.CATALOGUE_POSITION_COUNTRYORIGIN;
			НовСтрока.Суббренд                        = СтруктСтрока.CATALOGUE_POSITION_SUBBRAND;
			НовСтрока.ТемператураХраненияОт           = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.CATALOGUE_POSITION_TEMPERATUREOFSTORAGE_FROM);
			НовСтрока.ТемператураХраненияДо           = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.CATALOGUE_POSITION_TEMPERATUREOFSTORAGE_TO);		
			НовСтрока.ТипУпаковки                     = СтруктСтрока.CATALOGUE_POSITION_PACKAGE;
			НовСтрока.ТоварнаяГруппа                  = СтруктСтрока.CATALOGUE_POSITION_PRODUCTGROUP;
			НовСтрока.ТребуемоеДействие               = СтруктСтрока.CATALOGUE_POSITION_ACTION;
			НовСтрока.ФункциональноеНазвание          = СтруктСтрока.CATALOGUE_POSITION_FUNCTIONNAME;
			НовСтрока.ЦенаБезНДС                      = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.CATALOGUE_POSITION_UNITPRICE);
			НовСтрока.ЦенаВключаяНДС                  = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.CATALOGUE_POSITION_PRICEWITHVAT);
			НовСтрока.Ширина                          = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.CATALOGUE_POSITION_WIDTH);
			НовСтрока.ШтрихкодАналога                 = СтруктСтрока.CATALOGUE_POSITION_ANALOGPRODUCT;
			НовСтрока.ШтрихкодЗамены                  = СтруктСтрока.CATALOGUE_POSITION_REPLACEPRODUCT;
			НовСтрока.ШтрихКодПродукта                = СтруктСтрока.CATALOGUE_POSITION_PRODUCT;
			
		КонецЦикла;
		
		ЭКОМДок.ТекстОшибки = ""; // Очищаем ошибки документа
		ЭКОМДок.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.ПустаяСсылка(); // Обнуляем статус документа
		
		// Номенклатура, ЕдиницаИзмерения - необходимо заполнять в гибких настройках
		ВыполнитьДополнительныеДействия(ЭКОМДок, "Входящий PRICAT",
		пСтруктураДокумента,
		МассивЛогаСобытий,
		ТекстОшибки,
		,
		,
		,
		,
		КэшированныеЗначения);
			
		ЭКОМДок.ПрайсЛист.Сортировать("НомерСтрокиXML Возр");
		
		// По умолчанию документ загружается и записывается, если ЭКОМ документ не нужен в гибких настройках необходимо поставить НеЗагружатьДокумент = Истина 
		Если ЭКОМДок.НеЗагружатьДокумент = Ложь Тогда
			
			СтруктураРегистраСобытий = Новый Структура; 
			СтруктураРегистраСобытий.Вставить("ДатаЗаписи"                  , ТекущаяДата());
			СтруктураРегистраСобытий.Вставить("Контрагент"                  , ЭКОМДок.Контрагент);
			СтруктураРегистраСобытий.Вставить("Организация"                 , ЭКОМДок.Организация);
			СтруктураРегистраСобытий.Вставить("НаправлениеОбмена"           , Перечисления.ЭКОМ_НаправлениеОбмена.Входящий);
			СтруктураРегистраСобытий.Вставить("ФайлИмя"                     , СтрокаТЗСтруктур.ИмяФайлаXML);
			СтруктураРегистраСобытий.Вставить("ЗаказДата"                   , ЭКОМДок.ФайлДата);					
			СтруктураРегистраСобытий.Вставить("ЗаказНомер"                  , ЭКОМДок.ФайлНомер);
			СтруктураРегистраСобытий.Вставить("СтруктураФайла"              , Новый ХранилищеЗначения(пСтруктураДокумента,  Новый СжатиеДанных(9)));
			СтруктураРегистраСобытий.Вставить("Идентификатор"               , пСтруктураДокумента.ИдФайл);
			
			Если НЕ ЗначениеЗаполнено(ЭКОМДок.Организация) Тогда
				ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
				+ "Не заполнена организация." + "(" + ЭКОМДок.xmlОрганизация + ")"; 
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ЭКОМДок.Контрагент) Тогда
				ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
				+ "Не заполнен контрагент." + "(" + ЭКОМДок.xmlКонтрагент + ")";
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ЭКОМДок.Валюта) Тогда
				ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
				+ "Не заполнена валюта." + "(" + ЭКОМДок.xmlВалюта + ")";
			КонецЕсли;
			
			ДокументОбработан = ПроверитьОбработкуДокумента(ТекстОшибки, ЭКОМДок, пСтруктураДокумента, СтруктураРегистраСобытий, ПредставлениеДокументаXML, МассивЛогаСобытий);
			Если ДокументОбработан = Ложь Тогда
				Продолжить;			
			КонецЕсли;
			
		Иначе 			
			пСтруктураДокумента.Вставить("Обработан", Ложь);
			ТекстЛогаСобытий = "В гибких настройках указано не загружать документ - " + ПредставлениеДокументаXML;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ СоответствиеПоОрганизации.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоОрганизации     , "Организация_");
	КонецЕсли;
	Если НЕ СоответствиеПоКонтрагенту.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоКонтрагенту     , "Контрагент_");
	КонецЕсли;
	
КонецПроцедуры

Функция м_ADO_Номеклатура_Контрагентов_Прочитать( пADO_Строка_Подключения, пТЗ_Данные, пФильтр = Неопределено ) Экспорт
	
	лСоединение = "";
	Если м_ADO_Подключить( пADO_Строка_Подключения, 5, 30, лСоединение ) <> 1 Тогда
		Сообщить( "Ошибка при подключении к ADO (087).", СтатусСообщения.Важное );
		Возврат 0;
	КонецЕсли;
	
	лТекст_Запроса = "
	|Select
	|	_Exite_Spr_Nomenklatura_Kontragentov._ID,
	|	_Exite_Spr_Nomenklatura_Kontragentov.Kontragent,
	|	_Exite_Spr_Nomenklatura_Kontragentov.Nomenklatura,
	|	_Exite_Spr_Nomenklatura_Kontragentov.Edinica_Izmereniya,
	|	_Exite_Spr_Nomenklatura_Kontragentov.Kod_Nomenklatury_Kontragenta,
	|	_Exite_Spr_Nomenklatura_Kontragentov.Artikul_Nomenklatury_Kontragenta,
	|	_Exite_Spr_Nomenklatura_Kontragentov.Naimenovanie_Nomenklatury_Kontragenta,
	|	_Exite_Spr_Nomenklatura_Kontragentov.Shtrih_Kod_Nomenklatury_Kontragenta,
	|	_Exite_Spr_Nomenklatura_Kontragentov.Harakteristika_Nomenklatury,
	|	_Exite_Spr_Nomenklatura_Kontragentov.NotUpload
	|from
	|	_Exite_Spr_Nomenklatura_Kontragentov
	|";
	
	Если ТипЗнч( пФильтр ) = Тип( "Структура" ) Тогда
		
		лОтбор_Контрагент = Неопределено;
		лОтбор_Контрагент_Включен = пФильтр.Свойство( "Контрагент", лОтбор_Контрагент );
		Если лОтбор_Контрагент_Включен Тогда
			лТекст_Запроса = лТекст_Запроса + "
			|Where 
			| _Exite_Spr_Nomenklatura_Kontragentov.Kontragent = '" + м_Объект_1C_В_ADO( лОтбор_Контрагент ) + "'";
		КонецЕсли;
		
	КонецЕсли;
	
	лРекордСет = Неопределено;
	Если м_ADO_Запрос_Выполнить( лСоединение, лТекст_Запроса, лРекордСет ) <> 1 Тогда
		Сообщить( "Ошибка при выполнении запроса при чтении номенклатуры контрагентов (088).", СтатусСообщения.Важное );
		Возврат 0;
	КонецЕсли;
	
	лТЗ_Данные = "";
	Если м_ADO_RS_ТЗ( лРекордСет, лТЗ_Данные ) <> 1 Тогда
		Сообщить( "Ошибка при заполнении ТЗ при чтении номенклатуры контрагентов (089).", СтатусСообщения.Важное );
		Возврат 0;
	КонецЕсли;
	
	Если лТЗ_Данные.Количество() = 0 Тогда
		пТЗ_Данные = лТЗ_Данные;
		Возврат 0;
	КонецЕсли;
	
	лТЗ_Структура_Соответствий = "";
	Если м_Структура_Соответствий_Получить( "Номенклатура_Контрагентов", лТЗ_Структура_Соответствий ) <> 1 Тогда
		Сообщить( "Ошибка при получении структуры соответствий при чтении номенклатуры контрагентов (090).", СтатусСообщения.Важное );
		Возврат 0;
	КонецЕсли;
	
	Если м_ADO_ТЗ_Данные_Значения_Реквизитов_1С_Присоединить( лТЗ_Данные, лТЗ_Структура_Соответствий ) <> 1 Тогда
		Сообщить( "Ошибка при присоединении данных 1С при чтении номенклатуры контрагентов (091).", СтатусСообщения.Важное );
		Возврат 0;
	КонецЕсли;
	
	
	пТЗ_Данные = лТЗ_Данные;
	
	Возврат 1;
КонецФункции

Функция РазбитьМассивПоЧастям(пМассив)
	
	Структура = Новый Структура;
	
	Счетчик        = 0;	
	НомерПоПорядку = 0;
	Соответствие = Новый Соответствие;
	КоличествоФайлов = пМассив.Количество();
	Для каждого Эл Из пМассив Цикл
		
		НомерПоПорядку = НомерПоПорядку + 1;
		Счетчик = Счетчик + 1;
		
		// Добавляем в соответствие
		Если Счетчик < 2000 Тогда	
			Соответствие.Вставить(Эл.Имя, НомерПоПорядку);	
			
			// Добавляем в пакет	
		ИначеЕсли Счетчик = 2000 Тогда			
			Структура.Вставить("Часть" + Формат(НомерПоПорядку, "ЧГ=0"), Соответствие);
			Счетчик    = 0;
			Соответствие = Новый Соответствие;
			Соответствие.Вставить(Эл.Имя, НомерПоПорядку);
		КонецЕсли;
		
		// Заканчиваем добавляем остатки в пакет	
		Если НомерПоПорядку = КоличествоФайлов Тогда
			Структура.Вставить("Часть" + Формат(НомерПоПорядку, "ЧГ=0"), Соответствие);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Структура;
	
КонецФункции

Функция ПроверитьПодписьФайла(ИмяПодписанногоФайла, ИмяФайлаПодписиBIN, МассивЛогаСобытий) Экспорт
	
	ВременныйКаталог = ПутьВременногоКаталогаЭКОМ("Sign_testing");
	КаталогВременный = ЭКОМ_СоздатьКаталогПроверитьНаЗапись(ВременныйКаталог, МассивЛогаСобытий);	
	Если КаталогВременный = Неопределено Тогда		
		Возврат Неопределено;		
	КонецЕсли;
	
	Структура = Новый Структура;
	Структура.Вставить("ПодписьВерна", Ложь);
	Структура.Вставить("Отпечаток"   , "");
	
	знСертификат  = Неопределено;
	
	ПодписьТело		= Новый ТекстовыйДокумент;
	ПодписьТело.Прочитать(ИмяФайлаПодписиBIN);
	ПодписьТелоBase64 	= ПодписьТело.ПолучитьТекст();
	ПодписьТелоBase64 	= СтрЗаменить(ПодписьТелоBase64, Символы.ПС, "");
	ПодписьТелоBase64 	= СтрЗаменить(ПодписьТелоBase64, Символы.ВК, "");
	
	ИмяФайлаПодписиSGN = ВременныйКаталог + "FileSgn_" + Формат(ТекущаяДата(), "ДФ=yyyyMMddHHmmss") + ".sgn";
	
	// Декодирование и сохранение строки BASE64 в файл.
	ДвоичныеДанные 	= Base64Значение(ПодписьТелоBase64);
	ДвоичныеДанные.Записать(ИмяФайлаПодписиSGN);
	
	Попытка
		МенеджерКриптографии = Новый МенеджерКриптографии("", "", 80);
		МенеджерКриптографии.ПроверитьПодпись(ИмяПодписанногоФайла, ИмяФайлаПодписиSGN, знСертификат);
		Структура.Вставить("Отпечаток"   , Base64Строка(знСертификат.Отпечаток));
		Структура.Вставить("ПодписьВерна", Истина);		
	Исключение
		ТекстЛогаСобытий = ОписаниеОшибки();
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, "Проверка подписи");
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

	КонецПопытки;
	
	Возврат Структура;
	
КонецФункции

Процедура СоздатьЭКОМ_ДокЮЗД_СтарыйФормат_ON_SCHFDOPPR(ТЗСтруктур, ДокументыШапка, пДокументыТабличнаяЧасть, МассивЛогаСобытий) Экспорт
	
	КэшированныеЗначения = Неопределено;
	
	// Табличная часть заполняется в гибких настройках
	
	// Индентификатор отправителя и получателя берем с 3 символа чтобы убрать префикс оператора 
	// Запрос по шапке документов
	Запрос = Новый Запрос;	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ПОДСТРОКА(ДокументыШапка.Документ_СвКСчФ_СвПокуп_ИдСв_СвЮЛУч_ИННЮЛ, 1, 100) = """"
	|				ИЛИ ПОДСТРОКА(ДокументыШапка.Грузополучатель_ИННЮЛ, 1, 100) = НЕОПРЕДЕЛЕНО
	|				ИЛИ ПОДСТРОКА(ДокументыШапка.Грузополучатель_ИННЮЛ, 1, 100) ЕСТЬ NULL
	|			ТОГДА ПОДСТРОКА(ДокументыШапка.Грузополучатель_ИННФЛ, 1, 100)
	|		ИНАЧЕ ПОДСТРОКА(ДокументыШапка.Грузополучатель_ИННЮЛ, 1, 100)
	|	КОНЕЦ КАК Грузополучатель_ИНН,
	|	ПОДСТРОКА(ДокументыШапка.Грузополучатель_КПП, 1, 100) КАК Грузополучатель_КПП,
	|	ПОДСТРОКА(ДокументыШапка.Покупатель_ИННЮЛ, 1, 100) КАК Покупатель_ИННЮЛ,
	|	ПОДСТРОКА(ДокументыШапка.Покупатель_КПП, 1, 100) КАК Покупатель_КПП,
	|	ДокументыШапка.СчФ_Дата КАК СчФ_Дата,
	|	ПОДСТРОКА(ДокументыШапка.СчФ_Номер, 1, 100) КАК СчФ_Номер,
	|	ДокументыШапка.ВидДокумента КАК ВидДокумента,
	|	ПОДСТРОКА(ДокументыШапка.ИдФайл, 1, 256) КАК ИдФайл,
	|	ПОДСТРОКА(ДокументыШапка.ИдПок, 4, 256) КАК ИдентификаторОрганизации,
	|	ПОДСТРОКА(ДокументыШапка.ИдОтпр, 4, 256) КАК ИдентификаторКонтрагента,
	|	ПОДСТРОКА(ДокументыШапка.xmlТочкаДоставкиGLN, 1, 100) КАК xmlТочкаДоставкиGLN
	|ПОМЕСТИТЬ ДокументыШапка
	|ИЗ
	|	&ДокументыШапка КАК ДокументыШапка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДокументыШапка.ИдФайл КАК ИдФайл,
	|	ЕСТЬNULL(ЭКОМ_Документы.Ссылка, НЕОПРЕДЕЛЕНО) КАК ЭКОМДок,
	|	ЭКОМ_Документы.ПометкаУдаления КАК ПометкаУдаления,
	|	ЭКОМ_Документы.СтатусОбработкиДокумента КАК СтатусОбработкиДокумента,
	|	ЭКОМ_GLN_Организация.Объект КАК Организация,
	|	ЭКОМ_GLN_Контрагент.Объект КАК Контрагент,
	|	ДокументыШапка.СчФ_Дата КАК СчФ_Дата,
	|	ЕСТЬNULL(ЭКОМ_ТочкиДоставкиПоGLN.Объект, ЭКОМ_ТочкиДоставкиПоИНН_КПП.Объект) КАК ТочкаДоставки
	|ИЗ
	|	ДокументыШапка КАК ДокументыШапка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭКОМ_Документы КАК ЭКОМ_Документы
	|		ПО ДокументыШапка.СчФ_Дата = ЭКОМ_Документы.СЧФДата
	|			И ДокументыШапка.СчФ_Номер = ЭКОМ_Документы.СЧФНомер
	|			И ДокументыШапка.ВидДокумента = ЭКОМ_Документы.ВидДокумента
	|			И ДокументыШапка.ИдФайл = ЭКОМ_Документы.НомерТранзакции
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Организация
	|		ПО ДокументыШапка.ИдентификаторОрганизации = ЭКОМ_GLN_Организация.Ид_ОЭД
	|			И (НЕ ЭКОМ_GLN_Организация.Объект ССЫЛКА Справочник.Контрагенты)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Контрагент
	|		ПО ДокументыШапка.ИдентификаторКонтрагента = ЭКОМ_GLN_Контрагент.Ид_ОЭД
	|			И (ЭКОМ_GLN_Контрагент.Объект ССЫЛКА Справочник.Контрагенты)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_ТочкиДоставки КАК ЭКОМ_ТочкиДоставкиПоИНН_КПП
	|		ПО (ЭКОМ_ТочкиДоставкиПоИНН_КПП.ИНН = ВЫБОР
	|				КОГДА ДокументыШапка.Грузополучатель_ИНН = """"
	|						ИЛИ ДокументыШапка.Грузополучатель_ИНН = НЕОПРЕДЕЛЕНО
	|						ИЛИ ДокументыШапка.Грузополучатель_ИНН ЕСТЬ NULL
	|					ТОГДА ДокументыШапка.Покупатель_ИННЮЛ
	|				ИНАЧЕ ДокументыШапка.Грузополучатель_ИНН
	|			КОНЕЦ)
	|			И (ЭКОМ_ТочкиДоставкиПоИНН_КПП.КПП = ВЫБОР
	|				КОГДА ДокументыШапка.Грузополучатель_КПП = """"
	|						ИЛИ ДокументыШапка.Грузополучатель_КПП = НЕОПРЕДЕЛЕНО
	|						ИЛИ ДокументыШапка.Грузополучатель_КПП ЕСТЬ NULL
	|					ТОГДА ДокументыШапка.Покупатель_КПП
	|				ИНАЧЕ ДокументыШапка.Грузополучатель_КПП
	|			КОНЕЦ)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_ТочкиДоставки КАК ЭКОМ_ТочкиДоставкиПоGLN
	|		ПО ДокументыШапка.xmlТочкаДоставкиGLN = ЭКОМ_ТочкиДоставкиПоGLN.GLN";
	
	Запрос.УстановитьПараметр("ДокументыШапка", ДокументыШапка);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ПроверкаНаДублирование   = Новый Соответствие;
	
	СоответствиеПоОрганизации    = Новый Соответствие;
	СоответствиеПоКонтрагенту    = Новый Соответствие;
	СоответствиеПоТочкамДоставки = Новый Соответствие;
	
	Пользователь = НайтиТекущегоПользователя();
	     
	ИмяСобытия = "Создание документа Docrobot-ON_SCHFDOPPR";
	Пока Выборка.Следующий() Цикл
		
		// Для проверки дублирования строк
		Если ПроверкаНаДублирование.Получить(Выборка.ИдФайл) = Неопределено Тогда
			ПроверкаНаДублирование.Вставить(Выборка.ИдФайл, "Строка добавлена");
		Иначе
			ТекстЛогаСобытий = "Дубль данных, проверьте GLN организации, контрагента, точки доставки ИД документа - " + Выборка.ИдФайл;	
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

			Продолжить;
			
		КонецЕсли;
		
		// Получаем структуру документа
		СтруктураДокумента = Неопределено;
		СтрокаТЗСтруктур = ТЗСтруктур.Найти(Выборка.ИдФайл, "ИдентификаторФайла");
		Если СтрокаТЗСтруктур = Неопределено Тогда
			ТекстЛогаСобытий = "Не найдена структура документа";
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
			Продолжить;
			
		Иначе		
			СтруктураДокумента = СтрокаТЗСтруктур.СтруктураДокумента;		
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Выборка.Организация) Тогда
			
			Если ЗначениеЗаполнено(СтруктураДокумента.Получатель_GLN) Тогда
				xmlОрганизацияGLN = СтруктураДокумента.Получатель_GLN;
			Иначе	
				xmlОрганизацияGLN = Выборка.ИдентификаторОрганизации;
			КонецЕсли;				 
			СоответствиеПоОрганизации.Вставить("Организация_" + xmlОрганизацияGLN, xmlОрганизацияGLN);	
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Выборка.Контрагент)
			И ЗначениеЗаполнено(СтруктураДокумента.Отправитель_GLN) Тогда
			
			Если ЗначениеЗаполнено(СтруктураДокумента.Отправитель_GLN) Тогда
				xmlКонтрагентGLN = СтруктураДокумента.Отправитель_GLN;
			Иначе	
				xmlКонтрагентGLN = Выборка.ИдентификаторКонтрагента;
			КонецЕсли;				 
			СоответствиеПоКонтрагенту.Вставить("Контрагент_" + xmlКонтрагентGLN, xmlКонтрагентGLN);	
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Выборка.ТочкаДоставки) 
			И ЗначениеЗаполнено(СтруктураДокумента.xmlТочкаДоставкиGLN) Тогда
			СоответствиеПоТочкамДоставки.Вставить("ТочкаДоставки_" + СтруктураДокумента.xmlТочкаДоставкиGLN, СтруктураДокумента.xmlТочкаДоставкиGLN);
		КонецЕсли;
		
		ПредставлениеДокументаXML = "" + СтруктураДокумента.ВидДокумента +  " № " + СтруктураДокумента.СчФ_Номер + " от " + Формат(СтруктураДокумента.СчФ_Дата, "ДФ='dd.MM.yyyy г.'");
		
		Если Выборка.ЭКОМДок = Неопределено Тогда
			ЭКОМДок = Документы.ЭКОМ_Документы.СоздатьДокумент();
		ИначеЕсли (Выборка.ПометкаУдаления = Истина 
			ИЛИ Выборка.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.НеОбработан) Тогда
			ЭКОМДок = Выборка.ЭКОМДок.ПолучитьОбъект();
			ЭКОМДок.ПометкаУдаления = ЛОЖЬ;
			ЭКОМДок.ТЧ_Товары.Очистить();
			ЭКОМДок.ТЧ_Уточнение.Очистить();
			ЭКОМДок.ДокументыСвязанные.Очистить();		 
		Иначе
			ТекстЛогаСобытий = "ЭКОМ документ УПД/УКД уже существует в 1С, номер = " + Выборка.ЭКОМДок.Номер + " от " + Выборка.ЭКОМДок.Дата;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Продолжить;
			
		КонецЕсли;
		
		Если СтруктураДокумента.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_SCHFDOPPR_01
			ИЛИ СтруктураДокумента.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_SCHFDOPPR_01_Испр Тогда
			ДатаТранНакл = Дата(0001, 01, 01);
			Если СтруктураДокумента.Свойство("ДатаТранНакл") = Истина Тогда
				ДатаТранНакл = СтруктураДокумента.ДатаТранНакл;
			КонецЕсли;
			
			НомТранНакл = "";
			Если СтруктураДокумента.Свойство("НомТранНакл") = Истина Тогда
				НомТранНакл = СтруктураДокумента.НомТранНакл;
			КонецЕсли;
			
			ФайлНомер = "";
			Если СтруктураДокумента.Свойство("СчФ_Номер") = Истина Тогда
				ФайлНомер = СтруктураДокумента.СчФ_Номер;
			КонецЕсли;
			
			ФайлДата = Дата(0001, 01, 01);
			Если СтруктураДокумента.Свойство("СчФ_Дата") = Истина Тогда
				ФайлДата = СтруктураДокумента.СчФ_Дата;
			КонецЕсли;
		Иначе
			
			ДатаТранНакл = Дата(0001, 01, 01);
			Если СтруктураДокумента.Свойство("ОснКор_ДатаОсн") = Истина Тогда
				ДатаТранНакл = СтруктураДокумента.ОснКор_ДатаОсн;
			КонецЕсли;
			
			НомТранНакл = "";
			Если СтруктураДокумента.Свойство("ОснКор_НомОсн") = Истина Тогда
				НомТранНакл = СтруктураДокумента.ОснКор_НомОсн;
			КонецЕсли;
			
			ФайлНомер = "";
			Если СтруктураДокумента.Свойство("КСчФ_Номер") = Истина Тогда
				ФайлНомер = СтруктураДокумента.КСчФ_Номер;
			КонецЕсли;
			
			ФайлДата = Дата(0001, 01, 01);
			Если СтруктураДокумента.Свойство("КСчФ_Дата") = Истина Тогда
				ФайлДата = СтруктураДокумента.СчФ_Дата;
			КонецЕсли;
			
		КонецЕсли;
		
		ДатаЗаказа = Дата(0001, 01, 01);
		Если СтруктураДокумента.Свойство("ДатаЗаказа") = Истина Тогда
			ДатаЗаказа = ДатаИзXML_в_1С(СтруктураДокумента.ДатаЗаказа);
		КонецЕсли;
		
		// Шапка
		ЭКОМДок.ВидДокумента              = СтруктураДокумента.ВидДокумента;
		ЭКОМДок.Организация               = Выборка.Организация;
		ЭКОМДок.xmlОрганизация            = СтруктураДокумента.ИдПок;
		ЭКОМДок.Контрагент                = Выборка.Контрагент;
		ЭКОМДок.xmlКонтрагент             = СтруктураДокумента.ИдОтпр;
		ЭКОМДок.Дата                      = ТекущаяДата();
		ЭКОМДок.ЗаказНомер                = СтруктураДокумента.НомерORDER;
		ЭКОМДок.ЗаказДата                 = ДатаЗаказа;
		ЭКОМДок.xmlВалюта                 = СтруктураДокумента.КодОКВ;
		ЭКОМДок.ИмяФайла                  = СтрокаТЗСтруктур.ИмяФайлаXML;
		ЭКОМДок.ДатаПоставки              = ДатаТранНакл;	
		ЭКОМДок.ТочкаДоставки             = Выборка.ТочкаДоставки;
		ЭКОМДок.ИнформацияПоДокументу     = СтруктураДокумента.НаимДокОпр;
		ЭКОМДок.НомерТранзакции           = Выборка.ИдФайл;
		ЭКОМДок.НакладнаяДата             = ДатаТранНакл;
		ЭКОМДок.НакладнаяНомер            = НомТранНакл;
		ЭКОМДок.Ответственный             = Пользователь;
		ЭКОМДок.СЧФНомер                  = СтруктураДокумента.СчФ_Номер;
		ЭКОМДок.СЧФДата                   = СтруктураДокумента.СчФ_Дата;
		ЭКОМДок.ТипДокумента              = СтруктураДокумента.Функция;
		ЭКОМДок.Версия                    = СтруктураДокумента.ВерсПрог;
		ЭКОМДок.ФайлНомер                 = ФайлНомер;
		ЭКОМДок.ФайлДата                  = ФайлДата;		
		
		Если ЗначениеЗаполнено(СтруктураДокумента.НомИспрСчФ) Тогда
			ЭКОМДок.НомерИсправления = СтруктураДокумента.НомИспрСчФ;
			ЭКОМДок.ДатаИсправления  = СтруктураДокумента.ДатаИспрСчФ;
		КонецЕсли;
		
		// ТЧ товары
		СуммаБезНДСВсего = 0;
		СуммаНДСВсего    = 0;
		ТекстОшибки      = "";
		
		Для Каждого СтруктСтрока Из СтруктураДокумента.ДокументТЧ Цикл
			
			Если СтруктураДокумента.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_SCHFDOPPR_01 
				ИЛИ СтруктураДокумента.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_SCHFDOPPR_01_Испр Тогда
				Количество = СтруктСтрока.КоличествоПоставляемое;
			Иначе
				Количество = СтруктСтрока.Количество;
			КонецЕсли;
			
			СуммаСНДС  = СтруктСтрока.СуммаСНДС;  // Обязательный атрибут - число <= 19, 2 после запятой
			СтавкаНДС   = СтруктСтрока.СтавкаНДС; // Обязательный атрибут 
			СуммаНДС    = СтруктСтрока.СуммаНДС;  // Обязательный атрибут - число <= 19, 2 после запятой
			
			СуммаБезНДС = СуммаСНДС - СуммаНДС;
			Если НЕ Количество = 0 Тогда
				ЦенаБезНДС  = Окр(СуммаБезНДС/Количество, 11); // число <= 26, 11 после запятой			
				ЦенаСНДС    = Окр(СуммаСНДС/Количество, 11);
			Иначе
				ЦенаБезНДС  = Окр(СуммаБезНДС, 11); // число <= 26, 11 после запятой			
				ЦенаСНДС    = Окр(СуммаСНДС, 11);
			КонецЕсли;
			
			Если СтруктСтрока.Свойство("xmlЕдиницаИзмерения") = Ложь Тогда
				СтруктСтрока.Вставить("xmlЕдиницаИзмерения", "");
			КонецЕсли;
			
			НовСтрока = ЭКОМДок.ТЧ_Товары.Добавить();
			НовСтрока.xmlЕдиницаИзмерения = СтруктСтрока.xmlЕдиницаИзмерения + "_" + СтруктСтрока.ЕдиницаИзмеренияКод;
			НовСтрока.Цена        = ЦенаБезНДС;
			НовСтрока.ЦенаСНДС    = ЦенаСНДС;
			НовСтрока.Сумма       = СуммаБезНДС;
			НовСтрока.СтавкаНДС   = СтавкаНДС;
			НовСтрока.СуммаНДС    = СуммаНДС;
			НовСтрока.Сумма_с_НДС = СуммаСНДС;
			НовСтрока.КоличествоПоставляемое = Количество;
			
			НовСтрока.НомерПродукта           = СтруктСтрока.ШтрихКод;
			НовСтрока.НомерПродуктаПоставщика = СтруктСтрока.КодПродуктаПоставщика;
			НовСтрока.НомерПродуктаПокупателя = СтруктСтрока.КодПродуктаПокупателя;
			НовСтрока.ОписаниеПродукта        = СтруктСтрока.НоменклатураНаименование;
			
			Если СтруктураДокумента.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_KORSCHFDOPPR_01 
				ИЛИ СтруктураДокумента.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_KORSCHFDOPPR_01_Испр Тогда
				НовСтрУточ = ЭКОМДок.ТЧ_Уточнение.Добавить();
				НовСтрУточ.ОписаниеПродукта       = СтруктСтрока.НоменклатураНаименование;
				НовСтрУточ.КоличествоПоставляемое = СтруктСтрока.Количество;
				НовСтрУточ.КоличествоФактическое  = СтруктСтрока.КоличествоПосле;
				НовСтрУточ.ЦенаДо                 = СтруктСтрока.Цена; 
				НовСтрУточ.ЦенаПосле              = СтруктСтрока.ЦенаПосле;
				НовСтрУточ.СумБезНДСДо            = СтруктСтрока.СуммаБезНДС;
				НовСтрУточ.СумБезНДСПосле         = СтруктСтрока.СуммаБезНДСПосле;
				НовСтрУточ.СтавкаНДСДо            = СтруктСтрока.СтавкаНДС;
				НовСтрУточ.СтавкаНДСПосле         = СтруктСтрока.СтавкаНДСПосле;
				НовСтрУточ.СумУчНДСДо             = СтруктСтрока.СуммаСНДС;
				НовСтрУточ.СумУчНДСПосле          = СтруктСтрока.СуммаСНДСПосле;		
			КонецЕсли;
			
			СуммаБезНДСВсего = СуммаБезНДСВсего + СуммаБезНДС;
			СуммаНДСВсего    = СуммаНДСВсего + СуммаНДС;
		КонецЦикла;
		
		Если СтруктураДокумента.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_KORSCHFDOPPR_01 
			ИЛИ СтруктураДокумента.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_KORSCHFDOPPR_01_Испр Тогда
			
			Всего_СуммаСНДС_Уменьшение = 0;
			Если СтруктураДокумента.Свойство("Всего_СуммаСНДС_Уменьшение") Тогда
				Всего_СуммаСНДС_Уменьшение = СтруктураДокумента.Всего_СуммаСНДС_Уменьшение; 
			КонецЕсли;
			
			Всего_СуммаНДС_Уменьшение = 0;
			Если СтруктураДокумента.Свойство("Всего_СуммаНДС_Уменьшение") Тогда
				Всего_СуммаНДС_Уменьшение = СтруктураДокумента.Всего_СуммаНДС_Уменьшение; 
			КонецЕсли;
			
			Всего_СуммаСНДС_Увеличение = 0;
			Если СтруктураДокумента.Свойство("Всего_СуммаСНДС_Увеличение") Тогда
				Всего_СуммаСНДС_Увеличение = СтруктураДокумента.Всего_СуммаСНДС_Увеличение; 
			КонецЕсли;
			
			Всего_СуммаНДС_Увеличение = 0;
			Если СтруктураДокумента.Свойство("Всего_СуммаНДС_Увеличение") Тогда
				Всего_СуммаНДС_Увеличение = СтруктураДокумента.Всего_СуммаНДС_Увеличение; 
			КонецЕсли;
			
			// Сумма с НДС
			Если НЕ Всего_СуммаСНДС_Уменьшение = 0 Тогда
				ЭКОМДок.СуммаДокументаВсего = - Всего_СуммаСНДС_Уменьшение;
			Иначе
				ЭКОМДок.СуммаДокументаВсего = Всего_СуммаСНДС_Увеличение;
			КонецЕсли;
			
			// НДС
			Если НЕ Всего_СуммаНДС_Уменьшение = 0 Тогда
				ЭКОМДок.СуммаНДСВсего = - Всего_СуммаНДС_Уменьшение;
			Иначе
				ЭКОМДок.СуммаНДСВсего = Всего_СуммаНДС_Увеличение;
			КонецЕсли;
			
		Иначе
			
			ЭКОМДок.СуммаДокументаВсего = СуммаБезНДСВсего + СуммаНДСВсего;
			ЭКОМДок.СуммаНДСВсего       = СуммаНДСВсего;
			
		КонецЕсли;			
		
		ЭКОМДок.ТекстОшибки = ""; // Очищаем ошибки документа
		ЭКОМДок.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.ПустаяСсылка(); // Обнуляем статус документ
		
		// Если есть уточнение записываем его в комментарий!
		ВыполнитьДополнительныеДействия(ЭКОМДок, "Входящий ЮЗД - универсальный передаточный документ",
		СтруктураДокумента,
		МассивЛогаСобытий,
		ТекстОшибки,
		,
		,
		,
		,
		КэшированныеЗначения);
		
		ЭКОМДок.ТЧ_Товары.Сортировать("НомерСтрокиXML Возр");
		
		// По умолчанию документ загружается и записывается, если ЭКОМ документ не нужен в гибких настройках необходимо поставить НеЗагружатьДокумент = Истина 
		Если ЭКОМДок.НеЗагружатьДокумент = Ложь Тогда
			
			СтруктураРегистраСобытий = Новый Структура;
			СтруктураРегистраСобытий.Вставить("ДатаЗаписи"                  , ТекущаяДата());
			СтруктураРегистраСобытий.Вставить("ЭЦП"                         , СтрокаТЗСтруктур.ЭЦП);
			СтруктураРегистраСобытий.Вставить("Контрагент"                  , Выборка.Контрагент);
			СтруктураРегистраСобытий.Вставить("Организация"                 , Выборка.Организация);
			СтруктураРегистраСобытий.Вставить("НаправлениеОбмена"           , Перечисления.ЭКОМ_НаправлениеОбмена.Входящий);
			СтруктураРегистраСобытий.Вставить("ФайлИмя"                     , СтрокаТЗСтруктур.ИмяФайлаXML);
			СтруктураРегистраСобытий.Вставить("ЗаказДата"                   , ЭКОМДок.ЗаказДата);					
			СтруктураРегистраСобытий.Вставить("ЗаказНомер"                  , ЭКОМДок.ЗаказНомер);
			СтруктураРегистраСобытий.Вставить("Идентификатор"               , Выборка.ИдФайл);
			СтруктураРегистраСобытий.Вставить("СтруктураФайла"              , Новый ХранилищеЗначения(СтруктураДокумента, Новый СжатиеДанных(9)));
			
			ДокументОбработан = ПроверитьОбработкуДокумента(ТекстОшибки, ЭКОМДок, СтруктураДокумента, СтруктураРегистраСобытий, ПредставлениеДокументаXML, МассивЛогаСобытий);
			Если ДокументОбработан = Ложь Тогда
				Продолжить;			
			КонецЕсли;
			
		Иначе 			
			СтруктураДокумента.Вставить("Обработан", Ложь);
			ТекстЛогаСобытий = "В гибких настройках указано не загружать документ - " + ПредставлениеДокументаXML;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
		КонецЕсли;
		
		СтруктураДокумента.Вставить("Организация", Выборка.Организация);
		СтрокаТЗСтруктур.СтруктураДокумента = СтруктураДокумента;
		
	КонецЦикла;
	
	Если НЕ СоответствиеПоОрганизации.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоОрганизации     , "Организация_");
	КонецЕсли;
	Если НЕ СоответствиеПоКонтрагенту.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоКонтрагенту     , "Контрагент_");
	КонецЕсли;
	Если НЕ СоответствиеПоТочкамДоставки.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоТочкамДоставки  , "ТочкаДоставки_");
	КонецЕсли;
	
КонецПроцедуры

Процедура СоздатьЭКОМ_ДокЮЗД_Корректировка(ТЗСтруктур, ДокументыШапка, пДокументыТабличнаяЧасть, МассивЛогаСобытий) Экспорт
	
	КэшированныеЗначения = Неопределено;
	
	// Табличная часть заполняется в гибких настройках
	
	// Индентификатор отправителя и получателя берем с 3 символа чтобы убрать префикс оператора 
	// Запрос по шапке документов
	Запрос = Новый Запрос;	
	Запрос.Текст =                            
	"ВЫБРАТЬ
	|	ДокументыШапка.ДатаПринятияДокумента КАК ДатаПринятияДокумента,
	|	ДокументыШапка.Документ_СвКСчФ_ДатаКСчФ КАК ДатаКСчФ,
	|	ПОДСТРОКА(ДокументыШапка.Документ_СвКСчФ_НомерКСчФ, 1, 100) КАК НомерКСчФ,
	|	ПОДСТРОКА(ДокументыШапка.Документ_СвКСчФ_ИспрКСчФ_НомИспрКСчФ, 1, 100) КАК НомИспрКСчФ,
	|	ДокументыШапка.Документ_СвКСчФ_СчФ_ДатаСчФ КАК ДатаСчФ,
	|	ПОДСТРОКА(ДокументыШапка.Документ_СвКСчФ_СчФ_НомерСчФ, 1, 100) КАК НомерСчФ,
	|	ДокументыШапка.ВидДокумента КАК ВидДокумента,
	|	ПОДСТРОКА(ДокументыШапка.ИдФайл, 1, 256) КАК ИдФайл,
	|	ПОДСТРОКА(ДокументыШапка.СвУчДокОбор_ИдПол, 4, 256) КАК ИдентификаторОрганизации,
	|	ПОДСТРОКА(ДокументыШапка.СвУчДокОбор_ИдОтпр, 4, 256) КАК ИдентификаторКонтрагента,
	|	ПОДСТРОКА(ДокументыШапка.СвУчДокОбор_ИдПол, 0, 256) КАК ПолныйИдентификаторОрганизации,
	|	ПОДСТРОКА(ДокументыШапка.СвУчДокОбор_ИдОтпр, 0, 256) КАК ПолныйИдентификаторКонтрагента
	|ПОМЕСТИТЬ ДокументыШапка
	|ИЗ
	|	&ДокументыШапка КАК ДокументыШапка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДокументыШапка.ИдФайл КАК ИдФайл,
	|	ЕСТЬNULL(ЭКОМ_ДокументСуществующий.Ссылка, НЕОПРЕДЕЛЕНО) КАК ЭКОМДок,
	|	ЭКОМ_ДокументСуществующий.ПометкаУдаления КАК ПометкаУдаления,
	|	ЭКОМ_ДокументСуществующий.СтатусОбработкиДокумента КАК СтатусОбработкиДокумента,
	|	ЭКОМ_GLN_Организация.Объект КАК Организация,
	|	ЭКОМ_GLN_Контрагент.Объект КАК Контрагент,
	|	ДокументыШапка.ИдентификаторОрганизации,
	|	ДокументыШапка.ИдентификаторКонтрагента,
	|	ДокументыШапка.ДатаКСчФ,
	|	ДокументыШапка.НомерКСчФ,
	|	ДокументыШапка.ВидДокумента,
	|	ЕСТЬNULL(ЭКОМ_ДокументПервичный.Ссылка, НЕОПРЕДЕЛЕНО) КАК ЭКОМДокОснование,
	|	ЕСТЬNULL(КОЛИЧЕСТВО(ЭКОМ_ДокументыПовторный.Ссылка), 0) КАК КоличествоЭКОМДокПовторных,
	|	ДокументыШапка.НомИспрКСчФ
	|ИЗ
	|	ДокументыШапка КАК ДокументыШапка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭКОМ_Документы КАК ЭКОМ_ДокументСуществующий
	|		ПО ДокументыШапка.ДатаКСчФ = ЭКОМ_ДокументСуществующий.ФайлДата
	|			И ДокументыШапка.НомерКСчФ = ЭКОМ_ДокументСуществующий.ФайлНомер
	|			И ДокументыШапка.ВидДокумента = ЭКОМ_ДокументСуществующий.ВидДокумента
	|			И ДокументыШапка.ИдФайл = ЭКОМ_ДокументСуществующий.НомерТранзакции
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Организация
	|		ПО ДокументыШапка.ИдентификаторОрганизации = ЭКОМ_GLN_Организация.Ид_ОЭД
	|			И (НЕ ЭКОМ_GLN_Организация.Объект ССЫЛКА Справочник.Контрагенты)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Контрагент
	|		ПО ДокументыШапка.ИдентификаторКонтрагента = ЭКОМ_GLN_Контрагент.Ид_ОЭД
	|			И (ЭКОМ_GLN_Контрагент.Объект ССЫЛКА Справочник.Контрагенты)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭКОМ_Документы КАК ЭКОМ_ДокументПервичный
	|		ПО ДокументыШапка.ПолныйИдентификаторОрганизации = ЭКОМ_ДокументПервичный.xmlОрганизация
	|			И ДокументыШапка.ПолныйИдентификаторКонтрагента = ЭКОМ_ДокументПервичный.xmlКонтрагент
	|			И ДокументыШапка.ДатаСчФ = ЭКОМ_ДокументПервичный.СЧФДата
	|			И ДокументыШапка.НомерСчФ = ЭКОМ_ДокументПервичный.СЧФНомер
	|			И (НЕ ЭКОМ_ДокументПервичный.ПометкаУдаления)
	|			И (НЕ ДокументыШапка.ИдФайл = ЭКОМ_ДокументПервичный.НомерТранзакции)
	|			И ДокументыШапка.ДатаПринятияДокумента > ЭКОМ_ДокументПервичный.ДатаПринятияДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭКОМ_Документы КАК ЭКОМ_ДокументыПовторный
	|		ПО ДокументыШапка.НомерКСчФ = ЭКОМ_ДокументыПовторный.ФайлНомер
	|			И ДокументыШапка.ДатаКСчФ = ЭКОМ_ДокументыПовторный.ФайлДата
	|			И ДокументыШапка.ВидДокумента = ЭКОМ_ДокументыПовторный.ВидДокумента
	|			И (НЕ ЭКОМ_ДокументыПовторный.ПометкаУдаления)
	|			И (ДокументыШапка.ИдентификаторОрганизации = ПОДСТРОКА(ЭКОМ_ДокументыПовторный.xmlОрганизация, 4, 256))
	|			И (ДокументыШапка.ИдентификаторКонтрагента = ПОДСТРОКА(ЭКОМ_ДокументыПовторный.xmlКонтрагент, 4, 256))
	|			И ДокументыШапка.НомИспрКСчФ = ЭКОМ_ДокументыПовторный.НомерИсправления
	|
	|СГРУППИРОВАТЬ ПО
	|	ДокументыШапка.ДатаКСчФ,
	|	ЕСТЬNULL(ЭКОМ_ДокументПервичный.Ссылка, НЕОПРЕДЕЛЕНО),
	|	ЭКОМ_GLN_Контрагент.Объект,
	|	ДокументыШапка.ИдентификаторКонтрагента,
	|	ДокументыШапка.НомерКСчФ,
	|	ДокументыШапка.ВидДокумента,
	|	ЭКОМ_ДокументСуществующий.СтатусОбработкиДокумента,
	|	ЭКОМ_GLN_Организация.Объект,
	|	ДокументыШапка.ИдентификаторОрганизации,
	|	ЕСТЬNULL(ЭКОМ_ДокументСуществующий.Ссылка, НЕОПРЕДЕЛЕНО),
	|	ЭКОМ_ДокументСуществующий.ПометкаУдаления,
	|	ДокументыШапка.ИдФайл,
	|	ДокументыШапка.НомИспрКСчФ";
	
	Запрос.УстановитьПараметр("ДокументыШапка", ДокументыШапка);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ПроверкаНаДублирование   = Новый Соответствие; // Дублирование по файлам
	ПроверкаНаПовтор         = Новый Соответствие; // В случае если поставщик отправит несколько одинаковых УКД с одним и тем же номером и датой
	СоответствиеПоОрганизации    = Новый Соответствие;
	СоответствиеПоКонтрагенту    = Новый Соответствие;
	
	Пользователь = НайтиТекущегоПользователя();
	
	ИмяСобытия = "Создание документа Docrobot-ЮЗД Корректировка";
	Пока Выборка.Следующий() Цикл
		
		// Для проверки дублирования 
		Если ПроверкаНаДублирование.Получить(Выборка.ИдФайл) = Неопределено Тогда
			ПроверкаНаДублирование.Вставить(Выборка.ИдФайл, "Строка добавлена");
		Иначе			
			ТекстЛогаСобытий = "Дубль данных, проверьте GLN организации, контрагента, точки доставки ИД документа - " + Выборка.ИдФайл;	
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Продолжить;
			
		КонецЕсли;
		
		// Получаем структуру документа
		СтруктураДокумента = Неопределено;
		СтрокаТЗСтруктур = ТЗСтруктур.Найти(Выборка.ИдФайл, "ИдентификаторФайла");
		Если СтрокаТЗСтруктур = Неопределено Тогда			
			ТекстЛогаСобытий = "Не найдена структура документа. Документ не обработан. Посмотрите текст ошибки в регистре ЭКОМ события [" + Выборка.ИдФайл + "]";
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Продолжить;
			
		Иначе		
			СтруктураДокумента = СтрокаТЗСтруктур.СтруктураДокумента;		
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Выборка.Организация) Тогда			
			СоответствиеПоОрганизации.Вставить("Организация_" + Выборка.ИдентификаторОрганизации, Выборка.ИдентификаторОрганизации);	
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Выборка.Контрагент) Тогда	 
			СоответствиеПоКонтрагенту.Вставить("Контрагент_" + Выборка.ИдентификаторКонтрагента, Выборка.ИдентификаторКонтрагента);	
			
		КонецЕсли;
		
		ПредставлениеДокументаXML = "" + СтруктураДокумента.ВидДокумента +  " № " + СтруктураДокумента.Документ_СвКСчФ_НомерКСчФ + " от " + Формат(СтруктураДокумента.Документ_СвКСчФ_ДатаКСчФ, "ДФ='dd.MM.yyyy г.'");
		
		Если Выборка.ЭКОМДок = Неопределено Тогда
			ЭКОМДок = Документы.ЭКОМ_Документы.СоздатьДокумент();
		ИначеЕсли (Выборка.ПометкаУдаления = Истина 
			ИЛИ Выборка.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.НеОбработан) Тогда
			ЭКОМДок = Выборка.ЭКОМДок.ПолучитьОбъект();
			ЭКОМДок.ПометкаУдаления = ЛОЖЬ;
			ЭКОМДок.ТЧ_Товары.Очистить();
			ЭКОМДок.ТЧ_Уточнение.Очистить();
			ЭКОМДок.ТЧ_Маркировка.Очистить();
			ЭКОМДок.ДокументыСвязанные.Очистить();		 
		Иначе
			ТекстЛогаСобытий = "ЭКОМ документ УКД уже существует в 1С, номер = " + Выборка.ЭКОМДок.Номер + " от " + Выборка.ЭКОМДок.Дата;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Продолжить;
			
		КонецЕсли;
		
		// Для проверки повтора 
		// 1 случай - когда грузим впервые (ЭКОМ документы еще не созданы)
		КлючПовтора = Строка(Выборка.ВидДокумента) + Выборка.ИдентификаторКонтрагента + Строка(Выборка.НомИспрКСчФ) + Строка(Выборка.НомерКСчФ) + Строка(Выборка.ДатаКСчФ);
		Если ПроверкаНаПовтор.Получить(КлючПовтора) = Неопределено Тогда
			ПроверкаНаПовтор.Вставить(КлючПовтора, "Строка добавлена");					
		Иначе
			
			Если ЭКОМДок.ЭтоПовторныйДокумент = Истина 
				ИЛИ ЭКОМДок.ЭтоНовый() = Истина Тогда // Признак документа повторный или это новый ЭКОМ документ 				 
				
				ЭКОМДок.ЭтоПовторныйДокумент = Истина;
				
			КонецЕсли;	
			
		КонецЕсли;
		
		// Для проверки повтора 
		// 2 случай - когда повторный документ пришел позже
		Если Выборка.КоличествоЭКОМДокПовторных > 0 
			И (ЭКОМДок.ЭтоПовторныйДокумент = Истина 
			ИЛИ ЭКОМДок.ЭтоНовый() = Истина) Тогда // Есть повторные ЭКОМ документы 			 
			
			ЭКОМДок.ЭтоПовторныйДокумент = Истина;	
			
		КонецЕсли;
		
		// Основные ИнфПолФХЖ1
		СоответствиеИнфПолФХЖ1 = Новый Соответствие;
		СоответствиеИнфПолФХЖ1.Вставить("отправитель"                  , "");
		СоответствиеИнфПолФХЖ1.Вставить("получатель"                   , "");
		СоответствиеИнфПолФХЖ1.Вставить("грузополучатель"              , "");
		СоответствиеИнфПолФХЖ1.Вставить("дата_поставки"                , Дата(0001, 01, 01));
		СоответствиеИнфПолФХЖ1.Вставить("дата_заказа"                  , Дата(0001, 01, 01));
		СоответствиеИнфПолФХЖ1.Вставить("номер_заказа"                 , "");
		СоответствиеИнфПолФХЖ1.Вставить("номер_акта"                   , "");
		СоответствиеИнфПолФХЖ1.Вставить("дата_акта"                    , Дата(0001, 01, 01));
		СоответствиеИнфПолФХЖ1.Вставить("номер_накладной"              , "");
		СоответствиеИнфПолФХЖ1.Вставить("дата_накладной"               , Дата(0001, 01, 01));
		СоответствиеИнфПолФХЖ1.Вставить("номер_уведомления_об_отгрузке", "");
		СоответствиеИнфПолФХЖ1.Вставить("дата_уведомления_об_отгрузке" , Дата(0001, 01, 01));
		СоответствиеИнфПолФХЖ1.Вставить("код_поставщика"               , "");
		СоответствиеИнфПолФХЖ1.Вставить("документ_основание"           , "");
		
		Если СтруктураДокумента.Свойство("Документ_СвКСчФ_ИнфПолФХЖ1_ТекстИнф_") Тогда      
			Для каждого ЭлСтруктура Из СтруктураДокумента.Документ_СвКСчФ_ИнфПолФХЖ1_ТекстИнф_ Цикл
				
				Если НЕ СоответствиеИнфПолФХЖ1.Получить(ЭлСтруктура.Документ_СвКСчФ_ИнфПолФХЖ1_ТекстИнф_Идентиф) = Неопределено Тогда
					СоответствиеИнфПолФХЖ1[ЭлСтруктура.Документ_СвКСчФ_ИнфПолФХЖ1_ТекстИнф_Идентиф] = ЭлСтруктура.Документ_СвКСчФ_ИнфПолФХЖ1_ТекстИнф_Значен;		
				КонецЕсли;
				
			КонецЦикла;		
		КонецЕсли;
		
		// Одна строка
		Если СтруктураДокумента.Свойство("Документ_СвКСчФ_ИнфПолФХЖ1_ТекстИнф_Идентиф") Тогда		
			Если НЕ СоответствиеИнфПолФХЖ1.Получить(СтруктураДокумента.Документ_СвКСчФ_ИнфПолФХЖ1_ТекстИнф_Идентиф) = Неопределено Тогда
				СоответствиеИнфПолФХЖ1[СтруктураДокумента.Документ_СвКСчФ_ИнфПолФХЖ1_ТекстИнф_Идентиф] = СтруктураДокумента.Документ_СвКСчФ_ИнфПолФХЖ1_ТекстИнф_Значен;		
			КонецЕсли;
		КонецЕсли;
		
		ДатаОснования = Дата(0001, 01, 01);
		НомерОснования = "";
		Если Найти(СокрЛП(СтруктураДокумента.ВидДокумента), "ON_NKORSCHFDOPPR") > 0 Тогда
			ДатаОснования = СтруктураДокумента.Документ_СодФХЖ3_ПередатДокум_ДатаОсн;
			НомерОснования = СтруктураДокумента.Документ_СодФХЖ3_ПередатДокум_НомОсн; //Docrobot 1.21.0 MOD-1836 [Заменил НаимОсн на НомОсн]
		Иначе
			ДатаОснования = СтруктураДокумента.Документ_СодФХЖ3_ОснКор_ДатаОсн;
			НомерОснования = СтруктураДокумента.Документ_СодФХЖ3_ОснКор_НомОсн;		
		КонецЕсли;
		
		// Шапка
		ЭКОМДок.ВидДокумента              = СтруктураДокумента.ВидДокумента;
		ЭКОМДок.ДатаПринятияДокумента     = СтруктураДокумента.ДатаПринятияДокумента;
		ЭКОМДок.Организация               = Выборка.Организация;
		ЭКОМДок.xmlОрганизация            = СтруктураДокумента.СвУчДокОбор_ИдПол;
		ЭКОМДок.Контрагент                = Выборка.Контрагент;
		ЭКОМДок.xmlКонтрагент             = СтруктураДокумента.СвУчДокОбор_ИдОтпр;
		ЭКОМДок.Дата                      = ТекущаяДата();
		ЭКОМДок.xmlВалюта                 = СтруктураДокумента.Документ_СвКСчФ_КодОКВ;
		ЭКОМДок.ИмяФайла                  = СтрокаТЗСтруктур.ИмяФайлаXML;
		ЭКОМДок.ДатаПоставки              = ДатаОснования;	
		ЭКОМДок.xmlТочкаДоставки          = СоответствиеИнфПолФХЖ1.Получить("грузополучатель");
		ЭКОМДок.ИнформацияПоДокументу     = СоответствиеИнфПолФХЖ1.Получить("документ_основание");
		ЭКОМДок.НомерТранзакции           = Выборка.ИдФайл;
		ЭКОМДок.НакладнаяДата             = ДатаОснования;
		ЭКОМДок.НакладнаяНомер            = НомерОснования;
		ЭКОМДок.Ответственный             = Пользователь;
		ЭКОМДок.СЧФНомер                  = СтруктураДокумента.Документ_СвКСчФ_СчФ_НомерСчФ;
		ЭКОМДок.СЧФДата                   = СтруктураДокумента.Документ_СвКСчФ_СчФ_ДатаСчФ;
		ЭКОМДок.ТипДокумента              = СтруктураДокумента.Документ_Функция;
		ЭКОМДок.Версия                    = СтруктураДокумента.ВерсПрог;
		ЭКОМДок.ФайлНомер                 = СтруктураДокумента.Документ_СвКСчФ_НомерКСчФ;
		ЭКОМДок.ФайлДата                  = СтруктураДокумента.Документ_СвКСчФ_ДатаКСчФ;		
		ЭКОМДок.ЗаказНомер                = СоответствиеИнфПолФХЖ1.Получить("номер_заказа");
		ЭКОМДок.ЗаказДата                 = ДатаИзXML_в_1С(СоответствиеИнфПолФХЖ1.Получить("дата_заказа"));
		
		Если ЗначениеЗаполнено(Выборка.НомИспрКСчФ) Тогда 
			ЭКОМДок.НомерИсправления = СтруктураДокумента.Документ_СвКСчФ_ИспрКСчФ_НомИспрКСчФ;
			ЭКОМДок.ДатаИсправления  = СтруктураДокумента.Документ_СвКСчФ_ИспрКСчФ_ДатаИспрКСчФ;    
		КонецЕсли;
		
		// ТЧ товары
		СуммаБезНДСВсего = 0;
		СуммаНДСВсего    = 0;
		ДанныеПоМаркировке = Новый Массив;
		СоответствиеИнфПолФХЖ2 = Новый Соответствие;
		
		Для Каждого СтруктСтрока Из СтруктураДокумента.ДокументТЧ Цикл
			
			НомерСтрокиXML   = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.Документ_ТаблКСчФ_СведТов_НомСтр);
			ОписаниеПродукта = СтруктСтрока.Документ_ТаблКСчФ_СведТов_НаимТов;
			
			// Основные ИнфПолФХЖ2
			СоответствиеИнфПолФХЖ2.Вставить("дата_заказа"                  , Дата(0001, 01, 01));
			СоответствиеИнфПолФХЖ2.Вставить("номер_заказа"                 , "");
			СоответствиеИнфПолФХЖ2.Вставить("номер_акта"                   , "");
			СоответствиеИнфПолФХЖ2.Вставить("дата_акта"                    , Дата(0001, 01, 01));
			СоответствиеИнфПолФХЖ2.Вставить("номер_накладной"              , "");
			СоответствиеИнфПолФХЖ2.Вставить("дата_накладной"               , Дата(0001, 01, 01));
			СоответствиеИнфПолФХЖ2.Вставить("номер_уведомления_об_отгрузке", "");
			СоответствиеИнфПолФХЖ2.Вставить("дата_уведомления_об_отгрузке" , Дата(0001, 01, 01));
			СоответствиеИнфПолФХЖ2.Вставить("артикул_поставщика"           , "");
			СоответствиеИнфПолФХЖ2.Вставить("штрихкод"                     , "");
			СоответствиеИнфПолФХЖ2.Вставить("код_материала"                , "");
			
			// В новом формате УКД коды маркировки содержатся в элементах НомСредИдентТовДо и НомСредИдентТовПосле.
			// Предварительно выполняется получение этих данных из соответствующих элементов с последующей обработкой
			// и записью в массив ДанныеПоМаркировке
			ИмяЭлементаXML       = "Документ_ТаблКСчФ_СведТов_НомСредИдентТов";
			НомСредИдентТовДо 	 = ПолучитьМассивИзВходящегоДокумента(ИмяЭлементаXML + "До"   , СтруктСтрока);
			НомСредИдентТовПосле = ПолучитьМассивИзВходящегоДокумента(ИмяЭлементаXML + "После", СтруктСтрока);
			
			ЗаполнитьДанныеПоМаркировкеИзДокумена(НомСредИдентТовДо, ИмяЭлементаXML, "До", ДанныеПоМаркировке, НомерСтрокиXML, ОписаниеПродукта);
			ЗаполнитьДанныеПоМаркировкеИзДокумена(НомСредИдентТовПосле, ИмяЭлементаXML, "После", ДанныеПоМаркировке, НомерСтрокиXML, ОписаниеПродукта);
			
			ИнфПолФХЖ2 = Новый Массив;
			// Несколько строк
			Если СтруктСтрока.Свойство("Документ_ТаблКСчФ_СведТов_ИнфПолФХЖ2_") Тогда
				ИнфПолФХЖ2 = СтруктСтрока.Документ_ТаблКСчФ_СведТов_ИнфПолФХЖ2_;
			КонецЕсли;
			
			//// Одна строка
			//Если СтруктСтрока.Свойство("Документ_ТаблКСчФ_СведТов_ИнфПолФХЖ2") Тогда
			//	ИнфПолФХЖ2 = СтруктСтрока.Документ_ТаблКСчФ_СведТов_ИнфПолФХЖ2;	
			//КонецЕсли;
			
			//Docrobot 1.21.0 MOD-1839 [Если одна строка, то возвращается не как массив]
			Если СтруктСтрока.Свойство("Документ_ТаблКСчФ_СведТов_ИнфПолФХЖ2_Значен") Тогда
				СоответствиеИнфПолФХЖ2[СтруктСтрока.Документ_ТаблКСчФ_СведТов_ИнфПолФХЖ2_Идентиф] = СтруктСтрока.Документ_ТаблКСчФ_СведТов_ИнфПолФХЖ2_Значен;
			КонецЕсли;
			
			Для каждого ЭлСтруктура Из ИнфПолФХЖ2 Цикл  				
				Если НЕ СоответствиеИнфПолФХЖ2.Получить(ЭлСтруктура.Документ_ТаблКСчФ_СведТов_ИнфПолФХЖ2_Идентиф) = Неопределено Тогда
					СоответствиеИнфПолФХЖ2[ЭлСтруктура.Документ_ТаблКСчФ_СведТов_ИнфПолФХЖ2_Идентиф] = ЭлСтруктура.Документ_ТаблКСчФ_СведТов_ИнфПолФХЖ2_Значен;		
				КонецЕсли; 
			КонецЦикла;		
			
			Количество = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.Документ_ТаблКСчФ_СведТов_КолТовПосле);
			
			СуммаСНДС  = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.Документ_ТаблКСчФ_СведТов_СтТовУчНал_СтоимПослеИзм);  // Обязательный атрибут - число <= 19, 2 после запятой
			СтавкаНДС  = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.Документ_ТаблКСчФ_СведТов_НалСтПосле); // Обязательный атрибут 
			СуммаНДС   = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.Документ_ТаблКСчФ_СведТов_СумНалПосле_СумНДС);  // Обязательный атрибут - число <= 19, 2 после запятой
			
			СуммаБезНДС = СуммаСНДС - СуммаНДС;
			Если НЕ Количество = 0 Тогда
				ЦенаБезНДС  = Окр(СуммаБезНДС/Количество, 11); // число <= 26, 11 после запятой			
				ЦенаСНДС    = Окр(СуммаСНДС/Количество, 11);
			Иначе
				ЦенаБезНДС  = Окр(СуммаБезНДС, 11); // число <= 26, 11 после запятой			
				ЦенаСНДС    = Окр(СуммаСНДС, 11);
			КонецЕсли;
			
			НовСтрока = ЭКОМДок.ТЧ_Товары.Добавить();
			НовСтрока.xmlЕдиницаИзмерения = СтруктСтрока.Документ_ТаблКСчФ_СведТов_ОКЕИ_ТовПосле;
			НовСтрока.НомерСтрокиXML      = НомерСтрокиXML;
			НовСтрока.Цена                = ЦенаБезНДС;
			НовСтрока.ЦенаСНДС            = ЦенаСНДС;
			НовСтрока.Сумма               = СуммаБезНДС;
			НовСтрока.СтавкаНДС           = СтавкаНДС;
			НовСтрока.СуммаНДС            = СуммаНДС;
			НовСтрока.Сумма_с_НДС         = СуммаСНДС;
			НовСтрока.КоличествоПоставляемое = Количество;
			
			НовСтрока.НомерПродукта           = СоответствиеИнфПолФХЖ2["штрихкод"];
			НовСтрока.НомерПродуктаПоставщика = СоответствиеИнфПолФХЖ2["артикул_поставщика"];
			НовСтрока.НомерПродуктаПокупателя = СоответствиеИнфПолФХЖ2["код_материала"];
			НовСтрока.ОписаниеПродукта        = ОписаниеПродукта;
			
			// Уточнение
			НовСтрУточ = ЭКОМДок.ТЧ_Уточнение.Добавить();
			НовСтрУточ.ОписаниеПродукта       = ОписаниеПродукта;
			НовСтрУточ.КоличествоПоставляемое = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.Документ_ТаблКСчФ_СведТов_КолТовДо);
			НовСтрУточ.КоличествоФактическое  = Количество;
			НовСтрУточ.ЦенаДо                 = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.Документ_ТаблКСчФ_СведТов_ЦенаТовДо); 
			НовСтрУточ.ЦенаПосле              = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.Документ_ТаблКСчФ_СведТов_ЦенаТовПосле);
			НовСтрУточ.СумБезНДСДо            = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.Документ_ТаблКСчФ_СведТов_СтТовБезНДС_СтоимДоИзм);
			НовСтрУточ.СумБезНДСПосле         = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.Документ_ТаблКСчФ_СведТов_СтТовБезНДС_СтоимПослеИзм);
			НовСтрУточ.СтавкаНДСДо            = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.Документ_ТаблКСчФ_СведТов_НалСтДо);
			НовСтрУточ.СтавкаНДСПосле         = СтавкаНДС;
			НовСтрУточ.СумУчНДСДо             = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.Документ_ТаблКСчФ_СведТов_СтТовУчНал_СтоимДоИзм);
			НовСтрУточ.СумУчНДСПосле          = СуммаСНДС;
			НовСтрУточ.НомерСтрокиXML         = НомерСтрокиXML;
			
			СуммаБезНДСВсего = СуммаБезНДСВсего + СуммаБезНДС;
			СуммаНДСВсего    = СуммаНДСВсего + СуммаНДС;
		КонецЦикла;
		
		// Заполнение таблицы маркировки
		Для каждого Стр Из ДанныеПоМаркировке Цикл
			НовСтрока = ЭКОМДок.ТЧ_Маркировка.Добавить();
			НовСтрока.НомерСтрокиXML    = Стр.НомерСтрокиXML;
			НовСтрока.ОписаниеПродукта  = Стр.ОписаниеПродукта;
			НовСтрока.ИдентТрансУпак_До = Стр.ИдентТрансУпак_До;
			НовСтрока.КИЗ_До            = Стр.КИЗ_До;
			НовСтрока.НомУпак_До        = Стр.НомУпак_До;
			НовСтрока.ИдентТрансУпак    = Стр.ИдентТрансУпак_После;
			НовСтрока.КИЗ               = Стр.КИЗ_После;
			НовСтрока.НомУпак           = Стр.НомУпак_После;
		КонецЦикла;
		
		Если НЕ ЗначениеЗаполнено(ЭКОМДок.ЗаказНомер) Тогда
			ЭКОМДок.ЗаказНомер = СоответствиеИнфПолФХЖ2.Получить("номер_заказа");
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ЭКОМДок.ЗаказДата) Тогда
			ЭКОМДок.ЗаказДата  = ДатаИзXML_в_1С(СоответствиеИнфПолФХЖ2.Получить("дата_заказа"));
		КонецЕсли;
		
		Всего_СуммаСНДС_Уменьшение = ЭКОМ_ПреобразоватьВЧисло(СтруктураДокумента.Документ_ТаблКСчФ_ВсегоУм_СтТовУчНалВсего); 
		Всего_СуммаНДС_Уменьшение = ЭКОМ_ПреобразоватьВЧисло(СтруктураДокумента.Документ_ТаблКСчФ_ВсегоУм_СумНал_СумНДС); 
		
		Всего_СуммаСНДС_Увеличение = ЭКОМ_ПреобразоватьВЧисло(СтруктураДокумента.Документ_ТаблКСчФ_ВсегоУвел_СтТовУчНалВсего);
		Всего_СуммаНДС_Увеличение = ЭКОМ_ПреобразоватьВЧисло(СтруктураДокумента.Документ_ТаблКСчФ_ВсегоУвел_СумНал_СумНДС);
		
		// Сумма с НДС
		Если НЕ Всего_СуммаСНДС_Уменьшение = 0 Тогда
			ЭКОМДок.СуммаДокументаВсего = - Всего_СуммаСНДС_Уменьшение;
		Иначе
			ЭКОМДок.СуммаДокументаВсего = Всего_СуммаСНДС_Увеличение;
		КонецЕсли;
		
		// НДС
		Если НЕ Всего_СуммаНДС_Уменьшение = 0 Тогда
			ЭКОМДок.СуммаНДСВсего = - Всего_СуммаНДС_Уменьшение;
		Иначе
			ЭКОМДок.СуммаНДСВсего = Всего_СуммаНДС_Увеличение;
		КонецЕсли;
		
		// Запись документа основания в документ
		СтруктураДокумента.Вставить("ЭКОМДокОснование", Выборка.ЭКОМДокОснование);
		Если ЗначениеЗаполнено(Выборка.ЭКОМДокОснование) Тогда
			ЭКОМДок.ДокументыСвязанные.Очистить(); 
			НовСтрДокСвязанного = ЭКОМДок.ДокументыСвязанные.Добавить();
			НовСтрДокСвязанного.ДокументСвязанный = Выборка.ЭКОМДокОснование;		
		КонецЕсли; 
		
		// Данные по контрагенту		
		Идентификатор = "";
		Если СтруктураДокумента.Свойство("СвУчДокОбор_ИдОтпр", Идентификатор) Тогда
			СтруктураДокумента.Вставить("ИдОтпр", Идентификатор);
		КонецЕсли;
		
		ИНН = "";
		Если СтруктураДокумента.Свойство("Документ_СвКСчФ_СвПрод_ИдСв_СвЮЛУч_ИННЮЛ", ИНН) Тогда
			СтруктураДокумента.Вставить("ПродавецИНН", ИНН);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ИНН) Тогда
			Если СтруктураДокумента.Свойство("Документ_СвКСчФ_СвПрод_ИдСв_СвИП_ИННФЛ", ИНН) Тогда
				СтруктураДокумента.Вставить("ПродавецИНН", ИНН);
			КонецЕсли;
		КонецЕсли;
		
		КПП = "";
		Если СтруктураДокумента.Свойство("Документ_СвКСчФ_СвПрод_ИдСв_СвЮЛУч_КПП", КПП) Тогда
			СтруктураДокумента.Вставить("ПродавецКПП", КПП);
		КонецЕсли;
		
		ЭКОМДок.ТекстОшибки = ""; // Очищаем ошибки документа
		ЭКОМДок.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.ПустаяСсылка(); // Обнуляем статус документ
		
		ТекстОшибки      = ""; // Ошибки по документу - записываем в регистр сведений - выводим в табличную часть		
		//Если есть уточнение записываем его в комментарий!
		ВыполнитьДополнительныеДействия(ЭКОМДок, "Входящий ЮЗД - универсальный передаточный документ",
		СтруктураДокумента,
		МассивЛогаСобытий,
		ТекстОшибки,
		,
		,
		,
		,
		КэшированныеЗначения);
			
		ЭКОМДок.ТЧ_Товары.Сортировать("НомерСтрокиXML Возр");
		
		Если ЭКОМДок.ЭтоПовторныйДокумент = Истина Тогда
			ЭКОМДок.Комментарий     = "Повторный документ! Данный документ уже был загружен ранее." + " " + ЭКОМДок.Комментарий;	
		КонецЕсли;
		
		// По умолчанию документ загружается и записывается, если ЭКОМ документ не нужен в гибких настройках необходимо поставить НеЗагружатьДокумент = Истина 
		Если ЭКОМДок.НеЗагружатьДокумент = Ложь Тогда
			
			СтруктураРегистраСобытий = Новый Структура;
			СтруктураРегистраСобытий.Вставить("ДатаЗаписи"                  , ТекущаяДата());
			СтруктураРегистраСобытий.Вставить("ЭЦП"                         , СтрокаТЗСтруктур.ЭЦП);
			СтруктураРегистраСобытий.Вставить("Контрагент"                  , Выборка.Контрагент);
			СтруктураРегистраСобытий.Вставить("Организация"                 , Выборка.Организация);
			СтруктураРегистраСобытий.Вставить("НаправлениеОбмена"           , Перечисления.ЭКОМ_НаправлениеОбмена.Входящий);
			СтруктураРегистраСобытий.Вставить("ФайлИмя"                     , СтрокаТЗСтруктур.ИмяФайлаXML);
			СтруктураРегистраСобытий.Вставить("ЗаказДата"                   , ЭКОМДок.ЗаказДата);					
			СтруктураРегистраСобытий.Вставить("ЗаказНомер"                  , ЭКОМДок.ЗаказНомер);
			СтруктураРегистраСобытий.Вставить("Идентификатор"               , Выборка.ИдФайл);
			СтруктураРегистраСобытий.Вставить("СтруктураФайла"              , Новый ХранилищеЗначения(СтруктураДокумента, Новый СжатиеДанных(9)));
			
			СтруктураДокумента.Вставить("ЭтоПовторныйДокумент", ЭКОМДок.ЭтоПовторныйДокумент);
			
			ДокументОбработан = ПроверитьОбработкуДокумента(ТекстОшибки, ЭКОМДок, СтруктураДокумента, СтруктураРегистраСобытий, ПредставлениеДокументаXML, МассивЛогаСобытий);
			Если ДокументОбработан = Ложь Тогда
				Продолжить;			
			КонецЕсли;
			
		Иначе 		
			СтруктураДокумента.Вставить("Обработан", Ложь);
			ТекстЛогаСобытий = "В гибких настройках указано не загружать документ - " + ПредставлениеДокументаXML;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
		КонецЕсли;
		
		СтруктураДокумента.Вставить("Организация", Выборка.Организация);
		СтрокаТЗСтруктур.СтруктураДокумента = СтруктураДокумента;
		
	КонецЦикла;
	
	Если НЕ СоответствиеПоОрганизации.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоОрганизации     , "Организация_");
	КонецЕсли;
	Если НЕ СоответствиеПоКонтрагенту.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоКонтрагенту     , "Контрагент_");
	КонецЕсли;
	
КонецПроцедуры

Процедура СоздатьЭКОМ_ДокВозвратаRETANN(ТЗСтруктур, ДокументыШапка, пДокументыТабличнаяЧасть, МассивЛогаСобытий) Экспорт	
	
	КэшированныеЗначения = Неопределено;
	
	// Запрос к табличной части
	Запрос = Новый Запрос;	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_VAT, 0, 100) КАК СтавкаНДС,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_PRODUCTIDSUPPLIER, 0, 100) КАК КодПоставщика,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_PRODUCTIDBUYER, 0, 100) КАК КодПокупателя,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_ACTION_CODE, 0, 100) КАК ДействиеПоДокументу,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_CURRENCY, 0, 100) КАК xmlВалюта,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_POSITIONNUMBER, 0, 100) КАК НомерСтрокиТЧ,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_PRODUCT, 0, 100) КАК ШтрихКод,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_RETURNQUANTITY, 0, 100) КАК ВозвращенноеКоличество,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_RETURNQUANTITYUNIT, 0, 100) КАК ВозвращенноеЕдиницаИзмеренияXml,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_DELIVEREDQUANTITY, 0, 100) КАК ДоставленноеКоличество,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_DELIVEREDQUANTITYUNIT, 0, 100) КАК ДоставленноеЕдиницаИзмеренияXml,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_QUANTITYOFCUINTU, 0, 100) КАК КоличествоВУпаковке,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_PRICE, 0, 100) КАК Цена,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_ACTION_DESCRIPTION, 1, 100) КАК ОписаниеПричины,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.xmlКонтрагентGLN, 0, 100) КАК xmlКонтрагентGLN,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.ИдентификаторФайла, 0, 250) КАК ИдентификаторФайла
	|ПОМЕСТИТЬ пДокументыТабличнаяЧасть
	|ИЗ
	|	&пДокументыТабличнаяЧасть КАК пДокументыТабличнаяЧасть
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	пДокументыТабличнаяЧасть.НомерСтрокиТЧ КАК НомерСтрокиТЧ,
	|	пДокументыТабличнаяЧасть.xmlКонтрагентGLN КАК xmlКонтрагентGLN,
	|	пДокументыТабличнаяЧасть.ШтрихКод КАК ШтрихКод,
	|	ЭКОМ_GLN.Объект КАК Контрагент,
	|	пДокументыТабличнаяЧасть.ВозвращенноеЕдиницаИзмеренияXml КАК ВозвращенноеЕдиницаИзмеренияXml,
	|	пДокументыТабличнаяЧасть.ДоставленноеЕдиницаИзмеренияXml КАК ДоставленноеЕдиницаИзмеренияXml,
	|	пДокументыТабличнаяЧасть.ДействиеПоДокументу,
	|	пДокументыТабличнаяЧасть.xmlВалюта,
	|	пДокументыТабличнаяЧасть.ВозвращенноеКоличество,
	|	пДокументыТабличнаяЧасть.ДоставленноеКоличество,
	|	пДокументыТабличнаяЧасть.КоличествоВУпаковке,
	|	пДокументыТабличнаяЧасть.Цена,
	|	пДокументыТабличнаяЧасть.ИдентификаторФайла,
	|	пДокументыТабличнаяЧасть.КодПоставщика,
	|	пДокументыТабличнаяЧасть.КодПокупателя,
	|	пДокументыТабличнаяЧасть.СтавкаНДС,
	|	пДокументыТабличнаяЧасть.ОписаниеПричины,
	|	ВЫБОР
	|		КОГДА пДокументыТабличнаяЧасть.ВозвращенноеЕдиницаИзмеренияXml ЕСТЬ NULL
	|				ИЛИ пДокументыТабличнаяЧасть.ВозвращенноеЕдиницаИзмеренияXml = НЕОПРЕДЕЛЕНО
	|				ИЛИ пДокументыТабличнаяЧасть.ВозвращенноеЕдиницаИзмеренияXml = """"
	|			ТОГДА пДокументыТабличнаяЧасть.ДоставленноеЕдиницаИзмеренияXml
	|		ИНАЧЕ пДокументыТабличнаяЧасть.ВозвращенноеЕдиницаИзмеренияXml
	|	КОНЕЦ КАК xmlЕдиницаИзмерения
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	пДокументыТабличнаяЧасть КАК пДокументыТабличнаяЧасть
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN
	|		ПО пДокументыТабличнаяЧасть.xmlКонтрагентGLN = ЭКОМ_GLN.GLN
	|			И (ЭКОМ_GLN.Объект ССЫЛКА Справочник.Контрагенты)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ЭКОМ_НоменклатураКонтрагентов.Номенклатура, НЕОПРЕДЕЛЕНО) КАК Номенклатура,
	|	ЕСТЬNULL(ЭКОМ_НоменклатураКонтрагентов.ХарактеристикаНоменклатуры, НЕОПРЕДЕЛЕНО) КАК ХарактеристикаНоменклатуры,
	|	ЭКОМ_НоменклатураКонтрагентов.ЕдиницаНоменклатурыКонтрагента КАК ЕдиницаИзмерения,
	|	ЭКОМ_ЗначениеДополнительныхКонстант.ЗначениеДополнительнойКонстанты КАК ЕдиницаИзмеренияПоУмолчанию,
	|	ВТ.НомерСтрокиТЧ,
	|	ВТ.xmlКонтрагентGLN,
	|	ВТ.ШтрихКод,
	|	ВТ.Контрагент,
	|	ВТ.ДействиеПоДокументу,
	|	ВТ.xmlВалюта,
	|	ВТ.ВозвращенноеКоличество,
	|	ВТ.ДоставленноеКоличество,
	|	ВТ.КоличествоВУпаковке,
	|	ВТ.Цена,
	|	ВТ.ИдентификаторФайла,
	|	ВТ.КодПоставщика,
	|	ВТ.КодПокупателя,
	|	ВТ.СтавкаНДС,
	|	ВТ.ОписаниеПричины,
	|	ВТ.xmlЕдиницаИзмерения
	|ИЗ
	|	ВТ КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_НоменклатураКонтрагентов КАК ЭКОМ_НоменклатураКонтрагентов
	|		ПО ВТ.ШтрихКод = ЭКОМ_НоменклатураКонтрагентов.ШтрихКодНоменклатурыКонтрагента
	|			И ВТ.Контрагент = ЭКОМ_НоменклатураКонтрагентов.Контрагент
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_ЗначениеДополнительныхКонстант КАК ЭКОМ_ЗначениеДополнительныхКонстант
	|		ПО (ЭКОМ_ЗначениеДополнительныхКонстант.ДополнительнаяКонстанта = ""ЕдиницаИзмерения_"" + ВТ.xmlЕдиницаИзмерения)
	|			И (ЭКОМ_ЗначениеДополнительныхКонстант.Измерение = ""Единица измерения"")";
	Запрос.УстановитьПараметр("пДокументыТабличнаяЧасть", пДокументыТабличнаяЧасть);
	РезультатЗапроса = Запрос.Выполнить();
	ДокументыТабличнаяЧасть = РезультатЗапроса.Выгрузить();
	ДокументыТабличнаяЧасть.Индексы.Добавить("ИдентификаторФайла"); 
	
	// Запрос по шапке документов
	Запрос = Новый Запрос;	
	Запрос.Текст =                      
	"ВЫБРАТЬ
	|	ПОДСТРОКА(ДокументыШапка.INFO, 1, 250) КАК ДополнительнаяИнформация,
	|	ПОДСТРОКА(ДокументыШапка.HEAD_RECIPIENT, 1, 100) КАК xmlОрганизацияGLN,
	|	ПОДСТРОКА(ДокументыШапка.HEAD_SENDER, 1, 100) КАК xmlКонтрагентGLN,
	|	ПОДСТРОКА(ДокументыШапка.HEAD_DELIVERYPLACE, 1, 100) КАК xmlТочкаДоставкиGLN,
	|	ДокументыШапка.RECADVDATE КАК УведОПриемеДата,
	|	ПОДСТРОКА(ДокументыШапка.RECADVNUMBER, 1, 100) КАК УведОПриемеНомер,
	|	ДокументыШапка.DESADVDATE КАК УведОбОтгрузкеДата,
	|	ПОДСТРОКА(ДокументыШапка.DESADVNUMBER, 1, 100) КАК УведОбОтгрузкеНомер,
	|	ДокументыШапка.ORDERDATE КАК ЗаказДата,
	|	ПОДСТРОКА(ДокументыШапка.ORDERNUMBER, 1, 100) КАК ЗаказНомер,
	|	ПОДСТРОКА(ДокументыШапка.ACTION, 1, 100) КАК ДействиеПоДокументу,
	|	ДокументыШапка.RETURNDATE КАК ДатаВозврата,
	|	ДокументыШапка.DATE КАК ФайлДата,
	|	ПОДСТРОКА(ДокументыШапка.NUMBER, 1, 100) КАК ФайлНомер,
	|	ДокументыШапка.ВидДокумента КАК ВидДокумента,
	|	ПОДСТРОКА(ДокументыШапка.ИдФайл, 1, 250) КАК ИдФайл
	|ПОМЕСТИТЬ ДокументыШапка
	|ИЗ
	|	&ДокументыШапка КАК ДокументыШапка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ЭКОМ_Документы.Ссылка, НЕОПРЕДЕЛЕНО) КАК ЭКОМДок,
	|	ЭКОМ_Документы.ПометкаУдаления КАК ПометкаУдаления,
	|	ЭКОМ_Документы.СтатусОбработкиДокумента КАК СтатусОбработкиДокумента,
	|	ЭКОМ_GLN_Организация.Объект КАК Организация,
	|	ЭКОМ_GLN_Контрагент.Объект КАК Контрагент,
	|	ЭКОМ_ТочкиДоставки.Объект КАК ТочкаДоставки,
	|	ДокументыШапка.ИдФайл КАК ИдФайл,
	|	ДокументыШапка.xmlОрганизацияGLN,
	|	ДокументыШапка.xmlКонтрагентGLN,
	|	ДокументыШапка.xmlТочкаДоставкиGLN,
	|	ДокументыШапка.УведОПриемеДата,
	|	ДокументыШапка.УведОПриемеНомер,
	|	ДокументыШапка.УведОбОтгрузкеДата,
	|	ДокументыШапка.УведОбОтгрузкеНомер,
	|	ДокументыШапка.ЗаказДата,
	|	ДокументыШапка.ЗаказНомер,
	|	ДокументыШапка.ДействиеПоДокументу,
	|	ДокументыШапка.ДатаВозврата,
	|	ДокументыШапка.ФайлДата,
	|	ДокументыШапка.ФайлНомер,
	|	ДокументыШапка.ВидДокумента,
	|	ДокументыШапка.ДополнительнаяИнформация
	|ИЗ
	|	ДокументыШапка КАК ДокументыШапка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭКОМ_Документы КАК ЭКОМ_Документы
	|		ПО ДокументыШапка.ФайлДата = ЭКОМ_Документы.ФайлДата
	|			И ДокументыШапка.ФайлНомер = ЭКОМ_Документы.ФайлНомер
	|			И ДокументыШапка.ВидДокумента = ЭКОМ_Документы.ВидДокумента
	|			И (ДокументыШапка.ИдФайл + "".xml"" = ПОДСТРОКА(ЭКОМ_Документы.ИмяФайла, 0, 250))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Организация
	|		ПО ДокументыШапка.xmlОрганизацияGLN = ЭКОМ_GLN_Организация.GLN
	|			И (НЕ ЭКОМ_GLN_Организация.Объект ССЫЛКА Справочник.Контрагенты)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Контрагент
	|		ПО ДокументыШапка.xmlКонтрагентGLN = ЭКОМ_GLN_Контрагент.GLN
	|			И (ЭКОМ_GLN_Контрагент.Объект ССЫЛКА Справочник.Контрагенты)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_ТочкиДоставки КАК ЭКОМ_ТочкиДоставки
	|		ПО ДокументыШапка.xmlТочкаДоставкиGLN = ЭКОМ_ТочкиДоставки.GLN";
	
	Запрос.УстановитьПараметр("ДокументыШапка", ДокументыШапка);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ПроверкаНаДублирование = Новый Соответствие;
	
	СоответствиеПоОрганизации      = Новый Соответствие;
	СоответствиеПоКонтрагенту      = Новый Соответствие;
	СоответствиеПоТочкамДоставки   = Новый Соответствие;
	СоответствиеПоНоменклатуре     = Новый Соответствие;
	
	Пользователь = НайтиТекущегоПользователя();
	
	ИмяСобытия = "Создание документа Docrobot-RETANN";
	Пока Выборка.Следующий() Цикл
		
		// Для проверки дублирования строк
		Если ПроверкаНаДублирование.Получить(Выборка.ИдФайл) = Неопределено Тогда
			ПроверкаНаДублирование.Вставить(Выборка.ИдФайл, "Строка добавлена");
		Иначе			
			ТекстЛогаСобытий = "Дубль данных, проверьте GLN организации, контрагента, точки доставки ИД документа - " + Выборка.ИдФайл;	
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			Продолжить;
			
		КонецЕсли;
		
		// Получаем структуру документа
		пСтруктураДокумента = Неопределено;
		СтрокаТЗСтруктур = ТЗСтруктур.Найти(Выборка.ИдФайл, "ИдентификаторФайла");
		Если СтрокаТЗСтруктур = Неопределено Тогда			
			ТекстЛогаСобытий = "Не найдена структура документа с ИД = " + Выборка.ИдФайл;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
	
			Продолжить;
			
		Иначе			
			пСтруктураДокумента = СтрокаТЗСтруктур.СтруктураДокумента;
			
		КонецЕсли;
		
		ПредставлениеДокументаXML = Строка(Выборка.ВидДокумента) + " № " + Выборка.ФайлНомер + " от " + Формат(Выборка.ФайлДата, "ДФ='dd.MM.yyyy ""г.""'");
		
		Если Выборка.ЭКОМДок = Неопределено Тогда
			ЭКОМДок = Документы.ЭКОМ_Документы.СоздатьДокумент();
		ИначеЕсли (Выборка.ПометкаУдаления = Истина 
			ИЛИ Выборка.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.НеОбработан) Тогда
			ЭКОМДок = Выборка.ЭКОМДок.ПолучитьОбъект();
			ЭКОМДок.ПометкаУдаления = ЛОЖЬ;
			ЭКОМДок.ТЧ_Товары.Очистить();
			// Очищение остальных табличных частей документов в гибких настроках при необходимости
			
		Иначе
			ТекстЛогаСобытий = ПредставлениеДокументаXML +  " - ЭКОМ документ уже существует в 1С, номер = " + Выборка.ЭКОМДок.Номер + " от " + Выборка.ЭКОМДок.Дата;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Продолжить;
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Выборка.Организация) Тогда
			СоответствиеПоОрганизации.Вставить("Организация_" + Выборка.xmlОрганизацияGLN, Выборка.xmlОрганизацияGLN);	
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Выборка.Контрагент) Тогда
			СоответствиеПоКонтрагенту.Вставить("Контрагент_" + Выборка.xmlКонтрагентGLN, Выборка.xmlКонтрагентGLN);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Выборка.ТочкаДоставки) Тогда
			СоответствиеПоТочкамДоставки.Вставить("ТочкаДоставки_" + Выборка.xmlТочкаДоставкиGLN, Выборка.xmlТочкаДоставкиGLN);
		КонецЕсли;
		
		// Шапка
		ЭКОМДок.Организация               = Выборка.Организация;
		ЭКОМДок.xmlОрганизация            = Выборка.xmlОрганизацияGLN;
		ЭКОМДок.ВидДокумента              = Выборка.ВидДокумента;
		ЭКОМДок.Контрагент                = Выборка.Контрагент;
		ЭКОМДок.xmlКонтрагент             = Выборка.xmlКонтрагентGLN;
		ЭКОМДок.Дата                      = ТекущаяДата();
		ЭКОМДок.ЗаказНомер                = Выборка.ЗаказНомер;
		ЭКОМДок.ЗаказДата                 = Выборка.ЗаказДата;
		ЭКОМДок.ИмяФайла                  = СтрокаТЗСтруктур.ИмяФайлаXML;		
		ЭКОМДок.ТочкаДоставки             = Выборка.ТочкаДоставки;
		ЭКОМДок.xmlТочкаДоставки          = Выборка.xmlТочкаДоставкиGLN;
		ЭКОМДок.ИнформацияПоДокументу     = Выборка.ДополнительнаяИнформация;
		ЭКОМДок.Ответственный             = Пользователь;
		ЭКОМДок.ФайлНомер                 = Выборка.ФайлНомер;
		ЭКОМДок.ФайлДата                  = Выборка.ФайлДата;
		ЭКОМДок.ДатаПоставки              = Выборка.ДатаВозврата;
		ЭКОМДок.УточнениеОПоставке        = Выборка.ДействиеПоДокументу;
		ЭКОМДок.НакладнаяДата             = Выборка.УведОбОтгрузкеДата;
		ЭКОМДок.НакладнаяНомер            = Выборка.УведОбОтгрузкеНомер;
		ЭКОМДок.СЧФНомер                  = Выборка.УведОПриемеНомер;
		ЭКОМДок.СЧФДата                   = Выборка.УведОПриемеДата;
		ЭКОМДок.НомерТранзакции           = Выборка.ИдФайл;
		
		// ТЧ товары
		xmlВалюта            = "RUB";
		лСумма_Всего         = 0;
		лСумма_НДС_Всего     = 0;
		ТекстОшибки          = "";
		ПроверкаНаДублированиеТЧ = Новый Соответствие;
		
		Отбор = Новый Структура();
		Отбор.Вставить("ИдентификаторФайла", Выборка.ИдФайл);
		МассивСтрок = ДокументыТабличнаяЧасть.НайтиСтроки(Отбор);
		
		Для Каждого СтруктСтрока Из МассивСтрок Цикл	
			
			Если ЗначениеЗаполнено(СтруктСтрока.xmlВалюта) Тогда
				xmlВалюта = СтруктСтрока.xmlВалюта;
			КонецЕсли;
			
			СоставнойШтрихКод = СокрЛП(СтруктСтрока.НомерСтрокиТЧ) + "_" + СокрЛП(СтруктСтрока.ШтрихКод);
			Если ЗначениеЗаполнено(СтруктСтрока.ШтрихКод) Тогда
				Если ПроверкаНаДублированиеТЧ.Получить(СоставнойШтрихКод) = Неопределено Тогда
					ПроверкаНаДублированиеТЧ.Вставить(СоставнойШтрихКод, "Строка добавлена");
				Иначе
					
					ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
					+ "Дубль данных, проверьте номенклатуру - " + СтруктСтрока.ШтрихКод + ", строка - " + СокрЛП(СтруктСтрока.НомерСтрокиТЧ);
					
					Продолжить;
					
				КонецЕсли;		
			КонецЕсли;
			
			Номенклатура     = СтруктСтрока.Номенклатура; 
			ЕдиницаИзмерения = СтруктСтрока.ЕдиницаИзмерения;
			
			Если НЕ ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда			 							
				ЕдиницаИзмерения = СтруктСтрока.ЕдиницаИзмеренияПоУмолчанию;			
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Номенклатура)
				И ЗначениеЗаполнено(Выборка.Контрагент) Тогда
				Код = ?(ЗначениеЗаполнено(СтруктСтрока.ШтрихКод), СтруктСтрока.ШтрихКод, СтруктСтрока.КодПокупателя) + "_" + ЭКОМДок.xmlКонтрагент;
				СоответствиеПоНоменклатуре.Вставить("АртикулНоменклатурыКонтрагента_"      + Код, СтруктСтрока.КодПоставщика); // PRODUCTIDSUPPLIER
				СоответствиеПоНоменклатуре.Вставить("КодНоменклатурыКонтрагента_"          + Код, СтруктСтрока.КодПокупателя); // PRODUCTIDBUYER
				СоответствиеПоНоменклатуре.Вставить("ШтрихКодНоменклатурыКонтрагента_"     + Код, СтруктСтрока.ШтрихКод);      // PRODUCT
				СоответствиеПоНоменклатуре.Вставить("ЕдиницаНоменклатурыКонтрагента_"      + Код, ЕдиницаИзмерения);
				СоответствиеПоНоменклатуре.Вставить("Контрагент_"                          + Код, Выборка.Контрагент);
				СоответствиеПоНоменклатуре.Вставить("xmlЕдиницаИзмерения_"                 + Код, СтруктСтрока.xmlЕдиницаИзмерения); // Информация при выборе ед. измерения из справочника                    
			КонецЕсли;
			
			ЦенаБезНДС = СтруктСтрока.Цена;
			ЦенаСНДС   = 0;
			
			СтавкаНДСДок = СтруктСтрока.СтавкаНДС;
			Если НЕ ЗначениеЗаполнено(СтавкаНДСДок) Тогда
				Если ЦенаБезНДС <> ЦенаСНДС	
					И ЦенаБезНДС <> 0
					И ЦенаСНДС   <> 0 Тогда
					СтавкаНДСДок = Окр(((ЦенаСНДС - ЦенаБезНДС) / ЦенаБезНДС) * 100);
				Иначе
					СтавкаНДСДок = 0;
				КонецЕсли;		
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтруктСтрока.ВозвращенноеКоличество) Тогда
				знКоличество = СтруктСтрока.ВозвращенноеКоличество;	
			Иначе
				знКоличество = СтруктСтрока.ДоставленноеКоличество;
			КонецЕсли;
			СуммаСНДС = ЦенаСНДС * знКоличество;
			
			Если ЦенаБезНДС = 0 Тогда
				Если (СуммаСНДС > 0) И (знКоличество > 0) Тогда
					ЦенаСНДС      = Окр(СуммаСНДС/знКоличество, 4);			
					ЦенаБезНДС    = Окр( (ЦенаСНДС * 100) / (100 + СтавкаНДСДок) , 4);
				КонецЕсли;
			КонецЕсли;
			
			Если ЦенаСНДС = 0 Тогда
				ЦенаСНДС  = Окр( (ЦенаБезНДС * (100 + СтавкаНДСДок)) / 100 , 4);
				СуммаСНДС = ЦенаСНДС * знКоличество;
			КонецЕсли;	
			
			лСуммаБезНДС = ЦенаБезНДС * знКоличество;		
			Если лСуммаБезНДС = 0 Тогда
				Если (СуммаСНДС > 0) Тогда 
					лСуммаБезНДС = Окр( (СуммаСНДС * 100) / (100 + СтавкаНДСДок) , 4);	
				КонецЕсли;
			КонецЕсли;
			
			Если СуммаСНДС = 0 И СтавкаНДСДок <> 0 Тогда
				СуммаСНДС = Окр((лСуммаБезНДС * (100 + СтавкаНДСДок)) / 100 , 2);
			КонецЕсли;
			
			лСумма_НДС = Окр(лСуммаБезНДС * (СтавкаНДСДок/100), 4);	
			//лСумма_НДС = лСуммаСНДС - лСуммаБезНДС;	  
			
			НовСтрока                         = ЭКОМДок.ТЧ_Товары.Добавить();
			НовСтрока.Номенклатура            = Номенклатура;
			НовСтрока.ЕдиницаИзмерения        = ЕдиницаИзмерения;
			НовСтрока.xmlЕдиницаИзмерения     = СтруктСтрока.xmlЕдиницаИзмерения;
			НовСтрока.Цена                    = ЦенаБезНДС;
			НовСтрока.ЦенаСНДС                = ЦенаСНДС;
			НовСтрока.ОписаниеПродукта        = СтруктСтрока.ОписаниеПричины;
			НовСтрока.КоличествоПринятое      = СтруктСтрока.ВозвращенноеКоличество;
			НовСтрока.КоличествоПоставляемое  = СтруктСтрока.ДоставленноеКоличество;
			НовСтрока.Сумма                   = лСуммаБезНДС;
			НовСтрока.СтавкаНДС               = СтавкаНДСДок;
			НовСтрока.СуммаНДС                = лСумма_НДС;
			НовСтрока.Сумма_с_НДС             = СуммаСНДС;
			НовСтрока.НомерПродукта           = СтруктСтрока.ШтрихКод;
			НовСтрока.НомерПродуктаПокупателя = СтруктСтрока.КодПокупателя;
			НовСтрока.УточнениеОПоставке      = СтруктСтрока.ДействиеПоДокументу;
			НовСтрока.КоличествоВУпаковке 	  = СтруктСтрока.КоличествоВУпаковке; 
			
			лСумма_НДС_Всего     = лСумма_НДС_Всего + лСумма_НДС;
			лСумма_Всего         = лСумма_Всего + лСуммаБезНДС + лСумма_НДС;		
		КонецЦикла;
		
		ЭКОМДок.СуммаДокументаВсего = лСумма_Всего;
		ЭКОМДок.СуммаНДСВсего       = лСумма_НДС_Всего;
		ЭКОМДок.xmlВалюта           = xmlВалюта;
		
		ЭКОМДок.ТекстОшибки = ""; // Очищаем ошибки документа
		ЭКОМДок.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.ПустаяСсылка(); // Обнуляем статус документ
		
		ВыполнитьДополнительныеДействия(ЭКОМДок, "Входящий RETANN (уведомление о возврате)", пСтруктураДокумента, МассивЛогаСобытий, ТекстОшибки, 
		СоответствиеПоОрганизации,
		СоответствиеПоКонтрагенту,
		СоответствиеПоТочкамДоставки,
		СоответствиеПоНоменклатуре,
		КэшированныеЗначения);
				
		ЭКОМДок.ТЧ_Товары.Сортировать("НомерСтрокиXML Возр");
		
		// По умолчанию документ загружается и записывается, если ЭКОМ документ не нужен в гибких настройках необходимо поставить НеЗагружатьДокумент = Истина 
		Если ЭКОМДок.НеЗагружатьДокумент = Ложь Тогда
			
			СтруктураРегистраСобытий = Новый Структура; 
			СтруктураРегистраСобытий.Вставить("ДатаЗаписи"                  , ТекущаяДата());
			СтруктураРегистраСобытий.Вставить("Контрагент"                  , ЭКОМДок.Контрагент);
			СтруктураРегистраСобытий.Вставить("Организация"                 , ЭКОМДок.Организация);
			СтруктураРегистраСобытий.Вставить("НаправлениеОбмена"           , Перечисления.ЭКОМ_НаправлениеОбмена.Входящий);
			СтруктураРегистраСобытий.Вставить("ФайлИмя"                     , СтрокаТЗСтруктур.ИмяФайлаXML);
			СтруктураРегистраСобытий.Вставить("ЗаказДата"                   , ЭКОМДок.ЗаказДата);					
			СтруктураРегистраСобытий.Вставить("ЗаказНомер"                  , ЭКОМДок.ЗаказНомер);
			СтруктураРегистраСобытий.Вставить("СтруктураФайла"              , Новый ХранилищеЗначения(пСтруктураДокумента,  Новый СжатиеДанных(9)));
			СтруктураРегистраСобытий.Вставить("Идентификатор"               , пСтруктураДокумента.ИдФайл);
			
			Н = 1;
			Для Каждого Стр Из ЭКОМДок.ТЧ_Товары Цикл			
				// Проверка заполнения документа
				Если НЕ ЗначениеЗаполнено(Стр.ЕдиницаИзмерения) Тогда	
					ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "") 
					+ "В строке № " + Н + " " + "не заполнена единица измерения. (смотрите гибкие настройки или регистр сведений ЭКОМ_НоменклатураКонтрагентов)" 
					+ "(" + Стр.xmlЕдиницаИзмерения + ")"; 
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(Стр.Номенклатура) Тогда
					ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
					+ "В строке № " + Н + " " + "не заполнена номенклатура." 
					+ "(" + Стр.НомерПродукта + ")";
				КонецЕсли;
				
				Н = Н + 1;	
			КонецЦикла;
			
			Если НЕ ЗначениеЗаполнено(ЭКОМДок.Организация) Тогда
				ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
				+ "Не заполнена организация." + "(" + ЭКОМДок.xmlОрганизация + ")"; 
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ЭКОМДок.Контрагент) Тогда
				ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
				+ "Не заполнен контрагент." + "(" + ЭКОМДок.xmlКонтрагент + ")";
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ЭКОМДок.ТочкаДоставки) Тогда
				ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
				+ "Не заполнена точка доставки." + "(" + ЭКОМДок.xmlТочкаДоставки + ")";
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ЭКОМДок.Валюта) Тогда
				ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
				+ "Не заполнена валюта." + "(" + ЭКОМДок.xmlВалюта + ")";
			КонецЕсли;
			
			ДокументОбработан = ПроверитьОбработкуДокумента(ТекстОшибки, ЭКОМДок, пСтруктураДокумента, СтруктураРегистраСобытий, ПредставлениеДокументаXML, МассивЛогаСобытий);
			Если ДокументОбработан = Ложь Тогда
				Продолжить;			
			КонецЕсли;
			
		Иначе 			
			пСтруктураДокумента.Вставить("Обработан", Ложь);
			ТекстЛогаСобытий = "В гибких настройках указано не загружать документ - " + ПредставлениеДокументаXML;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ СоответствиеПоОрганизации.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоОрганизации     , "Организация_");
	КонецЕсли;
	Если НЕ СоответствиеПоКонтрагенту.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоКонтрагенту     , "Контрагент_");
	КонецЕсли;
	Если НЕ СоответствиеПоТочкамДоставки.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоТочкамДоставки  , "ТочкаДоставки_");
	КонецЕсли;
	Если НЕ СоответствиеПоНоменклатуре.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоНоменклатуре    , "Номенклатура_");
	КонецЕсли;
	
КонецПроцедуры

Процедура СоздатьЭКОМ_ДокИнструкцияRETINS(ТЗСтруктур, ДокументыШапка, пДокументыТабличнаяЧасть, МассивЛогаСобытий) Экспорт	
	
	КэшированныеЗначения = Неопределено;
	
	// Запрос к табличной части
	Запрос = Новый Запрос;	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_VAT, 0, 100) КАК СтавкаНДС,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_PRODUCTIDSUPPLIER, 0, 100) КАК КодПоставщика,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_PRODUCTIDBUYER, 0, 100) КАК КодПокупателя,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_ACTION_CODE, 0, 100) КАК ДействиеПоДокументу,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_CURRENCY, 0, 100) КАК xmlВалюта,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_POSITIONNUMBER, 0, 100) КАК НомерСтрокиТЧ,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_PRODUCT, 0, 100) КАК ШтрихКод,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_RETURNQUANTITY, 0, 100) КАК ВозвращенноеКоличество,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_RETURNQUANTITYUNIT, 0, 100) КАК ВозвращенноеЕдиницаИзмеренияXml,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_DELIVEREDQUANTITY, 0, 100) КАК ДоставленноеКоличество,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_DELIVEREDQUANTITYUNIT, 0, 100) КАК ДоставленноеЕдиницаИзмеренияXml,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_PRICE, 0, 100) КАК Цена,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.HEAD_POSITION_ACTION_DESCRIPTION, 1, 100) КАК ОписаниеПричины,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.xmlКонтрагентGLN, 0, 100) КАК xmlКонтрагентGLN,
	|	ПОДСТРОКА(пДокументыТабличнаяЧасть.ИдентификаторФайла, 0, 250) КАК ИдентификаторФайла
	|ПОМЕСТИТЬ пДокументыТабличнаяЧасть
	|ИЗ
	|	&пДокументыТабличнаяЧасть КАК пДокументыТабличнаяЧасть
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	пДокументыТабличнаяЧасть.НомерСтрокиТЧ КАК НомерСтрокиТЧ,
	|	пДокументыТабличнаяЧасть.xmlКонтрагентGLN КАК xmlКонтрагентGLN,
	|	пДокументыТабличнаяЧасть.ШтрихКод КАК ШтрихКод,
	|	ЭКОМ_GLN.Объект КАК Контрагент,
	|	пДокументыТабличнаяЧасть.ВозвращенноеЕдиницаИзмеренияXml КАК ВозвращенноеЕдиницаИзмеренияXml,
	|	пДокументыТабличнаяЧасть.ДоставленноеЕдиницаИзмеренияXml КАК ДоставленноеЕдиницаИзмеренияXml,
	|	пДокументыТабличнаяЧасть.ДействиеПоДокументу,
	|	пДокументыТабличнаяЧасть.xmlВалюта,
	|	пДокументыТабличнаяЧасть.ВозвращенноеКоличество,
	|	пДокументыТабличнаяЧасть.ДоставленноеКоличество,
	|	пДокументыТабличнаяЧасть.Цена,
	|	пДокументыТабличнаяЧасть.ИдентификаторФайла,
	|	пДокументыТабличнаяЧасть.КодПоставщика,
	|	пДокументыТабличнаяЧасть.КодПокупателя,
	|	пДокументыТабличнаяЧасть.СтавкаНДС,
	|	пДокументыТабличнаяЧасть.ОписаниеПричины,
	|	ВЫБОР
	|		КОГДА пДокументыТабличнаяЧасть.ВозвращенноеЕдиницаИзмеренияXml ЕСТЬ NULL
	|				ИЛИ пДокументыТабличнаяЧасть.ВозвращенноеЕдиницаИзмеренияXml = НЕОПРЕДЕЛЕНО
	|				ИЛИ пДокументыТабличнаяЧасть.ВозвращенноеЕдиницаИзмеренияXml = """"
	|			ТОГДА пДокументыТабличнаяЧасть.ДоставленноеЕдиницаИзмеренияXml
	|		ИНАЧЕ пДокументыТабличнаяЧасть.ВозвращенноеЕдиницаИзмеренияXml
	|	КОНЕЦ КАК xmlЕдиницаИзмерения
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	пДокументыТабличнаяЧасть КАК пДокументыТабличнаяЧасть
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN
	|		ПО пДокументыТабличнаяЧасть.xmlКонтрагентGLN = ЭКОМ_GLN.GLN
	|			И (ЭКОМ_GLN.Объект ССЫЛКА Справочник.Контрагенты)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ЭКОМ_НоменклатураКонтрагентов.Номенклатура, НЕОПРЕДЕЛЕНО) КАК Номенклатура,
	|	ЕСТЬNULL(ЭКОМ_НоменклатураКонтрагентов.ХарактеристикаНоменклатуры, НЕОПРЕДЕЛЕНО) КАК ХарактеристикаНоменклатуры,
	|	ЭКОМ_НоменклатураКонтрагентов.ЕдиницаНоменклатурыКонтрагента КАК ЕдиницаИзмерения,
	|	ЭКОМ_ЗначениеДополнительныхКонстант.ЗначениеДополнительнойКонстанты КАК ЕдиницаИзмеренияПоУмолчанию,
	|	ВТ.НомерСтрокиТЧ,
	|	ВТ.xmlКонтрагентGLN,
	|	ВТ.ШтрихКод,
	|	ВТ.Контрагент,
	|	ВТ.ДействиеПоДокументу,
	|	ВТ.xmlВалюта,
	|	ВТ.ВозвращенноеКоличество,
	|	ВТ.ДоставленноеКоличество,
	|	ВТ.Цена,
	|	ВТ.ИдентификаторФайла,
	|	ВТ.КодПоставщика,
	|	ВТ.КодПокупателя,
	|	ВТ.СтавкаНДС,
	|	ВТ.ОписаниеПричины,
	|	ВТ.xmlЕдиницаИзмерения
	|ИЗ
	|	ВТ КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_НоменклатураКонтрагентов КАК ЭКОМ_НоменклатураКонтрагентов
	|		ПО ВТ.ШтрихКод = ЭКОМ_НоменклатураКонтрагентов.ШтрихКодНоменклатурыКонтрагента
	|			И ВТ.Контрагент = ЭКОМ_НоменклатураКонтрагентов.Контрагент
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_ЗначениеДополнительныхКонстант КАК ЭКОМ_ЗначениеДополнительныхКонстант
	|		ПО (ЭКОМ_ЗначениеДополнительныхКонстант.ДополнительнаяКонстанта = ""ЕдиницаИзмерения_"" + ВТ.xmlЕдиницаИзмерения)
	|			И (ЭКОМ_ЗначениеДополнительныхКонстант.Измерение = ""Единица измерения"")";
	Запрос.УстановитьПараметр("пДокументыТабличнаяЧасть", пДокументыТабличнаяЧасть);
	РезультатЗапроса = Запрос.Выполнить();
	ДокументыТабличнаяЧасть = РезультатЗапроса.Выгрузить();
	ДокументыТабличнаяЧасть.Индексы.Добавить("ИдентификаторФайла"); 
	
	// Запрос по шапке документов
	Запрос = Новый Запрос;	
	Запрос.Текст =                      
	"ВЫБРАТЬ
	|	ПОДСТРОКА(ДокументыШапка.INFO, 1, 250) КАК ДополнительнаяИнформация,
	|	ПОДСТРОКА(ДокументыШапка.HEAD_RECIPIENT, 1, 100) КАК xmlОрганизацияGLN,
	|	ПОДСТРОКА(ДокументыШапка.HEAD_SENDER, 1, 100) КАК xmlКонтрагентGLN,
	|	ПОДСТРОКА(ДокументыШапка.HEAD_DELIVERYPLACE, 1, 100) КАК xmlТочкаДоставкиGLN,
	|	ДокументыШапка.RECADVDATE КАК УведОПриемеДата,
	|	ПОДСТРОКА(ДокументыШапка.RECADVNUMBER, 1, 100) КАК УведОПриемеНомер,
	|	ДокументыШапка.DESADVDATE КАК УведОбОтгрузкеДата,
	|	ПОДСТРОКА(ДокументыШапка.DESADVNUMBER, 1, 100) КАК УведОбОтгрузкеНомер,
	|	ДокументыШапка.ORDERDATE КАК ЗаказДата,
	|	ПОДСТРОКА(ДокументыШапка.ORDERNUMBER, 1, 100) КАК ЗаказНомер,
	|	ПОДСТРОКА(ДокументыШапка.ACTION, 1, 100) КАК ДействиеПоДокументу,
	|	ДокументыШапка.RETURNDATE КАК ДатаВозврата,
	|	ДокументыШапка.DATE КАК ФайлДата,
	|	ПОДСТРОКА(ДокументыШапка.NUMBER, 1, 100) КАК ФайлНомер,
	|	ДокументыШапка.ВидДокумента КАК ВидДокумента,
	|	ПОДСТРОКА(ДокументыШапка.ИдФайл, 1, 250) КАК ИдФайл
	|ПОМЕСТИТЬ ДокументыШапка
	|ИЗ
	|	&ДокументыШапка КАК ДокументыШапка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ЭКОМ_Документы.Ссылка, НЕОПРЕДЕЛЕНО) КАК ЭКОМДок,
	|	ЭКОМ_Документы.ПометкаУдаления КАК ПометкаУдаления,
	|	ЭКОМ_Документы.СтатусОбработкиДокумента КАК СтатусОбработкиДокумента,
	|	ЭКОМ_GLN_Организация.Объект КАК Организация,
	|	ЭКОМ_GLN_Контрагент.Объект КАК Контрагент,
	|	ЭКОМ_ТочкиДоставки.Объект КАК ТочкаДоставки,
	|	ДокументыШапка.ИдФайл КАК ИдФайл,
	|	ДокументыШапка.xmlОрганизацияGLN,
	|	ДокументыШапка.xmlКонтрагентGLN,
	|	ДокументыШапка.xmlТочкаДоставкиGLN,
	|	ДокументыШапка.УведОПриемеДата,
	|	ДокументыШапка.УведОПриемеНомер,
	|	ДокументыШапка.УведОбОтгрузкеДата,
	|	ДокументыШапка.УведОбОтгрузкеНомер,
	|	ДокументыШапка.ЗаказДата,
	|	ДокументыШапка.ЗаказНомер,
	|	ДокументыШапка.ДействиеПоДокументу,
	|	ДокументыШапка.ДатаВозврата,
	|	ДокументыШапка.ФайлДата,
	|	ДокументыШапка.ФайлНомер,
	|	ДокументыШапка.ВидДокумента,
	|	ДокументыШапка.ДополнительнаяИнформация
	|ИЗ
	|	ДокументыШапка КАК ДокументыШапка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭКОМ_Документы КАК ЭКОМ_Документы
	|		ПО ДокументыШапка.ФайлДата = ЭКОМ_Документы.ФайлДата
	|			И ДокументыШапка.ФайлНомер = ЭКОМ_Документы.ФайлНомер
	|			И ДокументыШапка.ВидДокумента = ЭКОМ_Документы.ВидДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Организация
	|		ПО ДокументыШапка.xmlОрганизацияGLN = ЭКОМ_GLN_Организация.GLN
	|			И (НЕ ЭКОМ_GLN_Организация.Объект ССЫЛКА Справочник.Контрагенты)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Контрагент
	|		ПО ДокументыШапка.xmlКонтрагентGLN = ЭКОМ_GLN_Контрагент.GLN
	|			И (ЭКОМ_GLN_Контрагент.Объект ССЫЛКА Справочник.Контрагенты)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_ТочкиДоставки КАК ЭКОМ_ТочкиДоставки
	|		ПО ДокументыШапка.xmlТочкаДоставкиGLN = ЭКОМ_ТочкиДоставки.GLN";
	
	Запрос.УстановитьПараметр("ДокументыШапка", ДокументыШапка);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ПроверкаНаДублирование = Новый Соответствие;
	
	СоответствиеПоОрганизации      = Новый Соответствие;
	СоответствиеПоКонтрагенту      = Новый Соответствие;
	СоответствиеПоТочкамДоставки   = Новый Соответствие;
	СоответствиеПоНоменклатуре     = Новый Соответствие;
	
	Пользователь = НайтиТекущегоПользователя();
	
	ИмяСобытия = "Создание документа Docrobot-RETINS";
	Пока Выборка.Следующий() Цикл
		
		// Для проверки дублирования строк
		Если ПроверкаНаДублирование.Получить(Выборка.ИдФайл) = Неопределено Тогда
			ПроверкаНаДублирование.Вставить(Выборка.ИдФайл, "Строка добавлена");
		Иначе
			ТекстЛогаСобытий = "Дубль данных, проверьте GLN организации, контрагента, точки доставки ИД документа - " + Выборка.ИдФайл;	
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Продолжить;
			
		КонецЕсли;
		
		// Получаем структуру документа
		пСтруктураДокумента = Неопределено;
		СтрокаТЗСтруктур = ТЗСтруктур.Найти(Выборка.ИдФайл, "ИдентификаторФайла");
		Если СтрокаТЗСтруктур = Неопределено Тогда			
			ТекстЛогаСобытий = "Не найдена структура документа с ИД = " + Выборка.ИдФайл;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Продолжить;
			
		Иначе
			
			пСтруктураДокумента = СтрокаТЗСтруктур.СтруктураДокумента;
			
		КонецЕсли;
		
		ПредставлениеДокументаXML = Строка(Выборка.ВидДокумента) + " № " + Выборка.ФайлНомер + " от " + Формат(Выборка.ФайлДата, "ДФ='dd.MM.yyyy ""г.""'");
		
		Если Выборка.ЭКОМДок = Неопределено Тогда
			ЭКОМДок = Документы.ЭКОМ_Документы.СоздатьДокумент();
		ИначеЕсли (Выборка.ПометкаУдаления = Истина 
			ИЛИ Выборка.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.НеОбработан) Тогда
			ЭКОМДок = Выборка.ЭКОМДок.ПолучитьОбъект();
			ЭКОМДок.ПометкаУдаления = ЛОЖЬ;
			ЭКОМДок.ТЧ_Товары.Очистить();
			// Очищение остальных табличных частей документов в гибких настроках при необходимости
			
		Иначе
			ТекстЛогаСобытий = ПредставлениеДокументаXML +  " - ЭКОМ документ уже существует в 1С, номер = " + Выборка.ЭКОМДок.Номер + " от " + Выборка.ЭКОМДок.Дата;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Продолжить;
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Выборка.Организация) Тогда
			СоответствиеПоОрганизации.Вставить("Организация_" + Выборка.xmlОрганизацияGLN, Выборка.xmlОрганизацияGLN);	
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Выборка.Контрагент) Тогда
			СоответствиеПоКонтрагенту.Вставить("Контрагент_" + Выборка.xmlКонтрагентGLN, Выборка.xmlКонтрагентGLN);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Выборка.ТочкаДоставки) Тогда
			СоответствиеПоТочкамДоставки.Вставить("ТочкаДоставки_" + Выборка.xmlТочкаДоставкиGLN, Выборка.xmlТочкаДоставкиGLN);
		КонецЕсли;
		
		// Шапка
		ЭКОМДок.Организация               = Выборка.Организация;
		ЭКОМДок.xmlОрганизация            = Выборка.xmlОрганизацияGLN;
		ЭКОМДок.ВидДокумента              = Выборка.ВидДокумента;
		ЭКОМДок.Контрагент                = Выборка.Контрагент;
		ЭКОМДок.xmlКонтрагент             = Выборка.xmlКонтрагентGLN;
		ЭКОМДок.Дата                      = ТекущаяДата();
		ЭКОМДок.ЗаказНомер                = Выборка.ЗаказНомер;
		ЭКОМДок.ЗаказДата                 = Выборка.ЗаказДата;
		ЭКОМДок.ИмяФайла                  = СтрокаТЗСтруктур.ИмяФайлаXML;		
		ЭКОМДок.ТочкаДоставки             = Выборка.ТочкаДоставки;
		ЭКОМДок.xmlТочкаДоставки          = Выборка.xmlТочкаДоставкиGLN;
		ЭКОМДок.ИнформацияПоДокументу     = Выборка.ДополнительнаяИнформация;
		ЭКОМДок.Ответственный             = Пользователь;
		ЭКОМДок.ФайлНомер                 = Выборка.ФайлНомер;
		ЭКОМДок.ФайлДата                  = Выборка.ФайлДата;
		ЭКОМДок.ДатаПоставки              = Выборка.ДатаВозврата;
		ЭКОМДок.УточнениеОПоставке        = Выборка.ДействиеПоДокументу;
		ЭКОМДок.НакладнаяДата             = Выборка.УведОбОтгрузкеДата;
		ЭКОМДок.НакладнаяНомер            = Выборка.УведОбОтгрузкеНомер;
		ЭКОМДок.СЧФНомер                  = Выборка.УведОПриемеНомер;
		ЭКОМДок.СЧФДата                   = Выборка.УведОПриемеДата;
		
		// ТЧ товары
		xmlВалюта            = "RUB";
		лСумма_Всего         = 0;
		лСумма_НДС_Всего     = 0;
		ТекстОшибки          = "";
		ПроверкаНаДублированиеТЧ = Новый Соответствие;
		
		Отбор = Новый Структура();
		Отбор.Вставить("ИдентификаторФайла", Выборка.ИдФайл);
		МассивСтрок = ДокументыТабличнаяЧасть.НайтиСтроки(Отбор);
		
		Для Каждого СтруктСтрока Из МассивСтрок Цикл	
			
			Если ЗначениеЗаполнено(СтруктСтрока.xmlВалюта) Тогда
				xmlВалюта = СтруктСтрока.xmlВалюта;
			КонецЕсли;
			
			СоставнойШтрихКод = СокрЛП(СтруктСтрока.НомерСтрокиТЧ) + "_" + СокрЛП(СтруктСтрока.ШтрихКод);
			Если ЗначениеЗаполнено(СтруктСтрока.ШтрихКод) Тогда
				Если ПроверкаНаДублированиеТЧ.Получить(СоставнойШтрихКод) = Неопределено Тогда
					ПроверкаНаДублированиеТЧ.Вставить(СоставнойШтрихКод, "Строка добавлена");
				Иначе
					
					ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
					+ "Дубль данных, проверьте номенклатуру - " + СтруктСтрока.ШтрихКод + ", строка - " + СокрЛП(СтруктСтрока.НомерСтрокиТЧ);
					
					Продолжить;
					
				КонецЕсли;		
			КонецЕсли;
			
			Номенклатура     = СтруктСтрока.Номенклатура; 
			ЕдиницаИзмерения = СтруктСтрока.ЕдиницаИзмерения;
			
			Если НЕ ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда			 							
				ЕдиницаИзмерения = СтруктСтрока.ЕдиницаИзмеренияПоУмолчанию;			
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Номенклатура) 
				И ЗначениеЗаполнено(Выборка.Контрагент) Тогда
				Код = ?(ЗначениеЗаполнено(СтруктСтрока.ШтрихКод), СтруктСтрока.ШтрихКод, СтруктСтрока.КодПокупателя) + "_" + ЭКОМДок.xmlКонтрагент;
				СоответствиеПоНоменклатуре.Вставить("АртикулНоменклатурыКонтрагента_"      + Код, СтруктСтрока.КодПоставщика); // PRODUCTIDSUPPLIER
				СоответствиеПоНоменклатуре.Вставить("КодНоменклатурыКонтрагента_"          + Код, СтруктСтрока.КодПокупателя); // PRODUCTIDBUYER
				СоответствиеПоНоменклатуре.Вставить("ШтрихКодНоменклатурыКонтрагента_"     + Код, СтруктСтрока.ШтрихКод);      // PRODUCT
				СоответствиеПоНоменклатуре.Вставить("ЕдиницаНоменклатурыКонтрагента_"      + Код, ЕдиницаИзмерения);
				СоответствиеПоНоменклатуре.Вставить("Контрагент_"                          + Код, Выборка.Контрагент);
				СоответствиеПоНоменклатуре.Вставить("xmlЕдиницаИзмерения_"                 + Код, СтруктСтрока.xmlЕдиницаИзмерения); // Информация при выборе ед. измерения из справочника
			КонецЕсли;
			
			ЦенаБезНДС = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.Цена);
			ЦенаСНДС   = 0;
			
			СтавкаНДСДок = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.СтавкаНДС);
			Если НЕ ЗначениеЗаполнено(СтавкаНДСДок) Тогда
				Если ЦенаБезНДС <> ЦенаСНДС	
					И ЦенаБезНДС <> 0
					И ЦенаСНДС   <> 0 Тогда
					СтавкаНДСДок = Окр(((ЦенаСНДС - ЦенаБезНДС) / ЦенаБезНДС) * 100);
				Иначе
					СтавкаНДСДок = 0;
				КонецЕсли;		
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтруктСтрока.ВозвращенноеКоличество) Тогда
				знКоличество = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.ВозвращенноеКоличество);	
			Иначе
				знКоличество = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.ДоставленноеКоличество);
			КонецЕсли;
			СуммаСНДС = ЦенаСНДС * знКоличество;
			
			Если ЦенаБезНДС = 0 Тогда
				Если (СуммаСНДС > 0) И (знКоличество > 0) Тогда
					ЦенаСНДС      = Окр(СуммаСНДС/знКоличество, 4);			
					ЦенаБезНДС    = Окр( (ЦенаСНДС * 100) / (100 + СтавкаНДСДок) , 4);
				КонецЕсли;
			КонецЕсли;
			
			Если ЦенаСНДС = 0 Тогда
				ЦенаСНДС  = Окр( (ЦенаБезНДС * (100 + СтавкаНДСДок)) / 100 , 4);
				СуммаСНДС = ЦенаСНДС * знКоличество;
			КонецЕсли;	
			
			лСуммаБезНДС = ЦенаБезНДС * знКоличество;		
			Если лСуммаБезНДС = 0 Тогда
				Если (СуммаСНДС > 0) Тогда 
					лСуммаБезНДС = Окр( (СуммаСНДС * 100) / (100 + СтавкаНДСДок) , 4);	
				КонецЕсли;
			КонецЕсли;
			
			Если СуммаСНДС = 0 И СтавкаНДСДок <> 0 Тогда
				СуммаСНДС = Окр((лСуммаБезНДС * (100 + СтавкаНДСДок)) / 100 , 2);
			КонецЕсли;
			
			лСумма_НДС = Окр(лСуммаБезНДС * (СтавкаНДСДок/100), 4);	
			//лСумма_НДС = лСуммаСНДС - лСуммаБезНДС;	  
			
			НовСтрока                         = ЭКОМДок.ТЧ_Товары.Добавить();
			НовСтрока.Номенклатура            = Номенклатура;
			НовСтрока.ЕдиницаИзмерения        = ЕдиницаИзмерения;
			НовСтрока.xmlЕдиницаИзмерения     = СтруктСтрока.xmlЕдиницаИзмерения;
			НовСтрока.Цена                    = ЦенаБезНДС;
			НовСтрока.ЦенаСНДС                = ЦенаСНДС;
			НовСтрока.ОписаниеПродукта        = СтруктСтрока.ОписаниеПричины;
			НовСтрока.КоличествоПринятое      = СтруктСтрока.ВозвращенноеКоличество;
			НовСтрока.КоличествоПоставляемое  = СтруктСтрока.ДоставленноеКоличество;
			НовСтрока.Сумма                   = лСуммаБезНДС;
			НовСтрока.СтавкаНДС               = СтавкаНДСДок;
			НовСтрока.СуммаНДС                = лСумма_НДС;
			НовСтрока.Сумма_с_НДС             = СуммаСНДС;
			НовСтрока.НомерПродукта           = СтруктСтрока.ШтрихКод;
			НовСтрока.НомерПродуктаПокупателя = СтруктСтрока.КодПокупателя;
			НовСтрока.УточнениеОПоставке      = СтруктСтрока.ДействиеПоДокументу;
			
			лСумма_НДС_Всего     = лСумма_НДС_Всего + лСумма_НДС;
			лСумма_Всего         = лСумма_Всего + лСуммаБезНДС + лСумма_НДС;		
		КонецЦикла;
		
		ЭКОМДок.СуммаДокументаВсего = лСумма_Всего;
		ЭКОМДок.СуммаНДСВсего       = лСумма_НДС_Всего;
		ЭКОМДок.xmlВалюта           = xmlВалюта;
		
		ЭКОМДок.ТекстОшибки = ""; // Очищаем ошибки документа
		ЭКОМДок.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.ПустаяСсылка(); // Обнуляем статус документ
		
		ВыполнитьДополнительныеДействия(ЭКОМДок, "Входящий RETINS (инструкция о возврате)", пСтруктураДокумента, МассивЛогаСобытий, ТекстОшибки, 
		СоответствиеПоОрганизации,
		СоответствиеПоКонтрагенту,
		СоответствиеПоТочкамДоставки,
		СоответствиеПоНоменклатуре,
		КэшированныеЗначения);
				
		ЭКОМДок.ТЧ_Товары.Сортировать("НомерСтрокиXML Возр");
		
		// По умолчанию документ загружается и записывается, если ЭКОМ документ не нужен в гибких настройках необходимо поставить НеЗагружатьДокумент = Истина 
		Если ЭКОМДок.НеЗагружатьДокумент = Ложь Тогда
			
			СтруктураРегистраСобытий = Новый Структура; 
			СтруктураРегистраСобытий.Вставить("ДатаЗаписи"                  , ТекущаяДата());
			СтруктураРегистраСобытий.Вставить("Контрагент"                  , ЭКОМДок.Контрагент);
			СтруктураРегистраСобытий.Вставить("Организация"                 , ЭКОМДок.Организация);
			СтруктураРегистраСобытий.Вставить("НаправлениеОбмена"           , Перечисления.ЭКОМ_НаправлениеОбмена.Входящий);
			СтруктураРегистраСобытий.Вставить("ФайлИмя"                     , СтрокаТЗСтруктур.ИмяФайлаXML);
			СтруктураРегистраСобытий.Вставить("ЗаказДата"                   , ЭКОМДок.ЗаказДата);					
			СтруктураРегистраСобытий.Вставить("ЗаказНомер"                  , ЭКОМДок.ЗаказНомер);
			СтруктураРегистраСобытий.Вставить("СтруктураФайла"              , Новый ХранилищеЗначения(пСтруктураДокумента,  Новый СжатиеДанных(9)));
			СтруктураРегистраСобытий.Вставить("Идентификатор"               , пСтруктураДокумента.ИдФайл);
			
			Н = 1;
			
			Для Каждого Стр Из ЭКОМДок.ТЧ_Товары Цикл			
				// Проверка заполнения документа
				Если НЕ ЗначениеЗаполнено(Стр.ЕдиницаИзмерения) Тогда	
					ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "") 
					+ "В строке № " + Н + " " + "не заполнена единица измерения. (смотрите гибкие настройки или регистр сведений ЭКОМ_НоменклатураКонтрагентов)" 
					+ "(" + Стр.xmlЕдиницаИзмерения + ")"; 
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(Стр.Номенклатура) Тогда
					ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
					+ "В строке № " + Н + " " + "не заполнена номенклатура." 
					+ "(" + Стр.НомерПродукта + ")";
				КонецЕсли;
				
				Н = Н + 1;	
			КонецЦикла;
			
			Если НЕ ЗначениеЗаполнено(ЭКОМДок.Организация) Тогда
				ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
				+ "Не заполнена организация." + "(" + ЭКОМДок.xmlОрганизация + ")"; 
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ЭКОМДок.Контрагент) Тогда
				ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
				+ "Не заполнен контрагент." + "(" + ЭКОМДок.xmlКонтрагент + ")";
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ЭКОМДок.ТочкаДоставки) Тогда
				ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
				+ "Не заполнена точка доставки." + "(" + ЭКОМДок.xmlТочкаДоставки + ")";
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ЭКОМДок.Валюта) Тогда
				ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
				+ "Не заполнена валюта." + "(" + ЭКОМДок.xmlВалюта + ")";
			КонецЕсли;
			
			ДокументОбработан = ПроверитьОбработкуДокумента(ТекстОшибки, ЭКОМДок, пСтруктураДокумента, СтруктураРегистраСобытий, ПредставлениеДокументаXML, МассивЛогаСобытий);
			Если ДокументОбработан = Ложь Тогда
				Продолжить;			
			КонецЕсли;
			
		Иначе 			
			пСтруктураДокумента.Вставить("Обработан", Ложь);
			ТекстЛогаСобытий = "В гибких настройках указано не загружать документ - " + ПредставлениеДокументаXML;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
		КонецЕсли;	
	КонецЦикла;
	
	Если НЕ СоответствиеПоОрганизации.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоОрганизации     , "Организация_");
	КонецЕсли;
	Если НЕ СоответствиеПоКонтрагенту.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоКонтрагенту     , "Контрагент_");
	КонецЕсли;
	Если НЕ СоответствиеПоТочкамДоставки.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоТочкамДоставки  , "ТочкаДоставки_");
	КонецЕсли;
	Если НЕ СоответствиеПоНоменклатуре.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоНоменклатуре    , "Номенклатура_");
	КонецЕсли;
	
КонецПроцедуры

// Подходит для ON_NSCHFDOPPRPROS, ON_NSCHFDOPPRMARK 
Процедура СоздатьЭКОМ_ДокЮЗД_ON_NSCHFDOPPR(ТЗСтруктур, ДокументыШапка, пДокументыТабличнаяЧасть, МассивЛогаСобытий) Экспорт	
	
	// Для исправительной УПД
	ВидыДокументовЮЗД = Новый Массив;
	Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьПервичныеВидыДокументовЮЗД(ВидыДокументовЮЗД);");
	
	КэшированныеЗначения = Неопределено;
	
	// Табличная часть заполняется в гибких настройках
	
	// Индентификатор отправителя и получателя берем с 3 символа чтобы убрать префикс оператора 
	// Запрос по шапке документов
	Запрос = Новый Запрос;	
	Запрос.Текст =                                  
	"ВЫБРАТЬ
	|	ДокументыШапка.Документ_СвСчФакт_ДатаСчФ КАК СчФ_Дата,
	|	ПОДСТРОКА(ДокументыШапка.Документ_СвСчФакт_НомерСчФ, 1, 100) КАК СчФ_Номер,
	|	ПОДСТРОКА(ДокументыШапка.Документ_СвСчФакт_ИспрСчФ_НомИспрСчФ, 1, 100) КАК НомИспрСчФ,
	|	ДокументыШапка.ВидДокумента КАК ВидДокумента,
	|	ПОДСТРОКА(ДокументыШапка.ИдФайл, 1, 256) КАК ИдФайл,
	|	ПОДСТРОКА(ДокументыШапка.СвУчДокОбор_ИдПол, 4, 256) КАК ИдентификаторОрганизации,
	|	ПОДСТРОКА(ДокументыШапка.СвУчДокОбор_ИдОтпр, 4, 256) КАК ИдентификаторКонтрагента,
	|	ДокументыШапка.ДатаПринятияДокумента КАК ДатаПринятияДокумента
	|ПОМЕСТИТЬ ДокументыШапка
	|ИЗ
	|	&ДокументыШапка КАК ДокументыШапка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДокументыШапка.ИдФайл КАК ИдФайл,
	|	ЕСТЬNULL(ЭКОМ_ДокументСуществующий.Ссылка, НЕОПРЕДЕЛЕНО) КАК ЭКОМДок,
	|	ЭКОМ_ДокументСуществующий.ПометкаУдаления КАК ПометкаУдаления,
	|	ЭКОМ_ДокументСуществующий.СтатусОбработкиДокумента КАК СтатусОбработкиДокумента,
	|	ЭКОМ_GLN_Организация.Объект КАК Организация,
	|	ЭКОМ_GLN_Контрагент.Объект КАК Контрагент,
	|	ДокументыШапка.СчФ_Дата КАК СчФ_Дата,
	|	ДокументыШапка.СчФ_Номер КАК СчФ_Номер,
	|	ДокументыШапка.ВидДокумента КАК ВидДокумента,
	|	ДокументыШапка.ИдентификаторКонтрагента КАК ИдентификаторКонтрагента,
	|	ЕСТЬNULL(КОЛИЧЕСТВО(ЭКОМ_ДокументыПовторный.Ссылка), 0) КАК КоличествоЭКОМДокПовторных,
	|	ДокументыШапка.НомИспрСчФ КАК НомИспрСчФ,
	|	ЕСТЬNULL(ЭКОМ_ДокументПервичный.Ссылка, НЕОПРЕДЕЛЕНО) КАК ЭКОМДокОснование
	|ИЗ
	|	ДокументыШапка КАК ДокументыШапка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭКОМ_Документы КАК ЭКОМ_ДокументСуществующий
	|		ПО ДокументыШапка.СчФ_Дата = ЭКОМ_ДокументСуществующий.СЧФДата
	|			И ДокументыШапка.СчФ_Номер = ЭКОМ_ДокументСуществующий.СЧФНомер
	|			И ДокументыШапка.ВидДокумента = ЭКОМ_ДокументСуществующий.ВидДокумента
	|			И ДокументыШапка.ИдФайл = ЭКОМ_ДокументСуществующий.НомерТранзакции
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Организация
	|		ПО ДокументыШапка.ИдентификаторОрганизации = ЭКОМ_GLN_Организация.Ид_ОЭД
	|			И (НЕ ЭКОМ_GLN_Организация.Объект ССЫЛКА Справочник.Контрагенты)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Контрагент
	|		ПО ДокументыШапка.ИдентификаторКонтрагента = ЭКОМ_GLN_Контрагент.Ид_ОЭД
	|			И (ЭКОМ_GLN_Контрагент.Объект ССЫЛКА Справочник.Контрагенты)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭКОМ_Документы КАК ЭКОМ_ДокументыПовторный
	|		ПО ДокументыШапка.СчФ_Дата = ЭКОМ_ДокументыПовторный.СЧФДата
	|			И ДокументыШапка.СчФ_Номер = ЭКОМ_ДокументыПовторный.СЧФНомер
	|			И (ДокументыШапка.ИдентификаторОрганизации = ПОДСТРОКА(ЭКОМ_ДокументыПовторный.xmlОрганизация, 4, 256))
	|			И (ДокументыШапка.ИдентификаторКонтрагента = ПОДСТРОКА(ЭКОМ_ДокументыПовторный.xmlКонтрагент, 4, 256))
	|			И (НЕ ЭКОМ_ДокументыПовторный.ПометкаУдаления)
	|			И ДокументыШапка.ВидДокумента = ЭКОМ_ДокументыПовторный.ВидДокумента
	|			И ДокументыШапка.НомИспрСчФ = ЭКОМ_ДокументыПовторный.НомерИсправления
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭКОМ_Документы КАК ЭКОМ_ДокументПервичный
	|		ПО ДокументыШапка.СчФ_Дата = ЭКОМ_ДокументПервичный.СЧФДата
	|			И ДокументыШапка.СчФ_Номер = ЭКОМ_ДокументПервичный.СЧФНомер
	|			И (ДокументыШапка.ИдентификаторОрганизации = ПОДСТРОКА(ЭКОМ_ДокументПервичный.xmlОрганизация, 4, 256))
	|			И (ДокументыШапка.ИдентификаторКонтрагента = ПОДСТРОКА(ЭКОМ_ДокументПервичный.xmlКонтрагент, 4, 256))
	|			И (НЕ ЭКОМ_ДокументПервичный.ПометкаУдаления)
	|			И (НЕ ДокументыШапка.ИдФайл = ЭКОМ_ДокументПервичный.НомерТранзакции)
	|			И ДокументыШапка.ДатаПринятияДокумента > ЭКОМ_ДокументПервичный.ДатаПринятияДокумента
	|			И (ЭКОМ_ДокументПервичный.ВидДокумента В (&ВидыДокументовЮЗД))
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕСТЬNULL(ЭКОМ_ДокументСуществующий.Ссылка, НЕОПРЕДЕЛЕНО),
	|	ЭКОМ_ДокументСуществующий.ПометкаУдаления,
	|	ЭКОМ_GLN_Организация.Объект,
	|	ДокументыШапка.ИдФайл,
	|	ДокументыШапка.СчФ_Дата,
	|	ДокументыШапка.ВидДокумента,
	|	ЭКОМ_GLN_Контрагент.Объект,
	|	ДокументыШапка.СчФ_Номер,
	|	ЭКОМ_ДокументСуществующий.СтатусОбработкиДокумента,
	|	ДокументыШапка.ИдентификаторКонтрагента,
	|	ДокументыШапка.НомИспрСчФ,
	|	ЕСТЬNULL(ЭКОМ_ДокументПервичный.Ссылка, НЕОПРЕДЕЛЕНО)";
	
	Запрос.УстановитьПараметр("ДокументыШапка", ДокументыШапка);
	Запрос.УстановитьПараметр("ВидыДокументовЮЗД", ВидыДокументовЮЗД);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ПроверкаНаПовтор       = Новый Соответствие; // В случае если поставщик отправит несколько одинаковых ЮЗД с одним и тем же номером и датой
	ПроверкаНаДублирование = Новый Соответствие;
	
	Пользователь = НайтиТекущегоПользователя();
	
	ИмяСобытия = "Создание документа Docrobot-ЮЗД";
	Пока Выборка.Следующий() Цикл
		
		// Для проверки дублирования строк
		Если ПроверкаНаДублирование.Получить(Выборка.ИдФайл) = Неопределено Тогда
			ПроверкаНаДублирование.Вставить(Выборка.ИдФайл, "Строка добавлена");
		Иначе
			ТекстЛогаСобытий = "Дубль данных, проверьте GLN организации, контрагента, точки доставки ИД документа - " + Выборка.ИдФайл + ". Документ не обработан.";
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Продолжить;
			
		КонецЕсли;
		
		// Получаем структуру документа
		пСтруктураДокумента = Неопределено;
		СтрокаТЗСтруктур = ТЗСтруктур.Найти(Выборка.ИдФайл, "ИдентификаторФайла");
		Если СтрокаТЗСтруктур = Неопределено Тогда			
			ТекстЛогаСобытий = "Не найдена структура документа с ИД = " + Выборка.ИдФайл + ". Документ не обработан.";
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Продолжить;
			
		Иначе			
			пСтруктураДокумента = СтрокаТЗСтруктур.СтруктураДокумента;
			
		КонецЕсли;
		
		ПредставлениеДокументаXML = Строка(пСтруктураДокумента.ВидДокумента) + " № " + пСтруктураДокумента.Документ_СвСчФакт_НомерСчФ 
		+ " от " + Формат(пСтруктураДокумента.Документ_СвСчФакт_ДатаСчФ, "ДФ='dd.MM.yyyy ""г.""'");
		
		Если Выборка.ЭКОМДок = Неопределено Тогда
			ЭКОМДок = Документы.ЭКОМ_Документы.СоздатьДокумент();
		ИначеЕсли (Выборка.ПометкаУдаления = Истина 
			ИЛИ Выборка.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.НеОбработан) Тогда
			ЭКОМДок = Выборка.ЭКОМДок.ПолучитьОбъект();
			ЭКОМДок.ПометкаУдаления = ЛОЖЬ;
			ЭКОМДок.ТЧ_Товары.Очистить();
			ЭКОМДок.ТЧ_Уточнение.Очистить();
			ЭКОМДок.ДокументыСвязанные.Очистить();
			ЭКОМДок.ТЧ_Маркировка.Очистить();
			ЭКОМДок.Комментарий = "";
		Иначе
			ТекстЛогаСобытий = ПредставлениеДокументаXML + " - ЭКОМ документ уже существует в 1С, номер = " + Выборка.ЭКОМДок.Номер + " от " + Выборка.ЭКОМДок.Дата;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Продолжить;
			
		КонецЕсли;
		
		// Для проверки повтора 
		// 1 случай - когда грузим впервые (ЭКОМ документы еще не созданы)
		КлючПовтора = Строка(Выборка.ВидДокумента) + Выборка.ИдентификаторКонтрагента + Строка(Выборка.НомИспрСчФ) + Строка(Выборка.СчФ_Номер) + Строка(Выборка.СчФ_Дата);
		Если ПроверкаНаПовтор.Получить(КлючПовтора) = Неопределено Тогда
			ПроверкаНаПовтор.Вставить(КлючПовтора, "Строка добавлена");					
		Иначе
			
			Если ЭКОМДок.ЭтоПовторныйДокумент = Истина 
				ИЛИ ЭКОМДок.ЭтоНовый() = Истина Тогда // Признак документа повторный или это новый ЭКОМ документ 				 
				
				ЭКОМДок.ЭтоПовторныйДокумент = Истина;
				
			КонецЕсли;	
			
		КонецЕсли;
		
		// Для проверки повтора 
		// 2 случай - когда повторный документ пришел позже
		Если Выборка.КоличествоЭКОМДокПовторных > 0 
			И (ЭКОМДок.ЭтоПовторныйДокумент = Истина 
			ИЛИ ЭКОМДок.ЭтоНовый() = Истина) Тогда // Есть повторные ЭКОМ документы 			 
			
			ЭКОМДок.ЭтоПовторныйДокумент = Истина;	
			
		КонецЕсли;
		
		// Основные ИнфПолФХЖ1
		СоответствиеИнфПолФХЖ1 = Новый Соответствие;
		СоответствиеИнфПолФХЖ1.Вставить("отправитель"                  , "");
		СоответствиеИнфПолФХЖ1.Вставить("получатель"                   , "");
		СоответствиеИнфПолФХЖ1.Вставить("грузополучатель"              , "");
		СоответствиеИнфПолФХЖ1.Вставить("дата_поставки"                , Дата(0001, 01, 01));
		СоответствиеИнфПолФХЖ1.Вставить("дата_заказа"                  , Дата(0001, 01, 01));
		СоответствиеИнфПолФХЖ1.Вставить("номер_заказа"                 , "");
		СоответствиеИнфПолФХЖ1.Вставить("номер_акта"                   , "");
		СоответствиеИнфПолФХЖ1.Вставить("дата_акта"                    , Дата(0001, 01, 01));
		СоответствиеИнфПолФХЖ1.Вставить("номер_накладной"              , "");
		СоответствиеИнфПолФХЖ1.Вставить("дата_накладной"               , Дата(0001, 01, 01));
		СоответствиеИнфПолФХЖ1.Вставить("номер_уведомления_об_отгрузке", "");
		СоответствиеИнфПолФХЖ1.Вставить("дата_уведомления_об_отгрузке" , Дата(0001, 01, 01));
		СоответствиеИнфПолФХЖ1.Вставить("код_поставщика"               , "");
		
		Если пСтруктураДокумента.Свойство("Документ_СвСчФакт_ИнфПолФХЖ1_ТекстИнф_") Тогда
			Для каждого ЭлСтруктура Из пСтруктураДокумента.Документ_СвСчФакт_ИнфПолФХЖ1_ТекстИнф_ Цикл
				
				Если НЕ СоответствиеИнфПолФХЖ1.Получить(ЭлСтруктура.Документ_СвСчФакт_ИнфПолФХЖ1_ТекстИнф_Идентиф) = Неопределено Тогда
					СоответствиеИнфПолФХЖ1[ЭлСтруктура.Документ_СвСчФакт_ИнфПолФХЖ1_ТекстИнф_Идентиф] = ЭлСтруктура.Документ_СвСчФакт_ИнфПолФХЖ1_ТекстИнф_Значен;		
				КонецЕсли;
				
			КонецЦикла;		
		КонецЕсли;
		
		// Одна строка
		Если пСтруктураДокумента.Свойство("Документ_СвСчФакт_ИнфПолФХЖ1_ТекстИнф_Идентиф") Тогда		
			Если НЕ СоответствиеИнфПолФХЖ1.Получить(пСтруктураДокумента.Документ_СвСчФакт_ИнфПолФХЖ1_ТекстИнф_Идентиф) = Неопределено Тогда
				СоответствиеИнфПолФХЖ1[пСтруктураДокумента.Документ_СвСчФакт_ИнфПолФХЖ1_ТекстИнф_Идентиф] = пСтруктураДокумента.Документ_СвСчФакт_ИнфПолФХЖ1_ТекстИнф_Значен;		
			КонецЕсли;
		КонецЕсли;
		
		// Шапка
		
		Если ЗначениеЗаполнено(Выборка.НомИспрСчФ) Тогда
			ЭКОМДок.НомерИсправления = пСтруктураДокумента.Документ_СвСчФакт_ИспрСчФ_НомИспрСчФ;
			ЭКОМДок.ДатаИсправления  = пСтруктураДокумента.Документ_СвСчФакт_ИспрСчФ_ДатаИспрСчФ;
		КонецЕсли;
		
		Если пСтруктураДокумента.Свойство("Документ_СвПродПер_СвПер_ТранГруз_ТранНакл_ДатаТранНакл") Тогда
			НакладнаяДата = пСтруктураДокумента.Документ_СвПродПер_СвПер_ТранГруз_ТранНакл_ДатаТранНакл;
		Иначе
			НакладнаяДата = ДатаИзXML_в_1С(СоответствиеИнфПолФХЖ1["дата_накладной"]);
		КонецЕсли;
		
		Если пСтруктураДокумента.Свойство("Документ_СвПродПер_СвПер_ТранГруз_ТранНакл_НомТранНакл") Тогда
			НакладнаяНомер = пСтруктураДокумента.Документ_СвПродПер_СвПер_ТранГруз_ТранНакл_НомТранНакл;
		Иначе
			НакладнаяНомер = СоответствиеИнфПолФХЖ1["номер_накладной"];	
		КонецЕсли;
		
		ЭКОМДок.Организация               = Выборка.Организация;
		ЭКОМДок.ДатаПринятияДокумента     = пСтруктураДокумента.ДатаПринятияДокумента;
		ЭКОМДок.xmlОрганизация            = пСтруктураДокумента.СвУчДокОбор_ИдПол;
		ЭКОМДок.ВидДокумента              = пСтруктураДокумента.ВидДокумента;
		ЭКОМДок.Контрагент                = Выборка.Контрагент;
		ЭКОМДок.xmlКонтрагент             = пСтруктураДокумента.СвУчДокОбор_ИдОтпр;
		ЭКОМДок.Дата                      = ТекущаяДата();
		ЭКОМДок.ЗаказНомер                = СоответствиеИнфПолФХЖ1["номер_заказа"];
		ЭКОМДок.ЗаказДата                 = ДатаИзXML_в_1С(СоответствиеИнфПолФХЖ1["дата_заказа"]);
		ЭКОМДок.ИмяФайла                  = СтрокаТЗСтруктур.ИмяФайлаXML;		
		ЭКОМДок.xmlТочкаДоставки          = СоответствиеИнфПолФХЖ1["грузополучатель"];
		ЭКОМДок.Ответственный             = Пользователь;
		ЭКОМДок.ДатаПоставки              = СоответствиеИнфПолФХЖ1["дата_поставки"];
		ЭКОМДок.НакладнаяДата             = НакладнаяДата;
		ЭКОМДок.НакладнаяНомер            = НакладнаяНомер;
		
		ЭКОМДок.СЧФНомер                  = пСтруктураДокумента.Документ_СвСчФакт_НомерСчФ;
		ЭКОМДок.СЧФДата                   = пСтруктураДокумента.Документ_СвСчФакт_ДатаСчФ;
		ЭКОМДок.ТипДокумента              = пСтруктураДокумента.Документ_Функция; 
		ЭКОМДок.Версия                    = пСтруктураДокумента.ВерсПрог;
		ЭКОМДок.НомерТранзакции           = пСтруктураДокумента.ИдФайл;
		ЭКОМДок.xmlВалюта                 = пСтруктураДокумента.Документ_СвСчФакт_КодОКВ;
		ЭКОМДок.ФайлНомер                 = пСтруктураДокумента.Документ_СвСчФакт_НомерСчФ;
		ЭКОМДок.ФайлДата                  = пСтруктураДокумента.Документ_СвСчФакт_ДатаСчФ;	
		
		// ТЧ товары
		СуммаБезНДСВсего   = 0;
		СуммаНДСВсего      = 0;
		ДанныеПоМаркировке = Новый Массив;
		
		Для Каждого СтруктСтрока Из пСтруктураДокумента.ДокументТЧ Цикл
			
			// Основные ИнфПолФХЖ2
			СоответствиеИнфПолФХЖ2 = Новый Соответствие;
			СоответствиеИнфПолФХЖ2.Вставить("дата_заказа"                  , Дата(0001, 01, 01));
			СоответствиеИнфПолФХЖ2.Вставить("номер_заказа"                 , "");
			СоответствиеИнфПолФХЖ2.Вставить("номер_акта"                   , "");
			СоответствиеИнфПолФХЖ2.Вставить("дата_акта"                    , Дата(0001, 01, 01));
			СоответствиеИнфПолФХЖ2.Вставить("номер_накладной"              , "");
			СоответствиеИнфПолФХЖ2.Вставить("дата_накладной"               , Дата(0001, 01, 01));
			СоответствиеИнфПолФХЖ2.Вставить("номер_уведомления_об_отгрузке", "");
			СоответствиеИнфПолФХЖ2.Вставить("дата_уведомления_об_отгрузке" , Дата(0001, 01, 01));
			СоответствиеИнфПолФХЖ2.Вставить("артикул_поставщика"           , "");
			СоответствиеИнфПолФХЖ2.Вставить("штрихкод"                     , "");
			СоответствиеИнфПолФХЖ2.Вставить("код_материала"                , "");
			
			Если СтруктСтрока.Свойство("Документ_ТаблСчФакт_СведТов_ИнфПолФХЖ2_") Тогда
				Для каждого ЭлСтруктура Из СтруктСтрока.Документ_ТаблСчФакт_СведТов_ИнфПолФХЖ2_ Цикл
					
					Если НЕ СоответствиеИнфПолФХЖ2.Получить(ЭлСтруктура.Документ_ТаблСчФакт_СведТов_ИнфПолФХЖ2_Идентиф) = Неопределено Тогда
						СоответствиеИнфПолФХЖ2[ЭлСтруктура.Документ_ТаблСчФакт_СведТов_ИнфПолФХЖ2_Идентиф] = ЭлСтруктура.Документ_ТаблСчФакт_СведТов_ИнфПолФХЖ2_Значен;		
					КонецЕсли;
					
				КонецЦикла;	
				
			ИначеЕсли СтруктСтрока.Свойство("Документ_ТаблСчФакт_СведТов_ИнфПолФХЖ2_Значен") Тогда
				 СоответствиеИнфПолФХЖ2[СтруктСтрока.Документ_ТаблСчФакт_СведТов_ИнфПолФХЖ2_Идентиф] = СтруктСтрока.Документ_ТаблСчФакт_СведТов_ИнфПолФХЖ2_Значен;		
			КонецЕсли;
	
			
			СтавкаНДС   = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.Документ_ТаблСчФакт_СведТов_НалСт);
			Количество  = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.Документ_ТаблСчФакт_СведТов_КолТов);	
			ЦенаБезНДС  = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.Документ_ТаблСчФакт_СведТов_ЦенаТов);
			СуммаСНДС   = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.Документ_ТаблСчФакт_СведТов_СтТовУчНал);
			СуммаБезНДС = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.Документ_ТаблСчФакт_СведТов_СтТовБезНДС);		 									
			СуммаНДС = СуммаСНДС - СуммаБезНДС;
			Если НЕ Количество = 0 Тогда
				ЦенаСНДС = Окр(СуммаСНДС/Количество, 11);
			Иначе	
				ЦенаСНДС = Окр(СуммаСНДС, 11);
			КонецЕсли;
			
			НовСтрока = ЭКОМДок.ТЧ_Товары.Добавить();
			НовСтрока.Цена        = ЦенаБезНДС;
			НовСтрока.ЦенаСНДС    = ЦенаСНДС;
			НовСтрока.Сумма       = СуммаБезНДС;
			НовСтрока.СтавкаНДС   = СтавкаНДС;
			НовСтрока.СуммаНДС    = СуммаНДС;
			НовСтрока.Сумма_с_НДС = СуммаСНДС;
			НовСтрока.КоличествоПоставляемое = Количество;
			
		    Штрихкод = СоответствиеИнфПолФХЖ2["штрихкод"];
			
			Если СтруктСтрока.Свойство("Документ_ТаблСчФакт_СведТов_ДопСведТов_КодТов") Тогда      
				НомерПродуктаПокупателя = СтруктСтрока.Документ_ТаблСчФакт_СведТов_ДопСведТов_КодТов; 
			Иначе 
				НомерПродуктаПокупателя = СоответствиеИнфПолФХЖ2["код_материала"]; 
			КонецЕсли;
			
			Если СтруктСтрока.Свойство("Документ_ТаблСчФакт_СведТов_ДопСведТов_НаимЕдИзм") И СтруктСтрока.Свойство("Документ_ТаблСчФакт_СведТов_ОКЕИ_Тов") Тогда
				НовСтрока.xmlЕдиницаИзмерения = СтруктСтрока.Документ_ТаблСчФакт_СведТов_ДопСведТов_НаимЕдИзм + "_" + СтруктСтрока.Документ_ТаблСчФакт_СведТов_ОКЕИ_Тов;
			КонецЕсли;
			
			НомерСтрокиXML   =  ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.Документ_ТаблСчФакт_СведТов_НомСтр);
			ОписаниеПродукта = СтруктСтрока.Документ_ТаблСчФакт_СведТов_НаимТов;
			
			НовСтрока.НомерПродукта           = Штрихкод;
			НовСтрока.НомерПродуктаПоставщика = СоответствиеИнфПолФХЖ2["артикул_поставщика"];
			НовСтрока.НомерПродуктаПокупателя = НомерПродуктаПокупателя;
			НовСтрока.ОписаниеПродукта        = ОписаниеПродукта;
			НовСтрока.НомерСтрокиXML          = НомерСтрокиXML;
			
			// Маркировка
			Если пСтруктураДокумента.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPRMARK_01 
				ИЛИ пСтруктураДокумента.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPRMARK_01_Испр Тогда
				
				// ИдентТрансУпак - Уникальный идентификатор транспортной упаковки - (КИТУ) Коды идентификации транспортной упаковки 
				// КИЗ            - Контрольный идентификационный знак - (КИ) Коды идентификации товаров в потребительской упаковке 
				// НомУпак        - Уникальный идентификатор вторичной (потребительской)/третичной (заводской, транспортной) упаковки - (КИГУ, КИН) Коды идентификации групповой упаковки: блоки, наборы, прочие групповые упаковки  
				
				// Несколько строк НомСредИдентТов
				Если СтруктСтрока.Свойство("Документ_ТаблСчФакт_СведТов_ДопСведТов_НомСредИдентТов_") Тогда
					
					Для каждого Стр_ Из СтруктСтрока.Документ_ТаблСчФакт_СведТов_ДопСведТов_НомСредИдентТов_ Цикл
						
						ИдентТрансУпак = "";
						КИЗ            = "";
						НомУпак        = "";
						
						Если Стр_.Свойство("Документ_ТаблСчФакт_СведТов_ДопСведТов_НомСредИдентТов_ИдентТрансУпак")  Тогда
							ИдентТрансУпак = Стр_.Документ_ТаблСчФакт_СведТов_ДопСведТов_НомСредИдентТов_ИдентТрансУпак;
						КонецЕсли;
						
						// Одна строка
						Если Стр_.Свойство("Документ_ТаблСчФакт_СведТов_ДопСведТов_НомСредИдентТов_КИЗ") Тогда
							КИЗ = Стр_.Документ_ТаблСчФакт_СведТов_ДопСведТов_НомСредИдентТов_КИЗ;
						КонецЕсли;
						// Несколько строк
						Если Стр_.Свойство("Документ_ТаблСчФакт_СведТов_ДопСведТов_НомСредИдентТов_КИЗ_") Тогда
							Для каждого Эл Из Стр_.Документ_ТаблСчФакт_СведТов_ДопСведТов_НомСредИдентТов_КИЗ_ Цикл													 
								
								Данные = Новый Структура;											
								Данные.Вставить("ОписаниеПродукта", ОписаниеПродукта);
								Данные.Вставить("НомерСтрокиXML"  , НомерСтрокиXML);
								Данные.Вставить("ИдентТрансУпак"  , ИдентТрансУпак);		
								Данные.Вставить("КИЗ"             , Эл);
								Данные.Вставить("НомУпак"         , "");
								
								ДанныеПоМаркировке.Добавить(Данные);
								
							КонецЦикла;
							ИдентТрансУпак = "";
						КонецЕсли;	
						
						// Одна строка
						Если Стр_.Свойство("Документ_ТаблСчФакт_СведТов_ДопСведТов_НомСредИдентТов_НомУпак") Тогда
							НомУпак = Стр_.Документ_ТаблСчФакт_СведТов_ДопСведТов_НомСредИдентТов_НомУпак;				
						КонецЕсли;
						// Несколько строк
						Если Стр_.Свойство("Документ_ТаблСчФакт_СведТов_ДопСведТов_НомСредИдентТов_НомУпак_") Тогда
							Для каждого Эл Из Стр_.Документ_ТаблСчФакт_СведТов_ДопСведТов_НомСредИдентТов_НомУпак_ Цикл													  
								
								Данные = Новый Структура;
								Данные.Вставить("ОписаниеПродукта", ОписаниеПродукта);
								Данные.Вставить("НомерСтрокиXML" , НомерСтрокиXML);
								Данные.Вставить("ИдентТрансУпак", ИдентТрансУпак);		
								Данные.Вставить("КИЗ"           , "");
								Данные.Вставить("НомУпак"       , Эл);
								
								ДанныеПоМаркировке.Добавить(Данные);
								
							КонецЦикла;	
							ИдентТрансУпак = "";
						КонецЕсли;
						
						Если ЗначениеЗаполнено(ИдентТрансУпак)
							ИЛИ ЗначениеЗаполнено(КИЗ) 
							ИЛИ ЗначениеЗаполнено(НомУпак) Тогда
							
							Данные = Новый Структура;
							Данные.Вставить("ОписаниеПродукта", ОписаниеПродукта);
							Данные.Вставить("НомерСтрокиXML"  , НомерСтрокиXML);
							Данные.Вставить("ИдентТрансУпак"  , ИдентТрансУпак);		
							Данные.Вставить("КИЗ"             , КИЗ);
							Данные.Вставить("НомУпак"         , НомУпак);
							
							ДанныеПоМаркировке.Добавить(Данные);
							
						КонецЕсли;
						
					КонецЦикла;	
					
					// Одна строка НомСредИдентТов
				Иначе
					
					ИдентТрансУпак = "";
					КИЗ            = "";
					НомУпак        = "";
					
					Если СтруктСтрока.Свойство("Документ_ТаблСчФакт_СведТов_ДопСведТов_НомСредИдентТов_ИдентТрансУпак") Тогда
						ИдентТрансУпак = СтруктСтрока.Документ_ТаблСчФакт_СведТов_ДопСведТов_НомСредИдентТов_ИдентТрансУпак;
					КонецЕсли;
					// Одна строка
					Если СтруктСтрока.Свойство("Документ_ТаблСчФакт_СведТов_ДопСведТов_НомСредИдентТов_КИЗ") Тогда
						КИЗ = СтруктСтрока.Документ_ТаблСчФакт_СведТов_ДопСведТов_НомСредИдентТов_КИЗ;
					КонецЕсли;
					// Несколько строк
					Если СтруктСтрока.Свойство("Документ_ТаблСчФакт_СведТов_ДопСведТов_НомСредИдентТов_КИЗ_") Тогда
						Для каждого Эл Из СтруктСтрока.Документ_ТаблСчФакт_СведТов_ДопСведТов_НомСредИдентТов_КИЗ_ Цикл													 
							
							Данные = Новый Структура;
							Данные.Вставить("ОписаниеПродукта", ОписаниеПродукта);
							Данные.Вставить("НомерСтрокиXML"  , НомерСтрокиXML);
							Данные.Вставить("ИдентТрансУпак"  , ИдентТрансУпак);		
							Данные.Вставить("КИЗ"             , Эл);
							Данные.Вставить("НомУпак"         , "");
							
							ДанныеПоМаркировке.Добавить(Данные);
							
						КонецЦикла;
						ИдентТрансУпак = "";
					КонецЕсли;	
					
					// Одна строка
					Если СтруктСтрока.Свойство("Документ_ТаблСчФакт_СведТов_ДопСведТов_НомСредИдентТов_НомУпак") Тогда
						НомУпак = СтруктСтрока.Документ_ТаблСчФакт_СведТов_ДопСведТов_НомСредИдентТов_НомУпак;
					КонецЕсли;					
					// Несколько строк
					Если СтруктСтрока.Свойство("Документ_ТаблСчФакт_СведТов_ДопСведТов_НомСредИдентТов_НомУпак_") Тогда
						Для каждого Эл Из СтруктСтрока.Документ_ТаблСчФакт_СведТов_ДопСведТов_НомСредИдентТов_НомУпак_ Цикл													  
							
							Данные = Новый Структура;
							Данные.Вставить("ОписаниеПродукта", ОписаниеПродукта);
							Данные.Вставить("НомерСтрокиXML"  , НомерСтрокиXML);
							Данные.Вставить("ИдентТрансУпак"  , ИдентТрансУпак);		
							Данные.Вставить("КИЗ"             , "");
							Данные.Вставить("НомУпак"         , Эл);
							
							ДанныеПоМаркировке.Добавить(Данные);
							
						КонецЦикла;	
						ИдентТрансУпак = "";
					КонецЕсли;
					
					Если ЗначениеЗаполнено(ИдентТрансУпак)
						ИЛИ ЗначениеЗаполнено(КИЗ) 
						ИЛИ ЗначениеЗаполнено(НомУпак) Тогда
						
						Данные = Новый Структура;
						Данные.Вставить("ОписаниеПродукта", ОписаниеПродукта);
						Данные.Вставить("НомерСтрокиXML"    , НомерСтрокиXML);
						Данные.Вставить("ИдентТрансУпак"    , ИдентТрансУпак);
						Данные.Вставить("КИЗ"               , КИЗ);
						Данные.Вставить("НомУпак"           , НомУпак);
						
						ДанныеПоМаркировке.Добавить(Данные);
						
					КонецЕсли;				
					
				КонецЕсли;
				
			КонецЕсли;
			
			СуммаБезНДСВсего = СуммаБезНДСВсего + СуммаБезНДС;
			СуммаНДСВсего    = СуммаНДСВсего + СуммаНДС;
		КонецЦикла;
		
		Для каждого Стр Из ДанныеПоМаркировке Цикл
			НовСтрока = ЭКОМДок.ТЧ_Маркировка.Добавить();
			НовСтрока.ОписаниеПродукта = Стр.ОписаниеПродукта; 
			НовСтрока.НомерСтрокиXML   = Стр.НомерСтрокиXML; 
			НовСтрока.ИдентТрансУпак   = Стр.ИдентТрансУпак;
			НовСтрока.КИЗ              = Стр.КИЗ;
			НовСтрока.НомУпак          = Стр.НомУпак;		
		КонецЦикла;
		
		ЭКОМДок.СуммаДокументаВсего = СуммаБезНДСВсего + СуммаНДСВсего;
		ЭКОМДок.СуммаНДСВсего       = СуммаНДСВсего;
		
		Если НЕ ЗначениеЗаполнено(ЭКОМДок.ЗаказНомер) Тогда
			ЭКОМДок.ЗаказНомер = СоответствиеИнфПолФХЖ2["номер_заказа"];
		КонецЕсли;	
		Если НЕ ЗначениеЗаполнено(ЭКОМДок.ЗаказДата) Тогда
			ЭКОМДок.ЗаказДата = ДатаИзXML_в_1С(СоответствиеИнфПолФХЖ2["дата_заказа"]);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ЭКОМДок.НакладнаяДата) Тогда
			ЭКОМДок.НакладнаяДата = ДатаИзXML_в_1С(СоответствиеИнфПолФХЖ1["дата_накладной"]);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ЭКОМДок.НакладнаяНомер) Тогда
			ЭКОМДок.НакладнаяНомер = СоответствиеИнфПолФХЖ1["номер_накладной"];
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ЭКОМДок.НакладнаяДата) Тогда
			ЭКОМДок.НакладнаяДата = ДатаИзXML_в_1С(СоответствиеИнфПолФХЖ1["дата_уведомления_об_отгрузке"]);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ЭКОМДок.НакладнаяНомер) Тогда
			ЭКОМДок.НакладнаяНомер = СоответствиеИнфПолФХЖ1["номер_уведомления_об_отгрузке"];
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ЭКОМДок.НакладнаяДата) Тогда
			ЭКОМДок.НакладнаяДата = ДатаИзXML_в_1С(СоответствиеИнфПолФХЖ2["дата_накладной"]);
		КонецЕсли;		
		Если НЕ ЗначениеЗаполнено(ЭКОМДок.НакладнаяНомер) Тогда
			ЭКОМДок.НакладнаяНомер = СоответствиеИнфПолФХЖ2["номер_накладной"];
		КонецЕсли;	
		
		Если НЕ ЗначениеЗаполнено(ЭКОМДок.НакладнаяДата) Тогда
			ЭКОМДок.НакладнаяДата = ДатаИзXML_в_1С(СоответствиеИнфПолФХЖ2["дата_уведомления_об_отгрузке"]);
		КонецЕсли;	
		Если НЕ ЗначениеЗаполнено(ЭКОМДок.НакладнаяНомер) Тогда
			ЭКОМДок.НакладнаяНомер = СоответствиеИнфПолФХЖ2["номер_уведомления_об_отгрузке"];
		КонецЕсли;	
		
		// Значения из инфо полей ФХЖ1
		СоответствиеИнфПолей = Новый Соответствие;
		Для каждого Стр Из СоответствиеИнфПолФХЖ1 Цикл
			
			СоответствиеИнфПолей.Вставить(Стр.Ключ, Стр.Значение);
			
		КонецЦикла;
		
		// Если значения из инфо полей 1 не заполнены берем из 2
		Для каждого Стр Из СоответствиеИнфПолФХЖ2 Цикл
			
			ЭлементСоответсвия = СоответствиеИнфПолей.Получить(Стр.Ключ);
			Если ЭлементСоответсвия = Неопределено Тогда
				
				// Добавляем элемент
				СоответствиеИнфПолей.Вставить(Стр.Ключ, Стр.Значение);
				
			Иначе	
				Если НЕ ЗначениеЗаполнено(ЭлементСоответсвия) Тогда
					
					// Перезаписываем ключ со значением
					СоответствиеИнфПолей.Вставить(Стр.Ключ, Стр.Значение);	
					
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		Для каждого Стр Из СоответствиеИнфПолей Цикл
			
			пСтруктураДокумента.Вставить(Стр.Ключ, Стр.Значение);
			
		КонецЦикла;
		
		// Запись документа основания в документ
		пСтруктураДокумента.Вставить("ЭКОМДокОснование", Выборка.ЭКОМДокОснование);
		Если ЗначениеЗаполнено(Выборка.ЭКОМДокОснование) Тогда
			ЭКОМДок.ДокументыСвязанные.Очистить(); 
			НовСтрДокСвязанного = ЭКОМДок.ДокументыСвязанные.Добавить();
			НовСтрДокСвязанного.ДокументСвязанный = Выборка.ЭКОМДокОснование;		
		КонецЕсли; 
		
		// Данные по контрагенту		
		Идентификатор = "";
		Если пСтруктураДокумента.Свойство("СвУчДокОбор_ИдОтпр", Идентификатор) Тогда
			пСтруктураДокумента.Вставить("ИдОтпр", Идентификатор);
		КонецЕсли;
		
		ИНН = "";
		Если пСтруктураДокумента.Свойство("Документ_СвСчФакт_СвПрод_ИдСв_СвЮЛУч_ИННЮЛ", ИНН) Тогда
			пСтруктураДокумента.Вставить("ПродавецИНН", ИНН);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ИНН) Тогда
			Если пСтруктураДокумента.Свойство("Документ_СвСчФакт_СвПрод_ИдСв_СвИП_ИННФЛ", ИНН) Тогда
				пСтруктураДокумента.Вставить("ПродавецИНН", ИНН);
			КонецЕсли;
		КонецЕсли;
		
		КПП = "";
		Если пСтруктураДокумента.Свойство("Документ_СвСчФакт_СвПрод_ИдСв_СвЮЛУч_КПП", КПП) Тогда
			пСтруктураДокумента.Вставить("ПродавецКПП", КПП);
		КонецЕсли;
		
		ЭКОМДок.ТекстОшибки = ""; // Очищаем ошибки документа
		ЭКОМДок.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.ПустаяСсылка(); // Обнуляем статус документ
		
		ТекстОшибки      = ""; // Ошибки по документу - записываем в регистр сведений - выводим в табличную часть
		// Если есть уточнение записываем его в комментарий!
		ВыполнитьДополнительныеДействия(ЭКОМДок, "Входящий ЮЗД - универсальный передаточный документ",
		пСтруктураДокумента,
		МассивЛогаСобытий,
		ТекстОшибки,
		КэшированныеЗначения);
				
		ЭКОМДок.ТЧ_Товары.Сортировать("НомерСтрокиXML Возр");
		
		Если ЭКОМДок.ЭтоПовторныйДокумент = Истина Тогда
			ЭКОМДок.Комментарий     = "Повторный документ! Данный документ уже был загружен ранее." + " " + ЭКОМДок.Комментарий;	
		КонецЕсли;
		
		// По умолчанию документ загружается и записывается, если ЭКОМ документ не нужен в гибких настройках необходимо поставить НеЗагружатьДокумент = Истина 
		Если ЭКОМДок.НеЗагружатьДокумент = Ложь Тогда
			
			СтруктураРегистраСобытий = Новый Структура;
			СтруктураРегистраСобытий.Вставить("ДатаЗаписи"                  , ТекущаяДата());
			СтруктураРегистраСобытий.Вставить("ЭЦП"                         , СтрокаТЗСтруктур.ЭЦП);
			СтруктураРегистраСобытий.Вставить("Контрагент"                  , ЭКОМДок.Контрагент);
			СтруктураРегистраСобытий.Вставить("Организация"                 , ЭКОМДок.Организация);
			СтруктураРегистраСобытий.Вставить("НаправлениеОбмена"           , Перечисления.ЭКОМ_НаправлениеОбмена.Входящий);
			СтруктураРегистраСобытий.Вставить("ФайлИмя"                     , СтрокаТЗСтруктур.ИмяФайлаXML);
			СтруктураРегистраСобытий.Вставить("ЗаказДата"                   , ЭКОМДок.ЗаказДата);					
			СтруктураРегистраСобытий.Вставить("ЗаказНомер"                  , ЭКОМДок.ЗаказНомер);
			СтруктураРегистраСобытий.Вставить("Идентификатор"               , Выборка.ИдФайл);
			СтруктураРегистраСобытий.Вставить("СтруктураФайла"              , Новый ХранилищеЗначения(пСтруктураДокумента, Новый СжатиеДанных(9)));
			
			пСтруктураДокумента.Вставить("ЭтоПовторныйДокумент", ЭКОМДок.ЭтоПовторныйДокумент);
			
			ДокументОбработан = ПроверитьОбработкуДокумента(ТекстОшибки, ЭКОМДок, пСтруктураДокумента, СтруктураРегистраСобытий, ПредставлениеДокументаXML, МассивЛогаСобытий);
			Если ДокументОбработан = Ложь Тогда
				Продолжить;			
			КонецЕсли;
			
		Иначе 	
			пСтруктураДокумента.Вставить("Обработан", Ложь);
			ТекстЛогаСобытий = "В гибких настройках указано не загружать документ - " + ПредставлениеДокументаXML;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
		КонецЕсли;
		
		пСтруктураДокумента.Вставить("Организация", Выборка.Организация);
		СтрокаТЗСтруктур.СтруктураДокумента = пСтруктураДокумента;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СоздатьДокументыКоррРеализации(ДокЭКОМ) Экспорт
	
	ДокументРеализации = ДокЭКОМ.ДокументыСвязанные[0].ДокументСвязанный;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КорректировкаРеализации.Ссылка
	|ИЗ
	|	Документ.КорректировкаРеализации КАК КорректировкаРеализации
	|ГДЕ
	|	КорректировкаРеализации.ДокументРеализации = &ДокументРеализации
	|	И КорректировкаРеализации.Проведен";
	
	Запрос.УстановитьПараметр("ДокументРеализации", ДокументРеализации);
	РезультатЗапроса = Запрос.Выполнить();	
	Выборка = РезультатЗапроса.Выбрать();	
	Пока Выборка.Следующий() Цикл
		Сообщить("Документ корр. РТУ № " + Выборка.Ссылка.Номер + " от " + Выборка.Ссылка.Дата + " уже создан в базе и соответствует документу - " + Строка(ДокЭКОМ));
		Возврат;	
	КонецЦикла;
	
	Если ДокЭКОМ.Организация.ПолучитьОбъект() = Неопределено Тогда
		Сообщить("Битая ссылка - " + Строка(ДокЭКОМ.Организация));
		Возврат;	
	КонецЕсли;
	
	Если ДокЭКОМ.Контрагент.ПолучитьОбъект() = Неопределено Тогда
		Сообщить("Битая ссылка - " + Строка(ДокЭКОМ.Контрагент));
		Возврат;	
	КонецЕсли;
	
	Если ДокЭКОМ.ТочкаДоставки.ПолучитьОбъект() = Неопределено Тогда
		Сообщить("Битая ссылка - " + Строка(ДокЭКОМ.ТочкаДоставки));
		Возврат;	
	КонецЕсли;
	
	ДокументКоррРеализации = Документы.КорректировкаРеализации.СоздатьДокумент();
	ДокументКоррРеализации.Заполнить(ДокументРеализации);
	
	// Табличная часть	
	ДокументТЧ = ДокЭКОМ.ТЧ_Товары.Выгрузить();
	ДокументТЧ.Свернуть("Номенклатура, ЕдиницаИзмерения, Цена, СтавкаНДС, СуммаНДС, Сумма, Сумма_с_НДС, ЦенаСНДС", "КоличествоПринятое");
	
	СуммаXML = 0; СуммаXMLСНДС = 0;
	Для Каждого ТекСтрока ИЗ ДокументТЧ Цикл
		СтрКорр = ДокументКоррРеализации.Товары.Найти(ТекСтрока.Номенклатура, "Номенклатура");
		Если ЗначениеЗаполнено(СтрКорр) Тогда			  
			СтрКорр.Количество   = ТекСтрока.КоличествоПринятое;
		КонецЕсли;			
	КонецЦикла;
	
	ДокументКоррРеализации.Комментарий = "Исправлена по ЭКОМ документу recadv № " + ДокЭКОМ.Номер;
	
	// Запишем документ в базу
	Если ДокументКоррРеализации.Товары.Количество() = 0 Тогда
		Сообщить("Документ ""Поступление товаров"" по ЭКОМ документу № " + ДокЭКОМ.Номер +
		" не создан, т.к. не заполнены товары, возможно документ был сформирован вручную, проверьте поступление к этому заказу.", СтатусСообщения.Важное);			
		Возврат;		
	КонецЕсли;
	
	Попытка
		ДокументКоррРеализации.Записать(РежимЗаписиДокумента.Проведение);
		
		Сообщить("Корр. реализация по ЭКОМ документу № " + ДокЭКОМ.Номер + " создана! Номер корр. РТУ № " + ДокументКоррРеализации.Номер);
	Исключение
		Сообщить("Корр. реализация по ЭКОМ документу № " + ДокЭКОМ.Номер + " не создана!!! " + СокрЛП(ОписаниеОшибки()));						
		Возврат;			
	КонецПопытки;
	
КонецПроцедуры

Процедура СоздатьДокументКорректировки(ДокЭКОМ) Экспорт
	
	ПредставлениеДок = "ТОРГ-2 № " + СокрЛП(ДокЭКОМ.Номер) + " от " + Формат(ДокЭКОМ.Дата, "ДФ='dd.MM.yyyy ""г.""'");
	
	Если ДокЭКОМ.ДокументыСвязанные.Количество() = 1  Тогда
		ДокументРеализации = ДокЭКОМ.ДокументыСвязанные[0].ДокументСвязанный;	 
	ИначеЕсли ДокЭКОМ.ДокументыСвязанные.Количество() > 1  Тогда
		Сообщить("В документе несколько связанных реализаций! - " + ПредставлениеДок);
		Возврат;
	Иначе
		Сообщить("В документе нет связанной реализации! - " + ПредставлениеДок);
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КорректировкаРеализации.Ссылка,
	|	КорректировкаРеализации.ПометкаУдаления
	|ИЗ
	|	Документ.КорректировкаРеализации КАК КорректировкаРеализации
	|ГДЕ
	|	КорректировкаРеализации.ДокументРеализации = &ДокументРеализации
	|	И КорректировкаРеализации.Организация = &Организация
	|	И КорректировкаРеализации.Контрагент = &Контрагент";
	
	Запрос.УстановитьПараметр("ДокументРеализации", ДокументРеализации);
	Запрос.УстановитьПараметр("Контрагент"        , ДокЭКОМ.Контрагент);
	Запрос.УстановитьПараметр("Организация"       , ДокЭКОМ.Организация);	
	РезультатЗапроса = Запрос.Выполнить();	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Если Выборка.ПометкаУдаления Тогда
			КорректировкаРеализации = Выборка.Ссылка.ПолучитьОбъект();
			КорректировкаРеализации.ПометкаУдаления = ЛОЖЬ;
			КорректировкаРеализации.Товары.Очистить();
		Иначе
			КорректировкаРеализации = Выборка.Ссылка;
			Сообщить("Корректировка № " + КорректировкаРеализации.Номер + " от " + КорректировкаРеализации.Дата +  " уже существет в базе данных!");
			Возврат;
		КонецЕсли;
	Иначе
		КорректировкаРеализации = Документы.КорректировкаРеализации.СоздатьДокумент();
	КонецЕсли; 
	
	КорректировкаРеализации.Дата = ТекущаяДата();
	КорректировкаРеализации.Заполнить(ДокументРеализации);	
	КорректировкаРеализации.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение;
	
	// Заполняем без изменений 
	Для Каждого ТекСтрока ИЗ КорректировкаРеализации.Товары Цикл	
		ТекСтрока.Количество = ТекСтрока.КоличествоДоИзменения;
		ТекСтрока.Цена       = ТекСтрока.ЦенаДоИзменения;
		ТекСтрока.Сумма      = ТекСтрока.СуммаДоИзменения;
		ТекСтрока.СтавкаНДС  = ТекСтрока.СтавкаНДСДоИзменения;
		ТекСтрока.СуммаНДС   = ТекСтрока.СуммаНДСДоИзменения;			
	КонецЦикла;			
	
	// Находим корректировку по номенклатуре
	Для Каждого ТекСтрока ИЗ ДокЭКОМ.ТЧ_Уточнение Цикл	
		СтрКорр = КорректировкаРеализации.Товары.Найти(ТекСтрока.Номенклатура, "Номенклатура");
		СтрКорр.Количество  = ТекСтрока.КоличествоФактическое;
		СтрКорр.Цена        = ТекСтрока.ЦенаПосле;
		СтрКорр.Сумма       = ТекСтрока.СумБезНДСПосле;
		СтрКорр.СтавкаНДС   = СтавкаНДССсылка(ТекСтрока.СтавкаНДСПосле);
		СтрКорр.СуммаНДС    = Окр(ТекСтрока.СтавкаНДСПосле * СтрКорр.Сумма / 100, 2);			
	КонецЦикла;			
	
	// Запишем документ в базу
	Если КорректировкаРеализации.Товары.Количество() = 0 Тогда
		Сообщить("Документ ""Корректировка"" по ЭКОМ документу № " + ДокЭКОМ.Номер +
		" не создан, т.к. не заполнены товары, возможно документ был сформирован вручную, проверьте поступление к этому заказу.", СтатусСообщения.Важное);			
		Возврат;		
	КонецЕсли;
	
	Попытка
		КорректировкаРеализации.Записать(РежимЗаписиДокумента.Проведение);
		
		СЧФИсходящий = Документы.СчетФактураВыданный.СоздатьДокумент();
		СЧФИсходящий.Дата = ТекущаяДата();
		СЧФИсходящий.Заполнить(КорректировкаРеализации.Ссылка);
		Попытка
			СЧФИсходящий.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			СЧФИсходящий.Записать(РежимЗаписиДокумента.Запись);
		КонецПопытки;	
		
		Сообщить("Корректировка № " + КорректировкаРеализации.Номер + " от " + КорректировкаРеализации.Дата + " создана! по " + ПредставлениеДок, СтатусСообщения.Информация);
		Сообщить("Корректировочная счет-фактура № " + СЧФИсходящий.Номер + " от " + СЧФИсходящий.Дата + " создана! по " + ПредставлениеДок, СтатусСообщения.Информация);
	Исключение
		КорректировкаРеализации.Записать(РежимЗаписиДокумента.Запись);
		Сообщить("Корректировка № " + КорректировкаРеализации.Номер + " от " + КорректировкаРеализации.Дата + " не создана!!!" + СокрЛП(ОписаниеОшибки()));
		Возврат;			
	КонецПопытки;
	
КонецПроцедуры 

Функция ТекстЗапроса_ОтправкаПодписаниеСчетФактурOK() Экспорт
	Результат = 
	"ВЫБРАТЬ
	|	ЭКОМ_Объекты_СобытияЮЗД.Документ_Основание КАК Документ_Основание,
	|	ЭКОМ_Объекты_СобытияУточнения.ВидДокумента КАК ПроверкаНаУточнение,
	|	ЭКОМ_Объекты_СобытияПодпись.ВидДокумента КАК ПроверкаНаПодпись,
	|	ЭКОМ_Объекты_СобытияЮЗД.ЗаказДата КАК ЗаказДата,
	|	ЭКОМ_Объекты_СобытияЮЗД.ЗаказНомер КАК ЗаказНомер,
	|	ЭКОМ_Объекты_СобытияЮЗД.Организация КАК Организация,
	|	ЭКОМ_Объекты_СобытияЮЗД.Контрагент КАК Контрагент,
	|	ЭКОМ_Объекты_СобытияЮЗД.Идентификатор,
	|	ЭКОМ_Объекты_СобытияЮЗД.ДатаЗаписи,
	|	ЭКОМ_Объекты_СобытияЮЗД.ЭЦП,
	|	ЭКОМ_Объекты_СобытияЮЗД.СтруктураФайла,
	|	ЭКОМ_Объекты_СобытияЮЗД.ВидДокумента КАК ВидДокументаЮЗД,
	|	ЭКОМ_Объекты_СобытияЮЗД.НомерДокумента,
	|	ЭКОМ_Объекты_СобытияЮЗД.ДатаДокумента,
	|	ВЫБОР
	|		КОГДА (ВЫРАЗИТЬ(ЭКОМ_Документы.Комментарий КАК СТРОКА(100))) = """"
	|			ТОГДА 1
	|		ИНАЧЕ 2
	|	КОНЕЦ КАК КодИтога
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	Документ.ЭКОМ_Документы КАК ЭКОМ_Документы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_СобытияПодпись
	|		ПО ЭКОМ_Документы.Ссылка = ЭКОМ_Объекты_СобытияПодпись.Документ_Основание
	|			И (ЭКОМ_Объекты_СобытияПодпись.ВидДокумента В (&ВидыДокументовПодписиЮЗД))
	|			И (ЭКОМ_Объекты_СобытияПодпись.НаправлениеОбмена = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_НаправлениеОбмена.Исходящий))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_СобытияУточнения
	|		ПО ЭКОМ_Документы.Ссылка = ЭКОМ_Объекты_СобытияУточнения.Документ_Основание
	|			И (ЭКОМ_Объекты_СобытияУточнения.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.DP_UVUTOCH_09))
	|			И (ЭКОМ_Объекты_СобытияУточнения.НаправлениеОбмена = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_НаправлениеОбмена.Исходящий))
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_СобытияЮЗД
	|		ПО ЭКОМ_Документы.Ссылка = ЭКОМ_Объекты_СобытияЮЗД.Документ_Основание
	|			И (ЭКОМ_Объекты_СобытияЮЗД.НаправлениеОбмена = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_НаправлениеОбмена.Входящий))
	|			И (ЭКОМ_Объекты_СобытияЮЗД.ВидДокумента В (&ВидыДокументовЮЗД))
	|ГДЕ
	|	ЭКОМ_Документы.СтатусОбработкиДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_Статусы.Обработан)
	|	И ЭКОМ_Документы.Ссылка В(&МассивДок)
	|	И НЕ ЭКОМ_Документы.ЭтоПовторныйДокумент
	|	И НЕ ЭКОМ_Документы.ЭтоПовторныйДокумент
	|	И ((ВЫРАЗИТЬ(ЭКОМ_Документы.Комментарий КАК СТРОКА(100))) = """"
	|			ИЛИ ЭКОМ_Документы.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPRMARK_01)
	|			ИЛИ ЭКОМ_Документы.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPRMARK_01_Испр)
	|			ИЛИ ЭКОМ_Документы.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.ON_NKORSCHFDOPPRMARK_01)
	|			ИЛИ ЭКОМ_Документы.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.ON_NKORSCHFDOPPRMARK_01_Испр))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Документ_Основание КАК ДокЭКОМ,
	|	ВТ.ПроверкаНаУточнение КАК ПроверкаНаУточнение,
	|	ВТ.ПроверкаНаПодпись КАК ПроверкаНаПодпись,
	|	ЭКОМ_GLN_Организация.Сертификат КАК Сертификат,
	|	ВТ.ЗаказДата КАК ЗаказДата,
	|	ВТ.ЗаказНомер КАК ЗаказНомер,
	|	ВТ.Организация КАК Организация,
	|	ВТ.Контрагент КАК Контрагент,
	|	ЭКОМ_GLN_Организация.Партнер КАК ОператорОрганизации,
	|	ЭКОМ_GLN_Организация.Ид_ОЭД КАК ИдентификаторОрганизации,
	|	ЭКОМ_GLN_Контрагент.Партнер КАК ОператорКонтрагента,
	|	ЭКОМ_GLN_Контрагент.Ид_ОЭД КАК ИдентификаторКонтрагента,
	|	ВТ.Идентификатор,
	|	ВТ.ДатаЗаписи,
	|	ВТ.ЭЦП,
	|	ВТ.СтруктураФайла,
	|	ВТ.ВидДокументаЮЗД,
	|	ВТ.НомерДокумента,
	|	ВТ.ДатаДокумента,
	|	ВТ.КодИтога
	|ИЗ
	|	ВТ КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Организация
	|		ПО ВТ.Организация = ЭКОМ_GLN_Организация.Объект
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Контрагент
	|		ПО ВТ.Контрагент = ЭКОМ_GLN_Контрагент.Объект
	|ГДЕ
	|	(ВТ.ПроверкаНаПодпись ЕСТЬ NULL
	|			ИЛИ ВТ.ПроверкаНаПодпись = НЕОПРЕДЕЛЕНО
	|			ИЛИ ВТ.ПроверкаНаПодпись = """")
	|	И (ВТ.ПроверкаНаУточнение ЕСТЬ NULL
	|			ИЛИ ВТ.ПроверкаНаУточнение = НЕОПРЕДЕЛЕНО
	|			ИЛИ ВТ.ПроверкаНаУточнение = """"
	|			ИЛИ ВТ.ВидДокументаЮЗД = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPRMARK_01)
	|			ИЛИ ВТ.ВидДокументаЮЗД = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPRMARK_01_Испр)
	|			ИЛИ ВТ.ВидДокументаЮЗД = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.ON_NKORSCHFDOPPRMARK_01)
	|			ИЛИ ВТ.ВидДокументаЮЗД = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.ON_NKORSCHFDOPPRMARK_01_Испр))";
	Возврат Результат;
КонецФункции 

Функция Отправить_ПодписьЮЗД(МассивДок, МассивЛогаСобытий) Экспорт
	
	ИмяСобытия = "Создание подписи ЮЗД";
	МассивСтруктур   = Новый Массив;
	
	ВидыДокументовЮЗД = Новый Массив;
	Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьПервичныеВидыДокументовЮЗД(ВидыДокументовЮЗД);");
	Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьИсправительныеВидыДокументовЮЗД(ВидыДокументовЮЗД);");
	Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьКорректировочныеВидыДокументовЮЗД(ВидыДокументовЮЗД);");

	ВидыДокументовПодписиЮЗД = Новый Массив;	          
	Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьПодписьВидовДокументовЮЗД(ВидыДокументовПодписиЮЗД);");

	// Отбираем только обработанные документы ЭКОМ
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса_ОтправкаПодписаниеСчетФактурOK();
	Запрос.УстановитьПараметр("ВидыДокументовЮЗД", ВидыДокументовЮЗД);
	Запрос.УстановитьПараметр("ВидыДокументовПодписиЮЗД", ВидыДокументовПодписиЮЗД);
	
	// По регламенту
	Если МассивДок.Количество() = 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ЭКОМ_Документы.Ссылка В(&МассивДок)", "");	
	Иначе
		// В ручную		
		Запрос.УстановитьПараметр("МассивДок", МассивДок);
	КонецЕсли;	
	
	РезультатЗапроса = Запрос.Выполнить();	
	
	ВременныйКаталог = ПутьВременногоКаталогаЭКОМ("SignPOK_out");
	КаталогВременный = ЭКОМ_СоздатьКаталогПроверитьНаЗапись(ВременныйКаталог, МассивЛогаСобытий);
	Если КаталогВременный = Неопределено Тогда		
		Возврат МассивСтруктур;		
	КонецЕсли;
	
	СтруктураМетаДанных = ЮрФизЛицоОпределитьМетаданные();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Если НЕ ЗначениеЗаполнено(Выборка.Сертификат) Тогда
				ТекстЛогаСобытий = "Данные для организации не определены, заполните регистр ЭКОМ GLN!";
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
				
				Продолжить;
			КонецЕсли; 
			
			Если НЕ ЗначениеЗаполнено(Выборка.Сертификат) Тогда
				Продолжить;			
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Выборка.ОператорКонтрагента) Тогда
				ТекстЛогаСобытий = "Нет данных по контрагенту (регистр ЭКОМ GLN)! - " + Строка(Выборка.Контрагент);
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

				Продолжить;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Выборка.ОператорОрганизации) Тогда
				ТекстЛогаСобытий = "Нет данных по организации (регистр ЭКОМ GLN)! - " + Строка(Выборка.Организация);
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
				Продолжить;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Выборка.Идентификатор) Тогда
				ТекстЛогаСобытий = "Нет данных по документу (регистр ЭКОМ события)! - " + Строка(Выборка.ДокЭКОМ);
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

				Продолжить;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Выборка.ЭЦП) Тогда	
				ТекстЛогаСобытий = "Не найдена ЭЦП для входящего ЮЗД документа ( не найдена запись в РС ""Docrobot События по документам"" документ: " + Выборка.ДокЭКОМ + ")";
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
				
				Продолжить;
			КонецЕсли; 

			СтруктураДокумента = Новый Структура;	
			СтруктураДокумента.Вставить("ВерсФорм", "5.01");
			СтруктураДокумента.Вставить("ВерсПрог", "Docrobot 1С Integration");	
			СтруктураДокумента.Вставить("НаимОргОператор"	, Выборка.ОператорОрганизации.Наименование);
			СтруктураДокумента.Вставить("ИННОператор"		, Выборка.ОператорОрганизации.ИНН);
			СтруктураДокумента.Вставить("ИдЭДООператор"		, Выборка.ОператорОрганизации.Идентификатор);
			СтруктураДокумента.Вставить("ИдОтпр"	        , Выборка.ОператорОрганизации.Идентификатор + Выборка.ИдентификаторОрганизации); 
			СтруктураДокумента.Вставить("НаимОтрДок"	    , Выборка.ОператорКонтрагента.Наименование);
			СтруктураДокумента.Вставить("ИННОтрДок"		    , Выборка.ОператорКонтрагента.ИНН);
