// ++++++++++++++++++++++++
//                     SSCC
// ++++++++++++++++++++++++

// Возвращает Токен авторизации для получения SSCC кодов.
//
// Параметры:
//  ПрофильОбмена  - СправочникСсылка.ЭКОМ_ПрофилиОбмена:
//		** ИмяПользователяFTP     - Логин FTP/SOAP.
//		** ПарольПользователяAPI  - Пароль API.
//
// Возвращаемое значение:
//  Строка   - Токен авторизации
//
Функция ПолучитьТокенАвторизацииSSCC(ПрофильОбмена)
	
	ЛогСобытий = "";	
	ТокенАвторизации = Неопределено;
	Ошибка = Новый Структура("ЕстьОшибка", Ложь);
	
	Если НЕ ЗначениеЗаполнено(ПрофильОбмена.ИмяПользователяFTP) Тогда
		ТекстЛогаСобытий = "В настройках программы не заполнен логин";
		ЗаписатьЛогСобытий(ЛогСобытий, ТекстЛогаСобытий);
		Ошибка.ЕстьОшибка = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПрофильОбмена.ПарольПользователяAPI) Тогда
		ТекстЛогаСобытий = "В настройках программы не заполнен пароль";
		ЗаписатьЛогСобытий(ЛогСобытий, ТекстЛогаСобытий);	
		Ошибка.ЕстьОшибка = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПрофильОбмена.СерверAPI) Тогда
		ТекстЛогаСобытий = "В настройках программы не заполнен адрес сервера API";
		ЗаписатьЛогСобытий(ЛогСобытий, ТекстЛогаСобытий);	
		Ошибка.ЕстьОшибка = Истина;
	КонецЕсли;
	
	//Получаем новый Токен.
	Если Ошибка.ЕстьОшибка = Ложь Тогда
		ДанныеЗапроса = Новый Структура;
		ДанныеЗапроса.Вставить("varLogin"   , ПрофильОбмена.ИмяПользователяFTP);
		ДанныеЗапроса.Вставить("varPassword", ПрофильОбмена.ПарольПользователяAPI);
		
		ЗаголовокHTTP = Новый Соответствие;
		ЗаголовокHTTP.Вставить("Content-type", "application/json");
		ЗаголовокHTTP.Вставить("Accept"      , "application/json");	
		
		ПараметрыЗапроса = Новый Структура;
		ПараметрыЗапроса.Вставить("МетодHTTP"    , "POST");
		ПараметрыЗапроса.Вставить("ЗаголовокHTTP", ЗаголовокHTTP);
		
		//Выполняем запрос.
		Ответ = ЭКОМ_ОбщегоНазначения.ВыполнитьЗапрос("/Api/Helpers/Index/Authorize", ПрофильОбмена, ДанныеЗапроса, ПараметрыЗапроса, Ошибка, ЛогСобытий);		
		
		Если Ошибка.ЕстьОшибка Тогда
			ТекстЛогаСобытий = "Код: " + Ошибка.КодОшибки + " - " + Ошибка.ТекстОшибки;
			ЗаписатьЛогСобытий(ЛогСобытий, ТекстЛогаСобытий);	
			
		Иначе
			// Проверяем ответ.
			ТокенАвторизации = Сред(Ответ.Текст, 14, 26);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЛогСобытий) Тогда 
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ЛогСобытий;
		Сообщение.Сообщить();	
	КонецЕсли;  
	
	Возврат ТокенАвторизации;
	
КонецФункции // ПолучитьТокенАвторизацииSSCC()

// Возвращает массив SSCC кодов.
//
// Параметры:
//  ПрофильОбмена  	- СправочникСсылка.ЭКОМ_ПрофилиОбмена.
//                 
//  Параметры  		- Структура.
//
// Возвращаемое значение:
//   Массив   		- Массив строк, SSCC кодов.
//
Функция ПолучитьКодыSSCC(ПрофильОбмена, Параметры)
	
	ЛогСобытий = "";
	МассивSSCC = Новый Массив;
	МассивЛогаСобытий = Новый Массив;
	Ошибка = Новый Структура("ЕстьОшибка", Ложь);
	
	ДанныеЗапроса = Новый Структура;
	ДанныеЗапроса.Вставить("varToken"   	, Параметры.ТокенАвторизации);
	ДанныеЗапроса.Вставить("varSender"		, Параметры.ОрганизацияGLN);
	ДанныеЗапроса.Вставить("varRecipient"   , Параметры.КонтрагентGLN);
	ДанныеЗапроса.Вставить("varCurentGln"	, Параметры.ОрганизацияGLN);
	ДанныеЗапроса.Вставить("intCount"		, Параметры.КоличествоSSCC);
	
	ЗаголовокHTTP = Новый Соответствие;
	ЗаголовокHTTP.Вставить("Content-type", "application/json");
	ЗаголовокHTTP.Вставить("Accept"      , "application/json");	
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("МетодHTTP"    , "POST");
	ПараметрыЗапроса.Вставить("ЗаголовокHTTP", ЗаголовокHTTP);
	
	//Выполняем запрос.
	Ответ = ЭКОМ_ОбщегоНазначения.ВыполнитьЗапрос("/Api/Helpers/Index/SSCCGenerate", ПрофильОбмена, ДанныеЗапроса, ПараметрыЗапроса, Ошибка, ЛогСобытий);		
	
	Если Ошибка.ЕстьОшибка Тогда 
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Код: " + Ошибка.КодОшибки + " - " + Ошибка.ТекстОшибки;
		Сообщение.Сообщить();	
		
	Иначе
		ОбработанныйРезультат = Вычислить("ЭКОМ_ОбщегоНазначения.ЗаполнитьСтруктуруИзОтветаJSON(Ответ.Текст, МассивЛогаСобытий)");
		РезультатSSCC = ОбработанныйРезультат.Получить("SSCC");
		Если НЕ РезультатSSCC = Неопределено Тогда
			МассивSSCC = РезультатSSCC;				
		КонецЕсли;
	КонецЕсли;
	
	Возврат МассивSSCC;
	
КонецФункции // ПолучитьКодыSSCC()

Процедура ЗаполнитьТалицуНовымиSSCC(ДокументОснование, GLN_Организации, GLN_Контрагента, ТЧПалеты, SSCC_ПолучатьОнлайн, Организация)Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ВТ_Палеты.НомерПалета КАК НомерПалета,
	|	ПОДСТРОКА(ВТ_Палеты.SSCC, 1, 17) КАК SSCC
	|ПОМЕСТИТЬ ВТ_Палеты
	|ИЗ
	|	&ВТ_Палеты КАК ВТ_Палеты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЭКОМ_Палеты.НомерПалета КАК НомерПалета,
	|	ПОДСТРОКА(ЭКОМ_Палеты.SSCC, 1, 17) КАК SSCC
	|ПОМЕСТИТЬ ТаблицаИтог
	|ИЗ
	|	РегистрСведений.ЭКОМ_Палеты КАК ЭКОМ_Палеты
	|ГДЕ
	|	ЭКОМ_Палеты.Документ.Организация = &Организация
	|	И ЭКОМ_Палеты.Документ.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&Дата, ГОД) И КОНЕЦПЕРИОДА(&Дата, ГОД)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_Палеты.НомерПалета,
	|	ВТ_Палеты.SSCC
	|ИЗ
	|	ВТ_Палеты КАК ВТ_Палеты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаИтог.НомерПалета КАК НомерПалета,
	|	ТаблицаИтог.SSCC КАК SSCC
	|ИЗ
	|	ТаблицаИтог КАК ТаблицаИтог
	|ГДЕ
	|	НЕ ТаблицаИтог.SSCC = """"
	|	И ПОДСТРОКА(ТаблицаИтог.SSCC, 1, 10) = &НачалоКодовПаллет
	|
	|УПОРЯДОЧИТЬ ПО
	|	SSCC УБЫВ";
	
	ТипДокумента = "Документ." + ДокументОснование.Метаданные().Имя;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЭКОМ_Палеты.Документ.Организация", "ВЫРАЗИТЬ(ЭКОМ_Палеты.Документ КАК " + ТипДокумента + ").Организация");  
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЭКОМ_Палеты.Документ.Дата", "ВЫРАЗИТЬ(ЭКОМ_Палеты.Документ КАК " + ТипДокумента + ").Дата"); 
	
	Если СокрЛП(GLN_Контрагента) = "4606068999995" Тогда // ТС "Лента"
		НачалоКодовПаллет = "1";
	ИначеЕсли СокрЛП(GLN_Контрагента) = "4607075269996" Тогда // ТС "Леруа Мерлен Восток"
		НачалоКодовПаллет = "2";
	Иначе
		НачалоКодовПаллет = "3";
	КонецЕсли;
	
	Если СокрЛП(GLN_Контрагента) = "4607164999995" Тогда // Тандер
		НачалоКодовПаллет = НачалоКодовПаллет + Сред(GLN_Организации, 5, 13);
	Иначе
		НачалоКодовПаллет = НачалоКодовПаллет + Сред(GLN_Организации, 1, 9);
	КонецЕсли;
	
	ПервыйКод         = НачалоКодовПаллет + "0000001";
	КоличествоСимволовПаллет = СтрДлина(НачалоКодовПаллет);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Дата"       , ДокументОснование.Дата);
	Запрос.УстановитьПараметр("Организация", ДокументОснование.Организация);
	Запрос.УстановитьПараметр("ВТ_Палеты"  , ТЧПалеты);
	Запрос.УстановитьПараметр("НачалоКодовПаллет"  , НачалоКодовПаллет);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() = Ложь Тогда
		
		ЧисловойКод = СтрЗаменить(ПервыйКод, " ", "");
		ЧисловойКод = Сред(ЧисловойКод, 1, 17);
		ЧисловойКод = ЭКОМ_ПреобразоватьВЧисло(ЧисловойКод);
		
	Иначе		
		ТекущийКод = Выборка.SSCC;
		Если Лев(ТекущийКод, КоличествоСимволовПаллет) <> НачалоКодовПаллет 
			ИЛИ ЭКОМ_ПреобразоватьВЧисло(Лев(ТекущийКод, КоличествоСимволовПаллет)) = 0 Тогда
			ТекущийКод = ПервыйКод;
		КонецЕсли; 
		
		ЧисловойКод = СтрЗаменить(ТекущийКод, " ", "");
		ЧисловойКод = Сред(ЧисловойКод, 1, 17);
		ЧисловойКод = ЭКОМ_ПреобразоватьВЧисло(ЧисловойКод);
		ЧисловойКод = ЧисловойКод + 1;
				
	КонецЕсли;
	
	Если SSCC_ПолучатьОнлайн Тогда 
		ЗаполнитьТалицуНовымиSSCC_Онлайн(ДокументОснование, GLN_Организации, GLN_Контрагента, ТЧПалеты, Организация, ЧисловойКод);
	Иначе	
		ЗаполнитьТалицуНовымиSSCC_Офлайн(ТЧПалеты, ЧисловойКод);
	КонецЕсли;
	
КонецПроцедуры	
		
Процедура ЗаполнитьТалицуНовымиSSCC_Офлайн(ТЧПалеты, ЧисловойКод)Экспорт	
	
	ЧисловойКод = Мин(ЧисловойКод, 999999999999999999);
	
	Для каждого СтрокаПаллеты Из ТЧПалеты Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаПаллеты.SSCC) 
			И ЗначениеЗаполнено(СтрокаПаллеты.НомерПалета) Тогда
			
			Штрихкод = Формат(ЧисловойКод, "ЧЦ=17; ЧВН=; ЧГ=");
			Штрихкод = Штрихкод + КонтрольныйСимвол(Штрихкод);	//GLN_Контрагента
			СтрокаПаллеты.SSCC = Штрихкод;
			
			// Продолжаем нумерацию
			ЧисловойКод = ЧисловойКод + 1;
		ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаПаллеты.SSCC)
			И НЕ ЗначениеЗаполнено(СтрокаПаллеты.НомерПалета) Тогда	
			Сообщить("Обязательно требуется номер паллеты для генерации кодов паллет (SSCC)");
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТалицуНовымиSSCC_Онлайн(ДокументОснование, GLN_Организации, GLN_Контрагента, ТЧПалеты, Организация, НачальныйЧисловойКод) Экспорт
		
	//Docrobot Получение SSCC  с платформы
	МассивЛогаСобытий = Новый Массив;  			
	ПрофильОбмена = ОсновнойПрофильОбмена(Организация, МассивЛогаСобытий);
	
	Если ПрофильОбмена = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не заполнен Активный профиль обмена в справочнике <<<ЭКОМ Профили обмена>>>!";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
		
	МассивКодовSSCCПослеПроверки = Новый Массив;
	
	Пока МассивКодовSSCCПослеПроверки.Количество() < ТЧПалеты.Количество() Цикл  
		
		ТокенАвторизации = ПолучитьТокенАвторизацииSSCC(ПрофильОбмена);

		Если Не(ЗначениеЗаполнено(ТокенАвторизации)) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Не удалось получить токен авторизации.";
			Сообщение.Сообщить();
			Возврат;
		КонецЕсли;
		
		ПараметрыЗапроса = Новый Структура("ТокенАвторизации, ОрганизацияGLN, КонтрагентGLN, КоличествоSSCC", 
		ТокенАвторизации, GLN_Организации, GLN_Контрагента, ТЧПалеты.Количество() - МассивКодовSSCCПослеПроверки.Количество());
			
		МассивSSCC = ПолучитьКодыSSCC(ПрофильОбмена, ПараметрыЗапроса);

		Если МассивSSCC.Количество() = 0 Тогда 
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Сервер не вернул коды SSCC. Проверьте подключение к серверу API.";
			Сообщение.Сообщить();
			Возврат;	
		КонецЕсли;
		
		НачальныйЧисловойКодСтрока = Формат(НачальныйЧисловойКод, "ЧЦ=17; ЧВН=; ЧГ=");
		
		Для Каждого Код Из МассивSSCC Цикл
			Если Сред(Код, 11, 7) >= Сред(НачальныйЧисловойКодСтрока, 11, 7) Тогда
				МассивКодовSSCCПослеПроверки.Добавить(Код);		
			КонецЕсли;		
		КонецЦикла;

	КонецЦикла;
	
	Индекс = 0;	
	Для каждого СтрокаПаллеты Из ТЧПалеты Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаПаллеты.SSCC) 
			И ЗначениеЗаполнено(СтрокаПаллеты.НомерПалета) Тогда		
			СтрокаПаллеты.SSCC = МассивКодовSSCCПослеПроверки[Индекс];
			Индекс = Индекс + 1;
			
		ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаПаллеты.SSCC)
			И НЕ ЗначениеЗаполнено(СтрокаПаллеты.НомерПалета) Тогда	
			Сообщить("Обязательно требуется номер паллеты для генерации кодов паллет (SSCC)");
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция КонтрольныйСимвол(Штрихкод)
	
	Четн   = 0;
	Нечетн = 0;

	Для Номер = 1 По СтрДлина(Штрихкод) Цикл 
		Цифра = Сред(Штрихкод, СтрДлина(Штрихкод)-(Номер-1), 1);
		Если Номер % 2 = 0 Тогда
			Четн 	= Четн + Цифра;
		Иначе
			Нечетн 	= Нечетн + Цифра;
		КонецЕсли;
	КонецЦикла;
	
	Нечетн = Нечетн * 3;
	
	КонтЦифра = 10 - (Четн + Нечетн) % 10; 
	
	Возврат ?(КонтЦифра = 10, "0", Строка(КонтЦифра));
	
КонецФункции 

Функция ПолучитьДанныеПаллетах(ДокументСсылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РегистрСведенийЭКОМ_Палеты.Документ,
	|	РегистрСведенийЭКОМ_Палеты.Номенклатура,
	//Docrobot 1.20.0 MOD-1481 [Добавлены Характеристика и Серия]
	|	РегистрСведенийЭКОМ_Палеты.Характеристика,
	|	РегистрСведенийЭКОМ_Палеты.Серия,
	|	РегистрСведенийЭКОМ_Палеты.НомерПалета,
	|	РегистрСведенийЭКОМ_Палеты.SSCC,
	|	РегистрСведенийЭКОМ_Палеты.ВесБрутто,
	|	РегистрСведенийЭКОМ_Палеты.ВесНетто,
	|	РегистрСведенийЭКОМ_Палеты.Высота,
	|	РегистрСведенийЭКОМ_Палеты.Европаллета,
	|	РегистрСведенийЭКОМ_Палеты.Единица_Измерения,
	|	РегистрСведенийЭКОМ_Палеты.Ключ_Строки КАК Ключ_Строки,
	|	РегистрСведенийЭКОМ_Палеты.Количество,
	|	РегистрСведенийЭКОМ_Палеты.МестоДоставкиУпаковки,
	|	РегистрСведенийЭКОМ_Палеты.Объем,
	|	РегистрСведенийЭКОМ_Палеты.ТемператураХранения,
	|	РегистрСведенийЭКОМ_Палеты.СрокХраненияВДнях,
	|	РегистрСведенийЭКОМ_Палеты.ЗаводПроизводитель,
	|	РегистрСведенийЭКОМ_Палеты.ДатаПроизводства,
	|	РегистрСведенийЭКОМ_Палеты.ДатаОкончанияСрокаГодности
	|ИЗ
	|	РегистрСведений.ЭКОМ_Палеты КАК РегистрСведенийЭКОМ_Палеты
	|ГДЕ
	|	РегистрСведенийЭКОМ_Палеты.Документ = &ДокументСсылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ключ_Строки";
	
	Запрос.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();	
	ТаблицаРезультат = РезультатЗапроса.Выгрузить();
	
	Возврат ТаблицаРезультат;
	
КонецФункции

Процедура ЗаписатьПалетты(ОбщаяТаблицаПаллет, ПаллетыПоТоварам, ДокументСсылка) Экспорт
	
	Набор_Палетты = РегистрыСведений.ЭКОМ_Палеты.СоздатьНаборЗаписей();
	Набор_Палетты.Отбор.Документ.Установить(ДокументСсылка);
	Набор_Палетты.Прочитать();
	Набор_Палетты.Очистить();
	Набор_Палетты.Записать();
	Набор_Палетты = Неопределено;
	
	СтрКолонки = "";
	Для каждого ТекКолонка Из ПаллетыПоТоварам.Колонки Цикл
		
		ИмяКолонки = ТекКолонка.Имя;
		Если ИмяКолонки = "Количество" Тогда
			Продолжить;
		КонецЕсли;
		
		СтрКолонки = СтрКолонки 
		+ ?(ПустаяСтрока(СтрКолонки), "", ",") 
		+ ИмяКолонки
		;
	КонецЦикла;
	
	ПаллетыПоТоварам.Свернуть(стрКолонки, "Количество");	
	
	Для Каждого ТекСтрока Из ПаллетыПоТоварам Цикл
		
		Набор_Палетты = РегистрыСведений.ЭКОМ_Палеты.СоздатьНаборЗаписей();
		Набор_Палетты.Отбор.Документ.Установить(ДокументСсылка);
		Набор_Палетты.Отбор.Номенклатура.Установить(ТекСтрока.Номенклатура);
		//Docrobot 1.20.0 MOD-1481 [Добавлены Характеристика и Серия]
		Набор_Палетты.Отбор.Характеристика.Установить(ТекСтрока.Характеристика);
		Набор_Палетты.Отбор.Серия.Установить(ТекСтрока.Серия);
		Набор_Палетты.Отбор.НомерПалета.Установить(ТекСтрока.НомерПалета);
		Набор_Палетты.Прочитать();
		Набор_Палетты.Очистить();
		
		НоваяЗапись_Палетта = Набор_Палетты.Добавить();
		
		НоваяЗапись_Палетта.Документ          = ДокументСсылка;
		НоваяЗапись_Палетта.Номенклатура      = ТекСтрока.Номенклатура;
		//Docrobot 1.20.0 MOD-1481 [Добавлены Характеристика и Серия]
		НоваяЗапись_Палетта.Характеристика    = ТекСтрока.Характеристика;
		НоваяЗапись_Палетта.Серия	          = ТекСтрока.Серия;
		НоваяЗапись_Палетта.Ключ_Строки       = ТекСтрока.Ключ_Строки;
		НоваяЗапись_Палетта.Количество        = ТекСтрока.Количество;
		НоваяЗапись_Палетта.Единица_Измерения = ТекСтрока.Единица_Измерения;
		НоваяЗапись_Палетта.НомерПалета       = ТекСтрока.НомерПалета;
		НоваяЗапись_Палетта.SSCC              = ТекСтрока.SSCC;
		НоваяЗапись_Палетта.ВесНетто          = ТекСтрока.ВесНеттоШтуки  * ТекСтрока.Количество;
		НоваяЗапись_Палетта.ВесБрутто         = ТекСтрока.ВесБруттоШтуки * ТекСтрока.Количество;
		НоваяЗапись_Палетта.ТемператураХранения        = ТекСтрока.ТемператураХранения;
		НоваяЗапись_Палетта.СрокХраненияВДнях          = ТекСтрока.СрокХраненияВДнях;
		НоваяЗапись_Палетта.ЗаводПроизводитель         = ТекСтрока.ЗаводПроизводитель;
		НоваяЗапись_Палетта.ДатаПроизводства           = ТекСтрока.ДатаПроизводства;
		НоваяЗапись_Палетта.ДатаОкончанияСрокаГодности = ТекСтрока.ДатаОкончанияСрокаГодности;
		
		НайденаяСтрокаПалета = ОбщаяТаблицаПаллет.Найти(ТекСтрока.НомерПалета, "НомерПалета");
		
		Если НайденаяСтрокаПалета <> Неопределено Тогда
			НоваяЗапись_Палетта.Европаллета           = НайденаяСтрокаПалета.Европаллета;
			НоваяЗапись_Палетта.Объем                 = НайденаяСтрокаПалета.Объем;
			НоваяЗапись_Палетта.Высота                = НайденаяСтрокаПалета.Высота;
			НоваяЗапись_Палетта.МестоДоставкиУпаковки = НайденаяСтрокаПалета.МестоДоставкиУпаковки;
		КонецЕсли;
		
		Набор_Палетты.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

Функция ОтправитьФайлыВНужномФорматеПоТипуДокументаПоFTP(ФайлXML, ФайлBIN, ТипДокумента, Сервер, ВременныйКаталог, МассивЛогаСобытий, ПрофильОбмена, ТипОбменаЭТРН, ФайлДанных = Неопределено, СтруктураEDI = Неопределено) //MOD-2544
	
	ФайлОтправлен = Ложь;
	
	Если ТипДокумента = "ЮЗД" 
		ИЛИ ТипДокумента = "WHGOV_01_Исходящий" 
		ИЛИ ТипДокумента = "WHGOU_04_Исходящий"
		ИЛИ ТипДокумента = "WHGPV_05_Исходящий" 
		ИЛИ ТипДокумента = "WHGPU_08_Исходящий"
		ИЛИ ТипДокумента = "DP_REZRUISP"
		ИЛИ Найти(ТипДокумента, "CONDRA") > 0 Тогда
		
		// Создаем архив с файлами ЮЗД
		ИмяФайлаДляОтправки = ВременныйКаталог + ФайлXML.ИмяБезРасширения + ".zip";
		
		ЗаписьZIP_ЮЗД  = Новый ЗаписьZipФайла(
		ИмяФайлаДляОтправки,
		"", // пароль на архив (оставим пустой)
		"Этот архив создан из 1с", // комментарий к архиву
		МетодСжатияZIP.Сжатие, // сжатие или копирование
		УровеньСжатияZIP.Оптимальный,
		МетодШифрованияZIP.Zip20
		);   
		
		//+MOD-2544 [Подпись Казахстан. Для работы с KalkanCryptCOM]
		Если Найти(ТипДокумента, "CONDRA") > 0 Тогда
			// Переименовываем xml файл в condra.xml
			ПереместитьФайл(ФайлXML.ПолноеИмя, ФайлXML.Путь + "condra.xml");
			ЗаписьZIP_ЮЗД.Добавить(ФайлXML.Путь + "condra.xml");
		Иначе
			ЗаписьZIP_ЮЗД.Добавить(ФайлXML.ПолноеИмя);
		КонецЕсли;
		
		Если НЕ ФайлBIN = Неопределено Тогда
			ЗаписьZIP_ЮЗД.Добавить(ФайлBIN.ПолноеИмя);
		КонецЕсли;
		
		Если НЕ ФайлДанных = Неопределено Тогда
			ЗаписьZIP_ЮЗД.Добавить(ФайлДанных.ПолноеИмя);
		КонецЕсли;
		
		ЗаписьZIP_ЮЗД.Записать();
		
		Если Найти(ТипДокумента, "CONDRA") > 0 Тогда
			// Возвращаем старое название файлу xml.
			ПереместитьФайл(ФайлXML.Путь + "condra.xml", ФайлXML.ПолноеИмя);
		КонецЕсли;
		
		//-MOD-2544 [Подпись Казахстан. Для работы с KalkanCryptCOM]
					
		ФайлОтправлен = ОтправитьФайлПоFTP(Сервер, ИмяФайлаДляОтправки, ФайлXML.ИмяБезРасширения + ".zip", МассивЛогаСобытий , ПрофильОбмена, ТипОбменаЭТРН);
		
		СтруктураEDI.Вставить("ИмяАрхива", ИмяФайлаДляОтправки);
		// Удаление архива
		//УдалитьФайлы(ИмяФайлаДляОтправки);
		
	Иначе
		ФайлОтправлен = ОтправитьФайлПоFTP(Сервер, ФайлXML.ПолноеИмя, ФайлXML.Имя, МассивЛогаСобытий , ПрофильОбмена, ТипОбменаЭТРН);
		Если ФайлBIN = Неопределено Тогда
			РезультатОтправкиBIN = Истина;	
		Иначе
			РезультатОтправкиBIN = ОтправитьФайлПоFTP(Сервер, ФайлBIN.ПолноеИмя, ФайлBIN.Имя, МассивЛогаСобытий , ПрофильОбмена, ТипОбменаЭТРН);
			Если ФайлBIN.Существует() Тогда
				УдалитьФайлы(ФайлBIN.ПолноеИмя);
			КонецЕсли;
		КонецЕсли;
		
		Если РезультатОтправкиBIN = Ложь 
			ИЛИ ФайлОтправлен = Ложь Тогда
			ФайлОтправлен = Ложь;
		КонецЕсли;
		
	КонецЕсли;            
	
	// Удаление файлов
	Если ФайлXML.Существует() Тогда
		УдалитьФайлы(ФайлXML.ПолноеИмя);
	КонецЕсли;
	Если НЕ ФайлBIN = Неопределено Тогда
		Если ФайлBIN.Существует() Тогда
			УдалитьФайлы(ФайлBIN.ПолноеИмя);
		КонецЕсли;
	КонецЕсли;
	
	Возврат ФайлОтправлен;
	
КонецФункции

Функция ОтправитьФайлПоFTP(Сервер, ПолноеИмяФайла, КраткоеИмяФайла, МассивЛогаСобытий, ПрофильОбмена, ТипОбменаЭТРН)
	
	Результат = Ложь;
	Попытка
		Сервер.Записать(ПолноеИмяФайла, ПрофильОбмена.ИсходящийПутьFTP + КраткоеИмяФайла);
		Результат = Истина;
	Исключение      
		Сервер = ПолучитьFTPСоединениеВОбработке(ПрофильОбмена, ТипОбменаЭТРН, МассивЛогаСобытий);
		Если НЕ Сервер = Неопределено тогда
			Сервер.Записать(ПолноеИмяФайла, ПрофильОбмена.ИсходящийПутьFTP + КраткоеИмяФайла);
			Результат = Истина;
		Иначе
			ТекстЛогаСобытий = "Ошибка отправки файла - " + КраткоеИмяФайла;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, "Отправка файла по FTP");
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		КонецЕсли;
	КонецПопытки;
	
	Возврат Результат;    
КонецФункции

Процедура ОтправитьФайлы(ОбщийМассивФайлов, ТипДокумента, МассивЛогаСобытий, ЭтоРегламентноеЗадание, ЭтоНовыеДокументы, СтруктураЛога) Экспорт
	
	ТекущаяДата = ТекущаяДатаСеанса();
	
	ИмяСобытия = "Отправка документов " + ТипДокумента;
	ФормаИндикации   = Неопределено;
	КоличествоФайлов = ОбщийМассивФайлов.Количество();
	Если КоличествоФайлов = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВременныйКаталог = ПутьВременногоКаталогаЭКОМ("Send_file");
	
	КаталогВременный = ЭКОМ_СоздатьКаталогПроверитьНаЗапись(ВременныйКаталог, МассивЛогаСобытий);	
	Если КаталогВременный = Неопределено Тогда		
		Возврат;		
	КонецЕсли;
	
	СлужебныйТипФормы = Настройка_Параметр_Прочитать("СлужебныйТипФормы", "ОбычнаяФорма", "Служебный");
	
	ТипОбменаЭТРН = Ложь;
	Если ТипДокумента = "WHGOV_01_Исходящий"  
		ИЛИ ТипДокумента = "WHGOU_04_Исходящий" 
		ИЛИ ТипДокумента = "WHGPV_05_Исходящий"  
		ИЛИ ТипДокумента = "WHGPU_08_Исходящий" Тогда	
		ТипОбменаЭТРН = Истина;
	КонецЕсли;
	
	Если ЭКОМ_ОбщегоНазначения.ИспользуетсяОтправкаВMarking() Тогда
		ЛокальныйКаталогMarking = ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере("ЭКОМ_Локальный_Каталог_Marking", "", Неопределено, Истина);
		Если ЗначениеЗаполнено(ЛокальныйКаталогMarking) Тогда
			ДополнитьАдресКаталога(ЛокальныйКаталогMarking);
			КаталогMarkingДоступен  = ЭКОМ_ОбщегоНазначения.ЭКОМ_СоздатьКаталогПроверитьНаЗапись(ЛокальныйКаталогMarking, МассивЛогаСобытий);
			КаталогMarkingАрхив     = ЛокальныйКаталогMarking + "docrobot_архив\";
		Иначе
			КаталогMarkingДоступен = Ложь;
		КонецЕсли;
		Если Не КаталогMarkingДоступен Тогда
			ТекстЛогаСобытий = "Проверьте каталог ""marking"""; 
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			ЭКОМ_ОбщегоНазначения.ЗаписатьЛогСобытийвРегистрЛогирование(МассивЛогаСобытий);
			Возврат;
		КонецЕсли;
	Иначе
		ЛокальныйКаталогMarking = ВременныйКаталог;
		КаталогMarkingАрхив 	= ВременныйКаталог;				
	КонецЕсли;
	
	// Разделим файлы для отправки
	СоответствиеПрофилей = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЭКОМ_GLN.ПрофильОбмена КАК ПрофильОбмена,
	|	ЭКОМ_GLN.Объект КАК Организация
	|ИЗ
	|	РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN
	|ГДЕ
	|	НЕ ЭКОМ_GLN.ПрофильОбмена = ЗНАЧЕНИЕ(Справочник.ЭКОМ_ПрофилиОбмена.ПустаяСсылка)
	|	И НЕ ЭКОМ_GLN.ПрофильОбмена.ПометкаУдаления
	|	И ЭКОМ_GLN.ПрофильОбмена.Активный = ИСТИНА
	|ИТОГИ ПО
	|	ПрофильОбмена";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		ВыборкаПрофильОбмена = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПрофильОбмена.Следующий() Цикл
			ПрофильОбмена = ВыборкаПрофильОбмена.ПрофильОбмена;
			МассивПоПрофилям = Новый Массив;
			Выборка = ВыборкаПрофильОбмена.Выбрать();
			Пока Выборка.Следующий() Цикл				
				Для каждого СтрокаМассива Из ОбщийМассивФайлов Цикл	
					Если СтрокаМассива.Организация = Выборка.Организация Тогда
						МассивПоПрофилям.Добавить(СтрокаМассива);
					КонецЕсли;
				КонецЦикла;		
			КонецЦикла;	
			СоответствиеПрофилей.Вставить(ПрофильОбмена, МассивПоПрофилям);
		КонецЦикла;	 
	Иначе
		ТекстЛогаСобытий = "Выберите в настройках профиль обмена по организации.
		                   |Не заполнен Активный профиль обмена в справочнике <<<Профили обмена>>>!";	
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
	КонецЕсли;
	
	Для каждого КлючЗначение Из СоответствиеПрофилей Цикл
		ПрофильОбмена = КлючЗначение.Ключ; 
		МассивФайловВсего = КлючЗначение.Значение;
		
		Если МассивФайловВсего.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ИспользоватьREST = Ложь;
		Если ПрофильОбмена.ОбменREST Тогда
			ИспользоватьREST = Истина;
		КонецЕсли;
		
		Если ТипОбменаЭТРН = Истина Тогда
			знИспользоватьАПИ = ПрофильОбмена.ЭТРН_ОбменПоSOAP;
			ИспользоватьREST  = Ложь;
		Иначе
			знИспользоватьАПИ = ПрофильОбмена.ОбменПоSOAP;
		КонецЕсли;
		

		
		НаправитьЮЗДВMarking 	      = ПрофильОбмена.ОтправлятьУПДВMarking И ТипДокумента = "ЮЗД";
		ФайлыКОтправкеИзМаркировки    = НайтиФайлы(ЛокальныйКаталогMarking + "обработанные", "ON_NSCHFDOPPR*.xml");
		ТребуетсяОтправкаИзМаркировки = ФайлыКОтправкеИзМаркировки.Количество() > 0;
		
		
		Если МассивФайловВсего.Количество() = 0 И (Не ТребуетсяОтправкаИзМаркировки ИЛИ ПрофильОбмена.ПроверятьФайлыЛокально) Тогда
			Продолжить;
		ИначеЕсли МассивФайловВсего.Количество() = 0 И ТребуетсяОтправкаИзМаркировки Тогда
			ОтправитьФайлыИзMarking(знИспользоватьАПИ, ВременныйКаталог, ЛокальныйКаталогMarking, КаталогMarkingАрхив, 
									ФайлыКОтправкеИзМаркировки, ТипДокумента, ПрофильОбмена, ТипОбменаЭТРН, МассивЛогаСобытий);
			Продолжить;			
		КонецЕсли;
		
		Если СлужебныйТипФормы = "ОбычнаяФорма" 
			И ЭтоРегламентноеЗадание = Ложь Тогда
			ФормаИндикации = ЭтотОбъект.ПолучитьФорму("ХодВыполненияОбработкиДанных",, "a763cfbb-f94f-4c67-8e13-0e96a3260919");
		КонецЕсли;
		
		Если СлужебныйТипФормы = "ОбычнаяФорма" 
			И ЭтоРегламентноеЗадание = Ложь Тогда
			ФормаИндикации.МаксимальноеЗначение = КоличествоФайлов;
		КонецЕсли;
		
		ВидыДокументовEDI = Новый Массив;
		ВидыДокументовEDI.Добавить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.ORDER_Исходящий"));
		ВидыДокументовEDI.Добавить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.ORDER_Входящий"));
		ВидыДокументовEDI.Добавить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.RETORD_Исходящий"));//Docrobot 1.21.0 MOD-1648[оно тут наверняка надо]
		ВидыДокументовEDI.Добавить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.ORDRSP_Исходящий"));
		ВидыДокументовEDI.Добавить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.ORDRSP_Входящий"));
		ВидыДокументовEDI.Добавить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.DESADV_Исходящий"));
		ВидыДокументовEDI.Добавить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.DESADV_Входящий"));
		ВидыДокументовEDI.Добавить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.DESSCC_Исходящий"));
		ВидыДокументовEDI.Добавить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.DESSCC_Входящий"));
		ВидыДокументовEDI.Добавить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.RECADV_Исходящий"));
		ВидыДокументовEDI.Добавить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.RECADV_Входящий"));
		ВидыДокументовEDI.Добавить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.RETANN_Исходящий"));
		ВидыДокументовEDI.Добавить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.RETANN_Входящий"));
		ВидыДокументовEDI.Добавить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.RETINS_Исходящий"));
		ВидыДокументовEDI.Добавить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.RETINS_Входящий"));
		ВидыДокументовEDI.Добавить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.INSDES_Исходящий"));
		ВидыДокументовEDI.Добавить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.INSDES_Входящий"));
		ВидыДокументовEDI.Добавить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.INVOICE"));
		ВидыДокументовEDI.Добавить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.STATUS"));
		
		Если ПрофильОбмена.ПроверятьФайлыЛокально = Ложь Тогда
			ЭтоКазахстан = ПрофильОбмена.Страна = "kz";

			Если ИспользоватьREST Тогда	
				Если ЭтоКазахстан Тогда
					ДобавитьЗаписьВМассивЛога(МассивЛогаСобытий, "Использование REST API недоступно для региона - kz", Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);  					
					Возврат;
				КонецЕсли;
				ОтправитьДокументыИспользуяАтоллАПИ(МассивФайловВсего, ПрофильОбмена, ТипДокумента, ВременныйКаталог, МассивЛогаСобытий);				
			ИначеЕсли знИспользоватьАПИ Тогда
				
				
				// Делим файлы на пакеты для отправки по SOAP - ограничение веб сервиса
				ПакетФайлов = Новый Структура;
				
				НомерПоПорядку	= 0;
				Соответствие   	= Новый Соответствие;
				КоличествоФайловВПакете = ?(ПрофильОбмена.КоличествоФайловВПакете = 0, 500, ПрофильОбмена.КоличествоФайловВПакете);
				
				Для Каждого Элемент Из МассивФайловВсего Цикл
					
					НомерПоПорядку = НомерПоПорядку + 1;
					Соответствие.Вставить(Элемент, НомерПоПорядку);
					
					Если Соответствие.Количество() = КоличествоФайловВПакете Тогда
						ПакетФайлов.Вставить("Часть" + Формат(ПакетФайлов.Количество() + 1, "ЧГ=0"), Соответствие);
						Соответствие = Новый Соответствие;
					КонецЕсли;
					
				КонецЦикла;
				
				// Добавляем последний пакет, если он не был добавлен в цикле (неполный пакет).
				Если НЕ Соответствие.Количество() = КоличествоФайловВПакете
					И НЕ Соответствие.Количество() = 0 Тогда
					ПакетФайлов.Вставить("Часть" + Формат(ПакетФайлов.Количество() + 1, "ЧГ=0"), Соответствие);
				КонецЕсли;
				
				Для каждого ЭлементПакета Из ПакетФайлов Цикл
					
					МассивФайлов = Новый Массив;
					Для каждого ЭлИменаФайлов Из ЭлементПакета.Значение Цикл
						МассивФайлов.Добавить(ЭлИменаФайлов.Ключ);
					КонецЦикла;
					
					Если ЭтоКазахстан Тогда
						
						Для Каждого СтруктураEDI Из МассивФайлов Цикл					
							
							ФайлXML = ПолучитьФайлДокумента(СтруктураEDI, ВременныйКаталог);						
							Если ФайлXML = Неопределено Тогда
								Продолжить;
							КонецЕсли;
							ДвоичныеДанныеФайлаXML = Новый ДвоичныеДанные(ФайлXML.ПолноеИмя);
							
							ОдноИмяФайла = Новый Массив;
							ОдноИмяФайла.Добавить(ФайлXML.Имя);
							
							Рез	= Вычислить("ЭКОМ_ОбщегоНазначения.НовыйSOAPОбращение(ПрофильОбмена, ""sendDoc"", ОдноИмяФайла, ДвоичныеДанныеФайлаXML, МассивЛогаСобытий)");							
							Если Рез.errorCode = "" Тогда							
								ТекстЛогаСобытий = "Нет данных об ответе или ответ сформирован не верно";		
								ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
								МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
								
								Возврат;
								
							ИначеЕсли Рез.errorCode = "0" Тогда			
								
								СтруктураEDI.Сообщение = " успешно отправлен по API";
								ВидДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.ПустаяСсылка");
								Если СтруктураEDI.Свойство("ВидДокумента", ВидДокумента)
									И НЕ ВидыДокументовEDI.Найти(ВидДокумента) = Неопределено Тогда
									СтруктураEDI.Отправлен = ПредопределенноеЗначение("Перечисление.ЭКОМ_СтатусыЭлектронныхДокументов.Отправлен");
								Иначе
									СтруктураEDI.Отправлен = Истина;
								КонецЕсли;
								
								
							Иначе							
								// Все документы не отправлены. Сообщаем об этом.			
								ТекстЛогаСобытий = "Ошибка отправки файла " + СтруктураEDI.ИмяФайлаXML;
								ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
								МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
								
							КонецЕсли;
							
						КонецЦикла;	
						
					Иначе
						// Создаем архив с файлами для отправки по SOAP
						Если ВерсияПлатформы() >= 83100 Тогда // Начиная с версии 8.3.10 доступна запись в поток в памяти
							ИмяZipФайла = "";
							ЗаписьZIP   = Новый ЗаписьZipФайла();
						Иначе
							ИмяZipФайла =  ВременныйКаталог + ТипДокумента + "_" + ЭлементПакета.Ключ + "_" + Формат(ТекущаяДатаСеанса(), "ДФ=ddMMyyhhmmss" ) + ".zip";
							ЗаписьZIP   = Новый ЗаписьZipФайла(
								ИмяZipФайла,
								"", // пароль на архив (оставим пустой)
								"Этот архив создан из 1с", // комментарий к архиву
								МетодСжатияZIP.Сжатие, // сжатие или копирование
								УровеньСжатияZIP.Оптимальный,
								МетодШифрованияZIP.Zip20
								);
						КонецЕсли;
						
						Для Каждого УПДМаркировка Из ФайлыКОтправкеИзМаркировки Цикл
							ЗаписьZIP.Добавить(УПДМаркировка.ПолноеИмя);
							Попытка
								КопироватьФайл(УПДМаркировка.ПолноеИмя, КаталогMarkingАрхив + УПДМаркировка.Имя);
								УдалитьФайлы(УПДМаркировка.ПолноеИмя);
							Исключение
								ТекстЛогаСобытий = ОписаниеОшибки();
								МассивЛогаСобытий.Добавить(ТекстЛогаСобытий);
							КонецПопытки 
						КонецЦикла;
						
						ФайлыКУдалению = Новый Массив;
						
						Если ТипДокумента = "ЮЗД" 
							ИЛИ ТипДокумента = "DP_REZRUISP"
							ИЛИ Найти(ТипДокумента, "CONDRA") > 0 Тогда  
							
							Для Каждого СтруктураEDI Из МассивФайлов Цикл					
								
								ФайлЗаписан  = Ложь; 
								ОшибкаЗаписи = Ложь;
								ПередатьФайлВMarking(ФайлЗаписан, ОшибкаЗаписи, СтруктураEDI, НаправитьЮЗДВMarking, ЛокальныйКаталогMarking, ВидыДокументовEDI, ВременныйКаталог);
								Если ФайлЗаписан ИЛИ ОшибкаЗаписи Тогда
									Продолжить;
								КонецЕсли;
								
								НеобходимаПодпись = Ложь;
								ФайлBIN = ПолучитьФайлПодписи(СтруктураEDI, НеобходимаПодпись, ВременныйКаталог);						
								Если НеобходимаПодпись = Истина 
									И ФайлBIN = Неопределено Тогда
									Продолжить;
								КонецЕсли;
								
								ФайлДанных = Неопределено;
								Если СтруктураEDI.Свойство("ИмяФайлаДанных") Тогда
									ПолноеИмяФайлаДанных = ВременныйКаталог + СтруктураEDI.ИмяФайлаДанных;
									СтруктураEDI.ДвоичныеДанныеФайлаДанных.Записать(ПолноеИмяФайлаДанных);
									
									ФайлДанных = Новый Файл(ПолноеИмяФайлаДанных);
									Если НЕ ФайлДанных.Существует() Тогда
										ФайлДанных = Неопределено;
									КонецЕсли;
									СтруктураEDI.Вставить("ПолноеИмяФайлаДанных", ПолноеИмяФайлаДанных);
								КонецЕсли;
								
								ФайлXML = ПолучитьФайлДокумента(СтруктураEDI, ВременныйКаталог);						
								Если ФайлXML = Неопределено Тогда
									Продолжить;
								КонецЕсли;
								
								// Создаем архив с файлами ЮЗД
								ИмяZipФайлаЮЗД = ВременныйКаталог + ФайлXML.ИмяБезРасширения + ".zip";
								ЗаписьZIP_ЮЗД  = Новый ЗаписьZipФайла(
								ИмяZipФайлаЮЗД,
								"", // пароль на архив (оставим пустой)
								"Этот архив создан из 1с", // комментарий к архиву
								МетодСжатияZIP.Сжатие, // сжатие или копирование
								УровеньСжатияZIP.Оптимальный,
								МетодШифрованияZIP.Zip20
								);
								ФайлыКУдалению.Добавить(ИмяZipФайлаЮЗД);
								
								Если Найти(ТипДокумента, "CONDRA") > 0 Тогда
									// Переименовываем xml файл в condra.xml
									ПереместитьФайл(ФайлXML.ПолноеИмя, ФайлXML.Путь + "condra.xml");
									ЗаписьZIP_ЮЗД.Добавить(ФайлXML.Путь + "condra.xml");
								Иначе
									ЗаписьZIP_ЮЗД.Добавить(ФайлXML.ПолноеИмя);
								КонецЕсли;
								
								Если НЕ ФайлBIN = Неопределено Тогда
									ЗаписьZIP_ЮЗД.Добавить(ФайлBIN.ПолноеИмя);
								КонецЕсли;
								
								Если НЕ ФайлДанных = Неопределено Тогда
									ЗаписьZIP_ЮЗД.Добавить(ФайлДанных.ПолноеИмя);
								КонецЕсли;
								
								ЗаписьZIP_ЮЗД.Записать();
								
								Если Найти(ТипДокумента, "CONDRA") > 0 Тогда
									// Возвращаем старое название файлу xml.
									ПереместитьФайл(ФайлXML.Путь + "condra.xml", ФайлXML.ПолноеИмя);
								КонецЕсли;
								
								ЗаписьZIP.Добавить(ИмяZipФайлаЮЗД);
								СтруктураEDI.Вставить("ИмяАрхива", ИмяZipФайлаЮЗД);
								
							КонецЦикла;
							
						Иначе	
							
							Для Каждого СтруктураEDI Из МассивФайлов Цикл					
								
								НеобходимаПодпись = Ложь;
								ФайлBIN = ПолучитьФайлПодписи(СтруктураEDI, НеобходимаПодпись, ВременныйКаталог);						
								Если НеобходимаПодпись = Истина 
									И ФайлBIN = Неопределено Тогда
									Продолжить;
								КонецЕсли;
								
								ФайлXML = ПолучитьФайлДокумента(СтруктураEDI, ВременныйКаталог);						
								Если ФайлXML = Неопределено Тогда
									Продолжить;
								КонецЕсли;
								
								Если ПрофильОбмена.ОтправлятьУПДВMarking И ТипДокумента = "ORDRSP" Тогда
									ФайлXMLMark = ПолучитьФайлДокумента(СтруктураEDI, ЛокальныйКаталогMarking);						
								КонецЕсли;
								
								ЗаписьZIP.Добавить(ФайлXML.ПолноеИмя);
								Если НеобходимаПодпись = Истина Тогда
									ЗаписьZIP.Добавить(ФайлBIN.ПолноеИмя);				
								КонецЕсли;
							КонецЦикла;	
							
						КонецЕсли;      
						
						Если ВерсияПлатформы() >= 83100 Тогда
							ДвоичныеДанные = Вычислить("ЗаписьZIP.ПолучитьДвоичныеДанные()");
						Иначе
							ЗаписьZIP.Записать();
							ДвоичныеДанные = Новый ДвоичныеДанные(ИмяZipФайла);	
						КонецЕсли;
						
						Рез	= Вычислить("ЭКОМ_ОбщегоНазначения.НовыйSOAPОбращение(ПрофильОбмена, ""sendDocumentsRequest"", , ДвоичныеДанные, МассивЛогаСобытий)");
						
						// Удалим файлы.
						Попытка         
							Если НЕ ПустаяСтрока(ИмяZipФайла) Тогда
								УдалитьФайлы(ИмяZipФайла);
							КонецЕсли;
						Исключение
							ТекстЛогаСобытий = ОписаниеОшибки();
							ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
							МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
						КонецПопытки;
						
						// Удаление дополнительных файлов (касается ЮЗД, которые предварительно записываются в архив, за исключением "CONDRA").
						Если НЕ ТипДокумента = "CONDRA" Тогда 
							Для Каждого ИмяФайла Из ФайлыКУдалению Цикл
								Попытка
									УдалитьФайлы(ИмяФайла);
								Исключение
									ТекстЛогаСобытий = ОписаниеОшибки();
									ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
									МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
								КонецПопытки;
							КонецЦикла;
						КонецЕсли;
						
						Если Рез.errorCode = "" Тогда						
							ТекстЛогаСобытий = "Нет данных об ответе или ответ сформирован не верно";		
							ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
							МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
							
							Возврат;
							
						ИначеЕсли Рез.errorCode = "0" Тогда			
							Для Каждого СтруктураEDI Из МассивФайлов Цикл
								Если СтруктураEDI.Сообщение = " записан в локальный каталог marking"
									ИЛИ СтруктураEDI.Сообщение = " записан во временный каталог" Тогда
									Продолжить;
								КонецЕсли; 
								
								СтруктураEDI.Сообщение = " успешно отправлен по API";
								ВидДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.ПустаяСсылка");
								Если СтруктураEDI.Свойство("ВидДокумента", ВидДокумента)
									И НЕ ВидыДокументовEDI.Найти(ВидДокумента) = Неопределено Тогда
									СтруктураEDI.Отправлен = ПредопределенноеЗначение("Перечисление.ЭКОМ_СтатусыЭлектронныхДокументов.Отправлен");
								Иначе
									СтруктураEDI.Отправлен = Истина;
								КонецЕсли;
							КонецЦикла;
						Иначе
							// Все документы не отправлены. Сообщаем об этом.
							Для Каждого СтруктураEDI Из МассивФайлов Цикл	
								Если СтруктураEDI.Сообщение = " записан в локальный каталог marking" 
									ИЛИ СтруктураEDI.Сообщение = " записан во временный каталог" Тогда
									Продолжить;
								КонецЕсли;
								
								ТекстЛогаСобытий = "Ошибка отправки файла " + СтруктураEDI.ИмяФайлаXML;
								ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
								МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

							КонецЦикла;	
						КонецЕсли;
						
					КонецЕсли;	
				КонецЦикла;
				
			Иначе
				// Отправим на сервер по FTP
				Сервер = ПолучитьFTPСоединениеВОбработке(ПрофильОбмена, ТипОбменаЭТРН, МассивЛогаСобытий);	
				Если Сервер = Неопределено Тогда
					ТекстЛогаСобытий = "Отсутствует подключение к FTP!";
					ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
					МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

					Возврат;
				КонецЕсли;
				
				Для Каждого УПДМаркировка Из ФайлыКОтправкеИзМаркировки Цикл

					ФайлОтправлен = ОтправитьФайлыВНужномФорматеПоТипуДокументаПоFTP(УПДМаркировка, Неопределено, ТипДокумента, Сервер, ЛокальныйКаталогMarking, МассивЛогаСобытий, ПрофильОбмена, ТипОбменаЭТРН, , СтруктураEDI);
					
					Попытка
						КопироватьФайл(УПДМаркировка.ПолноеИмя, КаталогMarkingАрхив + УПДМаркировка.Имя);
						УдалитьФайлы(УПДМаркировка.ПолноеИмя);
					Исключение
						ТекстЛогаСобытий = ОписаниеОшибки();
						МассивЛогаСобытий.Добавить(ТекстЛогаСобытий);
					КонецПопытки 				
				КонецЦикла;
				
				Для Каждого СтруктураEDI Из МассивФайловВсего Цикл
					
					ФайлЗаписан  = Ложь; 
					ОшибкаЗаписи = Ложь;
					ПередатьФайлВMarking(ФайлЗаписан, ОшибкаЗаписи, СтруктураEDI, НаправитьЮЗДВMarking, ЛокальныйКаталогMarking, ВидыДокументовEDI, ВременныйКаталог);
					Если ФайлЗаписан ИЛИ ОшибкаЗаписи Тогда
						Продолжить;
					КонецЕсли;
					
					НеобходимаПодпись = Ложь;
					ФайлBIN = ПолучитьФайлПодписи(СтруктураEDI, НеобходимаПодпись, ВременныйКаталог);						
					Если НеобходимаПодпись = Истина 
						И ФайлBIN = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					ФайлXML = ПолучитьФайлДокумента(СтруктураEDI, ВременныйКаталог);						
					Если ФайлXML = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					Если ПрофильОбмена.ОтправлятьУПДВMarking И ТипДокумента = "ORDRSP" Тогда
						ФайлXMLMark = ПолучитьФайлДокумента(СтруктураEDI, ЛокальныйКаталогMarking);						
					КонецЕсли; 
					
					//MOD-2544
					ФайлДанных = Неопределено;
					
					Если Найти(ТипДокумента, "CONDRA") > 0 Тогда  
						
						Если СтруктураEDI.Свойство("ДанныеФайла") Тогда
						
							ПолноеИмяФайлаДанных = ВременныйКаталог + СтруктураEDI.ИмяФайла;
							ДвоичныеДанныеФайлаДанных = СтруктураEDI.ДанныеФайла.Получить();
							ДвоичныеДанныеФайлаДанных.Записать(ПолноеИмяФайлаДанных);
							
							ФайлДанных = Новый Файл(ПолноеИмяФайлаДанных);
							Если НЕ ФайлДанных.Существует() Тогда
								ФайлДанных = Неопределено;
							КонецЕсли;
							СтруктураEDI.Вставить("ПолноеИмяФайлаДанных", ПолноеИмяФайлаДанных);

						ИначеЕсли СтруктураEDI.Свойство("ИмяФайлаДанных") Тогда
							
							ПолноеИмяФайлаДанных = ВременныйКаталог + СтруктураEDI.ИмяФайлаДанных;
							СтруктураEDI.ДвоичныеДанныеФайлаДанных.Записать(ПолноеИмяФайлаДанных);
							
							ФайлДанных = Новый Файл(ПолноеИмяФайлаДанных);
							Если НЕ ФайлДанных.Существует() Тогда
								ФайлДанных = Неопределено;
							КонецЕсли;
							СтруктураEDI.Вставить("ПолноеИмяФайлаДанных", ПолноеИмяФайлаДанных);
							
						КонецЕсли;
						
					КонецЕсли;
					//-MOD-2544
					
					ФайлОтправлен = ОтправитьФайлыВНужномФорматеПоТипуДокументаПоFTP(ФайлXML, ФайлBIN, ТипДокумента, Сервер, ВременныйКаталог, МассивЛогаСобытий, ПрофильОбмена, ТипОбменаЭТРН, ФайлДанных, СтруктураEDI); //MOD-2544
					
					Если ФайлОтправлен = Истина Тогда
						СтруктураEDI.Сообщение = " успешно отправлен по FTP в каталог outbox";
						ВидДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.ПустаяСсылка");
						Если СтруктураEDI.Свойство("ВидДокумента", ВидДокумента)
							И НЕ ВидыДокументовEDI.Найти(ВидДокумента) = Неопределено Тогда
							СтруктураEDI.Отправлен = ПредопределенноеЗначение("Перечисление.ЭКОМ_СтатусыЭлектронныхДокументов.Отправлен");
						Иначе
							СтруктураEDI.Отправлен = Истина;
						КонецЕсли; 
						
					КонецЕсли;
					
				КонецЦикла; 
				
			КонецЕсли;		
			
			// Локально
		Иначе
			Для Каждого СтруктураEDI Из МассивФайловВсего Цикл
				
				ФайлЗаписан  = Ложь; 
				ОшибкаЗаписи = Ложь;
				ПередатьФайлВMarking(ФайлЗаписан, ОшибкаЗаписи, СтруктураEDI, НаправитьЮЗДВMarking, ЛокальныйКаталогMarking, ВидыДокументовEDI, ВременныйКаталог);
				Если ФайлЗаписан ИЛИ ОшибкаЗаписи Тогда
					Продолжить;
				КонецЕсли;
				
				СохранятьУПДЛокальноБезПодписи = ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере("ЭКОМ_СохранятьУПДЛокальноБезПодписи");
				Если СохранятьУПДЛокальноБезПодписи = Неопределено ИЛИ
					Не ТипЗнч(СохранятьУПДЛокальноБезПодписи) = Тип("Булево")
					ИЛИ Не СохранятьУПДЛокальноБезПодписи Тогда 					
					НеобходимаПодпись = Ложь;
					ФайлBIN = ПолучитьФайлПодписи(СтруктураEDI, НеобходимаПодпись, ВременныйКаталог);						
					Если НеобходимаПодпись = Истина 
						И ФайлBIN = Неопределено Тогда
						Продолжить;
					КонецЕсли;    					
				КонецЕсли;
				
				ФайлXML = ПолучитьФайлДокумента(СтруктураEDI, ВременныйКаталог);						
				Если ФайлXML = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				СтруктураEDI.Сообщение = " записан в локальный каталог outbox";
				ВидДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.ПустаяСсылка");
				Если СтруктураEDI.Свойство("ВидДокумента", ВидДокумента)
					И НЕ ВидыДокументовEDI.Найти(ВидДокумента) = Неопределено Тогда
					СтруктураEDI.Отправлен = ПредопределенноеЗначение("Перечисление.ЭКОМ_СтатусыЭлектронныхДокументов.Отправлен");
				Иначе
					СтруктураEDI.Отправлен = Истина;
				КонецЕсли;
				
				
			КонецЦикла;	
		КонецЕсли;
		
		НомПП = 0;
		Для Каждого СтруктураEDI Из МассивФайловВсего Цикл			
			
			Если СтруктураEDI.Отправлен = ПредопределенноеЗначение("Перечисление.ЭКОМ_СтатусыЭлектронныхДокументов.Отправлен")
				ИЛИ СтруктураEDI.Отправлен = Истина Тогда
				
				НомПП = НомПП + 1;
				
				Если Найти(ТипДокумента, "CONDRA") > 0 Тогда // Для кондры используем другой регистр.
					
					Если ПустаяСтрока(СтруктураEDI.Идентификатор) Тогда
						ТекстЛогаСобытий = "Ошибка отправки файла " + СтруктураEDI.ИмяФайлаXML + ". Не указан идентификатор цепочки (TRANSGUID).";
						ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
						МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
						
					Иначе
						
						МенеджерЗаписи = РегистрыСведений.ЭКОМ_ЦепочкиНеструктурированныхДокументов.СоздатьМенеджерЗаписи();
						МенеджерЗаписи.TRANSGUID 			= СтруктураEDI.Идентификатор;
						//МенеджерЗаписи.НаправлениеОбмена 	= ПредопределенноеЗначение("Перечисление.ЭКОМ_НаправлениеОбмена.Исходящий");
						МенеджерЗаписи.Прочитать();
						
						Если МенеджерЗаписи.Выбран() Тогда
							МенеджерЗаписи.Статус = СтруктураEDI.Статус;
							МенеджерЗаписи.Действие = Перечисления.ЭКОМ_ТребуемоеДействиеCONDRA[Строка(СтруктураEDI.Статус)];
							МенеджерЗаписи.ДатаПоследнейТранзакции = ТекущаяДатаСеанса();
							МенеджерЗаписи.Записать();
							СтруктураEDI.Вставить("Документ", МенеджерЗаписи.ДокументОригинала);
							// Удаление записи с данными после первой отправки.
							МенеджерЗаписи = РегистрыСведений.ЭКОМ_НеструктурированныеДокументы.СоздатьМенеджерЗаписи();
							МенеджерЗаписи.TRANSGUID = СтруктураEDI.Идентификатор;
							МенеджерЗаписи.Прочитать();
							Если МенеджерЗаписи.Выбран() Тогда
								МенеджерЗаписи.Удалить();
							КонецЕсли;
						КонецЕсли;
						
					КонецЕсли;
					
				Иначе
					
					Структура = Новый Структура; 
					Структура.Вставить("ДатаЗаписи",        ТекущаяДатаСеанса());
					Структура.Вставить("Контрагент",        СтруктураEDI.Контрагент);
					Структура.Вставить("Организация",       СтруктураEDI.Организация);
					Структура.Вставить("ЗаказДата",         СтруктураEDI.ЗаказДата);					
					Структура.Вставить("ЗаказНомер",        СтруктураEDI.ЗаказНомер);
					Структура.Вставить("НаправлениеОбмена", Перечисления.ЭКОМ_НаправлениеОбмена.Исходящий);
					Структура.Вставить("ФайлИмя",           СтруктураEDI.ИмяФайлаXML);
					Структура.Вставить("Статус",            СтруктураEDI.Статус);
					Структура.Вставить("СтатусЭлектронногоДокумента", СтруктураEDI.Отправлен);
					Структура.Вставить("ИдентификаторИспр", ?(СтруктураEDI.Свойство("ИдентификаторИспр"), СтруктураEDI.ИдентификаторИспр, ""));
					Структура.Вставить("Идентификатор",     СтрЗаменить(СтруктураEDI.ИмяФайлаXML, ".xml", ""));
					Структура.Вставить("СтруктураФайла",    Новый ХранилищеЗначения(СтруктураEDI.СтруктураДокумента,  Новый СжатиеДанных(9)));
					Структура.Вставить("НомерДокумента",    СтруктураEDI.НомерДокумента);
					Структура.Вставить("ДатаДокумента",     СтруктураEDI.ДатаДокумента);
					
					Если СтруктураEDI.Свойство("ДвоичныеДанныеФайлаBIN") Тогда
						ЭЦПотКвитанции = СтруктураEDI.ДвоичныеДанныеФайлаBIN;
						Структура.Вставить("ЭЦП", Новый ХранилищеЗначения(ЭЦПотКвитанции, Новый СжатиеДанных(9)));
					КонецЕсли;
					
					ПроверитьУдалитьСтарыеКвитанции(СтруктураEDI.Документ, СтруктураEDI.ВидДокумента);
					ЭКОМ_Объекты_События_Записать(СтруктураEDI.Документ, СтруктураEDI.ВидДокумента, Структура);	
					
				КонецЕсли;
				
				ПредставлениеДокумента = Строка(СтруктураEDI.Документ);
				
				Если СлужебныйТипФормы = "ОбычнаяФорма" 
					И ЭтоРегламентноеЗадание = Ложь Тогда
					ФормаИндикации.КомментарийЗначения = "Обрабатывается документ: " + ПредставлениеДокумента;
					ФормаИндикации.Значение = ФормаИндикации.Значение + 1;
				КонецЕсли;
				
				ТекстЛогаСобытий = "Отправка № " + Строка(НомПП) + " из " + Строка(КоличествоФайлов) + " " + ПредставлениеДокумента 
				+ " файл [" + СтруктураEDI.ИмяФайлаXML + "] " + СтруктураEDI.Сообщение;
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Успешно, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

			КонецЕсли;
			
			// Удалим файл  
			Попытка
				
				Если СтруктураEDI.Свойство("ПолноеИмяФайлаXML") И Не ПрофильОбмена.ОтправлятьУПДВMarking Тогда
					ФайлXML = Новый Файл(СтруктураEDI.ПолноеИмяФайлаXML);			
					Если ФайлXML.Существует() Тогда
						УдалитьФайлы(ФайлXML.ПолноеИмя);
					КонецЕсли;
				КонецЕсли;
				
				Если СтруктураEDI.Свойство("ПолноеИмяФайлаBIN") И Не ПрофильОбмена.ОтправлятьУПДВMarking Тогда
					ФайлBIN = Новый Файл(СтруктураEDI.ПолноеИмяФайлаBIN);
					Если ФайлBIN.Существует() Тогда
						УдалитьФайлы(ФайлBIN.ПолноеИмя);
					КонецЕсли;
				КонецЕсли;
				
				Если СтруктураEDI.Свойство("ПолноеИмяФайлаДанных") И Не ПрофильОбмена.ОтправлятьУПДВMarking Тогда
					ФайлДанных = Новый Файл(СтруктураEDI.ПолноеИмяФайлаДанных);
					Если ФайлДанных.Существует() Тогда
						УдалитьФайлы(ФайлДанных.ПолноеИмя);
					КонецЕсли;
				КонецЕсли;
				
			Исключение
			КонецПопытки;		
		КонецЦикла; 
		
		Если МассивЛогаСобытий.ВГраница() >= 0
			И КоличествоФайлов > 0 Тогда  
			ПоследняяЗаписьЛога = МассивЛогаСобытий.Получить(МассивЛогаСобытий.ВГраница());
		КонецЕсли;
		
		
	КонецЦикла;	
	
	НаправлениеОбмена = "Исходящий";
	Если ЭтоНовыеДокументы = Ложь Тогда
	     НаправлениеОбмена = "Исходящий_Повторно";
	КонецЕсли;

	Выполнить("ЭКОМ_ОбщегоНазначения.СнятьБлокировкуОперации(ТипДокумента, НаправлениеОбмена, МассивЛогаСобытий);");
	
КонецПроцедуры

// Проверяет наличие в ЭКОМ_Объекты_События записи с таким же ключем и если таковая находится,
//	удаляет записи, относящиеся к такому документу-основанию с указанным видом документа (MOD-1073)
//
// Параметры:
//  ДокументОснование  	- ДокументСсылка - измерение ЭКОМ_Объекты_События для отбора
//  ВидДокумента  		- ПеречислениеСсылка.ЭКОМ_ВидыДокументов - измерение ЭКОМ_Объекты_События для отбора
//
Процедура ПроверитьУдалитьСтарыеКвитанции(ДокументОснование, ВидДокумента)

	КоллекцияЮЗД = Новый Массив;
	КоллекцияЮЗД.Добавить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPR_01"));
	КоллекцияЮЗД.Добавить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPR_01_Испр"));
	КоллекцияЮЗД.Добавить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.ON_KORSCHFDOPPR_01"));
	КоллекцияЮЗД.Добавить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.ON_NKORSCHFDOPPR_01"));
	КоллекцияЮЗД.Добавить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.ON_KORSCHFDOPPR_01_Испр"));
	КоллекцияЮЗД.Добавить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.ON_NKORSCHFDOPPR_01_Испр"));
	
	Если НЕ КоллекцияЮЗД.Найти(ВидДокумента) = Неопределено Тогда
		
		ЗаписьИзРегистра = ЭКОМ_Объекты_События_Прочитать(ДокументОснование, ВидДокумента);
		Если НЕ ЗаписьИзРегистра.СведенияЕсть Тогда
			Возврат;
		КонецЕсли;
		
		НаборЗаписей = РегистрыСведений.ЭКОМ_Объекты_События.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Документ_Основание.Установить(ДокументОснование);
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		ЗаписиКУдалению = Новый ТаблицаЗначений;
		ЗаписиКУдалению.Колонки.Добавить("Документ_Основание");
		ЗаписиКУдалению.Колонки.Добавить("ВидДокумента");
		ЗаписиКУдалению.Колонки.Добавить("Идентификатор");
		ЗаписиКУдалению.Колонки.Добавить("Индекс");
		
		// Добавляем запись исходного документа.
		НоваяЗапись = ЗаписиКУдалению.Добавить();
		НоваяЗапись.Документ_Основание = ДокументОснование;
		НоваяЗапись.ВидДокумента = ВидДокумента;
		НоваяЗапись.Идентификатор = ЗаписьИзРегистра.Идентификатор;
		Для Каждого Запись Из НаборЗаписей Цикл
			Если Запись.Идентификатор = ЗаписьИзРегистра.Идентификатор Тогда
				НоваяЗапись.Индекс = НаборЗаписей.Индекс(Запись);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого Запись Из НаборЗаписей Цикл
			Если Запись.ИдентификаторИспр = ЗаписьИзРегистра.Идентификатор Тогда
				КУдалению = ЗаписиКУдалению.Добавить();
				ЗаполнитьЗначенияСвойств(КУдалению, Запись);
				КУдалению.Индекс = НаборЗаписей.Индекс(Запись);
			КонецЕсли;
		КонецЦикла;
		
		// Ищем записи, которые ссылаются на подчиненную исходному докумнету запись (актуально для квитанций в формате до 01.07.2021).
		Для Каждого Запись Из НаборЗаписей Цикл
			Если НЕ ЗаписиКУдалению.Найти(Запись.ИдентификаторИспр, "Идентификатор") = Неопределено Тогда
				КУдалению = ЗаписиКУдалению.Добавить();
				ЗаполнитьЗначенияСвойств(КУдалению, Запись);
				КУдалению.Индекс = НаборЗаписей.Индекс(Запись);
			КонецЕсли;
		КонецЦикла;
		
		ЗаписиКУдалению.Свернуть("Индекс");
		ЗаписиКУдалению.Сортировать("Индекс Убыв");
		
		Для Каждого Запись Из ЗаписиКУдалению Цикл
			НаборЗаписей.Удалить(Запись.Индекс);
		КонецЦикла;
		
		Если НаборЗаписей.Модифицированность() Тогда
			НаборЗаписей.Записать();
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры // ПроверитьУдалитьСтарыеКвитанции()

Функция Записать_Файл_ЮЗД_Извешение_О_Получении(пСтруктураДокумента, врФайл) Экспорт
		
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку("WINDOWS-1251");
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ЗаписьXML.ЗаписатьНачалоЭлемента("Файл");
	
	ЗаписьXML.ЗаписатьАтрибут("ВерсПрог", пСтруктураДокумента.ВерсПрог);
	ЗаписьXML.ЗаписатьАтрибут("ВерсФорм", пСтруктураДокумента.ВерсФорм);
	ЗаписьXML.ЗаписатьАтрибут("ИдФайл"	, пСтруктураДокумента.ИдФайл);
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("СвУчДокОбор");
	ЗаписьXML.ЗаписатьАтрибут("ИдПол"	, пСтруктураДокумента.ИдПол);       
	ЗаписьXML.ЗаписатьАтрибут("ИдОтпр"	, пСтруктураДокумента.ИдОтпр);
	ЗаписьXML.ЗаписатьНачалоЭлемента("СвОЭДОтпр");
	ЗаписьXML.ЗаписатьАтрибут("НаимОрг"	,  пСтруктураДокумента.НаимОргОператор);
	ЗаписьXML.ЗаписатьАтрибут("ИННЮЛ"	,  пСтруктураДокумента.ИННОператор);
	ЗаписьXML.ЗаписатьАтрибут("ИдЭДО"	,  пСтруктураДокумента.ИдЭДООператор);              
	ЗаписьXML.ЗаписатьКонецЭлемента(); //СвОЭДОтпрСФ
	ЗаписьXML.ЗаписатьКонецЭлемента(); //СвУчДокОбор
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("ИнфПок");
	ЗаписьXML.ЗаписатьАтрибут("КНД"				, пСтруктураДокумента.КНД);
	ЗаписьXML.ЗаписатьАтрибут("ДатаИнфПок"		, пСтруктураДокумента.ДатаИнфПок);
	ЗаписьXML.ЗаписатьАтрибут("ВремИнфПок"		, пСтруктураДокумента.ВремИнфПок);
	ЗаписьXML.ЗаписатьАтрибут("НаимЭконСубСост"	, пСтруктураДокумента.НаимЭконСубСост);
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("ИдИнфПрод");                                          	
	ЗаписьXML.ЗаписатьАтрибут("ИдФайлИнфПр"		,  пСтруктураДокумента.ИдФайлИнфПр);
	ЗаписьXML.ЗаписатьАтрибут("ДатаФайлИнфПр"	,  пСтруктураДокумента.ДатаФайлИнфПр);
	ЗаписьXML.ЗаписатьАтрибут("ВремФайлИнфПр"	,  пСтруктураДокумента.ВремФайлИнфПр);	
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("ЭП");
	ЗаписьXML.ЗаписатьТекст(пСтруктураДокумента.ЭЦППолФайл);
	ЗаписьXML.ЗаписатьКонецЭлемента();// ЭП
	
	ЗаписьXML.ЗаписатьКонецЭлемента();//ИдИнфПрод
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("СодФХЖ4");                                          
	ЗаписьXML.ЗаписатьАтрибут("НаимДокОпрПр"	,  пСтруктураДокумента.НаимДокОпрПр);
	ЗаписьXML.ЗаписатьАтрибут("Функция"			,  "СЧФДОП");
	ЗаписьXML.ЗаписатьАтрибут("НомСчФИнфПр"		,  пСтруктураДокумента.НомСчФИнфПр);
	ЗаписьXML.ЗаписатьАтрибут("ДатаСчФИнфПр"	,  пСтруктураДокумента.ДатаСчФИнфПр);
	ЗаписьXML.ЗаписатьАтрибут("ВидОперации"		,  пСтруктураДокумента.ВидОперации);
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("СвПрин"); 
	ЗаписьXML.ЗаписатьАтрибут("СодОпер"		,  пСтруктураДокумента.СодОпер);
	ЗаписьXML.ЗаписатьАтрибут("ДатаПрин"	,  пСтруктураДокумента.ДатаПрин);
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("КодСодОпер"); 
	ЗаписьXML.ЗаписатьАтрибут("КодИтога"	,  пСтруктураДокумента.КодИтога);

	ЗаписьXML.ЗаписатьКонецЭлемента();//КодСодОпер
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("СвЛицПрин"); 
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("РабОргПок"); 
	ЗаписьXML.ЗаписатьАтрибут("Должность"		,  пСтруктураДокумента.ОтпрДолжность);
	ЗаписьXML.ЗаписатьАтрибут("ОснПолн"			,  пСтруктураДокумента.лПодписантОснПолн);
	
