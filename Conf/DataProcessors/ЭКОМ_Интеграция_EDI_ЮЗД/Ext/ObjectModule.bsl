// Функция возвращает ссылку на ставку НДС - лучше не использовать эту функцию а определить ссылку в гибких настройках
Функция СтавкаНДССсылка(СтавкаНДС) Экспорт
	
	Если НЕ Метаданные.Перечисления.Найти("СтавкиНДС") = Неопределено Тогда		
		Если СтавкаНДС = 0 Тогда
			ЗначениеНалога = Перечисления.СтавкиНДС.БезНДС;
		ИначеЕсли СтавкаНДС = 10 Тогда
			ЗначениеНалога = Перечисления.СтавкиНДС.НДС10;
		ИначеЕсли СтавкаНДС = 18 Тогда
			ЗначениеНалога = Перечисления.СтавкиНДС.НДС18;
		ИначеЕсли СтавкаНДС = 20 Тогда
			ЗначениеНалога = Перечисления.СтавкиНДС.НДС20;	
		Иначе
			ЗначениеНалога = Перечисления.СтавкиНДС.БезНДС;
		КонецЕсли;		
	ИначеЕсли НЕ Метаданные.Справочники.Найти("СтавкиНДС") = Неопределено Тогда	
		ЗначениеНалога = Справочники.СтавкиНДС.НайтиПоРеквизиту("Ставка", СтавкаНДС);
	КонецЕсли;	
	
	Возврат ЗначениеНалога;
	
