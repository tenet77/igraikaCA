Функция ПолучитьЗначениеПеременнойКода(Знач ТекстКода, ИмяПеременной, МассивЛогаСобытий, Источник, НомерИсправленияНаФорме = "", Приемник  = Неопределено) Экспорт    
	ЗначениеПеременной = Неопределено;
	
	ТекстКода = ИмяПеременной + " = Неопределено;" + Символы.ПС + ТекстКода;
	
	ТекстКода = ?(ЗначениеЗаполнено(НомерИсправленияНаФорме), 
	"НомерИсправления = " + НомерИсправленияНаФорме + ";" + Символы.ПС + ТекстКода,
	"НомерИсправления = """";" + Символы.ПС + ТекстКода); 
	ТекстКода = СтрЗаменить(ТекстКода, "¶", Символы.ПС);
	
	KdkDssRtkv = Неопределено;
	ТекстКода = СтрЗаменить(ТекстКода, "Возврат "   , "KdkDssRtkv = ");
	
	PyfxtybtGthtvtyyjq = Неопределено; //значение переменной для возврата
	ТекстКода = ТекстКода + Символы.ПС + "//подмена для возврата переменной" + Символы.ПС + "PyfxtybtGthtvtyyjq = " + ИмяПеременной + ";";
	
	ТекстКода = ЗакомментироватьВТекстеКодаЗаписатьДляПеременной(ТекстКода, "Источник");
	ТекстКода = ЗакомментироватьВТекстеКодаЗаписатьДляПеременной(ТекстКода, "Приемник");
	
	Попытка
		Выполнить(ТекстКода);
		ТипЗначенияВозвращенныйИзТекстаКода = Строка(ТипЗнч(PyfxtybtGthtvtyyjq));
	Исключение
		ТекстЛогаСобытий = ОписаниеОшибки();
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, "Тестирование");
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

	КонецПопытки;
	
	Возврат PyfxtybtGthtvtyyjq;
КонецФункции 

Функция НайтиТекстыЗапросовВКоде(Знач ТекстКода, МассивЛогаСобытий, Источник, НомерИсправленияНаФорме = "", Приемник  = Неопределено) Экспорт
	Перем Htpekmnfn;
	Перем НомерИсправления;
	
	ИмяСобытия = "Тестирование";
	НомерИсправления = НомерИсправленияНаФорме;
	
	Htpekmnfn = Новый СписокЗначений;
	
	ПеременныеИзКода = НайтиПеременныеПоТипу(ТекстКода, "Новый Запрос", МассивЛогаСобытий);
	Для каждого ТекущаяПеременная Из ПеременныеИзКода Цикл
		ЗначениеПеременной = ПолучитьЗначениеПеременнойКода(ТекстКода, ТекущаяПеременная, МассивЛогаСобытий, Источник, НомерИсправленияНаФорме, Приемник);
		Если ТипЗнч(ЗначениеПеременной) = Тип("Запрос") Тогда
			ТекстЗапроса = ЗначениеПеременной.Текст;
		Иначе
			ТекстЛогаСобытий = "Выполнение кода с текущими параметрами не заполнило переменную, объявленную как Новый Запрос, значением типа [Запрос]";
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);	
			
			ТекстЗапроса = "";
		КонецЕсли;
		Htpekmnfn.Добавить(ТекстЗапроса, ТекущаяПеременная);
	КонецЦикла;
	
	ПеременныеИзКода = НайтиПеременныеПоТипу(ТекстКода, "ТекстЗапроса", МассивЛогаСобытий);
	Для каждого ТекущаяПеременная Из ПеременныеИзКода Цикл
		ЗначениеПеременной = ПолучитьЗначениеПеременнойКода(ТекстКода, ТекущаяПеременная, МассивЛогаСобытий, Источник, НомерИсправленияНаФорме, Приемник);
		Если ТипЗнч(ЗначениеПеременной) = Тип("Запрос") Тогда
			ТекстЗапроса = ЗначениеПеременной.Текст;
		ИначеЕсли ТипЗнч(ЗначениеПеременной) = Тип("Строка") Тогда
			ТекстЗапроса = ЗначениеПеременной;
		Иначе
			ТекстЛогаСобытий = "Выполнение кода с текущими параметрами не заполнило переменную, объявленную как Новый Запрос, значением типа [Запрос]";
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

			ТекстЗапроса = "";
		КонецЕсли;
		Htpekmnfn.Добавить(ТекстЗапроса, ТекущаяПеременная);
	КонецЦикла;
		
	Возврат Htpekmnfn;
КонецФункции 

