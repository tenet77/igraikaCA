	МассивЛогаСобытий = Новый Массив;
	ИмяСобытия = "Получить данные ИнфоПолей, модуль обработки - " + ТипИнфополя;
	
	// Все возможные данные по инфо полям для примера
	ПолныеДанныеИнфоПолей = Новый Массив; 
	ПолныеДанныеИнфоПолей.Добавить("номер_накладной");      // НомерНакладной - номер накладной
	ПолныеДанныеИнфоПолей.Добавить("НомНакл");              // НомерНакладной - номер накладной
	ПолныеДанныеИнфоПолей.Добавить("Номер_накладной");      // НомерНакладной - номер накладной
	ПолныеДанныеИнфоПолей.Добавить("номер_отгрузки");       // НомерНакладной - номер накладной
    ПолныеДанныеИнфоПолей.Добавить("дата_накладной");       // ДокументОснованиеДата - дата накладной
	ПолныеДанныеИнфоПолей.Добавить("ДтНакл");               // ДокументОснованиеДата - дата накладной
	ПолныеДанныеИнфоПолей.Добавить("дата_отгрузки");        // ДокументОснованиеДата - дата накладной
	ПолныеДанныеИнфоПолей.Добавить("дата_поставки");        // ДокументОснованиеДата - дата накладной 
	ПолныеДанныеИнфоПолей.Добавить("номер_заказа");         // ЗаказНомер
	ПолныеДанныеИнфоПолей.Добавить("Заказ_на_поставку");    // ЗаказНомер	
	ПолныеДанныеИнфоПолей.Добавить("дата_заказа");          // ДатаЗаказа - дата заказа	
	ПолныеДанныеИнфоПолей.Добавить("номер_акта");           // RECADV_Номер - номер акта
	ПолныеДанныеИнфоПолей.Добавить("номер_апп");            // RECADV_Номер - номер акта	
	ПолныеДанныеИнфоПолей.Добавить("дата_акта");            // RECADV_Дата - дата акта
	ПолныеДанныеИнфоПолей.Добавить("дата_апп");             // RECADV_Дата - дата акта
    ПолныеДанныеИнфоПолей.Добавить("код_поставщика");       // CAMPAIGNNUMBER - номер договора 	
	ПолныеДанныеИнфоПолей.Добавить("GLN_грузополучателя");  // ГЛНТочкиДоставки - GLN точки доставки
	ПолныеДанныеИнфоПолей.Добавить("грузополучатель");      // ГЛНТочкиДоставки - GLN точки доставки 	
    ПолныеДанныеИнфоПолей.Добавить("документ_основание");   // ГУИДДокОснованиеДляКУПД 	
	ПолныеДанныеИнфоПолей.Добавить("отправитель");          // ГЛНОрганизации - GLN организации
	ПолныеДанныеИнфоПолей.Добавить("грузоотправитель");     // ГЛНОрганизации - GLN организации
	ПолныеДанныеИнфоПолей.Добавить("поставщик");            // ГЛНОрганизации - GLN организации
	ПолныеДанныеИнфоПолей.Добавить("GLN_грузоотправителя"); // ГЛНОрганизации - GLN организации	  
	ПолныеДанныеИнфоПолей.Добавить("VID");                  // RECADV_EDIINTERCHANGEID 		
	ПолныеДанныеИнфоПолей.Добавить("получатель");           // ГЛНКонтрагент - GLN контрагента
	ПолныеДанныеИнфоПолей.Добавить("покупатель");           // ГЛНКонтрагент - GLN контрагента
	ПолныеДанныеИнфоПолей.Добавить("ORDERVID");             // ORDERVID
		 	
	// ИнфПолФХЖ2		
	ПолныеДанныеИнфоПолей.Добавить("CAMPAIGNNUMBER");                // CAMPAIGNNUMBER - номер договора
	ПолныеДанныеИнфоПолей.Добавить("номер_уведомления_об_отгрузке"); // НомерНакладной - номер накладной
	ПолныеДанныеИнфоПолей.Добавить("код_материала");                 // КодТовараПокупателя
	ПолныеДанныеИнфоПолей.Добавить("КдВЕРНЫЙ");	                     // КодТовараПокупателя
	ПолныеДанныеИнфоПолей.Добавить("SKU");                           // КодТовараПокупателя
	ПолныеДанныеИнфоПолей.Добавить("штрихкод");                      // Штрихкод
	ПолныеДанныеИнфоПолей.Добавить("Штрих-код");                     // Штрихкод
	ПолныеДанныеИнфоПолей.Добавить("артикул_поставщика");            // КодТовараПоставщика
	ПолныеДанныеИнфоПолей.Добавить("код_продавца");                  // КодТовараПоставщика
	ПолныеДанныеИнфоПолей.Добавить("вложенность_кол");               // КоличествоМест
	ПолныеДанныеИнфоПолей.Добавить("вложенность_океи");              // НаименованиеЕдиницыИзмерения
	ПолныеДанныеИнфоПолей.Добавить("позиция_заказа");                // НомерСтроки
			
	ТекстОшибки = Новый Массив;
	Результат   = Новый Соответствие;
	
	Если НЕ ЗначениеЗаполнено(ЭКОМ_ИнфоПоле) 
		 ИЛИ ЭтоЮЗДБезИнфПоля = Истина Тогда
		ЭКОМ_ИнфоПоле = Справочники.ЭКОМ_ИнфоПоля.УПД_по_умолчанию;	
	КонецЕсли;
	
	// Заполняем формат по умолчанию
	Если (ЭКОМ_ИнфоПоле.ФорматУПД = "УПД по умолчанию"
		 ИЛИ ЭКОМ_ИнфоПоле.Наименование = "УПД по умолчанию") Тогда
	     Если ЭКОМ_ИнфоПоле.ТабличнаяЧасть.Количество() = 0 Тогда
			 
			 НовыйОбъект    = Справочники.ЭКОМ_ИнфоПоля.СоздатьЭлемент();	
	         НовыйОбъект.ЗаполнитьУПД_поУмолчанию(ЭКОМ_ИнфоПоле);
			  
		 КонецЕсли;			
	КонецЕсли;
	
	// Проверка параметров.
	Если НЕ ТипЗнч(ТипИнфополя) = Тип("Строка") Тогда
		ТекстОшибки.Добавить("<<<ТипИнфополя>>> - ошибка передачи значения в параметре, тип значения должно быть строка");
	КонецЕсли;

	Если НЕ ТипЗнч(ДанныеИнфополя) = Тип("Соответствие") Тогда
		ТекстОшибки.Добавить("<<<ДанныеИнфополя>>> - ошибка при передачи значения в параметре, тип значения должно быть соответствие");
	КонецЕсли;
		
	Если НЕ ТекстОшибки.Количество() = 0 Тогда		
		ТекстЛогаСобытий = СокрЛП(ТипИнфополя) + "Ошибка (" +  СокрЛП(ТипИнфополя) + ") при заполнении процедуры для формата УПД = <<<" + ЭКОМ_ИнфоПоле.Наименование + ">>>:";
		Для Каждого Ошибка Из ТекстОшибки Цикл
			ТекстЛогаСобытий =  ТекстЛогаСобытий + Символы.ПС + "	- " + Ошибка;
		КонецЦикла;
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
		Отказ     = Истина;
		Результат = Неопределено;	
	КонецЕсли;
	
	Если Отказ = Ложь Тогда
		// Добавляем обязательные поля
		Если ТипИнфополя = "ИнфПолФХЖ1" Тогда
			
			ИмяИдентификатора = "отправитель"; 
			Значение = ДанныеИнфополя.Получить(ИмяИдентификатора);
			Если НЕ ЗначениеЗаполнено(Значение) Тогда
				ТекстОшибки.Добавить("<<<" + ИмяИдентификатора + ">>> (GLN организации) - отсутствует обязательное значение");
			КонецЕсли;
			Результат.Вставить(ИмяИдентификатора, СокрЛП(Значение));
			
			ИмяИдентификатора = "получатель";
			Значение = ДанныеИнфополя.Получить(ИмяИдентификатора);
			Если НЕ ЗначениеЗаполнено(Значение) Тогда
				ТекстОшибки.Добавить("<<<" + ИмяИдентификатора + ">>> (GLN контрагента) - отсутствует обязательное значение");
			КонецЕсли;
			Результат.Вставить(ИмяИдентификатора, СокрЛП(Значение));
			
		КонецЕсли;
		
		// Собираем нужные нам данные по формату УПД
		Для каждого Стр Из ЭКОМ_ИнфоПоле.ТабличнаяЧасть Цикл
			
			Если ТипИнфополя = Стр.ТипПоля Тогда
				
				Значение = ДанныеИнфополя.Получить(Стр.Идентификатор);
				Если ЗначениеЗаполнено(Значение) Тогда
					
					Если ТипЗнч(Значение) = Тип("Дата") Тогда
						Значение = Формат(Значение, "ДФ=dd.MM.yyyy");
					Иначе
						Значение = СокрЛП(Значение);
					КонецЕсли;
					
					Результат.Вставить(Стр.Идентификатор, Значение);
				ИначеЕсли Стр.Обязательное = Истина Тогда
					ТекстОшибки.Добавить("<<<" + Стр.Идентификатор + ">>> - отсутствует обязательное значение");
				КонецЕсли;	
				
			КонецЕсли;
			
		КонецЦикла;
		
		
		Если НЕ ТекстОшибки.Количество() = 0 Тогда		
			ТекстЛогаСобытий = "Ошибка (" +  СокрЛП(ТипИнфополя) + ") при заполнении инфополей для формата УПД = <<<" + Строка(ЭКОМ_ИнфоПоле) + ">>>:";
			Для Каждого Ошибка Из ТекстОшибки Цикл
				ТекстЛогаСобытий =  ТекстЛогаСобытий + Символы.ПС + "	- " + Ошибка;
			КонецЦикла;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Отказ     = Истина;
			Результат = Неопределено;			
		КонецЕсли;	
	КонецЕсли;
	
	Если МассивЛогаСобытий.Количество() > 0 Тогда
		 Выполнить("ЭКОМ_ОбщегоНазначения.ЗаписатьЛогСобытийвРегистрЛогирование(МассивЛогаСобытий);");
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

// Процедура выполняет код из шаблона Входящие-Входяший ORDER или Входящий RECADV.
//
// Параметры:
//  Приемник  - ДокументСсылка - ссылка на создаваемый документ
//	ТипТранзакции - Строка - Название типа транзакции
//
Процедура ВыполнитьДополнительныеДействия(Приемник, ТипТранзакции, СтруктураДокумента = Неопределено, МассивЛогаСобытий, ТекстОшибки, 
	СоответствиеПоОрганизации = Неопределено,
	СоответствиеПоКонтрагенту = Неопределено,
	СоответствиеПоТочкамДоставки = Неопределено,										 
	СоответствиеПоНоменклатуре = Неопределено,
	КэшированныеЗначения = Неопределено)
	
	ИмяСобытия = "Выполнение гибких настроек " + ТипТранзакции;
	Дерево 		= ПолучитьСтруктуруФайлаДанных(ТипТранзакции);
	МассивСтрок = ?(Дерево.Строки.Количество() = 0, Новый Массив, Дерево.Строки.НайтиСтроки(Новый Структура("Использовать", Истина)));
	
	Если МассивСтрок.Количество() = 0 Тогда // для данного типа транзакции отсутствует шаблон.
		//+Лысковец MOD-1339 добавлено условие
		Если Найти(ТипТранзакции, "Входящий CONDRA") = 0 Тогда
			ТекстЛогаСобытий = "Для данного типа транзакции отсутствует шаблон.";
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		КонецЕсли;
		Возврат;
	ИначеЕсли НЕ МассивСтрок.Количество() = 1
		ИЛИ НЕ Приемник.Метаданные().Имя = "ЭКОМ_Документы"
		ИЛИ (ТипЗнч(Приемник) = Тип("РезультатЗапроса") 
		И Приемник.Ссылка.Пустая()) Тогда // По определению у нас должен быть только один макет для указанного типа документа
		
		ТекстЛогаСобытий = "Ошибка в параметре процедуры. Дополнительные действия после записи документа не выполнены.";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
		Возврат;
	КонецЕсли;
	
	Шаблон = МассивСтрок.Получить(0);
	Если Дерево.Колонки.Найти("Служебные")= Неопределено ИЛИ НЕ ЗначениеЗаполнено(Шаблон.Служебные) Тогда
		Возврат;
	КонецЕсли;
	
	ЛогСобытий = ""; // Переменная используется в гибких настройках
	ЭлектронныйДокумент = Приемник;
	Попытка
		// ВыполнитьГибкиеНастройки(Приемник); // Расскоментировать для тестирования
		Выполнить(Шаблон.Служебные);
		
		Если ЗначениеЗаполнено(ЛогСобытий) Тогда		
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ЛогСобытий, Перечисления.ЭКОМ_УровниЛогирования.Информация, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);			
		КонецЕсли;
		
	Исключение
		ТекстЛогаСобытий = "Критическая ошибка!" + Символы.ПС + ОписаниеОшибки() + Символы.ПС + ОписаниеСтрокиГибкихНастроек(Шаблон);	
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		Возврат;
		
	КонецПопытки;
	
КонецПроцедуры 

Процедура ПрочитатьУзел(ОбъектXDTO, СтрокаДерева)
	
	АтрибутыСоответствие = Новый Соответствие();
	
	Если ТипЗнч(ОбъектXDTO) = Тип("ОбъектXDTO") Тогда
		Для Каждого Ст ИЗ ОбъектXDTO.Свойства() Цикл		
			
			Если Ст.Форма = ФормаXML.Атрибут Тогда
				АтрибутыСоответствие.Вставить(Ст.Имя, ОбъектXDTO[Ст.Имя]);	 
			ИначеЕсли Ст.Форма = ФормаXML.Элемент 
				И ТипЗнч(ОбъектXDTO[Ст.Имя]) = Тип("Строка") Тогда 
				Строка = СтрокаДерева.Строки.Добавить();
				Строка.Элемент = Ст.Имя;
				Строка.Текст = ОбъектXDTO[Ст.Имя];	
			КонецЕсли;
			
		КонецЦикла;	
	КонецЕсли;		
	
	Если АтрибутыСоответствие.Количество() > 0 Тогда
		СтрокаДерева.Атрибуты = АтрибутыСоответствие;
	Иначе
		АтрибутыСоответствие = 0;
	КонецЕсли;
	
	Если ТипЗнч(ОбъектXDTO) = Тип("СписокXDTO") Тогда 
		Для Каждого Ст ИЗ ОбъектXDTO Цикл 
			Строка = СтрокаДерева.Строки.Добавить();
			Строка.Элемент = ОбъектXDTO.ВладеющееСвойство.Имя;
			Если ТипЗнч(Ст) = Тип("СписокXDTO") ИЛИ ТипЗнч(Ст) = Тип("ОбъектXDTO") Тогда
				ПрочитатьУзел(Ст, Строка);
			КонецЕсли;
		КонецЦикла;
	Иначе
		Для Каждого Ст ИЗ ОбъектXDTO.Свойства() Цикл
			
			Если ТипЗнч(ОбъектXDTO[Ст.Имя]) = Тип("ОбъектXDTO") Тогда
				Строка = СтрокаДерева.Строки.Добавить();
				Строка.Элемент = Ст.Имя;	
				ПрочитатьУзел(ОбъектXDTO[Ст.Имя], Строка);
			ИначеЕсли ТипЗнч(ОбъектXDTO[Ст.Имя]) = Тип("СписокXDTO") Тогда 
				ПрочитатьУзел(ОбъектXDTO[Ст.Имя], СтрокаДерева);	
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;	
	
КонецПроцедуры

Функция ПолучитьЧтениеXMLДляФайла(ФайлИмя, ФайлXMLДляОбработки, Кодировка = "UTF-8", МассивЛогаСобытий) Экспорт
	
	ЧтениеXML = Новый ЧтениеXML;
	ИмяСобытия = "Чтение XML файла";
	
	Если ФайлXMLДляОбработки.Расширение = ".xml" 
		ИЛИ ФайлXMLДляОбработки.Расширение = "xml" Тогда  
		Попытка
			ЧтениеXML.ОткрытьФайл(ФайлXMLДляОбработки.ПолноеИмя,,,Кодировка);			
			ЧтениеXML.Прочитать();
			
		Исключение
			ЧтениеXML.Закрыть();
			ТекстЛогаСобытий    = "Документ XML поврежден: " + ФайлИмя;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			ЧтениеXML = Неопределено;
		КонецПопытки;
	Иначе
		ЧтениеXML = Неопределено;
	КонецЕсли;
	
	Возврат ЧтениеXML;
	
КонецФункции

// Настройки хранятся в ЭКОМ_ЗначениеДополнительныхКонстант - функция получает соответствие настроек
// Имя - имя настройки
// опрЗначение - значение по умолчанию
// Измерение - может хранится в разрезе (организаций, пользователей)
Функция ПолучитьСписокНастроек(МассивДополнительныхКонстант = Неопределено) Экспорт	
	
	Настройки 	= Новый Соответствие;
	Запрос 		= Новый Запрос;
	
	// Получем все настройки
	Если МассивДополнительныхКонстант = Неопределено Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЭКОМ_ЗначениеДополнительныхКонстант.ДополнительнаяКонстанта КАК ДополнительнаяКонстанта,
		|	ЭКОМ_ЗначениеДополнительныхКонстант.Измерение КАК Измерение,
		|	ЭКОМ_ЗначениеДополнительныхКонстант.ЗначениеДополнительногоХранилища,
		|	ЭКОМ_ЗначениеДополнительныхКонстант.ЗначениеДополнительнойКонстанты
		|ИЗ
		|	РегистрСведений.ЭКОМ_ЗначениеДополнительныхКонстант КАК ЭКОМ_ЗначениеДополнительныхКонстант
		|ГДЕ
		|	НЕ ЭКОМ_ЗначениеДополнительныхКонстант.Измерение = ""Номенклатура_""
		|	И НЕ ЭКОМ_ЗначениеДополнительныхКонстант.Измерение = ""Контрагент_""
		|	И НЕ ЭКОМ_ЗначениеДополнительныхКонстант.Измерение = ""ТочкаДоставки_""
		|	И НЕ ЭКОМ_ЗначениеДополнительныхКонстант.Измерение = ""Организация_""";
		
	Иначе
		// Получаем только те настройки которые указаны в массиве
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЭКОМ_ЗначениеДополнительныхКонстант.ДополнительнаяКонстанта КАК ДополнительнаяКонстанта,
		|	ЭКОМ_ЗначениеДополнительныхКонстант.Измерение КАК Измерение,
		|	ЭКОМ_ЗначениеДополнительныхКонстант.ЗначениеДополнительногоХранилища,
		|	ЭКОМ_ЗначениеДополнительныхКонстант.ЗначениеДополнительнойКонстанты
		|ИЗ
		|	РегистрСведений.ЭКОМ_ЗначениеДополнительныхКонстант КАК ЭКОМ_ЗначениеДополнительныхКонстант
		|ГДЕ
		|	НЕ ЭКОМ_ЗначениеДополнительныхКонстант.Измерение = ""Номенклатура_""
		|	И НЕ ЭКОМ_ЗначениеДополнительныхКонстант.Измерение = ""Контрагент_""
		|	И НЕ ЭКОМ_ЗначениеДополнительныхКонстант.Измерение = ""ТочкаДоставки_""
		|	И НЕ ЭКОМ_ЗначениеДополнительныхКонстант.Измерение = ""Организация_""
		|	И ЭКОМ_ЗначениеДополнительныхКонстант.ДополнительнаяКонстанта В (&МассивДополнительныхКонстант)";
		
		Запрос.УстановитьПараметр("МассивДополнительныхКонстант", МассивДополнительныхКонстант);
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ТипЗнч(Выборка.ЗначениеДополнительнойКонстанты) = Тип("Неопределено") Тогда
			Значение = Выборка.ЗначениеДополнительногоХранилища.Получить();
		Иначе	
			Значение = Выборка.ЗначениеДополнительнойКонстанты;
		КонецЕсли;
		
		Настройки.Вставить(Выборка.ДополнительнаяКонстанта + СокрЛП(Выборка.Измерение), Значение);
	КонецЦикла;
	
	Возврат Настройки;
	
КонецФункции

Функция ПолучитьЗначениеНастройки(Настройка, Имя, Измерение, ЗначениеПоУмолчанию) Экспорт	
	
	ЗначениеНастройки = Настройка.Получить(Имя + СокрЛП(Измерение));
	Если ЗначениеНастройки = Неопределено Тогда
		ЗначениеНастройки = ЗначениеПоУмолчанию
	КонецЕсли;
	
	Возврат ЗначениеНастройки;
	
КонецФункции

Функция ПолучитьFTPСоединениеВОбработке(ПараметрыОбъекта, ТипОбменаЭТРН, МассивЛогаСобытий) Экспорт
	
	знИспользуетсяПрокси       = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_ИспользуетсяПрокси"", Ложь)");
	знИмяПользователяПрокси    = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_ИмяПользователяПрокси"")");
	знПарольПользователяПрокси = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_ПарольПользователяПрокси"")");
	знПорт                     = ПараметрыОбъекта.Порт;
	
	Если ТипОбменаЭТРН Тогда
		знИмяПользователяFTP       = ПараметрыОбъекта.ЭТРН_ИмяПользователя;
		знПарольПользователяFTP    = ПараметрыОбъекта.ЭТРН_ПарольПользователя;
		знСерверОбмена             = ПараметрыОбъекта.ЭТРН_Сервер;
		
	Иначе	
		знИмяПользователяFTP       = ПараметрыОбъекта.ИмяПользователяFTP;
		знПарольПользователяFTP    = ПараметрыОбъекта.ПарольПользователяFTP;
		знСерверОбмена             = ПараметрыОбъекта.СерверFTP;
		
	КонецЕсли;
	
	ПараметрыFTP = Новый Структура;
	ПараметрыFTP.Вставить("Сервер"                       , знСерверОбмена);
	ПараметрыFTP.Вставить("Порт"                         , знПорт);
	ПараметрыFTP.Вставить("ИмяПользователя"              , знИмяПользователяFTP);
	ПараметрыFTP.Вставить("ПарольПользователя"           , знПарольПользователяFTP);
	ПараметрыFTP.Вставить("ПассивноеСоединение"          , Истина);
	ПараметрыFTP.Вставить("Таймаут"                      , 0);
	ПараметрыFTP.Вставить("ЗащищенноеСоединение"         , Неопределено);
	ПараметрыFTP.Вставить("УровеньИспользованияЗащитыFTP", УровеньИспользованияЗащищенногоСоединенияFTP.Авто);
	ПараметрыFTP.Вставить("ИспользуетсяПрокси"           , знИспользуетсяПрокси);
	ПараметрыFTP.Вставить("ИмяПользователяПрокси"        , знИмяПользователяПрокси);
	ПараметрыFTP.Вставить("ПарольПользователяПрокси"     , знПарольПользователяПрокси);
	
	СерверFTP = ПолучитьСерверFTPОбщийМодульВОбработке(ПараметрыFTP, МассивЛогаСобытий);
	
	Возврат СерверFTP;
	
КонецФункции

Функция ПолучитьСерверFTPОбщийМодульВОбработке(ПараметрыFTP, МассивЛогаСобытий) Экспорт
	
	ИмяСобытия = "Получение сервера FTP, модуль обработки";
	СерверFTP    = Неопределено;
	ПроксиСервер = Новый ИнтернетПрокси();	     			
	Если ПараметрыFTP.ИспользуетсяПрокси = Истина Тогда	
		ПроксиСервер.Пользователь = СокрЛП(ПараметрыFTP.ИмяПользователяПрокси);
		ПроксиСервер.Пароль       = СокрЛП(ПараметрыFTP.ПарольПользователяПрокси);
		ПараметрыFTP.Вставить("Прокси", ПроксиСервер);
	КонецЕсли;
	
	знПорт = ?(ТипЗнч(ПараметрыFTP.Порт) = Тип("Число"), ПараметрыFTP.Порт, Вычислить("ЭКОМ_ОбщегоНазначения.ЭКОМ_ПреобразоватьВЧислоОбщегоНазначения(ПараметрыFTP.Порт)"));
	ПараметрыFTP.Вставить("Порт"  , знПорт);
	ПараметрыFTP.Вставить("Прокси", ПроксиСервер);
	
	Если Вычислить("ЭКОМ_ОбщегоНазначения.ВерсияПлатформыНаСервере()") >= 8309 Тогда
		Попытка
			Выполнить("СерверFTP = Новый FTPСоединение(
			|ПараметрыFTP.Сервер, 
			|ПараметрыFTP.Порт, 
			|ПараметрыFTP.ИмяПользователя, 
			|ПараметрыFTP.ПарольПользователя,
			|ПараметрыFTP.Прокси,
			|ПараметрыFTP.ПассивноеСоединение,
			|ПараметрыFTP.Таймаут,
			|ПараметрыFTP.ЗащищенноеСоединение,
			|ПараметрыFTP.УровеньИспользованияЗащитыFTP);");					
		Исключение
			ОписаниеОшибкиТекст = ОписаниеОшибки();
			Ошибка = Вычислить("ЭКОМ_ОбщегоНазначения.ДатьОписаниеОшибкиПоТекстуОшибкиОбщийМодуль(ОписаниеОшибкиТекст)");
			ТекстЛогаСобытий = "Не удается подключиться к серверу: " + ПараметрыFTP.Сервер + Символы.ПС + Ошибка;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
		КонецПопытки;	
	Иначе
		Попытка
			СерверFTP = Новый FTPСоединение(
			ПараметрыFTP.Сервер, 
			ПараметрыFTP.Порт, 
			ПараметрыFTP.ИмяПользователя, 
			ПараметрыFTP.ПарольПользователя,
			ПараметрыFTP.Прокси,
			ПараметрыFTP.ПассивноеСоединение,
			ПараметрыFTP.Таймаут);			
		Исключение
			ТекстЛогаСобытий = "Не удается подключиться к серверу: " + ПараметрыFTP.Сервер;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
		КонецПопытки;
	КонецЕсли;
	
	Если СерверFTP = Неопределено Тогда
		ТекстЛогаСобытий = "Отсутствует подключение к FTP (Неопределено)!";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
	КонецЕсли;
	
	Возврат СерверFTP;
	
КонецФункции

// Процедура получает все файлы.
Функция ПолучитьВсеФайлы(МассивФайловСКлиента, ТипДокумента, ОбработатьФайлыНаКлиенте = Ложь, МассивЛогаСобытий, ЭтоРегламентноеЗадание = Ложь, СтруктураЛога) Экспорт
	
	МассивСтруктурыФайлов  = Новый Массив;
	ИмяСобытия             = "Обработка документов " + ТипДокумента;
	
	ПродолжитьОбмен = ПроверитьУстановитьБлокировкуОперации(ТипДокумента, "Входящий", МассивЛогаСобытий);	
	
	Если ПродолжитьОбмен = Истина Тогда
		
		//Docrobot 1.22.0 MOD-2269 [используется для распределения входящих файлов по каталогам]
		Если ТипДокумента = "CONDRA" Тогда 
			ЛокальныйКаталогINBOX_Архив = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_Локальный_Каталог_INBOX_Архив"", Неопределено, Неопределено, Истина)");
			ТекущаяДата = ТекущаяДата();
			РазделительПути = ЭКОМ_ПолучитьРазделительПути();
		КонецЕсли;
	
		// Загружаем все не зависимо от периода
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЭКОМ_GLN.ПрофильОбмена КАК ПрофильОбмена,
		|	ЭКОМ_GLN.Объект КАК Организация,
		|	ЭКОМ_GLN.GLN КАК GLN,
		|	ЭКОМ_GLN.Ид_ОЭД КАК ИдУчастника
		|ИЗ
		|	РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN
		|ГДЕ
		|	НЕ ЭКОМ_GLN.ПрофильОбмена = ЗНАЧЕНИЕ(Справочник.ЭКОМ_ПрофилиОбмена.ПустаяСсылка)
		|	И НЕ ЭКОМ_GLN.ПрофильОбмена.ПометкаУдаления И ЭКОМ_GLN.ПрофильОбмена.Активный = ИСТИНА
		|ИТОГИ ПО
		|	ПрофильОбмена";
		
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			
			ВыборкаПрофильОбмена = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаПрофильОбмена.Следующий() Цикл
				ПрофильОбмена = ВыборкаПрофильОбмена.ПрофильОбмена;
				
				ИспользоватьЛокальный_FTP_Клиент = ПрофильОбмена.ПроверятьФайлыЛокально;
				знПутьНаСервере                  = ПрофильОбмена.ВходящийПутьFTP;			
				ЭКОМ_ОставитьДокументыНаПлатформеПослеЗагрузки = ПрофильОбмена.ОставитьФайлыНаПлатформеПослеЗагрузки;   
				
				ВременныйКаталог = ПутьВременногоКаталогаЭКОМ("Inbox_" + ТипДокумента);
				КаталогВременный = ЭКОМ_СоздатьКаталогПроверитьНаЗапись(ВременныйКаталог, МассивЛогаСобытий);
				Если НЕ КаталогВременный = Неопределено Тогда		
					ТипОбменаЭТРН     = Ложь;
					ИспользоватьREST  = ПрофильОбмена.ОбменREST;
					Если ТипДокумента = "DRVGOV_02_Входящий" 
						ИЛИ ТипДокумента = "DRVGOU_03_Входящий"
						ИЛИ ТипДокумента = "WHGOU_04_Входящий"
						ИЛИ ТипДокумента = "DRVGPV_06_Входящий"
						ИЛИ ТипДокумента = "DRVGPU_07_Входящий"
						ИЛИ ТипДокумента = "WHGPU_08_Входящий" Тогда
						
						НачалоИмениФайла = "TRNX5";
						ТипОбменаЭТРН    = Истина;
						знИспользоватьАПИ = ПрофильОбмена.ЭТРН_ОбменПоSOAP;
						
					ИначеЕсли ТипДокумента = "DP_Статусы" Тогда		
						НачалоИмениФайла = "DP_TRNX5";
						ТипОбменаЭТРН    = Истина;
						знИспользоватьАПИ = ПрофильОбмена.ЭТРН_ОбменПоSOAP;
						
					ИначеЕсли ТипДокумента = "RETINS" Тогда		
						НачалоИмениФайла = "RETINS";
						знИспользоватьАПИ = ПрофильОбмена.ОбменПоSOAP;
						
					ИначеЕсли ТипДокумента = "DP_IZVPOL_06"
						ИЛИ ТипДокумента = "DP_IZVPOL_10" 
						ИЛИ ТипДокумента = "DP_IZVPOL_23" Тогда	
						НачалоИмениФайла  = "DP_IZVPOL";
						знИспользоватьАПИ = ПрофильОбмена.ОбменПоSOAP;
						
					ИначеЕсли ТипДокумента = "DP_UVUTOCH_24"
						ИЛИ ТипДокумента = "DP_UVUTOCH_09" Тогда   //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _09]
						НачалоИмениФайла  = "DP_UVUTOCH";          
						знИспользоватьАПИ = ПрофильОбмена.ОбменПоSOAP;
						
					ИначеЕсли ТипДокумента = "DP_PRANNUL_22" Тогда //Docrobot 1.19.0 MOD-1377 [Добавлена проверка на вид документа PRANNUL]		
						НачалоИмениФайла  = "DP_PRANNUL";
						знИспользоватьАПИ = ПрофильОбмена.ОбменПоSOAP;
						
					ИначеЕсли Найти(ТипДокумента,"DOPPOK") > 0 Тогда //Docrobot 1.19.0 MOD-1377 [Добавлена проверка для подписи, без номера квитанции]
						НачалоИмениФайла = Лев(ТипДокумента,СтрДлина(ТипДокумента)-3);
						знИспользоватьАПИ = ПрофильОбмена.ОбменПоSOAP;
						
					ИначеЕсли Найти(ТипДокумента,"DOPPR") > 0 Тогда //Docrobot 1.19.0 MOD-1377 [Добавлена проверка для счф, без номера квитанции. 2 этап]
						Если Найти(ТипДокумента,"_Испр") > 0 Тогда //У исправительных имя длиннее
							НачалоИмениФайла = Лев(ТипДокумента,СтрДлина(ТипДокумента)-8);
						Иначе
							НачалоИмениФайла = Лев(ТипДокумента,СтрДлина(ТипДокумента)-3);
						КонецЕсли;
						знИспользоватьАПИ = ПрофильОбмена.ОбменПоSOAP;
						
					Иначе		
						НачалоИмениФайла  = ТипДокумента;   
						знИспользоватьАПИ = ПрофильОбмена.ОбменПоSOAP;
						
					КонецЕсли;
					
					ФайлыНаПлатформе = Новый ТаблицаЗначений;
					Массив = Новый Массив;
					КС = Новый КвалификаторыСтроки(250);
					Массив.Добавить(Тип("Строка"));
					ОписаниеТиповС = Новый ОписаниеТипов(Массив, , , ,КС);
					Массив.Очистить();
					
					ФайлыНаПлатформе.Колонки.Добавить("ФайлИмя"     , ОписаниеТиповС);
					ФайлыНаПлатформе.Колонки.Добавить("Идентификатор", ОписаниеТиповС);
					ФайлыНаПлатформе.Колонки.Добавить("Расширение"   , ОписаниеТиповС);
					
					МассивОбработанныхФайловСПлатформы = Новый Массив;
					МассивФайловСПлатформыДляЗагрузки  = Новый Массив;
					ФайлыНаСервере                     = Новый Соответствие; // Чтобы не было дублей
					
					// Проверка файлов на платформе
					Если ИспользоватьЛокальный_FTP_Клиент = Ложь Тогда
						
						// Способ получения по API
						Если знИспользоватьАПИ Тогда		
							
							МассивФайловСПлатформыДляЗагрузки = API_ПолучитьВходящиеДокументы(ПрофильОбмена, НачалоИмениФайла, ТипДокумента, МассивЛогаСобытий, ВременныйКаталог, ФайлыНаПлатформе); 
							
						ИначеЕсли ИспользоватьREST Тогда
							ТипДокументооборота      = ПолучитьТипДокументооборота(ТипДокумента);
							Если ТипДокументооборота = "" Тогда 
								ТекстЛогаСобытий = "Не удалось определить тип документооборота для типа документа: " + ТипДокумента;
								ДобавитьЗаписьВМассивЛога(МассивЛогаСобытий, ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
								Продолжить;
							КонецЕсли;
							
							ИмяИдентификатора 	     = ?(ТипДокументооборота = "EDI", "GLN", "ИдУчастника");
							ИдентификаторыУчастников = Новый Массив;
							ВыборкаДетальныеЗаписи   = ВыборкаПрофильОбмена.Выбрать();
							Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
								ИдентификаторыУчастников.Добавить(ВыборкаДетальныеЗаписи[ИмяИдентификатора]);
							КонецЦикла;
							
							МассивФайловСПлатформыДляЗагрузки = 
								ПолучитьВходящиеДокументыREST_API(ПрофильОбмена, ИдентификаторыУчастников, ТипДокумента, ФайлыНаПлатформе, МассивЛогаСобытий, ВременныйКаталог); 
							
						Иначе
							
							// Способ получения по FTP
							ТекстЛогаСобытий = "Начало загрузки с FTP " + СокрЛП(ТекущаяДата());
							ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Информация, ИмяСобытия);
							МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

							
							Сервер = ПолучитьFTPСоединениеВОбработке(ПрофильОбмена, ТипОбменаЭТРН, МассивЛогаСобытий); 	
							Если Сервер = Неопределено Тогда								
								ТекстЛогаСобытий = "Отсутствует подключение к FTP!";
								ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
								МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
								
							Иначе
								
								МассивФайловСFTP       = Новый Массив;
								
								// Находим файлы по всем регистрам в нужном каталоге по указанным маскам.
								ЗагружаемыеРасширения = Новый Массив;
								ЗагружаемыеРасширения.Добавить("*.xml");
								ЗагружаемыеРасширения.Добавить("*.bin");
								ЗагружаемыеРасширения.Добавить("*.zip");
								
								Для Каждого Расширение Из ЗагружаемыеРасширения Цикл
									МаскаВРег = ВРег(НачалоИмениФайла) + "_" + Расширение;
									СобратьИменаФайловНаПоМаскеFTP(Сервер, МаскаВРег, знПутьНаСервере, МассивФайловСFTP, ТипОбменаЭТРН, ПрофильОбмена, МассивЛогаСобытий);
									
									МаскаНРег = НРег(НачалоИмениФайла) + "_" + Расширение;
									СобратьИменаФайловНаПоМаскеFTP(Сервер, МаскаНРег, знПутьНаСервере, МассивФайловСFTP, ТипОбменаЭТРН, ПрофильОбмена, МассивЛогаСобытий);
									
									МаскаТРег = ТРег(НачалоИмениФайла) + "_" + Расширение;
									СобратьИменаФайловНаПоМаскеFTP(Сервер, МаскаТРег, знПутьНаСервере, МассивФайловСFTP, ТипОбменаЭТРН, ПрофильОбмена, МассивЛогаСобытий);
								КонецЦикла;
								
								Для Каждого Эл Из МассивФайловСFTP Цикл
									
									Стр = ФайлыНаПлатформе.Добавить();
									Стр.Расширение    = Эл.Расширение;
									Стр.ФайлИмя       = Эл.Имя;
									Стр.Идентификатор = Эл.ИмяБезРасширения;
									
								КонецЦикла;
								
								ОбработаннаяТЗ = Новый ТаблицаЗначений; 
								Если ФайлыНаПлатформе.Количество()>0 Тогда
									
									ОбработаннаяТЗ = ПроверитьСписокЗагружаемыхДокументов(ФайлыНаПлатформе, ТипДокумента);					
									
								КонецЕсли;
								
								ЗаменятьИмяXML = ТипДокумента = "CONDRA";
								
								Для Каждого ТекущийФайл Из ОбработаннаяТЗ Цикл		
									
									Если ТекущийФайл.Расширение = "bin" 
										ИЛИ ТекущийФайл.Расширение = ".bin" Тогда
										Продолжить;
									КонецЕсли;
									
									Попытка
										Сервер.Получить(знПутьНаСервере + ТекущийФайл.ФайлИмя, ВременныйКаталог + ТекущийФайл.ФайлИмя);
									Исключение
										Сервер = ПолучитьFTPСоединениеВОбработке(ПрофильОбмена, ТипОбменаЭТРН, МассивЛогаСобытий);	
										Если НЕ Сервер = Неопределено Тогда
											Сервер.Получить(знПутьНаСервере + ТекущийФайл.ФайлИмя, ВременныйКаталог + ТекущийФайл.ФайлИмя);
										КонецЕсли;
									КонецПопытки;
									
									ФайлCFTP = Новый Файл(ВременныйКаталог + ТекущийФайл.ФайлИмя);
									
									СтруктураФайла = Новый Структура;
									
									Если ФайлCFTP.Расширение = ".zip" 
										ИЛИ ФайлCFTP.Расширение = "zip"  Тогда
										ЧтениеZIP = Новый ЧтениеZipФайла(ФайлCFTP.ПолноеИмя);
										
										КаталогПуть = ВременныйКаталог + ФайлCFTP.ИмяБезРасширения;
										КаталогВременныйПуть = ЭКОМ_СоздатьКаталогПроверитьНаЗапись(КаталогПуть, МассивЛогаСобытий);
										Если КаталогВременныйПуть = Неопределено Тогда		
											Продолжить;		
										КонецЕсли;
										
										ЧтениеZIP.ИзвлечьВсе(КаталогПуть, РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
										
										// При необходимости сохранить уникальность имени XML получаем его имя из bin или pdf (актуально для CONDRA).
										Если ЗаменятьИмяXML Тогда
											// Для CONDRA указываем имя файла FTP. Оно отличается от имени файлов в архиве и нужно для удаления файла на FTP.
											СтруктураФайла.Вставить("ИмяФайлаАрхива", ФайлCFTP.Имя);
											ИмяФайлаXML = ВременныйКаталог + ФайлCFTP.ИмяБезРасширения + ".xml";
											
										КонецЕсли;
										
										// Перемещение файлов с соблюдением уникальности имени (если необходимо).
										Для Каждого Файл Из НайтиФайлы(КаталогПуть, "*.*", Истина) Цикл
											// Пропускаем каталоги.
											Если Файл.ЭтоКаталог() Тогда
												Продолжить;
											КонецЕсли;
											
											Если ЗаменятьИмяXML И Файл.Расширение = ".xml" 
												ИЛИ Файл.Расширение = "xml" Тогда
												ИмяФайлаПриемника = ИмяФайлаXML;
											Иначе
												ИмяФайлаПриемника = ВременныйКаталог + Файл.Имя;
											КонецЕсли;
											
											// Перемещаем файл из временного каталога в папку входящих документов, при необходимости изменив его имя.
											ПереместитьФайл(Файл.ПолноеИмя, ИмяФайлаПриемника);
											
											Файл = Новый Файл(ИмяФайлаПриемника);
											
											Если Файл.Расширение = "bin" 
												ИЛИ Файл.Расширение = ".bin" Тогда
												СтруктураФайла.Вставить("ФайлBIN", Файл);
											Иначе
												ПоддерживаемыеРасширенияCONDRA = ПоддерживаемыеРасширенияCONDRA();
												ПоддерживаемыеРасширенияCONDRA.Добавить("xml");
												Для Каждого Расширение Из ПоддерживаемыеРасширенияCONDRA Цикл
													Если Найти(Файл.Расширение, Расширение) > 0 Тогда
														
														Если СтруктураФайла.Свойство("ИмяБезРасширения") = Ложь Тогда
															СтруктураФайла.Вставить("ИмяБезРасширения", Файл.ИмяБезРасширения);
														КонецЕсли;
														Если Расширение = "xml" Тогда
															СтруктураФайла.Вставить("ФайлИмя",			Файл.Имя);
														КонецЕсли;
														СтруктураФайла.Вставить("Файл" + Расширение, 	Файл);
														
														Прервать;
													КонецЕсли;
												КонецЦикла;
											КонецЕсли;
											
										КонецЦикла;
										
										ЧтениеZIP.Закрыть();
										// Удаление архива.
										Попытка
											УдалитьФайлы(ФайлCFTP.ПолноеИмя);		
										Исключение
											ТекстЛогаСобытий = ОписаниеОшибки();
											ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
											МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

										КонецПопытки;
										// Удаление временной папки.
										Попытка
											УдалитьФайлы(КаталогПуть);		
										Исключение
											ТекстЛогаСобытий = ОписаниеОшибки();
											ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
											МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

										КонецПопытки;
									Иначе
										
										// Для квитанций
										ЭлементBIN = ОбработаннаяТЗ.Найти(ТекущийФайл.Идентификатор + ".bin", "ФайлИмя");
										Если НЕ ЭлементBIN = Неопределено Тогда
											
											Попытка
												Сервер.Получить(знПутьНаСервере + ЭлементBIN.ФайлИмя, ВременныйКаталог + ЭлементBIN.ФайлИмя);
											Исключение
												Сервер = ПолучитьFTPСоединениеВОбработке(ПрофильОбмена, ТипОбменаЭТРН, МассивЛогаСобытий);	
												Если НЕ Сервер = Неопределено Тогда
