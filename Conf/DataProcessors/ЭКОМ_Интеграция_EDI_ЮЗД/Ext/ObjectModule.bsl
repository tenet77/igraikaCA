	Иначе
		ТекстСообщения = ТекстЛогаСобытий;
	КонецЕсли;
	
КонецПроцедуры

Функция ЗаполнитьДеревоПоДокументу1С(ТипТранзакции, ДеревоЗначенийДляЗаполнения, ДеревоКонфигурацииОбъект) Экспорт
	
	ТекущаяСтрока = ДеревоЗначенийДляЗаполнения.Строки.Найти(ТипТранзакции , "ТипТранзакции");	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТекущаяСтрока.Строки.Очистить();
	ДокументИсточник = ДеревоКонфигурацииОбъект.Строки.Найти(ТекущаяСтрока.Источник      , "Синоним");			 
	ДокументПриемник = ДеревоКонфигурацииОбъект.Строки.Найти(ТекущаяСтрока.Приемник, "Синоним");
	
	Если ДокументИсточник = Неопределено
		ИЛИ ДокументПриемник = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Добавление колонок дерева.
	Если ДеревоЗначенийДляЗаполнения.Колонки.Найти("ТипТранзакции") = Неопределено Тогда
		ДеревоЗначенийДляЗаполнения.Колонки.Добавить("ТипТранзакции", Новый ОписаниеТипов("Строка"), "Тип транзакции");
	КонецЕсли;
	Если ДеревоЗначенийДляЗаполнения.Колонки.Найти("Использовать") = Неопределено Тогда
		ДеревоЗначенийДляЗаполнения.Колонки.Добавить("Использовать", Новый ОписаниеТипов("Булево"));
	КонецЕсли;
	Если ДеревоЗначенийДляЗаполнения.Колонки.Найти("Источник") = Неопределено Тогда
		ДеревоЗначенийДляЗаполнения.Колонки.Добавить("Источник", Новый ОписаниеТипов("Строка"));
	КонецЕсли;
	Если ДеревоЗначенийДляЗаполнения.Колонки.Найти("Приемник") = Неопределено Тогда	
		ДеревоЗначенийДляЗаполнения.Колонки.Добавить("Приемник", Новый ОписаниеТипов("Строка"));
	КонецЕсли;
	Если ДеревоЗначенийДляЗаполнения.Колонки.Найти("Формула") = Неопределено Тогда
		ДеревоЗначенийДляЗаполнения.Колонки.Добавить("Формула", Новый ОписаниеТипов("Строка"));
	КонецЕсли;
	Если ДеревоЗначенийДляЗаполнения.Колонки.Найти("Служебные") = Неопределено Тогда
		ДеревоЗначенийДляЗаполнения.Колонки.Добавить("Служебные", Новый ОписаниеТипов("Строка"));
	КонецЕсли;
	
	// Добавление реквизитов.
	Для Каждого ЭлРеквизита Из ДокументПриемник.Строки Цикл
		
		Если НЕ ЭлРеквизита.Строки.Количество() = 0 Тогда
			Продолжить; // Это таблица, а нужен реквизит
		КонецЕсли;
		
		Строка = ТекущаяСтрока.Строки.Добавить();
		Строка.Использовать	= Истина;
		Строка.Приемник 	= ЭлРеквизита.Синоним;
		
		СтрокаИсточник = ДокументИсточник.Строки.Найти(ЭлРеквизита.Синоним, "Синоним");
		Если НЕ СтрокаИсточник = Неопределено Тогда
			Строка.Источник	= СтрокаИсточник.Синоним;
		КонецЕсли;
		
	КонецЦикла;
	
	// Добавление табличных частей.
	Для Каждого Таблица Из ДокументПриемник.Строки Цикл
		
		Если Таблица.Строки.Количество() = 0 Тогда
			Продолжить; // Это реквизит, а нужна таблица
		КонецЕсли;
		
		// Исключаем эту таблицу.
		Если Таблица.Имя = "ДокументыСвязанные" Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТаб = ТекущаяСтрока.Строки.Добавить();
		СтрокаТаб.Использовать 	= Истина;
		СтрокаТаб.Приемник 		= Таблица.Синоним;
		СтрокаТабИсточник       = ДокументИсточник.Строки.Найти(Таблица.Синоним, "Синоним");
		Если НЕ СтрокаТабИсточник = Неопределено Тогда
			СтрокаТаб.Источник	= СтрокаТабИсточник.Синоним;
		КонецЕсли;
		
		// Добавление реквизитов табличной части.
		Для Каждого ЭлРеквизита Из Таблица.Строки Цикл
			Строка = СтрокаТаб.Строки.Добавить();
			Строка.Использовать	= Истина;
			Строка.Приемник 	= ЭлРеквизита.Синоним;
			СтрокаИсточник      = ДокументИсточник.Строки.Найти(ЭлРеквизита.Синоним, "Синоним");
			Если НЕ СтрокаИсточник = Неопределено Тогда
				Строка.Источник	= СтрокаИсточник.Синоним;
			КонецЕсли;
		КонецЦикла;		
	КонецЦикла;
	
	Возврат ДеревоЗначенийДляЗаполнения;
	
КонецФункции

//ТВС: НачалоИзменений: Автор [Тюрюков Владимир] | метка автора: [ТВС] |  21.08.2019]
Функция ВыделитьНДС(СуммаСНДС, СтавкаНДСЧислом) Экспорт
	
	КоэфициентНДС = (100 + СтавкаНДСЧислом) / 100;
	Результат = Окр(СуммаСНДС / КоэфициентНДС, 2);
	
	Возврат Результат;
КонецФункции

Функция СуммаСНДС(СуммаБезНДС, СтавкаНДСЧислом) Экспорт
	
	Результат = Окр(СуммаБезНДС * (100 + СтавкаНДСЧислом) / 100, 2);
	
	Возврат Результат;
КонецФункции

Функция РасчетСумм_Прямой(Цена, СтавкаНДСЧислом, ЦенаВключаетНДС, Количество) Экспорт
	
	ЦенаБезНДС = ?( ЦенаВключаетНДС = Ложь
	, Цена
	, ВыделитьНДС(Цена, СтавкаНДСЧислом)
	); 
	
	ЦенаСНДС   = ?( ЦенаВключаетНДС = Ложь
	, СуммаСНДС(Цена, СтавкаНДСЧислом)
	, Цена
	);
	
	// Рассчитываем суммы без НДС
	СуммаБезНДС = ЦенаБезНДС  * Количество;
	
	// Рассчитываем суммы с НДС 
	СуммаСНДС   = СуммаСНДС(СуммаБезНДС, СтавкаНДСЧислом);
	
	// Рассчитываем вычитанием суммы НДС из суммы с НДС.
	СуммаНДС    = СуммаСНДС - СуммаБезНДС;
	
	Результат   = Новый Структура("ЦенаБезНДС, ЦенаСНДС, СуммаБезНДС, СуммаСНДС, СуммаНДС"
	, ЦенаБезНДС, ЦенаСНДС, СуммаБезНДС, СуммаСНДС, СуммаНДС
	);
	
	Возврат Результат;
КонецФункции

Функция РасчетСумм_Обратный(Цена, СтавкаНДСЧислом, ЦенаВключаетНДС, Количество) Экспорт
	
	// Рассчитываем цены без НДС
	ЦенаБезНДС = ?( ЦенаВключаетНДС = Ложь
	, Цена
	, ВыделитьНДС(Цена, СтавкаНДСЧислом)
	); 
	
	// Рассчитываем цены с НДС
	ЦенаСНДС   = ?( ЦенаВключаетНДС = Ложь
	, СуммаСНДС(Цена, СтавкаНДСЧислом)
	, Цена
	);
	
	// Рассчитываем суммы с НДС    
	СуммаСНДС   = ЦенаСНДС   * Количество;
	
	// Рассчитываем суммы НДС
	СуммаНДС    = Окр(СуммаСНДС / (100 + СтавкаНДСЧислом) * СтавкаНДСЧислом, 2);
	
	// Рассчитываем суммы без НДС
	СуммаБезНДС = СуммаСНДС - СуммаНДС;  
	
	Результат   = Новый Структура("ЦенаБезНДС, ЦенаСНДС, СуммаБезНДС, СуммаСНДС, СуммаНДС"
	, ЦенаБезНДС, ЦенаСНДС, СуммаБезНДС, СуммаСНДС, СуммаНДС
	);
	
	Возврат Результат;
КонецФункции

Функция РасчетСумм(Цена, СтавкаНДСЧислом, ЦенаВключаетНДС, Количество, ОбратныйПорядокРасчетаСумм) Экспорт
	
	Если ОбратныйПорядокРасчетаСумм = Ложь Тогда
		Результат = РасчетСумм_Прямой(Цена, СтавкаНДСЧислом, ЦенаВключаетНДС, Количество);
	Иначе
		Результат = РасчетСумм_Обратный(Цена, СтавкаНДСЧислом, ЦенаВключаетНДС, Количество);
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

