		// <<< СвИзвПолуч - 3 уровень
		СвИзвПолуч = Новый Структура;
		ДокументУзел.Вставить("СвИзвПолуч", СвИзвПолуч);	
		СписокАтрибутов = Новый СписокЗначений;
		СписокАтрибутов.Добавить("ДатаПол" , Формат(ВыборкаДокумент.ОснованиеДатаТранзакции, "ДФ=dd.MM.yyyy"));
		СписокАтрибутов.Добавить("ВремяПол", Формат(ВыборкаДокумент.ОснованиеДатаТранзакции, "ДФ=HH.mm.ss"));
		СвИзвПолуч.Вставить("Атрибут", СписокАтрибутов);
		
		ИмяПостФайла = СтрЗаменить(ВыборкаДокумент.ОснованиеИмяФайла, ".xml", "");
		ИмяПостФайла = СтрЗаменить(ИмяПостФайла, ".zip", "");
		
		ЭЦППолФайл = Base64Строка(ОснованиеЭЦП); 
		ЭЦППолФайл = СтрЗаменить(ЭЦППолФайл, Символы.ПС, "");
		ЭЦППолФайл = СтрЗаменить(ЭЦППолФайл, Символы.ВК, "");
		
		// <<< СведПолФайл - 4 уровень
		СведПолФайл = Новый Структура;
		СвИзвПолуч.Вставить("СведПолФайл", СведПолФайл);	
		СписокАтрибутов = Новый СписокЗначений;
		СписокАтрибутов.Добавить("ИмяПостФайла", ИмяПостФайла);
		СведПолФайл.Вставить("Атрибут"   , СписокАтрибутов);
		СведПолФайл.Вставить("ЭЦППолФайл", ЭЦППолФайл);
		
		// <<< ОтпрДок - 3 уровень
		ОтпрДок = Новый Структура;
		ДокументУзел.Вставить("ОтпрДок", ОтпрДок);	
		СписокАтрибутов = Новый СписокЗначений;
		СписокАтрибутов.Добавить("ИдУчастЭДО", Получатель_ИД_ЭДО);
		ОтпрДок.Вставить("Атрибут", СписокАтрибутов);
		
		ЭтоЮрЛицоПолучатель = Ложь;
		// ПолучательТип
		Если ВыборкаДокумент.ПолучательТип = "" Тогда
			ЭтоЮрЛицоПолучатель = ЮрФизЛицоОпределитьТипОбъекта(ВыборкаДокумент.Контрагент, СтруктураМетаДанных.ИмяРеквизитаКонтрагента, СтруктураМетаДанных.ПеречислениеЮрЛицо);
		Иначе
			ЭтоЮрЛицоПолучатель = Истина; 
		КонецЕсли;
		
		Если ЭтоЮрЛицоПолучатель Тогда	
			// <<< ЮЛ - 4 уровень
			ОтпрДокЮЛ = Новый Структура;
			ОтпрДок.Вставить("ЮЛ", ОтпрДокЮЛ);
			СписокАтрибутов = Новый СписокЗначений;
			СписокАтрибутов.Добавить("НаимОрг", ВыборкаДокумент.ПолучательНаименование);
			СписокАтрибутов.Добавить("ИННЮЛ"  , ВыборкаДокумент.ПолучательИНН);
			СписокАтрибутов.Добавить("КПП"    , ВыборкаДокумент.ПолучательКПП);
			ОтпрДокЮЛ.Вставить("Атрибут", СписокАтрибутов); 			
			
		Иначе
			// <<< ИП - 4 уровень
			ОтпрДокИП = Новый Структура;
			ОтпрДок.Вставить("ИП", ОтпрДокИП);
			СписокАтрибутов = Новый СписокЗначений;
			СписокАтрибутов.Добавить("ИННФЛ", ВыборкаДокумент.ПолучательИНН);
			ОтпрДокИП.Вставить("Атрибут", СписокАтрибутов);
			
			// <<< ФИО - 5 уровень
			ОтпрДокИП_ФИО = Новый Структура;
			ОтпрДокИП.Вставить("ФИО", ОтпрДокИП_ФИО);
			СписокАтрибутов = Новый СписокЗначений;
			СписокАтрибутов.Добавить("Фамилия" , ВыборкаДокумент.ПолучательФамилияФЛ);
			СписокАтрибутов.Добавить("Имя"     , ВыборкаДокумент.ПолучательИмяФЛ);
			СписокАтрибутов.Добавить("Отчество", ВыборкаДокумент.ПолучательОтчествоФЛ);
			ОтпрДокИП_ФИО.Вставить("Атрибут", СписокАтрибутов);  			
			
		КонецЕсли;
		
		// <<< Подписант - 3 уровень
		Подписант = Новый Структура;
		ДокументУзел.Вставить("Подписант" , Подписант);
		СписокАтрибутов = Новый СписокЗначений;
		СписокАтрибутов.Добавить("Должность", ВыборкаДокумент.ОрганизацияДолжностьПодписанта);
		Подписант.Вставить("Атрибут", СписокАтрибутов);	
		
		// <<< ФИО - 4 уровень
		ПодписантФИО = Новый Структура;
		Подписант.Вставить("ФИО", ПодписантФИО);
		СписокАтрибутов = Новый СписокЗначений;
		СписокАтрибутов.Добавить("Фамилия" , СокрЛП(ВыборкаДокумент.ОрганизацияФамилияПодписанта));
		СписокАтрибутов.Добавить("Имя"     , СокрЛП(ВыборкаДокумент.ОрганизацияИмяПодписанта));
		СписокАтрибутов.Добавить("Отчество", СокрЛП(ВыборкаДокумент.ОрганизацияОтчествоПодписанта));
		ПодписантФИО.Вставить("Атрибут", СписокАтрибутов);
		
		КодировкаФайла = "windows-1251";
		
		СтрокаXML = ЗаписатьФайлXML(УзелНачальный, "Файл", КодировкаФайла);	
		УзелНачальный.Вставить("СтрокаXML", СтрокаXML);
		
		СписокФайлов = Новый Структура;
		СписокФайлов.Вставить("СтрокаXML"            , СтрокаXML);
		СписокФайлов.Вставить("ИмяФайлаXML"          , ФайлИмя);
		СписокФайлов.Вставить("ВидДокумента"         , ВидДокумента);  
		СписокФайлов.Вставить("КодировкаФайла"       , КодировкаФайла);
		СписокФайлов.Вставить("ДанныеСертификатаЭКОМ", ВыборкаДокумент.ОрганизацияСертификат);
		СписокФайлов.Вставить("СертификатНаСервере"  , ВыборкаДокумент.ОрганизацияСертификат.СертификатНаСервере);
		СписокФайлов.Вставить("ЗаказДата"            , ВыборкаДокумент.ЗаказДата);
		СписокФайлов.Вставить("ЗаказНомер"           , ВыборкаДокумент.ЗаказНомер);
		СписокФайлов.Вставить("ЭЦПотЮЗД"             , ЭЦПотЮЗД); // для проверки - чтобы цепочка была подписана одним сертификатом кв. 4 и кв. 10
		СписокФайлов.Вставить("ПредставлениеДок"     , ВыборкаДокумент.СчетФактураПредставление);
		СписокФайлов.Вставить("Организация"          , ВыборкаДокумент.Организация);
		СписокФайлов.Вставить("Контрагент"           , ВыборкаДокумент.Контрагент);
		СписокФайлов.Вставить("Статус"               , Перечисления.ЭКОМ_Статусы.Загружен);
		СписокФайлов.Вставить("ИдентификаторИспр"    , ВыборкаДокумент.ОснованиеИмяФайла);
		СписокФайлов.Вставить("СтруктураДокумента"   , УзелНачальный);
		СписокФайлов.Вставить("Документ"             , ВыборкаДокумент.СчетФактура);
		СписокФайлов.Вставить("НомерДокумента"       , ВыборкаДокумент.НомерДокумента);
		СписокФайлов.Вставить("ДатаДокумента"        , ВыборкаДокумент.ДатаДокумента);
		
		МассивЗаписейXML.Добавить(СписокФайлов);
	КонецЦикла;
	
	Возврат МассивЗаписейXML;
	
КонецФункции 

Функция ЗаписатьФайлXML(СтруктураДок, ТипФайла, Кодировка) Экспорт
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку(Кодировка);
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ЗаписьXML.ЗаписатьНачалоЭлемента(ТипФайла);
	
	Для каждого СтрокаЭлемента Из СтруктураДок Цикл
		ЗаписатьБлоки(ЗаписьXML, СтрокаЭлемента);
	КонецЦикла;
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); 
	
	Возврат ЗаписьXML.Закрыть();
	
КонецФункции

Процедура ЗаписатьБлоки(ЗаписьXML, СтруктураДок)
	
	// Узел
	Если ТипЗнч(СтруктураДок.Значение) =  Тип("Структура") Тогда
		ЗаписьXML.ЗаписатьНачалоЭлемента(СтруктураДок.Ключ);
		Для каждого СтрокаЭлемента Из СтруктураДок.Значение Цикл
			ЗаписатьБлоки(ЗаписьXML, СтрокаЭлемента);
		КонецЦикла;
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
		// Массив тегов
	ИначеЕсли ТипЗнч(СтруктураДок.Значение) =  Тип("Массив") Тогда
		Для каждого ТекСтрока Из СтруктураДок.Значение Цикл
			ЗаписьXML.ЗаписатьНачалоЭлемента(СтруктураДок.Ключ);
			Для каждого СтрокаЭлемента Из ТекСтрока Цикл
				ЗаписатьБлоки(ЗаписьXML, СтрокаЭлемента);				
			КонецЦикла;
			ЗаписьXML.ЗаписатьКонецЭлемента();
		КонецЦикла;
		
		// Атрибуты
	ИначеЕсли ТипЗнч(СтруктураДок.Значение) =  Тип("СписокЗначений") Тогда
		Для каждого ТекСтрока Из СтруктураДок.Значение Цикл
			Если ЗначениеЗаполнено(ТекСтрока.Представление) Тогда
				ЗаписьXML.ЗаписатьАтрибут(ТекСтрока.Значение, ТекСтрока.Представление);
			КонецЕсли;		
		КонецЦикла;
		
		// Теги
	Иначе
		Если ЗначениеЗаполнено(СтруктураДок.Значение) Тогда
			ЗаписатьXML(ЗаписьXML, СтруктураДок.Значение, СтруктураДок.Ключ);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ЭКОМ_СоздатьКаталогПроверитьНаЗапись(ПолныйПутьКаталога, МассивЛогаСобытий) Экспорт
	
	ИмяСобытия = "Создание и проверка каталогов";
	Каталог = Неопределено;
	Если ЗначениеЗаполнено(ПолныйПутьКаталога) 
		И ТипЗнч(ПолныйПутьКаталога) = Тип("Строка") Тогда
		
		// Создаем каталог 
		Каталог = Новый Файл(ПолныйПутьКаталога);
		Если НЕ Каталог.Существует() Тогда
			Попытка
				СоздатьКаталог(ПолныйПутьКаталога);
				Каталог = Новый Файл(ПолныйПутьКаталога);
			Исключение				
				ТекстЛогаСобытий = "Каталог, указанный в настройках модуля отсутствует. 
				|Ошибка создания каталога по настройке [" + ПолныйПутьКаталога + "] Текст ошибки платформы: " + ОписаниеОшибки();
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
				
				Возврат Неопределено;
				
			КонецПопытки;
			
		КонецЕсли;
		
		// Проверяем на запись
		Попытка
			Текст = Новый ЗаписьТекста(ПолныйПутьКаталога + "ТестНаЗапись.txt", КодировкаТекста.ANSI);    
			Текст.ЗаписатьСтроку("Проверка на запись файлов!");
			Текст.Закрыть();
			
			Попытка
				ФайлПроверкиЗаписи = Новый Файл(ПолныйПутьКаталога + "ТестНаЗапись.txt");
				Если ФайлПроверкиЗаписи.Существует() Тогда
					УдалитьФайлы(ФайлПроверкиЗаписи.ПолноеИмя);
				КонецЕсли;
			Исключение
			КонецПопытки;

			
		Исключение
			ТекстЛогаСобытий = "Нет прав на запись файлов. Текст ошибки платформы: " + ОписаниеОшибки();
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Возврат Неопределено;
			
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Каталог;
	
КонецФункции

// Процедура обновляет текущийи данными элементы справочника ЭКОМ_Роли
//
// Возвращаемое значение:
//   Строка - текст ошибки
//
Функция ОбновитьВсеРоли(ЭтоОФ) Экспорт
	
	ТекстОшибки = "";
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ЭКОМ_Роли.Ссылка
	|ИЗ
	|	Справочник.ЭКОМ_Роли КАК ЭКОМ_Роли";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Ошибка = Ложь;
		СправочникОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		Если СправочникОбъект.Заблокирован() Тогда
			Ошибка = Истина;
		Иначе
			СправочникОбъект.Заблокировать();
			СправочникОбъект.ОбновитьКнопкиИКолонки(ЭтоОФ);
			Попытка
				СправочникОбъект.Записать();
			Исключение
				Ошибка = Истина;
			КонецПопытки;
		КонецЕсли;
		
		Если Ошибка Тогда
			ТекстОшибки = ТекстОшибки + ?(ПустаяСтрока(ТекстОшибки), "", Символы.ПС)
			+ "Объект " + Строка(ВыборкаДетальныеЗаписи.Ссылка) + " заблокирован. Обновление не выполнено.";
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТекстОшибки;
	
КонецФункции // ОбновитьВсеРоли()

Функция РаботаСФайламиВыполняетсяЛокально()
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЭКОМ_ПрофилиОбмена.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ЭКОМ_ПрофилиОбмена КАК ЭКОМ_ПрофилиОбмена
	               |ГДЕ
	               |	ЭКОМ_ПрофилиОбмена.ПроверятьФайлыЛокально";
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Процедура ПередатьФайлВMarking(ФайлЗаписан, ОшибкаЗаписи, СтруктураEDI, НаправитьЮЗДВMarking, ЛокальныйКаталогMarking, ВидыДокументовEDI, ВременныйКаталог)
	Если (СтруктураEDI.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPR_01 
		ИЛИ СтруктураEDI.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPRMARK_01
		ИЛИ СтруктураEDI.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPRPROS_01
		ИЛИ СтруктураEDI.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NKORSCHFDOPPR_01
		ИЛИ СтруктураEDI.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPR_01_Испр
		ИЛИ СтруктураEDI.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPRMARK_01_Испр
		ИЛИ СтруктураEDI.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPRPROS_01_Испр
		ИЛИ СтруктураEDI.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NKORSCHFDOPPR_01_Испр)
		И НаправитьЮЗДВMarking Тогда
		
		ФайлXMLУПД = ПолучитьФайлДокумента(СтруктураEDI, ЛокальныйКаталогMarking);						
		Если ФайлXMLУПД = Неопределено Тогда
			ОшибкаЗаписи = Истина;
		КонецЕсли;
		
		Если ЛокальныйКаталогMarking = ВременныйКаталог Тогда
			СтруктураEDI.Сообщение = " записан во временный каталог";
		Иначе
			СтруктураEDI.Сообщение = " записан в локальный каталог marking";
		КонецЕсли;
		ВидДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.ПустаяСсылка");
		Если СтруктураEDI.Свойство("ВидДокумента", ВидДокумента)
			И НЕ ВидыДокументовEDI.Найти(ВидДокумента) = Неопределено Тогда
			СтруктураEDI.Отправлен = ПредопределенноеЗначение("Перечисление.ЭКОМ_СтатусыЭлектронныхДокументов.Отправлен");
		Иначе
			СтруктураEDI.Отправлен = Истина;
		КонецЕсли;	
		               		
		//при выгрузке УПД в маркировку, отправка и подписание файла будут осуществляться отдельно
		ФайлЗаписан = Истина; 
	КонецЕсли; 
КонецПроцедуры

Процедура ДополнитьАдресКаталога(АдресКаталога)
	Если НЕ Прав(АдресКаталога,1) = "\" Тогда	
		АдресКаталога = АдресКаталога + "\"; 
	КонецЕсли;
КонецПроцедуры

Процедура ОтправитьФайлыИзMarking(ИспользоватьАПИ, ВременныйКаталог, ЛокальныйКаталогMarking, КаталогMarkingАрхив, ФайлыКОтправкеИзМаркировки, ТипДокумента, ПрофильОбмена, ТипОбменаЭТРН, МассивЛогаСобытий)
	Если ИспользоватьАПИ Тогда
		// Создаем архив с файлами для отправки по SOAP   
		Если ВерсияПлатформы() >= 83100 Тогда // Начиная с версии 8.3.10 доступна запись в поток в памяти
			ИмяZipФайла = "";
			ЗаписьZIP   = Новый ЗаписьZipФайла(); // Для использования метода ПолучитьДвоичныеДанные() конструктор дложен быть без параметров.
		Иначе  
			ИмяZipФайла =  ВременныйКаталог + ТипДокумента + "_" + "1" + "_" + Формат(ТекущаяДата(), "ДФ=ddMMyyhhmmss" ) + ".zip"; // чем заменить 1
				ЗаписьZIP   = Новый ЗаписьZipФайла(
				ИмяZipФайла,
				"", // пароль на архив (оставим пустой)
				"Этот архив создан из 1с", // комментарий к архиву
				МетодСжатияZIP.Сжатие, // сжатие или копирование
				УровеньСжатияZIP.Оптимальный,
				МетодШифрованияZIP.Zip20
				);
		КонецЕсли;

		Для Каждого УПДМаркировка Из ФайлыКОтправкеИзМаркировки Цикл
			ЗаписьZIP.Добавить(УПДМаркировка.ПолноеИмя);
			Попытка
				КопироватьФайл(УПДМаркировка.ПолноеИмя, КаталогMarkingАрхив + УПДМаркировка.Имя);
				УдалитьФайлы(УПДМаркировка.ПолноеИмя);
			Исключение
				ТекстЛогаСобытий = ОписаниеОшибки();
				МассивЛогаСобытий.Добавить(ТекстЛогаСобытий);
			КонецПопытки 				
		КонецЦикла;  
		
		Если ВерсияПлатформы() >= 83100 Тогда
			ДвоичныеДанные = Вычислить("ЗаписьZIP.ПолучитьДвоичныеДанные()");
		Иначе
			ЗаписьZIP.Записать();
			ДвоичныеДанные = Новый ДвоичныеДанные(ИмяZipФайла);	
		КонецЕсли;
		
		Рез	= Вычислить("ЭКОМ_ОбщегоНазначения.НовыйSOAPОбращение(ПрофильОбмена, ""sendDocumentsRequest"", , ДвоичныеДанные, МассивЛогаСобытий)");
		Попытка     
			Если НЕ ПустаяСтрока(ИмяZipФайла) Тогда 
				УдалитьФайлы(ИмяZipФайла);
			КонецЕсли;
		Исключение
			ТекстЛогаСобытий = ОписаниеОшибки();
			МассивЛогаСобытий.Добавить(ТекстЛогаСобытий);
		КонецПопытки;
	Иначе
		// отправка через FTP
		Сервер = ПолучитьFTPСоединениеВОбработке(ПрофильОбмена, ТипОбменаЭТРН, МассивЛогаСобытий);	
		Если Сервер = Неопределено Тогда
			МассивЛогаСобытий.Добавить("Отсутствует подключение к FTP!");
			Возврат;
		КонецЕсли;
		
		Для Каждого УПДМаркировка Из ФайлыКОтправкеИзМаркировки Цикл
			ОтправитьФайлыВНужномФорматеПоТипуДокументаПоFTP(УПДМаркировка, Неопределено, ТипДокумента, Сервер, ЛокальныйКаталогMarking, МассивЛогаСобытий, ПрофильОбмена, ТипОбменаЭТРН);
			Попытка
				КопироватьФайл(УПДМаркировка.ПолноеИмя, КаталогMarkingАрхив + УПДМаркировка.Имя);
				УдалитьФайлы(УПДМаркировка.ПолноеИмя);
			Исключение
				ТекстЛогаСобытий = ОписаниеОшибки();
				МассивЛогаСобытий.Добавить(ТекстЛогаСобытий);
			КонецПопытки 				
		КонецЦикла;  
		
	КонецЕсли;
КонецПроцедуры

