КонецПроцедуры

// Возвращает доступные текущему пользователю роли
//
// Возвращаемое значение:
//   Массив   - коллекция доступных ролей
//
Функция ПолучитьРолиТекущегоПользвоателя() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЭКОМ_ПользователиРоли.Роль
	               |ИЗ
	               |	Справочник.ЭКОМ_Пользователи.Роли КАК ЭКОМ_ПользователиРоли
	               |ГДЕ
	               |	ЭКОМ_ПользователиРоли.Ссылка.Пользователь = &ТекущийПользователь
	               |	И НЕ ЭКОМ_ПользователиРоли.Ссылка.ПометкаУдаления
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЭКОМ_ПользователиРоли.НомерСтроки";
	Запрос.УстановитьПараметр("ТекущийПользователь", ПараметрыСеанса.ТекущийПользователь);
	РезультатЗапроса = Запрос.Выполнить();
	Роли = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку(0);
	Если Роли.Количество() = 0 Тогда  
		Попытка
			Роли.Добавить(Справочники.ЭКОМ_Роли.ПоУмолчанию);
		Исключение                       
			Роль = Справочники.ЭКОМ_Роли.НайтиПоНаименованию("По умолчанию");
			Если НЕ Роль = Неопределено Тогда
				Роли.Добавить(Роль);
			КонецЕсли;
		КонецПопытки;
	КонецЕсли;
	
	Возврат Роли;

КонецФункции // ПолучитьРолиТекущегоПользвоателя()

// <Описание функции>
//
// Параметры:
//  Роли  - Массив - коллекция доступных текущему пользователю ролей
//
// Возвращаемое значение:
//   <Тип.Вид>   - <описание возвращаемого значения>
//
Функция ПолучитьОграниченияДоступаПоКонтрагентам() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЭКОМ_РолиОграниченияПоКонтрагентам.Имя,
		|	ЭКОМ_РолиОграниченияПоКонтрагентам.Контрагент,
		|	МАКСИМУМ(ЭКОМ_РолиОграниченияПоКонтрагентам.Доступность) КАК Доступность
		|ИЗ
		|	Справочник.ЭКОМ_Роли.ОграниченияПоКонтрагентам КАК ЭКОМ_РолиОграниченияПоКонтрагентам
		|ГДЕ
		|	ЭКОМ_РолиОграниченияПоКонтрагентам.Ссылка В(&Роли)
		|
		|СГРУППИРОВАТЬ ПО
		|	ЭКОМ_РолиОграниченияПоКонтрагентам.Имя,
		|	ЭКОМ_РолиОграниченияПоКонтрагентам.Контрагент";
	
	Запрос.УстановитьПараметр("Роли", ПолучитьРолиТекущегоПользвоателя());
	
	Возврат Запрос.Выполнить().Выгрузить();
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл

	КонецЦикла;

КонецФункции // ПолучитьОграниченияДоступаПоКонтрагентам()

Функция ПолучитьДоступностьApiПоСтране() Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ЭКОМ_ПрофилиОбмена.Страна КАК Страна
	               |ИЗ
	               |	Справочник.ЭКОМ_ПрофилиОбмена КАК ЭКОМ_ПрофилиОбмена
	               |ГДЕ
	               |	ЭКОМ_ПрофилиОбмена.Активный = ИСТИНА";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Если НРег(Выборка.Страна) = "kz" Тогда
			Возврат Ложь;
		Иначе
			Возврат Истина;
		КонецЕсли;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Область REST API 

// Область ПолучениеДокументовREST

Функция ПолучитьВходящиеДокументыREST_API(ПрофильОбмена, ИдентификаторыУчастников, ТипДокумента, ФайлыНаПлатформе, МассивЛогаСобытий, Каталог) Экспорт
	Результат          = Новый Массив;
	ИмяСобытия         = "Получение входящих файлов по REST API";  
	
	ДанныеАвторизации = ЭКОМ_ВзаимодействиеREST_API.ВыполнитьАвторизациюАтолл(ПрофильОбмена);
	Если Не ДанныеАвторизации.Получены Тогда
		ТекстЛогаСобытий = "Не удалось выполнить авторизацию." + ТипДокумента;
		ДобавитьЗаписьВМассивЛога(МассивЛогаСобытий, ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		Возврат Результат;
	КонецЕсли;
	ДанныеПодключения = ЭКОМ_ВзаимодействиеREST_API.ПолучитьДанныеПодключенияEvolution(ПрофильОбмена);
	// получение типа документооборота для выбора соответствующего метода Атолл АПИ (EDI, CONDRA, ЮЗД)
	ТипДокументооборота = ПолучитьТипДокументооборота(ТипДокумента);
	// обход всех GLN с группировкой т.к. документы из платформы получаются отдельно по каждому идентифкатору
	Для Каждого ИдУчастника Из ИдентификаторыУчастников Цикл
		МассивДокументов = ПолучитьСписокДокументовАтолл(ТипДокумента, ТипДокументооборота, ДанныеПодключения, ИдУчастника);
		Для Каждого ДокументEDI Из МассивДокументов Цикл
			ДокИд  = ДокументEDI.Получить("Идентификатор");
			НовСтр = ФайлыНаПлатформе.Добавить();
			НовСтр.Расширение    = "XML";
			НовСтр.ФайлИмя       = ТипДокумента + "_" + ИдУчастника + "_" + ДокИд;
			НовСтр.Идентификатор = НовСтр.ФайлИмя;
		КонецЦикла;
	КонецЦикла;
	// проверка наличия информации о непрочитанных документах на платформе
	Если ФайлыНаПлатформе.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;  
	
	// отбор - получение только тех документов, которые не были загружены ранее
	ТаблицаНезагруженных = ПроверитьСписокЗагружаемыхДокументов(ФайлыНаПлатформе, ТипДокумента);	
	Для Каждого Строка Из ТаблицаНезагруженных Цикл
		Идентификатор 	  = СтрЗаменить(Строка.Идентификатор, ТипДокумента + "_", "");
		СимволРазделитель = Найти(Идентификатор, "_");
		Если СимволРазделитель = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ИдУчастника = Лев(Идентификатор, СимволРазделитель - 1);
		ДокИд		= Прав(Идентификатор, СтрДлина(Идентификатор) - СимволРазделитель); 
		ДокИд 		= СтрЗаменить(ДокИд, "-", "");
		
		СтруктураФайла = ПолучитьВходящийДокументАтолл(ДанныеПодключения, ТипДокумента, Каталог, ИдУчастника, ДокИд, ТипДокументооборота);
		Если СтруктураФайла <> Неопределено Тогда
			Результат.Добавить(СтруктураФайла);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;   	
КонецФункции

Функция ПолучитьТипДокументооборота(Знач ТипДокумента)
	ТипДокументооборота = "";
	
	ТипыEDI = ЭКОМ_ВзаимодействиеREST_API.ПолучитьМассивТиповEDI();
	ТипыЮЗД = ЭКОМ_ВзаимодействиеREST_API.ПолучитьМассивТиповЮЗД();
	Если ТипыEDI.Найти(ТипДокумента) <> Неопределено Тогда
		 ТипДокументооборота = "EDI";
	ИначеЕсли ТипДокумента = "CONDRA" Тогда
		 ТипДокументооборота = "CNDR";
	ИначеЕсли ТипыЮЗД.Найти(ТипДокумента) <> Неопределено Тогда
		 ТипДокументооборота = "ЮЗД";
	КонецЕсли;
	
	Возврат ТипДокументооборота;
КонецФункции

Функция ПолучитьВходящийДокументАтолл(ДанныеПодключения, ТипДокумента, Каталог, ИдУчастника, ДокИд, ТипДокументооборота)
	ЯвляетсяEDI    = ТипДокументооборота = "EDI";
	ЯвляетсяCONDRA = ТипДокументооборота = "CDNR";
	ЯвляетсяЮЗД    = ТипДокументооборота = "ЮЗД";
	
	ПараметрыМетода = Новый Структура("guid, doc_uuid", ИдУчастника, ДокИд); 
	Если ЯвляетсяEDI Тогда
		ПараметрыМетода = Новый Структура("gln, doc_id", ИдУчастника, ДокИд); 
		ОтветAPI = ЭКОМ_ВзаимодействиеREST_API.ПолучитьВходящийДокументEDI(ПараметрыМетода, ДанныеПодключения, Каталог, ТипДокумента);
	ИначеЕсли ЯвляетсяCONDRA Тогда
		ОтветAPI = ЭКОМ_ВзаимодействиеREST_API.ПолучитьВходящийДокументCONDRA(ПараметрыМетода, ДанныеПодключения, Каталог, ТипДокумента);
	Иначе
		ОтветAPI = ЭКОМ_ВзаимодействиеREST_API.ПолучитьВходящийДокументЮЗД(ПараметрыМетода, ДанныеПодключения, Каталог, ТипДокумента);
	КонецЕсли;
	
	Если ОтветAPI.Успешно Тогда
		Файл		   = ОтветAPI.ФайлBody;
		СтруктураФайла = Новый Структура;
		СтруктураФайла.Вставить("ИдУчастника"	  , ИдУчастника);
		СтруктураФайла.Вставить("ДокИд"		      , ДокИд);
		СтруктураФайла.Вставить("ИмяБезРасширения", Файл.ИмяБезРасширения);
		СтруктураФайла.Вставить("ФайлИмя"		  ,	Файл.Имя);
		СтруктураФайла.Вставить("ФайлXML"		  ,	Файл);
		Если ОтветAPI.Свойство("МассивПодписей") Тогда
			МассивПодписей = ОтветAPI.МассивПодписей;
			Если МассивПодписей.Количество() Тогда
				СтруктураФайла.Вставить("ФайлBIN",	МассивПодписей[0]);
			КонецЕсли;
		ИначеЕсли ОтветAPI.Свойство("ФайлПодпись") Тогда
			СтруктураФайла.Вставить("ФайлBIN",	ОтветAPI.ФайлПодпись);
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтруктураФайла;
КонецФункции

Функция ПолучитьСписокДокументовАтолл(ТипДокумента, ТипДокументооборота, ДанныеПодключения, ИдУчастника)
	СписокДокументов = Новый Массив;
	
	Если ДанныеПодключения.ПолученПрофиль И ДанныеПодключения.ПолученТокен Тогда
		ТипДокАтолл  = ЭКОМ_ВзаимодействиеREST_API.ПреобразоватьТипДокументаКЗначениюАтолл(ТипДокумента, ТипДокументооборота);
		
		ПараметрыМетода = Новый Структура("guid, unread, limit", ИдУчастника, Истина, "10000");
		Если ТипДокументооборота = "EDI" Тогда
			ПараметрыМетода = Новый Структура("gln, status, doc_type, limit", ИдУчастника, "inbox", ТипДокАтолл, "10000");
			СписокДокументов = ЭКОМ_ВзаимодействиеREST_API.ПолучитьСписокВходящихДокументовEDI(ПараметрыМетода, ДанныеПодключения); 
		ИначеЕсли ТипДокументооборота = "CNDR" Тогда 
			СписокДокументов = ЭКОМ_ВзаимодействиеREST_API.ПолучитьСписокВходящихДокументовCONDRA(ПараметрыМетода, ДанныеПодключения);
		ИначеЕсли ТипДокументооборота = "ЮЗД" Тогда
			СписокДокументов = ЭКОМ_ВзаимодействиеREST_API.ПолучитьСписокВходящихДокументовЮЗД(ПараметрыМетода, ДанныеПодключения, ТипДокАтолл);
		Иначе
			Возврат СписокДокументов;
		КонецЕсли;
		
		ИмяИдентификатора = ПолучитьСоответствиеАтоллПоТипуДокумента(ТипДокументооборота, "получение_документа", "идентификатор");
		Для Каждого Документ Из СписокДокументов Цикл
			Идентификатор = Строка(Документ.Получить(ИмяИдентификатора));
			Идентификатор = СтрЗаменить(Идентификатор, " ", "-");
			Идентификатор = СтрЗаменить(Идентификатор, Символы.НПП, "-");
		
			Документ.Вставить("Идентификатор", Идентификатор);
		КонецЦикла;
		
	Иначе
		Сообщить("Не получен профиль обмена и (или) токен");
	КонецЕсли;
	
	Возврат СписокДокументов;
КонецФункции

Функция ПолучитьСоответствиеАтоллПоТипуДокумента(ТипДокументооборота, ИмяОперации, ИмяПоля)
	  Атолл = Новый Соответствие;
	  Атолл.Вставить("EDI-получение_документа-идентификатор", "docID");
	  Атолл.Вставить("ЮЗД-получение_документа-идентификатор", "docUUID");
	  Атолл.Вставить("CNDR-получение_документа-идентификатор", "doc_uuid");
	  
	  Возврат Атолл.Получить(ТипДокументооборота + "-" + ИмяОперации + "-" + ИмяПоля);
	  
КонецФункции

Процедура ОтметитьДокументыАтоллПрочитанными(МассивОбработанныхФайловСПлатформы, ПрофильОбмена, ТипДокумента)
	ТипДокументооборота = ПолучитьТипДокументооборота(ТипДокумента);
	
	ДанныеПодключения = ЭКОМ_ВзаимодействиеREST_API.ПолучитьДанныеПодключенияEvolution(ПрофильОбмена);
	Для Каждого Элемент Из МассивОбработанныхФайловСПлатформы Цикл
		Идентификатор = СтрЗаменить(Элемент.Имя  , ТипДокумента + "_", "");
		Идентификатор = СтрЗаменить(Идентификатор, ".xml", "");
		СимволРазделитель = Найти(Идентификатор, "_");
		Если СимволРазделитель = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ИдУчастника = Лев(Идентификатор, СимволРазделитель - 1);
		ДокИд  		= Прав(Идентификатор, СтрДлина(Идентификатор) - СимволРазделитель);
		
		Если ТипДокументооборота = "EDI" Тогда
			ПараметрыМетода = Новый Структура("gln, doc_id, status, description", ИдУчастника, ДокИд, "read", "прочитано модулем 1С");
			ЭКОМ_ВзаимодействиеREST_API.ОтметитьEdiПрочитанными(ПараметрыМетода, ДанныеПодключения);
		ИначеЕсли ТипДокументооборота = "CDNR" Тогда
			ПараметрыМетода = Новый Структура("guid, doc_uuid, read", ИдУчастника, ДокИд, Истина);
			ЭКОМ_ВзаимодействиеREST_API.ОтметитьCONDRAПрочитанными(ПараметрыМетода, ДанныеПодключения);
		ИначеЕсли ТипДокументооборота = "ЮЗД" Тогда
			ПараметрыМетода = Новый Структура("guid, identifier, read", ИдУчастника, ДокИд, Истина);
			ЭКОМ_ВзаимодействиеREST_API.ОтметитьЮЗДПрочитанными(ПараметрыМетода, ДанныеПодключения);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
// КонецОбласти ПолучениеДокументовREST

// Область ОтправкаДокументовREST 

Процедура ОтправитьДокументыИспользуяАтоллАПИ(МассивФайлов, ПрофильОбмена, ТипДокумента, ВременныйКаталог, МассивЛогаСобытий)
	ИмяСобытия		    = "Отправка документов " + ТипДокумента + " через REST API.";
	
	ДанныеАвторизации = ЭКОМ_ВзаимодействиеREST_API.ВыполнитьАвторизациюАтолл(ПрофильОбмена);
	Если Не ДанныеАвторизации.Получены Тогда
		ТекстЛогаСобытий = "Не удалось выполнить авторизацию." + ТипДокумента;
		ДобавитьЗаписьВМассивЛога(МассивЛогаСобытий, ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		Возврат;
	КонецЕсли;
	
	МассивЛогаСобытий   = Новый Массив;
	ТипДокументооборота = ПолучитьТипДокументооборота(ТипДокумента);
	Если ТипДокументооборота = "" Тогда
		ТекстЛогаСобытий = "Не удалось определить тип документооборота для типа документа: " + ТипДокумента;
		ДобавитьЗаписьВМассивЛога(МассивЛогаСобытий, ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		Возврат;
	КонецЕсли;
	ЯвляетсяEDI         = ТипДокументооборота = "EDI";
	СтатусПодписанта    = "";
	// формирование данных для тела запроса REST
	Для Каждого СтруктураEDI Из МассивФайлов Цикл
		Если ЯвляетсяEDI Тогда
			ТелоBase64  = СодержимоеДокументаВСтрокуBase64(СтруктураEDI.СтрокаXML); 
		Иначе
			// TODO: дополнить СтруктураEDI base64 на этапе формирования структуры, для ускорения отправки
			ФайлДокумента  = ПолучитьФайлДокумента(СтруктураEDI, ВременныйКаталог);
			ДвоичныеДанные = Новый ДвоичныеДанные(ФайлДокумента.ПолноеИмя);
			ТелоBase64     = ЭКОМ_ОбщегоНазначения.ДвоичныеДанныеВBase64(ДвоичныеДанные);
		КонецЕсли;
		Если СтруктураEDI.Свойство("ДвоичныеДанныеФайлаBIN") Тогда
			ПодписьBase64    = ЭКОМ_ОбщегоНазначения.ДвоичныеДанныеВBase64(СтруктураEDI.ДвоичныеДанныеФайлаBIN);
			СтатусПодписанта = СтатусПодписантаПоСертификату(СтруктураEDI.ДанныеСертификатаЭКОМ);
			Если СтатусПодписанта = "" Тогда
				// TODO: обработать ошибку, добавить логирование
				Сообщить("Не заполнен статус подписанта");
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		// формирование тела запроса, выполнение запроса REST
		ДанныеПодключения = ЭКОМ_ВзаимодействиеREST_API.ПолучитьДанныеПодключенияEvolution(ПрофильОбмена);
		Если ТипДокументооборота = "CNDR" Тогда
			ТелоЗапроса  = ПолучитьТелоЗапроса_ОтправкаДокументовCONDRA(ТипДокумента, ЯвляетсяEDI, ТелоBase64, ПодписьBase64);
			РезультатAPI = ЭКОМ_ВзаимодействиеREST_API.ОтправитьCONDRAАтолл(Телозапроса, ДанныеПодключения);
		Иначе
			Если ЯвляетсяEDI Тогда
				DocType = ТипДокумента;
			Иначе
				DocTypesЮЗД = ЭКОМ_ВзаимодействиеREST_API.СоответсивеDocTypeВидуДокументов_Атолл();
				DocType		= DocTypesЮЗД.Получить(СтруктураEDI.ВидДокумента);
			КонецЕсли;
			ТелоЗапроса  = ПолучитьТелоЗапроса_ОтправкаДокументов(DocType, ЯвляетсяEDI, ТелоBase64, ПодписьBase64, СтатусПодписанта);
			РезультатAPI = ЭКОМ_ВзаимодействиеREST_API.Отправить_ДокументEDI_ЮЗД_Атолл(Телозапроса, ДанныеПодключения);
		КонецЕсли;

		// обработка ответа REST API
		Если РезультатAPI.Успешно Тогда
			// при успешной отправке изменяются специальные элементы структуры, для постобработки
			СоответствиеGLN   = ПолучитьСоответствиеОрганизацияGLN();
			
			СтруктураEDI.Сообщение = " успешно отправлен по REST API";
			Если ЯвляетсяEDI Тогда
				СтруктураEDI.Отправлен = ПредопределенноеЗначение("Перечисление.ЭКОМ_СтатусыЭлектронныхДокументов.Отправлен");
			Иначе
				СтруктураEDI.Отправлен = Истина;
			КонецЕсли;
			
			Если ЯвляетсяEDI Тогда
				СтруктураEDI.Вставить("Идентификатор", ТипДокумента + "_" + СоответствиеGLN.Получить(СтруктураEDI.Организация).GLN + "_" + РезультатAPI.ДокИд);
			ИначеЕсли ТипДокументооборота = "ЮЗД" Тогда	
				СтруктураEDI.Вставить("Идентификатор", ТипДокумента + "_" + СоответствиеGLN.Получить(СтруктураEDI.Организация).ИдУчастника + "_" + РезультатAPI.ДокИд);
			Иначе
				СтруктураEDI.Вставить("Идентификатор", РезультатAPI.ДокИд);
			КонецЕсли;
		Иначе										
			ТекстЛогаСобытий = "Ошибка отправки файла " + СтруктураEDI.ИмяФайлаXML;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ПолучитьСоответствиеОрганизацияGLN()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЭКОМ_GLN.Объект КАК Организация,
	               |	ЭКОМ_GLN.GLN КАК GLN,
	               |	ЭКОМ_GLN.Ид_ОЭД КАК ИдУчастника
	               |ИЗ
	               |	РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN";
	Выборка = Запрос.Выполнить().Выбрать();
	СоответствиеGLN = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		СтруктураРезультат = Новый Структура("GLN, ИдУчастника", Выборка.GLN, Выборка.ИдУчастника);
		СоответствиеGLN.Вставить(Выборка.Организация, СтруктураРезультат);
	КонецЦикла;
	
	Возврат СоответствиеGLN;	
КонецФункции

Функция ПолучитьТелоЗапроса_ОтправкаДокументов(ТипДокумента, ЯвляетсяEDI, ТелоBase64, ПодписьBase64, СтатусПодписанта)
	ТелоЗапроса = Новый Соответствие;
	ТелоЗапроса.Вставить("body"   , ТелоBase64);
	ТелоЗапроса.Вставить("docType", ТипДокумента);
	Если ЯвляетсяEDI Тогда
		ТелоЗапроса.Вставить("docName", ТипДокумента);
	ИначеЕсли ПодписьBase64 <> Неопределено Тогда
		ТелоЗапроса.Вставить("sign", ПодписьBase64);
		МассивSigns = Новый Массив;
		СоответствиеSign = Новый Соответствие;
		СоответствиеSign.Вставить("body", ПодписьBase64);
		СоответствиеSign.Вставить("type", СтатусПодписанта);
		МассивSigns.Добавить(СоответствиеSign);
		Телозапроса.Вставить("signs", МассивSigns);
	КонецЕсли;
	Возврат ТелоЗапроса;
КонецФункции

Функция ПолучитьТелоЗапроса_ОтправкаДокументовCONDRA(ТипДокумента, ЯвляетсяEDI, ТелоBase64, ПодписьBase64)
	ТелоЗапроса = Новый Соответствие;
	ТелоЗапроса.Вставить("date"   , ТелоBase64);
	ТелоЗапроса.Вставить("number", ТипДокумента);
	ТелоЗапроса.Вставить("condraType", ТелоBase64);
	ТелоЗапроса.Вставить("sender", ТипДокумента);
	ТелоЗапроса.Вставить("recipient"   , ТелоBase64);
	ТелоЗапроса.Вставить("body", ТипДокумента);
	ТелоЗапроса.Вставить("contractDate"   , ТелоBase64);
	ТелоЗапроса.Вставить("contractNumber", ТипДокумента);
	ТелоЗапроса.Вставить("info", ТипДокумента);
	ТелоЗапроса.Вставить("internalID"   , ТелоBase64);
	ТелоЗапроса.Вставить("sign", ТипДокумента);
	Возврат ТелоЗапроса;
КонецФункции

Функция СодержимоеДокументаВСтрокуBase64(Знач Строка)
		ПотокПамять = Новый ПотокВПамяти;
		Писатель    = Новый ЗаписьДанных(ПотокПамять,,, "");
		Писатель.ЗаписатьСтроку(Строка, КодировкаТекста.UTF8, );
		Писатель.Закрыть();
		
		ДвоичныеДанные = ПотокПамять.ЗакрытьИПолучитьДвоичныеДанные();
		СтрокаBase64   = Base64Строка(ДвоичныеДанные);
		СтрокаBase64   = СтрЗаменить(СтрокаBase64, Символы.ПС, "");
		СтрокаBase64   = СтрЗаменить(СтрокаBase64, Символы.ВК, "");
		
		Возврат СтрокаBase64;
КонецФункции

Функция СтатусПодписантаПоСертификату(СертификатЭКОМ)
	СтатусПодписанта = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЭКОМ_Сертификаты.СтатусПодписанта
	|ИЗ
	|	Справочник.ЭКОМ_Сертификаты КАК ЭКОМ_Сертификаты
	|ГДЕ
	|	ЭКОМ_Сертификаты.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", СертификатЭКОМ);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СтатусПодписанта = Выборка.СтатусПодписанта;
	КонецЕсли;
	
	Возврат СтатусПодписанта;
КонецФункции
