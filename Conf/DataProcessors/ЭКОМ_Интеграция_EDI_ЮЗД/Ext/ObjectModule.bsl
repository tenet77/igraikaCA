// Функция получает настройки для выгрузки данных из документа 1С в файл XML
//
// Параметры
//  ТипТранзакции  	- Строка - тип исходящего документа
//
// Возвращаемое значение:
//   ДеревоЗначений	- содержит макет структуры исходящего документа с пользовательскими настройками
//
Функция ПолучитьСтруктуруФайлаДанных(ТипТранзакции) Экспорт
	
	ЭКОМ_СтруктураФайлаXMLВходящие 	= Настройка_Параметр_Прочитать("СтруктураФайлаXMLВходящие", 	Новый ДеревоЗначений);
	ЭКОМ_СтруктураФайлаXMLИсходящие	= Настройка_Параметр_Прочитать("СтруктураФайлаXMLИсходящие", 	Новый ДеревоЗначений);
	ЭКОМ_СтруктураФайлаXMLДокументы = Настройка_Параметр_Прочитать("СтруктураФайлаXMLДокументы", 	Новый ДеревоЗначений);
	
	// Поиск по вкладке Исходящие.
	Результат	= ЭКОМ_СтруктураФайлаXMLИсходящие.Скопировать();
	Если НЕ Результат.Колонки.Найти("ТипТранзакции") = Неопределено Тогда
		Индекс 	= Результат.Строки.Количество() - 1;
		Пока НЕ Индекс < 0 Цикл
			Строка = Результат.Строки.Получить(Индекс);
			Если НЕ Строка.ТипТранзакции = ТипТранзакции Тогда
				Результат.Строки.Удалить(Строка);
			КонецЕсли;
			Индекс = Индекс - 1;
		КонецЦикла;
	КонецЕсли;
	
	// Поиск по вкладке Входящие.
	Если Результат.Строки.Количество() = 0 Тогда
		Результат	= ЭКОМ_СтруктураФайлаXMLВходящие.Скопировать();
		Если НЕ Результат.Колонки.Найти("ТипТранзакции") = Неопределено Тогда
			Индекс 		= Результат.Строки.Количество() - 1;
			Пока НЕ Индекс < 0 Цикл
				Строка = Результат.Строки.Получить(Индекс);
				Если НЕ Строка.ТипТранзакции = ТипТранзакции Тогда
					Результат.Строки.Удалить(Строка);
				КонецЕсли;
				Индекс = Индекс - 1;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	//Поиск по вкладке Документы.
	Если Результат.Строки.Количество() = 0 Тогда		
		Результат	= ЭКОМ_СтруктураФайлаXMLДокументы.Скопировать();
		Если НЕ Результат.Колонки.Найти("Кнопка") = Неопределено Тогда
			Индекс 		= Результат.Строки.Количество() - 1;
			Пока НЕ Индекс < 0 Цикл
				Строка = Результат.Строки.Получить(Индекс);
				Если НЕ Строка.Кнопка = ТипТранзакции Тогда
					Результат.Строки.Удалить(Строка);
				КонецЕсли;
				Индекс = Индекс - 1;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ?(Результат.Строки.Количество() = 0, Новый ДеревоЗначений, Результат);
	
КонецФункции // ПолучитьСтруктуруФайлаДанных()

// Формирует поля для запроса и подставляет в пользовательский код переменные для получения данных из результата запроса
//
// Параметры:
//  Дерево  		- ДеревоЗначений - содержит макет структуры исходящего документа с пользовательскими настройками
//  ПоляЗапроса  	- Соответствие - поля запроса
//  Входящий  		- Булево - признак работы со входящим документом
//
Процедура ОбходСтруктурыФайлаДанных(Дерево, ПоляЗапроса, Входящий = Ложь, ИмяКолонки = "", МассивЛогаСобытий, ЭКОМ_ДеревоКонфигурации = Неопределено)
	
	Если ЭКОМ_ДеревоКонфигурации = Неопределено Тогда
		ЭКОМ_ДеревоКонфигурации = Настройка_Параметр_Прочитать("СлужебныйДеревоКонфигурации", , "Служебный");
	КонецЕсли;
	
	Для Каждого Строка Из Дерево.Строки Цикл
		
		// Проверка флага "Использовать" для строки и родительских элементов.
		СтрокаРодитель	= Строка;
		Использовать	= Истина;
		
		Пока НЕ СтрокаРодитель = Неопределено Цикл
			Использовать = ?(СтрокаРодитель.Использовать = Истина, Использовать, Ложь);
			СтрокаРодитель = СтрокаРодитель.Родитель;
		КонецЦикла;
		
		Если НЕ Использовать Тогда
			Продолжить;
		КонецЕсли;
		
		// Подменяем синонимы в приемнике именами объектов и реквизитов. Пока только для входящих. Потом и для исходящих.
		Если Входящий Тогда
			
			Если ЗначениеЗаполнено(Строка.Приемник) Тогда
				Путь = ПолучитьПутьКРеквизитуПоСинониму(Строка, "Приемник", МассивЛогаСобытий, ЭКОМ_ДеревоКонфигурации);
				
				Пока Найти(Путь, ".") > 0 Цикл
					Путь = Прав(Путь, СтрДлина(Путь) - Найти(Путь, "."));
				КонецЦикла;
				
				Строка.Приемник = Путь;
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Строка.Формула) Тогда // Достаем поля в запрос, меняем код под результат выполнения запроса
			ПолучитьПоляЗапроса(Строка.Формула, ПоляЗапроса, Входящий, МассивЛогаСобытий);
		ИначеЕсли ЗначениеЗаполнено(Строка.Служебные) И ТипЗнч(Строка.Служебные) = Тип("Структура") Тогда // Работа с служебными значениями (структура)
			Для Каждого СтрокаСлужеб Из Строка.Служебные Цикл
				Если ЗначениеЗаполнено(СтрокаСлужеб.Значение) Тогда 
					ПолучитьПоляЗапроса(Строка.Служебные[СтрокаСлужеб.Ключ], ПоляЗапроса, Входящий, МассивЛогаСобытий);
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли ЗначениеЗаполнено(Строка.Служебные) И ТипЗнч(Строка.Служебные) = Тип("Строка") Тогда
			ПолучитьПоляЗапроса(Строка.Служебные, ПоляЗапроса, Входящий, МассивЛогаСобытий);
		ИначеЕсли Входящий И ЗначениеЗаполнено(Строка.Источник) И ЗначениеЗаполнено(Строка.Приемник) И Строка.Строки.Количество() = 0 Тогда // Для создания документа из документа ЭКом
			Формула = ПолучитьПутьКРеквизитуПоСинониму(Строка, "Источник", МассивЛогаСобытий, ЭКОМ_ДеревоКонфигурации);
			ПозицияТочки = Найти(Формула, ".");
			
			Если ПозицияТочки = 0 Тогда
				Формула = ?(ПустаяСтрока(ИмяКолонки), "ЭлектронныйДокумент", "Источник");
			ИначеЕсли НЕ Строка.Родитель.Уровень() = 0 Тогда // Это строка табличной части
				Формула = Прав(Формула, СтрДлина(Формула) - ПозицияТочки); // Удаляем представление документа
				ПозицияВторойТочки = Найти(Формула, "."); // Находим точку после определения табличной части
				Формула = "Строка" + Сред(Формула, ПозицияВторойТочки); // Заменяем определение таличной части на предопределенную переменную "Строка".
			Иначе
				Формула = ?(ПустаяСтрока(ИмяКолонки), "ЭлектронныйДокумент", "Источник") + Сред(Формула, ПозицияТочки);
			КонецЕсли;
			
			Строка.Формула = "Возврат " + Формула;
			ПолучитьПоляЗапроса(Строка.Формула, ПоляЗапроса, Входящий, МассивЛогаСобытий);
		КонецЕсли;
		
		// Рекурсия.
		ОбходСтруктурыФайлаДанных(Строка, ПоляЗапроса, Входящий, ИмяКолонки, МассивЛогаСобытий, ЭКОМ_ДеревоКонфигурации);
		
	КонецЦикла;
	
КонецПроцедуры

// Функция возвращает полный путь к реквизиту документа, состоящий из имен элементов,
// которые получаются из синонимов в передаваемой строки дерева значений.
// Функция работает как со строкой, содержащей синонимы, так и со строкой,
// состоящей из имен реквизитов (свойства "Имя", "Синоним" значения типа ОбъектМетаданных: Документ).
//
// Параметры:
//  Строка  	- СтрокаДереваЗначений - строка с реквизитом, для которого нужно получить путь
//  Синоним  	- Строка - синоним искомого реквизита
//
// Возвращаемое значение:
//   Строка   - полный путь к реквизиту в дереве конфигурации
//		Пример: "ЗаказПокупателя.Контрагент.Наименование"
//
Функция ПолучитьПутьКРеквизитуПоСинониму(Строка, Имя, МассивЛогаСобытий, ЭКОМ_ДеревоКонфигурации)
	
	СтрокаРодитель			= Строка;
	МассивСинонимов 		= Новый Массив;
	Путь = "";
		
	Пока НЕ СтрокаРодитель 	= Неопределено Цикл
		
		МассивСинонимов.Добавить(СтрокаРодитель[Имя]);
		СтрокаРодитель 		= СтрокаРодитель.Родитель;
		
	КонецЦикла; 
	
	МаксИндекс 				= МассивСинонимов.ВГраница();
	СтрокиДерева 			= ЭКОМ_ДеревоКонфигурации;
	
	Для Вычитаемое 			= 0 По МаксИндекс Цикл
		
		Имя 				= МассивСинонимов.Получить(МаксИндекс - Вычитаемое);
		
		Если СтрокиДерева.Строки.Найти(Имя, "Синоним") = Неопределено Тогда 
			СтрокиДерева	= СтрокиДерева.Строки.Найти(Имя, "Имя");
		Иначе
			СтрокиДерева	= СтрокиДерева.Строки.Найти(Имя, "Синоним");
		КонецЕсли;
		
		Если СтрокиДерева	= Неопределено Тогда
			ТекстЛогаСобытий = "Ошибка при поиске объекта конфигурации. " + Имя;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, "Получение полного пути к реквизиту документа");
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

			Возврат Путь;
		КонецЕсли;
		
		Путь 				= Путь + ?(ПустаяСтрока(Путь), "", ".") + СтрокиДерева.Имя;
		
	КонецЦикла;
	
	Возврат Путь;
	
КонецФункции // ПолучитьПутьКРеквизитуПоСинониму()

// Процедура заполняет документ 1С по данным документа Docrobot
//
// Параметры:
//	СтруктураФайлаДанных - ДеревоЗначений - шаблон для заполнения документа 1С
//  ЭлектронныйДокумент  - ДокументСсылка.ЭКОМ_Документы - ссылка на исходный документ Docrobot
//  Документ  - ДокументОбъект - документ для заполнения
//
Процедура ЗаполнитьДокумент(СтруктураФайлаДанных, ТаблицаЗначений, Приемник, ВыборкаЗарезервировано, ВыборкаСтроки, МассивЛогаСобытий)
	
	ИмяСобытия = "Заполнение документа";
	Для Каждого СтрокаШаблона Из СтруктураФайлаДанных.Строки Цикл
		
		СтрокаРодитель	= СтрокаШаблона;
		Использовать	= Истина;
		
		Пока НЕ СтрокаРодитель = Неопределено Цикл
			Использовать = ?(СтрокаРодитель.Использовать = Истина, Использовать, Ложь);
			СтрокаРодитель = СтрокаРодитель.Родитель;
		КонецЦикла;
		
		Если Использовать И ЗначениеЗаполнено(СтрокаШаблона.Формула) Тогда // Реквизиты документа
			
			Результат 	= Неопределено;
			
			Попытка
				Выполнить(СтрЗаменить(СтрокаШаблона.Формула, "¶", Символы.ПС));
			Исключение
				ТекстЛогаСобытий = "Ошибка в получении значения тега """ + СтрокаШаблона.Приемник + """: " + ОписаниеОшибки();
				Описание  = ОписаниеСтрокиГибкихНастроек(СтрокаШаблона);
				Ошибка    = ОписаниеОшибки();
				ТекстЛогаСобытий = ТекстЛогаСобытий + Символы.ПС + Ошибка + Символы.ПС + Описание;
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

			КонецПопытки;
			
			Если НЕ ПустаяСтрока(СтрокаШаблона.Приемник) Тогда
				Приемник[СтрокаШаблона.Приемник] = Результат; // Значение, которое запишется в тег файла XML
			КонецЕсли;
			
		ИначеЕсли Использовать И СтрокаШаблона.Строки.Количество() > 0 Тогда // Табличная часть
			
			// Очищаем табличную часть, чтобы заполнить ее по данным входящего документа.
			Приемник[СтрокаШаблона.Приемник].Очистить();
			
			Для Каждого Строка Из ВыборкаСтроки.НайтиСтроки(Новый Структура("Ссылка", ВыборкаЗарезервировано.Ссылка)) Цикл
				
				НоваяСтрока = Приемник[СтрокаШаблона.Приемник].Добавить(); // Добавляем новую строку в ТЧ приемника
				// Ренквизит "qteaBD9LR3zy" представляет ссылку на текущую строку табличной части создаваемого документа,
				// необходим для передачи строки в виде параметра в различные функции заполнения счетов учета, ставок и т.п.
				qteaBD9LR3zy 	= Неопределено;
				
				Для Каждого Колонка Из СтрокаШаблона.Строки Цикл // Проходим по всем реквизитам ТЧ приемника
					
					Если Колонка.Использовать = Ложь Тогда
						Продолжить;
					КонецЕсли;
					
					Результат = "EcZzd?Rd"; // Случайная строка для того, чтобы проверить, был ли изменен реквизит
					
					Для Каждого КолонкаСтрок Из ВыборкаСтроки.Колонки Цикл // Заменяем в формуле переменные, ссылающиеся на строку
						Колонка.Формула = СтрЗаменить(Колонка.Формула, "ВыборкаЗарезервировано." + КолонкаСтрок.Имя, "Строка." + КолонкаСтрок.Имя);
					КонецЦикла;
					
					Если НЕ Найти(Колонка.Формула, "qteaBD9LR3zy") = 0 И qteaBD9LR3zy 	= Неопределено Тогда
						qteaBD9LR3zy = Приемник[СтрокаШаблона.Приемник].Найти(Строка.НомерСтроки, "НомерСтроки");
					КонецЕсли;
					
					Попытка
						Выполнить(СтрЗаменить(Колонка.Формула, "¶", Символы.ПС));
					Исключение
						
						ТекстЛогаСобытий = "Ошибка в получении значения тега """ + СтрокаШаблона.Приемник + """: " + ОписаниеОшибки();
						ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
						МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

						Возврат;
						
					КонецПопытки;
					
					Если НЕ ПустаяСтрока(Колонка.Приемник) И НЕ Результат = "EcZzd?Rd" Тогда
						НоваяСтрока[Колонка.Приемник] = Результат;
					КонецЕсли;
					
				КонецЦикла;
				
				qteaBD9LR3zy 	= Неопределено;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	
КонецПроцедуры // ЗаполнитьДокумент()

// Процедура выполняет код из служебных настроек и получает результат для замены в значениях структуры служебных настроек.
//
// Параметры:
//  Служебные  				- Структура 					- служебные значения документа
//  ВыборкаЗарезервировано  - ВыборкаИзРезультатаЗапроса 	- данные выборки для текущего документа
//
// Возвращаемое значение:
//   Структура	- служебные значения документа
//
Функция ЗаполнитьСтруктуруСлужебные(Служебные, ВыборкаЗарезервировано)
	
	// Копирование значений структуры.
	Буфер = ЗначениеВСтрокуВнутр(Служебные);
	НоваяСтруктура = ЗначениеИзСтрокиВнутр(Буфер);
	
	Для Каждого Строка Из НоваяСтруктура Цикл
		Если ЗначениеЗаполнено(Строка.Значение) Тогда
			Результат = Неопределено;
			Выполнить(Строка.Значение);
			НоваяСтруктура[Строка.Ключ] = Результат;
		КонецЕсли;
	КонецЦикла;
	
	Возврат НоваяСтруктура;
	
КонецФункции // ЗаполнитьСтруктуруСлужебные()

// Процедура копирует значения одной строки в другую, включая подчиненные строки.
//
// Параметры:
//  Строка  - СтрокаДереваЗначений  - строка-источник
//  НоваяСтрока  - СтрокаДереваЗначений  - строка-приемник
//  Колонки  - Массив  - коллекция реквизитов строк
//
Процедура СкопироватьСтрокуДереваЗначений(Строка, НоваяСтрока, Колонки, ИмяДереваЗначений = "") Экспорт //Docrobot 1.21.0 MOD-280 [Добавлено ИмяДереваЗначений]
	
	// Копируем реквизиты.
	Для Каждого Колонка Из Колонки Цикл
		Попытка
			Если ТипЗнч(Строка[Колонка]) = Тип("Структура") Тогда
				// Копирование значений структуры.
				НоваяСтруктура = Новый Структура;
				Для Каждого Элемент Из Строка[Колонка] Цикл
					НоваяСтруктура.Вставить(Элемент.Ключ, Элемент.Значение);
				КонецЦикла;
				НоваяСтрока[Колонка] = НоваяСтруктура;
			Иначе
				// Копирование всего остального.
				НоваяСтрока[Колонка] = Строка[Колонка];
				
				//Docrobot 1.21.0 MOD-280 [+]
				Если ИмяДереваЗначений = "СтруктураФайлаXMLДокументы" и Колонка = "Приемник" Тогда
					
					ДеревоКонфигурации = ЗаполнитьДеревоКонфигурации(Истина); //Docrobot 1.21.0 MOD-280 [Будем искать в дереве]
					
				 	НайденныеСтроки = ДеревоКонфигурации.Строки.НайтиСтроки(Новый Структура ("Имя", Строка[Колонка]), Истина);	
					
					Если НайденныеСтроки.Количество() = 0 Тогда 
						НайденныеСтрокиСиноним = ДеревоКонфигурации.Строки.НайтиСтроки(Новый Структура ("Синоним", Строка[Колонка]), Истина);
						
						Если Не НайденныеСтрокиСиноним.Количество() = 0 Тогда
							Продолжить;
						КонецЕсли;
						
						НоваяСтрока[Колонка] = "";
						
						Сообщение = Новый СообщениеПользователю;		
						Сообщение.Текст = "Не найден тип документа " + Строка[Колонка] + " в конфигурации. Проверьте значение в колонке ""Приемник""!";
						Сообщение.Сообщить();
					КонецЕсли;
				КонецЕсли;
				//Docrobot 1.21.0 MOD-280 [-]
				
			КонецЕсли;
		Исключение КонецПопытки;
	КонецЦикла;
	
	// Копируем подчиненные строки.
	Для Каждого Элемент Из Строка.Строки Цикл
		СкопироватьСтрокуДереваЗначений(Элемент, НоваяСтрока.Строки.Добавить(), Колонки);
	КонецЦикла;
	
КонецПроцедуры // СкопироватьСтрокуДереваЗначений()

// Процедура анализирует переданный программный код и получает из него данные, которые могли бы выполниться в запросе;
//		заменяет блоки исходного кода значениями, которые будут получены при выполнении запроса.
//
// Параметры:
//  КодНаВстроенномЯзыке  	- Строка - программный код на встроенном языке 1С, который передается из тегов шаблона документа xml.
//		В процессе выполнения функции он должен измениться (блоки кода, которые передадутся в поля запроса, должны замениться переменными).
//		Соответствия полей запроса и перемменных запишутся в переменную ПоляЗапроса.
//  ПоляЗапроса				- Соответствие   - поля запроса. Ключ содержит поле в формате "Документ.Реквизит", Значение хранит имя поля
//		Например, Ключ = "Документ.Контрагент", Значение = "Перем1". Текст запроса будет иметь вид "Документ.Контрагент КАК Перем1,"
//
Процедура ПолучитьПоляЗапроса(КодНаВстроенномЯзыке, ПоляЗапроса, Входящий, МассивЛогаСобытий)
	
	// Реквизиты = Новый Структура; НЕ НУЖНО
	
	Кавычка 	= """";
	Буквы		= "абвгдеёжзийклмнопрстуфхцчшщъыьэюяabcdefghijklmnopqrstuvwxyz_";
	Цифры		= "0123456789";
	БлокиЗамены = Новый Массив; // Содержит начальные символы и длину всех блоков, которые потребуется заменить
	
	ВСтроке 	= Ложь;
	Позиция 	= 1;
	ПозицияПредыдущейКавычки 	= 0;
	ПоизцияПоследнейКавычки 	= 0;
	ДлинаТекста = СтрДлина(КодНаВстроенномЯзыке);
	ЭтоСледующийСимволСлова = Ложь;
	Слово 		= "";
	
	
	
	Пока Позиция <= ДлинаТекста Цикл
		
		ТекущийСимвол = Сред(КодНаВстроенномЯзыке, Позиция, 1);
		
		ПредыдущийСимвол = " ";
		Если Позиция > 1 Тогда
			ПредыдущийСимвол = Сред(КодНаВстроенномЯзыке, Позиция-1, 1);
		КонецЕсли;
		
		Если ТекущийСимвол = Кавычка Тогда
			ВСтроке = НЕ ВСтроке;
			ПозицияПредыдущейКавычки = ПоизцияПоследнейКавычки;
			ПоизцияПоследнейКавычки = Позиция;
			КавычкиЕсть = Истина;
		КонецЕсли;
		
		//Обработка комментария - начало
		Если (НЕ ВСтроке И ПредыдущийСимвол = "/" И ТекущийСимвол = "/") Тогда
			//это комментарий, пропускаем символы до конца строки
			Пока ТекущийСимвол <> Символы.LF И ТекущийСимвол <> Символы.CR И ТекущийСимвол <> "¶" Цикл
				Позиция = Позиция +1;
				Если Позиция > ДлинаТекста Тогда
					Прервать;
				КонецЕсли;
				ТекущийСимвол = Сред(КодНаВстроенномЯзыке, Позиция, 1);
			КонецЦикла;
			
			Продолжить;
		КонецЕсли;
		//Обработка комментария - конец
		
		Если НЕ ВСтроке Тогда
			
			ПозицияТекущегоБлока = ?(БлокиЗамены.Количество() = 0, Неопределено, БлокиЗамены.Получить(БлокиЗамены.Количество() - 1));
			ЭтоНачалоСлова = ПустаяСтрока(Слово) И НЕ Найти(Буквы, НРег(ТекущийСимвол)) = 0;
			ЭтоСледующийСимволСлова = НЕ ПустаяСтрока(Слово) И (НЕ Найти(Буквы, НРег(ТекущийСимвол)) = 0 ИЛИ НЕ Найти(Цифры, НРег(ТекущийСимвол)) = 0);
			ЭтоСледующийСимволРеквизита = ?(НЕ ПозицияТекущегоБлока = Неопределено И ПозицияТекущегоБлока.НачальнаяПозиция + ПозицияТекущегоБлока.Длина = Позиция, ЭтоСледующийСимволСлова ИЛИ ТекущийСимвол = ".", Ложь);
			
			// Запись слова
			Если ЭтоНачалоСлова ИЛИ ЭтоСледующийСимволСлова ИЛИ ЭтоСледующийСимволРеквизита Тогда // Это путь к реквизиту, считаем "." корректным символом для записи полного слова
				Слово = Слово + ТекущийСимвол;
				Если ЭтоСледующийСимволРеквизита Тогда
					ПозицияТекущегоБлока.Длина = ПозицияТекущегоБлока.Длина + 1;
				КонецЕсли;
			Иначе
				
				// Целое слово.
				Если ЭтоПредопределеннаяПеременная(Слово, Входящий) И (ТекущийСимвол = "." ИЛИ ТекущийСимвол = " ") Тогда // Для обработки вариантов "ПредопределеннаяПеременная.Реквизит1.Реквизит2" И "ПредопределеннаяПеременная.Реквизит3 "
					Слово = Слово + ТекущийСимвол;
					НачПозицияСлова = Позиция - СтрДлина(Слово);
					БлокиЗамены.Добавить(Новый Структура("НачальнаяПозиция, Длина", НачПозицияСлова + 1, СтрДлина(Слово)));
				ИначеЕсли ЭтоПредопределеннаяПеременная(Слово, Входящий) И (ТекущийСимвол = ")" ИЛИ ТекущийСимвол = ",") Тогда // Для обработки варианта "...ПредопределеннаяПеременная)", "...ПредопределеннаяПеременная,"
					НачПозицияСлова = Позиция - СтрДлина(Слово);
					БлокиЗамены.Добавить(Новый Структура("НачальнаяПозиция, Длина", НачПозицияСлова, СтрДлина(Слово)));
					Слово = ""; // Очищаем слово, чтобы не попасть сюда второй раз, если по коду подряд следуют несколько закрывающихся скобок "))"
				Иначе
					
					Если ТекущийСимвол = "(" Тогда
						// Определение, является ли сохраненный блок кода методом.	
						//ТекущийБлок 	= Сред(КодНаВстроенномЯзыке, ПозицияТекущегоБлока.НачальнаяПозиция, ПозицияТекущегоБлока.Длина);
						//ПозицияТочки 	= Найти(ТекущийБлок, ".");
						ПозицияТочки 	= Найти(Слово, ".");
						ПервоеСлово		= "";
						
						Если НЕ ПозицияТочки = 0 Тогда
							ПервоеСлово = Лев(Слово, ПозицияТочки - 1);
						КонецЕсли;
						
						Если ЭтоПредопределеннаяПеременная(ПервоеСлово, Входящий) Тогда // Оставляем только предопределенное слово до точки. Остальное может быть табличная часть и/или имя метода, так что лучше не рисковать.
							ПозицияТекущегоБлока.Длина = ПозицияТочки - 1; // минус точка
						КонецЕсли;		
					КонецЕсли;
					
					Слово = "";
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			Слово = "";
		КонецЕсли;
		
		Позиция = Позиция + 1;
		
	КонецЦикла;
	
	// Сохраняем поля запроса и присваиваем им имена переменных в тексте.
	Смещение			= 0;
	
	Для Каждого Координаты Из БлокиЗамены Цикл
		
		ПолеЗапроса 			= Сред(НРег(КодНаВстроенномЯзыке), Координаты.НачальнаяПозиция - Смещение, Координаты.Длина);
		ПолеЗапросаДополненное 	= ?(Найти(ПолеЗапроса, ".") = 0, ПолеЗапроса + ".Ссылка", ПолеЗапроса); // Дополняем поля типа "Документ" значением ".Ссылка"
		ТекущийБлок = ПоляЗапроса.Получить(ПолеЗапросаДополненное);
		
		// Сохранение имени переменной.
		Если ТекущийБлок = Неопределено Тогда
			// Получение счетчика переменных.
			Если ПоляЗапроса.Количество() = 0 Тогда
				Счетчик = 1;
			Иначе
				Счетчик = 0;
				Для Каждого Поле Из ПоляЗапроса Цикл
					ЧислоСтрокой = СтрЗаменить(Поле.Значение, "Перем", "");
					Попытка
						Счетчик = ?(Счетчик < ЭКОМ_ПреобразоватьВЧисло(ЧислоСтрокой), ЭКОМ_ПреобразоватьВЧисло(ЧислоСтрокой), Счетчик);
					Исключение
						
						ТекстЛогаСобытий = "Что-то не так с предопределенной переменной: " + ОписаниеОшибки();
						ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, "Получение полей запроса");
						МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
						
					КонецПопытки;
				КонецЦикла;
				Счетчик = Счетчик + 1;
			КонецЕсли;
			
			Если НРег(ПолеЗапроса) = "строка" Тогда
				ИмяПеременной = "qteaBD9LR3zy"; // Специальная переменная для определения строки табличной части документа
			Иначе
				ИмяПеременной = "Перем" + Строка(Счетчик);
			КонецЕсли;
			
			// Добавим Ссылку для предопределенного объекта, если у него нет реквизитов
			ПоляЗапроса.Вставить(ПолеЗапросаДополненное, ИмяПеременной);
		Иначе
			ИмяПеременной = ТекущийБлок;
		КонецЕсли;
		
		// Замена блока на переменную в тексте запроса.
		Если НРег(ПолеЗапроса) = "строка" Тогда
			ПолноеИмяПеременной = "qteaBD9LR3zy"; // Специальная переменная для определения строки табличной части документа
		Иначе
			ПолноеИмяПеременной = "ВыборкаЗарезервировано." + ИмяПеременной;
		КонецЕсли;
		
		КодНаВстроенномЯзыке = Лев(КодНаВстроенномЯзыке, Координаты.НачальнаяПозиция - 1 - Смещение)
		+ ПолноеИмяПеременной 
		+ Прав(КодНаВстроенномЯзыке, СтрДлина(КодНаВстроенномЯзыке) - (Координаты.НачальнаяПозиция - Смещение + Координаты.Длина) + 1);
		
		Смещение = Смещение + СтрДлина(ПолеЗапроса) - СтрДлина(ПолноеИмяПеременной);
	КонецЦикла;
	
	// Работает только для варианта "Возврат". Чтобы учитывать буквы в любом регистре нужно создать новую переменную,
	// скопировать в нее строку в НРег() и потом найти все вхождения строки "возврат ", запомнив их позицию и длину,
	// после чего по этим данным заменить в переменной КодНаВстроенномЯзыке, но это потом...
	КодНаВстроенномЯзыке = СтрЗаменить(КодНаВстроенномЯзыке, "Возврат ", "Результат = ");
	
КонецПроцедуры // ПолучитьПоляЗапроса()

// Функция содержит предопределенные переменные, которые интерпретируются как поля запроса.
//
// Параметры:
//  Слово  		- Строка - слово для проверки на предопределенность
//  Входящий	- Булево - признак работы со входящим документом
//
// Возвращаемое значение:
//   Булево   - признак предопределенной переменной
//
Функция ЭтоПредопределеннаяПеременная(Слово, Входящий = Ложь)
	
	Предопределенные = Новый Массив;
	// Предопределенные переменные вводить только в нижнем регистре.
	Предопределенные.Добавить("строка");
	Предопределенные.Добавить("электронныйдокумент");
	Предопределенные.Добавить("источник"); // должен использоваться вместо электронныйдокумент, который нужно удалить
	
	Если Входящий Тогда
		// Предопределенные.Добавить("источник");
	Иначе
		Предопределенные.Добавить("документ");
	КонецЕсли;
	
	Индекс = Предопределенные.Найти(НРег(Слово));
	
	Возврат НЕ Индекс = Неопределено И Предопределенные.Получить(Индекс) = НРег(Слово);
	
КонецФункции // ЭтоПредопределеннаяПеременная()

// Функция создает и выполняет запрос из переданных полей и параметров 
//
// Параметры:
//  ПоляЗапроса  	- Соответствие - поля запроса. Ключ содержит поле в формате "Документ.Реквизит", Значение хранит имя поля
//		Например, Ключ = "Документ.Контрагент", Значение = "Перем1". Текст запроса будет иметь вид "Документ.Контрагент КАК Перем1,"
//  Документы  		- Массив, Неопределено - содержит массив элементов ДокументСсылка, по которым нужно получить данные.
//		Если параметр не передается, то запрос получит все документы данного типа.
//  ВидДокумента  	- ПеречислениеСсылка.ЭКОМ_ВидыДокументов - вид обрабатываемого документа
//	ИмяОбъекта 		- Строка - путь к объекту в конфигурации
//  Режим  			- Число - режим работы функции:
//		1 - построение запроса по реквизитам документа (ключевое слово "документ").
//		2 - построение запроса по табличной части документа (ключевое слово "строка").
//      3 - построение запроса по рекивзитам документа (ключевое слово "документ").
//      4 - построение запроса по табличной части документа (ключевое слово "строка").
//
// Возвращаемое значение:
//   ВыборкаИзРезультатаЗапроса   - выборка для обхода результатов запроса
//
Функция СоздатьЗапросNew(ПоляЗапроса, Таблица, ИмяОбъекта, Режим, Имя = "", Роль, МассивЛогаСобытий)
	
	Если НЕ (Режим = 1 ИЛИ Режим = 2 ИЛИ Режим = 3 ИЛИ Режим = 4) Тогда		
		ТекстЛогаСобытий = "Ошибка в параметре функции.";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, "Создание запроса");
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	//Docrobot 1.20.0 MOD-973 [Проверка на пустое значение]
	Если ИмяОбъекта = Неопределено Или ИмяОбъекта = "" Тогда		
		ТекстЛогаСобытий = "Ошибка! Возможно повреждение дерева ЭКОМ-конфигурации! Необходимо перевыбрать Источник и Приемник, а также все их реквизиты.";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, "Создание запроса");
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	// В данной функции переработан исходный текст запроса. В нем мы отказались от использования параметра Имя для формирования текста запроса.
	// Вместо этого ориентируемся на колонку Документ для хранения ссылки на документ-источник.
	
	Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Таблица.ЭКОМ_Документ_ORDER КАК ЭлектронныйДокумент,
	|	Таблица.Документ,
	|	Таблица.ДокументЗаказа КАК ДокументЗаказа1С,
	|	Таблица.ДокументРеализации КАК ДокументРеализации,
	|	Таблица.ЭКОМ_Документ_RECADV КАК ЭлектронныйДокументRECADV,
	|	Таблица.Документ КАК Источник
	|ПОМЕСТИТЬ Таблица
	|ИЗ
	|	&Таблица КАК Таблица
	|;
	|";
	
	Если Роль = "Сеть" 
		ИЛИ Роль = "Покупатель" Тогда
		Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Таблица.ЭКОМ_Документ_DESADV КАК ЭлектронныйДокумент,
		|	Таблица.Документ,
		|	Таблица.ДокументЗаказа КАК ДокументЗаказа,
		|	Таблица.ДокументПоступления КАК ДокументПоступления,
		|	Таблица.ЭКОМ_Документ_ORDRSP КАК ЭлектронныйДокументORDRSP,
		|	Таблица.Документ КАК Источник
		|ПОМЕСТИТЬ Таблица
		|ИЗ
		|	&Таблица КАК Таблица
		|;
		|";
	ИначеЕсли Роль = "Прайс-лист" Тогда
		Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Таблица.PRICAT КАК ЭлектронныйДокумент,
		|	Таблица.PRICAT КАК PRICAT,
		|	Таблица.Документ КАК Источник
		|ПОМЕСТИТЬ Таблица
		|ИЗ
		|	&Таблица КАК Таблица
		|;
		|";
	КонецЕсли;
	
	// Начало формирования текста запроса.
	Запрос.Текст = Текст + "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	";
	// Добавление требуемых полей в текст запроса.
	Для Каждого Поле Из ПоляЗапроса Цикл
		Если (Режим = 1 И Найти(ТРег(Поле.Ключ), "Документ.") = 1)
			ИЛИ (Найти(ТРег(Поле.Ключ), "Источник.") = 1)
			ИЛИ (Режим = 2 И Найти(ТРег(Поле.Ключ), "Строка.") = 1)
			ИЛИ (Режим = 3 И Найти(ТРег(Поле.Ключ), "Источник.") = 1)
			ИЛИ (Режим = 4 И Найти(ТРег(Поле.Ключ), "Строка.") = 1) Тогда
			
			Запрос.Текст = Запрос.Текст + ?(Найти(ТРег(Поле.Ключ), "Строка.") = 1, "", "Таблица.") +
			ТРег(Поле.Ключ) + " КАК " + Поле.Значение + ",
			|	";
		КонецЕсли;
	КонецЦикла;
	
	// Завершение формирования теста запроса.
	// Поле "Документ.Ссылка КАК Ссылка" является системным и обязательно для получения.
	// По ссылке выборка из реквизитов документа соединяется с выборкой из табличной части.
	Если Режим = 1 Тогда // Исходящие, документ
		
		Запрос.Текст = Запрос.Текст 
		+ "Таблица.Документ.Ссылка КАК Ссылка,
		|Таблица.Источник.Ссылка КАК Источник,
		|Таблица.ЭлектронныйДокумент.Ссылка КАК ЭлектронныйДокумент 
		|ИЗ 
		|	Таблица КАК Таблица";
		
	ИначеЕсли Режим = 2 Тогда // Исходящие, товары
		
		Запрос.Текст = Запрос.Текст
		+ "Строка.НомерСтроки КАК НомерСтроки,
		|	Строка.Ссылка КАК Ссылка,
		|Таблица.Источник.Ссылка КАК Источник,
		|Таблица.ЭлектронныйДокумент.Ссылка КАК ЭлектронныйДокумент 
		|ИЗ 
		|	Таблица КАК Таблица 
		|		ЛЕВОЕ СОЕДИНЕНИЕ &ИмяОбъекта КАК Строка
		|		ПО Таблица.Документ.Ссылка = Строка.Ссылка ";   // А что если табличная часть называется не Товары??? Нужно передавать путь полностью!!!!
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИмяОбъекта ", "Документ."+ ИмяОбъекта + ".Товары "); // Сюда подставить наименование документа из метаданных
		
	ИначеЕсли Режим = 3 Тогда // Входящие, документ
		
		Запрос.Текст = Запрос.Текст
        + "Таблица.ЭлектронныйДокумент.Ссылка КАК ЭлектронныйДокумент,
        |Таблица.Источник.Ссылка КАК Источник,
        |Таблица.Источник.Ссылка КАК Ссылка";
		
		Если Роль = "Поставщик" Тогда
            Запрос.Текст = Запрос.Текст + "," + Символы.ПС +
            "Таблица.ДокументЗаказа1С КАК ДокументЗаказа1С,
             |Таблица.ДокументРеализации КАК ДокументРеализации";
		КонецЕсли;
		
        Запрос.Текст = Запрос.Текст + Символы.ПС +  
		"ИЗ 
        |   Таблица КАК Таблица";
        Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИмяОбъекта", ИмяОбъекта); 
		
	ИначеЕсли Режим = 4 Тогда // Входящие, товары       // ПРОДОЛЖИТЬ ОТСЮДА!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
		
		Запрос.Текст = Запрос.Текст
		+ "Строка.НомерСтроки КАК НомерСтроки,
		|	Строка.Ссылка КАК Ссылка,
		|Таблица.Источник.Ссылка КАК Источник
		|ИЗ 
		|	Таблица КАК Таблица 
		|		ЛЕВОЕ СОЕДИНЕНИЕ &ИмяОбъекта КАК Строка
		|		ПО Таблица.Источник.Ссылка = Строка.Ссылка ";
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИмяОбъекта", ИмяОбъекта);		
		
	КонецЕсли;
	
	// Выполнение запроса.
	Запрос.УстановитьПараметр("Таблица", Таблица);
	Если Режим = 1 Тогда
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
	ИначеЕсли Режим = 2  ИЛИ Режим = 3 ИЛИ Режим = 4 Тогда
		Выборка = Запрос.Выполнить().Выгрузить();
	КонецЕсли;
	
	Возврат Выборка;
	
КонецФункции

Процедура ЗаписатьЭлемент(XMLЭлемент,СтрокаДЗ)
	
	Для Каждого СтрокаДЗ Из СтрокаДЗ.Строки Цикл
		
		Если СтрокаДЗ.Использовать = Истина И СтрокаДЗ.Строки.Количество() > 0 Тогда
			
			XMLЭлемент.ЗаписатьНачалоЭлемента(СтрокаДЗ.Тег);
			ЗаписатьЭлемент(XMLЭлемент, СтрокаДЗ);
			
		ИначеЕсли СтрокаДЗ.Использовать = Истина И СтрокаДЗ.Строки.Количество() = 0 И ЗначениеЗаполнено(СтрокаДЗ.Значение) Тогда
			
			ЗаписатьXML(XMLЭлемент, СтрокаДЗ.Значение, СтрокаДЗ.Тег);
			
		Конецесли;
		
	Конеццикла;
	
	XMLЭлемент.ЗаписатьКонецЭлемента();
	
КонецПроцедуры

// Функция возвращает строковое представление пути к указанному объекту конфигурации
//
// Параметры:
//  Дерево  	- ДеревоЗначений, СтрокаДереваЗначений - объект, хранящий структуру документа
//  ВидОбъекта  - Число - признак пути к объекту. Возможные значения: 1 - путь к документу, 2 - путь к табличной части документа
//  Колонка  	- Строка - имя колонки дерева значений, которая содержит синоним объекта конфигурации
//
// Возвращаемое значение:
//   Строка   - строковое представление пути к объекту дерева конфигурации
//
Функция ПолучитьПутьКОбъектуКонфигурации(Дерево, ВидОбъекта, Колонка, МассивЛогаСобытий) Экспорт // Приемник
	
	ИмяСобытия = "Получение имени объекта конфигурации";
	ЭКОМ_ДеревоКонфигурации = Настройка_Параметр_Прочитать("СлужебныйДеревоКонфигурации", , "Служебный");
	
	Если ТипЗнч(Дерево) = Тип("ДеревоЗначений") Тогда
		Если Дерево.Строки.Количество() = 0 Тогда
			Возврат Неопределено;
		Иначе
			Дерево = Дерево.Строки.Получить(0);
		КонецЕсли;
	ИначеЕсли НЕ ТипЗнч(Дерево) = Тип("СтрокаДереваЗначений") Тогда
		ТекстЛогаСобытий = "Ошибка в параметре функции.";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	КолонкаИмя = "";
	СтрокаДерева = Неопределено;
	Если (Колонка = "КолонкаИсточника" И ВидОбъекта = 1)
		ИЛИ (Колонка = "Источник" И ВидОбъекта = 2) Тогда
		ЕстьКолонка = НЕ Дерево.Владелец().Колонки.Найти(Колонка) = Неопределено;
		Если ЕстьКолонка Тогда
			КолонкаИмя = Дерево[?(ВидОбъекта = 2, "КолонкаИсточника", Колонка)];
			ДанныеПоКолонкам = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьДанныеПоКолонкамИсточника()");
			ДанныеПоТипам    = ПолучитьТипДокументаКолонки(КолонкаИмя, ДанныеПоКолонкам);
			СтрокаДерева     = ЭКОМ_ДеревоКонфигурации.Строки.Найти(ДанныеПоТипам.ИмяДокументаВКонфигурации, "Имя");
		КонецЕсли;
	КонецЕсли;
	
	Если СтрокаДерева = Неопределено Тогда
		ИмяОбъектаКонфигурации = "";
		КолонкаИмя 		= Дерево[Колонка];
		СтрокаДерева	= ЭКОМ_ДеревоКонфигурации.Строки.Найти(КолонкаИмя, "Синоним");
		Если СтрокаДерева = Неопределено Тогда
			СтрокаДерева	= ЭКОМ_ДеревоКонфигурации.Строки.Найти(КолонкаИмя, "Имя");
		КонецЕсли;
	КонецЕсли;
	
	Если СтрокаДерева = Неопределено Тогда		
		ТекстЛогаСобытий = "Ошибка получения данных дерева конфигурации по синониму и имени документа - " + КолонкаИмя;
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
	
		Возврат Неопределено;
		
	Иначе
		ИмяОбъектаКонфигурации = "Документ." + СтрокаДерева.Имя;
	КонецЕсли;
	
	Если ВидОбъекта	= 2 Тогда
		
		ИмяТЧ = ПолучитьИмяТабличнойЧастиДокумента(Дерево.Строки, СтрокаДерева.Строки, Колонка);
		ИмяОбъектаКонфигурации = ИмяОбъектаКонфигурации + "." + ИмяТЧ;
		
	ИначеЕсли НЕ ВидОбъекта = 1 Тогда
		ТекстЛогаСобытий = "Ошибка в параметре функции.";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Возврат ИмяОбъектаКонфигурации;
	
КонецФункции

Функция ПолучитьТипДокументаКолонки(ИмяКолонки, ДанныеПоКолонкам) Экспорт
	
	ОпределенныйТипКолонки = Новый Структура;
	ОпределенныйТипКолонки.Вставить("ЗначениеПоУмолчанию", Неопределено);
	ОпределенныйТипКолонки.Вставить("ИмяДокументаВКонфигурации", "");
	ОпределенныйТипКолонки.Вставить("СинонимДокументаВКонфигурации", "");
	
	ТипКолонки = ДанныеПоКолонкам.Получить(ИмяКолонки);
	Если ТипКолонки = Неопределено Тогда
		Возврат ОпределенныйТипКолонки;
	КонецЕсли;
	
	МассивТиповКолонки = Новый Массив;
	МассивТиповВсего   = ТипКолонки.Типы();
	// Исключаем типы 
	Для каждого ЭлементМассива Из МассивТиповВсего Цикл
		
		Если Тип("Null") = ЭлементМассива
			ИЛИ Тип("Неопределено") = ЭлементМассива 
			ИЛИ Тип("Строка") = ЭлементМассива  
			ИЛИ Тип("Число") = ЭлементМассива 
			ИЛИ Тип("Дата") = ЭлементМассива 
			ИЛИ Тип("Булево") = ЭлементМассива Тогда
			Продолжить;
		КонецЕсли;	
		
		МассивТиповКолонки.Добавить(ЭлементМассива);
		
	КонецЦикла;
	
	// Проверяем - если составной тип то возвращаем неопределено
	Если МассивТиповКолонки.Количество() = 1 Тогда
		Для каждого ЭлементМассива Из МассивТиповКолонки Цикл
			
			ОбъектМетаданных = Метаданные.НайтиПоТипу(ЭлементМассива);
			Если НЕ ОбъектМетаданных = Неопределено Тогда
				ПолноеИмяОбъекта    = ОбъектМетаданных.ПолноеИмя();
				ЗначениеПоУмолчанию = ПредопределенноеЗначение(ПолноеИмяОбъекта + ".ПустаяСсылка");	
				ОпределенныйТипКолонки.Вставить("ЗначениеПоУмолчанию"          , ЗначениеПоУмолчанию);
				ОпределенныйТипКолонки.Вставить("ИмяДокументаВКонфигурации"    , ОбъектМетаданных.Имя);
				ОпределенныйТипКолонки.Вставить("СинонимДокументаВКонфигурации", ОбъектМетаданных.Синоним);
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	Возврат ОпределенныйТипКолонки;  
	
КонецФункции

// Функция возвращает имя объекта конфигурации по его синониму из строки дерева значений.
//
// Параметры:
//  Дерево  - СтрокаДереваЗначений - строка дерева, содержащая синоним, для которого нужно получить имя
//  ИмяКолонки  - Строка - имя колонки дерева значений, которая содержит синоним
//
// Возвращаемое значение:
//   Строка   - Имя объекта конфигурации, найденное по его синониму
Функция ПолучитьИмяПоСинониму(Знач Дерево, ИмяКолонки) Экспорт
	
	ЭКОМ_ДеревоКонфигурации = Настройка_Параметр_Прочитать("СлужебныйДеревоКонфигурации", , "Служебный");
	
	МассивСинонимов = Новый Массив;
	
	Пока НЕ Дерево 	= Неопределено Цикл
		Если ЗначениеЗаполнено(Дерево[ИмяКолонки]) Тогда
			МассивСинонимов.Добавить(Дерево[ИмяКолонки]);
		КонецЕсли;
		Дерево 		= Дерево.Родитель;
	КонецЦикла;
	
	Если МассивСинонимов.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	ДеревоКонф = ЭКОМ_ДеревоКонфигурации.Скопировать();
	МаксИндекс = МассивСинонимов.ВГраница();
	
	Для Вычитаемое 	= 0 По МаксИндекс Цикл
		Синоним 	= МассивСинонимов.Получить(МаксИндекс - Вычитаемое);
		ДеревоКонф 	= ДеревоКонф.Строки.Найти(Синоним, "Синоним");
	КонецЦикла;
	
	Возврат ДеревоКонф.Имя;
	
КонецФункции // ПолучитьИмяПоСинониму()

// Функция возвращает имя первой попавшейся табличной части документа.
//
// Параметры:
//  СтрокиДереваОбъекта  - СтрокиДереваЗначений - строки дерева, хранящего структуру документа или xml файла
//  СтрокиДереваКонфигурации  - СтрокиДереваЗначений - строки дерева, хранящего структуру конфигурации
//  Колонка  - Строка - имя колонки, в которой содержится синоним объекта конфигурации
//
// Возвращаемое значение:
//   Строка   - имя табличной части документа
//
Функция ПолучитьИмяТабличнойЧастиДокумента(СтрокиДереваОбъекта, СтрокиДереваКонфигурации, Колонка)
	
	// Функция не подходит для работы с несколькими табличными частями в документе, так как возвращает имя первой попавшейся ТЧ, игнорируя все последующие!!!
	Для Каждого Строка Из СтрокиДереваОбъекта Цикл
		
		Если Строка.Строки.Количество() > 0 И НЕ ПустаяСтрока(Строка[Колонка]) Тогда
			Результат = СтрокиДереваКонфигурации.Найти(Строка[Колонка], "Синоним").Имя;
			Возврат Результат;
		КонецЕсли;
		
		Результат = ПолучитьИмяТабличнойЧастиДокумента(Строка.Строки, СтрокиДереваКонфигурации, Колонка);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // ПолучитьИмяТабличнойЧастиДокумента()

// Процедура формирует и отправляет XML документы по данным дерева значений
//
// Параметры:
//  Дерево  - ДеревоЗначений - макет документа XML, сожержащий в себе все формулы и значения для выгрузки
//  Сервер  - FTPСоединение - содинение с сервером по FTP
//	Тип	- Строка - тип отправляемого документа
//
Функция СозданиеДокументаПоШаблонуXML(Дерево, ТипДокумента, МассивЛогаСобытий, ЭтоРегламентноеЗадание, ПодписатьФайл)
	
	МассивСтруктур = Новый Массив;
	
	ВременныйКаталог = ПутьВременногоКаталогаЭКОМ("Send_xml");	
	
	ИмяСобытия = "Создание документов XML по шаблону";
	КаталогВременный = ЭКОМ_СоздатьКаталогПроверитьНаЗапись(ВременныйКаталог, МассивЛогаСобытий);	
	Если КаталогВременный = Неопределено Тогда		
		Возврат МассивСтруктур;		
	КонецЕсли;
	
	Если Дерево.Строки.Количество() = 1 Тогда // По определению у нас должен быть только один макет для указанного типа документа
		ДокументыКоллекция = Дерево.Строки.Получить(0).ДанныеЗначения;
		Если НЕ ТипЗнч(ДокументыКоллекция) = Тип("ТаблицаЗначений") Тогда // И в корневой строке в столбце ДанныеЗначения должна быть таблица значений с документами
			ТекстЛогаСобытий = "В корневой строке в столбце данныеЗначения должна быть таблица значений с документами";
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			Возврат МассивСтруктур;
		КонецЕсли;
	Иначе
		ТекстЛогаСобытий = "Несколько видов операций в гибких настройках, должен быть указан 1 тип.";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
		Возврат МассивСтруктур;
	КонецЕсли;
	
	МассивКоррИспВидовДокументовЮЗД = Новый Массив;
	Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьИсправительныеВидыДокументовЮЗД(МассивКоррИспВидовДокументовЮЗД);");
	Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьКорректировочныеВидыДокументовЮЗД(МассивКоррИспВидовДокументовЮЗД);");

	КолонкаНомер = ДокументыКоллекция.Колонки.Найти("NUMBER");
	КолонкаДата  = ДокументыКоллекция.Колонки.Найти("DATE");
		
	Для Каждого Документ Из ДокументыКоллекция Цикл
		
		XMLДокумент        	= Новый ЗаписьXML;
		
		КодировкаXML = "UTF-8";
		Если Найти(ТипДокумента, "CONDRA") = 0  // Все подписанные файлы, кроме CONDRA
			И ПодписатьФайл = Истина Тогда
			КодировкаXML = "WINDOWS-1251";
		КонецЕсли;
		
		ПараметрыЗаписиXML 	= Новый ПараметрыЗаписиXML(КодировкаXML, "1.0", Истина, Ложь, Символы.Таб); 
		XMLДокумент.УстановитьСтроку(КодировкаXML);
		XMLДокумент.ЗаписатьОбъявлениеXML();
		
		МассивТегов = Новый Массив;
		Служебные = СтрокаДереваВXML(Новый Структура("Документ", Документ), XMLДокумент, Дерево,,, Документ, МассивЛогаСобытий, , МассивТегов); // Создание файла XML		
		Если Служебные = Неопределено Тогда
			Возврат МассивСтруктур;
		ИначеЕсли ТипЗнч(Служебные) = Тип("Структура") 
			И Служебные.Отказ = Истина Тогда					
			Продолжить;
		КонецЕсли;
		
		ФайлИмя = Неопределено;
		Служебные.Свойство("ФайлИмя", ФайлИмя);
		Если НЕ ЗначениеЗаполнено(ФайлИмя) Тогда
			ТекстЛогаСобытий = "В гибких настройках не заполнены служебные поля!";
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			Возврат МассивСтруктур;
		КонецЕсли;
		
		НомерДокумента = "";
		ДатаДокумента  = Дата(0001, 01, 01);
		Если НЕ КолонкаНомер = Неопределено Тогда
			НомерДокумента = Документ.NUMBER;	
		КонецЕсли;
		Если НЕ КолонкаДата = Неопределено Тогда
			ДатаДокумента  = ДатаИзXML_в_1С(Документ.DATE);
		КонецЕсли;
		
		ЭКОМ_ОбщегоНазначения.ОчиститьСтрокуXMLОтПустыхТегов(Служебные.СтрокаXML, МассивТегов);
		
		СтруктураEDI = Новый Структура;
		СтруктураEDI.Вставить("СтрокаXML"     , Служебные.СтрокаXML);
		СтруктураEDI.Вставить("КодировкаФайла", КодировкаXML);
		
		Если НЕ ЗначениеЗаполнено(Служебные.СтрокаXML) Тогда	
			ТекстЛогаСобытий = "Файл не сформирован - " + ФайлИмя;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

			Продолжить;
		ИначеЕсли Найти(ТипДокумента, "CONDRA") > 0 Тогда
			СтруктураEDI.Вставить("Идентификатор", Служебные.Идентификатор);
			СтруктураEDI.Вставить("Организация"  , Служебные.Организация);
			СтруктураEDI.Вставить("Статус"       , Служебные.Статус);
			
			ТипФайла = "CONDRA";
			СтруктураEDI.Вставить("ИмяФайлаXML"	, ФайлИмя);
			СтруктураEDI.Вставить("ВидДокумента", Перечисления.ЭКОМ_ВидыДокументов.CONDRA_Исходящий);
			СтруктураEDI.Вставить("Сообщение"  	, "");
			СтруктураEDI.Вставить("Отправлен"  	, "");
			СтруктураEDI.Вставить("ИмяФайла"   	, Документ.FILENAME);
			
			Если ДокументыКоллекция.Колонки.Найти("ДанныеФайла") <> Неопределено Тогда 
				СтруктураEDI.Вставить("ДанныеФайла", Документ.ДанныеФайла);	
			КонецЕсли;
			
		Иначе
			
			Статус = Перечисления.ЭКОМ_Статусы.Отправлен;
							
			Если Служебные.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_PRANNUL_22 Тогда	
				ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_PRANNUL_22;
				ТипФайла     = "DP_PRANNUL_22"; //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _22]
					
			ИначеЕсли Служебные.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_IZVPOL_23 Тогда	
				ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_IZVPOL_23;
				ТипФайла     = "DP_IZVPOL_23";
				
			ИначеЕсли Служебные.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_UVUTOCH_24 Тогда	
				ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_UVUTOCH_24;
				ТипФайла     = "DP_UVUTOCH_24";
				
			ИначеЕсли Найти(Служебные.Идентификатор, "ORDER") = 1 Тогда
				ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ORDER_Исходящий;
				ТипФайла     = "ORDER";
				
			//Docrobot 1.21.0 MOD-1648
			ИначеЕсли Найти(Служебные.Идентификатор, "RETORD") = 1 Тогда
				ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.RETORD_Исходящий;
				ТипФайла     = "RETORD";
				
			ИначеЕсли Найти(Служебные.Идентификатор, "ORDRSP") = 1 Тогда	
				ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ORDRSP_Исходящий;
				ТипФайла     = "ORDRSP";
				
			ИначеЕсли Найти(Служебные.Идентификатор, "DESADV") = 1 Тогда	
				ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DESADV_Исходящий;
				ТипФайла     = "DESADV";
				
				// Записываем в цепочку поставщика номер и дату
				ПараметрыОтбора = Новый Структура;
				ПараметрыОтбора.Вставить("Накладная", Служебные.Ссылка);
				
				ПараметрыЗаписи = Новый Структура;
				ПараметрыЗаписи.Вставить("DESADVNUMBER", НомерДокумента);
				ПараметрыЗаписи.Вставить("DESADVDATE"  , ДатаДокумента);
				
				ЭКОМ_ЦепочкиДокументовПоставщикаЗаписать(ПараметрыОтбора, ПараметрыЗаписи);
				
			ИначеЕсли Найти(Служебные.Идентификатор, "RECADV") = 1 Тогда	
				ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.RECADV_Исходящий;
				ТипФайла     = "RECADV";
			ИначеЕсли Найти(Служебные.Идентификатор, "RETANN") = 1 Тогда	
				ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.RETANN_Исходящий;
				ТипФайла     = "RETANN";
			ИначеЕсли Найти(Служебные.Идентификатор, "RETINS") = 1 Тогда	
				ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.RETINS_Исходящий;
				ТипФайла     = "RETINS";	
			ИначеЕсли Найти(Служебные.Идентификатор, "DESSCC") = 1 Тогда	
				ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DESSCC_Исходящий;
				ТипФайла     = "DESSCC";
			ИначеЕсли Найти(Служебные.Идентификатор, "INVOICE") = 1 Тогда	
				ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.INVOICE;
				ТипФайла     = "INVOICE";
			ИначеЕсли Найти(Служебные.Идентификатор, "DP_UVUTOCH_09") = 1 Тогда	//Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _09]	
				ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_UVUTOCH_09;
				Статус       = Перечисления.ЭКОМ_Статусы.Отправлен;
				ТипФайла     = "DP_UVUTOCH";
				
			ИначеЕсли Найти(Служебные.Идентификатор, "ON_NKORSCHFDOPPRMARK") = 1 Тогда	
				ВидДокумента = Служебные.ВидДокумента;
				ТипФайла     = "ON_NKORSCHFDOPPRMARK";
				
			ИначеЕсли Найти(Служебные.Идентификатор, "ON_NKORSCHFDOPPRPROS") = 1 Тогда	
				ВидДокумента = Служебные.ВидДокумента;
				ТипФайла     = "ON_NKORSCHFDOPPRPROS";
				
			ИначеЕсли Найти(Служебные.Идентификатор, "ON_NKORSCHFDOPPR") = 1 Тогда	
				ВидДокумента = Служебные.ВидДокумента;
				ТипФайла     = "ON_NKORSCHFDOPPR";

			ИначеЕсли Найти(Служебные.Идентификатор, "ON_KORSCHFDOPPR") = 1 Тогда	
				ВидДокумента = Служебные.ВидДокумента;
				ТипФайла     = "ON_KORSCHFDOPPR";

			ИначеЕсли Найти(Служебные.Идентификатор, "ON_NSCHFDOPPRMARK") = 1  Тогда	
				ВидДокумента = Служебные.ВидДокумента;
				ТипФайла     = "ON_NSCHFDOPPRMARK";
				
			ИначеЕсли Найти(Служебные.Идентификатор, "ON_NSCHFDOPPRPROS") = 1  Тогда	
				ВидДокумента = Служебные.ВидДокумента;
				ТипФайла     = "ON_NSCHFDOPPRPROS";
			ИначеЕсли Найти(Служебные.Идентификатор, "ON_NSCHFDOPPR") = 1  Тогда	
				ВидДокумента = Служебные.ВидДокумента;
				ТипФайла     = "ON_NSCHFDOPPR";
								
			ИначеЕсли Служебные.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.WHGOV_01_Исходящий  Тогда	
				ВидДокумента = Служебные.ВидДокумента;
				ТипФайла     = "WHGOV_01_Исходящий";
				
			ИначеЕсли Служебные.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.WHGOU_04_Исходящий  Тогда	
				ВидДокумента = Служебные.ВидДокумента;
				ТипФайла     = "WHGOU_04_Исходящий";
				
			ИначеЕсли Служебные.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.WHGPV_05_Исходящий Тогда	
				ВидДокумента = Служебные.ВидДокумента;
				ТипФайла     = "WHGPV_05_Исходящий";
				
			ИначеЕсли Служебные.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.WHGPU_08_Исходящий Тогда	
				ВидДокумента = Служебные.ВидДокумента;
				ТипФайла     = "WHGPU_08_Исходящий";
				
			ИначеЕсли Служебные.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.WHGPU_08_Исходящий Тогда	
				ВидДокумента = Служебные.ВидДокумента;
				ТипФайла     = "WHGPU_08_Исходящий";
				
			ИначеЕсли Найти(Служебные.Идентификатор, "STATUS") = 1 Тогда	
				ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.STATUS;
				ТипФайла     = "STATUS";
				
			ИначеЕсли Найти(Служебные.Идентификатор, "DP_REZRUISP") = 1 Тогда	
				ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_REZRUISP_Исходящий;
				ТипФайла     = "DP_REZRUISP";
				
			ИначеЕсли Найти(Служебные.Идентификатор, "PRICAT") = 1 Тогда	
				ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.PRICAT_Исходящий;
				ТипФайла     = "PRICAT";
				
			КонецЕсли;
			
			ЭтоВидДокументаЮЗД = Вычислить("ЭКОМ_ОбщегоНазначения.ОтноситсяКЮЗД(ВидДокумента)");
			Если ЭтоВидДокументаЮЗД = Истина Тогда
				НомерДокумента = Документ.НомерСчФ; // Записываем номер и дату счет-фактуры для обмена новыми квитанциями
				ДатаДокумента  = ДатаИзXML_в_1С(Документ.ДатаСчФ);			
			КонецЕсли;
			
			СтруктураEDI.Вставить("Документ",           Служебные.Ссылка);
			СтруктураEDI.Вставить("СтруктураДокумента", Служебные);
			СтруктураEDI.Вставить("Отправлен",          Неопределено);
			СтруктураEDI.Вставить("Сообщение",          "");
			СтруктураEDI.Вставить("ЗаказДата",          Служебные.ЗаказДата);					
			СтруктураEDI.Вставить("ЗаказНомер",         Служебные.ЗаказНомер);
			СтруктураEDI.Вставить("Контрагент",         Служебные.Контрагент);
			СтруктураEDI.Вставить("Организация",        Служебные.Организация);
			СтруктураEDI.Вставить("ВидДокумента",       ВидДокумента);
			СтруктураEDI.Вставить("ИмяФайлаXML",        ФайлИмя);
			СтруктураEDI.Вставить("Статус",             Статус);
			СтруктураEDI.Вставить("ТипФайла",           ТипФайла);
			СтруктураEDI.Вставить("ИдентификаторИспр",  ?(Служебные.Свойство("ИдентификаторИспр"), Служебные.ИдентификаторИспр, ""));							
			СтруктураEDI.Вставить("НомерДокумента",     НомерДокумента);
			СтруктураEDI.Вставить("ДатаДокумента",      ДатаДокумента);
			
		КонецЕсли;
		
		Если ПодписатьФайл = Истина Тогда 																		
			
			ДанныеПоОрганизации = ЭКОМ_GLN_Прочитать(Служебные.Организация);
			Если ДанныеПоОрганизации.СведенияЕсть = Ложь Тогда
				ТекстЛогаСобытий = "Нет данных о сертификате электронной подписи.";
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

				Продолжить;
			КонецЕсли;
			//Docrobot 1.19.1 MOD-1637 [Если серт просрочен то не подписываем]
			//+MOD-2544
			СтранаПрофиля = ДанныеПоОрганизации.ПрофильОбмена.Страна;
			СертификатЭКОМ = ДанныеПоОрганизации.Сертификат;
			ПроверкаСертификата = ЭКОМ_ОбщегоНазначения.ПроверитьСертификатДействителен(СертификатЭКОМ);

			Если ПроверкаСертификата <> 0 И СтранаПрофиля <> "kz" Тогда 

				ТекстЛогаСобытий = ПроверкаСертификата;
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия+ ". Тип файла: "+ТипФайла);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
				Продолжить;	
			КонецЕсли;
			СтруктураEDI.Вставить("ДанныеСертификатаЭКОМ", ДанныеПоОрганизации.Сертификат);
			СтруктураEDI.Вставить("СертификатНаСервере"  , ДанныеПоОрганизации.Сертификат.СертификатНаСервере);
			СтруктураEDI.Вставить("СтранаПрофиля"		 , СтранаПрофиля);
			//-MOD-2544
		КонецЕсли;
		
		МассивСтруктур.Добавить(СтруктураEDI);
		
	КонецЦикла;
	
	Возврат МассивСтруктур;
	
КонецФункции // СформироватьОтправитьXML()

// Функция обходит дерево значений и заполняет XMLДокумент данными документа. Данные шапки и товаров получаем ранее. Здесь выполняется код обращения к данным из СтрокаТаблицыЗначений шапки и строк товаров.
//
// Параметры:
//  Документ  	 - СтрокаТаблицыЗначений - данные документа для записи в XML
//  XMLДокумент  - ЗаписьXML - запись XML, в которую будут записаны все данные
//  Дерево       - ДеревоЗначений - макет документа XML, сожержащий в себе все формулы и значения для выгрузки
//  ДанныеСтроки - СтрокаТаблицыЗначений, Неопределено - переменная используется внутри текущего метода для передачи строки товара для записи в XML. Не передается извне.
//  ПропуститьСтроку - Булево - флаг, определяющий пропуск следующей строки дерева. Используется для работы с товарами. Не передается извне.
Функция СтрокаДереваВXML(НаборДанных, XMLДокумент, Дерево, ДанныеСтроки = Неопределено, ПропуститьСтроку = Ложь, Документ, МассивЛогаСобытий, ТребуютЗаполнения = "", МассивТегов)
		
	ИмяСобытия = "Строка дерева XML";
	Если ПропуститьСтроку Тогда // Пропускаем строку товаров, так как ее уже отработали
		ПропуститьСтроку = Ложь;
	Иначе
		
		Для каждого СтрокаДЗ из Дерево.Строки Цикл
			
			СтрокаРодитель	= СтрокаДЗ;
			Использовать	= Истина;
			
			Пока НЕ СтрокаРодитель = Неопределено Цикл
				Использовать 	= ?(СтрокаРодитель.Использовать = Истина, Использовать, Ложь);
				СтрокаРодитель 	= СтрокаРодитель.Родитель;
			КонецЦикла;
			
			Если Использовать Тогда
				
				ВыводитьСтроку = Истина;
				
				// Проверка наличия условий для вывода ветки.
				Если НЕ СтрокаДЗ.Уровень() = 0 И ЗначениеЗаполнено(СтрокаДЗ.Служебные) Тогда
					Попытка
						УсловиеВыводитьСтроку = СтрЗаменить(СтрокаДЗ.Служебные, "Возврат ", "ВыводитьСтроку = ");
						Для Каждого Данные Из НаборДанных Цикл
							ПозицияКлюча = Найти(УсловиеВыводитьСтроку, Данные.Ключ);
							Если НЕ ПозицияКлюча = 0 Тогда
								УсловиеВыводитьСтроку = Лев(УсловиеВыводитьСтроку, ПозицияКлюча - 1)  + "НаборДанных." 
								+ Прав(УсловиеВыводитьСтроку, СтрДлина(УсловиеВыводитьСтроку) - ПозицияКлюча + 1);
							КонецЕсли;
						КонецЦикла;
						
						Выполнить(УсловиеВыводитьСтроку);
					Исключение
						ТекстЛогаСобытий = "Критическая ошибка. Обработка документов остановлена" + Символы.ПС +
											ОписаниеОшибки() + Символы.ПС + ОписаниеСтрокиГибкихНастроек(СтрокаДЗ);
						ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
						МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

						Возврат Неопределено;
						
					КонецПопытки;
				КонецЕсли;
				
				Если ВыводитьСтроку Тогда
					
					Если НЕ СтрокаДЗ.Строки.Количество() = 0 ИЛИ (ТипЗнч(СтрокаДЗ.Атрибуты) = Тип("СписокЗначений") И НЕ СтрокаДЗ.Атрибуты.Количество() = 0) Тогда
						XMLДокумент.ЗаписатьНачалоЭлемента(СтрокаДЗ.Приемник); // Первый раз тег записывается без значения (как будто  него есть подчиненные строки)
						МассивТегов.Добавить(СтрокаДЗ.Приемник);
					КонецЕсли;
					
					Если СтрокаДЗ.Строки.Количество() = 0 Тогда // Сначала записываем атрибуты, а после данные (только для подчиненных строк)
						ЗаписатьАтрибутыXML(XMLДокумент, СтрокаДЗ, Документ, ДанныеСтроки, МассивЛогаСобытий, ТребуютЗаполнения);
					КонецЕсли;
					
					// Запись значений.
					Если НЕ СтрокаДЗ.Уровень() = 0 И ТипЗнч(СтрокаДЗ.Данные) = Тип("Строка") Тогда 
						
						Если (ТипЗнч(СтрокаДЗ.Связи) = Тип("СписокЗначений") ИЛИ ТипЗнч(СтрокаДЗ.Связи) = Тип("Соответствие"))
							И СтрокаДЗ.Связи.Количество() > 0 Тогда // Имеем дело с списком значений
							
							// Формируем структуру отбора строк товаров для текущего документа.
							Отборы = Новый Структура;
							Для Каждого Связь Из СтрокаДЗ.Связи Цикл
								Попытка
									Ключ = СтрЗаменить(Связь.Представление, СтрокаДЗ.Приемник + "." , "");
									Значение = Неопределено;
									Выполнить("Значение = НаборДанных." + Связь.Значение);
									Отборы.Вставить(Ключ, Значение);
								Исключение					
									ТекстЛогаСобытий = "Ошибка установки связи. Обработка документов остановлена" + Символы.ПС + 
														ОписаниеОшибки() + Символы.ПС + ОписаниеСтрокиГибкихНастроек(Связь);									
									ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
									МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
									
									Возврат Неопределено;
									
								КонецПопытки;
							КонецЦикла;
							
							// Обходим строки текущего документа.
							СтрокиТовары = СтрокаДЗ.ДанныеЗначения.НайтиСтроки(Отборы);
							Счетчик = 0;
							Для Каждого ДанныеСтроки Из СтрокиТовары Цикл
								
								Счетчик = Счетчик + 1;
								
								ЗаписатьАтрибутыXML(XMLДокумент, СтрокаДЗ, Документ, ДанныеСтроки, МассивЛогаСобытий, ТребуютЗаполнения);
								
								// Новый Функционал с сохранением текущей строки в структуру (для иерархии более 2-х таблиц)
								Если НЕ НаборДанных.Свойство(СтрокаДЗ.Приемник) Тогда
									НаборДанных.Вставить(СтрокаДЗ.Приемник, Неопределено);
								КонецЕсли;
								НаборДанных[СтрокаДЗ.Приемник] = ДанныеСтроки;
								// Конец нового функционала
								
								СтрокаДереваВXML(НаборДанных, XMLДокумент, СтрокаДЗ, ДанныеСтроки, ПропуститьСтроку, Документ, МассивЛогаСобытий, ТребуютЗаполнения, МассивТегов); // Далее проверяем, если заполнена перем ДанныеСтроки, работаем как со строкой
								// Закрываем/открываем теги для каждой строки, кроме последней (она закроется ниже, а открывать более ничего не нужно).
								Если НЕ Счетчик = СтрокиТовары.Количество() Тогда
									XMLДокумент.ЗаписатьКонецЭлемента();
									XMLДокумент.ЗаписатьНачалоЭлемента(СтрокаДЗ.Приемник);
								КонецЕсли;
								
							КонецЦикла;
							
							ДанныеСтроки 		= Неопределено; // Очищаем данные строки, чтобы процедура не пыталась обработать последующий код как строку
							ПропуститьСтроку 	= Истина;
							
						ИначеЕсли НЕ ПустаяСтрока(СтрокаДЗ.Данные) 
							      И НЕ Найти(СокрЛП(СтрокаДЗ.Данные), "//") = 1 Тогда
							Значение = "";
							Попытка
								Выполнить("Значение = НаборДанных." + СтрокаДЗ.Данные + ";");
							Исключение
								ТекстЛогаСобытий = "Критическая ошибка. Обработка документов остановлена." + Символы.ПС +  ОписаниеОшибки() +
													Символы.ПС + ОписаниеСтрокиГибкихНастроек(СтрокаДЗ);
								ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
								МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
								
								Возврат Неопределено;
								
							КонецПопытки;
							
							Если ТипЗнч(Значение) = Тип("Структура") 
								ИЛИ ТипЗнч(Значение) = Тип("Соответствие") Тогда // Структура(в старых настройках) или Соответствие(в новых) предназначена для инфополей
								
								// Удаление пустых значений.
								МассивУдаляемых = Новый Массив;
								Для Каждого ИнфоПоле Из Значение Цикл
									Если НЕ ЗначениеЗаполнено(ИнфоПоле.Значение) Тогда
										МассивУдаляемых.Добавить(ИнфоПоле.Ключ);
									КонецЕсли;
								КонецЦикла;
								
								Для Каждого Удаляемый Из МассивУдаляемых Цикл
									Значение.Удалить(Удаляемый);
								КонецЦикла;
								
								Счетчик = Значение.Количество();
								Для Каждого ИнфоПоле Из Значение Цикл
									XMLДокумент.ЗаписатьАтрибут("Идентиф", 	Строка(ИнфоПоле.Ключ));
									XMLДокумент.ЗаписатьАтрибут("Значен", 	Строка(ИнфоПоле.Значение)); // Проверить заполненность
									Если Счетчик > 1 Тогда
										XMLДокумент.ЗаписатьКонецЭлемента();
										XMLДокумент.ЗаписатьНачалоЭлемента(СтрокаДЗ.Приемник);
									КонецЕсли;
									Счетчик = Счетчик - 1;
								КонецЦикла;
								
							ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда // Массив предназначен для маркировки
								
								// Маркировка
								Счетчик = Значение.Количество();
								Для Каждого СтрокаМаркировки Из Значение Цикл
									ИдентТрансУпак = "";
									СтрокаМаркировки.Свойство("ИдентТрансУпак", ИдентТрансУпак);
									ИдентТрансУпак = ?(ЗначениеЗаполнено(ИдентТрансУпак), Строка(ИдентТрансУпак), "");
									Если ЗначениеЗаполнено(ИдентТрансУпак)  Тогда
										XMLДокумент.ЗаписатьАтрибут("ИдентТрансУпак", 	Строка(ИдентТрансУпак));										 
									КонецЕсли;
									
									ЗаполненКИЗ     = Ложь;
									ЗаполненНомУпак = Ложь;
									ЗначенияКодов = "";
									СтрокаМаркировки.Свойство("ЗначенияКодов", ЗначенияКодов);
									ЗначенияКодов = ?(ЗначениеЗаполнено(ЗначенияКодов), ЗначенияКодов, Новый Массив);
									Для каждого СтрокаКодов Из СтрокаМаркировки.ЗначенияКодов Цикл
										КИЗ = "";
										СтрокаКодов.Свойство("КИЗ", КИЗ);
										КИЗ = ?(ЗначениеЗаполнено(КИЗ), Строка(КИЗ), "");
										Если ЗначениеЗаполнено(КИЗ) Тогда
											XMLДокумент.ЗаписатьНачалоЭлемента("КИЗ");
											XMLДокумент.ЗаписатьТекст(КИЗ);
											XMLДокумент.ЗаписатьКонецЭлемента();
											ЗаполненКИЗ = Истина;
										КонецЕсли;
										
										НомУпак = "";
										СтрокаКодов.Свойство("НомУпак", НомУпак);
										НомУпак = ?(ЗначениеЗаполнено(НомУпак), Строка(НомУпак), "");
										Если ЗначениеЗаполнено(НомУпак) Тогда
											XMLДокумент.ЗаписатьНачалоЭлемента("НомУпак");
											XMLДокумент.ЗаписатьТекст(НомУпак);
											XMLДокумент.ЗаписатьКонецЭлемента();
											ЗаполненНомУпак = Истина;
										КонецЕсли;						
									КонецЦикла;
									
									Если ЗаполненКИЗ = Истина 
										И ЗаполненНомУпак = Истина Тогда
										ТребуютЗаполнения = ТребуютЗаполнения + ?(ПустаяСтрока(ТребуютЗаполнения), "", Символы.ПС) 
										+ "- " + Строка(СтрокаДЗ.Приемник) + " должен быть заполнен КИЗ или НомУпак (два тега одновременно не могут быть заполнены)!";
									КонецЕсли;
									
									Если Счетчик > 1 Тогда
										XMLДокумент.ЗаписатьКонецЭлемента();
										XMLДокумент.ЗаписатьНачалоЭлемента(СтрокаДЗ.Приемник);
									КонецЕсли;
									Счетчик = Счетчик - 1;
									
								КонецЦикла;
								
							ИначеЕсли ТипЗнч(Значение) = Тип("СписокЗначений") Тогда // Для всех
								
								Для Каждого СтрокаМассива Из Значение Цикл
									
									// Теги <КолНеттоВс>10</КолНеттоВс>
									Если ТипЗнч(СтрокаМассива.Значение) = Тип("Строка") Тогда
										
										XMLДокумент.ЗаписатьНачалоЭлемента(СтрокаДЗ.Приемник);
										XMLДокумент.ЗаписатьТекст(СокрЛП(СтрокаМассива.Значение));
										XMLДокумент.ЗаписатьКонецЭлемента();
										
										// Атрибуты <АдрРФ Индекс="117630" КодРегион="77" Город="г Москва" Улица="Профсоюзная"/> 
									ИначеЕсли  ТипЗнч(СтрокаМассива.Значение) = Тип("Структура") Тогда
										XMLДокумент.ЗаписатьНачалоЭлемента(СтрокаДЗ.Приемник);
										МассивТегов.Добавить(СтрокаДЗ.Приемник);
										Для каждого ЭлСтруктуры Из СтрокаМассива.Значение Цикл
											
											Если ЗначениеЗаполнено(ЭлСтруктуры.Значение) Тогда
												XMLДокумент.ЗаписатьАтрибут(ЭлСтруктуры.Ключ, 	СокрЛП(ЭлСтруктуры.Значение));
											КонецЕсли;	
										КонецЦикла;
										XMLДокумент.ЗаписатьКонецЭлемента();
										
										// Теги и атрибуты <НомСредИдентТов ИдентТрансУпак="011">010460043993</НомСредИдентТов>
									ИначеЕсли  ТипЗнч(СтрокаМассива.Значение) = Тип("Соответствие") Тогда
										XMLДокумент.ЗаписатьНачалоЭлемента(СтрокаДЗ.Приемник);
										МассивТегов.Добавить(СтрокаДЗ.Приемник);
										Для каждого ЭлСоответствия Из СтрокаМассива.Значение Цикл
											
											СтруктураАтрибутов = ЭлСоответствия.Ключ;	
											Для каждого ЭлСтруктуры Из СтруктураАтрибутов Цикл
												
												Если ЗначениеЗаполнено(ЭлСтруктуры.Значение) Тогда
													XMLДокумент.ЗаписатьАтрибут(ЭлСтруктуры.Ключ, 	СокрЛП(ЭлСтруктуры.Значение));
												КонецЕсли;	
											КонецЦикла;
											
											XMLДокумент.ЗаписатьТекст(СокрЛП(ЭлСоответствия.Значение));
											
										КонецЦикла;
										XMLДокумент.ЗаписатьКонецЭлемента();
										
									КонецЕсли;
								КонецЦикла;
								
							Иначе // Остальное обычные значения
								Значение = ?(ЗначениеЗаполнено(Значение), Строка(Значение), "");
								Если СтрокаДЗ.Обязательный = Истина И НЕ ЗначениеЗаполнено(Значение) Тогда
									ТребуютЗаполнения = ТребуютЗаполнения + ?(ПустаяСтрока(ТребуютЗаполнения), "", Символы.ПС) + "- " + Строка(СтрокаДЗ.Приемник) + ",данные " + СтрокаДЗ.Данные;
								КонецЕсли;
								Если НЕ ПустаяСтрока(Значение) Тогда
									ЗаписатьXML(XMLДокумент, Значение, СтрокаДЗ.Приемник); // Проверить заполненность
									МассивТегов.Добавить(СтрокаДЗ.Приемник);
								КонецЕсли;
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЕсли;
					
					// Запись атрибутов.
					Если НЕ ПропуститьСтроку И НЕ СтрокаДЗ.Строки.Количество() = 0 Тогда // Сначала получаем данные, а после записываем атрибуты (только для корневых строк)
						ЗаписатьАтрибутыXML(XMLДокумент, СтрокаДЗ, Документ, ДанныеСтроки, МассивЛогаСобытий, ТребуютЗаполнения);
					КонецЕсли;
					
					СтрокаДереваВXML(НаборДанных, XMLДокумент, СтрокаДЗ, ДанныеСтроки, ПропуститьСтроку, Документ, МассивЛогаСобытий, ТребуютЗаполнения, МассивТегов);
					
					Если НЕ СтрокаДЗ.Строки.Количество() = 0 ИЛИ (ТипЗнч(СтрокаДЗ.Атрибуты) = Тип("СписокЗначений") И НЕ СтрокаДЗ.Атрибуты.Количество() = 0) Тогда
						XMLДокумент.ЗаписатьКонецЭлемента();
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			Если СтрокаДЗ.Уровень() = 0 Тогда
				СтрокаXML = XMLДокумент.Закрыть();
				// Выполнение служебных настроек.
				СтруктураСлужебные = Новый Структура;
				СтруктураСлужебные.Вставить("СтрокаXML", СтрокаXML);
				СтруктураСлужебные.Вставить("Отказ"    , НЕ ПустаяСтрока(ТребуютЗаполнения));
				Если НЕ ПустаяСтрока(ТребуютЗаполнения) Тогда
					ТребуютЗаполнения = "Ошибка отправки " + Документ.ВидДокумента + " на основании документа "
					+ Строка(Документ.Ссылка) + ". Необходимо проверить заполнение следующих реквизитов:"
					+ Символы.ПС + ТребуютЗаполнения;
					
					ТекстЛогаСобытий = ТребуютЗаполнения;				
					ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
					МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
					
				КонецЕсли;
				
				Для Каждого Служебные Из СтрокаДЗ.Служебные Цикл
					Если ЗначениеЗаполнено(Служебные.Значение) Тогда
						Значение = "";
						Попытка
							Выполнить("Значение = НаборДанных." + Служебные.Значение + ";");
						Исключение
							ТекстЛогаСобытий = "Критическая ошибка. Обработка документов остановлена" +
												Символы.ПС + ОписаниеОшибки() + Символы.ПС + ОписаниеСтрокиГибкихНастроек(Служебные);		
							ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
							МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
					
							Возврат Неопределено;
							
						КонецПопытки;
						СтруктураСлужебные.Вставить(Служебные.Ключ, Значение);
					КонецЕсли;
				КонецЦикла;
				
				Возврат СтруктураСлужебные;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецФункции // СтрокаДереваВXML()

// <Описание процедуры>
//
// Параметры:
//  <Параметр1>  - <Тип.Вид> - <описание параметра>
//                 <продолжение описания параметра>
//  <Параметр2>  - <Тип.Вид> - <описание параметра>
//                 <продолжение описания параметра>
//
Процедура ПодменитьИмяРеквизита(Дерево, С, На)
	
	// СтрокаДЗ.Атрибуты
	Если НЕ Дерево.Атрибуты = Неопределено Тогда
		Структура = Новый Структура;
		Для Каждого Атрибут Из Дерево.Атрибуты Цикл
			Если НЕ Найти(Атрибут.Значение, На) = 1 И НЕ Найти(Атрибут.Значение, С) = 0 Тогда
				Значение = Лев(Атрибут.Значение, Найти(Атрибут.Значение, С) - 1) + На + Сред(Атрибут.Значение, Найти(Атрибут.Значение, С) + СтрДлина(С));
				Структура.Вставить(Атрибут.Ключ, Значение);
			КонецЕсли;
		КонецЦикла;
		Если НЕ Структура.Количество() = 0 Тогда
			Дерево.Атрибуты = Структура;
		КонецЕсли;
	КонецЕсли;
	
	// СтрокаДЗ.Служебные
	Если ТипЗнч(Дерево.Служебные) = Тип("Строка") И НЕ ПустаяСтрока(Дерево.Служебные) Тогда
		Если НЕ Найти(Дерево.Служебные, На) = 1 И НЕ Найти(Дерево.Служебные, С) = 0 Тогда
			Дерево.Служебные = Лев(Дерево.Служебные, Найти(Дерево.Служебные, С) - 1) + На + Сред(Дерево.Служебные, Найти(Дерево.Служебные, С) + СтрДлина(С));
		КонецЕсли;
	КонецЕсли;
	
	// СтрокаДЗ.Данные
	Если ТипЗнч(Дерево.Данные) = Тип("Строка")
		И Найти(Дерево.Данные, "¶") = 0 // Это именно одна строка (отсутствуют символы переноса)
		И Найти(Дерево.Данные, "Возврат ") = 0 Тогда // Еще раз убедимся, что это не формула
		
		Если НЕ Найти(Дерево.Данные, На) = 1 И НЕ Найти(Дерево.Данные, С) = 0 Тогда
			Дерево.Данные = Лев(Дерево.Данные, Найти(Дерево.Данные, С) - 1) + На + Сред(Дерево.Данные, Найти(Дерево.Данные, С) + СтрДлина(С));
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого Строка Из Дерево.Строки Цикл
		ПодменитьИмяРеквизита(Строка, С, На)
	КонецЦикла;
	
	
КонецПроцедуры // ПодменитьИмяРеквизита()

// Процедура заполняет атрибуты XML документа из текущей строки
//
// Параметры:
//  XMLДокумент  - <Тип.Вид> - <описание параметра>
//                 <продолжение описания параметра>
//  СтрокаДЗ  - СтрокаДереваЗначений - строка дерева с атрибутами (или без)
//
Процедура ЗаписатьАтрибутыXML(XMLДокумент, СтрокаДЗ, Документ, ДанныеСтроки, МассивЛогаСобытий, ТребуютЗаполнения)
	
	ИмяСобытия = "Записать атрибут XML";
	Если ТипЗнч(СтрокаДЗ.Атрибуты) = Тип("СписокЗначений") Тогда
		
		Для Каждого Атрибут Из СтрокаДЗ.Атрибуты Цикл
			// Проверка незаполненной формулы при обязательном выводе значения.
			Если Атрибут.Пометка = Истина И НЕ ЗначениеЗаполнено(Атрибут.Представление) Тогда
				ТребуютЗаполнения = ТребуютЗаполнения + ?(ПустаяСтрока(ТребуютЗаполнения), "", Символы.ПС) + "- " + Строка(Атрибут.Значение);
				Продолжить;
			ИначеЕсли НЕ ЗначениеЗаполнено(Атрибут.Представление) Тогда
				Продолжить;
			КонецЕсли;
			
			ЗначениеАтрибута = "";
			
			Попытка
				Выполнить("ЗначениеАтрибута = " + Атрибут.Представление + ";");
			Исключение
				Если ЗначениеЗаполнено(ДанныеСтроки) И Найти(Атрибут.Представление, СтрокаДЗ.Приемник) = 1 Тогда
					Значение = СтрЗаменить(Атрибут.Представление, СтрокаДЗ.Приемник, "ДанныеСтроки");
					Попытка
						Выполнить("ЗначениеАтрибута = " + Значение + ";");
					Исключение
						// Ошибка при обязательном выводе значения.
						Если Атрибут.Пометка = Истина Тогда
							ТребуютЗаполнения = ТребуютЗаполнения + ?(ПустаяСтрока(ТребуютЗаполнения), "", Символы.ПС) + "- " + Строка(Атрибут.Значение);
						КонецЕсли;
						Продолжить;
					КонецПопытки;
				Иначе
					Попытка
						Выполнить("ЗначениеАтрибута = " + "ДанныеСтроки" + Прав(Атрибут.Представление, СтрДлина(Атрибут.Представление) - Найти(Атрибут.Представление, ".") + 1) + ";");
					Исключение
						// Ошибка при обязательном выводе значения.
						Если Атрибут.Пометка = Истина Тогда
							ТребуютЗаполнения = ТребуютЗаполнения + ?(ПустаяСтрока(ТребуютЗаполнения), "", Символы.ПС) + "- " + Строка(Атрибут.Значение);
						КонецЕсли;
						Продолжить;
					КонецПопытки;
				КонецЕсли;
			КонецПопытки;
			
			Попытка
				Если ЗначениеЗаполнено(ЗначениеАтрибута) Тогда
					XMLДокумент.ЗаписатьАтрибут(Атрибут.Значение, ЗначениеАтрибута);
				ИначеЕсли Атрибут.Пометка = Истина Тогда // Ошибка при обязательном выводе значения
					ТребуютЗаполнения = ТребуютЗаполнения + ?(ПустаяСтрока(ТребуютЗаполнения), "", Символы.ПС) + "- " + Строка(Атрибут.Значение);
				КонецЕсли;
			Исключение
				
				// Ошибка при обязательном выводе значения.
				Если Атрибут.Пометка = Истина Тогда
					ТребуютЗаполнения = ТребуютЗаполнения + ?(ПустаяСтрока(ТребуютЗаполнения), "", Символы.ПС) + "- " + Строка(Атрибут.Значение);
				КонецЕсли;
				
				ТекстЛогаСобытий = "Ошибка записи атрибута в XML файл. Ключ атрибута [" + Атрибут.Значение +
				"], значение атрибута [" + Строка(ЗначениеАтрибута) + "] тип значения [" + ТипЗнч(ЗначениеАтрибута) 
				+ "]" + Символы.ПС + ОписаниеОшибки();
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
				
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры // ЗаписатьАтрибутыXML()

// Функция проверяет корректность введенной формулы и возвращает результат ее выполнения.
//
// Параметры:
//  Текст – Строка - текст на встроенном языке 1С
//  МассивЛогаСобытий – Массив - текст ошибки при выполнении кода
//
// Возвращаемое значение:
//   ТаблицаЗначений   - результат выполнения кода
//
Функция ПроверитьФормулу(Текст, МассивЛогаСобытий, Источник, НомерИсправленияНаФорме = "", Приемник  = Неопределено) Экспорт
	
	// Определение дополнительных параметров, использующихся в контексте.
	ТипТранзакции = "";
	ТекстОшибки = "";
	СтруктураДокумента = Новый Структура;
	СоответствиеПоОрганизации = Новый Соответствие;
	СоответствиеПоКонтрагенту = Новый Соответствие;
	СоответствиеПоТочкамДоставки = Новый Соответствие;
	СоответствиеПоНоменклатуре = Новый Соответствие;
	КэшированныеЗначения = Новый Соответствие;
	
	ИмяСобытия = "Тестирование гибких настроек";
	Текст = СтрЗаменить(Текст, Символы.НПП, " ");
	Значение = Неопределено;
	
	ЛогСобытий = ""; // Используется в гибких настройках
	Попытка
		
		Результат = ?(ЗначениеЗаполнено(НомерИсправленияНаФорме), 
		"НомерИсправления = " + НомерИсправленияНаФорме + ";" + Символы.ПС + Текст,
		"НомерИсправления = """";" + Символы.ПС + Текст); 
		Результат = СтрЗаменить(Результат, "¶", Символы.ПС);
		Результат = СтрЗаменить(Результат, "Возврат "   , "Значение = ");
		
		Выполнить(Результат); 
		
		Если ЗначениеЗаполнено(ЛогСобытий) Тогда
			ТекстЛогаСобытий = ЛогСобытий;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Информация, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		КонецЕсли;
		
	Исключение 
		ТекстЛогаСобытий = ОписаниеОшибки();
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
	КонецПопытки;
	
	Возврат ?(Значение = Неопределено, Новый ТаблицаЗначений, Значение);
	
КонецФункции 

