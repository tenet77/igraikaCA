// Процедура запускает создание/обновление записи регистра сведений ЭКОМ_НоменклатураКонтрагентов
//
// Параметры:
//  пСтруктура  		- Структура 		- данные для записи, где ключ - наименование реквизита регистра сведений + уникальный ключ записи
//		(допустим, штрихкод номенклатуры), значение - значение реквизита регистра сведений
//  РеквизитОбъекта  	- Строка 			- имеет вид "НаименованиеНоменклатурыКонтрагента_" + уникальный ключ записи
//	пОбъект1С			- СправочникСсылка 	- ссылка на элемент справочника, с которым будет связана новая/измененная запись
//
Функция СоздатьОбновитьНоменклатуру(СоответствиеДанных, РеквизитОбъекта, пОбъект1С) Экспорт
	
	Если НЕ ЗначениеЗаполнено(пОбъект1С) Тогда
		Возврат "Ошибка. Необходимо заполнить объект 1С";
	КонецЕсли;
	
	УникальныйКлюч = СтрЗаменить(РеквизитОбъекта, "НаименованиеНоменклатурыКонтрагента_", "");
	
	знХарактеристикиНоменклатуры  = Неопределено;
	
	ЕдиницаНоменклатурыКонтрагента = Неопределено;   	
	
	ЕдиницаИзмеренияНоменклатуры = СоответствиеДанных.Получить("ЕдиницаНоменклатурыКонтрагента_" + УникальныйКлюч);	
	Если ТипЗнч(ЕдиницаИзмеренияНоменклатуры) = Тип("Строка") 
		ИЛИ ТипЗнч(ЕдиницаИзмеренияНоменклатуры) = Тип("Неопределено") Тогда
		
		Если НЕ пОбъект1С.Метаданные().Реквизиты.Найти("ЕдиницаИзмерения") = Неопределено Тогда
			ЕдиницаНоменклатурыКонтрагента = пОбъект1С.ЕдиницаИзмерения;
		ИначеЕсли НЕ пОбъект1С.Метаданные().Реквизиты.Найти("БазоваяЕдиницаИзмерения") = Неопределено Тогда
			ЕдиницаНоменклатурыКонтрагента = пОбъект1С.БазоваяЕдиницаИзмерения;
		КонецЕсли;	
		
	Иначе
		ЕдиницаНоменклатурыКонтрагента = ЕдиницаИзмеренияНоменклатуры;		
	КонецЕсли;
	
	АртикулНоменклатурыКонтрагента      = СоответствиеДанных.Получить("АртикулНоменклатурыКонтрагента_"      + УникальныйКлюч);
	КодНоменклатурыКонтрагента          = СоответствиеДанных.Получить("КодНоменклатурыКонтрагента_"          + УникальныйКлюч);
	НаименованиеНоменклатурыКонтрагента = СоответствиеДанных.Получить("НаименованиеНоменклатурыКонтрагента_" + УникальныйКлюч);	
	ШтрихКодНоменклатурыКонтрагента     = СоответствиеДанных.Получить("ШтрихКодНоменклатурыКонтрагента_"     + УникальныйКлюч);   	
	знКонтрагент                        = СоответствиеДанных.Получить("Контрагент_"                          + УникальныйКлюч);	
	
	СтруктРегСв = Новый Структура; 					
	СтруктРегСв.Вставить("АртикулНоменклатурыКонтрагента"     , АртикулНоменклатурыКонтрагента);  // PRODUCTIDSUPPLIER
	СтруктРегСв.Вставить("КодНоменклатурыКонтрагента"         , КодНоменклатурыКонтрагента);      // PRODUCTIDBUYER
	СтруктРегСв.Вставить("ЕдиницаНоменклатурыКонтрагента"     , ЕдиницаНоменклатурыКонтрагента);  // PRODUCT
	СтруктРегСв.Вставить("НаименованиеНоменклатурыКонтрагента", НаименованиеНоменклатурыКонтрагента);
	СтруктРегСв.Вставить("ШтрихКодНоменклатурыКонтрагента"    , ШтрихКодНоменклатурыКонтрагента);
	СтруктРегСв.Вставить("Контрагент"                         , знКонтрагент);
	
	НоменклатураСозданаУспешно = Номенклатура_Контрагентов_Записать(знКонтрагент, пОбъект1С.Ссылка, знХарактеристикиНоменклатуры, СтруктРегСв);
	
	Если НоменклатураСозданаУспешно = Истина Тогда
		
		// Удаление данные после создания или обновления объекта	
		Для каждого Стр Из СоответствиеДанных Цикл				
			МЗ = РегистрыСведений.ЭКОМ_ЗначениеДополнительныхКонстант.СоздатьМенеджерЗаписи();
			МЗ.ДополнительнаяКонстанта = Стр.Ключ;
			МЗ.Измерение               = "Номенклатура_";
			МЗ.Прочитать();
			Если МЗ.Выбран() Тогда	
				МЗ.Удалить();
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат НоменклатураСозданаУспешно;
	
КонецФункции

// Процедура запускает создание/обновление записи регистра сведений ЭКОМ_GLN для организаций
//
// Параметры:
//  пСтруктура  		- Структура 		- данные для записи, где ключ - наименование реквизита регистра сведений + уникальный ключ записи
//		(допустим, GLN), значение - значение реквизита регистра сведений
//	пОбъект1С			- СправочникСсылка 	- ссылка на элемент справочника, с которым будет связана новая/измененная запись
//
Функция СоздатьОбновитьОрганизацию(СоответствиеДанных, пОбъект1С = Неопределено) Экспорт	
	
	Если ЗначениеЗаполнено(пОбъект1С) Тогда		
		ОбъектДляЗаписи = пОбъект1С.ПолучитьОбъект();		
	Иначе		
		Возврат "Необходимо заполнить объект 1С";
	КонецЕсли;
	
	СтруктРегСв = Новый Структура;
	СтруктРегСв.Вставить("GLN", СоответствиеДанных.Получить("GLN"));	
	
	Результат = ЭКОМ_GLN_Запись(ОбъектДляЗаписи.Ссылка, СтруктРегСв);
	
	Возврат Результат;
	
КонецФункции

// Процедура запускает создание/обновление записи регистра сведений ЭКОМ_GLN для контрагента
//
// Параметры:
//  пСтруктура  		- Структура 		- данные для записи, где ключ - наименование реквизита регистра сведений + уникальный ключ записи
//		(допустим, GLN), значение - значение реквизита регистра сведений
//	Тип					- Строка			- тип входящей записи: "Организация_", "Контрагент_", "ТочкаДоставки_", "ЕдиницаИзмерения_", "Номенклатура_"
//	пОбъект1С			- СправочникСсылка 	- ссылка на элемент справочника, с которым будет связана новая/измененная запись
//
Функция СоздатьОбновитьКонтрагента(СоответствиеДанных, Тип, пОбъект1С = Неопределено)	Экспорт
	
	Если ЗначениеЗаполнено(пОбъект1С) Тогда
		ОбъектДляЗаписи = пОбъект1С.ПолучитьОбъект();
	Иначе	
		Возврат "Необходимо заполнить объект 1С";
	КонецЕсли;
	
	СтруктРегСвКонтрагент    = Новый Структура;
	СтруктРегСвТочкаДоставки = Новый Структура;
	СоотвАдреса              = Новый Структура;
	
	Адрес	= "";	
	Индекс 	= СоответствиеДанных.Получить("Индекс");
	Если ЗначениеЗаполнено(Индекс) Тогда
		СоотвАдреса.Вставить("Поле1"                    , Индекс); 
		СтруктРегСвКонтрагент.Вставить("eXiteАдр_Индекс", Индекс);
		СтруктРегСвТочкаДоставки.Вставить("Адр_Индекс"  , Индекс);
		Адрес = Индекс + ", ";
	КонецЕсли;
	
	КодРегион = СоответствиеДанных.Получить("Регион");
	Если ЗначениеЗаполнено(КодРегион) Тогда
		СоотвАдреса.Вставить("Поле2"                        , КодРегион);
		СтруктРегСвКонтрагент.Вставить("eXiteАдр_КодРегиона", КодРегион);
		СтруктРегСвТочкаДоставки.Вставить("Адр_КодРегиона"  , КодРегион);
		Адрес = Адрес + КодРегион + ", ";
	КонецЕсли;
	
	Район  = СоответствиеДанных.Получить("Район");
	Если ЗначениеЗаполнено(Район) Тогда
		СоотвАдреса.Вставить("Поле3"                   , Район); 
		СтруктРегСвКонтрагент.Вставить("eXiteАдр_Район", Район);
		СтруктРегСвТочкаДоставки.Вставить("Адр_Район"  , Район);
		Адрес = Адрес + Район + ", ";
	КонецЕсли;
	
	Город = СоответствиеДанных.Получить("Город");
	Если ЗначениеЗаполнено(Город) Тогда
		СоотвАдреса.Вставить("Поле4"                   , Город);
		СтруктРегСвКонтрагент.Вставить("eXiteАдр_Город", Город);
		СтруктРегСвТочкаДоставки.Вставить("Адр_Город"  , Город);
		Адрес = Адрес + Город + ", ";
	КонецЕсли;
	
	НаселПункт = СоответствиеДанных.Получить("Население");
	Если ЗначениеЗаполнено(НаселПункт) Тогда
		СоотвАдреса.Вставить("Поле5"                        , НаселПункт);
		СтруктРегСвКонтрагент.Вставить("eXiteАдр_НаселПункт", НаселПункт);
		СтруктРегСвТочкаДоставки.Вставить("Адр_НаселПункт"  , НаселПункт);
		Адрес = Адрес + НаселПункт + ", ";
	КонецЕсли;
	
	Улица = СоответствиеДанных.Получить("Улица");
	Если ЗначениеЗаполнено(Улица) Тогда
		СоотвАдреса.Вставить("Поле6"                   , Улица);
		СтруктРегСвКонтрагент.Вставить("eXiteАдр_Улица", Улица);
		СтруктРегСвТочкаДоставки.Вставить("Адр_Улица"  , Улица);
		Адрес = Адрес + Улица + ", ";
	КонецЕсли;
	
	Дом = СоответствиеДанных.Получить("НомерДома");
	Если ЗначениеЗаполнено(Дом) Тогда
		СоотвАдреса.Вставить("Поле7"                 , Дом);  
		СтруктРегСвКонтрагент.Вставить("eXiteАдр_Дом", Дом);
		СтруктРегСвТочкаДоставки.Вставить("Адр_Дом"  , Дом);
		Адрес = Адрес + Дом + ", ";
	КонецЕсли;
	
	Корпус = СоответствиеДанных.Получить("Корпус");
	Если ЗначениеЗаполнено(Корпус) Тогда
		СоотвАдреса.Вставить("Поле8"                    , Корпус); 
		СтруктРегСвКонтрагент.Вставить("eXiteАдр_Корпус", Корпус);
		СтруктРегСвТочкаДоставки.Вставить("Адр_Корпус"  , Корпус);
		Адрес = Адрес + Корпус + ", ";
	КонецЕсли;
	
	Кварт = СоответствиеДанных.Получить("Квартира");
	Если ЗначениеЗаполнено(Кварт) Тогда
		СоотвАдреса.Вставить("Поле9"                   , Кварт); 
		СтруктРегСвКонтрагент.Вставить("eXiteАдр_Кварт", Кварт);
		СтруктРегСвТочкаДоставки.Вставить("Адр_Кварт"  , Кварт);
		Адрес = Адрес + Кварт + ", ";
	КонецЕсли;
	
	GLN = СоответствиеДанных.Получить("GLN");
	
	СтруктРегСвКонтрагент.Вставить("GLN", GLN);
	
	СтруктРегСвТочкаДоставки.Вставить("GLN"  , GLN);
	СтруктРегСвТочкаДоставки.Вставить("Адрес", Адрес);
	
	Если Найти(Тип, "Контрагент_") = 1 Тогда
		Результат = ЭКОМ_GLN_Запись(ОбъектДляЗаписи.Ссылка, СтруктРегСвКонтрагент);
	ИначеЕсли Найти(Тип, "ТочкаДоставки_") = 1 Тогда
		Результат = ЭКОМ_ТочкиДоставки_Запись(ОбъектДляЗаписи.Ссылка, СтруктРегСвТочкаДоставки);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

//Функции определяют тип документа используемого в базе 1С. Получение соответствий видов документов из доп. констант
Функция ПолучитьТипДокументаИБ(Вид = "ЭКОМ_ВидЗаказаПоставщик", МассивЛогаСобытий) Экспорт

	ИмяСобытия = "Тип документа - " + Вид;
	Результат = Настройка_Параметр_Прочитать(Вид, "");
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		ТекстЛогаСобытий =  "Необходимо заполнить типы документов: [" + Вид + "]";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции //ПолучитьТипДокумента()

