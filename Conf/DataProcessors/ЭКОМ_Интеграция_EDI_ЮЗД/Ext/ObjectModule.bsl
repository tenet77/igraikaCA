	|ВЫБРАТЬ
	|	ЭКОМ_Объекты_События.Контрагент КАК Контрагент,
	|	ЭКОМ_Объекты_События.Организация КАК Организация,
	|	ЕСТЬNULL(ЭКОМ_Объекты_События.Документ_Основание, НЕОПРЕДЕЛЕНО) КАК ДокументОснование,
	|	ДокументыШапка.ИдФайл КАК ИдФайл,
	|	ДокументыШапка.ВидДокумента КАК ВидДокумента,
	|	ЭКОМ_Объекты_События.ВидДокумента КАК ВидДокументаОснования,
	|	ДокументыШапка.ИмяПостФайла,
	|	ДокументыШапка.ТекстУточнения,
	|	ЭКОМ_Объекты_События.ЗаказДата,
	|	ЭКОМ_Объекты_События.ЗаказНомер,
	|	ЭКОМ_Объекты_События.НомерДокумента,
	|	ЭКОМ_Объекты_События.ДатаДокумента
	|ИЗ
	|	ДокументыШапка КАК ДокументыШапка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_События
	|		ПО ДокументыШапка.ИмяПостФайла = ЭКОМ_Объекты_События.Идентификатор
	|			И (ЭКОМ_Объекты_События.НаправлениеОбмена = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_НаправлениеОбмена.Исходящий))";
	
	Запрос.УстановитьПараметр("ДокументыШапка", ДокументыШапка);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ПроверкаНаДублирование = Новый Соответствие;
	
	ИмяСобытия = "Создание записи по квитанции уточнения - DP_UVUTOCH_09";
	
	Пока Выборка.Следующий() Цикл
		
		Если ПроверкаНаДублирование.Получить(Выборка.ИдФайл) = Неопределено Тогда
			ПроверкаНаДублирование.Вставить(Выборка.ИдФайл);
		Иначе			
			ТекстЛогаСобытий = "Дублирование данных, проверьте GLN организации, контрагента, точки доставки ИД документа - " + Выборка.ИдФайл;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

			Продолжить;
			
		КонецЕсли;
		
		СтрокаТЗСтруктур = ТЗСтруктур.Найти(Выборка.ИдФайл, "ИдентификаторФайла");
		
		СтруктураРегистраСобытий = Новый Структура;
		СтруктураРегистраСобытий.Вставить("НомерДокумента"   , Выборка.НомерДокумента);
		СтруктураРегистраСобытий.Вставить("ДатаДокумента"    , Выборка.ДатаДокумента);
		СтруктураРегистраСобытий.Вставить("ЗаказДата"        , Выборка.ЗаказДата);
		СтруктураРегистраСобытий.Вставить("ЗаказНомер"       , Выборка.ЗаказНомер);
		СтруктураРегистраСобытий.Вставить("Контрагент"       , Выборка.Контрагент);
		СтруктураРегистраСобытий.Вставить("Организация"      , Выборка.Организация);
		СтруктураРегистраСобытий.Вставить("ФайлИмя"          , СтрокаТЗСтруктур.ИмяФайлаXML);
		СтруктураРегистраСобытий.Вставить("ЭЦП"              , СтрокаТЗСтруктур.ЭЦП);
		СтруктураРегистраСобытий.Вставить("Идентификатор"    , Выборка.ИдФайл);
		СтруктураРегистраСобытий.Вставить("ИдентификаторИспр", Выборка.ИмяПостФайла);
		СтруктураРегистраСобытий.Вставить("Статус"           , Перечисления.ЭКОМ_Статусы.Загружен);
		СтруктураРегистраСобытий.Вставить("ТекстОшибки"      , Выборка.ТекстУточнения);
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("ДокументОснование"    , Выборка.ДокументОснование);
		СтруктураПараметров.Вставить("ВидДокумента"         , Выборка.ВидДокумента);
		СтруктураПараметров.Вставить("ВидДокументаОснования", Выборка.ВидДокументаОснования);
		СтруктураПараметров.Вставить("ИмяПостФайла"         , Выборка.ИмяПостФайла);
		
		СоздатьЗаписьПоКвитанции(СтруктураПараметров, СтруктураРегистраСобытий, СтрокаТЗСтруктур, МассивЛогаСобытий, НеНайденныеКвитанции);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СоздатьЗаписьDP_PRANNUL(ТЗСтруктур, ДокументыШапка, МассивЛогаСобытий, НеНайденныеКвитанции) Экспорт
	
	ВидыДокументовЮЗД = Новый Массив;
	Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьПервичныеВидыДокументовЮЗД(ВидыДокументовЮЗД);");
	Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьИсправительныеВидыДокументовЮЗД(ВидыДокументовЮЗД);");
	Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьКорректировочныеВидыДокументовЮЗД(ВидыДокументовЮЗД);");
	
	// Запрос по шапке документов
	Запрос = Новый Запрос;	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДокументыШапка.ВидДокумента КАК ВидДокумента,
	|	ПОДСТРОКА(ДокументыШапка.Документ_СвПредАн_СведАнФайл_ИмяАнФайла, 1, 256) КАК ИмяПостФайла,
	|	ПОДСТРОКА(ДокументыШапка.ИдФайл, 1, 256) КАК ИдФайл
	|ПОМЕСТИТЬ ДокументыШапка
	|ИЗ
	|	&ДокументыШапка КАК ДокументыШапка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЭКОМ_Объекты_СобытияЮЗД.Контрагент КАК Контрагент,
	|	ЭКОМ_Объекты_СобытияЮЗД.Организация КАК Организация,
	|	ЕСТЬNULL(ЭКОМ_Объекты_СобытияЮЗД.Документ_Основание, НЕОПРЕДЕЛЕНО) КАК ДокСЧФ,
	|	ДокументыШапка.ИдФайл КАК ИдФайл,
	|	ДокументыШапка.ВидДокумента КАК ВидДокумента,
	|	ЭКОМ_Объекты_СобытияЮЗД.ВидДокумента КАК ВидДокументаОснования,
	|	ЭКОМ_Объекты_СобытияЮЗД.Статус,
	|	ЭКОМ_Объекты_СобытияЮЗД.ЗаказДата,
	|	ЭКОМ_Объекты_СобытияЮЗД.ЗаказНомер,
	|	ДокументыШапка.ИмяПостФайла,
	|	ЭКОМ_Объекты_СобытияЮЗД.НаправлениеОбмена
	|ИЗ
	|	ДокументыШапка КАК ДокументыШапка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_СобытияЮЗД
	|		ПО ДокументыШапка.ИмяПостФайла = ЭКОМ_Объекты_СобытияЮЗД.Идентификатор
	|			И (ЭКОМ_Объекты_СобытияЮЗД.ВидДокумента В (&ВидыДокументовЮЗД))";
	
	Запрос.УстановитьПараметр("ДокументыШапка"   , ДокументыШапка);
	Запрос.УстановитьПараметр("ВидыДокументовЮЗД", ВидыДокументовЮЗД);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ИмяСобытия = "Создание записи по квитанции DP_PRANNUL_22"; //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _22]
	Пока Выборка.Следующий() Цикл
		
		ПредставлениеДокумента = СокрЛП(Выборка.ВидДокумента) + " с ИД = " + Выборка.ИдФайл + " для документа с ИД = " + Выборка.ИмяПостФайла;
		СтруктураДокумента = Неопределено;
		СтрокаТЗСтруктур = ТЗСтруктур.Найти(Выборка.ИдФайл, "ИдентификаторФайла");
		Если СтрокаТЗСтруктур = Неопределено Тогда		
			ТекстЛогаСобытий = "Не найдена структура документа - " + ПредставлениеДокумента;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Продолжить;
			
		Иначе		
			СтруктураДокумента = СтрокаТЗСтруктур.СтруктураДокумента;		
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Выборка.ДокСЧФ) Тогда	
			
			СтруктураДокумента.Вставить("Обработан"   , Ложь);
			СтруктураДокумента.Вставить("ТекстПричины", ""); // Текст причины не указываем, в итоговом сообщении укажем количество записанных квитанций в регистр ЭКОМ_Квитанции
			
			// Сохраняем в регистре ЭКОМ_Квитанции 
			МЗ = РегистрыСведений.ЭКОМ_Квитанции.СоздатьМенеджерЗаписи();
			МЗ.ВидДокумента  = СтруктураДокумента.ВидДокумента;
			МЗ.Идентификатор = СтруктураДокумента.ИдФайл;
			МЗ.Прочитать();
			
			Если НЕ МЗ.Выбран() Тогда
				МЗ.ВидДокумента  = СтруктураДокумента.ВидДокумента;
				МЗ.Идентификатор = СтруктураДокумента.ИдФайл;
			КонецЕсли;
			
			МЗ.ИдентификаторОснования = Выборка.ИмяПостФайла;		
			МЗ.СтруктураФайла = Новый ХранилищеЗначения(СтруктураДокумента, Новый СжатиеДанных(9));
			МЗ.ЭЦП            = СтрокаТЗСтруктур.ЭЦП;
			МЗ.ДатаЗаписи     = ТекущаяДата();
			МЗ.Записать();
			
			// Для архивирования добавляем в массив
			НеНайденныеКвитанции.Добавить(СтрокаТЗСтруктур.ИмяФайлаXML);
			НеНайденныеКвитанции.Добавить(СтрокаТЗСтруктур.ИмяФайлаПодписи);
			
		Иначе
			
			СтруктураДокумента.Вставить("Обработан", Истина);
			
			СтруктураРегистраСобытий = Новый Структура;
			СтруктураРегистраСобытий.Вставить("ЗаказДата"        , Выборка.ЗаказДата);
			СтруктураРегистраСобытий.Вставить("ЗаказНомер"       , Выборка.ЗаказНомер);
			СтруктураРегистраСобытий.Вставить("ДатаЗаписи"       , ТекущаяДата());
			СтруктураРегистраСобытий.Вставить("НаправлениеОбмена", Перечисления.ЭКОМ_НаправлениеОбмена.Входящий);
			СтруктураРегистраСобытий.Вставить("ФайлИмя"          , СтрокаТЗСтруктур.ИмяФайлаXML);
			СтруктураРегистраСобытий.Вставить("ЭЦП"              , СтрокаТЗСтруктур.ЭЦП);
			СтруктураРегистраСобытий.Вставить("Контрагент"       , Выборка.Контрагент);
			СтруктураРегистраСобытий.Вставить("Организация"      , Выборка.Организация);
			СтруктураРегистраСобытий.Вставить("Идентификатор"    , СтруктураДокумента.ИдФайл);
			СтруктураРегистраСобытий.Вставить("ИдентификаторИспр", Выборка.ИмяПостФайла);
			СтруктураРегистраСобытий.Вставить("СтруктураФайла"   , Новый ХранилищеЗначения(СтруктураДокумента, Новый СжатиеДанных(9)));	
			СтруктураРегистраСобытий.Вставить("Статус"           , Перечисления.ЭКОМ_Статусы.Загружен);
			СтруктураРегистраСобытий.Вставить("ТекстОшибки"      , "");		
			ЭКОМ_Объекты_События_Записать(Выборка.ДокСЧФ, СтруктураДокумента.ВидДокумента, СтруктураРегистраСобытий);	
			
			// Записываем в цепочку
			ДанныеОтбора = Новый Структура;
			Если Выборка.НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Входящий Тогда
				ИмяРегистра = "ЭКОМ_ЦепочкиДокументовПокупателя";
				ДанныеОтбора.Вставить("ЮЗД", Выборка.ДокСЧФ);
			Иначе	
				ИмяРегистра = "ЭКОМ_ЦепочкиДокументовПоставщика";
				ДанныеОтбора.Вставить("СЧФ", Выборка.ДокСЧФ);
			КонецЕсли;
			
			НачатьТранзакцию();
			
			НаборЗаписей = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
			ДанныеОтбора.Вставить("ORDERDATE"  , Выборка.ЗаказДата);
			ДанныеОтбора.Вставить("ORDERNUMBER", Выборка.ЗаказНомер);
			ДанныеОтбора.Вставить("Организация", Выборка.Организация);
			ДанныеОтбора.Вставить("Контрагент" , Выборка.Контрагент);
			Для каждого Стр Из ДанныеОтбора Цикл
				Если ЗначениеЗаполнено(Стр.Значение) Тогда
					НаборЗаписей.Отбор[Стр.Ключ].Установить(Стр.Значение);
				КонецЕсли;
			КонецЦикла;
			
			//Выполним блокировку данных
			Выполнить("ЭКОМ_ПодпискаСобытий.ВыполнитьБлокировкуНабораЗаписей(НаборЗаписей.Отбор, ИмяРегистра)");
			
			НаборЗаписей.Прочитать();
			
			// Если существует документ в регистре
			Для Каждого НоваяЗапись Из НаборЗаписей Цикл						
				НоваяЗапись.ТекстПричиныАннулирования = СтруктураДокумента.Документ_СвПредАн_ТекстПредАн;
			КонецЦикла;	
			
			НаборЗаписей.Записать();	
			
			ЗафиксироватьТранзакцию();
			
		КонецЕсли;
		
		СтруктураДокумента.Вставить("Организация", Выборка.Организация);
		СтрокаТЗСтруктур.СтруктураДокумента = СтруктураДокумента;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СоздатьЗаписьDP_IZVPOL_23(ТЗСтруктур, ДокументыШапка, МассивЛогаСобытий, НеНайденныеКвитанции) Экспорт
	
	ВидыДокументовЮЗД = Новый Массив;
	Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьПервичныеВидыДокументовЮЗД(ВидыДокументовЮЗД);");
	Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьИсправительныеВидыДокументовЮЗД(ВидыДокументовЮЗД);");
	Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьКорректировочныеВидыДокументовЮЗД(ВидыДокументовЮЗД);");	
	
	// Запрос по шапке документов
	Запрос = Новый Запрос;	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДокументыШапка.ВидДокумента КАК ВидДокумента,
	|	ПОДСТРОКА(ДокументыШапка.Документ_СвИзвПолуч_СведПолФайл_ИмяПостФайла, 1, 256) КАК ИмяПостФайла,
	|	ПОДСТРОКА(ДокументыШапка.ИдФайл, 1, 256) КАК ИдФайл
	|ПОМЕСТИТЬ ДокументыШапка
	|ИЗ
	|	&ДокументыШапка КАК ДокументыШапка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЭКОМ_Объекты_СобытияАннулирование.Контрагент КАК Контрагент,
	|	ЭКОМ_Объекты_СобытияАннулирование.Организация КАК Организация,
	|	ЕСТЬNULL(ЭКОМ_Объекты_СобытияАннулирование.Документ_Основание, НЕОПРЕДЕЛЕНО) КАК ДокСЧФ,
	|	ДокументыШапка.ИдФайл КАК ИдФайл,
	|	ДокументыШапка.ВидДокумента КАК ВидДокумента,
	|	ЭКОМ_Объекты_СобытияАннулирование.ВидДокумента КАК ВидДокументаОснования,
	|	ЭКОМ_Объекты_СобытияАннулирование.Статус КАК Статус,
	|	ЭКОМ_Объекты_СобытияАннулирование.ЗаказДата КАК ЗаказДата,
	|	ЭКОМ_Объекты_СобытияАннулирование.ЗаказНомер КАК ЗаказНомер,
	|	ДокументыШапка.ИмяПостФайла КАК ИмяПостФайла,
	|	ЭКОМ_Объекты_СобытияЮЗД.НаправлениеОбмена КАК НаправлениеОбменаЮЗД,
	|	ЭКОМ_Объекты_СобытияЮЗД.ВидДокумента КАК ВидДокументаЮЗД
	|ИЗ
	|	ДокументыШапка КАК ДокументыШапка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_СобытияАннулирование
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_СобытияЮЗД
	|			ПО ЭКОМ_Объекты_СобытияАннулирование.Документ_Основание = ЭКОМ_Объекты_СобытияЮЗД.Документ_Основание
	|				И (ЭКОМ_Объекты_СобытияЮЗД.ВидДокумента В (&ВидыДокументовЮЗД))
	|		ПО ДокументыШапка.ИмяПостФайла = ЭКОМ_Объекты_СобытияАннулирование.Идентификатор
	|			И (ЭКОМ_Объекты_СобытияАннулирование.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.DP_PRANNUL_22))
	|			И (ЭКОМ_Объекты_СобытияАннулирование.НаправлениеОбмена = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_НаправлениеОбмена.Исходящий))";
	
	Запрос.УстановитьПараметр("ДокументыШапка"   , ДокументыШапка);
	Запрос.УстановитьПараметр("ВидыДокументовЮЗД", ВидыДокументовЮЗД);
	
