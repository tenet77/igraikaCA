Функция ПолучитьТаблицуКоманд()
	
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	
	Возврат Команды;
	
КонецФункции  

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")
	
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;
	
КонецПроцедуры

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполнения = Неопределено) Экспорт
	
	// Реализация логики команды
	Если НЕ ЭКОМ_ОбщегоНазначения.ПоискВСтроке(ИдентификаторКоманды, "ДляОбменаЭлектроннымиДокументами") = 0 Тогда
		
		АвтоматическийОбменEDI(ИдентификаторКоманды);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьКомандуВФоне(СтруктураПараметров, АдресРезультата) Экспорт
	
	// Проверим структуру входящих параметров (задаются на форме)
	Если НЕ ТипЗнч(СтруктураПараметров) = Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	// Формируем возвращаемую структуру на клиент
	СтруктураВозврата = Новый Структура; 
	
	Если СтруктураПараметров.ИмяМетодаВыполнения = "ПолучитьВсеФайлы" Тогда
		МассивСтруктурыФайловСервера = ПолучитьВсеФайлы(СтруктураПараметров.МассивФайловСКлиента,
		СтруктураПараметров.ТипДокумента,
		СтруктураПараметров.ОбработатьФайлыНаКлиенте,
		СтруктураПараметров.МассивЛогаСобытий,
		СтруктураПараметров.ЭтоРегламентноеЗадание,
		СтруктураПараметров.СтруктураЛога);
		
		СтруктураВозврата.Вставить("МассивСтруктурыФайловСервера", МассивСтруктурыФайловСервера);
		
	ИначеЕсли СтруктураПараметров.ИмяМетодаВыполнения = "СформироватьДокументыXML" Тогда
		МассивСтруктур = СформироватьДокументыXML(СтруктураПараметров.МассивСтрок,
		СтруктураПараметров.ОбработатьФайлыНаКлиенте,
		СтруктураПараметров.МассивЛогаСобытий,
		СтруктураПараметров.ЭтоРегламентноеЗадание,
		СтруктураПараметров.ТипДокумента,
		СтруктураПараметров.ПодписатьФайл);
		
		СтруктураВозврата.Вставить("МассивСтруктур", МассивСтруктур);
		
	ИначеЕсли СтруктураПараметров.ИмяМетодаВыполнения = "ОтправитьВсеФайлы" Тогда
		МассивСтруктур = ОтправитьВсеФайлы(СтруктураПараметров.МассивСтрок,
		СтруктураПараметров.ТипДокумента,
		СтруктураПараметров.МассивЛогаСобытий,
		СтруктураПараметров.НомерИсправления,
		СтруктураПараметров.ЭтоРегламентноеЗадание,
		СтруктураПараметров.ПодписатьФайл,
		СтруктураПараметров.ЭтоНовыеДокументы,
		СтруктураПараметров.СтруктураЛога);
		
		СтруктураВозврата.Вставить("МассивСтруктур", МассивСтруктур);
		
	ИначеЕсли СтруктураПараметров.ИмяМетодаВыполнения = "ОтправитьФайлы" Тогда
		ОтправитьФайлы(СтруктураПараметров.МассивФайловВсего,
		СтруктураПараметров.ТипДокумента,
		СтруктураПараметров.МассивЛогаСобытий,
		СтруктураПараметров.ЭтоРегламентноеЗадание,
		СтруктураПараметров.ЭтоНовыеДокументы,
		СтруктураПараметров.СтруктураЛога);
		
	ИначеЕсли СтруктураПараметров.ИмяМетодаВыполнения = "СоздатьДокументПоДинамическойКнопке" Тогда
		
		ТЗДокументы =  ДинамическаяКнопкаПолучитьТаблицу(СтруктураПараметров.СинонимКнопки, СтруктураПараметров.ДанныеСписка.ИмяРеквизитаТаблицы, СтруктураПараметров.ВыбранныеСтроки, СтруктураПараметров.МассивЛогаСобытий);
		
		СоздатьДокументПоДинамическойКнопке(ТЗДокументы,
		СтруктураПараметров.СинонимКнопки,
		СтруктураПараметров.ДанныеСписка.ТипОбмена,
		СтруктураПараметров.МассивЛогаСобытий);
		
	КонецЕсли;   
	
	СтруктураВозврата.Вставить("СтруктураПараметров", СтруктураПараметров);
	
	// Помещаем в ВХ данные для клиента
	ПоместитьВоВременноеХранилище(СтруктураВозврата, АдресРезультата);
	
КонецПроцедуры

Функция ДинамическаяКнопкаПолучитьТаблицу(СинонимКнопки, ИмяСписка, ВыбранныеСтроки, МассивЛогаСобытий) Экспорт
	
	ИмяСобытия = "Получение таблицы значений";
	Шаблон = Неопределено;
	
	// Получение нужных нам колонок.
	ЭКОМ_СтруктураФайлаXMLДокументы	= Настройка_Параметр_Прочитать("СтруктураФайлаXMLДокументы");
	Для Каждого Строка Из ЭКОМ_СтруктураФайлаXMLДокументы.Строки Цикл
		Если Строка.Кнопка = СинонимКнопки Тогда
			Шаблон = Строка;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Шаблон = Неопределено Тогда
		ТекстЛогаСобытий = "Не найден подходящий шаблон!";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	СписокКолонок = Новый Соответствие;
	СписокКолонок.Вставить("ДокументЗаказа", "");
	СписокКолонок.Вставить("Документ"      , "");
	
	АлгоритмЗаполненияСписка = "";
	
	// Получаем список колонок.
	Если ИмяСписка = "СписокДляПоставщика" Тогда		
		СписокКолонок.Вставить("ЭКОМ_Документ_ORDER"  , "");
		СписокКолонок.Вставить("ЭКОМ_Документ_RECADV" , "");
		СписокКолонок.Вставить("ДокументРеализации"   , "");
		СписокКолонок.Вставить(Шаблон.КолонкаИсточника, "");
		
		АлгоритмЗаполненияСписка = Настройка_Параметр_Прочитать("СлужебныйЗапросДляФормыПоставщика", ,"Служебный");
	ИначеЕсли ИмяСписка = "СписокДляПокупателя" Тогда
		СписокКолонок.Вставить("ЭКОМ_Документ_ORDRSP" , "");
		СписокКолонок.Вставить("ЭКОМ_Документ_DESADV" , "");
		СписокКолонок.Вставить("ДокументПоступления"  , "");
		СписокКолонок.Вставить(Шаблон.КолонкаИсточника, "");
		
		АлгоритмЗаполненияСписка = Настройка_Параметр_Прочитать("СлужебныйЗапросДляФормыПокупателя", ,"Служебный");
		
	ИначеЕсли ИмяСписка = "СписокДляПрайсЛиста" Тогда
		СписокКолонок = Новый Соответствие; 
		СписокКолонок.Вставить("Документ"                , "");
		СписокКолонок.Вставить("PRICAT"                  , "");
		СписокКолонок.Вставить("УстановкаЦенНоменклатуры", "");
		СписокКолонок.Вставить(Шаблон.КолонкаИсточника   , "");
		
		АлгоритмЗаполненияСписка = Настройка_Параметр_Прочитать("СлужебныйЗапросДляФормыПрайсЛист", ,"Служебный");
		
	КонецЕсли;
	
	Колонки = "";
	Для каждого СтрСписокКолонок Из СписокКолонок Цикл	
		Колонки = ?(ЗначениеЗаполнено(Колонки), Колонки + ", ", "") + СтрСписокКолонок.Ключ;	
	КонецЦикла;
	
	ТекстЗапроса = "";
	
	ТЗ = Новый ТаблицаЗначений;
	Попытка
			
		Выполнить(АлгоритмЗаполненияСписка);
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВЫБРАТЬ", "ВЫБРАТЬ ПЕРВЫЕ 5");
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("ДатаНач", ТекущаяДата());
		Запрос.УстановитьПараметр("ДатаКон", ТекущаяДата());	
		Запрос.УстановитьПараметр("масПомеченныхДоков", Новый Массив);
		Запрос.УстановитьПараметр("НаправлениеОбмена" , Перечисления.ЭКОМ_НаправлениеОбмена.ПустаяСсылка());
		
		ТЗ = Запрос.Выполнить().Выгрузить();		
	Исключение
		ТекстЛогаСобытий = ОписаниеОшибки();
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

	КонецПопытки;
	
	// Проверяем наличие колонки источника
	ИсточникКолонка = ТЗ.Колонки.Найти(Шаблон.КолонкаИсточника);
	Если ИсточникКолонка = Неопределено Тогда // Такой колонки нет в таблице значений
		ТекстЛогаСобытий = "В таблице <" + ИмяСписка + "> отсутствует колонка с именем <" + Шаблон.КолонкаИсточника + ">";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	// Отмечаем выбранные строки (если они не отмечены).
	ТЗ.Колонки.Добавить("Документ", ИсточникКолонка.ТипЗначения);
	ТЗ.Очистить();
	Н = 0;
	Для Каждого Строка Из ВыбранныеСтроки Цикл
		Н = Н + 1;
		Если НЕ ЗначениеЗаполнено(Строка[Шаблон.КолонкаИсточника]) Тогда
			ТекстЛогаСобытий = "В строке - " + Н + " не заполнен документ источник - строка пропущена!";
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

			Продолжить;
		КонецЕсли;
		НоваяСтрока = ТЗ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		НоваяСтрока.Документ = Строка[Шаблон.КолонкаИсточника];
	КонецЦикла;
	
	// Формируем массив данных для передачаи на сервер.
	ТЗДокументы = ТЗ.Скопировать(,Колонки);
	Если ТЗДокументы.Количество() = 0 Тогда
		ТекстЛогаСобытий = "Нет помеченных строк для создания документа! или есть ошибки в строке!";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

	КонецЕсли;
	
	Возврат ТЗДокументы;
	
КонецФункции

// Процедура считывает документы конфигурации и заполняет реквизит ДеревоКонфигурации на основании полученных данных.
//
Функция ЗаполнитьДеревоКонфигурации(ВернутьРезультат = Ложь) Экспорт
	
	СлужебныйДеревоКонфигурации = Новый ДеревоЗначений;
	
	// Заполнение дерева конфигурации.
	Если СлужебныйДеревоКонфигурации.Строки.Количество() = 0 Тогда
		СлужебныйДеревоКонфигурации.Колонки.Добавить("Имя", 			Новый ОписаниеТипов("Строка"));
		СлужебныйДеревоКонфигурации.Колонки.Добавить("Синоним", 		Новый ОписаниеТипов("Строка"));
		СлужебныйДеревоКонфигурации.Колонки.Добавить("Тип",	Новый ОписаниеТипов("Строка"));
		
		Мета = Метаданные;
		
		Для Каждого Элемент Из Мета.Документы Цикл
			
			// Заполняем документы.
			ДокументКонфигурации 			= СлужебныйДеревоКонфигурации.Строки.Добавить();
			ДокументКонфигурации.Имя 		= Элемент.Имя;
			ДокументКонфигурации.Синоним 	= Элемент.Синоним;
			
			// Добавление стандартных реквизитов.
			Для Каждого Реквизит Из Элемент.СтандартныеРеквизиты Цикл
				Если Реквизит.Имя = "Ссылка" Тогда // Ссылку пропускаем
					Продолжить;
				КонецЕсли;
				РеквизитДокумента 			= ДокументКонфигурации.Строки.Добавить();
				РеквизитДокумента.Имя 		= Реквизит.Имя;
				РеквизитДокумента.Тип 		= ТипВСтроку(Мета, Реквизит.Тип);
				РеквизитДокумента.Синоним 	= ?(ПустаяСтрока(Реквизит.Синоним), Реквизит.Имя, Реквизит.Синоним);
			КонецЦикла;
			
			// Заполняем реквизиты документов.
			Для Каждого Реквизит Из Элемент.Реквизиты Цикл
				РеквизитДокумента 			= ДокументКонфигурации.Строки.Добавить();
				РеквизитДокумента.Имя 		= Реквизит.Имя;
				//ТВС: НачалоИзменений, 26.06.2019
				РеквизитДокумента.Тип 		= ТипВСтроку(Мета,Реквизит.Тип);
				//ТВС: КонецИзменений
				РеквизитДокумента.Синоним 	= Реквизит.Синоним;
			КонецЦикла;
			ДокументКонфигурации.Строки.Сортировать("Синоним");
			
			// Заполняем табличные части документов.	
			Для Каждого Таблица Из Элемент.ТабличныеЧасти Цикл
				ТаблицаДокумента 			= ДокументКонфигурации.Строки.Добавить();
				ТаблицаДокумента.Имя 		= Таблица.Имя;
				ТаблицаДокумента.Синоним 	= Таблица.Синоним;
				
				// Заполняем реквизиты табличных частей докумнетов.
				Для Каждого Реквизит Из Таблица.Реквизиты Цикл
					РеквизитТаблицы 			= ТаблицаДокумента.Строки.Добавить();
					РеквизитТаблицы.Имя 		= Реквизит.Имя;
					РеквизитТаблицы.Тип 		= ТипВСтроку(Мета, Реквизит.Тип);
					РеквизитТаблицы.Синоним 	= Реквизит.Синоним;
				КонецЦикла;
				
				// Добавление стандартных реквизитов.
				Для Каждого Реквизит Из Таблица.СтандартныеРеквизиты Цикл
					РеквизитТаблицы 			= ТаблицаДокумента.Строки.Добавить();
					РеквизитТаблицы.Имя 		= Реквизит.Имя;
					РеквизитТаблицы.Тип 		= ТипВСтроку(Мета, Реквизит.Тип);
					РеквизитТаблицы.Синоним 	= ?(ПустаяСтрока(Реквизит.Синоним), Реквизит.Имя, Реквизит.Синоним);
				КонецЦикла;
				ТаблицаДокумента.Строки.Сортировать("Синоним");
			КонецЦикла;
		КонецЦикла;
		
		СлужебныйДеревоКонфигурации.Строки.Сортировать("Синоним");
	КонецЕсли;
	
	ВернутьРезультат = Настройка_Параметр_Записать("_СлужебныйДеревоКонфигурации", СлужебныйДеревоКонфигурации, "Служебный");
	
	Если ВернутьРезультат = Истина Тогда
		Возврат СлужебныйДеревоКонфигурации;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции 

// Функция преобразует передаваемый тип в его строковое представление
//
// Параметры:
//  Мета  - ОбъектМетаданныхКонфигурация - коллекция метаданных объектов конфигурации
//  Тип  - ОписаниеТипов - тип данные
//
// Возвращаемое значение:
//   Строка   - представление типа
//
Функция ТипВСтроку(Мета, Тип)
	
	ТипыСтрокой = "";         
	
	Для Каждого Элемент Из Тип.Типы() Цикл
		
		ТипСтрокой = Строка(Элемент);
		
		Если Элемент = Тип("Дата") Тогда
			ТипСтрокой = ТипСтрокой + " (" + Строка(Тип.КвалификаторыДаты.ЧастиДаты) + ")";
		ИначеЕсли Элемент = Тип("Число") Тогда
			ТипСтрокой = ТипСтрокой + " (" + Строка(Тип.КвалификаторыЧисла.Разрядность) + ", "
			+ Строка(Тип.КвалификаторыЧисла.РазрядностьДробнойЧасти)
			+ ?(Тип.КвалификаторыЧисла.ДопустимыйЗнак = ДопустимыйЗнак.Неотрицательный, ", +", "") + ")";
		ИначеЕсли Элемент = Тип("Строка") ИЛИ Элемент = Тип("ДвоичныеДанные") Тогда
			ТипСтрокой = ТипСтрокой + " (" + Строка(Тип.КвалификаторыСтроки.Длина) + ?(Тип.КвалификаторыСтроки.ДопустимаяДлина = ДопустимаяДлина.Фиксированная, ", фикс", "") + ")";
		ИначеЕсли НЕ (Элемент = Тип("Булево")
			ИЛИ Элемент = Тип("ХранилищеЗначения")) Тогда	
			ОбъектМета = Мета.НайтиПоТипу(Элемент);
			Если ОбъектМета = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если Мета.Справочники.Содержит(ОбъектМета) Тогда 
				ТипСтрокой = "Справочник." + ТипСтрокой;
			ИначеЕсли Мета.Документы.Содержит(ОбъектМета) Тогда
				ТипСтрокой = "Документ." + ТипСтрокой;
			ИначеЕсли Мета.Перечисления.Содержит(ОбъектМета) Тогда
				ТипСтрокой = "Перечисление." + ТипСтрокой;
			ИначеЕсли Мета.Константы.Содержит(ОбъектМета) Тогда
				ТипСтрокой = "Константа." + ТипСтрокой;
			КонецЕсли;
		КонецЕсли;
		
		//ТипыСтрокой = ТипыСтрокой + ?(ПустаяСтрока(ТипыСтрокой), "", "; ") + ТипСтрокой;  //твс это медленнее
		ТипыСтрокой = ТипыСтрокой + ?(ТипыСтрокой = "", "", "; ") + ТипСтрокой;
		
	КонецЦикла;
	
	Возврат ТипыСтрокой;
	
КонецФункции // ТипВСтроку()

// Настройки хранятся в ЭКОМ_ЗначениеДополнительныхКонстант
// Имя - имя настройки
// опрЗначение - значение по умолчанию
// Измерение - может хранится в разрезе (организаций, пользователей)
Функция Настройка_Параметр_Прочитать(Имя, ЗначениеПоУмолчанию = Неопределено, Измерение = Неопределено, Обязательно = Ложь) Экспорт		
	
	// На сервер нельзя передавать дерево значений возникает мутабельность
	МЗ = РегистрыСведений.ЭКОМ_ЗначениеДополнительныхКонстант.СоздатьМенеджерЗаписи();
	МЗ.ДополнительнаяКонстанта  = Имя;
	МЗ.Измерение                = Измерение;
	МЗ.Прочитать();
	
	Если МЗ.Выбран() Тогда
		
		Если ТипЗнч(МЗ.ЗначениеДополнительнойКонстанты) = Тип("Неопределено") Тогда
			ЗначениеИзХранилища = МЗ.ЗначениеДополнительногоХранилища.Получить();
			Если НЕ ЗначениеИзХранилища = "" Тогда			
				ЗначениеПоУмолчанию = ЗначениеИзХранилища;		
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(МЗ.ЗначениеДополнительнойКонстанты) Тогда	
			ЗначениеПоУмолчанию = МЗ.ЗначениеДополнительнойКонстанты;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Обязательно 
		И НЕ ЗначениеЗаполнено(ЗначениеПоУмолчанию) Тогда	
		МассивЛогаСобытий = Новый Массив;
		ТекстЛогаСобытий = "Значение не заполнено для настройки - <<< " + Имя + ">>>";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, "Чтение настроек из регистра");
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		Выполнить("ЭКОМ_ОбщегоНазначения.ЗаписатьЛогСобытийвРегистрЛогирование(МассивЛогаСобытий);");
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Возврат ЗначениеПоУмолчанию;
	
КонецФункции

// Процедура добавляет или изменяе запись в регистре сведений ЭКОМ_ЗначениеДополнительныхКонстант
//
// Параметры:
//  пИмя  				- Строка - значение реквизита ДополнительнаяКонстанта
//  пЗначение  			- ЛюбаяСсылка, Булево, Строка, Дата, Число; ХранилищеЗначения - значение реквизитов ЗначениеДополнительнойКонстанты
//		либо ЗначениеДополнительногоХранилища, если первый символ строки в параметре пИмя равен "_"
//  пИзмерение  		- ДокументСсылка, Строка, СправочникСсылка - значение реквизита Измерение
//  пНовоеИзмерение  	- ДокументСсылка, Строка, СправочникСсылка - значение реквизита Измерение для замены. Если оставить значение
//		по умолчанию - Неопределено - замены не произойдет
//
Функция Настройка_Параметр_Записать(пИмя, пЗначение, пИзмерение = Неопределено, пНовоеИзмерение = Неопределено) Экспорт
	
	МЗ = РегистрыСведений.ЭКОМ_ЗначениеДополнительныхКонстант.СоздатьМенеджерЗаписи();
	
	Если Лев(пИмя , 1) = "_" Тогда
		ПоместитьВХранилище = Истина;
	Иначе
		ПоместитьВХранилище = Ложь;
	КонецЕсли;
	
	МЗ.ДополнительнаяКонстанта  = ?(ПоместитьВХранилище, Сред(пИмя, 2), пИмя);
	МЗ.Измерение                = пИзмерение;
	МЗ.Прочитать();
	
	Если НЕ МЗ.Выбран() Тогда
		МЗ.ДополнительнаяКонстанта  = ?(ПоместитьВХранилище, Сред(пИмя, 2), пИмя);
		МЗ.Измерение                = ?(пНовоеИзмерение = Неопределено, пИзмерение, пНовоеИзмерение);
	ИначеЕсли НЕ пНовоеИзмерение 	= Неопределено Тогда
		МЗ.Измерение                = пНовоеИзмерение;
	КонецЕсли;
	
	Если ПоместитьВХранилище Тогда
		МЗ.ЗначениеДополнительногоХранилища = Новый ХранилищеЗначения(пЗначение);
		МЗ.ЗначениеДополнительнойКонстанты = Неопределено; // Очищаем данные
	Иначе
		МЗ.ЗначениеДополнительнойКонстанты 	= пЗначение;
	КонецЕсли;
	
	Результат = Истина;
	Попытка
		МЗ.Записать();
	Исключение
		Ошибка = ОписаниеОшибки();
		Результат = "Ошибка записи настройки в [РегистрСведений.ЭКОМ_ЗначениеДополнительныхКонстант]" + Символы.ПС + Ошибка;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Процедура НастройкиПараметровЗаписатьНабором(Данные, Измерение) Экспорт
	
	НаборЗаписей = РегистрыСведений.ЭКОМ_ЗначениеДополнительныхКонстант.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Измерение.Установить(Измерение);
	НаборЗаписей.Прочитать();
	
	Таблица = НаборЗаписей.Выгрузить();
	Для каждого СтрТаб Из Таблица Цикл
		Если ЗначениеЗаполнено(СтрТаб.ЗначениеДополнительнойКонстанты) Тогда
			Данные.Вставить(СтрТаб.ДополнительнаяКонстанта, СтрТаб.ЗначениеДополнительнойКонстанты);
		КонецЕсли;		
	КонецЦикла;
	
	НаборЗаписей.Очистить();
	
	Для каждого Стр Из Данные Цикл
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.ДополнительнаяКонстанта         = Стр.Ключ;
		НоваяЗапись.Измерение                       = Измерение;
		НоваяЗапись.ЗначениеДополнительнойКонстанты = Стр.Значение; 
	КонецЦикла;
	
	НаборЗаписей.Записать(); 
	
КонецПроцедуры

Функция ВерсияПлатформы() Экспорт
	
	// # Пример: 8.3.11.3034 - 83110 (версия по трем позициям) и до 4 знаков 
	// # Пример: 8.3.5.6565  - 8350 (версия по трем позициям) и до 4 знаков 	
	// # Пример: 8.2.19.4342 - 8219 (версия по трем позициям) и до 4 знаков 
	// # Пример: 8.3.10.4342 - 83100(версия по трем позициям) и до 4 знаков
	// # Пример: 8.3.9.4342  - 8390 (версия по трем позициям) и до 4 знаков
	// # Пример: 8.3.12.4342 - 83120(версия по трем позициям) и до 4 знаков
	// # Пример: 8.3.1.00    - 8310(версия по трем позициям) и до 4 знаков
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	ТекущаяВерсия = СистемнаяИнформация.ВерсияПриложения;
	
	Версия  = "";
	Для н = 1  По 3 Цикл
		ПозицияТочки  = Найти(ТекущаяВерсия, ".");
		Символ        = Лев(ТекущаяВерсия , ПозицияТочки - 1);
		ТекущаяВерсия = Сред(ТекущаяВерсия, ПозицияТочки + 1);
		Версия        = Версия + Символ;
	КонецЦикла;
	
	Если СтрДлина(Версия) < 4 
		ИЛИ (Сред(Версия, 2, 1) = "3" И СтрДлина(Версия) = 4) Тогда
		Версия = Версия + "0";	
	КонецЕсли;
	
	Попытка
		ВерсияЧисло = ЭКОМ_ПреобразоватьВЧисло(Версия);
	Исключение
		ВерсияЧисло  = 0;
	КонецПопытки;
	
	Возврат ВерсияЧисло;
	
КонецФункции

Функция ПолучитьУзелДерева(СтрокаДерева, ТипУзла, ИмяПоля)
	
	Если СтрокаДерева = Неопределено Тогда
		Возврат Неопределено;    
	КонецЕсли;
	
	Если ТипУзла = "Строка" Тогда
		xmlУзел = СтрокаДерева.Найти(ИмяПоля, "Элемент", Истина);
	ИначеЕсли ТипУзла = "Массив" Тогда
		xmlУзел = СтрокаДерева.НайтиСтроки(Новый Структура("Элемент", ИмяПоля), Ложь);
	Иначе
		xmlУзел = Неопределено;
	КонецЕсли;
	
	Возврат xmlУзел;
	
