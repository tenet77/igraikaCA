Функция ДатаИзXML_в_1С(Знач ДатаXML) Экспорт
	
	Если НЕ (ТипЗнч(ДатаXML) = Тип("Строка")
		ИЛИ ТипЗнч(ДатаXML) = Тип("Число")) Тогда	
		Возврат Дата(0001, 01, 1);
	КонецЕсли;
	
	ЦифровойРяд = "0123456789";
	
	Год 	= "0001";
	Месяц 	= "01";
	День 	= "01";
	Час		= "00";
	Минута	= "00";
	Секунда	= "00";
	
	Дата 	= СокрЛП(Лев (ДатаXML, 10));
	Время 	= СокрЛП(Прав(ДатаXML, СтрДлина(ДатаXML) - 10));
	
	Если 		Найти(ЦифровойРяд, Сред(Дата, 3, 1)) = 0 Тогда // Сред(Дата, 3, 1) - 
		// "28х03х2019", где х - любой символ разделителя
		Год 	= Прав(СокрЛП(Дата), 4);
		Месяц 	= Сред(СокрЛП(Дата), 4, 2);
		День  	= Лев (СокрЛП(Дата), 2);
	ИначеЕсли 	Найти(ЦифровойРяд, Сред(Дата, 5, 1)) = 0 Тогда
		// "2019х03х28", где х - любой символ разделителя
		Год   = Лев (СокрЛП(Дата), 4);
		Месяц = Сред(СокрЛП(Дата), 6, 2);
		День  = Прав(СокрЛП(Дата), 2);
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(Время) И СтрДлина(Время) = 8 Тогда
		// "10х05х30", где х - любой символ разделителя
		Час		= Лев (СокрЛП(Время), 2);
		Минута	= Сред(СокрЛП(Время), 4, 2);
		Секунда	= Прав(СокрЛП(Время), 2);
	КонецЕсли;
	
	Попытка
		Результат  	= Дата(Год + Месяц + День + Час + Минута + Секунда);
	Исключение
		Результат 	= Дата(0001, 01, 1);
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция м_ADO_Контрагенты_Точки_Доставки_Прочитать( пADO_Строка_Подключения, пТЗ_Данные ) Экспорт
	
	лСоединение = "";
	Если м_ADO_Подключить( пADO_Строка_Подключения, 5, 30, лСоединение ) <> 1 Тогда
		Сообщить( "Ошибка при подключении к ADO (111).", СтатусСообщения.Важное );
		Возврат 0;
	КонецЕсли;
	
	лТекст_Запроса = "
	|Select
	|	_Exite_Spr_Tochki_Dostavki._ID,
	|	_Exite_Spr_Tochki_Dostavki.Kontragent,
	|	_Exite_Spr_Tochki_Dostavki.Adres,
	|	_Exite_Spr_Tochki_Dostavki.GLN,
	|	_Exite_Spr_Tochki_Dostavki.KPP_GRUZOPOLUCHATEL,
	|	_Exite_Spr_Tochki_Dostavki.NAME_GRUZOPOLUCHATEL,
	|	_Exite_Spr_Tochki_Dostavki.GRUZOPOLUCHATEL
	|from
	|	_Exite_Spr_Tochki_Dostavki
	|";
	
	лРекордСет = Неопределено;
	Если м_ADO_Запрос_Выполнить( лСоединение, лТекст_Запроса, лРекордСет ) <> 1 Тогда
		Сообщить( "Ошибка при выполнении запроса при чтении точек доставки (112).", СтатусСообщения.Важное );
		Возврат 0;
	КонецЕсли;
	
	лТЗ_Данные = "";
	Если м_ADO_RS_ТЗ( лРекордСет, лТЗ_Данные ) <> 1 Тогда
		Сообщить( "Ошибка при заполнении ТЗ при чтении точек доставки (113).", СтатусСообщения.Важное );
		Возврат 0;
	КонецЕсли;
	
	Если лТЗ_Данные.Количество() = 0 Тогда
		пТЗ_Данные = лТЗ_Данные;
		Возврат 0;
	КонецЕсли;
	
	лТЗ_Структура_Соответствий = "";
	Если м_Структура_Соответствий_Получить( "Контрагенты_Точки_Доставки", лТЗ_Структура_Соответствий ) <> 1 Тогда
		Сообщить( "Ошибка при получении структуры соответствий при чтении точек доставки (114).", СтатусСообщения.Важное );
		Возврат 0;
	КонецЕсли;
	
	Если м_ADO_ТЗ_Данные_Значения_Реквизитов_1С_Присоединить( лТЗ_Данные, лТЗ_Структура_Соответствий ) <> 1 Тогда
		Сообщить( "Ошибка при присоединении данных 1С при чтении точек доставки (115).", СтатусСообщения.Важное );
		Возврат 0;
	КонецЕсли;
	
	
	пТЗ_Данные = лТЗ_Данные;
	
	Возврат 1;
КонецФункции

