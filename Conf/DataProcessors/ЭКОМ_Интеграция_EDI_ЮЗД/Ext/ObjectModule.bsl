// + Возвращает титул продавца в виде двоичных данных // Тест пройден
// Параметр: НомерДокумента - 36-символьный код
Функция ПолучитьСодержимоеДокумента(НомерДокумента, Тип, Ошибка, ПрофильОбмена, МассивЛогаСобытий) Экспорт
	
	///////////////////////////////
	//Реализация 	
	
	ИмяСобытия = "Получить содержимое документа";
	Ошибка = ПолучитьСтруктуруОшибки();
	
	ТокенАвторизации = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьТокенАвторизации(ПрофильОбмена, Ошибка, МассивЛогаСобытий)");
	Если Ошибка.ЕстьОшибка Тогда	
		ТекстЛогаСобытий = "При получении токена(авторизации) возникла ошибка - Код: " + Ошибка.КодОшибки + " - " + Ошибка.ТекстОшибки;
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		Возврат Неопределено;		
	КонецЕсли;
	
	ТекстКоманды = "/Api/V1/Edo/Content/GetDocWithSignContent";
	
	ДанныеЗапроса = Новый Структура;
	ДанныеЗапроса.Вставить("identifier", НомерДокумента);
	ДанныеЗапроса.Вставить("varToken", ТокенАвторизации);
	
	ЗаголовокHTTP = Новый Соответствие;
	ЗаголовокHTTP.Вставить("Content-type", "application/json");
	ЗаголовокHTTP.Вставить("Accept"      , "application/json");	
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("МетодHTTP"    , "POST");
	ПараметрыЗапроса.Вставить("ЗаголовокHTTP", ЗаголовокHTTP);
	
	Результат  = Вычислить("ЭКОМ_ОбщегоНазначения.ВыполнитьЗапрос(ТекстКоманды, ПрофильОбмена, ДанныеЗапроса, ПараметрыЗапроса, Ошибка, МассивЛогаСобытий)");
	
	Если Ошибка.ЕстьОшибка Тогда	
		ТекстЛогаСобытий = Тип + " - при получении содержимого документа возникла ошибка(1): " + Ошибка.КодОшибки + " - " + Ошибка.ТекстОшибки;
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		Возврат Неопределено;	
	КонецЕсли;
	
	Соответствие     = UnJSON(Результат.Текст);	
	ПодписьДокументаSign = Соответствие.Получить("sign");
	Если НЕ ПодписьДокументаSign = Неопределено Тогда
		ПодписьДокумента = ПодписьДокументаSign[0].Получить("body"); 	
		ПодписьДокумента = Base64Значение(ПодписьДокумента);
	КонецЕсли;
	
	ТелоДокумента   = Соответствие.Получить("body");
	Если НЕ ТелоДокумента = Неопределено Тогда
		ТелоДокумента = СтрЗаменить(ТелоДокумента,"\/","/"); 	
		ТелоДокумента = Base64Значение(ТелоДокумента);
	КонецЕсли;
	
	Если ТелоДокумента = Неопределено Тогда
		
		Ошибка.Вставить("ЕстьОшибка" , Истина); 
		Ошибка.Вставить("КодОшибки"  , "");
		Ошибка.Вставить("ТекстОшибки", Результат.Текст);
		
		ТекстЛогаСобытий = Тип + " - при получении содержимого документа возникла ошибка(2): " + Ошибка.ТекстОшибки;
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		Возврат Неопределено;
		
	КонецЕсли;
	
	Данные = Новый Структура;
	Данные.Вставить("ТелоДокумента"   , ТелоДокумента); // Двоичный Файл
	Данные.Вставить("ПодписьДокумента", ПодписьДокумента);
	
	///////////////////////////////
	
	Возврат Данные;  
	
КонецФункции

Функция ПоместитьЗначВХранилище(Данные) Экспорт
	
	Результат = Новый ХранилищеЗначения(Данные, Новый СжатиеДанных(9));
	
	Возврат Результат;
	
КонецФункции

// Универсальный метод отправки квитанций/титула
// Параметры: 
//	- СтруктураРезультатаПодписания - Структура, 
//			Ключи:
//				- Файл    - двоичные данные,
//				- Подпись - двоичные данные, 
//	- Ошибка - Стандартный параметр см. ПолучитьСтруктуруОшибки
//  - ИД_Документа
Процедура УниверсальныйМетодОтправкиКвитанций(ИД_Документа, Файл, Подпись, Ошибка, ПрофильОбмена) Экспорт 
	
	МассивЛогаСобытий = Новый Массив;
	ТокенАвторизации = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьТокенАвторизации(ПрофильОбмена, Ошибка, МассивЛогаСобытий)");	  
	Если Ошибка.ЕстьОшибка Тогда		
		Сообщить("При получении токена(авторизации) возникла ошибка - Код: " + Ошибка.КодОшибки + " - " + Ошибка.ТекстОшибки);
		Возврат;		
	КонецЕсли;
	
	ТекстКоманды = "/Api/V1/Edo/Ticket/Enqueue"; 
	
	ДокументТелоBase64 	= Base64Строка(Файл);
	ДокументТелоBase64 	= СтрЗаменить(ДокументТелоBase64, Символы.ПС, "");
	ДокументТелоBase64 	= СтрЗаменить(ДокументТелоBase64, Символы.ВК, "");
	
	ПодписьТелоBase64 	= Base64Строка(Подпись);
	ПодписьТелоBase64 	= СтрЗаменить(ПодписьТелоBase64, Символы.ПС, "");
	ПодписьТелоBase64 	= СтрЗаменить(ПодписьТелоBase64, Символы.ВК, "");
	
	ДанныеЗапроса 		= Новый Структура;
	ДанныеЗапроса.Вставить("identifier",		ИД_Документа);
	ДанныеЗапроса.Вставить("varToken", 			ТокенАвторизации);
	ДанныеЗапроса.Вставить("xml", 				ДокументТелоBase64);
	ДанныеЗапроса.Вставить("sign", 				ПодписьТелоBase64);
	
	ЗаголовокHTTP = Новый Соответствие;
	ЗаголовокHTTP.Вставить("Content-type", "application/json");
	ЗаголовокHTTP.Вставить("Accept"      , "application/json");	
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("МетодHTTP"    , "POST");
	ПараметрыЗапроса.Вставить("ЗаголовокHTTP", ЗаголовокHTTP);
	
	Результат = Вычислить("ЭКОМ_ОбщегоНазначения.ВыполнитьЗапрос(ТекстКоманды, ДанныеЗапроса, ПараметрыЗапроса, Ошибка, МассивЛогаСобытий)");
	
	Если Ошибка.ЕстьОшибка Тогда	
		Сообщить("При отправке квитанции возникла ошибка - Код: " + Ошибка.КодОшибки + " - " + Ошибка.ТекстОшибки);
		Возврат;	
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьДанныОФайле(ДвоичныеДанныеФайла) Экспорт
	
	МассивЛогаСобытий = Новый Массив;
	
	ДанныОФайле = Новый Структура;
	ДанныОФайле.Вставить("СтруктураФайла"     , "");
	ДанныОФайле.Вставить("ИмяФайла"           , "");
	ДанныОФайле.Вставить("ДвоичныеДанныеФайла", ДвоичныеДанныеФайла);
	
	СтрокаXML = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанныеФайла, КодировкаТекста.ANSI);
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(СтрокаXML);
	
	ОбъектXDTO = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	СтруктураДок = ПолучитьСтруктуруДокумента(ОбъектXDTO, МассивЛогаСобытий);			
	СтруктураДок.Вставить("ТекстовыйXML", СтрокаXML);
	
	ДанныОФайле.Вставить("СтруктураФайла", ПоместитьЗначВХранилище(СтруктураДок));
	ДанныОФайле.Вставить("ИмяФайла"      , СтруктураДок.ИдФайл);
	
	Возврат ДанныОФайле;
	
КонецФункции 

Функция ПоместитьВРегистр(СтруктураСтроки, Тип, ТипОбмена, СтруктураРезультат) Экспорт
	
	Если ТипОбмена = "Сеть" Тогда                                    
		Документ  = СтруктураСтроки.ЭКОМ_Документ;
	Иначе
		Документ  = СтруктураСтроки.ДокументСЧФ;
	КонецЕсли;
	
	ИдентификаторОснование = Прав(СтруктураСтроки.ПервичныйЮЗД, 36);
	ЕстьИнформация = Ложь;
	Если НЕ СтруктураРезультат = Неопределено 
		И СтруктураРезультат.Свойство("ИмяФайлаОтправки")
		И ЗначениеЗаполнено(СтруктураРезультат.ИмяФайлаОтправки) Тогда
		
		СтруктураСтроки[Тип] = СтруктураРезультат.ИмяФайлаОтправки;
		КлючСтатус = "Статус" + Тип;
		СтруктураСтроки.Вставить(КлючСтатус, "ОК");            
		
		ЕстьИнформация = Истина;
	КонецЕсли;		
	
	Если Тип = "DP_PDPOL_02" Тогда
		
		ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_PDPOL_02;
		НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Входящий;
		Статус = Перечисления.ЭКОМ_Статусы.Загружен;
		
	ИначеЕсли Тип = "DP_PDOTPR_03" Тогда
		
		ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_PDOTPR_03;
		НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Входящий;
		Статус = Перечисления.ЭКОМ_Статусы.Загружен;
		
	ИначеЕсли Тип = "DP_IZVPOL_04" Тогда
		
		ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_IZVPOL_04;
		НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Исходящий;
		Статус = Перечисления.ЭКОМ_Статусы.Отправлен;
		
	ИначеЕсли Тип = "DP_IZVPOL_05" Тогда
		
		ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_IZVPOL_05;
		НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Исходящий;
		Статус = Перечисления.ЭКОМ_Статусы.Отправлен;
		
	ИначеЕсли Тип = "DP_IZVPOL_06" И ТипОбмена = "Сеть" Тогда
		
		ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_IZVPOL_06;
		НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Исходящий;
		Статус = Перечисления.ЭКОМ_Статусы.Отправлен;
		
	ИначеЕсли Тип = "DP_IZVPOL_06" Тогда
		
		ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_IZVPOL_06;
		НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Входящий;
		Статус = Перечисления.ЭКОМ_Статусы.Загружен;
		
	ИначеЕсли Тип = "DP_PDOTPR_07" Тогда
		
		ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_PDOTPR_07;
		НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Входящий;
		Статус = Перечисления.ЭКОМ_Статусы.Загружен;
		
	ИначеЕсли Тип = "DP_IZVPOL_08" Тогда
		
		ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_IZVPOL_08;
		НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Исходящий;
		Статус = Перечисления.ЭКОМ_Статусы.Отправлен;
		
	ИначеЕсли Тип = "DP_UVUTOCH_09" И ТипОбмена = "Сеть" Тогда
		
		ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_UVUTOCH_09;
		НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Исходящий;
		Статус = Перечисления.ЭКОМ_Статусы.Отправлен;
		
	ИначеЕсли Тип = "DP_UVUTOCH_09" Тогда
		
		ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_UVUTOCH_09;
		НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Входящий;
		Статус = Перечисления.ЭКОМ_Статусы.Загружен;
		
	ИначеЕсли Тип = "DP_IZVPOL_10" И ТипОбмена = "Сеть" Тогда
		
		ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_IZVPOL_10;
		НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Входящий;
		Статус = Перечисления.ЭКОМ_Статусы.Загружен;
		
	ИначеЕсли Тип = "DP_IZVPOL_10" Тогда
		
		ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_IZVPOL_10;
		НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Исходящий;
		Статус = Перечисления.ЭКОМ_Статусы.Отправлен;
		
	ИначеЕсли Тип = "Подпись" И ТипОбмена = "Сеть" Тогда
		
		Если СтруктураСтроки.ЭКОМ_Документ.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_SCHFDOPPR_01 
			ИЛИ СтруктураСтроки.ЭКОМ_Документ.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_SCHFDOPPR_01_Испр Тогда
			
			ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_SCHFDOPPOK_11;
			НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Исходящий;
			Статус = Перечисления.ЭКОМ_Статусы.Отправлен;
			
		ИначеЕсли СтруктураСтроки.ЭКОМ_Документ.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_KORSCHFDOPPR_01
			ИЛИ СтруктураСтроки.ЭКОМ_Документ.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_KORSCHFDOPPR_01_Испр Тогда
			
			ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_KORSCHFDOPPOK_11;
			НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Исходящий;
			Статус = Перечисления.ЭКОМ_Статусы.Отправлен;	
			
		ИначеЕсли СтруктураСтроки.ЭКОМ_Документ.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPR_01
			ИЛИ СтруктураСтроки.ЭКОМ_Документ.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPR_01_Испр Тогда
			
			ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPOK_11;
			НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Исходящий;
			Статус = Перечисления.ЭКОМ_Статусы.Отправлен;
			
		КонецЕсли;
		
	ИначеЕсли Тип = "Подпись" Тогда
		
		Если Найти(СтруктураСтроки.Подпись, "ON_SCHFDOPPOK_") = 1 Тогда
			
			ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_SCHFDOPPOK_11;
			НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Входящий;
			Статус = Перечисления.ЭКОМ_Статусы.Загружен;
			
		ИначеЕсли Найти(СтруктураСтроки.Подпись, "ON_KORSCHFDOPPOK_") = 1 Тогда
			
			ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_KORSCHFDOPPOK_11;
			НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Входящий;
			Статус = Перечисления.ЭКОМ_Статусы.Загружен;	
			
		ИначеЕсли Найти(СтруктураСтроки.Подпись, "ON_NSCHFDOPPOK_") = 1 Тогда
			
			ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPOK_11;
			НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Входящий;
			Статус = Перечисления.ЭКОМ_Статусы.Загружен;
			
		ИначеЕсли Найти(СтруктураСтроки.Подпись, "ON_NSCHFDOPPOKMARK_") = 1 Тогда
			
			ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPOKMARK_11;
			НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Входящий;
			Статус = Перечисления.ЭКОМ_Статусы.Загружен;
			
		КонецЕсли;
		
	Иначе
		
		Возврат ЕстьИнформация; 
		
	КонецЕсли;
	
	Если ЕстьИнформация = Истина Тогда
		МЗ = РегистрыСведений.ЭКОМ_Объекты_События.СоздатьМенеджерЗаписи();
		МЗ.Документ_Основание  = Документ;
		МЗ.ВидДокумента        = ВидДокумента;
		МЗ.Прочитать();
		
		Если НЕ МЗ.Выбран() Тогда
			МЗ.Документ_Основание  = Документ;
			МЗ.ВидДокумента = ВидДокумента;
			МЗ.ДатаЗаписи = ТекущаяДата();	
		КонецЕсли;
		
		МЗ.Идентификатор     = СтруктураРезультат.ИмяФайлаОтправки;
		МЗ.ИдентификаторИспр = ИдентификаторОснование;
		МЗ.Контрагент        = Документ.Контрагент;
		МЗ.Организация       = Документ.Организация;	
		МЗ.НаправлениеОбмена = НаправлениеОбмена;
		МЗ.Статус            = Статус;
		МЗ.ФайлИмя           = СтруктураРезультат.ИмяФайлаОтправки + ".xml";
		МЗ.ЭЦП               = СтруктураРезультат.ЭЦП;
		МЗ.СтруктураФайла    = СтруктураРезультат.СтруктураФайла;
		
		МЗ.Записать();
	КонецЕсли;
	
	Возврат ЕстьИнформация;
	
КонецФункции

// Возвращает стандартную форму ответа запроса подписания квитанции или документа
Процедура ЗаписатьВРегистрПослеОтправки(СтруктураСтроки, Тип, ДанныОФайле, Подпись = Неопределено) Экспорт
	
	ЕстьИнформация = Ложь;
	// ДанныОФайле - Структура, файл для которого сформирована подпись
	// Подпись - Двоичные данные, непосредственно подпись
	
	Если ЗначениеЗаполнено(ДанныОФайле.ИмяФайла) Тогда	
		ЕстьИнформация = Истина;
	КонецЕсли;
	
	СтруктураСтроки.Вставить(Тип, ДанныОФайле.ИмяФайла);
	
	СтруктураРезультат = Новый Структура;
	СтруктураРезультат.Вставить("ИмяФайлаОтправки", ДанныОФайле.ИмяФайла);
	СтруктураРезультат.Вставить("ЭЦП"             , ПоместитьЗначВХранилище(Подпись));
	СтруктураРезультат.Вставить("СтруктураФайла"  , ДанныОФайле.СтруктураФайла);
	
	ДокументОснование = Неопределено;
	Если Тип = "DP_IZVPOL_04" Тогда
		
		ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_IZVPOL_04;
		НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Исходящий;
		Статус = Перечисления.ЭКОМ_Статусы.Отправлен;
		ДокументОснование = СтруктураСтроки.ДокументСЧФ;
		
	ИначеЕсли Тип = "DP_IZVPOL_05" Тогда
		
		ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_IZVPOL_05;
		НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Исходящий;
		Статус = Перечисления.ЭКОМ_Статусы.Отправлен;
		ДокументОснование = СтруктураСтроки.ЭКОМ_Документ;
		
	ИначеЕсли Тип = "DP_IZVPOL_06" Тогда
		
		ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_IZVPOL_06;
		НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Исходящий;
		Статус = Перечисления.ЭКОМ_Статусы.Отправлен;
		ДокументОснование = СтруктураСтроки.ЭКОМ_Документ;
		
	ИначеЕсли Тип = "DP_IZVPOL_08" Тогда
		
		ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_IZVPOL_08;
		НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Исходящий;
		Статус = Перечисления.ЭКОМ_Статусы.Отправлен;
		ДокументОснование = СтруктураСтроки.ЭКОМ_Документ;
		
	ИначеЕсли Тип = "Подпись" Тогда
		
		Если СтруктураСтроки.ЭКОМ_Документ.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPR_01 
			ИЛИ СтруктураСтроки.ЭКОМ_Документ.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPR_01_Испр Тогда
			
			ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPOK_11;
			НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Исходящий;
			Статус = Перечисления.ЭКОМ_Статусы.Отправлен;
			
		ИначеЕсли СтруктураСтроки.ЭКОМ_Документ.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NKORSCHFDOPPR_01
			ИЛИ СтруктураСтроки.ЭКОМ_Документ.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NKORSCHFDOPPR_01_Испр Тогда
			
			ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NKORSCHFDOPPOK_11;
			НаправлениеОбмена = Перечисления.ЭКОМ_НаправлениеОбмена.Исходящий;
			Статус = Перечисления.ЭКОМ_Статусы.Отправлен;
			
		КонецЕсли;
		
		ДокументОснование = СтруктураСтроки.ЭКОМ_Документ;
		
	Иначе
		
		Возврат; 
		
	КонецЕсли;
	
	Если ЕстьИнформация Тогда
		МЗ = РегистрыСведений.ЭКОМ_Объекты_События.СоздатьМенеджерЗаписи();
		МЗ.Документ_Основание  = ДокументОснование;
		МЗ.ВидДокумента        = ВидДокумента;
		МЗ.Прочитать();
		
		Если НЕ МЗ.Выбран() Тогда
			МЗ.Документ_Основание  = ДокументОснование;
			МЗ.ВидДокумента = ВидДокумента;
			МЗ.ДатаЗаписи = ТекущаяДата();	
		КонецЕсли;
		
		МЗ.Идентификатор     = СтруктураРезультат.ИмяФайлаОтправки;
		МЗ.ИдентификаторИспр = СтруктураСтроки.ПервичныйЮЗД;
		МЗ.Контрагент        = ДокументОснование.Контрагент;
		МЗ.Организация       = ДокументОснование.Организация;	
		МЗ.НаправлениеОбмена = НаправлениеОбмена;
		МЗ.Статус            = Статус;
		МЗ.ФайлИмя           = СтруктураРезультат.ИмяФайлаОтправки + ".xml";
		МЗ.ЭЦП               = СтруктураРезультат.ЭЦП;
		МЗ.СтруктураФайла    = СтруктураРезультат.СтруктураФайла;
		
		МЗ.Записать();
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьФайлПодписи(СтруктураEDI, НеобходимаПодпись, ВременныйКаталог)
	
	ФайлBIN = Неопределено;
	НеобходимаПодпись = Ложь;
	Если СтруктураEDI.Свойство("ИмяФайлаBIN") Тогда
		НеобходимаПодпись = Истина;
		ПолноеИмяФайлаBIN = ВременныйКаталог + СтруктураEDI.ИмяФайлаBIN;
		
		// Файл подписи необходимо закодировать в Base64
		ФайлПодписи = Новый ЗаписьТекста(ПолноеИмяФайлаBIN, КодировкаТекста.ANSI);		
		ФайлПодписи.Записать(СтрЗаменить(Base64Строка(СтруктураEDI.ДвоичныеДанныеФайлаBIN),Символы.ВК + Символы.ПС,"")); //MOD-2544 [При подписи через Kalkan появляются переносы строк]		
		ФайлПодписи.Закрыть();
		
		ФайлBIN = Новый Файл(ПолноеИмяФайлаBIN);
		Если НЕ ФайлBIN.Существует() Тогда
			ФайлBIN = Неопределено;
		КонецЕсли;
		СтруктураEDI.Вставить("ПолноеИмяФайлаBIN", ПолноеИмяФайлаBIN);
	КонецЕсли;
	
	Возврат ФайлBIN;
	
КонецФункции 

Функция ПолучитьФайлДокумента(СтруктураEDI, ВременныйКаталог)
	
	ПолноеИмяФайлаXML = ВременныйКаталог + СтруктураEDI.ИмяФайлаXML;
	Текст = Новый ТекстовыйДокумент; 
	Текст.УстановитьТекст(СтруктураEDI.СтрокаXML); 
	Текст.Записать(ПолноеИмяФайлаXML, СтруктураEDI.КодировкаФайла); 
	
	ФайлXML = Новый Файл(ПолноеИмяФайлаXML);
	Если НЕ ФайлXML.Существует() Тогда
		ФайлXML = Неопределено;
	КонецЕсли;
	СтруктураEDI.Вставить("ПолноеИмяФайлаXML", ПолноеИмяФайлаXML);
	
	Возврат ФайлXML;			
	
КонецФункции

// Запись в регистр с набором и блокировкой
Процедура ЗаписьВРегистр(ИмяРегистра, ПараметрыОтбора, ПараметрыЗаписи) Экспорт
	
	НачатьТранзакцию();
	Попытка
		
		НаборЗаписей = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
		Для каждого СтрОтбора Из ПараметрыОтбора Цикл
			Если ЗначениеЗаполнено(СтрОтбора.Значение) Тогда
				НаборЗаписей.Отбор[СтрОтбора.Ключ].Установить(СтрОтбора.Значение);
			КонецЕсли;
			
		КонецЦикла;	
		
		//Выполним блокировку данных
		Выполнить("ЭКОМ_ПодпискаСобытий.ВыполнитьБлокировкуНабораЗаписей(НаборЗаписей.Отбор, """+ ИмяРегистра +""")");
		
		НаборЗаписей.Прочитать();
		
		/// Если существует документ в регистре
		Для Каждого НоваяЗапись Из НаборЗаписей Цикл
			Для каждого СтрЗаписи Из ПараметрыЗаписи Цикл
				НоваяЗапись[СтрЗаписи.Ключ] = СтрЗаписи.Значение;
			КонецЦикла;
		КонецЦикла;	
		
		// Записываем документ в первый раз
		Если НаборЗаписей.Количество() = 0 Тогда
			НоваяЗапись = НаборЗаписей.Добавить();			
			Для каждого СтрОтбора Из ПараметрыОтбора Цикл
				НоваяЗапись[СтрОтбора.Ключ] = СтрОтбора.Значение;
			КонецЦикла;
			Для каждого СтрЗаписи Из ПараметрыЗаписи Цикл
				НоваяЗапись[СтрЗаписи.Ключ] = СтрЗаписи.Значение;
			КонецЦикла;			
		КонецЕсли;
		
		НаборЗаписей.Записать();	
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();		
	КонецПопытки;
	
КонецПроцедуры

// Возвращает стандартную структуру сообщения об ошибке
Функция ПолучитьСтруктуруЛога()
	Структура = Новый Структура;
	// Флаг ставиться в значение "Истина" если в ходе выполнения операции произошла ошибка. 
	//Если после выполнения команды в флаг сброшен, операция считается успешно выполненой
	Структура.Вставить("ЕстьОшибка" , Ложь); 
	Структура.Вставить("ТекстОшибки", "");
	Возврат Структура;
КонецФункции

// Сравнивает 2 таблицы значений
Функция СравнитьТаблицыЗначений(ТаблицаЗначенийБыло, ТаблицаЗначенийСтало, ИзмененныеРеквизиты) Экспорт
	
	Если ТипЗнч(ТаблицаЗначенийБыло) <> Тип("ТаблицаЗначений") ИЛИ ТипЗнч(ТаблицаЗначенийСтало) <> Тип("ТаблицаЗначений") Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	Если ТаблицаЗначенийБыло.Количество() <> ТаблицаЗначенийСтало.Количество() Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	Если ТаблицаЗначенийБыло.Колонки.Количество() <> ТаблицаЗначенийСтало.Колонки.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Проверим поля на наличие
	Для каждого Колонка Из ТаблицаЗначенийБыло.Колонки Цикл
		КолонкаСтало = ТаблицаЗначенийСтало.Колонки.Найти(Колонка.Имя);
		Если КолонкаСтало = Неопределено Тогда
			ИзмененныеРеквизиты = ИзмененныеРеквизиты + ?(ИзмененныеРеквизиты = "", "", ", ") + "Изменились колонки(удалены) - " + Колонка.Имя;
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла; 
	Для каждого Колонка Из ТаблицаЗначенийСтало.Колонки Цикл
		КолонкаБыло = ТаблицаЗначенийБыло.Колонки.Найти(Колонка.Имя);
		Если КолонкаБыло = Неопределено Тогда
			ИзмененныеРеквизиты = ИзмененныеРеквизиты + ?(ИзмененныеРеквизиты = "", "", ", ") + "Изменились колонки(добавили) - " + Колонка.Имя;
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла; 
	
	// сформируем строку индекса для оптимизации поиска по таблице значений
	СтрокаИндекса = "";
	Для каждого Колонка Из ТаблицаЗначенийБыло.Колонки Цикл
		Если СтрокаИндекса = "" Тогда
			СтрокаИндекса = Колонка.Имя;
		Иначе
			СтрокаИндекса = СтрокаИндекса+","+Колонка.Имя;
		КонецЕсли;
	КонецЦикла;
	// добавим индекс
	ТаблицаЗначенийСтало.Индексы.Добавить(СтрокаИндекса);
	
	// Проверим записи
	Для каждого СтрокаТаблицы Из ТаблицаЗначенийБыло Цикл
		СтруктураПоиска = Новый Структура;
		Для каждого Колонка Из ТаблицаЗначенийБыло.Колонки Цикл
			СтруктураПоиска.Вставить(Колонка.Имя, СтрокаТаблицы[Колонка.Имя]);
		КонецЦикла;
		СтрокиТаблицы2 = ТаблицаЗначенийСтало.НайтиСтроки(СтруктураПоиска);
		Если СтрокиТаблицы2.Количество() <> 1 Тогда
			ИзмененныеРеквизиты = ИзмененныеРеквизиты + ?(ИзмененныеРеквизиты = "", "", ", ") + "Изменились строки(удалены) - " + СтрокаТаблицы[Колонка.Имя];
			Возврат Ложь;
		КонецЕсли;
		
		// Проверяем сортировку
		СтрокаИндексБыло  = ТаблицаЗначенийБыло.Индекс(СтрокаТаблицы);
		СтрокаИндексСтало = ТаблицаЗначенийСтало.Индекс(СтрокиТаблицы2[0]);
		Если НЕ СтрокаИндексБыло = СтрокаИндексСтало Тогда
			ИзмененныеРеквизиты = ИзмененныеРеквизиты + ?(ИзмененныеРеквизиты = "", "", ", ") + "Изменилась сортировка";
			Возврат Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	// сформируем строку индекса для оптимизации поиска по таблице значений
	СтрокаИндекса = "";
	Для каждого Колонка Из ТаблицаЗначенийСтало.Колонки Цикл
		Если СтрокаИндекса = "" Тогда
			СтрокаИндекса = Колонка.Имя;
		Иначе
			СтрокаИндекса = СтрокаИндекса+","+Колонка.Имя;
		КонецЕсли;
	КонецЦикла;
	// добавим индекс
	ТаблицаЗначенийБыло.Индексы.Добавить(СтрокаИндекса);
	
	Для каждого СтрокаТаблицы Из ТаблицаЗначенийСтало Цикл
		СтруктураПоиска = Новый Структура;
		Для каждого Колонка Из ТаблицаЗначенийСтало.Колонки Цикл
			СтруктураПоиска.Вставить(Колонка.Имя, СтрокаТаблицы[Колонка.Имя]);
		КонецЦикла;
		СтрокиТаблицы1 = ТаблицаЗначенийБыло.НайтиСтроки(СтруктураПоиска);
		Если СтрокиТаблицы1.Количество() <> 1 Тогда
			ИзмененныеРеквизиты = ИзмененныеРеквизиты + ?(ИзмененныеРеквизиты = "", "", ", ") + "Изменились строки(добавлены) - " + СтрокаТаблицы[Колонка.Имя];
			Возврат Ложь;
		КонецЕсли;
		
		// Проверяем сортировку
		СтрокаИндексСтало = ТаблицаЗначенийСтало.Индекс(СтрокаТаблицы);
		СтрокаИндексБыло  = ТаблицаЗначенийБыло.Индекс(СтрокиТаблицы1[0]);
		Если НЕ СтрокаИндексБыло = СтрокаИндексСтало Тогда
			ИзмененныеРеквизиты = ИзмененныеРеквизиты + ?(ИзмененныеРеквизиты = "", "", ", ") + "Изменилась сортировка";
			Возврат Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Процедура ДобавитьПрофилиОбменаДляСовместимости() Экспорт
	
	ЗначениеПоУмолчанию = Неопределено;
	Измерение           = Неопределено; 
	Обязательно         = Ложь;
	ЭКОМ_ИмяПользователяFTP = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_ИмяПользователяFTP"", ЗначениеПоУмолчанию, Измерение, Обязательно)");
	Если НЕ ЭКОМ_ИмяПользователяFTP = Неопределено Тогда
		Запрос = Новый Запрос;
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ЭКОМ_GLN.Объект КАК Организация
		|ИЗ
		|	РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN
		|ГДЕ
		|	НЕ ЭКОМ_GLN.Объект ССЫЛКА Справочник.Контрагенты
		|
		|УПОРЯДОЧИТЬ ПО
		|	Организация";
		
		Запрос.Текст = ТекстЗапроса;
		РезультатЗапроса = Запрос.Выполнить();			
		Если НЕ РезультатЗапроса.Пустой() Тогда
			
			ЭКОМ_ИмяПользователяFTP                        = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_ИмяПользователяFTP"")");
			ЭКОМ_ПарольПользователяFTP                     = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_ПарольПользователяFTP"")");
			ЭКОМ_Порт                                      = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_Порт"", 21)");
			ЭКОМ_СерверОбмена		                       = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_СерверОбмена"", ""ftpex.e-vo.ru"")");
			ЭКОМ_ИспользоватьАПИ                           = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_ИспользоватьАПИ"")");
			ЭКОМ_ПутьНаСервереИсходящий                    = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_ПутьНаСервереИсходящий"", ""/outbox/"")");
			ЭКОМ_ПутьНаСервере                             = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_ПутьНаСервере"", ""/inbox/"")");
			ЭКОМ_ПарольПользователяПортал                  = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_ПарольПользователяПортал"")");
			ЭКОМ_СерверОбменаAPI                           = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_СерверОбменаAPI"", ""api-service.e-vo.ru"")");
			ЭКОМ_СерверОбмена_ЭТРН                         = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_СерверОбмена_ЭТРН"", ""89.208.197.1"")");
			ЭКОМ_ИмяПользователяFTP_ЭТРН                   = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_ИмяПользователяFTP_ЭТРН"")");
			ЭКОМ_ПарольПользователяFTP_ЭТРН                = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_ПарольПользователяFTP_ЭТРН"")");
			ЭКОМ_ИспользоватьАПИ_ЭТРН                      = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_ИспользоватьАПИ_ЭТРН"")");
			ЭКОМ_Использовать_Локальный_FTP_Клиент         = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_Использовать_Локальный_FTP_Клиент"")");
			ЭКОМ_ОставитьДокументыНаПлатформеПослеЗагрузки = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_ОставитьДокументыНаПлатформеПослеЗагрузки"")");
			
			НовыйПрофильОбмена = Справочники.ЭКОМ_ПрофилиОбмена.НайтиПоНаименованию(ЭКОМ_ИмяПользователяFTP, Истина);
			Если НЕ ЗначениеЗаполнено(НовыйПрофильОбмена) Тогда
				НовыйПрофильОбмена = Справочники.ЭКОМ_ПрофилиОбмена.СоздатьЭлемент();
				НовыйПрофильОбмена.Наименование                          = ЭКОМ_ИмяПользователяFTP;
				НовыйПрофильОбмена.СерверFTP                             = ЭКОМ_СерверОбмена;
				НовыйПрофильОбмена.ИмяПользователяFTP                    = ЭКОМ_ИмяПользователяFTP;
				НовыйПрофильОбмена.ПарольПользователяFTP                 = ЭКОМ_ПарольПользователяFTP;
				НовыйПрофильОбмена.ВходящийПутьFTP                       = ЭКОМ_ПутьНаСервере;
				НовыйПрофильОбмена.ИсходящийПутьFTP                      = ЭКОМ_ПутьНаСервереИсходящий;
				НовыйПрофильОбмена.ОбменПоSOAP                           = ЭКОМ_ИспользоватьАПИ;
				НовыйПрофильОбмена.Порт                                  = ЭКОМ_Порт;
				НовыйПрофильОбмена.СерверAPI                             = ЭКОМ_СерверОбменаAPI;
				НовыйПрофильОбмена.ПарольПользователяAPI                 = ЭКОМ_ПарольПользователяПортал;
				НовыйПрофильОбмена.ПроверятьФайлыЛокально                = ЭКОМ_Использовать_Локальный_FTP_Клиент;
				НовыйПрофильОбмена.ОставитьФайлыНаПлатформеПослеЗагрузки = ЭКОМ_ОставитьДокументыНаПлатформеПослеЗагрузки;
				НовыйПрофильОбмена.ЭТРН_Сервер                           = ЭКОМ_СерверОбмена_ЭТРН;
				НовыйПрофильОбмена.ЭТРН_ИмяПользователя                  = ЭКОМ_ИмяПользователяFTP_ЭТРН;
				НовыйПрофильОбмена.ЭТРН_ПарольПользователя               = ЭКОМ_ПарольПользователяFTP_ЭТРН;
				НовыйПрофильОбмена.ЭТРН_ОбменПоSOAP                      = ЭКОМ_ИспользоватьАПИ_ЭТРН;
				НовыйПрофильОбмена.Страна                                = "ru";
				НовыйПрофильОбмена.Записать();				
			Иначе
				ОбъектПрофильОбмена = НовыйПрофильОбмена.Ссылка.ПолучитьОбъект();
				ОбъектПрофильОбмена.ПометкаУдаления = Ложь;
				ОбъектПрофильОбмена.Записать();
			КонецЕсли;
			
			Выборка = РезультатЗапроса.Выбрать();
			Пока Выборка.Следующий() Цикл
				МенеджеЗаписи = РегистрыСведений.ЭКОМ_GLN.СоздатьМенеджерЗаписи();
				МенеджеЗаписи.Объект = Выборка.Организация;
				МенеджеЗаписи.Прочитать();
				
				МенеджеЗаписи.ПрофильОбмена = НовыйПрофильОбмена.Ссылка;
				МенеджеЗаписи.Записать();
			КонецЦикла;
			
			НастройкиДляУдаления = Новый Массив;
			НастройкиДляУдаления.Добавить("ЭКОМ_ИмяПользователяFTP");
			НастройкиДляУдаления.Добавить("ЭКОМ_ПарольПользователяFTP");
			НастройкиДляУдаления.Добавить("ЭКОМ_Порт");
			НастройкиДляУдаления.Добавить("ЭКОМ_СерверОбмена");
			НастройкиДляУдаления.Добавить("ЭКОМ_ИспользоватьАПИ");
			НастройкиДляУдаления.Добавить("ЭКОМ_ПутьНаСервереИсходящий");
			НастройкиДляУдаления.Добавить("ЭКОМ_ПутьНаСервере");
			НастройкиДляУдаления.Добавить("ЭКОМ_ПарольПользователяПортал");
			НастройкиДляУдаления.Добавить("ЭКОМ_СерверОбменаAPI");
			НастройкиДляУдаления.Добавить("ЭКОМ_СерверОбмена_ЭТРН");
			НастройкиДляУдаления.Добавить("ЭКОМ_ИмяПользователяFTP_ЭТРН");
			НастройкиДляУдаления.Добавить("ЭКОМ_ПарольПользователяFTP_ЭТРН");
			НастройкиДляУдаления.Добавить("ЭКОМ_ИспользоватьАПИ_ЭТРН");
			НастройкиДляУдаления.Добавить("ЭКОМ_Использовать_Локальный_FTP_Клиент");
			НастройкиДляУдаления.Добавить("ЭКОМ_ОставитьДокументыНаПлатформеПослеЗагрузки");
			
			Для каждого ИмяНастройки Из НастройкиДляУдаления Цикл
				МенеджеЗаписиНастроек = РегистрыСведений.ЭКОМ_ЗначениеДополнительныхКонстант.СоздатьМенеджерЗаписи();
				МенеджеЗаписиНастроек.ДополнительнаяКонстанта = ИмяНастройки;
				МенеджеЗаписиНастроек.Измерение = Неопределено;
				МенеджеЗаписиНастроек.Удалить();
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Выбираем профиль по организации или первый рабочий профиль обмена, там где не важна организация
Функция ОсновнойПрофильОбмена(Организация, МассивЛогаСобытий) Экспорт
	
	ИмяСобытия    = "Получаем основной профиль обмен";
	ПрофильОбмена = Неопределено;
	
	// Определяем учетную запись организации 
	ЗапросПрофильОбмена = Новый Запрос;
	ЗапросПрофильОбмена.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЭКОМ_GLN.Объект,
	|	ЭКОМ_GLN.ПрофильОбмена
	|ИЗ
	|	РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN
	|ГДЕ
	|	НЕ ЭКОМ_GLN.ПрофильОбмена = ЗНАЧЕНИЕ(Справочник.ЭКОМ_ПрофилиОбмена.ПустаяСсылка)
	|	И НЕ ЭКОМ_GLN.ПрофильОбмена.ПометкаУдаления И ЭКОМ_GLN.ПрофильОбмена.Активный = ИСТИНА
	|	И ЭКОМ_GLN.Объект = &Организация";
	
	// Выбираем по организации
	Если ЗначениеЗаполнено(Организация) Тогда	
		ЗапросПрофильОбмена.УстановитьПараметр("Организация", Организация);	
		
		// Выбираем первый рабочий профиль обмена	
	Иначе
		ЗапросПрофильОбмена.Текст = СтрЗаменить(ЗапросПрофильОбмена.Текст, "И ЭКОМ_GLN.Объект = &Организация", "");
	КонецЕсли;
	
	РезультатЗапросаПрофильОбмена = ЗапросПрофильОбмена.Выполнить();
	Если РезультатЗапросаПрофильОбмена.Пустой() Тогда
		ТекстЛогаСобытий = "Выберите в настройках профиль обмена по организации.";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		Возврат Неопределено;	
	Иначе
		ВыборкаПрофильОбмена = РезультатЗапросаПрофильОбмена.Выбрать();
		ВыборкаПрофильОбмена.Следующий();
		ПрофильОбмена = ВыборкаПрофильОбмена.ПрофильОбмена;
	КонецЕсли;
	
	Возврат ПрофильОбмена;
	
КонецФункции 

// РАБОТА С CONDRA

// Создает записи исходящих Condra в РС ЭКОМ_ЦепочкиНеструктурированныхДокументов + РС ЭКОМ_НеструктурированныеДокументы.
//
// Параметры:
//  Данные  - ТаблицаЗначений - таблица с входящими данными для создания записей
//	НомерДатаПоУмолчанию - Булево - признак установки номера последовательно, даты в значение текущей даты
//
Процедура СоздатьЗаписи_ЭКОМ_ЦепочкиНеструктурированныхДокументов(Данные, НомерДатаПоУмолчанию) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Данные.Путь,
	|	Данные.Адрес,
	|	Данные.Записан,
	|	Данные.Номер,
	|	Данные.Дата,
	|	Данные.Контрагент,
	|	Данные.Организация,
	|	Данные.ТипДокумента,
	|	Данные.Описание,
	|	Данные.Сумма,
	|	Данные.НомерДоговора,
	|	Данные.СрокПодписания,
	|	Данные.ДатаДоговора
	|ПОМЕСТИТЬ вт
	|ИЗ
	|	&Данные КАК Данные
	|ГДЕ
	|	Данные.Записан = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вт.Путь КАК FILENAME,
	|	вт.Номер КАК NUMBER,
	|	вт.Дата КАК DATE,
	|	вт.Адрес КАК Адрес,
	|	ЭКОМ_GLN_Контрагент.GLN КАК xmlКонтрагент,
	|	ЭКОМ_GLN_Контрагент.Ид_ОЭД КАК xmlКонтрагентGUID,
	|	ЭКОМ_GLN_Организация.GLN КАК xmlОрганизация,
	|	ЭКОМ_GLN_Организация.Ид_ОЭД КАК xmlОрганизацияGUID,
	|	вт.ТипДокумента,
	|	вт.Описание КАК INFO,
	|	вт.Сумма,
	|	вт.НомерДоговора КАК CONTRACTNUMBER,
	|	вт.ДатаДоговора,
	|	вт.Контрагент,
	|   вт.СрокПодписания,
	|	вт.Организация,
	|	вт.Записан,
	|	ЗНАЧЕНИЕ(Перечисление.ЭКОМ_НаправлениеОбмена.Исходящий) КАК НаправлениеОбмена,
	|	ЗНАЧЕНИЕ(Перечисление.ЭКОМ_СтатусыCONDRA.Добавлен) КАК Статус,
	|	ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ТребуемоеДействиеCONDRA.Создан) КАК Действие,
	|	ЭКОМ_ТипыНеструктДокументов.Идентификатор КАК DOCTYPE
	|ИЗ
	|	вт КАК вт
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Контрагент
	|		ПО вт.Контрагент = ЭКОМ_GLN_Контрагент.Объект
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Организация
	|		ПО вт.Организация = ЭКОМ_GLN_Организация.Объект
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭКОМ_ТипыНеструктДокументов КАК ЭКОМ_ТипыНеструктДокументов
	|		ПО вт.ТипДокумента = ЭКОМ_ТипыНеструктДокументов.Ссылка";
	
	Запрос.УстановитьПараметр("Данные", Данные);
	РезультатЗапроса = Запрос.Выполнить();
	
	Данные = РезультатЗапроса.Выгрузить();
	
	Данные.Колонки.Добавить("TRANSGUID");
	Данные.Колонки.Добавить("DOCGUID");
	Данные.Колонки.Добавить("CONTRACTDATE");
	
	// Получаем количество записей в РС ЭКОМ_НеструктурированныеДокументы.
	Запрос.Текст 			= "ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ РегистрСведений.ЭКОМ_НеструктурированныеДокументы";
	//КоличествоЗаписейДанных = Запрос.Выполнить().Выгрузить()[0].Поле1;
	
	Если НомерДатаПоУмолчанию = Истина Тогда
		ПоследнийНомер = ПолучитьПоследнийНомерЭКОМ_ЦепочкиНеструктурированныхДокументов(
		ТекущаяДатаСеанса(),
		ПредопределенноеЗначение("Перечисление.ЭКОМ_НаправлениеОбмена.Исходящий")
		);
	КонецЕсли;
	
	Для Каждого Запись Из Данные Цикл
		// Прерываем работу, если документов к отправке более 100 штук.
		//Если КоличествоЗаписейДанных > 100 Тогда
		//	Прервать;
		//КонецЕсли;
		
		Если НомерДатаПоУмолчанию Тогда
			Запись.NUMBER 	= Формат(ПоследнийНомер + 1, "ЧЦ=10; ЧВН=; ЧГ=0");
			Запись.DATE 	= ТекущаяДатаСеанса();
		КонецЕсли;
		
		// Дополняем недостающими данными.
		//Запись.TRANSGUID 	= Строка(Новый УникальныйИдентификатор);
		Запись.TRANSGUID 	= СгенерироватьUUIDv1();
		Запись.DOCGUID 		= Строка(Новый УникальныйИдентификатор);
		Запись.CONTRACTDATE = Формат(Запись.ДатаДоговора, "ДФ=yyyy-MM-dd");
		
		// Запись в регистр.
		МенеджерЗаписиЦепочка 			= РегистрыСведений.ЭКОМ_ЦепочкиНеструктурированныхДокументов.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписиЦепочка, Запись,, "xmlКонтрагент, xmlОрганизация, xmlКонтрагентGUID, xmlОрганизацияGUID");
		МенеджерЗаписиЦепочка.xmlКонтрагент 		= СтрЗаменить(СтрЗаменить(Запись.xmlКонтрагент,			Символы.НПП, ""), Символ(160), "");
		МенеджерЗаписиЦепочка.xmlОрганизация 		= СтрЗаменить(СтрЗаменить(Запись.xmlОрганизация, 		Символы.НПП, ""), Символ(160), "");
		МенеджерЗаписиЦепочка.xmlКонтрагентGUID 	= СтрЗаменить(СтрЗаменить(Запись.xmlКонтрагентGUID, 	Символы.НПП, ""), Символ(160), "");
		МенеджерЗаписиЦепочка.xmlОрганизацияGUID 	= СтрЗаменить(СтрЗаменить(Запись.xmlОрганизацияGUID, 	Символы.НПП, ""), Символ(160), "");
		
		МенеджерЗаписиДанные 			= РегистрыСведений.ЭКОМ_НеструктурированныеДокументы.СоздатьМенеджерЗаписи();
		МенеджерЗаписиДанные.Данные 	= Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(Запись.Адрес));
		МенеджерЗаписиДанные.TRANSGUID 	= Запись.TRANSGUID;
		
		Попытка
			МенеджерЗаписиЦепочка.Записать();
			МенеджерЗаписиДанные.Записать();
			Запись.Записан = Истина;
			ПоследнийНомер = Число(Запись.NUMBER);
			//КоличествоЗаписейДанных = КоличествоЗаписейДанных + 1;
		Исключение
			Запись.NUMBER 	= "";
			ТекстОшибки 	= ОписаниеОшибки();
		КонецПопытки;
		
	КонецЦикла;
	
	КолонкиДляУдаления 		= Новый Массив;
	
	Для Каждого Колонка Из Данные.Колонки Цикл
		
		Если Колонка.Имя 	= "FILENAME"
			ИЛИ Колонка.Имя = "Записан"
			ИЛИ Колонка.Имя = "NUMBER"
			ИЛИ Колонка.Имя = "DATE"
			ИЛИ Колонка.Имя = "TRANSGUID" Тогда
			
			Продолжить;
		КонецЕсли;
		
		КолонкиДляУдаления.Добавить(Колонка);
	КонецЦикла;
	
	Для Каждого Колонка Из КолонкиДляУдаления Цикл
		Данные.Колонки.Удалить(Колонка);
	КонецЦикла;
	
КонецПроцедуры // СоздатьЗаписи_ЭКОМ_ЦепочкиНеструктурированныхДокументов()

// Формирует файлы типа CONDRA к отправке
//
// Параметры:
//  transguidКОтправке  - Массив - коллекция значений TRANSGUID из РС ЭКОМ_ЦепочкиНеструктурированныхДокументов для отправки
//  МассивЛогаСобытий  	- Массив - данные лога бсобытий
//
// Возвращаемое значение:
//   Массив   - данные об отправляемых записях
//
Функция CondraПодготовитьКОтправке(transguidКОтправке = Неопределено, МассивЛогаСобытий) Экспорт
	
	ИмяСобытия = "Подготовка condra к отправке";
	Шаг = 0; //MOD-2544
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЭКОМ_ЦепочкиНеструктурированныхДокументов.DATE КАК _DATE,
	|	ЭКОМ_ЦепочкиНеструктурированныхДокументов.Сумма КАК _SUM,
	|	ЭКОМ_ЦепочкиНеструктурированныхДокументов.FILENAME КАК _FILENAME,
	|	НЕОПРЕДЕЛЕНО КАК _Structure,
	|	ЛОЖЬ КАК _Отказ,
	|	ЭКОМ_ЦепочкиНеструктурированныхДокументов.Контрагент КАК _Контрагент,
	|	ЭКОМ_ЦепочкиНеструктурированныхДокументов.Организация КАК _Организация,
	|	ЭКОМ_GLN.Сертификат КАК _Сертификат,
	//|	ЭКОМ_GLN.Сертификат.СертификатНаСервере КАК _СертификатНаСервере, //MOD-2544
	|	ВЫБОР
	|			КОГДА ЭКОМ_GLN.ПрофильОбмена.Страна = ""kz""
	|				ТОГДА Ложь
	|			ИНАЧЕ ЭКОМ_GLN.Сертификат.СертификатНаСервере
	|		КОНЕЦ КАК _СертификатНаСервере,
	|	ЭКОМ_ЦепочкиНеструктурированныхДокументов.NUMBER КАК NUMBER,
	|	ВЫРАЗИТЬ("""" КАК СТРОКА(10)) КАК DATE,
	|	ЭКОМ_ЦепочкиНеструктурированныхДокументов.CONTRACTNUMBER КАК CONTRACTNUMBER,
	|	ЭКОМ_ЦепочкиНеструктурированныхДокументов.CONTRACTDATE КАК CONTRACTDATE,
	|	ЭКОМ_ЦепочкиНеструктурированныхДокументов.xmlОрганизация КАК SENDER,
	|	ЭКОМ_ЦепочкиНеструктурированныхДокументов.xmlОрганизацияGUID КАК SENDERGUID,
	|	ЭКОМ_ЦепочкиНеструктурированныхДокументов.xmlКонтрагент КАК RECIPIENT,
	|	ЭКОМ_ЦепочкиНеструктурированныхДокументов.xmlКонтрагентGUID КАК RECIPIENTGUID, 
	|	ЭКОМ_ЦепочкиНеструктурированныхДокументов.СрокПодписания КАК DAYSTOSIGN,
	|	ЭКОМ_ЦепочкиНеструктурированныхДокументов.INFO,
	|	ЭКОМ_ЦепочкиНеструктурированныхДокументов.DOCGUID,
	|	ЭКОМ_ЦепочкиНеструктурированныхДокументов.TRANSGUID,
	|	ЭКОМ_ЦепочкиНеструктурированныхДокументов.DOCTYPE,
	|	ВЫРАЗИТЬ("""" КАК СТРОКА(16)) КАК SUM,
	|	""1"" КАК TYPE,
	|	""0"" КАК isSigned,
	|	""0"" КАК isSignRequired,
	|	""0"" КАК isActionRequired,
	//+MOD-2544 [Для kz]
	//|	""1"" КАК WITHOUTSIGN,
	|	ВЫРАЗИТЬ("""" КАК СТРОКА(255)) КАК FILENAME,
	|	ВЫРАЗИТЬ("""" КАК СТРОКА(255)) КАК SIGNNAME,
	|	ЭКОМ_GLN.ПрофильОбмена.Страна КАК ПрофильОбменаСтрана
	//-MOD-2544 [Выводим страну профиля обмена, т.к. отличается структура xml]
	|ИЗ
	|	РегистрСведений.ЭКОМ_ЦепочкиНеструктурированныхДокументов КАК ЭКОМ_ЦепочкиНеструктурированныхДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN
	|		ПО ЭКОМ_ЦепочкиНеструктурированныхДокументов.Организация = ЭКОМ_GLN.Объект
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ТИПЗНАЧЕНИЯ(&transguidКОтправке) = &ТипНеопределено
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЭКОМ_ЦепочкиНеструктурированныхДокументов.TRANSGUID В (&transguidКОтправке)
	|		КОНЕЦ
	|	И ЭКОМ_ЦепочкиНеструктурированныхДокументов.НаправлениеОбмена = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_НаправлениеОбмена.Исходящий)
	|	И ЭКОМ_ЦепочкиНеструктурированныхДокументов.Статус = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_СтатусыCONDRA.Добавлен)";
	
	Запрос.УстановитьПараметр("transguidКОтправке", transguidКОтправке);
	Запрос.УстановитьПараметр("ТипНеопределено", Тип("Неопределено"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выгрузить();
	
	Для Каждого Запись Из ВыборкаДетальныеЗаписи Цикл
		
		ПрофильОбменаСтрана = Запись.ПрофильОбменаСтрана; //MOD-2544
		
		// Преобразование значений
		Запись.DATE = Формат(Запись._DATE, "ДФ=yyyy-MM-dd");
		Запись.SUM = Формат(Запись._SUM, "ЧРД=.; ЧГ=0");
		Файл = Новый Файл(Запись._FILENAME);
		Запись.FILENAME = Файл.Имя;
		//+MOD-2544 [Структура xml России и Казахстана отличается]
		Если ПрофильОбменаСтрана = "kz" Тогда
			Запись.SIGNNAME = "condra_" + Формат(ТекущаяДатаСеанса(), "ДФ=ггггММддЧЧммсс") + "_" + СокрЛП(Запись.NUMBER) + ".bin";
			
			Запись._Structure = Новый Структура("NUMBER, DATE, CONTRACTNUMBER, CONTRACTDATE, isSigned, isSignRequired, isActionRequired, DOCTYPE, HEAD");
			УзелHEAD = Новый Структура("SENDER, RECIPIENT, INFO, TRANSGUID, SUM, TYPE, DAYSTOSIGN, CONTENT");
		Иначе
			Запись.SIGNNAME = Файл.ИмяБезРасширения + ".bin";
		
			Запись._Structure = Новый Структура("NUMBER, DATE, CONTRACTNUMBER, CONTRACTDATE, DOCTYPE, HEAD");
			УзелHEAD = Новый Структура("SENDER, SENDERGUID, RECIPIENT, RECIPIENTGUID, INFO, DOCGUID, TRANSGUID, SUM, TYPE, CONTENT");
		КонецЕсли;
		//- MOD-2544
		
		УзелCONTENT = Новый Структура("FILENAME, SIGNNAME");
		
		ЗаполнитьЗначенияСвойств(Запись._Structure, Запись);
		ЗаполнитьЗначенияСвойств(УзелHEAD, Запись);
		ЗаполнитьЗначенияСвойств(УзелCONTENT, Запись);
		
		//MOD-2544 [Для kz запишем TRANSGUID в формате UUIDv1. Пока платформа другое не принимает]
		Если ПрофильОбменаСтрана = "kz" Тогда 
			УзелHEAD.TRANSGUID = Запись.TRANSGUID;
			//Шаг = Шаг + 1;
			//Гсч = Новый ГенераторСлучайныхЧисел();
			//СлучайноеЧисло = Строка(Формат(Гсч.СлучайноеЧисло(10000,90000) + Шаг, "ЧГ="));
			//УзелHEAD.TRANSGUID = СгенерироватьUUIDv1(УниверсальноеВремя(ТекущаяДата()),"0242ac1"+Строка(СлучайноеЧисло)); //По идее, надо передавать MAC-адрес сетевой карты, но его получение того не стоит
		КонецЕсли;
		
		Запись._Structure.HEAD = УзелHEAD;
		Запись._Structure.HEAD.CONTENT = УзелCONTENT;
		
	КонецЦикла;
	
	// Проверка заполнения обязательных полей.
	ОбязательныеПоля = Новый Массив;
	ОбязательныеПоля.Добавить("NUMBER");
	ОбязательныеПоля.Добавить("DATE");
	ОбязательныеПоля.Добавить("HEAD.SENDER");
	ОбязательныеПоля.Добавить("HEAD.RECIPIENT"); 
	Если ПрофильОбменаСтрана = "ru" Тогда //MOD-2544 [Для kz эти поля не заполняются]
		ОбязательныеПоля.Добавить("HEAD.SENDERGUID");
		ОбязательныеПоля.Добавить("HEAD.RECIPIENTGUID");
		ОбязательныеПоля.Добавить("HEAD.DOCGUID");
		КодировкаФайла = "windows-1251";
	Иначе
		КодировкаФайла = "utf-8";
	КонецЕсли;
	ОбязательныеПоля.Добавить("HEAD.TRANSGUID");
	ОбязательныеПоля.Добавить("HEAD.TYPE");
	ОбязательныеПоля.Добавить("HEAD.CONTENT.FILENAME");
	ОбязательныеПоля.Добавить("HEAD.CONTENT.SIGNNAME");
	
	Для Каждого Запись Из ВыборкаДетальныеЗаписи Цикл
		
		ПустыеПоля = Новый Массив;
		ПустыеПоляТекст = "";
		
		Для Каждого ОбязательноеПоле Из ОбязательныеПоля Цикл
			
			ЗначениеПоля 			= Неопределено;
			СтруктураДанныхКопия 	= Запись._Structure;
			
			Для Каждого ЭлементПоля Из Эком_РазложитьСтрокуВМассивПодстрок(ОбязательноеПоле, ".") Цикл
				СтруктураДанныхКопия.Свойство(ЭлементПоля, ЗначениеПоля);
				СтруктураДанныхКопия = ЗначениеПоля;
			КонецЦикла;
			
			Если ЗначениеПоля = Неопределено
				ИЛИ ПустаяСтрока(ЗначениеПоля) Тогда
				ПустыеПоля.Добавить(ОбязательноеПоле);
				Запись._Отказ = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого ПустоеПоле Из ПустыеПоля Цикл
			ПустыеПоляТекст = ПустыеПоляТекст + ?(ПустаяСтрока(ПустыеПоляТекст), "", ", ") + ПустоеПоле;
		КонецЦикла;
		
		Если НЕ ПустаяСтрока(ПустыеПоляТекст) Тогда
			ТекстЛогаСобытий = "Для исходящего неструктурированного документа с TRANSGUID " + Запись.TRANSGUID + " не "
			+ ?(ПустыеПоля.Количество() = 1, "заполнено обязательное поле ", "заполнены обязательные поля ") + ПустыеПоляТекст;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);				
		КонецЕсли;
		
	КонецЦикла;
	
	//КодировкаФайла = "windows-1251"; //MOD-2544
	ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.CONDRA_Исходящий;
	
	EDIINTERCHANGEID 	= 0;
	ЗаписиКОтправке 	= Новый Массив();
	ВыборкаДетальныеЗаписиБезОтказа = ВыборкаДетальныеЗаписи.НайтиСтроки(Новый Структура("_Отказ", Ложь));
	
	Для Каждого Запись Из ВыборкаДетальныеЗаписиБезОтказа Цикл
		// Получение имени XML файла.
		EDIINTERCHANGEID 	= НовыйНомерТранзакции(EDIINTERCHANGEID);
		EDIMESSAGE			= Формат(ТекущаяДатаСеанса(), "ДФ=ггггММддЧЧммсс000") + "-OUT-" + Формат(EDIINTERCHANGEID, "ЧГ=0");
		
		СтрокаЗаписи = Новый Структура;  
		СтрокаЗаписи.Вставить("ВидДокумента",			ВидДокумента);
		СтрокаЗаписи.Вставить("СтрокаXML", 				ЗаписатьФайлXML(Запись._Structure, "CONDRA", КодировкаФайла));
		СтрокаЗаписи.Вставить("ИмяФайлаДанных", 		Запись.FILENAME);
		СтрокаЗаписи.Вставить("ИмяФайлаBIN", 			Запись.SIGNNAME);
		СтрокаЗаписи.Вставить("Идентификатор", 			Запись.TRANSGUID);
		СтрокаЗаписи.Вставить("КодировкаФайла", 		КодировкаФайла);
		СтрокаЗаписи.Вставить("ДанныеСертификатаЭКОМ", 	Запись._Сертификат);
		СтрокаЗаписи.Вставить("СертификатНаСервере", 	Запись._СертификатНаСервере);
		СтрокаЗаписи.Вставить("Организация", 			Запись._Организация);
		СтрокаЗаписи.Вставить("Статус", 				Перечисления.ЭКОМ_СтатусыCONDRA.Отправлен);
		СтрокаЗаписи.Вставить("Документ", 				"Исходящий неструктурированный документ № " + Запись.NUMBER + " от " + Запись.DATE);
		СтрокаЗаписи.Вставить("Сообщение", 				"");
		СтрокаЗаписи.Вставить("Отправлен", 				Истина);

		СтрокаЗаписи.Вставить("ИмяФайлаXML", 			"CONDRA_" + EDIMESSAGE + ".xml");
		СтрокаЗаписи.Вставить("АдресФайлаДанных",		""); // Заполняется в CondraДобавитьОтпрвляемыеФайлы
		СтрокаЗаписи.Вставить("АдресФайлаBIN",			""); // Заполняется в модуле формы после подписания документа
		СтрокаЗаписи.Вставить("ДвоичныеДанныеФайлаДанных", ""); // Заполняется в CondraОтправить из АдресФайлаДанных
		СтрокаЗаписи.Вставить("ДвоичныеДанныеФайлаBIN", ""); // Заполняется в CondraОтправить из АдресФайлаBIN 
		СтрокаЗаписи.Вставить("Страна",					Запись.ПрофильОбменаСтрана); //MOD-2544
		
		ЗаписиКОтправке.Добавить(СтрокаЗаписи);
	КонецЦикла;
	
	Возврат ЗаписиКОтправке;
	
КонецФункции // CondraПодготовитьКОтправке()

// Добавляет к записям CONDRA к отправке пользовательские файлы для отправки
//
// Параметры:
//  ЗаписиКОтправке  	- Массив - коллекция структур с данными записей к отправке (получается методом "CondraПодготовитьКОтправке()")
//  МассивЛогаСобытий	- Массив - данные лога бсобытий
//
Процедура CondraДобавитьОтпрвляемыеФайлы(ЗаписиКОтправке, МассивЛогаСобытий) Экспорт
	
	TRANSGUID = Новый Массив;
	Для Каждого Запись Из ЗаписиКОтправке Цикл
		TRANSGUID.Добавить(Запись.Идентификатор);
	КонецЦикла;
	
	// Получаем файлы для оптравки.
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЭКОМ_НеструктурированныеДокументы.TRANSGUID,
	|	ЭКОМ_НеструктурированныеДокументы.Данные
	|ИЗ
	|	РегистрСведений.ЭКОМ_НеструктурированныеДокументы КАК ЭКОМ_НеструктурированныеДокументы
	|ГДЕ
	|	ЭКОМ_НеструктурированныеДокументы.TRANSGUID В(&TRANSGUID)";
	
	Запрос.УстановитьПараметр("TRANSGUID", TRANSGUID);
	РезультатЗапроса = Запрос.Выполнить();
	Данные = РезультатЗапроса.Выгрузить();
	
	МаксИндекс 			= ЗаписиКОтправке.ВГраница();
	
	Для Индекс = 0 По МаксИндекс Цикл
		Запись = ЗаписиКОтправке.Получить(МаксИндекс - Индекс);
		
		// Получение файла данных.
		СтрокаДанных = Данные.Найти(Запись.Идентификатор, "TRANSGUID");
		Если СтрокаДанных = Неопределено Тогда
			ТекстЛогаСобытий = "По TRANSGUID " + Запись.Идентификатор + " не найден файл для отправки!";
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, "Добавить файлы condra");
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			ЗаписиКОтправке.Удалить(МаксИндекс - Индекс);
			Продолжить;
		КонецЕсли;
		
		//ФайлДанных = Новый Файл(ВременныйКаталог + Запись.ИмяФайлаДанных);
		ДвоичныеДанныеФайлаДанных	= СтрокаДанных.Данные.Получить();
		Запись.АдресФайлаДанных		= ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайлаДанных, Новый УникальныйИдентификатор);
		
	КонецЦикла;
	
КонецПроцедуры // CondraДобавитьОтпрвляемыеФайлы()

// Отправляет файлы типа CONDRA
//
// Параметры:
//  ЗаписиКОтправке  	- Массив - коллекция структур с данными записей к отправке (получается методом "CondraПодготовитьКОтправке()")
//  МассивЛогаСобытий	- Массив - данные лога бсобытий
//
// Возвращаемое значение:
//   Массив - коллекция обработанных записей
//
Функция CondraОтправить(ЗаписиКОтправке, МассивЛогаСобытий) Экспорт
	
	ИмяСобытия = "Отправить CONDRA";
	ТипДокумента = "CONDRA";
	
	TRANSGUID = Новый Массив;
	Для Каждого Запись Из ЗаписиКОтправке Цикл
		TRANSGUID.Добавить(Запись.Идентификатор);
	КонецЦикла;
	
	ВременныйКаталог = ПутьВременногоКаталогаЭКОМ("Condra_out");
	СоздатьКаталог(ВременныйКаталог);
	
	// Подписание на сервере
	МаксИндекс = ЗаписиКОтправке.ВГраница();
	Для Индекс = 0 По МаксИндекс Цикл
		Запись = ЗаписиКОтправке.Получить(МаксИндекс - Индекс);
		
		ФайлДанных = Новый Файл(ВременныйКаталог + Запись.ИмяФайлаДанных);
		ДвоичныеДанныеФайлаДанных = ПолучитьИзВременногоХранилища(Запись.АдресФайлаДанных);
		ДвоичныеДанныеФайлаДанных.Записать(ФайлДанных.ПолноеИмя);
		
		// Подписание файла данных.
		ФайлПодписи = Новый Файл(ВременныйКаталог + Запись.ИмяФайлаBIN);
		
		Если Запись.СертификатНаСервере = Ложь Тогда
			ДвоичныеДанныеФайлаBIN = ПолучитьИзВременногоХранилища(Запись.АдресФайлаBIN);
		Иначе
			ДвоичныеДанныеФайлаBIN = Вычислить("ЭКОМ_ОбщегоНазначения.ЭЦП_СформироватьПодписьФайлаОбщегоНазначения(ДвоичныеДанныеФайлаДанных, Запись.ДанныеСертификатаЭКОМ, МассивЛогаСобытий)");
			Если ДвоичныеДанныеФайлаBIN = Неопределено Тогда
				ТекстЛогаСобытий = "Ошибка подписания файла. Проверьте настройки подписи (TRANSGUID " + Запись.Идентификатор + ")";
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

				ЗаписиКОтправке.Удалить(МаксИндекс - Индекс);
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
		
		ДвоичныеДанныеФайлаBIN.Записать(ФайлПодписи.ПолноеИмя);
		
		Запись.ДвоичныеДанныеФайлаДанных = ДвоичныеДанныеФайлаДанных;
		Запись.ДвоичныеДанныеФайлаBIN = ДвоичныеДанныеФайлаBIN;
		
	КонецЦикла;
	
	// Отправка документов.
	ПродолжитьОбмен = ПроверитьУстановитьБлокировкуОперации(ТипДокумента, "Исходящий", МассивЛогаСобытий);
	
	ЭтоНовыеДокументы = Истина;
	Если ПродолжитьОбмен = Истина Тогда
		СтруктураЛога = ПолучитьСтруктуруЛога();
		ОтправитьФайлы(ЗаписиКОтправке, ТипДокумента, МассивЛогаСобытий, Ложь, ЭтоНовыеДокументы, СтруктураЛога);
		Выполнить("ЭКОМ_ОбщегоНазначения.СнятьБлокировкуОперации(ТипДокумента, ""Исходящий"", МассивЛогаСобытий);");
	КонецЕсли;
	
	// Завершение отправки.
	УдалитьФайлы(ВременныйКаталог);
	
	// Помещение файла в архив.
	Для Индекс = 0 По ЗаписиКОтправке.ВГраница() Цикл
		Запись = ЗаписиКОтправке.Получить(Индекс);
		Если Запись.Свойство("ИмяАрхива") Тогда
			Отправлен 	= Запись.Отправлен;
			ФайлАрхива 	= Новый Файл(Запись.ИмяАрхива);
			АдресФайла 	= ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ФайлАрхива.ПолноеИмя));
			УдалитьФайлы(Запись.ИмяАрхива);
			ЗаписиКОтправке.Установить(Индекс, Новый Структура("АдресАрхива, ИмяАрхива, Отправлен", АдресФайла, ФайлАрхива.Имя, Отправлен));
		Иначе
			ЗаписиКОтправке.Установить(Индекс, Новый Структура("Отправлен", Ложь));
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЗаписиКОтправке;
	
КонецФункции // CondraОтправить()

// Получает максимальный номер поля NUMBER за календарный год, к которому относится указанная дата
//
// Параметры:
//  DATE  				- Дата 										- любая дата в пределах года, за который нужно получить запись
//  НаправлениеОбмена 	- ПеречислениеСсылка.ЭКОМ_НаправлениеОбмена - при необходимости можно задать направление обмена для отбора записей
//
// Возвращаемое значение:
//   Число   - максимальное значение номера (поле NUMBER) записи в пределах указанного года (поле DATE)
//
Функция ПолучитьПоследнийНомерЭКОМ_ЦепочкиНеструктурированныхДокументов(DATE, НаправлениеОбмена = Неопределено)
	
	МаксНомер = 0;
	Цифры = "0123456789";
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЭКОМ_ЦепочкиНеструктурированныхДокументов.NUMBER
	|ИЗ
	|	РегистрСведений.ЭКОМ_ЦепочкиНеструктурированныхДокументов КАК ЭКОМ_ЦепочкиНеструктурированныхДокументов
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ТИПЗНАЧЕНИЯ(&НаправлениеОбмена) = &ТипНеопределено
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЭКОМ_ЦепочкиНеструктурированныхДокументов.НаправлениеОбмена = &НаправлениеОбмена
	|		КОНЕЦ
	|	И НАЧАЛОПЕРИОДА(&DATE, ГОД) <= ЭКОМ_ЦепочкиНеструктурированныхДокументов.DATE <= КОНЕЦПЕРИОДА(&DATE, ГОД)";
	
	Запрос.УстановитьПараметр("DATE", 				DATE);
	Запрос.УстановитьПараметр("НаправлениеОбмена", 	НаправлениеОбмена);
	Запрос.УстановитьПараметр("ТипНеопределено", 	Тип("Неопределено"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ТолькоЦифры = "";
		
		Для Номер = 1 По СтрДлина(ВыборкаДетальныеЗаписи.NUMBER) Цикл
			
			Символ = Сред(ВыборкаДетальныеЗаписи.NUMBER, Номер, 1);
			
			Если НЕ Найти(Цифры, Символ) = Неопределено Тогда
				ТолькоЦифры = ТолькоЦифры + Символ;
			КонецЕсли;
		КонецЦикла;
		
		Попытка
			МаксНомер = Макс(МаксНомер, Число(ТолькоЦифры));
		Исключение КонецПопытки;
		
	КонецЦикла;
	
	Возврат МаксНомер;
	
КонецФункции // ПолучитьПоследнийНомерЭКОМ_ЦепочкиНеструктурированныхДокументов()


// ПОЛУЧЕНИЕ КОНТРАГЕНТОВ И ОРГАНИЗАЦИЙ У КОТОРЫХ УСТАНОВЛЕН GLN
Функция ПолучитьСписокКонтрагентовGLN() Экспорт
	
	Список = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЭКОМ_GLN.Объект КАК Объект,
	|	ЭКОМ_GLN.GLN КАК GLN
	|ИЗ
	|	РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN
	|ГДЕ
	|	ЭКОМ_GLN.Объект ССЫЛКА Справочник.Контрагенты";
	
	РезультатЗапроса = Запрос.Выполнить();	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Список.Добавить(Выборка.Объект, СокрЛП(Выборка.Объект) + " (GLN " + СокрЛП(Выборка.GLN) + ")");
	КонецЦикла;
	
	Возврат Список;
	
КонецФункции

