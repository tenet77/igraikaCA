// Если файл XML уже загружался то мы его не добавляем в список и не скачиваем его с платформы
Функция ПроверитьСписокЗагружаемыхДокументов(ТаблицаЗначенийФайловНаПлатформе, ТипДокумента)
	
	МассивПоТипам = ПолучитьМассивВидовДокумента(ТипДокумента);
	
	ТаблицаЗначенийДляЗагрузки = Новый ТаблицаЗначений;
	Массив = Новый Массив;
	КС = Новый КвалификаторыСтроки(250);
	Массив.Добавить(Тип("Строка"));
	ОписаниеТиповС = Новый ОписаниеТипов(Массив, , , ,КС);
	Массив.Очистить();
	
	ТаблицаЗначенийДляЗагрузки.Колонки.Добавить("ФайлИмя"      , ОписаниеТиповС);
	ТаблицаЗначенийДляЗагрузки.Колонки.Добавить("Идентификатор", ОписаниеТиповС);
	ТаблицаЗначенийДляЗагрузки.Колонки.Добавить("Расширение"   , ОписаниеТиповС);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПОДСТРОКА(СписокФайлов.Расширение, 0, 250) КАК Расширение,
	|	ПОДСТРОКА(СписокФайлов.ФайлИмя, 0, 250) КАК ФайлИмя,
	|	ПОДСТРОКА(СписокФайлов.Идентификатор, 0, 250) КАК Идентификатор
	|ПОМЕСТИТЬ СписокФайлов
	|ИЗ
	|	&ТаблицаЗначенийФайловНаПлатформе КАК СписокФайлов
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Идентификатор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЭКОМ_Объекты_События.Документ_Основание КАК Документ_Основание,
	|	СписокФайлов.ФайлИмя КАК ФайлИмя,
	|	СписокФайлов.Идентификатор КАК Идентификатор,
	|	СписокФайлов.Расширение КАК Расширение
	|ПОМЕСТИТЬ Итог
	|ИЗ
	|	СписокФайлов КАК СписокФайлов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_События
	|		ПО СписокФайлов.Идентификатор = ЭКОМ_Объекты_События.Идентификатор
	|			И (ЭКОМ_Объекты_События.ВидДокумента В (&ВидДокумента))
	|			И (ЭКОМ_Объекты_События.НаправлениеОбмена = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_НаправлениеОбмена.Входящий))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Итог.Документ_Основание КАК Документ_Основание,
	|	Итог.ФайлИмя КАК ФайлИмя,
	|	Итог.Идентификатор КАК Идентификатор,
	|	Итог.Расширение КАК Расширение
	|ИЗ
	|	Итог КАК Итог
	|ГДЕ
	|	Итог.Документ_Основание ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("ВидДокумента", МассивПоТипам);
	Запрос.УстановитьПараметр("ТаблицаЗначенийФайловНаПлатформе", ТаблицаЗначенийФайловНаПлатформе);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда		
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			НовСтр = ТаблицаЗначенийДляЗагрузки.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр, Выборка);
			
		КонецЦикла;	
	КонецЕсли;
	
	Возврат ТаблицаЗначенийДляЗагрузки;
	
КонецФункции

Процедура УдалитьФайлыПоИменам(Знач ЗагруженныеРанееФайлы, Знач МассивФайловСFTP)
	
	Перем ИмяФайлаДляУдаления, ИндексЭлемента, ФайлСФТП;
	
	Для каждого ИмяФайлаДляУдаления Из ЗагруженныеРанееФайлы Цикл
		ИндексЭлемента = 0;
		Для каждого ФайлСФТП Из МассивФайловСFTP Цикл
			Если ФайлСФТП.Имя = ИмяФайлаДляУдаления Тогда
				МассивФайловСFTP.Удалить(ИндексЭлемента);
				Прервать;
			Иначе 
				ИндексЭлемента = ИндексЭлемента + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция СобратьИменаФайловНаПоМаскеFTP(Сервер, МаскаФайлов, ПутьНаСервере, ОбщийМассивФайловСFTP, ТипОбменаЭТРН, ПрофильОбмена, МассивЛогаСобытий)
	
	Результат = Ложь;
	Попытка
		МассивФайловCFTP = Сервер.НайтиФайлы(ПутьНаСервере, МаскаФайлов);
	Исключение
		Сервер = ПолучитьFTPСоединениеВОбработке(ПрофильОбмена, ТипОбменаЭТРН, МассивЛогаСобытий);
		Если НЕ Сервер = Неопределено Тогда
			МассивФайловCFTP = Сервер.НайтиФайлы(ПутьНаСервере, МаскаФайлов);
		КонецЕсли;
	КонецПопытки;
	
	Если МассивФайловCFTP.Количество() > 0 Тогда
		Результат = Истина;
	КонецЕсли;
	
	// Собираем файлы в один массив
	Для Каждого ТекущийФайл Из МассивФайловCFTP Цикл
		Если НЕ ТекущийФайл.Этофайл() Тогда
			Продолжить;
		КонецЕсли;
		ОбщийМассивФайловСFTP.Добавить(ТекущийФайл);
	КонецЦикла;
	
	
	Возврат Результат;
КонецФункции

// Добавляем строки из документа в таблицу значений
//
// Параметры:
//  <ТаблицаЗначенийТЧ>  - Таблица  в которой собираются все строки
//  <ТабличнаяЧастьДокумента>  - табличная часть документа
//  <ИдентификаторФайла>  - имя файла без расширения
//
Процедура ДобавитьСтрокуВТаблицуТЧ(ТаблицаЗначенийТЧ, ТабличнаяЧастьДокумента, ИдентификаторФайла)
	
	// Создаем колонки для табличной части 
	Для каждого ЭлСтроки Из ТабличнаяЧастьДокумента Цикл
		Для каждого Эл Из ЭлСтроки Цикл
			Если ТаблицаЗначенийТЧ.Колонки.Найти(Эл.Ключ) = Неопределено Тогда	 
				ТипКолонки = ТипЗнч(Эл.Значение);
				Если ТипКолонки = Тип("Массив") 
					ИЛИ ТипКолонки = Тип("Неопределено") Тогда
					Продолжить;
				КонецЕсли;
				Массив = Новый Массив;
				Массив.Добавить(ТипКолонки);
				ТаблицаЗначенийТЧ.Колонки.Добавить(Эл.Ключ, Новый ОписаниеТипов(Массив));
			КонецЕсли;	
		КонецЦикла;
	КонецЦикла;
	
	// Собираем данные в таблицы значений для табличной части 
	Для каждого ЭлСтроки Из ТабличнаяЧастьДокумента Цикл
		СтрокаТЧДокумента = ТаблицаЗначенийТЧ.Добавить();
		Для каждого Эл Из ЭлСтроки Цикл
			Если НЕ ТаблицаЗначенийТЧ.Колонки.Найти(Эл.Ключ) = Неопределено Тогда
				СтрокаТЧДокумента[Эл.Ключ] = Эл.Значение;
			КонецЕсли;
		КонецЦикла;
		СтрокаТЧДокумента.ИдентификаторФайла = ИдентификаторФайла;
	КонецЦикла;
	
КонецПроцедуры // ДобавитьСтрокуВТаблицуТЧ(ТаблицаЗначенийТЧ, ТабличнаяЧастьДокумента)

// Добавляем строки из документа в таблицу значений
//
// Параметры:
//  <ТаблицаЗначенийТЧ>  - Таблица  в которой собираются все строки
//  <ТабличнаяЧастьДокумента>  - табличная часть документа
//  <ИдентификаторФайла>  - имя файла без расширения
//
Процедура ДобавитьСтрокуВТаблицуШапка(ТаблицаЗначенийШапка, СтруктураДокумента)
	
	// Создаем колонки для шапки документов
	Для каждого Эл Из СтруктураДокумента Цикл
		Если ТаблицаЗначенийШапка.Колонки.Найти(Эл.Ключ) = Неопределено Тогда
			ТипКолонки = ТипЗнч(Эл.Значение);
			Если Эл.Ключ = "ДатаЗаказа" И Эл.Значение = "" Тогда
				ТипКолонки = ТипЗнч(Дата(1,1,1));
				Эл.Значение = Дата(1,1,1);
			КонецЕсли;
			Если ТипКолонки = Тип("Массив")
				ИЛИ ТипКолонки = Тип("Неопределено") Тогда
				Продолжить;
			КонецЕсли;
			Массив = Новый Массив;
			Массив.Добавить(ТипКолонки);
			ТаблицаЗначенийШапка.Колонки.Добавить(Эл.Ключ, Новый ОписаниеТипов(Массив));	
		КонецЕсли;	
	КонецЦикла;
	
	// Собираем данные в таблицы значений для шапки документов 
	СтрокаШапкаДокумента = ТаблицаЗначенийШапка.Добавить();
	Для каждого Эл Из СтруктураДокумента Цикл	
		Если НЕ ТаблицаЗначенийШапка.Колонки.Найти(Эл.Ключ) = Неопределено Тогда
			СтрокаШапкаДокумента[Эл.Ключ] = Эл.Значение;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры // ДобавитьСтрокуВТаблицуТЧ(ТаблицаЗначенийТЧ, ТабличнаяЧастьДокумента)

// Проверка обязательных реквизитов
//
// Параметры:
//  <ТипДокумента>        - тип загружаемого документа XML
//  <СтруктураДокумента>  - структура получаемая из XML, которую необходимо проверить
//
Процедура ПроверкаОбязательныхПолейСтруктуры(ТипДокумента, СтруктураДокумента)
	
	Соответствие = Новый Соответствие;
	
	Если  ТипДокумента = "ON_SCHFDOPPR" 
		ИЛИ ТипДокумента = "ON_KORSCHFDOPPR"  Тогда 							
		
		Соответствие.Вставить("Грузополучатель_ИННЮЛ", "");
		Соответствие.Вставить("Грузополучатель_ИННФЛ", "");
		Соответствие.Вставить("Грузополучатель_КПП"  , "");
		Соответствие.Вставить("Покупатель_ИННЮЛ"     , "");
		Соответствие.Вставить("Покупатель_КПП"       , "");
		Соответствие.Вставить("xmlТочкаДоставкиGLN"  , "");
		Соответствие.Вставить("СчФ_Дата"             , Дата(0001, 01, 01));
		Соответствие.Вставить("СчФ_Номер"            , "");
		Соответствие.Вставить("ВидДокумента"         , Перечисления.ЭКОМ_ВидыДокументов.ПустаяСсылка());		
		Соответствие.Вставить("ИдФайл"               , "");
		Соответствие.Вставить("ИдПок"                , "");
		Соответствие.Вставить("ИдОтпр"               , "");
		
	КонецЕсли;
	
	Для каждого Элемент Из Соответствие Цикл
		Если СтруктураДокумента.Свойство(Элемент.Ключ) = Ложь Тогда
			СтруктураДокумента.Вставить(Элемент.Ключ, Элемент.Значение);			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры 

Процедура СформироватьПодписьНаСервере(МассивСтруктур, ТипДокумента, МассивЛогаСобытий) Экспорт
	
	ИмяСобытия = "Сформировать подпись на сервере";
	ВременныйКаталог = ПутьВременногоКаталогаЭКОМ("out_XML");
	СоздатьКаталог(ВременныйКаталог);
	
	МассивОшибочных = Новый Массив;
	Для каждого СтруктураEDI Из МассивСтруктур Цикл
		
		СтруктураEDI.Вставить("Отправлен"    , Ложь);
		СтруктураEDI.Вставить("Сообщение"    , "");
		
		// Проверка чтобы вся цепочка была подписана одним сертификатом для поставщика
		Если ТипДокумента = "DP_IZVPOL_04"
			ИЛИ ТипДокумента = "DP_IZVPOL_10"
			ИЛИ ТипДокумента = "DP_PTORG1" Тогда
			
			// Получаю из хранилища двоичные данные		
			Если НЕ ЗначениеЗаполнено(СтруктураEDI.ЭЦПотЮЗД) Тогда
				ТекстЛогаСобытий = "ЭЦП неопрелен для " + СтруктураEDI.ПредставлениеДок;
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
				
				Продолжить;
			КонецЕсли;
			
			СертификатСовпадает = Вычислить("ЭКОМ_ОбщегоНазначения.ЭЦП_ОперацииПроверкиПодписиНаСервере(СтруктураEDI.ЭЦПотЮЗД, СтруктураEDI.ДанныеСертификатаЭКОМ, МассивЛогаСобытий)");
			
			Если НЕ СертификатСовпадает Тогда
				ТекстЛогаСобытий = "УПД подписан другим сертификатом, " + ТипДокумента + " на " + СтруктураEDI.ТипИзвещения + " отправлен не будет! (1852) - " + СтруктураEDI.ПредставлениеДок;
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
				
				Продолжить;
			КонецЕсли;		
			
		КонецЕсли;
		
		
		// Получем файл 
		ФайлXML = ПолучитьФайлДокумента(СтруктураEDI, ВременныйКаталог);
		Если НЕ ФайлXML.Существует() Тогда
			Продолжить;
		КонецЕсли; 
		ДвоичныеДанныеФайлаXML = Новый ДвоичныеДанные(ФайлXML.ПолноеИмя);
		
		// Создаем подпись		
		ДвоичныеДанныеФайлаBIN = Вычислить("ЭКОМ_ОбщегоНазначения.ЭЦП_СформироватьПодписьФайлаОбщегоНазначения(ДвоичныеДанныеФайлаXML, СтруктураEDI.ДанныеСертификатаЭКОМ, МассивЛогаСобытий)");								
		ТипПодписи = "на сервере";
		
		Если ДвоичныеДанныеФайлаBIN = Неопределено Тогда
			ТекстЛогаСобытий = ТипДокумента + " - Документ не подписан! (" + ТипПодписи + ") - " + ФайлXML.Имя + " // " + СтруктураEDI.ДанныеСертификатаЭКОМ.Организация;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			МассивОшибочных.Добавить(СтруктураEDI);
			Продолжить;
		КонецЕсли;
		
		СтруктураEDI.Вставить("ИмяФайлаBIN"           , ФайлXML.ИмяБезРасширения + ".bin");
		СтруктураEDI.Вставить("ДвоичныеДанныеФайлаBIN", ДвоичныеДанныеФайлаBIN);
		
	КонецЦикла;
	
	// Удаляем 
	Для каждого ЭлМассивОшибочных Из МассивОшибочных Цикл
		Для каждого ЭлМассивФайлов Из МассивСтруктур  Цикл
			Если ЭлМассивФайлов.ИмяФайлаXML = ЭлМассивОшибочных.ИмяФайлаXML Тогда
				МассивСтруктур.Удалить(МассивСтруктур.Найти(ЭлМассивФайлов));	
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьНаличиеФайловНаСервере(ТипДокумента, ЭтоРегламентноеЗадание = Ложь, СтруктураЛога) Экспорт
	
	НачалоВыполнения                 = ТекущаяДатаСеанса();
	МассивОбработанныхФайловЛокально = Новый Массив;			
	КоличествоСозданныхДокументов    = 0;
	МассивЛогаСобытий                = Новый Массив;
	
	//Docrobot 1.19.0 MOD-1377 [Разделяем по номерам]
	ТЗОтветов = Новый ТаблицаЗначений;
	Если ТипДокумента = "DP_PDOTPR" Или ТипДокумента = "DP_PDPOL" Тогда
		ТЗОтветов.Колонки.Добавить("ВидДокумента");
		ТЗОтветов.Колонки.Добавить("КоличествоОбщее");
		ТЗОтветов.Колонки.Добавить("КоличествоОбработано");
	КонецЕсли;
	//Конец Docrobot 1.19.0 MOD-1377 [Разделяем по номерам]
	
	ИмяСобытия = "Проверка/загрузка документов на сервере " + ТипДокумента;
	МассивСтруктурыФайловСервера = ПолучитьВсеФайлы(Новый Массив, ТипДокумента, Ложь, МассивЛогаСобытий, ЭтоРегламентноеЗадание, СтруктураЛога); 	
	Для Каждого СтруктураФайла Из МассивСтруктурыФайловСервера Цикл
		
		// Повторная обработка документа, пропускаем - файла нет, чтение из регистра
		Если СтруктураФайла.ПовторнаяОбработка = Истина Тогда
			Продолжить;			
		КонецЕсли;
		
		ТекФайл      = СтруктураФайла.ФайлXML;
		СтруктураДок = СтруктураФайла.СтруктураДок;
		
		ФайлXMLПолноеИмя = ТекФайл.ПолноеИмя;
		
		// Получаем подпись только там где она необходима
		Если СтруктураФайла.Свойство("ИмяФайлаПодписи") Тогда			
			ФайлBIN = СтруктураФайла.ФайлBIN;		
		КонецЕсли;
		
		// Переносим локально
		Если СтруктураДок = Неопределено Тогда
			Попытка
				УдалитьФайлы(ТекФайл.ПолноеИмя);
			Исключение
				ТекстЛогаСобытий = "Ошибка при удалении файла <" + ТекФайл.ПолноеИмя +  "> в архив" + ТекущаяДата();
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

			КонецПопытки;
			
			Продолжить;
			
		КонецЕсли;
		
		знОрганизация = Неопределено;
		СтруктураДок.Свойство("Организация", знОрганизация);
		
		Обработан = Ложь;
		Если СтруктураДок.Свойство("Обработан") = Истина Тогда
			Обработан = СтруктураДок.Обработан;
		КонецЕсли;
		
		ТекущееКоличество = 0;
		
		Если Обработан = Истина Тогда
			
			ТекущееКоличество = 1;
			МассивОбработанныхФайловЛокально.Добавить(ТекФайл);
			Если СтруктураФайла.Свойство("ИмяФайлаПодписи") Тогда	     				
				МассивОбработанныхФайловЛокально.Добавить(ФайлBIN);
			КонецЕсли;
			
		Иначе
			
			//Продолжить;
			
		КонецЕсли;
		
		//Docrobot 1.19.0 MOD-1377 [Для каждого вида отдельно считаем количество]
		Если ТипДокумента = "DP_PDOTPR" Или ТипДокумента = "DP_PDPOL" Тогда
			НайденнаяСтрока = ТЗОтветов.Найти(СтруктураДок.ВидДокумента,"ВидДокумента");
			Если НайденнаяСтрока = Неопределено Тогда
				НоваяСтрока = ТЗОтветов.Добавить();		
				НоваяСтрока.ВидДокумента 		 	 = СтруктураДок.ВидДокумента;
				НоваяСтрока.КоличествоОбщее 	 	 = 1;
				НоваяСтрока.КоличествоОбработано 	 = ТекущееКоличество;
			Иначе
				НайденнаяСтрока.КоличествоОбщее 	 = НайденнаяСтрока.КоличествоОбщее + 1;
				НайденнаяСтрока.КоличествоОбработано = НайденнаяСтрока.КоличествоОбработано + ТекущееКоличество;
			КонецЕсли;
		КонецЕсли;
		
		Если Не Обработан Тогда
			Продолжить;
		КонецЕсли;
		//Конец Docrobot 1.19.0 MOD-1377 [Для каждого вида отдельно считаем количество]
		
		КоличествоСозданныхДокументов = КоличествоСозданныхДокументов + ТекущееКоличество;
		
	КонецЦикла;
	
	// Удалим файлы
	Попытка
		Для каждого Стр Из МассивОбработанныхФайловЛокально Цикл
			УдалитьФайлы(Стр.ПолноеИмя); 
		КонецЦикла;
	Исключение	
	КонецПопытки;
	
	//Docrobot 1.19.0 MOD-1377 [Для каждого вида отдельно выводим в лог количество]
	Если ТЗОтветов.Количество() > 0 Тогда
		
		Для Каждого СтрокаОтвета Из ТЗОтветов Цикл
			
			ИмяСобытия = "Проверка/загрузка документов на сервере " + ТипДокумента + ВернутьНомерКвитанции(СтрокаОтвета.ВидДокумента);
			
			ТекстЛогаСобытий = "Обработано " + СтрокаОтвета.КоличествоОбработано
			+ " файлов из " + СтрокаОтвета.КоличествоОбщее + " возможных.";
			
			//Docrobot 1.19.0 MOD-1272 [+. Уровень логирования, в зависимости от количества обработанных документов]
			Если СтрокаОтвета.КоличествоОбработано = СтрокаОтвета.КоличествоОбщее Тогда 
				УровеньЛогирования = Перечисления.ЭКОМ_УровниЛогирования.Успешно;
			Иначе
				УровеньЛогирования = Перечисления.ЭКОМ_УровниЛогирования.Предупреждение;
			КонецЕсли;
			
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, УровеньЛогирования, ИмяСобытия);
			//Docrobot 1.19.0 MOD-1272 [-]

			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
		КонецЦикла;
		
	ИначеЕсли Не МассивСтруктурыФайловСервера.Количество() = 0 Тогда //Docrobot 1.19.0 MOD-1377 [Добавил проверку. Не выводить, если количество 0. ]
		
		ТекстЛогаСобытий = "Обработано " + КоличествоСозданныхДокументов + " файлов из " 
		+ МассивСтруктурыФайловСервера.Количество() + " возможных.";
		
		//Docrobot 1.19.0 MOD-1272 [+. Уровень логирования, в зависимости от количества обработанных документов]
		Если СтрокаОтвета.КоличествоОбработано = СтрокаОтвета.КоличествоОбщее Тогда 
			УровеньЛогирования = Перечисления.ЭКОМ_УровниЛогирования.Успешно;
		Иначе
			УровеньЛогирования = Перечисления.ЭКОМ_УровниЛогирования.Предупреждение;
		КонецЕсли;
		
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, УровеньЛогирования, ИмяСобытия);
		//Docrobot 1.19.0 MOD-1272 [-]
		
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
	КонецЕсли;
	//Конец Docrobot 1.19.0 MOD-1377 [Для каждого вида отдельно выводим в лог количество]
		
	Если МассивЛогаСобытий.Количество() > 0 Тогда
		Выполнить("ЭКОМ_ОбщегоНазначения.ЗаписатьЛогСобытийвРегистрЛогирование(МассивЛогаСобытий);");
	КонецЕсли;
	
КонецПроцедуры

Функция ВернутьНомерКвитанции(ВидДокумента) //Docrobot 1.19.0 MOD-1377 []
	
	Если ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_PDOTPR_03 Тогда
		Возврат "_03";	
	ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_PDOTPR_08 Тогда 
		Возврат "_08";
	ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_PDOTPR_13 Тогда 
		Возврат "_13";
	ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_PDPOL_02 Тогда 
		Возврат "_02";
	ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_PDPOL_07 Тогда 
		Возврат "_07";
	ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_PDPOL_12 Тогда 
		Возврат "_12";
	КонецЕсли;
	
КонецФункции

Функция ПутьВременногоКаталогаЭКОМ(ТипФайла = "") Экспорт  
	
	РазделительПути = ЭКОМ_ПолучитьРазделительПути();
	Если ТипФайла = "" Тогда
		Результат = КаталогВременныхФайлов() + "TempECOM" + РазделительПути;
	Иначе
		Результат = КаталогВременныхФайлов() + "TempECOM" + РазделительПути + ТипФайла + РазделительПути;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОписаниеСтрокиГибкихНастроек(СтрокаНастроек, ВыполняемыйКод = Неопределено, Результат = "", ИмяНастройки = "ТипТранзакции") Экспорт
	
	Если ТипЗнч(СтрокаНастроек) <> Тип("СтрокаДереваЗначений") Тогда
		Возврат Результат;
	КонецЕсли;
	
	Владелец = СтрокаНастроек.Владелец();
	
	ИмяИсточника = "";
	ЗначениеИсточникаЗаполнено = Ложь;
	КолонкаИсточника = Владелец.Колонки.Найти("Источник");
	Если НЕ КолонкаИсточника = Неопределено Тогда
		ИмяИсточника = СтрокаНастроек.Источник;
		Если ЗначениеЗаполнено(СтрокаНастроек.Источник) Тогда
			ЗначениеИсточникаЗаполнено = Истина;
		КонецЕсли;
	КонецЕсли;
	
	ИмяПриемника = "";
	ЗначениеПриемникаЗаполнено = Ложь;
	КолонкаПриемник = Владелец.Колонки.Найти("Приемник");
	Если НЕ КолонкаПриемник = Неопределено Тогда
		ИмяПриемника = СтрокаНастроек.Приемник;
		Если ЗначениеЗаполнено(СтрокаНастроек.Приемник) Тогда
			ЗначениеПриемникаЗаполнено = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Попытка
		ИмяНастройкиИзСтроки = СтрокаНастроек[ИмяНастройки];
	Исключение
		ИмяНастройки = ?(ИмяНастройки = "ТипТранзакции", "Кнопка", "ТипТранзакции");
	КонецПопытки;
	Если ЗначениеЗаполнено(СтрокаНастроек[ИмяНастройки]) = Ложь Тогда
		Если ТипЗнч(СтрокаНастроек.Родитель) = Тип("СтрокаДереваЗначений") Тогда
			Если ЗначениеИсточникаЗаполнено = Истина
				ИЛИ ЗначениеПриемникаЗаполнено = Истина
				И ЗначениеЗаполнено(Результат) = Ложь Тогда
				Результат = Результат + Символы.ПС + "Ошибка в коде настроек в строке вложенность: " + Строка(СтрокаНастроек.Уровень()) + Символы.ПС + 
				"Источник [" + ИмяИсточника + "], " + 
				"Приемник [" + ИмяПриемника + "]" + Символы.ПС
				;
			КонецЕсли;
			Результат = ОписаниеСтрокиГибкихНастроек(СтрокаНастроек.Родитель, "", Результат);
		Иначе
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаНастроек[ИмяНастройки]) = Истина Тогда
		Результат = Результат + "Место в гибких настройках: " + Символы.ПС + 
		"Действие [" + СтрокаНастроек[ИмяНастройки] + "], " + 
		"Источник [" + ИмяИсточника + "], " + 
		"Приемник [" + ИмяПриемника + "]";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура СкорректироватьДокументыПоступления(МассивДокументов, МассивЛогаСобытий) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(ЭКОМ_ДокументыДокументыСвязанные.ДокументСвязанный, НЕОПРЕДЕЛЕНО) КАК ПоступлениеТоваровУслуг,
	|	ЭКОМ_Документы.Ссылка КАК ДокументЭКОМ_ЮЗД,
	|	ЕСТЬNULL(ЭКОМ_Документы.Документ1С, НЕОПРЕДЕЛЕНО) КАК ДокументСЧФ
	|ИЗ
	|	Документ.ЭКОМ_Документы КАК ЭКОМ_Документы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭКОМ_Документы.ДокументыСвязанные КАК ЭКОМ_ДокументыДокументыСвязанные
	|		ПО ЭКОМ_Документы.Ссылка = ЭКОМ_ДокументыДокументыСвязанные.Ссылка
	|ГДЕ
	|	ЭКОМ_Документы.Ссылка В(&МассивДокументов)";
	
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);	
	РезультатЗапроса = Запрос.Выполнить();	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ТекстЛогаСобытий = "";
		ТекстОшибки      = "";
		
		ЭКОМДок = Выборка.ДокументЭКОМ_ЮЗД; 
		
		ПредстДокЭКОМ = "ЭКОМ док № " + СокрЛП(ЭКОМДок.Номер) + " от " + Формат(ЭКОМДок.Дата, "ДФ=dd.MM.yyyy");
		
		ПоступлениеСсылка = Выборка.ПоступлениеТоваровУслуг;
		ДокументСЧФ       = Выборка.ДокументСЧФ;
		
		Если НЕ ЗначениеЗаполнено(ПоступлениеСсылка) Тогда
			ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "") +
			" Не найден документ поступление товаров и услуг по контрагенту - "
			+ ЭКОМДок.Контрагент.Наименование + ", номером по данным Супермаг - " + ЭКОМДок.НакладнаяНомер
			+ """ и датой СЧФ """ + Формат(ЭКОМДок.СЧФДата, "ДФ=dd.MM.yyyy") + """."; 
			
		Иначе
			
			// Проверка соответствие данных документов.
			СуммаСНДС 	= ПоступлениеСсылка.Товары.Итог("Сумма") + ?(ПоступлениеСсылка.СуммаВключаетНДС, 0, ПоступлениеСсылка.Товары.Итог("СуммаНДС"));
			СуммаНДС 	= ПоступлениеСсылка.Товары.Итог("СуммаНДС");
			СуммаБезНДС = СуммаСНДС - СуммаНДС;
			
			СоздатьСчетФактуру        = Ложь;
			КорректироватьПоступление = Ложь;
			
			РазницаСуммСНДС      = СуммаСНДС - ЭКОМДок.СуммаДокументаВсего;
			РазностьСуммПоМодулю = Макс(РазницаСуммСНДС, -РазницаСуммСНДС);
			
			Если РазностьСуммПоМодулю = 0 Тогда
				СоздатьСчетФактуру = Истина;
			Иначе
				КорректироватьПоступление = Истина;
				СоздатьСчетФактуру        = Истина;		
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ДокументСЧФ)Тогда		
				СоздатьСчетФактуру = Ложь;			 		
			КонецЕсли;
			
			ЭКОМДокОбъект = ЭКОМДок.ПолучитьОбъект();
			Если КорректироватьПоступление Тогда
				// Изменение поступления
				
				ПоступлениеОбъект = ПоступлениеСсылка.ПолучитьОбъект();
				
				Если ПоступлениеОбъект.Заблокирован() Тогда
					ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
					+ "Не удалось изменить сумму документа " + ПоступлениеСсылка + ". Различие в документе и в поступившем УПД составляет "
					+ РазностьСуммПоМодулю + " руб. Необходимо откорректировать сумму документа и связанного счета-фактуры вручную.";
				КонецЕсли;					
				
				Попытка
					ПоступлениеОбъект.Заблокировать();
				Исключение				
				КонецПопытки;
				
				Для Каждого Строка Из ПоступлениеОбъект.Товары Цикл
					
					Сумма1С = 0;
					
					СтруктураДляПоиска = Новый Структура;
					СтруктураДляПоиска.Вставить("Номенклатура", Строка.Номенклатура);
					НайденныеСтроки = ЭКОМДок.ТЧ_Товары.НайтиСтроки(СтруктураДляПоиска);
					Если НЕ НайденныеСтроки.Количество() = 0 Тогда
						СтрокаЭКОМ = НайденныеСтроки[0];
						Если ПоступлениеОбъект.СуммаВключаетНДС Тогда			   
							Сумма1С = СтрокаЭКОМ.Сумма_с_НДС;
						Иначе				         
							Сумма1С = СтрокаЭКОМ.Сумма;
						КонецЕсли;
						Строка.СуммаНДС  = СтрокаЭКОМ.СуммаНДС;
						Если Строка.Количество = 0 Тогда
							Строка.Цена = 0;
						Иначе
							Строка.Цена = Сумма1С / Строка.Количество;
						КонецЕсли;
						
						Строка.Сумма = Сумма1С;		
					КонецЕсли;	
					
				КонецЦикла;
				
				Попытка
					
					Если ПоступлениеОбъект.Проведен Тогда
						ПоступлениеОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения); // Необходимо для перезаписи движений в РС Хозрасчетный
						ПоступлениеОбъект.Записать(РежимЗаписиДокумента.Проведение);
					Иначе
						ПоступлениеОбъект.Записать();
					КонецЕсли;
					
					ЭКОМДокОбъект.Комментарий = "Изменен документ " + Строка(ПоступлениеСсылка) + ". Различие в документе и в поступившем УПД составляет "
					+ РазностьСуммПоМодулю + " руб.";
					
					ТекстЛогаСобытий = ЭКОМДокОбъект.Комментарий + " - " + ПредстДокЭКОМ;
					
				Исключение
					ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "")
					+ "Не удалось изменить сумму документа " + Строка(ПоступлениеСсылка) + ". Различие в документе и в поступившем УПД составляет "
					+ РазностьСуммПоМодулю + " руб. Необходимо откорректировать сумму документа и связанного счета-фактуры вручную.";
				КонецПопытки;
				
				ПоступлениеОбъект.Разблокировать();
				
			КонецЕсли;
			
			Если СоздатьСчетФактуру Тогда
				// Создание счет фактуры
				ДокументСЧФ = Документы.СчетФактураПолученный.СоздатьДокумент();
				
				ДокументСЧФ.Заполнить(ПоступлениеСсылка);		
				ДокументСЧФ.Дата                    = ЭКОМДок.СЧФДата;	
				ДокументСЧФ.НомерВходящегоДокумента = ЭКОМДок.СЧФНомер;
				ДокументСЧФ.ДатаВходящегоДокумента  = ЭКОМДок.СЧФДата;
				
				ДокументСЧФ.КодСпособаПолучения = 2;
				
				Попытка
					ДокументСЧФ.Записать(РежимЗаписиДокумента.Проведение);
					ЭКОМДокОбъект.Документ1С = ДокументСЧФ.Ссылка;
				Исключение		
				КонецПопытки;		
				
			КонецЕсли;											
			
			ЭКОМДокОбъект.Записать();
			
		КонецЕсли;
		
		СтруктураРегистраСобытий = Новый Структура;	
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			
			СтруктураРегистраСобытий.Вставить("ТекстОшибки", ТекстОшибки);
			ЭКОМ_Объекты_События_Записать(ЭКОМДок.Ссылка, ЭКОМДок.ВидДокумента, СтруктураРегистраСобытий);
			
		Иначе
			
			СтруктураРегистраСобытий.Вставить("ТекстОшибки", "");
			ЭКОМ_Объекты_События_Записать(ЭКОМДок.Ссылка, ЭКОМДок.ВидДокумента, СтруктураРегистраСобытий, Истина);
			
		КонецЕсли;
		
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Информация, "Корректировка документов поступления");
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработатьПовторно(МассивДокументов, МассивЛогаСобытий) Экспорт
	
	КэшированныеЗначения = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЭКОМ_Документы.Ссылка КАК ДокументЭКОМ_ЮЗД,
	|	ЭКОМ_Объекты_События.СтруктураФайла,
	|	ЭКОМ_Документы.СЧФНомер,
	|	ЭКОМ_Документы.СЧФДата
	|ИЗ
	|	Документ.ЭКОМ_Документы КАК ЭКОМ_Документы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_События
	|		ПО (ЭКОМ_Документы.Ссылка = (ВЫРАЗИТЬ(ЭКОМ_Объекты_События.Документ_Основание КАК Документ.ЭКОМ_Документы)))
	|			И ЭКОМ_Документы.ВидДокумента = ЭКОМ_Объекты_События.ВидДокумента
	|ГДЕ
	|	ЭКОМ_Документы.Ссылка В(&МассивДокументов)";
	
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);	
	РезультатЗапроса = Запрос.Выполнить();	
	Выборка = РезультатЗапроса.Выбрать();
	
	ИмяСобытия = "Обработать повторно ЮЗД";
	УспешноОбработаннныхДокументов = 0;
	Пока Выборка.Следующий() Цикл
		
		ЭКОМДок = Выборка.ДокументЭКОМ_ЮЗД;
		ЭКОМДокОбъект = Выборка.ДокументЭКОМ_ЮЗД.ПолучитьОбъект();
		СтруктураДокумента = Выборка.СтруктураФайла.Получить();
		ТекстОшибки  = "";
		
		ПредставлениеДокументаXML = "Счет-фактура XML № " + Выборка.СЧФНомер + " от " + Выборка.СЧФДата;
		
		ЭКОМДокОбъект.ТекстОшибки = ""; // Очищаем ошибки документа
		ЭКОМДокОбъект.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.ПустаяСсылка(); // Обнуляем статус документ
		
		ВыполнитьДополнительныеДействия(ЭКОМДокОбъект, "Входящий ЮЗД - универсальный передаточный документ",
		СтруктураДокумента,
		МассивЛогаСобытий,
		ТекстОшибки,
		,
		,
		,
		,
		КэшированныеЗначения);
				
		СтруктураРегистраСобытий = Новый Структура;
		ДокументОбработан = ПроверитьОбработкуДокумента(ТекстОшибки, ЭКОМДокОбъект, СтруктураДокумента, СтруктураРегистраСобытий, ПредставлениеДокументаXML, МассивЛогаСобытий);
		Если ДокументОбработан = Ложь Тогда
			ТекстЛогаСобытий = ПредставлениеДокументаXML + " не обработан!";
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

			Продолжить;	
		Иначе
			УспешноОбработаннныхДокументов = УспешноОбработаннныхДокументов + 1;
		КонецЕсли;	
	КонецЦикла;
	
	ТекстЛогаСобытий = "Всего документов = " + МассивДокументов.Количество() + " из них успешно обработанных = " + УспешноОбработаннныхДокументов + ".";
	ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Успешно, ИмяСобытия);
	МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

КонецПроцедуры

// Функция "расщепляет" строку на подстроки, используя заданный 
//		разделитель. Разделитель может иметь любую длину. 
//		Если в качестве разделителя задан пробел, рядом стоящие пробелы 
//		считаются одним разделителем, а ведущие и хвостовые пробелы параметра Стр
//		игнорируются.
//		Например, 
//		Эком_РазложитьСтрокуВМассивПодстрок(",строка 1,,,строка 2", ",") возвратит массив значений из пяти элементов, 
//		три из которых - пустые строки, а 
//		Эком_РазложитьСтрокуВМассивПодстрок(" строка1   строка 2", " ") возвратит массив значений из двух элементов
//
//	Параметры: 
//		Стр - 			строка, которую необходимо разложить на подстроки. 
//						Параметр передается по значению.
//		Разделитель - 	строка-разделитель, по умолчанию - запятая.
//
//
//	Возвращаемое значение:
//		массив значений, элементы которого - подстроки
//
Функция Эком_РазложитьСтрокуВМассивПодстрок(Знач Стр, Разделитель = ",", ДелатьСокрЛП = Истина, ПропускатьПустыеЗначения = Истина) Экспорт
	
	МассивСтрок = Новый Массив();
	Если Разделитель = " " Тогда
		Стр = СокрЛП(Стр);
		Пока Истина Цикл
			Поз = Найти(Стр,Разделитель);
			Если Поз=0 Тогда
				ТекущееЗначение = ?(ДелатьСокрЛП = Истина, СокрЛП(Стр), Стр);
				МассивСтрок.Добавить(ТекущееЗначение);
				Возврат МассивСтрок;
			КонецЕсли;
			ТекущееЗначение = Лев(Стр,Поз-1);
			ТекущееЗначение = ?(ДелатьСокрЛП = Истина, СокрЛП(ТекущееЗначение), ТекущееЗначение);
			МассивСтрок.Добавить(ТекущееЗначение);
			Стр = СокрЛ(Сред(Стр,Поз));
		КонецЦикла;
	ИначеЕсли Разделитель = "" Тогда
		Для Поз = 1 По СтрДлина(Стр) Цикл
			МассивСтрок.Добавить(Сред(Стр, Поз, 1));
		КонецЦикла;
		Возврат МассивСтрок;
	Иначе
		ДлинаРазделителя = СтрДлина(Разделитель);
		Пока Истина Цикл
			Поз = Найти(Стр,Разделитель);
			Если Поз=0 Тогда
				ТекущееЗначение = ?(ДелатьСокрЛП = Истина, СокрЛП(Стр), Стр);
				МассивСтрок.Добавить(ТекущееЗначение);
				Возврат МассивСтрок;
			КонецЕсли;
			ТекущееЗначение = Лев(Стр,Поз-1);
			ТекущееЗначение = ?(ДелатьСокрЛП = Истина, СокрЛП(ТекущееЗначение), ТекущееЗначение);
			МассивСтрок.Добавить(ТекущееЗначение);
			Стр = Сред(Стр,Поз+ДлинаРазделителя);
		КонецЦикла;
	КонецЕсли;
	Результат = МассивСтрок;
КонецФункции

// Позволяет получить список реквизитов документа, необходимых для дальнейшей
// передачи в обработку заполнения цен и валют.
//
// Параметры: 
//  ДокументОбъект      - объект документа, для реквизитов будет производится заполнение
//  СтруктураИсключений - структура, в которую передаются те исключения, которые или невозможно
//                        определить по метаданным, или, несмотря ни на что, нельзя включать в
//                        возвращаемую структуру.
//                        В структуре - ключ = имя реквизита, значение = истина (необходимо добавить
//                        в структуру) или ложь (нельзя добавлять в структуру)
//
// Возвращаемое значене:
//  Сформированная структура реквизитов документа.
//
Функция Эком_ПолучитьСтруктуруРеквизитовДокументаДляЦенообразования(ДокументОбъект, СтруктураИсключений = Неопределено) Экспорт
	
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	
	// Зададим, какие реквизиты вообще нам могут быть нужны.
	СтруктураВозможныхВариантовРеквизитов = Новый Структура;
	СтруктураВозможныхВариантовРеквизитов.Вставить("ТипЦен");
	СтруктураВозможныхВариантовРеквизитов.Вставить("ВалютаДокумента");
	СтруктураВозможныхВариантовРеквизитов.Вставить("КурсДокумента");
	СтруктураВозможныхВариантовРеквизитов.Вставить("КратностьДокумента");
	СтруктураВозможныхВариантовРеквизитов.Вставить("КурсВзаиморасчетов");
	СтруктураВозможныхВариантовРеквизитов.Вставить("КратностьВзаиморасчетов");
	СтруктураВозможныхВариантовРеквизитов.Вставить("УчитыватьНДС");
	СтруктураВозможныхВариантовРеквизитов.Вставить("СуммаВключаетНДС");
	СтруктураВозможныхВариантовРеквизитов.Вставить("ИспользоватьПлановуюСебестоимость");
	СтруктураВозможныхВариантовРеквизитов.Вставить("РегистрироватьЦеныПоставщика");
	СтруктураВозможныхВариантовРеквизитов.Вставить("УсловиеПродаж");
	
	// Зададим, какие реквизиты надо редактировать.
	СтруктураРеквизитовДокумента = Новый Структура;
	Для Каждого ТекущийЭлементСтруктуры Из СтруктураВозможныхВариантовРеквизитов Цикл
		НужныйРеквизитДокумента = ТекущийЭлементСтруктуры.Ключ;
		Если Эком_ЕстьРеквизитДокумента(НужныйРеквизитДокумента, МетаданныеДокумента) Тогда
			СтруктураРеквизитовДокумента.Вставить(НужныйРеквизитДокумента);
		КонецЕсли;
	КонецЦикла;
	
	// Теперь проверим исключения.
	Если СтруктураИсключений <> Неопределено Тогда
		Для Каждого ТекущийЭлементСтруктуры Из СтруктураИсключений Цикл
			Если ТекущийЭлементСтруктуры.Значение Тогда // надо добавить реквизит, если его еще нет
				СтруктураРеквизитовДокумента.Вставить(ТекущийЭлементСтруктуры.Ключ);
			Иначе // надо удалить реквизит, если он есть
				СтруктураРеквизитовДокумента.Удалить(ТекущийЭлементСтруктуры.Ключ);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат СтруктураРеквизитовДокумента;
	
КонецФункции // Эком_ПолучитьСтруктуруРеквизитовДокументаДляЦенообразования()

// Функция предназначена для преобразования номера документа.
//
// Параметры:
//  Документ - (ДокументСсылка), документ, чей номер надо получить для печати.
//
// Возвращаемое значение.
//  Строка - номер документа для печати
//
Функция Эком_ПолучитьНомерНаПечать(Документ)
	
	// Используется при подписке - записи документов
	Возврат Вычислить("ЭКОМ_ОбщегоНазначения.ЭКОМ_ПолучитьНомерНаПечать(Документ)");
	
КонецФункции // Эком_ПолучитьНомерНаПечать()

// Отсекает префикс и лидирующие нули от строки, оставляя только числа
//
// Параметры:
//  ВхНомер - Строка - номер, который необходимо обработать
//
// Возвращаемое значение.
//  Строка - номер без префиксов и нулей
//
Функция ПолучитьНомерБезПрефиксовИНулей(ВхНомер) Экспорт 
	
	НомерБезПрефиксовИНулей = ВхНомер;
	НомерБезПрефиксовИНулей = Врег(СокрЛП(НомерБезПрефиксовИНулей)); 
	
	Буквы = Врег("абвгдеёжзийклмнопрстуфхцчшщъыьэюя-0");
	
	Пока Найти(Буквы, Лев(НомерБезПрефиксовИНулей, 1)) > 0 Цикл
		НомерБезПрефиксовИНулей = Сред(НомерБезПрефиксовИНулей, 2);	
	КонецЦикла;
	
	Возврат НомерБезПрефиксовИНулей;
	
КонецФункции // ПолучитьНомерБезПрефиксовИНулей()

// Позволяет определить есть ли среди реквизитов шапки документа
// реквизит с переданным именем.
//
// Параметры: 
//  ИмяРеквизита - строковое имя искомого реквизита, 
//  МетаданныеДокумента - объект описания метаданных документа, среди реквизитов которого производится поиск.
//
// Возвращаемое значение:
//  Истина - нашли реквизит с таким именем, Ложь - не нашли.
//
Функция Эком_ЕстьРеквизитДокумента(ИмяРеквизита, МетаданныеДокумента) Экспорт
	
	Если МетаданныеДокумента.Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли; 
	
КонецФункции // Эком_ЕстьРеквизитДокумента()

