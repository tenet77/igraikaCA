				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
		Если ЭКОМ_ОбменПоставщик Тогда
			
			СписокТипов = Новый Структура;
			СписокТипов.Вставить("DP_PDPOL"             , Перечисления.ЭКОМ_ВидыДокументов.DP_PDPOL_02);
			СписокТипов.Вставить("ON_SCHFDOPPOK_11"        , Перечисления.ЭКОМ_ВидыДокументов.ON_SCHFDOPPOK_11); //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _11]
			СписокТипов.Вставить("ON_NSCHFDOPPOK_11"       , Перечисления.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPOK_11); //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _11]
			СписокТипов.Вставить("ON_NSCHFDOPPOKMARK_11"   , Перечисления.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPOKMARK_11); //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _11]
			СписокТипов.Вставить("ON_NSCHFDOPPOKPROS_11"   , Перечисления.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPOKPROS_11); //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _11]
			СписокТипов.Вставить("ON_KORSCHFDOPPOK_11"     , Перечисления.ЭКОМ_ВидыДокументов.ON_KORSCHFDOPPOK_11); //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _11]
			СписокТипов.Вставить("ON_NKORSCHFDOPPOK_11"    , Перечисления.ЭКОМ_ВидыДокументов.ON_NKORSCHFDOPPOK_11); //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _11]
			СписокТипов.Вставить("ON_NKORSCHFDOPPOKMARK_11", Перечисления.ЭКОМ_ВидыДокументов.ON_NKORSCHFDOPPOKMARK_11); //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _11]
			СписокТипов.Вставить("ON_NKORSCHFDOPPOKPROS_11", Перечисления.ЭКОМ_ВидыДокументов.ON_NKORSCHFDOPPOKPROS_11); //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _11]
