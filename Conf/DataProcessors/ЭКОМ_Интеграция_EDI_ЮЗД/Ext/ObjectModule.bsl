		Если xmlВалюта = "RUB" Тогда
			ВалютаСсылка = Справочники.Валюты.НайтиПоКоду(643);
			
		ИначеЕсли xmlВалюта = "KZT" Тогда
			ВалютаСсылка = Справочники.Валюты.НайтиПоКоду(398);	
			
		ИначеЕсли xmlВалюта = "UAH" Тогда
			ВалютаСсылка = Справочники.Валюты.НайтиПоКоду(980);
			
		ИначеЕсли xmlВалюта = "USD" Тогда
			ВалютаСсылка = Справочники.Валюты.НайтиПоКоду(840);
			
		ИначеЕсли xmlВалюта = "EUR" Тогда
			ВалютаСсылка = Справочники.Валюты.НайтиПоКоду(978);
			
		ИначеЕсли xmlВалюта = "MDL" Тогда
			ВалютаСсылка = Справочники.Валюты.НайтиПоКоду(498);
			
		ИначеЕсли xmlВалюта = "BYR" Тогда
			ВалютаСсылка = Справочники.Валюты.НайтиПоКоду(974);
			
		Иначе
			ВалютаСсылка = Справочники.Валюты.НайтиПоКоду(643);
			
