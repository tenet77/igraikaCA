Функция ЭКОМ_ТочкиДоставки_Запись(п_Объект, п_Структура) Экспорт
	
	// # Пример
	// п_Структура = Новый Структура;
	// п_Структура.Вставить("GLN",   1234567890);
	
	МенеджерЗаписи = РегистрыСведений.ЭКОМ_ТочкиДоставки.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Объект = п_Объект;	
	МенеджерЗаписи.Прочитать();
	
	Если НЕ МенеджерЗаписи.Выбран() Тогда // Если запись не существует то записать	
		МенеджерЗаписи.Объект = п_Объект;
	КонецЕсли;
	
	Для Каждого Элемент Из п_Структура Цикл
		Если ЗначениеЗаполнено(Элемент.Значение) ИЛИ Элемент.Значение = "" Тогда
			МенеджерЗаписи[Элемент.Ключ] = Элемент.Значение; 	
		КонецЕсли;	
	КонецЦикла;
	
	Результат = Неопределено;
	Попытка
		МенеджерЗаписи.Записать();
		Результат = Истина;
	Исключение
		Ошибка = ОписаниеОшибки();
		Результат = "Ошибка записи в [РегистрыСведений.ЭКОМ_ТочкиДоставки] " + Символы.ПС + Ошибка;
	КонецПопытки;
	
	Возврат Результат;
КонецФункции

Функция м_ADO_ТочкаДоставки_Найти_По_Реквизиту(пADO_Строка_Подключения, пРеквизит_Имя, пРеквизит_пЗначение, пТочкаДоставки, пТЗ_Данные = "") Экспорт
	
	
	лСоединение = "";
	Если м_ADO_Подключить( пADO_Строка_Подключения, 5, 30, лСоединение ) <> 1 Тогда
		Сообщить( "Ошибка при подключении к ADO (157).", СтатусСообщения.Важное );
		Возврат 0;
	КонецЕсли;
	
	лТекст_Запроса = "SELECT
	|  _Exite_Spr_Tochki_Dostavki._ID,
	|  _Exite_Spr_Tochki_Dostavki.GLN
	|FROM
	|  _Exite_Spr_Tochki_Dostavki AS _Exite_Spr_Tochki_Dostavki
	|WHERE
	|  _Exite_Spr_Tochki_Dostavki." + пРеквизит_Имя + " = '" + пРеквизит_пЗначение + "'
	|";
	
	лРекордСет = Неопределено;
	Если м_ADO_Запрос_Выполнить( лСоединение, лТекст_Запроса, лРекордСет ) <> 1 Тогда
		Сообщить( "Ошибка при выполнении запроса при поиске точки доставки (158).", СтатусСообщения.Важное );
		Возврат 0;
	КонецЕсли;
	
	лТЗ_Данные = "";
	Если м_ADO_RS_ТЗ( лРекордСет, лТЗ_Данные ) <> 1 Тогда
		Сообщить( "Ошибка при заполнении ТЗ при поиске точки доставки (159).", СтатусСообщения.Важное );
		Возврат 0;
	КонецЕсли;
	
	Если лТЗ_Данные.Количество() = 0 Тогда
		Возврат Неопределено;
	Иначе
		Возврат лТЗ_Данные[0].GLN
	КонецЕсли;
	
КонецФункции

