						ПоддерживаемыеРасширенияCONDRA = ПоддерживаемыеРасширенияCONDRA();
						ПоддерживаемыеРасширенияCONDRA.Добавить("bin");
						
						Для Каждого Расширение Из ПоддерживаемыеРасширенияCONDRA Цикл
							Если ЭлСтруктураФайла.Свойство("ИмяФайла" + Расширение) = Истина Тогда
								ФайлПолноеИмя    = ВременныйКаталог + ЭлСтруктураФайла["ИмяФайла" + Расширение];
