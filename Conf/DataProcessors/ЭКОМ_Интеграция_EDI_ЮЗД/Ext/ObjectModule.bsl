					ТЗСтруктур.Колонки.Добавить("ИмяФайлаXML");
					
					Для Каждого Расширение Из ПоддерживаемыеРасширенияCONDRA() Цикл
						ТЗСтруктур.Колонки.Добавить("АдресФайла" + Расширение);	
