								ИЛИ ТипДокумента = "ON_NSCHFDOPPRPROS_01"   //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _01. 2 этап]
								ИЛИ ТипДокумента = "ON_NSCHFDOPPOK_11"      //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _11]
								ИЛИ ТипДокумента = "ON_NSCHFDOPPOKMARK_11"  //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _11]
								ИЛИ ТипДокумента = "ON_NSCHFDOPPOKPROS_11"  //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _11]
								ИЛИ ТипДокумента = "ON_SCHFDOPPOK_11"       //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _11]
								ИЛИ ТипДокумента = "ON_KORSCHFDOPPOK_11"    //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _11]
								ИЛИ ТипДокумента = "RETANN"
								ИЛИ ТипДокумента = "RETINS"
								ИЛИ ТипДокумента = "DP_OTORG1"
								ИЛИ ТипДокумента = "DP_OTORG2" 
								ИЛИ ТипДокумента = "DRVGOV_02_Входящий" 
