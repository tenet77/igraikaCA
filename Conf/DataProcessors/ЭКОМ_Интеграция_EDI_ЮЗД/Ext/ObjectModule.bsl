			|ГДЕ
			|	ЭКОМ_ЦепочкиДокументовПокупателя.СтатусЮЗД = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_Статусы.ПустаяСсылка)";
			
			РезультатЗапроса = Запрос.Выполнить();	
			Выборка = РезультатЗапроса.Выбрать();		
