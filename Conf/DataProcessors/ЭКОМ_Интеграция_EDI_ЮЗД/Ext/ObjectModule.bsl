Функция СформироватьДокументыXML(МассивСтрок, МассивЛогаСобытий, ЭтоРегламентноеЗадание, ТипДокумента, ПодписатьФайл, НомерИсправления = "") Экспорт
	
	МассивСтруктур = Новый Массив;
	
	ДанныеПоКолонкам            = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьДанныеПоКолонкамИсточника()");
	ДанныеПоИсходящимНастройкам = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьДанныеПоИсходящимНастройкам(ДанныеПоКолонкам, ТипДокумента, МассивЛогаСобытий)");
	
	ИсходящееДерево       = ДанныеПоИсходящимНастройкам["ИсходящееДерево"].Получить();
	ИмяДокументаИсточника = ДанныеПоИсходящимНастройкам["ИмяДокументаИсточника"];
	
	ИмяСобытия = "Выполнение гибких настроек " + ТипДокумента;
	Если ИсходящееДерево.Строки.Количество() = 0 Тогда
		ТекстЛогаСобытий = "Для данного типа транзакции отсутствует шаблон.";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		Возврат МассивСтруктур;
	ИначеЕсли ИсходящееДерево.Строки.Количество() > 1 Тогда
		ТекстЛогаСобытий = "Для данного типа транзакции найдено более одного используемого шаблона. Отправка документов не будет выполнена.";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		Возврат МассивСтруктур;
	КонецЕсли;
	
	МассивДок = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьДокументыДляСозданияШаблона(МассивСтрок, ИмяДокументаИсточника, ТипДокумента, МассивЛогаСобытий)");
	
	Если Не МассивДок.Количество()=0 Тогда	
		Ошибка     = ПолучитьСтруктуруОшибки();
		ПолучитьДанныеДокументов(ИсходящееДерево, МассивДок, НомерИсправления, МассивЛогаСобытий, Ошибка);
		
		Если Ошибка.ЕстьОшибка Тогда
			Возврат МассивСтруктур;
		КонецЕсли;
		
		МассивСтруктур = СозданиеДокументаПоШаблонуXML(ИсходящееДерево, ТипДокумента, МассивЛогаСобытий, ЭтоРегламентноеЗадание, ПодписатьФайл);
		
	КонецЕсли;
	
	Возврат МассивСтруктур; 
	
КонецФункции

Процедура ОчиститьИсториюПоОтпрДокументам(ТипДокумента, МассивОтправленныхДок)
	
	Если ТипДокумента = "WHGOV_01_Исходящий" Тогда		
		
		МассивВидовДокументов = Новый Массив;
		МассивВидовДокументов.Добавить(Перечисления.ЭКОМ_ВидыДокументов.WHGOV_01_Исходящий);
		МассивВидовДокументов.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DRVGOV_02_Входящий);
		МассивВидовДокументов.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DRVGOU_03_Входящий);
		МассивВидовДокументов.Добавить(Перечисления.ЭКОМ_ВидыДокументов.WHGOU_04_Исходящий);
		МассивВидовДокументов.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DRVGPU_07_Входящий);
		МассивВидовДокументов.Добавить(Перечисления.ЭКОМ_ВидыДокументов.WHGPU_08_Входящий);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЭКОМ_Объекты_События.ВидДокумента,
		|	ЭКОМ_Объекты_События.Документ_Основание,
		|	ЭКОМ_Объекты_События.НаправлениеОбмена
		|ИЗ
		|	РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_События
		|ГДЕ
		|	ЭКОМ_Объекты_События.Документ_Основание В(&МассивОтправленныхДок)
		|	И ЭКОМ_Объекты_События.ВидДокумента В(&МассивВидовДокументов)";
		
		Запрос.УстановитьПараметр("МассивВидовДокументов", МассивВидовДокументов);
		Запрос.УстановитьПараметр("МассивОтправленныхДок", МассивОтправленныхДок);
		
		РезультатЗапроса = Запрос.Выполнить();			
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Пока Выборка.Следующий() Цикл
				
				МЗ_События = РегистрыСведений.ЭКОМ_Объекты_События.СоздатьМенеджерЗаписи();
				МЗ_События.Документ_Основание  = Выборка.Документ_Основание;
				МЗ_События.ВидДокумента        = Выборка.ВидДокумента;
				МЗ_События.Прочитать();
				МЗ_События.Удалить();
				
				НЗ_ЦепочкаДокументов = РегистрыСведений.ЭКОМ_ЦепочкиДокументовЭТРН.СоздатьНаборЗаписей();
				НЗ_ЦепочкаДокументов.Отбор.Накладная.Установить(Выборка.Документ_Основание);
				НЗ_ЦепочкаДокументов.Прочитать();
				
				Если НЕ НЗ_ЦепочкаДокументов.Количество() = 0 Тогда
					Для Каждого ЗаписьНабора Из НЗ_ЦепочкаДокументов Цикл
						ЗаписьНабора.Статус_DRVGOV_02 = Ложь; 
						ЗаписьНабора.Статус_DRVGOU_03 = Ложь;
						ЗаписьНабора.Статус_WHGOU_04  = Ложь;
						ЗаписьНабора.Статус_DRVGPU_07 = Ложь;
						ЗаписьНабора.Статус_WHGPU_08  = Ложь;
						ЗаписьНабора.СостояниеОбмена  = Перечисления.ЭКОМ_Статусы.ПустаяСсылка();
					КонецЦикла;	
					
					НЗ_ЦепочкаДокументов.Записать();
				КонецЕсли;				
			КонецЦикла;			 
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

Процедура ЭТРН_ВходящиеКвитанцииСоздатьЗапись(ТЗСтруктур, ДокументыШапка, МассивЛогаСобытий, НеНайденныеКвитанции) Экспорт
	
	// Запрос по шапке документов
	Запрос = Новый Запрос;	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДокументыШапка.ВидДокумента КАК ВидДокумента,
	|	ПОДСТРОКА(ДокументыШапка.Документ_СвЭТРН_ИдФайлПервичн, 1, 256) КАК ИдФайлПервичн,
	|	ПОДСТРОКА(ДокументыШапка.ИдФайл, 1, 256) КАК ИдФайл
	|ПОМЕСТИТЬ ДокументыШапка
	|ИЗ
	|	&ДокументыШапка КАК ДокументыШапка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЭКОМ_ЦепочкиДокументовЭТРН.Контрагент КАК Контрагент,
	|	ЭКОМ_ЦепочкиДокументовЭТРН.Организация КАК Организация,
	|	ДокументыШапка.ИдФайл КАК ИдФайл,
	|	ДокументыШапка.ВидДокумента КАК ВидДокумента,
	|	ДокументыШапка.ИдФайлПервичн КАК ИмяПостФайла,
	|	ЭКОМ_ЦепочкиДокументовЭТРН.Заказ.Дата КАК ЗаказДата,
	|	ЭКОМ_ЦепочкиДокументовЭТРН.Заказ.Номер КАК ЗаказНомер,
	|	ЭКОМ_ЦепочкиДокументовЭТРН.ДатаЭТРН КАК ДатаЭТРН,
	|	ЭКОМ_ЦепочкиДокументовЭТРН.НомерЭТРН КАК НомерЭТРН,
	|	ЭКОМ_ЦепочкиДокументовЭТРН.Накладная КАК Накладная,
	|	ЭКОМ_ЦепочкиДокументовЭТРН.ДокументЭКОМ КАК ДокументЭКОМ
	|ИЗ
	|	ДокументыШапка КАК ДокументыШапка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_ЦепочкиДокументовЭТРН КАК ЭКОМ_ЦепочкиДокументовЭТРН
	|		ПО ДокументыШапка.ИдФайлПервичн = ЭКОМ_ЦепочкиДокументовЭТРН.ИдФайлПервичн";
	
	Запрос.УстановитьПараметр("ДокументыШапка", ДокументыШапка);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ИмяСобытия = "Создание записи по ЭТРН квитанциям";
	Пока Выборка.Следующий() Цикл
		
		СтруктураДокумента = Неопределено;
		СтрокаТЗСтруктур = ТЗСтруктур.Найти(Выборка.ИдФайл, "ИдентификаторФайла");
		Если СтрокаТЗСтруктур = Неопределено Тогда			
			ТекстЛогаСобытий = "Не найдена структура документа - " + Строка(Выборка.ВидДокумента) + " с ИД = " + Выборка.ИдФайл;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Продолжить;
			
		Иначе		
			СтруктураДокумента = СтрокаТЗСтруктур.СтруктураДокумента;		
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.ДокументЭКОМ) Тогда
			ДокументОснование = Выборка.ДокументЭКОМ;
		Иначе		
			ДокументОснование = Выборка.Накладная;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ДокументОснование) Тогда	
			
			СтруктураДокумента.Вставить("Обработан"   , Ложь);
			СтруктураДокумента.Вставить("ТекстПричины", ""); // Текст причины не указываем, в итоговом сообщении укажем количество записанных квитанций в регистр ЭКОМ_Квитанции
			
			// Сохраняем в регистре ЭКОМ_Квитанции 
			МЗ = РегистрыСведений.ЭКОМ_Квитанции.СоздатьМенеджерЗаписи();
			МЗ.ВидДокумента  = СтруктураДокумента.ВидДокумента;
			МЗ.Идентификатор = СтруктураДокумента.ИдФайл;
			МЗ.Прочитать();
			
			Если НЕ МЗ.Выбран() Тогда
				МЗ.ВидДокумента  = СтруктураДокумента.ВидДокумента;
				МЗ.Идентификатор = СтруктураДокумента.ИдФайл;
			КонецЕсли;
			
			МЗ.ИдентификаторОснования = Выборка.ИмяПостФайла;		
			МЗ.СтруктураФайла = Новый ХранилищеЗначения(СтруктураДокумента, Новый СжатиеДанных(9));
			МЗ.ЭЦП            = СтрокаТЗСтруктур.ЭЦП;
			МЗ.ДатаЗаписи     = ТекущаяДата();
			МЗ.Записать();
			
			// Для архивирования добавляем в массив
			НеНайденныеКвитанции.Добавить(СтрокаТЗСтруктур.ИмяФайлаXML);
			НеНайденныеКвитанции.Добавить(СтрокаТЗСтруктур.ИмяФайлаПодписи);
			
		Иначе
			
			КомментарийПогрузки = "";
			СтруктураДокумента.Свойство("Документ_Подписи_ВодительПогруз_ФактСостГруза", КомментарийПогрузки);
			
			КомментарийВыгрузки = "";
			СтруктураДокумента.Свойство("Документ_Подписи_ВодительВыгруз_ФактСостГруза", КомментарийВыгрузки);
			
			Комментарий = "";
			Если ЗначениеЗаполнено(КомментарийПогрузки) Тогда
				Комментарий = КомментарийПогрузки;
			Иначе	
				Комментарий = КомментарийВыгрузки;
			КонецЕсли;
			
			СоответствиеПоВиду = Новый Соответствие;
			СоответствиеПоВиду.Вставить(Перечисления.ЭКОМ_ВидыДокументов.DRVGOV_02_Входящий, "Статус_DRVGOV_02");
			СоответствиеПоВиду.Вставить(Перечисления.ЭКОМ_ВидыДокументов.DRVGOU_03_Входящий, "Статус_DRVGOU_03");
			СоответствиеПоВиду.Вставить(Перечисления.ЭКОМ_ВидыДокументов.DRVGPV_06_Входящий, "Статус_DRVGPV_06");
			СоответствиеПоВиду.Вставить(Перечисления.ЭКОМ_ВидыДокументов.DRVGPU_07_Входящий, "Статус_DRVGPU_07");
			СоответствиеПоВиду.Вставить(Перечисления.ЭКОМ_ВидыДокументов.WHGPU_08_Входящий , "Статус_WHGPU_08");
			
			НаборЗаписей = РегистрыСведений.ЭКОМ_ЦепочкиДокументовЭТРН.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Накладная.Установить(Выборка.Накладная);
			НаборЗаписей.Отбор.ДокументЭКОМ.Установить(Выборка.ДокументЭКОМ);
			НаборЗаписей.Прочитать();	
			
			// Если существует документ в регистре
			Для Каждого НоваяЗапись Из НаборЗаписей Цикл
				НоваяЗапись[СоответствиеПоВиду[Выборка.ВидДокумента]] = Истина;
				
				Если ЗначениеЗаполнено(НоваяЗапись.Комментарий) 
					И ЗначениеЗаполнено(Комментарий) Тогда
					НоваяЗапись.Комментарий = НоваяЗапись.Комментарий + Символы.ПС + СокрЛП(Комментарий) + " " + Строка(Выборка.ВидДокумента);
				Иначе	
					НоваяЗапись.Комментарий = СокрЛП(Комментарий) + " " + Строка(Выборка.ВидДокумента);
				КонецЕсли;
				
			КонецЦикла;	
			
			// Записываем документ в первый раз
			Если НаборЗаписей.Количество() = 0 Тогда
				НоваяЗапись = НаборЗаписей.Добавить();
				НоваяЗапись.Организация   = Выборка.Организация;
				НоваяЗапись.Контрагент    = Выборка.Контрагент;
				НоваяЗапись.ДатаЭТРН      = Выборка.ДатаЭТРН;	
				НоваяЗапись.НомерЭТРН     = Выборка.НомерЭТРН;
				НоваяЗапись.ДокументЭКОМ  = Выборка.ДокументЭКОМ;
				НоваяЗапись.Накладная     = Выборка.Накладная;
				НоваяЗапись[СоответствиеПоВиду[Выборка.ВидДокумента]] = Истина;
			КонецЕсли;
			
			НаборЗаписей.Записать();
			
			СтруктураРегистраСобытий = Новый Структура;
			СтруктураРегистраСобытий.Вставить("ЗаказДата"        , Выборка.ЗаказДата);
			СтруктураРегистраСобытий.Вставить("ЗаказНомер"       , Выборка.ЗаказНомер);
			СтруктураРегистраСобытий.Вставить("ДатаЗаписи"       , ТекущаяДата());
			СтруктураРегистраСобытий.Вставить("Контрагент"       , Выборка.Контрагент);
			СтруктураРегистраСобытий.Вставить("Организация"      , Выборка.Организация);
			СтруктураРегистраСобытий.Вставить("НаправлениеОбмена", Перечисления.ЭКОМ_НаправлениеОбмена.Входящий);
			СтруктураРегистраСобытий.Вставить("ФайлИмя"          , СтрокаТЗСтруктур.ИмяФайлаXML);
			СтруктураРегистраСобытий.Вставить("ЭЦП"              , СтрокаТЗСтруктур.ЭЦП);
			СтруктураРегистраСобытий.Вставить("Идентификатор"    , СтруктураДокумента.ИдФайл);
			СтруктураРегистраСобытий.Вставить("ИдентификаторИспр", СтруктураДокумента.Документ_СвЭТРН_ИдФайлПервичн);
			СтруктураРегистраСобытий.Вставить("СтруктураФайла"   , Новый ХранилищеЗначения(СтруктураДокумента,  Новый СжатиеДанных(9)));
			
			// Удаляем файл с FTP
			СтруктураДокумента.Вставить("Обработан", Истина);
			СтруктураРегистраСобытий.Вставить("Статус", Перечисления.ЭКОМ_Статусы.Загружен);	
			ЭКОМ_Объекты_События_Записать(ДокументОснование, Выборка.ВидДокумента, СтруктураРегистраСобытий);
			
		КонецЕсли;
		
		СтруктураДокумента.Вставить("Организация", Выборка.Организация);
		СтрокаТЗСтруктур.СтруктураДокумента = СтруктураДокумента;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЭТРН_ОбработатьСтатусы(ТЗСтруктур, ДокументыШапка, МассивЛогаСобытий, НеНайденныеКвитанции) Экспорт
	
	// Запрос по шапке документов
	Запрос = Новый Запрос;	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПОДСТРОКА(ДокументыШапка.СведПолучФайл_ИдФайлПервичн, 1, 256) КАК ИдФайлПервичн,
	|	ПОДСТРОКА(ДокументыШапка.ИдФайл, 1, 256) КАК ИдФайл
	|ПОМЕСТИТЬ ДокументыШапка
	|ИЗ
	|	&ДокументыШапка КАК ДокументыШапка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДокументыШапка.ИдФайл КАК ИдФайл,
	|	ДокументыШапка.ИдФайлПервичн КАК ИмяПостФайла,
	|	ЭКОМ_ЦепочкиДокументовЭТРН.ДатаЭТРН КАК ДатаЭТРН,
	|	ЭКОМ_ЦепочкиДокументовЭТРН.Организация КАК Организация,
	|	ЭКОМ_ЦепочкиДокументовЭТРН.Контрагент КАК Контрагент,
	|	ЭКОМ_ЦепочкиДокументовЭТРН.НомерЭТРН КАК НомерЭТРН,
	|	ЭКОМ_ЦепочкиДокументовЭТРН.Накладная КАК Накладная,
	|	ЭКОМ_ЦепочкиДокументовЭТРН.ДокументЭКОМ КАК ДокументЭКОМ,
	|	ЭКОМ_Объекты_События.Документ_Основание КАК Документ_Основание,
	|	ЭКОМ_Объекты_События.ВидДокумента КАК ВидДокумента,
	|	ЭКОМ_ЦепочкиДокументовЭТРН.Статус_WHGOV_01 КАК Статус_WHGOV_01,
	|	ЭКОМ_ЦепочкиДокументовЭТРН.Статус_WHGOU_04 КАК Статус_WHGOU_04,
	|	ЭКОМ_ЦепочкиДокументовЭТРН.Статус_WHGPV_05 КАК Статус_WHGPV_05,
	|	ЭКОМ_ЦепочкиДокументовЭТРН.Статус_WHGPU_08 КАК Статус_WHGPU_08
	|ИЗ
	|	ДокументыШапка КАК ДокументыШапка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_ЦепочкиДокументовЭТРН КАК ЭКОМ_ЦепочкиДокументовЭТРН
	|		ПО ДокументыШапка.ИдФайлПервичн = ЭКОМ_ЦепочкиДокументовЭТРН.ИдФайлПервичн
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_События
	|		ПО ДокументыШапка.ИдФайлПервичн = ЭКОМ_Объекты_События.Идентификатор";
	
	Запрос.УстановитьПараметр("ДокументыШапка", ДокументыШапка);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ИмяСобытия = "Создание записи по статусам ЭТРН";
	Пока Выборка.Следующий() Цикл
		
		СтруктураДокумента = Неопределено;
		СтрокаТЗСтруктур = ТЗСтруктур.Найти(Выборка.ИдФайл, "ИдентификаторФайла");
		Если СтрокаТЗСтруктур = Неопределено Тогда
			ТекстЛогаСобытий = "Не найдена структура документа по статусу - с ИД = " + Выборка.ИдФайл;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

			Продолжить;
			
		Иначе		
			СтруктураДокумента = СтрокаТЗСтруктур.СтруктураДокумента;		
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Выборка.Документ_Основание) Тогда	
			
			СтруктураДокумента.Вставить("Обработан"   , Ложь);
			СтруктураДокумента.Вставить("ТекстПричины", ""); // Текст причины не указываем, в итоговом сообщении укажем количество записанных квитанций в регистр ЭКОМ_Квитанции
			
			// Сохраняем в регистре ЭКОМ_Квитанции 
			МЗ = РегистрыСведений.ЭКОМ_Квитанции.СоздатьМенеджерЗаписи();
			МЗ.ВидДокумента  = СтруктураДокумента.ВидДокумента;
			МЗ.Идентификатор = СтруктураДокумента.ИдФайл;
			МЗ.Прочитать();
			
			Если НЕ МЗ.Выбран() Тогда
				МЗ.ВидДокумента  = СтруктураДокумента.ВидДокумента;
				МЗ.Идентификатор = СтруктураДокумента.ИдФайл;
			КонецЕсли;
			
			МЗ.ИдентификаторОснования = Выборка.ИмяПостФайла;		
			МЗ.СтруктураФайла = Новый ХранилищеЗначения(СтруктураДокумента, Новый СжатиеДанных(9));
			МЗ.ЭЦП            = СтрокаТЗСтруктур.ЭЦП;
			МЗ.ДатаЗаписи     = ТекущаяДата();
			МЗ.Записать();
			
			// Для архивирования добавляем в массив
			НеНайденныеКвитанции.Добавить(СтрокаТЗСтруктур.ИмяФайлаXML);
			НеНайденныеКвитанции.Добавить(СтрокаТЗСтруктур.ИмяФайлаПодписи);
			
		Иначе
			
			СтатусОбработки = СтруктураДокумента.СведПолучФайл_СтатусОбработки;
			СведОбОшибке    = СтруктураДокумента.СведОбОшибке_Ошибка_;
			
			ТекстОшибки = "";		
			Если ЗначениеЗаполнено(СведОбОшибке) Тогда // Старый формат
				Для каждого Стр Из СведОбОшибке Цикл
					ТекстОшибки = ТекстОшибки + " " + Стр.СведОбОшибке_Ошибка_ТекстОш;			 
				КонецЦикла;		
			Иначе
				ТекстОшибки = СтруктураДокумента.СведОбОшибке_Ошибка_ТекстОш;
			КонецЕсли;
			
			Если СтатусОбработки = "ERR" Тогда
				ТекстОшибки = СтруктураДокумента.СведОбОперации;	
			КонецЕсли;
			
			Если Выборка.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.WHGOV_01_Исходящий 
				И (Выборка.Статус_WHGOU_04 = Ложь
				И Выборка.Статус_WHGOV_01 = Истина)  Тогда
				
				СостояниеОбмена = Перечисления.ЭКОМ_Статусы.Отправлен;	
				
			ИначеЕсли Выборка.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.WHGOU_04_Исходящий 
				И (Выборка.Статус_WHGOU_04 = Истина
				И Выборка.Статус_WHGOV_01 = Истина)  Тогда
				
				СостояниеОбмена = Перечисления.ЭКОМ_Статусы.ГотовКотправке;	
				
			ИначеЕсли Выборка.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.WHGPV_05_Исходящий
				И (Выборка.Статус_WHGPU_08 = Ложь
				И Выборка.Статус_WHGPV_05 = Истина) Тогда
				
				СостояниеОбмена = Перечисления.ЭКОМ_Статусы.Подтвержден;	
				
			ИначеЕсли Выборка.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.WHGPU_08_Исходящий
				И (Выборка.Статус_WHGPU_08 = Истина
				И Выборка.Статус_WHGPV_05 = Истина) Тогда
				
				СостояниеОбмена = Перечисления.ЭКОМ_Статусы.ДокументооборотЗавершен;	
			Иначе
				
				СостояниеОбмена = Перечисления.ЭКОМ_Статусы.НеОбработан;
				
			КонецЕсли;
			
			Если НЕ СостояниеОбмена = Перечисления.ЭКОМ_Статусы.НеОбработан Тогда
				
				Если СтатусОбработки = "2"
					ИЛИ СтатусОбработки = "ERR" Тогда
					СостояниеОбмена = Перечисления.ЭКОМ_Статусы.ОтклоненПолностью;
					Если НЕ ЗначениеЗаполнено(ТекстОшибки) Тогда
						ТекстОшибки = "Ошибка!";			
					КонецЕсли;
				КонецЕсли;
				
				НЗ = РегистрыСведений.ЭКОМ_ЦепочкиДокументовЭТРН.СоздатьНаборЗаписей();
				НЗ.Отбор.Накладная.Установить(Выборка.Накладная);
				НЗ.Отбор.ДокументЭКОМ.Установить(Выборка.ДокументЭКОМ);
				НЗ.Прочитать();	
				Для Каждого НоваяЗапись Из НЗ Цикл
					
					НоваяЗапись.СостояниеОбмена = СостояниеОбмена;
					НоваяЗапись.ТекстОшибки     = ТекстОшибки;
					
				КонецЦикла;
				НЗ.Записать();			
				
			КонецЕсли;
			
			// Удаляем файл с FTP
			СтруктураДокумента.Вставить("Обработан", Истина);
			
		КонецЕсли;
		
		СтруктураДокумента.Вставить("Организация", Выборка.Организация);
		СтрокаТЗСтруктур.СтруктураДокумента = СтруктураДокумента;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СоздатьЭКОМ_Док_WHGOU_04_Входящий(ТЗСтруктур, ДокументыШапка, пДокументыТабличнаяЧасть, МассивЛогаСобытий) Экспорт	
	
	КэшированныеЗначения = Неопределено;
	
	// Табличная часть заполняется в гибких настройках
	
	// Индентификатор отправителя и получателя берем с 3 символа чтобы убрать префикс оператора 
	// Запрос по шапке документов
	Запрос = Новый Запрос;	                               
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДокументыШапка.Документ_СвЭТРН_ДатаЭТРН КАК ДатаЭТРН,
	|	ПОДСТРОКА(ДокументыШапка.Документ_СвЭТРН_НомерЭТРН, 1, 250) КАК НомерЭТРН,
	|	ДокументыШапка.ВидДокумента КАК ВидДокумента,
	|	ПОДСТРОКА(ДокументыШапка.ИдФайл, 1, 256) КАК ИдФайл,
	|	ПОДСТРОКА(ДокументыШапка.Документ_СвЭТРН_ИдФайлПервичн, 1, 256) КАК ИдФайлПервичн,
	|	ПОДСТРОКА(ДокументыШапка.СвУчДокОбор_ИдГрузПол, 4, 256) КАК ИдентификаторОрганизации,
	|	ПОДСТРОКА(ДокументыШапка.СвУчДокОбор_ИдГрузОтпр, 4, 256) КАК ИдентификаторКонтрагента,
	|	ПОДСТРОКА(ДокументыШапка.СвУчДокОбор_ИдГрузПер, 4, 256) КАК ИдентификаторПеревозчика
	|ПОМЕСТИТЬ ДокументыШапка
	|ИЗ
	|	&ДокументыШапка КАК ДокументыШапка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДокументыШапка.ИдФайл КАК ИдФайл,
	|	ЕСТЬNULL(ЭКОМ_Документы.Ссылка, НЕОПРЕДЕЛЕНО) КАК ЭКОМДок,
	|	ЭКОМ_Документы.ПометкаУдаления КАК ПометкаУдаления,
	|	ЭКОМ_Документы.СтатусОбработкиДокумента КАК СтатусОбработкиДокумента,
	|	ЭКОМ_GLN_Организация.Объект КАК Организация,
	|	ЭКОМ_GLN_Контрагент.Объект КАК Контрагент,
	|	ЭКОМ_GLN_Перевозчик.Объект КАК Перевозчик
	|ИЗ
	|	ДокументыШапка КАК ДокументыШапка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Организация
	|		ПО ДокументыШапка.ИдентификаторОрганизации = ЭКОМ_GLN_Организация.Ид_ОЭД
	|			И (НЕ ЭКОМ_GLN_Организация.Объект ССЫЛКА Справочник.Контрагенты)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Контрагент
	|		ПО ДокументыШапка.ИдентификаторКонтрагента = ЭКОМ_GLN_Контрагент.Ид_ОЭД
	|			И (ЭКОМ_GLN_Контрагент.Объект ССЫЛКА Справочник.Контрагенты)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Перевозчик
	|		ПО ДокументыШапка.ИдентификаторПеревозчика = ЭКОМ_GLN_Перевозчик.Ид_ОЭД
	|			И (ЭКОМ_GLN_Контрагент.Объект ССЫЛКА Справочник.Контрагенты)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭКОМ_Документы КАК ЭКОМ_Документы
	|		ПО (ЭКОМ_Документы.ФайлНомер = ДокументыШапка.НомерЭТРН)
	|			И (НАЧАЛОПЕРИОДА(ЭКОМ_Документы.ФайлДата, ДЕНЬ) = НАЧАЛОПЕРИОДА(ДокументыШапка.ДатаЭТРН, ДЕНЬ))
	|			И (ЭКОМ_Документы.НомерТранзакции = ДокументыШапка.ИдФайлПервичн)
	|			И (ЭКОМ_Документы.ВидДокумента = ДокументыШапка.ВидДокумента)";
	Запрос.УстановитьПараметр("ДокументыШапка", ДокументыШапка);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ПроверкаНаДублирование = Новый Соответствие;
	
	ИмяСобытия = "Создание документа Docrobot-WHGOU_04";
	Пользователь = НайтиТекущегоПользователя();
	
	СоответствиеПоОрганизации = Новый Соответствие;
	СоответствиеПоКонтрагенту = Новый Соответствие;
	
	ИмяСобытия = "Создание документа Docrobot-WHGOU_04";
	Пока Выборка.Следующий() Цикл
		
		// Для проверки дублирования строк
		Если ПроверкаНаДублирование.Получить(Выборка.ИдФайл) = Неопределено Тогда
			ПроверкаНаДублирование.Вставить(Выборка.ИдФайл, "Строка добавлена");
		Иначе		
			ТекстЛогаСобытий = "Дубль данных, проверьте GLN организации, контрагента, точки доставки ИД документа - " + Выборка.ИдФайл;	
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Продолжить;
			
		КонецЕсли;
		
		// Получаем структуру документа
		пСтруктураДокумента = Неопределено;
		СтрокаТЗСтруктур = ТЗСтруктур.Найти(Выборка.ИдФайл, "ИдентификаторФайла");
		Если СтрокаТЗСтруктур = Неопределено Тогда			
			ТекстЛогаСобытий = "Не найдена структура документа с ИД = " + Выборка.ИдФайл;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

			Продолжить;
			
		Иначе
			
			пСтруктураДокумента = СтрокаТЗСтруктур.СтруктураДокумента;
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Выборка.Организация) Тогда
			
			Если ЗначениеЗаполнено(пСтруктураДокумента.Документ_СвЭТРН_ИнфВыгруз_GLNТочкиПолучат) Тогда
				xmlОрганизацияGLN = пСтруктураДокумента.Документ_СвЭТРН_ИнфВыгруз_GLNТочкиПолучат;
			Иначе	
				xmlОрганизацияGLN = пСтруктураДокумента.СвУчДокОбор_ИдГрузПол;
			КонецЕсли;				 
			СоответствиеПоОрганизации.Вставить("Организация_" + xmlОрганизацияGLN, xmlОрганизацияGLN);	
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Выборка.Контрагент) Тогда
			
			Если ЗначениеЗаполнено(пСтруктураДокумента.Документ_СвЭТРН_ИнфПогруз_GLNТочкиОтправ) Тогда
				xmlКонтрагентGLN = пСтруктураДокумента.Документ_СвЭТРН_ИнфПогруз_GLNТочкиОтправ;
			Иначе	
				xmlКонтрагентGLN = Выборка.СвУчДокОбор_ИдГрузОтпр;
			КонецЕсли;				 
			СоответствиеПоКонтрагенту.Вставить("Контрагент_" + xmlКонтрагентGLN, xmlКонтрагентGLN);	
			
		КонецЕсли;
		
		ПредставлениеДокументаXML = Строка(пСтруктураДокумента.ВидДокумента) + " № " + пСтруктураДокумента.Документ_СвЭТРН_НомерЭТРН 
		+ " от " + Формат(пСтруктураДокумента.Документ_СвЭТРН_ДатаЭТРН, "ДФ='dd.MM.yyyy ""г.""'");
		
		Если Выборка.ЭКОМДок = Неопределено Тогда
			ЭКОМДок = Документы.ЭКОМ_Документы.СоздатьДокумент();
		ИначеЕсли (Выборка.ПометкаУдаления = Истина 
			ИЛИ Выборка.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.НеОбработан) Тогда
			ЭКОМДок = Выборка.ЭКОМДок.ПолучитьОбъект();
			ЭКОМДок.ПометкаУдаления = ЛОЖЬ;
			ЭКОМДок.ТЧ_Товары.Очистить();
			// Очищение остальных табличных частей документов в гибких настроках при необходимости
		Иначе
			ТекстЛогаСобытий = ПредставлениеДокументаXML + " - ЭКОМ документ уже существует в 1С, номер = " + Выборка.ЭКОМДок.Номер + " от " + Выборка.ЭКОМДок.Дата;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Продолжить;
			
		КонецЕсли;
		
		// Шапка
		ЭКОМДок.Дата                      = ТекущаяДата();
		ЭКОМДок.Организация               = Выборка.Организация;	
		ЭКОМДок.Контрагент                = Выборка.Контрагент;
		ЭКОМДок.ТочкаДоставки             = Выборка.Перевозчик;
		ЭКОМДок.ИмяФайла                  = СтрокаТЗСтруктур.ИмяФайлаXML;
		ЭКОМДок.Ответственный             = Пользователь;
		
		// Проверка полей в структуре
		ОбязательныеПоля = Новый Соответствие;
		ОбязательныеПоля.Вставить("xmlОрганизация"  , "СвУчДокОбор_ИдГрузПол");
		ОбязательныеПоля.Вставить("ВидДокумента"    , "ВидДокумента");
		ОбязательныеПоля.Вставить("xmlКонтрагент"   , "СвУчДокОбор_ИдГрузОтпр");
		ОбязательныеПоля.Вставить("xmlТочкаДоставки", "СвУчДокОбор_ИдГрузПер");
		ОбязательныеПоля.Вставить("ЗаказНомер"      , "Документ_СвЭТРН_НомерЗаказТС");
		ОбязательныеПоля.Вставить("ДатаПоставки"    , "Документ_Дата");
		ОбязательныеПоля.Вставить("НакладнаяДата"   , "Документ_СвЭТРН_ДатаТоварТранНакл");
		ОбязательныеПоля.Вставить("НакладнаяНомер"  , "Документ_СвЭТРН_НомерТоварТранНакл");
		ОбязательныеПоля.Вставить("ТипДокумента"    , "Документ_СвЭТРН_ТипЭТРН");
		ОбязательныеПоля.Вставить("НомерТранзакции" , "Документ_СвЭТРН_ИдФайлПервичн");
		ОбязательныеПоля.Вставить("ФайлНомер"       , "Документ_СвЭТРН_НомерЭТРН");
		ОбязательныеПоля.Вставить("ФайлДата"        , "Документ_СвЭТРН_ДатаЭТРН");
		
		Для каждого Эл Из ОбязательныеПоля Цикл
			Если пСтруктураДокумента.Свойство(Эл.Значение) = Истина Тогда
				ЭКОМДок[Эл.Ключ] = пСтруктураДокумента[Эл.Значение];
			КонецЕсли;			
		КонецЦикла; 
		
		// ТЧ товары
		СуммаДокументаВсего = 0;
		ТекстОшибки         = "";
		
		Для Каждого СтруктСтрока Из пСтруктураДокумента.ДокументТЧ Цикл
			
			НовСтрока = ЭКОМДок.ТЧ_Товары.Добавить();
			
			ОбязательныеПоляТЧ = Новый Соответствие;
			ОбязательныеПоляТЧ.Вставить("Цена"                   , "Нет");
			ОбязательныеПоляТЧ.Вставить("ЦенаСНДС"               , "Нет");
			ОбязательныеПоляТЧ.Вставить("Сумма"                  , "Нет");
			ОбязательныеПоляТЧ.Вставить("СтавкаНДС"              , "Нет");
			ОбязательныеПоляТЧ.Вставить("СуммаНДС"               , "Нет");
			ОбязательныеПоляТЧ.Вставить("Сумма_с_НДС"            , "Нет");
			ОбязательныеПоляТЧ.Вставить("КоличествоПоставляемое" , "Документ_СвЭТРН_ПеревозкаИнф_Палетты_МассаБрутто");
			ОбязательныеПоляТЧ.Вставить("НомерПродукта"          , "Документ_СвЭТРН_ПеревозкаИнф_Палетты_SSCC");
			
			Для каждого Эл Из ОбязательныеПоляТЧ Цикл
				Если СтруктСтрока.Свойство(Эл.Значение) = Истина Тогда
					НовСтрока[Эл.Ключ] = СтруктСтрока[Эл.Значение];
				КонецЕсли;			
			КонецЦикла;
			
			Если СтруктСтрока.Свойство("Документ_СвЭТРН_ПеревозкаИнф_ОбъявСтоимГруза") = Истина Тогда
				СуммаДокументаВсего    = СтруктСтрока.Документ_СвЭТРН_ПеревозкаИнф_ОбъявСтоимГруза;
			КонецЕсли;
			
			Если пСтруктураДокумента.Свойство("Документ_СвЭТРН_ГрузИнф_ОтгрузНаимен") = Истина Тогда
				НовСтрока.ОписаниеПродукта = пСтруктураДокумента.Документ_СвЭТРН_ГрузИнф_ОтгрузНаимен;
			КонецЕсли;	
			
		КонецЦикла;
		
		ЭКОМДок.СуммаДокументаВсего = СуммаДокументаВсего;
		
		ЭКОМДок.ТекстОшибки = ""; // Очищаем ошибки документа
		ЭКОМДок.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.ПустаяСсылка(); // Обнуляем статус документ
		
		// Если есть уточнение записываем его в комментарий!
		ВыполнитьДополнительныеДействия(ЭКОМДок, "Входящий WHGOU-04(Отгрузка - титул ГО) - КЭП ГО", 
		пСтруктураДокумента, 
		МассивЛогаСобытий, 
		ТекстОшибки,
		,
		,
		,
		,
		КэшированныеЗначения);
		
		// По умолчанию документ загружается и записывается, если ЭКОМ документ не нужен в гибких настройках необходимо поставить НеЗагружатьДокумент = Истина 
		Если ЭКОМДок.НеЗагружатьДокумент = Ложь Тогда
			
			СтруктураДанных  = Новый Структура;			
			СтруктСтрока     = пСтруктураДокумента.ДокументТЧ[0]; // Первая строка
			
			ОбязательныеПоля = Новый Соответствие;			
			ОбязательныеПоля.Вставить("Марка"                    , "Документ_СвЭТРН_ПеревозкаИнф_МаркаТС");
			ОбязательныеПоля.Вставить("Номер"                    , "Документ_СвЭТРН_ПеревозкаИнф_НомерТС");		
			ОбязательныеПоля.Вставить("ВодительТелефон"          , "Документ_СвЭТРН_ПеревозкаИнф_ВодительИнф_Телефон");
			ОбязательныеПоля.Вставить("ВодительФамилия"          , "Документ_СвЭТРН_ПеревозкаИнф_ВодительИнф_Фамилия");
			ОбязательныеПоля.Вставить("ВодительИмя"              , "Документ_СвЭТРН_ПеревозкаИнф_ВодительИнф_Имя");
			ОбязательныеПоля.Вставить("ВодительОтчество"         , "Документ_СвЭТРН_ПеревозкаИнф_ВодительИнф_Отчество");
			ОбязательныеПоля.Вставить("ВодительскоеУдостоверение", "Документ_СвЭТРН_ПеревозкаИнф_ВодительИнф_ВУ");
			
			Для каждого Эл Из ОбязательныеПоля Цикл
				Если СтруктСтрока.Свойство(Эл.Значение) = Истина Тогда
					СтруктураДанных.Вставить(Эл.Ключ, СтруктСтрока[Эл.Значение]);
				КонецЕсли;			
			КонецЦикла;
			
			Если пСтруктураДокумента.Свойство("Документ_СвЭТРН_НомерРейса") = Истина Тогда
				СтруктураДанных.Вставить("НомерРейса", пСтруктураДокумента.Документ_СвЭТРН_НомерРейса);
			КонецЕсли;
			
			ЭКОМ_ТранспортнаяИнформация_РегСв_Записать(ЭКОМДок.Ссылка, СтруктураДанных);
			
			СтруктураРегистраСобытий = Новый Структура;
			СтруктураРегистраСобытий.Вставить("ДатаЗаписи"                  , ТекущаяДата());
			СтруктураРегистраСобытий.Вставить("ЭЦП"                         , СтрокаТЗСтруктур.ЭЦП);
			СтруктураРегистраСобытий.Вставить("Контрагент"                  , Выборка.Контрагент);
			СтруктураРегистраСобытий.Вставить("Организация"                 , Выборка.Организация);
			СтруктураРегистраСобытий.Вставить("НаправлениеОбмена"           , Перечисления.ЭКОМ_НаправлениеОбмена.Входящий);
			СтруктураРегистраСобытий.Вставить("ФайлИмя"                     , СтрокаТЗСтруктур.ИмяФайлаXML);
			СтруктураРегистраСобытий.Вставить("ЗаказДата"                   , ЭКОМДок.ЗаказДата);					
			СтруктураРегистраСобытий.Вставить("ЗаказНомер"                  , ЭКОМДок.ЗаказНомер);
			СтруктураРегистраСобытий.Вставить("Идентификатор"               , Выборка.ИдФайл);
			СтруктураРегистраСобытий.Вставить("СтруктураФайла"              , Новый ХранилищеЗначения(пСтруктураДокумента, Новый СжатиеДанных(9)));
			
			ДокументОбработан = ПроверитьОбработкуДокумента(ТекстОшибки, ЭКОМДок, пСтруктураДокумента, СтруктураРегистраСобытий, ПредставлениеДокументаXML, МассивЛогаСобытий);
			Если ДокументОбработан = Ложь Тогда
				Продолжить;			
			КонецЕсли;	
			
		Иначе 			
			пСтруктураДокумента.Вставить("Обработан", Ложь);
			ТекстЛогаСобытий = "В гибких настройках указано не загружать документ - " + ПредставлениеДокументаXML;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
		КонецЕсли;
		
		пСтруктураДокумента.Вставить("Организация", Выборка.Организация);
		СтрокаТЗСтруктур.СтруктураДокумента = пСтруктураДокумента;
		
	КонецЦикла;
	
	Если НЕ СоответствиеПоОрганизации.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоОрганизации     , "Организация_");
	КонецЕсли;
	Если НЕ СоответствиеПоКонтрагенту.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоКонтрагенту     , "Контрагент_");
	КонецЕсли;
	
КонецПроцедуры

Функция ПроверитьОбработкуДокумента(ТекстОшибки, ЭКОМДок, СтруктураДокумента, СтруктураРегистраСобытий, ПредставлениеДокументаXML, МассивЛогаСобытий)
	
	ИмяСобытия = "Проверка документа";
	ДокументОбработан = Ложь;
	ОшибкаВПроцедуре  = Ложь;
	
	// Проверка заполнения документа
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ЭКОМДок.ТекстОшибки = ТекстОшибки;
		Если ЭКОМДок.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ORDER_Входящий И ЭКОМДок.ЭтоПовторныйДокумент И Не ЭКОМДок.АктуальныйДокумент Тогда
			ЭКОМДок.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.Обработан;
		ИначеЕсли ЭКОМДок.ВидДокумента <> Перечисления.ЭКОМ_ВидыДокументов.ORDER_Входящий И ЭКОМДок.ЭтоПовторныйДокумент Тогда	
			ЭКОМДок.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.Обработан;
		Иначе
			ЭКОМДок.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.НеОбработан;
		КонецЕсли;
	КонецЕсли;
	
	// Документ обработан если нет ошибок.
	Если НЕ ЗначениеЗаполнено(ЭКОМДок.СтатусОбработкиДокумента) Тогда
		ЭКОМДок.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.Обработан;
	КонецЕсли;
	
	// Для EDI документов
	Если ВРег(ЭКОМДок.ТипДокумента) = "D" Тогда
		ЭКОМДок.Комментарий = ?(ЗначениеЗаполнено(ЭКОМДок.Комментарий), ЭКОМДок.Комментарий + Символы.ПС, "") + "Документ отменен/аннулирован!";
	ИначеЕсли ВРег(ЭКОМДок.ТипДокумента) = "R" Тогда 
		ЭКОМДок.Комментарий = ?(ЗначениеЗаполнено(ЭКОМДок.Комментарий), ЭКОМДок.Комментарий + Символы.ПС, "") + "Документ обновлен/скорректирован!";		
	КонецЕсли;
	
	Если ЭКОМДок.ЭтоПовторныйДокумент = Истина Тогда		   
		ЭКОМДок.Комментарий = ?(ЗначениеЗаполнено(ЭКОМДок.Комментарий), ЭКОМДок.Комментарий + Символы.ПС, "") + "Документ отправлен повторно!";
	КонецЕсли;
	
	Попытка		
		ПометкаУдаления    = ?(ВРег(ЭКОМДок.ТипДокумента) = "D", Истина, ЭКОМДок.ПометкаУдаления); // Считываем пометку удаления, выставленную в шаблоне (для D всегда помечен на удаление)
		ПараметрыДокумента = Новый Структура("ПометкаУдаления", ПометкаУдаления);
		ЗаписатьДокумент(ЭКОМДок, ПараметрыДокумента);
		
	Исключение
		ТекстЛогаСобытий = ОписаниеОшибки();
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		ОшибкаВПроцедуре = Истина;
	КонецПопытки;
	
	СтруктураРегистраСобытий.Вставить("НомерДокумента", ЭКОМДок.ФайлНомер);
	СтруктураРегистраСобытий.Вставить("ДатаДокумента",  ЭКОМДок.ФайлДата);
			
	Если ОшибкаВПроцедуре = Ложь Тогда
		Если ЭКОМДок.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.НеОбработан Тогда			
			ТекстЛогаСобытий = "Документ не обработан! В документе " + ПредставлениеДокументаXML + " есть ошибки, можно посмотреть в документе в поле <<<Текст ошибки>>>.";
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		    МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			// Оставляем
			СтруктураДокумента.Вставить("Обработан", Ложь);				
			СтруктураРегистраСобытий.Вставить("Статус",         Перечисления.ЭКОМ_Статусы.НеОбработан);			
			ЭКОМ_Объекты_События_Записать(ЭКОМДок.Ссылка,  СтруктураДокумента.ВидДокумента, СтруктураРегистраСобытий);
		Иначе	
			Если ЭКОМДок.ЭтоПовторныйДокумент Тогда
				ТекстЛогаСобытий = ПредставлениеДокументаXML + " - это повторный документ - " + ТекущаяДата();
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			КонецЕсли;	
			
			// Повторно загрузить документ не получиться.
			СтруктураДокумента.Вставить("Обработан", Истина);			
			СтруктураРегистраСобытий.Вставить("Статус", Перечисления.ЭКОМ_Статусы.Обработан);
			
			ВидыДокументовEDI = Новый Массив;
			ВидыДокументовEDI.Добавить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.ORDER_Входящий"));
			ВидыДокументовEDI.Добавить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.ORDRSP_Входящий"));
			ВидыДокументовEDI.Добавить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.DESADV_Входящий"));
			ВидыДокументовEDI.Добавить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.DESSCC_Входящий"));
			ВидыДокументовEDI.Добавить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.RECADV_Входящий"));
			ВидыДокументовEDI.Добавить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.RETANN_Входящий"));
			ВидыДокументовEDI.Добавить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.RETINS_Входящий"));
			ВидыДокументовEDI.Добавить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.INSDES_Входящий"));
			
			Если НЕ СтруктураРегистраСобытий.Свойство("СтатусЭлектронногоДокумента")
				И НЕ ВидыДокументовEDI.Найти(СтруктураДокумента.ВидДокумента) = Неопределено Тогда
				СтруктураРегистраСобытий.Вставить("СтатусЭлектронногоДокумента", ПредопределенноеЗначение("Перечисление.ЭКОМ_СтатусыЭлектронныхДокументов.Получен"));
			КонецЕсли;
			
			ЭКОМ_Объекты_События_Записать(ЭКОМДок.Ссылка,  СтруктураДокумента.ВидДокумента, СтруктураРегистраСобытий, Истина);
			ДокументОбработан = Истина;
			
		КонецЕсли;	
	КонецЕсли;
	
	Возврат ДокументОбработан;
	
КонецФункции

// Для входящих документов
Функция ПолучитьДанныеПоЗагруженнымФайлам(ТипДокумента, ТаблицаЗначенийФайловНаПлатформе) Экспорт
	
	Данные = Новый Структура;
	Данные.Вставить("ТаблицаНеОбработанныхФайлов", Новый ТаблицаЗначений);
	Данные.Вставить("ТаблицаОбработанныхФайлов"  , Новый ТаблицаЗначений);
	
	МассивВидовДокумента = ПолучитьМассивВидовДокумента(ТипДокумента);
	
	ВидыДокументовЮЗД = Новый Массив;
	Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьПервичныеВидыДокументовЮЗД(ВидыДокументовЮЗД);");
	Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьИсправительныеВидыДокументовЮЗД(ВидыДокументовЮЗД);");
	Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьКорректировочныеВидыДокументовЮЗД(ВидыДокументовЮЗД);");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ПОДСТРОКА(Таблица.Идентификатор, 0, 250) КАК Идентификатор,
	|	ПОДСТРОКА(Таблица.ФайлИмя, 0, 250) КАК ФайлИмя
	|ПОМЕСТИТЬ ФайлНаПлатформе
	|ИЗ
	|	&ТаблицаЗначенийФайловНаПлатформе КАК Таблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЭКОМ_Объекты_События.Идентификатор КАК Идентификатор,
	|	ЭКОМ_Документы.Ссылка КАК Документ,
	|	ЭКОМ_Объекты_События.СтруктураФайла КАК СтруктураФайлаДляПовторнойЗагрузки,
	|	ЭКОМ_Документы.СтатусОбработкиДокумента КАК СтатусОбработкиДокумента,
	|	ЭКОМ_Объекты_События.Статус КАК Статус,
	|	ЭКОМ_Объекты_События.ЭЦП КАК ЭЦП,
	|	ЭКОМ_Документы.НеЗагружатьДокумент КАК НеЗагружатьДокумент,
	|	ЭКОМ_Объекты_События.ФайлИмя КАК ФайлИмя
	|ИЗ
	|	РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_События
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЭКОМ_Документы КАК ЭКОМ_Документы
	|		ПО ЭКОМ_Объекты_События.Документ_Основание = ЭКОМ_Документы.Ссылка
	|			И ЭКОМ_Объекты_События.ВидДокумента = ЭКОМ_Документы.ВидДокумента
	|			И (ЭКОМ_Объекты_События.ВидДокумента В (&МассивВидовДокумента))
	|ГДЕ
	|	ЭКОМ_Документы.СтатусОбработкиДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_Статусы.НеОбработан)
	|	И ЭКОМ_Документы.НеЗагружатьДокумент = ЛОЖЬ
	|	И ЭКОМ_Объекты_События.НаправлениеОбмена = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_НаправлениеОбмена.Входящий)
	|	И ЭКОМ_Объекты_События.ДатаЗаписи >= ДАТАВРЕМЯ(2021, 1, 1)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЭКОМ_Объекты_СобытияЮЗД.Идентификатор,
	|	ЭКОМ_ДокументыЮЗД.Ссылка,
	|	ЭКОМ_Объекты_СобытияЮЗД.СтруктураФайла,
	|	ЭКОМ_ДокументыЮЗД.СтатусОбработкиДокумента,
	|	ЭКОМ_Объекты_СобытияЮЗД.Статус,
	|	ЭКОМ_Объекты_СобытияЮЗД.ЭЦП,
	|	ЭКОМ_ДокументыЮЗД.НеЗагружатьДокумент,
	|	ЭКОМ_Объекты_СобытияЮЗД.ФайлИмя
	|ИЗ
	|	РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_СобытияЮЗД
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЭКОМ_Документы КАК ЭКОМ_ДокументыЮЗД
	|		ПО ЭКОМ_Объекты_СобытияЮЗД.Документ_Основание = ЭКОМ_ДокументыЮЗД.Ссылка
	|			И ЭКОМ_Объекты_СобытияЮЗД.ВидДокумента = ЭКОМ_ДокументыЮЗД.ВидДокумента
	|			И (ЭКОМ_Объекты_СобытияЮЗД.ВидДокумента В (&ВидыДокументовЮЗД))
	|			И (ЭКОМ_ДокументыЮЗД.ВидДокумента В (&МассивВидовДокумента))
	|ГДЕ
	|	ЭКОМ_Объекты_СобытияЮЗД.НаправлениеОбмена = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_НаправлениеОбмена.Входящий)
	|	И ЭКОМ_Объекты_СобытияЮЗД.ДатаЗаписи >= ДАТАВРЕМЯ(2021, 1, 1)
	|	И ЭКОМ_ДокументыЮЗД.НеЗагружатьДокумент = ЛОЖЬ
	|	И ЭКОМ_ДокументыЮЗД.СтатусОбработкиДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_Статусы.НеОбработан)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ФайлНаПлатформе.Идентификатор КАК Идентификатор,
	|	ЭКОМ_Документы.Ссылка КАК Документ,
	|	ЭКОМ_Объекты_События.СтруктураФайла КАК СтруктураФайлаДляПовторнойЗагрузки,
	|	ЭКОМ_Объекты_События.Статус КАК Статус,
	|	ЭКОМ_Документы.СтатусОбработкиДокумента КАК СтатусОбработкиДокумента,
	|	ФайлНаПлатформе.ФайлИмя КАК ФайлИмя,
	|	ЭКОМ_Документы.НеЗагружатьДокумент КАК НеЗагружатьДокумент
	|ИЗ
	|	ФайлНаПлатформе КАК ФайлНаПлатформе
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_События
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЭКОМ_Документы КАК ЭКОМ_Документы
	|			ПО ЭКОМ_Объекты_События.Документ_Основание = ЭКОМ_Документы.Ссылка
	|				И (ЭКОМ_Документы.НеЗагружатьДокумент = ИСТИНА
	|					ИЛИ ЭКОМ_Документы.СтатусОбработкиДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_Статусы.Обработан))
	|				И ЭКОМ_Объекты_События.ВидДокумента = ЭКОМ_Документы.ВидДокумента
	|		ПО ФайлНаПлатформе.Идентификатор = ЭКОМ_Объекты_События.Идентификатор
	|			И (ЭКОМ_Объекты_События.ВидДокумента В (&МассивВидовДокумента))
	|ГДЕ
	|	ЭКОМ_Объекты_События.НаправлениеОбмена = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_НаправлениеОбмена.Входящий)";
	
	Запрос.УстановитьПараметр("ТаблицаЗначенийФайловНаПлатформе", ТаблицаЗначенийФайловНаПлатформе);
	Запрос.УстановитьПараметр("МассивВидовДокумента", МассивВидовДокумента);
	Запрос.УстановитьПараметр("ВидыДокументовЮЗД"   , ВидыДокументовЮЗД);
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ТаблицаНеОбработанныхФайлов = МассивРезультатов[1].Выгрузить();
	ТаблицаОбработанныхФайлов   = МассивРезультатов[2].Выгрузить();
	
	// Для повторной обработки с 01.01.2021
	Данные.Вставить("ТаблицаНеОбработанныхФайлов", ТаблицаНеОбработанныхФайлов);
	
	// Для отправки в архив
	Данные.Вставить("ТаблицаОбработанныхФайлов"  , ТаблицаОбработанныхФайлов);
	
	Возврат Данные;
	
КонецФункции

Функция ПолучитьДанныеПоКвитанциям(ТипДокумента) Экспорт
	
	МассивВидовДокумента = ПолучитьМассивВидовДокумента(ТипДокумента);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЭКОМ_Квитанции.ВидДокумента КАК ВидДокумента,
	|	ЭКОМ_Квитанции.ДатаЗаписи КАК ДатаЗаписи,
	|	ЭКОМ_Квитанции.Идентификатор КАК Идентификатор,
	|	ЭКОМ_Квитанции.ИдентификаторОснования КАК ИдентификаторОснования,
	|	ЭКОМ_Квитанции.СтруктураФайла КАК СтруктураФайлаДляПовторнойЗагрузки,
	|	ЭКОМ_Квитанции.ЭЦП КАК ЭЦП
	|ИЗ
	|	РегистрСведений.ЭКОМ_Квитанции КАК ЭКОМ_Квитанции
	|ГДЕ
	|	ЭКОМ_Квитанции.ВидДокумента В(&МассивВидовДокумента)
	|	И ЭКОМ_Квитанции.ДатаЗаписи МЕЖДУ ДОБАВИТЬКДАТЕ(&ТекущаяДата, ДЕНЬ, -30) И КОНЕЦПЕРИОДА(&ТекущаяДата, ДЕНЬ)";
	
	Запрос.УстановитьПараметр("МассивВидовДокумента", МассивВидовДокумента);
	Запрос.УстановитьПараметр("ТекущаяДата"         , ТекущаяДата());
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// <Описание функции>
//
// Параметры:
//  <Параметр1>  - <Тип.Вид> - <описание параметра>
//                 <продолжение описания параметра>
//  <Параметр2>  - <Тип.Вид> - <описание параметра>
//                 <продолжение описания параметра>
//
// Возвращаемое значение:
//   <Тип.Вид>   - <описание возвращаемого значения>
//
Функция API_ПолучитьВходящиеДокументы(ПрофильОбмена, НачалоИмениФайла, ТипДокумента, МассивЛогаСобытий, ВременныйКаталог, ТаблицаЗначенийФайловНаПлатформе) Экспорт
	
	Результат          = Новый Массив;
	СписокИменФайлов   = Новый Массив;
	ИмяСобытия         = "Получение входящих файлов по API";
	
	знНачалоИмениФайла = НачалоИмениФайла + "_";
	
	ЭтоКазахстан = ПрофильОбмена.Страна = "kz";	
	
	Рез = Вычислить("ЭКОМ_ОбщегоНазначения.НовыйSOAPОбращение(ПрофильОбмена, ""getListRequest"", , , МассивЛогаСобытий)");
	
	// Получение ответа от сервиса.
	Если Рез.errorCode = "" Тогда
		ТекстЛогаСобытий = "Нет данных об ответе или ответ сформирован не верно";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
		Возврат Результат;
	ИначеЕсли НЕ Рез.errorCode = "0" Тогда
		ТекстЛогаСобытий = "Ошибка подключения. (" + Рез.errorCode + ": " + Рез.errorMessage + ")";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
	КонецЕсли;
	
	Для Каждого Эл Из Рез.list Цикл
		
		// Фильтр по типу документа
		Если Найти(ВРег(Эл), знНачалоИмениФайла) > 0 Тогда
			
			ТочкаВИмени = Найти(Эл, ".");
			Стр = ТаблицаЗначенийФайловНаПлатформе.Добавить();
			Стр.Расширение    = Прав(Эл, СтрДлина(Эл) - ТочкаВИмени);
			Стр.ФайлИмя       = Эл;
			Стр.Идентификатор = Лев(Эл, ТочкаВИмени - 1);
			
		КонецЕсли;	
		
	КонецЦикла;	
	
	// Меняем ТЗ - добавляем документ и структуру
	Если ТаблицаЗначенийФайловНаПлатформе.Количество() = 0 Тогда
		
		Возврат Результат;
		
	КонецЕсли;
	
	ОбработаннаяТЗ   = ПроверитьСписокЗагружаемыхДокументов(ТаблицаЗначенийФайловНаПлатформе, ТипДокумента);			
	СписокИменФайлов = ОбработаннаяТЗ.ВыгрузитьКолонку("ФайлИмя"); // Массив для загрузки
	
	ПакетФайлов = Новый Структура;
	
	КоличествоФайловВПакете = 1998; 
	Счетчик        = 0;	
	НомерПоПорядку = 0;
	Соответствие = Новый Соответствие;
	КоличествоФайлов = СписокИменФайлов.Количество();
	Для каждого ФайлИмя Из СписокИменФайлов Цикл
		
		НомерПоПорядку = НомерПоПорядку + 1;
		
		// Добавляем в соответствие
		Если Счетчик < КоличествоФайловВПакете Тогда	
			Соответствие.Вставить(ФайлИмя, НомерПоПорядку);	
			
			// Добавляем в пакет	
		ИначеЕсли Счетчик = КоличествоФайловВПакете Тогда			
			ПакетФайлов.Вставить("Часть" + Формат(НомерПоПорядку, "ЧГ=0"), Соответствие);
			Счетчик    = 0;
			Соответствие = Новый Соответствие;
			Соответствие.Вставить(ФайлИмя, НомерПоПорядку);
		КонецЕсли;
		
		// Заканчиваем добавляем остатки в пакет	
		Если НомерПоПорядку = КоличествоФайлов Тогда
			ПакетФайлов.Вставить("Часть" + Формат(НомерПоПорядку, "ЧГ=0"), Соответствие);
		КонецЕсли;
		
		Счетчик = Счетчик + 1;
		
	КонецЦикла;
	
	Если ЭтоКазахстан Тогда
		Для каждого ЭлементПакета Из ПакетФайлов Цикл
			
			ИменаФайлов = Новый Массив;
			Для каждого ЭлИменаФайлов Из ЭлементПакета.Значение Цикл
				ИменаФайлов.Добавить(ЭлИменаФайлов.Ключ);
			КонецЦикла;
			
			Если ИменаФайлов.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;	
			
			Для каждого ИмяФайла Из ИменаФайлов Цикл
				ОдноИмяФайла = Новый Массив;
				ОдноИмяФайла.Добавить(ИмяФайла);
				Рез = Вычислить("ЭКОМ_ОбщегоНазначения.НовыйSOAPОбращение(ПрофильОбмена, ""getDoc"", ОдноИмяФайла, , МассивЛогаСобытий)");
				// Получение ответа от сервиса.
				Если Рез.errorCode = "" Тогда
					ТекстЛогаСобытий = "Нет данных об ответе или ответ сформирован не верно";
					ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
					МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
				
					Продолжить;
				КонецЕсли;
				
				Если НЕ Рез.errorCode = "0" Тогда
					ТекстЛогаСобытий = "Ошибка подключения. (" + Рез.errorCode + ": " + Рез.errorMessage + ")";
					ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
					МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
				
				Иначе
					
					н = 0;
					Для Каждого СтрокаXML Из Рез.content Цикл
						
						СтруктураФайла = Новый Структура;
						
						н = н + 1;
						ИмяТемпФайла = ВременныйКаталог + ИмяФайла;
						// Декодирование и сохранение строки BASE64 в файл.
						ДвоичныеДанные 	= Base64Значение(СтрокаXML);
						ДвоичныеДанные.Записать(ИмяТемпФайла);
						
						Файл = Новый Файл(ИмяТемпФайла);
						
						СтруктураФайла.Вставить("ИмяБезРасширения", Файл.ИмяБезРасширения);
						СтруктураФайла.Вставить("ФайлИмя", 			Файл.Имя);
						СтруктураФайла.Вставить("ФайлXML"         , Файл);
						
						Результат.Добавить(СтруктураФайла);
						
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	Иначе
		
		Для каждого ЭлементПакета Из ПакетФайлов Цикл
			
			ИменаФайлов = Новый Массив;
			Для каждого ЭлИменаФайлов Из ЭлементПакета.Значение Цикл
				ИменаФайлов.Добавить(ЭлИменаФайлов.Ключ);
			КонецЦикла;
			
			Если ИменаФайлов.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;	
			
			Рез = Вычислить("ЭКОМ_ОбщегоНазначения.НовыйSOAPОбращение(ПрофильОбмена, ""getDocumentsRequest"", ИменаФайлов, , МассивЛогаСобытий)");
			// Получение ответа от сервиса.
			Если Рез.errorCode = "" Тогда
				ТекстЛогаСобытий = "Нет данных об ответе или ответ сформирован не верно";
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
				Продолжить;
			КонецЕсли;
			
			Если НЕ Рез.errorCode = "0" Тогда
				ТекстЛогаСобытий = "Ошибка подключения. (" + Рез.errorCode + ": " + Рез.errorMessage + ")";
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
				
			Иначе
				
				н = 0;
				Для Каждого Строка Из Рез.content Цикл
					
					// Декодирование и сохранение строки BASE64 в файл.
					ДвоичныеДанные 	= Base64Значение(Строка);  
					
					Если ВерсияПлатформы() >= 83100 Тогда // Начиная с версии 8.3.10 доступно чтение на основании потока
						Чтение = Вычислить("Новый ЧтениеДанных(ДвоичныеДанные)");
						ИмяТемпФайла = Вычислить("Новый ПотокВПамяти(Чтение.ПрочитатьВБуферДвоичныхДанных())");
					Иначе  
						н = н + 1;
						ИмяТемпФайла = ВременныйКаталог + "FileArchive_" + н + ".zip";
						ДвоичныеДанные.Записать(ИмяТемпФайла);  
						ФайлЗип = Новый Файл(ИмяТемпФайла);
						Если НЕ ФайлЗип.Существует() Тогда
							Продолжить;
						КонецЕсли;
					КонецЕсли;
					
					ЗаменятьИмяXML = НачалоИмениФайла = "CONDRA";
					ЧтениеZIP = Новый ЧтениеZipФайла(ИмяТемпФайла);

					// Распакуем файлы по одиночке все файлы    
					Для Каждого Элемент Из ЧтениеZIP.Элементы Цикл	
						Попытка
							ЧтениеZIP.Извлечь(
							Элемент, // элемент для извлечения
							ВременныйКаталог,
							РежимВосстановленияПутейФайловZIP.НеВосстанавливать,
							"" // пароль
							);
						Исключение  
							ТекстЛогаСобытий = "Не удается распаковать архив при получении входящих документов. Повторите попытку заново. " + ОписаниеОшибки();
							ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
							МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
							Возврат Результат;
						КонецПопытки;
						
						Если ПустаяСтрока(Элемент.ИмяБезРасширения) Тогда // Это каталог
							Продолжить;
						КонецЕсли;
						
						Если Элемент.Расширение = "bin" 
							ИЛИ Элемент.Расширение = ".bin" Тогда
							Продолжить;
						КонецЕсли;
						
						СтруктураФайла = Новый Структура;
						
						Если Элемент.Расширение = "zip" 
							ИЛИ Элемент.Расширение = ".zip" Тогда
							
							ЧтениеZIPЭлемента = Новый ЧтениеZipФайла(ВременныйКаталог + Элемент.Имя);
							
							// Распакуем файлы в отдельный каталог.
							КаталогПуть = ВременныйКаталог + Элемент.ИмяБезРасширения;
							КаталогВременный = ЭКОМ_СоздатьКаталогПроверитьНаЗапись(КаталогПуть, МассивЛогаСобытий);
							Если КаталогВременный = Неопределено Тогда		
								Продолжить;
							КонецЕсли;
							
							ЧтениеZIPЭлемента.ИзвлечьВсе(КаталогПуть, РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
							
							// При необходимости сохранить уникальность имени XML получаем его имя из bin или pdf (актуально для CONDRA).
							Если ЗаменятьИмяXML Тогда
								
								СтруктураФайла.Вставить("ИмяФайлаАрхива", Элемент.Имя);
								ИмяФайлаXML = ВременныйКаталог + Элемент.ИмяБезРасширения + ".xml";
								
							КонецЕсли;
							
							// Перемещение файлов с соблюдением уникальности имени (если необходимо).
							Для Каждого Файл Из НайтиФайлы(КаталогПуть, "*.*", Истина) Цикл
								// Пропускаем каталоги.
								Если Файл.ЭтоКаталог() Тогда
									Продолжить;
								КонецЕсли;
								
								Если ЗаменятьИмяXML И Файл.Расширение = ".xml" 
									ИЛИ Файл.Расширение = "xml" Тогда
									ИмяФайлаПриемника = ИмяФайлаXML;
								Иначе
									ИмяФайлаПриемника = ВременныйКаталог + Файл.Имя;
								КонецЕсли;
								
								// Перемещаем файл из временного каталога в папку входящих документов, при необходимости изменив его имя.
								ПереместитьФайл(Файл.ПолноеИмя, ИмяФайлаПриемника);
								
								Файл = Новый Файл(ИмяФайлаПриемника);
								
								Если Найти(Файл.Расширение, "bin") > 0 Тогда
									СтруктураФайла.Вставить("ФайлBIN", Файл);
								Иначе
									ПоддерживаемыеРасширенияCONDRA = ПоддерживаемыеРасширенияCONDRA();
									ПоддерживаемыеРасширенияCONDRA.Добавить("xml");
									Для Каждого Расширение Из ПоддерживаемыеРасширенияCONDRA Цикл
										Если Найти(Файл.Расширение, Расширение) > 0 Тогда
											Если СтруктураФайла.Свойство("ИмяБезРасширения") = Ложь Тогда
												СтруктураФайла.Вставить("ИмяБезРасширения", Файл.ИмяБезРасширения);
											КонецЕсли;
											Если Расширение = "xml" Тогда
												СтруктураФайла.Вставить("ФайлИмя",			Файл.Имя);
											КонецЕсли;
											СтруктураФайла.Вставить("Файл" + Расширение,	Файл);
											
											Прервать;
										КонецЕсли;
									КонецЦикла;
								КонецЕсли;
							КонецЦикла;
							
							ЧтениеZIPЭлемента.Закрыть();
							// Удаление архива.
							Попытка
								УдалитьФайлы(ВременныйКаталог + Элемент.Имя);		
							Исключение
								ТекстЛогаСобытий = ОписаниеОшибки();
								ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
								МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
								
							КонецПопытки;
							// Удаление временной папки.
							Попытка
								УдалитьФайлы(КаталогПуть);		
							Исключение
								ТекстЛогаСобытий = ОписаниеОшибки();
								ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
								МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
						
							КонецПопытки;
							
						Иначе
							
							Файл = Новый Файл(ВременныйКаталог + Элемент.Имя);
							
							// Для квитанций
							ЭлементАрхиваBIN = ЧтениеZIP.Элементы.Найти(Элемент.ИмяБезРасширения + ".bin");
							Если НЕ ЭлементАрхиваBIN = Неопределено Тогда
								ФайлBIN = Новый Файл(ВременныйКаталог + ЭлементАрхиваBIN.Имя);
								СтруктураФайла.Вставить("ФайлBIN"  ,  ФайлBIN);
							КонецЕсли;
							
							СтруктураФайла.Вставить("ИмяБезРасширения", Файл.ИмяБезРасширения);	
							СтруктураФайла.Вставить("ФайлИмя", Файл.Имя);
							СтруктураФайла.Вставить("ФайлXML", Файл);
							
						КонецЕсли;
						
						Результат.Добавить(СтруктураФайла);
						
					КонецЦикла;
					
					ЧтениеZIP.Закрыть();
					// Удаление архива.
					Попытка  
						Если ТипЗнч(ИмяТемпФайла) = Тип("Строка") Тогда 
							УдалитьФайлы(ИмяТемпФайла);
						ИначеЕсли ТипЗнч(ИмяТемпФайла) = Вычислить("Тип(""ПотокВПамяти"")") Тогда
							ИмяТемпФайла.Закрыть();
						КонецЕсли;
					Исключение
						ТекстЛогаСобытий = ОписаниеОшибки();
						ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
						МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
					КонецПопытки;				
				КонецЦикла;			
			КонецЕсли;		
		КонецЦикла;		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

// Для входящих
Функция ПолучитьМассивВидовДокумента(ТипДокумента)
	
