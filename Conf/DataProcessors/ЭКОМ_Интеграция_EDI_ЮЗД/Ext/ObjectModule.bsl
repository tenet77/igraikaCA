				КонецПопытки;
				
				Если СтруктураЛога.ЕстьОшибка Тогда
					ЗаписьЖурналаРегистрации("Обработка ""Интеграция Docrobot""", УровеньЖурналаРегистрации.Ошибка, , , СтруктураЛога.ТекстОшибки);
				КонецЕсли;

			КонецЦикла;
			
			// DP_PDOTPR 3/8/13
			ТипДокумента = "DP_PDOTPR";
			СтруктураЛога = ПолучитьСтруктуруЛога();
			Попытка
				ПроверитьНаличиеФайловНаСервере(ТипДокумента, ЭтоРегламентноеЗадание, СтруктураЛога);
			Исключение
