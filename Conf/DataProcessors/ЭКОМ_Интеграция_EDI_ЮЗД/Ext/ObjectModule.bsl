Функция ЭКОМ_Объекты_События_Запись_Найти_По_Идентификатору(пИд, ВидДокумента = Неопределено) Экспорт
	
	СтруктураРезультат = Новый Структура;
	СтруктураРезультат.Вставить("Регистратор"     , "");
	СтруктураРезультат.Вставить("ВидДокумента"    , "");
	СтруктураРезультат.Вставить("ФайлИмя"         , "");
	СтруктураРезультат.Вставить("Отправитель"     , "");
	СтруктураРезультат.Вставить("Получатель"      , "");
	СтруктураРезультат.Вставить("ЭЦП"             , "");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ЭКОМ_Объекты_События.Документ_Основание КАК Регистратор,
	|	ЭКОМ_Объекты_События.ВидДокумента КАК ВидДокумента,
	|	ЭКОМ_Объекты_События.ФайлИмя,
	|	ЭКОМ_Объекты_События.ЭЦП,
	|	ЭКОМ_Объекты_События.Контрагент КАК Получатель,
	|	ЭКОМ_Объекты_События.Организация КАК Отправитель
	|ИЗ
	|	РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_События
	|ГДЕ
	|	ЭКОМ_Объекты_События.Идентификатор = &Идентификатор";
	
	Если ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_PDOTPR_03 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
		"&Идентификатор",
		"&Идентификатор И ЭКОМ_Объекты_События.НаправлениеОбмена = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_НаправлениеОбмена.Входящий)");
	ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_PDOTPR_07 
		ИЛИ ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_UVUTOCH_09
		ИЛИ ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_IZVPOL_06 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
		"&Идентификатор",
		"&Идентификатор И ЭКОМ_Объекты_События.НаправлениеОбмена = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_НаправлениеОбмена.Исходящий)");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Идентификатор", пИд);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураРезультат, Выборка);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат СтруктураРезультат;
	
КонецФункции

Процедура Рекурсия(СтрокаДерева, Чтение) Экспорт
	
	АтрибутыСоответствие = Новый Соответствие();
	Пока Чтение.ПрочитатьАтрибут() Цикл
		АтрибутыСоответствие.Вставить(Чтение.Имя, Чтение.Значение);
	КонецЦикла;
	Если АтрибутыСоответствие.Количество() > 0 Тогда
		СтрокаДерева.Атрибуты = АтрибутыСоответствие;
	Иначе
		АтрибутыСоответствие = 0;
	КонецЕсли;
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Прервать;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.Текст Тогда
			СтрокаДерева.Текст = Чтение.Значение;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Дочерний         = СтрокаДерева.Строки.Добавить();
			Дочерний.Элемент = Чтение.Имя;
			Рекурсия(Дочерний, Чтение);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

