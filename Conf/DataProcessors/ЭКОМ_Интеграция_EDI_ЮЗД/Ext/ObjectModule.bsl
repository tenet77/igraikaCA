// Сохраняет во временную папку на сервере гибкие настройки
Функция СкачатьГибкиеНастройкиНаGIT(ПутьКФайлу) Экспорт
	
	МассивЛогаСобытий = Новый Массив;
	КомандаЗапроса      = "/repos/1cdevelopexite/FlexibleSetting/contents/" + ПутьКФайлу;          
	ОтветСервераПоФайлу =  Вычислить("ЭКОМ_ОбщегоНазначения.ПолучениеДанныхGITНаСервере(КомандаЗапроса, МассивЛогаСобытий)");  
	ИмяФайла = ОтветСервераПоФайлу.Получить("name");
	
	СтрокаBase64   = ОтветСервераПоФайлу.Получить("content");	
	СтрокаBase64   = СтрЗаменить(СтрокаBase64,"\/","/");  
	
	ВременныйКаталог = КаталогВременныхФайлов() + "TempECOM" + ПолучитьРазделительПути();
	ПолноеИмяФайлаXML = ВременныйКаталог + ИмяФайла;
	ДвоичныеДанные = Base64Значение(СтрокаBase64);
	ДвоичныеДанные.Записать(ПолноеИмяФайлаXML);
	
	АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПолноеИмяФайлаXML));
	
	ДанныеПоФайлу = Новый Структура;
	ДанныеПоФайлу.Вставить("НаСервере", ПолноеИмяФайлаXML);
	ДанныеПоФайлу.Вставить("НаКлиенте", АдресВоВременномХранилище);
	ДанныеПоФайлу.Вставить("ИмяФайла" , ИмяФайла);
	
	Возврат ДанныеПоФайлу;
	
КонецФункции

// Загружает в строку дерева значений настройку
Процедура ЗагрузитьНастройкуВДеревоЗначений(ПутьКФайлу, ДЗ, НаименованиеФайла, ИмяДереваЗначений = "") Экспорт //Docrobot 1.21.0 MOD-280 [Добавлено ИмяДереваЗначений]
	
	НоваяСтрокаДерева = ДЗ.Строки.Добавить();
	
	// Получаем корень дерева.
	Пока НЕ НоваяСтрокаДерева.Уровень() = 0 Цикл
		НоваяСтрокаДерева = НоваяСтрокаДерева.Родитель;
	КонецЦикла;
	
	ДанныеПоФайлу  = СкачатьГибкиеНастройкиНаGIT(ПутьКФайлу);
	ПолноеИмяФайла = ДанныеПоФайлу.НаСервере;
	Файл = Новый Файл(ПолноеИмяФайла);
	Если НЕ Файл.Существует() Тогда
		Возврат;
	КонецЕсли;
	
	Если НРег(Файл.Расширение) = ".xml" Тогда
		НовоеЧтениеXML = Новый ЧтениеXML;
		НовоеЧтениеXML.ОткрытьФайл(ПолноеИмяФайла);
		НовыйСериализаторXDTO = Новый СериализаторXDTO(ФабрикаXDTO);
		ДанныеТЗ = НовыйСериализаторXDTO.ПрочитатьXML(НовоеЧтениеXML);
		НовоеЧтениеXML.Закрыть();
	Иначе
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Формат <" + НРег(Файл.Расширение) + "> не поддерживается!";
		Сообщение.Сообщить(); 
		
		Возврат;
	КонецЕсли;
	
	Колонки = Новый Массив;    
	Для Каждого Колонка Из ДанныеТЗ.Колонки Цикл
		Колонки.Добавить(Колонка.Имя);
	КонецЦикла;
	
	Индекс = ДЗ.Строки.Индекс(НоваяСтрокаДерева);
	ДЗ.Строки.Удалить(НоваяСтрокаДерева);
	
	// Коопируем строку в новое место.
	НоваяСтрока = ДЗ.Строки.Добавить();
	СкопироватьСтрокуДереваЗначений(ДанныеТЗ.Строки.Получить(0), НоваяСтрока, Колонки, ИмяДереваЗначений); //Docrobot 1.21.0 MOD-280 [Добавлено ИмяДереваЗначений]
	ДЗ.Строки.Сдвинуть(ДЗ.Строки.Индекс(НоваяСтрока), Индекс - ДЗ.Строки.Индекс(НоваяСтрока));
	Если Не ДЗ.Колонки.Найти("ТипТранзакции") = Неопределено И НастройкаДанногоТипаУжеИспользуется(ДЗ.Строки, НоваяСтрока.ТипТранзакции) Тогда
		НоваяСтрока.Использовать = Ложь;
		ЭКОМ_ОбщегоНазначения.СообщитьПользователю("Шаблон настроек с типом транзакции " + НоваяСтрока.ТипТранзакции + " уже используется, " 
		+ "загружаемый шаблон " + НоваяСтрока.Кнопка + " добавлен без флажка ""Использовать""");
	КонецЕсли;      
	
	// Удаление временных файлов.
	УдалитьФайлы(ДанныеПоФайлу.НаСервере);
	
	Сообщение = Новый СообщениеПользователю;		
	Сообщение.Текст = "Настройки загружены в базу по типу транзакции - " + НаименованиеФайла;
	Сообщение.Сообщить();
	
КонецПроцедуры

// Процедура запсывает документ с указанным режимом записи и снятием пометки удаления, при необъодимости получая объект из переданной ссылки
//
// Параметры:
//  Документ  - ДокументСсылка, ДокументОбъект - документ, который необходимо записать
//  РежимЗаписи  - РежимЗаписиДокумента - определяет режим записи документа
//	ПараметрыДокумента - Структура - указание реквизитов и их значений для установки перед записью
//
Процедура ЗаписатьДокумент(Знач Документ, ПараметрыДокумента)
	
	Тип = ТипЗнч(Документ);
	Если Документы.ТипВсеСсылки().СодержитТип(Тип) Тогда // Ссылка
		ДокументОбъект = Документ.ПолучитьОбъект();
	Иначе
		ДокументОбъект = Документ;
	КонецЕсли;
	
	Для Каждого Параметр Из ПараметрыДокумента Цикл
		ДокументОбъект[Параметр.Ключ] = Параметр.Значение;
	КонецЦикла;
	
	ДокументОбъект.Проведен = Ложь;
	ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	
КонецПроцедуры // ЗаписатьДокумент()

