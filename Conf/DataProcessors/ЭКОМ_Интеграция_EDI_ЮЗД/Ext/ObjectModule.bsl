// Возвращает Истину если ВерсияОбъектовЭКОМ равна или выше указанной. Делает ВызватьИсключение 
// Возвращаемое значение:
//  - Булево - Истина, ВерсияОбъектовЭКОМ равна или выше указанной, Ложь если версия ниже.
//
Функция АктуальныОбъектыЭКОМ(ТекстСообщения, МассивЛогаСобытий) Экспорт
	
	ОсновнаяВерсияКонфигурации = "0.0";
	ВерсияКонфигурации         = "0.0.0";
	ВерсияОбработки            = ПолучитьВерсиюОбработки();
	ЭКОМОбъектыАктуальны       = Ложь; 
	
	Если НЕ Метаданные.ОбщиеМодули.Найти("ЭКОМ_ОбщегоНазначения") = Неопределено Тогда 
		ВерсияКонфигурации = ПолучитьВерсиюКонфигурации();
		
		Верс1Массив = Эком_РазложитьСтрокуВМассивПодстрок(ВерсияКонфигурации, ".");
		Если Верс1Массив.Количество() >= 2 Тогда
			ОсновнаяВерсияКонфигурации = Верс1Массив[0] + "." +Верс1Массив[1];
		КонецЕсли;
		
		Верс2Массив = Эком_РазложитьСтрокуВМассивПодстрок(ВерсияОбработки, ".");
		Если Верс2Массив.Количество() >= 2 Тогда
			ОсновнаяВерсияОбработки    = Верс2Массив[0] + "." +Верс2Массив[1];
		КонецЕсли;
		
		МаксимальнаяВерсия   = СверитьВерсии(ОсновнаяВерсияКонфигурации, ОсновнаяВерсияОбработки);
		ЭКОМОбъектыАктуальны = (МаксимальнаяВерсия = ОсновнаяВерсияКонфигурации);
	КонецЕсли;	
	
	// Сообщения пользователю 	
	Если ЭКОМОбъектыАктуальны = Ложь Тогда	
		ТекстСообщения = "Конфигурация не содержит объектов модуля ""Docrobot: Интеграция EDI""." + Символы.ПС  
		+ "Для поддержки полного функционала модуля обновите объекты до последней версии или обратитесь к менеджеру для заказа интеграции." + Символы.ПС 
		+ "Используемая версия обработки интеграции [" + ВерсияОбработки + "]." + Символы.ПС 
		+ "Версия объектов внутри конфигурации [" + ВерсияКонфигурации + "]";
				
	КонецЕсли;
	
	Если ЭКОМОбъектыАктуальны = Истина Тогда
		ОбновлениеИнфоПолей = Настройка_Параметр_Прочитать("ОбновлениеИнфоПолейВключено", Истина, "Служебный");	
		
		Если ОбновлениеИнфоПолей = Истина Тогда
			ДатаОбновленияСправочниковИнфоПолей = ПолучитьДатуОбновленияИнфоПолей(МассивЛогаСобытий);	
			СлужебныйДатаОбновленияСправочниковИнфоПолей = Настройка_Параметр_Прочитать("СлужебныйДатаОбновленияСправочниковИнфоПолей", , "Служебный");
			Если НЕ СлужебныйДатаОбновленияСправочниковИнфоПолей = ДатаОбновленияСправочниковИнфоПолей Тогда
				Справочники.ЭКОМ_ИнфоПоля.ОбновитьСправочникиИнфополей();
				Настройка_Параметр_Записать("СлужебныйДатаОбновленияСправочниковИнфоПолей", ДатаОбновленияСправочниковИнфоПолей, "Служебный");
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ЭКОМОбъектыАктуальны;
	
КонецФункции 

Функция ПолучитьДатуОбновленияИнфоПолей(МассивЛогаСобытий)
	
	КомандаЗапроса = "/repos/1cdevelopexite/UpdateService";
	ОтветСервера   = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучениеДанныхGITНаСервере(КомандаЗапроса, МассивЛогаСобытий)");
	
	Если ТипЗнч(ОтветСервера) = Тип("Соответствие")Тогда
		Дата = ДатаИзXML_в_1С(ОтветСервера.Получить("updated_at")); 
	Иначе	
		Дата = Дата(2020, 01, 01);
	КонецЕсли;
	
	Возврат Дата; 
	
КонецФункции

// Процедура создает Эком документ на основании входящего DPOTORG1
//
// Параметры:
//  ТЗСтруктур  				- ТаблицаЗначений 	- <описание параметра>
//  ДокументыШапка  			- <Тип.Вид> 		- <описание параметра>
//  пДокументыТабличнаяЧасть  	- <Тип.Вид> 		- <описание параметра>
//  МассивЛогаСобытий  			 
Процедура СоздатьЭКОМ_ДокАктОПриемкеТоваровDPOTORG1(ТЗСтруктур, ДокументыШапка, пДокументыТабличнаяЧасть, МассивЛогаСобытий) Экспорт
	
	КэшированныеЗначения = Неопределено;
	
	// Табличная часть заполняется в гибких настройках
	
	// Индентификатор отправителя и получателя берем с 3 символа чтобы убрать префикс оператора 
	// Запрос по шапке документов
	Запрос = Новый Запрос;	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДокументыШапка.Документ_ДатаДок КАК Дата,
	|	ПОДСТРОКА(ДокументыШапка.Документ_КНД, 1, 100) КАК КНД,
	|	ПОДСТРОКА(ДокументыШапка.Документ_Подписант_ЮЛ_Должн, 1, 100) КАК ПодписантДолжность,
	|	ПОДСТРОКА(ДокументыШапка.Документ_Подписант_ЮЛ_ИННЮЛ, 1, 100) КАК ПодписантИНН,
	|	ПОДСТРОКА(ДокументыШапка.Документ_Подписант_ЮЛ_ФИО_Имя, 1, 100) КАК ПодписантИмя,
	|	ПОДСТРОКА(ДокументыШапка.Документ_Подписант_ЮЛ_ФИО_Фамилия, 1, 100) КАК ПодписантФамилия,
	|	ПОДСТРОКА(ДокументыШапка.Документ_СвТНО_Плательщик_ИдСв_СвЮЛ_ИННЮЛ, 1, 100) КАК ПлательщикИНН,
	|	ПОДСТРОКА(ДокументыШапка.Документ_СвТНО_Плательщик_ИдСв_СвЮЛ_КПП, 1, 100) КАК ПлательщикКПП,
	|	ПОДСТРОКА(ДокументыШапка.Документ_СвТНО_Плательщик_ИдСв_СвЮЛ_НаимОрг, 1, 100) КАК ПлательщикНаимОрг,
	|	ПОДСТРОКА(ДокументыШапка.Документ_СвТНО_Поставщик_ИдСв_СвЮЛ_ИННЮЛ, 1, 100) КАК ПоставщикИНН,
	|	ПОДСТРОКА(ДокументыШапка.Документ_СвТНО_Поставщик_ИдСв_СвЮЛ_КПП, 1, 100) КАК ПоставщикКПП,
	|	ПОДСТРОКА(ДокументыШапка.Документ_СвТНО_Поставщик_ИдСв_СвЮЛ_НаимОрг, 1, 100) КАК ПоставщикНаимОрг,
	|	ДокументыШапка.Документ_СвТНО_ТН_ДатаТН КАК ДатаТТН,
	|	ПОДСТРОКА(ДокументыШапка.Документ_СвТНО_ТН_НомТН, 1, 100) КАК НомерТТН,
	|	ПОДСТРОКА(ДокументыШапка.ИдФайл, 1, 256) КАК ИдФайл,
	|	ПОДСТРОКА(ДокументыШапка.СвУчДокОбор_ИдОтпр, 4, 256) КАК ИдентификаторОтправителя,
	|	ПОДСТРОКА(ДокументыШапка.СвУчДокОбор_ИдПок, 4, 256) КАК ИдентификаторПокупателя,
	|	ПОДСТРОКА(ДокументыШапка.СвУчДокОбор_СвОЭДОтпр_ИННЮЛ, 1, 100) КАК ИННОЭДОтправителя,
	|	ПОДСТРОКА(ДокументыШапка.СвУчДокОбор_СвОЭДОтпр_ИдЭДО, 1, 100) КАК ИДОЭДОтправителя,
	|	ПОДСТРОКА(ДокументыШапка.СвУчДокОбор_СвОЭДОтпр_НаимОрг, 1, 100) КАК НаименованиеОЭДОтправителя,
	|	ДокументыШапка.ВидДокумента КАК ВидДокумента
	|ПОМЕСТИТЬ ДокументыШапка
	|ИЗ
	|	&ДокументыШапка КАК ДокументыШапка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДокументыШапка.ИдФайл,
	|	ДокументыШапка.Дата,
	|	ЕСТЬNULL(ЭКОМ_Документы.Ссылка, НЕОПРЕДЕЛЕНО) КАК ЭКОМДок,
	|	ЭКОМ_Документы.ПометкаУдаления,
	|	ЭКОМ_Документы.СтатусОбработкиДокумента,
	|	ЭКОМ_GLN_Контрагент.Объект КАК Контрагент,
	|	ДокументыШапка.ИдентификаторОтправителя КАК ИдентификаторКонтрагента,
	|	ЭКОМ_GLN_Организация.Объект КАК Организация,
	|	ДокументыШапка.ИдентификаторПокупателя КАК ИдентификаторОрганизации
	|ИЗ
	|	ДокументыШапка КАК ДокументыШапка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭКОМ_Документы КАК ЭКОМ_Документы
	|		ПО ДокументыШапка.НомерТТН = ЭКОМ_Документы.НакладнаяНомер
	|			И ДокументыШапка.ДатаТТН = ЭКОМ_Документы.НакладнаяДата
	|			И (ЭКОМ_Документы.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.DPOTORG1_Входящий))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Организация
	|		ПО (ДокументыШапка.ИдентификаторПокупателя = (ВЫРАЗИТЬ(ЭКОМ_GLN_Организация.Ид_ОЭД КАК СТРОКА(256))))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Контрагент
	|		ПО (ДокументыШапка.ИдентификаторОтправителя = (ВЫРАЗИТЬ(ЭКОМ_GLN_Контрагент.Ид_ОЭД КАК СТРОКА(256))))";
	
	Запрос.УстановитьПараметр("ДокументыШапка", ДокументыШапка);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ПроверкаНаДублирование 		= Новый Соответствие;
	СоответствиеПоОрганизации	= Новый Соответствие;
	СоответствиеПоКонтрагенту	= Новый Соответствие;
	СоответствиеПоНоменклатуре	= Новый Соответствие;
	
	Пользователь = НайтиТекущегоПользователя();
	
	ИмяСобытия = "Создание документа Docrobot-DPOTORG1";
	Пока Выборка.Следующий() Цикл
		
		// Для проверки дублирования строк
		Если ПроверкаНаДублирование.Получить(Выборка.ИдФайл) = Неопределено Тогда
			ПроверкаНаДублирование.Вставить(Выборка.ИдФайл, "Строка добавлена");
		Иначе		
			ТекстЛогаСобытий = "Дубль данных, проверьте GLN организации, контрагента, точки доставки ИД документа - " + Выборка.ИдФайл;	
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Продолжить;
			
		КонецЕсли;
		
		// Получаем структуру документа
		пСтруктураДокумента = Неопределено;
		СтрокаТЗСтруктур = ТЗСтруктур.Найти(Выборка.ИдФайл, "ИдентификаторФайла");
		Если СтрокаТЗСтруктур = Неопределено Тогда
			ТекстЛогаСобытий = "Не найдена структура документа с ИД = " + Выборка.ИдФайл;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

			Продолжить;
		Иначе
			пСтруктураДокумента = СтрокаТЗСтруктур.СтруктураДокумента;
		КонецЕсли;
		
		ПредставлениеДокументаXML = Строка(пСтруктураДокумента.ВидДокумента) + " № " + пСтруктураДокумента.Документ_СвТНО_ТН_НомТН 
		+ " от " + Формат(пСтруктураДокумента.Документ_СвТНО_ТН_ДатаТН, "ДФ='dd.MM.yyyy ""г.""'");
		
		Если Выборка.ЭКОМДок = Неопределено Тогда
			ЭКОМДок = Документы.ЭКОМ_Документы.СоздатьДокумент();
		ИначеЕсли (Выборка.ПометкаУдаления = Истина 
			ИЛИ Выборка.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.НеОбработан) Тогда
			ЭКОМДок = Выборка.ЭКОМДок.ПолучитьОбъект();
			ЭКОМДок.ПометкаУдаления = ЛОЖЬ;
			ЭКОМДок.ТЧ_Товары.Очистить();
			// Очищение остальных табличных частей документов в гибких настроках при необходимости
			
		Иначе
			ТекстЛогаСобытий = ПредставлениеДокументаXML + " - ЭКОМ документ уже существует в 1С, номер = " + Выборка.ЭКОМДок.Номер + " от " + Выборка.ЭКОМДок.Дата;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Продолжить;
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Выборка.Организация) Тогда
			xmlОрганизацияGLN = Выборка.ИдентификаторОрганизации;
			СоответствиеПоОрганизации.Вставить("Организация_" + xmlОрганизацияGLN, xmlОрганизацияGLN);	
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Выборка.Контрагент) Тогда
			xmlКонтрагентGLN = Выборка.ИдентификаторКонтрагента;
			СоответствиеПоКонтрагенту.Вставить("Контрагент_" + xmlКонтрагентGLN, xmlКонтрагентGLN);	
		КонецЕсли;
		
		ЭКОМДок.Организация               = Выборка.Организация;
		ЭКОМДок.xmlОрганизация            = пСтруктураДокумента.СвУчДокОбор_ИдПок;
		ЭКОМДок.ВидДокумента              = пСтруктураДокумента.ВидДокумента;
		ЭКОМДок.Контрагент                = Выборка.Контрагент;
		ЭКОМДок.xmlКонтрагент             = пСтруктураДокумента.СвУчДокОбор_ИдОтпр;
		ЭКОМДок.Дата                      = ТекущаяДата();
		//ЭКОМДок.ЗаказНомер                = СоответствиеИнфПолФХЖ1["номер_заказа"];
		//ЭКОМДок.ЗаказДата                 = ДатаИзXML_в_1С(СоответствиеИнфПолФХЖ1["дата_заказа"]);
		ЭКОМДок.ИмяФайла                  = СтрокаТЗСтруктур.ИмяФайлаXML;		
		//ЭКОМДок.xmlТочкаДоставки
		ЭКОМДок.Ответственный             = Пользователь;
		ЭКОМДок.НакладнаяДата             = пСтруктураДокумента.Документ_СвТНО_ТН_ДатаТН;
		ЭКОМДок.НакладнаяНомер            = пСтруктураДокумента.Документ_СвТНО_ТН_НомТН;
		//ЭКОМДок.ТипДокумента              = пСтруктураДокумента.Документ_Функция; 
		ЭКОМДок.Версия                    = пСтруктураДокумента.ВерсПрог;
		ЭКОМДок.НомерТранзакции           = пСтруктураДокумента.ИдФайл;
		ЭКОМДок.xmlВалюта                 = "RUB";
		ЭКОМДок.ФайлДата                  = пСтруктураДокумента.Документ_ДатаДок;
		
		// ТЧ товары
		СуммаБезНДСВсего = 0;
		СуммаНДСВсего    = 0;
		ТекстОшибки      = "";
		
		Для Каждого СтруктСтрока Из пСтруктураДокумента.ДокументТЧ Цикл
			
			// Основные ИнфПолФХЖ2
			СоответствиеИнфПолФХЖ2 = Новый Соответствие;
			СоответствиеИнфПолФХЖ2.Вставить("номер_заказа", 		"");
			СоответствиеИнфПолФХЖ2.Вставить("номер_акта", 			"");
			СоответствиеИнфПолФХЖ2.Вставить("магазин", 				"");
			СоответствиеИнфПолФХЖ2.Вставить("номер_накладной", 		"");
			СоответствиеИнфПолФХЖ2.Вставить("штрихкод", 			"");
			СоответствиеИнфПолФХЖ2.Вставить("код_материала", 		"");
			СоответствиеИнфПолФХЖ2.Вставить("позиция_заказа", 		"");
			СоответствиеИнфПолФХЖ2.Вставить("количество_заказ", 	"");
			СоответствиеИнфПолФХЖ2.Вставить("количество_поставка", 	"");
			
			Если СтруктСтрока.Свойство("Документ_СвТНО_ТН_Таблица_СвТов_ИнфПолСтр") Тогда
				Для каждого Элемент Из СтруктСтрока.Документ_СвТНО_ТН_Таблица_СвТов_ИнфПолСтр Цикл
					
					Если НЕ СоответствиеИнфПолФХЖ2.Получить(Элемент.Ключ) = Неопределено Тогда
						СоответствиеИнфПолФХЖ2[Элемент.Ключ] = Элемент.Значение;		
					КонецЕсли;
					
				КонецЦикла;		
			КонецЕсли;
			
			СтавкаНДС   = СтавкаНДСЧислом(СтруктСтрока.Документ_СвТНО_ТН_Таблица_СвТов_СтавкаНДС);
			КоличествоЗаказаСтрокой = СоответствиеИнфПолФХЖ2["количество_заказ"];
			КоличествоЗаказа 	= ЭКОМ_ПреобразоватьВЧисло(?(ЗначениеЗаполнено(КоличествоЗаказаСтрокой), КоличествоЗаказаСтрокой, "0"));
			КоличествоЗаказа	= ?(КоличествоЗаказа = 0, 1, КоличествоЗаказа);
			Количество 	= СоответствиеИнфПолФХЖ2["количество_поставка"];
			Количество  = ЭКОМ_ПреобразоватьВЧисло(?(ЗначениеЗаполнено(Количество), Количество, "0"));	
			Количество 	= ?(Количество = 0, 1, Количество);
			ЦенаБезНДС  = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.Документ_СвТНО_ТН_Таблица_СвТов_Цена);
			СуммаСНДС   = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.Документ_СвТНО_ТН_Таблица_СвТов_СумУчНДС);
			СуммаБезНДС = ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.Документ_СвТНО_ТН_Таблица_СвТов_Стоимость);
			СуммаНДС 	= "";
			СтруктСтрока.Свойство("Документ_СвТНО_ТН_Таблица_СвТов_СумНал", СуммаНДС);
			СуммаНДС 	= ?(ЗначениеЗаполнено(СуммаНДС), ЭКОМ_ПреобразоватьВЧисло(СуммаНДС), СуммаСНДС - СуммаБезНДС);	
			ЦенаСНДС 	= Окр(СуммаСНДС / Количество, 2);
			
			НовСтрока = ЭКОМДок.ТЧ_Товары.Добавить();
			НовСтрока.xmlЕдиницаИзмерения = СтруктСтрока.Документ_СвТНО_ТН_Таблица_СвТов_НаимЕдИзм;
			НовСтрока.Цена        = ЦенаБезНДС;
			НовСтрока.ЦенаСНДС    = ЦенаСНДС;
			НовСтрока.Сумма       = СуммаБезНДС;
			НовСтрока.СтавкаНДС   = СтавкаНДС;
			НовСтрока.СуммаНДС    = СуммаНДС;
			НовСтрока.Сумма_с_НДС = СуммаСНДС;
			НовСтрока.КоличествоПоставляемое 	= Количество;
			НовСтрока.КоличествоЗаказанное 		= КоличествоЗаказа;
			Штрихкод = СтруктСтрока.Документ_СвТНО_ТН_Таблица_СвТов_КодТов;
			Штрихкод = ?(ЗначениеЗаполнено(Штрихкод), Штрихкод, СоответствиеИнфПолФХЖ2["штрихкод"]);
			НовСтрока.НомерПродукта           = Штрихкод;
			//НовСтрока.НомерПродуктаПоставщика = СоответствиеИнфПолФХЖ2["артикул_поставщика"];
			НовСтрока.НомерПродуктаПокупателя = СоответствиеИнфПолФХЖ2["код_материала"];
			НовСтрока.ОписаниеПродукта        = СтруктСтрока.Документ_СвТНО_ТН_Таблица_СвТов_НаимТов;
			
			СуммаБезНДСВсего = СуммаБезНДСВсего + СуммаБезНДС;
			СуммаНДСВсего    = СуммаНДСВсего + СуммаНДС;
		КонецЦикла;
		
		// Заполняем номенклатуру.
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Товары.НомерСтроки,
		|	Товары.НомерПродукта,
		|	Товары.xmlЕдиницаИзмерения,
		|	Товары.НомерПродуктаПокупателя
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&ТЧТовары КАК Товары
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.НомерСтроки,
		|	ВТ.НомерПродукта,
		|	ВТ.xmlЕдиницаИзмерения,
		|	ВТ.НомерПродуктаПокупателя,
		|	ЭКОМ_НоменклатураКонтрагентов.Номенклатура,
		|	ЭКОМ_НоменклатураКонтрагентов.ЕдиницаНоменклатурыКонтрагента
		|ИЗ
		|	ВТ КАК ВТ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_НоменклатураКонтрагентов КАК ЭКОМ_НоменклатураКонтрагентов
		|		ПО ВТ.НомерПродукта = ЭКОМ_НоменклатураКонтрагентов.ШтрихКодНоменклатурыКонтрагента
		|			И (ЭКОМ_НоменклатураКонтрагентов.Контрагент = &Контрагент)";
		
		Запрос.УстановитьПараметр("ТЧТовары", ЭКОМДок.ТЧ_Товары);
		Запрос.УстановитьПараметр("Контрагент", Выборка.Контрагент);
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаТовары = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаТовары.Следующий() Цикл
			
			Если НЕ ЗначениеЗаполнено(ВыборкаТовары.Номенклатура) 
				И ЗначениеЗаполнено(Выборка.Контрагент) Тогда
				
				Код = ?(ЗначениеЗаполнено(ВыборкаТовары.НомерПродукта), ВыборкаТовары.НомерПродукта, ВыборкаТовары.НомерПродуктаПокупателя) + "_" + ЭКОМДок.xmlКонтрагент;
				СоответствиеПоНоменклатуре.Вставить("КодНоменклатурыКонтрагента_"          + Код, ВыборкаТовары.НомерПродуктаПокупателя); 	// PRODUCTIDBUYER
				СоответствиеПоНоменклатуре.Вставить("ШтрихКодНоменклатурыКонтрагента_"     + Код, ВыборкаТовары.НомерПродукта);      		// PRODUCT
				СоответствиеПоНоменклатуре.Вставить("ЕдиницаНоменклатурыКонтрагента_"      + Код, ВыборкаТовары.xmlЕдиницаИзмерения);
				СоответствиеПоНоменклатуре.Вставить("Контрагент_"                          + Код, Выборка.Контрагент);
				СоответствиеПоНоменклатуре.Вставить("xmlЕдиницаИзмерения_"                 + Код, ВыборкаТовары.xmlЕдиницаИзмерения); // Информация при выборе ед. измерения из справочника
				Продолжить;
			КонецЕсли;
			
			СтрокаТовары 					= ЭКОМДок.ТЧ_Товары.Найти(ВыборкаТовары.НомерСтроки, "НомерСтроки");
			СтрокаТовары.Номенклатура 		= ВыборкаТовары.Номенклатура;
			СтрокаТовары.ЕдиницаИзмерения 	= ВыборкаТовары.ЕдиницаНоменклатурыКонтрагента;
			
		КонецЦикла;
		
		ЭКОМДок.СуммаДокументаВсего = СуммаБезНДСВсего + СуммаНДСВсего;
		ЭКОМДок.СуммаНДСВсего       = СуммаНДСВсего;
		
		Если НЕ ЗначениеЗаполнено(ЭКОМДок.ЗаказНомер) Тогда
			ЭКОМДок.ЗаказНомер = СоответствиеИнфПолФХЖ2["номер_заказа"];
		КонецЕсли;	
		
		Если НЕ ЗначениеЗаполнено(ЭКОМДок.НакладнаяНомер) Тогда
			ЭКОМДок.НакладнаяНомер = СоответствиеИнфПолФХЖ2["номер_накладной"];
		КонецЕсли;	
		
		ЭКОМДок.ТекстОшибки = ""; // Очищаем ошибки документа
		ЭКОМДок.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.ПустаяСсылка(); // Обнуляем статус документ
		
		// Если есть уточнение записываем его в комментарий!
		ВыполнитьДополнительныеДействия(ЭКОМДок, "Входящий DPOTORG1 (акт о приемке товаров)", 
		пСтруктураДокумента,
		МассивЛогаСобытий,
		ТекстОшибки,
		СоответствиеПоОрганизации,
		СоответствиеПоКонтрагенту,, 
		СоответствиеПоНоменклатуре,
		КэшированныеЗначения);
		
		// По умолчанию документ загружается и записывается, если ЭКОМ документ не нужен в гибких настройках необходимо поставить НеЗагружатьДокумент = Истина 
		Если ЭКОМДок.НеЗагружатьДокумент = Ложь Тогда
			
			СтруктураРегистраСобытий = Новый Структура;
			СтруктураРегистраСобытий.Вставить("ДатаЗаписи"                  , ТекущаяДата());
			СтруктураРегистраСобытий.Вставить("ЭЦП"                         , СтрокаТЗСтруктур.ЭЦП);
			СтруктураРегистраСобытий.Вставить("Контрагент"                  , Выборка.Контрагент);
			СтруктураРегистраСобытий.Вставить("Организация"                 , Выборка.Организация);
			СтруктураРегистраСобытий.Вставить("НаправлениеОбмена"           , Перечисления.ЭКОМ_НаправлениеОбмена.Входящий);
			СтруктураРегистраСобытий.Вставить("ФайлИмя"                     , СтрокаТЗСтруктур.ИмяФайлаXML);
			СтруктураРегистраСобытий.Вставить("ЗаказДата"                   , ЭКОМДок.ЗаказДата);					
			СтруктураРегистраСобытий.Вставить("ЗаказНомер"                  , ЭКОМДок.ЗаказНомер);
			СтруктураРегистраСобытий.Вставить("Идентификатор"               , Выборка.ИдФайл);
			СтруктураРегистраСобытий.Вставить("СтруктураФайла"              , Новый ХранилищеЗначения(пСтруктураДокумента, Новый СжатиеДанных(9)));
			
			ДокументОбработан = ПроверитьОбработкуДокумента(ТекстОшибки, ЭКОМДок, пСтруктураДокумента, СтруктураРегистраСобытий, ПредставлениеДокументаXML, МассивЛогаСобытий);
			Если ДокументОбработан = Ложь Тогда
				Продолжить;			
			КонецЕсли;
			
		Иначе 			
			пСтруктураДокумента.Вставить("Обработан", Ложь);
			ТекстЛогаСобытий = "В гибких настройках указано не загружать документ - " + ПредставлениеДокументаXML;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
		КонецЕсли;
		
		пСтруктураДокумента.Вставить("Организация", Выборка.Организация);
		СтрокаТЗСтруктур.СтруктураДокумента = пСтруктураДокумента;
		
	КонецЦикла;
	
	Если НЕ СоответствиеПоОрганизации.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоОрганизации     , "Организация_");
	КонецЕсли;
	Если НЕ СоответствиеПоКонтрагенту.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоКонтрагенту     , "Контрагент_");
	КонецЕсли;
	Если НЕ СоответствиеПоНоменклатуре.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоНоменклатуре    , "Номенклатура_");
	КонецЕсли;
	
КонецПроцедуры // СоздатьЭКОМ_ДокАктОПриемкеТоваровDPOTORG1()

// Процедура создает Эком документ на основании входящего DPOTORG2
//
// Параметры:
//  ТЗСтруктур  				- ТаблицаЗначений 	- <описание параметра>
//  ДокументыШапка  			- <Тип.Вид> 		- <описание параметра>
//  пДокументыТабличнаяЧасть  	- <Тип.Вид> 		- <описание параметра>
//  МассивЛогаСобытий  				- <Тип.Вид> 		- <описание параметра>
//
Процедура СоздатьЭКОМ_ДокАктОРасхожденииDPOTORG2(ТЗСтруктур, ДокументыШапка, пДокументыТабличнаяЧасть, МассивЛогаСобытий) Экспорт
	
	КэшированныеЗначения = Неопределено;
	
	// Табличная часть заполняется в гибких настройках
	
	// Индентификатор отправителя и получателя берем с 3 символа чтобы убрать префикс оператора 
	// Запрос по шапке документов
	Запрос = Новый Запрос;	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДокументыШапка.Документ_ДатаДок КАК Дата,
	|	ПОДСТРОКА(ДокументыШапка.Документ_КНД, 1, 100) КАК КНД,
	|	ПОДСТРОКА(ДокументыШапка.Документ_Подписант_ЮЛ_Должн, 1, 100) КАК ПодписантДолжность,
	|	ПОДСТРОКА(ДокументыШапка.Документ_Подписант_ЮЛ_ИННЮЛ, 1, 100) КАК ПодписантИНН,
	|	ПОДСТРОКА(ДокументыШапка.Документ_Подписант_ЮЛ_ФИО_Имя, 1, 100) КАК ПодписантИмя,
	|	ПОДСТРОКА(ДокументыШапка.Документ_Подписант_ЮЛ_ФИО_Фамилия, 1, 100) КАК ПодписантФамилия,
	|	ПОДСТРОКА(ДокументыШапка.Документ_СвТНО_Плательщик_ИдСв_СвЮЛ_ИННЮЛ, 1, 100) КАК ПлательщикИНН,
	|	ПОДСТРОКА(ДокументыШапка.Документ_СвТНО_Плательщик_ИдСв_СвЮЛ_КПП, 1, 100) КАК ПлательщикКПП,
	|	ПОДСТРОКА(ДокументыШапка.Документ_СвТНО_Плательщик_ИдСв_СвЮЛ_НаимОрг, 1, 100) КАК ПлательщикНаимОрг,
	|	ПОДСТРОКА(ДокументыШапка.Документ_СвТНО_Поставщик_ИдСв_СвЮЛ_ИННЮЛ, 1, 100) КАК ПоставщикИНН,
	|	ПОДСТРОКА(ДокументыШапка.Документ_СвТНО_Поставщик_ИдСв_СвЮЛ_КПП, 1, 100) КАК ПоставщикКПП,
	|	ПОДСТРОКА(ДокументыШапка.Документ_СвТНО_Поставщик_ИдСв_СвЮЛ_НаимОрг, 1, 100) КАК ПоставщикНаимОрг,
	|	ДокументыШапка.Документ_СвТНО_ТН_ДатаТН КАК ДатаТТН,
	|	ПОДСТРОКА(ДокументыШапка.Документ_СвТНО_ТН_НомТН, 1, 100) КАК НомерТТН,
	|	ПОДСТРОКА(ДокументыШапка.ИдФайл, 1, 256) КАК ИдФайл,
	|	ПОДСТРОКА(ДокументыШапка.СвУчДокОбор_ИдОтпр, 4, 256) КАК ИдентификаторОтправителя,
	|	ПОДСТРОКА(ДокументыШапка.СвУчДокОбор_ИдПок, 4, 256) КАК ИдентификаторПокупателя,
	|	ПОДСТРОКА(ДокументыШапка.СвУчДокОбор_СвОЭДОтпр_ИННЮЛ, 1, 100) КАК ИННОЭДОтправителя,
	|	ПОДСТРОКА(ДокументыШапка.СвУчДокОбор_СвОЭДОтпр_ИдЭДО, 1, 100) КАК ИДОЭДОтправителя,
	|	ПОДСТРОКА(ДокументыШапка.СвУчДокОбор_СвОЭДОтпр_НаимОрг, 1, 100) КАК НаименованиеОЭДОтправителя,
	|	ДокументыШапка.ВидДокумента КАК ВидДокумента
	|ПОМЕСТИТЬ ДокументыШапка
	|ИЗ
	|	&ДокументыШапка КАК ДокументыШапка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДокументыШапка.ИдФайл,
	|	ДокументыШапка.Дата,
	|	ЕСТЬNULL(ЭКОМ_Документы.Ссылка, НЕОПРЕДЕЛЕНО) КАК ЭКОМДок,
	|	ЭКОМ_Документы.ПометкаУдаления,
	|	ЭКОМ_Документы.СтатусОбработкиДокумента,
	|	ЭКОМ_GLN_Контрагент.Объект КАК Контрагент,
	|	ДокументыШапка.ИдентификаторОтправителя КАК ИдентификаторКонтрагента,
	|	ЭКОМ_GLN_Организация.Объект КАК Организация,
	|	ДокументыШапка.ИдентификаторПокупателя КАК ИдентификаторОрганизации
	|ИЗ
	|	ДокументыШапка КАК ДокументыШапка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭКОМ_Документы КАК ЭКОМ_Документы
	|		ПО ДокументыШапка.НомерТТН = ЭКОМ_Документы.НакладнаяНомер
	|			И ДокументыШапка.ДатаТТН = ЭКОМ_Документы.НакладнаяДата
	|			И (ЭКОМ_Документы.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.DPOTORG2_Входящий))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Организация
	|		ПО (ДокументыШапка.ИдентификаторПокупателя = (ВЫРАЗИТЬ(ЭКОМ_GLN_Организация.Ид_ОЭД КАК СТРОКА(256))))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Контрагент
	|		ПО (ДокументыШапка.ИдентификаторОтправителя = (ВЫРАЗИТЬ(ЭКОМ_GLN_Контрагент.Ид_ОЭД КАК СТРОКА(256))))";
	
	Запрос.УстановитьПараметр("ДокументыШапка", ДокументыШапка);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ПроверкаНаДублирование 		= Новый Соответствие;
	СоответствиеПоОрганизации	= Новый Соответствие;
	СоответствиеПоКонтрагенту	= Новый Соответствие;
	СоответствиеПоНоменклатуре	= Новый Соответствие;
	
	Пользователь = НайтиТекущегоПользователя();
	ИмяСобытия = "Создание документа Docrobot-DPOTORG2";
	Пока Выборка.Следующий() Цикл
		
		// Для проверки дублирования строк
		Если ПроверкаНаДублирование.Получить(Выборка.ИдФайл) = Неопределено Тогда
			ПроверкаНаДублирование.Вставить(Выборка.ИдФайл, "Строка добавлена");
		Иначе			
			ТекстЛогаСобытий = "Дубль данных, проверьте GLN организации, контрагента, точки доставки ИД документа - " + Выборка.ИдФайл;	
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Продолжить;
			
		КонецЕсли;
		
		// Получаем структуру документа
		пСтруктураДокумента = Неопределено;
		СтрокаТЗСтруктур = ТЗСтруктур.Найти(Выборка.ИдФайл, "ИдентификаторФайла");
		Если СтрокаТЗСтруктур = Неопределено Тогда
			ТекстЛогаСобытий = "Не найдена структура документа с ИД = " + Выборка.ИдФайл;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

			Продолжить;
		Иначе
			пСтруктураДокумента = СтрокаТЗСтруктур.СтруктураДокумента;
		КонецЕсли;
		
		ПредставлениеДокументаXML = Строка(пСтруктураДокумента.ВидДокумента) + " № " + пСтруктураДокумента.Документ_СвТНО_ТН_НомТН 
		+ " от " + Формат(пСтруктураДокумента.Документ_СвТНО_ТН_ДатаТН, "ДФ='dd.MM.yyyy ""г.""'");
		
		Если Выборка.ЭКОМДок = Неопределено Тогда
			ЭКОМДок = Документы.ЭКОМ_Документы.СоздатьДокумент();
		ИначеЕсли (Выборка.ПометкаУдаления = Истина 
			ИЛИ Выборка.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.НеОбработан) Тогда
			ЭКОМДок = Выборка.ЭКОМДок.ПолучитьОбъект();
			ЭКОМДок.ПометкаУдаления = ЛОЖЬ;
			ЭКОМДок.ТЧ_Товары.Очистить();
			ЭКОМДок.ТЧ_Уточнение.Очистить();
			// Очищение остальных табличных частей документов в гибких настроках при необходимости
		Иначе
			ТекстЛогаСобытий = ПредставлениеДокументаXML + " - ЭКОМ документ уже существует в 1С, номер = " + Выборка.ЭКОМДок.Номер + " от " + Выборка.ЭКОМДок.Дата;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Выборка.Организация) Тогда
			xmlОрганизацияGLN = Выборка.ИдентификаторОрганизации;
			СоответствиеПоОрганизации.Вставить("Организация_" + xmlОрганизацияGLN, xmlОрганизацияGLN);	
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Выборка.Контрагент) Тогда
			xmlКонтрагентGLN = Выборка.ИдентификаторКонтрагента;
			СоответствиеПоКонтрагенту.Вставить("Контрагент_" + xmlКонтрагентGLN, xmlКонтрагентGLN);	
		КонецЕсли;
		
		ЭКОМДок.Организация               = Выборка.Организация;
		ЭКОМДок.xmlОрганизация            = пСтруктураДокумента.СвУчДокОбор_ИдПок;
		ЭКОМДок.ВидДокумента              = пСтруктураДокумента.ВидДокумента;
		ЭКОМДок.Контрагент                = Выборка.Контрагент;
		ЭКОМДок.xmlКонтрагент             = пСтруктураДокумента.СвУчДокОбор_ИдОтпр;
		ЭКОМДок.Дата                      = ТекущаяДата();
		//ЭКОМДок.ЗаказНомер                = СоответствиеИнфПолФХЖ1["номер_заказа"];
		//ЭКОМДок.ЗаказДата                 = ДатаИзXML_в_1С(СоответствиеИнфПолФХЖ1["дата_заказа"]);
		ЭКОМДок.ИмяФайла                  = СтрокаТЗСтруктур.ИмяФайлаXML;		
		//ЭКОМДок.xmlТочкаДоставки
		ЭКОМДок.Ответственный             = Пользователь;
		ЭКОМДок.НакладнаяДата             = пСтруктураДокумента.Документ_СвТНО_ТН_ДатаТН;
		ЭКОМДок.НакладнаяНомер            = пСтруктураДокумента.Документ_СвТНО_ТН_НомТН;
		//ЭКОМДок.ТипДокумента              = пСтруктураДокумента.Документ_Функция; 
		ЭКОМДок.Версия                    = пСтруктураДокумента.ВерсПрог;
		ЭКОМДок.НомерТранзакции           = пСтруктураДокумента.ИдФайл;
		ЭКОМДок.xmlВалюта                 = "RUB";
		ЭКОМДок.ФайлДата                  = пСтруктураДокумента.Документ_ДатаДок;	
		
		// ТЧ товары
		СуммаБезНДСВсегоДо 		= 0;
		СуммаБезНДСВсегоПосле 	= 0;
		СуммаНДСВсегоДо    		= 0;
		СуммаНДСВсегоПосле    	= 0;
		ТекстОшибки      		= "";
		
		Для Каждого СтруктСтрока Из пСтруктураДокумента.ДокументТЧ Цикл
			
			// Основные ИнфПолФХЖ2
			СоответствиеИнфПолФХЖ2 = Новый Соответствие;
			СоответствиеИнфПолФХЖ2.Вставить("номер_заказа", 		"");
			СоответствиеИнфПолФХЖ2.Вставить("номер_акта", 			"");
			СоответствиеИнфПолФХЖ2.Вставить("магазин", 				"");
			СоответствиеИнфПолФХЖ2.Вставить("номер_накладной", 		"");
			СоответствиеИнфПолФХЖ2.Вставить("штрихкод", 			"");
			СоответствиеИнфПолФХЖ2.Вставить("код_материала", 		"");
			СоответствиеИнфПолФХЖ2.Вставить("позиция_заказа", 		"");
			СоответствиеИнфПолФХЖ2.Вставить("номер_торг2", 	"");
			
			Если СтруктСтрока.Свойство("Документ_СвТНО_ТН_Таблица_СвТов_ИнфПолСтр") Тогда
				Для каждого Элемент Из СтруктСтрока.Документ_СвТНО_ТН_Таблица_СвТов_ИнфПолСтр Цикл
					
					Если НЕ СоответствиеИнфПолФХЖ2.Получить(Элемент.Ключ) = Неопределено Тогда
						СоответствиеИнфПолФХЖ2[Элемент.Ключ] = Элемент.Значение;		
					КонецЕсли;
					
				КонецЦикла;		
			КонецЕсли;
			
			СтавкаНДСДо			= СтавкаНДСЧислом(СтруктСтрока.Документ_СвТНО_ТН_Таблица_СвТов_СтавкаНДСДо);
			СтавкаНДСПосле 		= СтавкаНДСЧислом(СтруктСтрока.Документ_СвТНО_ТН_Таблица_СвТов_СтавкаНДСПосле);
			СуммаБезНДСДо 		= ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.Документ_СвТНО_ТН_Таблица_СвТов_СумБезНДСДо);
			СуммаБезНДСПосле 	= ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.Документ_СвТНО_ТН_Таблица_СвТов_СумБезНДСПосле);
			СуммаНДСДо   		= ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.Документ_СвТНО_ТН_Таблица_СвТов_СумНалДо);
			СуммаНДСПосле   	= ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.Документ_СвТНО_ТН_Таблица_СвТов_СумНалПосле);
			СуммаСНДСДо   		= ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.Документ_СвТНО_ТН_Таблица_СвТов_СумУчНДСДо);
			СуммаСНДСПосле   	= ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.Документ_СвТНО_ТН_Таблица_СвТов_СумУчНДСПосле);
			ЦенаБезНДСДо  		= ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.Документ_СвТНО_ТН_Таблица_СвТов_ЦенаДо);
			ЦенаБезНДСПосле  	= ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.Документ_СвТНО_ТН_Таблица_СвТов_ЦенаПосле);
			КоличествоЗаказа	= ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.Документ_СвТНО_ТН_Таблица_СвТов_НеттоДо);
			Количество			= ЭКОМ_ПреобразоватьВЧисло(СтруктСтрока.Документ_СвТНО_ТН_Таблица_СвТов_НеттоПосле);
			
			ЦенаСНДСДо 			= Окр(СуммаСНДСДо / ?(КоличествоЗаказа = 0, 1, КоличествоЗаказа), 2);
			ЦенаСНДСПосле 		= Окр(СуммаСНДСПосле / ?(Количество = 0, 1, Количество), 2);
			
			НовСтрока = ЭКОМДок.ТЧ_Товары.Добавить();
			НовСтрока.xmlЕдиницаИзмерения = СтруктСтрока.Документ_СвТНО_ТН_Таблица_СвТов_НаимЕдИзм;
			НовСтрока.Цена        = ЦенаБезНДСДо;
			НовСтрока.ЦенаСНДС    = ЦенаСНДСДо;
			НовСтрока.Сумма       = СуммаБезНДСДо;
			НовСтрока.СтавкаНДС   = СтавкаНДСДо;
			НовСтрока.СуммаНДС    = СуммаНДСДо;
			НовСтрока.Сумма_с_НДС = СуммаСНДСДо;
			НовСтрока.КоличествоПоставляемое 	= Количество;
			НовСтрока.КоличествоЗаказанное 		= КоличествоЗаказа;
			Штрихкод = СтруктСтрока.Документ_СвТНО_ТН_Таблица_СвТов_КодТов;
			Штрихкод = ?(ЗначениеЗаполнено(Штрихкод), Штрихкод, СоответствиеИнфПолФХЖ2["штрихкод"]);
			НовСтрока.НомерПродукта           = Штрихкод;
			НовСтрока.НомерПродуктаПокупателя = СоответствиеИнфПолФХЖ2["код_материала"];
			НовСтрока.ОписаниеПродукта        = СтруктСтрока.Документ_СвТНО_ТН_Таблица_СвТов_НаимТов;
			
			СуммаБезНДСВсегоДо 		= СуммаБезНДСВсегоДо + СуммаБезНДСДо;
			СуммаБезНДСВсегоПосле 	= СуммаБезНДСВсегоПосле + СуммаБезНДСПосле;
			
			СуммаНДСВсегоДо    		= СуммаНДСВсегоДо + СуммаНДСДо;
			СуммаНДСВсегоПосле    	= СуммаНДСВсегоПосле + СуммаНДСПосле;
			
			НовСтрУточ = ЭКОМДок.ТЧ_Уточнение.Добавить();
			НовСтрУточ.ОписаниеПродукта       = СтруктСтрока.Документ_СвТНО_ТН_Таблица_СвТов_НаимТов;
			НовСтрУточ.КоличествоПоставляемое = КоличествоЗаказа;
			НовСтрУточ.КоличествоФактическое  = Количество;
			НовСтрУточ.ЦенаДо                 = ЦенаБезНДСДо; 
			НовСтрУточ.ЦенаПосле              = ЦенаБезНДСПосле;
			НовСтрУточ.СумБезНДСДо            = СуммаБезНДСДо;
			НовСтрУточ.СумБезНДСПосле         = СуммаБезНДСПосле;
			НовСтрУточ.СтавкаНДСДо            = СтавкаНДСДо;
			НовСтрУточ.СтавкаНДСПосле         = СтавкаНДСПосле;
			НовСтрУточ.СумУчНДСДо             = СуммаСНДСДо;
			НовСтрУточ.СумУчНДСПосле          = СуммаСНДСПосле;
			
		КонецЦикла;
		
		// Заполняем номенклатуру.
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Товары.НомерСтроки,
		|	Товары.НомерПродукта,
		|	Товары.НомерПродуктаПокупателя,
		|	Товары.xmlЕдиницаИзмерения
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&ТЧТовары КАК Товары
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.НомерСтроки,
		|	ВТ.НомерПродукта,
		|	ВТ.НомерПродуктаПокупателя,
		|	ВТ.xmlЕдиницаИзмерения,
		|	ЭКОМ_НоменклатураКонтрагентов.Номенклатура,
		|	ЭКОМ_НоменклатураКонтрагентов.ЕдиницаНоменклатурыКонтрагента
		|ИЗ
		|	ВТ КАК ВТ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_НоменклатураКонтрагентов КАК ЭКОМ_НоменклатураКонтрагентов
		|		ПО ВТ.НомерПродукта = ЭКОМ_НоменклатураКонтрагентов.ШтрихКодНоменклатурыКонтрагента
		|			И (ЭКОМ_НоменклатураКонтрагентов.Контрагент = &Контрагент)";
		
		Запрос.УстановитьПараметр("ТЧТовары", ЭКОМДок.ТЧ_Товары);
		Запрос.УстановитьПараметр("Контрагент", Выборка.Контрагент);
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаТовары = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаТовары.Следующий() Цикл
			
			Если НЕ ЗначениеЗаполнено(ВыборкаТовары.Номенклатура) 
				И ЗначениеЗаполнено(Выборка.Контрагент) Тогда
				
				Код = ?(ЗначениеЗаполнено(ВыборкаТовары.НомерПродукта), ВыборкаТовары.НомерПродукта, ВыборкаТовары.НомерПродуктаПокупателя) + "_" + ЭКОМДок.xmlКонтрагент;
				СоответствиеПоНоменклатуре.Вставить("КодНоменклатурыКонтрагента_"          + Код, ВыборкаТовары.НомерПродуктаПокупателя); 	// PRODUCTIDBUYER
				СоответствиеПоНоменклатуре.Вставить("ШтрихКодНоменклатурыКонтрагента_"     + Код, ВыборкаТовары.НомерПродукта);      		// PRODUCT
				СоответствиеПоНоменклатуре.Вставить("ЕдиницаНоменклатурыКонтрагента_"      + Код, ВыборкаТовары.xmlЕдиницаИзмерения);
				СоответствиеПоНоменклатуре.Вставить("Контрагент_"                          + Код, Выборка.Контрагент);
				СоответствиеПоНоменклатуре.Вставить("xmlЕдиницаИзмерения_"                 + Код, ВыборкаТовары.xmlЕдиницаИзмерения); // Информация при выборе ед. измерения из справочника
				Продолжить;
			КонецЕсли;
			
			СтрокаТовары 					= ЭКОМДок.ТЧ_Уточнение.Найти(ВыборкаТовары.НомерСтроки, "НомерСтроки");
			СтрокаТовары.Номенклатура 		= ВыборкаТовары.Номенклатура;
			СтрокаТовары.ЕдиницаИзмерения 	= ВыборкаТовары.ЕдиницаНоменклатурыКонтрагента;
			
			СтрокаТовары 					= ЭКОМДок.ТЧ_Товары.Найти(ВыборкаТовары.НомерСтроки, "НомерСтроки");
			СтрокаТовары.Номенклатура 		= ВыборкаТовары.Номенклатура;
			СтрокаТовары.ЕдиницаИзмерения 	= ВыборкаТовары.ЕдиницаНоменклатурыКонтрагента;
			
		КонецЦикла;
		
		ЭКОМДок.СуммаДокументаВсего = СуммаБезНДСВсегоПосле + СуммаНДСВсегоПосле;
		ЭКОМДок.СуммаНДСВсего       = СуммаНДСВсегоПосле;
		
		Если НЕ ЗначениеЗаполнено(ЭКОМДок.ЗаказНомер) Тогда
			ЭКОМДок.ЗаказНомер 		= СоответствиеИнфПолФХЖ2["номер_заказа"];
		КонецЕсли;	
		
		Если НЕ ЗначениеЗаполнено(ЭКОМДок.НакладнаяНомер) Тогда
			ЭКОМДок.НакладнаяНомер 	= СоответствиеИнфПолФХЖ2["номер_накладной"];
		КонецЕсли;	
		
		Если НЕ ЗначениеЗаполнено(ЭКОМДок.ФайлНомер) Тогда
			ЭКОМДок.ФайлНомер 		= СоответствиеИнфПолФХЖ2["номер_торг2"];
		КонецЕсли;
		
		ЭКОМДок.ТекстОшибки = ""; // Очищаем ошибки документа
		ЭКОМДок.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.ПустаяСсылка(); // Обнуляем статус документ
		
		// Если есть уточнение записываем его в комментарий!
		ВыполнитьДополнительныеДействия(ЭКОМДок, "Входящий DPOTORG2 (акт о расхождении)",
		пСтруктураДокумента,
		МассивЛогаСобытий,
		ТекстОшибки,
		СоответствиеПоОрганизации,
		СоответствиеПоКонтрагенту,, 
		СоответствиеПоНоменклатуре,
		КэшированныеЗначения);
		
		// По умолчанию документ загружается и записывается, если ЭКОМ документ не нужен в гибких настройках необходимо поставить НеЗагружатьДокумент = Истина 
		Если ЭКОМДок.НеЗагружатьДокумент = Ложь Тогда
			
			СтруктураРегистраСобытий = Новый Структура;
			СтруктураРегистраСобытий.Вставить("ДатаЗаписи"                  , ТекущаяДата());
			СтруктураРегистраСобытий.Вставить("ЭЦП"                         , СтрокаТЗСтруктур.ЭЦП);
			СтруктураРегистраСобытий.Вставить("Контрагент"                  , Выборка.Контрагент);
			СтруктураРегистраСобытий.Вставить("Организация"                 , Выборка.Организация);
			СтруктураРегистраСобытий.Вставить("НаправлениеОбмена"           , Перечисления.ЭКОМ_НаправлениеОбмена.Входящий);
			СтруктураРегистраСобытий.Вставить("ФайлИмя"                     , СтрокаТЗСтруктур.ИмяФайлаXML);
			СтруктураРегистраСобытий.Вставить("ЗаказДата"                   , ЭКОМДок.ЗаказДата);					
			СтруктураРегистраСобытий.Вставить("ЗаказНомер"                  , ЭКОМДок.ЗаказНомер);
			СтруктураРегистраСобытий.Вставить("Идентификатор"               , Выборка.ИдФайл);
			СтруктураРегистраСобытий.Вставить("СтруктураФайла"              , Новый ХранилищеЗначения(пСтруктураДокумента, Новый СжатиеДанных(9)));
			
			ДокументОбработан = ПроверитьОбработкуДокумента(ТекстОшибки, ЭКОМДок, пСтруктураДокумента, СтруктураРегистраСобытий, ПредставлениеДокументаXML, МассивЛогаСобытий);
			Если ДокументОбработан = Ложь Тогда
				Продолжить;			
			КонецЕсли;
			
		Иначе 		
			пСтруктураДокумента.Вставить("Обработан", Ложь);
			ТекстЛогаСобытий = "В гибких настройках указано не загружать документ - " + ПредставлениеДокументаXML;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		КонецЕсли;
		
		пСтруктураДокумента.Вставить("Организация", Выборка.Организация);
		СтрокаТЗСтруктур.СтруктураДокумента = пСтруктураДокумента;
		
	КонецЦикла;
	
	Если НЕ СоответствиеПоОрганизации.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоОрганизации, "Организация_");
	КонецЕсли;
	Если НЕ СоответствиеПоКонтрагенту.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоКонтрагенту, "Контрагент_");
	КонецЕсли;
	
	Если НЕ СоответствиеПоНоменклатуре.Количество() = 0 Тогда
		НастройкиПараметровЗаписатьНабором(СоответствиеПоНоменклатуре    , "Номенклатура_");
	КонецЕсли;
	
КонецПроцедуры // СоздатьЭКОМ_ДокАктОРасхожденииDPOTORG2()

Функция ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, УровеньЛогирования, ИмяСобытия)		
	ЗаписьСтруктурыЛога = Вычислить("ЭКОМ_ОбщегоНазначения.ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, УровеньЛогирования, ИмяСобытия)");	
	Возврат ЗаписьСтруктурыЛога;
	
КонецФункции

// Функция проверяет возможность заблокировать указанную операцию и в случае такой возможности блокирует ее
//
// Параметры:
//  ИмяОперации  - Строка - наименование операции для блокировки
//
// Возвращаемое значение:
//   Структура   - информация о блокировке операции
//
Функция ПроверитьУстановитьБлокировкуОперации(ТипДокумента, НаправлениеОбмена, МассивЛогаСобытий) Экспорт
	
    ИмяСобытия = "Проверка/установка блокировки " + ТипДокумента;
	
	// В случае ошибки добавим в массив текст лога 
	ТекстЛогаСобытий = "Процесс " + НаправлениеОбмена + " - " + ТипДокумента + " уже запущен другим пользователем(%время%). 
	|Для ручной разблокировки (в случае неудачного завершения работы) перейдите в Настройки - Хранение данных и нажмите кнопку <<<Разблокировать обмен>>>";
	
	ПродолжитьОбмен = Ложь;
	ИмяОперации = "Блокировка" + НаправлениеОбмена + "_" + ТипДокумента;
	Блокировать = ПолучитьРежимУправленияБлокировкойДанныхПоУмолчанию(); 	
	// Установка блокировки
	НачатьТранзакцию();
	Попытка
		
		Если Блокировать = Истина Тогда
			БлокировкаДанных 		= Новый БлокировкаДанных;
			ЭлементБлокировки 		= БлокировкаДанных.Добавить("РегистрСведений.ЭКОМ_ЗначениеДополнительныхКонстант");
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			ЭлементБлокировки.УстановитьЗначение("ДополнительнаяКонстанта", ИмяОперации);
			ЭлементБлокировки.УстановитьЗначение("Измерение", "Блокировка");
			БлокировкаДанных.Заблокировать();	
		КонецЕсли;
		
		// Читаем настройки и записываем если процесс еще не запущен. 
		МенеджерЗаписи = РегистрыСведений.ЭКОМ_ЗначениеДополнительныхКонстант.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ДополнительнаяКонстанта = ИмяОперации;
		МенеджерЗаписи.Измерение               = "Блокировка";
		МенеджерЗаписи.Прочитать();	
		Если МенеджерЗаписи.Выбран() Тогда			
			ВремяНачалаБлокировки = ?(ТипЗнч(МенеджерЗаписи.ЗначениеДополнительнойКонстанты) = Тип("Булево"), Дата(0001, 01, 01), МенеджерЗаписи.ЗначениеДополнительнойКонстанты);
			ВремяБлокировки = (ТекущаяДата() - ВремяНачалаБлокировки)/(60*60);
			Если ВремяБлокировки <= 2 Тогда // если меньше 2 часов 			
				ТекстЛогаСобытий = СтрЗаменить(ТекстЛогаСобытий, "%время%", ВремяНачалаБлокировки);
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
				
			Иначе
				МенеджерЗаписи.ЗначениеДополнительнойКонстанты = ТекущаяДата();
				МенеджерЗаписи.Записать();
				
				ПродолжитьОбмен = Истина;
				
			КонецЕсли;
		Иначе
			МенеджерЗаписи.ДополнительнаяКонстанта         = ИмяОперации;
			МенеджерЗаписи.Измерение                       = "Блокировка";
			МенеджерЗаписи.ЗначениеДополнительнойКонстанты = ТекущаяДата();
			МенеджерЗаписи.Записать();
			
			ПродолжитьОбмен = Истина;
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ТекстЛогаСобытий = ОписаниеОшибки() + " - " + ТекстЛогаСобытий;
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить();
	КонецПопытки;
	
	Возврат ПродолжитьОбмен;
	
КонецФункции // ПроверитьУстановитьБлокировкуОперации()

// Процедура распределяет для входящей коллекции документов какой из записи необходимо задать вопрос о повторном создании.
Процедура РаспределитьКоллекциюСоздаваемыхДокументов(СинонимКнопки, ТипОбмена, МассивСтрок, ВОбработку, Повторные, СинонимПриемника) Экспорт
	
	// Получаем наименования документов для дальнейшей обработки
	КолИсточника = Неопределено;
	Результат = Настройка_Параметр_Прочитать("СтруктураФайлаXMLДокументы");// = ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере("СтруктураФайлаXMLДокументы");
	Если ТипЗнч(Результат) = Тип("ДеревоЗначений") Тогда 		
		Для Каждого Стр Из Результат.Строки Цикл 
			Если Стр.Кнопка = СинонимКнопки Тогда
				ИмяИсточника = Стр.Источник;
				КолИсточника = Стр.КолонкаИсточника;
				ИмяДокумента = Стр.Приемник;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ИмяДокумента = Неопределено ИЛИ КолИсточника = Неопределено Тогда
			ВОбработку = МассивСтрок;
			Возврат; 
		КонецЕсли;					
	КонецЕсли;
	
	// Найдем имя источника из ТЧ
	Попытка
		Для Каждого Стр Из МассивСтрок Цикл 
			Если ЗначениеЗаполнено(Стр[КолИсточника])Тогда 
				ИмяИсточника = Стр[КолИсточника].Метаданные().Имя;
				Прервать;
			КонецЕсли;	
		КонецЦикла;
	Исключение
	КонецПопытки;	
	
	// Если предыдущие способы не помогли
	ЭКОМ_ДеревоКонфигурации = Настройка_Параметр_Прочитать("СлужебныйДеревоКонфигурации", , "Служебный");
	СтрокаДерева = ЭКОМ_ДеревоКонфигурации.Строки.Найти(ИмяДокумента, "Синоним");
	ИмяДокумента = ?(ЗначениеЗаполнено(СтрокаДерева),СтрокаДерева.Имя,ИмяДокумента);
	СтрокаДерева = ЭКОМ_ДеревоКонфигурации.Строки.Найти(ИмяИсточника, "Синоним");
	ИмяИсточника = ?(ЗначениеЗаполнено(СтрокаДерева),СтрокаДерева.Имя,ИмяИсточника);
	
	// Определяем наименование регистра сведений в котором будем искать повторы
	Если ТипОбмена = "Поставщик" Тогда
		ИмяРС = "ЭКОМ_ЦепочкиДокументовПоставщика";		
	ИначеЕсли ТипОбмена = "Сеть" Тогда
		ИмяРС = "ЭКОМ_ЦепочкиДокументовПокупателя";
	КонецЕсли;
	
	// Получаем измерения регистра сведений по которым осуществляем поиск
	Попытка
		Если НЕ ИмяРС = Неопределено Тогда
			Для Каждого Изм Из Метаданные.РегистрыСведений[ИмяРС].Измерения Цикл 
				Если Изм.Тип.СодержитТип(Тип("ДокументСсылка."+ИмяДокумента)) = Истина Тогда   
					ИзмерениеДляПоиска = Изм.Имя;
				КонецЕсли;
				Если Изм.Тип.СодержитТип(Тип("ДокументСсылка."+ИмяИсточника)) = Истина Тогда 
					ИзмерениеИсточника = Изм.Имя;						
				КонецЕсли;
			КонецЦикла;		
		КонецЕсли;
	Исключение
	    ИзмерениеДляПоиска = Неопределено;
		ИзмерениеИсточника = Неопределено;
	КонецПопытки;
	
	//Если не нашлось измерений отправляем на создание всех
	Если НЕ ЗначениеЗаполнено(ИзмерениеДляПоиска) ИЛИ НЕ ЗначениеЗаполнено(ИзмерениеИсточника) Тогда 
		ВОбработку = МассивСтрок;
		Возврат;
	КонецЕсли;

	СинонимПриемника = Метаданные.Документы[ИмяДокумента].Синоним;
	Если ИзмерениеДляПоиска = "СЧФ_Кор" и НЕ ИмяИсточника = "КорректировкаРеализации" Тогда
		ИзмерениеДляПоиска = "СЧФ";
	ИначеЕсли ИзмерениеДляПоиска = "СЧФ" и ИмяИсточника = "КорректировкаРеализации" Тогда
		ИзмерениеДляПоиска = "СЧФ_Кор";
	КонецЕсли;
	Если ИмяИсточника = "ЭКОМ_Документы" Тогда 
		ИзмерениеИсточника = ?(ТипОбмена = "Поставщик","ORDER","DESADV"); 
	КонецЕсли;
		
	// Готовим массив источников для запроса. В цикле, потому что МассивСтрок приходит с разными типами.
	Источники = Новый Массив;
	Для каждого Стр Из МассивСтрок Цикл	
		Источники.Добавить(Стр[КолИсточника]);		
	КонецЦикла;

	// Ищем записи у котрых заполнено искомое зачение, строки из МассивСтрок совпавшие с такими записями будут отнесены к повторным.
	Запрос = Новый Запрос("ВЫБРАТЬ "+ИзмерениеИсточника+" ИЗ РегистрСведений."+ИмяРС+" ГДЕ "+ИзмерениеИсточника+" В(&Источники) И (НЕ " 
	+ИзмерениеДляПоиска+" = Значение(Документ."+ИмяДокумента+".ПустаяСсылка) И НЕ "+ИзмерениеДляПоиска+" = Неопределено)");
	Запрос.УстановитьПараметр("Источники", Источники);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Для каждого Стр Из МассивСтрок Цикл
		Найден = Результат.Найти(Стр[КолИсточника],ИзмерениеИсточника);
		
		Если Найден = Неопределено Тогда
			ВОбработку.Добавить(Стр);			
		Иначе
			Повторные.Добавить(Стр);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

