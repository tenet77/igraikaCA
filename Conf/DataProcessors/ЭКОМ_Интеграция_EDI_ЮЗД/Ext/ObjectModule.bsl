		|	ЭКОМ_Квитанции.ИдентификаторОснования,
		|	ЭКОМ_Квитанции.ДатаЗаписи,
		|	ВЫРАЗИТЬ("""" КАК СТРОКА(250)) КАК ТекстОшибки,
		|	ВЫРАЗИТЬ("""" КАК СТРОКА(250)) КАК ЛогСобытий,
		|	ЛОЖЬ КАК Отметка
		|ИЗ
		|	РегистрСведений.ЭКОМ_Квитанции КАК ЭКОМ_Квитанции";
		
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

Функция СформироватьКвитанцию(ПрофильОбмена, ДанныеЗапроса, Ошибка, МассивЛогаСобытий) Экспорт
	
	ИмяСобытия = "Сформировать квитанции";
	
	ТокенАвторизации = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьТокенАвторизации(ПрофильОбмена, Ошибка, МассивЛогаСобытий)");
	Если Ошибка.ЕстьОшибка Тогда		
		ТекстЛогаСобытий = "При получении токена(авторизации) возникла ошибка - Код: " + Ошибка.КодОшибки + " - " + Ошибка.ТекстОшибки;
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		Возврат Неопределено;		
	КонецЕсли;
	
	Квитанция = "";
	
	ТекстКоманды = "/Api/V1/Edo/Ticket/Generate";                                                                                  
	
	ЗаголовокHTTP = Новый Соответствие;
	ЗаголовокHTTP.Вставить("Content-type", "application/json");
	ЗаголовокHTTP.Вставить("Accept"      , "application/json");	
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("МетодHTTP"    , "POST");
	ПараметрыЗапроса.Вставить("ЗаголовокHTTP", ЗаголовокHTTP);
	
	Результат = Вычислить("ЭКОМ_ОбщегоНазначения.ВыполнитьЗапрос(ТекстКоманды, ПрофильОбмена, ДанныеЗапроса, ПараметрыЗапроса, Ошибка, МассивЛогаСобытий)");
	
	Если Ошибка.ЕстьОшибка Тогда	
		ТекстЛогаСобытий = "При формировании квитанции возникла ошибка - Код: " + Ошибка.КодОшибки + " - " 
		+ Ошибка.ТекстОшибки + " " + Вычислить("ЭКОМ_ОбщегоНазначения.API_СформироватьЗапрос(ДанныеЗапроса)");
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		Возврат Неопределено;	
	КонецЕсли;
	
	Квитанция = СтрЗаменить(Сред(Результат.Текст, 13, Найти(Результат.Текст, "varMessage")-16), "\", "");
	Квитанция = СтрЗаменить(Квитанция,"\","");
	
	ФайлКвитанции = Base64Значение(Квитанция);
	Если ФайлКвитанции = Неопределено ИЛИ
		НЕ Найти(Результат.Текст, "No document") = 0 Тогда
		
		Ошибка.Вставить("ЕстьОшибка" , Истина); 
		Ошибка.Вставить("КодОшибки"  , "");
		Ошибка.Вставить("ТекстОшибки", Результат.Текст);
		
		ТекстЛогаСобытий = "При формировании квитнации возникла ошибка - Код: " + Ошибка.КодОшибки + " - " + Ошибка.ТекстОшибки + " " + Результат.Текст;
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		Возврат Неопределено;
		
	Иначе
		
		Возврат ФайлКвитанции;
		
	КонецЕсли;
	
КонецФункции

Функция ИзвлечьИнформациюОДокументе(Идентификатор, Тип, Ошибка, ПрофильОбмена, МассивЛогаСобытий) Экспорт
	
	ИмяСобытия = "Извлечение информации о документе";
	ТокенАвторизации = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьТокенАвторизации(ПрофильОбмена, Ошибка, МассивЛогаСобытий)");	  
	Если Ошибка.ЕстьОшибка Тогда		
		ТекстЛогаСобытий = "При получении токена(авторизации) возникла ошибка - Код: " + Ошибка.КодОшибки + " - " + Ошибка.ТекстОшибки;
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		Возврат Неопределено;		
	КонецЕсли;
	
	ТекстКоманды =  "/Api/V1/Edo/TimeLine/GetDocData";                                                                                  
	
	ДанныеЗапроса = Новый Структура;
	ДанныеЗапроса.Вставить("identifier"     , Идентификатор);
	ДанныеЗапроса.Вставить("varToken"       , ТокенАвторизации);	
	
	ЗаголовокHTTP = Новый Соответствие;
	ЗаголовокHTTP.Вставить("Content-type", "application/json");
	ЗаголовокHTTP.Вставить("Accept"      , "application/json");	
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("МетодHTTP"    , "POST");
	ПараметрыЗапроса.Вставить("ЗаголовокHTTP", ЗаголовокHTTP);
	
	Результат = Вычислить("ЭКОМ_ОбщегоНазначения.ВыполнитьЗапрос(ТекстКоманды, ПрофильОбмена, ДанныеЗапроса, ПараметрыЗапроса, Ошибка, МассивЛогаСобытий)");
	Если Ошибка.ЕстьОшибка Тогда	
		Возврат Неопределено;	
	КонецЕсли;
	
	Соответствие = UnJSON(Результат.Текст);
	
	Структура = Новый Структура();
	ТекЭлемент = Соответствие.Получить("document");
	Если НЕ ТекЭлемент = Неопределено Тогда	
		
		ДатаП = ТекЭлемент.Получить("event_date");
		Структура.Вставить("ИД_Документа"           , ТекЭлемент.Получить("document_id"));	
		Структура.Вставить("Дата"                   , ДатаИзXML_в_1С(ДатаП));	
		Структура.Вставить("Номер"                  , ТекЭлемент.Получить("number"));	
		Структура.Вставить("Описание"               , ТекЭлемент.Получить("info"));	
		Структура.Вставить("Сумма"                  , ТекЭлемент.Получить("summ"));	
		Структура.Вставить("ТипДокумента"           , ТекЭлемент.Получить("doc_type"));
		Структура.Вставить("НомерДоговора"          , ТекЭлемент.Получить("contract_number"));
		Структура.Вставить("ДатаДоговора"           , ТекЭлемент.Получить("contract_date"));	
		Структура.Вставить("ИдентификаторПоставщика", ТекЭлемент.Получить("sender_id"));
		Структура.Вставить("СтатусЭД"               , "DELIVERED");
		Структура.Вставить("ЭтоКорректировка"       , ТекЭлемент.Получить("doc_type") = "ON_KORSCHFDOPPR" ИЛИ ТекЭлемент.Получить("doc_type") = "ON_NKORSCHFDOPPR");
		
	Иначе
		
		Ошибка.Вставить("ЕстьОшибка" , Истина); 
		Ошибка.Вставить("КодОшибки"  , "");
		Ошибка.Вставить("ТекстОшибки", Результат.Текст);
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Возврат Структура;
	
КонецФункции

// Возвращает стандартное описание списка событий.
// Список допустимых значений для колонки "ТипКвитанции":
//		- "КвитанцияПолученаДокумент" 
//		- "КвитанцияПолученаПДО"
//		- "КвитанцияПолученаПДО_ИОП"
//		- "КвитанцияПолученаПредложениеОбАннулировании"
//		- "КвитанцияПолученаУОУ_Аннулирования"
//		- "АннулированиеДокумента"
Функция ПолучитьТаблицуСобытий() Экспорт
	ТаблицаЗначений = Новый ТаблицаЗначений;
	
	// Дата и время события
	ТаблицаЗначений.Колонки.Добавить("ДатаСобытия", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));	
	// Уникальный идентификатор квитанции (этот идентификатор будет передаваться в процедуру для подписания квитанций)
	ТаблицаЗначений.Колонки.Добавить("ИД_Квитанции", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(36)));
	// Уникальный идентификатор события
	ТаблицаЗначений.Колонки.Добавить("ИД_События", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	// Идентификатор для связи квитанции с документом
	ТаблицаЗначений.Колонки.Добавить("ИД_Документа", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(36)));
	// Строка, принимает значения из списка. Список приведён в описании к этой функции.
	ТаблицаЗначений.Колонки.Добавить("ТипКвитанции", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	// Строка, произвольный тектс с техническими данными для отладки
	ТаблицаЗначений.Колонки.Добавить("ТехническиеДанные", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(0)));
	
	Возврат ТаблицаЗначений;
	
КонецФункции

// + Получение дополнительной информации от провайдера по документу // Тест пройден 
// Параметры:
//	- ИД_Документа - Уникальный идентификатор документа
//	- Ошибка - Стандартный параметр см. ПолучитьСтруктуруОшибки
// Возвращает структуру дополнительной информации. См. "ПолучитьСтруктуруДополнительнойИнформации"
Функция ПолучитьДополнительнуюИнформациюПровайдера(ИД_Документа, Тип, Ошибка, ПрофильОбмена, МассивЛогаСобытий) Экспорт
	
	ИмяСобытия = "Получить дополнительную информацию провайдера";
	СтруктураРезультат = ПолучитьСтруктуруДополнительнойИнформации();
	
	///////////////////////////////
	//Реализация	
	
	ТокенАвторизации = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьТокенАвторизации(ПрофильОбмена, Ошибка, МассивЛогаСобытий)");	
	Если Ошибка.ЕстьОшибка Тогда	
		ТекстЛогаСобытий = "При получении токена(авторизации) возникла ошибка - Код: " + Ошибка.КодОшибки + " - " + Ошибка.ТекстОшибки;
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		Возврат Неопределено;		
	КонецЕсли;
	
	ТекстКоманды =  "/Api/V1/Edo/TimeLine/GetTimeLine";
	
	ДанныеЗапроса = Новый Структура;
	ДанныеЗапроса.Вставить("varToken"  , ТокенАвторизации);
	ДанныеЗапроса.Вставить("mode"      , "UPD");
	ДанныеЗапроса.Вставить("varDocGUID", ИД_Документа);
	
	ЗаголовокHTTP = Новый Соответствие;
	ЗаголовокHTTP.Вставить("Content-type", "application/json");
	ЗаголовокHTTP.Вставить("Accept"      , "application/json");	
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("МетодHTTP"    , "POST");
	ПараметрыЗапроса.Вставить("ЗаголовокHTTP", ЗаголовокHTTP);
	
	Ошибка     = ПолучитьСтруктуруОшибки();
	Результат  = Вычислить("ЭКОМ_ОбщегоНазначения.ВыполнитьЗапрос(ТекстКоманды, ПрофильОбмена, ДанныеЗапроса, ПараметрыЗапроса, Ошибка, МассивЛогаСобытий)");
	
	Если Ошибка.ЕстьОшибка Тогда	
		ТекстЛогаСобытий = "При получении информации с сервера возникла ошибка - Код: " + Ошибка.КодОшибки + " - " + Ошибка.ТекстОшибки;
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		Возврат Неопределено;		
	КонецЕсли;
	
	ДатаОтправки  = Дата(1,1,1);
	ДатаПолучения = Дата(1,1,1);
	ОператорПокупатель = "";
	ОператорПоставщика = "";
	ИмяФайлаОтправки = "";
	Получатель = "";
	ОператорПокупатель = "";
	Отправитель = "";
	Соответствие  = UnJSON(Результат.Текст);	
	Массив = Соответствие.Получить("timeline"); 
	Для каждого Элемент Из Массив  Цикл
		
		Статус = Элемент.Получить("event_status");
		
		// "УПДSENT"                                       - ON_SCHFDOPPR-01 (поставщик)
		// "УПДRECIEVED"                                   - ON_SCHFDOPPR-01 (покупатель)   +
		// "ПодтверждениеДатыПоступленияУПДRECIEVED"       - DP_PDPOL-02  (поставщик)
		// "ПодтверждениеДатыОтправкиУПДRECIEVED"          - DP_PDOTPR-03 (покупатель)      +
		// "ДатаПоступленияУПДПродавецSENT"                - DP_IZVPOL-04 (поставщик)
		// "ДатаОтправкиУПДПокупательSENT"                 - DP_IZVPOL-05 (покупатель)		+ Квитанция ИОП ПДО     //"КвитанцияПолученаПДО"
		// "ИзвещениеПолученияУПДПокупательSENT"           - DP_IZVPOL-06 (покупатель)      + Квитанция ИОП         //"КвитанцияПолученаДокумент"
		// "ИзвещениеПолученияУПДПокупательRECIEVED"       - DP_IZVPOL-06 (поставщик)
		// "ПодтверждениеДатыОтправкиИзвещенияRECIEVED"    - DP_PDOTPR-07 (покупатель)      +
		// "ДатаОтправкиИзвещенияПокупательSENT"           - DP_IZVPOL-08 (покупатель)      + Квитанция ИОП ПДО ИОП //"КвитанцияПолученаПДО_ИОП" 
		// "УведомлениеОбУточненииПокупательSENT"          - DP_UVUTOCH-09 (покупатель)     + 
		// "УведомлениеОбУточненииПокупательRECIEVED"      - DP_UVUTOCH-09 (поставщик)
		// "ИзвещениеПолученияУведомленияПродавецSENT"     - DP_IZVPOL-10 (поставщик)
		// "ИзвещениеПолученияУведомленияПродавецRECIEVED" - DP_IZVPOL-10 (покупатель)	    +
		// "ИнформацияПокупателяSENT"                      - ON_SCHFDOPPOK-11 (покупатель)  +
		// "ИнформацияПокупателяRECIEVED"                  - ON_SCHFDOPPOK-11 (поставщик)
		// "АннулированиеУПДRECIEVED" // "АннулированиеУКДRECIEVED"                         + //"АннулированиеДокумента"
		
		//      - "КвитанцияПолученаПредложениеОбАннулировании" - DP_PRANNUL
		//		- "КвитанцияПолученаУОУ_Аннулирования"          - DP_PRANNUL - UVUTOCH отклоняю
		//		- "АннулированиеДокумента"                      - DP_PRANNUL - IZVPOL  подтверждаю
		//      - "КвитанцияПолученаДокумент" - ON_SCHFDOPPR-01 // IZVPOL-06
		//      - "КвитанцияПолученаПДО"      - DP_PDOTPR-03    // IZVPOL-05
		//      - "КвитанцияПолученаПДО_ИОП"  - DP_PDOTPR-07    // IZVPOL-08
		
		Если Тип = "DP_PDPOL_02"
			И (Статус = "ПодтверждениеДатыПоступленияУПДRECIEVED"
			ИЛИ Статус = "ПодтверждениеДатыПоступленияУКДRECIEVED") Тогда  // DP_PDPOL_02 (поставщик)  
			
			ДатаПолучения = ДатаИзXML_в_1С(Элемент.Получить("event_date"));
			Получатель   = Элемент.Получить("recipient_id");	                 
			Отправитель  = Элемент.Получить("sender_id");
			Ид = Элемент.Получить("document_id");
			
		КонецЕсли;
		
		Если Тип = "DP_PDOTPR_03"
			И (Статус = "ПодтверждениеДатыОтправкиУПДRECIEVED"
			ИЛИ Статус = "ПодтверждениеДатыОтправкиУКДRECIEVED") Тогда  // DP_PDOTPR_03 (покупатель)  
			
			ДатаПолучения = ДатаИзXML_в_1С(Элемент.Получить("event_date"));
			Получатель   = Элемент.Получить("recipient_id");	                 
			Отправитель  = Элемент.Получить("sender_id");
			Ид = Элемент.Получить("document_id");
			
		КонецЕсли;
		
		Если Тип = "DP_IZVPOL_04"
			И (Статус = "ДатаПоступленияУПДПродавецSENT"
			ИЛИ Статус = "ДатаПоступленияУКДПродавецSENT") Тогда  // DP_IZVPOL_04 (поставщик)  
			
			ДатаОтправки = ДатаИзXML_в_1С(Элемент.Получить("event_date"));
			Получатель   = Элемент.Получить("recipient_id");	                 
			Отправитель  = Элемент.Получить("sender_id");
			Ид = Элемент.Получить("document_id");
			
		КонецЕсли;
		
		Если Тип = "DP_IZVPOL_05"
			И (Статус = "ДатаОтправкиУПДПокупательSENT"
			ИЛИ Статус = "ДатаОтправкиУКДПокупательSENT") Тогда  // DP_IZVPOL_05 (покупатель)  
			
			ДатаОтправки = ДатаИзXML_в_1С(Элемент.Получить("event_date"));
			Получатель   = Элемент.Получить("recipient_id");	                 
			Отправитель  = Элемент.Получить("sender_id");
			Ид = Элемент.Получить("document_id");
			
		КонецЕсли;
		
		Если Тип = "DP_IZVPOL_06"
			И (Статус = "ИзвещениеПолученияУПДПокупательSENT"            // DP_IZVPOL-06 (покупатель)
			ИЛИ  Статус = "ИзвещениеПолученияУКДПокупательSENT")  Тогда
			
			ДатаОтправки = ДатаИзXML_в_1С(Элемент.Получить("event_date"));
			Получатель   = Элемент.Получить("recipient_id");	                 
			Отправитель  = Элемент.Получить("sender_id");
			Ид = Элемент.Получить("document_id");
			
		КонецЕсли;
		
		Если Тип = "DP_IZVPOL_06"
			И (Статус = "ИзвещениеПолученияУПДПокупательRECIEVED"            // DP_IZVPOL-06 (поставщик)
			ИЛИ  Статус = "ИзвещениеПолученияУКДПокупательRECIEVED")  Тогда
			
			ДатаПолучения = ДатаИзXML_в_1С(Элемент.Получить("event_date"));
			Получатель   = Элемент.Получить("recipient_id");	                 
			Отправитель  = Элемент.Получить("sender_id");
			Ид = Элемент.Получить("document_id");
			
		КонецЕсли;
		
		Если Тип = "DP_PDOTPR_07"
			И (Статус = "ПодтверждениеДатыОтправкиИзвещенияRECIEVED") Тогда  // DP_PDOTPR-07 (покупатель)  
			
			ДатаПолучения = ДатаИзXML_в_1С(Элемент.Получить("event_date"));
			Получатель    = Элемент.Получить("recipient_id");	                 
			Отправитель   = Элемент.Получить("sender_id");
			Ид = Элемент.Получить("document_id");
			
		КонецЕсли;
		
		Если Тип = "DP_IZVPOL_08"
			И (Статус = "ДатаОтправкиИзвещенияПокупательSENT") Тогда  // DP_IZVPOL_08 (покупатель)  
			
			ДатаОтправки = ДатаИзXML_в_1С(Элемент.Получить("event_date"));
			Получатель   = Элемент.Получить("recipient_id");	                 
			Отправитель  = Элемент.Получить("sender_id");
			Ид = Элемент.Получить("document_id");
			
		КонецЕсли;
		
		
		Если Тип = "DP_UVUTOCH_09"
			И (Статус = "УведомлениеОбУточненииПокупательSENT") Тогда  // DP_UVUTOCH_09 (покупатель)  
			
			ДатаОтправки = ДатаИзXML_в_1С(Элемент.Получить("event_date"));
			Получатель   = Элемент.Получить("recipient_id");	                 
			Отправитель  = Элемент.Получить("sender_id");
			Ид = Элемент.Получить("document_id");
			
		КонецЕсли;
		
		Если Тип = "DP_UVUTOCH_09"
			И (Статус = "УведомлениеОбУточненииПокупательRECIEVED") Тогда  // DP_UVUTOCH_09 (поставщик)  
			
			ДатаПолучения = ДатаИзXML_в_1С(Элемент.Получить("event_date"));
			Получатель   = Элемент.Получить("recipient_id");	                 
			Отправитель  = Элемент.Получить("sender_id");
			Ид = Элемент.Получить("document_id");
			
		КонецЕсли;
		
		Если Тип = "DP_IZVPOL_10"
			И (Статус = "ИзвещениеПолученияУведомленияПродавецSENT") Тогда  // DP_IZVPOL_10 (поставщик)  
			
			ДатаОтправки = ДатаИзXML_в_1С(Элемент.Получить("event_date"));
			Получатель   = Элемент.Получить("recipient_id");	                 
			Отправитель  = Элемент.Получить("sender_id");
			Ид = Элемент.Получить("document_id");
			
		КонецЕсли;
		
		Если Тип = "DP_IZVPOL_10"
			И (Статус = "ИзвещениеПолученияУведомленияПродавецRECIEVED") Тогда  // DP_IZVPOL_10 (покупатель)  
			
			ДатаПолучения = ДатаИзXML_в_1С(Элемент.Получить("event_date"));
			Получатель   = Элемент.Получить("recipient_id");	                 
			Отправитель  = Элемент.Получить("sender_id");
			Ид = Элемент.Получить("document_id");
			
		КонецЕсли;
		
		Если Тип = "Подпись"
			И (Статус = "ИнформацияПокупателяSENT") Тогда  // Подпись (покупатель)  
			
			ДатаОтправки = ДатаИзXML_в_1С(Элемент.Получить("event_date"));
			Получатель   = Элемент.Получить("recipient_id");	                 
			Отправитель  = Элемент.Получить("sender_id");
			Ид = Элемент.Получить("document_id");
			
		КонецЕсли;
		
	КонецЦикла;
	
	СтруктураФайла = Неопределено;
	ЭЦП = Неопределено;
	ДанныеФайла = ПолучитьСодержимоеДокумента(Ид, Тип, Ошибка, ПрофильОбмена, МассивЛогаСобытий);	
	Если НЕ ДанныеФайла = Неопределено И ДанныеФайла.Свойство("ПодписьДокумента") = Истина Тогда
		
		СтрокаBase64 = Base64Строка(ДанныеФайла.ПодписьДокумента);
		СтрокаBase64 = СтрЗаменить(СтрокаBase64, Символы.ПС, "");
		СтрокаBase64 = СтрЗаменить(СтрокаBase64, Символы.ВК, "");
		
		ПодписьBIN = Новый ТекстовыйДокумент;
		ПодписьBIN.УстановитьТекст(СтрокаBase64);
		
		ИмяФайлаBIN = ПолучитьИмяВременногоФайла("bin");
		ПодписьBIN.Записать(ИмяФайлаBIN);
		
		ЭЦП = ПоместитьЗначВХранилище(Новый ДвоичныеДанные(ИмяФайлаBIN));
		
		СтрокаXML = ПолучитьСтрокуИзДвоичныхДанных(ДанныеФайла.ТелоДокумента, КодировкаТекста.ANSI);
		
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(СтрокаXML);
		
		ОбъектXDTO = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
		СтруктураДок = ПолучитьСтруктуруДокумента(ОбъектXDTO, МассивЛогаСобытий);			
		СтруктураДок.Вставить("ТекстовыйXML", СтрокаXML);
		
		СтруктураФайла = ПоместитьЗначВХранилище(СтруктураДок);
		ИмяФайлаОтправки = СтруктураДок.ИдФайл;  
	КонецЕсли;
	
	СтруктураРезультат.Вставить("СтруктураФайла"   , СтруктураФайла);
	СтруктураРезультат.Вставить("ЭЦП"              , ЭЦП);
	СтруктураРезультат.Вставить("ИмяФайлаОтправки" , ИмяФайлаОтправки);
	СтруктураРезультат.Вставить("ДатаОтправки"     , ДатаОтправки);  
	СтруктураРезультат.Вставить("ДатаПолучения"    , ДатаПолучения); 		
	
	//Реализация
	///////////////////////////////
	
	Возврат СтруктураРезультат;
	
КонецФункции

