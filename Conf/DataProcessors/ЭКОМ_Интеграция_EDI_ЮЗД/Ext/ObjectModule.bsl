	    |ПОМЕСТИТЬ втINSDES
	    |ИЗ
	    |	РегистрСведений.ЭКОМ_ЦепочкиДокументовПоставщика КАК ЭКОМ_ЦепочкиДокументовПоставщика
	    |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭКОМ_Документы.ТЧ_Товары КАК ЭКОМ_ДокументыТЧ_Товары
	    |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_ТочкиДоставки КАК ЭКОМ_GLN_Покупатель
	    |			ПО ЭКОМ_ДокументыТЧ_Товары.ТочкаДоставки = ЭКОМ_GLN_Покупатель.Объект
	    |		ПО ЭКОМ_ЦепочкиДокументовПоставщика.INSDES = ЭКОМ_ДокументыТЧ_Товары.Ссылка
	    |ГДЕ
	    |	ЭКОМ_ЦепочкиДокументовПоставщика.Накладная = &ДокументРеализации
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ
	    |	втПалеты.Номер КАК Номер,
	    |	втПалеты.Штрихкод КАК Штрихкод,
	    |	втПалеты.Наименование КАК Наименование,
	    |	втПалеты.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	    |	втПалеты.SSCC КАК SSCC,
	    |	втПалеты._Количество КАК _Количество,
	    |	втПалеты.Количество КАК Количество,
	    |	втПалеты.СтранаПроисхождения КАК СтранаПроисхождения,
	    |	втПалеты._Европаллета КАК _Европаллета,
	    |	втПалеты.Европаллета КАК Европаллета,
	    |	втПалеты._МассаБрутто КАК _МассаБрутто,
	    |	втПалеты.МассаБрутто КАК МассаБрутто,
	    |	втПалеты._МассаНетто КАК _МассаНетто,
	    |	втПалеты.МассаНетто КАК МассаНетто,
	    |	втРеализация.КоличествоВУпаковке КАК КоличествоВУпаковке,
	    |	втПалеты._ДатаПроизводства КАК _ДатаПроизводства,
	    |	втПалеты._СрокГодности КАК _СрокГодности,
	    |	втПалеты.ДатаПроизводства КАК ДатаПроизводства,
	    |	втПалеты.СрокГодности КАК СрокГодности,
	    |	втРеализация._Цена КАК _Цена,
	    |	втРеализация.Цена КАК Цена,
	    |	втORDER.НомерПродукта КАК НомерПродукта,
	    |	втORDER._КоличествоЗаказанное КАК _КоличествоЗаказанное,
	    |	втORDER.КоличествоЗаказанное КАК КоличествоЗаказанное,
	    |	ЕСТЬNULL(втORDER._КоличествоВУпаковке, 0) КАК _КоличествоВУпаковке,
	    |	втПалеты._КоличествоКонтейнеров КАК _КоличествоКонтейнеров,
	    |	втПалеты.КоличествоКонтейнеров КАК КоличествоКонтейнеров,
	    |	втПалеты._КоличествоПалет КАК _КоличествоПалет,
	    |	втINSDES.ПокупательGLN КАК ПокупательGLN,
	    |	втINSDES.ПокупательНаименование КАК ПокупательНаименование,
	    |	втINSDES._ПокупательАдрИндекс КАК _ПокупательАдрИндекс,
	    |	втINSDES._ПокупательАдрКодРегиона КАК _ПокупательАдрКодРегиона,
	    |	втINSDES._ПокупательАдрРайон КАК _ПокупательАдрРайон,
	    |	втINSDES._ПокупательАдрГород КАК _ПокупательАдрГород,
	    |	втINSDES._ПокупательАдрНаселенныйПункт КАК _ПокупательАдрНаселенныйПункт,
	    |	втINSDES._ПокупательАдрУлица КАК _ПокупательАдрУлица,
	    |	втINSDES._ПокупательАдрДом КАК _ПокупательАдрДом,
	    |	втINSDES._ПокупательАдрКорпус КАК _ПокупательАдрКорпус,
	    |	втINSDES._ПокупательАдрКвартира КАК _ПокупательАдрКвартира,
	    |	втINSDES.ПокупательАдр КАК ПокупательАдр
	    |ИЗ
	    |	втПалеты КАК втПалеты
	    |		ЛЕВОЕ СОЕДИНЕНИЕ втРеализация КАК втРеализация
	    |		ПО втПалеты._НомерСтроки = втРеализация._НомерСтроки
	    |		ЛЕВОЕ СОЕДИНЕНИЕ втORDER КАК втORDER
	    |		ПО втПалеты._Номенклатура = втORDER._Номенклатура
	    |		ЛЕВОЕ СОЕДИНЕНИЕ втINSDES КАК втINSDES
	    |		ПО втПалеты._Номенклатура = втINSDES._Номенклатура
	    |
	    |УПОРЯДОЧИТЬ ПО
	    |	SSCC,
	    |	втПалеты.Ключ_Строки";
	
	//Docrobot 1.19.0 MOD-1357
	МетаданныеДокумент = ДокументСсылка.Метаданные();
	
	Если Не МетаданныеДокумент.ТабличныеЧасти.Найти("Товары") = Неопределено Тогда
		ИмяТЧ = "Товары";
	ИначеЕсли Не МетаданныеДокумент.ТабличныеЧасти.Найти("Запасы") = Неопределено Тогда //Для УНФ
		ИмяТЧ = "Запасы";
	Иначе
		ИмяТЧ = "";	
	КонецЕсли;
	//КОНЕЦ Docrobot 1.19.0 MOD-1357
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИмяРеализацииТовары", "Документ." + ДокументСсылка.Метаданные().Имя + "."+ИмяТЧ); //Docrobot 1.19.0 MOD-1357 ["Товары" заменено на "ИмяТЧ"]
	
	Если Метаданные.Справочники.Номенклатура.Реквизиты.Найти("СтранаПроисхождения") = Неопределено Тогда
		Запрос.УстановитьПараметр("СтранаПроисхождения", "RU");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&СтранаПроисхождения", "ЭКОМ_Палеты.Номенклатура.СтранаПроисхождения");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ДокументРеализации", ДокументСсылка);
	РезультатЗапроса = Запрос.Выполнить();
	
	Товары = РезультатЗапроса.Выгрузить();
	КолонкиКУдалению = Новый Массив;
	SSCC = "";
	СчетчикТоваровНаПалете = 0;
	
	Для Каждого Строка Из Товары Цикл
		
		// Заполнение адреса.
		Адреса = Новый Массив;
		Адреса.Добавить("ПокупательАдр");
		Для Каждого Адрес Из Адреса Цикл
			Строка[Адрес] =
				?(ПустаяСтрока(Строка["_" + Адрес + "Индекс"]), 			"", Строка["_" + Адрес + "Индекс"] + 		", ") +
				?(ПустаяСтрока(Строка["_" + Адрес + "КодРегиона"]), 		"", Строка["_" + Адрес + "КодРегиона"] + 	", ") +
				?(ПустаяСтрока(Строка["_" + Адрес + "Район"]), 				"", Строка["_" + Адрес + "Район"] + 		", ") +
				?(ПустаяСтрока(Строка["_" + Адрес + "Город"]), 				"", Строка["_" + Адрес + "Город"] + 		", ") +
				?(ПустаяСтрока(Строка["_" + Адрес + "НаселенныйПункт"]), 	"", Строка["_" + Адрес + "НаселенныйПункт"] + ", ") +
				?(ПустаяСтрока(Строка["_" + Адрес + "Улица"]), 				"", Строка["_" + Адрес + "Улица"] + 		", ") +
				?(ПустаяСтрока(Строка["_" + Адрес + "Дом"]), 				"", Строка["_" + Адрес + "Дом"] + 			", ") +
				?(ПустаяСтрока(Строка["_" + Адрес + "Корпус"]), 			"", Строка["_" + Адрес + "Корпус"] + 		", ") +
				?(ПустаяСтрока(Строка["_" + Адрес + "Квартира"]), 			"", Строка["_" + Адрес + "Квартира"] + 		", ");
			Строка[Адрес] = Сред(Строка[Адрес], 1, СтрДлина(Строка[Адрес]) - 2);
		КонецЦикла;
		
		Для Каждого Колонка Из Товары.Колонки Цикл
			Если Найти(Колонка.Имя, "_") = 1 Тогда
				Если НЕ Товары.Колонки.Найти(Сред(Колонка.Имя, 2)) = Неопределено Тогда
					Если ТипЗнч(Строка[Колонка.Имя]) = Тип("Число") Тогда
						Строка[Сред(Колонка.Имя, 2)] = Формат(Строка[Колонка.Имя], "ЧГ=0");
					ИначеЕсли ТипЗнч(Строка[Колонка.Имя]) = Тип("Дата") Тогда
						Строка[Сред(Колонка.Имя, 2)] = Формат(Строка[Колонка.Имя], "ДФ=dd.MM.yyyy");
					ИначеЕсли ТипЗнч(Строка[Колонка.Имя]) = Тип("Булево") Тогда
						Строка[Сред(Колонка.Имя, 2)] = Формат(Строка[Колонка.Имя], "БЛ=Нет; БИ=Да");
					КонецЕсли;
				КонецЕсли;
				КолонкиКУдалению.Добавить(Колонка);
			КонецЕсли;
		КонецЦикла;
		Строка.КоличествоКонтейнеров = ?(ПустаяСтрока(Строка._КоличествоКонтейнеров), "", Строка._КоличествоКонтейнеров + "/" + Формат(Строка._КоличествоПалет, "ЧГ="));
		Если НЕ SSCC = Строка.SSCC Тогда
			СчетчикТоваровНаПалете = 0;
			SSCC = Строка.SSCC;
		КонецЕсли;
		СчетчикТоваровНаПалете = СчетчикТоваровНаПалете + 1;
		Строка.Номер = Формат(СчетчикТоваровНаПалете, "ЧГ=0");
	КонецЦикла;
	
	Для Каждого Колонка Из КолонкиКУдалению Цикл
		Товары.Колонки.Удалить(Колонка);
	КонецЦикла;
	
	Возврат Новый Структура("Шапка, Товары", ШапкаСтруктура, Товары);
	
КонецФункции // ПолучитьДанныеДляПечати()

