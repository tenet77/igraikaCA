	Если РезультатЗапроса.Пустой() Тогда
		ТекстЛогаСобытий = "Нет данных для удаления!";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		Возврат ОчисткаУспешна;	
	Иначе
		ОчисткаУспешна = Истина;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();

	ТекстЛогаСобытий = "Найдено записей = " + Строка(Выборка.Количество());
	ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Информация, ИмяСобытия);
	МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

	Выборка = РезультатЗапроса.Выбрать();	
	НаборЗаписей = РегистрыСведений.ЭКОМ_ТочкиДоставки.СоздатьНаборЗаписей();
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей.Отбор.Объект.Установить(Выборка.Объект);
		
		ТекстЛогаСобытий = "Удаляю записи  - " + СокрЛП(Выборка.Объект);
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		НаборЗаписей.Прочитать();
		НаборЗаписей.Очистить();
		НаборЗаписей.Записать(Истина);
	КонецЦикла;
	
	Возврат ОчисткаУспешна;
	
КонецФункции

Функция ОчиститьИБ_ОтДанныхЭКОМ(ДанныеОРегистрах, Знач НачДатаОчистки, Знач КонДатаОчистки, МассивЛогаСобытий) Экспорт
	
	ИмяСобытия = "Очистка данных";
	ОчисткаУспешна = Ложь;
	
	Если НЕ ЗначениеЗаполнено(КонДатаОчистки) Тогда
		ТекстЛогаСобытий = "Не указана дата, по конец дня которой, нужно удалить все данные объектов Docrobot";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
		Возврат ОчисткаУспешна;
	КонецЕсли;
	
	КонДатаОчистки = КонецДня(КонДатаОчистки);
	Для каждого Стр Из ДанныеОРегистрах Цикл
		
		ОчисткаРегистраУспешна = Ложь;
		Если Стр.Значение = Истина Тогда
			
			Если  Стр.Ключ = "ОчиститьОбъекты_РегистрСведений_ЭКОМ_ИсторияОбмена" Тогда
				ОчисткаРегистраУспешна = ОчиститьИБ_ОтДанныхЭКОМ_РегистрСведений_ЭКОМ_ИсторияОбмена(НачДатаОчистки, КонДатаОчистки, МассивЛогаСобытий);
				
			ИначеЕсли Стр.Ключ = "ОчиститьОбъекты_РегистрСведений_ЭКОМ_ОбъектыСобытия"  Тогда
				ОчисткаРегистраУспешна = ОчиститьИБ_ОтДанныхЭКОМ_РегистрСведений_ЭКОМ_Объекты_События(НачДатаОчистки, КонДатаОчистки, МассивЛогаСобытий);
				
			ИначеЕсли Стр.Ключ = "ОчиститьОбъекты_РегистрСведений_ЭКОМ_ТранспортнаяИнформация"  Тогда
				ОчисткаРегистраУспешна = ОчиститьИБ_ОтДанныхЭКОМ_РегистрСведений_ЭКОМ_ТранспортнаяИнформация(НачДатаОчистки, КонДатаОчистки, МассивЛогаСобытий);
				
			ИначеЕсли Стр.Ключ = "ОчиститьОбъекты_ЭКОМ_Документы"  Тогда
				ОчисткаРегистраУспешна = ОчиститьИБ_ОтДанныхЭКОМ_ЭКОМ_Документы(НачДатаОчистки, КонДатаОчистки, МассивЛогаСобытий);
				
			ИначеЕсли Стр.Ключ = "ОчиститьОбъекты_РегистрСведений_ЭКОМ_ЦепочкиДокументовПоставщика"  Тогда
				ОчисткаРегистраУспешна = ОчиститьИБ_ОтДанныхЭКОМ_РегистрСведений_ЭКОМ_ЦепочкиДокументовПоставщика(НачДатаОчистки, КонДатаОчистки, МассивЛогаСобытий);
				
			ИначеЕсли Стр.Ключ = "ОчиститьОбъекты_РегистрСведений_ЭКОМ_ЦепочкиДокументовПокупателя"  Тогда
				ОчисткаРегистраУспешна = ОчиститьИБ_ОтДанныхЭКОМ_РегистрСведений_ЭКОМ_ЦепочкиДокументовПокупателя(НачДатаОчистки, КонДатаОчистки, МассивЛогаСобытий);
				
			ИначеЕсли Стр.Ключ = "ОчиститьОбъекты_РегистрСведений_ЭКОМ_ЦепочкиДокументовЭТРН"  Тогда
				ОчисткаРегистраУспешна = ОчиститьИБ_ОтДанныхЭКОМ_РегистрСведений_ЭКОМ_ЦепочкиДокументовЭТРН(НачДатаОчистки, КонДатаОчистки, МассивЛогаСобытий);
				
			ИначеЕсли Стр.Ключ = "ОчиститьОбъекты_РегистрСведений_ЭКОМ_Квитанции"  Тогда
				ОчисткаРегистраУспешна = ОчиститьИБ_ОтДанныхРегистрСведений_ЭКОМ_Квитанции(НачДатаОчистки, КонДатаОчистки, МассивЛогаСобытий);
				
			ИначеЕсли Стр.Ключ = "ОчиститьОбъекты_РегистрСведений_ЭКОМ_ЦепочкиНеструктурированныхДокументов"  Тогда
				ОчисткаРегистраУспешна = ОчиститьИБ_ОтДанныхРегистрСведений_Очистить_ЭКОМ_ЦепочкиНеструктурированныхДокументов(НачДатаОчистки, КонДатаОчистки, МассивЛогаСобытий);
				
			ИначеЕсли Стр.Ключ = "ОчиститьОбъекты_РегистрСведений_ЭКОМ_Маркировка"  Тогда
				ОчисткаРегистраУспешна = ОчиститьИБ_ОтДанныхРегистрСведений_Очистить_ЭКОМ_Маркировка(НачДатаОчистки, КонДатаОчистки, МассивЛогаСобытий);
				
			ИначеЕсли Стр.Ключ = "ОчиститьОбъекты_РегистрСведений_ЭКОМ_GLN"  Тогда
				ОчисткаРегистраУспешна = ОчиститьИБ_ОтДанныхРегистрСведений_Очистить_ЭКОМ_GLN(МассивЛогаСобытий);
				
			ИначеЕсли Стр.Ключ = "ОчиститьОбъекты_РегистрСведений_ЭКОМ_ЗначениеДополнительныхКонстант"  Тогда
				ОчисткаРегистраУспешна = ОчиститьИБ_ОтДанныхРегистрСведений_Очистить_ЭКОМ_ЗначениеДополнительныхКонстант(МассивЛогаСобытий);
				
			ИначеЕсли Стр.Ключ = "ОчиститьОбъекты_РегистрСведений_ЭКОМ_НоменклатураКонтрагентов"  Тогда
				ОчисткаРегистраУспешна = ОчиститьИБ_ОтДанныхРегистрСведений_Очистить_ЭКОМ_НоменклатураКонтрагентов(МассивЛогаСобытий);
				
			ИначеЕсли Стр.Ключ = "ОчиститьОбъекты_РегистрСведений_ЭКОМ_Паллеты"  Тогда
				ОчисткаРегистраУспешна = ОчиститьИБ_ОтДанныхРегистрСведений_Очистить_ЭКОМ_Паллеты(МассивЛогаСобытий);
				
			ИначеЕсли Стр.Ключ = "ОчиститьОбъекты_РегистрСведений_ЭКОМ_ТочкиДоставки"  Тогда
				ОчисткаРегистраУспешна = ОчиститьИБ_ОтДанныхРегистрСведений_Очистить_ЭКОМ_ТочкиДоставки(МассивЛогаСобытий);
				
			ИначеЕсли Стр.Ключ = "ОчиститьОбъекты_РегистрСведений_ЭКОМ_Логирование"  Тогда
				ОчисткаРегистраУспешна = ОчиститьИБ_ОтДанныхРегистрСведений_Логирование(НачДатаОчистки, КонДатаОчистки, МассивЛогаСобытий);
				
			ИначеЕсли Стр.Ключ = "ОчиститьОбъекты_РегистрСведений_ЭКОМ_Новости"  Тогда
				ОчисткаРегистраУспешна = ОчиститьИБ_ОтДанныхРегистрСведений_Новости(НачДатаОчистки, КонДатаОчистки, МассивЛогаСобытий);
						   
			КонецЕсли;		
		КонецЕсли;
		
		Если ОчисткаРегистраУспешна = Истина Тогда
			ОчисткаУспешна = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ОчисткаУспешна;
	
КонецФункции

// Функция создает файл выгрузки по данным выбранных регистров ЭКОМ
//
// Параметры:
//  Регистры  	- Структура - коллекция регистров сведений для выгрузки. Пример заполнения:
//		Новый Структура("ЭКОМ_ЗначениеДополнительныхКонстант, ЭКОМ_GLN, ЭКОМ_ТочкиДоставки, ЭКОМ_НоменклатураКонтрагентов", Истина, Ложь, Ложь, Истина);
//  Отбор  		- Массив 	- коллекция значений для установки отбора в регистре сведений ЭКОМ_ЗначениеДополнительныхКонстант по полю ДополнительнаяКонстанта
//
// Возвращаемое значение:
//   Строка   	- адрес файла выгрузки во временном хранилище
//
Функция ВыгрузитьНастройки(Регистры, Отбор, МассивЛогаСобытий, ВыгружатьТолькоВыбранные = Ложь, НастройкиКВыгрузке = Неопределено, ВернутьСтруктурой = Ложь) Экспорт
	
	ИмяСобытия = "Выгрузить настройки"; 
	ВременныйКаталог = ПутьВременногоКаталогаЭКОМ("Settings_out");
	КаталогВременный = ЭКОМ_СоздатьКаталогПроверитьНаЗапись(ВременныйКаталог, МассивЛогаСобытий);	
	Если КаталогВременный = Неопределено Тогда		
		Возврат Неопределено;		
	КонецЕсли;
	
	ПутьКФайлу = ВременныйКаталог + "FileSettings_" + Формат(ТекущаяДата(), "ДФ=yyyyMMddHHmmss") + ".xml";
	
	Результат 		= Новый Структура;
	Запрос 			= Новый Запрос;
	Запрос.Текст 	= "";
	
	Если Регистры.Свойство("ЭКОМ_ЗначениеДополнительныхКонстант") И Регистры.ЭКОМ_ЗначениеДополнительныхКонстант Тогда
		
		Запрос.Текст = Запрос.Текст + ?(ПустаяСтрока(Запрос.Текст), "", ";" + Символы.ПС) + 
		"ВЫБРАТЬ
		|	""ЭКОМ_ЗначениеДополнительныхКонстант"" КАК Регистр,
		|	ЭКОМ_ЗначениеДополнительныхКонстант.*
		|ИЗ
		|	РегистрСведений.ЭКОМ_ЗначениеДополнительныхКонстант КАК ЭКОМ_ЗначениеДополнительныхКонстант"
		
		+ ?(Отбор.Количество() = 0, "", Символы.ПС + 
		"ГДЕ
		|	ЭКОМ_ЗначениеДополнительныхКонстант.ДополнительнаяКонстанта В (&Отбор)");
		
	КонецЕсли;
	
	Если Регистры.Свойство("ЭКОМ_GLN") И Регистры.ЭКОМ_GLN Тогда
		
		Запрос.Текст = Запрос.Текст + ?(ПустаяСтрока(Запрос.Текст), "", ";" + Символы.ПС) +
		"ВЫБРАТЬ
		|	""ЭКОМ_GLN"" КАК Регистр,
		|	ЭКОМ_GLN.*
		|ИЗ
		|	РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN;
		|
		|ВЫБРАТЬ
		|	""ЭКОМ_ПрофилиОбмена"" КАК Регистр,
		|	ЭКОМ_ПрофилиОбмена.Ссылка,
		|	ЭКОМ_ПрофилиОбмена.Код,
		|	ЭКОМ_ПрофилиОбмена.Наименование,
		|	ЭКОМ_ПрофилиОбмена.СерверFTP,
		|	ЭКОМ_ПрофилиОбмена.ИмяПользователяFTP,
		|	ЭКОМ_ПрофилиОбмена.ПарольПользователяFTP,
		|	ЭКОМ_ПрофилиОбмена.ВходящийПутьFTP,
		|	ЭКОМ_ПрофилиОбмена.ИсходящийПутьFTP,
		|	ЭКОМ_ПрофилиОбмена.ОбменПоSOAP,
		|	ЭКОМ_ПрофилиОбмена.Порт,
		|	ЭКОМ_ПрофилиОбмена.СерверAPI,
		|	ЭКОМ_ПрофилиОбмена.ПарольПользователяAPI,
		|	ЭКОМ_ПрофилиОбмена.ПроверятьФайлыЛокально,
		|	ЭКОМ_ПрофилиОбмена.ОставитьФайлыНаПлатформеПослеЗагрузки,
		|	ЭКОМ_ПрофилиОбмена.ЭТРН_Сервер,
		|	ЭКОМ_ПрофилиОбмена.ЭТРН_ИмяПользователя,
		|	ЭКОМ_ПрофилиОбмена.ЭТРН_ПарольПользователя,
		|	ЭКОМ_ПрофилиОбмена.ЭТРН_ОбменПоSOAP,
		|	ЭКОМ_ПрофилиОбмена.Страна,
		|	ЭКОМ_ПрофилиОбмена.КоличествоФайловВПакете,
		|	ЭКОМ_ПрофилиОбмена.ОтправлятьУПДВMarking,
		|	ЭКОМ_ПрофилиОбмена.ОбменREST,
		|	ЭКОМ_ПрофилиОбмена.СерверREST
		|ИЗ
		|	Справочник.ЭКОМ_ПрофилиОбмена КАК ЭКОМ_ПрофилиОбмена
		|ГДЕ
		|	ЭКОМ_ПрофилиОбмена.Ссылка В
		|			(ВЫБРАТЬ
		|				ЭКОМ_GLN.ПрофильОбмена
		|			ИЗ
		|				РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN);
		|
		|ВЫБРАТЬ
		|	""ЭКОМ_ОператорыЭДО"" КАК Регистр,
		|	ЭКОМ_ОператорыЭДО.Ссылка,
		|	ЭКОМ_ОператорыЭДО.Код,
		|	ЭКОМ_ОператорыЭДО.Наименование,
		|	ЭКОМ_ОператорыЭДО.ИНН,
		|	ЭКОМ_ОператорыЭДО.КПП,
		|	ЭКОМ_ОператорыЭДО.Идентификатор
		|ИЗ
		|	Справочник.ЭКОМ_ОператорыЭДО КАК ЭКОМ_ОператорыЭДО
		|ГДЕ
		|	ЭКОМ_ОператорыЭДО.Ссылка В
		|			(ВЫБРАТЬ
		|				ЭКОМ_GLN.Партнер
		|			ИЗ
		|				РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN);
		|
		|ВЫБРАТЬ
		|	""ЭКОМ_Сертификаты"" КАК Регистр,
		|	ЭКОМ_Сертификаты.Ссылка,
		|	ЭКОМ_Сертификаты.Код,
		|	ЭКОМ_Сертификаты.Наименование,
		|	ЭКОМ_Сертификаты.ДолжностьПодписанта,
		|	ЭКОМ_Сертификаты.ФамилияПодписанта,
		|	ЭКОМ_Сертификаты.ИмяПодписанта,
		|	ЭКОМ_Сертификаты.ОтчествоПодписанта,
		|	ЭКОМ_Сертификаты.ОтпечатокСертификата,
		|	ЭКОМ_Сертификаты.ИмяСертификата,
		|	ЭКОМ_Сертификаты.ПарольСертификата,
		|	ЭКОМ_Сертификаты.ОбластьПолномочий,
		|	ЭКОМ_Сертификаты.ОснованиеПолномочий,
		|	ЭКОМ_Сертификаты.СтатусПодписанта,
		|	ЭКОМ_Сертификаты.АлгоритмПодписи,
		|	ЭКОМ_Сертификаты.Организация,
		|	ЭКОМ_Сертификаты.Пользователь,
		|	ЭКОМ_Сертификаты.СертификатНаСервере,
		|	ЭКОМ_Сертификаты.УстановленВЛичномХранилище
		|ИЗ
		|	Справочник.ЭКОМ_Сертификаты КАК ЭКОМ_Сертификаты
		|ГДЕ
		|	ЭКОМ_Сертификаты.Ссылка В
		|			(ВЫБРАТЬ
		|				ЭКОМ_GLN.Сертификат
		|			ИЗ
		|				РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN)";
		
	КонецЕсли;
	
	Если Регистры.Свойство("ЭКОМ_ТочкиДоставки") И Регистры.ЭКОМ_ТочкиДоставки Тогда
		
		Запрос.Текст = Запрос.Текст + ?(ПустаяСтрока(Запрос.Текст), "", ";" + Символы.ПС) +
		"ВЫБРАТЬ
		|	""ЭКОМ_ТочкиДоставки"" КАК Регистр,
		|	ЭКОМ_ТочкиДоставки.*
		|ИЗ
		|	РегистрСведений.ЭКОМ_ТочкиДоставки КАК ЭКОМ_ТочкиДоставки";
		
	КонецЕсли;
	
	Если Регистры.Свойство("ЭКОМ_НоменклатураКонтрагентов") И Регистры.ЭКОМ_НоменклатураКонтрагентов Тогда
		
		Запрос.Текст = Запрос.Текст + ?(ПустаяСтрока(Запрос.Текст), "", ";" + Символы.ПС) +
		"ВЫБРАТЬ
		|	""ЭКОМ_НоменклатураКонтрагентов"" КАК Регистр,
		|	ЭКОМ_НоменклатураКонтрагентов.*
		|ИЗ
		|	РегистрСведений.ЭКОМ_НоменклатураКонтрагентов КАК ЭКОМ_НоменклатураКонтрагентов";
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Отбор", Отбор);
	
	Если НЕ ПустаяСтрока(Запрос.Текст) Тогда
		
		РезультатЗапроса = Запрос.ВыполнитьПакет();
		
		Для Каждого Элемент Из РезультатЗапроса Цикл
			
			Выгрузка = Элемент.Выгрузить();
			
			Если Выгрузка.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Регистр = Выгрузка.Получить(0).Регистр;
			Выгрузка.Колонки.Удалить("Регистр");
			
			// Распаковка хранилища значений.
			Если Регистр = "ЭКОМ_ЗначениеДополнительныхКонстант" Тогда
				
				Выгрузка.Колонки.Добавить("ЗначениеДополнительногоХранилища_Значение");
				
				Для Каждого Строка Из Выгрузка Цикл
					ЗначениеНастроек = Строка.ЗначениеДополнительногоХранилища.Получить();
					
					Если ВыгружатьТолькоВыбранные И ТипЗнч(ЗначениеНастроек) = Тип("ДеревоЗначений") Тогда 						
						
						Если Не ЗначениеНастроек.Колонки.Найти("ТипТранзакции") = Неопределено Тогда
							КолонкаПоиска = "ТипТранзакции";
						ИначеЕсли Не ЗначениеНастроек.Колонки.Найти("Кнопка") = Неопределено Тогда
							КолонкаПоиска = "Кнопка";
						Иначе
							Строка.ЗначениеДополнительногоХранилища_Значение = ЗначениеНастроек;
							Продолжить;
						КонецЕсли;
						
						СтрокиДереваНастроек = ЗначениеНастроек.Строки;
						МаксИндекс = СтрокиДереваНастроек.Количество()-1;
						Для Счетчик = 0 По МаксИндекс Цикл
							ТекущийИндекс = МаксИндекс - Счетчик;
							СтрокаНастроек = СтрокиДереваНастроек[ТекущийИндекс];
							Если НастройкиКВыгрузке.Найти(СтрокаНастроек[КолонкаПоиска]) = Неопределено Тогда
								СтрокиДереваНастроек.Удалить(ТекущийИндекс);
							КонецЕсли;
						КонецЦикла;
						
					КонецЕсли;
					
					Строка.ЗначениеДополнительногоХранилища_Значение = ЗначениеНастроек;
				КонецЦикла;
				
				Выгрузка.Колонки.Удалить(Выгрузка.Колонки.Найти("ЗначениеДополнительногоХранилища"));
				Выгрузка.Колонки.Найти("ЗначениеДополнительногоХранилища_Значение").Имя = "ЗначениеДополнительногоХранилища";
				
			ИначеЕсли Регистр = "ЭКОМ_ПрофилиОбмена" Или Регистр = "ЭКОМ_ОператорыЭДО" Или Регистр = "ЭКОМ_Сертификаты" Тогда
				
				Выгрузка.Колонки.Добавить("ГУИД");
				Для Каждого Строка Из Выгрузка Цикл
					Строка.ГУИД = Строка.Ссылка.УникальныйИдентификатор();
				КонецЦикла;
				
				Выгрузка.Колонки.Удалить(Выгрузка.Колонки.Найти("Ссылка"));
				
			КонецЕсли;
			
			Результат.Вставить(Регистр, Выгрузка);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ВыгружатьТолькоВыбранные Тогда
		МаксИндекс = Выгрузка.Количество()-1; 
		Для Счетчик = 0 По МаксИндекс Цикл
			ТекущийИндекс = МаксИндекс - Счетчик;
			Строка = Выгрузка[ТекущийИндекс];
			Если Не Выгрузка.Колонки.Найти("ЗначениеДополнительногоХранилища") = Неопределено 
				И ТипЗнч(Строка.ЗначениеДополнительногоХранилища) = Тип("ДеревоЗначений") 
				И Строка.ЗначениеДополнительногоХранилища.Строки.Количество() = 0 Тогда
				Выгрузка.Удалить(ТекущийИндекс);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ВернутьСтруктурой Тогда
		Возврат Результат;
	КонецЕсли;
	
	// Запись
	
	Запись = Новый ЗаписьXML;
	Запись.ОткрытьФайл(ПутьКФайлу);    
	
	НовыйСериализаторXDTO = Новый СериализаторXDTO(ФабрикаXDTO);
	НовыйСериализаторXDTO.ЗаписатьXML(Запись, Результат, НазначениеТипаXML.Явное);
	
	Запись.Закрыть();
	
	АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПутьКФайлу), Новый УникальныйИдентификатор);
	
	// Удалим файлы
	Попытка
		УдалитьФайлы(ПутьКФайлу);	
	Исключение
		ТекстЛогаСобытий = ОписаниеОшибки();
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога); 
	КонецПопытки;
	
	Возврат АдресВоВременномХранилище;
	
КонецФункции // ВыгрузитьНастройки()

// Процедура загружает в регистры сведений данные из файла, созданного функцией ВыгрузитьНастройки()
//
// Параметры:
//  АдресВоВременномХранилище  - Адрес - адрес загружаемого файла во временном хранилище
//  МассивЛогаСобытий  - Массив - коллекция записей лога событий
//
// Возвращаемое значение:
//   Булево   - признак успешности загрузки настроек
//
Функция ЗагрузитьНастройки(АдресВоВременномХранилище, МассивЛогаСобытий) Экспорт
	
	ИмяСобытия = "Загрузить настройки";
	ПутьКФайлу = ПолучитьИмяВременногоФайла(".xml");
	
	Попытка
		
		ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(АдресВоВременномХранилище);
		ДвоичныеДанныеФайла.Записать(ПутьКФайлу);
	
		НовоеЧтениеXML = Новый ЧтениеXML;
		НовоеЧтениеXML.ОткрытьФайл(ПутьКФайлу);
		
		НовыйСериализаторXDTO = Новый СериализаторXDTO(ФабрикаXDTO);
		Результат = НовыйСериализаторXDTO.ПрочитатьXML(НовоеЧтениеXML);
		
	Исключение
		ТекстЛогаСобытий = ОписаниеОшибки();
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
	КонецПопытки;

	Если НЕ ТипЗнч(Результат) = Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого Элемент Из Результат Цикл
		
		// Помещение в хранилище значений.
		Если Элемент.Ключ = "ЭКОМ_ЗначениеДополнительныхКонстант" Тогда
			
			Элемент.Значение.Колонки.Добавить("ЗначениеДополнительногоХранилища_Значение");
			
			Для Каждого Строка Из Элемент.Значение Цикл
				Если ЗначениеЗаполнено(Строка.ЗначениеДополнительногоХранилища) Тогда
					Строка.ЗначениеДополнительногоХранилища_Значение = Новый ХранилищеЗначения(Строка.ЗначениеДополнительногоХранилища, Новый СжатиеДанных(9));
				КонецЕсли;
			КонецЦикла;
			
			Элемент.Значение.Колонки.Удалить(Элемент.Значение.Колонки.Найти("ЗначениеДополнительногоХранилища"));
			Элемент.Значение.Колонки.Найти("ЗначениеДополнительногоХранилища_Значение").Имя = "ЗначениеДополнительногоХранилища";
			
		КонецЕсли;
		
		Если Элемент.Ключ = "ЭКОМ_ПрофилиОбмена" Или Элемент.Ключ = "ЭКОМ_ОператорыЭДО" Или Элемент.Ключ = "ЭКОМ_Сертификаты" Тогда
			
			Для Каждого Строка Из Элемент.Значение Цикл
				ГУИД = Новый УникальныйИдентификатор(Строка.ГУИД);
				ТекущийЭлемент = Справочники[Элемент.Ключ].ПолучитьСсылку(ГУИД); 
				ТекущийОбъект = ТекущийЭлемент.ПолучитьОбъект();
				Если ТекущийОбъект = Неопределено Тогда
					ТекущийОбъект = Справочники[Элемент.Ключ].СоздатьЭлемент();
					ТекущийОбъект.УстановитьСсылкуНового(ТекущийЭлемент);
				КонецЕсли;
								
				Для Каждого Колонка Из Элемент.Значение.Колонки Цикл
					Если Колонка.Имя = "ГУИД" Тогда
						Продолжить;
					КонецЕсли;
					ТекущийОбъект[Колонка.Имя] = Строка[Колонка.Имя];
				КонецЦикла;
				
				Попытка
					ТекущийОбъект.Записать();
				Исключение
					ТекстЛогаСобытий = ОписаниеОшибки();
					ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
					МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
				КонецПопытки;
			КонецЦикла;
			
		Иначе
			
			// Предварительное удаление загружаемых записей.
			Измерения = Метаданные.РегистрыСведений[Элемент.Ключ].Измерения;
			
			Для Каждого Строка Из Элемент.Значение Цикл
				МенеджерЗаписи = РегистрыСведений[Элемент.Ключ].СоздатьМенеджерЗаписи();
				Для Каждого Измерение Из Измерения Цикл
					МенеджерЗаписи[Измерение.Имя] = Строка[Измерение.Имя];
				КонецЦикла;
				МенеджерЗаписи.Прочитать();
				Если МенеджерЗаписи.Выбран() Тогда
					МенеджерЗаписи.Удалить();
				КонецЕсли;
			КонецЦикла;
			
			// Загрузка записей в регистр.
			НаборЗаписей = РегистрыСведений[Элемент.Ключ].СоздатьНаборЗаписей();
			НаборЗаписей.Загрузить(Элемент.Значение);
			НаборЗаписей.Записать(Ложь);
			
		КонецЕсли;
	КонецЦикла;
	
	НовоеЧтениеXML.Закрыть();
	
	// Удалим файлы
	Попытка
		УдалитьФайлы(ПутьКФайлу);		
	Исключение
		ТекстЛогаСобытий = ОписаниеОшибки();
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции // ЗагрузитьНастройки()

// Загружает в регистры сведений данные из файла, созданного функцией ВыгрузитьНастройки()
//
// Параметры:
//  АдресТаблицы  - Адрес во временном хранилище - таблица настроек к загрузке
//  МассивЛогаСобытий  - Массив - коллекция записей лога событий
//	МассивКонстант - Массив - выбранные константы настроек для загрузки
//	МассивНастроек - Массив - выбранные настройки для загрузки
//
Процедура ЗагрузитьНастройкиПоДокументам(АдресТаблицы, МассивКонстант, МассивНастроек, ВызовИзОбычнойФормы = Ложь) Экспорт
	
	ТаблицаНастроек 	 = ПолучитьИзВременногоХранилища(АдресТаблицы);
	МассивПрочихНастроек = Новый Массив;
	
	// удаление настроек не соответствующих отбору
	МаксИндекс = ТаблицаНастроек.Количество()-1;
	Для Счетчик = 0 По МаксИндекс Цикл
		Строка = ТаблицаНастроек[МаксИндекс - Счетчик];
		Если МассивКонстант.Найти(Строка.ДополнительнаяКонстанта) = Неопределено Тогда
			ТаблицаНастроек.Удалить(Строка);
			Продолжить;
		КонецЕсли;
		
		ЗафиксироватьЗагрузкуДопНастройки(МассивПрочихНастроек, Строка.ДополнительнаяКонстанта);		
		
		Если ТипЗнч(Строка.ЗначениеДополнительногоХранилища) = Тип("ДеревоЗначений") Тогда
			Если Не Строка.ЗначениеДополнительногоХранилища.Колонки.Найти("ТипТранзакции") = Неопределено Тогда
				КолонкаПоиска = "ТипТранзакции";
			ИначеЕсли Не Строка.ЗначениеДополнительногоХранилища.Колонки.Найти("Кнопка") = Неопределено Тогда
				КолонкаПоиска = "Кнопка";
			Иначе
				Продолжить;
			КонецЕсли;
			
			СтрокиДерева      = Строка.ЗначениеДополнительногоХранилища.Строки;
			МаксИндексДерево  = СтрокиДерева.Количество()-1;
			Для СчетчикДерево = 0 По МаксИндексДерево Цикл
				СтрокаДерева = СтрокиДерева[МаксИндексДерево - СчетчикДерево];
				Если МассивНастроек.Найти(СтрокаДерева[КолонкаПоиска]) = Неопределено Тогда
					СтрокиДерева.Удалить(СтрокаДерева);	
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		// запись прочитанных данных в хранилище значений
		Если ЗначениеЗаполнено(Строка.ЗначениеДополнительногоХранилища) Тогда
			Строка.ЗначениеДополнительногоХранилища_Значение = Новый ХранилищеЗначения(Строка.ЗначениеДополнительногоХранилища, Новый СжатиеДанных(9));
		КонецЕсли;
		
	КонецЦикла;
	
	
	// Предварительное удаление загружаемых записей.
	Измерения = Метаданные.РегистрыСведений.ЭКОМ_ЗначениеДополнительныхКонстант.Измерения;
	
	ИндексПоследнейСтроки = ТаблицаНастроек.Количество() - 1;
	Для Индекс = 0 По ИндексПоследнейСтроки Цикл
		Строка = ТаблицаНастроек[ИндексПоследнейСтроки - Индекс];
		МенеджерЗаписи = РегистрыСведений.ЭКОМ_ЗначениеДополнительныхКонстант.СоздатьМенеджерЗаписи();
		Для Каждого Измерение Из Измерения Цикл
			МенеджерЗаписи[Измерение.Имя] = Строка[Измерение.Имя];
		КонецЦикла;
		МенеджерЗаписи.Прочитать();
		Если МенеджерЗаписи.Выбран() Тогда
			// дополнить дерево настроек существующей константы, если настройка хранится как дерево
			НастройкиЗначение =  МенеджерЗаписи.ЗначениеДополнительногоХранилища.Получить();
			Если ТипЗнч(НастройкиЗначение) = Тип("ДеревоЗначений") Тогда
                ДеревоЗагружаемыхНастроек    = Строка.ЗначениеДополнительногоХранилища;
                СтрокиТекущихНастроек        = НастройкиЗначение.Строки;             
                КонтролироватьИспользуемость = Не ДеревоЗагружаемыхНастроек.Колонки.Найти("ТипТранзакции") = Неопределено;
                ДобавитьСтрокиДереваЗначенийКСуществующему(ДеревоЗагружаемыхНастроек.Строки, СтрокиТекущихНастроек, КонтролироватьИспользуемость); 
				
				МенеджерЗаписи.ЗначениеДополнительногоХранилища = Новый ХранилищеЗначения(НастройкиЗначение, Новый СжатиеДанных(9));
                МенеджерЗаписи.Записать();
                ТаблицаНастроек.Удалить(Строка);
			Иначе
				// если настройка константы хранится не как дерево, то она будет перезаписана,
				// поэтому существующая запись удаляется
				МенеджерЗаписи.Удалить();
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаНастроек.Колонки.Удалить(ТаблицаНастроек.Колонки.Найти("ЗначениеДополнительногоХранилища"));
	ТаблицаНастроек.Колонки.Найти("ЗначениеДополнительногоХранилища_Значение").Имя = "ЗначениеДополнительногоХранилища"; 	
	
	// загрузка в регистр тех настроек, значения которых представлены не в виде дерева значений
	НаборЗаписей = РегистрыСведений.ЭКОМ_ЗначениеДополнительныхКонстант.СоздатьНаборЗаписей();
	НаборЗаписей.Загрузить(ТаблицаНастроек);
	НаборЗаписей.Записать(Ложь);  
	
	ОбновитьВсеРоли(ВызовИзОбычнойФормы);
	Для Каждого Элемент Из МассивПрочихНастроек Цикл
		Настройка_Параметр_Записать(Элемент, Истина);		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗафиксироватьЗагрузкуДопНастройки(МассивПрочихНастроек, ДополнительнаяКонстанта);
	Если Найти(ДополнительнаяКонстанта, "Поставщик") И МассивПрочихНастроек.Найти("Поставщик") = Неопределено Тогда
		МассивПрочихНастроек.Добавить("ЭКОМ_ОбменПоставщик");
	ИначеЕсли Найти(ДополнительнаяКонстанта, "Сеть") И МассивПрочихНастроек.Найти("Сеть") = Неопределено Тогда
		МассивПрочихНастроек.Добавить("ЭКОМ_ОбменСеть");
	ИначеЕсли Найти(ДополнительнаяКонстанта, "Condra") И МассивПрочихНастроек.Найти("Condra") = Неопределено Тогда
		МассивПрочихНастроек.Добавить("ЭКОМ_ОбменCondra");
	ИначеЕсли Найти(ДополнительнаяКонстанта, "ЭТРН") И МассивПрочихНастроек.Найти("ЭТРН") = Неопределено Тогда
		МассивПрочихНастроек.Добавить("ЭКОМ_ОбменЭТРН");
	ИначеЕсли Найти(ДополнительнаяКонстанта, "ПрайсЛист") И МассивПрочихНастроек.Найти("ПрайсЛист") = Неопределено Тогда
		МассивПрочихНастроек.Добавить("ЭКОМ_ОбменПрайсЛист");
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьСтрокиДереваЗначенийКСуществующему(СтрокиИсточник, СтрокиТекущихНастроек, КонтролироватьИспользуемость = Ложь)
	Для Каждого ЗагружаемаяНастройка Из СтрокиИсточник Цикл
		НоваяСтрокаНастроек = СтрокиТекущихНастроек.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаНастроек, ЗагружаемаяНастройка);
		Если КонтролироватьИспользуемость 
			И НастройкаДанногоТипаУжеИспользуется(СтрокиТекущихНастроек, НоваяСтрокаНастроек.ТипТранзакции) Тогда
			ЭКОМ_ОбщегоНазначения.СообщитьПользователю("Шаблон настроек с типом транзакции " + НоваяСтрокаНастроек.ТипТранзакции + " уже используется, " 
			+ "загружаемый шаблон " + НоваяСтрокаНастроек.Кнопка + " добавлен без флажка ""Использовать""");
			НоваяСтрокаНастроек.Использовать = Ложь;
		КонецЕсли;
		ЕстьПодчиненныеСтроки = ЗагружаемаяНастройка.Строки.Количество() > 0;
		Если ЕстьПодчиненныеСтроки Тогда
			ДобавитьСтрокиДереваЗначенийКСуществующему(ЗагружаемаяНастройка.Строки, НоваяСтрокаНастроек.Строки);            
		КонецЕсли;
	КонецЦикла; 
КонецПроцедуры

Функция НастройкаДанногоТипаУжеИспользуется(ДеревоЗначений, ИмяКолонки, Счетчик = 0)
	Для Каждого Строка Из ДеревоЗначений Цикл
		Если Строка.ТипТранзакции = ИмяКолонки И Строка.Использовать Тогда
			Счетчик = Счетчик + 1;
			Если Счетчик > 1 Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;		
	КонецЦикла; 	
	
	Возврат Счетчик > 1;
КонецФункции

// Получает настройки из файла созданного функцией ВыгрузитьНастройки(), преобразует значения настроек
// в хранилище значений.
//
// Параметры:
//  АдресВоВременномХранилище - Адрес - адрес файла с настройками
//	МассивКонстант - Массив - выбранные константы настроек для загрузки
//	МассивНастроек - Массив - выбранные настройки для загрузки
//      
Функция ПолучитьСоставЗагружаемыхНастроек(АдресВоВременномХранилище) Экспорт
	
	Результат        = Новый Структура;
	Результат.Вставить("Получены", Ложь);
	ВременныйКаталог = ПутьВременногоКаталогаЭКОМ("Settings_in");
	
	ПутьКФайлу = ВременныйКаталог + "FileSettings_" + Формат(ТекущаяДата(), "ДФ=yyyyMMddHHmmss") + ".xml";
	
	ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(АдресВоВременномХранилище);
	ДвоичныеДанныеФайла.Записать(ПутьКФайлу);
	
	НовоеЧтениеXML = Новый ЧтениеXML;
	НовоеЧтениеXML.ОткрытьФайл(ПутьКФайлу);
	
	НовыйСериализаторXDTO = Новый СериализаторXDTO(ФабрикаXDTO);
	
	ЧтениеXML = НовыйСериализаторXDTO.ПрочитатьXML(НовоеЧтениеXML);
	
	Если НЕ ТипЗнч(ЧтениеXML) = Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;
	
	ЗагружаемыеНастройки = Новый Соответствие;
	Для Каждого Элемент Из ЧтениеXML Цикл
		
		Если Не Элемент.Ключ = "ЭКОМ_ЗначениеДополнительныхКонстант" Тогда 
			Продолжить;
		КонецЕсли;
		
		Элемент.Значение.Колонки.Добавить("ЗначениеДополнительногоХранилища_Значение");
		
		ПрочиеНастройки = Новый Массив;		
		Для Каждого Строка Из Элемент.Значение Цикл
			Если ЗначениеЗаполнено(Строка.ЗначениеДополнительногоХранилища) Тогда
			
				Если  ТипЗнч(Строка.ЗначениеДополнительногоХранилища) = Тип("ДеревоЗначений") Тогда					
					// сбор структуры входящих настроек
					ПодчиненныеНастройки = Новый Массив;				
					Если Не Строка.ЗначениеДополнительногоХранилища.Колонки.Найти("ТипТранзакции") = Неопределено Тогда
						КолонкаПоиска = "ТипТранзакции";
					ИначеЕсли Не Строка.ЗначениеДополнительногоХранилища.Колонки.Найти("Кнопка") = Неопределено Тогда
						КолонкаПоиска = "Кнопка";
					Иначе
						Продолжить;
					КонецЕсли;
					
					СтрокиДерева = Строка.ЗначениеДополнительногоХранилища.Строки;
					Для Каждого СтрокаДерева Из СтрокиДерева Цикл
						ПодчиненныеНастройки.Добавить(СтрокаДерева[КолонкаПоиска]);
					КонецЦикла;
					
					ЗагружаемыеНастройки.Вставить(Строка.ДополнительнаяКонстанта, ПодчиненныеНастройки);
					
				Иначе
					ПрочиеНастройки.Добавить(Строка.ДополнительнаяКонстанта);
				КонецЕсли; // проверка значения дополнительного хранилища	
			КонецЕсли; // проверка заполненности дополнительного хранилища
		КонецЦикла;  // обход строк таблицы настроек          		
		
		Если ПрочиеНастройки.Количество() Тогда
			ЗагружаемыеНастройки.Вставить("Прочие настройки", ПрочиеНастройки);
		КонецЕсли;
		
	КонецЦикла; // обход элементов структуры
	
	
	АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(Элемент.Значение, Новый УникальныйИдентификатор);
	Результат.Вставить("ЗагружаемыеНастройки", ЗагружаемыеНастройки);	
	Результат.Вставить("ТаблицаНастроек", АдресВоВременномХранилище);
	
	Результат.Получены = Истина; 	
	Возврат Результат;
	
КонецФункции

// Здесь можно вставлять код из гибких настроек для отладки
// Параметры: 
// Приемник - документ создания
