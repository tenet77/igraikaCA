	|	ПОДСТРОКА(ДокументыШапка.ИнфПок_ИдИнфПрод_ИдФайлИнфПр, 1, 256) КАК ИмяПостФайла,
	|	ПОДСТРОКА(ДокументыШапка.ИдФайл, 1, 256) КАК ИдФайл
	|ПОМЕСТИТЬ ДокументыШапка
	|ИЗ
	|	&ДокументыШапка КАК ДокументыШапка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЭКОМ_Объекты_СобытияЮЗД.Контрагент КАК Контрагент,
	|	ЭКОМ_Объекты_СобытияЮЗД.Организация КАК Организация,
	|	ЕСТЬNULL(ЭКОМ_Объекты_СобытияЮЗД.Документ_Основание, НЕОПРЕДЕЛЕНО) КАК ДокСЧФ,
	|	ДокументыШапка.ИдФайл КАК ИдФайл,
	|	ДокументыШапка.ВидДокумента КАК ВидДокумента,
	|	ЭКОМ_Объекты_СобытияЮЗД.ВидДокумента КАК ВидДокументаОснования,
	|	ЭКОМ_Объекты_СобытияЮЗД.Статус,
	|	ЭКОМ_Объекты_СобытияЮЗД.ЗаказДата,
	|	ЭКОМ_Объекты_СобытияЮЗД.ЗаказНомер,
	|	ДокументыШапка.ИмяПостФайла,
	|	ЭКОМ_Объекты_СобытияЮЗД.НомерДокумента,
	|	ЭКОМ_Объекты_СобытияЮЗД.ДатаДокумента
	|ИЗ
	|	ДокументыШапка КАК ДокументыШапка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_СобытияЮЗД
	|		ПО ДокументыШапка.ИмяПостФайла = ЭКОМ_Объекты_СобытияЮЗД.Идентификатор
	|			И (ЭКОМ_Объекты_СобытияЮЗД.НаправлениеОбмена = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_НаправлениеОбмена.Исходящий))";
	
	Запрос.УстановитьПараметр("ДокументыШапка", ДокументыШапка);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	ИмяСобытия = "Создание записи по квитанции подписи/титула";
	Пока Выборка.Следующий() Цикл
		
		СтруктураДокумента = Неопределено;
		СтрокаТЗСтруктур = ТЗСтруктур.Найти(Выборка.ИдФайл, "ИдентификаторФайла");
		Если СтрокаТЗСтруктур = Неопределено Тогда			
			ТекстЛогаСобытий = "Не найдена структура документа - " + СтруктураДокумента.ВидДокумента + " с ИД = " + СтруктураДокумента.ИдФайл;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Продолжить;
			
		Иначе		
			СтруктураДокумента = СтрокаТЗСтруктур.СтруктураДокумента;		
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Выборка.ДокСЧФ) Тогда	
			
			СтруктураДокумента.Вставить("Обработан"   , Ложь);
			СтруктураДокумента.Вставить("ТекстПричины", ""); // Текст причины не указываем, в итоговом сообщении укажем количество записанных квитанций в регистр ЭКОМ_Квитанции
			
			// Сохраняем в регистре ЭКОМ_Квитанции 
			МЗ = РегистрыСведений.ЭКОМ_Квитанции.СоздатьМенеджерЗаписи();
			МЗ.ВидДокумента  = СтруктураДокумента.ВидДокумента;
			МЗ.Идентификатор = СтруктураДокумента.ИдФайл;
			МЗ.Прочитать();
			
			Если НЕ МЗ.Выбран() Тогда
				МЗ.ВидДокумента  = СтруктураДокумента.ВидДокумента;
				МЗ.Идентификатор = СтруктураДокумента.ИдФайл;
			КонецЕсли;
			
			МЗ.ИдентификаторОснования = Выборка.ИмяПостФайла;		
			МЗ.СтруктураФайла = Новый ХранилищеЗначения(СтруктураДокумента, Новый СжатиеДанных(9));
			МЗ.ЭЦП            = СтрокаТЗСтруктур.ЭЦП;	
			МЗ.ДатаЗаписи     = ТекущаяДата();
			МЗ.Записать();
			
			// Для архивирования добавляем в массив
			НеНайденныеКвитанции.Добавить(СтрокаТЗСтруктур.ИмяФайлаXML);
			НеНайденныеКвитанции.Добавить(СтрокаТЗСтруктур.ИмяФайлаПодписи);
			
		Иначе
			
			СтруктураДокумента.Вставить("Обработан", Истина);
			
			// События по квитанции
			СтруктураРегистраСобытий = Новый Структура;
			СтруктураРегистраСобытий.Вставить("ЗаказДата"        , Выборка.ЗаказДата);
			СтруктураРегистраСобытий.Вставить("ЗаказНомер"       , Выборка.ЗаказНомер);
			СтруктураРегистраСобытий.Вставить("ДатаЗаписи"       , ТекущаяДата());
			СтруктураРегистраСобытий.Вставить("НаправлениеОбмена", Перечисления.ЭКОМ_НаправлениеОбмена.Входящий);
			СтруктураРегистраСобытий.Вставить("ФайлИмя"          , СтрокаТЗСтруктур.ИмяФайлаXML);
			СтруктураРегистраСобытий.Вставить("ЭЦП"              , СтрокаТЗСтруктур.ЭЦП);
			СтруктураРегистраСобытий.Вставить("Контрагент"       , Выборка.Контрагент);
			СтруктураРегистраСобытий.Вставить("Организация"      , Выборка.Организация);
			СтруктураРегистраСобытий.Вставить("Идентификатор"    , СтруктураДокумента.ИдФайл);
			СтруктураРегистраСобытий.Вставить("ИдентификаторИспр", Выборка.ИмяПостФайла);
			СтруктураРегистраСобытий.Вставить("СтруктураФайла"   , Новый ХранилищеЗначения(СтруктураДокумента, Новый СжатиеДанных(9)));			
			СтруктураРегистраСобытий.Вставить("ТекстОшибки"      , "");
			СтруктураРегистраСобытий.Вставить("Статус"           , Перечисления.ЭКОМ_Статусы.Загружен);
			СтруктураРегистраСобытий.Вставить("НомерДокумента"   , Выборка.НомерДокумента);
			СтруктураРегистраСобытий.Вставить("ДатаДокумента"    , Выборка.ДатаДокумента);
			
			ЭКОМ_Объекты_События_Записать(Выборка.ДокСЧФ, СтруктураДокумента.ВидДокумента, СтруктураРегистраСобытий, Истина);
			
			
		КонецЕсли;
		
		СтруктураДокумента.Вставить("Организация", Выборка.Организация);
		СтрокаТЗСтруктур.СтруктураДокумента = СтруктураДокумента;
		
	КонецЦикла;
	
КонецПроцедуры

// Процедура создает запись о входящем документе CONDRA
//
// Параметры:
//  <Параметр1>  - <Тип.Вид> - <описание параметра>
//                 <продолжение описания параметра>
//  <Параметр2>  - <Тип.Вид> - <описание параметра>
//                 <продолжение описания параметра>
//
Процедура СоздатьЗаписьCONDRA(ТЗСтруктур, ДокументыШапка, МассивЛогаСобытий)
	
	КэшированныеЗначения = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДокументыШапка.HEAD_SENDER,
	|	ДокументыШапка.HEAD_RECIPIENT,
	|	ДокументыШапка.DOCTYPE,
	|	ДокументыШапка.HEAD_TRANSGUID,
	|	ДокументыШапка.HEAD_TYPE,
	|	*
	|ПОМЕСТИТЬ ДокументыШапка
	|ИЗ
	|	&ДокументыШапка КАК ДокументыШапка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДокументыШапка.*,
	|	ЭКОМ_GLN_Отправитель.Объект КАК Контрагент,
	|	ЭКОМ_GLN_Получатель.Объект КАК Организация,
	|	ДокументыШапка.HEAD_SENDER КАК xmlКонтрагент,
	|	ДокументыШапка.HEAD_RECIPIENT КАК xmlОрганизация,
	|	ЕСТЬNULL(ЭКОМ_ТипыНеструктДокументов.Ссылка, ЗНАЧЕНИЕ(Справочник.ЭКОМ_ТипыНеструктДокументов.НеУказано)) КАК ТипДокумента,
	|	ЗНАЧЕНИЕ(Перечисление.ЭКОМ_НаправлениеОбмена.Входящий) КАК НаправлениеОбмена,
	|	ЗНАЧЕНИЕ(Перечисление.ЭКОМ_СтатусыCONDRA.Получен) КАК Статус,
	|	ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ТребуемоеДействиеCONDRA.Получен) КАК Действие,
	|	ЕСТЬNULL(ЭКОМ_Документы.Ссылка, НЕОПРЕДЕЛЕНО) КАК ЭкомДокумент,
	|	ЭКОМ_Документы.Номер КАК Номер,
	|	ЭКОМ_Документы.Дата КАК Дата,
	|	ЭКОМ_Документы.СтатусОбработкиДокумента КАК СтатусОбработкиДокумента,
	|	ЭКОМ_ЦепочкиНеструктурированныхДокументов.TRANSGUID КАК TRANSGUID_Цепочки
	|ИЗ
	|	ДокументыШапка КАК ДокументыШапка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Отправитель
	|		ПО ((ВЫРАЗИТЬ(ДокументыШапка.HEAD_SENDER КАК СТРОКА(13))) = ЭКОМ_GLN_Отправитель.GLN)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Получатель
	|		ПО ((ВЫРАЗИТЬ(ДокументыШапка.HEAD_RECIPIENT КАК СТРОКА(13))) = ЭКОМ_GLN_Получатель.GLN)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭКОМ_ТипыНеструктДокументов КАК ЭКОМ_ТипыНеструктДокументов
	|		ПО ((ВЫРАЗИТЬ(ДокументыШапка.DOCTYPE КАК СТРОКА(4))) = ЭКОМ_ТипыНеструктДокументов.Идентификатор)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭКОМ_Документы КАК ЭКОМ_Документы
	|		ПО ((ВЫРАЗИТЬ(ДокументыШапка.HEAD_TRANSGUID КАК СТРОКА(100))) = ЭКОМ_Документы.TRANSGUID)
	|			И ((ВЫРАЗИТЬ(ДокументыШапка.HEAD_TYPE КАК СТРОКА(1))) = ЭКОМ_Документы.Тип)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_ЦепочкиНеструктурированныхДокументов КАК ЭКОМ_ЦепочкиНеструктурированныхДокументов
	|		ПО ((ВЫРАЗИТЬ(ДокументыШапка.HEAD_TRANSGUID КАК СТРОКА(100))) = ЭКОМ_ЦепочкиНеструктурированныхДокументов.TRANSGUID)";
	
	Запрос.УстановитьПараметр("ДокументыШапка", ДокументыШапка);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ИмяСобытия = "Создание записи по квитанции CONDRA";
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ТекстЛогаСобытий 			= "";
		СтруктураДокумента 			= Неопределено;
		СоответствиеПоОрганизации 	= Новый Соответствие;
		СоответствиеПоКонтрагенту 	= Новый Соответствие;
		
		МассивТЗСтруктур = ТЗСтруктур.НайтиСтроки(Новый Структура("TRANSGUID_CONDRA, ТипФайлаCONDRA", ВыборкаДетальныеЗаписи.HEAD_TRANSGUID, ВыборкаДетальныеЗаписи.HEAD_TYPE));
		Если МассивТЗСтруктур.Количество() = 0 Тогда			
			ТекстЛогаСобытий = "Не найдена структура документа - " + СтруктураДокумента.ВидДокумента + " с ИД = " + СтруктураДокумента.ИдФайл;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Продолжить;
			
		Иначе		
			СтруктураДокумента = МассивТЗСтруктур.Получить(0).СтруктураДокумента;
			СтруктураДокумента.Вставить("Обработан", Ложь);
		КонецЕсли;
		
		ПредставлениеДокументаXML = "Неструктурированный документ № " + ВыборкаДетальныеЗаписи.NUMBER + " от " + ВыборкаДетальныеЗаписи.DATE;
		Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.HEAD_TRANSGUID) Тогда
			
			ТекстЛогаСобытий = "Ошибка заполнения для неструктурированного документа с номером <" + ВыборкаДетальныеЗаписи.NUMBER + "> и датой <"
			+ ВыборкаДетальныеЗаписи.DATE + ">." + Символы.ПС + "	- не заполнено обязательное поле TRANSGUID. Документ пропущен.";
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Продолжить;
			
		ИначеЕсли НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.TRANSGUID_Цепочки)
			И (Лев(ВыборкаДетальныеЗаписи.HEAD_TYPE, 1) = "2"
			ИЛИ Лев(ВыборкаДетальныеЗаписи.HEAD_TYPE, 1) = "3"
			ИЛИ Лев(ВыборкаДетальныеЗаписи.HEAD_TYPE, 1) = "4") Тогда
			// Это не инициатор цепочки, а в регистре нет записи о полученном ДокументОригинала.
			// Нужно игнорировать запись и удалить файл с платформы (если в настройках включено удаление файлов).
			СтруктураДокумента.Обработан = Истина;
			ТекстЛогаСобытий = "Ошибка загрузки неструктурированного документа с номером <" + ВыборкаДетальныеЗаписи.NUMBER + ">, датой <"
			+ ВыборкаДетальныеЗаписи.DATE + "> и типом <" + ВыборкаДетальныеЗаписи.HEAD_TYPE + ">." + Символы.ПС
			+ "	- не найден ранее загруженный документ оригинала. Документ пропущен.";
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

			Продолжить;
		КонецЕсли;
		
		// Проверка на ошибки.
		Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.DATE) Тогда
			ТекстОшибки = "	- не заполнено обязательное поле DATE";
			ТекстЛогаСобытий = ТекстЛогаСобытий + ?(ПустаяСтрока(ТекстЛогаСобытий), "", ";"  + Символы.ПС) + ТекстОшибки;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.NUMBER) Тогда
			ТекстОшибки = "	- не заполнено обязательное поле NUMBER";
			ТекстЛогаСобытий = ТекстЛогаСобытий + ?(ПустаяСтрока(ТекстЛогаСобытий), "", ";"  + Символы.ПС) + ТекстОшибки;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Организация) Тогда
			СоответствиеПоОрганизации.Вставить("Организация_" + ВыборкаДетальныеЗаписи.xmlОрганизация, ВыборкаДетальныеЗаписи.xmlОрганизация);	
			ТекстОшибки = "	- не заполнено обязательное поле Организация";
			ТекстЛогаСобытий = ТекстЛогаСобытий + ?(ПустаяСтрока(ТекстЛогаСобытий), "", ";"  + Символы.ПС) + ТекстОшибки;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Контрагент) Тогда
			СоответствиеПоКонтрагенту.Вставить("Контрагент_" + ВыборкаДетальныеЗаписи.xmlКонтрагент, ВыборкаДетальныеЗаписи.xmlКонтрагент);
			ТекстОшибки = "	- не заполнено обязательное поле Контрагент";
			ТекстЛогаСобытий = ТекстЛогаСобытий + ?(ПустаяСтрока(ТекстЛогаСобытий), "", ";"  + Символы.ПС) + ТекстОшибки;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.HEAD_CONTENT_FILENAME) Тогда
			ТекстОшибки = "	- не заполнено обязательное поле FILENAME";
			ТекстЛогаСобытий = ТекстЛогаСобытий + ?(ПустаяСтрока(ТекстЛогаСобытий), "", ";"  + Символы.ПС) + ТекстОшибки;
		КонецЕсли;
		
		// Заполнение документа.
		ДокументОбъект = ВыборкаДетальныеЗаписи.ЭкомДокумент;
		
		Если ДокументОбъект = Неопределено Тогда
			ДокументОбъект = Документы.ЭКОМ_Документы.СоздатьДокумент();
			ДокументОбъект.ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.CONDRA_Входящий;
			ДокументОбъект.ФайлНомер 	= ВыборкаДетальныеЗаписи.NUMBER;
			ДокументОбъект.ФайлДата 	= ВыборкаДетальныеЗаписи.DATE;
			ДокументОбъект.TRANSGUID 	= ВыборкаДетальныеЗаписи.HEAD_TRANSGUID;
			
		ИначеЕсли ВыборкаДетальныеЗаписи.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.Обработан Тогда			
			ДокументОбъект = ДокументОбъект.ПолучитьОбъект();
			ТекстЛогаСобытий = "Повторно обновляется уже загруженный неструктурированный документ номер = " + ВыборкаДетальныеЗаписи.NUMBER + " от " + ВыборкаДетальныеЗаписи.DATE;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		Иначе
			ТекстЛогаСобытий = ТекстЛогаСобытий + ?(ПустаяСтрока(ТекстЛогаСобытий), "", ";"  + Символы.ПС) + "ЭКОМ документ CONDRA уже существует в 1С, номер = " + ВыборкаДетальныеЗаписи.Номер + " от " + ВыборкаДетальныеЗаписи.Дата + ". Для повторного заполнения документа установите измените статус на не обработан.";
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Продолжить;
			
		КонецЕсли;
		
		ДокументОбъект.ДатаПринятияДокумента = ТекущаяДата();
		ДокументОбъект.Дата					= ТекущаяДата();
		ДокументОбъект.ТипДокумента 		= ВыборкаДетальныеЗаписи.DOCTYPE;
		ДокументОбъект.ТипДокументаCONDRA 	= ВыборкаДетальныеЗаписи.ТипДокумента; 
		
		//Docrobot Сергей
		ДокументОбъект.СрокПодписания 	= ВыборкаДетальныеЗаписи.HEAD_DAYSTOSIGN;
		//Docrobot Сергей
        	
		Если РезультатЗапроса.Колонки.Найти("HEAD_DOCGUID") <> Неопределено Тогда //Попытка  //MOD-2544
		ДокументОбъект.DOCGUID 				= ВыборкаДетальныеЗаписи.HEAD_DOCGUID;
		КонецЕсли;//Исключение//КонецПопытки;
		ДокументОбъект.Тип 					= ВыборкаДетальныеЗаписи.HEAD_TYPE;
		Если НЕ ЗначениеЗаполнено(ДокументОбъект.Тип) ИЛИ ДокументОбъект.Тип = "1" Тогда
			ДокументОбъект.ИмяФайла 		= ВыборкаДетальныеЗаписи.КаталогПуть + ВыборкаДетальныеЗаписи.HEAD_CONTENT_FILENAME;
		КонецЕсли;
		ДокументОбъект.Организация 			= ВыборкаДетальныеЗаписи.Организация;
		ДокументОбъект.xmlОрганизация 		= ВыборкаДетальныеЗаписи.HEAD_RECIPIENT;
		ДокументОбъект.Контрагент 			= ВыборкаДетальныеЗаписи.Контрагент;
		ДокументОбъект.xmlКонтрагент 		= ВыборкаДетальныеЗаписи.HEAD_SENDER;
		ДокументОбъект.ТекстОшибки 			    = ТекстЛогаСобытий;	
		ДокументОбъект.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.ПустаяСсылка(); // Обнуляем статус документ
		
		// Обработка значений дополнительных реквизитов (не обязательные).
		Если НЕ ДокументыШапка.Колонки.Найти("HEAD_SUM") = Неопределено Тогда
			Попытка
				ДокументОбъект.СуммаДокументаВсего = Число(ВыборкаДетальныеЗаписи.HEAD_SUM);
			Исключение КонецПопытки;
		КонецЕсли;
		
		Если НЕ ДокументыШапка.Колонки.Найти("CONTRACTNUMBER") = Неопределено Тогда
			ДокументОбъект.НомерДоговораНаПоставку = ВыборкаДетальныеЗаписи.CONTRACTNUMBER;
		КонецЕсли;
				
		ТекстОшибки = "";
		
		ВыполнитьДополнительныеДействия(ДокументОбъект, "Входящий CONDRA (Неструктурированный документ)",
		СтруктураДокумента,
		МассивЛогаСобытий,
		ТекстОшибки,
		,
		,
		,
		,
		КэшированныеЗначения);
			
		Если ДокументОбъект.НеЗагружатьДокумент = Ложь Тогда
			
			СтруктураРегистраСобытий = Новый Структура;
			СтруктураРегистраСобытий.Вставить("ДатаЗаписи"                  , ТекущаяДата());
			Если СтруктураДокумента.Свойство("ЭЦП") Тогда
				СтруктураРегистраСобытий.Вставить("ЭЦП"                     , СтруктураДокумента.ЭЦП);
			КонецЕсли;
			СтруктураРегистраСобытий.Вставить("Контрагент"                  , ВыборкаДетальныеЗаписи.Контрагент);
			СтруктураРегистраСобытий.Вставить("Организация"                 , ВыборкаДетальныеЗаписи.Организация);
			СтруктураРегистраСобытий.Вставить("НаправлениеОбмена"           , Перечисления.ЭКОМ_НаправлениеОбмена.Входящий);
			СтруктураРегистраСобытий.Вставить("ФайлИмя"                     , МассивТЗСтруктур.Получить(0).ИмяФайлаАрхива);
			СтруктураРегистраСобытий.Вставить("Идентификатор"               , СтруктураДокумента.ИдФайл);
			СтруктураРегистраСобытий.Вставить("СтруктураФайла"              , Новый ХранилищеЗначения(СтруктураДокумента, Новый СжатиеДанных(9)));
			
			СтруктураДокумента.Обработан = ПроверитьОбработкуДокумента(ТекстОшибки, ДокументОбъект, СтруктураДокумента, СтруктураРегистраСобытий, ПредставлениеДокументаXML, МассивЛогаСобытий);
			Если СтруктураДокумента.Обработан = Ложь Тогда
				Продолжить;			
			КонецЕсли;
			
		Иначе
			ТекстЛогаСобытий = "В гибких настройках указано не загружать документ - " + ПредставлениеДокументаXML;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		КонецЕсли;
		
		Если НЕ СоответствиеПоОрганизации.Количество() = 0 Тогда
			НастройкиПараметровЗаписатьНабором(СоответствиеПоОрганизации     , "Организация_");
		КонецЕсли;
		Если НЕ СоответствиеПоКонтрагенту.Количество() = 0 Тогда
			НастройкиПараметровЗаписатьНабором(СоответствиеПоКонтрагенту     , "Контрагент_");
		КонецЕсли;
				
	КонецЦикла;
	
КонецПроцедуры // СоздатьЗаписьCONDRA()

// Процедура находит цепочку для текущего документа и записывает данные о полученной квитанции в регистр сведений
//
// Параметры:
//  ТЗСтруктур  - ТаблицаЗначений - данные о структуре входящего документа
//  ДокументыШапка  - ТаблицаЗначений - данные шапки входящего документа
//  МассивЛогаСобытий  - Массив - лог событий по текущей операции
//
Процедура СоздатьЗаписьDP_REZRUZAK(ТЗСтруктур, ДокументыШапка, МассивЛогаСобытий, НеНайденныеКвитанции)
	
	// Запрос по шапке документов
	Запрос = Новый Запрос;	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДокументыШапка.ВидДокумента КАК ВидДокумента,
	|	ПОДСТРОКА(ДокументыШапка.Документ_ИдДокПРУИсп_ИдФайлИнфИсп, 1, 256) КАК ИмяПостФайла,
	|	ПОДСТРОКА(ДокументыШапка.ИдФайл, 1, 256) КАК ИдФайл
	|ПОМЕСТИТЬ ДокументыШапка
	|ИЗ
	|	&ДокументыШапка КАК ДокументыШапка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЭКОМ_Объекты_СобытияАкт.Контрагент КАК Контрагент,
	|	ЭКОМ_Объекты_СобытияАкт.Организация КАК Организация,
	|	ЕСТЬNULL(ЭКОМ_Объекты_СобытияАкт.Документ_Основание, НЕОПРЕДЕЛЕНО) КАК ДокРеализация,
	|	ДокументыШапка.ИдФайл КАК ИдФайл,
	|	ДокументыШапка.ВидДокумента КАК ВидДокумента,
	|	ЭКОМ_Объекты_СобытияАкт.ВидДокумента КАК ВидДокументаОснования,
	|	ЭКОМ_Объекты_СобытияАкт.Статус КАК Статус,
	|	ЭКОМ_Объекты_СобытияАкт.ЗаказДата КАК ЗаказДата,
	|	ЭКОМ_Объекты_СобытияАкт.ЗаказНомер КАК ЗаказНомер,
	|	ДокументыШапка.ИмяПостФайла КАК ИмяПостФайла
	|ИЗ
	|	ДокументыШапка КАК ДокументыШапка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_СобытияАкт
	|		ПО ДокументыШапка.ИмяПостФайла = ЭКОМ_Объекты_СобытияАкт.Идентификатор
	|			И (ЭКОМ_Объекты_СобытияАкт.НаправлениеОбмена = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_НаправлениеОбмена.Исходящий))";
	
	Запрос.УстановитьПараметр("ДокументыШапка", ДокументыШапка);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ИмяСобытия = "Создание записи по квитанции DP_REZRUZAK";	
	Пока Выборка.Следующий() Цикл
		
		СтруктураДокумента = Неопределено;
		СтрокаТЗСтруктур = ТЗСтруктур.Найти(Выборка.ИдФайл, "ИдентификаторФайла");
		Если СтрокаТЗСтруктур = Неопределено Тогда			
			ТекстЛогаСобытий = "Не найдена структура документа - " + СтруктураДокумента.ВидДокумента + " с ИД = " + СтруктураДокумента.ИдФайл;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
			Продолжить;
			
		Иначе		
			СтруктураДокумента = СтрокаТЗСтруктур.СтруктураДокумента;		
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Выборка.ДокРеализация) Тогда	
			
			СтруктураДокумента.Вставить("Обработан"   , Ложь);
			СтруктураДокумента.Вставить("ТекстПричины", ""); // Текст причины не указываем, в итоговом сообщении укажем количество записанных квитанций в регистр ЭКОМ_Квитанции
			
			// Сохраняем в регистре ЭКОМ_Квитанции 
			МЗ = РегистрыСведений.ЭКОМ_Квитанции.СоздатьМенеджерЗаписи();
			МЗ.ВидДокумента  = СтруктураДокумента.ВидДокумента;
			МЗ.Идентификатор = СтруктураДокумента.ИдФайл;
			МЗ.Прочитать();
			
			Если НЕ МЗ.Выбран() Тогда
				МЗ.ВидДокумента  = СтруктураДокумента.ВидДокумента;
				МЗ.Идентификатор = СтруктураДокумента.ИдФайл;
			КонецЕсли;
			
			МЗ.ИдентификаторОснования = Выборка.ИмяПостФайла;		
			МЗ.СтруктураФайла = Новый ХранилищеЗначения(СтруктураДокумента, Новый СжатиеДанных(9));
			МЗ.ЭЦП            = СтрокаТЗСтруктур.ЭЦП;	
			МЗ.ДатаЗаписи     = ТекущаяДата();
			МЗ.Записать();
			
			// Для архивирования добавляем в массив
			НеНайденныеКвитанции.Добавить(СтрокаТЗСтруктур.ИмяФайлаXML);
			НеНайденныеКвитанции.Добавить(СтрокаТЗСтруктур.ИмяФайлаПодписи);
			
		Иначе
			
			СтруктураРегистраСобытий = Новый Структура;
			СтруктураРегистраСобытий.Вставить("ЗаказДата"        , Выборка.ЗаказДата);
			СтруктураРегистраСобытий.Вставить("ЗаказНомер"       , Выборка.ЗаказНомер);
			СтруктураРегистраСобытий.Вставить("ДатаЗаписи"       , ТекущаяДата());
			СтруктураРегистраСобытий.Вставить("НаправлениеОбмена", Перечисления.ЭКОМ_НаправлениеОбмена.Входящий);
			СтруктураРегистраСобытий.Вставить("ФайлИмя"          , СтрокаТЗСтруктур.ИмяФайлаXML);
			СтруктураРегистраСобытий.Вставить("ЭЦП"              , СтрокаТЗСтруктур.ЭЦП);
			СтруктураРегистраСобытий.Вставить("Контрагент"       , Выборка.Контрагент);
			СтруктураРегистраСобытий.Вставить("Организация"      , Выборка.Организация);
			СтруктураРегистраСобытий.Вставить("Идентификатор"    , СтруктураДокумента.ИдФайл);
			СтруктураРегистраСобытий.Вставить("ИдентификаторИспр", Выборка.ИмяПостФайла);
			СтруктураРегистраСобытий.Вставить("СтруктураФайла"   , Новый ХранилищеЗначения(СтруктураДокумента, Новый СжатиеДанных(9)));	
			
			СтруктураДокумента.Вставить("Обработан", Истина);
			СтруктураРегистраСобытий.Вставить("ТекстОшибки", "");
			СтруктураРегистраСобытий.Вставить("Статус", СтруктураДокумента.СтатусАкта);
			ЭКОМ_Объекты_События_Записать(Выборка.ДокРеализация, СтруктураДокумента.ВидДокумента, СтруктураРегистраСобытий, Истина);	
			
			СтруктураРегистраСобытий = Новый Структура;
			СтруктураРегистраСобытий.Вставить("Статус", СтруктураДокумента.СтатусАкта);		
			ЭКОМ_Объекты_События_Записать(Выборка.ДокРеализация, Выборка.ВидДокументаОснования, СтруктураРегистраСобытий);
			
		КонецЕсли;
		
		СтруктураДокумента.Вставить("Организация", Выборка.Организация);
		СтрокаТЗСтруктур.СтруктураДокумента = СтруктураДокумента;
		
	КонецЦикла;
	
КонецПроцедуры // СоздатьЗаписьDP_REZRUZAK()

Процедура СоздатьЗаписьПоКвитанции(СтруктураПараметров, СтруктураРегистраСобытий, СтрокаТЗСтруктур, МассивЛогаСобытий, НеНайденныеКвитанции) Экспорт
	
	ИмяСобытия = "Создание записи в регистр по квитанции";
	СтруктураНайдена   = Истина;
	СтруктураДокумента = Неопределено;
	
	Если СтрокаТЗСтруктур = Неопределено Тогда		
		ТекстЛогаСобытий = "Не найдена структура документа - " + СокрЛП(СтруктураПараметров.ВидДокумента) + " с ИД = " + СтруктураРегистраСобытий.Идентификатор;
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
		СтруктураНайдена = Ложь;
		
	Иначе		
		СтруктураДокумента = СтрокаТЗСтруктур.СтруктураДокумента;		
	КонецЕсли;
	
	Если СтруктураНайдена = Истина Тогда
		
		МЗ = РегистрыСведений.ЭКОМ_Квитанции.СоздатьМенеджерЗаписи();
		МЗ.ВидДокумента  = СтруктураДокумента.ВидДокумента;
		МЗ.Идентификатор = СтруктураДокумента.ИдФайл;
		МЗ.Прочитать();
		
		ДатаОтпр = ТекущаяДата();
		Если СтруктураДокумента.Свойство("Документ_СведПодтв_ДатаОтпр") = Истина Тогда
			ДатаОтпр = СтруктураДокумента.Документ_СведПодтв_ДатаОтпр;	
		КонецЕсли;
		РазницаВДнях = (НачалоДня(ТекущаяДата()) - НачалоДня(ДатаОтпр)) / (60 * 60 * 24);
		
		Если НЕ ЗначениеЗаполнено(СтруктураПараметров.ДокументОснование) Тогда	
			
			// 7 дней квитанция будет на веб-сервере, только потом будет загружена в регистр ЭКОМ квитанции
			Если (Найти(СтруктураДокумента.ИдФайл, "DP_PDOTPR") > 0
				ИЛИ Найти(СтруктураДокумента.ИдФайл, "DP_PDPOL") > 0)
				И РазницаВДнях < 7 Тогда 
				Возврат;			
			КонецЕсли;
		
			СтруктураДокумента.Вставить("Обработан"   , Ложь);
			СтруктураДокумента.Вставить("ТекстПричины", ""); // Текст причины не указываем, в итоговом сообщении укажем количество записанных квитанций в регистр ЭКОМ_Квитанции
			
			// Сохраняем в регистре ЭКОМ_Квитанции 			
			Если НЕ МЗ.Выбран() Тогда
				МЗ.ВидДокумента  = СтруктураДокумента.ВидДокумента;
				МЗ.Идентификатор = СтруктураДокумента.ИдФайл;
			КонецЕсли;
			
			МЗ.ИдентификаторОснования = СтруктураПараметров.ИмяПостФайла;		
			МЗ.СтруктураФайла = Новый ХранилищеЗначения(СтруктураДокумента, Новый СжатиеДанных(9));
			МЗ.ЭЦП            = СтрокаТЗСтруктур.ЭЦП;
			МЗ.ДатаЗаписи     = ТекущаяДата();
			МЗ.Записать();
			
			// Для архивирования добавляем в массив
			НеНайденныеКвитанции.Добавить(СтрокаТЗСтруктур.ИмяФайлаXML);
			НеНайденныеКвитанции.Добавить(СтрокаТЗСтруктур.ИмяФайлаПодписи);
			
		Иначе
			
			СтруктураРегистраСобытий.Вставить("ДатаЗаписи"       , ТекущаяДата());
			СтруктураРегистраСобытий.Вставить("НаправлениеОбмена", Перечисления.ЭКОМ_НаправлениеОбмена.Входящий);
			СтруктураРегистраСобытий.Вставить("СтруктураФайла"   , Новый ХранилищеЗначения(СтруктураДокумента,  Новый СжатиеДанных(9)));
			
			// Если успешно обработан удаляем файл с FTP
			СтруктураДокумента.Вставить("Обработан", Истина);
			ЭКОМ_Объекты_События_Записать(СтруктураПараметров.ДокументОснование, СтруктураПараметров.ВидДокумента, СтруктураРегистраСобытий);
			
			// Удаляем
			Если МЗ.Выбран() Тогда
				МЗ.Удалить(); 
			КонецЕсли;
			
		КонецЕсли;
		
		СтруктураДокумента.Вставить("Организация", СтруктураРегистраСобытий.Организация);
		СтрокаТЗСтруктур.СтруктураДокумента = СтруктураДокумента;
		
	КонецЕсли;
	
КонецПроцедуры

// Обрабатывает входящие STATUS файлы и при нахождении родительских документов создает к ним записи
//
// Параметры:
//  <Параметр1>  - <Тип.Вид> - <описание параметра>
//                 <продолжение описания параметра>
//  <Параметр2>  - <Тип.Вид> - <описание параметра>
//                 <продолжение описания параметра>
//
Процедура СоздатьЗаписьSTATUS(ТЗСтруктур, ДокументыШапка, МассивЛогаСобытий) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДокументыШапка.MessageClass,
		|	ДокументыШапка.Status,
		|	ДокументыШапка.StatusOnFileName,
		|	ДокументыШапка.Description,
		|	ДокументыШапка.ИдФайл
		|ПОМЕСТИТЬ ДокументыШапка
		|ИЗ
		|	&ДокументыШапка КАК ДокументыШапка
		|ГДЕ
		|	ВЫРАЗИТЬ(ДокументыШапка.StatusOnFileName КАК СТРОКА(1)) <> """"
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДокументыШапка.*,
		|	ЭКОМ_Объекты_События.Документ_Основание КАК Документ,
		|	ЭКОМ_Объекты_События.ВидДокумента
		|ИЗ
		|	ДокументыШапка КАК ДокументыШапка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_События
		|		ПО ((ВЫРАЗИТЬ(ДокументыШапка.StatusOnFileName КАК СТРОКА(300))) = (ВЫРАЗИТЬ(ЭКОМ_Объекты_События.ФайлИмя КАК СТРОКА(300))))";
	
	Запрос.УстановитьПараметр("ДокументыШапка", ДокументыШапка);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаИзЗапроса = РезультатЗапроса.Выгрузить();
	
	// + todo удалить часть кода после того, как сделают задачу https://youtrack.e-vo.ru/issue/CORE-2487.
	
	СтрокиДляУдаления = Новый Массив;
	
	Для Каждого Строка Из ТЗСтруктур Цикл
		Строка.СтруктураДокумента.Вставить("Обработан", Ложь);
	КонецЦикла;
	
	ДокументыШапка.Колонки.Добавить("ВидДокумента", Новый ОписаниеТипов("ПеречислениеСсылка.ЭКОМ_ВидыДокументов"));
	ДокументыШапка.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	
	Для Каждого Строка Из ДокументыШапка Цикл
		
		// Получение даты исходного документа.
		Строка.Дата = ДатаИзXML_в_1С(Строка.Date);
		
		// Получение вида документа.
		ВидДокументаСтрокой = ВРег(Строка.MessageClass);
		Найден = Ложь;
		Попытка
			Строка.ВидДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов." + ВидДокументаСтрокой + "_Исходящий");
			Найден = Истина;
		Исключение КонецПопытки;
		
		Если НЕ Найден Тогда
			Попытка
				Строка.ВидДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов." + ВидДокументаСтрокой);
			Исключение
				ТекстЛогаСобытий = "Не найден вид документа с именем " + ВидДокументаСтрокой + "_Исходящий или " + ВидДокументаСтрокой;
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, "Создание записи по квитанции STATUS");
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
				СтрокиДляУдаления.Добавить(Строка);
			КонецПопытки;
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Срока Из СтрокиДляУдаления Цикл
		ДокументыШапка.Удалить(Срока);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДокументыШапка.MessageClass,
		|	ДокументыШапка.Status,
		|	ДокументыШапка.StatusOnFileName,
		|	ДокументыШапка.Description,
		|	ДокументыШапка.CustomerICID,
		|	ДокументыШапка.Date,
		|	ДокументыШапка.Дата,
		|	ДокументыШапка.From,
		|	ДокументыШапка.To,
		|	ДокументыШапка.ИдФайл,
		|	ДокументыШапка.ВидДокумента
		|ПОМЕСТИТЬ ДокументыШапка
		|ИЗ
		|	&ДокументыШапка КАК ДокументыШапка
		|ГДЕ
		|	ВЫРАЗИТЬ(ДокументыШапка.StatusOnFileName КАК СТРОКА(1)) = """"
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДокументыШапка.*,
		|	ЭКОМ_GLN_Организация.Объект КАК Организация,
		|	ЭКОМ_GLN_Контрагент.Объект КАК Контрагент
		|ПОМЕСТИТЬ втСКонтрагентами
		|ИЗ
		|	ДокументыШапка КАК ДокументыШапка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Контрагент
		|		ПО ВЫРАЗИТЬ(ДокументыШапка.To КАК СТРОКА(13)) = ЭКОМ_GLN_Контрагент.GLN
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Организация
		|		ПО ВЫРАЗИТЬ(ДокументыШапка.From КАК СТРОКА(13)) = ЭКОМ_GLN_Организация.GLN
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ДокументыШапка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втСКонтрагентами.MessageClass,
		|	втСКонтрагентами.Status,
		|	втСКонтрагентами.StatusOnFileName,
		|	втСКонтрагентами.Description,
		|	втСКонтрагентами.ИдФайл,
		|	ЭКОМ_Объекты_События.Документ_Основание КАК Документ,
		|	ЭКОМ_Объекты_События.ВидДокумента
		|ИЗ
		|	втСКонтрагентами КАК втСКонтрагентами
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_События
		|		ПО втСКонтрагентами.Организация = ЭКОМ_Объекты_События.Организация
		|			И втСКонтрагентами.Контрагент = ЭКОМ_Объекты_События.Контрагент
		|			И НАЧАЛОПЕРИОДА(втСКонтрагентами.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(ЭКОМ_Объекты_События.ДатаДокумента, ДЕНЬ)
		|			И ВЫРАЗИТЬ(втСКонтрагентами.CustomerICID КАК СТРОКА(15)) = ЭКОМ_Объекты_События.НомерДокумента
		|			И втСКонтрагентами.ВидДокумента = ЭКОМ_Объекты_События.ВидДокумента";
	
	Запрос.УстановитьПараметр("ДокументыШапка", ДокументыШапка);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаРезультатаЗапроса = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаРезультатаЗапроса.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ВыборкаИзЗапроса.Добавить(), ВыборкаРезультатаЗапроса);
	КонецЦикла;
	
	// - todo удалить часть кода после того, как сделают задачу https://youtrack.e-vo.ru/issue/CORE-2487.
	
	ИмяСобытия = "Создание записи по квитанции STATUS";
	Для Каждого Выборка Из ВыборкаИзЗапроса Цикл
		
		// Получаем структуру документа
		СтруктураДокумента = Неопределено;
		СтрокаТЗСтруктур = ТЗСтруктур.Найти(Выборка.ИдФайл, "ИдентификаторФайла");
		
		Если СтрокаТЗСтруктур = Неопределено Тогда		
			ТекстЛогаСобытий = "Не найдена структура документа с ИД = " + Выборка.ИдФайл;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Продолжить;
			
		Иначе
			
			СтруктураДокумента = СтрокаТЗСтруктур.СтруктураДокумента;
			// + todo раскомментировать после того, как сделают задачу https://youtrack.e-vo.ru/issue/CORE-2487.
			//СтруктураДокумента.Вставить("Обработан", Ложь);
			// - todo раскомментировать после того, как сделают задачу https://youtrack.e-vo.ru/issue/CORE-2487.
		КонецЕсли;
		
		// Пропускаем с удалением на платформе обработку тех типов, которые не поддерживаются модулем.
		Если Найти(ВРег(Выборка.MessageClass), "ON_") = 1 Тогда
			СтруктураДокумента.Обработан = Истина;
			ТекстЛогаСобытий = "Документ с ИД = " + Выборка.ИдФайл + " удален без обработки. Отсутствует возможность обрабатывать файлы с MessageClass = " + ВРег(Выборка.MessageClass);
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Выборка.Документ) Тогда
			Продолжить;
		КонецЕсли;
		
		СтатусДокумНента = ПредопределенноеЗначение("Перечисление.ЭКОМ_СтатусыЭлектронныхДокументов.ПустаяСсылка");
		
		Если Выборка.Status = "0" Тогда
			СтатусДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_СтатусыЭлектронныхДокументов.ДоставленоНаПлатформу");
		ИначеЕсли Выборка.Status = "1" Тогда
			СтатусДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_СтатусыЭлектронныхДокументов.ПрочитаноПолучателем");
		ИначеЕсли Выборка.Status = "2" Тогда
			СтатусДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_СтатусыЭлектронныхДокументов.ОшибкаОбработки");
		ИначеЕсли Выборка.Status = "3" Тогда
			СтатусДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_СтатусыЭлектронныхДокументов.ПолученоПолучателем");
		ИначеЕсли Выборка.Status = "4" Тогда
			СтатусДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_СтатусыЭлектронныхДокументов.ОшибкаОбработкиНаСторонеСети");
		КонецЕсли;
		
		// Меняем статус записи исходящего документа.
		ЭКОМ_Объекты_События_Записать(Выборка.Документ,  Выборка.ВидДокумента, Новый Структура("СтатусЭлектронногоДокумента, ТекстОшибки", СтатусДокумента, Выборка.Description));
		
		Если ВРег(Выборка.MessageClass) = "ORDER" Тогда
			ИмяЦепочки = "ЭКОМ_ЦепочкиДокументовПокупателя";
		ИначеЕсли ВРег(Выборка.MessageClass) = "RECADV" Тогда
			ИмяЦепочки = "ЭКОМ_ЦепочкиДокументовПокупателя";
		ИначеЕсли ВРег(Выборка.MessageClass) = "RETANN" Тогда
			ИмяЦепочки = "ЭКОМ_ЦепочкиДокументовПокупателя";
		//ИначеЕсли ВРег(Выборка.MessageClass) = "INSDES" Тогда
		//	ИмяЦепочки = "ЭКОМ_ЦепочкиДокументовПокупателя";
		ИначеЕсли ВРег(Выборка.MessageClass) = "ORDRSP" Тогда
			ИмяЦепочки = "ЭКОМ_ЦепочкиДокументовПоставщика";
		ИначеЕсли ВРег(Выборка.MessageClass) = "DESADV" Тогда
			ИмяЦепочки = "ЭКОМ_ЦепочкиДокументовПоставщика";
		ИначеЕсли ВРег(Выборка.MessageClass) = "INVOICE" Тогда
			ИмяЦепочки = "ЭКОМ_ЦепочкиДокументовПоставщика";
		ИначеЕсли ВРег(Выборка.MessageClass) = "RETINS" Тогда
			ИмяЦепочки = "ЭКОМ_ЦепочкиДокументовПоставщика";
		Иначе
			Продолжить; // Непонятно, к какому регистру отнести данный вид документа.
		КонецЕсли;
			
		НаборЗаписей = РегистрыСведений[ИмяЦепочки].СоздатьНаборЗаписей();
		
		МетаданныеРегистр = Метаданные.РегистрыСведений.Найти(ИмяЦепочки);
		Если МетаданныеРегистр = Неопределено Тогда
			ТекстЛогаСобытий = "Не найден регистр сведений с именем = " + ИмяЦепочки;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Продолжить;
		КонецЕсли;
		
		ИмяПоляДляОтбора = "";
		Для Каждого Измерение Из МетаданныеРегистр.Измерения Цикл
			Если Измерение.Тип.СодержитТип(ТипЗнч(Выборка.Документ)) Тогда 
				ИмяПоляДляОтбора = Измерение.Имя;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ПустаяСтрока(ИмяПоляДляОтбора) Тогда
			
			ТекстЛогаСобытий = "Не найдено измерение для отбора в регистре сведений с именем = " + ИмяЦепочки;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Продолжить;
			
		КонецЕсли;
		
		ЭлементОтбора = НаборЗаписей.Отбор.Найти(ИмяПоляДляОтбора);
		Если ЭлементОтбора = Неопределено Тогда
			Продолжить; // Такого вида документа нет в регистре
		КонецЕсли;
		ЭлементОтбора.Установить(Выборка.Документ); // поле проиндексировано
		
		// Выполним блокировку данных
		НачатьТранзакцию();
		Выполнить("ЭКОМ_ПодпискаСобытий.ВыполнитьБлокировкуНабораЗаписей(НаборЗаписей.Отбор, ИмяЦепочки);");				 
		НаборЗаписей.Прочитать();
		Если НЕ НаборЗаписей.Количество() = 0 Тогда
			
			Для Каждого НоваяЗапись Из НаборЗаписей Цикл
				ДанныеРесурсов = Новый Структура;
				Если ЗначениеЗаполнено(Выборка.Description) Тогда
					ДанныеРесурсов.Вставить("ТекстОшибки", Выборка.Description);
				КонецЕсли;
				ДанныеРесурсов.Вставить("Статус_" + Выборка.MessageClass, СтатусДокумента);
				Выполнить("ЭКОМ_ПодпискаСобытий.СформироватьЗаписьВРегистр(НоваяЗапись, Новый Структура, ДанныеРесурсов);");
			КонецЦикла;
			
			Если НаборЗаписей.Модифицированность() Тогда
				НаборЗаписей.Записать();
			КонецЕсли;
			
		КонецЕсли;
		ЗафиксироватьТранзакцию();
		СтруктураДокумента.Обработан = Истина;
			
	КонецЦикла;

КонецПроцедуры // СоздатьЗаписьSTATUS()

Функция ТекстЗапроса_ОтправкаDP_PTORG1_DP_PTORG2() Экспорт
	Результат = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЭКОМ_Объекты_СобытияDPOTORG.Документ_Основание КАК Документ_Основание,
	|	ЭКОМ_Объекты_СобытияDPOTORG.Документ_Основание.Номер КАК Номер,
	|	ЭКОМ_Объекты_СобытияDPOTORG.Документ_Основание.Дата КАК Дата,
	|	ДАТАВРЕМЯ(1, 1, 1) КАК ЗаказДата,
	|	"""" КАК ЗаказНомер,
	|	ЭКОМ_Объекты_СобытияDPOTORG.Документ_Основание.ФайлДата КАК ДатаИзXML,
	|	ЭКОМ_Объекты_СобытияDPOTORG.Документ_Основание.НакладнаяНомер КАК НомерТН,
	|	ЭКОМ_Объекты_СобытияDPOTORG.Документ_Основание.НакладнаяДата КАК ДатаТН,
	|	ЭКОМ_Объекты_СобытияDPOTORG.Идентификатор КАК Идентификатор,
	|	ЭКОМ_Объекты_СобытияDPOTORG.ДатаЗаписи КАК ДатаЗаписи,
	|	ЭКОМ_Объекты_СобытияDPOTORG.ЭЦП КАК ЭЦП,
	|	ЭКОМ_Объекты_СобытияDPOTORG.Контрагент КАК Контрагент,
	|	ЭКОМ_Объекты_СобытияDPOTORG.Организация КАК Организация,
	|	ЭКОМ_GLN_Контрагент.Ид_ОЭД КАК ИдентификаторКонтрагента,
	|	ЭКОМ_GLN_Контрагент.Партнер КАК ОператорКонтрагента,
	|	ЭКОМ_GLN_Контрагент.Партнер.ИНН КАК ОператорКонтрагентаИНН,
	|	ЭКОМ_GLN_Контрагент.Партнер.Наименование КАК ОператорКонтрагентаНаименование,
	|	ЭКОМ_GLN_Контрагент.Партнер.Идентификатор КАК ОператорКонтрагентаИдентификатор,
	|	ЭКОМ_GLN_Организация.Партнер КАК ОператорОрганизации,
	|	ЭКОМ_GLN_Организация.Партнер.Идентификатор КАК ОператорОрганизацииИдентификатор,
	|	ЭКОМ_GLN_Организация.Сертификат КАК СертификатОрганизации,
	|	ЭКОМ_GLN_Организация.Ид_ОЭД КАК ИдентификаторОрганизации,
	|	&ТипДокумента КАК Извещение,
	|	ВЫБОР
	|		КОГДА &ТипДокумента = ""DP_PTORG1""
	|			ТОГДА ""DP_OTORG1""
	|		КОГДА &ТипДокумента = ""DP_PTORG2""
	|			ТОГДА ""DP_OTORG2""
	|	КОНЕЦ КАК ТипИзв,
	|	ЭКОМ_Объекты_СобытияDPOTORG.НомерДокумента,
	|	ЭКОМ_Объекты_СобытияDPOTORG.ДатаДокумента
	|ИЗ
	|	РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_СобытияDPOTORG
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_СобытияDP_PTORG
	|		ПО ЭКОМ_Объекты_СобытияDPOTORG.Документ_Основание = ЭКОМ_Объекты_СобытияDP_PTORG.Документ_Основание
	|			И (ЭКОМ_Объекты_СобытияDP_PTORG.ВидДокумента = ВЫБОР
	|				КОГДА &ТипДокумента = ""DP_PTORG1""
	|					ТОГДА ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.DP_PTORG1)
	|				КОГДА &ТипДокумента = ""DP_PTORG2""
	|					ТОГДА ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.DP_PTORG2)
	|			КОНЕЦ)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Организация
	|		ПО ЭКОМ_Объекты_СобытияDPOTORG.Организация = ЭКОМ_GLN_Организация.Объект
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN_Контрагент
	|		ПО ЭКОМ_Объекты_СобытияDPOTORG.Контрагент = ЭКОМ_GLN_Контрагент.Объект
	|ГДЕ
	|	ЭКОМ_Объекты_СобытияDPOTORG.ВидДокумента = ВЫБОР
	|			КОГДА &ТипДокумента = ""DP_PTORG1""
	|				ТОГДА ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.DPOTORG1_Входящий)
	|			КОГДА &ТипДокумента = ""DP_PTORG2""
	|				ТОГДА ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.DPOTORG2_Входящий)
	|		КОНЕЦ
	|	И ЭКОМ_Объекты_СобытияDP_PTORG.Документ_Основание ЕСТЬ NULL
	|	И ЭКОМ_Объекты_СобытияDPOTORG.НаправлениеОбмена = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_НаправлениеОбмена.Входящий)";		
	Возврат Результат;
КонецФункции 

// Функция формирует данные для отправки титула продавца DP_PTORG1 и DP_PTORG2 в ответ на входящие DP_OTORG1 и DP_OTORG2 соответственно
//	
//
// Параметры:
//  ОбработатьФайлНаКлиенте  - Булево - признак вызова функции на клиенте
//  ТипДокумента  	- Строка - тип обрабатываемого докуента. Может принимать значения DP_PTORG1 или DP_PTORG2
//  МассивЛогаСобытий  	- Массив - лог событий обмена
//
// Возвращаемое значение:
//   Структура   - данные созданного документа
//
Функция DP_PTORG1_DP_PTORG2_ТитулПродавцаСформировать(ТипДокумента, МассивЛогаСобытий) Экспорт
	
	ИмяСобытия = "Сформировать титул DP_PTORG1_DP_PTORG2";
	МассивСтруктур = Новый Массив;
	
	Если НЕ (ТипДокумента = "DP_PTORG1" ИЛИ ТипДокумента = "DP_PTORG2") Тогда
		// Ошибка использования функции.
		ТекстОшибки = "Функция ""DP_PTORG1_DP_PTORG2_ТитулПродавцаСформировать()"". Ошибка значения параметра ""ТипДокумента"". Квитанции отправлены не будут.";
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Запрос = Новый Запрос;		
	Запрос.Текст = ТекстЗапроса_ОтправкаDP_PTORG1_DP_PTORG2();
	
	Запрос.УстановитьПараметр("ТипДокумента", ТипДокумента);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ТекстЛогаСобытий = "Нет документов для отправки квитанций [" + ТипДокумента + "]!";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Информация, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		Возврат МассивСтруктур; 
	Иначе
		Выборка = РезультатЗапроса.Выбрать();		
	КонецЕсли;
	
	ВременныйКаталог = ПутьВременногоКаталогаЭКОМ("DP_PTORG1_DP_PTORG2_out");
	КаталогВременный = ЭКОМ_СоздатьКаталогПроверитьНаЗапись(ВременныйКаталог, МассивЛогаСобытий);	
	Если КаталогВременный = Неопределено Тогда		
		Возврат МассивСтруктур;		
	КонецЕсли;
	
	Пока Выборка.Следующий() Цикл
		
		ПредставлениеДок = "Документ № " + СокрЛП(Выборка.Номер) + " от " + Выборка.Дата;
		
		// Получаю из хранилища двоичные данные подписи
		ЭЦП = Неопределено;
		Если ЗначениеЗаполнено(Выборка.ЭЦП) Тогда	
			ЭЦП = Выборка.ЭЦП.Получить();
			
			Если НЕ ЗначениеЗаполнено(ЭЦП) Тогда
				ТекстЛогаСобытий = "Для " + Выборка.Извещение + " ЭЦП не определен! " + Выборка.Извещение + " на " + Выборка.ТипИзв + " отправлен не будет! (1852) - " + ПредставлениеДок;
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

				Продолжить;			
			КонецЕсли;	
			
		Иначе
			ТекстЛогаСобытий = "Для " + Выборка.Извещение + " Нет данных по ЭЦП для документа  - " + Строка(Выборка.Идентификатор);
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Выборка.ОператорОрганизации) Тогда		
			ТекстЛогаСобытий = "Для " + Выборка.Извещение + " Не заполнен ОЭД организации! - " + Строка(Выборка.Организация);
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
			Продолжить;			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Выборка.ОператорКонтрагента) Тогда
			ТекстЛогаСобытий = "Для " + Выборка.Извещение + " Не заполнен ОЭД контрагента! - " + Строка(Выборка.Контрагент);
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

			Продолжить;
		КонецЕсли;
		
		ДанныеСертификатаЭКОМ = ДанныеСертификатаЭКОМ(Выборка.СертификатОрганизации);
		Если ДанныеСертификатаЭКОМ.СведенияЕсть = Ложь Тогда
			Продолжить;			
		КонецЕсли;
		
		// Код общий для всех деревьев.
		ДанныеДокумента = ПодготовитьХранилищеДляДанныхДокумента();
		СтруктураДокумента = Новый Структура;	
		// Код общий для всех деревьев.
		
		ТекущаяДата 				= ТекущаяДата();
		ИдентификаторКонтрагента 	= Выборка.ОператорКонтрагентаИдентификатор + Выборка.ИдентификаторКонтрагента;
		ИдентификаторОрганизации 	= Выборка.ОператорОрганизацииИдентификатор + Выборка.ИдентификаторОрганизации;
		ИдентификаторФайла 			= ТипДокумента + "_" + ИдентификаторКонтрагента + "_" + ИдентификаторОрганизации 
		+ "_" + Формат(ТекущаяДата, "ДФ=yyyyMMdd" ) + "_" + ВРег(Строка(Новый УникальныйИдентификатор));
		
		СтрокаФайл = ДанныеДокумента.Строки.Добавить();
		СтрокаФайл.Тег = "Файл";
		СтрокаФайл.Атрибуты.Вставить("ИдФайл", ИдентификаторФайла);
		СтрокаФайл.Атрибуты.Вставить("ВерсПрог", "Docrobot 1C");
		СтрокаФайл.Атрибуты.Вставить("ВерсФорм", "5.01");
		
		СведенияОбУчастниках = СтрокаФайл.Строки.Добавить();
		СведенияОбУчастниках.Тег = "СвУчДокОбор";
		СведенияОбУчастниках.Атрибуты.Вставить("ИдОтпр", ИдентификаторКонтрагента);
		СведенияОбУчастниках.Атрибуты.Вставить("ИдПок", 	ИдентификаторОрганизации);
		
		СведенияОЭДОтправителя = СведенияОбУчастниках.Строки.Добавить();
		СведенияОЭДОтправителя.Тег = "СвОЭДОтпр";
		СведенияОЭДОтправителя.Атрибуты.Вставить("НаимОрг", Выборка.ОператорКонтрагентаНаименование);
		СведенияОЭДОтправителя.Атрибуты.Вставить("ИННЮЛ", Выборка.ОператорКонтрагентаИНН);
		СведенияОЭДОтправителя.Атрибуты.Вставить("ИдЭДО", Выборка.ОператорКонтрагентаИдентификатор);
		
		Документ = СтрокаФайл.Строки.Добавить();
		Документ.Тег = "Документ";
		Документ.Атрибуты.Вставить("КНД", "1175005");
		Документ.Атрибуты.Вставить("ДатаДок", Формат(ТекущаяДата, "ДФ=dd.MM.yyyy"));
		Документ.Атрибуты.Вставить("ВремДок", Формат(ТекущаяДата, "ДФ=HH.mm.ss"));
		
		ИдентификаторНакладной = Документ.Строки.Добавить();
		ИдентификаторНакладной.Тег = "ИдТНО";
		ИдентификаторНакладной.Атрибуты.Вставить("ИдФайлТН", Выборка.Идентификатор);
		ИдентификаторНакладной.Атрибуты.Вставить("ДатаДокТН", Формат(Выборка.ДатаИзXML, "ДФ=dd.MM.yyyy"));
		ИдентификаторНакладной.Атрибуты.Вставить("ВремДокТН", Формат(Выборка.ДатаИзXML, "ДФ=HH.mm.ss"));
		
		СведенияНакладной = Документ.Строки.Добавить();
		СведенияНакладной.Тег = "СвТНП";
		СведенияНакладной.Атрибуты.Вставить("НаимПервДок", ?(ТипДокумента = "DP_PTORG1", "Акт о приемке товаров",
		"Акт об установленном расхождении по количеству и качеству при приемке товарно-материальных"));
		СведенияНакладной.Атрибуты.Вставить("ОКУДПервДок", "0330201");
		СведенияНакладной.Атрибуты.Вставить("НомФорм", ?(ТипДокумента = "DP_PTORG1", "ТОРГ-1", "ТОРГ-2"));
		СведенияНакладной.Атрибуты.Вставить("НомТН", Выборка.НомерТН);
		СведенияНакладной.Атрибуты.Вставить("ДатаТН", Формат(Выборка.ДатаТН, "ДФ=dd.MM.yyyy"));
		
		Подписант = Документ.Строки.Добавить();
		Подписант.Тег = "Подписант";
		
		ПодписантЮЛ = Подписант.Строки.Добавить();
		ПодписантЮЛ.Тег = "ЮЛ";
		ПодписантЮЛ.Атрибуты.Вставить("ИННЮЛ", ДанныеСертификатаЭКОМ.Организация.ИНН);
		ПодписантЮЛ.Атрибуты.Вставить("Должн", ДанныеСертификатаЭКОМ.ПодписантДолжность);
		
		ПодписантФИО = ПодписантЮЛ.Строки.Добавить();
		ПодписантФИО.Тег = "ФИО";
		ПодписантФИО.Атрибуты.Вставить("Фамилия", 	ДанныеСертификатаЭКОМ.ПодписантФамилия);
		ПодписантФИО.Атрибуты.Вставить("Имя", 		ДанныеСертификатаЭКОМ.ПодписантИмя);
		ПодписантФИО.Атрибуты.Вставить("Отчество", 	ДанныеСертификатаЭКОМ.ПодписантОтчество);
		
		СтрокаXML = СоздатьФайлXML(ДанныеДокумента);
		
		СтруктураДокумента.Вставить("ИдФайл", ИдентификаторФайла);
		
		СтруктураСтроки = Новый Структура;	
		СтруктураСтроки.Вставить("ТипДокумента"         , Выборка.Извещение);
		СтруктураСтроки.Вставить("Документ"             , Выборка.Документ_Основание);	
		СтруктураСтроки.Вставить("ИмяФайлаXML"          , ИдентификаторФайла + ".xml");
		СтруктураСтроки.Вставить("СтруктураДокумента"   , СтруктураДокумента);
		СтруктураСтроки.Вставить("ТипИзвещения"         , Выборка.ТипИзв);	
		СтруктураСтроки.Вставить("ВидДокумента"         , Перечисления.ЭКОМ_ВидыДокументов[ТипДокумента]);
		СтруктураСтроки.Вставить("ДанныеСертификатаЭКОМ", ДанныеСертификатаЭКОМ);
		СтруктураСтроки.Вставить("СертификатНаСервере"  , ДанныеСертификатаЭКОМ.СертификатНаСервере);
		СтруктураСтроки.Вставить("ПредставлениеДок"     , ПредставлениеДок);
		СтруктураСтроки.Вставить("ЭЦПотУПД_УКД"         , ЭЦП);
		СтруктураСтроки.Вставить("Контрагент"           , Выборка.Контрагент);
		СтруктураСтроки.Вставить("Организация"          , Выборка.Организация);
		СтруктураСтроки.Вставить("ЗаказДата"            , Выборка.ЗаказДата);
		СтруктураСтроки.Вставить("ЗаказНомер"           , Выборка.ЗаказНомер);
		СтруктураСтроки.Вставить("Статус"               , Перечисления.ЭКОМ_Статусы.Загружен);
		СтруктураСтроки.Вставить("СтрокаXML"            , СтрокаXML);
		СтруктураСтроки.Вставить("КодировкаФайла"       , "windows-1251");
		СтруктураСтроки.Вставить("НомерДокумента"       , Выборка.НомерДокумента);
		СтруктураСтроки.Вставить("ДатаДокумента"        , Выборка.ДатаДокумента);
		
		МассивСтруктур.Добавить(СтруктураСтроки);
		
	КонецЦикла;
	
	Возврат МассивСтруктур;
	
КонецФункции

// Функция проверяет формат пользовательских настреок и изменяет его при необходимости
//
// Возвращаемое значение:
//   Структура   - данные настроек до внесения изменений
//
Функция ИзменитьФорматПользовательскихНастроек(ЭтоОФ, МассивЛогаСобытий) Экспорт
	
	// Проверка необходимости запуска обновлений.
	ВерсияДоЗапуска 	= Настройка_Параметр_Прочитать("СлужебныйТекущаяВерсияОбработки", "");
	ВерсияОбработки 	= ПолучитьВерсиюОбработки();
	СтаршаяВерсия 		= СверитьВерсии(ВерсияДоЗапуска, ВерсияОбработки);
	НеобходимоОбновление = СтаршаяВерсия = ВерсияОбработки И НЕ СтаршаяВерсия = ВерсияДоЗапуска; // Версия обработки выше версии до запуска
	Результат 			= Новый Структура("ЕстьИзменения, ИмяФайлаНастроек, ФайлНастроек", Ложь, "", "");
	
	// Запуск обновлений.
	Если НеобходимоОбновление Тогда
		
		ТребуетсяИзменение 	= Ложь;
		
		// Добавление колонки Обязательный в дерево значений шаблонов исходящих документов.
		ЭКОМ_СтруктураФайлаXMLИсходящие	= Настройка_Параметр_Прочитать("СтруктураФайлаXMLИсходящие");
		
		Если НЕ (ЭКОМ_СтруктураФайлаXMLИсходящие = Неопределено
			ИЛИ НЕ  ТипЗнч(ЭКОМ_СтруктураФайлаXMLИсходящие) = Тип("ДеревоЗначений")) Тогда
			
			// Проверка типа колонки Атрибуты.
			Для Каждого Строка Из ЭКОМ_СтруктураФайлаXMLИсходящие.Строки Цикл
				Если НЕ (ТипЗнч(Строка.Атрибуты) = Тип("Неопределено") ИЛИ ТипЗнч(Строка.Атрибуты) = Тип("СписокЗначений")) Тогда
					ТребуетсяИзменение = Истина;
				КонецЕсли;
			КонецЦикла;
			
			// Проверка наличия колонки Обязательный.
			ТребуетсяИзменение = ?(ЭКОМ_СтруктураФайлаXMLИсходящие.Колонки.Найти("Обязательный") = Неопределено, Истина, ТребуетсяИзменение);
			
			Если ЭКОМ_СтруктураФайлаXMLИсходящие.Колонки.Найти("Кнопка") = Неопределено Тогда
				ТребуетсяИзменение = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
		// Перенос транзакций "Создать..." в отдельный шаблон.
		ЭКОМ_СтруктураФайлаXMLВходящие	= Настройка_Параметр_Прочитать("СтруктураФайлаXMLВходящие");
		
		Если НЕ (ЭКОМ_СтруктураФайлаXMLВходящие = Неопределено
			ИЛИ НЕ  ТипЗнч(ЭКОМ_СтруктураФайлаXMLВходящие) = Тип("ДеревоЗначений")) Тогда
			
			Для Каждого Строка Из ЭКОМ_СтруктураФайлаXMLВходящие.Строки Цикл
				Если Найти(Строка.ТипТранзакции, "Создать") = 1 Тогда
					ТребуетсяИзменение = Истина;
				КонецЕсли;
			КонецЦикла;
			
			Если ЭКОМ_СтруктураФайлаXMLВходящие.Колонки.Найти("Кнопка") = Неопределено Тогда
				ТребуетсяИзменение = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
		// Проверка настроек для работы фильтра Condra.
		ТекущийПользователь = НайтиТекущегоПользователя();
		СлужебныйНастройкиФильтров = Настройка_Параметр_Прочитать("СлужебныйНастройкиФильтров", , ТекущийПользователь);
		Если НЕ СлужебныйНастройкиФильтров = Неопределено Тогда
			Для Каждого НастройкаФильтров Из СлужебныйНастройкиФильтров.ФильтрыНастройки Цикл
				Если НастройкаФильтров.Имя = СлужебныйНастройкиФильтров.ПоследняяНастройка Тогда
					Если НЕ НастройкаФильтров.Свойство("ФильтрыCondra") Тогда
