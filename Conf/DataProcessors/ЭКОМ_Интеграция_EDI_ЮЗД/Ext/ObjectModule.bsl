Функция Инфо_СколькоОбработано(Знач ЗаДату = Неопределено) Экспорт
	Результат = Неопределено;
	
	ЗаДату = ?(ЗаДату = Неопределено, ТекущаяДата(), ЗаДату);
	ЗаДату = НачалоДня(Дата(ЗаДату));
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|   регСобытия.ВидДокумента,
	|   КОЛИЧЕСТВО(регСобытия.ВидДокумента) КАК Количество
	|ИЗ
	|   РегистрСведений.ЭКОМ_Объекты_События КАК регСобытия
	|ГДЕ
	|   регСобытия.ДатаЗаписи >= &ЗаДату
	|СГРУППИРОВАТЬ ПО
	|   регСобытия.ВидДокумента
	|";
	
	Запрос.УстановитьПараметр("ЗаДату", ЗаДату);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаЗапроса   = РезультатЗапроса.Выбрать();
	
	Результат = "";
	Пока ВыборкаЗапроса.Следующий() Цикл
		Результат = Результат 
		+ ?(ЗначениеЗаполнено(Результат), ", ","") 
		+  ВыборкаЗапроса.ВидДокумента + ": " + ВыборкаЗапроса.Количество
		;    		
	КонецЦикла;
	
	Результат = "за " + Формат(ЗаДату, "ДЛФ=Д") + ?(Результат = "", " Обработано 0 документов", " Обработано: " + Результат); 
	Возврат Результат;
КонецФункции 

Функция Инфо_ДокументыНаПлатформе(МассивЛогаСобытий) Экспорт
	
	Результат = Новый Структура("СписокФайлов, КоличествоФайлов, КоличествоУПД, КоличествоКвитанций", Новый Массив, 0, 0, 0);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЭКОМ_GLN.ПрофильОбмена КАК ПрофильОбмена,
	|	ЭКОМ_GLN.Объект КАК Организация
	|ИЗ
	|	РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN
	|ГДЕ
	|	НЕ ЭКОМ_GLN.ПрофильОбмена = ЗНАЧЕНИЕ(Справочник.ЭКОМ_ПрофилиОбмена.ПустаяСсылка)
	|	И НЕ ЭКОМ_GLN.ПрофильОбмена.ПометкаУдаления И ЭКОМ_GLN.ПрофильОбмена.Активный = ИСТИНА
	|ИТОГИ ПО
	|	ПрофильОбмена";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	мИменаФайлов = Новый Массив;
	счКолФайловВсего     = 0;
	счКолФайловУПД       = 0;
	счКолФайловКвитанции = 0;
	
	ИмяСобытия = "Документы на платформе";
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		ВыборкаПрофильОбмена = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаПрофильОбмена.Следующий() Цикл
			ПрофильОбмена = ВыборкаПрофильОбмена.ПрофильОбмена;
			
			Если ПрофильОбмена.ПроверятьФайлыЛокально = Ложь Тогда
				Если ПрофильОбмена.ОбменПоSOAP = Истина Тогда
					
					МассивЛогаСобытий = Новый Массив;
					Рез = Вычислить("ЭКОМ_ОбщегоНазначения.НовыйSOAPОбращение(ПрофильОбмена, ""getListRequest"", , , МассивЛогаСобытий)");
					
					// Получение ответа от сервиса.
					Если Рез.errorCode = "" Тогда
						ТекстЛогаСобытий = "Нет данных об ответе или ответ сформирован не верно";
						ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
						МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
					
						Возврат Неопределено;
						
					ИначеЕсли НЕ Рез.errorCode = "0" Тогда
						ТекстЛогаСобытий = "Ошибка подключения. (" + Рез.errorCode + ": " + Рез.errorMessage + ")";
						ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
						МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
						
					КонецЕсли;
					
					Для Каждого лЭлемент Из Рез.list Цикл
						мИменаФайлов.Добавить(лЭлемент);
						счКолФайловВсего = счКолФайловВсего + 1;
						
						Если Найти(лЭлемент, "ON_SCHFDOPPR") Тогда
							счКолФайловУПД = счКолФайловУПД + 1;
						ИначеЕсли     Найти(лЭлемент, "DP_PDOTPR") 
							Или Найти(лЭлемент, "DP_IZVPOL") 
							Тогда
							счКолФайловКвитанции = счКолФайловКвитанции + 1;
						КонецЕсли;
					КонецЦикла;
					
					Результат.СписокФайлов         = мИменаФайлов;
					Результат.КоличествоФайлов     = счКолФайловВсего;
					Результат.КоличествоУПД        = счКолФайловУПД;
					Результат.КоличествоКвитанций  = счКолФайловКвитанции;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;	 
		
	КонецЕсли;
	
	Результат.СписокФайлов         = мИменаФайлов;
	Результат.КоличествоФайлов     = счКолФайловВсего;
	Результат.КоличествоУПД        = счКолФайловУПД;
	Результат.КоличествоКвитанций  = счКолФайловКвитанции;
	
	Возврат Результат;
КонецФункции 

Функция Инфо_СведенияОДокументах(ЗаДату = Неопределено, МассивЛогаСобытий) Экспорт
	ИнфоОбработано = Инфо_СколькоОбработано(ЗаДату);
	
	Результат = Инфо_ДокументыНаПлатформе(МассивЛогаСобытий);	
	Если НЕ Результат = Неопределено Тогда    		
		Результат.Вставить("ИнфоОбработано", ИнфоОбработано);		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

Функция ПолучитьСостояниеОбмена() Экспорт
	
	зн_ДатаОтправления = Дата(0001, 01, 01);
	зн_ДатаПолучения   = Дата(0001, 01, 01);
	зн_ЧасыОтправления = 0;
	зн_ЧасыПолучения = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЭКОМ_Объекты_События_Отправка.ДатаЗаписи КАК ДатаОтправления,
	|	РАЗНОСТЬДАТ(ЭКОМ_Объекты_События_Отправка.ДатаЗаписи, &ТекущаяДата, ЧАС) КАК ЧасыОтправления
	|ПОМЕСТИТЬ ВТ_Отправления
	|ИЗ
	|	РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_События_Отправка
	|ГДЕ
	|	ЭКОМ_Объекты_События_Отправка.НаправлениеОбмена = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_НаправлениеОбмена.Исходящий)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЭКОМ_Объекты_События_Отправка.ДатаЗаписи УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЭКОМ_Объекты_События_Поступление.ДатаЗаписи КАК ДатаПолучения,
	|	ВТ_Отправления.ДатаОтправления КАК ДатаОтправления,
	|	РАЗНОСТЬДАТ(ЭКОМ_Объекты_События_Поступление.ДатаЗаписи, &ТекущаяДата, ЧАС) КАК ЧасыПолучения,
	|	ВТ_Отправления.ЧасыОтправления КАК ЧасыОтправления
	|ИЗ
	|	РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_События_Поступление,
	|	ВТ_Отправления КАК ВТ_Отправления
	|ГДЕ
	|	ЭКОМ_Объекты_События_Поступление.НаправлениеОбмена = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_НаправлениеОбмена.Входящий)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПолучения УБЫВ";
	
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	РезультатЗапроса = Запрос.Выполнить();	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		зн_ДатаОтправления = ВыборкаДетальныеЗаписи.ДатаОтправления;
		зн_ДатаПолучения   = ВыборкаДетальныеЗаписи.ДатаПолучения;
		зн_ЧасыОтправления = ВыборкаДетальныеЗаписи.ЧасыОтправления;
		зн_ЧасыПолучения   = ВыборкаДетальныеЗаписи.ЧасыПолучения;
	КонецЦикла;
	
	Результат = Новый Структура("ДатаОтправления, ДатаПолучения, ЧасыОтправления, ЧасыПолучения", зн_ДатаОтправления, зн_ДатаПолучения, зн_ЧасыОтправления, зн_ЧасыПолучения);
	
	Возврат Результат;
	
КонецФункции

Функция Номенклатура_Контрагентов_Записать(Контрагент, Номенклатура, ХарактеристикаНоменклатуры, п_Структура) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат "Укажите Контрагента в настройке соответствий для номенклатуры [" + Строка(Номенклатура) + "]. Невозможно сохранить запись в [РегистрСведений.ЭКОМ_НоменклатураКонтрагентов]";
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.ЭКОМ_НоменклатураКонтрагентов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Контрагент                 = Контрагент;
	МенеджерЗаписи.Номенклатура               = Номенклатура;
	МенеджерЗаписи.ХарактеристикаНоменклатуры = ХарактеристикаНоменклатуры;
	МенеджерЗаписи.Прочитать();
	
	Если НЕ МенеджерЗаписи.Выбран() Тогда // Если запись не существует то записать	
		МенеджерЗаписи.Контрагент                 = Контрагент;
		МенеджерЗаписи.Номенклатура               = Номенклатура;		
		МенеджерЗаписи.ХарактеристикаНоменклатуры = ХарактеристикаНоменклатуры;		
	КонецЕсли;
	
	Для Каждого Элемент Из п_Структура Цикл
		Если ЗначениеЗаполнено(Элемент.Значение) Тогда
			МенеджерЗаписи[Элемент.Ключ] = Элемент.Значение; 	
		КонецЕсли;	
	КонецЦикла;
	
	Попытка
		МенеджерЗаписи.Записать();	
		Результат = Истина;
	Исключение
		Ошибка = ОписаниеОшибки();
		Результат = "Невозможно сохранить запись в [РегистрСведений.ЭКОМ_НоменклатураКонтрагентов]. " + Символы.ПС + Ошибка;
	КонецПопытки;
	
	
	Возврат Истина;
КонецФункции

Функция ПолучитьЕдиницуИзмерения(НаименованиеЕдиницыИзмерения) 
	
	Если НаименованиеЕдиницыИзмерения = Неопределено Тогда
		Возврат "KGM"; 
	КонецЕсли;	
	
	Если СокрЛП(НаименованиеЕдиницыИзмерения) = "шт." 
		или СокрЛП(НаименованиеЕдиницыИзмерения) = "Штука"  
		или СокрЛП(НаименованиеЕдиницыИзмерения) = "шт" Тогда
		Возврат "PCE"; 
	ИначеЕсли  СокрЛП(НаименованиеЕдиницыИзмерения) = "г" 
		или СокрЛП(НаименованиеЕдиницыИзмерения) = "г." 
		или СокрЛП(НаименованиеЕдиницыИзмерения) = "грамм" Тогда
		Возврат "GRM";
	ИначеЕсли  СокрЛП(НаименованиеЕдиницыИзмерения) = "кор" 
		или СокрЛП(НаименованиеЕдиницыИзмерения) = "кор." 
		или НРег(СокрЛП(НаименованиеЕдиницыИзмерения)) = "коробка" Тогда
		Возврат "CT";
	ИначеЕсли  СокрЛП(НаименованиеЕдиницыИзмерения) = "упак" 
		или СокрЛП(НаименованиеЕдиницыИзмерения) = "упак." 
		или НРег(СокрЛП(НаименованиеЕдиницыИзмерения)) = "упаковка" Тогда
		Возврат "NMP";
	ИначеЕсли  СокрЛП(НаименованиеЕдиницыИзмерения) = "кг." 
		или СокрЛП(НаименованиеЕдиницыИзмерения) = "Килограмм" 
		или СокрЛП(НаименованиеЕдиницыИзмерения) = "кг" Тогда
		Возврат "KGM";
	ИначеЕсли  СокрЛП(НаименованиеЕдиницыИзмерения) = "м" 
		или СокрЛП(НаименованиеЕдиницыИзмерения) = "Метр" Тогда
		Возврат "MTR"; 
	ИначеЕсли  СокрЛП(НаименованиеЕдиницыИзмерения) = "гол" 
		или СокрЛП(НаименованиеЕдиницыИзмерения) = "Голова" Тогда
		Возврат "ZHD"; 	
	Иначе
		Возврат "KGM";
	КонецЕсли;
	
КонецФункции	

// Функция открывает окно редактора кода и получает результат в виде текста исполняемого кода
//
// Параметры:
//  Заголовок  - Строка - заголовок окна редактора кода
//  ТекстЗапроса  - Строка - текст запроса, передаваемый в редактор кода. Также содержит возвращаемый текст исполняемого кода.
//	ТипДокумента - ДокументСсылка - пустая ссылка на документ, который будет использован для проверки кода (временно возможно не заполнять значение, пока есть варианты без выбора документа)
//	ЭтоЗапрос - Булево - признак работы с запросом (без редактора кода). В этом режиме не выполняется проверка кода и подсветка работает на синтаксис запроса, а не кода 1С.
//
// Возвращаемое значение:
//   Булево   - признак изменения текста исполняемого кода
//
Функция ОткрытьРедакторКода(Обработка, ТекстЗапроса = "", Заголовок = "Редактор кода", ТипДокумента = Неопределено, ЭтоЗапрос = Ложь, РезультатВыраженияКонсоли = Неопределено, СообщитьРезультатПроверки = Истина, ТипТекстаКода = "") Экспорт
	
	// Предназначена только для запуска в обычных формах на стороне клиента.
	#Если НЕ Клиент Тогда
		Возврат Ложь;
	#КонецЕсли
	
	РезультатВвода 		= Неопределено;
	ТекстМодифицирован 	= Ложь;
	
	ФормаКонсольЗапросов = Обработка.ПолучитьФорму("КонсольЗапросов");
	ФормаКонсольЗапросов.Заголовок 		= Заголовок;
	ФормаКонсольЗапросов.Источник 		= ТипДокумента;
	ФормаКонсольЗапросов.ТекстЗапроса 	= ТекстЗапроса;
	ФормаКонсольЗапросов.ЭтоЗапрос		= ЭтоЗапрос;
	ФормаКонсольЗапросов.ТипТекстаКода  = ТипТекстаКода;
	ФормаКонсольЗапросов.СообщитьРезультатПроверки = СообщитьРезультатПроверки;
	РезультатВвода = ФормаКонсольЗапросов.ОткрытьМодально();
	
	Если ТипЗнч(РезультатВвода) = Тип("Структура") Тогда
		ТекстМодифицирован 	= РезультатВвода.Изменен;
		ТекстЗапроса 		= РезультатВвода.ТекстЗапроса;
		//ТВС: НачалоИзменений, 02.07.2019
		РезультатВыраженияКонсоли = РезультатВвода.Значение;
		//ТВС: КонецИзменений
	Иначе
		
		Если НЕ РезультатВвода = Неопределено
			И НЕ РезультатВвода = ТекстЗапроса Тогда
			ТекстЗапроса = РезультатВвода;
			ТекстМодифицирован = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ТекстМодифицирован;
	
КонецФункции // ОткрытьРедакторКода()

// Получаем ссылку обработки "Docrobot: Интеграция EDI" для обновления
Функция ПолучитьСсылкуВнешнейОбработкиДляАвтоматическогоОбновления() Экспорт
	
	СправочникОбработок = "";
	Если НЕ Метаданные.Справочники.Найти("ДополнительныеОтчетыИОбработки") = Неопределено Тогда
		СправочникОбработок = "ДополнительныеОтчетыИОбработки"; 
	ИначеЕсли НЕ Метаданные.Справочники.Найти("ВнешниеОбработки") = Неопределено Тогда	
		СправочникОбработок = "ВнешниеОбработки"; 
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СправочникОбработок) Тогда
		
		Попытка
			Ссылка = Справочники[СправочникОбработок].НайтиПоНаименованию("Docrobot: Интеграция EDI", Истина);
			Если Ссылка.Пустая() Тогда
				Возврат Неопределено;
			Иначе
				Возврат Ссылка;
			КонецЕсли;	
		Исключение
			// наш УИД пустой, или ссылается на удаленный элемент справочника
			Возврат Неопределено;
		КонецПопытки;	
		
	КонецЕсли;	
	
	Возврат Неопределено;
	
КонецФункции

Процедура ЗаписатьЛогСобытий(ТекстСообщения, Знач ТекстЛогаСобытий)

	Если НЕ ЗначениеЗаполнено(ТекстЛогаСобытий) Тогда
		Возврат;
	Иначе
		ТекстЛогаСобытий = Строка(ТекущаяДата()) + ": " + ТекстЛогаСобытий;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстСообщения) Тогда
