	|  _Exite_Spr_Kontragenty.eXite_ESF_TC_VERNOV 
	|FROM
	|  _Exite_Spr_Kontragenty AS _Exite_Spr_Kontragenty" + ?(пКонтрагент = Неопределено, "" , "
	|WHERE
	|  _Exite_Spr_Kontragenty._ID = '" + м_Объект_1C_В_ADO( пКонтрагент ) + "'
	|");
	
	лРекордСет = Неопределено;
