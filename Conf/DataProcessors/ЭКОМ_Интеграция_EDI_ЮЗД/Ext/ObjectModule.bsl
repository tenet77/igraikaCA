							// Данный файл уже есть в не обработанных и добвлен в обработку
							Продолжить;
						КонецЕсли;
						
						НайденнаяСтрока = Данные.ТаблицаОбработанныхФайлов.Найти(ЭлСтруктураФайла.ИмяБезРасширения, "Идентификатор");
						Если НЕ НайденнаяСтрока = Неопределено Тогда
							// Данный файл уже есть в обработанных
							Продолжить;
						КонецЕсли;
						
						СтруктураФайла = Новый Структура;
						// Получем файл из клиента на сервер
						ФайлXMLПолноеИмя    = ВременныйКаталог + ЭлСтруктураФайла.ИмяФайлаXML;
