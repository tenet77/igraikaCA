&НаКлиенте
Процедура КомандаОтчетПоДокументуЭКОМ(Команда)
	
	Если Элементы.СписокДляПоставщика.ТекущиеДанные = Неопределено Тогда
		Сообщить("Выберите строку в табличной части!");
		Возврат;
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура;
	
	СтруктураПараметров.Вставить("Регистратор", Элементы.СписокДляПоставщика.ТекущиеДанные.ЭКОМ_Документ_ORDER);
	СтруктураПараметров.Вставить("Заказ", Элементы.СписокДляПоставщика.ТекущиеДанные.ДокументЗаказа);
	СтруктураПараметров.Вставить("Накладная", Элементы.СписокДляПоставщика.ТекущиеДанные.ДокументРеализации);
	СтруктураПараметров.Вставить("Заголовок"  , Заголовок);
	
	ТабДок = Новый ТабличныйДокумент();
	
	ЗаполнитьТабличныйДокументОтчетПоставщикНаСервере(СтруктураПараметров,ТабДок);
	
	ТабДок.Показать();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТабличныйДокументОтчетПоставщикНаСервере(СтруктураПараметров,ТабДок)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект"); 
	//Получаем схему из макета
	СхемаКомпоновкиДанных = ОбработкаОбъект.ПолучитьМакет("ОтчетПоставщик");
		
	//создадим компоновщик настроек и загрузим настройки по умолчанию, вместо настроек по умолчанию можно использовать восстановленные настройки
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных();
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных));
	КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	Настройки = КомпоновщикНастроек.Настройки;
	
	//установка параметров отчета, без КомпоновщикНастроекКомпоновкиДанных делать это гораздо сложнее
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Регистратор", СтруктураПараметров.Регистратор);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Заказ", СтруктураПараметров.Заказ);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Накладная", СтруктураПараметров.Накладная);
	Настройки.ПараметрыВывода.УстановитьЗначениеПараметра("Заголовок"  , СтруктураПараметров.Заголовок);
	
	//Помещаем в переменную данные о расшифровке данных - здесь ненужный пункт, но пусть будет.
	ДанныеРасшифровки = Вычислить("Новый ДанныеРасшифровкиКомпоновкиДанных");
	
	//Формируем макет, с помощью компоновщика макета
	КомпоновщикМакета = Вычислить("Новый КомпоновщикМакетаКомпоновкиДанных");
	
	//Передаем в макет компоновки схему, настройки и данные расшифровки
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);
	
	//Выполним компоновку с помощью процессора компоновки
	ПроцессорКомпоновкиДанных = Вычислить("Новый ПроцессорКомпоновкиДанных");
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки);
	
	//Очищаем поле табличного документа
	ПроцессорВывода = Вычислить("Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент");
	ПроцессорВывода.УстановитьДокумент(ТабДок);	
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	ТабДок.ОтображатьЗаголовки = Ложь;
	ТабДок.ОтображатьСетку = Ложь;
	
КонецПроцедуры

