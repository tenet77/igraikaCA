// Получает данные роли
//
&НаСервере
Процедура СоздатьДинамическийСписокДобавитьДинамическиеКнопкиНаСервере(ДанныеСписка, МассивЛогаСобытий)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Роли 			= ОбработкаОбъект.ПолучитьРолиТекущегоПользвоателя();
	
	~ОбновитьТаблицуКнопок:
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЭКОМ_РолиКнопки.Ссылка КАК Роль,
		|	""Кнопка"" КАК ВидДанных,
		|	ЭКОМ_РолиКнопки.Синоним,
		|	ЭКОМ_РолиКнопки.Имя,
		|	ЭКОМ_РолиКнопки.Путь,
		|	ЭКОМ_РолиКнопки.ИмяКоманды,
		|	ЭКОМ_РолиКнопки.Действие,
		|	ЭКОМ_РолиКнопки.Предопределенная,
		|	ЭКОМ_РолиКнопки.Картинка,
		|	ЭКОМ_РолиКнопки.Отображение,
		|	ЭКОМ_РолиКнопки.НомерСтроки КАК НомерСтроки
		|ИЗ
		|	Справочник.ЭКОМ_Роли.Кнопки КАК ЭКОМ_РолиКнопки
		|ГДЕ
		|	ЭКОМ_РолиКнопки.Ссылка В(&Роли)
		|	И ЭКОМ_РолиКнопки.Доступность = ИСТИНА
		|	И НЕ ЭКОМ_РолиКнопки.Действие = """"
		|	И НЕ ЭКОМ_РолиКнопки.Ссылка.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЭКОМ_РолиКолонки.Ссылка,
		|	""Колонка"",
		|	ЭКОМ_РолиКолонки.Синоним,
		|	ЭКОМ_РолиКолонки.Имя,
		|	ЭКОМ_РолиКолонки.Путь,
		|	"""",
		|	"""",
		|	"""",
		|	"""",
		|	"""",
		|	ЭКОМ_РолиКолонки.НомерСтроки
		|ИЗ
		|	Справочник.ЭКОМ_Роли.Колонки КАК ЭКОМ_РолиКолонки
		|ГДЕ
		|	ЭКОМ_РолиКолонки.Ссылка В(&Роли)
		|	И ЭКОМ_РолиКолонки.Доступность = ИСТИНА
		|	И НЕ ЭКОМ_РолиКолонки.Ссылка.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";

	Запрос.УстановитьПараметр("Роли", Роли);

	РезультатЗапроса = Запрос.Выполнить();

	НастройкиРоли = РезультатЗапроса.Выгрузить();
	
	Отбор = Новый Структура;
	Отбор.Вставить("Предопределенная", Истина);
	Отбор.Вставить("ИмяКоманды", "");
	ПустыеСтроки = НастройкиРоли.НайтиСтроки(Отбор);
	Если ПустыеСтроки.Количество() > 0 Тогда
		Попытка
			ОбъектПоУмолчанию = Справочники.ЭКОМ_Роли.ПоУмолчанию.ПолучитьОбъект();
		Исключение
			Роль = Справочники.ЭКОМ_Роли.НайтиПоНаименованию("По умолчанию");
			Если Роль = Неопределено Тогда            
				ТекстЛогаСобытий = "Не найдена роль, доступная для текущего пользователя. "
					+ "Динамический список не создан, динамические кнопки не заполнены.";  
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛогаОбщийМодуль(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Ошибка"),
					"СоздатьДинамическийСписокДобавитьДинамическиеКнопкиНаСервере()");
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			КонецЕсли;
			ОбъектПоУмолчанию = Роль.ПолучитьОбъект();
		КонецПопытки;
		ОбъектПоУмолчанию.ОбновитьКнопки();
		ОбъектПоУмолчанию.Записать();
		Роли.Очистить();
		Роли.Добавить(ОбъектПоУмолчанию.Ссылка);
		Перейти ~ОбновитьТаблицуКнопок;
	КонецЕсли;
	ДобавитьДинамическиеКнопки(ДанныеСписка, НастройкиРоли);
	СоздатьДинамическийСписок(ДанныеСписка, НастройкиРоли, Роли, МассивЛогаСобытий);
	
КонецПроцедуры // СоздатьДинамическийСписокДобавитьДинамическиеКнопкиНаСервере()

// Добавляет динамические кнопки на форму
//
// Параметры:
//  <Параметр1>  - <Тип.Вид> - <описание параметра>
//                 <продолжение описания параметра>
//  <Параметр2>  - <Тип.Вид> - <описание параметра>
//                 <продолжение описания параметра>
//
&НаСервере
Процедура ДобавитьДинамическиеКнопки(ДанныеСписка, НастройкиРоли)

	// Группа сопоставлений для совместимости с настройками от ОФ.
	СопоставлениеКонтекстныеМеню = Новый Соответствие;
	СопоставлениеКонтекстныеМеню.Вставить("Поставщик"         , "СписокДляПоставщикаКонтекстноеМеню");
	СопоставлениеКонтекстныеМеню.Вставить("Покупатель"        , "СписокДляПокупателяКонтекстноеМеню");
	СопоставлениеКонтекстныеМеню.Вставить("ЭТРН"              , "СписокДляЭТРНКонтекстноеМеню");
	СопоставлениеКонтекстныеМеню.Вставить("ПрайсЛистВходящий" , "СписокДляПрайсЛистаВходящийКонтекстноеМеню");
	СопоставлениеКонтекстныеМеню.Вставить("ПрайсЛистИсходящий", "СписокДляПрайсЛистаИсходящийКонтекстноеМеню");
	
	СопоставлениеГруппыМеню = Новый Соответствие;
	СопоставлениеГруппыМеню.Вставить("Входящие" , "Получить");
	СопоставлениеГруппыМеню.Вставить("Исходящие", "Отправить");
	СопоставлениеГруппыМеню.Вставить("Документы", "Документы");
	
	СопоставлениеКомандныеПанели = Новый Соответствие;
	СопоставлениеКомандныеПанели.Вставить("КоманднаяПанельПоставщик" , "СписокДляПоставщикаКоманднаяПанель");
	СопоставлениеКомандныеПанели.Вставить("КоманднаяПанельПокупатель", "СписокДляПокупателяКоманднаяПанель"); 
	СопоставлениеКомандныеПанели.Вставить("КоманднаяПанельЭТРН"      , "СписокДляЭТРНКоманднаяПанель");
	СопоставлениеКомандныеПанели.Вставить("КоманднаяПанельCondra"    , "СписокДляCondraКоманднаяПанель");
	СопоставлениеКомандныеПанели.Вставить("КоманднаяПанельПрайсЛистВходящий" , "СписокДляПрайсЛистаВходящийКоманднаяПанель");
	СопоставлениеКомандныеПанели.Вставить("КоманднаяПанельПрайсЛистИсходящий", "СписокДляПрайсЛистаИсходящийКоманднаяПанель");
	
	СопоставлениеОтображение = Новый Соответствие;
	СопоставлениеОтображение.Вставить("Авто", 			"Авто");
	СопоставлениеОтображение.Вставить("Картинка", 		"Картинка");
	СопоставлениеОтображение.Вставить("КартинкаИТекст",	"КартинкаИТекст");
	СопоставлениеОтображение.Вставить("Текст", 			"Текст");
	
	КонтекстноеМеню = Элементы.Найти(ДанныеСписка.ИмяСписка).КонтекстноеМеню;
	ОбновитьКонкретнуюПанель = ТипЗнч(КонтекстноеМеню) = Тип("ГруппаФормы");
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	ВходящиеНастройки  = ОбработкаОбъект.Настройка_Параметр_Прочитать("СтруктураФайлаXMLВходящие");
	ИсходящиеНастройки = ОбработкаОбъект.Настройка_Параметр_Прочитать("СтруктураФайлаXMLИсходящие");
	ДокументыНастройки = ОбработкаОбъект.Настройка_Параметр_Прочитать("СтруктураФайлаXMLДокументы");
	
	Шаблоны = Новый Структура("Входящие, Исходящие, Документы", ВходящиеНастройки, ИсходящиеНастройки, ДокументыНастройки);

	Кнопки = НастройкиРоли.СкопироватьКолонки();
	Кнопки.Колонки.Удалить("Путь");
	Кнопки.Колонки.Добавить("Путь");
	Кнопки.Колонки.Добавить("Группа");

	ЗаписатьДеревоИсходящие = Ложь;
	ЗаписатьДеревоВходящие  = Ложь;

	Для Каждого КнопкаРоли Из НастройкиРоли.НайтиСтроки(Новый Структура("ВидДанных", "Кнопка")) Цикл
		Пути = СтрЗаменить(КнопкаРоли.Путь, "|", Символы.ПС); // Разделяем строку пути на несколько путей, если в ней указано более одного пути для добавления кнопки
		Для НомерСтрокиПути = 1 По СтрЧислоСтрок(Пути) Цикл
			НоваяКнопка = Кнопки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяКнопка, КнопкаРоли, , "Путь");
			Путь = СокрЛП(СтрПолучитьСтроку(Пути, НомерСтрокиПути));
			Путь	= СтрЗаменить(Путь, "__", Символы.ПС);
			НоваяКнопка.Путь = Новый Массив;
			Для НомерСтроки = 1 По СтрЧислоСтрок(Путь) Цикл
				НоваяКнопка.Путь.Добавить(СокрЛП(СтрПолучитьСтроку(Путь, НомерСтроки)));	
			КонецЦикла;
			
			// Нет имени командной панели, получаем ее из шаблона.
			Если НоваяКнопка.Путь.Количество() > 1
				И ПустаяСтрока(НоваяКнопка.Путь.Получить(0)) Тогда
				Шаблон 	= Неопределено;
				ВидШаблона = НоваяКнопка.Путь.Получить(1);
				Если Шаблоны.Свойство(ВидШаблона, Шаблон) И Шаблон <> Неопределено Тогда //Docrobot 1.21.0 MOD-1648[проверка шаблона]
					СтрокаДерева = Шаблон.Строки.Найти(КнопкаРоли.Синоним, "Кнопка");
					Если СтрокаДерева = Неопределено Тогда
						Кнопки.Удалить(НоваяКнопка); // Такого дерева нет, следовательно и кнопки не будет
						Прервать;
					КонецЕсли;
					
					// Изменение имени операции
					Если ВидШаблона = "Исходящие" 
						И СтрокаДерева.ТипТранзакции = "Исходящий ON_NSCHFDOPPR (Новый формат УПД)" Тогда
						СтрокаДерева.ТипТранзакции = "Исходящий ЮЗД - универсальный передаточный документ";
						ЗаписатьДеревоИсходящие = Истина;
					КонецЕсли;
					
					Если ВидШаблона = "Входящие" 
						И СтрокаДерева.ТипТранзакции = "Входящий ON_SCHFDOPPR (универсальный передаточный документ)" Тогда
						СтрокаДерева.ТипТранзакции = "Входящий ЮЗД - универсальный передаточный документ";
						ЗаписатьДеревоВходящие = Истина;
					КонецЕсли;

					// Определение панелей, на которых должна выводиться кнопка.
					Вкладки = Новый Соответствие;
					Вкладки.Вставить("Поставщик" , Ложь);
					Вкладки.Вставить("Покупатель", Ложь);
					Вкладки.Вставить("ЭТРН"      , Ложь);
					Вкладки.Вставить("ПрайсЛист" , Ложь);
					Если НЕ Шаблон.Колонки.Найти("КоллекцияТЧ") = Неопределено Тогда
						
						Если СтрокаДерева.КоллекцияТЧ.Количество() = 0 Тогда
							 СтрокаДерева.КоллекцияТЧ.Добавить("ИмяКнопки" , СтрокаДерева.Кнопка, Истина);
							 СтрокаДерева.КоллекцияТЧ.Добавить("Поставщик" , "", Истина);
							 СтрокаДерева.КоллекцияТЧ.Добавить("Покупатель", "", Истина);
							 СтрокаДерева.КоллекцияТЧ.Добавить("ЭТРН"      , "", Истина);
							 СтрокаДерева.КоллекцияТЧ.Добавить("ПрайсЛист" , "", Истина);												
						КонецЕсли;

						Для Каждого СтрокаКоллекции Из СтрокаДерева.КоллекцияТЧ Цикл
							ИмяДляПанели = СтрЗаменить(?(СтрокаКоллекции.Значение = "ЭТРН", СтрокаКоллекции.Значение, ТРег(СтрокаКоллекции.Значение)), "-", "");
							Если НЕ Вкладки.Получить(ИмяДляПанели) = Неопределено Тогда
								Вкладки[ИмяДляПанели] = СтрокаКоллекции.Пометка;
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
					
					Вкладки.Вставить("ПрайсЛистВходящий" , Вкладки["ПрайсЛист"]);
					Вкладки.Вставить("ПрайсЛистИсходящий", Вкладки["ПрайсЛист"]);
					Вкладки.Удалить("ПрайсЛист");
					
					// Заполнение имени командной панели и дублирование строк с кнопками, если вывод предполагается на нескольких панелях.
					Для Каждого Вкладка Из Вкладки Цикл
						Если НЕ Вкладка.Значение Тогда
							Продолжить;
						КонецЕсли;
						Если ПустаяСтрока(НоваяКнопка.Путь.Получить(0)) Тогда
							НоваяКнопка.Путь.Установить(0, СопоставлениеКонтекстныеМеню.Получить(Вкладка.Ключ));
						Иначе
							НоваяКнопка2 = Кнопки.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяКнопка2, НоваяКнопка, , "Путь");
							НоваяКнопка2.Путь = Новый Массив;
							Для Каждого Элемент Из НоваяКнопка.Путь Цикл
								НоваяКнопка2.Путь.Добавить(Элемент);
							КонецЦикла;
							НоваяКнопка2.Путь.Установить(0, СопоставлениеКонтекстныеМеню.Получить(Вкладка.Ключ));
						КонецЕсли;     
						
					КонецЦикла;
					
				КонецЕсли;
			ИначеЕсли НоваяКнопка.ИмяКоманды = "СоздатьRETORD" Тогда //Docrobot 1.21.0 MOD-1648
				НоваяКнопка.Путь.Добавить("Документы");	
			Иначе
				НоваяКнопка.Путь.Установить(0, СопоставлениеКомандныеПанели.Получить(НоваяКнопка.Путь.Получить(0)));
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если ЗаписатьДеревоИсходящие = Истина Тогда
		 ОбработкаОбъект.Настройка_Параметр_Записать("_СтруктураФайлаXMLИсходящие", ИсходящиеНастройки);
	КонецЕсли;
	Если ЗаписатьДеревоВходящие = Истина Тогда
		 ОбработкаОбъект.Настройка_Параметр_Записать("_СтруктураФайлаXMLВходящие", ВходящиеНастройки);
	КонецЕсли;

	// Преобразовываем путь из массива в группу на панели.
	Для Каждого Кнопка Из Кнопки Цикл
		
		ЭлементФормы 	= Неопределено;
		ПутьСтрокой 	= "";
		
		Для Каждого Путь Из Кнопка.Путь Цикл
			Если СтрДлина(Путь) - Найти(Путь, "КонтекстноеМеню") = 14 Тогда
				ЭлементФормы 	= Элементы.Найти(Путь);
				ПутьСтрокой 	= СтрЗаменить(Путь, "КонтекстноеМеню", "");
			ИначеЕсли СтрДлина(Путь) - Найти(Путь, "КоманднаяПанель") = 14 Тогда
				ЭлементФормы 	= Элементы.Найти(Путь);
				ПутьСтрокой 	= СтрЗаменить(Путь, "КоманднаяПанель", "");
			Иначе
				ПутьСтрокой 	= ПутьСтрокой + "Группа" + СопоставлениеГруппыМеню.Получить(Путь);
				ЭлементФормы 	= Элементы.Найти(ПутьСтрокой);
			КонецЕсли;
		КонецЦикла;
		
		Кнопка.Группа = ЭлементФормы;
		
	КонецЦикла;
	
	// Удаляем все ранее добавленные кнопки.
	Для Каждого ЗаписьКнопки Из Кнопки Цикл
		Если ТипЗнч(ЗаписьКнопки.Группа) = Тип("ГруппаФормы") Тогда
			Для Индекс = 0 По ЗаписьКнопки.Группа.ПодчиненныеЭлементы.Количество() - 1 Цикл
				Попытка
					Кнопка = ЗаписьКнопки.Группа.ПодчиненныеЭлементы.Получить(Индекс);
					Если ТипЗнч(Кнопка) = Тип("КнопкаФормы")
						И Кнопка.РасширеннаяПодсказка.Заголовок = "Кнопка добавлена автоматически" Тогда
						//ЗаписьКнопки.Группа.ПодчиненныеЭлементы.Удалить(Индекс);
					КонецЕсли;
				Исключение 
				    ТекстОшибки = ОписаниеОшибки();	
				КонецПопытки;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	// Добавляем кнопки на форму.
	Для Каждого ЗаписьКнопки Из Кнопки Цикл
		
		// Ищем кнопку.
		Кнопка = Неопределено;
		Если ЗаписьКнопки.Группа = Неопределено Тогда
			Продолжить; // Такого пути не существует (задан неправильный путь для вывода).
		ИначеЕсли ТипЗнч(ЗаписьКнопки.Группа) = Тип("ГруппаФормы") Тогда
			Для Каждого КнопкаГруппы Из ЗаписьКнопки.Группа.ПодчиненныеЭлементы Цикл
				Если КнопкаГруппы.Заголовок = ЗаписьКнопки.Синоним Тогда
					Кнопка = КнопкаГруппы;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		// Добавляем новую кнопку, если ранее ее не было.
		Если Кнопка = Неопределено Тогда
			
			// Создаем команду.
			Если ЭтаФорма.Команды.Найти(ЗаписьКнопки.ИмяКоманды) = Неопределено Тогда
				НоваяКоманда = ЭтаФорма.Команды.Добавить(ЗаписьКнопки.ИмяКоманды);
				НоваяКоманда.Действие = ЗаписьКнопки.Действие;
			КонецЕсли;
			
			// Добавляем кнопку.
			Кнопка = Элементы.Добавить(ЗаписьКнопки.Группа.Имя + ЗаписьКнопки.Имя, Тип("КнопкаФормы"), ЗаписьКнопки.Группа);
			Кнопка.Заголовок  = ЗаписьКнопки.Синоним;
			Кнопка.ИмяКоманды = ЗаписьКнопки.ИмяКоманды;
			Кнопка.РасширеннаяПодсказка.Заголовок = "Кнопка добавлена автоматически";
			
			Если НЕ ПустаяСтрока(ЗаписьКнопки.Картинка) Тогда
				Кнопка.Картинка 	= БиблиотекаКартинок[ЗаписьКнопки.Картинка];
			КонецЕсли;
			Если НЕ ПустаяСтрока(ЗаписьКнопки.Отображение) Тогда
				Кнопка.Отображение	= ОтображениеКнопки[СопоставлениеОтображение.Получить(ЗаписьКнопки.Отображение)];
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	             
КонецПроцедуры // ДобавитьДинамическиеКнопки()

// Обновляет колонки в указанной таблице, сортирует их в определенной последовательности и меняет синоним колонки согласно настройкам роли
//
// Параметры:
//  ИмяДинамическогоСписка  - Строка - имя динамического списка на форме
//  НастройкиРоли  - ТаблицаЗначений - результат запроса, выводимый в таблицу формы
//	Роли - Массив - коллекция доступных пользователю ролей
//  МассивЛогаСобытий  - Массив - данные лога событий для вывода пользователю
//
&НаСервере
Процедура СоздатьДинамическийСписок(ДанныеСписка, НастройкиРоли, Роли, МассивЛогаСобытий)

	ИмяСобытия = "Создать динамический список";
	СлужебныйЗапросДляФормы = ДанныеСписка.АлгоритмЗаполненияСписка;
	ДинамическийСписок = ЭтаФорма[ДанныеСписка.ИмяРеквизитаТаблицы];
	
	КодПолученияТекстаЗапроса = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(СлужебныйЗапросДляФормы, Неопределено, ""Служебный"", Ложь)");
	
	Если НЕ ЗначениеЗаполнено(КодПолученияТекстаЗапроса) Тогда
		
		ТекстЛогаСобытий = "Не заполнен алгоритм заполнения списка формы!";
		ЗаписьСтруктурыЛога = Вычислить("ЭКОМ_ОбщегоНазначения.ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение(""Перечисление.ЭКОМ_УровниЛогирования.Ошибка""), ИмяСобытия)");
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
		Возврат;
	КонецЕсли;
	
	ОбработанныеКолонки = Новый ТаблицаЗначений;
	ОбработанныеКолонки.Колонки.Добавить("Имя");
	ОбработанныеКолонки.Колонки.Добавить("Синоним");
	ОбработанныеКолонки.Колонки.Добавить("Обработана", Новый ОписаниеТипов("Булево"));
	
	Попытка
		
		ТекстЗапроса = "";
		Выполнить(КодПолученияТекстаЗапроса);
		
		Запрос = Новый Запрос;		               
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("ДатаНач", ТекущаяДата());
		Запрос.УстановитьПараметр("ДатаКон", ТекущаяДата());		
		Запрос.УстановитьПараметр("масПомеченныхДоков", Новый Массив);
		Запрос.УстановитьПараметр("НаправлениеОбмена" , Перечисления.ЭКОМ_НаправлениеОбмена.ПустаяСсылка());
		
		Попытка
			РезультатЗапроса = Запрос.Выполнить();
		Исключение
			ТекстЛогаСобытий = ОписаниеОшибки();
			ЗаписьСтруктурыЛога = Вычислить("ЭКОМ_ОбщегоНазначения.ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение(""Перечисление.ЭКОМ_УровниЛогирования.Ошибка""), ИмяСобытия)");
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			//Результат = Новый Структура("ТекстЗапроса, Колонки", ТекстЗапроса, Колонки);
			Возврат; // Результат
		КонецПопытки;
		
		КолонкиЗапроса = РезультатЗапроса.Колонки;
		
		Для каждого ТекКолонка Из КолонкиЗапроса Цикл
			НоваяЗапись	= ОбработанныеКолонки.Добавить();
			НоваяЗапись.Имя	= ТекКолонка.Имя;
		КонецЦикла;			
		
		ДинамическийСписок.ТекстЗапроса = ТекстЗапроса;
			
		Если ДанныеСписка.ТипОбмена="Поставщик" Тогда
			ДинамическийСписок.ОсновнаяТаблица = "РегистрСведений.ЭКОМ_ЦепочкиДокументовПоставщика";
			ДинамическийСписок.ДинамическоеСчитываниеДанных = Истина;	
		ИначеЕсли ДанныеСписка.ТипОбмена="Сеть" Тогда
			ДинамическийСписок.ОсновнаяТаблица = "РегистрСведений.ЭКОМ_ЦепочкиДокументовПокупателя";
			ДинамическийСписок.ДинамическоеСчитываниеДанных = Истина;	
		ИначеЕсли ДанныеСписка.ТипОбмена="ЭТРН" Тогда
			ДинамическийСписок.ОсновнаяТаблица = "РегистрСведений.ЭКОМ_ЦепочкиДокументовЭТРН";
			ДинамическийСписок.ДинамическоеСчитываниеДанных = Истина;	
		ИначеЕсли ДанныеСписка.ТипОбмена="Неструкт. докум." Тогда
			ДинамическийСписок.ОсновнаяТаблица = "РегистрСведений.ЭКОМ_ЦепочкиНеструктурированныхДокументов";
			ДинамическийСписок.ДинамическоеСчитываниеДанных = Истина;	
		КонецЕсли;
		 
	Исключение
		ТекстЛогаСобытий = ОписаниеОшибки();
		ЗаписьСтруктурыЛога = Вычислить("ЭКОМ_ОбщегоНазначения.ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение(""Перечисление.ЭКОМ_УровниЛогирования.Ошибка""), ИмяСобытия)");
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

	КонецПопытки;
		
	// Получение приоритетной настройки колонок (если одна и та же колонка присутствует в нескольких ролях).
	КолонкиРоли = НастройкиРоли.СкопироватьКолонки();
	Для Каждого Роль Из Роли Цикл
		Для Каждого Колонка Из НастройкиРоли.НайтиСтроки(Новый Структура("ВидДанных, Путь, Роль", "Колонка", ДанныеСписка.Путь, Роль)) Цикл
			НоваяКолонка = КолонкиРоли.Найти(Колонка.Имя, "Имя");
			Если НоваяКолонка = Неопределено Тогда
				ЗаполнитьЗначенияСвойств(КолонкиРоли.Добавить(), Колонка);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	// Совпавшие в запросе и выбранные в роли колонки отмечаем как не требующие удаления.
	Для ИндексКолонкиВРоли = 0 По КолонкиРоли.Количество() - 1 Цикл
		Колонка = КолонкиРоли.Получить(ИндексКолонкиВРоли);
		НоваяЗапись = ОбработанныеКолонки.Найти(Колонка.Имя, "Имя");
		Если НоваяЗапись = Неопределено Тогда // Этой колонки нет в запросе. Пропускаем ее
			Продолжить;
		КонецЕсли;
		НоваяЗапись.Синоним = Колонка.Синоним;
		НоваяЗапись.Обработана = Истина; // Отмечаем те колонки, которые необходимо оставить
		// Изменение позиции колонок в переменной.
		ИндексКолонкиНаФорме = ОбработанныеКолонки.Индекс(НоваяЗапись);
		Смещение = ИндексКолонкиВРоли - ИндексКолонкиНаФорме;
		ОбработанныеКолонки.Сдвинуть(НоваяЗапись, Смещение);
	КонецЦикла;
	
	// Изменение видимости и синонимов колонок.
	ЭлементыФормы = Элементы[ДанныеСписка.ИмяСписка].ПодчиненныеЭлементы;
	Для Каждого Колонка Из ЭлементыФормы Цикл
		Если Колонка.Вид = ПредопределенноеЗначение("ВидГруппыФормы.ГруппаКолонок") Тогда
			Продолжить;
		КонецЕсли;
		
		КолонкаИзРоли = ОбработанныеКолонки.Найти(СтрЗаменить(Колонка.Имя, ДанныеСписка.ИмяСписка, ""), "Имя");
		Колонка.Видимость = ?(КолонкаИзРоли = Неопределено ИЛИ НЕ КолонкаИзРоли.Обработана, Ложь, Истина);
		Если НЕ КолонкаИзРоли = Неопределено Тогда
			Колонка.Заголовок = КолонкаИзРоли.Синоним;
		КонецЕсли;
		
	КонецЦикла;
	
	// Изменение позиции колонок на форме.
	Для Каждого КолонкаИзРоли Из ОбработанныеКолонки Цикл
		
		Если НЕ ЭтоКолонкаСКартинкой(КолонкаИзРоли.Имя) Тогда
			
			КолонкаНаФорме = ДанныеСписка.ИмяСписка + КолонкаИзРоли.Имя;
			ЭлементыСписка = Элементы.Найти(КолонкаНаФорме); 				
			Если ЭлементыСписка = Неопределено	Тогда
				НоваяКолонкаТаблицы = Элементы.Добавить(КолонкаНаФорме, Тип("ПолеФормы"), Элементы[ДанныеСписка.ИмяСписка]);
				НоваяКолонкаТаблицы.ПутьКДанным = ДанныеСписка.ИмяРеквизитаТаблицы + "." + КолонкаИзРоли.Имя;
				ЭлементыСписка = НоваяКолонкаТаблицы;
			КонецЕсли;
			
			Элементы[КолонкаНаФорме].Видимость = КолонкаИзРоли.Обработана;
			Элементы[КолонкаНаФорме].Заголовок = КолонкаИзРоли.Синоним;
			ЭтаФорма.Элементы.Переместить(ЭлементыСписка, Элементы[ДанныеСписка.ИмяСписка]);
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Изменение позиции колонок с картинками на форме.
	Для Каждого КолонкаИзРоли Из ОбработанныеКолонки Цикл
		
		Если НЕ ЗначениеЗаполнено(КолонкаИзРоли.Синоним) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЭтоКолонкаСКартинкой(КолонкаИзРоли.Имя) Тогда
			                     
			ИмяОсновнойКолонки = ИмяОсновнойКолонки(КолонкаИзРоли.Имя);
			ОсновнаяКолонкаНаФорме = ДанныеСписка.ИмяСписка + ИмяОсновнойКолонки;
			ЭлементОсновнаяКолонка = Элементы.Найти(ОсновнаяКолонкаНаФорме);
			Если ЭлементОсновнаяКолонка = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			КолонкаНаФорме = ДанныеСписка.ИмяСписка + КолонкаИзРоли.Имя;
			ЭлементыСписка = Элементы.Найти(КолонкаНаФорме); 				
			Если ЭлементыСписка = Неопределено	Тогда
				НоваяКолонкаТаблицы = Элементы.Добавить(КолонкаНаФорме, Тип("ПолеФормы"), Элементы[ДанныеСписка.ИмяСписка]);
				НоваяКолонкаТаблицы.ПутьКДанным = ДанныеСписка.ИмяСписка + "." + КолонкаИзРоли.Имя;
				ЭлементыСписка = НоваяКолонкаТаблицы;
			КонецЕсли;
			
			Элементы[КолонкаНаФорме].Видимость = КолонкаИзРоли.Обработана;
			Элементы[КолонкаНаФорме].Заголовок = КолонкаИзРоли.Синоним;
			Элементы[КолонкаНаФорме].Вид = ВидПоляФормы.ПолеКартинки;
			Элементы[КолонкаНаФорме].КартинкаЗначений = КартинкаДляКолонки(КолонкаИзРоли.Имя);
			
			ГруппаКолонокСКартинкой = ЭтаФорма.Элементы.Найти("ГруппаКолонок_" + ИмяОсновнойКолонки);
			Если ГруппаКолонокСКартинкой = Неопределено Тогда
				ГруппаКолонокСКартинкой = ЭтаФорма.Элементы.Добавить("ГруппаКолонок_" + ИмяОсновнойКолонки, Тип("ГруппаФормы"), Элементы[ДанныеСписка.ИмяСписка]);
				ГруппаКолонокСКартинкой.Вид = ВидГруппыФормы.ГруппаКолонок;
				ГруппаКолонокСКартинкой.Группировка = ГруппировкаКолонок.ВЯчейке;
				ГруппаКолонокСКартинкой.Заголовок = ЭлементОсновнаяКолонка.Заголовок;
				ГруппаКолонокСКартинкой.ОтображатьВШапке = Истина;
			КонецЕсли;
			ЭтаФорма.Элементы.Переместить(ГруппаКолонокСКартинкой, Элементы[ДанныеСписка.ИмяСписка], ЭлементОсновнаяКолонка);
			
			ЭтаФорма.Элементы.Переместить(ЭлементОсновнаяКолонка, ГруппаКолонокСКартинкой);
			ЭлементОсновнаяКолонка.ОтображатьВШапке = Ложь;
			ЭтаФорма.Элементы.Переместить(ЭлементыСписка, ГруппаКолонокСКартинкой);
			ЭлементыСписка.ОтображатьВШапке = Ложь;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЭтаФорма.ДеревоФильтров.ПолучитьЭлементы().Очистить();
	СоздатьСоставПользовательскихНастроекНаСервере(ДанныеСписка);
	СоздатьДеревоПользовательскихНастроекНаСервере(ДанныеСписка, Новый Массив);
	
КонецПроцедуры // СоздатьДинамическийСписок()

Функция ЭтоКолонкаСКартинкой(Знач ИмяКолонки)
	
	Если Найти(ИмяКолонки, "__Картинка") > 0 Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция ИмяОсновнойКолонки(Знач ИмяКолонкиСКартинкой)
	
	ПозицияПостфикса = Найти(ИмяКолонкиСКартинкой, "__Картинка");
	ИмяОсновнойКолонки = Лев(ИмяКолонкиСКартинкой, ПозицияПостфикса - 1);
		
	Возврат ИмяОсновнойКолонки;
	
КонецФункции

Функция КартинкаДляКолонки(Знач ИмяКолонкиСКартинкой)
	
	ДлинаИмениКолонкиСКартинкой = СтрДлина(ИмяКолонкиСКартинкой);
	ПозицияПостфикса = Найти(ИмяКолонкиСКартинкой, "__Картинка");
	ПозицияИдентификатораКартинки = ПозицияПостфикса + СтрДлина("__Картинка");
	ДлинаИдентификатораКартинки = ДлинаИмениКолонкиСКартинкой - ПозицияИдентификатораКартинки + 1; 
	ИдентификаторКартинки = Прав(ИмяКолонкиСКартинкой, ДлинаИдентификатораКартинки);
	ИмяКартинкиИзКонфигурации = "ЭКОМ_" + ИдентификаторКартинки; 
	
	Если ИмяКартинкиИзКонфигурации = "ЭКОМ_Информация" Тогда
		Картинка = БиблиотекаКартинок.ЭКОМ_Информация;
	ИначеЕсли ИмяКартинкиИзКонфигурации = "ЭКОМ_Вопрос" Тогда
		Картинка = БиблиотекаКартинок.ЭКОМ_Вопрос;
	ИначеЕсли ИмяКартинкиИзКонфигурации = "ЭКОМ_ВосклицательныйЗнак" Тогда
		Картинка = БиблиотекаКартинок.ЭКОМ_ВосклицателыныйЗнак;
	Иначе
        Картинка = БиблиотекаКартинок.ЭКОМ_Информация;
	КонецЕсли;
		
	Возврат Картинка;
	
КонецФункции

//Проверка кода гибких настроек на форме: Конец

&НаКлиенте
Функция ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, УровеньЛогирования, ИмяСобытия)
	ЗаписьСтруктурыЛога = Вычислить("ЭКОМ_ОбщегоНазначенияКлиент.ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, УровеньЛогирования, ИмяСобытия)");	
	Возврат ЗаписьСтруктурыЛога;
	
КонецФункции

// <Описание процедуры>
//
// Параметры:
//  <Параметр1>  - <Тип.Вид> - <описание параметра>
//                 <продолжение описания параметра>
//  <Параметр2>  - <Тип.Вид> - <описание параметра>
//                 <продолжение описания параметра>
//
&НаКлиенте
Процедура ДинамическаяКнопкаПолучитьВыполнитьНажатие(Команда)
	
	ТекущаяДата = ТекущаяДата();
	ИмяСобытия	= "Получение документов";
	
	Элементы.КомандаНадписьОшибка.Видимость = Ложь;
	
	ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();
	Если ДанныеСписка.ИмяСписка = "" Тогда
		Возврат;
	КонецЕсли;
	
	МассивлогаСобытий = Новый Массив;	
	СписокОпераций = ДинамическаяКнопкаПолучитьНаСервере(ДанныеСписка, Команда.Имя, МассивЛогаСобытий);
									
	Элементы.ПолеИндикатор.Видимость = Истина;
	Элементы.КомандаЗакрытьИндикатор.Видимость = Истина;	
	ЭтаФорма.Индикатор = 1;
		
    КоличествоОпераци = СписокОпераций.Количество();			
	Для каждого ТипДокумента Из СписокОпераций Цикл
		ОбщийПроцентПрогресса = Окр(100/КоличествоОпераци, 2, РежимОкругления.Окр15как20);		
		Попытка		
			ПроверитьНаличиеФайловНаКлиенте(ТипДокумента, ОбщийПроцентПрогресса, ДанныеСписка, МассивлогаСобытий, ТекущаяДата);
			
		Исключение
			ТекстЛогаСобытий = ОписаниеОшибки();
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Ошибка"), "Проверка/загрузка документов " + ТипДокумента);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			ТекстЛогаСобытий = "Время выполнения " + ЭКОМ_ОбщегоНазначенияКлиент.СекундыВоВремяНаКлиенте(ТекущаяДата() - ТекущаяДата).Строка;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Информация"), ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
			Элементы.КомандаНадписьОшибка.Видимость = Истина;
			
			Выполнить("ЭКОМ_ОбщегоНазначения.СнятьБлокировкуОперации(ТипДокумента, ""Входящий"", МассивлогаСобытий)");
		КонецПопытки;
			
	КонецЦикла;
	
	ОтобразитьЛогСобытий(МассивлогаСобытий);
	
КонецПроцедуры // ДинамическаяКнопкаПолучитьВыполнитьНажатие()

&НаСервере
Функция ДинамическаяКнопкаПолучитьНаСервере(ДанныеСписка, ИмяКнопки, МассивЛогаСобытий)	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Результат = ОбработкаОбъект.ДинамическаяКнопкаПолучить(ДанныеСписка, ИмяКнопки, МассивЛогаСобытий);
	
	Возврат Результат;	
	
КонецФункции

// <Описание процедуры>
//
// Параметры:
//  <Параметр1>  - <Тип.Вид> - <описание параметра>
//                 <продолжение описания параметра>
//  <Параметр2>  - <Тип.Вид> - <описание параметра>
//                 <продолжение описания параметра>
//
&НаКлиенте
Процедура ДинамическаяКнопкаОтправитьВыполнитьНажатие(Команда)
	
	ТекущаяДата = ТекущаяДата();
	ИмяСобытия	= "Отправка документов";
	
	ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();
	Если ДанныеСписка.ИмяСписка = "" Тогда
		Возврат;
	КонецЕсли;	
	
	МассивЛогаСобытий = Новый Массив;
	
	СоответствиеКолонок = ПолучитьСтруктуруКолонок(ДанныеСписка.ИмяСписка);
	Результат = ДинамическаяКнопкаОтправитьНаСервере(ДанныеСписка, Команда.Имя, СоответствиеКолонок, МассивЛогаСобытий);
	
	ДанныеСписка.Вставить("ИмяКнопки", Команда.Имя);
	
	Если Результат.ЕстьОшибка = Ложь Тогда
		Если ОтправитьДокументы(ДанныеСписка, Результат.ИмяСтатуса, Результат.ИмяДокументаИсточника, Результат.ТипДокумента, СоответствиеКолонок, Результат.НужнаПодпись) Тогда
			МассивЛогаСобытий 	= Новый Массив;
			ТекстЛогаСобытий 	= "Время выполнения " + ЭКОМ_ОбщегоНазначенияКлиент.СекундыВоВремяНаКлиенте(ТекущаяДата() - ТекущаяДата).Строка;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Информация"), ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			ОтобразитьЛогСобытий(МассивЛогаСобытий);
		КонецЕсли;
	Иначе	          
		ТекстЛогаСобытий 	= "Время выполнения " + ЭКОМ_ОбщегоНазначенияКлиент.СекундыВоВремяНаКлиенте(ТекущаяДата() - ТекущаяДата).Строка;
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Информация"), ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		ОтобразитьЛогСобытий(МассивЛогаСобытий);
	КонецЕсли;
		
КонецПроцедуры 

&НаСервере
Функция ДинамическаяКнопкаОтправитьНаСервере(ДанныеСписка, ИмяКнопки, СоответствиеКолонок, МассивЛогаСобытий)	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Результат = ОбработкаОбъект.ДинамическаяКнопкаОтправить(ДанныеСписка, ИмяКнопки, СоответствиеКолонок, МассивЛогаСобытий);
	
	Возврат Результат;	
	
КонецФункции

&НаКлиенте
Функция ПолучитьСтруктуруКолонок(ИмяСписка)

	// Проверяем наличие колонок
	СоответствиеКолонок = Новый Соответствие;
	Для каждого СтрКолонки Из Элементы[ИмяСписка].ПодчиненныеЭлементы Цикл
		ИмяКолонки = СтрЗаменить(СтрКолонки.Имя, ИмяСписка, "");
		ИмяКолонки = СтрЗаменить(ИмяКолонки, "ГруппаКолонок_", "");
		СоответствиеКолонок.Вставить(ИмяКолонки, ИмяКолонки);
	КонецЦикла;
	
	Возврат СоответствиеКолонок;
	
КонецФункции 

&НаКлиенте
Процедура ДинамическаяКнопкаВыполнитьНажатие(Команда)
	
	ИмяСобытия = "Создание документов";
	МассивЛогаСобытий = Новый Массив;
	НачалоВыполнения 	= ТекущаяДата();
	
	ТекущаяСтраница = Элементы.ОсновнаяПанель.ТекущаяСтраница;
	Если ТекущаяСтраница = Неопределено Тогда
		ТекстЛогаСобытий = "Выполнение остановлено. Не определена выбранная страница формы";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Ошибка"), ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		Возврат;
	КонецЕсли;
	
	ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();
	ИмяКнопки 	 = Команда.Имя;
	Кнопка		 = Элементы.Найти(ДанныеСписка.ИмяСписка + "ГруппаДокументы" + ИмяКнопки);
		
	Если Кнопка = Неопределено Тогда
		ТекстЛогаСобытий = "Выполнение остановлено. Среди элементов формы не найдена кнопка с именем " + ИмяКнопки;
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Ошибка"), ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		Возврат;
	КонецЕсли;
	
	СинонимКнопки = Кнопка.Заголовок;
		
	ПоляИсточникаДанных = ПоляДокументовТЧ(ДанныеСписка.ИмяСписка);
	ПозицияТекущейСтроки = Неопределено;
	МассивСтрок     = ПолучитьСтрокиДинамическогоСпискаДляОбработки(ДанныеСписка, ПозицияТекущейСтроки);
	//ВыбранныеСтроки = ДокументыПоСтрокеВСтруктуруНаКлиенте(МассивСтрок, ПоляИсточникаДанных, Ложь, Ложь); //++ЭКОМ_ДА Закомментил, не используется
	
	//++ЭКОМ_ДА 2021.10.25(( Проверяем на созданные документы  
	ВОбработку = Новый Массив;
	Повторные  = Новый Массив;
	
	СинонимПриемника="";
	ЗаполнитьМассивПовторных(СинонимКнопки,ДанныеСписка.ТипОбмена,МассивСтрок,ВОбработку,Повторные,СинонимПриемника);
	
	КлючЗаписиЦепочкиДокументов = Элементы[ДанныеСписка.ИмяСписка].ТекущаяСтрока;
	Если ВОбработку.Количество() > 0 Тогда
		// Начать обработку данных
		Если ЭтаФорма.ДоступноВыполнениеВФоне Тогда
			
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("СинонимКнопки", 		СинонимКнопки);
			СтруктураПараметров.Вставить("Роль", 				ДанныеСписка.ТипОбмена);
			СтруктураПараметров.Вставить("ВыбранныеСтроки", 	ВОбработку); //МассивСтрок
			СтруктураПараметров.Вставить("КлючЗаписиЦепочкиДокументов", КлючЗаписиЦепочкиДокументов);
			СтруктураПараметров.Вставить("НачалоВыполнения", 	НачалоВыполнения);
			СтруктураПараметров.Вставить("ДанныеСписка", 		ДанныеСписка);
			СтруктураПараметров.Вставить("ПозицияТекущейСтроки", ПозицияТекущейСтроки);
			СтруктураПараметров.Вставить("ТипДокумента", 		"");
			СтруктураПараметров.Вставить("МассивЛогаСобытий", 	МассивЛогаСобытий);
			СтруктураПараметров.Вставить("ИмяСобытия",			ИмяСобытия);
		                         
			НачатьВыполнениеВФоне(СтруктураПараметров, "СоздатьДокументПоДинамическойКнопке", "Создаем документы - [" + СинонимКнопки + "]...");
			
		Иначе		
			//СоздатьДокументПоДинамическойКнопкеНаСервере(ЭтаФорма.ОбработкаТип, СинонимКнопки, МассивСтрок, ДанныеСписка, МассивЛогаСобытий);	  			
			//ЗавершитьСозданиеДокументов(ДанныеСписка, МассивЛогаСобытий, НачалоВыполнения, ПозицияТекущейСтроки, МассивСтрок, ИмяСобытия);
			СоздатьДокументПоДинамическойКнопкеНаСервере(ЭтаФорма.ОбработкаТип, СинонимКнопки, ВОбработку, ДанныеСписка, МассивЛогаСобытий);	  			
			ЗавершитьСозданиеДокументов(ДанныеСписка, МассивЛогаСобытий, НачалоВыполнения, ПозицияТекущейСтроки, ВОбработку, ИмяСобытия, КлючЗаписиЦепочкиДокументов);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Повторные.Количество() > 0 Тогда
		
		СтруктураПараметров = Новый Структура;  
		СтруктураПараметров.Вставить("СинонимКнопки"  		, СинонимКнопки);
		СтруктураПараметров.Вставить("Роль"           		, ДанныеСписка.ТипОбмена);
	    СтруктураПараметров.Вставить("СинонимПриемника"  	, СинонимПриемника);
		СтруктураПараметров.Вставить("НачалоВыполнения"    	, НачалоВыполнения);
		СтруктураПараметров.Вставить("ДанныеСписка"        	, ДанныеСписка);
		СтруктураПараметров.Вставить("ПозицияТекущейСтроки"	, ПозицияТекущейСтроки);
		СтруктураПараметров.Вставить("ТипДокумента"        	, "");
		СтруктураПараметров.Вставить("МассивЛогаСобытий"   	, МассивЛогаСобытий);
		СтруктураПараметров.Вставить("ИмяСобытия" 		   	, ИмяСобытия);
		СтруктураПараметров.Вставить("КлючЗаписиЦепочкиДокументов", КлючЗаписиЦепочкиДокументов);
		
		ПроверкаМассиваСоздаваемыхДокументов(СтруктураПараметров,Повторные, СинонимКнопки);
		
	КонецЕсли;
	//++ЭКОМ_ДА 2021.10.25))
	
КонецПроцедуры

//++ЭКОМ_ДА(( Используется для проверки повторно создаваемых документов 1С
&НаСервере
Процедура ЗаполнитьМассивПовторных(СинонимКнопки,ТипОбмена,МассивСтрок,ВОбработку,Повторные,СинонимПриемника)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.РаспределитьКоллекциюСоздаваемыхДокументов(СинонимКнопки,ТипОбмена,МассивСтрок,ВОбработку,Повторные,СинонимПриемника);
	
	Для Каждого Стр Из Повторные Цикл 
		Стр.Вставить("СтрокаОбработана",Ложь);	
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПроверкаМассиваСоздаваемыхДокументов(СтруктураПараметров, Повторные, СинонимКнопки)

	Данные = Новый Структура;
	Данные.Вставить("МассивСтрок", Повторные);
	
	Кнопки = Новый СписокЗначений;	
	Кнопки.Добавить("КнопкаДа"        , "Да");
	Кнопки.Добавить("КнопкаДаДляВсех" , "Да, для всех");
	Кнопки.Добавить("КнопкаНет"       , "Нет");
	Кнопки.Добавить("КнопкаНетДляВсех", "Нет, для всех");
	ОтправитьДокумент = Истина;
		
	Для каждого ЭлМассива Из Повторные Цикл	
		
		Если ЭлМассива.СтрокаОбработана = Ложь Тогда
			ОтправитьДокумент = Ложь; 
			
			Данные.Вставить("ИндексМассива"         , Повторные.Найти(ЭлМассива));
			Данные.Вставить("МассивЛогаСобытий"     , СтруктураПараметров.МассивЛогаСобытий);
			Данные.Вставить("ПредставлениеДокумента", ЭлМассива.НомерЗаказа);
			Данные.Вставить("СтруктураПараметров"	, СтруктураПараметров);
			Данные.Вставить("СинонимПриемника"		, СтруктураПараметров.СинонимПриемника);
			Данные.Вставить("СинонимКнопки"		    , СинонимКнопки);
			
			СтрокаИсточник   = "";
			ДокументИсточник = Неопределено;
			Если Найти(НРег(СинонимКнопки), "заказ") > 0  И ЭлМассива.Свойство("ДокументЗаказа", ДокументИсточник) Тогда
				СтрокаИсточник = " " + Строка(ДокументИсточник);
			ИначеЕсли Найти(НРег(СинонимКнопки), "реализацию") > 0 И ЭлМассива.Свойство("ДокументРеализации", ДокументИсточник) Тогда
				СтрокаИсточник = " " + Строка(ДокументИсточник);
			КонецЕсли;
			
			Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопросСозданиеДокументов", ЭтаФорма, Данные); 		
			ПоказатьВопрос(Оповещение, "По заказу " + ЭлМассива.НомерЗаказа + ", документ" + СтрокаИсточник + " уже был создан ранее." 
			+ Символы.ПС + "Продолжить?", Кнопки, 0);
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ОтправитьДокумент Тогда

		Если Повторные.Количество() > 0 Тогда
			
			Если СтруктураПараметров.ДанныеСписка.ИмяСписка = "СписокДляПоставщика" Тогда
				ЭКОМДокументы    = МассивЭКОМДокументовЦепочкиПоставщика();
			ИначеЕсли СтруктураПараметров.ДанныеСписка.ИмяСписка = "СписокДляПокупателя" Тогда
				ЭКОМДокументы    = МассивЭКОМДокументовЦепочкиПокупателя();
			Иначе
				ЭКОМДокументы = Новый Массив;
			КонецЕсли;
			
			Если СписокВыбранныхСтрок.Количество() Тогда   				
				Для Каждого Строка Из Повторные Цикл
					Для Каждого ИмяЭКОМДок Из ЭКОМДокументы Цикл
						Если Строка.Свойство(ИмяЭКОМДок) И ЗначениеЗаполнено(Строка[ИмяЭКОМДок]) Тогда
							СписокВыбранныхСтрок.Добавить(Строка[ИмяЭКОМДок]);
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
			Иначе
				Для Каждого Строка Из Повторные Цикл
					Строка.Вставить("Повтор", Истина);
				КонецЦикла;
			КонецЕсли;
			
			 //Начать обработку данных
			Если ЭтаФорма.ДоступноВыполнениеВФоне Тогда
				
				СтруктураПараметров.Вставить("ВыбранныеСтроки", Повторные);
				НачатьВыполнениеВФоне(СтруктураПараметров, "СоздатьДокументПоДинамическойКнопке", "Создаем документы - [" + СтруктураПараметров.СинонимКнопки + "]...");
				
			Иначе		
				СоздатьДокументПоДинамическойКнопкеНаСервере(ЭтаФорма.ОбработкаТип, СтруктураПараметров.СинонимКнопки, 
					Повторные, СтруктураПараметров.ДанныеСписка, СтруктураПараметров.МассивЛогаСобытий);	  			
				ЗавершитьСозданиеДокументов(СтруктураПараметров.ДанныеСписка, СтруктураПараметров.МассивЛогаСобытий, 
					СтруктураПараметров.НачалоВыполнения, СтруктураПараметров.ПозицияТекущейСтроки, Повторные, СтруктураПараметров.ИмяСобытия, СтруктураПараметров.КлючЗаписиЦепочкиДокументов);
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаНаВопросСозданиеДокументов(Результат, Данные) Экспорт
	
	ИмяСобытия = "Повторное создание";	
	Если Результат <> КодВозвратаДиалога.Отмена Тогда
    	Данные.МассивСтрок[Данные.ИндексМассива].СтрокаОбработана = Истина;
    КонецЕсли;    
    Если Результат = "КнопкаНет" Тогда		
        Данные.МассивСтрок.Удалить(Данные.ИндексМассива);
		ТекстЛогаСобытий = "Документ("+ Данные.СинонимПриемника +") по заказу №"+ Данные.ПредставлениеДокумента + " не создан, так как был создан ранее!";		
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Предупреждение"), ИмяСобытия);
		мЛог = Новый Массив();
		мЛог.Добавить(ЗаписьСтруктурыЛога);
		ОтобразитьЛогСобытий(мЛог);

    ИначеЕсли Результат = "КнопкаНетДляВсех" Тогда		
        Данные.МассивСтрок.Очистить();
		ТекстЛогаСобытий =  "Документы("+Данные.СинонимПриемника+") не созданы, так как были созданы ранее!";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Предупреждение"), ИмяСобытия);
		мЛог = Новый Массив();
		мЛог.Добавить(ЗаписьСтруктурыЛога);
		ОтобразитьЛогСобытий(мЛог);
		 
    ИначеЕсли Результат = "КнопкаДаДляВсех" Тогда		
        Для Каждого ТекущаяСтрокаМассива Из Данные.МассивСтрок Цикл
            ТекущаяСтрокаМассива.СтрокаОбработана = Истина;
        КонецЦикла;	
    КонецЕсли;
    
    ПроверкаМассиваСоздаваемыхДокументов(Данные.СтруктураПараметров,Данные.МассивСтрок, Данные.СинонимКнопки);
    
КонецПроцедуры
//++ЭКОМ_ДА))

&НаКлиенте
Процедура ЗавершитьСозданиеДокументов(ДанныеСписка, МассивЛогаСобытий, НачалоВыполнения, ПозицияТекущейСтроки, ВыбранныеСтроки, ИмяСобытия, КлючЗаписиЦепочкиДокументов = Неопределено)

	//УправлениеПометкамиДинамическогоСписка(Ложь, ДанныеСписка); //MOD-1485
	ОбновитьДинамическийСписок(ДанныеСписка, Истина, ВыбранныеСтроки, КлючЗаписиЦепочкиДокументов);
	СохранитьВыделенныеСтроки(ВыбранныеСтроки, ДанныеСписка.ИмяСписка);
	ОбновитьЦепочкуДокументовНаКлиенте(ДанныеСписка.ИмяСписка, КлючЗаписиЦепочкиДокументов);
    ВосстановитьТекущуюСтрокуСписка(ПозицияТекущейСтроки, ДанныеСписка.ИмяСписка, ВыбранныеСтроки);  
	
	ТекстЛогаСобытий = "Время выполнения " + ЭКОМ_ОбщегоНазначенияКлиент.СекундыВоВремяНаКлиенте(ТекущаяДата() - НачалоВыполнения).Строка;
	ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Информация"), ИмяСобытия);
	МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
	ОтобразитьЛогСобытий(МассивЛогаСобытий);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СоздатьДокументПоДинамическойКнопкеНаСервере(ОбработкаТип, СинонимКнопки, ВыбранныеСтроки, ДанныеСписка, МассивЛогаСобытий)

	Если НЕ ЗначениеЗаполнено(ОбработкаТип) Тогда
	     Возврат;     
	КонецЕсли;
	 
	ОбработкаОбъект = Новый (ЗначениеИзСтрокиВнутр(ОбработкаТип));

	ТЗДокументы =  ОбработкаОбъект.ДинамическаяКнопкаПолучитьТаблицу(СинонимКнопки, ДанныеСписка.ИмяРеквизитаТаблицы, ВыбранныеСтроки, МассивЛогаСобытий);
		
	ОбработкаОбъект.СоздатьДокументПоДинамическойКнопке(ТЗДокументы, СинонимКнопки, ДанныеСписка.ТипОбмена, МассивЛогаСобытий); 
		
КонецПроцедуры

// Функция получает данные в виде таблицы значений из элемента формы
//
// Параметры:
//  ИмяЭлемента  - Строка - имя элемента формы
//
// Возвращаемое значение:
//   ТаблицаЗначений   - данные элемента формы
//
&НаСервере
Функция ТаблицаЗначенийИзЭлементаФормы(ИмяЭлемента)
    
    Схема		= Элементы[ИмяЭлемента].ПолучитьИсполняемуюСхемуКомпоновкиДанных();
    Настройки   = Элементы[ИмяЭлемента].ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
    
    КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
    Макет = КомпоновщикМакета.Выполнить(Схема, Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
    
    ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
    ПроцессорКомпоновкиДанных.Инициализировать(Макет);
    
    ТЗ = Новый ТаблицаЗначений;
    
    ПроцессорВывода  = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
    ПроцессорВывода.УстановитьОбъект(ТЗ);
    ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
    
    Возврат ТЗ;
    
КонецФункции // ДанныеИзЭлементаФормы()

// Функция получает колонки таблицы значений из элемента формы
//
// Параметры:
//  ИмяЭлемента  - Строка - имя элемента формы
//
// Возвращаемое значение:
//   Массив   - коллекция колонок таблицы значений
//
&НаСервере
Функция КолонкиТаблицыЗначенийИзЭлементаФормы(ИмяЭлемента) Экспорт
    
    Колонки = Новый Массив;
    
    Для Каждого Колонка Из ТаблицаЗначенийИзЭлементаФормы(ИмяЭлемента).Колонки Цикл
        Колонки.Добавить(Колонка.Имя);
    КонецЦикла;
    
    Возврат Колонки;
    
КонецФункции // КолонкиТаблицыЗначенийИзЭлементаФормы()

&НаСервере
Функция ПолучитьСписокНастроекНаСервере(МассивНастроек = Неопределено)
    Перем Результат;
    
    ОбъектЭтаОбработка = РеквизитФормыВЗначение("Объект");
    Результат          = ОбъектЭтаОбработка.ПолучитьСписокНастроек(МассивНастроек);

    Возврат Результат;
КонецФункции

&НаСервере
Функция  КомандаПечатьЮЗДНаСервере(МассивДокументовЮЗД, МассивЛогаСобытий, ОриентацияСтраницы)
	
	МассивДокументовСФайлами= Новый Массив;

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	МассивВидовДокументовЮЗД = Новый Массив;
	Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьПервичныеВидыДокументовЮЗД(МассивВидовДокументовЮЗД);");
	Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьИсправительныеВидыДокументовЮЗД(МассивВидовДокументовЮЗД);");
	Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьКорректировочныеВидыДокументовЮЗД(МассивВидовДокументовЮЗД);");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЭКОМ_Объекты_События.Идентификатор,
	|	ЭКОМ_Объекты_События.Документ_Основание,
	|	ЭКОМ_Объекты_События.ВидДокумента,
	|	ЭКОМ_GLN.ПрофильОбмена
	|ИЗ
	|	РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_События
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN
	|		ПО ЭКОМ_Объекты_События.Организация = ЭКОМ_GLN.Объект
	|ГДЕ
	|	ЭКОМ_Объекты_События.Документ_Основание В(&ДокументыЮЗД)
	|	И ЭКОМ_Объекты_События.ВидДокумента В(&ВыдыДокументовЮЗД)";
	
	Запрос.УстановитьПараметр("ВыдыДокументовЮЗД", МассивВидовДокументовЮЗД);
	Запрос.УстановитьПараметр("ДокументыЮЗД"     , МассивДокументовЮЗД);
	
	РезультатЗапроса = Запрос.Выполнить();	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Ошибка = Новый Структура;
		Ошибка.Вставить("ЕстьОшибка" , Ложь);
		Ошибка.Вставить("КодОшибки"  , "");
		Ошибка.Вставить("ТекстОшибки", "");  
		
		ИД_Документа = Прав(Выборка.Идентификатор, 36);
		СтрокаBase64PDF_Документа = ОбработкаОбъект.ИзвлечьPDF_ЭКОМ(Выборка.ПрофильОбмена, ИД_Документа, Ошибка, МассивЛогаСобытий,ОриентацияСтраницы);
		
		ИмяФайла = Строка(Выборка.ВидДокумента) + " № " + Строка(Выборка.Документ_Основание.Номер) + " от " + Формат(Выборка.Документ_Основание.Дата, "ДФ=dd.MM.yy");
		
		Данные = Новый Структура;
		Данные.Вставить("СтрокаBase64PDF_Документа", СтрокаBase64PDF_Документа);
		Данные.Вставить("ИмяФайла"                 , ИмяФайла);
		Данные.Вставить("ТекстОшибки"              , "Код: " + Ошибка.КодОшибки + " - " + Ошибка.ТекстОшибки);
		Данные.Вставить("ИД_Документа"             , ИД_Документа);
		МассивДокументовСФайлами.Добавить(Данные);
				
	КонецЦикла;
	
	Возврат МассивДокументовСФайлами;
	
КонецФункции

&НаСервере
Функция  КомандаПолучитьВсеДокументыЮЗД(МассивДокументовЮЗД, МассивЛогаСобытий)
			
	МассивДокументовСФайлами= Новый Массив;

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	МассивВидовДокументовЮЗД = Новый Массив;
	Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьПервичныеВидыДокументовЮЗД(МассивВидовДокументовЮЗД);");
	Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьИсправительныеВидыДокументовЮЗД(МассивВидовДокументовЮЗД);");
	Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьКорректировочныеВидыДокументовЮЗД(МассивВидовДокументовЮЗД);");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЭКОМ_Объекты_События.Идентификатор КАК Идентификатор,
	|	ЭКОМ_Объекты_События.Документ_Основание КАК Документ_Основание,
	|	ЭКОМ_Объекты_События.ВидДокумента КАК ВидДокумента,
	|	ЭКОМ_GLN.ПрофильОбмена КАК ПрофильОбмена,
	|	ЭКОМ_Объекты_События.ИдентификаторИспр КАК ИдентификаторИспр
	|ИЗ
	|	РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_События
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN
	|		ПО ЭКОМ_Объекты_События.Организация = ЭКОМ_GLN.Объект
	|ГДЕ
	|	ЭКОМ_Объекты_События.Документ_Основание В(&ДокументыЮЗД)
	|	И ЭКОМ_Объекты_События.ВидДокумента В(&ВыдыДокументовЮЗД)";
	
	Запрос.УстановитьПараметр("ВыдыДокументовЮЗД", МассивВидовДокументовЮЗД);
	Запрос.УстановитьПараметр("ДокументыЮЗД"     , МассивДокументовЮЗД);
	
	РезультатЗапроса = Запрос.Выполнить();	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		
		Ошибка = Новый Структура;
		Ошибка.Вставить("ЕстьОшибка" , Ложь);
		Ошибка.Вставить("КодОшибки"  , "");
		Ошибка.Вставить("ТекстОшибки", "");  
		
		ИД_Документа = Прав(Выборка.Идентификатор, 36);
		СтруктураСвязанныхДокументовBase64 = ОбработкаОбъект.ЗагрузитьСвязанныеДокументыЮЗД(Выборка.ПрофильОбмена, ИД_Документа, Ошибка, МассивЛогаСобытий);
		
		
		ИмяФайла = Строка(Выборка.ВидДокумента) + " № " + Строка(Выборка.Документ_Основание.Номер) + " от " + Формат(Выборка.Документ_Основание.Дата, "ДФ=dd.MM.yy");
		
		Данные = Новый Структура;
		Данные.Вставить("СтруктураСвязанныхДокументовBase64", СтруктураСвязанныхДокументовBase64);
		Данные.Вставить("ИмяФайла"                 , ИмяФайла);
		Данные.Вставить("ТекстОшибки"              , "Код: " + Ошибка.КодОшибки + " - " + Ошибка.ТекстОшибки);
		Данные.Вставить("ИД_Документа"             , ИД_Документа);
		МассивДокументовСФайлами.Добавить(Данные);
		
		Если ЗначениеЗаполнено(Выборка.ИдентификаторИспр) Тогда
		
			ЗапросИспр = Новый Запрос;
			ЗапросИспр.Текст = 
			"ВЫБРАТЬ
			|	ЭКОМ_Объекты_События.Идентификатор КАК Идентификатор,
			|	ЭКОМ_Объекты_События.Документ_Основание КАК Документ_Основание,
			|	ЭКОМ_Объекты_События.ВидДокумента КАК ВидДокумента,
			|	ЭКОМ_GLN.ПрофильОбмена КАК ПрофильОбмена,
			|	ЭКОМ_Объекты_События.ИдентификаторИспр КАК ИдентификаторИспр
			|ИЗ
			|	РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_События
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN
			|		ПО ЭКОМ_Объекты_События.Организация = ЭКОМ_GLN.Объект
			|ГДЕ
			|	ЭКОМ_Объекты_События.Идентификатор ПОДОБНО ""%"" + &ИдентификаторОснования
			|	И ЭКОМ_Объекты_События.ВидДокумента В(&ВыдыДокументовЮЗД)";
			
			ЗапросИспр.УстановитьПараметр("ВыдыДокументовЮЗД", МассивВидовДокументовЮЗД);
			ЗапросИспр.УстановитьПараметр("ИдентификаторОснования"     , Выборка.ИдентификаторИспр);
			
			РезультатЗапросаИспр = ЗапросИспр.Выполнить();	
			ВыборкаИспр = РезультатЗапросаИспр.Выбрать();
			Пока ВыборкаИспр.Следующий() Цикл
				
				
				Ошибка = Новый Структура;
				Ошибка.Вставить("ЕстьОшибка" , Ложь);
				Ошибка.Вставить("КодОшибки"  , "");
				Ошибка.Вставить("ТекстОшибки", "");  
				
				ИД_Документа = Прав(ВыборкаИспр.Идентификатор, 36);
				СтруктураСвязанныхДокументовBase64 = ОбработкаОбъект.ЗагрузитьСвязанныеДокументыЮЗД(ВыборкаИспр.ПрофильОбмена, ИД_Документа, Ошибка, МассивЛогаСобытий);
				
				
				ИмяФайла = Строка(ВыборкаИспр.ВидДокумента) + " № " + Строка(ВыборкаИспр.Документ_Основание.Номер) + " от " + Формат(ВыборкаИспр.Документ_Основание.Дата, "ДФ=dd.MM.yy");
				
				Данные = Новый Структура;
				Данные.Вставить("СтруктураСвязанныхДокументовBase64", СтруктураСвязанныхДокументовBase64);
				Данные.Вставить("ИмяФайла"                 , ИмяФайла);
				Данные.Вставить("ТекстОшибки"              , "Код: " + Ошибка.КодОшибки + " - " + Ошибка.ТекстОшибки);
				Данные.Вставить("ИД_Документа"             , ИД_Документа);
				МассивДокументовСФайлами.Добавить(Данные);
				
			КонецЦикла;			
		КонецЕсли;	
	КонецЦикла;
	
	Возврат МассивДокументовСФайлами;
	
КонецФункции

&НаКлиенте
Процедура КомандаПечатьЮЗД(Команда)
	
		ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();
	
	Если  ДанныеСписка.ИмяСписка = "СписокДляПокупателя" Тогда
		ПечатьЮЗД(ДанныеСписка, "ДокументЭКОМ_ЮЗД");
	ИначеЕсли  ДанныеСписка.ИмяСписка = "СписокДляПоставщика" Тогда
		ПечатьЮЗД(ДанныеСписка, "ДокументСЧФ");	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьЮЗД(ДанныеСписка, ИмяДокументаЮЗД)
	
	
    КлючУникальностиФормы = "Docrobot_ФормаНастроекПечати";
	
	ПараметрыНастроек = Новый Структура;
	
	ПараметрыНастроек.Вставить("ИмяДокументаЮЗД", 	ИмяДокументаЮЗД);
	ПараметрыНастроек.Вставить("ИмяСписка", 	ДанныеСписка.ИмяСписка);
		
	Оповещение = Новый ОписаниеОповещения("ОбработатьНастройкиПечати", ЭтаФорма);
    
    ФормаНастройкиПечатиЮЗ = ОткрытьФорму(ПолноеИмяОбработки + ".Форма.УФ_ФормаНастройкиПечатиЮЗД", ПараметрыНастроек, ЭтаФорма, КлючУникальностиФормы,,,Оповещение);
    ФормаНастройкиПечатиЮЗ.Активизировать();

КонецПроцедуры	

&НаКлиенте
Процедура КомандаПолучитьВсеДокументыЮЗДЦепочки(Команда)
	
	ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();
	
	Если  ДанныеСписка.ИмяСписка = "СписокДляПокупателя" Тогда
		ПолучитьВсеДокументыЮЗДЦепочки(ДанныеСписка, "ДокументЭКОМ_ЮЗД");
	ИначеЕсли  ДанныеСписка.ИмяСписка = "СписокДляПоставщика" Тогда
		ПолучитьВсеДокументыЮЗДЦепочки(ДанныеСписка, "ДокументСЧФ");	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьВсеДокументыЮЗДЦепочки(ИмяСписка, ИмяДокументаЮЗД)
	
	ИмяСобытия = "Получить все документы ЮЗД";
	МассивЛогаСобытий = Новый Массив;
	
	ПозицияТекущейСтроки = Неопределено;	
	СписокДокументов = ПолучитьСтрокиДинамическогоСпискаДляОбработки(ИмяСписка, ПозицияТекущейСтроки);
	
	МассивДокументовЮЗД = Новый Массив;
	Для Каждого ВыбраннаяСтрока Из СписокДокументов Цикл		
		Если ЗначениеЗаполнено(ВыбраннаяСтрока[ИмяДокументаЮЗД]) Тогда
			МассивДокументовЮЗД.Добавить(ВыбраннаяСтрока[ИмяДокументаЮЗД]);
		КонецЕсли;					
	КонецЦикла;
	
	Если МассивДокументовЮЗД.Количество() = 0 Тогда
		ТекстЛогаСобытий = "Список выбранных документов пуст. Проверьте заполнение поля - " + ИмяДокументаЮЗД;
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Предупреждение"), ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
	Иначе	
		ЗначениеПоУмолчанию = Неопределено;
		Измерение           = Неопределено; 
		Обязательно         = Истина;
		
		ЛокальныйКаталогРабочийКаталог = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_Рабочий_Каталог"", ЗначениеПоУмолчанию, Измерение, Обязательно)");
		
		// Проверка каталогов INBOX
		Если НЕ Прав(ЛокальныйКаталогРабочийКаталог,1) = "\" Тогда	
			ЛокальныйКаталогРабочийКаталогЦепочекЮЗД = ЛокальныйКаталогРабочийКаталог + "\" + "Цепочки ЮЗД Документов\"; 
		Иначе
			ЛокальныйКаталогРабочийКаталогЦепочекЮЗД = ЛокальныйКаталогРабочийКаталог + "Цепочки ЮЗД Документов\";
		КонецЕсли;
		СоздатьКаталог(ЛокальныйКаталогРабочийКаталогЦепочекЮЗД);
		
		МассивДокументовСФайлами = КомандаПолучитьВсеДокументыЮЗД(МассивДокументовЮЗД, МассивЛогаСобытий);
		ДокументыЗаписаны = Ложь;	
		Если МассивДокументовСФайлами.Количество() = 0 Тогда
			ТекстЛогаСобытий = "Выбранные документы не найдены в регистре ЭКОМ События по документам";
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Предупреждение"), ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
		Иначе
			Для каждого ЭлементМассива Из МассивДокументовСФайлами Цикл
				СодержаниеОшибки = СтрЗаменить(ЭлементМассива.ТекстОшибки, "Код:  - ","");
				Если ЗначениеЗаполнено(СодержаниеОшибки) Тогда
					ТекстЛогаСобытий = "Нет файлов для загрузки по документу:" + ЭлементМассива.ИмяФайла + "( ИД Документа: " + ЭлементМассива.ИД_Документа+". Текст ошибки: " + СодержаниеОшибки + ").";
					ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Ошибка"), ИмяСобытия);
					МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);		
				Иначе
					ИмяКаталогаДляЮЗДЦепочки = ЛокальныйКаталогРабочийКаталогЦепочекЮЗД + ЭлементМассива.ИмяФайла  + "\" ;				
					КаталогДляЮЗДЦепочки = Новый Файл(ИмяКаталогаДляЮЗДЦепочки);
					Если КаталогДляЮЗДЦепочки.Существует()=Ложь Тогда
						СоздатьКаталог(ИмяКаталогаДляЮЗДЦепочки);
					Иначе
						УдалитьФайлы(ИмяКаталогаДляЮЗДЦепочки); 
					КонецЕсли;
					
					Для Каждого ДокСтруктуры Из ЭлементМассива.СтруктураСвязанныхДокументовBase64 Цикл
						Для Каждого ФайлСоответствие из ДокСтруктуры.Значение Цикл
							ДвоичныеДанныеДокумента = Base64Значение(ФайлСоответствие.Значение);
							ИмяФайла = ФайлСоответствие.Ключ;						
							Если НЕ ДвоичныеДанныеДокумента = Неопределено Тогда
								ФайлПолноеИмя = ИмяКаталогаДляЮЗДЦепочки + ИмяФайла;
								ДвоичныеДанныеДокумента.Записать(ФайлПолноеИмя);
								ТекстЛогаСобытий = "Файл сохранен - " + ФайлПолноеИмя;
								ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Успешно"), ИмяСобытия);
								МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);								
								ДокументыЗаписаны = Истина;
							Иначе	
								ТекстЛогаСобытий = "Не найден документ на платформе - " + ЭлементМассива.ИмяФайла + ". Попробуйте позже. /// " 
								+ ЭлементМассива.ТекстОшибки;
								ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Предупреждение"), ИмяСобытия);
								МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
								
							КонецЕсли;						
						КонецЦикла;				
					КонецЦикла;
				КонецЕсли;	
			КонецЦикла;			
		КонецЕсли;
		
		Если ДокументыЗаписаны = Истина Тогда
			Попытка
				ЗапуститьПриложение(ИмяКаталогаДляЮЗДЦепочки);
			Исключение
			КонецПопытки;
		КонецЕсли;
		
	КонецЕсли;
		
	ОтобразитьЛогСобытий(МассивЛогаСобытий);
	
КонецПроцедуры

&НаКлиенте	
Процедура ОбработатьНастройкиПечати(Результат, Данные) Экспорт
	
	МассивЛогаСобытий = Новый Массив;
	ИмяСобытия = "Печать ЮЗД";

	
	Если Результат.ОтменаОперации = Ложь Тогда
		
		ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();
		ИмяДокументаЮЗД = Результат.ИмяДокументаЮЗД;
		
		ПозицияТекущейСтроки = Неопределено;	
		СписокДокументов = ПолучитьСтрокиДинамическогоСпискаДляОбработки(ДанныеСписка, ПозицияТекущейСтроки);
		
		МассивДокументовЮЗД = Новый Массив;
		Для Каждого ВыбраннаяСтрока Из СписокДокументов Цикл		
			Если ЗначениеЗаполнено(ВыбраннаяСтрока[ИмяДокументаЮЗД]) Тогда
				Если ИмяДокументаЮЗД = "ДокументСЧФ" Тогда
					Если Результат.РежимЗагрузкиДокументов = "ЗагружатьПоследнююВерсиюДокумента" Тогда
						МассивДокументовЮЗД.Добавить(ВыбраннаяСтрока[ИмяДокументаЮЗД]);
					ИначеЕсли Результат.РежимЗагрузкиДокументов = "ЗагружатьИсходнуюВерсиюДокумента" Тогда
						МассивДокументовЮЗД.Добавить(ВыбраннаяСтрока.СчетФактураИсходная);
					ИначеЕсли Результат.РежимЗагрузкиДокументов = "ЗагружатьВсеВерсииДокументов" Тогда
						МассивДокументовЮЗД.Добавить(ВыбраннаяСтрока.СчетФактураИсходная);
						
						Если ЗначениеЗаполнено(ВыбраннаяСтрока.СчетФактураКорректировочная) Тогда
							МассивДокументовЮЗД.Добавить(ВыбраннаяСтрока.СчетФактураКорректировочная);
						КонецЕсли;
						
						Если (ЗначениеЗаполнено(ВыбраннаяСтрока.СчетФактураИсправительная)) 
							И (НЕ ВыбраннаяСтрока.СчетФактураИсправительная = ВыбраннаяСтрока.СчетФактураКорректировочная) Тогда
							МассивДокументовЮЗД.Добавить(ВыбраннаяСтрока.СчетФактураИсправительная);
						КонецЕсли;
					КонецЕсли;
				Иначе
					МассивДокументовЮЗД.Добавить(ВыбраннаяСтрока[ИмяДокументаЮЗД]);
				КонецЕсли;
			КонецЕсли;					
		КонецЦикла;
		
		Если МассивДокументовЮЗД.Количество() = 0 Тогда
			ТекстЛогаСобытий = "Список выбранных документов пуст. Проверьте заполнение поля - " + ИмяДокументаЮЗД;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Предупреждение"), ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			
		Иначе	
			
			ЗначениеПоУмолчанию = Неопределено;
			Измерение           = Неопределено; 
			Обязательно         = Истина;
			ЛокальныйКаталогРабочийКаталог = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_Рабочий_Каталог"", ЗначениеПоУмолчанию, Измерение, Обязательно)");
			
			// Проверка каталогов INBOX
			ДанныеОС = ЭКОМ_ПолучитьРазделительПутиОСКлиента();
			РазделительПути = ДанныеОС.Получить("РазделительПути");
			
			ПроверитьЛокальныйКаталог(ЛокальныйКаталогРабочийКаталог, РазделительПути);
			ЛокальныйКаталогРабочийКаталогДляПечатныхФорм = ЛокальныйКаталогРабочийКаталог + "Печатные формы счет-фактур" + РазделительПути;
			
			СоздатьКаталог(ЛокальныйКаталогРабочийКаталогДляПечатныхФорм);
			
			МассивДокументовСФайлами = КомандаПечатьЮЗДНаСервере(МассивДокументовЮЗД, МассивЛогаСобытий,Результат.ОриентацияСтраницы);
			ДокументыЗаписаны = Ложь;	
			Если МассивДокументовСФайлами.Количество() = 0 Тогда
				ТекстЛогаСобытий = "Выбранные документы не найдены в регистре ЭКОМ События по документам";
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Предупреждение"), ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
				
			Иначе
				Для каждого ЭлементМассива Из МассивДокументовСФайлами Цикл
					
					ДвоичныеДанныеPDF_Документа = Base64Значение(ЭлементМассива.СтрокаBase64PDF_Документа);
					
					Если НЕ ДвоичныеДанныеPDF_Документа = Неопределено Тогда
						ФайлПолноеИмя = ЛокальныйКаталогРабочийКаталогДляПечатныхФорм + ЭлементМассива.ИмяФайла + " ИД - " + ЭлементМассива.ИД_Документа + ".pdf";
						ДвоичныеДанныеPDF_Документа.Записать(ФайлПолноеИмя);
						
						ТекстЛогаСобытий = "Файл сохранен - " + ФайлПолноеИмя;
						ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Успешно"), ИмяСобытия);
						МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
						
						ДокументыЗаписаны = Истина;
					Иначе	
						ТекстЛогаСобытий = "Не найден документ на платформе - " + ЭлементМассива.ИмяФайла + ". Попробуйте позже. /// " 
						+ ЭлементМассива.ТекстОшибки;
						ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Предупреждение"), ИмяСобытия);
						МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
			Если ДокументыЗаписаны = Истина Тогда
				Попытка
					ЗапуститьПриложение(ЛокальныйКаталогРабочийКаталогДляПечатныхФорм);
				Исключение
				КонецПопытки;
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		ТекстЛогаСобытий = "Печать документов ЮЗД отменена.";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Информация"), ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
	КонецЕсли;
	
	ОтобразитьЛогСобытий(МассивЛогаСобытий);
					
КонецПроцедуры

&НаКлиенте
Процедура СписокДляЭТРНВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	           
	Если Элемент = Неопределено 
		Или Элемент.ТекущиеДанные = Неопределено 
		Или ВыбраннаяСтрока = Неопределено Тогда
        Возврат;
    КонецЕсли;
    СтандартнаяОбработка = Ложь;
	
	ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();
	Если Поле.Имя = ДанныеСписка.ИмяСписка + "Пометка" Тогда
		
		Если Не Элемент.ТекущиеДанные = Неопределено Тогда
			Если Элемент.ТекущиеДанные.Пометка Тогда
				СнятьПометку(Элемент.ТекущиеДанные.Накладная);
			Иначе
				ПоставитьПометку(Элемент.ТекущиеДанные.Накладная);
			КонецЕсли;
		КонецЕсли;
		
		//Параметр в динамическом списке нужно обновить
		УстановитьПараметрДинамическогоСписка(ДанныеСписка.ИмяРеквизитаТаблицы, "масПомеченныхДоков", СписокВыбранныхСтрок.ВыгрузитьЗначения());	
			
    ИначеЕсли Поле.Имя = "СписокДляЭТРНПалеты" Тогда
		
		ТекСтрока = Элемент.ТекущиеДанные;
			
		Если ЗначениеЗаполнено(ТекСтрока.Накладная) Тогда
						
			ЗначениеПоУмолчанию = Неопределено;
			Измерение           = Неопределено; 
			Обязательно         = Ложь;
			ДокументСсылкаИмя = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_ВидРеализацииПоставщик"", ЗначениеПоУмолчанию, Измерение, Обязательно)");
			
			ПараметрыФормыDesscc = Новый Структура("ДокументСсылкаИмя", ДокументСсылкаИмя);
						
			Оповещение = Новый ОписаниеОповещения("ОбработатьВыборПалеты", ЭтаФорма);
			ОткрытьФорму(ПолноеИмяОбработки + ".Форма.УФ_ФормаDesscc", Новый Структура("ДокументСсылкаИмя, ДокументСсылка", ДокументСсылкаИмя, ТекСтрока.Накладная),,,,, Оповещение);
			
		КонецЕсли;
		
    ИначеЕсли Поле.Имя = "СписокДляЭТРНТранспорт" Тогда
		
		ТекСтрока = Элемент.ТекущиеДанные;
		
		Документ = Неопределено;
		Если ЗначениеЗаполнено(ТекСтрока.ДокументЭКОМ) Тогда
			Документ = ТекСтрока.ДокументЭКОМ;
		Иначе	
			Документ = ТекСтрока.Накладная;
		КонецЕсли;
		
		Отбор = Новый Структура;
		Отбор.Вставить("Документ", Документ);
		
		КлючЗаписи = ПолучитьКлючЭКОМ_ТранспортнаяИнформация(Отбор); 
		Структура = Новый Структура("Ключ", КлючЗаписи);
		
		Если КлючЗаписи = Неопределено Тогда
			
			ОткрытьФорму("РегистрСведений.ЭКОМ_ТранспортнаяИнформация.ФормаЗаписи", Отбор,,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		Иначе
			
			ОткрытьФорму("РегистрСведений.ЭКОМ_ТранспортнаяИнформация.ФормаЗаписи", Структура,,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		КонецЕсли;
		
	ИначеЕсли Поле.Имя = "СписокДляЭТРНТекстОшибки" Тогда
		
		Подсказка = "Текст ошибки";
		Оповещение = Новый ОписаниеОповещения("ЗавершениеПросмотраТекстОшибки", ЭтаФорма);
		ПоказатьВводСтроки(Оповещение, Элемент.ТекущиеДанные.ТекстОшибки, Подсказка, 0, Истина);
		
	ИначеЕсли Поле.Имя = "СписокДляЭТРНКомментарий" Тогда
		
		Подсказка = "Комментарий к ЭТРН";
		Оповещение = Новый ОписаниеОповещения("ЗавершениеПросмотраТекстОшибки", ЭтаФорма);
		ПоказатьВводСтроки(Оповещение, Элемент.ТекущиеДанные.Комментарий, Подсказка, 0, Истина);
		
	КонецЕсли;
	
	ЭлементОбъект = ОпределитьТипОбъекта(Элемент, Поле.Имя);
    Если ЗначениеЗаполнено(ЭлементОбъект) Тогда
        ПоказатьЗначение( , ЭлементОбъект);
    КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура СписокДляCondraВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Элемент = Неопределено 
		Или Элемент.ТекущиеДанные = Неопределено 
		Или ВыбраннаяСтрока = Неопределено Тогда
        Возврат;
    КонецЕсли;
    СтандартнаяОбработка = Ложь;
	
	ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();
	Если Поле.Имя = ДанныеСписка.ИмяСписка + "Пометка" Тогда
		
		Если Не Элемент.ТекущиеДанные = Неопределено Тогда
			Если Элемент.ТекущиеДанные.Пометка Тогда
				СнятьПометку(Элемент.ТекущиеДанные.ДокументОригинала);
			Иначе
				ПоставитьПометку(Элемент.ТекущиеДанные.ДокументОригинала);
			КонецЕсли;
		КонецЕсли;
		
		//Параметр в динамическом списке нужно обновить
		УстановитьПараметрДинамическогоСписка(ДанныеСписка.ИмяРеквизитаТаблицы, "масПомеченныхДоков", СписокВыбранныхСтрок.ВыгрузитьЗначения());	
			
    ИначеЕсли Поле.Имя = "СписокДляCondraТекстОшибки" Тогда
		
		Подсказка = "Текст ошибки";
		Оповещение = Новый ОписаниеОповещения("ЗавершениеПросмотраТекстОшибки", ЭтаФорма);
		ПоказатьВводСтроки(Оповещение, Элемент.ТекущиеДанные.ТекстОшибки, Подсказка, 0, Истина);
		
	ИначеЕсли Поле.Имя = "СписокДляCondraИнформация" Тогда
		
		Подсказка = "Причина отклонения";
		Оповещение = Новый ОписаниеОповещения("ЗавершениеПросмотраТекстОшибки", ЭтаФорма);
		ПоказатьВводСтроки(Оповещение, Элемент.ТекущиеДанные.Информация, Подсказка, 0, Истина);
		
	ИначеЕсли Поле.Имя = "СписокДляCondraОткрытьКаталог" Тогда
		
		ЗначениеПоУмолчанию = Неопределено;
		Измерение           = Неопределено; 
		Обязательно         = Ложь;
		ЛокальныйКаталогINBOX_Архив = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_Локальный_Каталог_INBOX_Архив"", ЗначениеПоУмолчанию, Измерение, Обязательно)");
		
		Файлы 	= НайтиФайлы(ЛокальныйКаталогINBOX_Архив, Элемент.ТекущиеДанные.ИмяФайла, Истина); 
		Если Файлы.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		Файл 	= Файлы.Получить(0);
		
		Если Файл.ЭтоФайл() И Файл.Существует() Тогда
			ЗапуститьПриложение("C:\Windows\explorer.exe /select, " + Файл.ПолноеИмя);
		КонецЕсли;
		
		Возврат;
		
	ИначеЕсли Поле.Имя = "СписокДляCondraДокументОригинала" И ЗначениеЗаполнено(Элемент.ТекущиеДанные.ДокументОригинала) Тогда
		
		Оповещение = Новый ОписаниеОповещения("ЗавершениеПросмотраТекстОшибки", ЭтаФорма);
		ПоказатьЗначение(Оповещение, Элемент.ТекущиеДанные.ДокументОригинала);
		
	ИначеЕсли Поле.Имя = "СписокДляCondraДокументПринятия" И ЗначениеЗаполнено(Элемент.ТекущиеДанные.ДокументПринятия) Тогда
		
		Оповещение = Новый ОписаниеОповещения("ЗавершениеПросмотраТекстОшибки", ЭтаФорма);
		ПоказатьЗначение(Оповещение, Элемент.ТекущиеДанные.ДокументПринятия);
		
	ИначеЕсли Поле.Имя = "СписокДляCondraДокументОтклонения" И ЗначениеЗаполнено(Элемент.ТекущиеДанные.ДокументОтклонения) Тогда
		
		Оповещение = Новый ОписаниеОповещения("ЗавершениеПросмотраТекстОшибки", ЭтаФорма);
		ПоказатьЗначение(Оповещение, Элемент.ТекущиеДанные.ДокументОтклонения);
		
	ИначеЕсли Элемент.ТекущиеДанные.НаправлениеОбмена = ПредопределенноеЗначение("Перечисление.ЭКОМ_НаправлениеОбмена.Исходящий") Тогда
		
		СтруктураЗаписи = Новый Структура("TRANSGUID", Элемент.ТекущиеДанные.ИД_Документа);
		МассивСтруктураЗаписи = Новый Массив;
		МассивСтруктураЗаписи.Добавить(СтруктураЗаписи);
		КлючЗаписи = Новый ("РегистрСведенийКлючЗаписи.ЭКОМ_ЦепочкиНеструктурированныхДокументов", МассивСтруктураЗаписи);
		ОткрытьФорму("РегистрСведений.ЭКОМ_ЦепочкиНеструктурированныхДокументов.ФормаЗаписи", Новый Структура("Ключ", КлючЗаписи));
		
	ИначеЕсли ЗначениеЗаполнено(Элемент.ТекущиеДанные.ДокументОригинала) Тогда
		
		Оповещение = Новый ОписаниеОповещения("ЗавершениеПросмотраТекстОшибки", ЭтаФорма);
		ПоказатьЗначение(Оповещение, Элемент.ТекущиеДанные.ДокументОригинала);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьКлючЭКОМ_ТранспортнаяИнформация(Отбор)
	
	Рег = РегистрыСведений.ЭКОМ_ТранспортнаяИнформация;
	КлючЗаписи = Рег.СоздатьКлючЗаписи(Отбор);
	
	МенеджерЗаписи = РегистрыСведений.ЭКОМ_ТранспортнаяИнформация.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Документ = Отбор.Документ;
	МенеджерЗаписи.Прочитать();
	
	Если МенеджерЗаписи.Выбран() Тогда
		Возврат КлючЗаписи;
	Иначе
		 Возврат Неопределено;	
	КонецЕсли;
			
КонецФункции

&НаСервере
Функция ПолучитьКлючЭКОМ_CondraДатаПоследнейТранзакции(Отбор)
	
	РегистрСведений = РегистрыСведений.ЭКОМ_ЦепочкиНеструктурированныхДокументов;
	Возврат РегистрСведений.СоздатьКлючЗаписи(Отбор);
			
КонецФункции

&НаКлиенте
Процедура ОбновитьТаблицуПалетНаКлиенте(ИмяДинамическогоСписка)
	
	Если ИмяДинамическогоСписка = "СписокДляЭТРН" Тогда
		 
		 МассивДокументов = Новый Массив;
		 
		 ТекущаяСтрока = Элементы[ИмяДинамическогоСписка].ТекущиеДанные;
		 Если НЕ ТекущаяСтрока = Неопределено Тогда
			 МассивДокументов.Добавить(ТекущаяСтрока.Накладная);			
		 КонецЕсли;
		 
		 ТаблицаПалет.Параметры.УстановитьЗначениеПараметра("масПомеченныхДоков" , МассивДокументов);
		 
	 КонецЕсли;
	    
КонецПроцедуры

