Функция ВидСравненияКратко(ВидСравненияДляОписания)
    
    Если      Строка(ВидСравненияДляОписания) = "Больше"           Тогда Результат = ">"
    ИначеЕсли Строка(ВидСравненияДляОписания) = "Больше или равно" Тогда Результат = ">="
    ИначеЕсли Строка(ВидСравненияДляОписания) = "Меньше"           Тогда Результат = "<"
    ИначеЕсли Строка(ВидСравненияДляОписания) = "Меньше или равно" Тогда Результат = "<="
    ИначеЕсли Строка(ВидСравненияДляОписания) = "Не равно"         Тогда Результат = "<>"
    ИначеЕсли Строка(ВидСравненияДляОписания) = "Равно"            Тогда Результат = "="
    Иначе Результат = Строка(ВидСравненияДляОписания)
    КонецЕсли;
    
    Возврат Результат;    
КонецФункции

&НаСервере
Функция ОписатьЭлементКоллекции(ЭлементКоллекции, флТолькоАктивные = Истина, ТипЭлементаСтрокой = "ЭлементОтбораКомпоновкиДанных")
    Результат = "";
    
    Если ТипЗнч(ЭлементКоллекции) = Тип(ТипЭлементаСтрокой) Тогда
        
        Если флТолькоАктивные = Истина
            И НЕ ЭлементКоллекции.Использование 
            Тогда
            Возврат "";
        КонецЕсли;
        
        Результат = Строка(ЭлементКоллекции.ЛевоеЗначение) + " " + ВидСравненияКратко(ЭлементКоллекции.ВидСравнения) + " " + Строка(ЭлементКоллекции.ПравоеЗначение);
    КонецЕсли;
    
    Возврат Результат;
КонецФункции

&НаСервере
Функция ОписатьКоллекциюЭлементовОтбора(Коллекция, флТолькоАктивные = Истина)
    
    Результат = "";
    Для каждого ЭлементКоллекции Из Коллекция Цикл
        ОписаниеЭлементаНастройки = ОписатьЭлементКоллекции(ЭлементКоллекции);
        Результат = Результат + ?(Результат = "", ОписаниеЭлементаНастройки, ", " + ОписаниеЭлементаНастройки); 
    КонецЦикла;
    
    Возврат Результат;
КонецФункции

&НаСервере
Функция ОписатьАктивныеЭлементыНастройки(ЭлементНастройки,флТолькоАктивные = Истина, Знач ТипЭлементаСтрокой = "ОтборКомпоновкиДанных")
    Результат = "";
    КоллекцияЭлементов = ЭлементНастройки.Элементы;
    
    Для каждого ЭлементКоллекции Из КоллекцияЭлементов Цикл
        Если ТипЗнч(ЭлементКоллекции) = Тип("ЭлементОтбораКомпоновкиДанных") Или ТипЗнч(ЭлементКоллекции) = Тип("ОтборКомпоновкиДанных") Тогда
        Иначе
            Продолжить;
        КонецЕсли;
        
        Если ТипЗнч(КоллекцияЭлементов) = Тип("КоллекцияЭлементовПользовательскихНастроекКомпоновкиДанных")  Тогда 
            
            ОписаниеЭлементаНастройки = ОписатьКоллекциюЭлементовОтбора(ЭлементКоллекции.Элементы);
            Результат = Результат + ?(Результат = "", ОписаниеЭлементаНастройки, ", " + ОписаниеЭлементаНастройки); 
            
        Иначе
            
            ОписаниеЭлементаНастройки = ОписатьЭлементКоллекции(ЭлементКоллекции);
            Результат = Результат + ?(Результат = "", ОписаниеЭлементаНастройки, ", " + ОписаниеЭлементаНастройки); 
            
        КонецЕсли;
        
        ОписаниеЭлемента = Неопределено;
        
    КонецЦикла;
    
    КоллекцияЭлементов = Неопределено;
    Возврат Результат;
КонецФункции

&НаКлиенте
Процедура КомандаОбновитьСостоянияОбменов(Команда)
    КомандаПолучитьСостояниеОбмена(Команда);
    КомандаОбновитьКоличествоДокументовНаПлатформе(Команда);
КонецПроцедуры

&НаКлиенте
Процедура КомандаНастройкаСоответствий(Команда)
    
    КлючУникальностиФормы = "ЭКОМ_НастройкиОсновные";
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("НеЗапрашиватьПароль", 						Истина);
	ПараметрыФормы.Вставить("ЭКОМОбъектыАктуальны", 					ЭтаФорма.ЭКОМОбъектыАктуальны);
	ПараметрыФормы.Вставить("ДополнительнаяОбработкаСсылка",			ЭтаФорма.ОбъектСсылка);
	ПараметрыФормы.Вставить("РежимИспользования", 						РежимИспользования);
	ПараметрыФормы.Вставить("ИспользуемоеИмяФайла", 	ЭтаФорма.ИспользуемоеИмяФайла);

	
    ФормаНастроек = ОткрытьФорму(ПолноеИмяОбработки + ".Форма.УФ_ФормаНастройкиОсновные", ПараметрыФормы, ЭтаФорма, КлючУникальностиФормы); 
    ФормаНастроек.Активизировать();
    ФормаНастроек.Элементы.ГруппаПанельНастроек.ТекущаяСтраница = ФормаНастроек.Элементы.ГруппаПанельНастроек.ПодчиненныеЭлементы.ГруппаНастройкаСоответсвий;
    
КонецПроцедуры

&НаКлиенте
Процедура КомандаСкорректироватьДокументыПоступления(Команда)
    
    ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();  
    МассивЛогаСобытий = Новый Массив; 
       
    ВыделенныеСтроки = Элементы[ДанныеСписка.ИмяСписка].ВыделенныеСтроки;
    
    МассивДокументов = Новый Массив;
    Для каждого ИдентификаторСтроки_ Из ВыделенныеСтроки Цикл
        
        ВыбраннаяСтрока  = Элементы[ДанныеСписка.ИмяСписка].ДанныеСтроки(ИдентификаторСтроки_);
        
        Если ЗначениеЗаполнено(ВыбраннаяСтрока.ДокументЭКОМ_ЮЗД) Тогда
            
            МассивДокументов.Добавить(ВыбраннаяСтрока.ДокументЭКОМ_ЮЗД);
            
        КонецЕсли;	
    КонецЦикла;
    
    // Скорректировать документы
    Если МассивДокументов.Количество() > 0 Тогда		
		ПараметрыАлгоритма = Новый Структура;
		ПараметрыАлгоритма.Вставить("МассивДокументов",  МассивДокументов);
		ИмяАлгоритма = "СкорректироватьДокументыПоступления";

		ВыполнитьПроцедуруИзМодуляОбъектаСтруктура(ИмяАлгоритма, ПараметрыАлгоритма, МассивЛогаСобытий);
		
		ОбновитьДинамическийСписок(ДанныеСписка);				
    Иначе
        ТекстЛогаСобытий = "Нет документов поступления для корректировки!";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Предупреждение"), "Скорректировать поступление");
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
    КонецЕсли;
    
    ОтобразитьЛогСобытий(МассивЛогаСобытий);
    
КонецПроцедуры

Процедура ОтборДинамическогоСписка(Источник = "СписокДляПоставщика", ИмяПоля =  "Пометка", ЗначениеПоля = Истина, Очищать = Истина)
    ОтборДС = ЭтаФорма[Источник].Отбор;
    Если Очищать = Истина Тогда
        ОтборДС.Элементы.Очистить();
    КонецЕсли;
    
    Если ИмяПоля = Неопределено И ЗначениеПоля = Неопределено Тогда
        ОтборДС.Элементы.Очистить();
        Возврат;
    КонецЕсли;
    
    
    ЭлОтбора = ОтборДС.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
    
    ЭлОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Пометка");
    ЭлОтбора.ПравоеЗначение = ЗначениеПоля;
    ЭлОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
    
КонецПроцедуры

Функция ДинамическийСписок_в_ТЗ(Источник)
    
    //Получаем схема компановки данных (здесь хранится текст запроса)
    Схема = Элементы[Источник].ПолучитьИсполняемуюСхемуКомпоновкиДанных();
    
    //Получаем настройки пользователя (отборы, сортировки и т.п.)
    Настройки = Элементы[Источник].ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
    
    //Выводим динамический список в таблицу значений
    КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных();
    МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, Настройки, , ,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
    
    ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
    ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
    
    ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
    
    Результат = ПроцессорВывода.Вывести(ПроцессорКомпоновки);
    
    Возврат Результат;
КонецФункции	

&НаСервере
Функция ПолучитьКоличествоСтрокВДинамичесокмСписке(ИмяСписка)
    
    ТЗ = ДинамическийСписок_в_ТЗ(ИмяСписка);
    
    Возврат ТЗ.Количество();
	
КонецФункции

&НаСервере
Функция ПолучитьМассивВсехДокументовДС(ИмяСписка)
    
    ТЗ = ДинамическийСписок_в_ТЗ(ИмяСписка);
    
    Возврат ТЗ.ВыгрузитьКолонку("ДокументыВсе");
	
КонецФункции

&НаКлиенте
Процедура УправлениеПометкамиДинамическогоСписка(Пометка, ДанныеСписка = Неопределено)
	
	Если ДанныеСписка = Неопределено Тогда
	     ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();
	КонецЕсли;
	
	СписокВыбранныхСтрок.Очистить();
	Элементы[ДанныеСписка.ИмяСписка].ВыделенныеСтроки.Очистить();
    ЕстьПометкаНаФорме = НЕ Элементы.Найти(ДанныеСписка.ИмяСписка + "Пометка") = Неопределено;
	
	Если Пометка = Истина 
		ИЛИ ЕстьПометкаНаФорме = Истина Тогда
		КоличествоСтрок = ПолучитьКоличествоСтрокВДинамичесокмСписке(ДанныеСписка.ИмяСписка);
		Для Индекс = 1 По КоличествоСтрок Цикл
			Элементы[ДанныеСписка.ИмяСписка].ВыделенныеСтроки.Добавить(Индекс);			
		КонецЦикла;
	КонецЕсли;

	// Если на форме добавлена колонка пометка
	Если ЕстьПометкаНаФорме = Истина Тогда
				
		Если Пометка Тогда
			МассивДляПометки = ПолучитьМассивВсехДокументовДС(ДанныеСписка.ИмяСписка);
			СписокВыбранныхСтрок.Очистить();
			СписокВыбранныхСтрок.ЗагрузитьЗначения(МассивДляПометки);
		Иначе
			СписокВыбранныхСтрок.Очистить();
		КонецЕсли;

		УстановитьПараметрДинамическогоСписка(ДанныеСписка.ИмяРеквизитаТаблицы, "масПомеченныхДоков", СписокВыбранныхСтрок.ВыгрузитьЗначения());
    		
	КонецЕсли;
	
	Если НЕ Элементы[ДанныеСписка.ИмяСписка].ТекущаяСтрока = Неопределено Тогда
		Элементы[ДанныеСписка.ИмяСписка].ВыделенныеСтроки.Добавить(Элементы[ДанныеСписка.ИмяСписка].ТекущаяСтрока);
	КонецЕсли;
		    
КонецПроцедуры

&НаКлиенте
Процедура СнятьПометку(ДокументСтрока)
	ЭлементСпискаЗначений = СписокВыбранныхСтрок.НайтиПоЗначению(ДокументСтрока);
	Если Не ЭлементСпискаЗначений = Неопределено Тогда
		СписокВыбранныхСтрок.Удалить(ЭлементСпискаЗначений);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПоставитьПометку(ДокументСтрока)
	ЭлементСпискаЗначений = СписокВыбранныхСтрок.НайтиПоЗначению(ДокументСтрока);
	Если ЭлементСпискаЗначений = Неопределено И Не ДокументСтрока = Неопределено Тогда
		СписокВыбранныхСтрок.Добавить(ДокументСтрока);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПометкиСписокДляПоставщикаУстановитьВсе(Команда)
    УправлениеПометкамиДинамическогоСписка(Истина);
КонецПроцедуры

&НаКлиенте
Процедура ПометкиСписокДляПоставщикаСнятьВсе(Команда)
	УправлениеПометкамиДинамическогоСписка(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ПометкиСписокДляПокупателяСнятьВсе(Команда)
	УправлениеПометкамиДинамическогоСписка(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ПометкиСписокДляПокупателяУстановитьВсе(Команда)
	УправлениеПометкамиДинамическогоСписка(Истина);
КонецПроцедуры

//подробное описание вида документа на человеческом языке
&НаСервереБезКонтекста
Функция ПредставлениеВидаЭКОМ_Документа(ЭКОМ_Документ) Экспорт
    
    Если ТипЗнч(ЭКОМ_Документ) <> Тип("ДокументСсылка.ЭКОМ_Документы") Тогда
        Возврат "";
    КонецЕсли;
    
    ВидДокумента = ЭКОМ_Документ.ВидДокумента;
    Возврат Строка(ВидДокумента);
    //если нужно представление отличное от представления в перечислении - уберите вышестоящую строку
    
    Результат = "";
    Если ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ORDER_Входящий Тогда
        Результат = "Заказ покупателя входящий (ORDER)";
    ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ORDER_Исходящий Тогда
        Результат = "Заказ покупателя исходящий (ORDER)";
    ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ORDRSP_Исходящий Тогда
        Результат = "Подтв. заказа покупателя исходящее (ORDERSP)";
    ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ORDRSP_Входящий Тогда
        Результат = "Подтв. заказа покупателя входящее (ORDERSP)";
    ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DESADV_Исходящий Тогда
        Результат = "Уведомление об отгрузке исходящее (DESADV)";
    ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DESADV_Входящий Тогда
        Результат = "Уведомление об отгрузке входящее (DESADV)";
    ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.RECADV_Исходящий Тогда
        Результат = "Уведомление о приемке исходящее (RECADV)";
    ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.RECADV_Входящий Тогда
        Результат = "Уведомление о приемке входящее (RECADV)";
    ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.RETANN_Исходящий Тогда
        Результат = "Уведомление о возврате исходящее (RETANN)";
    ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.RETANN_Входящий Тогда
        Результат = "Уведомление о возврате входящее (RETANN)";
    ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.RETINS_Исходящий Тогда
        Результат = "Инструкция о возврате исходящая (RETINS)";
    ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.RETINS_Входящий Тогда
        Результат = "Инструкция о возврате входящая (RETINS)";
    ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.INVOICE Тогда
        Результат = "Счет (INVOICE)";
    ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DP_OTORG2 Тогда
        Результат = "Подтверждение получения (DP_OTORG2)";
    ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DESSCC_Исходящий Тогда
        Результат = "Уведомление об отгрузке для РЦ исходящее (DESSCC)";
    ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.DESSCC_Входящий Тогда
        Результат = "Уведомление об отгрузке для РЦ входящее (DESSCC)";
        
    ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPR_01 Тогда
        Результат = "УПД/Счет-фактура новый формат (ON_NSCHFDOPPR_01)";
    ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPR_01_Испр Тогда
        Результат = "Исправление УПД/Счет-фактуры новый формат (ON_NSCHFDOPPR_01)";
    ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPOK_11 Тогда
        Результат = "УПД/Счет-фактура (инфо покупателя) новый формат (ON_NSCHFDOPPOK_11)";
	ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPOKMARK_11 Тогда
        Результат = "Маркировка УПД/Счет-фактура (инфо покупателя) новый формат (ON_NSCHFDOPPOKMARK_11)";
	ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_NSCHFDOPPOKPROS_11 Тогда
        Результат = "Прослеживаемость УПД/Счет-фактура (инфо покупателя) новый формат (ON_NSCHFDOPPOKPROS_11)";
    ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_SCHFDOPPR_01 Тогда
        Результат = "УПД/Счет-фактура (ON_SCHFDOPPR_01)";
        
    ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_SCHFDOPPR_01_Испр Тогда
        Результат = "Исправление УПД/Счет-фактуры (ON_SCHFDOPPR_01_Испр)";
    ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_KORSCHFDOPPR_01 Тогда
        Результат = "УКД Корректировочная счет-фактура (ON_KORSCHFDOPPR_01)";
    ИначеЕсли ВидДокумента = Перечисления.ЭКОМ_ВидыДокументов.ON_KORSCHFDOPPR_01_Испр Тогда
        Результат = "УКД Корректировочная исправленная счет-фактура (ON_KORSCHFDOPPR_01_Испр)";
        
    Иначе
        Результат = Строка(ВидДокумента);
    КонецЕсли;		
    
    Возврат Результат;
КонецФункции
//ТВС: КонецИзменений

&НаКлиенте
Процедура КомандаОбработатьПовторно(Команда)
	
	МассивЛогаСобытий = Новый Массив;
    ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();  
	
	ПоляИсточникаДанных = ПоляДокументовТЧ(ДанныеСписка.ИмяСписка);
	ПозицияТекущейСтроки = Неопределено;
	МассивСтрок = ПолучитьСтрокиДинамическогоСпискаДляОбработки(ДанныеСписка, ПозицияТекущейСтроки);
	ВыбранныеСтроки = ДокументыПоСтрокеВСтруктуруНаКлиенте(МассивСтрок, ПоляИсточникаДанных, Ложь, Ложь);
	
    МассивДокументов = Новый Массив;
    Для каждого ВыбраннаяСтрока Из ВыбранныеСтроки Цикл
        Если ЗначениеЗаполнено(ВыбраннаяСтрока.ДокументЭКОМ_ЮЗД) Тогда           
            МассивДокументов.Добавить(ВыбраннаяСтрока.ДокументЭКОМ_ЮЗД);            
        КонецЕсли;	
    КонецЦикла;
    
    // Скорректировать документы
    Если МассивДокументов.Количество() > 0 Тогда       		
		ПараметрыАлгоритма = Новый Структура;
		ПараметрыАлгоритма.Вставить("МассивДокументов", МассивДокументов);
		ИмяАлгоритма = "ОбработатьПовторно";
			
		ВыполнитьПроцедуруИзМодуляОбъектаСтруктура(ИмяАлгоритма, ПараметрыАлгоритма, МассивЛогаСобытий);	
		    
        ОбновитьДинамическийСписок(ДанныеСписка);
        ОбновитьЦепочкуДокументовНаКлиенте(ДанныеСписка.ИмяСписка);
        ОбновитьКвитанцииНаКлиенте(ДанныеСписка.ИмяСписка);

    Иначе
        ТекстЛогаСобытий = "Нет счет-фактур для обработки!";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Информация"), "Обработать повторно");
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
    КонецЕсли;
    
    ОтобразитьЛогСобытий(МассивЛогаСобытий);
    
КонецПроцедуры

&НаКлиенте
