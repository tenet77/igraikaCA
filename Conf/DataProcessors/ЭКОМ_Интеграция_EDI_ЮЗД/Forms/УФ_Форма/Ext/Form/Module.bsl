&НаКлиенте
Процедура ДеревоФильтровУстановитьВсеФлажки(Команда)
	
	Если Команда.Имя = "ДеревоФильтровУстановитьВсеФлажки"  Тогда
		УстановитьИлиСброситьФлажкиДереваОтборов(Истина);
	Иначе
		УстановитьИлиСброситьФлажкиДереваОтборов(Ложь);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьИлиСброситьФлажкиДереваОтборов(Установить) 
	
	Для Каждого Родитель Из ДеревоФильтров.ПолучитьЭлементы() Цикл
		Родитель.Пометка = Установить;
		ДеревоФильтровИзменитьФильтры(Родитель);
		
		Для Каждого Потомок Из Родитель.ПолучитьЭлементы() Цикл
			Потомок.Пометка = Установить;
			ДеревоФильтровИзменитьФильтры(Потомок);
			
			//Для Каждого Стр3 Из Потомок.ПолучитьЭлементы() Цикл
			//	Стр3.Пометка = Установить;
			//КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоФильтровПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ТекущаяСтрока = Элемент.ТекущиеДанные;
	ДеревоФильтровИзменитьФильтры(ТекущаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоФильтровИзменитьФильтры(ТекущаяСтрока)
	
	Родитель      = ТекущаяСтрока.ПолучитьРодителя();

	ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();
	
	ПользовательскийОтбор = ЭтаФорма[ДанныеСписка.ИмяРеквизитаТаблицы].КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ЭтаФорма[ДанныеСписка.ИмяРеквизитаТаблицы].КомпоновщикНастроек.Настройки.Отбор.ИдентификаторПользовательскойНастройки);
	Для каждого Отбор ИЗ ПользовательскийОтбор.Элементы Цикл
		
		Если Родитель = Неопределено Тогда
			
			Если ТипЗнч(Отбор) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
				Продолжить;
			КонецЕсли;	
			
			Если  Найти(Отбор.Представление, "Программный отбор") > 0 
				И Отбор.ПредставлениеПользовательскойНастройки = ТекущаяСтрока.ГруппаНастроек Тогда
				
		        Отбор.Использование = ТекущаяСтрока.Пометка;
				
			КонецЕсли;
		
		Иначе
			
			Если Отбор.ПредставлениеПользовательскойНастройки = Родитель.ГруппаНастроек Тогда
				
				Если Родитель = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				Если Родитель.ТипЗначения = "Число" 
					ИЛИ Родитель.ТипЗначения = "Строка" Тогда
					
					Если ТекущаяСтрока.Пометка = Истина Тогда
					     Отбор.ПравоеЗначение =ТекущаяСтрока.Значение;
					КонецЕсли;
					
				Иначе	
					
					Отбор.ПравоеЗначение.Очистить();
					
					Строки = Родитель.ПолучитьЭлементы();
					Для каждого Стр Из Строки Цикл
						
						Если Стр.Пометка = Истина Тогда
							
							Отбор.ПравоеЗначение.Добавить(Стр.Значение);
							
						КонецЕсли;  
						
					КонецЦикла;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция  НайтиПользовательскийОтбор(ПользовательскийОтбор, ИмяГруппыНастроек)
	
	НайденныйОтбор = Неопределено;
	
	Для каждого Отбор ИЗ ПользовательскийОтбор.Элементы Цикл
		
		Если ТипЗнч(Отбор) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;
		
		Если  Найти(Отбор.Представление, "Программный отбор") > 0 
			И Отбор.ПредставлениеПользовательскойНастройки = ИмяГруппыНастроек Тогда
			
			НайденныйОтбор = Отбор;
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат НайденныйОтбор;
	
КонецФункции

&НаКлиенте
Процедура РазвернутьДеревоФильтровКлиент()
	
	//развернуть дерево отборов требуемого действия
	КоллекцияЭлементовДерева=ДеревоФильтров.ПолучитьЭлементы();
    Для Каждого Строка Из КоллекцияЭлементовДерева Цикл    
        ИдентификаторСтроки = Строка.ПолучитьИдентификатор();
        Элементы.ДеревоФильтров.Развернуть(ИдентификаторСтроки,ИСТИНА);
	КонецЦикла;
	 
КонецПроцедуры

&НаКлиенте
Процедура ОтборДобавить(Команда)
	
	СписокВыбора = ПолучитьСписокОтборов();
	
	СписокПараметров = Новый Структура;
	СписокПараметров.Вставить("Родитель"          , Неопределено);
	СписокПараметров.Вставить("ДобавитьНовыйОтбор", Истина);
	
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораЭлемента", ЭтаФорма, СписокПараметров);
	СписокВыбора.ПоказатьОтметкуЭлементов(Оповещение, "Выберите отбор");
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокОтборов()
	
	ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаСервере();
	
	ЗначениеПоУмолчанию = Неопределено;
	Измерение           = "Служебный"; 
	Обязательно         = Ложь;
	АлгоритмЗаполненияСписка = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(ДанныеСписка.АлгоритмЗаполненияСписка, ЗначениеПоУмолчанию, Измерение, Обязательно)");
	
	Запрос = Новый Запрос;	
    ТекстЗапроса = "";
	СписокВыбора = Новый СписокЗначений;
	
	Если ЗначениеЗаполнено(АлгоритмЗаполненияСписка) Тогда
		Попытка
			
			Выполнить(АлгоритмЗаполненияСписка);
               
			Запрос.Текст = ТекстЗапроса;
			Запрос.УстановитьПараметр("ДатаНач", ТекущаяДата());
			Запрос.УстановитьПараметр("ДатаКон", ТекущаяДата());	
			Запрос.УстановитьПараметр("масПомеченныхДоков", Новый Массив);
			Запрос.УстановитьПараметр("НаправлениеОбмена" , Перечисления.ЭКОМ_НаправлениеОбмена.ПустаяСсылка());
			
			РезультатЗапроса = Запрос.Выполнить();
			КолонкиЗапроса = РезультатЗапроса.Колонки;				
			Для каждого ТекКолонка Из КолонкиЗапроса Цикл
				СписокВыбора.Добавить(ТекКолонка.Имя);			
			КонецЦикла;
			
		Исключение				
		КонецПопытки;
	Иначе
		
		Попытка
			               
			Запрос.Текст = ЭтаФорма[ДанныеСписка.ИмяРеквизитаТаблицы].ТекстЗапроса;
			Запрос.УстановитьПараметр("ДатаНач", ТекущаяДата());
			Запрос.УстановитьПараметр("ДатаКон", ТекущаяДата());	
			Запрос.УстановитьПараметр("масПомеченныхДоков", Новый Массив);
			Запрос.УстановитьПараметр("НаправлениеОбмена" , Перечисления.ЭКОМ_НаправлениеОбмена.ПустаяСсылка());
			
			РезультатЗапроса = Запрос.Выполнить();
			КолонкиЗапроса = РезультатЗапроса.Колонки;				
			Для каждого ТекКолонка Из КолонкиЗапроса Цикл
				СписокВыбора.Добавить(ТекКолонка.Имя);			
			КонецЦикла;
			
		Исключение				
		КонецПопытки;
		
	КонецЕсли;
		
	СписокВыбора.СортироватьПоЗначению();
	
	Возврат СписокВыбора;
	
КонецФункции 

&НаСервере
Функция ПолучитьТекущиеДанныеПоИмениСпискаНаСервере()
	
	ТекущаяСтраницаИмя = Элементы.ОсновнаяПанель.ТекущаяСтраница.Имя;
	
	ИмяРеквизитаТаблицы      = "";
	ИмяСписка                = "";		
	АлгоритмЗаполненияСписка = "";
	ИмяФильтра               = "";
	ТипОбмена                = "";
	Путь                     = "";

	Если ТекущаяСтраницаИмя = "Группа_ЭТРН" Тогда
		
		ИмяРеквизитаТаблицы      = "СписокДляЭТРН";
		ИмяСписка                = "СписокДляЭТРН";		
		АлгоритмЗаполненияСписка = "СлужебныйЗапросДляФормыЭТРН";
		ИмяФильтра               = "ГруппаДинамическийФильтрЭТРН";
		ТипОбмена                = "ЭТРН";
		Путь                     = "ЭТРН";
		
	ИначеЕсли ТекущаяСтраницаИмя = "Группа_Покупатель" Тогда		
		
		ИмяРеквизитаТаблицы      = "СписокДляПокупателя";
		ИмяСписка                = "СписокДляПокупателя";	
		АлгоритмЗаполненияСписка = "СлужебныйЗапросДляФормыПокупателя";
		ИмяФильтра               = "ГруппаДинамическийФильтрСеть";
		ТипОбмена                = "Сеть";
		Путь                     = "Сеть";
		
	ИначеЕсли ТекущаяСтраницаИмя = "Группа_Поставщик" Тогда 	
		
		ИмяРеквизитаТаблицы      = "СписокДляПоставщика";
		ИмяСписка                = "СписокДляПоставщика";
		АлгоритмЗаполненияСписка = "СлужебныйЗапросДляФормыПоставщика";
		ИмяФильтра               = "ГруппаДинамическийФильтрПоставщик";
		ТипОбмена                = "Поставщик";
		Путь                     = "Поставщик";

	ИначеЕсли ТекущаяСтраницаИмя = "Группа_Condra" Тогда 	
		
		ИмяРеквизитаТаблицы      = "СписокДляCondra";
		ИмяСписка                = "СписокДляCondra";
		АлгоритмЗаполненияСписка = "СлужебныйЗапросДляФормыCondra";
		ИмяФильтра               = "ГруппаДинамическийФильтрCondra";
		ТипОбмена                = "Неструкт. докум.";
		Путь                     = "Condra";
		
	ИначеЕсли ТекущаяСтраницаИмя = "ГруппаПрайсЛист" Тогда 	
		
		ИмяРеквизитаТаблицы      = "СписокДляПрайсЛиста";
		АлгоритмЗаполненияСписка = "СлужебныйЗапросДляФормыПрайсЛист";
		ИмяФильтра               = "ГруппаДинамическийФильтрПрайсЛист";
		ТипОбмена                = "Прайс-лист";
		Путь                     = "ПрайсЛист";
		
		ТекущаяВкладка = Элементы.ГруппаСтраницыПрайсЛиста.ТекущаяСтраница.Имя;		
		Если ТекущаяВкладка = "ГруппаВходящийПрайсЛист" Тогда
			ИмяСписка = "СписокДляПрайсЛистаВходящий";
		Иначе	
			ИмяСписка = "СписокДляПрайсЛистаИсходящий";	
		КонецЕсли;
		
	КонецЕсли;

	ДанныеСписка = Новый Структура;
	ДанныеСписка.Вставить("ИмяРеквизитаТаблицы"     , ИмяРеквизитаТаблицы); // Имя реквизита таблицы формы
	ДанныеСписка.Вставить("ИмяСтраницы"             , ТекущаяСтраницаИмя);
	ДанныеСписка.Вставить("ИмяСписка"               , ИмяСписка); // Имя элемента таблицы формы
	ДанныеСписка.Вставить("АлгоритмЗаполненияСписка", АлгоритмЗаполненияСписка);
	ДанныеСписка.Вставить("ИмяФильтра"              , ИмяФильтра);
	ДанныеСписка.Вставить("ТипОбмена"               , ТипОбмена);
	ДанныеСписка.Вставить("Путь"                    , Путь);

	Возврат ДанныеСписка;
	
КонецФункции

&НаКлиенте
Функция ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте(ТекущаяСтраницаИмя = "")

	Если НЕ ЗначениеЗаполнено(ТекущаяСтраницаИмя) Тогда
	     ТекущаяСтраницаИмя = Элементы.ОсновнаяПанель.ТекущаяСтраница.Имя;
	КонецЕсли;

	ИмяРеквизитаТаблицы      = "";
	ИмяСписка                = "";		
	АлгоритмЗаполненияСписка = "";
	ИмяФильтра               = "";
	ТипОбмена                = "";
	Путь                     = "";

	Если ТекущаяСтраницаИмя = "Группа_ЭТРН" Тогда
		
		ИмяРеквизитаТаблицы      = "СписокДляЭТРН";
		ИмяСписка                = "СписокДляЭТРН";		
		АлгоритмЗаполненияСписка = "СлужебныйЗапросДляФормыЭТРН";
		ИмяФильтра               = "ГруппаДинамическийФильтрЭТРН";
		ТипОбмена                = "ЭТРН";
		Путь                     = "ЭТРН";
		
	ИначеЕсли ТекущаяСтраницаИмя = "Группа_Покупатель" Тогда		
		
		ИмяРеквизитаТаблицы      = "СписокДляПокупателя";
		ИмяСписка                = "СписокДляПокупателя";	
		АлгоритмЗаполненияСписка = "СлужебныйЗапросДляФормыПокупателя";
		ИмяФильтра               = "ГруппаДинамическийФильтрСеть";
		ТипОбмена                = "Сеть";
		Путь                     = "Сеть";
		
	ИначеЕсли ТекущаяСтраницаИмя = "Группа_Поставщик" Тогда 	
		
		ИмяРеквизитаТаблицы      = "СписокДляПоставщика";
		ИмяСписка                = "СписокДляПоставщика";
		АлгоритмЗаполненияСписка = "СлужебныйЗапросДляФормыПоставщика";
		ИмяФильтра               = "ГруппаДинамическийФильтрПоставщик";
		ТипОбмена                = "Поставщик";
		Путь                     = "Поставщик";

	ИначеЕсли ТекущаяСтраницаИмя = "Группа_Condra" Тогда 	
		
		ИмяРеквизитаТаблицы      = "СписокДляCondra";
		ИмяСписка                = "СписокДляCondra";
		АлгоритмЗаполненияСписка = "СлужебныйЗапросДляФормыCondra";
		ИмяФильтра               = "ГруппаДинамическийФильтрCondra";
		ТипОбмена                = "Неструкт. докум.";
		Путь                     = "Condra";
		
	ИначеЕсли ТекущаяСтраницаИмя = "ГруппаПрайсЛист" Тогда 	
		
		ИмяРеквизитаТаблицы      = "СписокДляПрайсЛиста";
		АлгоритмЗаполненияСписка = "СлужебныйЗапросДляФормыПрайсЛист";
		ИмяФильтра               = "ГруппаДинамическийФильтрПрайсЛист";
		ТипОбмена                = "Прайс-лист";
		Путь                     = "ПрайсЛист";
		
		ТекущаяВкладка = Элементы.ГруппаСтраницыПрайсЛиста.ТекущаяСтраница.Имя;		
		Если ТекущаяВкладка = "ГруппаВходящийПрайсЛист" Тогда
			ИмяСписка = "СписокДляПрайсЛистаВходящий";
		Иначе	
			ИмяСписка = "СписокДляПрайсЛистаИсходящий";	
		КонецЕсли;
		
	КонецЕсли;

	ДанныеСписка = Новый Структура;
	ДанныеСписка.Вставить("ИмяРеквизитаТаблицы"     , ИмяРеквизитаТаблицы); // Имя реквизита таблицы формы
	ДанныеСписка.Вставить("ИмяСтраницы"             , ТекущаяСтраницаИмя);
	ДанныеСписка.Вставить("ИмяСписка"               , ИмяСписка); // Имя элемента таблицы формы
	ДанныеСписка.Вставить("АлгоритмЗаполненияСписка", АлгоритмЗаполненияСписка);
	ДанныеСписка.Вставить("ИмяФильтра"              , ИмяФильтра);
	ДанныеСписка.Вставить("ТипОбмена"               , ТипОбмена);
	ДанныеСписка.Вставить("Путь"                    , Путь);

	Возврат ДанныеСписка;
	
КонецФункции

&НаКлиенте
Процедура ОтборУдалить(Команда)
	
	ИдентификаторСтроки = Элементы.ДеревоФильтров.ТекущаяСтрока;
	ТекущаяСтрока       = ЭтаФорма.ДеревоФильтров.НайтиПоИдентификатору(ИдентификаторСтроки);
	СтрокаРодитель      = ТекущаяСтрока.ПолучитьРодителя();
	Если НЕ СтрокаРодитель = Неопределено Тогда
	     Возврат;
	КонецЕсли;
	
	Если ТекущаяСтрока.ГруппаНастроек = "Организация"
		ИЛИ ТекущаяСтрока.ГруппаНастроек = "Контрагент" 
		ИЛИ ТекущаяСтрока.ГруппаНастроек = "ТочкаДоставки" Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();
	
	ПользовательскийОтбор = ЭтаФорма[ДанныеСписка.ИмяРеквизитаТаблицы].КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ЭтаФорма[ДанныеСписка.ИмяРеквизитаТаблицы].КомпоновщикНастроек.Настройки.Отбор.ИдентификаторПользовательскойНастройки);
	НайденныйОтбор = НайтиПользовательскийОтбор(ПользовательскийОтбор, ТекущаяСтрока.ГруппаНастроек);
	Если НЕ НайденныйОтбор = Неопределено Тогда
		ПользовательскийОтбор.Элементы.Удалить(НайденныйОтбор);					
	КонецЕсли;
	ЭтаФорма.ДеревоФильтров.ПолучитьЭлементы().Удалить(ТекущаяСтрока);
		
КонецПроцедуры

&НаКлиенте
Процедура КомандаУдалитьФильтр(Команда)
	
	КомандаУдалитьФильтрНаСервере();
		
КонецПроцедуры

&НаСервере
Процедура КомандаУдалитьФильтрНаСервере()
		
	ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаСервере();                
	
	ЗаголовокЭлемента = СтрЗаменить(ТекущийЭлемент.Имя, "УдалитьФильтр" + ДанныеСписка.ИмяРеквизитаТаблицы, "");
	НачалоИмениЭлементов = "ПрограммноПользовательскиеНастройки";
	
	ПользовательскийОтбор = ЭтаФорма[ДанныеСписка.ИмяРеквизитаТаблицы].КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ЭтаФорма[ДанныеСписка.ИмяРеквизитаТаблицы].КомпоновщикНастроек.Настройки.Отбор.ИдентификаторПользовательскойНастройки);
	Для каждого Отбор ИЗ ПользовательскийОтбор.Элементы Цикл
		
		Если ТипЗнч(Отбор) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных")  Тогда
			
			Если Отбор.ПредставлениеПользовательскойНастройки = ЗаголовокЭлемента Тогда
			     ПользовательскийОтбор.Элементы.Удалить(Отбор);
   			КонецЕсли;
			
		Иначе
			Если Строка(Отбор.ЛевоеЗначение) = ЗаголовокЭлемента Тогда
				
				ПользовательскийОтбор.Элементы.Удалить(Отбор);
				Прервать;
				
			КонецЕсли;
		КонецЕсли;	
		
	КонецЦикла;
	
	// Проверяем относится ли элемент к периоду
	ЭлементПериод = Элементы.Найти(НачалоИмениЭлементов + "ПериодГлавный" + ДанныеСписка.Путь);
	Если НЕ ЭлементПериод = Неопределено Тогда
		Для Каждого Эл Из ЭлементПериод.ПодчиненныеЭлементы Цикл
			
			Если Найти(Эл.Имя, НачалоИмениЭлементов + "Группа" + ЗаголовокЭлемента + ДанныеСписка.Путь) > 0 Тогда
				Элементы.Удалить(Эл);
			КонецЕсли;
			
		КонецЦикла;	
	КонецЕсли;
	
	// Удаляем прочие
	Для Каждого Эл Из Элементы[НачалоИмениЭлементов + "ОтборыКолонка" + ДанныеСписка.Путь].ПодчиненныеЭлементы Цикл
		
		Если Найти(Эл.Имя, НачалоИмениЭлементов + "Группа" + ЗаголовокЭлемента + ДанныеСписка.Путь) > 0 Тогда
			Элементы.Удалить(Эл);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры


&НаКлиенте
Процедура КомандаФильтрыИМеню(Команда)
	
	Если Элементы.ГруппаДинамическийФильтр.Видимость = Истина Тогда
		Элементы.ГруппаДинамическийФильтр.Видимость = Ложь;
		Элементы.КомандаФильтрыИМеню.Картинка = БиблиотекаКартинок.ЭКОМ_МенюРаскрыть;
	Иначе
		Элементы.ГруппаДинамическийФильтр.Видимость = Истина;
		Элементы.КомандаФильтрыИМеню.Картинка = БиблиотекаКартинок.ЭКОМ_МенюСкрыть;
	КонецЕсли;
	
	ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();	

	// Сбрасываем выделенные строки, если их больше 200 штук.
	ВыделенныеСтроки = Элементы[ДанныеСписка.ИмяСписка].ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() > 200 Тогда
		ВыделенныеСтроки.Очистить();
		ВыделенныеСтроки.Добавить(Элементы[ДанныеСписка.ИмяСписка].ТекущаяСтрока);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ОпределитьТипОбъекта(Элемент, ИмяКолонки)

	ОбъектЭлемент = "";

	СокращенноеИмяКолонки      = СтрЗаменить(ИмяКолонки, Элемент.Имя, "");
	ЗначениеКолонки = Неопределено;
	Элемент.ТекущиеДанные.Свойство(СокращенноеИмяКолонки, ЗначениеКолонки);
	
		ТипЗначения = ТипЗнч(ЗначениеКолонки);
	Если НЕ (ТипЗначения = Тип("Строка") 
		ИЛИ ТипЗначения = Тип("Неопределено") 
		ИЛИ ТипЗначения = Тип("Число")
		ИЛИ ТипЗначения = Тип("Null") 
		ИЛИ ТипЗначения = Тип("Дата")  
		ИЛИ ТипЗначения = Тип("Булево")) Тогда
	        
		    ОбъектЭлемент = ЗначениеКолонки;
	
	КонецЕсли;

    Возврат ОбъектЭлемент;
	
КонецФункции 

&НаКлиенте
Процедура ОбновитьДинамическийСписок(ДанныеСписка, ОбновитьВыбранныеСтроки = Ложь, ВыбранныеСтроки = Неопределено, КлючЗаписиЦепочкиДокументов = Неопределено, ПозицияТекущейСтроки = Неопределено)
	
	Если ДанныеСписка.ИмяСтраницы = "ГруппаПрайсЛист" Тогда
		Попытка
			Если ДанныеСписка.ИмяСписка = "СписокДляПрайсЛистаИсходящий" Тогда
				НаправлениеОбмена = ПредопределенноеЗначение("Перечисление.ЭКОМ_НаправлениеОбмена.Исходящий");
				//Docrobot 2021.11.29 MOD-1340
				Если Элементы.Найти("СписокДляПрайсЛистаИсходящийКоманднаяПанельИсходящийPricat") <> Неопределено Тогда
					Элементы.СписокДляПрайсЛистаИсходящийКоманднаяПанельИсходящийPricat.РасширеннаяПодсказка.Заголовок = "Отправить";
				КонецЕсли;	
				Элементы.СписокДляПрайсЛистаИсходящийОбновитьАктивныйСписок.РасширеннаяПодсказка.Заголовок = "Обновить";
				Элементы.СписокДляПрайсЛистаИсходящийГруппаДокументы.Подсказка = "Документы";
			Иначе	 
				НаправлениеОбмена = ПредопределенноеЗначение("Перечисление.ЭКОМ_НаправлениеОбмена.Входящий");
				//Docrobot 2021.11.29 MOD-1340
				Если Элементы.Найти("СписокДляПрайсЛистаВходящийКоманднаяПанельВходящийPricat") <> Неопределено Тогда
					Элементы.СписокДляПрайсЛистаВходящийКоманднаяПанельВходящийPricat.РасширеннаяПодсказка.Заголовок = "Получить";
				КонецЕсли;
				Элементы.ОбновитьАктивныйСписокПрайсЛистВходящий.РасширеннаяПодсказка.Заголовок = "Обновить";
				Элементы.СписокДляПрайсЛистаВходящийГруппаДокументы.Подсказка = "Документы";
			КонецЕсли;
		Исключение
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Не удалось обновить кнопки Прайс листа, обновите роли в справочнике ЭКОМ_Роли";
			Сообщение.Сообщить();
		КонецПопытки;
		УстановитьПараметрДинамическогоСписка(ДанныеСписка.ИмяРеквизитаТаблицы, "НаправлениеОбмена", НаправлениеОбмена);
	КонецЕсли;
	
	Если ОбновитьВыбранныеСтроки И СписокВыбранныхСтрок.Количество() Тогда
		ОбновитьСписокВыбранныхСтрок(ДанныеСписка.ИмяСписка); 
	ИначеЕсли ВыбранныеСтроки <> Неопределено Тогда
		ОбновитьИдентификаторыВыделенныхСтрок(ВыбранныеСтроки, ДанныеСписка.ИмяСписка);
	КонецЕсли;
	
	Если КлючЗаписиЦепочкиДокументов <> Неопределено И (ДанныеСписка.ИмяСписка = "СписокДляПоставщика" ИЛИ ДанныеСписка.ИмяСписка = "СписокДляПокупателя") Тогда			
		КлючЗаписи = Новый Массив;
		КлючЗаписи.Добавить(Новый Структура("ИдентификаторВыделенныхСтрок, КлючЗаписиЦепочкиДокументов", КлючЗаписиЦепочкиДокументов, Истина));
		ОбновитьИдентификаторыВыделенныхСтрок(КлючЗаписи, ДанныеСписка.ИмяСписка);
		КлючЗаписиЦепочкиДокументов = КлючЗаписи;
	Иначе 
		КлючЗаписиЦепочкиДокументов = Неопределено;
	КонецЕсли;
	УстановитьПараметрДинамическогоСписка(ДанныеСписка.ИмяРеквизитаТаблицы, "масПомеченныхДоков", СписокВыбранныхСтрок.ВыгрузитьЗначения());
	Элементы[ДанныеСписка.ИмяСписка].Обновить();
	
	// Сортировка
	ОтобразитьСортировку(ДанныеСписка);
	

КонецПроцедуры

&НаКлиенте
Процедура ДеревоФильтровПриАктивизацииСтроки(Элемент)
	
	ЭтоКореньДерева = Ложь;

	ИдентификаторСтроки = Элементы.ДеревоФильтров.ТекущаяСтрока;
	Если НЕ ИдентификаторСтроки = Неопределено Тогда
		
		ТекущаяСтрока       = ДеревоФильтров.НайтиПоИдентификатору(ИдентификаторСтроки);	
		РодительСтроки      = ТекущаяСтрока.ПолучитьРодителя();
		Если РодительСтроки = Неопределено Тогда
			ЭтоКореньДерева = Истина;
		КонецЕсли;
		
		Если ТекущаяСтрока.ГруппаНастроек = "Организация"
			ИЛИ ТекущаяСтрока.ГруппаНастроек = "Контрагент" 
			ИЛИ ТекущаяСтрока.ГруппаНастроек = "ТочкаДоставки" Тогда
			Элементы.ОтборУдалить.Доступность = Ложь;
		Иначе
			Элементы.ОтборУдалить.Доступность = ЭтоКореньДерева;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьПериодФильтра(Элемент)
	
	ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();	
	ИмяЭлемента = "ЗначениеПериода" + ДанныеСписка.ИмяСписка;
	
	ИзменитьДатуНачалаОтбора    = Ложь;
	ИзменитьДатуОкончанияОтбора = Ложь;

	Если Элемент.Заголовок = "с" Тогда
	     ИзменитьДатуНачалаОтбора = Истина;
	Иначе
	     ИзменитьДатуОкончанияОтбора = Истина;
	КонецЕсли;	
	
	ПользовательскийОтбор = ЭтаФорма[ДанныеСписка.ИмяРеквизитаТаблицы].КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ЭтаФорма[ДанныеСписка.ИмяРеквизитаТаблицы].КомпоновщикНастроек.Настройки.Отбор.ИдентификаторПользовательскойНастройки);
	Для каждого Отбор ИЗ ПользовательскийОтбор.Элементы Цикл
		
		// Для периода 
		Если Найти(Отбор.Представление, "Программный отбор") > 0 Тогда					
			Если ТипЗнч(Отбор) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда					
				// Поиск именно для периода				
				Если Элемент.Имя = ИмяЭлемента + Отбор.ПредставлениеПользовательскойНастройки + Элемент.Заголовок Тогда
					Для каждого Эл Из Отбор.Элементы Цикл
						Если Эл.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно 
							И ИзменитьДатуНачалаОтбора = Истина Тогда
							
							Эл.ПравоеЗначение = НачалоДня(Эл.ПравоеЗначение);  
							
						ИначеЕсли Эл.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно 
							И ИзменитьДатуОкончанияОтбора = Истина Тогда
							
							Эл.ПравоеЗначение= КонецДня(Эл.ПравоеЗначение);					
							
						КонецЕсли;
					КонецЦикла;
					
					// Завершаем поиск
					Прервать;
					
				КонецЕсли;			
			КонецЕсли;		
		КонецЕсли;		
	КонецЦикла;	
	
	ОбновитьЦепочкуДокументовИКвитанцииНаКлиенте(ДанныеСписка.ИмяСписка);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПараметрДинамическогоСписка(ИмяРеквизитаТаблицы, ИмяПараметра, ЗначениеПараметра)
	
	ЕстьПараметр = ЭтаФорма[ИмяРеквизитаТаблицы].Параметры.Элементы.Найти(ИмяПараметра);	
	Если Не ЕстьПараметр = Неопределено Тогда
		ЭтаФорма[ИмяРеквизитаТаблицы].Параметры.УстановитьЗначениеПараметра(ИмяПараметра, ЗначениеПараметра);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьВсеПараметрыДинамическогоСписка(ИмяРеквизитаТаблицы)
	
    УстановитьПараметрДинамическогоСписка(ИмяРеквизитаТаблицы, "ДатаНач"  , Дата(2000, 01, 01));
    УстановитьПараметрДинамическогоСписка(ИмяРеквизитаТаблицы, "ДатаКон"  , Дата(2050, 01, 01));
    УстановитьПараметрДинамическогоСписка(ИмяРеквизитаТаблицы, "масПомеченныхДоков", СписокВыбранныхСтрок.ВыгрузитьЗначения());
	УстановитьПараметрДинамическогоСписка(ИмяРеквизитаТаблицы, "НаправлениеОбмена", ПредопределенноеЗначение("Перечисление.ЭКОМ_НаправлениеОбмена.ПустаяСсылка"));
	
КонецПроцедуры

// Процедура - Обновить активный список - аналог системной команды платформы для динамического списка чтобы обновлять подчиненные списки без смены текущей строки
//
// Параметры:
//  Команда  - Команда - любая команда
//
&НаКлиенте
Процедура ОбновитьАктивныйСписок(Команда = Неопределено)
    
	ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();
	ОбновитьЦепочкуДокументовИКвитанцииНаКлиенте(ДанныеСписка.ИмяСписка);
	ОбновитьДинамическийСписок(ДанныеСписка);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОтправитьФайлыНаСервереБезКонтекста(ОбработкаТип, МассивФайловВсего, ТипДокумента, МассивЛогаСобытий, ЭтоРегламентноеЗадание, ЭтоНовыеДокументы, СтруктураЛога)

	 Если НЕ ЗначениеЗаполнено(ОбработкаТип) Тогда
	     Возврат;     
	 КонецЕсли;
	 
	 ОбработкаОбъект = Новый (ЗначениеИзСтрокиВнутр(ОбработкаТип));
	 ОбработкаОбъект.ОтправитьФайлы(МассивФайловВсего, ТипДокумента, МассивЛогаСобытий, ЭтоРегламентноеЗадание, ЭтоНовыеДокументы, СтруктураЛога); 
	 
 КонецПроцедуры
 
&НаСервереБезКонтекста
Процедура ОтправитьФайлыНаСервереСПодписьюБезКонтекста(ОбработкаТип, МассивФайловВсего, ТипДокумента, МассивЛогаСобытий, ЭтоРегламентноеЗадание)

	 Если НЕ ЗначениеЗаполнено(ОбработкаТип) Тогда
	     Возврат;     
	 КонецЕсли;
	 
	 ОбработкаОбъект = Новый (ЗначениеИзСтрокиВнутр(ОбработкаТип));
	 ОбработкаОбъект.ОтправитьФайлыНаСервереСПодписью(МассивФайловВсего, ТипДокумента, МассивЛогаСобытий, ЭтоРегламентноеЗадание); 
	 
КонецПроцедуры

 &НаСервереБезКонтекста
Функция ПолучитьВсеФайлыНаСервереБезКонтекста(ОбработкаТип, МассивФайловСКлиента, ТипДокумента, ОбработатьФайлыНаКлиенте, МассивЛогаСобытий, ЭтоРегламентноеЗадание, СтруктураЛога)

	Если НЕ ЗначениеЗаполнено(ОбработкаТип) Тогда
		Возврат Неопределено;     
	КонецЕсли;
	 ОбработкаОбъект = Новый (ЗначениеИзСтрокиВнутр(ОбработкаТип));
	 МассивСтруктурыФайловСервера = ОбработкаОбъект.ПолучитьВсеФайлы(МассивФайловСКлиента, ТипДокумента, ОбработатьФайлыНаКлиенте, МассивЛогаСобытий, ЭтоРегламентноеЗадание, СтруктураЛога); 
	 Возврат МассивСтруктурыФайловСервера;

КонецФункции

&НаСервереБезКонтекста
Функция ОтправитьВсеФайлыНаСервереБезКонтекста(ОбработкаТип, МассивСтрок, ТипДокумента, МассивЛогаСобытий, ЭтоРегламентноеЗадание, НомерИсправления, ПодписатьФайл, ЭтоНовыеДокументы, СтруктураЛога)
	
	Если НЕ ЗначениеЗаполнено(ОбработкаТип) Тогда
		Возврат Неопределено;     
	КонецЕсли;
	ОбработкаОбъект = Новый (ЗначениеИзСтрокиВнутр(ОбработкаТип));
	МассивСтруктур  = ОбработкаОбъект.ОтправитьВсеФайлы(МассивСтрок, ТипДокумента, МассивЛогаСобытий, НомерИсправления, ЭтоРегламентноеЗадание, ПодписатьФайл, ЭтоНовыеДокументы, СтруктураЛога); 
	Возврат МассивСтруктур;
	 
КонецФункции 

&НаКлиенте
Процедура НачатьВыполнениеВФоне(ПараметрыЗапуска, ИмяМетодаВыполнения, ТекстСообщения) 

	ПараметрыЗапуска.Вставить("ИмяМетодаВыполнения", ИмяМетодаВыполнения);
		
	Если ЭтаФорма.ЭтоВнешняяОбработка 
		И НЕ ЗначениеЗаполнено(ОбъектСсылка) Тогда		
		ДанныеОбработки = Новый ДвоичныеДанные(ЭтаФорма.ИспользуемоеИмяФайла);
	Иначе
		ДанныеОбработки = Неопределено;
	КонецЕсли;

    СтруктураФоновогоЗадания = ВыполнитьФоновоеЗаданиеНаСервере(ЭтаФорма.ИспользуемоеИмяФайла, ДанныеОбработки, ЭтаФорма.ЭтоВнешняяОбработка, ЭтаФорма.ОбъектСсылка, ПараметрыЗапуска, УникальныйИдентификатор);
    
    ПараметрыОжидания = Вычислить("ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтаФорма)");
    ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	ПараметрыОжидания.ВыводитьСообщения          = Истина;
	ПараметрыОжидания.ВыводитьОкноОжидания       = Истина;
	ПараметрыОжидания.ТекстСообщения             = ТекстСообщения;
	
	Если ПараметрыЗапуска.Свойство("ИмяСобытия") Тогда
		ПараметрыОжидания.Вставить("ИмяСобытия", ПараметрыЗапуска.ИмяСобытия);
	КонецЕсли;
	
    // указываем интервал обновления состояния в секундах, если не указать, 
    // то интервал будет увеличиваться при каждой итерации в 1.4 раза.
    ПараметрыОжидания.Интервал = 3;
    
    Выполнить("ДлительныеОперацииКлиент.ОжидатьЗавершение(СтруктураФоновогоЗадания, Новый ОписаниеОповещения(""ФоновоеЗаданиеЗавершение"", ЭтаФорма), ПараметрыОжидания);");
        
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВыполнитьФоновоеЗаданиеНаСервере(ИспользуемоеИмяФайла, ДанныеОбработки, ЭтоВнешняяОбработка, ОбъектСсылка, ПараметрыЗапуска, УникальныйИдентификатор)

  	ВыполняемыйМетод = "ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки";	
  	
	ПараметрыЗадания = Новый Структура;
	ПараметрыЗадания.Вставить("БезопасныйРежим", Ложь);
	ПараметрыЗадания.Вставить("ЭтоВнешняяОбработка"          , ЭтоВнешняяОбработка);
    ПараметрыЗадания.Вставить("ДополнительнаяОбработкаСсылка", ОбъектСсылка);
    ПараметрыЗадания.Вставить("ИмяМетода"                    , "ВыполнитьКомандуВФоне");

	Если ЭтоВнешняяОбработка Тогда
		Если НЕ ЗначениеЗаполнено(ОбъектСсылка) Тогда
			ИмяОбработки = ПолучитьИмяВременногоФайла("epf");
			ДанныеОбработки.Записать(ИмяОбработки);
			ПараметрыЗапуска.Вставить("ФайлКУдалению", ИмяОбработки);
			ПараметрыЗадания.Вставить("ИмяОбработки", ИмяОбработки);
		КонецЕсли;
	Иначе
		ПараметрыЗадания.Вставить("ИмяОбработки", ИспользуемоеИмяФайла);
	КонецЕсли;
	ПараметрыЗадания.Вставить("ПараметрыВыполнения", ПараметрыЗапуска);
      
    ПараметрыВыполнения                             = Вычислить("ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор)");
    ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Фоновое задание длительной операции");
    ПараметрыВыполнения.ЗапуститьВФоне              = Истина;
    ПараметрыВыполнения.Вставить("ИдентификаторФормы", УникальныйИдентификатор); 
	
    СтруктураФоновогоЗадания = Вычислить("ДлительныеОперации.ВыполнитьВФоне(ВыполняемыйМетод, ПараметрыЗадания, ПараметрыВыполнения)");
    
    Возврат СтруктураФоновогоЗадания;
    
КонецФункции

&НаКлиенте
Процедура ФоновоеЗаданиеЗавершение(Результат, ДополнительныеПараметры) Экспорт
    
    Если Результат = Неопределено Тогда
        Возврат;
    ИначеЕсли Результат.Статус = "Ошибка" Тогда
        Выполнить("ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Результат.ПодробноеПредставлениеОшибки);");
    ИначеЕсли Результат.Статус = "Выполнено" Тогда
        // обрабатываем результат
        Данные = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
        Если ТипЗнч(Данные) = Тип("Структура") Тогда
			
			ТипДокумента          = Данные.СтруктураПараметров.ТипДокумента;
			НачалоВыполнения      = Данные.СтруктураПараметров.НачалоВыполнения;
			ДанныеСписка          = Данные.СтруктураПараметров.ДанныеСписка;
			МассивЛогаСобытий     = Данные.СтруктураПараметров.МассивЛогаСобытий;
			
			ПодписатьФайл = Ложь;
			Если Данные.СтруктураПараметров.Свойство("ПодписатьФайл") Тогда
			     ПодписатьФайл = Данные.СтруктураПараметров.ПодписатьФайл;		
			КонецЕсли;
													
			Если Данные.СтруктураПараметров.ИмяМетодаВыполнения = "ПолучитьВсеФайлы" Тогда
				
				 ОбщийПроцентПрогресса = Данные.СтруктураПараметров.ОбщийПроцентПрогресса;
				 МассивСтруктурыФайловСервера = Данные.МассивСтруктурыФайловСервера;
				 ЛокальныйКаталогINBOX = Данные.СтруктураПараметров.ЛокальныйКаталогINBOX;
				 СтруктураЛога = Данные.СтруктураПараметров.СтруктураЛога;
				 КлючЗаписиЦепочкиДокументов = Данные.СтруктураПараметров.КлючЗаписиЦепочкиДокументов;

				 ОбработатьПолучениеФайловНаКлиенте(МассивСтруктурыФайловСервера, ТипДокумента, ЛокальныйКаталогINBOX, НачалоВыполнения, МассивЛогаСобытий, ДанныеСписка, ОбщийПроцентПрогресса, СтруктураЛога, КлючЗаписиЦепочкиДокументов);

			 ИначеЕсли Данные.СтруктураПараметров.ИмяМетодаВыполнения = "ОтправитьВсеФайлы" Тогда	
				
				ОбщийПроцентПрогресса  = Данные.СтруктураПараметров.ОбщийПроцентПрогресса;
				МассивСтруктур         = Данные.МассивСтруктур;
				ВыделенныеСтроки       = Данные.СтруктураПараметров.ВыделенныеСтроки;
				ПозицияТекущейСтроки   = Данные.СтруктураПараметров.ПозицияТекущейСтроки;
				СтруктураЛога          = Данные.СтруктураПараметров.СтруктураЛога;
                ПодписатьФайл          = Данные.СтруктураПараметров.ПодписатьФайл;
				ЭтоРегламентноеЗадание = Данные.СтруктураПараметров.ЭтоРегламентноеЗадание;
				ЭтоНовыеДокументы      = Данные.СтруктураПараметров.ЭтоНовыеДокументы;
				КлючЗаписиЦепочкиДокументов = Данные.СтруктураПараметров.КлючЗаписиЦепочкиДокументов;
				
				ОбработатьОтправкуФайловНаКлиенте(МассивСтруктур, ТипДокумента, НачалоВыполнения, МассивЛогаСобытий, ДанныеСписка, ПозицияТекущейСтроки, ВыделенныеСтроки, ОбщийПроцентПрогресса, ПодписатьФайл, СтруктураЛога, ЭтоРегламентноеЗадание, ЭтоНовыеДокументы, КлючЗаписиЦепочкиДокументов);
				
			ИначеЕсли Данные.СтруктураПараметров.ИмяМетодаВыполнения = "ОтправитьФайлы" Тогда
				
				ВыделенныеСтроки      = Данные.СтруктураПараметров.ВыделенныеСтроки;
				ОбщийПроцентПрогресса = Данные.СтруктураПараметров.ОбщийПроцентПрогресса;
				ПозицияТекущейСтроки  = Данные.СтруктураПараметров.ПозицияТекущейСтроки;
				СтруктураЛога         = Данные.СтруктураПараметров.СтруктураЛога;
				КлючЗаписиЦепочкиДокументов = Данные.СтруктураПараметров.КлючЗаписиЦепочкиДокументов;

				ЗавершитьОтправкуНаКлиенте(ТипДокумента, НачалоВыполнения, МассивЛогаСобытий, ДанныеСписка, ПозицияТекущейСтроки, ВыделенныеСтроки, ОбщийПроцентПрогресса, СтруктураЛога, КлючЗаписиЦепочкиДокументов);
				
			ИначеЕсли Данные.СтруктураПараметров.ИмяМетодаВыполнения = "СоздатьДокументПоДинамическойКнопке" Тогда
				
				ВыбранныеСтроки      	= Данные.СтруктураПараметров.ВыбранныеСтроки;
				ПозицияТекущейСтроки 	= Данные.СтруктураПараметров.ПозицияТекущейСтроки; 
				ИмяСобытия				= Данные.СтруктураПараметров.ИмяСобытия;
				КлючЗаписиЦепочкиДокументов = Данные.СтруктураПараметров.КлючЗаписиЦепочкиДокументов;
											
				ЗавершитьСозданиеДокументов(ДанныеСписка, МассивЛогаСобытий, НачалоВыполнения, ПозицияТекущейСтроки, ВыбранныеСтроки, ИмяСобытия, КлючЗаписиЦепочкиДокументов);
				 
			КонецЕсли;
			
			Если Данные.СтруктураПараметров.Свойство("ФайлКУдалению") Тогда			
				УдалитьВременныйФайл(Данные.СтруктураПараметров.ФайлКУдалению);	
			КонецЕсли;
			
			//Docrobot 1.20.0 MOD-1431 [Закомментировал вывод времени выполнения(повтор), добавил вывод лога если он не пуст] 
			Если МассивЛогаСобытий.Количество() <> 0 Тогда
				 ОтобразитьЛогСобытий(МассивЛогаСобытий);
			КонецЕсли;
			//НачалоВыполнения = '0001-01-01';
			//Если Данные.СтруктураПараметров.Свойство("НачалоВыполнения", НачалоВыполнения)
			//	И ЗначениеЗаполнено(НачалоВыполнения)
			//	И Данные.СтруктураПараметров.Свойство("ИмяСобытия") Тогда			
			//	ТекстЛогаСобытий = "Время выполнения " + ЭКОМ_ОбщегоНазначенияКлиент.СекундыВоВремяНаКлиенте(ТекущаяДата() - НачалоВыполнения).Строка;
			//	ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Информация"), Данные.СтруктураПараметров.ИмяСобытия);
			//	МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
			//	ОтобразитьЛогСобытий(МассивЛогаСобытий);
			//КонецЕсли; 
			
        КонецЕсли;
        
    КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УдалитьВременныйФайл(ИмяФайла)
	Если ЗначениеЗаполнено(ИмяФайла) Тогда
		УдалитьФайлы(ИмяФайла);
	КонецЕсли;
КонецПроцедуры

Функция ВыполнитьТекстКодаВЭтомКонтекстеФормы(ТекстКода, ПереченьПеременныхВСтруктуреРезультата = "") Экспорт
    Перем Результат;
    
    Если ЗначениеЗаполнено(ПереченьПеременныхВСтруктуреРезультата) Тогда
        ТекстКодаПолученияПеременных = "Результат = Новый Структура(""" + ПереченьПеременныхВСтруктуреРезультата + """, " + ПереченьПеременныхВСтруктуреРезультата + ")";
    Иначе
        ТекстКодаПолученияПеременных = ""
    КонецЕсли;
    
    ТекстКода = ТекстКодаПолученияПеременных + Символы.ПС + ТекстКода;
    Выполнить(ТекстКода);
    
    Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ПометкиСписокДляCondraУстановитьВсе(Команда)
	УправлениеПометкамиДинамическогоСписка(Истина);
КонецПроцедуры

