&НаКлиенте
Функция ПолучитьИнформациюОЛокальныхКаталогах(ЛокальнаяРаботаСФайлами, ЛокальныйКаталогOUTBOX_Архив, ТипДокумента, РазделительПути, МассивЛогаСобытий)
	
	ДополнениеПути = ТипДокумента + РазделительПути + Формат(ТекущаяДата(), "ДФ=yyyyMMdd") + РазделительПути;

	Если НЕ ЗначениеЗаполнено(ЛокальныйКаталогOUTBOX_Архив)
		ИЛИ ЛокальныйКаталогOUTBOX_Архив = РазделительПути Тогда
		КаталогСохраненияФайл = Неопределено;
	Иначе	
		ПроверитьЛокальныйКаталог(ЛокальныйКаталогOUTBOX_Архив, РазделительПути);		
		КаталогСохранения = ЛокальныйКаталогOUTBOX_Архив + ДополнениеПути;		
		КаталогСохраненияФайл = ЭКОМ_СоздатьКаталогПроверитьНаЗаписьКлиент(КаталогСохранения, МассивЛогаСобытий);     			
	КонецЕсли;
	
	КаталогMarkingДоступен = Истина;        	
	Если ЭКОМ_ОбщегоНазначения.ИспользуетсяОтправкаВMarking() Тогда
		КаталогMarking = ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере("ЭКОМ_Локальный_Каталог_Marking", "", Неопределено, Истина);
		Если ЗначениеЗаполнено(КаталогMarking) Тогда
			ПроверитьЛокальныйКаталог(КаталогMarking, РазделительПути);
			КаталогMarkingДоступен = ЭКОМ_ОбщегоНазначения.ЭКОМ_СоздатьКаталогПроверитьНаЗапись(КаталогMarking, МассивЛогаСобытий);
		Иначе
			КаталогMarkingДоступен = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	КаталогOutboxДоступен = Истина;
	Если ЛокальнаяРаботаСФайлами Тогда
		КаталогOUTBOX = ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере("ЭКОМ_Локальный_Каталог_OUTBOX", "", Неопределено, Истина); 
		Если ЗначениеЗаполнено(КаталогOUTBOX) Тогда
			ПроверитьЛокальныйКаталог(КаталогOUTBOX, РазделительПути);
			КаталогOUTBOX = КаталогOUTBOX;
			КаталогOutboxДоступен = ЭКОМ_ОбщегоНазначенияКлиент.ЭКОМ_СоздатьКаталогПроверитьНаЗапись(КаталогOUTBOX, МассивЛогаСобытий);
			Если КаталогOutboxДоступен = Неопределено Тогда
				КаталогOutboxДоступен = Ложь;
			Иначе
				КаталогOutboxДоступен = Истина;
			КонецЕсли;
		Иначе
			КаталогOutboxДоступен = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("КаталогMarkingДоступен", КаталогMarkingДоступен);
	Результат.Вставить("КаталогOutboxДоступен" , КаталогOutboxДоступен);
	Результат.Вставить("КаталогMarking"		   , ?(КаталогMarkingДоступен, КаталогMarking, ""));
	Результат.Вставить("КаталогOUTBOX" 		   , ?(КаталогOutboxДоступен , КаталогOUTBOX , ""));
	Результат.Вставить("КаталогСохранения"     , КаталогСохранения);
	Результат.Вставить("КаталогСохраненияФайл" , КаталогСохраненияФайл);
	
	Возврат Результат;
КонецФункции


