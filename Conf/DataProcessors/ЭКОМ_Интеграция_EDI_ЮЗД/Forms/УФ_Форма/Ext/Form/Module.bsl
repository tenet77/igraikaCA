&НаСервере
Процедура СоздатьСоставПользовательскихНастроекНаСервере(ДанныеСписка)
	
	Если ЭтаФорма.НеобходимоУстановитьОбновление = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если ДанныеСписка.ИмяРеквизитаТаблицы = "СписокДляПрайсЛиста" Тогда
	   	Элементы[ДанныеСписка.ИмяФильтра].ИспользуемаяТаблица = Элементы[ДанныеСписка.ИмяСписка];
	КонецЕсли;
	
	НачалоИмениЭлементов = "ПрограммноПользовательскиеНастройки";
	//	Очищаем все созданные элементы с отборами, через удаление главной группы
	Для Каждого Эл Из Элементы[ДанныеСписка.ИмяФильтра].ПодчиненныеЭлементы Цикл
		
		Если Найти(Эл.Имя, НачалоИмениЭлементов) > 0 Тогда
		     Элементы.Удалить(Эл);
		КонецЕсли;
		
	КонецЦикла;
	
	ОбязательныеОтборы = Новый Массив;
	ОбязательныеОтборы.Добавить("Организация");
	ОбязательныеОтборы.Добавить("Контрагент");
	ОбязательныеОтборы.Добавить("ТочкаДоставки");
	ОбязательныеОтборы.Добавить("ДатаЗаказа");
	ОбязательныеОтборы.Добавить("ДатаЭТРН");
	ОбязательныеОтборы.Добавить("Дата");
    СоздатьПользовательскиеНастройки(ДанныеСписка, ОбязательныеОтборы);

	//Поиск элемента пользовательских настроек по уникальному идентификатору раздела настроек
	ИдентификаторПользовательскойНастройки = ЭтаФорма[ДанныеСписка.ИмяРеквизитаТаблицы].КомпоновщикНастроек.Настройки.Отбор.ИдентификаторПользовательскойНастройки;
	ПользовательскийОтбор = ЭтаФорма[ДанныеСписка.ИмяРеквизитаТаблицы].КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ИдентификаторПользовательскойНастройки);
	Если ПользовательскийОтбор = Неопределено Тогда
	     Возврат;
	КонецЕсли;
	 
	// Создаём главную группу
	ОтборыКолонка 		               = ЭтаФорма.Элементы.Добавить(НачалоИмениЭлементов + "ОтборыКолонка" + ДанныеСписка.Путь, Тип("ГруппаФормы"), Элементы[ДанныеСписка.ИмяФильтра]);
	ОтборыКолонка.Вид                  = ВидГруппыФормы.ОбычнаяГруппа;
	ОтборыКолонка.Группировка          = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ОтборыКолонка.ОтображатьЗаголовок  = Ложь;
	ОтборыКолонка.СквозноеВыравнивание = СквозноеВыравнивание.Использовать;
	
	// Создаём группу период
	ПолеГруппыОтбораПериодГлавный                      = ЭтаФорма.Элементы.Добавить(НачалоИмениЭлементов + "ПериодГлавный" + ДанныеСписка.Путь, Тип("ГруппаФормы"), ОтборыКолонка);
	ПолеГруппыОтбораПериодГлавный.Вид                  = ВидГруппыФормы.ОбычнаяГруппа;
	ПолеГруппыОтбораПериодГлавный.Группировка          = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ПолеГруппыОтбораПериодГлавный.ОтображатьЗаголовок  = Истина;
	ПолеГруппыОтбораПериодГлавный.СквозноеВыравнивание = СквозноеВыравнивание.Использовать;
    ПолеГруппыОтбораПериодГлавный.Заголовок            = "Период";
	ПолеГруппыОтбораПериодГлавный.ЗаголовокСвернутогоОтображения = "Период";
	ПолеГруппыОтбораПериодГлавный.Поведение                      = ПоведениеОбычнойГруппы.Свертываемая;
	ПолеГруппыОтбораПериодГлавный.Отображение                    = ОтображениеОбычнойГруппы.Нет;
	ПолеГруппыОтбораПериодГлавный.ОтображениеУправления          = ОтображениеУправленияОбычнойГруппы.Картинка;
	ПолеГруппыОтбораПериодГлавный.ЦветТекстаЗаголовка            = WebЦвета.СинеСерый;
	
	// Создаём группу расширенные настройки
	ПолеГруппыОтбораФильтрРасширенный                      = ЭтаФорма.Элементы.Добавить(НачалоИмениЭлементов + "ФильтрРасширенный" + ДанныеСписка.Путь, Тип("ГруппаФормы"), ОтборыКолонка);
	ПолеГруппыОтбораФильтрРасширенный.Вид                  = ВидГруппыФормы.ОбычнаяГруппа;
	ПолеГруппыОтбораФильтрРасширенный.Группировка          = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ПолеГруппыОтбораФильтрРасширенный.ОтображатьЗаголовок  = Истина;
	ПолеГруппыОтбораФильтрРасширенный.СквозноеВыравнивание = СквозноеВыравнивание.Использовать;
    ПолеГруппыОтбораФильтрРасширенный.Заголовок            = "Фильтр расширенный";
	ПолеГруппыОтбораФильтрРасширенный.ЗаголовокСвернутогоОтображения = "Фильтр расширенный";
	ПолеГруппыОтбораФильтрРасширенный.Поведение                      = ПоведениеОбычнойГруппы.Свертываемая;
	ПолеГруппыОтбораФильтрРасширенный.Отображение                    = ОтображениеОбычнойГруппы.Нет;
	ПолеГруппыОтбораФильтрРасширенный.ОтображениеУправления          = ОтображениеУправленияОбычнойГруппы.Картинка;
	
	// Сохраняем название форм в ТЗ
	
	//	Начинаем добавлять настройки на форму
	НомерЭлемента = 0;
	Для каждого ЭлОтбора из ПользовательскийОтбор.Элементы Цикл
		
		ПутьКДанным = ДанныеСписка.ИмяРеквизитаТаблицы + ".КомпоновщикНастроек.ПользовательскиеНастройки[0][" + НомерЭлемента + "]."; 
		ИмяЭлемента = НачалоИмениЭлементов + "КомпоновщикНастроекПользовательскиеНастройкиЭлемент" + ДанныеСписка.Путь + НомерЭлемента;
					
		Если ТипЗнч(ЭлОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			
			ИмяКнопки = "";
			Если Найти(ЭлОтбора.Представление, "Программный отбор") > 0 Тогда
				
				ИмяКнопки = ЭлОтбора.ПредставлениеПользовательскойНастройки;
				
				// Создаём подгруппу период
				ПолеГруппыОтбораПериод = ЭтаФорма.Элементы.Добавить(НачалоИмениЭлементов + "Группа" + ИмяКнопки + ДанныеСписка.Путь + НомерЭлемента, Тип("ГруппаФормы"), ПолеГруппыОтбораПериодГлавный);
				ПолеГруппыОтбораПериод.Вид                  = ВидГруппыФормы.ОбычнаяГруппа;
				ПолеГруппыОтбораПериод.Группировка          = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
				ПолеГруппыОтбораПериод.ОтображатьЗаголовок  = Ложь;
				ПолеГруппыОтбораПериод.СквозноеВыравнивание = СквозноеВыравнивание.Использовать;
				
				ПолеИспользование = ЭтаФорма.Элементы.Добавить(ИмяЭлемента + "Использование", Тип("ПолеФормы"), ПолеГруппыОтбораПериод);
				ПолеИспользование.Вид                = ВидПоляФормы.ПолеФлажка;
				ПолеИспользование.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Лево;
				ПолеИспользование.Заголовок          = ЭлОтбора.ПредставлениеПользовательскойНастройки;
				ПолеИспользование.ПутьКДанным        = ПутьКДанным + "Использование";
								
			Иначе	
				
				// Создаём группу 
				ПолеГруппыОтбораСУсловием = ЭтаФорма.Элементы.Добавить(НачалоИмениЭлементов + "Группа" + ИмяКнопки + ДанныеСписка.Путь + НомерЭлемента, Тип("ГруппаФормы"), ПолеГруппыОтбораФильтрРасширенный);
				ПолеГруппыОтбораСУсловием.Вид                  = ВидГруппыФормы.ОбычнаяГруппа;
				ПолеГруппыОтбораСУсловием.Группировка          = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
				ПолеГруппыОтбораСУсловием.ОтображатьЗаголовок  = Ложь;
				ПолеГруппыОтбораСУсловием.СквозноеВыравнивание = СквозноеВыравнивание.Использовать;
				ПолеГруппыОтбораСУсловием.Отображение          = ОтображениеОбычнойГруппы.Нет;
				
				ПолеИспользование = ЭтаФорма.Элементы.Добавить(ИмяЭлемента + "Использование", Тип("ПолеФормы"), ПолеГруппыОтбораСУсловием);
				ПолеИспользование.Вид                 = ВидПоляФормы.ПолеФлажка;
				ПолеИспользование.ПоложениеЗаголовка  = ПоложениеЗаголовкаЭлементаФормы.Лево;
				ПолеИспользование.Заголовок           = Строка(ЭлОтбора.ТипГруппы);
				ПолеИспользование.ПутьКДанным         = ПутьКДанным + "Использование";

			КонецЕсли;
			
		    НомерЭлементаГруппы = 0;
			Для каждого ЭлОтбораСписка Из ЭлОтбора.Элементы Цикл
				
				ЗаголовокЭлемента = Строка(ЭлОтбораСписка.ЛевоеЗначение);
				Если ЗначениеЗаполнено(ЭлОтбораСписка.ПредставлениеПользовательскойНастройки)  Тогда
					ЗаголовокЭлемента = ЭлОтбораСписка.ПредставлениеПользовательскойНастройки;
				КонецЕсли;

				ПутьКДанным = ДанныеСписка.ИмяРеквизитаТаблицы + ".КомпоновщикНастроек.ПользовательскиеНастройки[0]["+НомерЭлемента+"][" + НомерЭлементаГруппы +"]."; 
				ИмяЭлемента = НачалоИмениЭлементов + "КомпоновщикНастроекПользовательскиеНастройкиЭлемент" + ДанныеСписка.Путь + НомерЭлемента + НомерЭлементаГруппы;
				
				// Для периода
				Если Найти(ЭлОтбораСписка.Представление, "Программный отбор") > 0 Тогда
					
					ЗаголовокПолеЗначение = СокрЛП(СтрЗаменить(ЗаголовокЭлемента, СокрЛП(ЭлОтбораСписка.ЛевоеЗначение), ""));
					
					ПолеЗначение = ЭтаФорма.Элементы.Добавить("ЗначениеПериода" + ДанныеСписка.ИмяРеквизитаТаблицы + ИмяКнопки + ЗаголовокПолеЗначение, Тип("ПолеФормы"), ПолеГруппыОтбораПериод);
					ПолеЗначение.Вид                = ВидПоляФормы.ПолеВвода;
					ПолеЗначение.ВыбиратьТип        = Ложь;
					ПолеЗначение.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Лево;
					ПолеЗначение.Заголовок          = ЗаголовокПолеЗначение;
					ПолеЗначение.ПутьКДанным        = ПутьКДанным + "Значение";
					ПолеЗначение.РастягиватьПоГоризонтали = Ложь;
					ПолеЗначение.АвтоМаксимальнаяШирина   = Ложь;
					ПолеЗначение.КнопкаВыпадающегоСписка  = Ложь;
					ПолеЗначение.Ширина                   = 7;
					ПолеЗначение.ФорматРедактирования     = "ДФ=dd.MM.yy";
					ПолеЗначение.УстановитьДействие("ПриИзменении", "ИзменитьПериодФильтра");
					
				Иначе
					
					//	Создаём группу под каждую настройку
					ПолеГруппыОтбора = ЭтаФорма.Элементы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), ПолеГруппыОтбораСУсловием);
					ПолеГруппыОтбора.Вид = ВидГруппыФормы.ОбычнаяГруппа;
					ПолеГруппыОтбора.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
					ПолеГруппыОтбора.ОтображатьЗаголовок = Ложь;
					ПолеГруппыОтбора.СквозноеВыравнивание = СквозноеВыравнивание.Использовать;
					
					//	Создаём элементы с привязкой к настройкам компоновщика данных
					ПолеИспользование = ЭтаФорма.Элементы.Добавить(ИмяЭлемента + "Использование", Тип("ПолеФормы"), ПолеГруппыОтбора);
					ПолеИспользование.Вид                = ВидПоляФормы.ПолеФлажка;
					ПолеИспользование.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Лево;
					ПолеИспользование.Заголовок          = ЗаголовокЭлемента;
					ПолеИспользование.ПутьКДанным        = ПутьКДанным + "Использование";
					
					ПолеВидСравнения = ЭтаФорма.Элементы.Добавить(ИмяЭлемента + "ВидСравненияЭлементаОтбора", Тип("ПолеФормы"), ПолеГруппыОтбора);
					ПолеВидСравнения.Вид                      = ВидПоляФормы.ПолеВвода;
					ПолеВидСравнения.ПоложениеЗаголовка       = ПоложениеЗаголовкаЭлементаФормы.Нет;
					ПолеВидСравнения.РастягиватьПоГоризонтали = Ложь;
					ПолеВидСравнения.ПутьКДанным              = ПутьКДанным + "ВидСравнения";
					
					ПолеЗначение = ЭтаФорма.Элементы.Добавить(ИмяЭлемента + "Значение", Тип("ПолеФормы"), ПолеГруппыОтбора);
					ПолеЗначение.Вид                = ВидПоляФормы.ПолеВвода;
					ПолеЗначение.ВыбиратьТип        = Ложь;
					ПолеЗначение.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
					ПолеЗначение.ПутьКДанным        = ПутьКДанным + "Значение";
					
				КонецЕсли;
				
				НомерЭлементаГруппы = НомерЭлементаГруппы + 1;
	
			КонецЦикла;
			
			ИмяКнопки = СтрЗаменить(ИмяКнопки, " ", "_");
			
			// Для периода
			Если Найти(ЭлОтбора.Представление, "Программный отбор") > 0 Тогда
								
				// Создадим кнопку и привяжем к ней команду
				КнопкаЭлементПериод		     = ЭтаФорма.Элементы.Добавить("ВыбратьПериод" + ДанныеСписка.ИмяРеквизитаТаблицы + ИмяКнопки, Тип("КнопкаФормы"), ПолеГруппыОтбораПериод);
				КнопкаЭлементПериод.Заголовок	= "...";
				КнопкаЭлементПериод.ИмяКоманды  = "КомандаВыбратьПериод";
				КнопкаЭлементПериод.Картинка    = БиблиотекаКартинок.УстановитьИнтервал;
				КнопкаЭлементПериод.Отображение = ОтображениеКнопки.Картинка;
				КнопкаЭлементПериод.ВажностьПриОтображении = ВажностьПриОтображении.Высокая;
				КнопкаЭлементПериод.Ширина  = 3;


			КонецЕсли;
			
			Если НЕ Элементы.Найти("УдалитьФильтр" + ДанныеСписка.ИмяРеквизитаТаблицы + ИмяКнопки) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			// Кнопка удаления (кроме обязательных отборов)
			Если Найти(ЭлОтбора.Представление, "Программный отбор") > 0 
				И ОбязательныеОтборы.Найти(ИмяКнопки) = Неопределено Тогда
				
				// Создадим кнопку и привяжем к ней команду
				КнопкаЭлементУдалить		     = ЭтаФорма.Элементы.Добавить("УдалитьФильтр" + ДанныеСписка.ИмяРеквизитаТаблицы + ИмяКнопки, Тип("КнопкаФормы"), ПолеГруппыОтбораПериод);
				КнопкаЭлементУдалить.Заголовок	 = "Удалить";
				КнопкаЭлементУдалить.ИмяКоманды  = "КомандаУдалитьФильтр";
				КнопкаЭлементУдалить.Картинка     = БиблиотекаКартинок.ЭКОМ_ОчиститьЛогСобытий;
				КнопкаЭлементУдалить.Отображение  = ОтображениеКнопки.Картинка;
				КнопкаЭлементУдалить.ВажностьПриОтображении = ВажностьПриОтображении.Высокая;
				КнопкаЭлементУдалить.Ширина  = 3;
				
			ИначеЕсли Найти(ЭлОтбора.Представление, "Программный отбор") = 0 Тогда 
				
				// Создадим кнопку и привяжем к ней команду
				КнопкаЭлементУдалить		     = ЭтаФорма.Элементы.Добавить("УдалитьФильтр" + ДанныеСписка.ИмяРеквизитаТаблицы + ИмяКнопки, Тип("КнопкаФормы"), ПолеГруппыОтбораСУсловием);
				КнопкаЭлементУдалить.Заголовок	 = "Удалить";
				КнопкаЭлементУдалить.ИмяКоманды  = "КомандаУдалитьФильтр";
				КнопкаЭлементУдалить.Картинка     = БиблиотекаКартинок.ЭКОМ_ОчиститьЛогСобытий;
				КнопкаЭлементУдалить.Отображение  = ОтображениеКнопки.Картинка;
				КнопкаЭлементУдалить.ВажностьПриОтображении = ВажностьПриОтображении.Высокая;
				КнопкаЭлементУдалить.Ширина  = 3;
				
			КонецЕсли;			
						
		Иначе
			
			ЗаголовокЭлемента = Строка(ЭлОтбора.ЛевоеЗначение);
			Если ЗначениеЗаполнено(ЭлОтбора.ПредставлениеПользовательскойНастройки)  Тогда
				ЗаголовокЭлемента = ЭлОтбора.ПредставлениеПользовательскойНастройки;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ЭлОтбора.ПредставлениеПользовательскойНастройки) Тогда
							
				// Создаём группу 
				ПолеГруппыВертикальная = ЭтаФорма.Элементы.Добавить(НачалоИмениЭлементов + "Группа" + ЗаголовокЭлемента + ДанныеСписка.Путь + НомерЭлемента, Тип("ГруппаФормы"), ПолеГруппыОтбораФильтрРасширенный);
				ПолеГруппыВертикальная.Вид                  = ВидГруппыФормы.ОбычнаяГруппа;
				ПолеГруппыВертикальная.Группировка          = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
				ПолеГруппыВертикальная.ОтображатьЗаголовок  = Ложь;
				ПолеГруппыВертикальная.СквозноеВыравнивание = СквозноеВыравнивание.Использовать;
				ПолеГруппыВертикальная.Отображение          = ОтображениеОбычнойГруппы.Нет;
				
				//	Создаём элементы с привязкой к настройкам компоновщика данных
				
				//	Создаём группу под каждую настройку
				ПолеГруппыОтбора = ЭтаФорма.Элементы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), ПолеГруппыВертикальная);
				ПолеГруппыОтбора.Вид                  = ВидГруппыФормы.ОбычнаяГруппа;
				ПолеГруппыОтбора.Группировка          = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
				ПолеГруппыОтбора.ОтображатьЗаголовок  = Ложь;
				ПолеГруппыОтбора.СквозноеВыравнивание = СквозноеВыравнивание.Использовать;
				
				ПолеИспользование = ЭтаФорма.Элементы.Добавить(ИмяЭлемента + "Использование", Тип("ПолеФормы"), ПолеГруппыОтбора);
				ПолеИспользование.Вид                = ВидПоляФормы.ПолеФлажка;
				ПолеИспользование.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Лево;
				ПолеИспользование.Заголовок          = ЗаголовокЭлемента;
				ПолеИспользование.ПутьКДанным        = ПутьКДанным + "Использование";
				
				ПолеВидСравнения = ЭтаФорма.Элементы.Добавить(ИмяЭлемента + "ВидСравненияЭлементаОтбора", Тип("ПолеФормы"), ПолеГруппыОтбора);
				ПолеВидСравнения.Вид                      = ВидПоляФормы.ПолеВвода;
				ПолеВидСравнения.ПоложениеЗаголовка       = ПоложениеЗаголовкаЭлементаФормы.Нет;
				ПолеВидСравнения.РастягиватьПоГоризонтали = Ложь;
				ПолеВидСравнения.ПутьКДанным              = ПутьКДанным + "ВидСравнения";
				ПолеВидСравнения.Ширина                   = 7;
				ПолеВидСравнения.Доступность              = Ложь;
			
				ПолеЗначение = ЭтаФорма.Элементы.Добавить(ИмяЭлемента + "Значение", Тип("ПолеФормы"), ПолеГруппыОтбора);
				ПолеЗначение.Вид                = ВидПоляФормы.ПолеВвода;
				ПолеЗначение.ВыбиратьТип        = Ложь;
				ПолеЗначение.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
				ПолеЗначение.ПутьКДанным        = ПутьКДанным + "Значение";
				
				ЗаголовокЭлемента = СтрЗаменить(ЗаголовокЭлемента, " ", "_");
				
				Если Элементы.Найти("УдалитьФильтр" + ДанныеСписка.ИмяРеквизитаТаблицы + ЗаголовокЭлемента) = Неопределено Тогда
					// Кнопка удаления	
					// Создадим кнопку и привяжем к ней команду
					КнопкаЭлементУдалить		     = ЭтаФорма.Элементы.Добавить("УдалитьФильтр" + ДанныеСписка.ИмяРеквизитаТаблицы + ЗаголовокЭлемента, Тип("КнопкаФормы"), ПолеГруппыОтбора);
					КнопкаЭлементУдалить.Заголовок	 = "Удалить";
					КнопкаЭлементУдалить.ИмяКоманды  = "КомандаУдалитьФильтр";
					КнопкаЭлементУдалить.Картинка     = БиблиотекаКартинок.ЭКОМ_ОчиститьЛогСобытий;
					КнопкаЭлементУдалить.Отображение  = ОтображениеКнопки.Картинка;
					
				КонецЕсли;
				
			КонецЕсли;
								
		КонецЕсли;
		
		НомерЭлемента = НомерЭлемента + 1;
	
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьПользовательскиеНастройки(ДанныеСписка, МассивОтборов)
	
	ИдентификаторПользовательскойНастройки = ЭтаФорма[ДанныеСписка.ИмяРеквизитаТаблицы].КомпоновщикНастроек.Настройки.Отбор.ИдентификаторПользовательскойНастройки;
	ПользовательскийОтбор = ЭтаФорма[ДанныеСписка.ИмяРеквизитаТаблицы].КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ИдентификаторПользовательскойНастройки);
	
	Для каждого ИмяЭлементаОтбора Из МассивОтборов Цикл
		
		Если ПользовательскийОтбор = Неопределено Тогда
		     Продолжить;
		КонецЕсли;
		 
		ДоступныйЭлементОтбора = ПользовательскийОтбор.ДоступныеПоляОтбора.Элементы.Найти(ИмяЭлементаОтбора);
		Если ДоступныйЭлементОтбора = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		МассивТипов         = ДоступныйЭлементОтбора.ТипЗначения.Типы();
		
		// Исключаем Null и Неопределено 
		ОпределенныеТипы = Новый Структура;
		ОпределенныеТипы.Вставить("ЗначениеПоУмолчанию", Неопределено);
		Для каждого ЭлементМассива Из МассивТипов Цикл
			
			Если Тип("Null") = ЭлементМассива
				ИЛИ Тип("Неопределено") = ЭлементМассива Тогда
				Продолжить;
			КонецЕсли;	
			
			ОпределенныеТипы.Вставить("Тип", ЭлементМассива);
			
		КонецЦикла;
	
		Для каждого ЭлементСтруктуры Из ОпределенныеТипы Цикл
			
			Если Тип("Строка") = ЭлементСтруктуры.Значение  Тогда
				
				ОпределенныеТипы.Вставить("ЗначениеПоУмолчанию", "");
				ОпределенныеТипы.Вставить("ВидСравнения"       , ВидСравненияКомпоновкиДанных.Содержит);
							
			ИначеЕсли Тип("Число") = ЭлементСтруктуры.Значение  Тогда
				
				ОпределенныеТипы.Вставить("ЗначениеПоУмолчанию", 0);
				ОпределенныеТипы.Вставить("ВидСравнения"       , ВидСравненияКомпоновкиДанных.Равно);

			ИначеЕсли Тип("Дата") = ЭлементСтруктуры.Значение  Тогда
				
				ОпределенныеТипы.Вставить("ЗначениеПоУмолчанию", ТекущаяДата());		
				
			ИначеЕсли Тип("Булево") = ЭлементСтруктуры.Значение  Тогда
				
				ОпределенныеТипы.Вставить("ЗначениеПоУмолчанию", Истина);
				ОпределенныеТипы.Вставить("ВидСравнения"       , ВидСравненияКомпоновкиДанных.Равно);
				
			Иначе
				
				ОпределенныеТипы.Вставить("ЗначениеПоУмолчанию", Новый СписокЗначений);
			    ОпределенныеТипы.Вставить("ВидСравнения"       , ВидСравненияКомпоновкиДанных.ВСписке);

			КонецЕсли;	
			
		КонецЦикла;
		
		ПолеКомпоновки = ДоступныйЭлементОтбора.Поле;
		
		//Поиск уже созданного ранее элемента отбора	
		КоличествоФильтров = 0;
		Для каждого ЭлементОтбора Из ПользовательскийОтбор.Элементы Цикл
			Если ЭлементОтбора.ПредставлениеПользовательскойНастройки = ИмяЭлементаОтбора  
				И Найти(ЭлементОтбора.Представление, "Программный отбор") > 0  Тогда
				
				Если ИмяЭлементаОтбора = "Организация" 
					ИЛИ ИмяЭлементаОтбора = "Контрагент"  
					ИЛИ ИмяЭлементаОтбора = "ТочкаДоставки" Тогда
					
					Если НЕ ТипЗнч(ОпределенныеТипы.ЗначениеПоУмолчанию) = Тип("СписокЗначений") Тогда
						
						 ПользовательскийОтбор.Элементы.Удалить(ЭлементОтбора);
						 ОпределенныеТипы.Вставить("ЗначениеПоУмолчанию", Новый СписокЗначений);
						 ОпределенныеТипы.Вставить("ВидСравнения"       , ВидСравненияКомпоновкиДанных.ВСписке);

						 Прервать;
					КонецЕсли;
					
				КонецЕсли;
				
				КоличествоФильтров = КоличествоФильтров + 1;
				Прервать;
			Иначе
				
				// Проверка на тип 
				Если ИмяЭлементаОтбора = "Организация" 
					ИЛИ ИмяЭлементаОтбора = "Контрагент"  
					ИЛИ ИмяЭлементаОтбора = "ТочкаДоставки" Тогда
					
					Если НЕ ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных")
						 И СокрЛП(ЭлементОтбора.ЛевоеЗначение) = ИмяЭлементаОтбора
						 И ТипЗнч(ОпределенныеТипы.ЗначениеПоУмолчанию) = Тип("СписокЗначений") 
						 И ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Содержит Тогда
						 
						ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке;
						ЭлементОтбора.ПравоеЗначение = Новый СписокЗначений;
					
						Прервать;
					КонецЕсли;
					
				КонецЕсли;

			КонецЕсли;	
		КонецЦикла;
		
		//Создание нового элемента отбора в пользовательских настройках	
		Если КоличествоФильтров = 0 Тогда
			
			// Для даты создаем два отбора
			Если ТипЗнч(ОпределенныеТипы.ЗначениеПоУмолчанию) = Тип("Дата") Тогда
				
				ГруппаОтбора = ПользовательскийОтбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
				ГруппаОтбора.Использование = Истина;
				ГруппаОтбора.ТипГруппы     = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
				ГруппаОтбора.Представление = "Программный отбор [" + ИмяЭлементаОтбора + "]";
				ГруппаОтбора.ПредставлениеПользовательскойНастройки = ИмяЭлементаОтбора;
				
				ОсталосьСоздать = 2 - КоличествоФильтров; 
				Для Н = 1 По ОсталосьСоздать Цикл
					//Создание нового элемента отбора в пользовательских настройках	
					Отбор = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
					Отбор.ЛевоеЗначение    = ПолеКомпоновки;
					Отбор.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ;
					Отбор.Использование    = Истина;
					Если Н = 1 Тогда
						Отбор.ВидСравнения   = ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
						Отбор.ПравоеЗначение = НачалоДня(ОпределенныеТипы.ЗначениеПоУмолчанию - 7*24*60*60);
						Отбор.ПредставлениеПользовательскойНастройки  = ИмяЭлементаОтбора + " с ";
					Иначе
						Отбор.ВидСравнения   = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно;
						Отбор.ПравоеЗначение = КонецДня(ОпределенныеТипы.ЗначениеПоУмолчанию);
						Отбор.ПредставлениеПользовательскойНастройки  = ИмяЭлементаОтбора + " по ";
					КонецЕсли;
					Отбор.Представление = "Программный отбор [" + Отбор.ПредставлениеПользовательскойНастройки + "]";

					//Для вывода отбора в быстром доступе необходимо обязательно назначить идентификатор пользовательской настройки
					Отбор.ИдентификаторПользовательскойНастройки = Новый УникальныйИдентификатор;		
				КонецЦикла;	
			Иначе
				
				Отбор = ПользовательскийОтбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				Отбор.ЛевоеЗначение    = ПолеКомпоновки;
				Отбор.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ;
				Отбор.Использование    = Ложь;
				Отбор.ВидСравнения     = ОпределенныеТипы.ВидСравнения;
				Отбор.ПравоеЗначение   = ОпределенныеТипы.ЗначениеПоУмолчанию;
				Отбор.ПредставлениеПользовательскойНастройки = ИмяЭлементаОтбора;
				Отбор.Представление = "Программный отбор [" + ИмяЭлементаОтбора + "]";
				
				//Для вывода отбора в быстром доступе необходимо обязательно назначить идентификатор пользовательской настройки
				Отбор.ИдентификаторПользовательскойНастройки = Новый УникальныйИдентификатор;	
			КонецЕсли;
			
		КонецЕсли;	
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьДеревоПользовательскихНастроекНаСервере(ДанныеСписка, МассивНовыхОтборов)
	
	Если ЭтаФорма.НеобходимоУстановитьОбновление = Истина Тогда
		Возврат;
	КонецЕсли;

	//Поиск элемента пользовательских настроек по уникальному идентификатору раздела настроек
	ИдентификаторПользовательскойНастройки = ЭтаФорма[ДанныеСписка.ИмяРеквизитаТаблицы].КомпоновщикНастроек.Настройки.Отбор.ИдентификаторПользовательскойНастройки;
	ПользовательскийОтбор = ЭтаФорма[ДанныеСписка.ИмяРеквизитаТаблицы].КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ИдентификаторПользовательскойНастройки);
	Если ПользовательскийОтбор = Неопределено Тогда
	     Возврат;
	КонецЕсли;	
	 
	// Получим все существующие элементы в корневом отборе
	СуществующиеОтборы = Новый Соответствие;
	СтрокиКорневые     = ЭтаФорма.ДеревоФильтров.ПолучитьЭлементы();
	Для каждого Эл Из СтрокиКорневые Цикл
		СуществующиеОтборы.Вставить(Эл.Значение, Эл.Значение);
	КонецЦикла;
	
	Для каждого ЭлементОтбора Из ПользовательскийОтбор.Элементы Цикл
		
		ЭтоНовыйОтбор = Ложь;
		
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;	
		
		Если Найти(ЭлементОтбора.Представление, "Программный отбор") > 0  Тогда
			
			Если СуществующиеОтборы.Получить(ЭлементОтбора.ПредставлениеПользовательскойНастройки) = Неопределено Тогда
				
				ДоступныйЭлементОтбора = ПользовательскийОтбор.ДоступныеПоляОтбора.Элементы.Найти(ЭлементОтбора.ПредставлениеПользовательскойНастройки);
				Если ДоступныйЭлементОтбора = Неопределено Тогда
					Продолжить;;
				КонецЕсли;
				
				МассивТипов = ДоступныйЭлементОтбора.ТипЗначения.Типы();
				
				// Исключаем Null и Неопределено 
				ОпределенныеТипы = Новый Структура;
				Для каждого ЭлементМассива Из МассивТипов Цикл
					
					Если Тип("Null") = ЭлементМассива
						ИЛИ Тип("Неопределено") = ЭлементМассива Тогда
						Продолжить;
					КонецЕсли;	
					
					ОпределенныеТипы.Вставить("Тип", ЭлементМассива);
					
				КонецЦикла;
				
				ИмяСравнения = СокрЛП(ЭлементОтбора.ВидСравнения);		
				ИмяСравнения = НРег(ИмяСравнения);
				
				Попытка
					ОтрицаниеЗначение = БиблиотекаКартинок.ЭКОМ_ВосклицательныйЗнакВыключенСерый;
					Если Найти(ИмяСравнения, "не") = 1 Тогда
					     ОтрицаниеЗначение = БиблиотекаКартинок.ЭКОМ_ВосклицателыныйЗнак;
					КонецЕсли;
				Исключение
					ОтрицаниеЗначение = Неопределено;
				КонецПопытки;
			
				Данные = Новый Структура;
				Данные.Вставить("Иконка"              , "");
				Данные.Вставить("РодительИзменить"    , "");
				Данные.Вставить("ЗначениеВидСравнения", "");
				Данные.Вставить("ТипЗначения"         , "");
				Данные.Вставить("ОтрицаниеЗначение"   , ОтрицаниеЗначение);
				Данные.Вставить("ЗначениеПоУмолчанию" , Неопределено);
				
				Для каждого ЭлементСтруктуры Из ОпределенныеТипы Цикл
					
					Если Тип("Строка") = ЭлементСтруктуры.Значение  Тогда
						
						Данные.Вставить("Иконка"              , БиблиотекаКартинок.Задача);
						Данные.Вставить("РодительИзменить"    , БиблиотекаКартинок.ЭКОМ_ДобавитьНовуюСтроку);
						Данные.Вставить("ЗначениеВидСравнения", ЭлементОтбора.ВидСравнения);
						Данные.Вставить("ТипЗначения"         , "Строка");
						Данные.Вставить("ЗначениеПоУмолчанию" , "");

					ИначеЕсли Тип("Число") = ЭлементСтруктуры.Значение  Тогда
						
						Данные.Вставить("Иконка"             , БиблиотекаКартинок.Калькулятор);
						Данные.Вставить("РодительИзменить"    , БиблиотекаКартинок.ЭКОМ_ДобавитьНовуюСтроку);
						Данные.Вставить("ЗначениеВидСравнения", ЭлементОтбора.ВидСравнения);
						Данные.Вставить("ТипЗначения"         , "Число");
						Данные.Вставить("ЗначениеПоУмолчанию" , 0);

					ИначеЕсли Тип("Дата") = ЭлементСтруктуры.Значение  Тогда
											
						Данные.Вставить("Иконка"             , БиблиотекаКартинок.Календарь);
						Данные.Вставить("РодительИзменить"    , БиблиотекаКартинок.ЭКОМ_ДобавитьНовуюСтроку);
						Данные.Вставить("ЗначениеВидСравнения", ЭлементОтбора.ВидСравнения);
						Данные.Вставить("ТипЗначения"         , "Дата");
			            Данные.Вставить("ЗначениеПоУмолчанию" , Дата(0001, 01, 01));

					ИначеЕсли Тип("Булево") = ЭлементСтруктуры.Значение  Тогда
						
						Данные.Вставить("Иконка"              , БиблиотекаКартинок.ЗаписатьИЗакрыть);
						Данные.Вставить("РодительИзменить"    , "");
						Данные.Вставить("ЗначениеВидСравнения", "");
						Данные.Вставить("ТипЗначения"         , "Булево");
						Данные.Вставить("ЗначениеПоУмолчанию" , Ложь);

					Иначе
						
						ТипЗначения = "";
						ОбъектМетаданных = Метаданные.НайтиПоТипу(ЭлементСтруктуры.Значение);
						Если НЕ ОбъектМетаданных = Неопределено Тогда
							ТипЗначения = ОбъектМетаданных.ПолноеИмя();
						КонецЕсли;
						
						Если Найти(ТипЗначения, "Документ") = 1  Тогда
							
							 ИмяОбъекта = СтрЗаменить(ТипЗначения, "Документ.", "");
						     Данные.Вставить("Иконка"              , БиблиотекаКартинок.Документ);
							 Данные.Вставить("ЗначениеПоУмолчанию" , Документы[ИмяОбъекта].ПустаяСсылка());
							 
						ИначеЕсли Найти(ТипЗначения, "Перечисление") = 1  Тогда
							 
							 ИмяОбъекта = СтрЗаменить(ТипЗначения, "Перечисление.", "");
                           	 Данные.Вставить("Иконка"              , БиблиотекаКартинок.Перечисление);
							 Данные.Вставить("ЗначениеПоУмолчанию" , Перечисления[ИмяОбъекта].ПустаяСсылка());
							 
						ИначеЕсли Найти(ТипЗначения, "Справочник") = 1  Тогда
						
							 ИмяОбъекта = СтрЗаменить(ТипЗначения, "Справочник.", "");
							 Данные.Вставить("Иконка"              , БиблиотекаКартинок.Справочник);
							 Данные.Вставить("ЗначениеПоУмолчанию" , Справочники[ИмяОбъекта].ПустаяСсылка());
							 
						КонецЕсли;
						
						Данные.Вставить("РодительИзменить"    , БиблиотекаКартинок.ЭКОМ_ДобавитьНовуюСтроку);
						Данные.Вставить("ЗначениеВидСравнения", ЭлементОтбора.ВидСравнения);
						Данные.Вставить("ТипЗначения"         , ТипЗначения);
											
					КонецЕсли;	
					
				КонецЦикла;
				
				Если ЭлементОтбора.ПредставлениеПользовательскойНастройки = "Организация" 
					ИЛИ ЭлементОтбора.ПредставлениеПользовательскойНастройки = "Контрагент"  
					ИЛИ ЭлементОтбора.ПредставлениеПользовательскойНастройки = "ТочкаДоставки" Тогда
					
					Если НЕ (Данные.ТипЗначения = "Строка" 
						 ИЛИ Данные.ТипЗначения = "") Тогда
						
						Если НЕ МассивНовыхОтборов.Найти(ЭлементОтбора.ПредставлениеПользовательскойНастройки) = Неопределено Тогда
							ЭлементОтбора.Использование = Истина;
							ЭтоНовыйОтбор               = Истина;
						КонецЕсли;
						ДобавитьОтборДеревоФильтров(ЭлементОтбора, Данные, ЭтоНовыйОтбор);
						
					КонецЕсли;
				Иначе
					
					Если НЕ МассивНовыхОтборов.Найти(ЭлементОтбора.ПредставлениеПользовательскойНастройки) = Неопределено Тогда
						ЭлементОтбора.Использование = Истина;
						ЭтоНовыйОтбор               = Истина;
					КонецЕсли;
					ДобавитьОтборДеревоФильтров(ЭлементОтбора, Данные, ЭтоНовыйОтбор);
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
				
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ДобавитьОтборДеревоФильтров(ЭлементОтбора, Данные, ЭтоНовыйОтбор)
		
	// Родитель
	НоваяСтрокаДерева = ЭтаФорма.ДеревоФильтров.ПолучитьЭлементы().Добавить();
	НоваяСтрокаДерева.Значение          = ЭлементОтбора.ПредставлениеПользовательскойНастройки;
	НоваяСтрокаДерева.Представление     = ЭлементОтбора.ПредставлениеПользовательскойНастройки;
	НоваяСтрокаДерева.Пометка           = ЭлементОтбора.Использование;
	НоваяСтрокаДерева.Иконка            = Данные.Иконка;
	НоваяСтрокаДерева.Изменить          = Данные.РодительИзменить;
	НоваяСтрокаДерева.ГруппаНастроек    = ЭлементОтбора.ПредставлениеПользовательскойНастройки;
	НоваяСтрокаДерева.ВидСравнения      = Данные.ЗначениеВидСравнения;
	НоваяСтрокаДерева.ТипЗначения       = Данные.ТипЗначения;
	НоваяСтрокаДерева.ОтрицаниеЗначение = Данные.ОтрицаниеЗначение;
	
	Подстрока = Неопределено;
	
	// Потомки
	Если ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке Тогда
		Для каждого Эл Из ЭлементОтбора.ПравоеЗначение Цикл	
			Если ЗначениеЗаполнено(Эл.Значение) Тогда
				Подстрока = НоваяСтрокаДерева.ПолучитьЭлементы().Добавить(); 
				Подстрока.Значение    = Эл.Значение; 
				Подстрока.Пометка     = Истина;
				Подстрока.Изменить    = БиблиотекаКартинок.ЭКОМ_ОчиститьЛогСобытий;
				Подстрока.Иконка      = Данные.Иконка;
				Подстрока.ТипЗначения = Данные.ТипЗначения;
			КонецЕсли;				
		КонецЦикла;
		Если ЭтоНовыйОтбор Тогда
			Подстрока = НоваяСтрокаДерева.ПолучитьЭлементы().Добавить(); 
			Подстрока.Значение    = Данные.ЗначениеПоУмолчанию; 
			Подстрока.Пометка     = Истина;
			Подстрока.Изменить    = БиблиотекаКартинок.ЭКОМ_ОчиститьЛогСобытий;
			Подстрока.Иконка      = Данные.Иконка;
			Подстрока.ТипЗначения = Данные.ТипЗначения;	
		КонецЕсли;
					
	// Для строки и числа
	ИначеЕсли НЕ Данные.ТипЗначения = "Булево" Тогда
		Подстрока = НоваяСтрокаДерева.ПолучитьЭлементы().Добавить(); 
		Подстрока.Значение    = ЭлементОтбора.ПравоеЗначение; 
		Подстрока.Пометка     = Истина;
		Подстрока.Изменить    = БиблиотекаКартинок.ЭКОМ_ОчиститьЛогСобытий;
		Подстрока.Иконка      = Данные.Иконка;
		Подстрока.ТипЗначения = Данные.ТипЗначения;
	КонецЕсли;
	
	// Текущая строка
	Если НЕ Подстрока = Неопределено Тогда
	     Элементы.ДеревоФильтров.ТекущаяСтрока = Подстрока.ПолучитьИдентификатор();
	Иначе
		 Элементы.ДеревоФильтров.ТекущаяСтрока = НоваяСтрокаДерева.ПолучитьИдентификатор(); 
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьПоТекущейСтранице(ИмяРеквизитаТаблицы)
	
	Элементы.ГруппаДинамическийФильтрСеть.Видимость      	= Ложь;
	Элементы.ГруппаДинамическийФильтрЭТРН.Видимость      	= Ложь;
	Элементы.ГруппаДинамическийФильтрПоставщик.Видимость 	= Ложь;
	Элементы.ГруппаДинамическийФильтрCondra.Видимость 		= Ложь;
	Элементы.ГруппаДинамическийФильтрПрайсЛист.Видимость    = Ложь;
	
	Элементы.СписокДляПокупателяНастройкаСписка.Видимость 	= Ложь;
	Элементы.СписокДляЭТРННастройкаСписка.Видимость       	= Ложь;
	Элементы.СписокДляПоставщикаНастройкаСписка.Видимость 	= Ложь;
	Элементы.СписокДляCondraНастройкаСписка.Видимость		= Ложь;
	Элементы.СписокДляПрайсЛистаНастройкаСписка.Видимость	= Ложь;
    Элементы.НомерИсправления.Видимость                     = Ложь;
	Элементы.ТаблицаПалет.Видимость                         = Ложь;
	
	Элементы.СписокДляПокупателяКомпоновщикНастроекПользовательскиеНастройкиПорядок.Видимость = Ложь;
	Элементы.СписокДляCondraКомпоновщикНастроекПользовательскиеНастройкиПорядок.Видимость = Ложь;
	Элементы.СписокДляПоставщикаКомпоновщикНастроекПользовательскиеНастройкиПорядок.Видимость = Ложь;
	Элементы.СписокДляПрайсЛистаКомпоновщикНастроекПользовательскиеНастройкиПорядок.Видимость = Ложь;
	Элементы.СписокДляЭТРНКомпоновщикНастроекПользовательскиеНастройкиПорядок.Видимость = Ложь;
	
	Элементы.СписокДляПокупателяКомпоновщикНастроекПользовательскиеНастройки.Видимость = Ложь;
	Элементы.СписокДляCondraКомпоновщикНастроекПользовательскиеНастройки.Видимость = Ложь;
	Элементы.СписокДляПоставщикаКомпоновщикНастроекПользовательскиеНастройки.Видимость = Ложь;
	Элементы.СписокДляПрайсЛистаКомпоновщикНастроекПользовательскиеНастройки.Видимость = Ложь;
	Элементы.СписокДляЭТРНКомпоновщикНастроекПользовательскиеНастройки.Видимость = Ложь;
	
	Элементы.КомандаОтчетПоДокументуЭКОМ.Видимость = Ложь;
	Элементы.СписокДляПоставщикаКомандаОтчетПоЗагруженнымЗаказам.Видимость = Ложь;
	
	Если ИмяРеквизитаТаблицы = "СписокДляПоставщика" Тогда
		Элементы.КомандаОтчетПоДокументуЭКОМ.Видимость 			= Истина;
		Элементы.ГруппаДинамическийФильтрПоставщик.Видимость	= Истина;
		Элементы.СписокДляПоставщикаНастройкаСписка.Видимость 	= Истина;
		Элементы.НомерИсправления.Видимость                     = Истина;
		Элементы.СписокДляПоставщикаКомпоновщикНастроекПользовательскиеНастройки.Видимость = Истина;
		Элементы.СписокДляПоставщикаКомпоновщикНастроекПользовательскиеНастройкиПорядок.Видимость = Истина;
        	
	ИначеЕсли ИмяРеквизитаТаблицы = "СписокДляПокупателя" Тогда
		Элементы.СписокДляПоставщикаКомандаОтчетПоЗагруженнымЗаказам.Видимость 	= Истина;
		Элементы.ГруппаДинамическийФильтрСеть.Видимость      					= Истина;
		Элементы.СписокДляПокупателяНастройкаСписка.Видимость 					= Истина;
		Элементы.СписокДляПокупателяКомпоновщикНастроекПользовательскиеНастройки.Видимость = Истина;
        Элементы.СписокДляПокупателяКомпоновщикНастроекПользовательскиеНастройкиПорядок.Видимость = Истина;
		
    ИначеЕсли ИмяРеквизитаТаблицы = "СписокДляЭТРН" Тогда			
		Элементы.ГруппаДинамическийФильтрЭТРН.Видимость      	= Истина;			
		Элементы.СписокДляЭТРННастройкаСписка.Видимость       	= Истина;
		Элементы.СписокДляЭТРНКомпоновщикНастроекПользовательскиеНастройки.Видимость = Истина;
		Элементы.СписокДляЭТРНКомпоновщикНастроекПользовательскиеНастройкиПорядок.Видимость = Истина;
		
	ИначеЕсли ИмяРеквизитаТаблицы = "СписокДляCondra" Тогда			
		Элементы.ГруппаДинамическийФильтрCondra.Видимость 		= Истина;		
		Элементы.СписокДляCondraНастройкаСписка.Видимость		= Истина;
		Элементы.СписокДляCondraКомпоновщикНастроекПользовательскиеНастройки.Видимость = Истина;
		Элементы.СписокДляCondraКомпоновщикНастроекПользовательскиеНастройкиПорядок.Видимость = Истина;
			
	ИначеЕсли ИмяРеквизитаТаблицы = "СписокДляПрайсЛиста" Тогда		
		Элементы.ГруппаДинамическийФильтрПрайсЛист.Видимость    = Истина;
		Элементы.СписокДляПрайсЛистаНастройкаСписка.Видимость   = Истина;		
		Элементы.СписокДляПрайсЛистаКомпоновщикНастроекПользовательскиеНастройки.Видимость = Истина;
        Элементы.СписокДляПрайсЛистаКомпоновщикНастроекПользовательскиеНастройкиПорядок.Видимость = Истина;
	КонецЕсли;   
	
	
	Элементы.КомандаПечатьЮЗД.Доступность = ИмяРеквизитаТаблицы = "СписокДляПокупателя" ИЛИ ИмяРеквизитаТаблицы = "СписокДляПоставщика";
	Элементы.КнопкаПолучитьВсеДокументыЮЗДЦепочки.Доступность = ИмяРеквизитаТаблицы = "СписокДляПокупателя" ИЛИ ИмяРеквизитаТаблицы = "СписокДляПоставщика";
	

       
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериод(Команда)	
	
	ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();	
	ТипКнопки = "";
	
	ДатаНачалаОтбора    = ТекущаяДата();
	ДатаОкончанияОтбора = ТекущаяДата();

	ПользовательскийОтбор = ЭтаФорма[ДанныеСписка.ИмяРеквизитаТаблицы].КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ЭтаФорма[ДанныеСписка.ИмяРеквизитаТаблицы].КомпоновщикНастроек.Настройки.Отбор.ИдентификаторПользовательскойНастройки);
	Для каждого Отбор ИЗ ПользовательскийОтбор.Элементы Цикл
		
		// Для периода 
		Если Найти(Отбор.Представление, "Программный отбор") > 0 Тогда
			
			Если ТипЗнч(Отбор) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
				
				// Поиск именно для периода
				Если ТекущийЭлемент.Имя = "ВыбратьПериод" + ДанныеСписка.ИмяРеквизитаТаблицы + Отбор.ПредставлениеПользовательскойНастройки Тогда
					
					ТипКнопки = Отбор.ПредставлениеПользовательскойНастройки;
 
					Для каждого Эл Из Отбор.Элементы Цикл
						
						Если Эл.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно Тогда
							ДатаНачалаОтбора = Эл.ПравоеЗначение; 
						ИначеЕсли Эл.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно Тогда
							ДатаОкончанияОтбора = Эл.ПравоеЗначение;
						КонецЕсли;
						
					КонецЦикла;	
					
				КонецЕсли;	
			КонецЕсли;			
		КонецЕсли;	
	КонецЦикла;

	Диалог = Новый ДиалогРедактированияСтандартногоПериода();                                 
    Диалог.Период = Новый СтандартныйПериод(ДатаНачалаОтбора, ДатаОкончанияОтбора);
	
	Данные = Новый Структура;
	Данные.Вставить("Диалог"                         , Диалог);
	Данные.Вставить("ЭлементыПользовательскогоОтбора", ПользовательскийОтбор.Элементы);
	Данные.Вставить("ТипКнопки"                      , ТипКнопки);
	
    ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("УстановитьПериодЗавершение", ЭтаФорма, Данные);
    Диалог.Показать(ОписаниеОповещенияОЗакрытии); 	
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериодЗавершение(Период, ДополнительныеПараметры) Экспорт	
	
	Если НЕ Период = Неопределено Тогда		
		Диалог = ДополнительныеПараметры.Диалог; 
		Для каждого Отбор ИЗ ДополнительныеПараметры.ЭлементыПользовательскогоОтбора Цикл
			
			// Для периода 
			Если Найти(Отбор.Представление, "Программный отбор") > 0 Тогда			
				
				Если ТипЗнч(Отбор) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда		
					
					// Поиск именно для периода
					Если ДополнительныеПараметры.ТипКнопки = Отбор.ПредставлениеПользовательскойНастройки Тогда
						Для каждого Эл Из Отбор.Элементы Цикл
							Если Эл.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно Тогда
								Эл.ПравоеЗначение = НачалоДня(Диалог.Период.ДатаНачала);  
							ИначеЕсли Эл.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно Тогда
								Эл.ПравоеЗначение= КонецДня(Диалог.Период.ДатаОкончания);					
							КонецЕсли;
						КонецЦикла;
						
						// Завершаем поиск
						Прервать;

					КонецЕсли;		
					
				КонецЕсли;
				
			КонецЕсли;	
			
		КонецЦикла;	
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьСписокОрганизаций()
	
	ОбъектЭтаОбработка    = РеквизитФормыВЗначение("Объект");
    Возврат ОбъектЭтаОбработка.ПолучитьСписокОрганизацийGLN();

КонецФункции 

&НаСервере
Функция ПолучитьСписокКонтрагентов()
	
	ОбъектЭтаОбработка    = РеквизитФормыВЗначение("Объект");
    Возврат ОбъектЭтаОбработка.ПолучитьСписокКонтрагентовGLN()

КонецФункции

&НаСервере
Функция ПолучитьСписокТочекДоставки()
	
	ОбъектЭтаОбработка    = РеквизитФормыВЗначение("Объект");
    Возврат ОбъектЭтаОбработка.ПолучитьСписокТочекДоставкиGLN();

КонецФункции

&НаКлиенте
Процедура ДеревоФильтровВыбор(Элемент, ЗНАЧ ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
    ЭтоКореньДерева      = Ложь;

	ВыбраннаяСтрока = Элементы.ДеревоФильтров.ТекущиеДанные; 
	Если ВыбраннаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РодительСтроки  = ВыбраннаяСтрока.ПолучитьРодителя();
	Если РодительСтроки = Неопределено Тогда
	     ЭтоКореньДерева = Истина;
	КонецЕсли;
	
	ГруппаНастроек = ВыбраннаяСтрока.ГруппаНастроек;
	
	Если ГруппаНастроек ="Организация" 
		И Элемент.ТекущийЭлемент.Имя = "ДеревоФильтровИзменить" Тогда 
		
		СписокВыбора = ПолучитьСписокОрганизаций();
		
		СписокПараметров = Новый Структура;
		СписокПараметров.Вставить("Родитель"          , ВыбраннаяСтрока);
		СписокПараметров.Вставить("ДобавитьНовыйОтбор", Ложь);
		
		Оповещение = Новый ОписаниеОповещения("ПослеВыбораЭлемента", ЭтаФорма, СписокПараметров);
		СписокВыбора.ПоказатьОтметкуЭлементов(Оповещение, "Выберите организацию (GLN организации)");
		
	ИначеЕсли ГруппаНастроек ="Контрагент" 
		И Элемент.ТекущийЭлемент.Имя = "ДеревоФильтровИзменить" Тогда 
		
		СписокВыбора = ПолучитьСписокКонтрагентов();
		
		СписокПараметров = Новый Структура;
		СписокПараметров.Вставить("Родитель"          , ВыбраннаяСтрока);
		СписокПараметров.Вставить("ДобавитьНовыйОтбор", Ложь);
		
		Оповещение = Новый ОписаниеОповещения("ПослеВыбораЭлемента", ЭтаФорма, СписокПараметров);
		СписокВыбора.ПоказатьОтметкуЭлементов(Оповещение, "Выберите контрагента (GLN контрагенты)");
		
	ИначеЕсли ГруппаНастроек ="ТочкаДоставки" 
		И Элемент.ТекущийЭлемент.Имя = "ДеревоФильтровИзменить" Тогда 
		
		СписокВыбора = ПолучитьСписокТочекДоставки();
		
		СписокПараметров = Новый Структура;
		СписокПараметров.Вставить("Родитель"          , ВыбраннаяСтрока);
		СписокПараметров.Вставить("ДобавитьНовыйОтбор", Ложь);
		
		Оповещение = Новый ОписаниеОповещения("ПослеВыбораЭлемента", ЭтаФорма, СписокПараметров);
		СписокВыбора.ПоказатьОтметкуЭлементов(Оповещение, "Выберите точки доставки (GLN точки доставки)");
		
	ИначеЕсли ВыбраннаяСтрока.ТипЗначения = "Строка" 
		И Элемент.ТекущийЭлемент.Имя = "ДеревоФильтровИзменить"
		И ЭтоКореньДерева = Истина Тогда 
		
		ИдентификаторСтроки = Элементы.ДеревоФильтров.ТекущаяСтрока;
		ТекущаяСтрока       = ДеревоФильтров.НайтиПоИдентификатору(ИдентификаторСтроки);
		
		НоваяСтрокаДерева          = ТекущаяСтрока.ПолучитьЭлементы().Добавить();
		НоваяСтрокаДерева.Значение = "";
		НоваяСтрокаДерева.Изменить = БиблиотекаКартинок.ЭКОМ_ОчиститьЛогСобытий;
		НоваяСтрокаДерева.Иконка   = ТекущаяСтрока.Иконка;
		НоваяСтрокаДерева.Пометка  = Истина;
		
		ТекущаяСтрока.Пометка  = Истина;
		ДеревоФильтровИзменитьФильтры(ТекущаяСтрока);
		
		// Развернуть дерево отборов требуемого действия
		Элементы.ДеревоФильтров.Развернуть(ИдентификаторСтроки, ИСТИНА);
		
	ИначеЕсли ВыбраннаяСтрока.ТипЗначения = "Число" 
		И Элемент.ТекущийЭлемент.Имя = "ДеревоФильтровИзменить"
		И ЭтоКореньДерева = Истина Тогда 
		
		ИдентификаторСтроки = Элементы.ДеревоФильтров.ТекущаяСтрока;
		ТекущаяСтрока       = ДеревоФильтров.НайтиПоИдентификатору(ИдентификаторСтроки);
		
		НоваяСтрокаДерева          = ТекущаяСтрока.ПолучитьЭлементы().Добавить();
		НоваяСтрокаДерева.Значение = 0;
		НоваяСтрокаДерева.Изменить = БиблиотекаКартинок.ЭКОМ_ОчиститьЛогСобытий;
		НоваяСтрокаДерева.Иконка   = ТекущаяСтрока.Иконка;
		НоваяСтрокаДерева.Пометка  = Истина;
		
		ТекущаяСтрока.Пометка  = Истина;
		ДеревоФильтровИзменитьФильтры(ТекущаяСтрока);
		
		// Развернуть дерево отборов требуемого действия
		Элементы.ДеревоФильтров.Развернуть(ИдентификаторСтроки, ИСТИНА);
		
	ИначеЕсли (Найти(ВыбраннаяСтрока.ТипЗначения, "Документ") > 0
		ИЛИ Найти(ВыбраннаяСтрока.ТипЗначения, "Справочник") > 0
		ИЛИ Найти(ВыбраннаяСтрока.ТипЗначения, "Перечислени") > 0)
		И Элемент.ТекущийЭлемент.Имя = "ДеревоФильтровИзменить"
		И ЭтоКореньДерева = Истина Тогда 
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("МножественныйВыбор", Истина);
		
		СписокПараметров = Новый Структура;
		СписокПараметров.Вставить("Родитель"          , ВыбраннаяСтрока);
		СписокПараметров.Вставить("ДобавитьНовыйОтбор", Ложь);
		
		ОписаниеВыбора = Новый ОписаниеОповещения("ПослеВыбораЭлемента", ЭтаФорма, СписокПараметров);
	
		ОткрытьФорму(ВыбраннаяСтрока.ТипЗначения + ".ФормаВыбора", 
		ПараметрыФормы,,,,,
		ОписаниеВыбора,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
	// Удалить строки дерева
	ИначеЕсли Поле.Имя = "ДеревоФильтровИзменить" 
		И ЭтоКореньДерева = Ложь Тогда 
		
		ВыбраннаяСтрока.Пометка = Ложь;
		ДеревоФильтровИзменитьФильтры(ВыбраннаяСтрока);
		РодительСтроки.ПолучитьЭлементы().Удалить(ВыбраннаяСтрока);
		
		// Если нет элементов то снимаем галку с родителя
		Если РодительСтроки.ПолучитьЭлементы().Количество() = 0 Тогда
		     РодительСтроки.Пометка = Ложь;
		     ДеревоФильтровИзменитьФильтры(РодительСтроки);			
		КонецЕсли;

	// Отрицание значения 
    ИначеЕсли Поле.Имя = "ДеревоФильтровОтрицаниеЗначение"  
	      И ЭтоКореньДерева = Истина Тогда 
		
		ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();	
	    ПользовательскийОтбор = ЭтаФорма[ДанныеСписка.ИмяРеквизитаТаблицы].КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ЭтаФорма[ДанныеСписка.ИмяРеквизитаТаблицы].КомпоновщикНастроек.Настройки.Отбор.ИдентификаторПользовательскойНастройки);
		НайденныйОтбор = НайтиПользовательскийОтбор(ПользовательскийОтбор, ВыбраннаяСтрока.ГруппаНастроек);
		
		ИмяСравнения = СокрЛП(НайденныйОтбор.ВидСравнения);		
		ИмяСравнения = НРег(ИмяСравнения);
		ИмяСравнения = СтрЗаменить(ИмяСравнения, "не ", "");
		
		СоответствиеВидСравнения = Новый Соответствие;
		СоответствиеВидСравнения.Вставить("не содержит", ВидСравненияКомпоновкиДанных.НеСодержит);
		СоответствиеВидСравнения.Вставить("содержит"   , ВидСравненияКомпоновкиДанных.Содержит);
		СоответствиеВидСравнения.Вставить("не равно"   , ВидСравненияКомпоновкиДанных.НеРавно);
		СоответствиеВидСравнения.Вставить("равно"      , ВидСравненияКомпоновкиДанных.Равно);
		СоответствиеВидСравнения.Вставить("не в списке", ВидСравненияКомпоновкиДанных.НеВСписке);
		СоответствиеВидСравнения.Вставить("в списке"   , ВидСравненияКомпоновкиДанных.ВСписке);
		
		Если ВыбраннаяСтрока.ОтрицаниеЗначение = БиблиотекаКартинок.ЭКОМ_ВосклицателыныйЗнак Тогда
		     ВыбраннаяСтрока.ОтрицаниеЗначение = БиблиотекаКартинок.ЭКОМ_ВосклицательныйЗнакВыключенСерый;
			 НайденныйОтбор.ВидСравнения = СоответствиеВидСравнения.Получить(ИмяСравнения);
		Иначе	
		     ВыбраннаяСтрока.ОтрицаниеЗначение = БиблиотекаКартинок.ЭКОМ_ВосклицателыныйЗнак;
			 НайденныйОтбор.ВидСравнения = СоответствиеВидСравнения.Получить("не " + ИмяСравнения); 
		КонецЕсли;   
		
	// Число строка 
    ИначеЕсли Поле.Имя = "ДеревоФильтровЗначение"  
	      И ЭтоКореньДерева = Ложь Тогда 
		  
		  СтандартнаяОбработка = Истина;

	КонецЕсли;			
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораЭлемента(ВыбранныйЭлемент, СписокПараметров) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
	     Возврат;
	КонецЕсли;
	
	ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();
	
	Если СписокПараметров.ДобавитьНовыйОтбор = Истина Тогда
		
		// Получим все существующие элементы в корневом отборе
		СуществующиеОтборы = Новый Соответствие;
		СтрокиКорневые       = ЭтаФорма.ДеревоФильтров.ПолучитьЭлементы();
		Для каждого Эл Из СтрокиКорневые Цикл
			СуществующиеОтборы.Вставить(Эл.Значение, Эл.Значение);
		КонецЦикла;
		
		// Чтобы не было дублей поместим все в соответсвие
		НовыйОтбор = Новый Массив;
		Для каждого Эл Из ВыбранныйЭлемент Цикл
			Если Эл.Пометка = Истина Тогда
				НовыйОтбор.Добавить(Эл.Значение);
			КонецЕсли;		
		КонецЦикла;
		
		// Создаем новый отбор
        СоздатьПользовательскиеНастройки(ДанныеСписка, НовыйОтбор);
		СоздатьДеревоПользовательскихНастроекНаСервере(ДанныеСписка, НовыйОтбор);
		    
	Иначе
		
		// Получим все существующие элементы в отборе
		Соответствие = Новый Соответствие;
		Строки       = Элементы.ДеревоФильтров.ТекущиеДанные.ПолучитьЭлементы();
		Для каждого Эл Из Строки  Цикл
			Соответствие.Вставить(Эл.Значение, Эл.Пометка);
		КонецЦикла;
		
		// Чтобы не было дублей поместим все в соответсвие
		Если ТипЗнч(ВыбранныйЭлемент) = Тип("СписокЗначений") Тогда
			Для каждого Эл Из ВыбранныйЭлемент  Цикл
				Если Эл.Пометка = Истина Тогда
					Соответствие.Вставить(Эл.Значение, Истина);
				КонецЕсли;		
			КонецЦикла;
		Иначе	
			Для каждого Эл Из ВыбранныйЭлемент  Цикл				
					Соответствие.Вставить(Эл, Истина);
			КонецЦикла;
		КонецЕсли;
		
		
		// Ищем строку в отборе и очищаем
		ИдентификаторСтроки = Элементы.ДеревоФильтров.ТекущаяСтрока;	
		ТекущаяСтрока       = ЭтаФорма.ДеревоФильтров.НайтиПоИдентификатору(ИдентификаторСтроки);
		ТекущаяСтрока.ПолучитьЭлементы().Очистить();
		
		// Добавляем все элементы
		Для каждого Эл Из Соответствие  Цикл
			НоваяСтрокаДерева  = ТекущаяСтрока.ПолучитьЭлементы().Добавить();
			НоваяСтрокаДерева.Пометка  = Эл.Значение;
			НоваяСтрокаДерева.Иконка   = СписокПараметров.Родитель.Иконка;
			НоваяСтрокаДерева.Значение = Эл.Ключ;
			НоваяСтрокаДерева.Изменить = БиблиотекаКартинок.ЭКОМ_ОчиститьЛогСобытий; 
		КонецЦикла;
		
		ТекущаяСтрока.Пометка  = Истина;
		ДеревоФильтровИзменитьФильтры(ТекущаяСтрока);
		
		//Поиск элемента пользовательских настроек по уникальному идентификатору раздела настроек 
		ПользовательскийОтбор = ЭтаФорма[ДанныеСписка.ИмяРеквизитаТаблицы].КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ЭтаФорма[ДанныеСписка.ИмяРеквизитаТаблицы].КомпоновщикНастроек.Настройки.Отбор.ИдентификаторПользовательскойНастройки);
		
		НайденныйОтбор = НайтиПользовательскийОтбор(ПользовательскийОтбор, ТекущаяСтрока.ГруппаНастроек);
		Если НЕ НайденныйОтбор = Неопределено Тогда
			
			НайденныйОтбор.ПравоеЗначение.Очистить();
			
			Если НЕ СписокПараметров.Родитель = Неопределено Тогда
				Строки = СписокПараметров.Родитель.ПолучитьЭлементы();
				Для каждого Стр Из Строки Цикл
					
					Если Стр.Пометка = Истина Тогда
						
						НайденныйОтбор.ПравоеЗначение.Добавить(Стр.Значение);
						
					КонецЕсли;  
					
				КонецЦикла;			
			КонецЕсли;
			
		КонецЕсли;
				
	КонецЕсли;
		
	РазвернутьДеревоФильтровКлиент();
	
КонецПроцедуры

&НаКлиенте
Функция НайтиВДереве(ДеревоИлиЕгоЭлемент,ЧтоИщем,ВКакойКолонке)
	НайденныйЭлемент = Неопределено;
	
	Для	Каждого ЭлементДерева Из ДеревоИлиЕгоЭлемент.ПолучитьЭлементы() Цикл
		ЗначениеВКолонке = Неопределено;
		НашлиПоСвойству = ЭлементДерева.Свойство(ВКакойКолонке,ЗначениеВКолонке);
		Если НашлиПоСвойству и ЗначениеВКолонке=ЧтоИщем Тогда 
			НайденныйЭлемент = ЭлементДерева;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат НайденныйЭлемент;
КонецФункции

