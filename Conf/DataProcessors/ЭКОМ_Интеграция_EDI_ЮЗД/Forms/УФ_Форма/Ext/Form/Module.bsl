&НаКлиенте
Процедура ИсходящийCondra_Добавить(Команда)
	
    КлючУникальностиФормы = "ФормаНовыйCONDRA";
	
	ПараметрыНастроек = Новый Структура;
	
	ПараметрыНастроек.Вставить("ЭКОМОбъектыАктуальны", 			ЭтаФорма.ЭКОМОбъектыАктуальны);
	ПараметрыНастроек.Вставить("ДополнительнаяОбработкаСсылка", ЭтаФорма.ОбъектСсылка);
    
    ФормаНастроек = ОткрытьФорму(ПолноеИмяОбработки + ".Форма.УФ_ФормаНовыйCONDRA", ПараметрыНастроек, ЭтаФорма, КлючУникальностиФормы);
    ФормаНастроек.Активизировать();

КонецПроцедуры

&НаКлиенте
Процедура ИсходящийCondra_Отправить(Команда, transguidКОтправке = Неопределено) Экспорт
	
	ИмяСобытия = "Отправка CONDRA";
	ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();
	Если ДанныеСписка.ИмяСписка = "" Тогда
		Возврат;
	КонецЕсли;
	
	ПозицияТекущейСтроки = Неопределено;	
	
	ВыделенныеЗаписи = Новый Массив;
	Если transguidКОтправке = Неопределено Тогда
		
		ВыделенныеЗаписи = ПолучитьСтрокиДинамическогоСпискаДляОбработки(ДанныеСписка, ПозицияТекущейСтроки);
		
		transguidКОтправке = Новый Массив;
		Для Каждого Запись Из ВыделенныеЗаписи Цикл
			transguidКОтправке.Добавить(Запись.ИД_Документа);
		КонецЦикла;
	
	КонецЕсли;

	МассивЛогаСобытий 	= Новый Массив;
	
	Если transguidКОтправке.Количество() = 0 Тогда
		ТекстЛогаСобытий = "Нет данных для отправки";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Предупреждение"), ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		ОтобразитьЛогСобытий(МассивЛогаСобытий);
		Возврат;
	КонецЕсли;
	
	ЗначениеПоУмолчанию = Неопределено;
	Измерение           = Неопределено; 
	Обязательно         = Истина;
	
	ЛокальныйКаталогOUTBOX_Архив = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_Локальный_Каталог_OUTBOX_Архив"", ЗначениеПоУмолчанию, Измерение, Обязательно)");
	
	ЗаписиКОтправке = ИсходящийCondra_ПодготовитьКОтправкеНаСервере(transguidКОтправке, МассивЛогаСобытий);
	
	// Подписание на клиенте.
	МаксИндекс = ЗаписиКОтправке.ВГраница();
	Для Индекс = 0 По МаксИндекс Цикл
		Запись = ЗаписиКОтправке.Получить(МаксИндекс - Индекс);
		Если Запись.СертификатНаСервере = Ложь Тогда
			ДвоичныеДанныеФайлаДанных = ПолучитьИзВременногоХранилища(Запись.АдресФайлаДанных);
			Если Запись.Страна = "kz" Тогда //MOD-2544  					
				Base64ДанныеФайлаBIN = Вычислить("ЭКОМ_ОбщегоНазначенияКлиент.ПодписатьТекстKalkanCryptCOM(ДвоичныеДанныеФайлаДанных, МассивЛогаСобытий)");
				ДвоичныеДанныеФайлаBIN = Base64Значение(Base64ДанныеФайлаBIN);
				Если Base64ДанныеФайлаBIN = Неопределено Тогда 
					ОтобразитьЛогСобытий(МассивЛогаСобытий);
					Возврат;
				КонецЕсли;
			Иначе	
				ДвоичныеДанныеФайлаBIN = Вычислить("ЭКОМ_ОбщегоНазначенияКлиент.ЭЦП_СформироватьПодписьФайлаОбщегоНазначения(ДвоичныеДанныеФайлаДанных, Запись.ДанныеСертификатаЭКОМ, МассивЛогаСобытий)");
			КонецЕсли;
			Если ДвоичныеДанныеФайлаBIN = Неопределено Тогда
				ТекстЛогаСобытий = "Ошибка подписания файла на клиенте. Проверьте настройки подписи (TRANSGUID " + Запись.Идентификатор + ")";
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Ошибка"), ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

				ЗаписиКОтправке.Удалить(МаксИндекс - Индекс);
				Продолжить;
			КонецЕсли;
			Запись.АдресФайлаДанных = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайлаДанных, Новый УникальныйИдентификатор);
			Запись.АдресФайлаBIN 	= ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайлаBIN, Новый УникальныйИдентификатор);
		КонецЕсли;
	КонецЦикла;
	
	ЗаписиОтправленные	= ИсходящийCondra_ОтправитьНаСервере(ЗаписиКОтправке, МассивЛогаСобытий);
	РазделительПути 	= ЭКОМ_ПолучитьРазделительПутиОСКлиента().Получить("РазделительПути");
	
	КаталогСохранения = ЛокальныйКаталогOUTBOX_Архив + ДанныеСписка.Путь
		+ РазделительПути + Формат(ТекущаяДата(), "ДФ=yyyyMMdd") + РазделительПути;		
	СоздатьКаталог(КаталогСохранения);
	
	Для Каждого Запись Из ЗаписиОтправленные Цикл
		Если НЕ Запись.Отправлен = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(Запись.АдресАрхива);
		ДвоичныеДанные.Записать(КаталогСохранения + Запись.ИмяАрхива);
		
	КонецЦикла;
	
	ОбновитьДинамическийСписок(ДанныеСписка);
	ВосстановитьТекущуюСтрокуСписка(ПозицияТекущейСтроки, ДанныеСписка.ИмяСписка, ВыделенныеЗаписи);
	ОтобразитьЛогСобытий(МассивЛогаСобытий);
	
КонецПроцедуры

// Подготавливает к отправке документы CONDRA по выделенным строкам на сервере
//
// Параметры:
//  transguidКОтправке  - Массив - коллекция значений TRANSGUID из РС ЭКОМ_ЦепочкиНеструктурированныхДокументов для отправки
//  МассивЛогаСобытий  	- Массив - данные лога бсобытий
//
// Возвращаемое значение:
//   Массив - коллекция подготовленных записей
//
&НаСервере
Функция ИсходящийCondra_ПодготовитьКОтправкеНаСервере(transguidКОтправке, МассивЛогаСобытий)

	ОбработкаОбъект	= РеквизитФормыВЗначение("Объект");
	ЗаписиКОтправке =  ОбработкаОбъект.CondraПодготовитьКОтправке(transguidКОтправке, МассивЛогаСобытий);
	ОбработкаОбъект.CondraДобавитьОтпрвляемыеФайлы(ЗаписиКОтправке, МассивЛогаСобытий);
	
	Возврат ЗаписиКОтправке;
	
КонецФункции // ИсходящийCondra_ПодготовитьКОтправкеНаСервере()

// Выполняет отправку документа CONDRA по выделенным строкам на сервере
//
// Параметры:
//  ЗаписиКОтправке  	- Массив - коллекция подготовленных записей
//  МассивЛогаСобытий  	- Массив - данные лога бсобытий
//
// Возвращаемое значение:
//   Массив - коллекция обработанных записей
//
&НаСервере
Функция ИсходящийCondra_ОтправитьНаСервере(ЗаписиКОтправке, МассивЛогаСобытий)

	ОбработкаОбъект		= РеквизитФормыВЗначение("Объект");
	ЗаписиОтправленные 	= ОбработкаОбъект.CondraОтправить(ЗаписиКОтправке, МассивЛогаСобытий);

	Возврат ЗаписиОтправленные;

КонецФункции // ИсходящийCondra_ОтправитьНаСервере()

&НаКлиенте
Процедура СписокДляПрайсЛистаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Элемент = Неопределено 
		Или Элемент.ТекущиеДанные = Неопределено 
		Или ВыбраннаяСтрока = Неопределено Тогда
        Возврат;
    КонецЕсли;
    СтандартнаяОбработка = Ложь;
	
	ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();
	Если Поле.Имя = ДанныеСписка.ИмяСписка + "Пометка" Тогда
		
		Если Не Элемент.ТекущиеДанные = Неопределено Тогда
			Если Элемент.ТекущиеДанные.Пометка Тогда
				СнятьПометку(Элемент.ТекущиеДанные.ДокументыВсе);
			Иначе
				ПоставитьПометку(Элемент.ТекущиеДанные.ДокументыВсе);
			КонецЕсли;
		КонецЕсли;
		
		//Параметр в динамическом списке нужно обновить
		УстановитьПараметрДинамическогоСписка(ДанныеСписка.ИмяРеквизитаТаблицы, "масПомеченныхДоков", СписокВыбранныхСтрок.ВыгрузитьЗначения());
    
    КонецЕсли;
	
	ЭлементОбъект = ОпределитьТипОбъекта(Элемент, Поле.Имя);
    Если ЗначениеЗаполнено(ЭлементОбъект) Тогда
        ПоказатьЗначение( , ЭлементОбъект);
	КонецЕсли;  
	
КонецПроцедуры

&НаСервере
Процедура СписокДляПрайсЛистаПриОбновленииСоставаПользовательскихНастроекНаСервере(СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПриОбновленииСоставаПользовательскихНастроекНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриОбновленииСоставаПользовательскихНастроекНаСервере()
	
	ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаСервере();
	СоздатьСоставПользовательскихНастроекНаСервере(ДанныеСписка);
	СоздатьДеревоПользовательскихНастроекНаСервере(ДанныеСписка, Новый Массив);

КонецПроцедуры

&НаКлиенте
Процедура СписокДляПрайсЛистаВходящийПриАктивизацииСтроки(Элемент)
	
	Если НЕ Элементы.ОсновнаяПанель.ТекущаяСтраница = Элементы.ГруппаПрайсЛист Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ТаблицаЦепочкаДокументов.Видимость = Истина;
	Элементы.ТаблицаКвитанций.Видимость         = Ложь;
	Элементы.ТаблицаПалет.Видимость             = Ложь;

	Если НЕ ТекущийЭлемент.Имя = "КомандаФильтрыИМеню" Тогда
		ОбновитьЦепочкуДокументовИКвитанцииНаКлиенте("СписокДляПрайсЛистаВходящий");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СписокДляПрайсЛистаИсходящийПриАктивизацииСтроки(Элемент)
	
	Если НЕ Элементы.ОсновнаяПанель.ТекущаяСтраница = Элементы.ГруппаПрайсЛист Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ТекущийЭлемент.Имя = "КомандаФильтрыИМеню" Тогда
		ОбновитьЦепочкуДокументовИКвитанцииНаКлиенте("СписокДляПрайсЛистаИсходящий");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ГруппаСтраницыПрайсЛистаПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	// Очищаем пометки при смене страницы
	СписокВыбранныхСтрок.Очистить();
	
	МассивЛогаСобытий = Новый Массив;
	
	ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();
	СоздатьДинамическийСписокДобавитьДинамическиеКнопки(МассивЛогаСобытий);
	ОбновитьЦепочкуДокументовИКвитанцииНаКлиенте(ДанныеСписка.ИмяСписка);
	ОбновитьДинамическийСписок(ДанныеСписка);

	Если МассивЛогаСобытий.Количество() > 0  Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Вычислить("ЭКОМ_ОбщегоНазначенияКлиент.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий)");
		Сообщение.Сообщить();
	КонецЕсли;

КонецПроцедуры

