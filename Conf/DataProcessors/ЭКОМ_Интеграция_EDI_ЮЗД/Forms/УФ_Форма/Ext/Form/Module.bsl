Функция ОпределитьКаталогПоУмолчанию(Диск, РазделительПути)
	
	РабочийКаталогПоУмолчанию = "Диск_EDI_ECOM@";
	
	ПутьКаталога = СтрЗаменить(РабочийКаталогПоУмолчанию, "@", РазделительПути);
	ПутьКаталога = СтрЗаменить(ПутьКаталога, "Диск_", Диск);
	
	ПроверитьЛокальныйКаталог(ПутьКаталога, РазделительПути);
		
	Возврат ПутьКаталога;

КонецФункции

&НаКлиенте
Функция ЭКОМ_СоздатьКаталогПроверитьНаЗаписьКлиент(ПолныйПутьКаталога, МассивЛогаСобытий)
	
	ИмяСобытия = "Проверка каталога";
	Каталог = Неопределено;
	Если ЗначениеЗаполнено(ПолныйПутьКаталога) 
		 И ТипЗнч(ПолныйПутьКаталога) = Тип("Строка") Тогда

		 // Создаем каталог 
		 Каталог = Новый Файл(ПолныйПутьКаталога);
		 Если НЕ Каталог.Существует() Тогда
			 Попытка
				 СоздатьКаталог(ПолныйПутьКаталога);
				 Каталог = Новый Файл(ПолныйПутьКаталога);
			 Исключение
				 ТекстЛогаСобытий = "Каталог, указанный в настройках модуля отсутствует. 
				 |Ошибка создания каталога по настройке [" + ПолныйПутьКаталога + "] Текст ошибки платформы: " + ОписаниеОшибки();
				 ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Ошибка"), ИмяСобытия);
				 МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
				 
				 Возврат Неопределено;
				 
			 КонецПопытки;
			 
		 КонецЕсли;
		 
		 // Проверяем на запись
		 Попытка
			 Текст = Новый ЗаписьТекста(ПолныйПутьКаталога + "ТестНаЗапись.txt", КодировкаТекста.ANSI);    
			 Текст.ЗаписатьСтроку("Проверка на запись файлов!");
			 Текст.Закрыть();
			 
		 Исключение
			 ТекстЛогаСобытий = "Нет прав на запись файлов. Текст ошибки платформы: " + ОписаниеОшибки();	
			 ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Ошибка"), ИмяСобытия);
			 МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

			 Возврат Неопределено;
			 
		 КонецПопытки;
		 
	КонецЕсли;

    Возврат Каталог;

КонецФункции

&НаКлиенте
Процедура ОткрытьПредыдущуюВерсиюОбработки()
		
   	ДанныеОС = ЭКОМ_ПолучитьРазделительПутиОСКлиента();
	РазделительПути = ДанныеОС.Получить("РазделительПути");
	
	ЗначениеПоУмолчанию = Неопределено;
	Измерение           = Неопределено; 
	Обязательно         = Истина;
	МассивЛогаСобытий = Новый Массив;
	ЛокальныйКаталогUPDATE = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_Локальный_Каталог_UPDATE"", ЗначениеПоУмолчанию, Измерение, Обязательно)");
	
	Если ЗначениеЗаполнено(ЛокальныйКаталогUPDATE) 
		 И ТипЗнч(ЛокальныйКаталогUPDATE) = Тип("Строка") Тогда
		 
		 ПолныйПутьАрхиваUpdate = ЛокальныйКаталогUPDATE + ?(Прав(ЛокальныйКаталогUPDATE, 1) = РазделительПути, "", РазделительПути) + "archive" + РазделительПути;
		
	Иначе
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не указан каталог UPDATE!";
		Сообщение.Сообщить();
		
		Возврат;
		
	КонецЕсли;
	
	КаталогАрхиваUpdate = ЭКОМ_СоздатьКаталогПроверитьНаЗаписьКлиент(ПолныйПутьАрхиваUpdate, МассивЛогаСобытий);
	Если КаталогАрхиваUpdate = Неопределено Тогда		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Вычислить("ЭКОМ_ОбщегоНазначенияКлиент.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий)");
		Сообщение.Сообщить();
		
		Возврат;
		
	КонецЕсли;
    
    СписокФайловВерсий = Новый СписокЗначений;
        
    ФайлыИзАрхива = НайтиФайлы(ПолныйПутьАрхиваUpdate, "*.epf");
    Для каждого ТекущийФайл Из ФайлыИзАрхива Цикл
        ИмяФайла = ТекущийФайл.ИмяБезРасширения;
        СписокФайловВерсий.Добавить(ТекущийФайл.ПолноеИмя, ИмяФайла);
    КонецЦикла;
    
   ФайлыИзАрхива = Неопределено;
   
   ФайлыИзАрхива = НайтиФайлы(ЛокальныйКаталогUPDATE, "Архив*.epf");
   Для каждого ТекущийФайл Из ФайлыИзАрхива Цикл
        ИмяФайла = ТекущийФайл.ИмяБезРасширения;
        СписокФайловВерсий.Добавить(ТекущийФайл.ПолноеИмя, ИмяФайла);
    КонецЦикла;
    
    СписокФайловВерсий.ПоказатьВыборЭлемента(Новый ОписаниеОповещения("ОткрытьПредыдущуюВерсиюОбработкиЗавершение", ЭтаФорма), "Какую версию открыть?");
КонецПроцедуры

&НаСервере
Функция ПолучитьОбъектВнешнейОбработки(Адрес)
    Защита = Новый ОписаниеЗащитыОтОпасныхДействий;
    Защита.ПредупреждатьОбОпасныхДействиях = Ложь;
    
    ИмяПредОбработки = ВнешниеОбработки.Подключить(Адрес, , Ложь, Защита);
    Возврат ИмяПредОбработки;    	
КонецФункции

&НаКлиенте
Процедура ОткрытьПредыдущуюВерсиюОбработкиЗавершение(Результат, ДопПараметры) Экспорт
    
	Если Результат = Неопределено Тогда
        Возврат;
    КонецЕсли;
	
	Адрес = "";
	ПоместитьФайл(Адрес, Результат.Значение, , Ложь, Новый УникальныйИдентификатор);
	
    ИмяПредОбработки = ПолучитьОбъектВнешнейОбработки(Адрес);
	
	ПредФорма = ПолучитьФорму("ВнешняяОбработка." + ИмяПредОбработки + ".Форма.УФ_Форма", , ЭтаФорма);
	
	ВсеОткрытыеОкна = ПолучитьОкна();
	Для Каждого ОткрытоеОкно Из ВсеОткрытыеОкна Цикл
		Если НЕ ОткрытоеОкно.Содержимое.Количество() = 0 И ПредФорма.Заголовок = ОткрытоеОкно.Содержимое[0].Заголовок Тогда
			ОткрытоеОкно.Активизировать();
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	ПредФорма.Открыть();
	
КонецПроцедуры

&НаСервере
Функция Настройка_Параметр_Записать(пИмя, пЗначение, пИзмерение = Неопределено) Экспорт
    
    МЗ = РегистрыСведений.ЭКОМ_ЗначениеДополнительныхКонстант.СоздатьМенеджерЗаписи();
    
    Если Лев(пИмя , 1) = "_" Тогда
        ПоместитьВХранилище = Истина;
    Иначе
        ПоместитьВХранилище = Ложь;
    КонецЕсли;
    
    МЗ.ДополнительнаяКонстанта  = ?(ПоместитьВХранилище, Сред(пИмя, 2), пИмя);
    МЗ.Измерение                = пИзмерение;
    МЗ.Прочитать();
    
    Если НЕ МЗ.Выбран() Тогда
        МЗ.ДополнительнаяКонстанта  = ?(ПоместитьВХранилище, Сред(пИмя, 2), пИмя);
        МЗ.Измерение                = пИзмерение;
    КонецЕсли;
    
    Если ПоместитьВХранилище Тогда
        МЗ.ЗначениеДополнительногоХранилища = Новый ХранилищеЗначения(пЗначение);
    Иначе
        МЗ.ЗначениеДополнительнойКонстанты 	= пЗначение;
    КонецЕсли;
    
    МЗ.Записать();
    
    Возврат 1;
    
КонецФункции

