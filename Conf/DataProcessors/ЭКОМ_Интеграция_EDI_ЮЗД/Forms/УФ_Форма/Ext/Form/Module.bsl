&НаКлиенте
Процедура ПолучитьСостояниеОбменаНаКлиенте()
    
    Данные = ВернутьРезультатИзМодуляОбъекта("ПолучитьСостояниеОбмена");
    
    ЭтаФорма.СостояниеВыгрузки = Данные.ДатаОтправления; 
    ЭтаФорма.СостояниеЗагрузки = Данные.ДатаПолучения;	
    
    Если Данные.ЧасыОтправления >= 2  Тогда
        Элементы.СостояниеВыгрузки.ЦветФона = WebЦвета.СветлоРозовый;
    Иначе
        Элементы.СостояниеВыгрузки.ЦветФона = WebЦвета.СветлоЗеленый;
    КонецЕсли;
    
    Если Данные.ЧасыПолучения >= 2  Тогда
        Элементы.СостояниеЗагрузки.ЦветФона = WebЦвета.СветлоРозовый;
    Иначе
        Элементы.СостояниеЗагрузки.ЦветФона = WebЦвета.СветлоЗеленый;
    КонецЕсли;
    
КонецПроцедуры

&НаСервере
Функция ПолучитьИменаФайлов(МассивСтрок, РазделительПути)
    
    МассивОбработанныхФайлов = Новый Массив;
    Для каждого Стр  Из МассивСтрок Цикл
        
        // Найдем имя файла для архивирования на сервере
        ПоследнийНомерСлеш = 0;			
        ТекстДляПоиска     = Стр.ИмяФайла;
        ПродолжитьПоиск    = Истина;
        Пока ПродолжитьПоиск Цикл
            ОбратныйСлэш = Найти(ТекстДляПоиска, РазделительПути);
            Если ОбратныйСлэш = 0 Тогда
                ПродолжитьПоиск = Ложь;
            Иначе   // в имени файла есть слэш "C:\EDI_ECOM\inbox_bak\ORDER\20190713\order_201907131754_3194898437.xml"
                ПоследнийНомерСлеш = ПоследнийНомерСлеш + ОбратныйСлэш;
                ТекстДляПоиска     = Сред(ТекстДляПоиска, ОбратныйСлэш + 1); 
            КонецЕсли; 						
        КонецЦикла;
        
        ИмяФайла = СокрЛП(Сред(Стр.ИмяФайла, ПоследнийНомерСлеш + 1));
        
        Структура = Новый Структура;
        Структура.Вставить("Имя", ИмяФайла);
        
        МассивОбработанныхФайлов.Добавить(Структура);
        
        // Пометим на удаление ЭКОМ документ
        ДокЭКОМ = Стр.ПолучитьОбъект();
        ДокЭКОМ.Документ1С = Неопределено;
        ДокЭКОМ.ДокументыСвязанные.Очистить();
        ДокЭКОМ.ПометкаУдаления = Истина;
        ДокЭКОМ.Записать(РежимЗаписиДокумента.Запись);
        
    КонецЦикла;
    
    Возврат МассивОбработанныхФайлов;
    
КонецФункции

&НаСервере
Процедура ПометитьЭКОМЗаказНаУдалениеОтправитьВАрхивНаСервере(МассивОбработанныхФайлов, РазделительПути, МассивЛогаСобытий)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЭКОМ_GLN.ПрофильОбмена КАК ПрофильОбмена,
	|	ЭКОМ_GLN.Объект КАК Организация
	|ИЗ
	|	РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN
	|ГДЕ
	|	НЕ ЭКОМ_GLN.ПрофильОбмена = ЗНАЧЕНИЕ(Справочник.ЭКОМ_ПрофилиОбмена.ПустаяСсылка)
	|	И НЕ ЭКОМ_GLN.ПрофильОбмена.ПометкаУдаления И ЭКОМ_GLN.ПрофильОбмена.Активный = ИСТИНА
	|ИТОГИ ПО
	|	ПрофильОбмена";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда		
		
		ЗначениеПоУмолчанию = Истина;
		Измерение           = Неопределено; 
		Обязательно         = Ложь;
	
		знИспользоватьАПИ = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_ИспользоватьАПИ"", ЗначениеПоУмолчанию, Измерение, Обязательно)");
		
		ВыборкаПрофильОбмена = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПрофильОбмена.Следующий() Цикл
			ПрофильОбмена = ВыборкаПрофильОбмена.ПрофильОбмена;
			
			// Перместить файлы в архив 
			Если знИспользоватьАПИ = Истина Тогда
				СтруктураМассивов = РазбитьМассивПоЧастям(МассивОбработанныхФайлов);   
				Для Каждого Эл Из СтруктураМассивов Цикл
					ИменаФайлов = Новый Массив;
					Для каждого ЭлИменаФайлов Из Эл.Значение Цикл
						ИменаФайлов.Добавить(ЭлИменаФайлов.Ключ);
					КонецЦикла;
					
					ПараметрыПроцедуры = Новый Массив;
					ПараметрыПроцедуры.Добавить(ПрофильОбмена);
					ПараметрыПроцедуры.Добавить(ИменаФайлов);
					ПараметрыПроцедуры.Добавить(МассивЛогаСобытий);
					
					ВыполнитьПроцедуруИзМодуляОбъекта("API_АрхивироватьДокументы", ПараметрыПроцедуры);		
					
				КонецЦикла;
			Иначе
				МассивИмен = Новый Массив;
				Для Каждого ЭлИмяФайла Из МассивОбработанныхФайлов Цикл		
					МассивИмен.Добавить(ЭлИмяФайла.Имя);
				КонецЦикла;
				
				ПараметрыПроцедуры = Новый Массив;
				ПараметрыПроцедуры.Добавить(ПрофильОбмена);
				ПараметрыПроцедуры.Добавить("Помещаю в архив");
				ПараметрыПроцедуры.Добавить(МассивЛогаСобытий);
				ПараметрыПроцедуры.Добавить(Ложь);
				ВыполнитьПроцедуруИзМодуляОбъекта("FTP_АрхивироватьДокументы", ПараметрыПроцедуры);	
			КонецЕсли;
			
		КонецЦикла; 		
	КонецЕсли;	
	
КонецПроцедуры

