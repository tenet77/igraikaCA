
&НаКлиенте
Процедура КомандаВыбратьПериодЛога(Команда)
	Диалог = Новый ДиалогРедактированияСтандартногоПериода();                                 
	Диалог.Период = Новый СтандартныйПериод(ЭтаФорма.ПериодНачалоЛога, ЭтаФорма.ПериодКонецЛога);
	ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("УстановитьПериодЗавершениеЛога", ЭтаФорма, Новый Структура("Диалог", Диалог));
	Диалог.Показать(ОписаниеОповещенияОЗакрытии); 	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериодЗавершениеЛога(Период, ДополнительныеПараметры) Экспорт	
	
	Диалог = ДополнительныеПараметры.Диалог; 	
    Если НЕ Период = Неопределено Тогда		
        ЭтаФорма.ПериодНачалоЛога = Диалог.Период.ДатаНачала;
        ЭтаФорма.ПериодКонецЛога  = Диалог.Период.ДатаОкончания;		
    КонецЕсли;
    
КонецПроцедуры

// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИмяСобытия = "Запуск обработки";
	МассивЛогаСобытий = Новый Массив;
	
	ОбработкаОбъект 	   = РеквизитФормыВЗначение("Объект");
    ПолноеИмяОбработки	   = ОбработкаОбъект.Метаданные().ПолноеИмя();
	ВерсияОбработки        = ОбработкаОбъект.ПолучитьВерсиюОбработки();
    ЭтаФорма.ОбработкаТип  = ЗначениеВСтрокуВнутр(ТипЗнч(ОбработкаОбъект)); // Установим внутреннее строковое представление типа значения объекта обработки
	
	ЭтаФорма.ОбъектСсылка = Параметры.ДополнительнаяОбработкаСсылка;
	
	МетаОбработкаИмя = ОбработкаОбъект.Метаданные().Имя;
	Если НЕ Метаданные.Обработки.Найти(МетаОбработкаИмя) = Неопределено
		И ТипЗнч(ОбработкаОбъект) = Тип("ОбработкаОбъект." + МетаОбработкаИмя) Тогда
		ЭтаФорма.ЭтоВнешняяОбработка = Ложь;
		ЭтаФорма.ИспользуемоеИмяФайла = МетаОбработкаИмя;
	Иначе
		ЭтаФорма.ЭтоВнешняяОбработка = Истина;
		ЭтаФорма.ИспользуемоеИмяФайла = ОбработкаОбъект.ИспользуемоеИмяФайла;
	КонецЕсли;
	
	РежимИспользования = "файл внешней обработки";
	Если Найти(ЭтаФорма.ИспользуемоеИмяФайла, "e1cib") = 1 Тогда 		
		РежимИспользования = "обработка в справочнике внешних обработок";  
		ЭтаФорма.ИспользуемоеИмяФайла = ПолучитьНавигационнуюСсылку(ЭтаФорма.ОбъектСсылка, "ХранилищеОбработки");
		
	ИначеЕсли ЭтаФорма.ЭтоВнешняяОбработка = Ложь 
		ИЛИ ЭтаФорма.ИспользуемоеИмяФайла = Неопределено Тогда
		РежимИспользования = "обработка в составе конфигурации"; 
		
	КонецЕсли;
	
	Попытка
		ТекущийПользователь = ОбработкаОбъект.НайтиТекущегоПользователя();
		ЭКОМ_РольУстановлена = Вычислить("ЭКОМ_ОбщегоНазначения.ЭКОМ_ЕстьРоль(""ЭКОМ_Роль"", ТекущийПользователь)");
		Если ЭКОМ_РольУстановлена = Ложь Тогда		 
			ЭтаФорма.СообщениеТекст = "Установите для пользователя <<<" + Строка(ТекущийПользователь) + ">>> роль - Docrobot Роль!!!";
			СообщениеПользователю = Новый СообщениеПользователю;
			СообщениеПользователю.Текст = ЭтаФорма.СообщениеТекст;
			СообщениеПользователю.Сообщить();
			ЭтаФорма.ОбработкаДоступна = Ложь;
			Возврат;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	ТекстСообщения = "";
	ЭтаФорма.ЭКОМОбъектыАктуальны  = ОбработкаОбъект.АктуальныОбъектыЭКОМ(ТекстСообщения, МассивЛогаСобытий);  	
	Если ЭтаФорма.ЭКОМОбъектыАктуальны = Ложь Тогда 	
		ЭтаФорма.НеобходимоУстановитьОбновление = Истина;
	
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Конфигурация Docrobot требует обновления" + Символы.ПС + ТекстСообщения;
		Сообщение.Сообщить();

	Иначе
		Если НЕ Метаданные.Документы.ЭКОМ_Документы.РасширениеКонфигурации() = Неопределено Тогда
			РежимИспользования = "обработка в составе расширения";
		КонецЕсли;

		ЭтаФорма.ОбработкаДоступна = Истина;
				
		// Для выполнения длительных операций в фоне
		Если Метаданные.ОбщиеМодули.Найти("СтандартныеПодсистемыСервер") = Неопределено Тогда
			ЭтаФорма.ДоступноВыполнениеВФоне = Ложь;
		Иначе		
			
			ВерсияБСП = Вычислить("СтандартныеПодсистемыСервер.ВерсияБиблиотеки()");
			ЭтаФорма.ДоступноВыполнениеВФоне = ВерсияБСП >= "2.2.2.1";
			
		КонецЕсли;
		ЭтаФорма.ДоступноВыполнениеВФоне = НастройкаПрочитатьОбщийМодуль("ДоступноВыполнениеВФоне", ЭтаФорма.ДоступноВыполнениеВФоне, Неопределено, Ложь);
				
		ЗначениеПоУмолчанию = Ложь;
		Измерение           = Неопределено; 
		Обязательно         = Ложь;
		ЭКОМ_Автообновление = НастройкаПрочитатьОбщийМодуль("ЭКОМ_Автообновление", ЗначениеПоУмолчанию, Измерение, Обязательно);
		
		// Статистика для улучшения модуля 1С
		Выполнить("ЭКОМ_ОбщегоНазначения.СобратьДанныеДляСтатистики(ВерсияОбработки, ЭКОМ_Автообновление, МассивЛогаСобытий);");
		
		// Запрос для таблицы паллет	
		ТекстЗапросаПаллет = "ВЫБРАТЬ
		|	ЭКОМ_Палеты.Номенклатура КАК Номенклатура,
		|	ЭКОМ_Палеты.НомерПалета КАК НомерПалета,
		|	ЭКОМ_Палеты.SSCC КАК SSCC,
		|	ЭКОМ_Палеты.ВесБрутто КАК ВесБрутто,
		|	ЭКОМ_Палеты.ВесНетто КАК ВесНетто,
		|	ЭКОМ_Палеты.Высота КАК Высота,
		|	ЭКОМ_Палеты.Европаллета КАК Европаллета,
		|	ЭКОМ_Палеты.Единица_Измерения КАК Единица_Измерения,
		|	ЭКОМ_Палеты.Количество КАК Количество,
		|	ЭКОМ_Палеты.МестоДоставкиУпаковки КАК МестоДоставкиУпаковки,
		|	ЭКОМ_Палеты.Объем КАК Объем
		|ИЗ
		|	РегистрСведений.ЭКОМ_Палеты КАК ЭКОМ_Палеты
		|ГДЕ
		|	ЭКОМ_Палеты.Документ В(&масПомеченныхДоков)";
		
		ЭтаФорма.ТаблицаПалет.ТекстЗапроса = ТекстЗапросаПаллет;
		
		ЭтаФорма.ПанельСвернута = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""СлужебныйПанельЦепочкиСвернута"", Истина, ""Служебный"")");
		
		// Получаем дерево как програмный объект
		ЗначениеПоУмолчанию = Неопределено;
		Измерение           = "Служебный"; 
		Обязательно         = Ложь;
		СлужебныйДеревоКонфигурации = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""СлужебныйДеревоКонфигурации"", ЗначениеПоУмолчанию, Измерение, Обязательно)");
		
		Если НЕ ЗначениеЗаполнено(СлужебныйДеревоКонфигурации) Тогда
			ОбработкаОбъект.ЗаполнитьДеревоКонфигурации();
		КонецЕсли;
		
		Настройка_Параметр_Записать("СлужебныйТипФормы", "УправляемаяФорма", "Служебный");
		
		ПроверитьЗаполнитьЗначенияДопКонстант();
		
		АвтоЗаголовок = Ложь;
		ЭтаФорма.Заголовок = ОбработкаОбъект.Метаданные().Синоним + " версия: " + ВерсияОбработки + ", " + РежимИспользования;
		
		ПараметрыФункции = Новый Массив;
		ПараметрыФункции.Добавить(Ложь);
		ПараметрыФункции.Добавить(МассивЛогаСобытий);	
		БекапНастроек = ВернутьРезультатИзМодуляОбъекта("ИзменитьФорматПользовательскихНастроек", ПараметрыФункции);
		Если БекапНастроек.ЕстьИзменения Тогда
			БекапАдресНастроек = БекапНастроек.ФайлНастроек;
			БекапИмяФайлаНастроек = БекапНастроек.ИмяФайлаНастроек;
		КонецЕсли;
		
		ПолучатьИдентификаторыЦепочек = Вычислить("ЭКОМ_ОбщегоНазначения.Настройка_Параметр_Прочитать(""ЭКОМ_ПолучатьИдентификаторыЦепочек"", Ложь)");
		Элементы.ЗаполнитьИдентификаторыЦепочек.Видимость = ПолучатьИдентификаторыЦепочек;
		
		// Поставщик
		ЗначениеПоУмолчанию = Ложь;
		Измерение           = Неопределено; 
		Обязательно         = Ложь;
		ЭКОМ_ОбменПоставщик = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_ОбменПоставщик"", ЗначениеПоУмолчанию, Измерение, Обязательно)");
		Элементы.Группа_Поставщик.Видимость            = ЭКОМ_ОбменПоставщик;
		
		// Покупатель
		ЗначениеПоУмолчанию = Ложь;
		Измерение           = Неопределено; 
		Обязательно         = Ложь;
		ЭКОМ_ОбменСеть = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_ОбменСеть"", ЗначениеПоУмолчанию, Измерение, Обязательно)");
		Элементы.Группа_Покупатель.Видимость       = ЭКОМ_ОбменСеть;
		
		// ЭТРН
		ЗначениеПоУмолчанию = Ложь;
		Измерение           = Неопределено; 
		Обязательно         = Ложь;
		ЭКОМ_ОбменЭТРН = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_ОбменЭТРН"", ЗначениеПоУмолчанию, Измерение, Обязательно)");
		Элементы.Группа_ЭТРН.Видимость                  = ЭКОМ_ОбменЭТРН;
		
		// Condra
		ЗначениеПоУмолчанию = Ложь;
		Измерение           = Неопределено; 
		Обязательно         = Ложь;
		ЭКОМ_ОбменCondra = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_ОбменCondra"", ЗначениеПоУмолчанию, Измерение, Обязательно)");
		Элементы.Группа_Condra.Видимость                  = ЭКОМ_ОбменCondra;
		
		// Прайс-лист
		ЗначениеПоУмолчанию = Ложь;
		Измерение           = Неопределено; 
		Обязательно         = Ложь;
		ЭКОМ_ОбменПрайсЛист = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_ОбменПрайсЛист"", ЗначениеПоУмолчанию, Измерение, Обязательно)");
		Элементы.ГруппаПрайсЛист.Видимость = ЭКОМ_ОбменПрайсЛист;
		
		// Заполнение текстов запросов для динамических списков.
		Вкладки = Новый Соответствие;
		Если ЭКОМ_ОбменПоставщик Тогда
			Вкладки.Вставить("СлужебныйЗапросДляФормыПоставщика", СписокДляПоставщика);
		КонецЕсли;
		Если ЭКОМ_ОбменСеть Тогда
			Вкладки.Вставить("СлужебныйЗапросДляФормыПокупателя", СписокДляПокупателя);
		КонецЕсли;
		Если ЭКОМ_ОбменЭТРН Тогда
			Вкладки.Вставить("СлужебныйЗапросДляФормыЭТРН", СписокДляЭТРН);
		КонецЕсли;
		Если ЭКОМ_ОбменCondra Тогда
			Вкладки.Вставить("СлужебныйЗапросДляФормыCondra", СписокДляCondra);
		КонецЕсли;
		Если ЭКОМ_ОбменПрайсЛист Тогда
			Вкладки.Вставить("СлужебныйЗапросДляФормыПрайсЛист", СписокДляПрайсЛиста);
		КонецЕсли;
	
		Для Каждого Вкладка Из Вкладки Цикл
			КодПолученияТекстаЗапроса = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(Вкладка.Ключ, Неопределено, ""Служебный"", Ложь)");
			Если НЕ ЗначениеЗаполнено(КодПолученияТекстаЗапроса) Тогда   
				Продолжить;
			КонецЕсли;
			
			Попытка
				
				ТекстЗапроса = "";
				Выполнить(КодПолученияТекстаЗапроса);
				
				Запрос = Новый Запрос;		               
				Запрос.Текст = ТекстЗапроса;
				Запрос.УстановитьПараметр("ДатаНач", ТекущаяДата());
				Запрос.УстановитьПараметр("ДатаКон", ТекущаяДата());			
				Запрос.УстановитьПараметр("масПомеченныхДоков", Новый Массив);
				Запрос.УстановитьПараметр("НаправлениеОбмена" , Перечисления.ЭКОМ_НаправлениеОбмена.ПустаяСсылка());
				
				Попытка
					РезультатЗапроса = Запрос.Выполнить();
				Исключение					
					ТекстЛогаСобытий = ОписаниеОшибки();
					ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛогаОбщийМодуль(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Ошибка"), ИмяСобытия);
					МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

					Продолжить;
				КонецПопытки;
				
				Вкладка.Значение.ТекстЗапроса = ТекстЗапроса;
				
			Исключение
				ТекстЛогаСобытий = ОписаниеОшибки();
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛогаОбщийМодуль(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Ошибка"), ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

			КонецПопытки;
		КонецЦикла;
		
		счВидимыхСтраниц = 0;
		Для Каждого СтраницаГруппы Из Элементы.ОсновнаяПанель.ПодчиненныеЭлементы Цикл
			счВидимыхСтраниц = ?(СтраницаГруппы.Видимость = Ложь, счВидимыхСтраниц, счВидимыхСтраниц + 1);
		КонецЦикла;
		
		Если счВидимыхСтраниц = 1 Тогда
			Элементы.ОсновнаяПанель.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;    
		КонецЕсли;
		
		ИнфоДатаЗагруженоЗа = НачалоДня(ТекущаяДата());
		
		ВсегоЭлементов = Новый Массив;
		
		ДанныеОформления = Новый Структура;
		ДанныеОформления.Вставить("ЭлементОтбора" , "ДеревоФильтров.Пометка");
		ДанныеОформления.Вставить("Оформление"    , "ЦветТекста");
		ДанныеОформления.Вставить("Значение"      , WebЦвета.Серый);
		ДанныеОформления.Вставить("ПолеОформления", "ДеревоФильтровЗначение");
		ДанныеОформления.Вставить("ВидСравнения"  , ВидСравненияКомпоновкиДанных.Равно);
		ДанныеОформления.Вставить("ПравоеЗначение", Ложь);
		ВсегоЭлементов.Добавить(ДанныеОформления);
		
		ДанныеОформления = Новый Структура;
		ДанныеОформления.Вставить("ЭлементОтбора" , "ДеревоФильтров.ГруппаНастроек");
		ДанныеОформления.Вставить("Оформление"    , "Шрифт");
		ДанныеОформления.Вставить("Значение"      , Новый Шрифт(ШрифтыСтиля.ОбычныйШрифтТекста, "ЭКОМ_ШрифтФильтра", 10, Истина, Ложь));  
		ДанныеОформления.Вставить("ПолеОформления", "ДеревоФильтровЗначение");
		ДанныеОформления.Вставить("ВидСравнения"  , ВидСравненияКомпоновкиДанных.Заполнено);
		ДанныеОформления.Вставить("ПравоеЗначение", "");
		ВсегоЭлементов.Добавить(ДанныеОформления);	
		
		ДанныеОформления = Новый Структура;
		ДанныеОформления.Вставить("ЭлементОтбора" , "ДеревоФильтров.Значение");
		ДанныеОформления.Вставить("Оформление"    , "ЦветТекста");
		ДанныеОформления.Вставить("Значение"      , WebЦвета.Синий);
		ДанныеОформления.Вставить("ПолеОформления", "ДеревоФильтровЗначение");
		ДанныеОформления.Вставить("ВидСравнения"  , ВидСравненияКомпоновкиДанных.Равно);
		ДанныеОформления.Вставить("ПравоеЗначение", "Добавить отбор");	
		ВсегоЭлементов.Добавить(ДанныеОформления);	
		
		Для каждого ЭлементМассива Из ВсегоЭлементов Цикл
			
			НовыйЭлементУсловногоОформления                  = УсловноеОформление.Элементы.Добавить();
			НовыйЭлементУсловногоОформления.Использование    = Истина;
			НовыйЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра(ЭлементМассива.Оформление, ЭлементМассива.Значение);
			
			ЭлементОтбора                                    = НовыйЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбора.ЛевоеЗначение                      = Новый ПолеКомпоновкиДанных(ЭлементМассива.ЭлементОтбора);
			ЭлементОтбора.ПравоеЗначение                     = ЭлементМассива.ПравоеЗначение;;
			ЭлементОтбора.ВидСравнения                       = ЭлементМассива.ВидСравнения;
			ЭлементОтбора.Использование                      = Истина;                                                       
			
			ПолеОформления = НовыйЭлементУсловногоОформления.Поля.Элементы.Добавить();
			ПолеОформления.Поле = Новый ПолеКомпоновкиДанных(ЭлементМассива.ПолеОформления);
			ПолеОформления.Использование = Истина; 	
			
		КонецЦикла;	
		
		// Добавляем профили обмена при первом запуске
		ОбработкаОбъект.ДобавитьПрофилиОбменаДляСовместимости();
		
	КонецЕсли;
	
	ЭтаФорма.ПериодНачалоЛога = ТекущаяДата();
	ЭтаФорма.ПериодКонецЛога  = ТекущаяДата();
	
	ЭКОМ_ОбщегоНазначения.ОбработатьНовости();
				
	Если МассивЛогаСобытий.Количество() > 0  Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий)");
		Сообщение.Сообщить();
	КонецЕсли;
	
	Если Не ОбработкаОбъект.ПолучитьДоступностьApiПоСтране() Тогда
		Элементы.ГруппаПодменюПечать.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаполненнаяЗаписьЛогаОбщийМодуль(ТекстЛогаСобытий, УровеньЛогирования, ИмяСобытия)	
	ЗаписьСтруктурыЛога = Вычислить("ЭКОМ_ОбщегоНазначения.ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, УровеньЛогирования, ИмяСобытия)");
	Возврат ЗаписьСтруктурыЛога;
	
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Не открываем обработку
	Если ЭтаФорма.ОбработкаДоступна = Ложь Тогда
		
		Если ЗначениеЗаполнено(ЭтаФорма.СообщениеТекст)  Тогда
		     ПоказатьПредупреждение(, ЭтаФорма.СообщениеТекст);
		КонецЕсли;
		
		Закрыть();
		Возврат;
	КонецЕсли;

	МассивЛогаСобытий = Новый Массив;
	УстановленыВсеОбъектыЭКОМ = УстановкаОбъектовКонфигурацииЭКОМ(МассивЛогаСобытий);
	Если УстановленыВсеОбъектыЭКОМ = Ложь Тогда
		ТекстСообщения = "";
		
		Для каждого Запись Из МассивЛогаСобытий Цикл
			Если ЗначениеЗаполнено(Запись.Комментарий) Тогда
				ТекстСообщения = ТекстСообщения + ?(ЗначениеЗаполнено(ТекстСообщения), Символы.ПС, "") + Запись.Комментарий;
			КонецЕсли;		
		КонецЦикла;
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстСообщения;
		Сообщение.Сообщить();

	КонецЕсли;
	
	УстановитьАктивныеПрофили();
	
	УстановитьВсеПараметрыДинамическогоСписка("СписокДляПоставщика");
    УстановитьВсеПараметрыДинамическогоСписка("СписокДляПокупателя");
    УстановитьВсеПараметрыДинамическогоСписка("СписокДляЭТРН");
	УстановитьВсеПараметрыДинамическогоСписка("СписокДляCondra");
	УстановитьВсеПараметрыДинамическогоСписка("СписокДляПрайсЛиста");
    УстановитьВсеПараметрыДинамическогоСписка("ТаблицаПалет");

	// Открываем настройки для заполнения если открываем впервые
	Если Элементы.Группа_Поставщик.Видимость = Ложь
		И Элементы.Группа_Покупатель.Видимость = Ложь
		//Docrobot 1.20.0 MOD-1559 [добавлена проверка на прайс]
		//И Элементы.ГруппаВходящийПрайсЛист.Видимость = Ложь
		//И Элементы.ГруппаИсходящийПрайсЛист.Видимость = Ложь
		//+Лысковец 20220201 MOD-1559
		И Элементы.ГруппаПрайсЛист.Видимость = Ложь
		//-
		И Элементы.Группа_ЭТРН.Видимость = Ложь
		И Элементы.Группа_Condra.Видимость = Ложь Тогда
		
		ПараметрыФормы = Новый Структура;
		
		ПараметрыФормы.Вставить("ЭКОМОбъектыАктуальны", 					ЭтаФорма.ЭКОМОбъектыАктуальны);
		ПараметрыФормы.Вставить("ДополнительнаяОбработкаСсылка",			ЭтаФорма.ОбъектСсылка);
		ПараметрыФормы.Вставить("РежимИспользования", 						РежимИспользования);
		ПараметрыФормы.Вставить("ИспользуемоеИмяФайла", 	ЭтаФорма.ИспользуемоеИмяФайла);

		
		ОткрытьФорму(ПолноеИмяОбработки + ".Форма.УФ_ФормаНастройкиОсновные",ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
		ПоказатьПредупреждение(, "Заполните настройки!");
		
	КонецЕсли;
   
    СоздатьЛокальныеКаталогиНаКлиенте(МассивЛогаСобытий);
	    
    Если НЕ ПустаяСтрока(БекапАдресНастроек) Тогда
        ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(БекапАдресНастроек);
        ДвоичныеДанныеФайла.Записать(БекапИмяФайлаНастроек);
		
		ТекстЛогаСобытий = "Выполнено обновление шаблонов настроек. Копия настроек до изменений сохранена в " + БекапИмяФайлаНастроек;
		ЗаписьСтруктурыЛога = Вычислить("ЭКОМ_ОбщегоНазначенияКлиент.ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение(""Перечисление.ЭКОМ_УровниЛогирования.Предупреждение""), ""Открытие формы"")");
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

    КонецЕсли;
	
	// По умолчанию при открытии скрыто
	Элементы.ГруппаДинамическийФильтр.Видимость = Ложь;
	
	ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();
	УстановитьВидимостьПоТекущейСтранице(ДанныеСписка.ИмяРеквизитаТаблицы);
    ВыбраннаяСтрока = Элементы[ДанныеСписка.ИмяСписка].ТекущиеДанные;
	
	ОбновитьТаблицуПалетНаКлиенте(ДанныеСписка.ИмяСписка);
    
    Если ПустаяСтрока(СообщениеТекст) = Ложь Тогда
        Сообщение 		= Новый СообщениеПользователю;
        Сообщение.Текст = СообщениеТекст;
        Сообщение.Сообщить();
    КонецЕсли;
      	
	Оповещение = Новый ОписаниеОповещения;
    ОткрытьФорму(ПолноеИмяОбработки + ".Форма.УФ_Приветствие",,,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);

    Если ВыбраннаяСтрока <> Неопределено Тогда
        ОбновитьКвитанцииНаКлиенте(ДанныеСписка.ИмяСписка);
    КонецЕсли;
	
	// Для периода заказа
	
	ДанныеСпискаКлюч = "Используется, ТекущаяСтраницаИмя";
	
	АктивныеОбмены = Новый Соответствие;
	АктивныеОбмены.Вставить("СписокДляПоставщика", Новый Структура(ДанныеСпискаКлюч, Элементы.Группа_Поставщик.Видимость , "Группа_Поставщик"));
	АктивныеОбмены.Вставить("СписокДляПокупателя", Новый Структура(ДанныеСпискаКлюч, Элементы.Группа_Покупатель.Видимость, "Группа_Покупатель"));
	АктивныеОбмены.Вставить("СписокДляЭТРН"      , Новый Структура(ДанныеСпискаКлюч, Элементы.Группа_ЭТРН.Видимость      , "Группа_ЭТРН")); 
	АктивныеОбмены.Вставить("СписокДляCondra"    , Новый Структура(ДанныеСпискаКлюч, Элементы.Группа_Condra.Видимость    , "Группа_Condra"));	
	АктивныеОбмены.Вставить("СписокДляПрайсЛиста", Новый Структура(ДанныеСпискаКлюч, Элементы.ГруппаПрайсЛист.Видимость  , "ГруппаПрайсЛист"));
	
	УстановитьПериоды(АктивныеОбмены);
	
	Если УстановленыВсеОбъектыЭКОМ = Истина Тогда
		СоздатьДинамическийСписокДобавитьДинамическиеКнопки(МассивЛогаСобытий);
	КонецЕсли;
	ОтобразитьЛогСобытий(МассивЛогаСобытий);
	
	Если ЭтаФорма.ПанельСвернута = Истина Тогда 
		Элементы.ГруппаПодвал.Скрыть();		
	Иначе	
	    Элементы.ГруппаПодвал.Показать();
	КонецЕсли;
	
	// Сортировка
	ОтобразитьСортировку(ДанныеСписка);
	
	Если МассивЛогаСобытий.Количество() > 0  Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.ИдентификаторНазначения = ЭтаФорма.УникальныйИдентификатор;
		Сообщение.Текст = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий)");
		Сообщение.Сообщить();
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ПоказатьНовости", 3, Истина);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьАктивныеПрофили()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЭКОМ_GLN.Объект,
		|	ЭКОМ_GLN.ПрофильОбмена
		|ИЗ
		|	РегистрСведений.ЭКОМ_GLN КАК ЭКОМ_GLN
		|ГДЕ
		|	ЭКОМ_GLN.Объект.ПометкаУдаления = ЛОЖЬ
		|	И ЭКОМ_GLN.ПрофильОбмена.ПометкаУдаления = ЛОЖЬ
		|	И ЭКОМ_GLN.ПрофильОбмена.Активный = ЛОЖЬ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыбЗап = РезультатЗапроса.Выбрать();
	
	Пока ВыбЗап.Следующий() Цикл
		Проф = ВыбЗап.ПрофильОбмена.ПолучитьОбъект();
		Проф.Активный = Истина;
		Проф.Записать();
	КонецЦикла;
	
КонецПроцедуры

// Открывает форму новостей. Запускается из обработчика ПриОткрытии()
//
&НаКлиенте
Процедура ПоказатьНовости()
	
	ОткрытьФорму(ПолноеИмяОбработки + ".Форма.УФ_Новости", , ЭтаФорма, "ФормаНовостей");

КонецПроцедуры // ПоказатьНовости()

&НаКлиенте
Процедура ОтобразитьСортировку(ДанныеСписка)
	ИдентификаторПорядок = ЭтаФорма[ДанныеСписка.ИмяРеквизитаТаблицы].КомпоновщикНастроек.Настройки.Порядок.ИдентификаторПользовательскойНастройки;
	Если НЕ ЗначениеЗаполнено(ИдентификаторПорядок) Тогда
		ИдентификаторПорядок = СокрЛП(Новый УникальныйИдентификатор);
		ЭтаФорма[ДанныеСписка.ИмяРеквизитаТаблицы].КомпоновщикНастроек.Настройки.Порядок.ИдентификаторПользовательскойНастройки = ИдентификаторПорядок;
	КонецЕсли;
	ПользовательскийПорядок  = ЭтаФорма[ДанныеСписка.ИмяРеквизитаТаблицы].КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ИдентификаторПорядок);
	ЭлементЗначениеПараметра = ЭтаФорма[ДанныеСписка.ИмяРеквизитаТаблицы].КомпоновщикНастроек.ПользовательскиеНастройки.ПолучитьИдентификаторПоОбъекту(ПользовательскийПорядок);
	
	ИмяНастроекПорядка = СокрЛП(ДанныеСписка.ИмяРеквизитаТаблицы) + "КомпоновщикНастроекПользовательскиеНастройки";
	Элементы[ИмяНастроекПорядка].ТекущаяСтрока = ЭлементЗначениеПараметра;
	Элементы[ИмяНастроекПорядка].ДанныеСтроки(ЭлементЗначениеПараметра);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериоды(АктивныеОбмены)
	
	Настройки = ПолучитьПользовательскиеНастройки(ТекущийПользователь);
	
	Для каждого Стр Из АктивныеОбмены Цикл
		
		Используется        = Стр.Значение.Используется;
		ИмяРеквизитаТаблицы = Стр.Ключ;
		ТекущаяСтраницаИмя  = Стр.Значение.ТекущаяСтраницаИмя;
		Если Используется = Истина Тогда
			
			ИдентификаторПользовательскойНастройки = ЭтаФорма[ИмяРеквизитаТаблицы].КомпоновщикНастроек.Настройки.Отбор.ИдентификаторПользовательскойНастройки;
			Если НЕ ЗначениеЗаполнено(ИдентификаторПользовательскойНастройки) Тогда
				ИдентификаторПользовательскойНастройки = СокрЛП(Новый УникальныйИдентификатор);
				ЭтаФорма[ИмяРеквизитаТаблицы].КомпоновщикНастроек.Настройки.Отбор.ИдентификаторПользовательскойНастройки = ИдентификаторПользовательскойНастройки;
			КонецЕсли;
	 
			ПользовательскийОтбор = ЭтаФорма[ИмяРеквизитаТаблицы].КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ИдентификаторПользовательскойНастройки);
			Если НЕ ПользовательскийОтбор = Неопределено Тогда
				
				ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте(ТекущаяСтраницаИмя);
				
				ОбязательныеОтборы = Новый Массив;
				ОбязательныеОтборы.Добавить("Организация");
				ОбязательныеОтборы.Добавить("Контрагент");
				ОбязательныеОтборы.Добавить("ТочкаДоставки");
				ОбязательныеОтборы.Добавить("ДатаЗаказа");
				ОбязательныеОтборы.Добавить("ДатаЭТРН");
				ОбязательныеОтборы.Добавить("Дата");
				СоздатьПользовательскиеНастройки(ДанныеСписка, ОбязательныеОтборы);
				
				Для каждого Отбор ИЗ ПользовательскийОтбор.Элементы Цикл
					
					// Для периода 
					Если Найти(Отбор.Представление, "Программный отбор") > 0 Тогда			
						
						Если ТипЗнч(Отбор) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда		
							
							// Поиск именно для периода
							Если Отбор.ПредставлениеПользовательскойНастройки = "ДатаЗаказа"
								ИЛИ (ИмяРеквизитаТаблицы = "СписокДляЭТРН" И Отбор.ПредставлениеПользовательскойНастройки = "ДатаЭТРН")
								ИЛИ (ИмяРеквизитаТаблицы = "СписокДляCondra" И Отбор.ПредставлениеПользовательскойНастройки = "Дата")
								ИЛИ (ИмяРеквизитаТаблицы = "СписокДляПрайсЛиста" И Отбор.ПредставлениеПользовательскойНастройки = "Дата") Тогда
								
								Для каждого Эл Из Отбор.Элементы Цикл
									Если Эл.ВидСравнения 		= ВидСравненияКомпоновкиДанных.БольшеИлиРавно Тогда
										
										ДатаНачалаОтбора 		= Неопределено;
										Если НЕ Настройки.Свойство(ИмяРеквизитаТаблицы + "ДатаНачалаОтбора", ДатаНачалаОтбора) Тогда
											ДатаНачалаОтбора    = НачалоДня(ТекущаяДата() - 7*60*60*24);  // 7 дней от текущей даты
										КонецЕсли;
										
										Эл.ПравоеЗначение 		= ДатаНачалаОтбора;
										
									ИначеЕсли Эл.ВидСравнения 	= ВидСравненияКомпоновкиДанных.МеньшеИлиРавно Тогда
										
										ДатаОкончанияОтбора 	= Неопределено;
										Если НЕ Настройки.Свойство(ИмяРеквизитаТаблицы + "ДатаОкончанияОтбора", ДатаОкончанияОтбора) Тогда
											ДатаОкончанияОтбора	= КонецДня(ТекущаяДата());
										КонецЕсли;
										
										Эл.ПравоеЗначение		= ДатаОкончанияОтбора;
										
									КонецЕсли;
								КонецЦикла;
								
								Использование 		= Неопределено;
								Если НЕ Настройки.Свойство(ИмяРеквизитаТаблицы + "Использование", Использование) Тогда
									Использование	= Истина;
								КонецЕсли;
								
								Отбор.Использование = Использование;
								
								Прервать;
								
							КонецЕсли;		
							
						КонецЕсли;
						
					КонецЕсли;	
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;    
	
КонецПроцедуры

&НаКлиенте
Процедура СписокДляПоставщикаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
    
    Если Элемент = Неопределено 
		Или Элемент.ТекущиеДанные = Неопределено 
		Или ВыбраннаяСтрока = Неопределено Тогда
        Возврат;
    КонецЕсли;
    СтандартнаяОбработка = Ложь;
	
	ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();
	Если Поле.Имя = ДанныеСписка.ИмяСписка + "Пометка" Тогда
		
		Если Не Элемент.ТекущиеДанные = Неопределено Тогда
			ДокументыЦепочки = МассивИменДокументовЦепочкиПоставщика();
			Если Элемент.ТекущиеДанные.Пометка Тогда
				СнятьПометку(Элемент.ТекущиеДанные.ДокументыВсе);
				Для Каждого ИмяДокумента Из ДокументыЦепочки Цикл
					Если Элемент.ТекущиеДанные.Свойство(ИмяДокумента) Тогда 
						СнятьПометку(Элемент.ТекущиеДанные[ИмяДокумента]);
					КонецЕсли;
				КонецЦикла;
			Иначе
				ПоставитьПометку(Элемент.ТекущиеДанные.ДокументыВсе);
			КонецЕсли;
		КонецЕсли;
		
		//Параметр в динамическом списке нужно обновить
		УстановитьПараметрДинамическогоСписка(ДанныеСписка.ИмяРеквизитаТаблицы, "масПомеченныхДоков", СписокВыбранныхСтрок.ВыгрузитьЗначения());
    
   ИначеЕсли Поле.Имя = "СписокДляПоставщикаСтатус" ИЛИ
        Поле.Имя = "СписокДляПоставщикаСтатус_ORDER" ИЛИ
        Поле.Имя = "СписокДляПоставщикаСтатус_ORDRSP" ИЛИ
        Поле.Имя = "СписокДляПоставщикаСтатус_DESADV" ИЛИ 
        Поле.Имя = "СписокДляПоставщикаСтатус_RECADV" ИЛИ 
        Поле.Имя = "СписокДляПоставщикаСтатус_DESSCC" ИЛИ
		Поле.Имя = "СписокДляПоставщикаСтатус_RETANN" ИЛИ 
        Поле.Имя = "СписокДляПоставщикаСтатус_RETINS" ИЛИ
		Поле.Имя = "СписокДляПоставщикаСтатус_INVOICE" ИЛИ
        Поле.Имя = "СписокДляПоставщикаСтатус_УПД" Тогда
                
        ВыбраннаяСтрока = Элемент.ТекущиеДанные;
        СписокДокументов = ПолучитьСписокДокументов(ВыбраннаяСтрока, ДанныеСписка.ИмяСписка);
        
        Форма = ОткрытьФорму("РегистрСведений.ЭКОМ_Объекты_События.Форма.УФ_ФормаСписка");
        ОтборВладелец = Форма.Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); //Добавлям отбор
        ОтборВладелец.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке; //Как будем сравнивать
        ОтборВладелец.Использование  = Истина; // Устанавливаем галку использованияНовый ПолеКомпоновкиДанных("Номенклатура")
        ОтборВладелец.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Документ_Основание"); //По какому реквизиту будем делать отбор
        ОтборВладелец.ПравоеЗначение = СписокДокументов; // И само значение отбора
        
        УсловиеСортировки = Форма.Список.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
        УсловиеСортировки.Поле = Новый ПолеКомпоновкиДанных("ДатаЗаписи");
        УсловиеСортировки.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Возр;
        УсловиеСортировки.Использование = Истина;
        
    ИначеЕсли Поле.Имя = "СписокДляПоставщикаПалеты" Тогда
        
        // ---> Chernyatin Andrey  10 октября 2019 г.
        ВыбраннаяСтрока    = Элемент.ТекущиеДанные;
        ДокументРеализации = ВыбраннаяСтрока.ДокументРеализации;
        
        Если ЗначениеЗаполнено(ДокументРеализации) Тогда
            
			ЗначениеПоУмолчанию = Неопределено;
			Измерение           = Неопределено; 
			Обязательно         = Ложь;
			ДокументСсылкаИмя = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_ВидРеализацииПоставщик"", ЗначениеПоУмолчанию, Измерение, Обязательно)");
			
			ПараметрыФормыDesscc = Новый Структура;
			ПараметрыФормыDesscc.Вставить("ДокументСсылкаИмя", ДокументСсылкаИмя);
			ПараметрыФормыDesscc.Вставить("ДокументСсылка"   , ДокументРеализации);	
			ЭКОМ_Документ_ORDER = Неопределено;
			Если ЗначениеЗаполнено(ВыбраннаяСтрока.ЭКОМ_Документ_ORDER) Тогда
			     ЭКОМ_Документ_ORDER = ВыбраннаяСтрока.ЭКОМ_Документ_ORDER;
			КонецЕсли;
			ПараметрыФормыDesscc.Вставить("ЭКОМ_Документ_ORDER", ЭКОМ_Документ_ORDER);
           
            Оповещение = Новый ОписаниеОповещения("ОбработатьВыборПалеты", ЭтаФорма);
            ОткрытьФорму(ПолноеИмяОбработки + ".Форма.УФ_ФормаDesscc", ПараметрыФормыDesscc, ЭтаФорма,,,, Оповещение);
            
        КонецЕсли;
        // <--- Chernyatin Andrey  10 октября 2019 г.
		
	ИначеЕсли Поле.Имя = "СписокДляПоставщикаТекстОшибки" Тогда
        
        Подсказка = "Текст ошибки";
        Оповещение = Новый ОписаниеОповещения("ЗавершениеПросмотраТекстОшибки", ЭтаФорма);
        ПоказатьВводСтроки(Оповещение, Элемент.ТекущиеДанные.ТекстОшибки, Подсказка, 0, Истина);
		
	ИначеЕсли Поле.Имя = "СписокДляПоставщикаТекстУточнения" Тогда
        
        Подсказка = "Текст уточнения";
        Оповещение = Новый ОписаниеОповещения("ЗавершениеПросмотраТекстОшибки", ЭтаФорма);
        ПоказатьВводСтроки(Оповещение, Элемент.ТекущиеДанные.ТекстУточнения, Подсказка, 0, Истина);
		
	ИначеЕсли Поле.Имя = "СписокДляПоставщикаТекстОтклоненияАннулирования" Тогда
		
		Подсказка = "Текст отклонения аннулирования";
		Оповещение = Новый ОписаниеОповещения("ЗавершениеПросмотраТекстОшибки", ЭтаФорма);
		ПоказатьВводСтроки(Оповещение, Элемент.ТекущиеДанные.ТекстОтклоненияАннулирования, Подсказка, 0, Истина);
		
		
	ИначеЕсли Поле.Имя = "СписокДляПоставщикаТекстПричиныАннулирования" Тогда
		
		Подсказка = "Текст причины аннулирования";
		Оповещение = Новый ОписаниеОповещения("ЗавершениеПросмотраТекстОшибки", ЭтаФорма);
		ПоказатьВводСтроки(Оповещение, Элемент.ТекущиеДанные.ТекстПричиныАннулирования, Подсказка, 0, Истина);
		
	ИначеЕсли Поле.Имя = "СписокДляПоставщикаТранспорт" Тогда
		Отбор = Новый Структура;
		Отбор.Вставить("Документ", Элемент.ТекущиеДанные.ДокументРеализации);
		
		КлючЗаписи = ПолучитьКлючЭКОМ_ТранспортнаяИнформация(Отбор); 
		Структура = Новый Структура("Ключ", КлючЗаписи);		
		Если КлючЗаписи = Неопределено Тогда	
			ОткрытьФорму("РегистрСведений.ЭКОМ_ТранспортнаяИнформация.ФормаЗаписи", Отбор,,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		Иначе			
			ОткрытьФорму("РегистрСведений.ЭКОМ_ТранспортнаяИнформация.ФормаЗаписи", Структура,,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		КонецЕсли;
    КонецЕсли;
	
	ЭлементОбъект = ОпределитьТипОбъекта(Элемент, Поле.Имя);
    Если ЗначениеЗаполнено(ЭлементОбъект) Тогда
        ПоказатьЗначение( , ЭлементОбъект);
    КонецЕсли;             
    
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборПалеты(Результат, Данные) Экспорт
    
    Элементы.СписокДляПоставщика.Обновить();
    Элементы.СписокДляПокупателя.Обновить();
    
КонецПроцедуры

&НаКлиенте
Процедура СписокДляПоставщикаПриАктивизацииСтроки(Элемент)
	Если НЕ Элементы.ОсновнаяПанель.ТекущаяСтраница = Элементы.Группа_Поставщик Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ТекущийЭлемент.Имя = "КомандаФильтрыИМеню" Тогда
		ОбновитьЦепочкуДокументовИКвитанцииНаКлиенте("СписокДляПоставщика");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СписокДляПокупателяПриАктивизацииСтроки(Элемент)
	Если НЕ Элементы.ОсновнаяПанель.ТекущаяСтраница = Элементы.Группа_Покупатель Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ТекущийЭлемент.Имя = "КомандаФильтрыИМеню" Тогда
		ОбновитьЦепочкуДокументовИКвитанцииНаКлиенте("СписокДляПокупателя");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СписокДляЭТРНПриАктивизацииСтроки(Элемент)
	Если НЕ Элементы.ОсновнаяПанель.ТекущаяСтраница = Элементы.Группа_ЭТРН Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ТекущийЭлемент.Имя = "КомандаФильтрыИМеню" Тогда
		ОбновитьЦепочкуДокументовИКвитанцииНаКлиенте("СписокДляЭТРН");
		ОбновитьТаблицуПалетНаКлиенте("СписокДляЭТРН");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СписокДляCondraПриАктивизацииСтроки(Элемент)
	
	Если НЕ Элементы.ОсновнаяПанель.ТекущаяСтраница = Элементы.Группа_Condra Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ТаблицаЦепочкаДокументов.Видимость = Истина;
	Элементы.ТаблицаКвитанций.Видимость         = Ложь;
	Элементы.ТаблицаПалет.Видимость             = Ложь;
	
	Если НЕ ТекущийЭлемент.Имя = "КомандаФильтрыИМеню" Тогда
    	ОбновитьЦепочкуДокументовИКвитанцииНаКлиенте("СписокДляCondra");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДействияПриАктивизацииСтрокиСписка(Элемент)

    Если Элемент.ТекущиеДанные = Неопределено Или Элемент.ТекущаяСтрока = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    ОбновитьЦепочкуДокументовИКвитанцииНаКлиенте(Элемент.Имя);
    
КонецПроцедуры

&НаКлиенте
Процедура ОсновнаяПанельПриСменеСтраницы(НоваяАктивнаяСтраница)
	
	// Очищаем пометки при смене страницы
	СписокВыбранныхСтрок.Очистить();
	
	ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();
	
	МассивЛогаСобытий = Новый Массив;
	УстановитьВидимостьПоТекущейСтранице(ДанныеСписка.ИмяРеквизитаТаблицы);
	СоздатьДинамическийСписокДобавитьДинамическиеКнопки(МассивЛогаСобытий);
    ОбновитьДинамическийСписок(ДанныеСписка);
	
	//ЭтаФорма.ДеревоФильтров.ПолучитьЭлементы().Очистить();
	//СоздатьСоставПользовательскихНастроекНаСервере(ДанныеСписка);
	//СоздатьДеревоПользовательскихНастроекНаСервере(ДанныеСписка, Новый Массив);
	
	ОбновитьЦепочкуДокументовНаКлиенте(ДанныеСписка.ИмяСписка);
    ОбновитьКвитанцииНаКлиенте(ДанныеСписка.ИмяСписка);		
	
	Если МассивЛогаСобытий.Количество() > 0  Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Вычислить("ЭКОМ_ОбщегоНазначенияКлиент.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий)");
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЦепочкаДокументовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
    
    СтандартнаяОбработка = Ложь;
    
    Док = Неопределено; 	
    Если Поле.Имя = "ТаблицаЦепочкаДокументовДокумент" Тогда	
        
        Док = Элемент.ТекущиеДанные.Документ;	
        
    КонецЕсли;
    
    Если ЗначениеЗаполнено(Док) Тогда
        ПоказатьЗначение( , Док);
    КонецЕсли; 
    
КонецПроцедуры

&НаКлиенте
Функция ПолучитьФормуОбработки(ИмяФормы, ПараметрыФормы = Неопределено , ВладелецФормы  = Неопределено, КлючУникальности = Истина, ЗакрыватьПризакрытииВладельца = Ложь)
    
    ПолучаемаяФорма=	ПолучитьФорму(ПолноеИмяОбработки + ".Форма." + ИмяФормы
    , ПараметрыФормы
    , 
    , КлючУникальности);
    
    Возврат ПолучаемаяФорма;
    
КонецФункции

#КонецОбласти


