&НаСервереБезКонтекста
Функция НастройкаПрочитатьОбщийМодуль(ИмяНастройки, ЗначениеПоУмолчанию, Измерение, Обязательно)
	Результат = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(ИмяНастройки, ЗначениеПоУмолчанию, Измерение, Обязательно)");	
   	Возврат Результат;
КонецФункции

&НаКлиенте
Функция УстановкаОбъектовКонфигурацииЭКОМ(МассивЛогаСобытий)
	
	СписокКонопок = Новый СписокЗначений;
	СписокКонопок.Добавить("СкачатьОбновление", "Скачать обновление");
	СписокКонопок.Добавить("Отмена", "Отмена");

	Данные = Новый Структура;
	Данные.Вставить("Действие"            , "Обновление");
	Данные.Вставить("ЭКОМОбъектыАктуальны", ЭтаФорма.ЭКОМОбъектыАктуальны);
	
	УстановленыВсеОбъектыЭКОМ = Ложь;
	
	СписокОтсутствующихОбъектов = "";
	Если ЭтаФорма.ЭКОМОбъектыАктуальны = Ложь Тогда	
		ДанныеОС        = ЭКОМ_ПолучитьРазделительПутиОСКлиента();
		Диск            = ДанныеОС.Получить("Диск");
		РазделительПути = ДанныеОС.Получить("РазделительПути");	
		ЛокальныйКаталогUPDATE = ОпределитьКаталогПоУмолчанию(Диск, РазделительПути);
	    ЭКОМ_СоздатьКаталог(ЛокальныйКаталогUPDATE, ДанныеОС);
 
	Иначе
		ЗначениеПоУмолчанию = Неопределено;
		Измерение           = Неопределено; 
		Обязательно         = Истина;
		ЛокальныйКаталогUPDATE = НастройкаПрочитатьОбщийМодуль("ЭКОМ_Локальный_Каталог_UPDATE", ЗначениеПоУмолчанию, Измерение, Обязательно);
		
		ЗначениеПоУмолчанию = Ложь;
		Измерение           = Неопределено; 
		Обязательно         = Ложь;
		ЭКОМ_Автообновление = НастройкаПрочитатьОбщийМодуль("ЭКОМ_Автообновление", ЗначениеПоУмолчанию, Измерение, Обязательно);
		НеобходимоОбновление =  Ложь;
		Если ЭКОМ_Автообновление = Истина Тогда		
			
			Результат = ПроверитьОбновлениеНаКлиенте(ЭтаФорма.ЭКОМОбъектыАктуальны, ЛокальныйКаталогUPDATE, МассивЛогаСобытий);
			НеобходимоОбновление	= Результат.НеобходимоОбновление;
			
			Если НеобходимоОбновление Тогда
				
				Данные.Вставить("ВерсияМодуля"   , Результат.ВерсияМодуля);	
				Данные.Вставить("ДатаОбработки"  , Результат.ДатаОбработки);	
				Данные.Вставить("Описание"       , Результат.Описание);	
				Данные.Вставить("СтатусОбработки", ?(Результат.Свойство("СтатусОбработки"), Результат.СтатусОбработки, ""));	      
				
			КонецЕсли;		
		КонецЕсли;
		
		ОтсутствующиеОбъекты = ЕстьОбъектыЭКОМ(ЭтаФорма.ОбработкаТип);
		УстановленыВсеОбъектыЭКОМ = (ОтсутствующиеОбъекты.Количество() = 0);
		Для каждого Стр Из ОтсутствующиеОбъекты Цикл
			СписокОтсутствующихОбъектов = СписокОтсутствующихОбъектов + ?(ЗначениеЗаполнено(СписокОтсутствующихОбъектов), Символы.ПС, "") + Стр.Ключ;
		КонецЦикла;
        
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СписокОтсутствующихОбъектов) Тогда		
		ТекстЛогаСобытий = СписокОтсутствующихОбъектов;
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Ошибка"), "Проверка объектов конфигурации");
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЛокальныйКаталогUPDATE) = Истина Тогда
		КаталогUpdateФС = Новый Файл(ЛокальныйКаталогUPDATE);
		Если КаталогUpdateФС.Существует() 
			И УстановленыВсеОбъектыЭКОМ = Истина Тогда 
			СписокКонопок.Добавить("ОткрытьПредВерсию", "Открыть пред. версию обработки");
			СписокКонопок.Добавить("ОткрытьКаталог", "Открыть папку с обновлениями");
		КонецЕсли;
	КонецЕсли;

	Данные.Вставить("ЛокальныйКаталогUPDATE", ЛокальныйКаталогUPDATE);
	Данные.Вставить("МассивЛогаСобытий"            , МассивЛогаСобытий);
	Если УстановленыВсеОбъектыЭКОМ = Ложь Тогда	       
        Оповещение = Новый ОписаниеОповещения("УстановкаОбъектовКонфигурацииЭКОМ_Завершение", ЭтаФорма, Данные);
        ПоказатьВопрос(Оповещение, "Необходимо обновить объекты конфигурации.", СписокКонопок, , , "Требуется обновление.");
		
	ИначеЕсли ЭтаФорма.ЭКОМОбъектыАктуальны = Ложь Тогда
		Оповещение = Новый ОписаниеОповещения("УстановкаОбъектовКонфигурацииЭКОМ_Завершение", ЭтаФорма, Данные);
        ПоказатьВопрос(Оповещение, "Доступна новая версия. Обновить?", СписокКонопок, , , "Доступно обновление.");
		
	ИначеЕсли НеобходимоОбновление Тогда
		Оповещение = Новый ОписаниеОповещения("УстановкаОбъектовКонфигурацииЭКОМ_Завершение", ЭтаФорма, Данные);
        ПоказатьВопрос(Оповещение, "Доступна новая версия. Обновить?", СписокКонопок, , , "Доступно обновление.");
			
	КонецЕсли;
    	
	Возврат УстановленыВсеОбъектыЭКОМ;
	
КонецФункции

&НаКлиенте
Процедура УстановкаОбъектовКонфигурацииЭКОМ_Завершение(Ответ, ДополнительныеПараметры) Экспорт
    
	МассивЛогаСобытий = ДополнительныеПараметры.МассивЛогаСобытий;
	
    Если Ответ = "ОткрытьКаталог" Тогда
		
		ЗначениеПоУмолчанию = Неопределено;
		Измерение           = Неопределено; 
		Обязательно         = Истина;
		ЛокальныйКаталог = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_Локальный_Каталог_UPDATE"", ЗначениеПоУмолчанию, Измерение, Обязательно)");
        Если ЛокальныйКаталог = Неопределено Тогда
            Сообщение = Новый СообщениеПользователю;
            Сообщение.Текст = "В настройках не указан каталог для хранения обновлений.";
            Сообщение.Сообщить();
        Иначе
            ЗапуститьПриложение(ЛокальныйКаталог);
        КонецЕсли;
        
    ИначеЕсли Ответ = "ОткрытьПредВерсию" Тогда
        ОткрытьПредыдущуюВерсиюОбработки();
		
	ИначеЕсли Ответ = "СкачатьОбновление" Тогда
		
		Результат = ПроверитьОбновлениеНаКлиенте(ДополнительныеПараметры.ЭКОМОбъектыАктуальны, ДополнительныеПараметры.ЛокальныйКаталогUPDATE, МассивЛогаСобытий);
	
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ВерсияМодуля"   , Результат.ВерсияМодуля);	
		ПараметрыФормы.Вставить("ДатаОбработки"  , Результат.ДатаОбработки);	
		ПараметрыФормы.Вставить("Описание"       , Результат.Описание);	
		ПараметрыФормы.Вставить("СтатусОбработки", Результат.СтатусОбработки);
		ПараметрыФормы.Вставить("ЛокальныйКаталогUPDATE", ДополнительныеПараметры.ЛокальныйКаталогUPDATE);
		ПараметрыФормы.Вставить("СтатусОбработки", Результат.СтатусОбработки);
		ПараметрыФормы.Вставить("ЭКОМОбъектыАктуальны", ДополнительныеПараметры.ЭКОМОбъектыАктуальны);
		
		ОткрытьФорму(ПолноеИмяОбработки + ".Форма.УФ_ФормаОбновления", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
    КонецЕсли;	
    
    Если МассивЛогаСобытий.Количество() > 0 Тогда
        Сообщение = Новый СообщениеПользователю;
        Сообщение.Текст = Вычислить("ЭКОМ_ОбщегоНазначенияКлиент.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий)");
        Сообщение.Сообщить();
    КонецЕсли;
    
КонецПроцедуры

&НаКлиенте
Функция ПроверитьОбновлениеНаКлиенте(ЭКОМОбъектыАктуальны, ЛокальныйКаталогUPDATE, МассивЛогаСобытий) 
	
	Результат = Новый Структура;
	Результат.Вставить("ВерсияМодуля"       , "");
	Результат.Вставить("ДатаОбработки"      , "");
	Результат.Вставить("Описание"           , "");
	Результат.Вставить("СтатусОбработки"    , "");
	Результат.Вставить("НеобходимоОбновление", "");
	
	ПараметрыФункции = Новый Структура;
	ПараметрыФункции.Вставить("ЭКОМОбъектыАктуальны", ЭКОМОбъектыАктуальны);
	СтруктураРезультата = ВернутьРезультатИзМодуляОбъектаСтруктура("ПроверитьОбновление", ПараметрыФункции, МассивЛогаСобытий);

	ДанныеОбработки = СтруктураРезультата.ДанныеОбработки;
	
	Если ДанныеОбработки = Неопределено Тогда
		Возврат Новый Структура("НеобходимоОбновление", Ложь);
	КонецЕсли;
	
	Если СтруктураРезультата.ОбновлениеЗагружено = Истина Тогда
		ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(СтруктураРезультата.ДанныеОбработки.АдресВоВременномХранилище);	
		ПараметрыФормы  = Новый Структура;
		ПараметрыФормы.Вставить("ЭКОМОбъектыАктуальны"  , ЭКОМОбъектыАктуальны);
		ПараметрыФормы.Вставить("ЛокальныйКаталогUPDATE", ЛокальныйКаталогUPDATE); 
		
		ФормаОбновлений = ПолучитьФорму(ЭтаФорма.ПолноеИмяОбработки + ".Форма.УФ_ФормаОбновления", ПараметрыФормы);
		ФормаОбновлений.СохранитьОбновленияНаДиск(ДвоичныеДанныеФайла, СтруктураРезультата.ДанныеОбработки.ФайлОбновленияИмя, ЛокальныйКаталогUPDATE, МассивЛогаСобытий);
	КонецЕсли;
	
	Результат.Вставить("ВерсияМодуля"       , ДанныеОбработки.ВерсияМодуля);
	Результат.Вставить("ДатаОбработки"      , ДанныеОбработки.ДатаОбработки);
	Результат.Вставить("Описание"           , ДанныеОбработки.Описание);
	Результат.Вставить("СтатусОбработки"    , ДанныеОбработки.СтатусОбработки);
	Результат.Вставить("НеобходимоОбновление", СтруктураРезультата.НеобходимоОбновление);

	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ВерсияПлатформыНаКлиенте() Экспорт
	
	// # Пример: 8.3.11.3034 - 83110 (версия по трем позициям) и до 4 знаков 
    // # Пример: 8.3.5.6565  - 8350 (версия по трем позициям) и до 4 знаков 	
	// # Пример: 8.2.19.4342 - 8219 (версия по трем позициям) и до 4 знаков 
    // # Пример: 8.3.10.4342 - 83100(версия по трем позициям) и до 4 знаков
	// # Пример: 8.3.9.4342  - 8390 (версия по трем позициям) и до 4 знаков
	// # Пример: 8.3.12.4342 - 83120(версия по трем позициям) и до 4 знаков
	// # Пример: 8.3.1.00    - 8310(версия по трем позициям) и до 4 знаков
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	ТекущаяВерсия = СистемнаяИнформация.ВерсияПриложения;
	
	Версия  = "";
	Для н = 1  По 3 Цикл
		ПозицияТочки  = Найти(ТекущаяВерсия, ".");
		Символ        = Лев(ТекущаяВерсия , ПозицияТочки - 1);
		ТекущаяВерсия = Сред(ТекущаяВерсия, ПозицияТочки + 1);
		Версия        = Версия + Символ;
	КонецЦикла;
	
	Если СтрДлина(Версия) < 4 
		 ИЛИ (Сред(Версия, 2, 1) = "3" И СтрДлина(Версия) = 4) Тогда
	    Версия = Версия + "0";	
	КонецЕсли;
	
	Попытка
		ВерсияЧисло = Число(Версия);
	Исключение
	   ВерсияЧисло  = 0;
	КонецПопытки;

	Возврат ВерсияЧисло;
	
КонецФункции

&НаКлиенте
Функция ЭКОМ_ПолучитьРазделительПутиОСКлиента()
	
	// По умолчнию Windows
	РазделительПути = "\";
	Диск            = "C:\";
	ОС              = "Windows";
	
	СистемнаяИнформация = Новый СистемнаяИнформация;	
	ЭтоLinuxКлиент = СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86 ИЛИ СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86_64;
		
	Если ЭтоLinuxКлиент Тогда
		РазделительПути = "/";
		Диск = "/home/";
		ОС   = "Linux";
	КонецЕсли;

	Если ВерсияПлатформыНаКлиенте() >= 8330 Тогда
		РазделительПути = ПолучитьРазделительПутиКлиента();
		Диск            = КаталогДокументов();	
	КонецЕсли;
		
	Данные = Новый Соответствие;
	Данные.Вставить("РазделительПути", РазделительПути);
	Данные.Вставить("Диск"           , Диск);
	Данные.Вставить("ОС"             , ОС);
	Данные.Вставить("РазделительПутиWindows", "\");
	Данные.Вставить("РазделительПутиLinux"  , "/");
	
    Возврат Данные;

КонецФункции

