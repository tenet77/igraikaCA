// ПРОЧИЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервере 
Процедура ПроверитьЗаполнитьЗначенияДопКонстант()
	
	СтруктураДанныеДляПроверки = Новый Структура;	
	
	СтруктураДанныеДляПроверки.Вставить("ЭКОМ_ИспПарольДляНастроек",Ложь);
	СтруктураДанныеДляПроверки.Вставить("ЭКОМ_ОтправлятьДокументыПовторно",Ложь);
	СтруктураДанныеДляПроверки.Вставить("ЭКОМ_ИспользоватьАдресаИзРегистраGLN",Ложь);
	СтруктураДанныеДляПроверки.Вставить("ЭКОМ_ИспользоватьАдресаИзРегистраТочкиДоставкиGLN",Ложь);
	СтруктураДанныеДляПроверки.Вставить("ЭКОМ_ПодписыватьПрайсЛист",Ложь);
	СтруктураДанныеДляПроверки.Вставить("ЭКОМ_ПолучатьСтатусФайлы",Ложь);
	СтруктураДанныеДляПроверки.Вставить("ЭКОМ_СоздаватьДокументЗаказ1СПроведенным",Ложь);
	СтруктураДанныеДляПроверки.Вставить("ЭКОМ_СоздаватьДокументРеализация1СПроведенным",Ложь);
	СтруктураДанныеДляПроверки.Вставить("ЭКОМ_ЗаказыЗагружатьТекущейДатой",Ложь);
	СтруктураДанныеДляПроверки.Вставить("ЭКОМ_РеализацииСоздаватьДатойПоставки",Ложь);
	СтруктураДанныеДляПроверки.Вставить("ЭКОМ_ОтправлятьНепроведенные",Ложь);
	СтруктураДанныеДляПроверки.Вставить("ЭКОМ_СоздаватьДокументПоступления1СПроведенным",Ложь);
	СтруктураДанныеДляПроверки.Вставить("ЭКОМ_СоздаватьДокументПолученныйСЧФ1СПроведенным",Ложь);
	СтруктураДанныеДляПроверки.Вставить("ЭКОМ_ОбрабатыватьПовторныеORDER",Ложь);
	СтруктураДанныеДляПроверки.Вставить("ЭКОМ_ПерезаписыватьЗаказ",Ложь);
	СтруктураДанныеДляПроверки.Вставить("ЭКОМ_ВыборВетвиРепозитория",Ложь);
	СтруктураДанныеДляПроверки.Вставить("ЭКОМ_ОтмечатьИзмененныеШаблоны",Ложь);
	СтруктураДанныеДляПроверки.Вставить("ЭКОМ_ИспользоватьПредставленияШаблонов",Истина);
	
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Для Каждого ЭлементСтруктурыДляПроверки Из СтруктураДанныеДляПроверки Цикл		
		Если ОбработкаОбъект.Настройка_Параметр_Прочитать(ЭлементСтруктурыДляПроверки.Ключ) = Неопределено Тогда			
			ОбработкаОбъект.Настройка_Параметр_Записать(ЭлементСтруктурыДляПроверки.Ключ, ЭлементСтруктурыДляПроверки.Значение);			
		КонецЕсли		
	КонецЦикла;	
	
КонецПроцедуры

// Возвращает настройки формы для текущего пользователя информационной базы
//
// Параметры:
//  ТекущийПользователь  - СправочникСсылка.Пользователи - текущий пользователь информационной базы, полученный из параметров сеанса
//
// Возвращаемое значение:
//   Структура   - Пользовательские настройки
//
&НаСервереБезКонтекста
Функция ПолучитьПользовательскиеНастройки(ТекущийПользователь)

	Настройки = Новый Структура;
	
	ПараметрыОтбора = Новый Структура("КлючОбъекта, Пользователь", "Docrobot_ОсновнаяФорма", ПользователиИнформационнойБазы.ТекущийПользователь().Имя);
	ВыборкаНастроек = ХранилищеНастроекДанныхФорм.Выбрать(ПараметрыОтбора);
	Пока ВыборкаНастроек.Следующий() Цикл
		Настройки.Вставить(ВыборкаНастроек.КлючНастроек, ВыборкаНастроек.Настройки);
	КонецЦикла;
	
	Возврат Настройки;
	
КонецФункции // ПолучитьПользовательскиеНастройки()

// Записывает настройки формы для текущего пользователя информационной базы
//
// Параметры:
//  ТекущийПользователь  - СправочникСсылка.Пользователи - текущий пользователь информационной базы, полученный из параметров сеанса
//  Настройки  - Структура - коллекция настроек формы для текущего пользователя
//
&НаСервереБезКонтекста
Процедура СохранитьПользовательскиеНастройки(ТекущийПользователь, Настройки)

	Для Каждого Настройка Из Настройки Цикл
		ХранилищеНастроекДанныхФорм.Сохранить("Docrobot_ОсновнаяФорма", Настройка.Ключ, Настройка.Значение, , ПользователиИнформационнойБазы.ТекущийПользователь().Имя);
	КонецЦикла;

КонецПроцедуры // СохранитьПользовательскиеНастройки()

// Выполняется вызов функции из модуля объекта обарботки
//
// Параметры:
//  ИмяФункции  - Строка - наименование функции в модуле объекта
//  ПараметрыФункции  - Массив - парамеры функции в последовательности их заполнения 
//
// Возвращаемое значение:
//   Any   - результат выполнения функции
//
&НаСервере                             
Функция ВернутьРезультатИзМодуляОбъекта(ИмяФункции, ПараметрыФункции = Неопределено)	
    
    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    
    Если ПараметрыФункции = Неопределено Тогда	
        ПараметрыФункции = Новый Массив;	
    ИначеЕсли ТипЗнч(ПараметрыФункции) <> Тип("Массив") Тогда	
        ВызватьИсключение "Ошибка валидации входного параметра";		
    КонецЕсли;
    
    Результат = Неопределено;
    
    СтрокаФункции = "ОбработкаОбъект." + ИмяФункции + "(";
    Индекс = 0;
    
    ПараметрыФункцииСтруктура = Новый Структура;
    Пока Индекс < ПараметрыФункции.Количество() Цикл
        ПараметрыФункцииСтруктура.Вставить("Ключ_" + Индекс, ПараметрыФункции.Получить(Индекс));
        СтрокаФункции 	= СтрокаФункции + ?(Индекс = 0, "", ", ") + "ПараметрыФункцииСтруктура.Ключ_" + Индекс; 
        Индекс 			= Индекс + 1;
    КонецЦикла;
    
    СтрокаФункции = СтрокаФункции + ")";
    Результат = Вычислить(СтрокаФункции);
    
    Для Каждого ЭлементСтруктуры Из ПараметрыФункцииСтруктура Цикл
        Индекс = Число(СтрЗаменить(ЭлементСтруктуры.Ключ, "Ключ_", ""));
        ПараметрыФункции.Вставить(Индекс, ЭлементСтруктуры.Значение);	
    КонецЦикла;
    
    Возврат Результат;
    
КонецФункции // ВернутьРезультатИзМодуляОбъекта()
	
&НаСервере                             
Функция ВернутьРезультатИзМодуляОбъектаСтруктура(ИмяФункции, ПараметрыФункцииСтруктура, МассивЛогаСобытий = Неопределено)	
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	СтрокаФункции = "ОбработкаОбъект." + ИмяФункции + "(";	
	Для каждого СтруктураПараметр Из ПараметрыФункцииСтруктура Цикл
		СтрокаФункции = СтрокаФункции + ?(Прав(СтрокаФункции, 1) = "(", "", ", ") + "ПараметрыФункцииСтруктура." + СтруктураПараметр.Ключ;
	КонецЦикла;
	
	Если НЕ МассивЛогаСобытий = Неопределено Тогда
		 СтрокаФункции = СтрокаФункции + ?(Прав(СтрокаФункции, 1) = "(", "", ", ") + "МассивЛогаСобытий";		
	КонецЕсли;
	СтрокаФункции = СтрокаФункции + ")";
	
	Попытка
		Результат = Вычислить(СтрокаФункции);	
	Исключение
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ОписаниеОшибки();
		Сообщение.Сообщить();
		
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции 

&НаСервере                             
Процедура ВыполнитьПроцедуруИзМодуляОбъектаСтруктура(ИмяПроцедуры, ПараметрыАлгоритма, МассивЛогаСобытий = Неопределено)	
		 
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Если ТипЗнч(ПараметрыАлгоритма) <> Тип("Структура") Тогда	
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Ошибка валидации входного параметра";
		Сообщение.Сообщить();
		
		Возврат;
	КонецЕсли;
	
    СтрокаПроцедуры = "ОбработкаОбъект." + ИмяПроцедуры + "(";	
	Для каждого СтруктураПараметр Из ПараметрыАлгоритма Цикл
		СтрокаПроцедуры = СтрокаПроцедуры + ?(Прав(СтрокаПроцедуры, 1) = "(", "", ", ") + "ПараметрыАлгоритма." + СтруктураПараметр.Ключ;
	КонецЦикла;
	
	Если НЕ МассивЛогаСобытий = Неопределено Тогда
		 СтрокаПроцедуры = СтрокаПроцедуры + ?(Прав(СтрокаПроцедуры, 1) = "(", "", ", ") + "МассивЛогаСобытий";		
	КонецЕсли;
	СтрокаПроцедуры = СтрокаПроцедуры + ")";
	
	Попытка
		Выполнить(СтрокаПроцедуры);	
	Исключение
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ОписаниеОшибки();
		Сообщение.Сообщить();
		
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

&НаСервере                             
Процедура ВыполнитьПроцедуруИзМодуляОбъекта(ИмяПроцедуры, ПараметрыПроцедуры = Неопределено)	
    
    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    
    Если ПараметрыПроцедуры = Неопределено Тогда	
        ПараметрыПроцедуры = Новый Массив;	
    ИначеЕсли ТипЗнч(ПараметрыПроцедуры) <> Тип("Массив") Тогда	
        ВызватьИсключение "Ошибка валидации входного параметра";		
    КонецЕсли;
    
    Результат = Неопределено;
    
    СтрокаПроцедуры = "ОбработкаОбъект." + ИмяПроцедуры + "(";
    Индекс = 0;
    
    ПараметрыПроцедурыСтруктура = Новый Структура;
    Пока Индекс < ПараметрыПроцедуры.Количество() Цикл
        ПараметрыПроцедурыСтруктура.Вставить("Ключ_" + Индекс, ПараметрыПроцедуры.Получить(Индекс));
        СтрокаПроцедуры = СтрокаПроцедуры + ?(Индекс = 0, "", ", ") + "ПараметрыПроцедурыСтруктура.Ключ_" + Индекс; 
        Индекс 			= Индекс + 1;	
    КонецЦикла;
    
    СтрокаПроцедуры = СтрокаПроцедуры + ")";
    Выполнить(СтрокаПроцедуры);
    
    Для Каждого ЭлементСтруктуры Из ПараметрыПроцедурыСтруктура Цикл
        Индекс = Число(СтрЗаменить(ЭлементСтруктуры.Ключ, "Ключ_", ""));
        ПараметрыПроцедуры.Вставить(Индекс, ЭлементСтруктуры.Значение);	
    КонецЦикла;
    
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСоотвСтатусов()
    
    СоотвСтатусовПоставщик = Новый Соответствие;
    СоотвСтатусовПоставщик.Вставить(Перечисления.ЭКОМ_Статусы.Отправлен                , "Отправлен");            // (ON_SCHFDOPPR  - 01) исх.
	
	// (DP_PDPOL      - 02) вх.  - Подтверждено получение в СОС
	// (DP_IZVPOL     - 04) исх. - Дата поступления УПД
	// (DP_IZVPOL     - 06) вх.  - Извещение получения УПД
	СоотвСтатусовПоставщик.Вставить(Перечисления.ЭКОМ_Статусы.ОжиданиеПодтверждения    , "Ожидание контрагента");       
                
	// (DP_UVUTOCH    - 09) вх.  - Уведомление об уточнении
	// (DP_IZVPOL     - 10) исх. - Извещение получения уточнения
    СоотвСтатусовПоставщик.Вставить(Перечисления.ЭКОМ_Статусы.Уточнение_Получено       , "Получено уточнение");                    
            
	СоотвСтатусовПоставщик.Вставить(Перечисления.ЭКОМ_Статусы.ПодписаноПокупателем     , "Подписан"); // (ON_SCHFDOPPOK - 11) вх. и (DP_IZVPOL - 06 // 10) вх. если СЧФ // Уточ
	СоотвСтатусовПоставщик.Вставить(Перечисления.ЭКОМ_Статусы.ДокументооборотЗавершен  , "Документооборот завершен"); // (ON_SCHFDOPPOK - 11) вх. и (DP_IZVPOL - 06 // 10) вх. если СЧФ // Уточ
    СоотвСтатусовПоставщик.Вставить(Перечисления.ЭКОМ_Статусы.Подтвержден_с_отклонением, "Завершён с уточнением");    //   
    
    СоотвСтатусовПокупатель = Новый Соответствие;
    СоотвСтатусовПокупатель.Вставить(Перечисления.ЭКОМ_Статусы.НеОбработан              , "Не обработан");             // (ON_SCHFDOPPR  - 01) вх.  - УПД
	
	// (DP_PDPOTPR    - 03) вх.  - ПодтверждениеДатыОтправкиУПД 
	// (DP_IZVPOL     - 05) исх. - Дата отправки УПД
	// (DP_IZVPOL     - 06) исх. - Извещение получения УПД
	// (DP_PDPOTPR    - 07) вх.  - Подтверждение отправки в СОС
	// (DP_IZVPOL     - 08) исх. - ДатаОтправкиИзвещенияПокупатель СЧФДОП                      
    СоотвСтатусовПокупатель.Вставить(Перечисления.ЭКОМ_Статусы.ТребуетсяПодписатьУПД    , "Требуется подписать ЮЗД");
	СоотвСтатусовПокупатель.Вставить(Перечисления.ЭКОМ_Статусы.ПодписаноПокупателем     , "Подписан"); 
	
	// (DP_UVUTOCH    - 09) исх. - Уведомление об уточнении
	// (DP_IZVPOL     - 10) вх.  - Извещение получения уточнения 
	СоотвСтатусовПокупатель.Вставить(Перечисления.ЭКОМ_Статусы.ОтправленоУточнение      , "Отправлено уточнение");        	
    СоотвСтатусовПокупатель.Вставить(Перечисления.ЭКОМ_Статусы.ДокументооборотЗавершен  , "Документооборот завершен"); // (ON_SCHFDOPPOK - 11) исх. и (DP_IZVPOL - 08 ) исх. если СЧФ ИнформацияПокупателя
    СоотвСтатусовПокупатель.Вставить(Перечисления.ЭКОМ_Статусы.Подтвержден_с_отклонением, "Завершён с уточнением");    // (DP_OTORG2) вх.  
    
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокДокументов(ВыбраннаяСтрока, ИмяСписка, ВключитьИсходнуюСчФИзОснованияСчФ = Истина)
			
	Если НЕ ИмяСписка = "СписокДляЭТРН" Тогда
		
		СчетФактураИсходная = ВыбраннаяСтрока.ДокументСЧФ;
		СчетФактураКоррИспр = Неопределено;
		СчетФактураИспр     = Неопределено;
		СчетФактураКорр     = Неопределено;
		ЭтоКорректировка    = Ложь;
		ЭтоИсправление      = Ложь;
		
		Если ЗначениеЗаполнено(СчетФактураИсходная) Тогда
			
			Если НЕ СчетФактураИсходная.Метаданные().Реквизиты.Найти("Корректировочный") = Неопределено Тогда
				ЭтоКорректировка = СчетФактураИсходная.Корректировочный;	
			ИначеЕсли НЕ СчетФактураИсходная.Метаданные().Реквизиты.Найти("ВидСчетаФактуры") = Неопределено Тогда
				ЭтоКорректировка = СчетФактураИсходная.ВидСчетаФактуры = ПредопределенноеЗначение("Перечисление.ВидСчетаФактурыВыставленного.Корректировочный");				
			КонецЕсли;
			
			Если НЕ СчетФактураИсходная.Метаданные().Реквизиты.Найти("Исправление") = Неопределено Тогда
				ЭтоИсправление = СчетФактураИсходная.Исправление;		
			КонецЕсли;
			
			СчетФактураОснование = "ИсправляемыйСчетФактура";
			Если НЕ СчетФактураИсходная.Метаданные().Реквизиты.Найти("СчетФактураОснование") = Неопределено Тогда
				СчетФактураОснование = "СчетФактураОснование";		
			КонецЕсли;
			
			Если ЭтоКорректировка И ЭтоИсправление Тогда
				СчетФактураКоррИспр = СчетФактураИсходная;
			ИначеЕсли ЭтоИсправление Тогда
				СчетФактураИспр     = СчетФактураИсходная;
			ИначеЕсли ЭтоКорректировка Тогда
				СчетФактураКорр     = СчетФактураИсходная;
			КонецЕсли;
            
            Если (ЭтоКорректировка Или ЭтоИсправление) И ВключитьИсходнуюСчФИзОснованияСчФ = Истина Тогда
                СчетФактураИсходная = СчетФактураИсходная[СчетФактураОснование];		
            КонецЕсли;
            
		КонецЕсли;
		
	КонецЕсли;

    
    // Чтобы не было задвоений
    СписокСоответствий = Новый Соответствие;
    Если ИмяСписка = "СписокДляПоставщика"  Тогда
        Если ВыбраннаяСтрока.Свойство("ЭКОМ_Документ_ORDER") Тогда
            СписокСоответствий.Вставить(ВыбраннаяСтрока.ЭКОМ_Документ_ORDER, "А");
        КонецЕсли;
        Если ВыбраннаяСтрока.Свойство("ДокументЗаказа") Тогда
            СписокСоответствий.Вставить(ВыбраннаяСтрока.ДокументЗаказа, "Б");
        КонецЕсли;	
        Если ВыбраннаяСтрока.Свойство("ДокументРеализации") Тогда
            СписокСоответствий.Вставить(ВыбраннаяСтрока.ДокументРеализации, "В");
        КонецЕсли;
        Если ВыбраннаяСтрока.Свойство("ЭКОМ_Документ_RECADV") Тогда
            СписокСоответствий.Вставить(ВыбраннаяСтрока.ЭКОМ_Документ_RECADV, "Г");
        КонецЕсли;	
        СписокСоответствий.Вставить(СчетФактураИсходная                       , "Д");
        СписокСоответствий.Вставить(СчетФактураИспр                           , "Е");
        СписокСоответствий.Вставить(СчетФактураКорр                           , "Ж");
        СписокСоответствий.Вставить(СчетФактураКоррИспр                       , "З");
        Если ВыбраннаяСтрока.Свойство("КорректировкаРеализации") Тогда
            СписокСоответствий.Вставить(ВыбраннаяСтрока.КорректировкаРеализации, "И");
        КонецЕсли;	
        Если ВыбраннаяСтрока.Свойство("ВозвратТоваровОтПокупателя") Тогда
            СписокСоответствий.Вставить(ВыбраннаяСтрока.ВозвратТоваровОтПокупателя, "К");		
        КонецЕсли;	
    ИначеЕсли ИмяСписка = "СписокДляПокупателя" Тогда
        Если ВыбраннаяСтрока.Свойство("ДокументЗаказа") Тогда
            СписокСоответствий.Вставить(ВыбраннаяСтрока.ДокументЗаказа            , "А");
        КонецЕсли;	
        Если ВыбраннаяСтрока.Свойство("ЭКОМ_Документ_ORDRSP") Тогда
            СписокСоответствий.Вставить(ВыбраннаяСтрока.ЭКОМ_Документ_ORDRSP      , "Б");
        КонецЕсли;	
        Если ВыбраннаяСтрока.Свойство("ЭКОМ_Документ_DESADV") Тогда
            СписокСоответствий.Вставить(ВыбраннаяСтрока.ЭКОМ_Документ_DESADV      , "В");
        КонецЕсли;	
        Если ВыбраннаяСтрока.Свойство("ДокументПоступления") Тогда
            СписокСоответствий.Вставить(ВыбраннаяСтрока.ДокументПоступления       , "Г");
        КонецЕсли;	
        Если ВыбраннаяСтрока.Свойство("ДокументЭКОМ_ЮЗД") Тогда
            СписокСоответствий.Вставить(ВыбраннаяСтрока.ДокументЭКОМ_ЮЗД          , "Д");
        КонецЕсли;	
        СписокСоответствий.Вставить(СчетФактураИсходная                       , "Е");
        СписокСоответствий.Вставить(СчетФактураИспр                           , "Ж");
        СписокСоответствий.Вставить(СчетФактураКорр                           , "З");
        СписокСоответствий.Вставить(СчетФактураКоррИспр                       , "И");
        Если ВыбраннаяСтрока.Свойство("КорректировкаПоступления") Тогда
            СписокСоответствий.Вставить(ВыбраннаяСтрока.КорректировкаПоступления  , "К");
        КонецЕсли;	
        Если ВыбраннаяСтрока.Свойство("ВозвратТоваровПоставщику") Тогда
            СписокСоответствий.Вставить(ВыбраннаяСтрока.ВозвратТоваровПоставщику  , "Л");		
		КонецЕсли;	
	ИначеЕсли ИмяСписка = "СписокДляЭТРН"  Тогда
		
		Если ВыбраннаяСтрока.Свойство("Накладная") Тогда
			СписокСоответствий.Вставить(ВыбраннаяСтрока.Накладная, "А");
		КонецЕсли;	
		Если ВыбраннаяСтрока.Свойство("ДокументЭКОМ") Тогда
			СписокСоответствий.Вставить(ВыбраннаяСтрока.ДокументЭКОМ, "Б");
		КонецЕсли;

    КонецЕсли;
    
    СписокДокументов = Новый СписокЗначений;
    Для каждого Эл Из СписокСоответствий Цикл
        Если ЗначениеЗаполнено(Эл.Ключ) Тогда
            СписокДокументов.Добавить(Эл.Ключ, Эл.Значение); 
        КонецЕсли;		
    КонецЦикла;
	
    Возврат СписокДокументов;
    
КонецФункции

&НаКлиенте
Процедура СоздатьЛокальныеКаталогиНаКлиенте(МассивЛогаСобытий) Экспорт
		
	МассивНастроек = Новый Массив;
	МассивНастроек.Добавить("ЭКОМ_Рабочий_Каталог");
	МассивНастроек.Добавить("ЭКОМ_Локальный_Каталог_INBOX");
	МассивНастроек.Добавить("ЭКОМ_Локальный_Каталог_INBOX_Архив");
	МассивНастроек.Добавить("ЭКОМ_Локальный_Каталог_OUTBOX");
	МассивНастроек.Добавить("ЭКОМ_Локальный_Каталог_OUTBOX_Архив");
	МассивНастроек.Добавить("ЭКОМ_Локальный_Каталог_UPDATE");
	МассивНастроек.Добавить("ЭКОМ_Локальный_Каталог_Marking");

    НастройкиЭКОМ  = ПолучитьСписокНастроекНаСервере(МассивНастроек);
	 
   	РабочийКаталог                 = НастройкиЭКОМ.Получить("ЭКОМ_Рабочий_Каталог");
	Локальный_Каталог_INBOX        = НастройкиЭКОМ.Получить("ЭКОМ_Локальный_Каталог_INBOX"); 
	Локальный_Каталог_INBOX_Архив  = НастройкиЭКОМ.Получить("ЭКОМ_Локальный_Каталог_INBOX_Архив");
	Локальный_Каталог_OUTBOX       = НастройкиЭКОМ.Получить("ЭКОМ_Локальный_Каталог_OUTBOX");
	Локальный_Каталог_OUTBOX_Архив = НастройкиЭКОМ.Получить("ЭКОМ_Локальный_Каталог_OUTBOX_Архив");
	Локальный_Каталог_UPDATE       = НастройкиЭКОМ.Получить("ЭКОМ_Локальный_Каталог_UPDATE");
	Локальный_Каталог_Marking      = НастройкиЭКОМ.Получить("ЭКОМ_Локальный_Каталог_Marking");
	
	ДанныеОС        = Вычислить("ЭКОМ_ОбщегоНазначенияКлиент.ЭКОМ_ПолучитьРазделительПутиОСКлиента()");
	Диск            = ДанныеОС.Получить("Диск");
	РазделительПути = ДанныеОС.Получить("РазделительПути");

	ПроверитьЛокальныйКаталог(РабочийКаталог, РазделительПути);
	ПроверитьЛокальныйКаталог(Локальный_Каталог_INBOX, РазделительПути);
	ПроверитьЛокальныйКаталог(Локальный_Каталог_INBOX_Архив, РазделительПути);
	ПроверитьЛокальныйКаталог(Локальный_Каталог_OUTBOX, РазделительПути);
	ПроверитьЛокальныйКаталог(Локальный_Каталог_OUTBOX_Архив, РазделительПути);
	ПроверитьЛокальныйКаталог(Локальный_Каталог_UPDATE, РазделительПути);
	ПроверитьЛокальныйКаталог(Локальный_Каталог_Marking, РазделительПути);

	ЗаписатьКаталоги = Ложь;
	Если НЕ ЗначениеЗаполнено(РабочийКаталог) 
		ИЛИ РабочийКаталог = РазделительПути Тогда
		РабочийКаталог  = Вычислить("ЭКОМ_ОбщегоНазначенияКлиент.ОпределитьКаталогПоУмолчанию(Диск, РазделительПути)");
		
		Локальный_Каталог_INBOX         = РабочийКаталог + "inbox"      + РазделительПути;
		Локальный_Каталог_INBOX_Архив  	= РабочийКаталог + "inbox_bak"  + РазделительПути;
		Локальный_Каталог_OUTBOX       	= РабочийКаталог + "outbox"     + РазделительПути;
		Локальный_Каталог_OUTBOX_Архив 	= РабочийКаталог + "outbox_bak" + РазделительПути;
		Локальный_Каталог_UPDATE       	= РабочийКаталог + "update"     + РазделительПути;
		Локальный_Каталог_Marking       = РабочийКаталог + "marking"    + РазделительПути;

		ЗаписатьКаталоги = Истина;
	КонецЕсли;
	
	
	СписокКаталогов = Новый Соответствие;
    СписокКаталогов.Вставить("ЭКОМ_Рабочий_Каталог",                РабочийКаталог);
    СписокКаталогов.Вставить("ЭКОМ_Локальный_Каталог_INBOX",        Локальный_Каталог_INBOX);
    СписокКаталогов.Вставить("ЭКОМ_Локальный_Каталог_INBOX_Архив",  Локальный_Каталог_INBOX_Архив);
    СписокКаталогов.Вставить("ЭКОМ_Локальный_Каталог_OUTBOX",       Локальный_Каталог_OUTBOX);
    СписокКаталогов.Вставить("ЭКОМ_Локальный_Каталог_OUTBOX_Архив", Локальный_Каталог_OUTBOX_Архив);
    СписокКаталогов.Вставить("ЭКОМ_Локальный_Каталог_UPDATE",       Локальный_Каталог_UPDATE);
    СписокКаталогов.Вставить("ЭКОМ_Локальный_Каталог_Marking",       Локальный_Каталог_Marking);

	Для Каждого Каталог Из СписокКаталогов Цикл		
		КаталогФайл = Вычислить("ЭКОМ_ОбщегоНазначенияКлиент.ЭКОМ_СоздатьКаталогПроверитьНаЗапись(Каталог.Значение, МассивЛогаСобытий)");
		Если КаталогФайл = Неопределено Тогда		
			Продолжить;
			
		КонецЕсли;
		
		Если ЗаписатьКаталоги = Истина Тогда
			Настройка_Параметр_Записать(Каталог.Ключ, Каталог.Значение, Неопределено);	
		КонецЕсли;	
	КонецЦикла;
    
КонецПроцедуры

&НаКлиенте
Процедура СписокДляПокупателяВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Элемент = Неопределено 
		Или Элемент.ТекущиеДанные = Неопределено 
		Или ВыбраннаяСтрока = Неопределено Тогда
        Возврат;
    КонецЕсли;
    СтандартнаяОбработка = Ложь;

	ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();
	Если Поле.Имя = ДанныеСписка.ИмяСписка + "Пометка" Тогда
		
		Если Не Элемент.ТекущиеДанные = Неопределено Тогда
			ДокументыЦепочки = МассивИменДокументовЦепочкиПокупателя();
			Если Элемент.ТекущиеДанные.Пометка Тогда
				СнятьПометку(Элемент.ТекущиеДанные.ДокументыВсе);
				Для Каждого ИмяДокумента Из ДокументыЦепочки Цикл
					Если Элемент.ТекущиеДанные.Свойство(ИмяДокумента) Тогда 
						СнятьПометку(Элемент.ТекущиеДанные[ИмяДокумента]);
					КонецЕсли;
				КонецЦикла;
			Иначе
				ПоставитьПометку(Элемент.ТекущиеДанные.ДокументыВсе);
			КонецЕсли;
		КонецЕсли;
		
		//Параметр в динамическом списке нужно обновить
		УстановитьПараметрДинамическогоСписка(ДанныеСписка.ИмяРеквизитаТаблицы, "масПомеченныхДоков", СписокВыбранныхСтрок.ВыгрузитьЗначения());

	ИначеЕсли Поле.Имя = ДанныеСписка.ИмяСписка + "Статус" ИЛИ
		Поле.Имя = ДанныеСписка.ИмяСписка + "Статус_ORDER" ИЛИ
        Поле.Имя = ДанныеСписка.ИмяСписка + "Статус_ORDRSP" ИЛИ
        Поле.Имя = ДанныеСписка.ИмяСписка + "Статус_DESADV" ИЛИ
        Поле.Имя = ДанныеСписка.ИмяСписка + "Статус_RECADV" ИЛИ 
        Поле.Имя = ДанныеСписка.ИмяСписка + "Статус_DESSCC" ИЛИ 
        Поле.Имя = ДанныеСписка.ИмяСписка + "Статус_RETINS" ИЛИ
		Поле.Имя = ДанныеСписка.ИмяСписка + "Статус_RETANN" ИЛИ
		Поле.Имя = ДанныеСписка.ИмяСписка + "Статус_INVOICE" ИЛИ
		Поле.Имя = ДанныеСписка.ИмяСписка + "Статус_STATUS" ИЛИ
        Поле.Имя = ДанныеСписка.ИмяСписка + "Статус_УПД" Тогда
        
        ВыбраннаяСтрока  = Элемент.ТекущиеДанные;
        СписокДокументов = ПолучитьСписокДокументов(ВыбраннаяСтрока, "СписокДляПокупателя");
        
        Форма = ОткрытьФорму("РегистрСведений.ЭКОМ_Объекты_События.Форма.УФ_ФормаСписка");
        ОтборВладелец = Форма.Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); //Добавлям отбор
        ОтборВладелец.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке; //Как будем сравнивать
        ОтборВладелец.Использование  = Истина; // Устанавливаем галку использованияНовый ПолеКомпоновкиДанных("Номенклатура")
        ОтборВладелец.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Документ_Основание"); //По какому реквизиту будем делать отбор
        ОтборВладелец.ПравоеЗначение = СписокДокументов; // И само значение отбора
        
        УсловиеСортировки = Форма.Список.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
        УсловиеСортировки.Поле = Новый ПолеКомпоновкиДанных("ДатаЗаписи");
        УсловиеСортировки.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Возр;
        УсловиеСортировки.Использование = Истина;
                
    ИначеЕсли Поле.Имя = "СписокДляПокупателяТекстОшибки" Тогда
        
        Подсказка = "Текст ошибки";
        Оповещение = Новый ОписаниеОповещения("ЗавершениеПросмотраТекстОшибки", ЭтаФорма);
        ПоказатьВводСтроки(Оповещение, Элемент.ТекущиеДанные.ТекстОшибки, Подсказка, 0, Истина);
		
	ИначеЕсли Поле.Имя = "СписокДляПокупателяТекстУточнения" Тогда
        
        Подсказка = "Текст уточнения";
        Оповещение = Новый ОписаниеОповещения("ЗавершениеПросмотраТекстОшибки", ЭтаФорма);
        ПоказатьВводСтроки(Оповещение, Элемент.ТекущиеДанные.ТекстУточнения, Подсказка, 0, Истина);
		
	ИначеЕсли Поле.Имя = "СписокДляПокупателяТекстОтклоненияАннулирования" Тогда
		
		Подсказка = "Текст отклонения аннулирования";
		Оповещение = Новый ОписаниеОповещения("ЗавершениеПросмотраТекстОшибки", ЭтаФорма);
		ПоказатьВводСтроки(Оповещение, Элемент.ТекущиеДанные.ТекстОтклоненияАннулирования, Подсказка, 0, Истина);
		
		
	ИначеЕсли Поле.Имя = "СписокДляПокупателяТекстПричиныАннулирования" Тогда
		
		Подсказка = "Текст причины аннулирования";
		Оповещение = Новый ОписаниеОповещения("ЗавершениеПросмотраТекстОшибки", ЭтаФорма);
		ПоказатьВводСтроки(Оповещение, Элемент.ТекущиеДанные.ТекстПричиныАннулирования, Подсказка, 0, Истина);
		
    КонецЕсли;
    
    ЭлементОбъект = ОпределитьТипОбъекта(Элемент, Поле.Имя);
    Если ЗначениеЗаполнено(ЭлементОбъект) Тогда
        ПоказатьЗначение( , ЭлементОбъект);
    КонецЕсли;              
    
КонецПроцедуры

