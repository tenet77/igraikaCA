&НаСервере
Функция ПроверитьФормулуНаФорме(Текст, ИмяЭлементаФормы, МассивЛогаСобытий) Экспорт
    Значение = Неопределено;
    
    Попытка
        
        КодЗапроса = СтрЗаменить(Текст, "¶", Символы.ПС);
        КодЗапроса = СтрЗаменить(КодЗапроса, "Возврат "      , "Значение = ");
        КодЗапроса = СтрЗаменить(КодЗапроса, "Значение = КАК", "Возврат КАК");

        ИмяДинамическогоСписка = ?(ИмяЭлементаФормы = "ГруппаПоставщик", "СписокДляПоставщика", "СписокДляПокупателя");
        ДинамическийСписок     = ?(ИмяЭлементаФормы = "ГруппаПоставщик", СписокДляПоставщика, СписокДляПокупателя);
		
		ТекстЗапроса = "";
		Результат = Новый Структура("ТекстЗапроса, Колонки", ТекстЗапроса, Новый Массив);
		
		Если ЗначениеЗаполнено(КодЗапроса) Тогда   
			
			Выполнить(КодЗапроса);
			
			Запрос = Новый Запрос;		               
			Запрос.Текст = ТекстЗапроса;
			Результат.ТекстЗапроса = ТекстЗапроса;
			Запрос.УстановитьПараметр("ДатаНач", ТекущаяДата());
			Запрос.УстановитьПараметр("ДатаКон", ТекущаяДата());
			Запрос.УстановитьПараметр("масПомеченныхДоков", Новый Массив);
			Запрос.УстановитьПараметр("НаправлениеОбмена" , Перечисления.ЭКОМ_НаправлениеОбмена.ПустаяСсылка());
			
			РезультатЗапроса = Запрос.Выполнить();
			КолонкиЗапроса = РезультатЗапроса.Колонки;
			
			Для каждого ТекКолонка Из КолонкиЗапроса Цикл
				ИмяКолонкиЗапроса = ТекКолонка.Имя;
				Результат.Колонки.Добавить(ИмяКолонкиЗапроса);
				КонецЦикла;			
			
		КонецЕсли;
        
    Исключение 
        ТекстЛогаСобытий = ОписаниеОшибки();
		ЗаписьСтруктурыЛога = Вычислить("ЭКОМ_ОбщегоНазначения.ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение(""Перечисление.ЭКОМ_УровниЛогирования.Ошибка""), ""Тестирование гибких настроек"")");
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
    КонецПопытки;
	
	Если МассивЛогаСобытий.Количество() > 0  Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий)");
		Сообщение.Сообщить();
	КонецЕсли;
	
    Возврат Результат;
	
КонецФункции

