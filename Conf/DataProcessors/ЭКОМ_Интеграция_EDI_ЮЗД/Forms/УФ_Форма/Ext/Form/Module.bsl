&НаКлиенте
Процедура КомандаНастройки(Команда)
    
    КлючУникальностиФормы = "ЭКОМ_НастройкиОсновные";
	
	ПараметрыНастроек = Новый Структура;
	
	ПараметрыНастроек.Вставить("ЭКОМОбъектыАктуальны", 			ЭтаФорма.ЭКОМОбъектыАктуальны);
	ПараметрыНастроек.Вставить("ДополнительнаяОбработкаСсылка", ЭтаФорма.ОбъектСсылка);
    
    ФормаНастроек = ОткрытьФорму(ПолноеИмяОбработки + ".Форма.УФ_ФормаНастройкиОсновные", ПараметрыНастроек, ЭтаФорма, КлючУникальностиФормы);
    ФормаНастроек.Активизировать();
КонецПроцедуры

&НаСервере
Процедура ОбменУведомлениямиОПриемкеНаСервереИсходящий(МассивСтрок)
    
    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    
    Если МассивСтрок.Количество()=0 Тогда 
        Сообщить("Не выбраны документы для отправки заказов! Возможно заказ(ы) не подтвержден (проведен)", СтатусСообщения.Важное);
    Иначе 
        ОбработкаОбъект.ОтправитьRECADV(МассивСтрок);
    КонецЕсли;	
    
    Элементы.СписокДляПокупателя.Обновить();
    
КонецПроцедуры

&НаКлиенте
Процедура ОбменКвитанциямиНаКлиенте(ДанныеСписка, МассивЛогаСобытий) Экспорт 	
	
	ПараметрыСтруктуры = "Тип, ИспользоватьДерево";
	ИспользуемыеДеревья = Новый Соответствие;
	ИспользуемыеДеревья.Вставить("Входящий DP_PRANNUL_22 (аннулирование)"                , Новый Структура(ПараметрыСтруктуры, "DP_PRANNUL_22", Ложь)); //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _22]
	ИспользуемыеДеревья.Вставить("Входящий DP_IZVPOL_23 (подтверждение аннулирования)", Новый Структура(ПараметрыСтруктуры, "DP_IZVPOL_23" , Ложь));
	ИспользуемыеДеревья.Вставить("Входящий DP_UVUTOCH_24 (отклонение аннулирования)"  , Новый Структура(ПараметрыСтруктуры, "DP_UVUTOCH_24", Ложь));

	КоличествоОпераций = 0;
	ПроверитьНаличиеВеткиДерева(ИспользуемыеДеревья);
	Для каждого Стр Из ИспользуемыеДеревья Цикл		
		Если Стр.Значение.ИспользоватьДерево = Истина Тогда
			КоличествоОпераций = КоличествоОпераций + 1;
		КонецЕсли;	
	КонецЦикла;
	
	НужнаПодпись = Истина;
	ЭтоНовыеДокументы = Истина;
	Если ДанныеСписка.ИмяСписка = "СписокДляПокупателя" Тогда
			
		ЗначениеПоУмолчанию = Ложь;
		Измерение           = Неопределено; 
		Обязательно         = Ложь;
		знОтправлятьУточнения = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_АвтоотправкаУточнений"", ЗначениеПоУмолчанию, Измерение, Обязательно)");
		
		Если знОтправлятьУточнения = Истина Тогда
		     КоличествоОпераций = 4;
		Иначе	
		     КоличествоОпераций = 3;
		КонецЕсли;
			
		ЭтаФорма.Индикатор = 1;
		Элементы.ПолеИндикатор.Видимость = Истина;
		Элементы.КомандаЗакрытьИндикатор.Видимость = Истина;
		
		СписокДляОбработки   = Элементы[ДанныеСписка.ИмяСписка];
		ПозицияТекущейСтроки = СписокДляОбработки.ТекущаяСтрока;
		ВыделенныеСтроки = Новый Массив;
		Для Каждого Идентификатор Из СписокДляОбработки.ВыделенныеСтроки Цикл
			ВыделенныеСтроки.Добавить(Новый Структура("ИдентификаторВыделенныхСтрок", Идентификатор));
		КонецЦикла;
		
