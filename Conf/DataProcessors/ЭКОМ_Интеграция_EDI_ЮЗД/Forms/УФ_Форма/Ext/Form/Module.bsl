&НаСервере
Процедура ОбновитьИдентификаторыВыделенныхСтрок(ВыделенныеСтроки, ИмяСписка)
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// сбор документов выделенных строк для использования в отборах при обращении к регистру цепочки
	Если ИмяСписка = "СписокДляПоставщика" Тогда
		СоответствиеЦепочки = СоответствиеПолейЦепочкиПоставщика();
		МассивПолейЦепочки  = МассивПолейЦепочкиПоставщика();
		ИмяРегистра = "ЭКОМ_ЦепочкиДокументовПоставщика";
		ЭКОМДокументы = МассивЭКОМДокументовЦепочкиПоставщика();
		ТиповыеДокументы = МассивТиповыхДокументовЦепочкиПоставщика();
	ИначеЕсли ИмяСписка = "СписокДляПокупателя" Тогда
		СоответствиеЦепочки = СоответствиеПолейЦепочкиПокупателя();
		МассивПолейЦепочки  = МассивПолейЦепочкиПокупателя();
		ИмяРегистра = "ЭКОМ_ЦепочкиДокументовПокупателя";
		ЭКОМДокументы = МассивЭКОМДокументовЦепочкиПокупателя();
		ТиповыеДокументы = МассивТиповыхДокументовЦепочкиПокупателя();
	Иначе
		Возврат;
	КонецЕсли;
	
	Если ВыделенныеСтроки[0].Свойство("Полученные") ИЛИ ВыделенныеСтроки[0].Свойство("КлючЗаписиЦепочкиДокументов") Тогда
		Для Каждого Строка Из ВыделенныеСтроки Цикл
			Для Каждого Элемент Из СоответствиеЦепочки Цикл
				Строка.Вставить(Элемент.Ключ, Строка.ИдентификаторВыделенныхСтрок[Элемент.Значение]);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	МассивыДокументов = Новый Структура;
	Для Каждого Элемент Из СоответствиеЦепочки Цикл
		МассивыДокументов.Вставить(Элемент.Значение, Новый Массив);
	КонецЦикла;

	Для Каждого Строка Из ВыделенныеСтроки Цикл	
		Для Каждого Элемент Из СоответствиеЦепочки Цикл
			Если Строка.Свойство(Элемент.Ключ) = Ложь Тогда
				Продолжить;
			КонецЕсли;
			
			ДокументСтроки = Строка[Элемент.Ключ];
			Если ЗначениеЗаполнено(ДокументСтроки) Тогда
				МассивДокументов = МассивыДокументов[Элемент.Значение];
				МассивДокументов.Добавить(ДокументСтроки);	
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	// получение всех измерений цепочки для заполнения полей запроса
	Измерения	   = "";
	СтруктураКлюча = Новый Структура;
	Для Каждого Измерение Из Метаданные.РегистрыСведений[ИмяРегистра].Измерения Цикл
		Измерения = Измерения + Измерение.Имя + ",";
		СтруктураКлюча.Вставить(Измерение.Имя);
	КонецЦикла;
	
	МассивПолей = ЭКОМ_ОбщегоНазначения.Эком_РазложитьСтрокуВМассивПодстрок(Измерения, ",", Истина, Истина); 
	Запрос      = ЭКОМ_ОбщегоНазначения.ЗапросКРегиструЭКОМ(ИмяРегистра, МассивПолей, МассивыДокументов, "В", "ИЛИ");
	
	Если ВыделенныеСтроки[0].Свойство("Полученные") Тогда
		Для Каждого Строка Из ВыделенныеСтроки Цикл
			Для Каждого Элемент Из СоответствиеЦепочки Цикл
				Строка.Вставить(Элемент.Ключ, Строка.ИдентификаторВыделенныхСтрок[Элемент.Значение]);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	
	Попытка
		ТаблицаЦепочки = Запрос.Выполнить().Выгрузить();
		// актуализация ключа записи для строки-источника таблицы формы ЦепочкаДокументов
		Если ВыделенныеСтроки[0].Свойство("КлючЗаписиЦепочкиДокументов") Тогда
			Строка = ВыделенныеСтроки[0];
			НоваяЗапись = Неопределено;
			Для Каждого Ключ Из МассивПолейЦепочки Цикл
				Если Строка.Свойство(Ключ) = Ложь Тогда
					Продолжить;
				КонецЕсли;
				ЗначениеСоответствия = СоответствиеЦепочки.Получить(Ключ);
				
				ДокументДляПоиска = Строка[Ключ]; 
				Если ЗначениеЗаполнено(ДокументДляПоиска) Тогда
					НайденныеСтроки = ТаблицаЦепочки.НайтиСтроки(Новый Структура(ЗначениеСоответствия, Строка[Ключ]));
					Если НайденныеСтроки.Количество() = 1 Тогда
						НоваяЗапись = НайденныеСтроки[0];
						Прервать;
					КонецЕсли;
				КонецЕсли;				
			КонецЦикла;
			
			Если НоваяЗапись = Неопределено Тогда
				ВыделенныеСтроки = Новый Структура("ИдентификаторВыделенныхСтрок, КлючЗаписиЦепочкиДокументов, УдалосьОпределить", ВыделенныеСтроки[0].ИдентификаторВыделенныхСтрок, Истина, Ложь);
			Иначе
				ЗаполнитьЗначенияСвойств(СтруктураКлюча, НоваяЗапись);
				КлючЗаписи  = РегистрыСведений[ИмяРегистра].СоздатьКлючЗаписи(СтруктураКлюча);
				ВыделенныеСтроки = Новый Структура("ИдентификаторВыделенныхСтрок, КлючЗаписиЦепочкиДокументов, УдалосьОпределить",КлючЗаписи, Истина, Истина);
			КонецЕсли;
			
			Возврат;
		КонецЕсли;
		
		Для Каждого Строка Из ВыделенныеСтроки Цикл
			Отбор = Новый Структура;
			// заполнение отбора всеми доступными документами выделенной строки
			Для Каждого Элемент Из СоответствиеЦепочки Цикл
				// если строка является повторной (документ пересоздается), то отбор будет только по тем документам,
				// которые нельзя пересоздать (все ЭКОМ и для покупателя дополнительно - заказ)
				Если Строка.Свойство("Повтор") И ЭКОМДокументы.Найти(Элемент.Ключ) = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				//// если строка является полученной, то отбор будет только по тем документам,
				//// которые нельзя получить (все типовые документы 1С в цепочке)
				Если Строка.Свойство("Полученные") И ТиповыеДокументы.Найти(Элемент.Ключ) = Неопределено Тогда
					Продолжить;
				КонецЕсли;  
				
				Если Строка.Свойство(Элемент.Ключ) = Ложь Тогда
					Продолжить;
				КонецЕсли;
				
				ДокументДляПоиска = Строка[Элемент.Ключ]; 
				Если ЗначениеЗаполнено(ДокументДляПоиска) Тогда
					Отбор.Вставить(Элемент.Значение, Строка[Элемент.Ключ]);
				КонецЕсли;
			КонецЦикла;
			
			// поиск строки в регистре цепочки с актуальными данными, по отбору данными выделенной строки до изменения
			// когда поиск успешен, актуализируется идентификатор выделенных строк
			НайденныеСтроки = ТаблицаЦепочки.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() Тогда
				ЗаполнитьЗначенияСвойств(СтруктураКлюча, НайденныеСтроки[0]);
				КлючЗаписи  = РегистрыСведений[ИмяРегистра].СоздатьКлючЗаписи(СтруктураКлюча);
				Строка.ИдентификаторВыделенныхСтрок = КлючЗаписи;  				
			КонецЕсли;
		КонецЦикла;

	Исключение
		Сообщить("Не удалось обновить идентификаторы выделенных строк");
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокВыбранныхСтрок(ИмяСписка);
	ТЗ = ДинамическийСписок_в_ТЗ(ИмяСписка);
	ПоследнийИндекс = СписокВыбранныхСтрок.Количество() - 1;
	
	МассивEDI = ЭКОМ_ВзаимодействиеREST_API.ПолучитьМассивТиповEDI();	
	Если ИмяСписка = "СписокДляПоставщика" Тогда
		ИменаДокументовЦепочки = МассивИменДокументовЦепочкиПоставщика();
	ИначеЕсли ИмяСписка = "СписокДляПокупателя" Тогда
		ИменаДокументовЦепочки = МассивИменДокументовЦепочкиПокупателя();
	ИначеЕсли ЭКОМ_ОбщегоНазначения.ПоискВСтроке(ИмяСписка, "СписокДляПрайсЛиста") > 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ЭКОМ_Документы.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.УстановкаЦенНоменклатуры КАК УстановкаЦенНоменклатуры
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭКОМ_Документы КАК ЭКОМ_Документы
		|		ПО (ЭКОМ_Документы.Документ1С = УстановкаЦенНоменклатуры.Ссылка)
		|			И (ЭКОМ_Документы.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.PRICAT_Исходящий))
		|ГДЕ
		|	УстановкаЦенНоменклатуры.Ссылка В(&МассивУстановок)
		|	И НЕ ЭКОМ_Документы.Ссылка ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЭКОМ_Документы.Документ1С
		|ИЗ
		|	Документ.ЭКОМ_Документы КАК ЭКОМ_Документы
		|ГДЕ
		|	ЭКОМ_Документы.Ссылка В(&МассивPRICAT)
		|	И ЭКОМ_Документы.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ЭКОМ_ВидыДокументов.PRICAT_Входящий)
		|	И НЕ ЭКОМ_Документы.Документ1С = ЗНАЧЕНИЕ(Документ.УстановкаЦенНоменклатуры.ПустаяСсылка)";
		МассивУстановок = Новый Массив;
		МассивPRICAT    = Новый Массив;
		
		Для Каждого ВыбраннаяСтрока Из СписокВыбранныхСтрок Цикл
			Если ТипЗнч(ВыбраннаяСтрока.Значение) = Тип("ДокументСсылка.УстановкаЦенНоменклатуры") Тогда
				МассивУстановок.Добавить(ВыбраннаяСтрока.Значение);
			ИначеЕсли ТипЗнч(ВыбраннаяСтрока.Значение) = Тип("ДокументСсылка.ЭКОМ_Документы") Тогда
				МассивPRICAT.Добавить(ВыбраннаяСтрока.Значение);
			КонецЕсли;
		КонецЦикла;
		
		Запрос.УстановитьПараметр("МассивУстановок", МассивУстановок);
		Запрос.УстановитьПараметр("МассивPRICAT"   , МассивPRICAT);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			СписокВыбранныхСтрок.Добавить(Выборка.Ссылка);
		КонецЦикла;
		
		Возврат;
	Иначе
		Возврат;
	КонецЕсли;
	
	ИсключитьИзПроверки = Новый Массив;
	ИсключитьИзПроверки.Добавить("ВозвратТоваровОтПокупателя");
	ИсключитьИзПроверки.Добавить("ЭКОМ_Документ_RECADV");
	ИсключитьИзПроверки.Добавить("ЭКОМ_Документ_RETINS");
	ИсключитьИзПроверки.Добавить("ВозвратТоваровПоставщику");
	ИсключитьИзПроверки.Добавить("ДокументыВсе");
	ИсключитьИзПроверки.Добавить("Ссылка");
	
	Если ТЗ.Количество() Тогда
		
		ИндексПоследнего = СписокВыбранныхСтрок.Количество() - 1;
		Для Счетчик = 0 По ИндексПоследнего Цикл
			ИндексТекущего = ИндексПоследнего - Счетчик;
			ВыбраннаяСтрока = СписокВыбранныхСтрок[ИндексТекущего];
			
			ПредставлениеВыбранного = Строка(ВыбраннаяСтрока.Значение);
			ПредставлениеВыбранного = Лев(ПредставлениеВыбранного, ЭКОМ_ОбщегоНазначения.ПоискВСтроке(ПредставлениеВыбранного, " ") - 1);
			
			Для Каждого Колонка Из ТЗ.Колонки Цикл
				Если ТипЗнч(ВыбраннаяСтрока.Значение) =  ТипЗнч(ТЗ[0][Колонка.Имя]) И ИсключитьИзПроверки.Найти(Колонка.Имя) = Неопределено Тогда
					Если ТипЗнч(ВыбраннаяСтрока.Значение) = Тип("ДокументСсылка.ЭКОМ_Документы")Тогда
						
						ПредставлениеНайденного = Строка(ТЗ[0][Колонка.Имя]);
						ПредставлениеНайденного = Лев(ПредставлениеНайденного, ЭКОМ_ОбщегоНазначения.ПоискВСтроке(ПредставлениеНайденного, " ") - 1); 
						
						ТипДокументаОтсутствуетВКолонке = ЭКОМ_ОбщегоНазначения.ПоискВСтроке(Колонка.Имя, ПредставлениеВыбранного) = 0;
						Если Не ПредставлениеВыбранного = ПредставлениеНайденного И ТипДокументаОтсутствуетВКолонке Тогда
							Продолжить;	
						КонецЕсли;
					КонецЕсли;
					КолонкаПоиска = Колонка.Имя;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			ТипЮЗД = МассивEDI.Найти(ПредставлениеВыбранного) = Неопределено;
			Если ТипЮЗД И Не ЗначениеЗаполнено(КолонкаПоиска) Тогда
				КолонкаПоиска = "ДокументЭКОМ_ЮЗД";
			КонецЕсли;
			
			Если ЗначениеЗаполнено(КолонкаПоиска) Тогда
				НайденнаяСтрока = ТЗ.Найти(ВыбраннаяСтрока.Значение, КолонкаПоиска);
				Если НайденнаяСтрока <> Неопределено Тогда
					Для Каждого Элемент Из ИменаДокументовЦепочки Цикл
						Если ТЗ.Колонки.Найти(Элемент) = Неопределено Тогда
							Продолжить;
						КонецЕсли;
						
						АктуальныйДокумент = НайденнаяСтрока[Элемент];
						Если ЗначениеЗаполнено(АктуальныйДокумент) И ИсключитьИзПроверки.Найти(Элемент) = Неопределено Тогда
							Если СписокВыбранныхСтрок.НайтиПоЗначению(АктуальныйДокумент) = Неопределено Тогда
								ВыбраннаяСтрока.Значение = АктуальныйДокумент;
							КонецЕсли;
							Прервать;
						КонецЕсли;
					КонецЦикла; 
				Иначе
					// когда выбранная строка не найдена - её больше нет в динамическом списке, 
					// поэтому требуется удаление из списка выбранных
					СписокВыбранныхСтрок.Удалить(ИндексТекущего);
				КонецЕсли; // строка найдена
			КонецЕсли; // заполненность колонки поиска
			
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВыделенныеСтроки(ВыбранныеСтроки, ИмяСписка) 
	Если ВыбранныеСтроки.Количество() И ВыбранныеСтроки[0].Свойство("ИдентификаторВыделенныхСтрок") Тогда
		ИдентификаторВМассиве = Ложь;
		Для Каждого Идентификатор Из Элементы[ИмяСписка].ВыделенныеСтроки Цикл
			Для Каждого Строка Из ВыбранныеСтроки Цикл
				Если Идентификатор = Строка.ИдентификаторВыделенныхСтрок Тогда
					ИдентификаторВМассиве = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если Не ИдентификаторВМассиве Тогда
				ВыбранныеСтроки.Добавить(Новый Структура("ИдентификаторВыделенныхСтрок", Идентификатор));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

