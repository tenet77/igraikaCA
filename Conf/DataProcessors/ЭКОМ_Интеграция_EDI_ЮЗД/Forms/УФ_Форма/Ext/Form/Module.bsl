&НаКлиенте
Функция ОтправитьФайлыНаКлиенте(МассивСтрок, ТипДокумента, ДанныеСписка, ОбщийПроцентПрогресса, ПозицияТекущейСтроки, ВыделенныеСтроки, ЭтоПовторнаяОтправка, МассивЛогаСобытий, ПодписатьФайл, ЭтоНовыеДокументы) Экспорт
	
	ИмяСобытия = "Отправить документы - " + ТипДокумента;
    НачалоВыполнения = ТекущаяДата();
	
	ОбработатьФайлыНаКлиенте = Истина;
	ЭтоРегламентноеЗадание   = Ложь;
    СтруктураЛога            = Вычислить("ЭКОМ_ОбщегоНазначенияКлиент.ПолучитьСтруктуруЛогаНаКлиенте()");
	
	ТекстСообщения = "";
	Если ЭтоПовторнаяОтправка = Истина Тогда
		ТекстСообщения = "Повторная отправка. ";
	КонецЕсли;

	КлючЗаписиЦепочкиДокументов = Элементы[ДанныеСписка.ИмяСписка].ТекущаяСтрока;
	// Начать обработку данных
	Если ЭтаФорма.ДоступноВыполнениеВФоне Тогда
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("МассивСтрок"             , МассивСтрок);
		СтруктураПараметров.Вставить("ТипДокумента"            , ТипДокумента);
		СтруктураПараметров.Вставить("МассивЛогаСобытий"       , МассивЛогаСобытий);
		СтруктураПараметров.Вставить("ЭтоРегламентноеЗадание"  , ЭтоРегламентноеЗадание);
		СтруктураПараметров.Вставить("НомерИсправления"        , ЭтаФорма.НомерИсправления);
		СтруктураПараметров.Вставить("ПодписатьФайл"           , ПодписатьФайл);
		СтруктураПараметров.Вставить("СтруктураЛога"           , СтруктураЛога);
		СтруктураПараметров.Вставить("НачалоВыполнения"       , НачалоВыполнения);
		СтруктураПараметров.Вставить("ДанныеСписка"           , ДанныеСписка);		
		СтруктураПараметров.Вставить("ВыделенныеСтроки"       , ВыделенныеСтроки);
		СтруктураПараметров.Вставить("ПозицияТекущейСтроки"   , ПозицияТекущейСтроки);
		СтруктураПараметров.Вставить("ОбщийПроцентПрогресса"  , ОбщийПроцентПрогресса);
		СтруктураПараметров.Вставить("ЭтоНовыеДокументы"      , ЭтоНовыеДокументы);
		СтруктураПараметров.Вставить("ИмяСобытия"			  , ИмяСобытия);
		СтруктураПараметров.Вставить("КлючЗаписиЦепочкиДокументов", КлючЗаписиЦепочкиДокументов);
		
		НачатьВыполнениеВФоне(СтруктураПараметров, "ОтправитьВсеФайлы", ТекстСообщения + "Формируем XML и отправляем файлы - [" + ТипДокумента + "]...");
		Возврат Ложь;	
	Иначе	
		МассивСтруктур = ОтправитьВсеФайлыНаСервереБезКонтекста(ЭтаФорма.ОбработкаТип, МассивСтрок, ТипДокумента, МассивЛогаСобытий, ЭтоРегламентноеЗадание, ЭтаФорма.НомерИсправления, ПодписатьФайл, ЭтоНовыеДокументы, СтруктураЛога);   	
	    ОбработатьОтправкуФайловНаКлиенте(МассивСтруктур, ТипДокумента, НачалоВыполнения, МассивЛогаСобытий, ДанныеСписка, ПозицияТекущейСтроки, ВыделенныеСтроки, ОбщийПроцентПрогресса, ПодписатьФайл, СтруктураЛога, ЭтоРегламентноеЗадание, ЭтоНовыеДокументы, КлючЗаписиЦепочкиДокументов);		
		Возврат Истина;		
	КонецЕсли;
		
КонецФункции

&НаКлиенте
Процедура ОбработатьОтправкуФайловНаКлиенте(МассивСтруктур, ТипДокумента, НачалоВыполнения, МассивЛогаСобытий, ДанныеСписка, ПозицияТекущейСтроки, ВыделенныеСтроки, ОбщийПроцентПрогресса, ПодписатьФайл, СтруктураЛога, ЭтоРегламентноеЗадание, ЭтоНовыеДокументы, КлючЗаписиЦепочкиДокументов = Неопределено) Экспорт
	НастройкиПрофилейОбмена = ЭКОМ_ОбщегоНазначения.ПолучитьНастройкиПрофилейОбмена();
	СохранятьУПДЛокальноБезПодписи = ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере("ЭКОМ_СохранятьУПДЛокальноБезПодписи");
	Если СохранятьУПДЛокальноБезПодписи = Неопределено ИЛИ
		Не ТипЗнч(СохранятьУПДЛокальноБезПодписи) = Тип("Булево") Тогда
		СохранятьУПДЛокальноБезПодписи = Ложь;
	КонецЕсли; 
	
	ИмяСобытия = "Отправка документов на клиенте " + ТипДокумента;	
	Если НЕ МассивСтруктур.Количество() = 0 Тогда
		
		ЗначениеПоУмолчанию = "";
		Измерение           = Неопределено; 
		Обязательно         = Истина;
		ЛокальныйКаталогOUTBOX_Архив = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_Локальный_Каталог_OUTBOX_Архив"", ЗначениеПоУмолчанию, Измерение, Обязательно)");
		
		// Проверка каталогов
		ДанныеОС = ЭКОМ_ПолучитьРазделительПутиОСКлиента();
		РазделительПути = ДанныеОС.Получить("РазделительПути");
		
		РаботаСФайламиВыполняетсяЛокально = Ложь;
		Для Каждого Соответствие Из НастройкиПрофилейОбмена Цикл
			Если Соответствие.Значение Тогда
				РаботаСФайламиВыполняетсяЛокально = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		ЛокальныеКаталоги 	    = ПолучитьИнформациюОЛокальныхКаталогах(РаботаСФайламиВыполняетсяЛокально, 
									ЛокальныйКаталогOUTBOX_Архив, ТипДокумента, РазделительПути, МассивЛогаСобытий);  
		КаталогСохранения       = ЛокальныеКаталоги.КаталогСохранения;
		КаталогСохраненияФайл   = ЛокальныеКаталоги.КаталогСохраненияФайл;     			
		КаталогMarkingДоступен  = ЛокальныеКаталоги.КаталогMarkingДоступен;
		КаталогOutboxДоступен   = ЛокальныеКаталоги.КаталогOutboxДоступен;
		ЛокальныйКаталогMarking = ЛокальныеКаталоги.КаталогMarking;
		ЛокальныйКаталогOUTBOX  = ЛокальныеКаталоги.КаталогOUTBOX; 
		
		Если НЕ КаталогСохраненияФайл = Неопределено И КаталогMarkingДоступен И КаталогOutboxДоступен Тогда
			
			МассивОшибочных = Новый Массив;
			Для каждого СтруктураEDI Из МассивСтруктур Цикл
				
				СтруктураEDI.Вставить("Отправлен"    , Ложь);
				СтруктураEDI.Вставить("Сообщение"    , "");
				
				// Проверка чтобы вся цепочка была подписана одним сертификатом для поставщика
				Если ТипДокумента = "DP_IZVPOL_04"
					ИЛИ ТипДокумента = "DP_IZVPOL_10"
					ИЛИ ТипДокумента = "DP_PTORG1" Тогда
					
					// Получаю из хранилища двоичные данные		
					Если НЕ ЗначениеЗаполнено(СтруктураEDI.ЭЦПотЮЗД) Тогда
						ТекстЛогаСобытий = "ЭЦП неопрелен для " + СтруктураEDI.ПредставлениеДок;
						ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Ошибка"), ИмяСобытия);
						МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
						
						Продолжить;
					КонецЕсли;
					
					Если СтруктураEDI.СертификатНаСервере = Истина Тогда		
						СертификатСовпадает = Вычислить("ЭКОМ_ОбщегоНазначения.ЭЦП_ОперацииПроверкиПодписиНаСервере(СтруктураEDI.ЭЦПотЮЗД, СтруктураEDI.ДанныеСертификатаЭКОМ, МассивЛогаСобытий)");
					Иначе
						СертификатСовпадает = Вычислить("ЭКОМ_ОбщегоНазначенияКлиент.ЭЦП_ОперацииПроверкиПодписиНаКлиенте(СтруктураEDI.ЭЦПотЮЗД, СтруктураEDI.ДанныеСертификатаЭКОМ, МассивЛогаСобытий)");
					КонецЕсли;
					
					Если НЕ СертификатСовпадает Тогда
						ТекстЛогаСобытий = "УПД подписан другим сертификатом, " + ТипДокумента + " на " + Строка(СтруктураEDI.ВидДокумента) + " отправлен не будет! (1852) - " + СтруктураEDI.ПредставлениеДок;
						ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Ошибка"), ИмяСобытия);
						МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

						Продолжить;
					КонецЕсли;		
					
				КонецЕсли;
				
				// Получем файл 
				ФайлXML = ПолучитьФайлДокументаНаКлиенте(СтруктураEDI.ИмяФайлаXML, СтруктураEDI.СтрокаXML, СтруктураEDI.КодировкаФайла, КаталогСохранения);
				Если НЕ ФайлXML.Существует() Тогда
					Продолжить;
				КонецЕсли; 
				
				ПроверятьФайлыЛокально = НастройкиПрофилейОбмена.Получить(СтруктураEDI.Организация);
				Если ПроверятьФайлыЛокально Тогда
					КопироватьФайл(ФайлXML.ПолноеИмя, ЛокальныйКаталогOUTBOX + ФайлXML.Имя);
				КонецЕсли;
				
				Если ПроверятьФайлыЛокально И СохранятьУПДЛокальноБезПодписи Тогда
					Продолжить;
				КонецЕсли;
				
				Если ПодписатьФайл Тогда
					ФайлBINПолноеИмя = КаталогСохранения + ФайлXML.ИмяБезРасширения + ".bin";
					ДвоичныеДанныеФайлаXML = Новый ДвоичныеДанные(ФайлXML.ПолноеИмя);
					
					//+MOD-2544
					//Если СтруктураEDI.СтранаПрофиля = "kz" И Найти(ТипДокумента, "CONDRA_") > 0 Тогда //добавим прикрепленный файл
					//	ЗначениеПоУмолчанию = "";
					//	ЛокальныйКаталогINBOX_Архив = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_Локальный_Каталог_INBOX_Архив"", ЗначениеПоУмолчанию, Измерение, Обязательно)");
					//	НайденныеФайлы = НайтиФайлы(ЛокальныйКаталогINBOX_Архив + "CONDRA", СтруктураEDI.ИмяФайла, Истина);
					//	
					//	Если НайденныеФайлы.Количество() Тогда
					//		Файл =  Новый Файл(НайденныеФайлы[0].ПолноеИмя);
					//		ДвоичныеДанныеФайлаXML = Новый ДвоичныеДанные(Файл.ПолноеИмя);
					//		СтруктураEDI.Вставить("ИмяФайлаДанных", Файл.Имя);                      
					//		СтруктураEDI.Вставить("ДвоичныеДанныеФайлаДанных", ДвоичныеДанныеФайлаXML);
					//	КонецЕсли;

					//КонецЕсли;
					//-MOD-2544
					
					// Создаем подпись
					Если СтруктураEDI.СертификатНаСервере = Истина Тогда              
						ДвоичныеДанныеФайлаBIN = Вычислить("ЭКОМ_ОбщегоНазначения.ЭЦП_СформироватьПодписьФайлаОбщегоНазначения(ДвоичныеДанныеФайлаXML, СтруктураEDI.ДанныеСертификатаЭКОМ, МассивЛогаСобытий)");
						ТипПодписи = "на сервере";
						
					Иначе
						Если СтруктураEDI.СтранаПрофиля = "kz" Тогда //MOD-2544  					
							Base64ДанныеФайлаBIN = Вычислить("ЭКОМ_ОбщегоНазначенияКлиент.ПодписатьТекстKalkanCryptCOM(ДвоичныеДанныеФайлаXML, МассивЛогаСобытий)");
							ДвоичныеДанныеФайлаBIN = Base64Значение(Base64ДанныеФайлаBIN);
						Иначе	
							ДвоичныеДанныеФайлаBIN = Вычислить("ЭКОМ_ОбщегоНазначенияКлиент.ЭЦП_СформироватьПодписьФайлаОбщегоНазначения(ДвоичныеДанныеФайлаXML, СтруктураEDI.ДанныеСертификатаЭКОМ, МассивЛогаСобытий)");
						КонецЕсли;
						//ДвоичныеДанныеФайлаBIN = Вычислить("ЭКОМ_ОбщегоНазначенияКлиент.ЭЦП_СформироватьПодписьФайлаОбщегоНазначения(ДвоичныеДанныеФайлаXML, СтруктураEDI.ДанныеСертификатаЭКОМ, МассивЛогаСобытий)");
						ТипПодписи = "на клиенте";				
					КонецЕсли;
					
					Если ДвоичныеДанныеФайлаBIN = Неопределено Тогда
						ТекстЛогаСобытий = ТипДокумента + " - по электронному документу " + СокрЛП(СтруктураEDI.Документ) + 
						" - " + ТипПодписи + " не подписан! Проверьте сертификат по организации - " + СокрЛП(СтруктураEDI.Организация);
						ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Ошибка"), ИмяСобытия);
						МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

						МассивОшибочных.Добавить(СтруктураEDI);
						Продолжить;
						
					Иначе
						// Файл подписи необходимо закодировать в Base64
						ФайлПодписи = Новый ЗаписьТекста(ФайлBINПолноеИмя, КодировкаТекста.ANSI);		
						ФайлПодписи.Записать(Base64Строка(ДвоичныеДанныеФайлаBIN));
						ФайлПодписи.Закрыть();
						
						Если ПроверятьФайлыЛокально Тогда
							КопироватьФайл(ФайлПодписи.ПолноеИмя, ЛокальныйКаталогOUTBOX + ФайлПодписи.Имя);
						КонецЕсли;
						
					КонецЕсли;
					
					СтруктураEDI.Вставить("ИмяФайлаBIN"           , ФайлXML.ИмяБезРасширения + ".bin");
					СтруктураEDI.Вставить("ДвоичныеДанныеФайлаBIN", ДвоичныеДанныеФайлаBIN);
					
				КонецЕсли;
				
			КонецЦикла;
			
			// Удаляем 
			Для каждого ЭлМассивОшибочных Из МассивОшибочных Цикл
				Для каждого СтруктураEDI Из МассивСтруктур  Цикл
					Если СтруктураEDI.ИмяФайлаXML = ЭлМассивОшибочных.ИмяФайлаXML Тогда
						МассивСтруктур.Удалить(МассивСтруктур.Найти(СтруктураEDI));	
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			
			// Начать обработку данных
			Если ЭтаФорма.ДоступноВыполнениеВФоне Тогда
				
				СтруктураПараметров = Новый Структура;
				СтруктураПараметров.Вставить("МассивФайловВсего"       , МассивСтруктур);
				СтруктураПараметров.Вставить("ТипДокумента"            , ТипДокумента);
				//Docrobot 1.20.0 MOD-1637 [Вместо МассивЛогаСобытий отправляем новый массив, в противном случае лог задваивается]
				СтруктураПараметров.Вставить("МассивЛогаСобытий"       , Новый Массив);
				СтруктураПараметров.Вставить("ЭтоРегламентноеЗадание"  , ЭтоРегламентноеЗадание);
				
				СтруктураПараметров.Вставить("НачалоВыполнения"       , НачалоВыполнения);
				СтруктураПараметров.Вставить("ДанныеСписка"           , ДанныеСписка);			
				СтруктураПараметров.Вставить("ВыделенныеСтроки"       , ВыделенныеСтроки);
				СтруктураПараметров.Вставить("ПозицияТекущейСтроки"   , ПозицияТекущейСтроки);
				СтруктураПараметров.Вставить("ОбщийПроцентПрогресса"  , ОбщийПроцентПрогресса);
				СтруктураПараметров.Вставить("СтруктураЛога"          , СтруктураЛога);
				СтруктураПараметров.Вставить("ЭтоНовыеДокументы"      , ЭтоНовыеДокументы);
				СтруктураПараметров.Вставить("КлючЗаписиЦепочкиДокументов", КлючЗаписиЦепочкиДокументов);
				
				НачатьВыполнениеВФоне(СтруктураПараметров, "ОтправитьФайлы", "Отправляем подписанные файлы XML - [" + ТипДокумента + "]...");
				
			Иначе				
				ОтправитьФайлыНаСервереБезКонтекста(ЭтаФорма.ОбработкаТип, МассивСтруктур, ТипДокумента, МассивЛогаСобытий, ЭтоРегламентноеЗадание, ЭтоНовыеДокументы, СтруктураЛога);	
				ЗавершитьОтправкуНаКлиенте(ТипДокумента, НачалоВыполнения, МассивЛогаСобытий, ДанныеСписка, ПозицияТекущейСтроки, ВыделенныеСтроки, ОбщийПроцентПрогресса, СтруктураЛога, КлючЗаписиЦепочкиДокументов);
				
			КонецЕсли;
		Иначе
			ТекстЛогаСобытий = "";
			Если КаталогСохраненияФайл = Неопределено Тогда
				ТекстЛогаСобытий = ТекстЛогаСобытий + "Проверьте каталог сохранения исходящих и каталог сохранения архива исходящих файлов";
			ИначеЕсли Не КаталогMarkingДоступен Тогда
				ТекстЛогаСобытий = ТекстЛогаСобытий + "Проверьте каталог ""marking"". Возможно незаполнен адрес или каталог недоступен для записи на сервере"; 
			ИначеЕсли Не КаталогOutboxДоступен Тогда
				ТекстЛогаСобытий = ТекстЛогаСобытий + "Проверьте каталог ""outbox"". Возможно незаполнен адрес или каталог недоступен для записи."; 
			КонецЕсли;

			СтруктураЛога.ЕстьОшибка = Истина;
			ЗаписьСтруктурыЛога		 = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Ошибка"), ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

			ЗавершитьОтправкуНаКлиенте(ТипДокумента, НачалоВыполнения, МассивЛогаСобытий, ДанныеСписка, ПозицияТекущейСтроки, ВыделенныеСтроки, ОбщийПроцентПрогресса, СтруктураЛога, КлючЗаписиЦепочкиДокументов);
		КонецЕсли;	
	Иначе
		ТекстЛогаСобытий = "Нет сформированных документов для отправки";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Предупреждение"), ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		ЗавершитьОтправкуНаКлиенте(ТипДокумента, НачалоВыполнения, МассивЛогаСобытий, ДанныеСписка, ПозицияТекущейСтроки, ВыделенныеСтроки, ОбщийПроцентПрогресса, СтруктураЛога, КлючЗаписиЦепочкиДокументов);

	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьОтправкуНаКлиенте(ТипДокумента, НачалоВыполнения, МассивЛогаСобытий, ДанныеСписка, ПозицияТекущейСтроки, ВыделенныеСтроки, ОбщийПроцентПрогресса, СтруктураЛога, КлючЗаписиЦепочкиДокументов = Неопределено) Экспорт
	
	ИмяСобытия = "Отправка документов на клиенте " + ТипДокумента;
	
	// Статус завершения операции в фоне
	ЭтаФорма.Индикатор = ЭтаФорма.Индикатор + ОбщийПроцентПрогресса;
	Если ЭтаФорма.Индикатор > 99 Тогда
	     Элементы.ПолеИндикатор.Видимость = Ложь;
		 Элементы.КомандаЗакрытьИндикатор.Видимость = Ложь;
	КонецЕсли;
		
	Если СтруктураЛога.ЕстьОшибка = Истина Тогда
		Элементы.КомандаНадписьОшибка.Видимость = Истина;
	КонецЕсли;
	
	ОбновитьДинамическийСписок(ДанныеСписка, Истина, ВыделенныеСтроки, КлючЗаписиЦепочкиДокументов);
	ОбновитьЦепочкуДокументовНаКлиенте(ДанныеСписка.ИмяСписка, КлючЗаписиЦепочкиДокументов);
	ОбновитьКвитанцииНаКлиенте(ДанныеСписка.ИмяСписка);	
    ВосстановитьТекущуюСтрокуСписка(ПозицияТекущейСтроки, ДанныеСписка.ИмяСписка, ВыделенныеСтроки);  
	
	ТекстЛогаСобытий = "Время выполнения " + ЭКОМ_ОбщегоНазначенияКлиент.СекундыВоВремяНаКлиенте(ТекущаяДата() - НачалоВыполнения).Строка;
	ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Информация"), ИмяСобытия);
	МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
	
	ОтобразитьЛогСобытий(МассивЛогаСобытий);
	
КонецПроцедуры


