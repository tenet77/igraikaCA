&НаКлиенте
Функция ПолучитьФайлДокументаНаКлиенте(ИмяФайлаXML, ТекстXML, КодировкаФайла, ВременныйКаталог)
	
	ПолноеИмяФайлаXML = ВременныйКаталог + ИмяФайлаXML;
	Текст = Новый ТекстовыйДокумент; 
	Текст.УстановитьТекст(ТекстXML); 
	Текст.Записать(ПолноеИмяФайлаXML, КодировкаФайла); 
	
	ФайлXML = Новый Файл(ПолноеИмяФайлаXML);
	
	Возврат ФайлXML;			
		
КонецФункции

&НаКлиенте
Процедура ПометкиСписокДляЭТРНСнятьВсе(Команда)
	УправлениеПометкамиДинамическогоСписка(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ПометкиСписокДляЭТРНУстановитьВсе(Команда)
	УправлениеПометкамиДинамическогоСписка(Истина);
КонецПроцедуры

&НаСервере
Процедура РазблокировкаПроцессаОбменаНаСервере()
	
	ОбъектЭтаОбработка = РеквизитФормыВЗначение("Объект");

	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Измерение", "Блокировка");
	
	ПараметрыЗаписи = Новый Структура;
	ПараметрыЗаписи.Вставить("ЗначениеДополнительнойКонстанты", Ложь);
	
	ОбъектЭтаОбработка.ЗаписьВРегистр("ЭКОМ_ЗначениеДополнительныхКонстант", ПараметрыОтбора, ПараметрыЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура РазблокировкаПроцессаОбмена(Команда)
	
	РазблокировкаПроцессаОбменаНаСервере();
	
	МассивЛогаСобытий = Новый Массив;
	ТекстЛогаСобытий = "Обмен документами разблокирован!";
	ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Информация"), "Разблокировка документов");
	МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

	ОтобразитьЛогСобытий(МассивЛогаСобытий);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЛокальныйКаталог(ЛокальныйКаталог, РазделительПути)

	// Проверка каталога
	Если НЕ Прав(ЛокальныйКаталог, 1) = РазделительПути 
		И ЗначениеЗаполнено(ЛокальныйКаталог) Тогда	
		ЛокальныйКаталог = ЛокальныйКаталог + РазделительПути; 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЭКОМ_СоздатьКаталог(ЛокальныйКаталог, ДанныеОС)
	
	Диск            = ДанныеОС.Получить("Диск");
	РазделительПути = ДанныеОС.Получить("РазделительПути");

	Файл = Новый Файл(ЛокальныйКаталог);
	Если Файл.Существует() Тогда
		
		Если Файл.ЭтоФайл() Тогда
			Сообщить("Каталог <" + ЛокальныйКаталог + "> является файлом (195). Создан каталог по умолчанию!!! ", СтатусСообщения.Важное);
			ЛокальныйКаталог = ОпределитьКаталогПоУмолчанию(Диск, РазделительПути);
			СоздатьКаталог(ЛокальныйКаталог);
			Сообщить("Создан каталог по умолчанию!!! - <" + ЛокальныйКаталог + ">", СтатусСообщения.Важное);
		КонецЕсли;
		
	Иначе
		
		Если ЗначениеЗаполнено(ЛокальныйКаталог) Тогда
			Попытка
				СоздатьКаталог(ЛокальныйКаталог);
			Исключение
				Сообщить("Ошибка при создании каталога (196): <" + ЛокальныйКаталог + ">");
				ЛокальныйКаталог = ОпределитьКаталогПоУмолчанию(Диск, РазделительПути);
				СоздатьКаталог(ЛокальныйКаталог);
	            Сообщить("Создан каталог по умолчанию!!! - <" + ЛокальныйКаталог + ">", СтатусСообщения.Важное);
			КонецПопытки;	
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

