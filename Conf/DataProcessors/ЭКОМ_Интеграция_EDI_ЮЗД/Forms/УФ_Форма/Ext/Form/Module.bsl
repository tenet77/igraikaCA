&НаКлиенте
Процедура КомандаПометитьЭКОМЗаказНаУдалениеОтправитьВАрхив(Команда)
    
    МассивЛогаСобытий = Новый Массив;
       
    ВыделенныеСтроки = Элементы.СписокДляПоставщика.ВыделенныеСтроки;
    МассивСтрок = Новый Массив();
    Для каждого ИдентификаторСтроки_ Из ВыделенныеСтроки Цикл
        Если ЗначениеЗаполнено(Элементы.СписокДляПоставщика.ДанныеСтроки(ИдентификаторСтроки_).ЭКОМ_Документ_ORDER) Тогда
            МассивСтрок.Добавить(Элементы.СписокДляПоставщика.ДанныеСтроки(ИдентификаторСтроки_).ЭКОМ_Документ_ORDER);
        КонецЕсли;	
    КонецЦикла;
	
	ДанныеОС = ЭКОМ_ПолучитьРазделительПутиОСКлиента();
	РазделительПути = ДанныеОС.Получить("РазделительПути");

	МассивОбработанныхФайлов = ПолучитьИменаФайлов(МассивСтрок, РазделительПути);
	Если МассивОбработанныхФайлов.Количество() > 0 Тогда
		
		ПометитьЭКОМЗаказНаУдалениеОтправитьВАрхивНаСервере(МассивОбработанныхФайлов, ДанныеОС, МассивЛогаСобытий);	 		
		
		ЗначениеПоУмолчанию = Неопределено;
		Измерение           = Неопределено; 
		Обязательно         = Истина;
		ЛокальныйКаталогINBOX = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_Локальный_Каталог_INBOX"", ЗначениеПоУмолчанию, Измерение, Обязательно)");
		
		ЗначениеПоУмолчанию = Неопределено;
		Измерение           = Неопределено; 
		Обязательно         = Истина;
		ЛокальныйКаталогINBOX_Архив = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_Локальный_Каталог_INBOX_Архив"", ЗначениеПоУмолчанию, Измерение, Обязательно)");
		
		ПроверитьЛокальныйКаталог(ЛокальныйКаталогINBOX, РазделительПути);
		ПроверитьЛокальныйКаталог(ЛокальныйКаталогINBOX_Архив, РазделительПути);
		
		КаталогСохранения = ЛокальныйКаталогINBOX_Архив + "ORDER" + РазделительПути + Формат(ТекущаяДата(), "ДФ=yyyyMMdd") + РазделительПути; 
		СоздатьКаталог(КаталогСохранения);
		
		// После создания переносим загруженный файл в архив
		Для Каждого ЭлФайл Из МассивОбработанныхФайлов Цикл
			Файл = Новый Файл(ЛокальныйКаталогINBOX + ЭлФайл.Имя);
			Если Файл.Существует() Тогда
				ПереместитьФайл(ЛокальныйКаталогINBOX + ЭлФайл.Имя, КаталогСохранения + ЭлФайл.Имя);	 
			КонецЕсли;			
		КонецЦикла;		
		
		Элементы.СписокДляПоставщика.Обновить();
	КонецЕсли;
	
	ОтобразитьЛогСобытий(МассивЛогаСобытий);

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьЛогСобытияВФайл(МассивЛогаСобытий, Каталог)
	
	ТекстСообщения = Вычислить("ЭКОМ_ОбщегоНазначенияКлиент.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий)");  
    Если ЗначениеЗаполнено(ТекстСообщения) 
        И ЗначениеЗаполнено(Каталог) Тогда
		ИмяФайла  = СокрЛП(Каталог) + "ЛогОшибок" + Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd-HH-mm") + ".txt";
		ЛогОшибок = новый ТекстовыйДокумент;
		Попытка    
            ЛогОшибок.УстановитьТекст(ТекстСообщения);           
            ЛогОшибок.Записать(ИмяФайла, КодировкаТекста.ANSI);
        Исключение			
        КонецПопытки;		
    КонецЕсли;
    
КонецПроцедуры

&НаКлиенте
Процедура ОтобразитьЛогСобытий(МассивЛогаСобытий) Экспорт
	Выполнить("ЭКОМ_ОбщегоНазначения.ЗаписатьЛогСобытийвРегистрЛогирование(МассивЛогаСобытий);");
	СформироватьЛогСобытий();
	МассивЛогаСобытий.Очистить();
КонецПроцедуры

&НаСервере
Процедура СформироватьЛогСобытий(ПоНажатию = Ложь) Экспорт
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	ТабДок = ПолеЛогаСобытий;
	ТабДок.ОтображатьЗаголовки = Ложь;
	ТабДок.ОтображатьСетку = Ложь;

	//Получаем схему из макета
	СхемаКомпоновкиДанных = ОбработкаОбъект.ПолучитьМакет("ОтчетПоЛогамСобытий"); 
	
	//создадим компоновщик настроек и загрузим настройки по умолчанию, вместо настроек по умолчанию можно использовать восстановленные настройки
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных();
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных));
	КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	Настройки = КомпоновщикНастроек.Настройки;
	
	//установка параметров отчета, без КомпоновщикНастроекКомпоновкиДанных делать это гораздо сложнее
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("НачалоПериода", НачалоДня(ЭтаФорма.ПериодНачалоЛога));
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("КонецПериода" , КонецДня(ЭтаФорма.ПериодКонецЛога));
	Если ЗначениеЗаполнено(ЭтаФорма.ПолеВводаУровнаяЛога) Тогда
	     УровеньЛогирования = ЭтаФорма.ПолеВводаУровнаяЛога;
	Иначе	
	     УровеньЛогирования = Неопределено;
	КонецЕсли;
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("УровеньЛогирования" , УровеньЛогирования);
		
	//Помещаем в переменную данные о расшифровке данных - здесь ненужный пункт, но пусть будет.
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	
	//Формируем макет, с помощью компоновщика макета
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	//Передаем в макет компоновки схему, настройки и данные расшифровки
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки,,);
	
	//Выполним компоновку с помощью процессора компоновки
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки);
	
	////Очищаем поле табличного документа
	ТабДок.Очистить();
	//Выводим результат в табличный документ
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ТабДок);	
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	Если ПоНажатию = Ложь
		И ТабДок.ВысотаТаблицы > 1  Тогда
		Элементы.ПодвалСтраницы.ПодчиненныеЭлементы.ГруппаПолеЛогаСобытий.Заголовок = " События (есть непрочитанные)";
	КонецЕсли;

КонецПроцедуры

