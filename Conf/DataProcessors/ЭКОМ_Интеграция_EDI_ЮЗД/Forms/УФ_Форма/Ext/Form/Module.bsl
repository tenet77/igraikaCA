&НаКлиенте
Процедура ПослеОтветаНаВопрос(Результат, Данные) Экспорт
    
    Данные.МассивСтрок[Данные.ИндексМассива].СтрокаОбработана = Истина;
    
    Если Результат = "КнопкаНет" Тогда		
        Данные.МассивСтрок.Удалить(Данные.ИндексМассива);
    ИначеЕсли Результат = "КнопкаНетДляВсех" Тогда		
        Данные.МассивСтрок.Очистить();
    ИначеЕсли Результат = "КнопкаДаДляВсех" Тогда		
        Для Каждого ТекущаяСтрокаМассива Из Данные.МассивСтрок Цикл
            ТекущаяСтрокаМассива.СтрокаОбработана = Истина;
        КонецЦикла;	
    КонецЕсли;
    
    ПроверитьНаПовторноеСоздание(Данные.МассивСтрок, Данные.ИмяПроцедуры, Данные.МассивЛогаСобытий);
    
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНаПовторноеСоздание(МассивСтрок, ИмяПроцедуры, МассивЛогаСобытий) 
	
	ИмяСобытия = "Проверка на повторное создание";
    Кнопки = Новый СписокЗначений;	
    Кнопки.Добавить("КнопкаДа"        , "Да");
    Кнопки.Добавить("КнопкаДаДляВсех" , "Да, для всех");
    Кнопки.Добавить("КнопкаНет"       , "Нет");
    Кнопки.Добавить("КнопкаНетДляВсех", "Нет, для всех");
    
    Данные = Новый Структура;
    Данные.Вставить("МассивСтрок", МассивСтрок);
	
	ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();
	
    ОтправитьДокумент = Истина; 
    Для каждого ЭлМассива Из МассивСтрок Цикл	
        
        Если ЭлМассива.СтрокаОбработана = Ложь Тогда
            ОтправитьДокумент = Ложь; 
            
            ПредставлениеДок = СокрЛП(ЭлМассива.Строка[ЭлМассива.ИмяДокументаПриемника]);
            
            Данные.Вставить("ИндексМассива"    , МассивСтрок.Найти(ЭлМассива));
            Данные.Вставить("ИмяПроцедуры"     , ИмяПроцедуры);
            Данные.Вставить("МассивЛогаСобытий", МассивЛогаСобытий);
            
            Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопрос", ЭтаФорма, Данные); // Прописываем название процедуры-обработчика.		
            ПоказатьВопрос(Оповещение, "по " + ПредставлениеДок + " уже был создан документ. Создать повторно?", Кнопки, 0);
            Прервать;
        КонецЕсли;
        
    КонецЦикла;
    
    Если ОтправитьДокумент 
        И МассивСтрок.Количество() > 0 Тогда
        
        ТекстЛогаСобытий = "";
        
        ПараметрыПроцедуры = Новый Массив;
        ПараметрыПроцедуры.Добавить(МассивСтрок);
        ПараметрыПроцедуры.Добавить(ТекстЛогаСобытий);
        ВыполнитьПроцедуруИзМодуляОбъекта(ИмяПроцедуры, ПараметрыПроцедуры);
        
		ТекстЛогаСобытий = ПараметрыПроцедуры[1];	
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Информация"), ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
        
        ОбновитьДинамическийСписок(ДанныеСписка);      
        ОбновитьЦепочкуДокументовНаКлиенте(ДанныеСписка.ИмяСписка);
        ОтобразитьЛогСобытий(МассивЛогаСобытий);
        
    КонецЕсли;
    
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаНаВопросОтправка(Результат, Данные) Экспорт
	
	ИмяСобытия = "Повторная отправка";
    Данные.МассивСтрок[Данные.ИндексМассива].СтрокаОбработана = Истина;
    
    Если Результат = "КнопкаНет" Тогда		
        Данные.МассивСтрок.Удалить(Данные.ИндексМассива);
		ТекстЛогаСобытий = Данные.ПредставлениеДокумента + " - документ пропущен, так как был отправлен ранее!";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Предупреждение"), ИмяСобытия);
		Данные.МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

    ИначеЕсли Результат = "КнопкаНетДляВсех" Тогда		
        Данные.МассивСтрок.Очистить();
		ТекстЛогаСобытий = Данные.ТипДокумента + " - документы пропущены, так как были отправлены ранее!";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Предупреждение"), ИмяСобытия);
		Данные.МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		 
    ИначеЕсли Результат = "КнопкаДаДляВсех" Тогда		
        Для Каждого ТекущаяСтрокаМассива Из Данные.МассивСтрок Цикл
            ТекущаяСтрокаМассива.СтрокаОбработана = Истина;
        КонецЦикла;	
    КонецЕсли;
    
    ПроверитьНаПовторнуюОтправку(Данные.МассивСтрок, Данные.МассивЛогаСобытий, Данные.НужнаПодпись, Данные.ТипДокумента, Данные.ПозицияТекущейСтроки, Данные.ВыделенныеСтроки);
    
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНаПовторнуюОтправку(МассивСтрок, МассивЛогаСобытий, НужнаПодпись, ТипДокумента, ПозицияТекущейСтроки, ВыгружаемыеДанные) 
       
    Кнопки = Новый СписокЗначений;	
    Кнопки.Добавить("КнопкаДа"        , "Да");
    Кнопки.Добавить("КнопкаДаДляВсех" , "Да, для всех");
    Кнопки.Добавить("КнопкаНет"       , "Нет");
    Кнопки.Добавить("КнопкаНетДляВсех", "Нет, для всех");
    
    Данные = Новый Структура;
    Данные.Вставить("МассивСтрок", МассивСтрок);
	
	ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();
	
    ОтправитьДокумент = Истина; 
    Для каждого ЭлМассива Из МассивСтрок Цикл	
        
        Если ЭлМассива.СтрокаОбработана = Ложь Тогда
            ОтправитьДокумент = Ложь; 
              		                        
            Данные.Вставить("ИндексМассива"         , МассивСтрок.Найти(ЭлМассива));
            Данные.Вставить("МассивЛогаСобытий"     , МассивЛогаСобытий);
            Данные.Вставить("НужнаПодпись"          , НужнаПодпись);
            Данные.Вставить("ТипДокумента"          , ТипДокумента);
            Данные.Вставить("ПозицияТекущейСтроки"  , ПозицияТекущейСтроки);
			Данные.Вставить("ВыделенныеСтроки"      , ВыгружаемыеДанные);		
			Данные.Вставить("ПредставлениеДокумента", ЭлМассива.ПредставлениеДокумента);
            
            Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопросОтправка", ЭтаФорма, Данные); // Прописываем название процедуры-обработчика.		
            ПоказатьВопрос(Оповещение, ЭлМассива.ПредставлениеДокумента + " уже был отправлен ранее." 
            + Символы.ПС + "Отправить повторно?", Кнопки, 0);
            Прервать;
        КонецЕсли;
        
    КонецЦикла;
    
    Если ОтправитьДокумент 
        И МассивСтрок.Количество() > 0 Тогда
		
		ЭтаФорма.Индикатор = 1;
		Элементы.ПолеИндикатор.Видимость = Истина;
		Элементы.КомандаЗакрытьИндикатор.Видимость = Истина;
		
		ЭтоНовыеДокументы = Ложь;
        ОтправитьФайлыНаКлиенте(МассивСтрок, ТипДокумента, ДанныеСписка, 100, ПозицияТекущейСтроки, ВыгружаемыеДанные, Истина, МассивЛогаСобытий, НужнаПодпись, ЭтоНовыеДокументы);
                
    КонецЕсли;
	
	Если МассивСтрок.Количество() = 0 Тогда
	     ОтобразитьЛогСобытий(МассивЛогаСобытий);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновитьЦепочку(Команда)
	
	ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();
    ОбновитьЦепочкуДокументовНаКлиенте(ДанныеСписка.ИмяСписка);
    
КонецПроцедуры

&НаКлиенте
Функция ПоляДокументовТЧ(ИмяСписка) Экспорт
    Результат = Новый Массив;
      
    Если ИмяСписка = "СписокДляПоставщика" Тогда
        
		Результат.Добавить("ЭКОМ_Документ_RETORD");//Docrobot 1.21.0 MOD-1648
		Результат.Добавить("ЭКОМ_Документ_ORDER");
        Результат.Добавить("ДокументЗаказа");
        Результат.Добавить("ДокументРеализации");
        Результат.Добавить("ЭКОМ_Документ_RECADV");
        
        Результат.Добавить("ЭКОМ_Документ_RETANN");
        Результат.Добавить("ЭКОМ_Документ_RETINS");
		Результат.Добавить("ЭКОМ_Документ_INSDES");
        
        Результат.Добавить("ЭКОМ_Документ_DPOTORG1");
        Результат.Добавить("ЭКОМ_Документ_DPOTORG2");
        Результат.Добавить("ДокументСЧФ");
        Результат.Добавить("СчетФактураИсходная");
        Результат.Добавить("СчетФактураКорректировочная");
        Результат.Добавить("СчетФактураИсправительная");
        
        Результат.Добавить("КорректировкаРеализации");
        Результат.Добавить("ВозвратТоваровОтПокупателя");
        
    ИначеЕсли ИмяСписка = "СписокДляПокупателя" Тогда
        
        Результат.Добавить("ДокументЗаказа");
        Результат.Добавить("ЭКОМ_Документ_ORDRSP");
        Результат.Добавить("ЭКОМ_Документ_DESADV");
        
        Результат.Добавить("ЭКОМ_Документ_RETANN");
        Результат.Добавить("ЭКОМ_Документ_RETINS");
        
        Результат.Добавить("ДокументЭКОМ_ЮЗД");
        Результат.Добавить("ДокументПоступления");
        Результат.Добавить("ДокументСЧФ");
        Результат.Добавить("КорректировкаПоступления");
        Результат.Добавить("ВозвратТоваровПоставщику");
		Результат.Добавить("ПриходныйОрдерНаТовары");
		
	ИначеЕсли ИмяСписка = "СписокДляЭТРН" Тогда
        
        Результат.Добавить("Накладная");
        Результат.Добавить("ДокументЭКОМ");
		
	ИначеЕсли ИмяСписка = "СписокДляCondra" Тогда
		
		Результат.Добавить("ДокументОригинала");
		Результат.Добавить("ДокументПринятия");
		Результат.Добавить("ДокументОтзыва");
		Результат.Добавить("ДокументОтклонения");
		
    ИначеЕсли ИмяСписка = "СписокДляПрайсЛистаВходящий"
		ИЛИ ИмяСписка = "СписокДляПрайсЛистаИсходящий" Тогда		
		Результат.Добавить("PRICAT");
		Результат.Добавить("УстановкаЦенНоменклатуры");
		
    КонецЕсли;
    
    Возврат Результат;
КонецФункции 

&НаКлиенте
Функция ДокументыПоСтрокеВСтруктуруНаКлиенте(МассивСтрок, ПоляИсточникаДанных, ЭтоПовторнаяОтправка, ИспользоватьСтроку) Экспорт
		
	МассивСтрокДокументов = Новый Массив;
	Для каждого Эл Из МассивСтрок Цикл
		
		Если ИспользоватьСтроку = Истина Тогда
			СтрокаМассива = Эл.Строка; 
		Иначе
			СтрокаМассива = Эл;
		КонецЕсли;
		
		РезультатСтруктура = Новый Структура;
		Для каждого ИмяКолонки Из ПоляИсточникаДанных Цикл
			РезультатСтруктура.Вставить(ИмяКолонки, Неопределено);		
		КонецЦикла;
		ЗаполнитьЗначенияСвойств(РезультатСтруктура, СтрокаМассива);
		
		Если ИспользоватьСтроку = Истина Тогда
			СтруктураСтроки = Новый Структура;
			СтруктураСтроки.Вставить("Строка", РезультатСтруктура);
			СтруктураСтроки.Строка.Вставить("ОтправитьПовторно", ЭтоПовторнаяОтправка);
			МассивСтрокДокументов.Добавить(СтруктураСтроки);
		Иначе
			МассивСтрокДокументов.Добавить(РезультатСтруктура);
		КонецЕсли;
				
	КонецЦикла;	
	  
    Возврат МассивСтрокДокументов;
	
КонецФункции 

&НаКлиенте
Процедура ОбновитьЦепочкуДокументовНаКлиенте(ИмяСписка, КлючЗаписиЦепочкиДокументов = Неопределено)
	
	ТекущаяСтрокаЦепочки = Элементы.ТаблицаЦепочкаДокументов.ТекущиеДанные;
    ДокументЦепочки = Неопределено;
	Если НЕ ТекущаяСтрокаЦепочки = Неопределено Тогда
		ДокументЦепочки  = ТекущаяСтрокаЦепочки.Документ;
	КонецЕсли;
	//Docrobot 1.20.0 MOD-1575[Очистка цепочки перенесена выше, до возможного выхода из процедуры]
	ЭтаФорма.ТаблицаЦепочкаДокументов.Очистить();
	
	Если ИмяСписка = "СписокДляПоставщика" 
		ИЛИ ИмяСписка = "СписокДляПокупателя"
		ИЛИ ИмяСписка = "СписокДляCondra"
		ИЛИ ИмяСписка = "СписокДляПрайсЛистаВходящий"
		ИЛИ ИмяСписка = "СписокДляПрайсЛистаИсходящий" Тогда		
		
		Если Не КлючЗаписиЦепочкиДокументов = Неопределено И КлючЗаписиЦепочкиДокументов.УдалосьОпределить Тогда
			ТекущаяСтрокаСписка =  Элементы[ИмяСписка].ДанныеСтроки(КлючЗаписиЦепочкиДокументов.ИдентификаторВыделенныхСтрок);
			Элементы[ИмяСписка].ТекущаяСтрока = КлючЗаписиЦепочкиДокументов.ИдентификаторВыделенныхСтрок;
		ИначеЕсли Не КлючЗаписиЦепочкиДокументов = Неопределено И Не КлючЗаписиЦепочкиДокументов.УдалосьОпределить Тогда
			Возврат;
		Иначе
			ТекущаяСтрокаСписка = Элементы[ИмяСписка].ТекущиеДанные; 
		КонецЕсли;	
		
		Если ТекущаяСтрокаСписка = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		// По строке
		ПоляИсточникаДанных = ПоляДокументовТЧ(ИмяСписка);
		
		ВсеДокументыЦепочкиПоСтроке = Новый Структура;    	
		Для каждого ИмяКолонки Из ПоляИсточникаДанных Цикл
			ВсеДокументыЦепочкиПоСтроке.Вставить(ИмяКолонки, Неопределено);		
		КонецЦикла;
		ЗаполнитьЗначенияСвойств(ВсеДокументыЦепочкиПоСтроке, ТекущаяСтрокаСписка);
		
		// Видимость элементов
		Элементы.ТаблицаПалет.Видимость = Ложь;
		Элементы.ТаблицаЦепочкаДокументов.Видимость = Истина;
		Если ИмяСписка = "СписокДляCondra"
			ИЛИ ИмяСписка = "СписокДляПрайсЛистаВходящий"
			ИЛИ ИмяСписка = "СписокДляПрайсЛистаИсходящий" Тогда
			Элементы.ТаблицаКвитанций.Видимость = Ложь;
		Иначе	
			Элементы.ТаблицаКвитанций.Видимость = Истина;
		КонецЕсли;
	
		Если ВсеДокументыЦепочкиПоСтроке.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		//Docrobot 1.20.0 MOD-1575[Очистка цепочки перенесена выше, до возможного выхода из процедуры]
		ЭтаФорма.ТаблицаЦепочкаДокументов.Очистить();
		
		Н = 1;
		
		ВыведенныеДокументыЦепочки = Новый Массив;
		
		ТаблицаЦепочки = ЭтаФорма.ТаблицаЦепочкаДокументов;
		
		Для каждого ЭлементЦепочкиДокументов Из ВсеДокументыЦепочкиПоСтроке Цикл
			ТекущийДокумент = ЭлементЦепочкиДокументов.Значение;
			
			Если ЗначениеЗаполнено(ТекущийДокумент) Тогда
				
				Если ВыведенныеДокументыЦепочки.Найти(ТекущийДокумент) <> Неопределено Тогда
					Продолжить;
				Иначе
					ВыведенныеДокументыЦепочки.Добавить(ТекущийДокумент);
				КонецЕсли;
				
				// Убираем все счет-фактуры из цепочки
				Если ЭлементЦепочкиДокументов.Ключ = "СчетФактураИсходная" Тогда
					Продолжить;
				ИначеЕсли ЭлементЦепочкиДокументов.Ключ = "СчетФактураИсправительная" Тогда
					Продолжить;
				ИначеЕсли ЭлементЦепочкиДокументов.Ключ = "СчетФактураКорректировочная" Тогда
					Продолжить;
				КонецЕсли;
				
				ВидДокумента = "";
				Если ЭлементЦепочкиДокументов.Ключ = "ДокументСЧФ" Тогда
					ДокСчетФактураИсходная = Неопределено;
					ВсеДокументыЦепочкиПоСтроке.Свойство("СчетФактураИсходная", ДокСчетФактураИсходная);
					
					ДокСчетФактураИсправительная = Неопределено;
					ВсеДокументыЦепочкиПоСтроке.Свойство("СчетФактураИсправительная", ДокСчетФактураИсправительная);
					
					ДокСчетФактураКорректировочная = Неопределено;
					ВсеДокументыЦепочкиПоСтроке.Свойство("СчетФактураКорректировочная", ДокСчетФактураКорректировочная);
					
					Если ДокСчетФактураИсходная = ЭлементЦепочкиДокументов.Значение Тогда
						ВидДокумента = "Первичная";
						
					ИначеЕсли ДокСчетФактураИсправительная = ЭлементЦепочкиДокументов.Значение Тогда
						ВидДокумента = "Исправительная";
						
					ИначеЕсли ДокСчетФактураКорректировочная = ЭлементЦепочкиДокументов.Значение Тогда
						ВидДокумента = "Корректировочная";
						
					КонецЕсли;
				КонецЕсли;
			
				НСтр              = ТаблицаЦепочки.Добавить();
				НСтр.Документ     = ТекущийДокумент;
				НСтр.Статус       = ИндексПиктограммыДокумента(ТекущийДокумент);
				НСтр.НомерСтроки  = Н;
				
				// Подробное описание вида документа
				Если ТипЗнч(НСтр.Документ) = Тип("ДокументСсылка.ЭКОМ_Документы") Тогда					             
					ВидДокумента = ПредставлениеВидаЭКОМ_Документа(НСтр.Документ);
					
				КонецЕсли;
				
				НСтр.ВидДокумента = ВидДокумента;
				
				Н = Н + 1;
			КонецЕсли;
		КонецЦикла;
				
	ИначеЕсли ИмяСписка = "СписокДляЭТРН" Тогда	
		
		ЗначениеПоУмолчанию = Ложь;
		Измерение           = Неопределено; 
		Обязательно         = Ложь;
		ЭКОМ_ТипОбменаЭТРН_Отправитель = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_ТипОбменаЭТРН_Отправитель"", ЗначениеПоУмолчанию, Измерение, Обязательно)");
		ЭКОМ_ТипОбменаЭТРН_Перевозчик = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_ТипОбменаЭТРН_Перевозчик"", ЗначениеПоУмолчанию, Измерение, Обязательно)");
        ЭКОМ_ТипОбменаЭТРН_Получатель = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_ТипОбменаЭТРН_Получатель"", ЗначениеПоУмолчанию, Измерение, Обязательно)");
			
		// Видимость элементов
		Элементы.ТаблицаКвитанций.Видимость = Истина;
        Элементы.ТаблицаЦепочкаДокументов.Видимость = Ложь;
		Если ЭКОМ_ТипОбменаЭТРН_Отправитель Тогда	
			Элементы.ТаблицаПалет.Видимость = Истина;	
		КонецЕсли;
		Если ЭКОМ_ТипОбменаЭТРН_Перевозчик Тогда	
			Элементы.ТаблицаПалет.Видимость = Ложь;	
		КонецЕсли;
		Если ЭКОМ_ТипОбменаЭТРН_Получатель Тогда	
			Элементы.ТаблицаПалет.Видимость = Ложь;	
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ДокументЦепочки = Неопределено Тогда
		 ИдентификаторСтроки  = 0;
		 ПараметрыОтбора = Новый Структура;
		 ПараметрыОтбора.Вставить("Документ", ДокументЦепочки);
	     МассивТекущаяСтрокаЦепочки = ЭтаФорма.ТаблицаЦепочкаДокументов.НайтиСтроки(ПараметрыОтбора);
		 Если МассивТекущаяСтрокаЦепочки.Количество() > 0 Тогда
			 НоваяТекущаяСтрокаЦепочки = МассивТекущаяСтрокаЦепочки[0];
			 ИдентификаторСтроки = НоваяТекущаяСтрокаЦепочки.ПолучитьИдентификатор();
		 КонецЕсли;
		  
	     Элементы.ТаблицаЦепочкаДокументов.ТекущаяСтрока = ИдентификаторСтроки;
	КонецЕсли;
  
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИндексПиктограммыДокумента(ДокументДляПиктограммы)
	
	Результат = 0;
	Если ТипЗнч(ДокументДляПиктограммы) = Тип("ДокументСсылка.ЭКОМ_Документы") Тогда
		Если ДокументДляПиктограммы.СтатусОбработкиДокумента = Перечисления.ЭКОМ_Статусы.Обработан Тогда
			Результат = 1;
		КонецЕсли;	
	Иначе
		Если ДокументДляПиктограммы.Проведен Тогда
			Результат = 1;
		КонецЕсли;	
	КонецЕсли;

	Если ДокументДляПиктограммы.ПометкаУдаления Тогда
		Результат = 2;
	КонецЕсли;	
	
    Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьКвитанцииНаКлиенте(ИмяСписка)
	
	ЭтаФорма.ТаблицаКвитанций.Очистить();

    ВыбраннаяСтрока = Новый Структура;
    
    Если ИмяСписка = "СписокДляПоставщика" Тогда		
        ТекущаяСтрока = Элементы.СписокДляПоставщика.ТекущиеДанные;
        Если ТекущаяСтрока = Неопределено Тогда      
            Возврат;
        КонецЕсли;
        
        Если ТекущаяСтрока.Свойство("ЭКОМ_Документ_ORDER") Тогда
            ВыбраннаяСтрока.Вставить("ЭКОМ_Документ_ORDER", ТекущаяСтрока.ЭКОМ_Документ_ORDER);
        КонецЕсли;
        
        
        Если ТекущаяСтрока.Свойство("ДокументРеализации") Тогда
            ВыбраннаяСтрока.Вставить("ДокументРеализации", ТекущаяСтрока.ДокументРеализации);
        КонецЕсли;
        
        Если ТекущаяСтрока.Свойство("ЭКОМ_Документ_RECADV") Тогда
            ВыбраннаяСтрока.Вставить("ЭКОМ_Документ_RECADV", ТекущаяСтрока.ЭКОМ_Документ_RECADV);
        КонецЕсли;
        
        Если ТекущаяСтрока.Свойство("ДокументСЧФ") Тогда
            ВыбраннаяСтрока.Вставить("ДокументСЧФ", ТекущаяСтрока.ДокументСЧФ);
        КонецЕсли;
        
        Если ТекущаяСтрока.Свойство("КорректировкаРеализации") Тогда
            ВыбраннаяСтрока.Вставить("КорректировкаРеализации", ТекущаяСтрока.КорректировкаРеализации);
        КонецЕсли;
        
        Если ТекущаяСтрока.Свойство("ВозвратТоваровОтПокупателя") Тогда
            ВыбраннаяСтрока.Вставить("ВозвратТоваровОтПокупателя", ТекущаяСтрока.ВозвратТоваровОтПокупателя);
        КонецЕсли;
    ИначеЕсли ИмяСписка = "СписокДляПокупателя" Тогда
        ТекущаяСтрока = Элементы.СписокДляПокупателя.ТекущиеДанные;
        Если ТекущаяСтрока = Неопределено Тогда
            Возврат;
        КонецЕсли;
        
        Если ТекущаяСтрока.Свойство("ДокументЗаказа") Тогда
            ВыбраннаяСтрока.Вставить("ДокументЗаказа"          , ТекущаяСтрока.ДокументЗаказа);
        КонецЕсли;
        
        Если ТекущаяСтрока.Свойство("ЭКОМ_Документ_ORDRSP") Тогда
            ВыбраннаяСтрока.Вставить("ЭКОМ_Документ_ORDRSP"    , ТекущаяСтрока.ЭКОМ_Документ_ORDRSP);
        КонецЕсли;
        
        Если ТекущаяСтрока.Свойство("ЭКОМ_Документ_DESADV") Тогда
            ВыбраннаяСтрока.Вставить("ЭКОМ_Документ_DESADV"    , ТекущаяСтрока.ЭКОМ_Документ_DESADV);
        КонецЕсли;
        
        Если ТекущаяСтрока.Свойство("ДокументЭКОМ_ЮЗД") Тогда
            ВыбраннаяСтрока.Вставить("ДокументЭКОМ_ЮЗД"        , ТекущаяСтрока.ДокументЭКОМ_ЮЗД);
        КонецЕсли;
        
        Если ТекущаяСтрока.Свойство("ДокументПоступления") Тогда
            ВыбраннаяСтрока.Вставить("ДокументПоступления"     , ТекущаяСтрока.ДокументПоступления);
        КонецЕсли;
        
        Если ТекущаяСтрока.Свойство("ДокументСЧФ") Тогда
            ВыбраннаяСтрока.Вставить("ДокументСЧФ"             , ТекущаяСтрока.ДокументСЧФ);
        КонецЕсли;
        
        Если ТекущаяСтрока.Свойство("КорректировкаПоступления") Тогда
            ВыбраннаяСтрока.Вставить("КорректировкаПоступления", ТекущаяСтрока.КорректировкаПоступления);
        КонецЕсли;
        
        Если ТекущаяСтрока.Свойство("ВозвратТоваровПоставщику") Тогда
            ВыбраннаяСтрока.Вставить("ВозвратТоваровПоставщику", ТекущаяСтрока.ВозвратТоваровПоставщику);
        КонецЕсли;
		
	ИначеЕсли ИмяСписка = "СписокДляЭТРН" Тогда	
		ТекущаяСтрока = Элементы.СписокДляЭТРН.ТекущиеДанные;
		Если ТекущаяСтрока = Неопределено Тогда		
			Возврат;
		КонецЕсли;
		
		Если ТекущаяСтрока.Свойство("Накладная") Тогда
			ВыбраннаяСтрока.Вставить("Накладная", ТекущаяСтрока.Накладная);
		КонецЕсли;
		
		Если ТекущаяСтрока.Свойство("ДокументЭКОМ") Тогда
			ВыбраннаяСтрока.Вставить("ДокументЭКОМ"          , ТекущаяСтрока.ДокументЭКОМ);
		КонецЕсли;

    КонецЕсли;
    
    Если ВыбраннаяСтрока.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;
	
	ПараметрыСтруктуры = "Тип, ИспользоватьДерево";
	ИспользуемDP_REZRUISP = Новый Соответствие;
	ИспользуемDP_REZRUISP.Вставить("Исходящий DP_REZRUISP (Акт выполненных работ)" , Новый Структура(ПараметрыСтруктуры, "DP_REZRUISP"   , Ложь));
	ПроверитьНаличиеВеткиДерева(ИспользуемDP_REZRUISP);
	
	ИспользуемDP_REZRUISP = ИспользуемDP_REZRUISP.Получить("Исходящий DP_REZRUISP (Акт выполненных работ)").ИспользоватьДерево = Истина;
	
    ДанныеДляТаблицыКвитанций = ПолучитьДанныеТаблицыКвитанцийНаСервере(ИмяСписка, ВыбраннаяСтрока, ИспользуемDP_REZRUISP);
    Для Каждого СтрокаДанных Из ДанныеДляТаблицыКвитанций Цикл
        НоваяСтрокаКвитанций = ТаблицаКвитанций.Добавить();
        ЗаполнитьЗначенияСвойств(НоваяСтрокаКвитанций, СтрокаДанных);
    КонецЦикла;
    
    ЭтаФорма.ТаблицаКвитанций.Сортировать("ДатаЗаписи, Порядок");
    
    Н = 1;
    Для каждого Стр  Из ЭтаФорма.ТаблицаКвитанций Цикл
        Стр.НомерСтроки = Н;
        Н = Н + 1;
    КонецЦикла;
    
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеТаблицыКвитанцийНаСервере(ИмяСписка, Знач ВыбраннаяСтрока, ИспользуемDP_REZRUISP)
	
	Результат = Новый Массив;  
    Если ВыбраннаяСтрока = Неопределено Тогда
        Возврат Результат;
    КонецЕсли;
	
	Алфавит = Новый Соответствие;
	Алфавит.Вставить(0, "А");
	Алфавит.Вставить(1, "Б");
	Алфавит.Вставить(2, "В");
	Алфавит.Вставить(3, "Г");
	Алфавит.Вставить(4, "Д");
	Алфавит.Вставить(5, "Е");
	Алфавит.Вставить(6, "Ё");
	Алфавит.Вставить(7, "Ж");
	Алфавит.Вставить(8, "З");
	Алфавит.Вставить(9, "И");
	Алфавит.Вставить(10, "Й");
	Алфавит.Вставить(11, "К");
	Алфавит.Вставить(12, "Л");
	Алфавит.Вставить(13, "М");
	Алфавит.Вставить(14, "Н");
	Алфавит.Вставить(15, "О");
	Алфавит.Вставить(16, "П");
	Алфавит.Вставить(17, "Р");
	Алфавит.Вставить(18, "С");
	Алфавит.Вставить(19, "Т");
	Алфавит.Вставить(20, "У");
	Алфавит.Вставить(21, "Ф");
	Алфавит.Вставить(22, "Х");
	Алфавит.Вставить(23, "Ц");
	Алфавит.Вставить(24, "Ч");
	Алфавит.Вставить(25, "Ш");
	Алфавит.Вставить(26, "Щ");
	Алфавит.Вставить(27, "Ъ");
	Алфавит.Вставить(28, "Ы");
	Алфавит.Вставить(29, "Ь");
	Алфавит.Вставить(30, "Э");
	Алфавит.Вставить(31, "Ю");
	Алфавит.Вставить(32, "Я");

	ПервичныеДокументыЮЗД = Новый Массив;
	Для Каждого Элемент Из Алфавит Цикл
		Если Элемент.Ключ < 14 Тогда
			ПервичныеДокументыЮЗД.Добавить(Элемент.Значение);
		КонецЕсли;
	КонецЦикла;
	
	МассивВидовДокументовЮЗД = Новый Массив;

    СписокЗначенийДокументов = ПолучитьСписокДокументов(ВыбраннаяСтрока, ИмяСписка, Ложь);   
    СписокВидДокумента = Новый СписокЗначений;   
	Если ИмяСписка = "СписокДляПоставщика" 
		И НЕ ИспользуемDP_REZRUISP Тогда
		
		Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьПервичныеВидыДокументовЮЗД(МассивВидовДокументовЮЗД);");
		Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьИсправительныеВидыДокументовЮЗД(МассивВидовДокументовЮЗД);");
		Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьКорректировочныеВидыДокументовЮЗД(МассивВидовДокументовЮЗД);");
		
		МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DP_PDPOL_02);
		МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DP_PDOTPR_03);
		МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DP_IZVPOL_04);
		МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DP_IZVPOL_06);
		МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DP_PDOTPR_08);
		МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DP_UVUTOCH_09);		
		МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DP_IZVPOL_10);
		МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DP_PDOTPR_13);
			
		Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьПодписьВидовДокументовЮЗД(МассивВидовДокументовЮЗД);");
		
		МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DP_PRANNUL_22);
		МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DP_IZVPOL_23);
		МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DP_UVUTOCH_24);
		
	ИначеЕсли ИмяСписка = "СписокДляПоставщика"
		И ИспользуемDP_REZRUISP Тогда
		
		МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DP_REZRUISP_Исходящий);
        МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DP_REZRUZAK_Входящий); 

    ИначеЕсли ИмяСписка = "СписокДляПокупателя" Тогда
		
		Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьПервичныеВидыДокументовЮЗД(МассивВидовДокументовЮЗД);");
		Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьИсправительныеВидыДокументовЮЗД(МассивВидовДокументовЮЗД);");
		Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьКорректировочныеВидыДокументовЮЗД(МассивВидовДокументовЮЗД);");
		
		МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DP_PDOTPR_03);
		
		МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DP_IZVPOL_05); // Старый формат обмена

		МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DP_IZVPOL_06);
		
		МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DP_PDOTPR_07); // Старый формат обмена
		
		МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DP_PDPOL_07);
		МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DP_PDOTPR_08);
		
		МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DP_IZVPOL_08); // Старый формат обмена
		
		МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DP_UVUTOCH_09);
		
		МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DP_IZVPOL_10); // Старый формат обмена
		
		МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DP_PDPOL_12);
		МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DP_PDOTPR_13);
		
		Выполнить("ЭКОМ_ОбщегоНазначения.ПолучитьПодписьВидовДокументовЮЗД(МассивВидовДокументовЮЗД);");
		
		МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DP_PRANNUL_22);
		МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DP_IZVPOL_23);
		МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DP_UVUTOCH_24);
		
	ИначеЕсли ИмяСписка = "СписокДляЭТРН" Тогда
			
		ЗначениеПоУмолчанию = Ложь;
		Измерение           = Неопределено; 
		Обязательно         = Ложь;
		ЭКОМ_ТипОбменаЭТРН_Отправитель = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_ТипОбменаЭТРН_Отправитель"", ЗначениеПоУмолчанию, Измерение, Обязательно)");
		ЭКОМ_ТипОбменаЭТРН_Получатель  = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_ТипОбменаЭТРН_Получатель"", ЗначениеПоУмолчанию, Измерение, Обязательно)");
		
		Если ЭКОМ_ТипОбменаЭТРН_Отправитель = Истина Тогда
			
			МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.WHGOV_01_Исходящий);
			МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DRVGOV_02_Входящий);
			МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DRVGOU_03_Входящий);
			МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.WHGOU_04_Исходящий);
			МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DRVGPV_06_Входящий);
			МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DRVGPU_07_Входящий);
			МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.WHGPU_08_Входящий);
			
		КонецЕсли;
		
		Если ЭКОМ_ТипОбменаЭТРН_Получатель = Истина Тогда
			
			МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DRVGOV_02_Входящий);
			МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DRVGOU_03_Входящий);
			МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.WHGOU_04_Входящий);
			МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.WHGPV_05_Исходящий);
			МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DRVGPV_06_Входящий);
			МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.DRVGPU_07_Входящий);
			МассивВидовДокументовЮЗД.Добавить(Перечисления.ЭКОМ_ВидыДокументов.WHGPU_08_Исходящий);
				
		КонецЕсли;

	Иначе
        Возврат Результат;
    КонецЕсли;	
	
	Индекс = 0;
	Для каждого Строка Из МассивВидовДокументовЮЗД Цикл
		СписокВидДокумента.Добавить(Строка, Алфавит.Получить(Индекс));
		Индекс = Индекс + 1;	
	КонецЦикла;

	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЭКОМ_Объекты_События.Документ_Основание КАК Документ,
	               |	ЭКОМ_Объекты_События.ВидДокумента КАК ВидДокумента,
	               |	ЭКОМ_Объекты_События.Идентификатор КАК Идентификатор,
	               |	ЭКОМ_Объекты_События.ИдентификаторИспр КАК Основание,
	               |	ЭКОМ_Объекты_События.ДатаЗаписи КАК ДатаЗаписи,
	               |	ЭКОМ_Объекты_События.НаправлениеОбмена КАК НаправлениеОбмена
	               |ИЗ
	               |	РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_События
	               |ГДЕ
	               |	ЭКОМ_Объекты_События.Документ_Основание В(&Документ_Основание)
	               |	И ЭКОМ_Объекты_События.ВидДокумента В(&ВидДокумента)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаЗаписи";
	
    Запрос.Текст = ТекстЗапроса;
    Запрос.УстановитьПараметр("Документ_Основание", СписокЗначенийДокументов);
    Запрос.УстановитьПараметр("ВидДокумента"      , СписокВидДокумента);
    
    РезультатЗапроса = Запрос.Выполнить();
	Выгрузка = РезультатЗапроса.Выгрузить();
	
	РезультатТЗ = Выгрузка.СкопироватьКолонки("Документ, Идентификатор, Основание, ДатаЗаписи, НаправлениеОбмена"); //Docrobot 1.21.0 MOD-1277 [Добавлено НаправлениеОбмена]
	РезультатТЗ.Колонки.Добавить("ВидДокумента");
	РезультатТЗ.Колонки.Добавить("Порядок");
	РезультатТЗ.Колонки.Добавить("Статус");
	
	// Добавляем исходные документы.
	ГруппыКвитанций = Новый Массив;
	
	Для Каждого Строка Из Выгрузка Цикл
		ЭлементВидДокумента = СписокВидДокумента.НайтиПоЗначению(Строка.ВидДокумента);
		Если НЕ ЭлементВидДокумента = Неопределено
			И НЕ ПервичныеДокументыЮЗД.Найти(ЭлементВидДокумента.Представление) = Неопределено Тогда
			
			НоваяГруппа		= РезультатТЗ.СкопироватьКолонки();
			НоваяГруппа.Колонки.Добавить("НомерСтроки");
			НСтр			= НоваяГруппа.Добавить();
			ЗаполнитьЗначенияСвойств(НСтр, Строка);
			НСтр.Порядок	= СписокВидДокумента.НайтиПоЗначению(Строка.ВидДокумента);
            НСтр.Статус		= ИндексПиктограммыДокумента(Строка.Документ);
			ГруппыКвитанций.Добавить(НоваяГруппа);
		КонецЕсли;
	КонецЦикла;
	
	ДобавитьВКонце = Новый Массив; // коллекция строк, основания которых не совпадают с идентификатором исходной УПД (актуально для квитанций в формате до 01.07.2021)
	
	// Добавляем квитанции под исходными документами.
	СтрокаРодителя 	= Неопределено;
	Для Каждого Строка Из Выгрузка Цикл 
		ЭлементВидДокумента = СписокВидДокумента.НайтиПоЗначению(Строка.ВидДокумента);
		Если НЕ ЭлементВидДокумента = Неопределено
			И ПервичныеДокументыЮЗД.Найти(ЭлементВидДокумента.Представление) = Неопределено Тогда
			
			ГруппаКвитанций = Неопределено;
			Для Каждого ГруппаКвитанций Из ГруппыКвитанций Цикл
				Если НЕ ГруппаКвитанций.Найти(Строка.Основание, "Идентификатор") = Неопределено Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если ГруппаКвитанций = Неопределено Тогда
				ДобавитьВКонце.Добавить(Строка);
				Продолжить;
			КонецЕсли;
			
			НовыйРодитель 	= НЕ СтрокаРодителя = ГруппаКвитанций.Найти(Строка.Основание, "Идентификатор");
			
			СтрокаРодителя 	= ГруппаКвитанций.Найти(Строка.Основание, "Идентификатор");
			Если СтрокаРодителя = Неопределено Тогда
				ДобавитьВКонце.Добавить(Строка);
				Продолжить;
			КонецЕсли;
			
			Если НовыйРодитель Тогда
				Индекс 		= ГруппаКвитанций.Индекс(СтрокаРодителя) + 1;
			Иначе
				Индекс = Индекс + 1;
			КонецЕсли;
			
			НСтр			= ГруппаКвитанций.Вставить(Индекс);
			ЗаполнитьЗначенияСвойств(НСтр, Строка);
			НСтр.Порядок	= СписокВидДокумента.НайтиПоЗначению(Строка.ВидДокумента);
			НСтр.Статус		= ИндексПиктограммыДокумента(Строка.Документ);
			
		КонецЕсли;
	КонецЦикла;
	
	// Добавляем строки, основания которых не совпадают с идентификатором исходной УПД (актуально для квитанций в формате до 01.07.2021)
	Для Каждого Строка Из ДобавитьВКонце Цикл
		
		ГруппаКвитанций = Неопределено;
		Для Каждого ГруппаКвитанций Из ГруппыКвитанций Цикл
			Если НЕ ГруппаКвитанций.Найти(Строка.Основание, "Идентификатор") = Неопределено Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ГруппаКвитанций = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаРодителя = ГруппаКвитанций.Найти(Строка.Основание, "Идентификатор");
		Если СтрокаРодителя = Неопределено Тогда
			НСтр            = ГруппаКвитанций.Добавить();
		Иначе
			Индекс 			= ГруппаКвитанций.Индекс(СтрокаРодителя) + 1;
			НСтр            = ГруппаКвитанций.Вставить(Индекс);
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(НСтр, Строка);
		НСтр.Порядок     = СписокВидДокумента.НайтиПоЗначению(Строка.ВидДокумента);
        НСтр.Статус      = ИндексПиктограммыДокумента(Строка.Документ);
	КонецЦикла;
	
	
	// Сортировка квитанций, их нумеранция и вывод на форму.
	Н = 1;
	Для Каждого ГруппаКвитанций Из ГруппыКвитанций Цикл
		
		ГруппаКвитанций.Сортировать("ДатаЗаписи, Порядок");
		Для Каждого ЗаписьКвитанции Из ГруппаКвитанций Цикл
			ЗаписьКвитанции.НомерСтроки = Н;
			Н = Н + 1;
			
			ДанныеСтроки = Новый Структура("Документ, ВидДокумента, Идентификатор, Основание, ДатаЗаписи, Порядок, Статус, НомерСтроки, НаправлениеОбмена"); //Docrobot 1.21.0 MOD-1277 [Добавлено НаправлениеОбмена]

			ЗаполнитьЗначенияСвойств(ДанныеСтроки, ЗаписьКвитанции, , "Порядок");
			ДанныеСтроки.Порядок = ЗаписьКвитанции.Порядок.Представление;
			Результат.Добавить(ДанныеСтроки);
			
		КонецЦикла;
		
	КонецЦикла;
	
    Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьЦепочкуДокументовИКвитанцииНаКлиенте(ИмяСписка)
	ОбновитьЦепочкуДокументовНаКлиенте(ИмяСписка);
    ОбновитьКвитанцииНаКлиенте(ИмяСписка);	
КонецПроцедуры

&НаСервере
Процедура ОбработкаОповещенияНаСервере(ИмяСобытия, Параметр)

    Если ИмяСобытия = "НастройкиОбновить" Тогда
        ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
        
        // Покупатель
		ЗначениеПоУмолчанию = Ложь;
		Измерение           = Неопределено; 
		Обязательно         = Ложь;	
		ЭКОМ_ОбменСеть = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_ОбменСеть"", ЗначениеПоУмолчанию, Измерение, Обязательно)");
        Элементы.Группа_Покупатель.Видимость = ЭКОМ_ОбменСеть;				
        
        // Поставщик
		ЗначениеПоУмолчанию = Ложь;
		Измерение           = Неопределено; 
		Обязательно         = Ложь;	
		ЭКОМ_ОбменПоставщик = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_ОбменПоставщик"", ЗначениеПоУмолчанию, Измерение, Обязательно)");
        Элементы.Группа_Поставщик.Видимость = ЭКОМ_ОбменПоставщик;		
		
		// ЭТРН
		ЗначениеПоУмолчанию = Ложь;
		Измерение           = Неопределено; 
		Обязательно         = Ложь;	
		ЭКОМ_ОбменЭТРН = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_ОбменЭТРН"", ЗначениеПоУмолчанию, Измерение, Обязательно)");
		Элементы.Группа_ЭТРН.Видимость = ЭКОМ_ОбменЭТРН;		
        
		// Condra
		ЗначениеПоУмолчанию = Ложь;
		Измерение           = Неопределено; 
		Обязательно         = Ложь;	
		ЭКОМ_ОбменCondra = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_ОбменCondra"", ЗначениеПоУмолчанию, Измерение, Обязательно)");
		Элементы.Группа_ЭТРН.Видимость = ЭКОМ_ОбменCondra;		
		
    КонецЕсли;
    
КонецПроцедуры

&НаСервере
Функция ПолучитьДоступностьApiПоСтранеНаСервере()
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ДоступностьAPI = ОбработкаОбъект.ПолучитьДоступностьApiПоСтране();
	Возврат ДоступностьAPI;
КонецФункции

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник) Экспорт
	
	МассивЛогаСобытий = Новый Массив;
	
	Если ИмяСобытия = "ОбновленПрофильОбмена" Тогда 
		ДоступностьAPI = ПолучитьДоступностьApiПоСтранеНаСервере(); 
		Попытка
			Элементы.КомандаДанныеКонтрагентаПоAPI.Видимость = ДоступностьAPI;	
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	ФормаДляОповещения = Неопределено;
	Если ТипЗнч(Параметр) = Тип("Структура") Тогда
		Параметр.Свойство("ФормаДляОповещения", ФормаДляОповещения);
	КонецЕсли;
	
	Если ФормаДляОповещения = "Обработка.УФ_Форма" Тогда		
		Попытка
			Если ИмяСобытия = "НастройкиОбновить"
				И НЕ Параметр.ЗавершениеРаботы Тогда
				
				ОбработкаОповещенияНаСервере(ИмяСобытия, Параметр);
				Если ИмяСобытия = "НастройкиОбновить" Тогда	
					СоздатьДинамическийСписокДобавитьДинамическиеКнопки(Параметр.МассивЛогаСобытий);
				КонецЕсли;
				
				СостояниеСохранение("Настройки основной формы обновлены.", "Обновление настроек после записи", 100); 
			ИначеЕсли ИмяСобытия = "ЭКОМ_ПроверитьФормулуНаФорме" Тогда
				
				МассивЛогаСобытий = Параметр.МассивЛогаСобытий;
				Результат = ПроверитьФормулуНаФорме(Параметр.Текст, Параметр.ИмяЭлементаФормы, МассивЛогаСобытий);
				
				Параметр.Вставить("Результат", Результат);
				Параметр.Вставить("ФормаДляОповещения", "Обработка.УФ_ФормаКонсольЗапросов");
				Оповестить("ЭКОМ_КонецПроверкиФормулыНаФорме", Параметр);
				
				Элементы.Группа_Поставщик.Видимость = Параметр.ЭКОМ_ОбменПоставщик;
				Элементы.Группа_Покупатель.Видимость = Параметр.ЭКОМ_ОбменСеть; 
				Элементы.Группа_ЭТРН.Видимость            = Параметр.ЭКОМ_ОбменЭТРН;
				Элементы.Группа_Condra.Видимость          = Параметр.ЭКОМ_ОбменCondra;
				
				ДанныеСпискаКлюч = "Используется, ТекущаяСтраницаИмя";

				АктивныеОбмены = Новый Соответствие;
				АктивныеОбмены.Вставить("СписокДляПоставщика", Новый Структура(ДанныеСпискаКлюч, Элементы.Группа_Поставщик.Видимость , "Группа_Поставщик"));
				АктивныеОбмены.Вставить("СписокДляПокупателя", Новый Структура(ДанныеСпискаКлюч, Элементы.Группа_Покупатель.Видимость, "Группа_Покупатель"));
				АктивныеОбмены.Вставить("СписокДляЭТРН"      , Новый Структура(ДанныеСпискаКлюч, Элементы.Группа_ЭТРН.Видимость      , "Группа_ЭТРН")); 
				АктивныеОбмены.Вставить("СписокДляCondra"    , Новый Структура(ДанныеСпискаКлюч, Элементы.Группа_Condra.Видимость    , "Группа_Condra"));	
				АктивныеОбмены.Вставить("СписокДляПрайсЛиста", Новый Структура(ДанныеСпискаКлюч, Элементы.ГруппаПрайсЛист.Видимость  , "ГруппаПрайсЛист"));
				
				Для каждого Стр Из АктивныеОбмены Цикл
					
					Если Стр.Значение.Используется = Истина Тогда
						
						ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте(Стр.Значение.ТекущаяСтраницаИмя);
												
						СоздатьСоставПользовательскихНастроекНаСервере(ДанныеСписка);
						СоздатьДеревоПользовательскихНастроекНаСервере(ДанныеСписка, Новый Массив); 
												
					КонецЕсли;						
					
				КонецЦикла;
				
				УстановитьПериоды(АктивныеОбмены);	
											
			ИначеЕсли ИмяСобытия = "ОбновитьКолонкиДинамическогоСписка" Тогда
				СоздатьДинамическийСписокДобавитьДинамическиеКнопки(Параметр.МассивЛогаСобытий);	
			ИначеЕсли ИмяСобытия = "ОбновитьСписокЭТРН" Тогда
				
				ОбновитьАктивныйСписок();
				
			КонецЕсли;
			
		Исключение
			ТекстЛогаСобытий = ОписаниеОшибки();
			Если ИмяСобытия = "ЭКОМ_ПроверитьФормулуНаФорме" Тогда
				МассивЛогаСобытий = Параметр.МассивЛогаСобытий;
			КонецЕсли;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Ошибка"), ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		КонецПопытки;
		
	ИначеЕсли ФормаДляОповещения = "Документы.ЭКОМ_Документы" Тогда
		Если ИмяСобытия = "ОбновитьТабличнуюЧасть" Тогда
			Если ЗначениеЗаполнено(Параметр.СобытиеПоДокументу) Тогда
				Если ЗначениеЗаполнено(Параметр.СобытиеПоДокументу) Тогда
					ТекстЛогаСобытий = Параметр.СобытиеПоДокументу;
					ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Информация"), "Обновление табличной части");
					МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
					
					ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();
					ОбновитьЦепочкуДокументовИКвитанцииНаКлиенте(ДанныеСписка.ИмяСписка);
					ОбновитьДинамическийСписок(ДанныеСписка);
				КонецЕсли;
			КонецЕсли;							
		КонецЕсли;	
	КонецЕсли;
	
	Если МассивЛогаСобытий.Количество() > 0  Тогда
		ОтобразитьЛогСобытий(МассивЛогаСобытий);
	Иначе 
		Если ИмяСобытия = "ЭКОМ_ПроверитьФормулуНаФорме" Тогда
			Если ЗначениеЗаполнено(Параметр.Текст) Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Проверка кода прошла успешно - ошибок нет.";
				Сообщение.Сообщить();
			Иначе
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Пустой текст, проверять нечего";
				Сообщение.Сообщить();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
    
    Если ЗавершениеРаботы = Истина Тогда
        ТекстПредупреждения = "Docrobot: для корректного сохранения настроек сначала необходимо закрыть обработку!";
        Отказ = Истина;
		Возврат;
    КонецЕсли;
	
	ИзменитьПриОткрытии = Элементы.ГруппаПодвал.Скрыта();   	
	Если ЭтаФорма.ЭКОМОбъектыАктуальны = Истина Тогда
		МассивЛогаСобытий = Новый Массив;
		НастройкаЗаписана = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкаПараметрЗаписать(""СлужебныйПанельЦепочкиСвернута"", ИзменитьПриОткрытии, ""Служебный"", МассивЛогаСобытий)");
		Если НастройкаЗаписана = Ложь Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий)");
			Сообщение.Сообщить();
		КонецЕсли;		
	КонецЕсли;
	
	// Сохранение пользовательских отборов.
	ДанныеСпискаКлюч = "Используется, ТекущаяСтраницаИмя";
	
	АктивныеОбмены = Новый Соответствие;
	АктивныеОбмены.Вставить("СписокДляПоставщика", Новый Структура(ДанныеСпискаКлюч, Элементы.Группа_Поставщик.Видимость , "Группа_Поставщик"));
	АктивныеОбмены.Вставить("СписокДляПокупателя", Новый Структура(ДанныеСпискаКлюч, Элементы.Группа_Покупатель.Видимость, "Группа_Покупатель"));
	АктивныеОбмены.Вставить("СписокДляЭТРН"      , Новый Структура(ДанныеСпискаКлюч, Элементы.Группа_ЭТРН.Видимость      , "Группа_ЭТРН")); 
	АктивныеОбмены.Вставить("СписокДляCondra"    , Новый Структура(ДанныеСпискаКлюч, Элементы.Группа_Condra.Видимость    , "Группа_Condra"));	
	АктивныеОбмены.Вставить("СписокДляПрайсЛиста", Новый Структура(ДанныеСпискаКлюч, Элементы.ГруппаПрайсЛист.Видимость  , "ГруппаПрайсЛист"));
	
	Настройки = Новый Структура;
	
	Для каждого Стр Из АктивныеОбмены Цикл
		
		Используется        = Стр.Значение.Используется;
		ИмяРеквизитаТаблицы = Стр.Ключ;
		ТекущаяСтраницаИмя  = Стр.Значение.ТекущаяСтраницаИмя;
		Если Используется = Истина Тогда
			
			ИдентификаторПользовательскойНастройки = ЭтаФорма[ИмяРеквизитаТаблицы].КомпоновщикНастроек.Настройки.Отбор.ИдентификаторПользовательскойНастройки;
			Если НЕ ЗначениеЗаполнено(ИдентификаторПользовательскойНастройки) Тогда
				ИдентификаторПользовательскойНастройки = СокрЛП(Новый УникальныйИдентификатор);
				ЭтаФорма[ИмяРеквизитаТаблицы].КомпоновщикНастроек.Настройки.Отбор.ИдентификаторПользовательскойНастройки = ИдентификаторПользовательскойНастройки;
			КонецЕсли;
	 
			ПользовательскийОтбор = ЭтаФорма[ИмяРеквизитаТаблицы].КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ИдентификаторПользовательскойНастройки);
			Если НЕ ПользовательскийОтбор = Неопределено Тогда
				
				Для каждого Отбор ИЗ ПользовательскийОтбор.Элементы Цикл
					
					// Для периода 
					Если Найти(Отбор.Представление, "Программный отбор") > 0 Тогда			
						
						Если ТипЗнч(Отбор) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда		
							
							// Поиск именно для периода
							Если Отбор.ПредставлениеПользовательскойНастройки = "ДатаЗаказа"
								ИЛИ (ИмяРеквизитаТаблицы = "СписокДляЭТРН" И Отбор.ПредставлениеПользовательскойНастройки = "ДатаЭТРН")
								ИЛИ (ИмяРеквизитаТаблицы = "СписокДляCondra" И Отбор.ПредставлениеПользовательскойНастройки = "Дата")
								ИЛИ (ИмяРеквизитаТаблицы = "СписокДляПрайсЛиста" И Отбор.ПредставлениеПользовательскойНастройки = "Дата") Тогда
								
								Для каждого Эл Из Отбор.Элементы Цикл
									Если Эл.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно Тогда
										Настройки.Вставить(ИмяРеквизитаТаблицы + "ДатаНачалаОтбора", Эл.ПравоеЗначение);
									//ИначеЕсли Эл.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно Тогда
									//	Настройки.Вставить(ИмяРеквизитаТаблицы + "ДатаОкончанияОтбора", Эл.ПравоеЗначение);
									КонецЕсли;
								КонецЦикла;
								
								Настройки.Вставить(ИмяРеквизитаТаблицы + "Использование", Отбор.Использование);
								
								Прервать;
								
							КонецЕсли;		
							
						КонецЕсли;
						
					КонецЕсли;	
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	СохранитьПользовательскиеНастройки(ТекущийПользователь, Настройки);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНаличиеФайловНаКлиенте(ТипДокумента, ОбщийПроцентПрогресса, ДанныеСписка, МассивлогаСобытий, НачалоВыполнения = Неопределено) Экспорт
	
	Если НачалоВыполнения 	= Неопределено Тогда
		НачалоВыполнения 	= ТекущаяДата();
	КонецЕсли;
	
	ИмяСобытия	= "Получение документов " + ТипДокумента;
	
	ЗначениеПоУмолчанию = Неопределено;
	Измерение           = Неопределено; 
	Обязательно         = Истина;
	ЛокальныйКаталогINBOX = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_Локальный_Каталог_INBOX"", ЗначениеПоУмолчанию, Измерение, Обязательно)");
	ЛокальныйКаталогINBOX_Архив = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_Локальный_Каталог_INBOX_Архив"", ЗначениеПоУмолчанию, Измерение, Обязательно)");
	
	ДанныеОС = ЭКОМ_ПолучитьРазделительПутиОСКлиента();
	РазделительПути = ДанныеОС.Получить("РазделительПути");
	ТекущаяДата = ТекущаяДата();//Docrobot 1.22.0 MOD-2269
	
	КаталогиДоступны = Истина;	
	Если Не ЗначениеЗаполнено(ЛокальныйКаталогINBOX) ИЛИ Не ЗначениеЗаполнено(ЛокальныйКаталогINBOX_Архив) Тогда
		КаталогиДоступны = Ложь;
	Иначе	
		ПроверитьЛокальныйКаталог(ЛокальныйКаталогINBOX		 , ДанныеОС.Получить("РазделительПути"));
		ПроверитьЛокальныйКаталог(ЛокальныйКаталогINBOX_Архив, ДанныеОС.Получить("РазделительПути"));
		
		ЛокальныйКаталогINBOXФайл = ЭКОМ_СоздатьКаталогПроверитьНаЗаписьКлиент(ЛокальныйКаталогINBOX, МассивЛогаСобытий);
		ЛокальныйКаталогINBOX_АрхивФайл = ЭКОМ_СоздатьКаталогПроверитьНаЗаписьКлиент(ЛокальныйКаталогINBOX, МассивЛогаСобытий);
		Если ЛокальныйКаталогINBOXФайл = Неопределено ИЛИ ЛокальныйКаталогINBOX_АрхивФайл = Неопределено Тогда
			КаталогиДоступны = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если Не КаталогиДоступны Тогда
		ТекстЛогаСобытий = "Проверьте каталоги входящих (inbox) и архива входящих (inbox_bak) файлов";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Ошибка"), ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		ОтобразитьЛогСобытий(МассивЛогаСобытий);
		
		Возврат;
	КонецЕсли;

	Если ТипДокумента = "DRVGOV_02_Входящий" 
		ИЛИ ТипДокумента = "DRVGOU_03_Входящий"
		ИЛИ ТипДокумента = "WHGOU_04_Входящий"
		ИЛИ ТипДокумента = "DRVGPV_06_Входящий"
		ИЛИ ТипДокумента = "DRVGPU_07_Входящий"
		ИЛИ ТипДокумента = "WHGPU_08_Входящий" Тогда
		
		НачалоИмениФайла = "TRNX5";
		
	ИначеЕсли ТипДокумента = "DP_Статусы" Тогда
		
		НачалоИмениФайла = "DP_TRNX5";
		
	ИначеЕсли ТипДокумента = "RETINS" Тогда
		
		НачалоИмениФайла = "RETINS";
		
	ИначеЕсли ТипДокумента = "DP_IZVPOL_06"
		      ИЛИ ТипДокумента = "DP_IZVPOL_10" 
			  ИЛИ ТипДокумента = "DP_IZVPOL_23" Тогда	
			  
	    НачалоИмениФайла  = "DP_IZVPOL";
		
	ИначеЕсли Найти(ТипДокумента, "DP_PRANNUL_22") > 0 Тогда //Docrobot 1.19.0 MOD-1377 [Добавлена проверка на вид документа PRANNUL]
		
		НачалоИмениФайла = "DP_PRANNUL";
		
	ИначеЕсли ТипДокумента = "DP_UVUTOCH_09" Тогда //Docrobot 1.19.0 MOD-1377 [Добавлена проверка на вид документа UVUTOCH]
		
		НачалоИмениФайла = "DP_UVUTOCH";
		
	ИначеЕсли Найти(ТипДокумента,"DOPPOK") > 0 Тогда //Docrobot 1.19.0 MOD-1377 [Добавлена проверка для подписи, без номера квитанции]
		НачалоИмениФайла = Лев(ТипДокумента,СтрДлина(ТипДокумента)-3);

	Иначе
		
		НачалоИмениФайла = ТипДокумента;
	
	КонецЕсли;

    // Ищем файлы в локальном каталоге
    ФайлыЛокальные  = Новый Соответствие; // Чтобы не было дублей
    
	ФайлыЛокальныеНижнийРегистр = НайтиФайлы(ЛокальныйКаталогINBOX, "*" + НРЕГ(НачалоИмениФайла) + "_" + "*.xml", Ложь);
	ФайлыXML = НайтиФайлы(ЛокальныйКаталогINBOX, "*" + НачалоИмениФайла + "_" + "*.xml", Ложь);
	ФайлыZIP = НайтиФайлы(ЛокальныйКаталогINBOX, "*" + НачалоИмениФайла + "_" + "*.zip", Ложь);

    Для Каждого лЭлемент Из ФайлыЛокальныеНижнийРегистр Цикл
        ФайлыЛокальные.Вставить(лЭлемент.Имя, лЭлемент);
    КонецЦикла;
    
    Для Каждого лЭлемент Из ФайлыXML Цикл
        ФайлыЛокальные.Вставить(лЭлемент.Имя, лЭлемент);
    КонецЦикла;
    
    Для Каждого лЭлемент Из ФайлыZIP Цикл
        ФайлыЛокальные.Вставить(лЭлемент.Имя, лЭлемент);
    КонецЦикла;
    
    // Передаем файлы с клиента на сервер
    МассивФайловСКлиента 	= Новый Массив;
	ЗаменятьИмяXML			= ТипДокумента = "CONDRA";
	
	ПодписьНеобходима = Вычислить("ЭКОМ_ОбщегоНазначения.ПроверитьНеобходимостьПодписи(ТипДокумента)");
	
    Для каждого ЭлементФайл Из ФайлыЛокальные Цикл
        
        ЭлФайл = ЭлементФайл.Значение;
        
        СтруктураФайла = Новый Структура;
        
        // Распакуем файлы 
        Если ЭлФайл.Расширение = ".zip" 
            ИЛИ ЭлФайл.Расширение = "zip" Тогда
            ЧтениеZIP = Новый ЧтениеZipФайла(ЭлФайл.ПолноеИмя);
            
			// При необходимости сохранить уникальность имени XML получаем его имя из bin или pdf (актуально для CONDRA).
			Если ЗаменятьИмяXML Тогда
				
				//Docrobot 1.22.0 MOD-2269[распакуем сразу в необходимый каталог, обработка ошибок происходит позже]
				КаталогПуть = ЛокальныйКаталогINBOX_Архив + ТипДокумента + РазделительПути + Формат(ТекущаяДата, "ДФ=yyyyMMdd") + РазделительПути + ЭлФайл.ИмяБезРасширения + РазделительПути;			
				СтруктураФайла.Вставить("КаталогПуть", КаталогПуть);
			    СоздатьКаталог(КаталогПуть);
				ЧтениеZIP.ИзвлечьВсе(КаталогПуть, РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
							
			Иначе
				
				// Распакуем файлы в отдельный каталог.
				КаталогПуть = ЛокальныйКаталогINBOX + ЭлФайл.ИмяБезРасширения;
				СоздатьКаталог(КаталогПуть);
				ЧтениеZIP.ИзвлечьВсе(КаталогПуть, РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
				
			КонецЕсли;
			
			// Перемещение файлов с соблюдением уникальности имени (если необходимо).
			Для Каждого Файл Из НайтиФайлы(КаталогПуть, "*.*", Истина) Цикл
				// Пропускаем каталоги.
				Если Файл.ЭтоКаталог() Тогда
					Продолжить;
				КонецЕсли;
				
				// Перемещаем файл из временного каталога в папку входящих документов, при необходимости изменив его имя.
				Если Не ЗаменятьИмяXML Тогда  //Docrobot 1.22.0 MOD-2269
					ИмяФайлаПриемника = ЛокальныйКаталогINBOX + Файл.Имя;
					ПереместитьФайл(Файл.ПолноеИмя, ИмяФайлаПриемника);
				Иначе 
					ИмяФайлаПриемника = Файл.ПолноеИмя;
				КонецЕсли;
				
				Элемент = Новый Файл(ИмяФайлаПриемника);
				// Обрабатываем файл в зависимости от его расширения.
				СтруктураФайла.Вставить("ИмяБезРасширения",  Элемент.ИмяБезРасширения);
				
				ПоддерживаемыеРасширенияCONDRA = ?(ТипДокумента = "CONDRA", ПоддерживаемыеРасширенияCONDRAНаСервере(), Новый Массив);
				ПоддерживаемыеРасширенияCONDRA.Добавить("bin");
				ПоддерживаемыеРасширенияCONDRA.Добавить("xml");
				
				Для Каждого Расширение Из ПоддерживаемыеРасширенияCONDRA Цикл
					Если Найти(Элемент.Расширение, Расширение) > 0 Тогда
						АдресФайла = Base64Строка(Новый ДвоичныеДанные(Элемент.ПолноеИмя));
						СтруктураФайла.Вставить("ИмяФайла" + Расширение,  	Элемент.Имя);
						СтруктураФайла.Вставить("АдресФайла" + Расширение,  АдресФайла);
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
			КонецЦикла;
            
            ЧтениеZIP.Закрыть();
            // Удаление архива.
            УдалитьФайлы(ЭлФайл.ПолноеИмя);
			// Удаление временной папки.
			Если Не ЗаменятьИмяXML Тогда //Docrobot 1.22.0 MOD-2269 [удалять не нужно, это конечный каталог]
				УдалитьФайлы(КаталогПуть);
			КонецЕсли;
			
        Иначе
			
			//Docrobot 1.22.0 MOD-2269
			Если ЗаменятьИмяXML И ЭлФайл.Расширение = ".xml" 
				ИЛИ ЭлФайл.Расширение = "xml" Тогда
				КаталогПутьCONDRA = ЛокальныйКаталогINBOX_Архив + ТипДокумента + РазделительПути + Формат(ТекущаяДата, "ДФ=yyyyMMdd") + РазделительПути + ЭлФайл.ИмяБезРасширения + РазделительПути;			
				СтруктураФайла.Вставить("КаталогПуть", КаталогПутьCONDRA);
			КонецЕсли;
			
			Если ПодписьНеобходима = Истина Тогда
								
				ФайлыBIN = НайтиФайлы(ЛокальныйКаталогINBOX, "*" + ЭлФайл.ИмяБезРасширения + ".bin", Ложь);
				Если ФайлыBIN.Количество() > 0 Тогда
					ФайлBIN = ФайлыBIN[0];
					АдресФайлаBIN = Base64Строка(Новый ДвоичныеДанные(ФайлBIN.ПолноеИмя));	
					СтруктураФайла.Вставить("ИмяФайлаBIN"     ,  ФайлBIN.Имя);
					СтруктураФайла.Вставить("АдресФайлаBIN"   ,  АдресФайлаBIN);
					СтруктураФайла.Вставить("ИмяБезРасширения",  ФайлBIN.ИмяБезРасширения);
				КонецЕсли;
				
			КонецЕсли;
            
            Если ЭлФайл.Расширение = ".xml" 
                ИЛИ ЭлФайл.Расширение = "xml" Тогда
                АдресФайлаXML = Base64Строка(Новый ДвоичныеДанные(ЭлФайл.ПолноеИмя));	
                СтруктураФайла.Вставить("ИмяФайлаXML"     ,  ЭлФайл.Имя);
                СтруктураФайла.Вставить("АдресФайлаXML"   ,  АдресФайлаXML);
                СтруктураФайла.Вставить("ИмяБезРасширения",  ЭлФайл.ИмяБезРасширения);
            КонецЕсли;
            
        КонецЕсли;
        
        МассивФайловСКлиента.Добавить(СтруктураФайла);
        
	КонецЦикла;
	
	КлючЗаписиЦепочкиДокументов = Элементы[ДанныеСписка.ИмяСписка].ТекущаяСтрока;
    
	СтруктураЛога     = Вычислить("ЭКОМ_ОбщегоНазначенияКлиент.ПолучитьСтруктуруЛогаНаКлиенте()");	
	// Начать обработку данных
	Если ЭтаФорма.ДоступноВыполнениеВФоне Тогда
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("МассивФайловСКлиента", 	МассивФайловСКлиента);
		СтруктураПараметров.Вставить("ТипДокумента", 			ТипДокумента);
		СтруктураПараметров.Вставить("ОбработатьФайлыНаКлиенте", Истина);
		СтруктураПараметров.Вставить("МассивЛогаСобытий", 		МассивЛогаСобытий);
		СтруктураПараметров.Вставить("ЭтоРегламентноеЗадание", 	Ложь);
		СтруктураПараметров.Вставить("СтруктураЛога", 			СтруктураЛога);	
		СтруктураПараметров.Вставить("ЛокальныйКаталогINBOX", 	ЛокальныйКаталогINBOX);               
		СтруктураПараметров.Вставить("НачалоВыполнения", 		НачалоВыполнения);
		СтруктураПараметров.Вставить("ДанныеСписка", 			ДанныеСписка);	
		СтруктураПараметров.Вставить("ОбщийПроцентПрогресса", 	ОбщийПроцентПрогресса);
		СтруктураПараметров.Вставить("ИмяСобытия",				ИмяСобытия);
		СтруктураПараметров.Вставить("КлючЗаписиЦепочкиДокументов", КлючЗаписиЦепочкиДокументов);

		НачатьВыполнениеВФоне(СтруктураПараметров, "ПолучитьВсеФайлы", "Проверяем файлы на платформе - [" + ТипДокумента + "]...");
		
	Иначе
		
		МассивСтруктурыФайловСервера = ПолучитьВсеФайлыНаСервереБезКонтекста(ЭтаФорма.ОбработкаТип, МассивФайловСКлиента, ТипДокумента, Истина, МассивЛогаСобытий, Ложь, СтруктураЛога);   
		ОбработатьПолучениеФайловНаКлиенте(МассивСтруктурыФайловСервера, ТипДокумента, ЛокальныйКаталогINBOX, НачалоВыполнения, МассивЛогаСобытий, ДанныеСписка, ОбщийПроцентПрогресса, СтруктураЛога, КлючЗаписиЦепочкиДокументов);
		
		ТекстЛогаСобытий = "Время выполнения " + ЭКОМ_ОбщегоНазначенияКлиент.СекундыВоВремяНаКлиенте(ТекущаяДата() - НачалоВыполнения).Строка;
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Информация"), ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьПолучениеФайловНаКлиенте(МассивСтруктурыФайловСервера, ТипДокумента, ЛокальныйКаталогINBOX, НачалоВыполнения, МассивЛогаСобытий, ДанныеСписка, ОбщийПроцентПрогресса, СтруктураЛога, КлючЗаписиЦепочкиДокументов = Неопределено) Экспорт
	
	ТекущаяДата = ТекущаяДата();
	
	ИмяСобытия = "Получение документов - " + ТипДокумента;
	МассивОбработанныхФайловЛокально   = Новый Массив;
	
    Если МассивСтруктурыФайловСервера = Неопределено Тогда
        Возврат;
	КонецЕсли;
	
	ТЗОтветов.Очистить(); //Docrobot 1.19.0 MOD-1377 []
        
    МассивОшибочных = Новый Массив; 
    КоличествоСозданныхДокументов = 0;
    Для Каждого СтруктураФайла Из МассивСтруктурыФайловСервера Цикл
	
		Обработан = Ложь;
		СтруктураДок =  СтруктураФайла.СтруктураДок;
        Если СтруктураДок.Свойство("Обработан") = Истина Тогда
            Обработан = СтруктураДок.Обработан;
        КонецЕсли;	
		
		// Повторная обработка документа, пропускаем - файла нет, чтение из регистра
		Если СтруктураФайла.ПовторнаяОбработка = Истина Тогда
			ТекущееКоличество = 0;
			Если Обработан = Истина Тогда
				ТекущееКоличество = 1;
				КоличествоСозданныхДокументов = КоличествоСозданныхДокументов + ТекущееКоличество;
            КонецЕсли;
			
			Продолжить;			
		КонецЕсли;


        Если СтруктураФайла.АдресФайлаXML = Неопределено Тогда
            
            ТекстЛогаСобытий = "Не найден файл " + СтруктураФайла.ИмяФайлаXML;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Ошибка"), ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);	
			
            Продолжить;
            
        КонецЕсли;	
        
        // Получем файл из сервера на клиент
		Если ТипДокумента = "CONDRA" Тогда//Docrobot 1.22.0 MOD-2269
			ФайлXMLПолноеИмя = СтруктураДок.КаталогПуть + СтруктураФайла.ИмяФайлаXML
		Иначе
        	ФайлXMLПолноеИмя = ЛокальныйКаталогINBOX + СтруктураФайла.ИмяФайлаXML;
		КонецЕсли;	
        ДвоичныеДанныеФайла = Base64Значение(СтруктураФайла.АдресФайлаXML);
        ДвоичныеДанныеФайла.Записать(ФайлXMLПолноеИмя);
        ТекФайл = Новый Файл(ФайлXMLПолноеИмя);
        
        // Получаем подпись только там где она необходима
		Если СтруктураФайла.Свойство("АдресBIN") Тогда
			Если ТипДокумента = "CONDRA" Тогда//Docrobot 1.22.0 MOD-2269
				ФайлBINПолноеИмя = СтруктураДок.КаталогПуть + СтруктураФайла.ИмяФайлаПодписи;
			Иначе
            	ФайлBINПолноеИмя = ЛокальныйКаталогINBOX + СтруктураФайла.ИмяФайлаПодписи;
			КонецЕсли;	
            ДвоичныеДанныеФайлаПодписи = Base64Значение(СтруктураФайла.АдресBIN);
            ДвоичныеДанныеФайлаПодписи.Записать(ФайлBINПолноеИмя);
            ФайлBIN = Новый Файл(ФайлBINПолноеИмя);
            
        КонецЕсли;
        
        Если СтруктураФайла.Свойство("ИмяДокумента") Тогда	
            
            ТекстЛогаСобытий = " Файл <" + СтруктураФайла.ИмяФайлаXML + "> был загружен ранее. Пропущен. Документ - " + СтруктураФайла.ИмяДокумента;
            ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Предупреждение"), ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);	
            
            МассивОшибочных.Добавить(ТекФайл);
            Если СтруктураФайла.Свойство("АдресBIN") Тогда	     				
                МассивОшибочных.Добавить(ФайлBIN);
            КонецЕсли;
            
            Продолжить;
            
        КонецЕсли;
        	
        Если НЕ ЗначениеЗаполнено(СтруктураДок) Тогда	
            //Нет структуры
            ТекстЛогаСобытий = "Файл " + ТекФайл.Имя + " не загружен! структура файла не верна (260)";
            ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Ошибка"), ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);		
            
            МассивОшибочных.Добавить(ТекФайл);
            Если СтруктураФайла.Свойство("АдресBIN") Тогда	     				
                МассивОшибочных.Добавить(ФайлBIN);
            КонецЕсли;
            
            Продолжить;
            
        КонецЕсли;
        
        знОрганизация = Неопределено;
        СтруктураДок.Свойство("Организация", знОрганизация);
        
        ОбработкаПрерыванияПользователя();
               
        ТекущееКоличество = 0;	
                
        Если Обработан = Истина Тогда
            ТекущееКоличество = 1;
            МассивОбработанныхФайловЛокально.Добавить(ТекФайл);
            Если СтруктураФайла.Свойство("АдресBIN") Тогда	     				
                МассивОбработанныхФайловЛокально.Добавить(ФайлBIN);
			КонецЕсли;
			Если ТипДокумента = "CONDRA" Тогда
				Для Каждого Расширение Из ПоддерживаемыеРасширенияCONDRAНаСервере() Цикл
					Если СтруктураФайла.Свойство("ИмяФайла" + Расширение) И СтруктураФайла.Свойство("АдресФайла" + Расширение) Тогда
						Файлы = НайтиФайлы(ЛокальныйКаталогINBOX, СтруктураФайла["ИмяФайла" + Расширение], Ложь);
						Если Файлы.Количество() > 0 Тогда
							Файл = Файлы[0];
							ПереместитьФайл(Файл.ПолноеИмя, СтруктураДок.КаталогПуть + Файл.Имя);//Docrobot 1.22.0 MOD-2269
						ИначеЕсли СтруктураФайла.Свойство("АдресФайла" + Расширение) Тогда
							ФайлПолноеИмя = СтруктураДок.КаталогПуть + СтруктураФайла["ИмяФайла" + Расширение];
							ДвоичныеДанныеФайла = Base64Значение(СтруктураФайла["АдресФайла" + Расширение]);
							ДвоичныеДанныеФайла.Записать(ФайлПолноеИмя);
						КонецЕсли;
						
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
        Иначе
            МассивОшибочных.Добавить(ТекФайл);
            Если СтруктураФайла.Свойство("АдресBIN") Тогда	     				
                МассивОшибочных.Добавить(ФайлBIN);
			КонецЕсли;
			Если ТипДокумента = "CONDRA" Тогда
				Для Каждого Расширение Из ПоддерживаемыеРасширенияCONDRAНаСервере() Цикл
					Если СтруктураФайла.Свойство("ИмяФайла" + Расширение) И СтруктураФайла.Свойство("АдресФайла" + Расширение) Тогда
						Файлы = НайтиФайлы(ЛокальныйКаталогINBOX, СтруктураФайла["ИмяФайла" + Расширение], Ложь);
						Если Файлы.Количество() > 0 Тогда
							Файл = Файлы[0];
						ИначеЕсли СтруктураФайла.Свойство("АдресФайла" + Расширение) Тогда
							ФайлПолноеИмя = ЛокальныйКаталогINBOX + СтруктураФайла["ИмяФайла" + Расширение];
							ДвоичныеДанныеФайла = Base64Значение(СтруктураФайла["АдресФайла" + Расширение]);
							ДвоичныеДанныеФайла.Записать(ФайлПолноеИмя);
							Файл = Новый Файл(ФайлПолноеИмя);
						КонецЕсли;
						
						МассивОшибочных.Добавить(Файл);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
            //Продолжить; //Docrobot 1.19.0 MOD-1377 [Используется ниже]
		КонецЕсли;
		
		//Docrobot 1.19.0 MOD-1377 [Для каждого вида отдельно считаем количество]
		Если ТипДокумента = "DP_PDOTPR" Или ТипДокумента = "DP_PDPOL" Тогда
			Отбор = Новый Структура;
    		Отбор.Вставить("ВидДокумента", СтруктураДок.ВидДокумента);
			НайденнаяСтрока = ТЗОтветов.НайтиСтроки(Отбор);
			Если НайденнаяСтрока.Количество() = 0 Тогда
				НоваяСтрока = ТЗОтветов.Добавить();		
				НоваяСтрока.ВидДокумента 		 	 = СтруктураДок.ВидДокумента;
				НоваяСтрока.КоличествоОбщее 	 	 = 1;
				НоваяСтрока.КоличествоОбработано 	 = ТекущееКоличество;
			Иначе
				НайденнаяСтрока[0].КоличествоОбщее 	 = НайденнаяСтрока[0].КоличествоОбщее + 1;
				НайденнаяСтрока[0].КоличествоОбработано = НайденнаяСтрока[0].КоличествоОбработано + ТекущееКоличество;
			КонецЕсли;
		КонецЕсли;
		
		Если Не Обработан Тогда
			Продолжить;
		КонецЕсли;
		//Конец Docrobot 1.19.0 MOD-1377 [Для каждого вида отдельно считаем количество]
        
        КоличествоСозданныхДокументов = КоличествоСозданныхДокументов + ТекущееКоличество;
        
    КонецЦикла;
    
    // Перместить ошибочные файлы в архив - Локально
    Если МассивОшибочных.Количество() > 0 Тогда			
		
		ДанныеОС = ЭКОМ_ПолучитьРазделительПутиОСКлиента();
		РазделительПути = ДанныеОС.Получить("РазделительПути");
		
		КаталогОшибок     = ЛокальныйКаталогINBOX + "Ошибки при загрузке" + РазделительПути;
		СоздатьКаталог(КаталогОшибок);

		// После создания переносим загруженный файл в архив
        Для Каждого ЭлФайл Из МассивОшибочных Цикл
            Попытка
                ПереместитьФайл(ЭлФайл.ПолноеИмя, КаталогОшибок + ЭлФайл.Имя);
            Исключение               
                ТекстЛогаСобытий = "Ошибка при переносе файла <" + ЛокальныйКаталогINBOX + ЭлФайл.Имя +  "> в архив";
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Ошибка"), ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);	
				
                Продолжить;
                
            КонецПопытки;			
        КонецЦикла;
        
        ЗаписатьЛогСобытияВФайл(МассивЛогаСобытий, КаталогОшибок);
		    
    КонецЕсли;
    
    // Перместить файлы в архив - Локально
    Если МассивОбработанныхФайловЛокально.Количество() > 0 Тогда			
		
		ЗначениеПоУмолчанию = Неопределено;
		Измерение           = Неопределено; 
		Обязательно         = Истина;
		ЛокальныйКаталогINBOX_Архив = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_Локальный_Каталог_INBOX_Архив"", ЗначениеПоУмолчанию, Измерение, Обязательно)");
		
		ДанныеОС = ЭКОМ_ПолучитьРазделительПутиОСКлиента();
		РазделительПути = ДанныеОС.Получить("РазделительПути");
		
		ПроверитьЛокальныйКаталог(ЛокальныйКаталогINBOX_Архив, РазделительПути);
			
		//Docrobot 1.22.0 MOD-2269
		Если ТипДокумента <> "CONDRA" Тогда
			
			КаталогСохранения = ЛокальныйКаталогINBOX_Архив + ТипДокумента + РазделительПути + Формат(ТекущаяДата, "ДФ=yyyyMMdd") + РазделительПути; 
			СоздатьКаталог(КаталогСохранения);

			// После создания переносим загруженный файл в архив
	        Для Каждого ЭлФайл Из МассивОбработанныхФайловЛокально Цикл
	            Попытка
	                ПереместитьФайл(ЭлФайл.ПолноеИмя, КаталогСохранения + ЭлФайл.Имя);
	            Исключение              
	                ТекстЛогаСобытий = "Ошибка при переносе файла <" + ЛокальныйКаталогINBOX + ЭлФайл.Имя +  "> в архив";
	                ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Ошибка"), ИмяСобытия);
					МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
	                
	                Продолжить;
	            КонецПопытки;			
			КонецЦикла;
			
		КонецЕсли;	
			
    КонецЕсли;
	
	КоличествоФайловВсего = МассивСтруктурыФайловСервера.Количество();
	Если НЕ КоличествоСозданныхДокументов = КоличествоФайловВсего Тогда
		УровеньЛогирования = ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Предупреждение");
	ИначеЕсли КоличествоФайловВсего = 0 Тогда
		УровеньЛогирования = ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Информация");	
	Иначе
		УровеньЛогирования = ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Успешно");
	КонецЕсли;

    // Сообщим количество загруженых файлов
	
   	//Docrobot 1.19.0 MOD-1377 [Для каждого вида отдельно выводим в лог количество]
	Если ТЗОтветов.Количество() > 0 Тогда
		
		Для Каждого СтрокаОтвета Из ТЗОтветов Цикл
			Если НЕ СтрокаОтвета.КоличествоОбработано = СтрокаОтвета.КоличествоОбщее Тогда
				УровеньЛогирования = ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Предупреждение");	
			Иначе
				УровеньЛогирования = ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Успешно");
			КонецЕсли;
			
			ИмяСобытия = "Обработка/загрузка документов на клиенте " + ТипДокумента + ВернутьНомерКвитанции(СтрокаОтвета.ВидДокумента);
			
			ТекстЛогаСобытий = "Окончание обработки/загрузки документов. Обработано " + СтрокаОтвета.КоличествоОбработано
			+ " файлов из " + СтрокаОтвета.КоличествоОбщее + " возможных."
			//Docrobot 1.19.0 MOD-1377 [2 этап]
			+ " Время выполнения " + ЭКОМ_ОбщегоНазначенияКлиент.СекундыВоВремяНаКлиенте(ТекущаяДата() - ТекущаяДата).Строка;
			ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, УровеньЛогирования, ИмяСобытия);
			МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		КонецЦикла;
		
	ИначеЕсли Не КоличествоФайловВсего = 0 Тогда //Docrobot 1.19.0 MOD-1377 [Добавил проверку. Не выводить, если количество 0. ]
		
		ТекстЛогаСобытий = "Окончание обработки/загрузки документов. Обработано " + КоличествоСозданныхДокументов
		+ " файлов из " + КоличествоФайловВсего + " возможных."
		//Docrobot 1.19.0 MOD-1377 []
		+ " Время выполнения " + ЭКОМ_ОбщегоНазначенияКлиент.СекундыВоВремяНаКлиенте(ТекущаяДата() - ТекущаяДата).Строка;
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, УровеньЛогирования, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
	КонецЕсли;
	//Конец Docrobot 1.19.0 MOD-1377 [Для каждого вида отдельно выводим в лог количество]
	
	// Статус завершения операции в фоне
	ЭтаФорма.Индикатор = ЭтаФорма.Индикатор + ОбщийПроцентПрогресса;
	
	Если ЭтаФорма.Индикатор >= 99 Тогда
	     Элементы.ПолеИндикатор.Видимость = Ложь;
		 Элементы.КомандаЗакрытьИндикатор.Видимость = Ложь;
	КонецЕсли;
	
	Если СтруктураЛога.ЕстьОшибка = Истина Тогда
	     Элементы.КомандаНадписьОшибка.Видимость = Истина;
	КонецЕсли;
	
	//ОтобразитьЛогСобытий(МассивЛогаСобытий);

	
	ВыбранныеСтроки = Новый Массив;
	Для Каждого Идентификатор Из Элементы[ДанныеСписка.ИмяСписка].ВыделенныеСтроки Цикл
		ВыбранныеСтроки.Добавить(Новый Структура("ИдентификаторВыделенныхСтрок, Полученные", Идентификатор, Истина));
	КонецЦикла;
	ОбновитьДинамическийСписок(ДанныеСписка, Истина, ВыбранныеСтроки, КлючЗаписиЦепочкиДокументов);
	ОбновитьЦепочкуДокументовНаКлиенте(ДанныеСписка.ИмяСписка, КлючЗаписиЦепочкиДокументов);
	ОбновитьКвитанцииНаКлиенте(ДанныеСписка.ИмяСписка);
	КомандаОбновитьКоличествоДокументовНаПлатформеНаСервере(ИнфоДатаЗагруженоЗа, ИнфоДокументыНаПлатформе);
	Если ВыбранныеСтроки.Количество() Тогда
		ВосстановитьТекущуюСтрокуСписка(Элементы[ДанныеСписка.ИмяСписка].ТекущаяСтрока, ДанныеСписка.ИмяСписка, ВыбранныеСтроки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ВернутьНомерКвитанции(ВидДокумента) //Docrobot 1.19.0 MOD-1377 []
	
	Если ВидДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.DP_PDOTPR_03") Тогда
		Возврат "_03";	
	ИначеЕсли ВидДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.DP_PDOTPR_08") Тогда 
		Возврат "_08";
	ИначеЕсли ВидДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.DP_PDOTPR_13") Тогда 
		Возврат "_13";
	ИначеЕсли ВидДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.DP_PDPOL_02") Тогда 
		Возврат "_02";
	ИначеЕсли ВидДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.DP_PDPOL_07") Тогда 
		Возврат "_07";
	ИначеЕсли ВидДокумента = ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.DP_PDPOL_12") Тогда 
		Возврат "_12";
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ВыводСообщенийНаЭкранНаКлиенте(Текст, Заголовок, Статус = "", ВыводитьСообщения = Истина)
    
    Если НЕ ВыводитьСообщения Тогда
        Возврат;
    КонецЕсли;
    
    Если Статус = "" Тогда	
        Статус = СтатусСообщения.Обычное;	
    КонецЕсли;
    
    Если Заголовок <> "Авто" Тогда
        Сообщить(Текст, Статус);	
    КонецЕсли;
КонецПроцедуры	

&НаКлиенте
Функция ПроверитьПодписьФайлаНаКлиенте(ИмяПодписанногоФайла, ИмяФайлаПодписиBIN, МассивЛогаСобытий)
    
    Структура = Новый Структура;
    Структура.Вставить("ПодписьВерна", Ложь);
    Структура.Вставить("Отпечаток"   , "");
    
    знСертификат  = Неопределено;
    
    ПодписьТело		= Новый ТекстовыйДокумент;
    ПодписьТело.Прочитать(ИмяФайлаПодписиBIN);
    ПодписьТелоBase64 	= ПодписьТело.ПолучитьТекст();
    ПодписьТелоBase64 	= СтрЗаменить(ПодписьТелоBase64, Символы.ПС, "");
    ПодписьТелоBase64 	= СтрЗаменить(ПодписьТелоBase64, Символы.ВК, "");
    
    ИмяФайлаПодписиSGN = ПолучитьИмяВременногоФайла("sgn");
    // Декодирование и сохранение строки BASE64 в файл.
    ДвоичныеДанные 	= Base64Значение(ПодписьТелоBase64);
    ДвоичныеДанные.Записать(ИмяФайлаПодписиSGN);
    
    Попытка
        МенеджерКриптографии = Новый МенеджерКриптографии("", "", 80);
        МенеджерКриптографии.ПроверитьПодпись(ИмяПодписанногоФайла, ИмяФайлаПодписиSGN, знСертификат);
        Структура.Вставить("Отпечаток"   , Base64Строка(знСертификат.Отпечаток));
        Структура.Вставить("ПодписьВерна", Истина);		
    Исключение
        ТекстЛогаСобытий = ОписаниеОшибки();
        ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Ошибка"), "Проверка подписи на клиенте");
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

    КонецПопытки;
    
    Возврат Структура;
    
КонецФункции

&НаСервереБезКонтекста
Функция РазбитьМассивПоЧастям(пМассив)
    
    Структура = Новый Структура;
    
    Счетчик    = 0;
    НомерЧасти = 1;
    Соответствие = Новый Соответствие;
    Для каждого Эл Из пМассив Цикл
        Счетчик = Счетчик + 1;
        Если Счетчик < 2000 Тогда	
            Соответствие.Вставить(Эл.Имя, "");	
        Иначе			
            Счетчик    = 0;
            НомерЧасти = НомерЧасти + 1;		
            Соответствие = Новый Соответствие;
        КонецЕсли;
        
        Структура.Вставить("Часть" + НомерЧасти, Соответствие);
    КонецЦикла;
    
    Возврат Структура;
    
КонецФункции

&НаСервере
Функция НайтиТекущегоПользователя()
    ОбъектЭтаОбработка = РеквизитФормыВЗначение("Объект");
    Результат = ОбъектЭтаОбработка.НайтиТекущегоПользователя();
    
    ОбъектЭтаОбработка = Неопределено;
    Возврат Результат;
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ФУНКЦИИ ДЛЯ ПОСТАВЩИКА

#Область ФункцииДляПоставщика

&НаКлиенте
Функция ПолучитьСтрокиДинамическогоСпискаДляОбработки(ДанныеСписка, ПозицияТекущейСтроки, ВыделенныеСтроки = Неопределено)
	
	Если ВыделенныеСтроки = Неопределено Тогда
		ВыделенныеСтроки = Новый Массив;
	КонецЕсли;
	
	СписокДляОбработки   = Элементы[ДанныеСписка.ИмяСписка];
	ПозицияТекущейСтроки = СписокДляОбработки.ТекущаяСтрока;
	ВыделенныеСтроки     = СписокДляОбработки.ВыделенныеСтроки;
	
	СтрКолонки = "";
	Для каждого ИмяКолонки Из СписокДляОбработки.ПодчиненныеЭлементы Цикл
		ИмяТекКолонки = СтрЗаменить(ИмяКолонки.Имя, СписокДляОбработки.Имя, "");
		ИмяТекКолонки = СтрЗаменить(ИмяТекКолонки, "ГруппаКолонок_", "");
		СтрКолонки    = ?(СтрКолонки = "", ИмяТекКолонки, СтрКолонки + "," + ИмяТекКолонки);		
	КонецЦикла;
	
	ПомеченныеСтроки = Новый Массив;
	УстанавливаютсяПометкиВЗапросе = Найти(СтрКолонки, "Пометка") > 0;
	Если УстанавливаютсяПометкиВЗапросе = Истина Тогда
		ПомеченныеСтроки = ПолучитьСтроки(ДанныеСписка.ИмяСписка, СтрКолонки);
	КонецЕсли;
	
	Если ПомеченныеСтроки.Количество() = 0 Тогда			
		Для каждого текВыделеннаяСтрока Из ВыделенныеСтроки Цикл
			РезультатСтруктура = Новый Структура(СтрКолонки);
			РезультатСтруктура.Вставить("ИдентификаторВыделенныхСтрок", текВыделеннаяСтрока);			
			ВыбраннаяСтрока = СписокДляОбработки.ДанныеСтроки(текВыделеннаяСтрока);			
			ЗаполнитьЗначенияСвойств(РезультатСтруктура, ВыбраннаяСтрока);
			ПомеченныеСтроки.Добавить(РезультатСтруктура);
		КонецЦикла;				
	КонецЕсли;
	
	//++ MOD-1485 
	// Очищаем пометки
	//Если УстанавливаютсяПометкиВЗапросе = Истина Тогда		
	//	УправлениеПометкамиДинамическогоСписка(Ложь);
	//КонецЕсли;
	//-- MOD-1485
	
	Если ТипЗнч(ПозицияТекущейСтроки) = Тип("Число") 
		И ПомеченныеСтроки.Количество() >= ПозицияТекущейСтроки Тогда
		СписокДляОбработки.ТекущаяСтрока = ПозицияТекущейСтроки;
	КонецЕсли;
	
	Возврат ПомеченныеСтроки;
	
КонецФункции

&НаСервере
Функция ПолучитьСтроки(ИмяСписка, СтрКолонки)
	
	ВыбранныеСтроки = Новый Массив; 
	
	ТЗ = ДинамическийСписок_в_ТЗ(ИмяСписка);
	НайденныеСтроки = ТЗ.НайтиСтроки(Новый Структура("Пометка", Истина));
	Для каждого ТекСтрока Из НайденныеСтроки Цикл
		РезультатСтруктура = Новый Структура(СтрКолонки);	
		ЗаполнитьЗначенияСвойств(РезультатСтруктура, ТекСтрока);
		ВыбранныеСтроки.Добавить(РезультатСтруктура);
	КонецЦикла;
	
	Возврат ВыбранныеСтроки;
	
КонецФункции

// Параметры: 
// ИмяСписка             = "СписокДляПоставщика"
// ИмяДокументаИсточника = "ЭКОМ_Документ_ORDER"
// ИмяДокументаПриемника = "ДокументЗаказа"
// ИмяПроцедурыСоздания  = "СоздатьДокументыЗаказа"
&НаКлиенте
Процедура СоздатьДокументы(ИмяДокументаИсточника, ИмяДокументаПриемника, ИмяПроцедурыСоздания)	
	
	МассивЛогаСобытий = Новый Массив;
	ДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();	
	ПозицияТекущейСтроки = Неопределено;
    ОбрабатываемыеДанные = ПолучитьСтрокиДинамическогоСпискаДляОбработки(ДанныеСписка, ПозицияТекущейСтроки);
  
    МассивСтрокОтправленных    = Новый Массив;
    МассивСтрокНовыхДокументов = Новый Массив;
    Для каждого ВыбраннаяСтрока Из ОбрабатываемыеДанные Цикл
        
        Если ЗначениеЗаполнено(ВыбраннаяСтрока[ИмяДокументаИсточника]) 
            И НЕ ЗначениеЗаполнено(ВыбраннаяСтрока.ТекстОшибки) Тогда
            
            СтруктураСтроки = Новый Структура;
            СтруктураСтроки.Вставить("Строка", ВыбраннаяСтрока);
            СтруктураСтроки.Вставить("ИмяДокументаПриемника", ИмяДокументаПриемника);
            
            Если ЗначениеЗаполнено(ВыбраннаяСтрока[ИмяДокументаПриемника]) Тогда	 
                СтруктураСтроки.Вставить("СтрокаОбработана", Ложь);	 
                МассивСтрокОтправленных.Добавить(СтруктураСтроки);
            Иначе
                СтруктураСтроки.Вставить("СтрокаОбработана", Истина);
                МассивСтрокНовыхДокументов.Добавить(СтруктураСтроки);
            КонецЕсли;
            
        КонецЕсли;	
    КонецЦикла;
    
    Если МассивСтрокОтправленных.Количество() > 0 Тогда
        
        ПроверитьНаПовторноеСоздание(МассивСтрокОтправленных, ИмяПроцедурыСоздания, МассивЛогаСобытий);		
        
    КонецЕсли;
    
    // Создание документов для тех которые еще не созданы
    Если МассивСтрокНовыхДокументов.Количество() > 0 Тогда
        
        ПараметрыПроцедуры = Новый Массив;
        ПараметрыПроцедуры.Добавить(МассивСтрокНовыхДокументов);
        ПараметрыПроцедуры.Добавить(МассивЛогаСобытий);
        ВыполнитьПроцедуруИзМодуляОбъекта(ИмяПроцедурыСоздания, ПараметрыПроцедуры);
        	
		ОбновитьДинамическийСписок(ДанныеСписка);        
        ОбновитьЦепочкуДокументовНаКлиенте(ДанныеСписка.ИмяСписка);
        ОтобразитьЛогСобытий(МассивЛогаСобытий);
        
    КонецЕсли;	
    
КонецПроцедуры

// Параметры: 
// ИмяСписка             = "СписокДляПоставщика"
// ИмяДокументаИсточника = "ЭКОМ_Документ_ORDER"
// ИмяДокументаПриемника = "ДокументЗаказа"
// ИмяПроцедурыСоздания  = "СоздатьДокументыЗаказа"
&НаКлиенте
Функция ОтправитьДокументы(ДанныеСписка, ИмяСтатуса, ИмяДокументаИсточника, ТипДокумента, СоответствиеКолонок, НужнаПодпись)	
	
	Отказ = Ложь;
	МассивЛогаСобытий = Новый Массив;
	ИмяСобытия = "Отправка документов " + ТипДокумента;
	
	Если СоответствиеКолонок.Получить(ИмяСтатуса) = Неопределено Тогда
		ТекстЛогаСобытий = "В списке табличной части нет колонки с именем статуса - [" + ИмяСтатуса + "]";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Ошибка"), ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		Отказ = Истина;
	КонецЕсли;
	
	Если СоответствиеКолонок.Получить(ИмяДокументаИсточника) = Неопределено Тогда
		ТекстЛогаСобытий = "Отсутствует документ-источник (колонка [" + ИмяДокументаИсточника + "])";
		ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Ошибка"), ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		Отказ = Истина;
	КонецЕсли;
	
	Если Отказ = Ложь Тогда		
		// Проверка заполненности причины отклонения 
		Если Найти(ТипДокумента, "DP_PRANNUL_22") > 0 //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _22]
			ИЛИ ТипДокумента = "DP_UVUTOCH_24" Тогда
			
			ПозицияТекущейСтроки = Неопределено;	
			ВыгружаемыеДанные    = ПолучитьСтрокиДинамическогоСпискаДляОбработки(ДанныеСписка, ПозицияТекущейСтроки);
			ВосстановитьТекущуюСтрокуСписка(ПозицияТекущейСтроки, ДанныеСписка.ИмяСписка, ВыгружаемыеДанные);
			
			Если ТипДокумента = "DP_UVUTOCH_24" Тогда
				ИмяКолонкиТекста = "ТекстОтклоненияАннулирования";
				Подсказка = "Причина отклонения аннулирования";
			Иначе
				ИмяКолонкиТекста = "ТекстПричиныАннулирования";
				Подсказка = "Причина аннулирования";
			КонецЕсли;
			
			Если СоответствиеКолонок.Получить("ТекстПричиныАннулирования") = Неопределено Тогда
				ТекстЛогаСобытий = "В списке табличной части нет колонки с именем документа - [" + ИмяКолонкиТекста + "])";
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Ошибка"), ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
				Отказ = Истина;
			КонецЕсли;
			
			Если Отказ = Ложь Тогда
				ТребуютУстановкиТекста = Новый Массив;
				Для Каждого ВыбраннаяСтрока Из ВыгружаемыеДанные Цикл
					
					Если ПустаяСтрока(ВыбраннаяСтрока[ИмяКолонкиТекста]) Тогда				
						ТребуютУстановкиТекста.Добавить(ВыбраннаяСтрока[ИмяДокументаИсточника]);
					КонецЕсли;
					
				КонецЦикла;
				
				Если ТребуютУстановкиТекста.Количество() > 0 Тогда
					
					ДополнительныеПараметры = Новый Структура;		
					ДополнительныеПараметры.Вставить("ДанныеСписка", 		   ДанныеСписка);
					ДополнительныеПараметры.Вставить("ИмяСтатуса", 			   ИмяСтатуса);
					ДополнительныеПараметры.Вставить("МассивЛогаСобытий", 	   МассивЛогаСобытий);
					ДополнительныеПараметры.Вставить("ТипДокумента", 		   ТипДокумента);
					ДополнительныеПараметры.Вставить("НужнаПодпись", 		   НужнаПодпись);
					ДополнительныеПараметры.Вставить("ТребуютУстановкиТекста", ТребуютУстановкиТекста);
					ДополнительныеПараметры.Вставить("ИмяКолонкиТекста"      , ИмяКолонкиТекста);
					
					Оповещение = Новый ОписаниеОповещения("ЗавершениеВводаТекстаАннулирования", ЭтаФорма, ДополнительныеПараметры);
					ПоказатьВводСтроки(Оповещение, , Подсказка, 0, Истина);
				Иначе
					Возврат ОтправитьДокументыПродолжить(ДанныеСписка, ИмяСтатуса, ТипДокумента, НужнаПодпись, МассивЛогаСобытий);
				КонецЕсли;
				
			КонецЕсли;
			
			// Проверка заполненности причины отклонения для отклоненной кондры.
		ИначеЕсли ТипДокумента = "CONDRA_ОТКЛОНИТЬ" Тогда
			
			ПозицияТекущейСтроки = Неопределено;
			ВыделенныеСтроки	 = Неопределено;
			ВыгружаемыеДанные    = ПолучитьСтрокиДинамическогоСпискаДляОбработки(ДанныеСписка, ПозицияТекущейСтроки, ВыделенныеСтроки);
			
			Для Каждого ВыбраннаяСтрока Из ВыгружаемыеДанные Цикл
				Если ПустаяСтрока(ВыбраннаяСтрока.Информация) Тогда
					Подсказка = "Причина отклонения";
					ДополнительныеПараметры = Новый Структура;
					
					ДополнительныеПараметры.Вставить("ДанныеСписка", 			ДанныеСписка);
					ДополнительныеПараметры.Вставить("ИмяСтатуса", 				ИмяСтатуса);
					ДополнительныеПараметры.Вставить("МассивЛогаСобытий", 		МассивЛогаСобытий);
					ДополнительныеПараметры.Вставить("ТипДокумента", 			ТипДокумента);
					ДополнительныеПараметры.Вставить("НужнаПодпись", 			НужнаПодпись);
					ДополнительныеПараметры.Вставить("ВыгружаемыеДанные", 		ВыгружаемыеДанные);
					ДополнительныеПараметры.Вставить("ПозицияТекущейСтроки", 	ПозицияТекущейСтроки);
					ДополнительныеПараметры.Вставить("ИмяДокумента", 			ИмяДокументаИсточника);
					ДополнительныеПараметры.Вставить("ВыделенныеСтроки",		ВыделенныеСтроки);
					
					Оповещение = Новый ОписаниеОповещения("ЗавершениеВводаИнформация", ЭтаФорма, ДополнительныеПараметры);
					ПоказатьВводСтроки(Оповещение, , Подсказка, 0, Истина);
					Прервать;
				Иначе
					Возврат ОтправитьДокументыПродолжить(ДанныеСписка, ИмяСтатуса, ТипДокумента, НужнаПодпись, МассивЛогаСобытий);
				КонецЕсли;
			КонецЦикла;
		Иначе
			Возврат ОтправитьДокументыПродолжить(ДанныеСписка, ИмяСтатуса, ТипДокумента, НужнаПодпись, МассивЛогаСобытий);
		КонецЕсли;
		
	Иначе		
		ОтобразитьЛогСобытий(МассивЛогаСобытий);
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// Продолжение процедуры отправки документов (нужен для отображения поля ввода текста отклонения для CONDRA)
//
// Параметры:
// ИмяСписка             = "СписокДляПоставщика"
// ИмяДокументаИсточника = "ЭКОМ_Документ_ORDER"
// ИмяДокументаПриемника = "ДокументЗаказа"
// ИмяПроцедурыСоздания  = "СоздатьДокументыЗаказа"
//
&НаКлиенте
Функция ОтправитьДокументыПродолжить(ДанныеСписка, ИмяСтатуса, ТипДокумента, НужнаПодпись, МассивЛогаСобытий)
	
	// Обновление ТЧ для актуализации статусов документов перед отправкой.
	ОбновитьДинамическийСписок(ДанныеСписка);
	
	ИмяСобытия = "Отправить документы - " + ТипДокумента;
	ПозицияТекущейСтроки = Неопределено;	
	ВыгружаемыеДанные    = ПолучитьСтрокиДинамическогоСпискаДляОбработки(ДанныеСписка, ПозицияТекущейСтроки);
	ВосстановитьТекущуюСтрокуСписка(ПозицияТекущейСтроки, ДанныеСписка.ИмяСписка, ВыгружаемыеДанные);
	
	МассивСтрокОтправленных    = Новый Массив;
    МассивСтрокНовыхДокументов = Новый Массив;
	
	ЗначениеПоУмолчанию = Ложь;
	Измерение           = Неопределено; 
	Обязательно         = Ложь;
	ЭКОМ_ОтправлятьДокументыПовторно = Вычислить("ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере(""ЭКОМ_ОтправлятьДокументыПовторно"", ЗначениеПоУмолчанию, Измерение, Обязательно)");
	
	Для каждого ВыбраннаяСтрока Из ВыгружаемыеДанные Цикл
		
		ВыбраннаяСтрока.Вставить("ПредставлениеДокумента", ПолучитьПредставлениеДокумента(ТипДокумента, ВыбраннаяСтрока));
		ДокументУжеБылОтправлен = Ложь;
		// Для EDI
		Если ВыбраннаяСтрока[ИмяСтатуса] = Истина
			ИЛИ ВыбраннаяСтрока[ИмяСтатуса] = ПредопределенноеЗначение("Перечисление.ЭКОМ_СтатусыЭлектронныхДокументов.Отправлен") Тогда
			ДокументУжеБылОтправлен = Истина;
		КонецЕсли;
		
		Если ИмяСтатуса = "Статус_УПД" 
			ИЛИ ИмяСтатуса = "Статус_УПД_Исходящий" Тогда
			
			Если ТипДокумента = "ЮЗД"
				И (ВыбраннаяСтрока[ИмяСтатуса] = "" 
				ИЛИ ВыбраннаяСтрока[ИмяСтатуса] = ПредопределенноеЗначение("Перечисление.ЭКОМ_Статусы.ПустаяСсылка")
				ИЛИ ВыбраннаяСтрока[ИмяСтатуса] = ПредопределенноеЗначение("Перечисление.ЭКОМ_Статусы.НеОбработан")) Тогда
				
				ДокументУжеБылОтправлен = Ложь;
				
			ИначеЕсли ТипДокумента = "DP_UVUTOCH_09" Тогда // Задача MOD-1423 //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _09]
				//И НЕ (ВыбраннаяСтрока[ИмяСтатуса] = "Отправлено уточнение"
				//ИЛИ ВыбраннаяСтрока[ИмяСтатуса] = ПредопределенноеЗначение("Перечисление.ЭКОМ_Статусы.ОтправленоУточнение")) 
				
				ДокументУжеБылОтправлен = Ложь;
				
			ИначеЕсли Найти(ТипДокумента, "DP_PRANNUL_22") > 0  //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _22]  
				И НЕ (ВыбраннаяСтрока[ИмяСтатуса] = "Отправлено аннулирование"
				ИЛИ ВыбраннаяСтрока[ИмяСтатуса] = ПредопределенноеЗначение("Перечисление.ЭКОМ_Статусы.ОтправленоАннулирование")) Тогда
				
				ДокументУжеБылОтправлен = Ложь;
				
			ИначеЕсли ТипДокумента = "DP_UVUTOCH_24" 
				И НЕ (ВыбраннаяСтрока[ИмяСтатуса] = "Отклонено аннулирование"
				ИЛИ ВыбраннаяСтрока[ИмяСтатуса] = ПредопределенноеЗначение("Перечисление.ЭКОМ_Статусы.ОтклоненоАннулирование")) Тогда
				
				ДокументУжеБылОтправлен = Ложь;
				
			ИначеЕсли ТипДокумента = "DP_IZVPOL_23" 
				И НЕ (ВыбраннаяСтрока[ИмяСтатуса] = "Принято аннулирование"
				ИЛИ ВыбраннаяСтрока[ИмяСтатуса] = ПредопределенноеЗначение("Перечисление.ЭКОМ_Статусы.ПринятоАннулирование")) Тогда

				ДокументУжеБылОтправлен = Ложь;

			ИначеЕсли ТипДокумента = "ПодписьЮЗД" Тогда // Задача MOD-1410
				//И НЕ (ВыбраннаяСтрока[ИмяСтатуса] = "Документооборот завершен"
				//ИЛИ ВыбраннаяСтрока[ИмяСтатуса] = ПредопределенноеЗначение("Перечисление.ЭКОМ_Статусы.ДокументооборотЗавершен")) Тогда
				
				ДокументУжеБылОтправлен = Ложь;
				
			ИначеЕсли ТипДокумента = "DP_REZRUISP"
				И (ВыбраннаяСтрока[ИмяСтатуса] = "Не обработан"
				ИЛИ ВыбраннаяСтрока[ИмяСтатуса] = ПредопределенноеЗначение("Перечисление.ЭКОМ_Статусы.НеОбработан")) Тогда 
				
				ДокументУжеБылОтправлен = Ложь;
			
			Иначе
				
				ДокументУжеБылОтправлен = Истина;
				
			КонецЕсли;
			
		// Для прайс-листа
		ИначеЕсли ИмяСтатуса = "СтатусОбработкиДокумента" Тогда		
			Если ВыбраннаяСтрока[ИмяСтатуса] = ПредопределенноеЗначение("Перечисление.ЭКОМ_Статусы.Отправлен") Тогда
				ДокументУжеБылОтправлен = Истина;
			КонецЕсли;

		КонецЕсли;
		
		Если Найти(ТипДокумента, "CONDRA") > 0 Тогда
			Если (ТипДокумента = "CONDRA_ОТКЛОНИТЬ" 
				И ВыбраннаяСтрока[ИмяСтатуса] = ПредопределенноеЗначение("Перечисление.ЭКОМ_СтатусыCONDRA.Отклонён"))
				
				ИЛИ (ТипДокумента = "CONDRA_ПРИНЯТЬ" 
				И ВыбраннаяСтрока[ИмяСтатуса] = ПредопределенноеЗначение("Перечисление.ЭКОМ_СтатусыCONDRA.Принят")) Тогда
				
				ДокументУжеБылОтправлен = Истина;
			КонецЕсли;
		КонецЕсли;
		
		СтруктураСтроки = Новый Структура;
		СтруктураСтроки.Вставить("Строка", ВыбраннаяСтрока);       
		
		Если ДокументУжеБылОтправлен Тогда	 
			Если ЭКОМ_ОтправлятьДокументыПовторно = Ложь Тогда
				ТекстЛогаСобытий = СтруктураСтроки.Строка.ПредставлениеДокумента + " - документ пропущен, так как был уже отправлен!";
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Предупреждение"), ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

				Продолжить;
			Иначе
				СтруктураСтроки.Вставить("СтрокаОбработана", Ложь);
				СтруктураСтроки.Вставить("ОтправитьПовторно", Истина);
				СтруктураСтроки.Вставить("ПредставлениеДокумента", СтруктураСтроки.Строка.ПредставлениеДокумента);
				МассивСтрокОтправленных.Добавить(СтруктураСтроки);
			КонецЕсли;
		Иначе
			СтруктураСтроки.Вставить("СтрокаОбработана" , Истина);
			СтруктураСтроки.Вставить("ОтправитьПовторно", Ложь);
			СтруктураСтроки.Вставить("ПредставлениеДокумента", СтруктураСтроки.Строка.ПредставлениеДокумента);
			МассивСтрокНовыхДокументов.Добавить(СтруктураСтроки);
		КонецЕсли;
		
	КонецЦикла;
	
	ИсключитьОтправкуПоЗапрещеннымКонтрагентам(МассивСтрокОтправленных, ДанныеСписка.ИмяКнопки, ИмяСобытия, МассивЛогаСобытий, ОбработкаТип);
	ИсключитьОтправкуПоЗапрещеннымКонтрагентам(МассивСтрокНовыхДокументов, ДанныеСписка.ИмяКнопки, ИмяСобытия, МассивЛогаСобытий, ОбработкаТип);
	
    Если МассивСтрокОтправленных.Количество() > 0 
        И ЭКОМ_ОтправлятьДокументыПовторно = Истина Тогда
        
        ПроверитьНаПовторнуюОтправку(МассивСтрокОтправленных, МассивЛогаСобытий, НужнаПодпись, ТипДокумента, ПозицияТекущейСтроки, ВыгружаемыеДанные);		
        
    КонецЕсли;
    
    // Отправка документов которые еще не отправлены
    Если МассивСтрокНовыхДокументов.Количество() > 0 Тогда
		
		ЭтаФорма.Индикатор = 1;
		Элементы.ПолеИндикатор.Видимость = Истина;
        Элементы.КомандаЗакрытьИндикатор.Видимость = Истина;
		
		ЭтоНовыеДокументы = Истина;
		Возврат ОтправитьФайлыНаКлиенте(МассивСтрокНовыхДокументов, ТипДокумента, ДанныеСписка, 100, ПозицияТекущейСтроки, ВыгружаемыеДанные, Ложь, МассивЛогаСобытий, НужнаПодпись, ЭтоНовыеДокументы);
	Иначе
		ОтобразитьЛогСобытий(МассивЛогаСобытий);
		Возврат Ложь;	
    КонецЕсли;	
    
КонецФункции // ОтправитьДокументыПродолжить()

// Исключает из отправки документы по контрагенту, на отправку которому установлен запрет для текущих ролей пользователя
//
// Параметры:
//  МассивСтрок	- Массив - коллекция строк табличного поля с документами к отправке
//  ИмяКнопки  	- Строка - наименование нажатой пользователем кнопки
//	ИмяСобытия	- Строка - имя выполняемого доействия для указания в записи лога
//	МассивЛогаСобытий - Массив - коллекция сообщений для записи в лог событий
//	ОбработкаТип 	  - Строка - внутреннее строковое представление типа значения объекта обработки. Необходимо для обращения к методам модуля обработки 	
//   
&НаСервереБезКонтекста
Процедура ИсключитьОтправкуПоЗапрещеннымКонтрагентам(МассивСтрок, ИмяКнопки, ИмяСобытия, МассивЛогаСобытий, ОбработкаТип)
	
	КоличествоСтрок = МассивСтрок.Количество();
	Если КоличествоСтрок = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОбработкаОбъект = Новый (ЗначениеИзСтрокиВнутр(ОбработкаТип));
	ОграниченияПоКонтрагентам = ОбработкаОбъект.ПолучитьОграниченияДоступаПоКонтрагентам();
	Если ОграниченияПоКонтрагентам.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Счетчик = 1 По КоличествоСтрок Цикл
		ИндексСтроки = КоличествоСтрок - Счетчик;
		ЭлементМассива = МассивСтрок.Получить(ИндексСтроки);
		
		Контрагент = Неопределено;
		Если ЭлементМассива.Строка.Свойство("Контрагент", Контрагент) Тогда
			ОграниченияПоКонтрагенту = ОграниченияПоКонтрагентам.НайтиСтроки(Новый Структура("Контрагент, Имя", Контрагент, ИмяКнопки));
			Если ОграниченияПоКонтрагенту.Количество() > 0
				И НЕ ОграниченияПоКонтрагенту.Получить(0).Доступность Тогда
				
				ТекстЛогаСобытий = "Документ " + ЭлементМассива.Строка.ПредставлениеДокумента + " пропущен. Пользователю запрещено отправлять документы по контрагенту " + Строка(Контрагент);
				ЗаписьСтруктурыЛога = ЗаполненнаяЗаписьЛогаОбщийМодуль(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Предупреждение"), ИмяСобытия);
				МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
				
				МассивСтрок.Удалить(ИндексСтроки);
			КонецЕсли;
		Иначе
			Возврат;
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры // ИсключитьОтправкуПоЗапрещеннымКонтрагентам()
&НаКлиенте
Процедура ЗавершениеВводаИнформация(Информация, ДополнительныеПараметры) Экспорт
	
	ДанныеСписка 			= ДополнительныеПараметры.ДанныеСписка;
	ИмяСтатуса				= ДополнительныеПараметры.ИмяСтатуса;
	МассивЛогаСобытий 	    = ДополнительныеПараметры.МассивЛогаСобытий;
	ИмяДокумента 			= ДополнительныеПараметры.ИмяДокумента;
	ТипДокумента 			= ДополнительныеПараметры.ТипДокумента;
	НужнаПодпись 			= ДополнительныеПараметры.НужнаПодпись;
	ВыгружаемыеДанные 		= ДополнительныеПараметры.ВыгружаемыеДанные;
	ПозицияТекущейСтроки 	= ДополнительныеПараметры.ПозицияТекущейСтроки;
	ВыделенныеСтроки		= ДополнительныеПараметры.ВыделенныеСтроки;
	
	ТребуютУстановкиПричиныОтклонения = Новый Массив;
	Для Каждого ВыбраннаяСтрока Из ВыгружаемыеДанные Цикл
		Если ПустаяСтрока(ВыбраннаяСтрока.Информация) Тогда
			ВыбраннаяСтрока.Информация = Информация;
			ТребуютУстановкиПричиныОтклонения.Добавить(ВыбраннаяСтрока[ИмяДокумента]);
		КонецЕсли;
	КонецЦикла;
	// Добавляем причину отклонения в записи регистра.
	Если ТребуютУстановкиПричиныОтклонения.Количество() > 0
		И ЗначениеЗаполнено(Информация) Тогда
		ПараметрыПроцедуры = Новый Массив;
        ПараметрыПроцедуры.Добавить(ТребуютУстановкиПричиныОтклонения);
        ПараметрыПроцедуры.Добавить(Информация);
		ВыполнитьПроцедуруИзМодуляОбъекта("ДобавитьПричинуОтклоненияCONDRA", ПараметрыПроцедуры);
		
		// Здесь нужно обновить форму, но так чтобы выделенные строки остались выделенными!!
		ОбновитьДинамическийСписок(ДанныеСписка);
		ВосстановитьТекущуюСтрокуСписка(ПозицияТекущейСтроки, ДанныеСписка.ИмяСписка, ВыгружаемыеДанные);
	КонецЕсли;
	
	ОтправитьДокументыПродолжить(ДанныеСписка, ИмяСтатуса, ТипДокумента, НужнаПодпись, МассивЛогаСобытий);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеВводаТекстаАннулирования(Текст, ДополнительныеПараметры) Экспорт
	
	ДанныеСписка 		    = ДополнительныеПараметры.ДанныеСписка;
	ИмяСтатуса				= ДополнительныеПараметры.ИмяСтатуса;
	МассивЛогаСобытий 	    = ДополнительныеПараметры.МассивЛогаСобытий;
	ТипДокумента 			= ДополнительныеПараметры.ТипДокумента;
	НужнаПодпись 			= ДополнительныеПараметры.НужнаПодпись;
	ТребуютУстановкиТекста 	= ДополнительныеПараметры.ТребуютУстановкиТекста;
	ИмяКолонкиТекста        = ДополнительныеПараметры.ИмяКолонкиТекста;
	
	Для каждого ИндекснаяСтрока Из Элементы[ДанныеСписка.ИмяСписка].ВыделенныеСтроки Цикл
		ВыбраннаяСтрока = Элементы[ДанныеСписка.ИмяСписка].ДанныеСтроки(ИндекснаяСтрока);
		Если ПустаяСтрока(ВыбраннаяСтрока[ИмяКолонкиТекста]) Тогда
			ВыбраннаяСтрока[ИмяКолонкиТекста] = Текст;
		КонецЕсли;   
	КонецЦикла;
	
	// Добавляем причину отклонения в записи регистра.
	Если ЗначениеЗаполнено(Текст) Тогда
		
		ПараметрыАлгоритма = Новый Структура;
		ПараметрыАлгоритма.Вставить("Документы"       , ТребуютУстановкиТекста);
		ПараметрыАлгоритма.Вставить("Текст"           , Текст);
		ПараметрыАлгоритма.Вставить("ИмяКолонкиТекста", ИмяКолонкиТекста);
		ИмяАлгоритма = "ДобавитьТекстАннулирования";
		
		ВыполнитьПроцедуруИзМодуляОбъектаСтруктура(ИмяАлгоритма, ПараметрыАлгоритма, Неопределено);	
	
	КонецЕсли;
	
	ОтправитьДокументыПродолжить(ДанныеСписка, ИмяСтатуса, ТипДокумента, НужнаПодпись, МассивЛогаСобытий);
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьТекущуюСтрокуСписка(ПозицияТекущейСтроки, ИмяСписка, ВыделенныеСтроки)
	      	
	Если ТипЗнч(ВыделенныеСтроки) = Тип("Массив") Тогда
		Элементы[ИмяСписка].ВыделенныеСтроки.Очистить();
		Для Каждого Строка Из ВыделенныеСтроки Цикл
			Если Строка.Свойство("ИдентификаторВыделенныхСтрок") = Истина Тогда
			     Элементы[ИмяСписка].ВыделенныеСтроки.Добавить(Строка.ИдентификаторВыделенныхСтрок);	
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Элементы[ИмяСписка].ВыделенныеСтроки.Количество() = 0 Тогда
		Если ТипЗнч(ПозицияТекущейСтроки) = Тип("Число") Тогда
			Элементы[ИмяСписка].ТекущаяСтрока = ПозицияТекущейСтроки;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Функция позволяет получить имя источника для шаблонов исходящих документов
//
// Параметры:
//  <ИмяШаблона  - Строка - имя шаблона в базе клиента
//  МассивЛогаСобытий  - Строка - данные лога событий для вывода пользователю
//  ТекстЛогаСобытий  - Строка - нужно передать пустую строку и выполнить проверку на ее заполнение после выхода из функции. Если значение
//		будет заполнено - значит возникла ошибка при получении имени источника. Стоит завершить выполнение операции с оповещением
//		пользователя, чтобы не словить баг.
//
// Возвращаемое значение:
//   Строка   - имя колонки в ТЧ, где находится документ источника для исходящего электронного документа
//
&НаСервере
Функция ПолучитьИмяИсточникаДляИсходящихДокументов(ИмяШаблона, МассивЛогаСобытий, ТекстЛогаСобытий = "")

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");	
    Дерево = ОбработкаОбъект.ПолучитьСтруктуруФайлаДанных(ИмяШаблона);
	Если Дерево.Строки.Количество() = 0 Тогда
		ТекстЛогаСобытий = "Запрошенный тип настроек [" + ИмяШаблона + "] не предусмотрен гибкими настройками модуля.
		|Ошибка получения данных дерева конфигурации " + ИмяШаблона;
		Возврат "";
	КонецЕсли;
	Возврат Дерево.Строки.Получить(0).Источник;

КонецФункции // ПолучитьИмяИсточникаДляИсходящихДокументов()

#КонецОбласти

&НаКлиенте
Функция ПолучитьПредставлениеДокумента(ТипДокумента, ВыбраннаяСтрока)
	
	ПредставлениеДокумента = "";
	
	// EDI
	Если ТипДокумента = "ORDRSP"
		ИЛИ ТипДокумента = "DESADV" 
		ИЛИ ТипДокумента = "INVOICE" 
		ИЛИ ТипДокумента = "DESSCC"
		ИЛИ ТипДокумента = "RETINS"
		ИЛИ ТипДокумента = "ORDER"
		ИЛИ ТипДокумента = "ORDERS"
		ИЛИ	ТипДокумента = "RETORD"
		ИЛИ	ТипДокумента = "RECADV"		 
		ИЛИ ТипДокумента = "STATUS" Тогда
		
		Если ВыбраннаяСтрока.Свойство("НомерЗаказа") Тогда
			ПредставлениеДокумента = "по заказу № " + СокрЛП(ВыбраннаяСтрока.НомерЗаказа);	
		КонецЕсли;
		Если ВыбраннаяСтрока.Свойство("ДатаЗаказа") Тогда
			ПредставлениеДокумента = ПредставлениеДокумента + ?(ЗначениеЗаполнено(ПредставлениеДокумента), " ", "по дате заказа ") 
			+ "от " + Формат(ВыбраннаяСтрока.ДатаЗаказа, "ДФ=dd.MM.yy");	
		КонецЕсли;
		
	// ЮЗД 
	ИначеЕсли ТипДокумента = "ЮЗД" 
		ИЛИ Найти(ТипДокумента, "DP_PRANNUL_22") > 0 //Docrobot 1.19.0 MOD-1377 [Добавлен номер квитанции _22] 
		ИЛИ ТипДокумента = "DP_IZVPOL_23"
		ИЛИ ТипДокумента = "DP_UVUTOCH_24"
		ИЛИ ТипДокумента = "DP_REZRUISP" Тогда
		
		Если ВыбраннаяСтрока.Свойство("СЧФ_Номер") Тогда
			ПредставлениеДокумента = "по счет-фактуре № " + СокрЛП(ВыбраннаяСтрока.СЧФ_Номер);	
		КонецЕсли;
		Если ВыбраннаяСтрока.Свойство("СЧФ_Дата") Тогда
			ПредставлениеДокумента = ПредставлениеДокумента + ?(ЗначениеЗаполнено(ПредставлениеДокумента), " ", "по дате счет-фактуры ")
			+ "от " + Формат(ВыбраннаяСтрока.СЧФ_Дата, "ДФ=dd.MM.yy");	
		КонецЕсли;
		
	// ЭТРН 
	ИначеЕсли ТипДокумента = "WHGOV_01_Исходящий" 
		ИЛИ ТипДокумента = "WHGPV_05_Исходящий" 
		ИЛИ ТипДокумента = "WHGOU_04_Исходящий"
		ИЛИ ТипДокумента = "WHGPU_08_Исходящий" Тогда
		
		Если ВыбраннаяСтрока.Свойство("НомерЭТРН") Тогда
			ПредставлениеДокумента = "по ЭТРН № " + СокрЛП(ВыбраннаяСтрока.НомерЭТРН);	
		КонецЕсли;
		Если ВыбраннаяСтрока.Свойство("ДатаЭТРН") Тогда
			ПредставлениеДокумента = ПредставлениеДокумента + ?(ЗначениеЗаполнено(ПредставлениеДокумента), " ", "по дате ЭТРН ") 
			+ "от " + Формат(ВыбраннаяСтрока.ДатаЭТРН, "ДФ=dd.MM.yy");	
		КонецЕсли;

	// CONDRA 
	ИначеЕсли Найти(ТипДокумента, "CONDRA") > 0 Тогда
		
		Если ВыбраннаяСтрока.Свойство("Номер") Тогда
			ПредставлениеДокумента = "по документу № " + СокрЛП(ВыбраннаяСтрока.Номер);	
		КонецЕсли;
		Если ВыбраннаяСтрока.Свойство("Дата") Тогда
			ПредставлениеДокумента = ПредставлениеДокумента + ?(ЗначениеЗаполнено(ПредставлениеДокумента), " ", "по дате документа ") 
			+ "от " + Формат(ВыбраннаяСтрока.Дата, "ДФ=dd.MM.yy");	
		КонецЕсли;

	КонецЕсли;
	
	ПредставлениеДокумента = ТипДокумента + " " + ПредставлениеДокумента;
	ПредставлениеДокумента = СокрЛП(ПредставлениеДокумента);

	Возврат ПредставлениеДокумента;
	
КонецФункции 

