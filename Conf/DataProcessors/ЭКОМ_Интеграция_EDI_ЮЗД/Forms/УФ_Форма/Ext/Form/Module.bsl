&НаСервере
Процедура КомандаОбновитьКоличествоДокументовНаПлатформеНаСервере(ИнфоДатаЗагруженоЗа, ИнфоДокументыНаПлатформе)
    
    МассивЛогаСобытий = Новый Массив;    
    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    Инфо = ОбработкаОбъект.Инфо_СведенияОДокументах(ИнфоДатаЗагруженоЗа, МассивЛогаСобытий);
	Если НЕ Инфо = Неопределено Тогда
		
		ИнфоДокументыНаПлатформе.Очистить();
		Если ТипЗнч(Инфо) = Тип("Структура") И Инфо.Свойство("СписокФайлов") Тогда
			СписокФайлов = Инфо.СписокФайлов;
			ИнфоДокументыНаПлатформе.ЗагрузитьЗначения(СписокФайлов);
			ИнфоДокументыНаПлатформе.СортироватьПоЗначению(НаправлениеСортировки.Возр);
		КонецЕсли;
		
		ИнфоДокументыЗагружено = Инфо.ИнфоОбработано;		
	КонецЕсли;
	
	Если МассивЛогаСобытий.Количество() > 0  Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий)");
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецПроцедуры

