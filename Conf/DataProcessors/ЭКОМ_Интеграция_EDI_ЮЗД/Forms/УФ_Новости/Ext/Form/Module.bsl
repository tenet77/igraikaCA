
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТЗНовости = ЭКОМ_ОбщегоНазначения.ПолучитьНовостиПользователя();
	Новости.Загрузить(ТЗНовости);
	Отказ = Новости.Количество() = 0;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПерелистнутьНовость();
КонецПроцедуры

// Меняет текущую новость на форме
//
// Параметры:
//  Смещение  - Число - значение инкремента или декремента для индекса таблицы Новости
//
&НаКлиенте
Процедура ПерелистнутьНовость(Смещение = 0)
	
	ПерелистнутьНовостьНаСервере(Смещение);
	Элементы.ПолеHTMLДокумента.Документ.Body.InnerHTML = ПолеHTMLДокумента;

КонецПроцедуры // ПерелистнутьНовость()

&НаСервере
Процедура ПерелистнутьНовостьНаСервере(Смещение)
	
	Если 0 <= ИндексСтроки + Смещение
		И ИндексСтроки + Смещение < Новости.Количество() Тогда
		ИндексСтроки = ИндексСтроки + Смещение;
		Новость = Новости.Получить(ИндексСтроки);
		Содержание 	= ?(Прав(НРег(Новость.ИмяФайла), 4) = ".txt", СтрЗаменить(Новость.Содержание, Символы.ПС, "<br>"), Новость.Содержание);
		
		Прочитано			= Новость.Прочитано;
		Элементы.НадписьЗаглавие.Заголовок = Новость.Заглавие; 
		ПолеHTMLДокумента = Содержание;
		Элементы.НадписьСчетчик.Заголовок	= Формат(ИндексСтроки + 1, "ЧГ=")
			+ " из " + Формат(Новости.Количество(), "ЧГ=");   
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ДругаяНовостьПриНажатии(Команда)
	ПерелистнутьНовость(?(Команда.Имя = "СледующаяНовость", 1, -1));
КонецПроцедуры

&НаСервере
Процедура ПрочитаноПриИзмененииНаСервере()
	
	Новость = Новости.Получить(ИндексСтроки);
	Новость.Прочитано 	= Прочитано;  
	
	Отбор 		= Новый Структура("ДатаФайла, ИмяФайла, Пользователь",
		Новость.ДатаФайла,
		Новость.ИмяФайла,
		ЭКОМ_ОбщегоНазначения.ПолучитьЭкомПользователяПоПользователю(ЭКОМ_ОбщегоНазначения.НайтиТекущегоПользователя()));
	Значения 	= Новый Структура("Прочитано", Новость.Прочитано);
	ЭКОМ_ОбщегоНазначения.ИзменитьНовость(Отбор, Значения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочитаноПриИзменении(Элемент)
	ПрочитаноПриИзмененииНаСервере();
КонецПроцедуры 
