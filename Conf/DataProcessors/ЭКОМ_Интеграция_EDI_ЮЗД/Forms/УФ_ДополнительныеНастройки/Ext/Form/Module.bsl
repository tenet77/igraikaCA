&НаКлиенте
Процедура СохранитьИзмененныеНастройки(ВызватьДиалог = Истина)
	
	Если ЭтаФорма.СписокИзмененныхНастроек.Количество() = 0 Тогда
		ЭКОМ_ОбщегоНазначенияКлиент.СообщитьПользователю("Изменения настроек отсутствуют!");
		ЭтаФорма.Модифицированность = Ложь;
	Иначе
		ОписаниеИзменений = "";
		СоответствиеЗначений = ЭтаФорма.СписокИзмененныхНастроек.Получить(0).Значение;
		Для каждого Стр Из СоответствиеЗначений Цикл
			ОписаниеИзменений = ОписаниеИзменений + ?(ЗначениеЗаполнено(ОписаниеИзменений), Символы.ПС, "") + Стр.Ключ;	 
		КонецЦикла;
		
		 Если ВызватьДиалог Тогда
			 ВызватьДиалогПодтвержденияЗаписи(СоответствиеЗначений, ОписаниеИзменений);
		 Иначе
			 ВызватьДиалогПодтвержденияЗаписиЗавершение(Истина, Новый Структура("ЗакрытьФорму, ИзмененныеНастройки", Ложь, СоответствиеЗначений));
		 КонецЕсли;
		 
		 Состояние("Настройки успешно записаны.", , , БиблиотекаКартинок.Записать);
		 ЭтаФорма.Модифицированность = Ложь; 		
	 КонецЕсли;  	 
			
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокДляИзменения(Значение, Имя)
	
	Если СписокИзмененныхНастроек.Количество() = 0 Тогда
	    СоответствиеЗначений = Новый Соответствие;
	Иначе	
	    СоответствиеЗначений = СписокИзмененныхНастроек.Получить(0).Значение;
	КонецЕсли;
    
	СоответствиеЗначений.Вставить(Имя, Значение);
	СписокИзмененныхНастроек.Очистить();
	СписокИзмененныхНастроек.Добавить(СоответствиеЗначений);
	
	ЭтаФорма.Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЭтаФорма.Модифицированность
		И ЗавершениеРаботы Тогда 
		              
		Если ТипЗнч(ВладелецФормы) = Тип("ФормаКлиентскогоПриложения") И ВладелецФормы.Открыта() Тогда
			Возврат;
		КонецЕсли;
		
		ТекстПредупреждения = "Docrobot: перед закрытием необходимо сохранить настройки!";
	    Отказ = Истина;
		Возврат;     
	КонецЕсли;
	
	Если НЕ ЗавершениеРаботы  Тогда
		МассивЛогаСобытий = Новый Массив;
	    Если ЭтаФорма.Модифицированность Тогда
			Отказ = Истина;
			СохранитьИзмененныеНастройки(Истина);
	    КонецЕсли;
		
		Если МассивЛогаСобытий.Количество() > 0  Тогда
			Попытка
				Выполнить("ЭКОМ_ОбщегоНазначения.ЗаписатьЛогСобытийвРегистрЛогирование(МассивЛогаСобытий);");
			Исключение
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий)");
				Сообщение.Сообщить();
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьНастройки(ЛогСобытий = "")
	
	СоответствиеРеквизитовФормы = Новый Соответствие;
	РеквизитыФормы = ЭтаФорма.ПолучитьРеквизиты();
	Для каждого Стр Из РеквизитыФормы Цикл
	    СоответствиеРеквизитовФормы.Вставить(Стр.Имя, Стр);			
	КонецЦикла;
	
	НастройкиЭКОМ = ПолучитьСписокНастроекНаСервере();
	Для каждого Настройка Из НастройкиЭКОМ Цикл
		СоответствиеРеквизитаФормы = СоответствиеРеквизитовФормы.Получить(Настройка.Ключ);
		Если НЕ СоответствиеРеквизитаФормы = Неопределено Тогда
			УстановитьЗначениеРеквизитаФормы(Настройка.Ключ, Настройка.Значение); 
		Иначе
			Если Прав(Настройка.Ключ, 9) = "Служебный" Тогда
				ИмяРеквизитаФормы = Лев(Настройка.Ключ, СтрДлина(Настройка.Ключ)-9);
				СоответствиеРеквизитаФормы = СоответствиеРеквизитовФормы.Получить(ИмяРеквизитаФормы);
				Если НЕ СоответствиеРеквизитаФормы = Неопределено Тогда
					УстановитьЗначениеРеквизитаФормы(ИмяРеквизитаФормы, Настройка.Значение); 
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;   	
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокНастроекНаСервере(МассивНастроек = Неопределено)
	
	ОбъектЭтаОбработка = РеквизитФормыВЗначение("Объект");
    Результат          = ОбъектЭтаОбработка.ПолучитьСписокНастроек(МассивНастроек);

    Возврат Результат;
	
КонецФункции  

&НаСервере
Процедура УстановитьЗначениеРеквизитаФормы(ИмяРеквизита, Знач Значение)
		
	ТипРеквизита = ТипЗнч(ЭтаФорма[ИмяРеквизита]);	
	Если Значение = Неопределено Тогда								
		Если ТипРеквизита = Тип("Булево") Тогда
			Значение = Ложь;			 			 
		ИначеЕсли ТипРеквизита = Тип("Строка") Тогда
			Значение = "";
		ИначеЕсли ТипРеквизита = Тип("Число") Тогда
			Значение = 0;	
		ИначеЕсли ТипРеквизита = Тип("ДанныеФормыКоллекция") Тогда
			Попытка
				Значение = ЭтаФорма[ИмяРеквизита].Выгрузить(); // Попытка получить пустое значение из реквизита формы
			Исключение КонецПопытки;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипРеквизита = Тип("ДанныеФормыКоллекция") 
		Или ТипРеквизита = Тип("ДанныеФормыСтруктура")
		Или ТипРеквизита = Тип("ДанныеФормыСтруктураСКоллекцией") Тогда
		
		Если ТипЗнч(Значение) = Тип("Строка") Тогда
			 Возврат;
		КонецЕсли;
		
		Попытка
			ЗначениеВРеквизитФормы(Значение, ИмяРеквизита);
							
		Исключение
			ПриемникРезультат = РеквизитФормыВЗначение(ИмяРеквизита, Тип("ДеревоЗначений"));
            СкопироватьСовпадающиеКолонкиВРезультат(Значение, ПриемникРезультат);
            Если ТипЗнч(Элементы[ИмяРеквизита]) = Тип("ТаблицаФормы") Тогда
                Попытка
                    ЗначениеВРеквизитФормы(ПриемникРезультат, ИмяРеквизита);
                Исключение
                    Если ТипЗнч(ИмяРеквизита) = Тип("ТаблицаЗначений") Тогда
                        ЭтаФорма[ИмяРеквизита].Загрузить(ПриемникРезультат);
                    КонецЕсли;
                КонецПопытки;
            Иначе
                ЗначениеВРеквизитФормы(ПриемникРезультат, ИмяРеквизита);
            КонецЕсли;
		КонецПопытки;
		
	ИначеЕсли ТипРеквизита = Тип("ДанныеФормыДерево") Тогда
		
		Попытка			
			// Очищаем
			ЛокальныйОбъект = ДанныеФормыВЗначение(ЭтаФорма[ИмяРеквизита], Тип("ДеревоЗначений"));
			ЛокальныйОбъект.Строки.Очистить();
			ЗначениеВРеквизитФормы(ЛокальныйОбъект, ИмяРеквизита);
			
			// Заполняем новыми данными
			ЗначениеВРеквизитФормы(Значение, ИмяРеквизита);
		Исключение
			ПриемникРезультат = РеквизитФормыВЗначение(ИмяРеквизита, Тип("ДеревоЗначений"));
            СкопироватьСовпадающиеКолонкиВРезультат(Значение, ПриемникРезультат);
            Если ТипЗнч(Элементы[ИмяРеквизита]) = Тип("ТаблицаФормы") Тогда
                Попытка
                    ЗначениеВРеквизитФормы(ПриемникРезультат, ИмяРеквизита);
                Исключение
                    Если ТипЗнч(ИмяРеквизита) = Тип("ТаблицаЗначений") Тогда
                        ЭтаФорма[ИмяРеквизита].Загрузить(ПриемникРезультат);
                    КонецЕсли;
                КонецПопытки;
            Иначе
                ЗначениеВРеквизитФормы(ПриемникРезультат, ИмяРеквизита);
            КонецЕсли;
		КонецПопытки;	
		
	Иначе
		ЭтаФорма[ИмяРеквизита] = Значение; 
	КонецЕсли;    
КонецПроцедуры

&НаСервере
Процедура СкопироватьСовпадающиеКолонкиВРезультат(Источник, Приемник) Экспорт
	
	Если НЕ (ТипЗнч(Источник) = Тип("ДеревоЗначений") 
		И ТипЗнч(Приемник) = Тип("ДеревоЗначений")) Тогда
        Возврат;	
    КонецЕсли;
    
    ВсеКолонкиИсточника = Источник.Колонки;
    ВсеКолонкиПриемника = Приемник.Колонки;
    
    КолонкиДляКопирования = Новый Массив;
    Для каждого КолонкаИсточник Из ВсеКолонкиИсточника Цикл
        ИмяКолонки = КолонкаИсточник.Имя;
        ТипКолонки = КолонкаИсточник.ТипЗначения;
        
        ТакаяЖеКолонкаПриемник = ВсеКолонкиПриемника.Найти(ИмяКолонки);
        
        Если ТакаяЖеКолонкаПриемник <> Неопределено И ТипЗнч(КолонкаИсточник.ТипЗначения) = ТипЗнч(ТакаяЖеКолонкаПриемник.ТипЗначения) Тогда
        	КолонкиДляКопирования.Добавить(ИмяКолонки);
        КонецЕсли;
    КонецЦикла;
    Если КолонкиДляКопирования.Количество() = 0 Тогда
    	Источник = Приемник.Скопировать();
        Источник.Строки.Очистить();
    Иначе
        ВыгрузитьСтрокиЭлементаДереваЗначений(Источник, Приемник, КолонкиДляКопирования);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВыгрузитьСтрокиЭлементаДереваЗначений(Источник, Приемник, ИменаКолонокДляКопирования) Экспорт
    ВложенныеСтроки = Источник.Строки;
    
    Если ТипЗнч(Приемник) = Тип("ДеревоЗначений") Тогда
        Для каждого ИмяКолонки Из ИменаКолонокДляКопирования Цикл
            Если Приемник.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
                Приемник.Колонки.Добавить(ИмяКолонки, Источник.Колонки[ИмяКолонки].ТипЗначения);
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    
    Для каждого СтрокаИсточник Из ВложенныеСтроки Цикл
        СтрокаПриемник = Приемник.Строки.Добавить();
        Для каждого ИмяКолонки Из ИменаКолонокДляКопирования Цикл
            СтрокаПриемник[ИмяКолонки] = СтрокаИсточник[ИмяКолонки];
        КонецЦикла;
        //ЗаполнитьЗначенияСвойств(СтрокаПриемник, СтрокаИсточник, ИменаКолонокДляКопирования);
        ВыгрузитьСтрокиЭлементаДереваЗначений(СтрокаИсточник, СтрокаПриемник, ИменаКолонокДляКопирования);
    КонецЦикла;
    
КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)
	СохранитьИзмененныеНастройки(Ложь); 
КонецПроцедуры

&НаКлиенте
Процедура ВызватьДиалогПодтвержденияЗаписи(ИзмененныеНастройки, ОписаниеИзменений, ЗакрытьФорму = Ложь, ИзмененныеНастройкиТаблицей = Неопределено)
    
    ВозвращаемыеПараметры = Новый Структура("ЗакрытьФорму, ИзмененныеНастройки,", ЗакрытьФорму, ИзмененныеНастройки) ;
    ОповещениеОЗакрытии   = Новый ОписаниеОповещения("ВызватьДиалогПодтвержденияЗаписиЗавершение", ЭтаФорма, ВозвращаемыеПараметры);
    ПараметрыВызова       = Новый Структура("ОписаниеИзмененийТекст, ИзмененныеНастройки", ОписаниеИзменений, ИзмененныеНастройкиТаблицей);
    ФормаСохранения       = ОткрытьФорму(ЭтаФорма.СлужебныйПолноеИмяФормы + ".Форма.УФ_СохранениеНастроек", ПараметрыВызова, ЭтаФорма,,,, ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
    
КонецПроцедуры

&НаКлиенте
Процедура ВызватьДиалогПодтвержденияЗаписиЗавершение(РезультатЗакрытия, Параметры = Ложь) Экспорт
	
	Если РезультатЗакрытия = Истина Тогда  		
        ЗаписатьНаСервере(Параметры.ИзмененныеНастройки);		
    Иначе
        Состояние("Вы отказались от сохранения настроек.", , , БиблиотекаКартинок.Записать);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьНаСервере(ИзмененныеНастройки, СохранитьНастройки = Истина)
	
	Если НЕ СохранитьНастройки Тогда
	     Возврат;
	КонецЕсли;
		
	ОбъектЭтаОбработка = РеквизитФормыВЗначение("Объект");
	
	Для каждого Стр Из ИзмененныеНастройки Цикл	
		Если Лев(Стр.Ключ, 1) = "_" Тогда
		   ОбъектЭтаОбработка.Настройка_Параметр_Записать(Стр.Ключ, ДанныеФормыВЗначение(ЭтаФорма[Стр.Значение], Тип("ДеревоЗначений")));
		Иначе	
		   ОбъектЭтаОбработка.Настройка_Параметр_Записать(Стр.Ключ, Стр.Значение);
		КонецЕсли;
					 
	КонецЦикла;
	
	ЭтаФорма.СписокИзмененныхНастроек.Очистить();
	ЭтаФорма.Модифицированность = Ложь;
    	
КонецПроцедуры

&НаКлиенте
Процедура ПерезаписыватьЗаказПриИзменении(Элемент)
	ЗаполнитьСписокДляИзменения(ЭтаФорма[Элемент.Имя], Элемент.Имя);
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ПрочитатьНастройки();
	
	ЭКОМ_ОбменПоставщик = ЭКОМ_ОбщегоНазначения.Настройка_Параметр_Прочитать("ЭКОМ_ОбменПоставщик", Ложь);
	Элементы.ГруппаПоставщик.Доступность = ЭКОМ_ОбменПоставщик;
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	СохранитьИзмененныеНастройки(Ложь);
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ЭКОМ_ОбрабатыватьПовторныеORDERПриИзменении(Элемент)
	ЗаполнитьСписокДляИзменения(ЭтаФорма[Элемент.Имя], Элемент.Имя);
КонецПроцедуры


