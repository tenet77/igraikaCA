////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.Параметры.Свойство("УстановитьПароль", УстановитьПароль);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если УстановитьПароль Тогда
		Элементы.ГруппаУстановитьПароль.Видимость = Истина;
		Элементы.ГруппаСтраницы.ТекущаяСтраница   = Элементы.ГруппаУстановитьПароль;
		Элементы.ГруппаВводПароля.Видимость       = Ложь;
	Иначе
		Элементы.ГруппаУстановитьПароль.Видимость = Ложь;
		Элементы.ГруппаСтраницы.ТекущаяСтраница   = Элементы.ГруппаВводПароля;
		Элементы.ГруппаВводПароля.Видимость       = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Структура = Новый Структура;
  
	Если УстановитьПароль Тогда
		Структура.Вставить("ПарольИзБазы", "0");
		Структура.Вставить("Пароль"      , "0");
		Структура.Вставить("ИспользоватьПароль" , Ложь);
	Иначе
		Структура.Вставить("ПарольИзБазы"      , "0");
		Структура.Вставить("Пароль"            , "1");
		Структура.Вставить("ИспользоватьПароль", Истина);				
	КонецЕсли;
	
	ЭтаФорма.Закрыть(Структура);
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура КомандаПодтвердить(Команда)
	
	знПарольИзБазы = Настройка_Параметр_ПрочитатьНаСервере("СлужебныйПарольДляНастроек", "", "Служебный");
	
	Структура = Новый Структура;
	Структура.Вставить("ИспользоватьПароль", Истина);
	Структура.Вставить("ПарольИзБазы"      , знПарольИзБазы);
    Структура.Вставить("Пароль"            , ЭтаФорма.Пароль);
	
	ЭтаФорма.Закрыть(Структура);	
			
КонецПроцедуры

&НаКлиенте
Процедура КомандаОтмена(Команда)
	
	Структура = Новый Структура;
	Структура.Вставить("ИспользоватьПароль", Истина);
	Структура.Вставить("ПарольИзБазы"   , "0");
    Структура.Вставить("Пароль"         , "1");
	
	ЭтаФорма.Закрыть(Структура);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаУстановитьПароль(Команда)
	
	Структура = Новый Структура;
    Структура.Вставить("ИспользоватьПароль", Истина);
	Структура.Вставить("ПарольИзБазы", "0");
    Структура.Вставить("Пароль"      , "0");

	Если ЭтаФорма.Пароль = ЭтаФорма.ПарольПовторить Тогда
		Настройка_Параметр_ЗаписатьНаСервере("СлужебныйПарольДляНастроек", ЭтаФорма.Пароль, "Служебный");	
		ЭтаФорма.Закрыть(Структура);
	Иначе
		Состояние("Пароль не совпадает! Попробуйте еще раз!");
	КонецЕсли;
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервере
Функция Настройка_Параметр_ЗаписатьНаСервере(Параметр, Значение, Измерение = Неопределено)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.Настройка_Параметр_Записать(Параметр, Значение, Измерение);
	
КонецФункции

&НаСервере
Функция Настройка_Параметр_ПрочитатьНаСервере(Параметр, Значение, Измерение = Неопределено)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	знПарольИзБазы = ОбработкаОбъект.Настройка_Параметр_Прочитать(Параметр, Значение, Измерение);
	
	Возврат знПарольИзБазы;
	
КонецФункции
