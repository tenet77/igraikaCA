&НаКлиенте
Перем ЗНАЧЕНИЕ_ЗакрытьФорму;

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Заголовок = "Настройки служебные";
	ЭтаФорма.Параметры.Свойство("Редактирование", Редактирование);
	ЭтаФорма.Параметры.Свойство("Записать"      , Записать);
	ЭтаФорма.Параметры.Свойство("Заголовок"     , Заголовок);
	
	ЭтаФорма.Заголовок = Заголовок;	
	
	ЭтаФорма.ДоступныеЗначения = Новый СписокЗначений;
	МассивСтрок = Новый Массив;
	ЭтаФорма.Параметры.Свойство("ТабличноеПоле" , МассивСтрок);
	Если НЕ МассивСтрок = Неопределено Тогда
		Для каждого ЭлМассива Из МассивСтрок Цикл
			НовСтр = ЭтаФорма.ТабличноеПоле.Добавить();
			НовСтр.Реквизит = ЭлМассива.Реквизит;
			НовСтр.Формула  = ЭлМассива.Формула;
			Если ЭлМассива.Свойство("Обязательный") Тогда
				НовСтр.Обязательный  = ЭлМассива.Обязательный;
				ЕстьПолеОбязательный = Истина;
			КонецЕсли;
			НовСтр.ДоступныеЗначения = ЭлМассива.ДоступныеЗначения;
			ЭтаФорма.ДоступныеЗначения = ЭлМассива.ДоступныеЗначения;
		КонецЦикла;
	КонецЕсли;
	
	МассивСтрок = Новый Массив;
	ЭтаФорма.Параметры.Свойство("ТабличноеПолеДляКнопки" , МассивСтрок);
	Если НЕ МассивСтрок = Неопределено Тогда
		Для каждого ЭлМассива Из МассивСтрок Цикл
			НовСтр = ЭтаФорма.ТабличноеПоле.Добавить();
			НовСтр.Реквизит      = ЭлМассива.Реквизит;
			НовСтр.Формула       = ЭлМассива.Формула;
			НовСтр.Обязательный  = ЭлМассива.Использовать;
            ЕстьПолеОбязательный = Истина;
			Элементы.ТабличноеПоле.ПодчиненныеЭлементы.ТабличноеПолеФормула.Заголовок = "Имя кнопки";
			Элементы.ТабличноеПоле.ПодчиненныеЭлементы.ТабличноеПолеОбязательный.Заголовок = "Использовать";
		КонецЦикла;
	КонецЕсли;

	СтрокиВыполнить = Новый Массив;
	Если ЭтаФорма.Параметры.Свойство("Выполнить", СтрокиВыполнить) Тогда
		Для Каждого СтрокаВыполнить Из СтрокиВыполнить Цикл
			Выполнить(СтрокаВыполнить);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ЗНАЧЕНИЕ_ЗакрытьФорму = Ложь;
	Элементы.ТабличноеПолеКоманднаяПанель.Доступность = Редактирование;
	Элементы.ТабличноеПоле.ПодчиненныеЭлементы.ТабличноеПолеРеквизит.ТолькоПросмотр = НЕ Редактирование;
	Элементы.ТабличноеПолеОбязательный.Видимость = ЕстьПолеОбязательный;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если НЕ Записать И Модифицированность И ЗНАЧЕНИЕ_ЗакрытьФорму = Ложь Тогда
		Отказ = Истина;
		ТекстВопроса = НСтр("ru = 'Все изменения будут утеряны. Продолжить?'; en = 'Do you want to continue?'");
		Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопрос", ЭтаФорма); // Прописываем название процедуры-обработчика.
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет,	
		0,                    // задержка (секунды). необязательно	
		КодВозвратаДиалога.Да,// задает кнопку по умолчанию. необязательно	
		"Закрытие формы.");   // устанавливаем заголовок. необязательно
	КонецЕсли;

КонецПроцедуры

#КонецОбласти


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ 

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ТабличноеПолеПриАктивизацииЯчейки(Элемент)
	
	Если Элемент.ТекущийЭлемент.Вид = ВидПоляФормы.ПолеВвода Тогда
		
		Элемент.ТекущийЭлемент.СписокВыбора.Очистить();
		
		Если Элемент.ТекущийЭлемент.Имя = "ТабличноеПолеФормула" Тогда
			Если НЕ ЭтаФорма.ДоступныеЗначения.Количество() = 0 Тогда
			    Элемент.ТекущийЭлемент.КнопкаСпискаВыбора 	= Истина;
				Элемент.ТекущийЭлемент.РежимВыбораИзСписка 	= Истина;
				Элемент.ТекущийЭлемент.КнопкаВыбора			= Ложь;
				Элемент.ТекущийЭлемент.КнопкаОткрытия 		= Ложь;
				Элемент.ТекущийЭлемент.КнопкаОчистки 		= Истина;
				Для Каждого Эл Из ЭтаФорма.ДоступныеЗначения Цикл
					Элемент.ТекущийЭлемент.СписокВыбора.Добавить(Эл.Значение);
				КонецЦикла;
				
			ИначеЕсли НЕ Элемент.ТекущиеДанные = Неопределено
				И Элемент.ТекущиеДанные.ДоступныеЗначения.Количество() = 0 Тогда
				ЭтоСписокЗначений = Элемент.ТекущиеДанные.Реквизит = "ФорматУПД";
				Элемент.ТекущийЭлемент.КнопкаСпискаВыбора 	= ЭтоСписокЗначений;
				Элемент.ТекущийЭлемент.РежимВыбораИзСписка 	= ЭтоСписокЗначений;
				Элемент.ТекущийЭлемент.КнопкаВыбора			= Ложь;
				Элемент.ТекущийЭлемент.КнопкаОткрытия 		= Ложь;
				Элемент.ТекущийЭлемент.КнопкаОчистки 		= НЕ ЭтоСписокЗначений;
				
				Если ЭтоСписокЗначений И Элемент.ТекущийЭлемент.СписокВыбора.Количество() = 0 Тогда
					Элемент.ТекущийЭлемент.СписокВыбора.ЗагрузитьЗначения(ПолучитьФорматыУПДНаСервере(Истина));
				КонецЕсли;
				
			Иначе
				
				Если НЕ Элемент.ТекущиеДанные = Неопределено Тогда
					Элемент.ТекущийЭлемент.КнопкаСпискаВыбора 	= Истина;
					Элемент.ТекущийЭлемент.РежимВыбораИзСписка 	= Истина;
					Элемент.ТекущийЭлемент.КнопкаВыбора			= Ложь;
					Элемент.ТекущийЭлемент.КнопкаОткрытия 		= Ложь;
					Элемент.ТекущийЭлемент.КнопкаОчистки 		= Истина;
					Для Каждого Эл Из Элемент.ТекущиеДанные.ДоступныеЗначения Цикл
						Элемент.ТекущийЭлемент.СписокВыбора.Добавить(Эл.Значение);
					КонецЦикла; 
				КонецЕсли;
								
			КонецЕсли;	
		КонецЕсли;		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабличноеПолеПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	// Определяем тип поля Формула новой строки.
	Отказ = Истина;
	НоваяСтрока = ТабличноеПоле.Добавить();
	НоваяСтрока.Формула = "";
	
КонецПроцедуры

&НаКлиенте
Процедура ТабличноеПолеПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	Если НЕ НеПроверятьКорректностьИмениКлюча Тогда
		// Ключ должен быть уникальным.
		Отказ = ТабличноеПоле.НайтиСтроки(Новый Структура("Реквизит", Элемент.ТекущиеДанные.Реквизит)).Количество() > 1 ;
		
		Значение = "";
		Если НЕ Отказ Тогда
			// Проверим корректность имени ключа.
			Значение = НРег(Элемент.ТекущиеДанные.Реквизит);
			Алфавит = "абвгдеёжзийклмнопрстуфхцчшщъыьэюяabcdefghijklmnopqrstuvwxyz_";
			Цифры = "0123456789";
			
			Для Позиция = 1 По СтрДлина(Значение) Цикл
				
				Символ = Сред(Значение, Позиция, 1);
				
				Если Найти(?(Позиция = 1, Алфавит, Алфавит + Цифры), Символ) = 0  Тогда
					Если Не(Символ = "-" И Значение = "прайс-лист") Тогда
						Отказ = Истина;
					КонецЕсли;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если Отказ 
			И НЕ Значение = "прайс-лист" Тогда
			Элемент.ТекущиеДанные.Реквизит = "";
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабличноеПолеФормулаПриИзменении(Элемент)	
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабличноеПолеФормулаОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Элементы.ТабличноеПоле.ТекущиеДанные.Формула = "";
	
КонецПроцедуры

&НаКлиенте
Процедура ТабличноеПолеФормулаОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка 	= Ложь;
	Значение = СтрЗаменить(Элемент.ТекстРедактирования, "¶", Символы.ПС);
	
	ИмяОткрываемойФормы = ПолучитьПолноеИмяФормы("УФ_ФормаКонсольЗапросов");
		
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ОбработкаЗакрытия", ЭтаФорма, "СтруктураФайлаXMLИсходящие");
	
	ПараметрыФормы = Новый Структура;
    ПараметрыФормы.Вставить("Заголовок"     , "Введите алгоритм для заполнения поля (тега) настройки");
	ПараметрыФормы.Вставить("Документы"     , Неопределено);
	ПараметрыФормы.Вставить("ТекстНачальный", Значение);
	
	ОткрытьФорму(ИмяОткрываемойФормы, ПараметрыФормы,,,,,ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
		
КонецПроцедуры

#КонецОбласти


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Записать(Команда)
	
	Записать = Истина;
	
	Структура = Новый Структура;
	Структура.Вставить("Редактирование", ЭтаФорма.Редактирование);
	Структура.Вставить("Тип", ?(Элементы.ТабличноеПолеОбязательный.Видимость, "СписокЗначений", "Структура"));
	Структура.Вставить("ТабличноеПоле", ЭтаФорма.ТабличноеПоле);
	Закрыть(Структура);
	
КонецПроцедуры

#КонецОбласти


////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

#Область СлужебныеПроцедурыИФункции

// Функция возвращает доступные форматы УПД
//
// Возвращаемое значение:
//   СписокЗначений   - коллекция форматов УПД контрагентов
&НаСервере
Функция ПолучитьФорматыУПДНаСервере(НуженМассив)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	СписокУПД = ОбработкаОбъект.ПолучитьФорматыУПД(НуженМассив);
	
	Возврат СписокУПД;	
	
КонецФункции

&НаКлиенте 
Функция ПолучитьПолноеИмяФормы(ИмяФормы)
	СимволТочка  = ".";
	ПозицияТочки = СтрДлина(ЭтаФорма.ИмяФормы);
	Пока Сред(ЭтаФорма.ИмяФормы, ПозицияТочки, 1) <> СимволТочка 
		Цикл ПозицияТочки = ПозицияТочки - 1; 
	КонецЦикла;
	
	Возврат Лев(ЭтаФорма.ИмяФормы, ПозицияТочки) + ИмяФормы;
КонецФункции

&НаКлиенте
Процедура ОбработкаЗакрытия(Результат, ИмяТабличнойЧасти) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Модифицированность = ?(Результат.Изменен, Истина, Модифицированность);
	    Элементы.ТабличноеПоле.ТекущиеДанные.Формула = Результат.Текст;
	КонецЕсли;

КонецПроцедуры 

&НаКлиенте
Процедура ПослеОтветаНаВопрос(Результат, Параметры) Экспорт 
	               
	Если Результат = КодВозвратаДиалога.Да Тогда
		   ЗНАЧЕНИЕ_ЗакрытьФорму = Истина;
           Закрыть();	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
