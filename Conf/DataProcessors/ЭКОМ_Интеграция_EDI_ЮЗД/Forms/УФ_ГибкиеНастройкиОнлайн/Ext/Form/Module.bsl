&НаКлиенте
Процедура ОчисткаТабличногоПоля(ТипФильтра)
	
	КопияСписокПараметровОтбора = СписокПараметровОтбора.Скопировать();
	Для каждого Стр Из КопияСписокПараметровОтбора Цикл
	    Если Стр.Представление = ТипФильтра Тогда
			ЭлСтр = СписокПараметровОтбора.НайтиПоЗначению(Стр.Значение);
			СписокПараметровОтбора.Удалить(ЭлСтр);
  		КонецЕсли;			
	КонецЦикла;		
	Фильтр();
	
КонецПроцедуры

&НаКлиенте
Функция ПрочитатьТекстЗапросаПодписки(ПутьКФайлу) Экспорт
	
	Текст = Неопределено;
	
	ДанныеПоФайлу  = СкачатьГибкиеНастройкиНаGITНаСервере(ПутьКФайлу);	
		
	ВременныйКаталог = КаталогВременныхФайлов() + "TempECOM" + ПолучитьРазделительПути();
	ПолноеИмяФайлаXML = ВременныйКаталог + ДанныеПоФайлу.ИмяФайла;
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(ДанныеПоФайлу.НаКлиенте);
	ДвоичныеДанные.Записать(ПолноеИмяФайлаXML);
	
	Файл = Новый Файл(ПолноеИмяФайлаXML);
	Если Файл.Существует() Тогда
		Если НРег(Файл.Расширение) = ".txt" Тогда
			ЧтениеТекста =  Новый ЧтениеТекста(ПолноеИмяФайлаXML, КодировкаТекста.UTF8);
			Текст = ЧтениеТекста.Прочитать();
			ЧтениеТекста.Закрыть();
		Иначе
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Формат <" + НРег(Файл.Расширение) + "> не поддерживается!";
			Сообщение.Сообщить(); 
				
		КонецЕсли;
		УдалитьФайлы(ПолноеИмяФайлаXML);
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

