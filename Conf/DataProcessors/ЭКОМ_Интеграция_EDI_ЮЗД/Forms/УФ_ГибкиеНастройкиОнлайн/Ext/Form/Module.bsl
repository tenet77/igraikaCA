&НаСервереБезКонтекста
Функция ПолучитьПараметрВетвьРепозитория(ВетвьРепозитория)
	ДоступенВыборВетви = ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере("ЭКОМ_ВыборВетвиРепозитория", Ложь);
	ПараметрВетвь = "";
	Если ДоступенВыборВетви Тогда
		Если ВетвьРепозитория = "" Тогда
			ЭКОМ_ОбщегоНазначения.СообщитьПользователю("Не выбрана ветвь репозитория github");
			ПараметрВетвь = Неопределено;
		КонецЕсли;     		
		ПараметрВетвь = "?ref=" + ВетвьРепозитория;
	КонецЕсли;
	
	Возврат ПараметрВетвь;
КонецФункции

