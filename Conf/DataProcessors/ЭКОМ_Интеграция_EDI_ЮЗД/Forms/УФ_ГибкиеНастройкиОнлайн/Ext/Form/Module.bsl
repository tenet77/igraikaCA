&НаКлиенте
Процедура СкачатьНастройкуНаДиск(ПутьКФайлу, ТипРасширения)
	
	ДанныеПоФайлу  = СкачатьГибкиеНастройкиНаGITНаСервере(ПутьКФайлу);
	СохранениеФайла(ДанныеПоФайлу.НаКлиенте, ДанныеПоФайлу.ИмяФайла, ТипРасширения);
		
КонецПроцедуры

&НаСервере
Функция СкачатьГибкиеНастройкиНаGITНаСервере(ПутьКФайлу)
	ПараметрВетвь = ПолучитьПараметрВетвьРепозитория(ВетвьРепозитория);
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");	
	ДанныеПоФайлу = ОбработкаОбъект.СкачатьГибкиеНастройкиНаGIT(ПутьКФайлу + ПараметрВетвь);
	
	Возврат ДанныеПоФайлу;
	
КонецФункции

&НаСервере
Функция ПолучитьИнформациюОбИзмененныхШаблонах(ПутьКФайлу)
	МассивИзмененных = Новый Массив; 
	ПараметрВетвь    = ПолучитьПараметрВетвьРепозитория(ВетвьРепозитория);
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");	
	ДанныеПоФайлу = ОбработкаОбъект.СкачатьГибкиеНастройкиНаGIT(ПутьКФайлу + ПараметрВетвь);
	
	ЧтениеТекста = Новый ЧтениеТекста(ДанныеПоФайлу.НаСервере, КодировкаТекста.UTF8);
	Строка = ЧтениеТекста.ПрочитатьСтроку();
	Пока Строка <> Неопределено Цикл
		МассивИзмененных.Добавить(Строка);		
		Строка = ЧтениеТекста.ПрочитатьСтроку();
	КонецЦикла;
	
	Возврат МассивИзмененных;
КонецФункции

&НаСервере
Функция СоответствиеПредставленийГибкихНастроек(ПутьКФайлу)
	Результат = Новый Соответствие; 
	ПараметрВетвь    = ПолучитьПараметрВетвьРепозитория(ВетвьРепозитория);
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");	
	ДанныеПоФайлу = ОбработкаОбъект.СкачатьГибкиеНастройкиНаGIT(ПутьКФайлу + ПараметрВетвь);
	
	ЧтениеТекста = Новый ЧтениеТекста(ДанныеПоФайлу.НаСервере, КодировкаТекста.UTF8);
	Строка = ЧтениеТекста.ПрочитатьСтроку();
	Пока Строка <> Неопределено Цикл
		МассивСтрок = ЭКОМ_ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(Строка, "|", Ложь);
		Если МассивСтрок.Количество() > 1  Тогда
			Результат.Вставить(МассивСтрок[0], МассивСтрок);
		КонецЕсли;
		Строка = ЧтениеТекста.ПрочитатьСтроку();
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура СохранениеФайла(АдресВоВременномХранилище, ИмяСохранения, ТипРасширения)
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресВоВременномХранилище);
	// создаем на клиенте текстовый файл
	ИмяВременногоФайлаXML = ПолучитьИмяВременногоФайла(ТипРасширения);
	
    Если ДвоичныеДанные = Неопределено Тогда
        ПоказатьПредупреждение(Новый ОписаниеОповещения, "Не удалось получить данные настроек из временного хранилища", , "Сохранение в файл");
        Возврат;
	КонецЕсли;
	
	Если ТипРасширения = ".xml" Тогда
	     Фильтр = ИмяСохранения + "(*.xml)|*.xml";
	Иначе	
	     Фильтр = ИмяСохранения + "(*.txt)|*.txt"; 
	КонецЕсли;

	// создаем диалог сохранения файла
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДиалогОткрытияФайла.Заголовок          = "Сохраните файл";
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.Расширение         = ТипРасширения;
    ДиалогОткрытияФайла.Фильтр             = Фильтр;
	ДиалогОткрытияФайла.ИндексФильтра      = 0; //укажем фильтр по умолчанию (нумерация с нуля)
	
	ДиалогОткрытияФайла.ПолноеИмяФайла = ИмяСохранения;
	
	ДиалогОткрытияФайла.Показать(Новый ОписаниеОповещения("ЗавершениеДиалогаВыбораФайлаСохранение", ЭтаФорма, ДвоичныеДанные));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеДиалогаВыбораФайлаСохранение(ВыбранныеФайлы, ДвоичныеДанные) Экспорт
    
	Если ВыбранныеФайлы = Неопределено Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Отмена сохранения файла";	
		Сообщение.Сообщить();

        Возврат;
    КонецЕсли;
    
    ВсегоФайлов = ВыбранныеФайлы.Количество();
    Прогресс = 0;
    ТекущийНомерФайла = 0;
	Если ВыбранныеФайлы <> Неопределено Или ТипЗнч(ВыбранныеФайлы) = Тип("Массив") Тогда
        Для каждого ИмяФайла Из ВыбранныеФайлы Цикл
            ТекущийНомерФайла = ТекущийНомерФайла + 1;
            Попытка
                Прогресс = Окр(ТекущийНомерФайла * 100 / ВсегоФайлов, 0);
                ДвоичныеДанные.Записать(ИмяФайла);
            Исключение
				
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Ошибка записи в файл [" + "] " + ИмяФайла;	
				Сообщение.Сообщить();
			
            КонецПопытки;
            Состояние("Сохранено в " + ИмяФайла, Прогресс,, БиблиотекаКартинок.ЭКОМ_Информация);
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Настройки сохранены на диск  - " + ИмяФайла;	
			Сообщение.Сообщить();
			
        КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНастройкуВДеревоЗначенийНаСервере(ПутьКФайлу, ИмяДереваЗначений, НаименованиеФайла)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ДЗ = ДанныеФормыВЗначение(ЭтаФорма[ИмяДереваЗначений], Тип("ДеревоЗначений"));
	
	ПараметрВетвь = ПолучитьПараметрВетвьРепозитория(ВетвьРепозитория);
	ОбработкаОбъект.ЗагрузитьНастройкуВДеревоЗначений(ПутьКФайлу + ПараметрВетвь, ДЗ, НаименованиеФайла, ИмяДереваЗначений); //Docrobot 1.21.0 MOD-280 [Добавлено ИмяДереваЗначений]
		
	ЗначениеВРеквизитФормы(ДЗ, ИмяДереваЗначений);

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	Структура = Новый Структура; 
    Структура.Вставить("СтруктураФайлаXMLИсходящие", ЭтаФорма.СтруктураФайлаXMLИсходящие);
	Структура.Вставить("СтруктураФайлаXMLВходящие" , ЭтаФорма.СтруктураФайлаXMLВходящие);
	Структура.Вставить("СтруктураФайлаXMLДокументы", ЭтаФорма.СтруктураФайлаXMLДокументы);
	
	ЭтаФорма.Закрыть(Структура);

КонецПроцедуры

&НаКлиенте
Процедура ФильтрПоКонфигурацииПриИзменении(Элемент)
	СписокПараметровОтбора.Добавить(ЭтаФорма.ФильтрПоКонфигурации, "Конфигурация");
	Фильтр();
КонецПроцедуры

&НаСервере
Процедура Фильтр()
	
	ТЗ = ДанныеФормыВЗначение(ЭтаФорма.ИсходнаяТЗ, Тип("ТаблицаЗначений"));
	
	ПараметрыОтбора = Новый Структура;
	Для каждого Стр Из СписокПараметровОтбора Цикл
		Если ЗначениеЗаполнено(Стр.Значение) Тогда
		     ПараметрыОтбора.Вставить(Стр.Представление, Стр.Значение);
		КонецЕсли;
	КонецЦикла;
	
	ЭтаФорма.ТабличноеПоле.Очистить();
	Если НЕ ПараметрыОтбора.Количество() = 0 Тогда
		Результат = ТЗ.НайтиСтроки(ПараметрыОтбора);	
		Для Каждого Выборка Из Результат Цикл
			НовСтр = ЭтаФорма.ТабличноеПоле.Добавить();		
			ЗаполнитьЗначенияСвойств(НовСтр, Выборка);	
		КонецЦикла;
		
	Иначе
		КопироватьДанныеФормы(ЭтаФорма.ИсходнаяТЗ, ЭтаФорма.ТабличноеПоле);
		
	КонецЕсли;
	
КонецПроцедуры

