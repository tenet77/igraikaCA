&НаКлиенте
Процедура ПроверкаКвитанцииНаПлатформе(Команда)
	
	МассивЛогаСобытий = Новый Массив;
	ПараметрКлюч = "ТипОбмена, Тип";
	
	// Только входящие
	СписокКвитанций = Новый Соответствие;	
	СписокКвитанций.Вставить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.DP_IZVPOL_10") , Новый Структура(ПараметрКлюч, "Сеть"     , "DP_IZVPOL_10"));
	СписокКвитанций.Вставить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.DP_PDOTPR_03") , Новый Структура(ПараметрКлюч, "Сеть"     , "DP_PDOTPR_03"));
	СписокКвитанций.Вставить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.DP_IZVPOL_05") , Новый Структура(ПараметрКлюч, "Сеть"     , "DP_IZVPOL_05"));
	СписокКвитанций.Вставить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.DP_PDOTPR_07") , Новый Структура(ПараметрКлюч, "Сеть"     , "DP_PDOTPR_07"));
	СписокКвитанций.Вставить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.DP_IZVPOL_08") , Новый Структура(ПараметрКлюч, "Сеть"     , "DP_IZVPOL_08"));	
	СписокКвитанций.Вставить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.DP_PDPOL_02")  , Новый Структура(ПараметрКлюч, "Поставщик", "DP_PDPOL_02"));
	СписокКвитанций.Вставить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.DP_IZVPOL_04") , Новый Структура(ПараметрКлюч, "Поставщик", "DP_IZVPOL_04"));	
	СписокКвитанций.Вставить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.DP_IZVPOL_06") , Новый Структура(ПараметрКлюч, "Поставщик", "DP_IZVPOL_06"));
	СписокКвитанций.Вставить(ПредопределенноеЗначение("Перечисление.ЭКОМ_ВидыДокументов.DP_UVUTOCH_09"), Новый Структура(ПараметрКлюч, "Поставщик", "DP_UVUTOCH_09"));
    СписокКвитанций.Вставить("SCHFDOPPOK"                                                              , Новый Структура(ПараметрКлюч, "Поставщик", "Подпись"));
				
	Для каждого Стр Из Элементы.ТаблицаОшибочныеКвитанции.ВыделенныеСтроки Цикл
		ВыбраннаяСтрока = Элементы.ТаблицаОшибочныеКвитанции.ДанныеСтроки(Стр);

		Если Найти(ВыбраннаяСтрока.Идентификатор, "SCHFDOPPOK") > 0 Тогда
			Данные = СписокКвитанций.Получить("SCHFDOPPOK");
		Иначе
			Данные = СписокКвитанций.Получить(ВыбраннаяСтрока.ВидДокумента);
		КонецЕсли;	
		 
		Если НЕ Данные = Неопределено Тогда
			
			Структура  = ОбновитьСтатусСтрокиТаблицы(ЭтаФорма.ПрофильОбменаНаФорме, ВыбраннаяСтрока.Идентификатор, Данные.Тип, МассивЛогаСобытий);
			ТексОшибки = СокрЛП(ВыбраннаяСтрока.ТекстОшибки) + ?(ЗначениеЗаполнено(ВыбраннаяСтрока.ТекстОшибки), Символы.ПС, "") + СокрЛП(Структура.ТекстОшибки);
			ЛогСобытий = СокрЛП(ВыбраннаяСтрока.ЛогСобытий) + ?(ЗначениеЗаполнено(ВыбраннаяСтрока.ЛогСобытий), Символы.ПС, "") + СокрЛП(Структура.ЛогСобытий);
			
			ВыбраннаяСтрока.ТекстОшибки       = ТексОшибки;
			ВыбраннаяСтрока.ЛогСобытий        = ЛогСобытий;
			
		КонецЕсли;	
		
	КонецЦикла;
	
	Если МассивЛогаСобытий.Количество() > 0  Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ЭКОМ_ОбщегоНазначенияКлиент.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий);
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура НайтиПовторноДокументОснования(Команда)
	
	КвитанцииНайдены = Ложь;
	МассивСтрок =  ПолучитьСтрокиДинамическогоСпискаДляОбработки("ТаблицаОшибочныеКвитанции");
	СписокТиповОбмена = НайтиПовторноДокументОснованияНаСервере(КвитанцииНайдены, МассивСтрок);
	
	Если КвитанцииНайдены = Истина Тогда
		ФормаОсновная = ПолучитьФорму(ЭтаФорма.ПолноеИмяОбработки + ".Форма.УФ_Форма");
		Для каждого ИмяСписка Из СписокТиповОбмена Цикл
			ФормаОсновная.ПроверитьНаличиеФайловНаКлиенте(ИмяСписка.Ключ, 1, ИмяСписка.Значение);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция НайтиПовторноДокументОснованияНаСервере(КвитанцииНайдены, МассивСтрок)
	
	ПараметрКлюч = "ТипОбмена, Тип";

	// Только входящие
	СписокКвитанций = Новый Соответствие;	
	СписокКвитанций.Вставить(Перечисления.ЭКОМ_ВидыДокументов.DP_IZVPOL_10 , Новый Структура(ПараметрКлюч, "СписокДляПокупателя", "DP_IZVPOL_10"));
	СписокКвитанций.Вставить(Перечисления.ЭКОМ_ВидыДокументов.DP_PDOTPR_03 , Новый Структура(ПараметрКлюч, "СписокДляПокупателя", "DP_PDOTPR"));
	СписокКвитанций.Вставить(Перечисления.ЭКОМ_ВидыДокументов.DP_PDOTPR_07 , Новый Структура(ПараметрКлюч, "СписокДляПокупателя", "DP_PDOTPR"));

	СписокКвитанций.Вставить(Перечисления.ЭКОМ_ВидыДокументов.DP_PDPOL_02  , Новый Структура(ПараметрКлюч, "СписокДляПоставщика", "DP_PDPOL"));
	СписокКвитанций.Вставить(Перечисления.ЭКОМ_ВидыДокументов.DP_IZVPOL_06 , Новый Структура(ПараметрКлюч, "СписокДляПоставщика", "DP_IZVPOL_06"));
	СписокКвитанций.Вставить(Перечисления.ЭКОМ_ВидыДокументов.DP_UVUTOCH_09, Новый Структура(ПараметрКлюч, "СписокДляПоставщика", "DP_UVUTOCH"));
    СписокКвитанций.Вставить("SCHFDOPPOK"                                  , Новый Структура(ПараметрКлюч, "СписокДляПоставщика", "Подпись"));
	
	СписокТиповОбмена = Новый Структура;
	МассивИдентификаторов = Новый Массив;
	Для каждого ВыбраннаяСтрока Из МассивСтрок Цикл	
		
		Если Найти(ВыбраннаяСтрока.Идентификатор, "SCHFDOPPOK") > 0 Тогда
			Данные = СписокКвитанций.Получить("SCHFDOPPOK");
		Иначе
			Данные = СписокКвитанций.Получить(ВыбраннаяСтрока.ВидДокумента);
		КонецЕсли;
		
		Если НЕ Данные = Неопределено Тогда
		    СписокТиповОбмена.Вставить(Данные.Тип, Данные.ТипОбмена);
  		КонецЕсли;
			
		МассивИдентификаторов.Добавить(ВыбраннаяСтрока.ИдентификаторОснования);				
	КонецЦикла;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЭКОМ_Объекты_События.Документ_Основание,
	               |	ЭКОМ_Квитанции.ВидДокумента,
	               |	ЭКОМ_Квитанции.Идентификатор
	               |ИЗ
	               |	РегистрСведений.ЭКОМ_Объекты_События КАК ЭКОМ_Объекты_События
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЭКОМ_Квитанции КАК ЭКОМ_Квитанции
	               |		ПО ЭКОМ_Объекты_События.Идентификатор = ЭКОМ_Квитанции.ИдентификаторОснования
	               |ГДЕ
	               |	ЭКОМ_Объекты_События.Идентификатор В(&МассивИдентификаторов)
	               |	И НЕ ЭКОМ_Квитанции.ВидДокумента ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("МассивИдентификаторов", МассивИдентификаторов);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой()  Тогда
	
		Соообщение = Новый СообщениеПользователю;
		Соообщение.Текст = "Документы основания по квитанциям не найдены в базе 1С!";
		Соообщение.Сообщить();
		
	Иначе
		МЗ = РегистрыСведений.ЭКОМ_Квитанции.СоздатьМенеджерЗаписи();
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл			
			
			МЗ.ВидДокумента  = Выборка.ВидДокумента;
			МЗ.Идентификатор = Выборка.Идентификатор;
			МЗ.Прочитать();
			
			МЗ.ДатаЗаписи     = ТекущаяДата();
			МЗ.Записать();

		КонецЦикла;
		
		КвитанцииНайдены = Истина;
			
	КонецЕсли;

	Возврат СписокТиповОбмена;
	
КонецФункции

&НаКлиенте
Процедура ТаблицаОшибочныеКвитанцииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Элемент = Неопределено 
		ИЛИ Элемент.ТекущиеДанные = Неопределено 
		ИЛИ ВыбраннаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле.Имя = "ТаблицаКвитанцийПоставщикТекстОшибки" 
		И ЗначениеЗаполнено(Элемент.ТекущиеДанные.ТекстОшибки) Тогда
		
		СтандартнаяОбработка = Ложь;
        Подсказка = "Текст ошибки";
        ПоказатьВводСтроки(Новый ОписаниеОповещения, Элемент.ТекущиеДанные.ТекстОшибки, Подсказка, 0, Истина);
		
	ИначеЕсли Поле.Имя = "ТаблицаКвитанцийПоставщикЛогСобытий" 
		И ЗначениеЗаполнено(Элемент.ТекущиеДанные.ЛогСобытий) Тогда
		
		СтандартнаяОбработка = Ложь;
        Подсказка = "Текст лога событий";
        ПоказатьВводСтроки(Новый ОписаниеОповещения, Элемент.ТекущиеДанные.ЛогСобытий, Подсказка, 0, Истина);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ПолучитьСтрокиДинамическогоСпискаДляОбработки(ИмяСписка)
    
    СписокДляОбработки = Элементы[ИмяСписка];	
	СтрКолонки = "";
	Для каждого ИмяКолонки Из СписокДляОбработки.ПодчиненныеЭлементы Цикл
		ИмяТекКолонки = СтрЗаменить(ИмяКолонки.Имя, СписокДляОбработки.Имя, "");
		СтрКолонки    = ?(СтрКолонки = "", ИмяТекКолонки, СтрКолонки + "," + ИмяТекКолонки);		
	КонецЦикла;
	
	ВыгружаемыеДанныеВыделения = Новый Массив;
	Для каждого текВыделеннаяСтрока Из СписокДляОбработки.ВыделенныеСтроки Цикл
		РезультатСтруктура = Новый Структура(СтрКолонки);
		ВыбраннаяСтрока = СписокДляОбработки.ДанныеСтроки(текВыделеннаяСтрока);			
		ЗаполнитьЗначенияСвойств(РезультатСтруктура, ВыбраннаяСтрока);
		ВыгружаемыеДанныеВыделения.Добавить(РезультатСтруктура);
	КонецЦикла;
		       
    Возврат ВыгружаемыеДанныеВыделения;
	
КонецФункции

&НаКлиенте
Процедура ДатаКонецПриИзменении(Элемент)
	ТекущиеДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();
	ОбновитьТЧ(ТекущиеДанныеСписка.ИмяСписка, ТекущиеДанныеСписка.ТипОбмена, Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаПриИзменении(Элемент)
	ТекущиеДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();
	ОбновитьТЧ(ТекущиеДанныеСписка.ИмяСписка, ТекущиеДанныеСписка.ТипОбмена, Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериод(Команда)	
    Диалог = Новый ДиалогРедактированияСтандартногоПериода();                                 
    Диалог.Период = Новый СтандартныйПериод(ЭтаФорма.ДатаНачала, ЭтаФорма.ДатаКонец);
    ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("УстановитьПериодЗавершение", ЭтаФорма, Новый Структура("Диалог", Диалог));
    Диалог.Показать(ОписаниеОповещенияОЗакрытии); 	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериодЗавершение(Период, ДополнительныеПараметры) Экспорт	
	
	Диалог = ДополнительныеПараметры.Диалог; 	
    Если НЕ Период = Неопределено Тогда		
        ЭтаФорма.ДатаНачала = Диалог.Период.ДатаНачала;
        ЭтаФорма.ДатаКонец  = Диалог.Период.ДатаОкончания;		
    КонецЕсли;
	
	ТекущиеДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();
	ОбновитьТЧ(ТекущиеДанныеСписка.ИмяСписка, ТекущиеДанныеСписка.ТипОбмена, Неопределено);

КонецПроцедуры
