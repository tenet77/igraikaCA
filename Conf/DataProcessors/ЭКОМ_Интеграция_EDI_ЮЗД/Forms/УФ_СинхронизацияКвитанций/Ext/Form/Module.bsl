&НаКлиенте
Процедура ОбменКвитанциями(Тип, ТипОбмена)
	
	МассивЛогаСобытий = Новый Массив;
	
	Если ТипОбмена = "Поставщик" Тогда	
		ИмяТЧ = "ТаблицаКвитанцийПоставщик";	
		
	ИначеЕсли ТипОбмена = "Сеть" Тогда		
		ИмяТЧ = "ТаблицаКвитанцийСеть";	
		
	Иначе
		ИмяТЧ = "ТаблицаОшибочныеКвитанции";			
	КонецЕсли;
	 
	// Поместим в регистр если есть
	Для каждого Стр Из Элементы[ИмяТЧ].ВыделенныеСтроки Цикл
		ВыбраннаяСтрока = Элементы[ИмяТЧ].ДанныеСтроки(Стр);
		
		КлючСтатус = "Статус" + Тип;
		Если ВыбраннаяСтрока[КлючСтатус] = "" 
			 ИЛИ ВыбраннаяСтрока[КлючСтатус] = "Неопределен" Тогда
			 
			ИД_Квитанции = "";
			ИД_Документа = Прав(ВыбраннаяСтрока.ПервичныйЮЗД, 36); 
			
			Ошибка = ПолучитьСтруктуруОшибки();
			
			Структура = Новый Структура;
			Структура.Вставить("ПервичныйЮЗД", "");
			Структура.Вставить("DP_IZVPOL_06", "");
			Структура.Вставить("DP_UVUTOCH_09", "");
			Структура.Вставить("DP_IZVPOL_10" , "");
			Структура.Вставить("Подпись"      , "");
			
			Структура.Вставить("СтатусПервичныйЮЗД", "");
			Структура.Вставить("СтатусDP_IZVPOL_06", "");
			Структура.Вставить("СтатусDP_UVUTOCH_09", "");
			Структура.Вставить("СтатусDP_IZVPOL_10", "");
			Структура.Вставить("СтатусПодпись", "");
			Структура.Вставить("ТекстОшибки", "");
			Структура.Вставить("Организация", "");
			Структура.Вставить("Контрагенты", "");

			Если ТипОбмена = "Сеть" Тогда
				
				Структура.Вставить("ЭКОМ_Документ", "");
				Структура.Вставить("DP_PDOTPR_03", "");
				Структура.Вставить("DP_IZVPOL_05", "");	
				Структура.Вставить("DP_PDOTPR_07", "");
				Структура.Вставить("DP_IZVPOL_08" , "");		
				
				Структура.Вставить("СтатусDP_PDOTPR_03", "");
				Структура.Вставить("СтатусDP_IZVPOL_05", "");
				Структура.Вставить("СтатусDP_PDOTPR_07", "");
				Структура.Вставить("СтатусDP_IZVPOL_08", "");
				
			Иначе
				
				Структура.Вставить("ДокументСЧФ", "");
				Структура.Вставить("DP_PDPOL_02", "");
				Структура.Вставить("DP_IZVPOL_04", "");
				
				Структура.Вставить("СтатусDP_PDPOL_02", "");
				Структура.Вставить("СтатусDP_IZVPOL_04", "");
				
			КонецЕсли;
					
			ЗаполнитьЗначенияСвойств(Структура, ВыбраннаяСтрока);
			
			ИдентификаторОснование = Прав(Структура.ПервичныйЮЗД, 36);
            
            СтруктураРезультат = ПолучитьДополнительнуюИнформациюПровайдераНаСеревере(ИдентификаторОснование, Тип, Ошибка, ВыбраннаяСтрока.ПрофильОбмена, МассивЛогаСобытий);

			ПоместитьВРегистр(Структура, Тип, ТипОбмена, СтруктураРезультат);
			// Отправляем если есть ошибка
			Если Ошибка.ЕстьОшибка = Истина 
				 И ТипОбмена = "Сеть" Тогда
				
				Ошибка = ПолучитьСтруктуруОшибки();
				Если Тип="DP_IZVPOL_05" Тогда
					
					ИД_Квитанции = Прав(ВыбраннаяСтрока.DP_PDOTPR_03, 36);
					Результат = ОтправитьКвитанцию(ВыбраннаяСтрока.Сертификат, ВыбраннаяСтрока.ПрофильОбмена, Структура, Тип, ВыбраннаяСтрока.Организация, ИД_Квитанции, ИД_Документа, Ошибка, МассивЛогаСобытий);
					
				ИначеЕсли Тип="DP_IZVPOL_08" 
					И (НЕ ЗначениеЗаполнено(ВыбраннаяСтрока[Тип]) 
					ИЛИ ВыбраннаяСтрока[Тип] = "Нет данных") Тогда
					
					ИД_Квитанции = Прав(ВыбраннаяСтрока.DP_PDOTPR_07, 36);
					Результат = ОтправитьКвитанцию(ВыбраннаяСтрока.Сертификат, ВыбраннаяСтрока.ПрофильОбмена, Структура, Тип, ВыбраннаяСтрока.Организация, ИД_Квитанции, ИД_Документа, Ошибка, МассивЛогаСобытий);
					
				ИначеЕсли Тип="DP_IZVPOL_06" Тогда
					
					ИД_Квитанции = Прав(ВыбраннаяСтрока.ПервичныйЮЗД, 36);
					Результат = ОтправитьКвитанцию(ВыбраннаяСтрока.Сертификат, ВыбраннаяСтрока.ПрофильОбмена, Структура, Тип, ВыбраннаяСтрока.Организация, ИД_Квитанции, ИД_Документа, Ошибка, МассивЛогаСобытий);
					
				ИначеЕсли Тип = "Подпись" Тогда
					
					ИД_Документа = Прав(ВыбраннаяСтрока.ПервичныйЮЗД, 36);
					Результат = ОтправитьТитулПокупателя(ВыбраннаяСтрока.Сертификат, ВыбраннаяСтрока.ПрофильОбмена, Структура, Тип, ВыбраннаяСтрока.Организация, ИД_Документа, Ошибка, МассивЛогаСобытий);
	 	
				КонецЕсли;
				
				Если НЕ Результат = Неопределено Тогда
					
					Структура.Вставить(КлючСтатус, "ОК");
					
				КонецЕсли;
				
			КонецЕсли;
			
			// Отправляем если есть ошибка
			Если Ошибка.ЕстьОшибка = Истина 
				 И ТипОбмена = "Поставщик" Тогда
				
				Ошибка = ПолучитьСтруктуруОшибки();
				Если Тип="DP_IZVPOL_04" Тогда
					
					ИД_Квитанции = Прав(ВыбраннаяСтрока.DP_PDPOL_02, 36);
					Результат = ОтправитьКвитанцию(ВыбраннаяСтрока.Сертификат, ВыбраннаяСтрока.ПрофильОбмена, Структура, Тип, ВыбраннаяСтрока.Организация, ИД_Квитанции, ИД_Документа, Ошибка, МассивЛогаСобытий);
					
				ИначеЕсли Тип="DP_IZVPOL_10" Тогда
					
					ИД_Квитанции = Прав(ВыбраннаяСтрока.DP_UVUTOCH_09, 36);
					Результат = ОтправитьКвитанцию(ВыбраннаяСтрока.Сертификат, ВыбраннаяСтрока.ПрофильОбмена, Структура, Тип, ВыбраннаяСтрока.Организация, ИД_Квитанции, ИД_Документа, Ошибка, МассивЛогаСобытий);
						 	
				КонецЕсли;
				
				Если НЕ Результат = Неопределено Тогда
					
					Структура.Вставить(КлючСтатус, "ОК");
					
				КонецЕсли;
				
			КонецЕсли;
			
			Структура.Вставить("ТекстОшибки", Структура.ТекстОшибки + " " + Ошибка.ТекстОшибки);
			
			ЗаполнитьЗначенияСвойств(ВыбраннаяСтрока,Структура);
			
			Соообщение = Новый СообщениеПользователю;
			Соообщение.Текст = "Данные успешно обновлены!";
			Соообщение.Сообщить();
			
		Иначе
			Соообщение = Новый СообщениеПользователю;
			Соообщение.Текст = "Данная квитанция уже загружена в базу!";
			Соообщение.Сообщить();

		КонецЕсли;
		
	КонецЦикла;

	Если МассивЛогаСобытий.Количество() > 0  Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ЭКОМ_ОбщегоНазначения.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий);
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецПроцедуры

