&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбработкаОбъект 	  = РеквизитФормыВЗначение("Объект");
    ПолноеИмяОбработки	  = ОбработкаОбъект.Метаданные().ПолноеИмя();

	ЭтаФорма.ДатаНачала = НачалоМесяца(ТекущаяДата());
	ЭтаФорма.ДатаКонец  = ТекущаяДата();
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьКомпоновкуДанных(СхемаКомпоновкиДанных)
	
	URLСхемы = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, Новый УникальныйИдентификатор());	
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(URLСхемы);
	
	ОтборНаФорме.Инициализировать(ИсточникНастроек);
	ОтборНаФорме.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
					
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	
	ТекущиеДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();
	ОбновитьТЧ(ТекущиеДанныеСписка.ИмяСписка, ТекущиеДанныеСписка.ТипОбмена, Неопределено);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте()

	ИмяСписка = "";		
	ТипОбмена = "";

	ТекущаяСтраницаИмя = Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя;	
	Если ТекущаяСтраницаИмя = "ГруппаПоставщик" Тогда		
		ИмяСписка = "ТаблицаКвитанцийПоставщик";		
		ТипОбмена = "Поставщик";
		
	ИначеЕсли ТекущаяСтраницаИмя = "ГруппаПокупатель" Тогда				
		ИмяСписка = "ТаблицаКвитанцийСеть";	
		ТипОбмена = "Сеть";
		
	Иначе 		
		ИмяСписка = "ТаблицаОшибочныеКвитанции";
		ТипОбмена = "";

	КонецЕсли;

	ТекущиеДанныеСписка = Новый Структура;
	ТекущиеДанныеСписка.Вставить("ИмяСписка", ИмяСписка);
	ТекущиеДанныеСписка.Вставить("ТипОбмена", ТипОбмена);

	Возврат ТекущиеДанныеСписка;
	
КонецФункции


&НаСервере
Процедура ОбновитьТЧ(ИмяТЗ, ТипОбмена, КомпоновщикНастроек)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ТекстЗапроса    = ОбработкаОбъект.ПолучитьТекстЗапросаСинхронизации(ТипОбмена);			
	СхемаКомпоновкиДанных = СозданиеСКД(ТекстЗапроса, ТипОбмена);

	Если КомпоновщикНастроек = Неопределено Тогда
	     ИнициализироватьКомпоновкуДанных(СхемаКомпоновкиДанных);
	КонецЕсли;
	 
	ЭтаФорма[ИмяТЗ].Очистить();

	НастройкиКомпоновщика = ОтборНаФорме.Настройки;
	Если НЕ НастройкиКомпоновщика.ПараметрыДанных.ДоступныеПараметры.Элементы.Количество() = 0 Тогда
		НастройкиКомпоновщика.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаНач", НачалоДня(ЭтаФорма.ДатаНачала));
		НастройкиКомпоновщика.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаКон", КонецДня(ЭтаФорма.ДатаКонец));
	КонецЕсли;
			
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки   = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиКомпоновщика,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ТЗ = Новый ТаблицаЗначений;
	ПроцессорВывода.УстановитьОбъект(ТЗ);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	ЭтаФорма[ИмяТЗ].Загрузить(ТЗ);	
		
КонецПроцедуры

&НаКлиенте
Функция ОбновитьСтатусСтрокиТаблицы(ПрофильОбмена, ПолныйИдентификатор, Тип, МассивЛогаСобытий)
	
	ПервыйЭлементНач = Найти(ПолныйИдентификатор, "_");
	ВторойЭлементНач = Найти(Сред(ПолныйИдентификатор, ПервыйЭлементНач + 1), "_");
		
	СтатсусОК = "Неопределен";
	Идентификатор = Прав(ПолныйИдентификатор, 36);
	ТекстОшибки = "";
	ЛогСобытий  = "";
	Если ЗначениеЗаполнено(Идентификатор) Тогда
		ДанныеОбОшибке = ПолучитьСтруктуруОшибки();
		Данные = ИзвлечьИнформациюОДокументеНаСервере(Идентификатор, Тип, ДанныеОбОшибке, ПрофильОбмена, МассивЛогаСобытий);
		Если ДанныеОбОшибке.ЕстьОшибка Тогда
			ТекстОшибки = Тип + " - " + ДанныеОбОшибке.ТекстОшибки;
		Иначе
			СтатсусОК  = "ОК";
			ЛогСобытий = Тип + " - ОК";
		КонецЕсли;
	КонецЕсли;
	
	Структура = Новый Структура;
	Структура.Вставить("СтатсусОК"  , СтатсусОК);
	Структура.Вставить("ТекстОшибки", ТекстОшибки);
	Структура.Вставить("ЛогСобытий" , ЛогСобытий);
	
	Возврат Структура;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьСтатусы()
	
	ТекущиеДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();
	
	МассивЛогаСобытий = Новый Массив;
	
	МассивСтатусов = ПолучитьМассивСтатусов(ТекущиеДанныеСписка.ИмяСписка);
	Для каждого Стр Из Элементы[ТекущиеДанныеСписка.ИмяСписка].ВыделенныеСтроки Цикл
		ВыбраннаяСтрока = Элементы[ТекущиеДанныеСписка.ИмяСписка].ДанныеСтроки(Стр);
		ПолучитьСтатусы(ВыбраннаяСтрока, МассивСтатусов, МассивЛогаСобытий);	
	КонецЦикла;
	
	Если МассивЛогаСобытий.Количество() > 0  Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ЭКОМ_ОбщегоНазначенияКлиент.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий);
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьСтатусы(ВыбраннаяСтрока, МассивСтатусов, МассивЛогаСобытий)

	Для каждого ЭлИмя Из МассивСтатусов Цикл
		
		Если ЗначениеЗаполнено(ВыбраннаяСтрока[ЭлИмя])
			И НЕ ВыбраннаяСтрока[ЭлИмя] = "Нет данных" Тогда
			
			Структура  = ОбновитьСтатусСтрокиТаблицы(ВыбраннаяСтрока.ПрофильОбмена, ВыбраннаяСтрока[ЭлИмя], ЭлИмя, МассивЛогаСобытий);
			ТексОшибки = СокрЛП(ВыбраннаяСтрока.ТекстОшибки) + ?(ЗначениеЗаполнено(ВыбраннаяСтрока.ТекстОшибки), Символы.ПС, "") + СокрЛП(Структура.ТекстОшибки);
			ЛогСобытий = СокрЛП(ВыбраннаяСтрока.ЛогСобытий) + ?(ЗначениеЗаполнено(ВыбраннаяСтрока.ЛогСобытий), Символы.ПС, "") + СокрЛП(Структура.ЛогСобытий);
			
			ВыбраннаяСтрока["Статус" + ЭлИмя] = Структура.СтатсусОК;
			ВыбраннаяСтрока.ТекстОшибки       = ТексОшибки;
			ВыбраннаяСтрока.ЛогСобытий        = ЛогСобытий;
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ПолучитьМассивСтатусов(ТипОбмена)
	
	Массив = Новый Массив;
	
	Если ТипОбмена = "ТаблицаКвитанцийПоставщик" Тогда
		Массив.Добавить("ПервичныйЮЗД");
		Массив.Добавить("DP_PDPOL_02");
		Массив.Добавить("DP_IZVPOL_04");
		Массив.Добавить("DP_IZVPOL_06");
		Массив.Добавить("DP_UVUTOCH_09");
		Массив.Добавить("DP_IZVPOL_10");
		Массив.Добавить("Подпись");
		
	ИначеЕсли ТипОбмена = "ТаблицаКвитанцийСеть" Тогда
		Массив.Добавить("ПервичныйЮЗД");
		Массив.Добавить("DP_PDOTPR_03");
		Массив.Добавить("DP_IZVPOL_05");
		Массив.Добавить("DP_IZVPOL_06");
		Массив.Добавить("DP_PDOTPR_07");
		Массив.Добавить("DP_IZVPOL_08");
		Массив.Добавить("DP_UVUTOCH_09");
		Массив.Добавить("DP_IZVPOL_10");
		Массив.Добавить("Подпись");
		
	КонецЕсли;
	
	Возврат Массив;
	
КонецФункции 

&НаКлиенте
Процедура ПолучитьНеобработанныеСобытияКлиент(Команда)
	
	МассивЛогаСобытий = Новый Массив;
	Ошибка = ПолучитьСтруктуруОшибки();
	ПолучитьНеобработанныеСобытияНаСервере(Ошибка, 0, МассивЛогаСобытий);
	
	Если МассивЛогаСобытий.Количество() > 0  Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ЭКОМ_ОбщегоНазначенияКлиент.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий);
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбменКвитанциямиDP_IZVPOL_08(Команда)
	
	ОбменКвитанциями("DP_IZVPOL_08", "Сеть");

КонецПроцедуры

// + Отправка ответной квитанции "Извещение о получении подтверждения даты отправки извещения о получени" // IZVPOL-08
// Параметры:
//	- ИД_Квитанции - Уникальный идентификатор квитанции к которой формируется ответ
//	- ИД_Документа - Уникальный идентификатор документа
//	- Ошибка - Стандартный параметр см. ПолучитьСтруктуруОшибки
// Возвращает файлы подписанной квитанции и подписи в структуре "РезультатПодписи" см. ПолучитьСтруктуруРезультатаПодписания 
&НаКлиенте
Функция ОтправитьКвитанцию(СертификатЭКОМ, ПрофильОбмена, СтруктураСтроки, Тип, Организация, ИД_Квитанции, ИД_Документа, Ошибка, МассивЛогаСобытий) Экспорт 

	ЗначениеПоУмолчанию = Неопределено;
	Измерение           = Неопределено; 
	Обязательно         = Истина;
	ЛокальныйКаталогOUTBOX = ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере("ЭКОМ_Локальный_Каталог_OUTBOX", ЗначениеПоУмолчанию, Измерение, Обязательно);
	
	// Проверка каталогов OUTBOX
    Если НЕ Прав(ЛокальныйКаталогOUTBOX,1) = "\" Тогда	
        ЛокальныйКаталогOUTBOX = ЛокальныйКаталогOUTBOX + "\"; 
    КонецЕсли;
	
	ТокенАвторизации = ЭКОМ_ОбщегоНазначения.ПолучитьТокенАвторизации(ПрофильОбмена, Ошибка, МассивЛогаСобытий);	  
	Если Ошибка.ЕстьОшибка Тогда		
		Сообщить("При получении токена(авторизации) возникла ошибка - Код: " + + Ошибка.КодОшибки + " - " + Ошибка.ТекстОшибки);
		Возврат Неопределено;		
	КонецЕсли;
	
	///////////////////////////////
	//Реализация
	
	ДанныеСертификатаЭКОМ = ЭКОМ_ОбщегоНазначения.ПолучитьДанныеСертификатаЭКОМ(СертификатЭКОМ); 
	
	ДанныеЗапроса = Новый Структура;
	ДанныеЗапроса.Вставить("identifier"     , ИД_Квитанции);
	ДанныеЗапроса.Вставить("signer_fname"   , ДанныеСертификатаЭКОМ.ФамилияПодписанта);
	ДанныеЗапроса.Вставить("signer_inn"     , ДанныеСертификатаЭКОМ.ИНН);
    ДанныеЗапроса.Вставить("signer_position", ДанныеСертификатаЭКОМ.ДолжностьПодписанта);
    ДанныеЗапроса.Вставить("signer_sname"   , ДанныеСертификатаЭКОМ.ИмяПодписанта);
    ДанныеЗапроса.Вставить("varToken"       , ТокенАвторизации);			
	
    ФайлКвитанции = СформироватьКвитанциюНаСервере(ПрофильОбмена, ДанныеЗапроса, Ошибка, МассивЛогаСобытий);	
	Если Ошибка.ЕстьОшибка Тогда	
		Сообщить("При формировании квитанции возникла ошибка - Код: " + Ошибка.КодОшибки + " - " + Ошибка.ТекстОшибки);
		Возврат Неопределено;	
	КонецЕсли;

	ДанныОФайле = ПолучитьДанныОФайлеНаСервере(ФайлКвитанции); 
	
	ПолноеИмяФайлаXML    = ЛокальныйКаталогOUTBOX + ДанныОФайле.ИмяФайла;
	ФайлКвитанции.Записать(ПолноеИмяФайлаXML);
	ФайлXML = Новый Файл(ПолноеИмяФайлаXML);

	ПолноеИмяФайлаBIN = ЛокальныйКаталогOUTBOX + ФайлXML.ИмяБезРасширения + ".bin";
	
	ДвоичныеДанныеФайлаXML = Новый ДвоичныеДанные(ПолноеИмяФайлаXML);
	
	//Пример. Формирует подпись для файла. Возвращает результат в виде двоичных данных.
	ЛогСобытий = "";
	СформированаПодписьФайла = ЭЦП_СформироватьПодписьФайлаНаКлиенте(ДвоичныеДанныеФайлаXML, ДанныеСертификатаЭКОМ, ЛогСобытий);
	Если СформированаПодписьФайла = Неопределено 
		ИЛИ СформированаПодписьФайла = Ложь Тогда	
		Возврат Неопределено;
		
	КонецЕсли;
	
	ФайлBIN = Новый Файл(ПолноеИмяФайлаBIN);
	Если НЕ ФайлBIN.Существует() Тогда	
		Возврат Неопределено;
		
	КонецЕсли;
	ДвоичныеДанныеПодписи = Новый ДвоичныеДанные(ФайлBIN.ПолноеИмя);
	
	УниверсальныйМетодОтправкиКвитанцийНаСеревере(ДанныеЗапроса.identifier, ФайлКвитанции, ДвоичныеДанныеПодписи, Ошибка);
    Если Ошибка.ЕстьОшибка Тогда	
		Сообщить("При отправке квитанции возникла ошибка - Код: " + Ошибка.КодОшибки + " - " + Ошибка.ТекстОшибки);
		Возврат Неопределено;	
	
	КонецЕсли;

	//Реализация
	///////////////////////////////
	ЗаписатьВРегистрПослеОтправкиНаСервере(СтруктураСтроки, Тип, ДанныОФайле, ДвоичныеДанныеПодписи);
	
	Возврат 1;
	
КонецФункции

&НаКлиенте
Функция ЭЦП_СформироватьПодписьФайлаНаКлиенте(ДвоичныеДанныеФайлаXML, ДанныеСертификатаЭКОМ, ЛогСобытий) Экспорт
	
	МассивЛогаСобытий = Новый Массив;
	ДанныеПодписи = Вычислить("ЭКОМ_ОбщегоНазначенияКлиент.ЭЦП_СформироватьПодписьФайлаОбщегоНазначения(ДвоичныеДанныеФайлаXML, ДанныеСертификатаЭКОМ, МассивЛогаСобытий)");
	Для каждого Лог Из МассивЛогаСобытий Цикл
		Если ЗначениеЗаполнено(Лог) Тогда
			ЛогСобытий = ЛогСобытий + ?(ЗначениеЗаполнено(ЛогСобытий), Символы.ПС, "") + Лог;
		КонецЕсли;	
	КонецЦикла;
	
	Возврат ДанныеПодписи;

КонецФункции

&НаКлиенте
Функция ЭЦП_ПолучитьСертификатПоОтпечаткуНаКлиенте(МенеджерКриптографии, ДанныеСертификатаЭКОМ, ТолькоВЛичномХранилище) Экспорт
	
	ЗначениеХранилищеСертификатов = Неопределено;
	Если ТолькоВЛичномХранилище Тогда
		ЗначениеХранилищеСертификатов = МенеджерКриптографии.ПолучитьХранилищеСертификатов(ТипХранилищаСертификатовКриптографии.ПерсональныеСертификаты);
	Иначе	
		ЗначениеХранилищеСертификатов = МенеджерКриптографии.ПолучитьХранилищеСертификатов();
	КонецЕсли;
	
	ДвоичныеДанныеОтпечатка = Base64Значение(ДанныеСертификатаЭКОМ.СертификатОтпечаток);
	Сертификат = ЗначениеХранилищеСертификатов.НайтиПоОтпечатку(ДвоичныеДанныеОтпечатка);
	
	Возврат Сертификат;
    
КонецФункции

