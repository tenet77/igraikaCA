&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	ТекущиеДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();
	ОбновитьТЧ(ТекущиеДанныеСписка.ИмяСписка, ТекущиеДанныеСписка.ТипОбмена, Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОтбор(Команда)
	
	ТекущиеДанныеСписка = ПолучитьТекущиеДанныеПоИмениСпискаНаКлиенте();
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТипОбмена"   , ТекущиеДанныеСписка.ТипОбмена);
	ПараметрыФормы.Вставить("ИмяСписка"   , ТекущиеДанныеСписка.ИмяСписка);
	ПараметрыФормы.Вставить("ОтборНаФорме", ЭтаФорма.ОтборНаФорме);
	Оповещение = Новый ОписаниеОповещения("ЗавершениеОтбора", ЭтаФорма);
	ФормаОтбора = ОткрытьФорму(ПолноеИмяОбработки + ".Форма.УФ_ФормаОтбора", ПараметрыФормы, ЭтаФорма,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);		
	
КонецПроцедуры


&НаКлиенте
Процедура ЗавершениеОтбора(Результат, Данные) Экспорт
	
	ЭтаФорма.ОтборНаФорме = Результат.ОтборНаФорме;
	
	ОбновитьТЧ(Результат.ИмяСписка, Результат.ТипОбмена, ЭтаФорма.ОтборНаФорме);
	
КонецПроцедуры

&НаСервере
Функция СозданиеСКД(ТекстЗапроса, ТипОбмена)
	
	//1. Создаем схему компоновки данных 
    СхемаКомпоновкиДанных = Новый СхемаКомпоновкиДанных;
    
   //1.1 Определяем источник данных для схемы 
   //для наших целей - текущая ИБ 
    Источник = СхемаКомпоновкиДанных.ИсточникиДанных.Добавить();
    Источник.Имя = "ИсточникДанных1";
    Источник.СтрокаСоединения = "";
    Источник.ТипИсточникаДанных = "Local";
    
   //1.2 Определяем набор данных 
    НаборДанных = СхемаКомпоновкиДанных.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	НаборДанных.Имя = "НаборДанных1";
	НаборДанных.ИсточникДанных = "ИсточникДанных1";
	НаборДанных.АвтоЗаполнениеДоступныхПолей = Истина;
	НаборДанных.Запрос = ТекстЗапроса;
	
	//2. Создаем настройки для схемы 
    НастройкиКомпоновкиДанных = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	
	Если ТипОбмена = "Сеть" 
		ИЛИ ТипОбмена = "Поставщик"  Тогда
		СтрПараметр = НастройкиКомпоновкиДанных.ПараметрыДанных.Элементы.Добавить();
		СтрПараметр.Параметр = Новый ПараметрКомпоновкиДанных("ДатаНач");
		СтрПараметр.Значение = Дата(0001, 01, 01); 
		СтрПараметр.Использование = Истина;
		
		СтрПараметр = НастройкиКомпоновкиДанных.ПараметрыДанных.Элементы.Добавить();
		СтрПараметр.Параметр = Новый ПараметрКомпоновкиДанных("ДатаКон");
		СтрПараметр.Значение = Дата(0001, 01, 01); 
		СтрПараметр.Использование = Истина;
	КонецЕсли;
	
	Структура = НастройкиКомпоновкиДанных.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	Структура.Использование = Истина;
	Структура.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	Структура.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));

	КоллекцияКолонок = Новый ТаблицаЗначений;
	КоллекцияКолонок.Колонки.Добавить("Имя");
	КоллекцияКолонок.Колонки.Добавить("ТипЗначения");
	КоллекцияКолонок.Колонки.Добавить("Заголовок");
	
	ПостроительЗапроса = Новый ПостроительЗапроса;
	ПостроительЗапроса.Текст = СокрЛП(ТекстЗапроса);
	ПостроительЗапроса.ЗаполнитьНастройки();
	Для каждого ВыбранноеПоле Из ПостроительЗапроса.ВыбранныеПоля Цикл	
		НоваяКолонка = КоллекцияКолонок.Добавить();
		НоваяКолонка.Имя = ВыбранноеПоле.Имя;			
		НоваяКолонка.ТипЗначения = ПостроительЗапроса.ДоступныеПоля[ВыбранноеПоле.ПутьКДанным].ТипЗначения;
		НоваяКолонка.Заголовок = ВыбранноеПоле.Представление
	КонецЦикла;
	
	// Добавление полей в набор		
	Для каждого НоваяКолонка Из КоллекцияКолонок Цикл			
		ПолеНабора = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		ПолеНабора.Заголовок   = СокрЛП(НоваяКолонка.Заголовок);
		ПолеНабора.Поле        = СокрЛП(НоваяКолонка.Имя);
		ПолеНабора.ПутьКДанным = СокрЛП(НоваяКолонка.Имя);
		
		// Удалим неопределено и NULL
		Массив = Новый Массив;
		Для каждого ТекущийТип Из НоваяКолонка.ТипЗначения.Типы() Цикл
			Если ТекущийТип = Тип("Неопределено") 
				ИЛИ ТекущийТип = Тип("NULL") 
				ИЛИ ТекущийТип = Неопределено 
				ИЛИ ТекущийТип = Null Тогда 
				Продолжить; 
			КонецЕсли;
			Массив.Добавить(ТекущийТип);
		КонецЦикла;
		ПолеНабора.ТипЗначения = Новый ОписаниеТипов(Массив,НоваяКолонка.ТипЗначения.КвалификаторыЧисла,НоваяКолонка.ТипЗначения.КвалификаторыСтроки,НоваяКолонка.ТипЗначения.КвалификаторыДаты);
		
		ВыбранноеПолеКомпоновкиДанных = НастройкиКомпоновкиДанных.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));			
		ВыбранноеПолеКомпоновкиДанных.Поле = Новый ПолеКомпоновкиДанных(ПолеНабора.ПутьКДанным);
		ВыбранноеПолеКомпоновкиДанных.Использование = Истина;
	КонецЦикла;
	 
   Возврат СхемаКомпоновкиДанных;
   
КонецФункции

&НаКлиенте
Процедура ТаблицаКвитанцийСетьВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Элемент = Неопределено 
		ИЛИ Элемент.ТекущиеДанные = Неопределено 
		ИЛИ ВыбраннаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле.Имя = "ТаблицаКвитанцийСетьТекстОшибки" 
		И ЗначениеЗаполнено(Элемент.ТекущиеДанные.ТекстОшибки) Тогда
		
		СтандартнаяОбработка = Ложь;
        Подсказка = "Текст ошибки";
        ПоказатьВводСтроки(Новый ОписаниеОповещения, Элемент.ТекущиеДанные.ТекстОшибки, Подсказка, 0, Истина);
		
	ИначеЕсли Поле.Имя = "ТаблицаКвитанцийСетьЛогСобытий" 
		И ЗначениеЗаполнено(Элемент.ТекущиеДанные.ЛогСобытий) Тогда
		
		СтандартнаяОбработка = Ложь;
        Подсказка = "Текст лога событий";
        ПоказатьВводСтроки(Новый ОписаниеОповещения, Элемент.ТекущиеДанные.ЛогСобытий, Подсказка, 0, Истина);
		
	КонецЕсли;

КонецПроцедуры

