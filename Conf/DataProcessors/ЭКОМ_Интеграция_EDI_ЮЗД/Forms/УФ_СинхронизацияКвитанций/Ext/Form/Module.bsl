// + Отправка титула покупателя // ON_SCHFDOPPOK_11 
// Параметры:
//	- ИД_Документа - Уникальный идентификатор документа
//	- ДанныеТитула - Структура,
//			Ключи:
//				- ДатаДокумента
//				- СодержаниеОперации"
//	- Ошибка - Стандартный параметр см. ПолучитьСтруктуруОшибки
// Возвращает файлы подписанного титула и подписи в структуре "РезультатПодписи" см. ПолучитьСтруктуруРезультатаПодписания
&НаКлиенте
Функция ОтправитьТитулПокупателя(СертификатЭКОМ, ПрофильОбмена, СтруктураСтроки, Тип, Организация, ИД_Документа, Ошибка, МассивЛогаСобытий) Экспорт
	
	///////////////////////////////
	//Реализация
	
	ЗначениеПоУмолчанию = Неопределено;
	Измерение           = Неопределено; 
	Обязательно         = Истина;
	ЛокальныйКаталогOUTBOX = ЭКОМ_ОбщегоНазначения.НастройкиПрочитатьНаСервере("ЭКОМ_Локальный_Каталог_OUTBOX", ЗначениеПоУмолчанию, Измерение, Обязательно);
	
	// Проверка каталогов OUTBOX
    Если НЕ Прав(ЛокальныйКаталогOUTBOX,1) = "\" Тогда	
        ЛокальныйКаталогOUTBOX = ЛокальныйКаталогOUTBOX + "\"; 
    КонецЕсли;

	ТокенАвторизации = ЭКОМ_ОбщегоНазначения.ПолучитьТокенАвторизации(ПрофильОбмена, Ошибка, МассивЛогаСобытий);	  
	Если Ошибка.ЕстьОшибка Тогда		
		Сообщить("При получении токена(авторизации) возникла ошибка - Код: " + Ошибка.КодОшибки + " - " + Ошибка.ТекстОшибки);
		Возврат Неопределено;		
	КонецЕсли;

	ДанныеЗапроса = Новый Структура;
	ДанныеЗапроса.Вставить("varToken", 	 ТокенАвторизации);
	ДанныеЗапроса.Вставить("identifier", ИД_Документа);	
	
	ДанныеДокумента = ИзвлечьИнформациюОДокументеНаСервере(ИД_Документа, Тип, Ошибка, ПрофильОбмена, МассивЛогаСобытий);
	Если Ошибка.ЕстьОшибка Тогда		
		Возврат Неопределено;		
	КонецЕсли;	

	ДанныеСертификатаЭКОМ = ЭКОМ_ОбщегоНазначения.ПолучитьДанныеСертификатаЭКОМ(СертификатЭКОМ);
	
	ДанныеЗапросаОтвета = Новый Структура;
	ДанныеЗапросаОтвета.Вставить("signer_fname"   , ДанныеСертификатаЭКОМ.ФамилияПодписанта);
	ДанныеЗапросаОтвета.Вставить("signer_inn"     , ДанныеСертификатаЭКОМ.ИНН);
	ДанныеЗапросаОтвета.Вставить("signer_position", ДанныеСертификатаЭКОМ.ДолжностьПодписанта);
	ДанныеЗапросаОтвета.Вставить("signer_sname"   , ДанныеСертификатаЭКОМ.ИмяПодписанта);
	ДанныеЗапросаОтвета.Вставить("signer_oblpoln" , ДанныеСертификатаЭКОМ.ОбластьПолномочий);
	ДанныеЗапросаОтвета.Вставить("signer_status"  , ДанныеСертификатаЭКОМ.СтатусПодписанта);
	ДанныеЗапросаОтвета.Вставить("signer_osnpoln" , ДанныеСертификатаЭКОМ.ОснованиеПолномочий);
	ДанныеЗапросаОтвета.Вставить("rec_sodoper"    , ДанныеДокумента.ТипДокумента);
	
	ДанныеЗапроса.Вставить("answer_data", ДанныеЗапросаОтвета);	 
	
	ТитулПокупателя = СформироватьКвитанциюНаСервере(ПрофильОбмена, ДанныеЗапроса, Ошибка, МассивЛогаСобытий);
	Если Ошибка.ЕстьОшибка Тогда	
		Сообщить("При формировании титула покупателя возникла ошибка - Код: " + Ошибка.КодОшибки + " - " + Ошибка.ТекстОшибки);
		Возврат Неопределено;	
	КонецЕсли;

	ДанныОФайле = ПолучитьДанныОФайлеНаСервере(ТитулПокупателя); 
	
	ПолноеИмяФайлаXML    = ЛокальныйКаталогOUTBOX + ДанныОФайле.ИмяФайла;
	ТитулПокупателя.Записать(ПолноеИмяФайлаXML);
	ФайлXML = Новый Файл(ПолноеИмяФайлаXML);

	ПолноеИмяФайлаBIN = ЛокальныйКаталогOUTBOX + ФайлXML.ИмяБезРасширения + ".bin";

	ДвоичныеДанныеФайлаXML = Новый ДвоичныеДанные(ПолноеИмяФайлаXML);

	//Пример. Формирует подпись для файла. Возвращает результат в виде двоичных данных.
	ЛогСобытий = "";
	Подпись = ЭЦП_СформироватьПодписьФайлаНаКлиенте(ДвоичныеДанныеФайлаXML, ДанныеСертификатаЭКОМ, ЛогСобытий);
	Если Подпись = Неопределено Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;

	УниверсальныйМетодОтправкиКвитанцийНаСеревере(ДанныеЗапроса.identifier, ТитулПокупателя, Подпись, Ошибка);
    Если Ошибка.ЕстьОшибка Тогда	
		Сообщить("При отправке титула покупателя возникла ошибка - Код: " + Ошибка.КодОшибки + " - " + Ошибка.ТекстОшибки);
		Возврат Неопределено;	
	КонецЕсли;

	//Реализация
	///////////////////////////////
	ЗаписатьВРегистрПослеОтправкиНаСервере(СтруктураСтроки, Тип, ДанныОФайле, Подпись);

	Возврат 1;

КонецФункции

