// + Получение дополнительной информации от провайдера по документу // Тест пройден 
// Параметры:
//	- ИД_Документа - Уникальный идентификатор документа
//	- Ошибка - Стандартный параметр см. ПолучитьСтруктуруОшибки
// Возвращает структуру дополнительной информации. См. "ПолучитьСтруктуруДополнительнойИнформации"
&НаСервере
Функция ПолучитьДополнительнуюИнформациюПровайдераНаСеревере(ИД_Документа, Тип, Ошибка, ПрофильОбмена, МассивЛогаСобытий) Экспорт
		
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	СтруктураРезультат = ОбработкаОбъект.ПолучитьДополнительнуюИнформациюПровайдера(ИД_Документа, Тип, Ошибка, ПрофильОбмена, МассивЛогаСобытий);
	
	Возврат СтруктураРезультат;
	
КонецФункции

// + Возвращает список необработанных событий // Тест пройден
//	- Ошибка - Стандартный параметр см. ПолучитьСтруктуруОшибки
&НаСервере
Функция ПолучитьНеобработанныеСобытияНаСервере(Ошибка, Количество, МассивЛогаСобытий) Экспорт
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ТаблицаСобытий  = ОбработкаОбъект.ПолучитьНеобработанныеСобытия(Ошибка, Количество, МассивЛогаСобытий);
	
	Возврат ТаблицаСобытий; // Заполненая таблица
	
КонецФункции

// Возвращает стандартную структуру сообщения об ошибке
&НаКлиенте
Функция ПолучитьСтруктуруОшибки()
	
	Структура = Новый Структура;
	Структура.Вставить("ЕстьОшибка" , Ложь);
	Структура.Вставить("КодОшибки"  , "");
	Структура.Вставить("ТекстОшибки", "");
	Возврат Структура;

КонецФункции

// Функция формирует запрос в формате JSON.
//
// Параметры:
//  ДанныеЗапроса  - Структура - данные для формирования запроса
//
// Возвращаемое значение:
//   Строка   - итоговый текст запроса
//
&НаСервере
Функция API_СформироватьЗапрос(ДанныеЗапроса) Экспорт

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ТекстЗапроса = ОбработкаОбъект.API_СформироватьЗапрос(ДанныеЗапроса);
	
	Возврат ТекстЗапроса;
	
КонецФункции // API_СформироватьЗапрос()

&НаСервере
Функция UnJSON(СтрJSON) Экспорт

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Значение = ОбработкаОбъект.UnJSON(СтрJSON);
	
	Возврат Значение;
	
КонецФункции

&НаСервере
Функция ВыполнитьЗапрос(Команда, ТелоЗапроса, HTTP_Метод, НеобходимоПолучитьТокен, Ошибка, ТокенАвторизации) Экспорт
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Ответ = ОбработкаОбъект.ВыполнитьЗапрос(Команда, ТелоЗапроса, HTTP_Метод, НеобходимоПолучитьТокен, Ошибка, ТокенАвторизации, ЭтаФОрма.АдресСервера, ЭтаФорма.Логин, ЭтаФорма.Пароль);
	
	Возврат Ответ;
	
КонецФункции

&НаСервере
Функция ПолучитьДату(ДатаXML) Экспорт 
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
