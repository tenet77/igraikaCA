&НаКлиенте
Процедура ПроверкаКодаНаФормеАРМЗавершение(Параметры)
    
    МассивЛогаСобытий = Параметры.МассивЛогаСобытий;
 	Если МассивЛогаСобытий.Количество() > 0  Тогда
		Попытка
			Выполнить("ЭКОМ_ОбщегоНазначения.ЗаписатьЛогСобытийвРегистрЛогирование(МассивЛогаСобытий);");
		Исключение
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий)");
			Сообщение.Сообщить();
		КонецПопытки;
	 Иначе
        КомментарийКТекстуЗапроса = "";

	КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура ПолучитьКолонкиТабличнойЧастиОбновитьТЗВидимостиКолонок(ТипДинамическогоСписка)
    
    ИмяНастройки = ?(ТипДинамическогоСписка = "Поставщик", "СлужебныйЗапросДляФормыПоставщика", "СлужебныйЗапросДляФормыПокупателя");
    
    ТекстКода        = НастройкаПрочитатьОбщийМодуль(ИмяНастройки, "", "Служебный");
    ИмяЭлементаФормы = "Группа" + ТипДинамическогоСписка;
    
    МассивЛогаСобытий = Новый Массив;
    ПараметрыПроверки = Новый Структура;
    ПараметрыПроверки.Вставить("Текст"           , ТекстКода);
	ПараметрыПроверки.Вставить("ИмяЭлементаФормы", ИмяЭлементаФормы);
	ПараметрыПроверки.Вставить("МассивЛогаСобытий"   , МассивЛогаСобытий);
	ПараметрыПроверки.Вставить("ЗакрытьПослеПроверки", Ложь);
	ПараметрыПроверки.Вставить("ФормаДляОповещения"  , "Обработка.УФ_Форма");
	
    Оповестить("ЭКОМ_ПроверитьФормулуНаФорме", ПараметрыПроверки);
    
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКолонкиТабличнойЧастиАРМаПоставщик(Команда)
	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("ТипОбмена", "Поставщик");
	ПараметрыОповещения.Вставить("ФормаДляОповещения", "Обработка.УФ_Форма");
    Оповестить("ОбновитьКолонкиДинамическогоСписка", ПараметрыОповещения);
