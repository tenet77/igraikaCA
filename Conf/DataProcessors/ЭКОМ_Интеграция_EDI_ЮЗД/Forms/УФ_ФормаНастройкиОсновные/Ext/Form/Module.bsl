&НаСервере
Процедура ЗаписатьНаСервере(ИзмененныеНастройки, СохранитьНастройки = Истина)
	
	Если НЕ СохранитьНастройки Тогда
	     Возврат;
	КонецЕсли;
		
	ОбъектЭтаОбработка = РеквизитФормыВЗначение("Объект");
	
	Для каждого Стр Из ИзмененныеНастройки Цикл	
		Если Лев(Стр.Ключ, 1) = "_" Тогда
		   ОбъектЭтаОбработка.Настройка_Параметр_Записать(Стр.Ключ, ДанныеФормыВЗначение(ЭтаФорма[Стр.Значение], Тип("ДеревоЗначений")));
		Иначе	
		   ОбъектЭтаОбработка.Настройка_Параметр_Записать(Стр.Ключ, Стр.Значение);
		КонецЕсли;
					 
	КонецЦикла;
	
	ЭтаФорма.СписокЗначенийИзмененныхНастроек.Очистить();
	ЭтаФорма.Модифицированность = Ложь;
    	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаписатьИЗакрыть(Команда)
	СохранитьИзмененныеНастройки(Истина);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаАлгоритмаЗаполнения(Строка, пПараметры)
	Если НЕ Строка = Неопределено Тогда 
		//Даем возможность передавать имя колонки, в которую пишется значение.
		Элементы[пПараметры.Имя].ТекущиеДанные[?(пПараметры.Свойство("Колонка"), пПараметры.Колонка, "Формула")] = Строка; 
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СтруктураФайлаXMLПриАктивизацииЯчейки(Элемент)
	
	Если Элементы.СтруктураФайлаXMLВходящие.ТекущиеДанные = Неопределено 
		ИЛИ Элемент.ТекущийЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПолеВвода = Элемент.ТекущийЭлемент;
	Родитель = ЭтаФорма.СтруктураФайлаXMLВходящие.НайтиПоИдентификатору(Элементы.СтруктураФайлаXMLВходящие.ТекущаяСтрока).ПолучитьРодителя();
	Строки = ЭтаФорма.СтруктураФайлаXMLВходящие.НайтиПоИдентификатору(Элементы.СтруктураФайлаXMLВходящие.ТекущаяСтрока).ПолучитьЭлементы();
	
	Если Элемент.ТекущийЭлемент.Имя = "СтруктураФайлаXMLВходящиеТипТранзакции" Тогда
		
		Если Родитель = Неопределено И ПолеВвода.СписокВыбора.Количество() = 0 Тогда
			
			МассивИменДокументов = Неопределено;
			СписокВыбора = Вычислить("ЭКОМ_ОбщегоНазначения.ДокументыСписокВыбораПолучить(""ТипТразакций"", МассивИменДокументов)");
			ПолеВвода.СписокВыбора.ЗагрузитьЗначения(СписокВыбора);
			
		ИначеЕсли НЕ Родитель = Неопределено И НЕ ПолеВвода.СписокВыбора.Количество() = 0 Тогда
			
			ПолеВвода.СписокВыбора.Очистить();
			
		КонецЕсли;
	КонецЕсли;
	
	// Установка высоты списка.
	Если ПолеВвода.Вид = ВидПоляФормы.ПолеВвода Тогда
		
		ВысотаСписка = ?(ПолеВвода.СписокВыбора.Количество() > 20, 20, ПолеВвода.СписокВыбора.Количество());
		
		Если НЕ ПолеВвода.ВысотаСпискаВыбора = ВысотаСписка Тогда
			ПолеВвода.ВысотаСпискаВыбора = ВысотаСписка;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМетаданные()
	    Возврат Метаданные.Документы;
КонецФункции

&НаКлиенте
Функция ПолучитьТипДокумента(ТекущийРодитель, ИмяТаблицы, РольДокумента)
	
	Корень = ТекущийРодитель;
	Пока НЕ Корень.ПолучитьРодителя()	= Неопределено Цикл
		Корень = Корень.ПолучитьРодителя();
	КонецЦикла;
	
	Если ИмяТаблицы = "СтруктураФайлаXMLИсходящие" Тогда
		    ТипДокумента = Корень.Источник;
	Иначе		
		Если РольДокумента = "Приемник" Тогда
			ТипДокумента = Корень.Приемник;
		Иначе	
			ТипДокумента = Корень.Источник;
		КонецЕсли;
	КонецЕсли;	
	
	Возврат ТипДокумента;
	
КонецФункции

&НаКлиенте
Процедура СтруктураФайлаXMLВходящиеФормулаОткрытие(Элемент, СтандартнаяОбработка)
		
	СтандартнаяОбработка 	= Ложь;
	Строки = Элементы[Элемент.Родитель.Имя].ТекущиеДанные.ПолучитьЭлементы();
	
	Если НЕ Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТипДокументаПриемника = ПолучитьТипДокумента(Элементы[Элемент.Родитель.Имя].ТекущиеДанные, Элемент.Родитель.Имя, "Приемник");	
	ТипДокументаИсточника = ПолучитьТипДокумента(Элементы[Элемент.Родитель.Имя].ТекущиеДанные, Элемент.Родитель.Имя, "Источник");	
		
	ИмяОткрываемойФормы = ЭтаФорма.СлужебныйПолноеИмяФормы + ".Форма.УФ_ФормаКонсольЗапросов";
	ДопПараметры = Новый Структура;
    ДопПараметры.Вставить("ИмяТабличнойЧасти", Элемент.Родитель.Имя);
	ДопПараметры.Вставить("ИмяФормы"         , "УФ_ФормаКонсольЗапросов");
	ДопПараметры.Вставить("ИмяЭлементаФормы" , "СтруктураФайлаXMLДокументыФормула");	

	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ОбработкаЗакрытия", ЭтаФорма, ДопПараметры);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок"            , "Введите алгоритм для заполнения поля (тега) файла");
	ПараметрыФормы.Вставить("ТипДокументаПриемника", ТипДокументаПриемника);
	ПараметрыФормы.Вставить("ТипДокументаИсточника", ТипДокументаИсточника);
	ПараметрыФормы.Вставить("ТекстНачальный"       , Элементы[Элемент.Родитель.Имя].ТекущиеДанные.Формула);
    
    ПараметрыФормы.Вставить("ДопПараметры", ДопПараметры);
    
	ОткрытьФорму(ИмяОткрываемойФормы, ПараметрыФормы,,,,,ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
			
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаЗакрытия(Результат, ДопПараметры) Экспорт

     НастройкаЗаписана = Ложь;
	 ИзмененияОтсутствуют = Не ЭтаФорма.Модифицированность;
	 
    Если ДопПараметры.ИмяФормы = "УФ_ФормаКонсольЗапросов" 
        И ТипЗнч(Результат) = Тип("Структура") Тогда
        
        Если Результат.Изменен = Ложь Тогда
            Состояние("Код не был изменен!. Нечего сохранять", ,, БиблиотекаКартинок.Записать);
        Иначе 
            ЭтаФорма.Модифицированность = Истина;
        КонецЕсли;
        
        Если Результат.Изменен 
             И ДопПараметры.ИмяЭлементаФормы = "СтруктураФайлаXMLИсходящиеСлужебные" Тогда
             
            ПараметрыДанные = Новый Структура;
            ПараметрыДанные.Вставить("ИдентификаторСтроки", Элементы[ДопПараметры.ИмяТабличнойЧасти].ТекущаяСтрока);
            ПараметрыДанные.Вставить("Имя"    , ДопПараметры.ИмяТабличнойЧасти);
            ПараметрыДанные.Вставить("Колонка", "Служебные");
            ПослеВводаАлгоритмаЗаполнения(СокрЛП(Результат.Текст), ПараметрыДанные);
            
        ИначеЕсли Результат.Изменен 
             И ДопПараметры.ИмяЭлементаФормы = "СтруктураФайлаXMLДокументыФормула" Тогда
             
            ПараметрыДанные = Новый Структура;
            ПараметрыДанные.Вставить("ИдентификаторСтроки", Элементы[ДопПараметры.ИмяТабличнойЧасти].ТекущаяСтрока);
            ПараметрыДанные.Вставить("Имя"    , ДопПараметры.ИмяТабличнойЧасти);
            ПослеВводаАлгоритмаЗаполнения(СокрЛП(Результат.Текст), ПараметрыДанные);
			
			ИмяЭлемента = "СтруктураФайлаXMLДокументы";
			ЗаполнитьСписокДляИзменения(ИмяЭлемента, "_" + ИмяЭлемента);    			
        ИначеЕсли Результат.Изменен 
            И (ДопПараметры.ИмяЭлементаФормы = "СтруктураФайлаXMLВходящиеСлужебныеТекст"
			ИЛИ ДопПараметры.ИмяЭлементаФормы = "СтруктураФайлаXMLДокументыСлужебныеТекст") Тогда
            
            Элементы[ДопПараметры.ИмяТабличнойЧасти].ТекущиеДанные.Служебные = Результат.Текст;     
            ЭтаФорма.ЭтаФорма.Модифицированность = Истина;
        ИначеЕсли Результат.Изменен 
            И ДопПараметры.ИмяЭлементаФормы = "СтруктураФайлаXMLИсходящиеДанные" Тогда
            
            Элементы[ДопПараметры.ИмяТабличнойЧасти].ТекущиеДанные.Данные = Результат.Текст;    
            Колонки = Новый СписокЗначений;
            Для Каждого Колонка Из Результат.Значение Цикл
                Колонки.Добавить(Колонка.КолонкаКлюч);
            КонецЦикла;
            Элементы[ДопПараметры.ИмяТабличнойЧасти].ТекущиеДанные.ДоступныеЗначения.Очистить();
            Элементы[ДопПараметры.ИмяТабличнойЧасти].ТекущиеДанные.ДоступныеЗначения = Колонки;         
            
        ИначеЕсли Результат.Изменен 
            И ДопПараметры.ИмяЭлементаФормы = "ГруппаПоставщик" Тогда
            
            ПараметрыФункции = Новый Массив;
            ПараметрыФункции.Добавить("_СлужебныйЗапросДляФормыПоставщика");        
            ПараметрыФункции.Добавить(Результат.Текст);
            ПараметрыФункции.Добавить("Служебный");
            НастройкаЗаписана = ВернутьРезультатИзМодуляОбъекта("Настройка_Параметр_Записать", ПараметрыФункции);
            ОбновитьВсеРолиНаСервере();
            ЭтаФорма.ЭтаФорма.Модифицированность = ?(ИзмененияОтсутствуют, Ложь, Истина);
			
		ИначеЕсли ДопПараметры.ИмяЭлементаФормы = "ГруппаПрайсЛист"
			И (Результат.Изменен = Истина
			ИЛИ Результат.ДопПараметры.ЗаписатьЗапрос = Истина) Тогда
            
            ПараметрыФункции = Новый Массив;
            ПараметрыФункции.Добавить("_СлужебныйЗапросДляФормыПрайсЛист");        
            ПараметрыФункции.Добавить(Результат.Текст);
            ПараметрыФункции.Добавить("Служебный");
            НастройкаЗаписана = ВернутьРезультатИзМодуляОбъекта("Настройка_Параметр_Записать", ПараметрыФункции);
            ОбновитьВсеРолиНаСервере();
            ЭтаФорма.ЭтаФорма.Модифицированность = ?(ИзмененияОтсутствуют, Ложь, Истина);

        ИначеЕсли Результат.Изменен 
            И ДопПараметры.ИмяЭлементаФормы = "ГруппаПокупатель" Тогда
            
            ПараметрыФункции = Новый Массив;
            ПараметрыФункции.Добавить("_СлужебныйЗапросДляФормыПокупателя");        
            ПараметрыФункции.Добавить(Результат.Текст);
            ПараметрыФункции.Добавить("Служебный");
            НастройкаЗаписана = ВернутьРезультатИзМодуляОбъекта("Настройка_Параметр_Записать", ПараметрыФункции);
            ОбновитьВсеРолиНаСервере();
            ЭтаФорма.ЭтаФорма.Модифицированность = ?(ИзмененияОтсутствуют, Ложь, Истина);
			
        ИначеЕсли Результат.Изменен 
            И ДопПараметры.ИмяЭлементаФормы = "АвтоОбмен" Тогда
            
            ПараметрыФункции = Новый Массив;
            ПараметрыФункции.Добавить(ДопПараметры.ИмяЗапроса); 
            ПараметрыФункции.Добавить(Результат.Текст);
            ПараметрыФункции.Добавить("Служебный");
            НастройкаЗаписана = ВернутьРезультатИзМодуляОбъекта("Настройка_Параметр_Записать", ПараметрыФункции);
			
		ИначеЕсли Результат.Изменен 
			И ДопПараметры.ИмяЭлементаФормы = "ГруппаЭТРН" Тогда
			
			ПараметрыФункции = Новый Массив;
			ПараметрыФункции.Добавить("_СлужебныйЗапросДляФормыЭТРН");		
			ПараметрыФункции.Добавить(Результат.Текст);
			ПараметрыФункции.Добавить("Служебный");
			НастройкаЗаписана = ВернутьРезультатИзМодуляОбъекта("Настройка_Параметр_Записать", ПараметрыФункции);
			ОбновитьВсеРолиНаСервере();
            ЭтаФорма.ЭтаФорма.Модифицированность = ?(ИзмененияОтсутствуют, Ложь, Истина);
			
		ИначеЕсли Результат.Изменен 
			И ДопПараметры.ИмяЭлементаФормы = "ПодпискаДляДокументовПоставщик" Тогда
			
			ПараметрыФункции = Новый Массив;
			ПараметрыФункции.Добавить("_СлужебныйЗапросДляПодпискиДокументовПоставщик");		
			ПараметрыФункции.Добавить(Результат.Текст);
			ПараметрыФункции.Добавить("Служебный");
			НастройкаЗаписана = ВернутьРезультатИзМодуляОбъекта("Настройка_Параметр_Записать", ПараметрыФункции);
            ЭтаФорма.ЭтаФорма.Модифицированность = ?(ИзмененияОтсутствуют, Ложь, Истина);
			
		ИначеЕсли Результат.Изменен 
			И ДопПараметры.ИмяЭлементаФормы = "ПодпискаДляДокументовСеть" Тогда
			
			ПараметрыФункции = Новый Массив;
			ПараметрыФункции.Добавить("_СлужебныйЗапросДляПодпискиДокументовСеть");		
			ПараметрыФункции.Добавить(Результат.Текст);
			ПараметрыФункции.Добавить("Служебный");
			НастройкаЗаписана = ВернутьРезультатИзМодуляОбъекта("Настройка_Параметр_Записать", ПараметрыФункции);
            ЭтаФорма.ЭтаФорма.Модифицированность = ?(ИзмененияОтсутствуют, Ложь, Истина);
			
		ИначеЕсли Результат.Изменен 
			И ДопПараметры.ИмяЭлементаФормы = "ПодпискаДляДокументовЭТРН" Тогда
			
			ПараметрыФункции = Новый Массив;
			ПараметрыФункции.Добавить("_СлужебныйЗапросДляПодпискиДокументовЭТРН");		
			ПараметрыФункции.Добавить(Результат.Текст);
			ПараметрыФункции.Добавить("Служебный");
			НастройкаЗаписана = ВернутьРезультатИзМодуляОбъекта("Настройка_Параметр_Записать", ПараметрыФункции);
            ЭтаФорма.ЭтаФорма.Модифицированность = ?(ИзмененияОтсутствуют, Ложь, Истина);
			
		ИначеЕсли Результат.Изменен 
			И ДопПараметры.ИмяЭлементаФормы = "ГруппаCondra" Тогда
			
			ПараметрыФункции = Новый Массив;
			ПараметрыФункции.Добавить("_СлужебныйЗапросДляФормыCondra");		
			ПараметрыФункции.Добавить(Результат.Текст);
			ПараметрыФункции.Добавить("Служебный");
			НастройкаЗаписана = ВернутьРезультатИзМодуляОбъекта("Настройка_Параметр_Записать", ПараметрыФункции);
			ОбновитьВсеРолиНаСервере();
            ЭтаФорма.ЭтаФорма.Модифицированность = ?(ИзмененияОтсутствуют, Ложь, Истина);
			
		ИначеЕсли Результат.Изменен 
			И ДопПараметры.ИмяЭлементаФормы = "ПодпискаДляДокументовCondra" Тогда
			
			ПараметрыФункции = Новый Массив;
			ПараметрыФункции.Добавить("_СлужебныйЗапросДляПодпискиДокументовCondra");		
			ПараметрыФункции.Добавить(Результат.Текст);
			ПараметрыФункции.Добавить("Служебный");
			НастройкаЗаписана = ВернутьРезультатИзМодуляОбъекта("Настройка_Параметр_Записать", ПараметрыФункции);
            ЭтаФорма.ЭтаФорма.Модифицированность = ?(ИзмененияОтсутствуют, Ложь, Истина);
			
        КонецЕсли;
        		
		Если ДопПараметры.Свойство("ИмяТабличнойЧасти") Тогда
			
			Если ДопПараметры.Свойство("ИмяЭлементаФормы") = Истина 
				И НЕ ДопПараметры.ИмяЭлементаФормы = "ПодпискаДляДокументовЭТРН" Тогда
				
				СтруктураФайлаXMLПриАктивизацииЯчейки(Элементы[ДопПараметры.ИмяТабличнойЧасти]);
				
			КонецЕсли;
			
		КонецЕсли;
            
    ИначеЕсли ДопПараметры.ИмяФормы = "УФ_ФормаНастройкиСлужебные" 
              И ТипЗнч(Результат) = Тип("Структура") Тогда  
              
        Если НЕ ТипЗнч(ДопПараметры.ЭлементТекущиеДанные) = Тип(Результат.Тип) Тогда
            ДопПараметры.ЭлементТекущиеДанные = Вычислить("Новый " + Результат.Тип);
        КонецЕсли;
        
        Если Результат.Редактирование Тогда
            ДопПараметры.ЭлементТекущиеДанные.Очистить();
        КонецЕсли;
        
         Для Каждого Строка Из Результат.ТабличноеПоле Цикл
			Если Результат.Тип = "Структура" Тогда
				Если ЗначениеЗаполнено(Строка.Реквизит) Тогда
				     ДопПараметры.ЭлементТекущиеДанные.Вставить(Строка.Реквизит, Строка.Формула);
				 КонецЕсли;
            ИначеЕсли Результат.Тип = "СписокЗначений" Тогда
                ДопПараметры.ЭлементТекущиеДанные.Добавить(Строка.Реквизит, Строка.Формула, Строка.Обязательный);
            КонецЕсли;
        КонецЦикла;
        
        Если ДопПараметры.ИмяЭлементаФормы = "СтруктураФайлаXMLИсходящиеКнопка"
			ИЛИ ДопПараметры.ИмяЭлементаФормы = "СтруктураФайлаXMLВходящиеКнопка"
			ИЛИ ДопПараметры.ИмяЭлементаФормы = "СтруктураФайлаXMLДокументыКнопка" Тогда
			Элементы[ДопПараметры.ИмяТабличнойЧасти].ТекущиеДанные.КоллекцияТЧ = ДопПараметры.ЭлементТекущиеДанные;
			Элементы[ДопПараметры.ИмяТабличнойЧасти].ТекущиеДанные.Кнопка = ?(ДопПараметры.ЭлементТекущиеДанные.НайтиПоЗначению("ИмяКнопки") = Неопределено, "", ДопПараметры.ЭлементТекущиеДанные.НайтиПоЗначению("ИмяКнопки").Представление);
			
		ИначеЕсли Найти(ДопПараметры.ИмяЭлементаФормы, "Атрибуты") > 0 Тогда
			Если Элементы[ДопПараметры.ИмяТабличнойЧасти].ТекущиеДанные.Атрибуты = Неопределено Тогда
				Элементы[ДопПараметры.ИмяТабличнойЧасти].ТекущиеДанные.Атрибуты = ДопПараметры.ЭлементТекущиеДанные;   
			КонецЕсли;	
			
		Иначе
			Если Элементы[ДопПараметры.ИмяТабличнойЧасти].ТекущиеДанные.Служебные = Неопределено Тогда
				Элементы[ДопПараметры.ИмяТабличнойЧасти].ТекущиеДанные.Служебные = ДопПараметры.ЭлементТекущиеДанные;   
			КонецЕсли;
			
		КонецЕсли;
        
    ИначеЕсли ДопПараметры.ИмяФормы = "УФ_ФормаСвязи" И ТипЗнч(Результат) = Тип("Структура") Тогда 
        
        Если НЕ ТипЗнч(ДопПараметры.ЭлементТекущиеДанные) = Тип("СписокЗначений") Тогда
            ДопПараметры.ЭлементТекущиеДанные = Новый СписокЗначений;
        КонецЕсли;
        
        ДопПараметры.ЭлементТекущиеДанные.Очистить();
        
        Для Каждого Строка Из Результат.ТабличноеПоле Цикл
            ДопПараметры.ЭлементТекущиеДанные.Добавить(Строка.ЛевоеПоле, Строка.ПравоеПоле);
        КонецЦикла;
        
        Если НастройкаЗаписана = 1 Или НастройкаЗаписана = Истина Тогда
        Состояние("Код записан в настройки", ,, БиблиотекаКартинок.Записать);
        //здесь может быть обновление кэша формы
    КонецЕсли;
    
    ИначеЕсли ДопПараметры.ИмяФормы = "УФ_ФормаКонтрагента"  Тогда 
        Элементы.СписокКонтрагентов.Обновить(); 
    ИначеЕсли ДопПараметры.ИмяФормы = "УФ_ФормаОрганизации"  Тогда 
        Элементы.СписокОрганизаций.Обновить();  
    ИначеЕсли ДопПараметры.ИмяФормы = "УФ_ФормаТочкиДоставки"  Тогда 
        Элементы.СписокТочекДоставок.Обновить();
    ИначеЕсли ДопПараметры.ИмяФормы = "УФ_ФормаНастройкиСоответсвий" Тогда 
        Элементы.СписокСоответствий.Обновить();
    ИначеЕсли ДопПараметры.ИмяФормы = "УФ_ФормаВводаПароля" Тогда       
        ЭтаФорма.ЭКОМ_ИспПарольДляНастроек = Результат.ИспользоватьПароль;
        
        Если Результат.ПарольИзБазы = Результат.Пароль Тогда
			ПарольВведенВерно = Истина;
		Иначе
			Состояние("Пароль не корректен!");
		КонецЕсли;
		УправлениеВидимостью();
		
	ИначеЕсли ДопПараметры.ИмяФормы = "УФ_ГибкиеНастройкиОнлайн" Тогда  
		 
		Если ДопПараметры.ТипГибкихНастроек = "Исходящие настройки" Тогда
			ИмяРеквизитаФормы = "СтруктураФайлаXMLИсходящие";
		    ОбновитьСтруктуруДереваСтруктураФайлаXML(Результат.СтруктураФайлаXMLИсходящие, ИмяРеквизитаФормы);			
			ЗаполнитьСписокДляИзменения(ИмяРеквизитаФормы, "_" + ИмяРеквизитаФормы);
		ИначеЕсли ДопПараметры.ТипГибкихНастроек = "Входящие настройки" Тогда
			ИмяРеквизитаФормы = "СтруктураФайлаXMLВходящие";
	        ОбновитьСтруктуруДереваСтруктураФайлаXML(Результат.СтруктураФайлаXMLВходящие, ИмяРеквизитаФормы);
			ЗаполнитьСписокДляИзменения(ИмяРеквизитаФормы, "_" + ИмяРеквизитаФормы);
		ИначеЕсли ДопПараметры.ТипГибкихНастроек = "Настройки по созданию документов" Тогда
			ИмяРеквизитаФормы = "СтруктураФайлаXMLДокументы";
            ОбновитьСтруктуруДереваСтруктураФайлаXML(Результат.СтруктураФайлаXMLДокументы, ИмяРеквизитаФормы);
			ЗаполнитьСписокДляИзменения(ИмяРеквизитаФормы, "_" + ИмяРеквизитаФормы);
		КонецЕсли;
  	
    КонецЕсли;
    
    Если НастройкаЗаписана = 1 Или НастройкаЗаписана = Истина Тогда
        Состояние("Код записан в настройки", ,, БиблиотекаКартинок.Записать);
        //здесь может быть обновление кэша формы
    КонецЕсли;

КонецПроцедуры 

