&НаКлиенте
Процедура ОбновитьСписокПоИмениСтраницы(ИмяСтраницы);
    
    Если ИмяСтраницы = "ГруппаОрганизации" Тогда
        Элементы.СписокОрганизаций.Обновить();
	ИначеЕсли ИмяСтраницы = "ГруппаКонтрагенты" Тогда
		Элементы.СписокКонтрагентов.Обновить();
	ИначеЕсли ИмяСтраницы = "ГруппаТочкиДоставки" Тогда
		Элементы.СписокТочекДоставок.Обновить();
	ИначеЕсли ИмяСтраницы = "ГруппаНоменклатура_Контрагентов" Тогда
		Элементы.СписокНоменклатурыКонтрагентов.Обновить();
	ИначеЕсли ИмяСтраницы = "ГруппаНастройкаСоответсвий" Тогда
		Элементы.СписокСоответствий.Обновить();
	ИначеЕсли ИмяСтраницы = "ГруппаОбновления" Тогда
		ЗаполнитьИсториюТаблицыОбновлений();
	КонецЕсли;

КонецПроцедуры

