	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ДоступностьAPI = ОбработкаОбъект.ПолучитьДоступностьApiПоСтране();
	Возврат ДоступностьAPI;
КонецФункции

&НаКлиенте
Процедура СписокОбновленийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если НЕ Элемент.ТекущиеДанные = Неопределено Тогда	
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ВерсияМодуля"   , Элемент.ТекущиеДанные.ВерсияМодуля);	
		ПараметрыФормы.Вставить("ДатаОбработки"  , Элемент.ТекущиеДанные.ДатаОбработки);	
        ПараметрыФормы.Вставить("Описание"       , Элемент.ТекущиеДанные.Описание);	
		ПараметрыФормы.Вставить("СтатусОбработки", Элемент.ТекущиеДанные.СтатусОбработки);	
		ПараметрыФормы.Вставить("ЭКОМОбъектыАктуальны", ЭтаФорма.ЭКОМОбъектыАктуальны);	
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ИмяФормы", "УФ_ФормаОбновления");
		
		ОповещениеОЗакрытии = Новый ОписаниеОповещения("ОбработкаЗакрытия", ЭтаФорма, ДопПараметры);	
		ОткрытьФорму(ЭтаФорма.СлужебныйПолноеИмяФормы + ".Форма.УФ_ФормаОбновления", ПараметрыФормы, ЭтаФорма,,,, ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник) Экспорт
	
	Если ИмяСобытия = "ОбновленПрофильОбмена" Тогда 
		ДоступностьAPI = ПолучитьДоступностьApiПоСтранеНаСервере();
		Элементы.КомандаДанныеКонтрагентаПоAPI.Видимость = ДоступностьAPI;	
	КонецЕсли;
	
	ФормаДляОповещения = Неопределено;
	Если ТипЗнч(Параметр) = Тип("Структура") Тогда
	     Параметр.Свойство("ФормаДляОповещения", ФормаДляОповещения);
	КонецЕсли;
	
	Если ФормаДляОповещения = "Обработка.УФ_ФормаНастройкиОсновные" Тогда
		
		Если ИмяСобытия = "ОбработкаЗакрытия" Тогда
			ОбработкаЗакрытия(Параметр, Параметр.ДопПараметры);
			
		ИначеЕсли ИмяСобытия = "ЭКОМ_КонецПроверкиФормулыНаФорме" Тогда
			ПроверкаКодаНаФормеАРМЗавершение(Параметр);
		КонецЕсли;
	
	КонецЕсли;
      
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаписать(Команда)
	СохранитьИзмененныеНастройки();
КонецПроцедуры

&НаКлиенте
Процедура ЭКОМ_ИспПарольДляНастроекПриИзменении(Элемент)
	
	Если ЭтаФорма.ЭКОМ_ИспПарольДляНастроек Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("УстановитьПароль", Истина);
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ИмяФормы", "УФ_ФормаВводаПароля");
		
		ОповещениеОЗакрытии = Новый ОписаниеОповещения("ОбработкаЗакрытия", ЭтаФорма, ДопПараметры);	
		ОткрытьФорму(ЭтаФорма.СлужебныйПолноеИмяФормы + ".Форма.УФ_ФормаВводаПароля", ПараметрыФормы, ЭтаФорма,,,, ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	КонецЕсли;	

	ПараметрыФункции = Новый Массив;
	ПараметрыФункции.Добавить("ЭКОМ_ИспПарольДляНастроек");
	ПараметрыФункции.Добавить(ЭтаФорма.ЭКОМ_ИспПарольДляНастроек);
	ПараметрыФункции.Добавить(Неопределено);
	ВернутьРезультатИзМодуляОбъекта("Настройка_Параметр_Записать", ПараметрыФункции);
		
КонецПроцедуры


&НаКлиенте
Процедура КомандаЗаполнитьПодчиненныеВходящие(Команда)
	
	Если Элементы.ГруппаНастройкиДокументовСтраницы.ТекущаяСтраница.Имя = "ГруппаДокументы1С" Тогда
		ЗаполнитьПодчиненныеСтрокиСтруктурыФайлаXML("СтруктураФайлаXMLВходящие");
	ИначеЕсли Элементы.ГруппаНастройкиДокументовСтраницы.ТекущаяСтраница.Имя = "ГруппаДокументы" Тогда
		ЗаполнитьПодчиненныеСтрокиСтруктурыФайлаXML("СтруктураФайлаXMLДокументы");
	КонецЕсли;
	
КонецПроцедуры

//Описание универсальная процедура заполнения подчиненных строк дерева гибких настроек
&НаКлиенте
Процедура ЗаполнитьПодчиненныеСтрокиСтруктурыФайлаXML(ИмяЭлементаФормы_СтруктураФайлаXML = "СтруктураФайлаXMLВходящие")
	
    ТекущиеДанные  = Элементы[ИмяЭлементаФормы_СтруктураФайлаXML].ТекущиеДанные;	
	Пока НЕ ТекущиеДанные.ПолучитьРодителя() = Неопределено Цикл
 		 ТекущиеДанные = ТекущиеДанные.ПолучитьРодителя();
	КонецЦикла;
	
	Данные = Новый Структура;	
	Данные.Вставить("ТипТранзакции", ТекущиеДанные.ТипТранзакции);
	Данные.Вставить("Процедура"    , "ЗаполнитьПодчиненныеСтрокиСтруктурыФайлаXML");
	
	Если НЕ ТекущиеДанные.ПолучитьЭлементы().Количество() = 0 Тогда
		
		Оповещение = Новый ОписаниеОповещения("ОповещениеПослеОтветаНаВопрос", ЭтаФорма, Данные); 
		ПоказатьВопрос(Оповещение, "Подчиненные строки будут удалены. 
        |Продолжить?", РежимДиалогаВопрос.ДаНет, 0);	
		
	Иначе
		
		ЗаполнитьДеревоПоДокументу1С(Данные);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеПослеОтветаНаВопрос(Результат, Данные) Экспорт 
	
	Если Данные.Процедура =  "ЗаполнитьПодчиненныеСтрокиСтруктурыФайлаXML" 
		И Результат = КодВозвратаДиалога.Да Тогда
	
		ЗаполнитьДеревоПоДокументу1С(Данные);
		
	ИначеЕсли Данные.Процедура =  "ПередЗакрытием" 
		И Результат = КодВозвратаДиалога.Да Тогда
            СохранитьИзмененныеНастройки(Истина);
	КонецЕсли;
		
КонецПроцедуры

