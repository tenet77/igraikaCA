&НаСервере
Процедура ОтборДинамическогоСписка(ИмяСписка)
    
    ДинамическийСписокДляОбработки = ЭтаФорма[ИмяСписка];
	ДинамическийСписокДляОбработки.Отбор.Элементы.Очистить();
	
	ИмяПоляСписка = Неопределено;
	
	Если ИмяСписка = "СписокОрганизация" Тогда
		ЗначениеОтбора = ЭтаФорма.ОрганизацияОтбор;
        ИмяПоляСписка  = "Организация";
    ИначеЕсли ИмяСписка = "СписокКонтрагентов" Тогда
        ЗначениеОтбора = ЭтаФорма.КонтрагентОтбор;
        ИмяПоляСписка  = "Контрагент";
    ИначеЕсли ИмяСписка = "СписокТочекДоставок" Тогда
		ЗначениеОтбора = ЭтаФорма.Владелец;
		ИмяПоляСписка  = "ТочкаДоставки";
	ИначеЕсли ИмяСписка = "СписокСоответствий" Тогда
		Если НЕ ЭтаФорма.ФильтрПоСоответствиям.Количество() = 0 Тогда
			ЗначениеОтбора = ЭтаФорма.ФильтрПоСоответствиям[0].Значение;
			ИмяПоляСписка  = "Тип";
		КонецЕсли;
	КонецЕсли;
    
	Если ИмяПоляСписка = Неопределено 
		ИЛИ ЗначениеЗаполнено(ЗначениеОтбора) = Ложь Тогда     
        Возврат;
    КонецЕсли;
	
	ЭлементОтбора = ДинамическийСписокДляОбработки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));      
    ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(ИмяПоляСписка);
    ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
    ЭлементОтбора.ПравоеЗначение = ЗначениеОтбора;
    ЭлементОтбора.ИдентификаторПользовательскойНастройки = ИмяСписка;
    
КонецПроцедуры
