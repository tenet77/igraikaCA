	Возврат ТекстЗапроса; 
КонецФункции

&НаКлиенте
Процедура СтруктураФайлаXMLВходящиеПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Корень = Элемент.ТекущиеДанные;
	Пока НЕ Корень.ПолучитьРодителя()	= Неопределено Цикл
		Корень = Корень.ПолучитьРодителя();
	КонецЦикла;

	// Запрещаем добавление строк для входящих ORDER и RECADV, а также при отсутствующем типе транзакции.
	Отказ = Корень.ТипТранзакции = "Входящий ORDER" ИЛИ Корень.ТипТранзакции = "Входящий RECADV"
	ИЛИ ПустаяСтрока(Корень.ТипТранзакции);	

КонецПроцедуры

&НаКлиенте
Процедура ТочкиДоставкиДобавить(Команда)
	ОткрытьФорму(ЭтаФорма.СлужебныйПолноеИмяФормы + ".Форма.УФ_ФормаТочкиДоставки", ,,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура СтруктураФайлаXMLИсходящиеПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если Элементы.СтруктураФайлаXMLИсходящие.ТекущиеДанные = Неопределено
		ИЛИ НЕ Элемент.ТекущийЭлемент.Вид = ВидПоляФормы.ПолеВвода Тогда
		Возврат;
	КонецЕсли;
	
	ПолеВвода 				 = Элемент.ТекущийЭлемент;
	Родитель 				 = Элементы.СтруктураФайлаXMLИсходящие.ТекущиеДанные.ПолучитьРодителя();
	Строки 					 = Элементы.СтруктураФайлаXMLИсходящие.ТекущиеДанные.ПолучитьЭлементы();
	СписокВыбора 			 = Новый Массив;
	ПолеВвода.ТолькоПросмотр = Истина;
	ПолеВвода.СписокВыбора.Очистить();
	
	// Определение направления транзакции.
	Корень = Элементы.СтруктураФайлаXMLИсходящие.ТекущиеДанные;
	Пока НЕ Корень.ПолучитьРодителя()	= Неопределено Цикл
		Корень = Корень.ПолучитьРодителя();
	КонецЦикла;
	
	ЭКОМ_ОбменСеть      = НастройкаПрочитатьОбщийМодуль("ЭКОМ_ОбменСеть"     , Истина);
    ЭКОМ_ОбменПоставщик = НастройкаПрочитатьОбщийМодуль("ЭКОМ_ОбменПоставщик", Истина);
	ЭКОМ_ОбменЭТРН      = НастройкаПрочитатьОбщийМодуль("ЭКОМ_ОбменЭТРН"     , Истина);

	Если Элемент.ТекущийЭлемент.Имя = "СтруктураФайлаXMLИсходящиеТипТранзакции" И Родитель = Неопределено Тогда
		
		СписокВыбора 	= Вычислить("ЭКОМ_ОбщегоНазначения.ДокументыСписокВыбораПолучить(""ТипТразакций"")");
				
		ПолеВвода.СписокВыбора.ЗагрузитьЗначения(СписокВыбора);
		ПолеВвода.ТолькоПросмотр = Ложь;
		
	ИначеЕсли Элемент.ТекущийЭлемент.Имя = "СтруктураФайлаXMLИсходящиеИсточник"
			И Родитель = Неопределено Тогда
			
			ДанныеПоКолонкам = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьДанныеПоКолонкамИсточника()");
			Для каждого Данные Из ДанныеПоКолонкам Цикл
				СписокВыбора.Добавить(Данные.Ключ);
			КонецЦикла;
		
			ПолеВвода.ТолькоПросмотр = Ложь;
			
	ИначеЕсли Элемент.ТекущийЭлемент.Имя = "СтруктураФайлаXMLИсходящиеПриемник" Тогда

			ПолеВвода.РежимВыбораИзСписка 		= Ложь;
			ПолеВвода.РедактированиеТекста 		= Истина;
			ПолеВвода.ТолькоПросмотр = Ложь;
	
	ИначеЕсли Элемент.ТекущийЭлемент.Имя = "СтруктураФайлаXMLИсходящиеДанные" Тогда
		
		Если Строки.Количество() = 0 Тогда // Только выбор из списка.
			ПолеВвода.РежимВыбораИзСписка 		= Истина;
			ПолеВвода.КнопкаОчистки 			= Истина;
			ПолеВвода.КнопкаОткрытия			= Ложь;
			ПолеВвода.РедактированиеТекста 		= Ложь;
			
			СписокВыбора = ПолучитьКоллекциюДоступныхРеквизитов(Элементы.СтруктураФайлаXMLИсходящие.ТекущиеДанные).ВыгрузитьЗначения();
			
			ПолеВвода.ТолькоПросмотр = Ложь;
		Иначе // Позволяем писать код.
			ПолеВвода.РежимВыбораИзСписка 		= Ложь;
			ПолеВвода.КнопкаОчистки 			= Ложь;
			ПолеВвода.КнопкаОткрытия			= Истина;
			ПолеВвода.РедактированиеТекста 		= Ложь; // Не позволяем писать текст. Код редактируется только в окне конструктора, чтобы была возможность его выполнить.
			ПолеВвода.ТолькоПросмотр = Ложь;
		КонецЕсли;
		
	ИначеЕсли Элемент.ТекущийЭлемент.Имя = "СтруктураФайлаXMLИсходящиеКнопка" Тогда
		ПолеВвода.ТолькоПросмотр = Ложь;
	КонецЕсли;
	
	Для каждого Эл Из СписокВыбора Цикл
	    ПолеВвода.СписокВыбора.Добавить(Эл);
	КонецЦикла;
		
	// Установка высоты списка.
	Если ПолеВвода.Вид = ВидПоляФормы.ПолеВвода Тогда		
		ВысотаСписка = ?(ПолеВвода.СписокВыбора.Количество() > 20, 20, ПолеВвода.СписокВыбора.Количество());	
		Если НЕ ПолеВвода.ВысотаСпискаВыбора = ВысотаСписка Тогда
			ПолеВвода.ВысотаСпискаВыбора = ВысотаСписка;
		КонецЕсли;		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КонтрагентыДобавить(Команда)
	ОткрытьФорму(ЭтаФорма.СлужебныйПолноеИмяФормы + ".Форма.УФ_ФормаКонтрагента", ,,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура СписокНоменклатурыКонтрагентовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Контрагент"                , Элемент.ТекущиеДанные.Контрагент);
	Отбор.Вставить("Номенклатура"              , Элемент.ТекущиеДанные.Номенклатура);
	Отбор.Вставить("ХарактеристикаНоменклатуры", Элемент.ТекущиеДанные.Характеристика);

	Структура = Новый Структура("Ключ", ПолучитьКлючЭКОМ_НоменклатураКонтрагентов(Отбор));
	
	ОткрытьФорму("РегистрСведений.ЭКОМ_НоменклатураКонтрагентов.ФормаЗаписи", Структура, ,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

