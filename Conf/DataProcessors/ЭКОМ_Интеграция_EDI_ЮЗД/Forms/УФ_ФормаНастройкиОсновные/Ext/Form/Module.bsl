&НаКлиенте
Процедура ПередСохранениемНастроекДокументов(Результат = Неопределено, Параметры = Неопределено) Экспорт
	
	Если ТипЗнч(Результат) = Тип("КодВозвратаДиалога") И Результат = КодВозвратаДиалога.ОК Тогда
		ВызватьДиалог = Ложь;
		СохранитьИзмененныеНастройки(, ВызватьДиалог);
	ИначеЕсли ТипЗнч(Результат) = Тип("КодВозвратаДиалога") И Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;	
	
	ТипыТранзакций = Новый Соответствие;
	ТипыТранзакций.Вставить("СтруктураФайлаXMLВходящие");
	ТипыТранзакций.Вставить("СтруктураФайлаXMLИсходящие");
	ТипыТранзакций.Вставить("СтруктураФайлаXMLДокументы");
	
	Для Каждого Элемент Из ТипыТранзакций Цикл
		СтрокиДЗ      = ЭтаФорма[Элемент.Ключ].ПолучитьЭлементы();
		
		ТранзакцииПоПолю = Новый Массив;
		Для Каждого Строка Из СтрокиДЗ Цикл
			ТекущийТипТранзакции = Неопределено;
			Если Строка.Свойство("ТипТранзакции", ТекущийТипТранзакции) = Ложь Тогда
				Если Строка.Свойство("Кнопка", ТекущийТипТранзакции) = Ложь Тогда
					Продолжить; 
				КонецЕсли;
			КонецЕсли;
			
			ТранзакцииПоПолю.Добавить(ТекущийТипТранзакции);
		КонецЦикла;
		
		ТипыТранзакций.Вставить(Элемент.Ключ, ТранзакцииПоПолю);
	КонецЦикла;  	
	
	ИменаПрочихНастроек = Новый Соответствие;
	ИменаПрочихНастроек.Вставить("СетьПодписка", "ДокументовСеть");
	ИменаПрочихНастроек.Вставить("СетьЗапрос", "Покупателя");
	ИменаПрочихНастроек.Вставить("ПоставщикПодписка", "ДокументовПоставщик");
	ИменаПрочихНастроек.Вставить("ПоставщикЗапрос", "Поставщика");
	ИменаПрочихНастроек.Вставить("Прайс-листЗапрос", "ПрайсЛист");
	ИменаПрочихНастроек.Вставить("Прайс-листПодписка", "ПрайсЛист");
	ИменаПрочихНастроек.Вставить("Неструкт. докум.Запрос", "Condra");
	ИменаПрочихНастроек.Вставить("Неструкт. докум.Подписка", "ДокументовCondra");
	ИменаПрочихНастроек.Вставить("ЭТРНЗапрос", "ЭТРН");
	ИменаПрочихНастроек.Вставить("ЭТРНПодписка", "ДокументовЭТРН");	
	
	// настройки интерфейса, прочие настройки
	МассивНастроек = Новый Массив;
	Для Каждого Строка Из ЭКОМ_ПрочиеНастройки Цикл
		Если Строка.Использовать Тогда
			МассивНастроек.Добавить("СлужебныйЗапросДляФормы" + ИменаПрочихНастроек.Получить(Строка.ТипОбмена  + "Запрос"));
			МассивНастроек.Добавить("СлужебныйЗапросДляПодписки" + ИменаПрочихНастроек.Получить(Строка.ТипОбмена  + "Подписка"));
		КонецЕсли;
	КонецЦикла;
	Если МассивНастроек.Количество() Тогда
		ТипыТранзакций.Вставить("Прочие настройки", МассивНастроек);
	КонецЕсли;
	
	ПараметрыОткрываемойФормы = Новый Структура;
	ПараметрыОткрываемойФормы.Вставить("ТипОперации"   , "Сохранение");
	ПараметрыОткрываемойФормы.Вставить("ТипыТранзакций", ТипыТранзакций);
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПослеВыбораНастроекСохранения", ЭтаФорма);
	ОткрытьФорму(ЭтаФорма.СлужебныйПолноеИмяФормы + ".Форма.УФ_ВыборСохраняемыхНастроек", ПараметрыОткрываемойФормы,,,,, ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораНастроекСохранения(Результат, ДополнительныеПараметры) Экспорт
	
	МассивЛогаСобытий	   = Новый Массив;
	ВыбранныеТипы  	       = Неопределено;
	ВсегоФайлов   		   = Неопределено;
	КаталогСохранения 	   = Неопределено;
	МассивКонстант		   = Неопределено;
	СохранятьПоОтдельности = Неопределено;
	Если Результат.Свойство("ВыбранныеТипы", ВыбранныеТипы) = Ложь 
		ИЛИ Результат.Свойство("КаталогСохранения", КаталогСохранения) = Ложь 
		ИЛИ Результат.Свойство("ВсегоФайлов", ВсегоФайлов) = Ложь
		ИЛИ Результат.Свойство("МассивКонстант", МассивКонстант) = Ложь 
		ИЛИ Результат.Свойство("СохранятьПоОтдельности", СохранятьПоОтдельности) = Ложь Тогда		 
		
		Если Не Результат.Свойство("Отменить") Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Сохранение настроек не может быть выполнено, не выбран каталог сохранения или не удалось передать структуру сохраняемых настроек";
			Сообщение.Сообщить();
		КонецЕсли;
		Возврат;
		
	КонецЕсли;
	
	Сообщение = Новый СообщениеПользователю;  	
	Если СохранятьПоОтдельности Тогда 		
		Прогресс		  = 0;
		ТекущийНомерФайла = 0;
		ДанныеОС 		  = ЭКОМ_ОбщегоНазначенияКлиент.ЭКОМ_ПолучитьРазделительПутиОСКлиента();
		РазделительПути   = ДанныеОС.Получить("РазделительПути");
		ВерсияОбработки   = ПолучитьВерсиюОбработкиНаСервере();
		
		СтруктураФайловНастроек = ПолучитьФайлыНастроек(ВыбранныеТипы, МассивКонстант);
		Для Каждого ЭлементОсновной Из СтруктураФайловНастроек Цикл
			
			Для Каждого Элемент Из ЭлементОсновной.Значение Цикл
				ДвоичныеДанные = ПолучитьИзВременногоХранилища(Элемент.Значение);
				
				ИмяСохранения	    = ЭКОМ_ОбщегоНазначенияКлиент.ПолучитьИмяСохраняемогоФайла(ВерсияОбработки, Элемент.Ключ, ЭлементОсновной.Ключ);
				ИмяФайлаПоУмолчанию = ИмяСохранения + ".xml";
				ПолныйПутьКФайлу	= КаталогСохранения + РазделительПути + ИмяФайлаПоУмолчанию;
				
				Прогресс = Окр(ТекущийНомерФайла * 100 / ВсегоФайлов, 0);
				Попытка
					ДвоичныеДанные.Записать(ПолныйПутьКФайлу);
				Исключение
					Сообщить("Ошибка записи в файл [" + "] " + ПолныйПутьКФайлу);
				КонецПопытки;
				
				ЗаписанныйФайл = Новый Файл(ПолныйПутьКФайлу);
				Если ЗаписанныйФайл.Существует() Тогда
					СостояниеЭКОМ("Успешно сохранен файл настроек", "" + ИмяФайлаПоУмолчанию, Прогресс);
					Сообщение.Текст = "Успешно сохранен файл настроек: " + ИмяФайлаПоУмолчанию;    					
				Иначе
					СостояниеЭКОМ("Файл настроек не записан", ИмяФайлаПоУмолчанию, Прогресс);
					Сообщение.Текст = "Файл настроек не записан: " + ИмяФайлаПоУмолчанию;
				КонецЕсли;
				Сообщение.Сообщить();
			КонецЦикла;
			
		КонецЦикла;
	Иначе
		ОтборРегистр = Новый Структура;
		ОтборРегистр.Вставить("ЭКОМ_ЗначениеДополнительныхКонстант", Истина);
		
		АдресВоВременномХранилище = ВыгрузкаНаСервере(ОтборРегистр, МассивКонстант, МассивЛогаСобытий, Истина, ВыбранныеТипы);
		
		КраткаяИнформация = ЭКОМ_ОбщегоНазначения.ПолучитьКраткуюИнформацияОКонфигурации();
		ДатаЗаписи        = Формат(ТекущаяДата(), "ДФ=dd.MM.yy");
		ИмяСохранения     = "Настройки по документам_" + ДатаЗаписи + "_" + КраткаяИнформация + ".xml";
		
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресВоВременномХранилище);
		ДвоичныеДанные.Записать(КаталогСохранения + ПолучитьРазделительПутиКлиента() + ИмяСохранения);
		
		Сообщение.Текст = "Успешно сохранен файл с выбранными настройками.";
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьФайлыНастроек(ВыбранныеТипы, МассивКонстант)
	
	ОтборРегистр = Новый Структура("ЭКОМ_ЗначениеДополнительныхКонстант", Истина);
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
    СтруктураНастроек = ОбработкаОбъект.ВыгрузитьНастройки(ОтборРегистр, МассивКонстант, , Истина, ВыбранныеТипы, Истина);	
	Если СтруктураНастроек.Свойство("ЭКОМ_ЗначениеДополнительныхКонстант") Тогда
		ТаблицаНастроек   = СтруктураНастроек.ЭКОМ_ЗначениеДополнительныхКонстант;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	ФайлыНастроек     = Новый Соответствие;
	
	ТекущийНомерФайла = 0;
	Для Каждого Строка Из ТаблицаНастроек Цикл
		СформированныеФайлы = Новый Соответствие;
		
		ИмяКолонки    = ?(Строка.ДополнительнаяКонстанта = "СтруктураФайлаXMLДокументы", "Кнопка", "ТипТранзакции");
		ТекущийНомерФайла = ТекущийНомерФайла + 1;
		
		СтрокаДеревоНастроек = Строка.ЗначениеДополнительногоХранилища;
		
		Если ТипЗнч(СтрокаДеревоНастроек) = Тип("ДеревоЗначений") Тогда
			
			Для Каждого СтрокаДерева Из СтрокаДеревоНастроек.Строки Цикл
				ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
					
				Колонки = Новый Массив;
				Для Каждого Колонка Из СтрокаДеревоНастроек.Колонки Цикл
					Колонки.Добавить(Колонка.Имя);
				КонецЦикла;
				
				Дерево = Новый ДеревоЗначений;
				Для Каждого Колонка Из Колонки Цикл
					Дерево.Колонки.Добавить(Колонка);
				КонецЦикла;
				
				НайденнаяСтрока = СтрокаДеревоНастроек.Строки.Найти(СтрокаДерева[ИмяКолонки], ИмяКолонки); 
				
				ОбработкаОбъект.СкопироватьСтрокуДереваЗначений(НайденнаяСтрока, Дерево.Строки.Добавить(), Колонки);
				
				Запись = Новый ЗаписьXML;
				Запись.ОткрытьФайл(ИмяВременногоФайла);    
				
				НовыйСериализаторXDTO = Новый СериализаторXDTO(ФабрикаXDTO);
				НовыйСериализаторXDTO.ЗаписатьXML(Запись, Дерево, НазначениеТипаXML.Явное);
				
				Запись.Закрыть();
				
				АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяВременногоФайла), ЭтаФорма.УникальныйИдентификатор);
				
				СформированныеФайлы.Вставить(СтрокаДерева[ИмяКолонки], АдресВоВременномХранилище);  				
			КонецЦикла;
			
			ФайлыНастроек.Вставить(Строка.ДополнительнаяКонстанта, СформированныеФайлы);
		Иначе
			ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
			
			Запись = Новый ЗаписьXML;
			Запись.ОткрытьФайл(ИмяВременногоФайла);    
			
			НовыйСериализаторXDTO = Новый СериализаторXDTO(ФабрикаXDTO);
			НовыйСериализаторXDTO.ЗаписатьXML(Запись, Строка.ЗначениеДополнительногоХранилища, НазначениеТипаXML.Явное);
			
			Запись.Закрыть();
			
			ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
			АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанные, ЭтаФорма.УникальныйИдентификатор);
			
			СформированныеФайлы.Вставить(Строка.ДополнительнаяКонстанта, АдресВоВременномХранилище); 
			ФайлыНастроек.Вставить(Строка.ДополнительнаяКонстанта, СформированныеФайлы);
		КонецЕсли;
	
		
	КонецЦикла;
	
	Возврат ФайлыНастроек;
	
КонецФункции

&НаСервере
Функция ПолучитьФайлыНастроекЗапросПодписка(ВыбранныеТипы, МассивКонстант)
	
	ОтборРегистр = Новый Структура("ЭКОМ_ЗначениеДополнительныхКонстант", Истина);
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
    СтруктураНастроек = ОбработкаОбъект.ВыгрузитьНастройки(ОтборРегистр, МассивКонстант, , Истина, ВыбранныеТипы, Истина);	
	Если СтруктураНастроек.Свойство("ЭКОМ_ЗначениеДополнительныхКонстант") Тогда
		ТаблицаНастроек   = СтруктураНастроек.ЭКОМ_ЗначениеДополнительныхКонстант;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	ФайлыНастроек     = Новый Соответствие;
	
	ТекущийНомерФайла = 0;
	Для Каждого Строка Из ТаблицаНастроек Цикл
		
		Если Строка.ЗначениеДополнительногоХранилища = Неопределено Или Строка.ЗначениеДополнительногоХранилища = "" Тогда
			Возврат Неопределено;
		Иначе
			СформированныеФайлы = Новый Соответствие;
			
			ИмяКолонки    = ?(Строка.ДополнительнаяКонстанта = "СтруктураФайлаXMLДокументы", "Кнопка", "ТипТранзакции");
			ТекущийНомерФайла = ТекущийНомерФайла + 1;
			
			СтрокаДеревоНастроек = Строка.ЗначениеДополнительногоХранилища;
			
			ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
			
			Запись = Новый ЗаписьXML;
			Запись.ОткрытьФайл(ИмяВременногоФайла);    
			
			НовыйСериализаторXDTO = Новый СериализаторXDTO(ФабрикаXDTO);
			НовыйСериализаторXDTO.ЗаписатьXML(Запись, Строка.ЗначениеДополнительногоХранилища, НазначениеТипаXML.Явное);
			
			Запись.Закрыть();
			
			ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
			АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанные, ЭтаФорма.УникальныйИдентификатор);
			
			СформированныеФайлы.Вставить(Строка.ДополнительнаяКонстанта, АдресВоВременномХранилище); 
			ФайлыНастроек.Вставить(Строка.ДополнительнаяКонстанта, СформированныеФайлы);
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат ФайлыНастроек;
	
КонецФункции

