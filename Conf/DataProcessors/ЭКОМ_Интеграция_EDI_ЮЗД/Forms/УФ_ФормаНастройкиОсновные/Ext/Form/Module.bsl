&НаКлиенте
Процедура ОповещениеЗагрузитьНастройкиИзРегистров(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Тогда
        Возврат;
    КонецЕсли;    
	
	Если ВыбранныеФайлы.Количество() = 1 Тогда			
		
		АдресВоВременомХранилище = ВыбранныеФайлы[0].Хранение;
		ПутьКФайлу = ВыбранныеФайлы[0].Имя;
							
		ЗагрузитьНастройкиИзРегистра(ПутьКФайлу, АдресВоВременомХранилище);
			
		Состояние("Настройки загружены");
	
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНастройкиИзРегистра(ПутьКФайлу, АдресВоВременномХранилище = Неопределено)

	ИмяСобытия = "Загрузка настроек из регистр";
	МассивЛогаСобытий = Новый Массив;
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	РасширениеФайлаНастроек = НРег(Прав(ПутьКФайлу, 4));
	
	Если АдресВоВременномХранилище <> Неопределено Тогда
		ДвоичныеДанныеИзВременногоХранилища = ПолучитьИзВременногоХранилища(АдресВоВременномХранилище);
		ИмяФайлаНаСервере = ПолучитьИмяВременногоФайла(РасширениеФайлаНастроек);
		ДвоичныеДанныеИзВременногоХранилища.Записать(ИмяФайлаНаСервере);
	Иначе
		ИмяФайлаНаСервере = ПутьКФайлу;
	КонецЕсли;
	
	Файл = Новый Файл(ПутьКФайлу);
	Загружены = Ложь;
	Если РасширениеФайлаНастроек = ".1ct" Тогда // Старый формат

		ФайлНастроек = Новый ТекстовыйДокумент;
		ФайлНастроек.Прочитать(ИмяФайлаНаСервере);
		Настройки = XMLЗначение(Тип("ХранилищеЗначения"), ФайлНастроек.ПолучитьТекст()).Получить();
		
		Для Каждого Настройка Из Настройки Цикл
			
			МенеджерЗаписи = РегистрыСведений.ЭКОМ_ЗначениеДополнительныхКонстант.СоздатьМенеджерЗаписи();
			Для Каждого Эл Из Настройка.Значение Цикл
				МенеджерЗаписи[Эл.Ключ] = Эл.Значение;
			КонецЦикла;
			МенеджерЗаписи.Записать(Истина);
			
		КонецЦикла;
		
		Загружены = Истина;
	ИначеЕсли РасширениеФайлаНастроек = ".xml" Тогда // Новый формат
		АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяФайлаНаСервере), Новый УникальныйИдентификатор);
	    Загружены = ОбработкаОбъект.ЗагрузитьНастройки(АдресВоВременномХранилище, МассивЛогаСобытий);
	Иначе
		ТекстЛогаСобытий = "Формат [" + РасширениеФайлаНастроек + "] не поддерживается!";	
		ЗаписьСтруктурыЛога = Вычислить("ЭКОМ_ОбщегоНазначения.ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия)");
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
	КонецЕсли;
	
	Сообщение = Новый СообщениеПользователю;
	
	Если Загружены Тогда
		ПараметрыФункции = Новый Массив;
		ПараметрыФункции.Добавить(Ложь);
		ПараметрыФункции.Добавить(МассивЛогаСобытий);
		БекапНастроек = ВернутьРезультатИзМодуляОбъекта("ИзменитьФорматПользовательскихНастроек", ПараметрыФункции);
		
		// Обновим загруженные настройки
    	ПриСозданииНаСервере(Ложь, Истина);
		
		Сообщение.Текст = "Настройки загружены";
		
	Иначе
		Сообщение.Текст = "Настройки не загружены. Причину смотрите в логе событий.";
	КонецЕсли;
	
	Сообщение.Сообщить();
	
	Если МассивЛогаСобытий.Количество() > 0  Тогда
		Попытка
			Выполнить("ЭКОМ_ОбщегоНазначения.ЗаписатьЛогСобытийвРегистрЛогирование(МассивЛогаСобытий);");
		Исключение
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий)");
			Сообщение.Сообщить();
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьОбновлениеНаКлиенте(Команда)
	
	ЗаполнитьТаблицуОбновлений();
	
КонецПроцедуры

Процедура СохранитьФайлИзХранилища(ДанныеФайла, Знач ТипФайла = Неопределено)
    
    Если ТипФайла = Неопределено Тогда
    	СохранитьФайлИзХранилища(ДанныеФайла, "ФайлОбновления");
		//СохранитьФайлИзХранилища(ДанныеФайла, "ФайлОписания");
		//СохранитьФайлИзХранилища(ДанныеФайла, "ФайлКонфигурации");
        Возврат; //все файлы сохранены
    КонецЕсли;
    
    //когда указан конкретный тип файла тогда и сохраняю (при рекурсивных вызовах или при сохранении отдельных файлов)
    Если ДанныеФайла["ОшибкаЗаписи" + ТипФайла] = Истина Тогда
        Если ДанныеФайла["ОшибкаЗаписи" + ТипФайла] = Истина Тогда
            Адрес = ДанныеФайла["АдресВоВременномХранилище" + ТипФайла];
            ДДФ = ПолучитьИзВременногоХранилища(Адрес);
            Попытка
            	ДДФ.Записать(ДанныеФайла[ТипФайла]);
            Исключение
                Ошибка = ОписаниеОшибки();
                Сообщить(Ошибка);
            КонецПопытки;
        КонецЕсли;
    КонецЕсли;
  		
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицуОбновлений()

	ЭтаФорма.СписокОбновлений.Очистить();
	
	МассивЛогаСобытий = Новый Массив;
	
	ЗначениеПоУмолчанию = Неопределено;
	Измерение           = Неопределено; 
	Обязательно         = Истина;
	ЛокальныйКаталогUPDATE = НастройкаПрочитатьОбщийМодуль("ЭКОМ_Локальный_Каталог_UPDATE", ЗначениеПоУмолчанию, Измерение, Обязательно);
	
	ПараметрыФункции = Новый Массив;
	ПараметрыФункции.Добавить(Истина);
	ПараметрыФункции.Добавить(МассивЛогаСобытий);
	
	СтруктураРезультата = ВернутьРезультатИзМодуляОбъекта("ПроверитьОбновление", ПараметрыФункции);	
	Если СтруктураРезультата.ОбновлениеЗагружено = Истина Тогда
		 ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(СтруктураРезультата.ДанныеОбработки.АдресВоВременномХранилище);
		 ФормаОбновлений     = ПолучитьФорму(ЭтаФорма.СлужебныйПолноеИмяФормы + ".Форма.УФ_ФормаОбновления");
	     ФормаОбновлений.СохранитьОбновленияНаДиск(ДвоичныеДанныеФайла, СтруктураРезультата.ДанныеОбработки.ФайлОбновленияИмя, ЛокальныйКаталогUPDATE, МассивЛогаСобытий);
	КонецЕсли;
    
	Если СтруктураРезультата.НеобходимоОбновление Тогда
         ТекстСообщения = "Доступна новая версия - " + СтруктураРезультата.ДанныеОбработки.ВерсияМодуля;
		 //СохранитьФайлИзХранилища(СтруктураВозврата.ДанныеОбработки);
     Иначе
         ТекстСообщения = "Новая версия отсутствует.";
	КонецЕсли;
	
	ЗаполнитьИсториюТаблицыОбновлений();

    Элементы.ИнфоОбновления.Заголовок = ТекстСообщения;

КонецПроцедуры
&НаСервере
Процедура ЗаполнитьИсториюТаблицыОбновлений()

	ЭтаФорма.СписокОбновлений.Очистить();
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	// Получим список установленных обновлений
	Запрос = Новый Запрос;
	Запрос.Текст = ОбработкаОбъект.ЗапросДляТаблицыОбновлений();
			
	РезультатЗапроса = Запрос.Выполнить();	
	
	Н = 1;
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			НовСтр = ЭтаФорма.СписокОбновлений.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр, Выборка);
            НовСтр.НомерСтроки = Н;

			Н = Н + 1;
			
		КонецЦикла;	
    КонецЕсли;
    
    ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
КонецПроцедуры

