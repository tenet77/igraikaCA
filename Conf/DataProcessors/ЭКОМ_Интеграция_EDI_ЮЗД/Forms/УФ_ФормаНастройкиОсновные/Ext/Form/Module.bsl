Функция СтрНайтиПоШаблону(СтрокаГдеИскать, ШаблонПоиска) Экспорт
    Перем Результат;
    
    Если (Прав(ШаблонПоиска, 1) = "%" И Лев(ШаблонПоиска, 1) = "%") Тогда //ищет вхождение в любом месте
        
        ШаблонПоискаБезСпецСимволов = СтрЗаменить(ШаблонПоиска, "%", "");
        Если Найти(СтрокаГдеИскать, ШаблонПоискаБезСпецСимволов) = 0 Тогда
            Возврат Неопределено;
        КонецЕсли;
        
    ИначеЕсли Лев(ШаблонПоиска, 1) = "%" Или Найти(ШаблонПоиска, "%") = 0 Тогда //Ищет только сначала строки
        
            ШаблонПоискаБезСпецСимволов = СтрЗаменить(ШаблонПоиска, "%", "");
            ФрагментТекста              = Лев(СтрокаГдеИскать, СтрДлина(ШаблонПоискаБезСпецСимволов));
            Результат                   = (ФрагментТекста = ШаблонПоискаБезСпецСимволов);
    КонецЕсли;
    
    Возврат Результат;
КонецФункции 

//возвращает истину если шаблон поиска найден ложь если не найден
Функция СтрНайденШаблонПоискаВСтроке(СтрокаГдеИскать, ШаблонПоиска) Экспорт
    Перем Результат;
    
    ПозицияВхождения = СтрНайтиПоШаблону(СтрокаГдеИскать, ШаблонПоиска);
    Если ПозицияВхождения <> Неопределено И ПустаяСтрока(ПозицияВхождения) = Ложь Тогда
        Результат = ?(ПозицияВхождения > 0, Истина, Ложь);
    Иначе
        Результат = Ложь;
    КонецЕсли;
    
    Возврат Результат;
КонецФункции

// Функция - ищет по шаблону реквизиты формы с именами используемый спецсимвол % действует как в ПОДОБНО. Если % не указан то ищу сначала строки указанный шаблон в имени реквизита формы
//
// Параметры:
//  ШаблонПоиска - Строка - строка поиска. Способ поиска указывается спецсимволом %. Поддерживаются ЭКОМ_% или просто ЭКОМ_ - поиск вхождения с начала строки. %ЭКОМ_% - поиск вхождения в имя в любой части строки.
//  ВернутьТолькоИмена - Булево - Истина - вернет имена (по-умолчанию). Ложь - вернет объекты подмножества реквизит формы.
// Возвращаемое значение:
//   - Массив имен реквизитов формы или массив реквизитов формы
//
&НаСервере
Функция НайтиРеквизитыФормы(Знач ШаблонПоиска, ВернутьТолькоИмена = Истина, Результат = Неопределено)
    
    Если Результат = Неопределено Тогда
        Результат = Новый Массив;
    КонецЕсли;
    
    Если ТипЗнч(ШаблонПоиска) = Тип("Строка") Тогда
        Если Найти(ШаблонПоиска, ",") > 0 Тогда
            ШаблонПоиска = ВернутьТемЖеЗначениемИлиМассивомИзЭтогоЗначения(ШаблонПоиска, ",", Истина, Ложь);
            Результат    = НайтиРеквизитыФормы(ШаблонПоиска, ВернутьТолькоИмена, Результат);
            Возврат Результат;
        КонецЕсли;
    ИначеЕсли ТипЗнч(ШаблонПоиска) = Тип("Массив") Тогда
        Для Каждого ТекущийШаблонПоиска Из ШаблонПоиска Цикл
            Результат = НайтиРеквизитыФормы(ТекущийШаблонПоиска, ВернутьТолькоИмена, Результат);
        КонецЦикла;
        Возврат Результат;
    КонецЕсли;
    
    НайденныйЭлементФормы = Элементы.Найти(ШаблонПоиска);
    Если НайденныйЭлементФормы = Неопределено Тогда  //был передан шаблон поиска - перебираю все реквизиты добавляя подходящие или этот реквизит формы не выведен 
        Попытка ////может быть ситуация когда Реквизит формы не выведен на форму в элементы формы
	        НайденныйРеквизитФормы = ЭтаФорма[ШаблонПоиска];
            Результат.Добавить(ШаблонПоиска);
            Возврат Результат; //наден реквизит по шаблону поиска и шаблоном было точное имя реквизита
        Исключение
        КонецПопытки;
        
        //по точному соотвествию реквизит формы не обнаружен пробую искать по подстроке в имени реквизита
        Для Каждого ЭлементФормы Из Элементы Цикл
            Если ТипЗнч(ЭлементФормы) <> Тип("ПолеФормы") Тогда
                Продолжить;
            КонецЕсли;
            
            ИмяРеквизита = ЭлементФормы.Имя;
            Если СтрНайденШаблонПоискаВСтроке(ИмяРеквизита, ШаблонПоиска) = Ложь Тогда
                Продолжить;    
            Иначе
                Попытка
	                ЗначениеРеквизитаФормы = ЭтаФорма[ИмяРеквизита];
                    НайденныйЭлементФормы = ЭлементФормы;
                    Результат = НайтиРеквизитыФормы(ИмяРеквизита, ВернутьТолькоИмена, Результат);
                Исключение
                    Продолжить; 
                КонецПопытки;
            КонецЕсли;        
        КонецЦикла;
        Возврат Результат;
    КонецЕсли;
    
    //это вызывается когда передано конкретное имя реквизита и он был найден. (вызывается в конечном итоге всегда в при успехе поиска конце цепочки вызовов)
    Если НайденныйЭлементФормы <> Неопределено Тогда
        Если ВернутьТолькоИмена = Истина Тогда
            Результат.Добавить(НайденныйЭлементФормы.Имя);
        Иначе
            Результат.Добавить(НайденныйЭлементФормы);
        КонецЕсли; 
    КонецЕсли;
    
    
    Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ВызватьДиалогПодтвержденияЗаписи(ИзмененныеНастройки, ОписаниеИзменений, ЗакрытьФорму = Ложь, ИзмененныеНастройкиТаблицей = Неопределено)
    
    ВозвращаемыеПараметры = Новый Структура("ЗакрытьФорму, ИзмененныеНастройки,", ЗакрытьФорму, ИзмененныеНастройки) ;
    ОповещениеОЗакрытии   = Новый ОписаниеОповещения("ВызватьДиалогПодтвержденияЗаписиЗавершение", ЭтаФорма, ВозвращаемыеПараметры);
    ПараметрыВызова       = Новый Структура("ОписаниеИзмененийТекст, ИзмененныеНастройки", ОписаниеИзменений, ИзмененныеНастройкиТаблицей);
    ФормаСохранения       = ОткрытьФорму(ЭтаФорма.СлужебныйПолноеИмяФормы + ".Форма.УФ_СохранениеНастроек", ПараметрыВызова, ЭтаФорма,,,, ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
    
КонецПроцедуры

&НаКлиенте
Процедура ВызватьДиалогПодтвержденияЗаписиЗавершение(РезультатЗакрытия, Параметры = Ложь) Экспорт
	
	МассивЛогаСобытий = Новый Массив;
	Если РезультатЗакрытия = Истина Тогда
		
        ЗаписатьНаСервере(Параметры.ИзмененныеНастройки);
		
		// Для обновления ролей при изменении значений определенных переменных.
		ОбновитьРоли = Ложь;
		ЭлементыДляОбновленияРолей = Новый Массив;
		ЭлементыДляОбновленияРолей.Добавить("_СтруктураФайлаXMLВходящие");
		ЭлементыДляОбновленияРолей.Добавить("_СтруктураФайлаXMLИсходящие");
		ЭлементыДляОбновленияРолей.Добавить("_СтруктураФайлаXMLДокументы");
		Для каждого Стр Из Параметры.ИзмененныеНастройки Цикл			 
			ОбновитьРоли = ?(НЕ ЭлементыДляОбновленияРолей.Найти(Стр.Ключ) = Неопределено, Истина, ОбновитьРоли);
		КонецЦикла;
		
		Если ОбновитьРоли Тогда
			ОбновитьВсеРолиНаСервере();
		КонецЕсли;
		
        Состояние("Настройки успешно записаны.", , , БиблиотекаКартинок.Записать);
        ЭтаФорма.Модифицированность = Ложь;
		
		//+Лысковец 20220125 / MOD-570 / При попытке записать изменения, если закрыта обработка / добавлено условие
		Если НЕ ВладелецФормы = Неопределено Тогда
			ВладелецФормы.СоздатьДинамическийСписокДобавитьДинамическиеКнопки(МассивЛогаСобытий);
		КонецЕсли;
		//-
		
    Иначе
        Состояние("Вы отказались от сохранения настроек.", , , БиблиотекаКартинок.Записать);
    КонецЕсли;
    Если Параметры.ЗакрытьФорму = Истина Тогда
        ПараметрФормы = Новый Структура;
        ПараметрФормы.Вставить("ЗавершениеРаботы", Истина);
		ПараметрФормы.Вставить("ФормаДляОповещения", "Обработка.УФ_Форма");
    	Оповестить("НастройкиОбновить", ПараметрФормы);
        ЭтаФорма.Модифицированность = Ложь;
        Закрыть();
	КонецЕсли;
	
	Если МассивЛогаСобытий.Количество() > 0  Тогда
		Попытка
			Выполнить("ЭКОМ_ОбщегоНазначения.ЗаписатьЛогСобытийвРегистрЛогирование(МассивЛогаСобытий);");
		Исключение
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий)");
			Сообщение.Сообщить();
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

&НаСервере
