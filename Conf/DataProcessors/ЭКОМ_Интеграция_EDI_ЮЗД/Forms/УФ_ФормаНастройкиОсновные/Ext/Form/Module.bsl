		ОткрытьФорму("Обработка.РегламентныеИФоновыеЗадания.Форма");
			
	Иначе
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Обработка - <<< Регламентные и фоновые задания >>> не найдена!";
		Сообщение.Сообщить();
	КонецЕсли;
	
