&НаКлиенте
Процедура ЗаполнитьСписокДляИзменения(Значение, Имя)
	
	// Создаем новый список
	Если СписокЗначенийИзмененныхНастроек.Количество() = 0 Тогда
	    СоответствиеЗначений = Новый Соответствие;
		
	// Меняем текущий	
	Иначе	
	    СоответствиеЗначений = СписокЗначенийИзмененныхНастроек.Получить(0).Значение;
	КонецЕсли;
	
	СоответствиеЗначений.Вставить(Имя, Значение);
	СписокЗначенийИзмененныхНастроек.Очистить();
	СписокЗначенийИзмененныхНастроек.Добавить(СоответствиеЗначений);
	
	ЭтаФорма.Модифицированность = Истина;
	
	УправлениеВидимостью();
	
КонецПроцедуры

