&НаСервере
Функция ОчиститьОбъектыЭКОМПоДатуНаСервере(МассивЛогаСобытий)
    
    ОбъектЭтаОбработка = РеквизитФормыВЗначение("Объект");

	ДанныеОРегистрах = Новый Соответствие;
	ДанныеОРегистрах.Вставить("ОчиститьОбъекты_РегистрСведений_ЭКОМ_ИсторияОбмена"              , ОчиститьОбъекты_РегистрСведений_ЭКОМ_ИсторияОбмена);
	ДанныеОРегистрах.Вставить("ОчиститьОбъекты_РегистрСведений_ЭКОМ_ОбъектыСобытия"             , ОчиститьОбъекты_РегистрСведений_ЭКОМ_ОбъектыСобытия);
	ДанныеОРегистрах.Вставить("ОчиститьОбъекты_РегистрСведений_ЭКОМ_ТранспортнаяИнформация"     , ОчиститьОбъекты_РегистрСведений_ЭКОМ_ТранспортнаяИнформация);
	ДанныеОРегистрах.Вставить("ОчиститьОбъекты_ЭКОМ_Документы"                                  , ОчиститьОбъекты_ЭКОМ_Документы);
	ДанныеОРегистрах.Вставить("ОчиститьОбъекты_РегистрСведений_ЭКОМ_ЦепочкиДокументовПоставщика", ОчиститьОбъекты_РегистрСведений_ЭКОМ_ЦепочкиДокументовПоставщика);
	ДанныеОРегистрах.Вставить("ОчиститьОбъекты_РегистрСведений_ЭКОМ_ЦепочкиДокументовПокупателя", ОчиститьОбъекты_РегистрСведений_ЭКОМ_ЦепочкиДокументовПокупателя);
	ДанныеОРегистрах.Вставить("ОчиститьОбъекты_РегистрСведений_ЭКОМ_ЦепочкиДокументовЭТРН"      , ОчиститьОбъекты_РегистрСведений_ЭКОМ_ЦепочкиДокументовЭТРН);
	ДанныеОРегистрах.Вставить("ОчиститьОбъекты_РегистрСведений_ЭКОМ_Квитанции"                  , ОчиститьОбъекты_РегистрСведений_ЭКОМ_Квитанции);
	ДанныеОРегистрах.Вставить("ОчиститьОбъекты_РегистрСведений_ЭКОМ_ЦепочкиНеструктурированныхДокументов", ОчиститьОбъекты_РегистрСведений_ЭКОМ_ЦепочкиНеструктурированныхДокументов);
	ДанныеОРегистрах.Вставить("ОчиститьОбъекты_РегистрСведений_ЭКОМ_Маркировка"                    , ОчиститьОбъекты_РегистрСведений_ЭКОМ_Маркировка);
	ДанныеОРегистрах.Вставить("ОчиститьОбъекты_РегистрСведений_ЭКОМ_GLN"                           , ОчиститьОбъекты_РегистрСведений_ЭКОМ_GLN);
	ДанныеОРегистрах.Вставить("ОчиститьОбъекты_РегистрСведений_ЭКОМ_ЗначениеДополнительныхКонстант", ОчиститьОбъекты_РегистрСведений_ЭКОМ_ЗначениеДополнительныхКонстант);
	ДанныеОРегистрах.Вставить("ОчиститьОбъекты_РегистрСведений_ЭКОМ_НоменклатураКонтрагентов"      , ОчиститьОбъекты_РегистрСведений_ЭКОМ_НоменклатураКонтрагентов);
	ДанныеОРегистрах.Вставить("ОчиститьОбъекты_РегистрСведений_ЭКОМ_Паллеты"                       , ОчиститьОбъекты_РегистрСведений_ЭКОМ_Паллеты);
	ДанныеОРегистрах.Вставить("ОчиститьОбъекты_РегистрСведений_ЭКОМ_ТочкиДоставки"                 , ОчиститьОбъекты_РегистрСведений_ЭКОМ_ТочкиДоставки);
	ДанныеОРегистрах.Вставить("ОчиститьОбъекты_РегистрСведений_ЭКОМ_Логирование"                 , ОчиститьОбъекты_РегистрСведений_ЭКОМ_Логирование);
	ДанныеОРегистрах.Вставить("ОчиститьОбъекты_РегистрСведений_ЭКОМ_Новости"                 	, ОчиститьОбъекты_РегистрСведений_ЭКОМ_Новости);
	
    ОчисткаУспешна = ОбъектЭтаОбработка.ОчиститьИБ_ОтДанныхЭКОМ(ДанныеОРегистрах, ОчиститьОбъекты_НачДатаОчистки, ОчиститьОбъекты_КонДатаОчистки, МассивЛогаСобытий);
    
    Возврат ОчисткаУспешна;
	
КонецФункции

&НаКлиенте
Процедура ОчиститьОбъектыЭКОМПоДату(Команда)
    Если НЕ ЗначениеЗаполнено(ОчиститьОбъекты_НачДатаОчистки) ИЛИ НЕ ЗначениеЗаполнено(ОчиститьОбъекты_КонДатаОчистки) Тогда
           ПоказатьПредупреждение(Новый ОписаниеОповещения, "Очистка отменена. Не заполнен период очистки." 
                                 ,
                                 , "Очистка ИБ от объектов Docrobot"
                                 );
    	Возврат;
    КонецЕсли;
    
    Если ОчиститьОбъекты_НачДатаОчистки <> НачалоДня(ОчиститьОбъекты_НачДатаОчистки) Тогда
    	ОчиститьОбъекты_НачДатаОчистки = НачалоДня(ОчиститьОбъекты_НачДатаОчистки);
    КонецЕсли;
    
    Если ОчиститьОбъекты_КонДатаОчистки <> КонецДня(ОчиститьОбъекты_КонДатаОчистки) Тогда
    	ОчиститьОбъекты_КонДатаОчистки = КонецДня(ОчиститьОбъекты_КонДатаОчистки);
    КонецЕсли;
    
    ОповещениеВопроса = Новый ОписаниеОповещения("ОчиститьОбъектыЭКОМПоДатуЗавершение", ЭтаФорма);
    ПоказатьВопрос(ОповещениеВопроса, "Вы ДЕЙСТВИТЕЛЬНО хотите очистить данные Docrobot объектов за период " + ПредставлениеПериода(ОчиститьОбъекты_НачДатаОчистки, ОчиститьОбъекты_КонДатаОчистки, "ДФ=дд.ММ.гггг") + "?"
                  , РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Нет, "Очистка ИБ от данных Docrobot");
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьОбъектыЭКОМПоДатуЗавершение(РезультатВопроса, ДопПараметры) Экспорт
	
	МассивЛогаСобытий = Новый Массив;
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ОчисткаУспешна = ОчиститьОбъектыЭКОМПоДатуНаСервере(МассивЛогаСобытий);
		
		Если ОчисткаУспешна = Ложь Тогда //ничего не сделано
			ПоказатьПредупреждение( , "Очистка завершена. Найдено и удалено 0 объектов.", , "Очистка ИБ от объектов Docrobot");
			Возврат;
		КонецЕсли;
		
		ТекстовыйДокумент = Новый ТекстовыйДокумент;
		ТекстСообщения = Вычислить("ЭКОМ_ОбщегоНазначенияКлиент.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий)");
        ТекстовыйДокумент.УстановитьТекст(ТекстСообщения);
		
		ДанныеОС = Вычислить("ЭКОМ_ОбщегоНазначенияКлиент.ЭКОМ_ПолучитьРазделительПутиОСКлиента()");
		РазделительПути = ДанныеОС.Получить("РазделительПути");
		
		РабочийКаталог = НастройкаПрочитатьОбщийМодуль("ЭКОМ_Рабочий_Каталог");
		Выполнить("ЭКОМ_ОбщегоНазначенияКлиент.ПроверитьЛокальныйКаталог(РабочийКаталог, РазделительПути)");
		
		Если ЗначениеЗаполнено(РабочийКаталог) Тогда
			
			ПолноеИмяЛога = РабочийКаталог + "Результаты очистки ИБ от данных объектов Docrobot по " + Формат(ОчиститьОбъекты_КонДатаОчистки, "ДФ=дд-ММ-гггг") + ".txt";;		
			ТекстовыйДокумент.Записать(ПолноеИмяЛога, КодировкаТекста.UTF8);
			ТекстовыйДокумент.Показать(ПолноеИмяЛога);
			ПоказатьПредупреждение(Новый ОписаниеОповещения, "Очистка завершена. Подробности выведены в текстовый файл " + Символы.ПС + ПолноеИмяЛога, , "Очистка ИБ от объектов Docrobot");	
		Иначе
			ТекстовыйДокумент.Показать();
			ПоказатьПредупреждение(Новый ОписаниеОповещения, "Не заполнен рабочий каталог. Лог не сохранен.", , "Очистка ИБ от объектов Docrobot");
		КонецЕсли;
		
	Иначе
		ПоказатьПредупреждение(Новый ОписаниеОповещения, "Очистка отменена.", , "Очистка ИБ от объектов Docrobot");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ВерсияПлатформыНаКлиенте() Экспорт
	
	// # Пример: 8.3.11.3034 - 83110 (версия по трем позициям) и до 4 знаков 
    // # Пример: 8.3.5.6565  - 8350 (версия по трем позициям) и до 4 знаков 	
	// # Пример: 8.2.19.4342 - 8219 (версия по трем позициям) и до 4 знаков 
    // # Пример: 8.3.10.4342 - 83100(версия по трем позициям) и до 4 знаков
	// # Пример: 8.3.9.4342  - 8390 (версия по трем позициям) и до 4 знаков
	// # Пример: 8.3.12.4342 - 83120(версия по трем позициям) и до 4 знаков
	// # Пример: 8.3.1.00    - 8310(версия по трем позициям) и до 4 знаков
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	ТекущаяВерсия = СистемнаяИнформация.ВерсияПриложения;
	
	Версия  = "";
	Для н = 1  По 3 Цикл
		ПозицияТочки  = Найти(ТекущаяВерсия, ".");
		Символ        = Лев(ТекущаяВерсия , ПозицияТочки - 1);
		ТекущаяВерсия = Сред(ТекущаяВерсия, ПозицияТочки + 1);
		Версия        = Версия + Символ;
	КонецЦикла;
	
	Если СтрДлина(Версия) < 4 
		 ИЛИ (Сред(Версия, 2, 1) = "3" И СтрДлина(Версия) = 4) Тогда
	    Версия = Версия + "0";	
	КонецЕсли;
	
	Попытка
		ВерсияЧисло = Число(Версия);
	Исключение
	   ВерсияЧисло  = 0;
	КонецПопытки;

	Возврат ВерсияЧисло;
	
КонецФункции

