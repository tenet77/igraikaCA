&НаКлиенте
Процедура ПодключениеЛокальныеКаталогиЗаполнитьПоУмолчанию(Команда)

	ДанныеОС = Вычислить("ЭКОМ_ОбщегоНазначенияКлиент.ЭКОМ_ПолучитьРазделительПутиОСКлиента()");
	Диск = ДанныеОС.Получить("Диск");
	РазделительПути = ДанныеОС.Получить("РазделительПути");
		
	РабочийКаталог = Новый Файл(ЭтаФорма.ЭКОМ_Рабочий_Каталог);
	
	Если НЕ РабочийКаталог.Существует() ИЛИ РабочийКаталог.ЭтоФайл() Тогда       
		ЭтаФорма.ЭКОМ_Рабочий_Каталог = Вычислить("ЭКОМ_ОбщегоНазначенияКлиент.ОпределитьКаталогПоУмолчанию(Диск, РазделительПути)");
		Попытка
			СоздатьКаталог(ЭтаФорма.ЭКОМ_Рабочий_Каталог);
		Исключение
			Сообщить("Ошибка создания каталога. Возможно у Вас нет прав на это действие.");
		КонецПопытки;
		РабочийКаталог = Новый Файл(ЭтаФорма.ЭКОМ_Рабочий_Каталог);
	КонецЕсли;
	
	ЭтаФорма.ЭКОМ_Локальный_Каталог_INBOX 			= РабочийКаталог.ПолноеИмя + РазделительПути + "inbox"      + РазделительПути;
	ЭтаФорма.ЭКОМ_Локальный_Каталог_INBOX_Архив  	= РабочийКаталог.ПолноеИмя + РазделительПути + "inbox_bak"  + РазделительПути;
	ЭтаФорма.ЭКОМ_Локальный_Каталог_OUTBOX       	= РабочийКаталог.ПолноеИмя + РазделительПути + "outbox"     + РазделительПути;
	ЭтаФорма.ЭКОМ_Локальный_Каталог_OUTBOX_Архив 	= РабочийКаталог.ПолноеИмя + РазделительПути + "outbox_bak" + РазделительПути;
	ЭтаФорма.ЭКОМ_Локальный_Каталог_UPDATE       	= РабочийКаталог.ПолноеИмя + РазделительПути + "update"     + РазделительПути;
	ЭтаФорма.ЭКОМ_Локальный_Каталог_Marking       	= РабочийКаталог.ПолноеИмя + РазделительПути + "marking"    + РазделительПути;
    
	СоздатьКаталог(ЭтаФорма.ЭКОМ_Локальный_Каталог_INBOX);
	СоздатьКаталог(ЭтаФорма.ЭКОМ_Локальный_Каталог_INBOX_Архив);
	СоздатьКаталог(ЭтаФорма.ЭКОМ_Локальный_Каталог_OUTBOX);
	СоздатьКаталог(ЭтаФорма.ЭКОМ_Локальный_Каталог_OUTBOX_Архив);
	СоздатьКаталог(ЭтаФорма.ЭКОМ_Локальный_Каталог_UPDATE);
	СоздатьКаталог(ЭтаФорма.ЭКОМ_Локальный_Каталог_Marking);
	
	ЗаполнитьСписокДляИзменения(ЭтаФорма.ЭКОМ_Рабочий_Каталог               , "ЭКОМ_Рабочий_Каталог");
	ЗаполнитьСписокДляИзменения(ЭтаФорма.ЭКОМ_Локальный_Каталог_INBOX       , "ЭКОМ_Локальный_Каталог_INBOX");
	ЗаполнитьСписокДляИзменения(ЭтаФорма.ЭКОМ_Локальный_Каталог_INBOX_Архив , "ЭКОМ_Локальный_Каталог_INBOX_Архив");
	ЗаполнитьСписокДляИзменения(ЭтаФорма.ЭКОМ_Локальный_Каталог_OUTBOX      , "ЭКОМ_Локальный_Каталог_OUTBOX");
	ЗаполнитьСписокДляИзменения(ЭтаФорма.ЭКОМ_Локальный_Каталог_OUTBOX_Архив, "ЭКОМ_Локальный_Каталог_OUTBOX_Архив");
	ЗаполнитьСписокДляИзменения(ЭтаФорма.ЭКОМ_Локальный_Каталог_UPDATE      , "ЭКОМ_Локальный_Каталог_UPDATE");
	ЗаполнитьСписокДляИзменения(ЭтаФорма.ЭКОМ_Локальный_Каталог_Marking     , "ЭКОМ_Локальный_Каталог_Marking");
	
КонецПроцедуры

&НаКлиенте
Процедура ХранениеДанныхЭКОМХраненияДанныхНажатие(Команда)	
	
	// Регистры сведений
	Если Команда.Имя = "ХранениеДанныхЭКОМ_GLN" Тогда
        ОткрытьФорму("РегистрСведений.ЭКОМ_GLN.ФормаСписка");
		
    ИначеЕсли Команда.Имя = "ХранениеДанныхЭКОМ_ТочкиДоставки" Тогда
        ОткрытьФорму("РегистрСведений.ЭКОМ_ТочкиДоставки.ФормаСписка");	
		
    ИначеЕсли Команда.Имя = "ХранениеДанныхЭКОМ_Объекты_События" Тогда
        ОткрытьФорму("РегистрСведений.ЭКОМ_Объекты_События.ФормаСписка");
		
    ИначеЕсли Команда.Имя = "ХранениеДанныхЭКОМ_ИсторияОбмена" Тогда
        ОткрытьФорму("РегистрСведений.ЭКОМ_ИсторияОбмена.ФормаСписка");	
		
    ИначеЕсли Команда.Имя = "ХранениеДанныхЭКОМ_ЗначениеДополнительныхКонстант" Тогда
        ОткрытьФорму("РегистрСведений.ЭКОМ_ЗначениеДополнительныхКонстант.ФормаСписка");
		
    ИначеЕсли Команда.Имя = "ХранениеДанныхЭКОМ_ТранспортнаяИнформация" Тогда
        ОткрытьФорму("РегистрСведений.ЭКОМ_ТранспортнаяИнформация.ФормаСписка");
		
	ИначеЕсли Команда.Имя = "ХранениеДанныхЭКОМ_НоменклатураКонтрагентов" Тогда
        ОткрытьФорму("РегистрСведений.ЭКОМ_НоменклатураКонтрагентов.ФормаСписка");	
		
	ИначеЕсли Команда.Имя = "ХранениеДанныхЭКОМ_ЦепочкиДокументовПоставщика" Тогда
        ОткрытьФорму("РегистрСведений.ЭКОМ_ЦепочкиДокументовПоставщика.ФормаСписка");	
		
	ИначеЕсли Команда.Имя = "ХранениеДанныхЭКОМ_ЦепочкиДокументовПокупателя" Тогда
        ОткрытьФорму("РегистрСведений.ЭКОМ_ЦепочкиДокументовПокупателя.ФормаСписка");	
		
	ИначеЕсли Команда.Имя = "ХранениеДанныхЭКОМ_ЦепочкиДокументовЭТРН" Тогда
        ОткрытьФорму("РегистрСведений.ЭКОМ_ЦепочкиДокументовЭТРН.ФормаСписка");	
		
	ИначеЕсли Команда.Имя = "ХранениеДанныхЭКОМ_ЦепочкиНеструктурированныхДокументов" Тогда
        ОткрытьФорму("РегистрСведений.ЭКОМ_ЦепочкиНеструктурированныхДокументов.ФормаСписка");
		
	ИначеЕсли Команда.Имя = "ХранениеДанныхЭКОМ_Маркировка" Тогда
        ОткрытьФорму("РегистрСведений.ЭКОМ_Маркировка.ФормаСписка");
	
	ИначеЕсли Команда.Имя = "ХранениеДанныхЭКОМ_Квитанции" Тогда
        ОткрытьФорму("РегистрСведений.ЭКОМ_Квитанции.ФормаСписка"); 
		
	ИначеЕсли Команда.Имя = "ХранениеДанныхЭКОМ_Логирование" Тогда
        ОткрытьФорму("РегистрСведений.ЭКОМ_Логирование.ФормаСписка"); 
		
	// Документы
	ИначеЕсли Команда.Имя = "ХранениеДанныхЭКОМ_Документы" Тогда
        ОткрытьФорму("Документ.ЭКОМ_Документы.ФормаСписка");
		
	// Справочники
	ИначеЕсли Команда.Имя = "ХранениеДанныхЭКОМ_ОператорыЭДО" Тогда
        ОткрытьФорму("Справочник.ЭКОМ_ОператорыЭДО.ФормаСписка");
		
	ИначеЕсли Команда.Имя = "ХранениеДанныхЭКОМ_Сертификаты" Тогда
        ОткрытьФорму("Справочник.ЭКОМ_Сертификаты.ФормаСписка");
		
	ИначеЕсли Команда.Имя = "ХранениеДанныхЭКОМ_ТипыНеструктурированныхДокументов" Тогда
        ОткрытьФорму("Справочник.ЭКОМ_ТипыНеструктДокументов.ФормаСписка");
		
	ИначеЕсли Команда.Имя = "ХранениеДанныхЭКОМ_ИнфоПоля" Тогда
        ОткрытьФорму("Справочник.ЭКОМ_ИнфоПоля.ФормаСписка");
		
	ИначеЕсли Команда.Имя = "ХранениеДанныхЭКОМ_ПрофилиОбмена" Тогда
        ОткрытьФорму("Справочник.ЭКОМ_ПрофилиОбмена.ФормаСписка");
		
	ИначеЕсли Команда.Имя = "ХранениеДанныхЭКОМ_Новости" Тогда
		ОткрытьФорму("РегистрСведений.ЭКОМ_Новости.ФормаСписка");
		
	КонецЕсли;
	
