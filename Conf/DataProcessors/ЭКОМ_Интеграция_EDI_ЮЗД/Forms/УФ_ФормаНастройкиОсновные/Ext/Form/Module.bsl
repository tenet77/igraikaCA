&НаСервере
Процедура УдалитьИзРегистраНаСервереЭКОМ_ЗначениеДополнительныхКонстант(ДопПараметры)
	
	МЗ = РегистрыСведений.ЭКОМ_ЗначениеДополнительныхКонстант.СоздатьМенеджерЗаписи();
	МЗ.ДополнительнаяКонстанта = ДопПараметры.ДополнительнаяКонстанта;
	МЗ.Измерение               = ДопПараметры.Измерение;
	МЗ.Прочитать();
	Если МЗ.Выбран() Тогда	
		МЗ.Удалить();
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиенте
Процедура НастройкиСоответсвийУдалитьИзРегистра(Команда)
	
	Для каждого текВыделеннаяСтрока Из Элементы.СписокСоответствий.ВыделенныеСтроки Цикл
		ВыбраннаяСтрока = Элементы.СписокСоответствий.ДанныеСтроки(текВыделеннаяСтрока);
			
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ДополнительнаяКонстанта", ВыбраннаяСтрока.Реквизит);
		ДопПараметры.Вставить("Измерение"              , ВыбраннаяСтрока.Тип);
		
		УдалитьИзРегистраНаСервереЭКОМ_ЗначениеДополнительныхКонстант(ДопПараметры);
		
	КонецЦикла;
		
	Элементы.СписокСоответствий.Обновить();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораВидамиДокументов1С(Элемент, СписокДоступныхДокументов = Неопределено)
    
    Если СписокДоступныхДокументов = Неопределено Тогда
        ИсточникДанных = ЭтаФорма.СлужебныйДеревоКонфигурации.ПолучитьЭлементы();
    Иначе
        ИсточникДанных = СписокДоступныхДокументов;
    КонецЕсли;
    
    ТипИсточникаДанныхСписокЗначений = (ТипЗнч(ИсточникДанных) = Тип("СписокЗначений"));
    
	Если Элемент.СписокВыбора.Количество() = 0 Тогда
        Для Каждого ЭлементИсточникаДанных Из ИсточникДанных Цикл
            Если ТипИсточникаДанныхСписокЗначений Тогда
                Элемент.СписокВыбора.Добавить(ЭлементИсточникаДанных.Значение, ЭлементИсточникаДанных.Представление);
            Иначе
                Элемент.СписокВыбора.Добавить(ЭлементИсточникаДанных.Имя, ЭлементИсточникаДанных.Синоним);
            КонецЕсли;
		КонецЦикла;
	КонецЕсли;
    
КонецПроцедуры

&НаСервере
Функция ПолучитьНастройкиИзРегистра()

	Настройки 	= Новый Структура;
	
	НаборЗаписей = РегистрыСведений.ЭКОМ_ЗначениеДополнительныхКонстант.СоздатьНаборЗаписей();
	НаборЗаписей.Прочитать();
	Счетчик 	= 0;
	
	Для Каждого Запись Из НаборЗаписей Цикл
		Если ПустаяСтрока(Запись.ДополнительнаяКонстанта) 
			 ИЛИ Запись.ДополнительнаяКонстанта = "ЭКОМ_ПарольПользователяFTP"
			 ИЛИ Запись.ДополнительнаяКонстанта = "ЭКОМ_ПарольПользователяПортал" Тогда
			Продолжить;
		КонецЕсли;
		
		Настройки.Вставить("Запись_" + Формат(Счетчик, "ЧГ=0"), Новый Структура("ДополнительнаяКонстанта, Измерение, ЗначениеДополнительнойКонстанты, ЗначениеДополнительногоХранилища",
		Запись.ДополнительнаяКонстанта, Запись.Измерение, Запись.ЗначениеДополнительнойКонстанты, Запись.ЗначениеДополнительногоХранилища));
		Счетчик = Счетчик + 1;
	КонецЦикла;
	
	Возврат Новый ХранилищеЗначения(Настройки);

КонецФункции

&НаКлиенте
Процедура ХранениеДанныхСохранитьВсеНастройки(Команда)
	
	Элементы.ГруппаСтруктураСохранения.Видимость = Истина;
	ЭтаФорма.РС_ЭКОМ_ЗначениеДополнительныхКонстант = Истина;
	
