&НаКлиенте
Процедура ЭКОМ_ПрочиеНастройкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекЭлемент = ЭтаФорма.ЭКОМ_ПрочиеНастройки.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	Если Поле.Имя = "ЭКОМ_ПрочиеНастройкиЗапросДляТабличнойЧасти" Тогда
		
		ЗапросПоУмолчанию = "";
		ТекстЗапроса = "";
		Если ТекЭлемент.ТипОбмена = "Поставщик" Тогда
			
			ТекстЗапроса = ИнтерфейсНастройкаТабличнойЧастиНаСервере("СлужебныйЗапросДляФормыПоставщика");
			Заголовок    = "Введите запрос для получения полей формы поставщика";
			Имя = "ГруппаПоставщик";
			
		ИначеЕсли ТекЭлемент.ТипОбмена = "Сеть" Тогда	
			
			ТекстЗапроса = ИнтерфейсНастройкаТабличнойЧастиНаСервере("СлужебныйЗапросДляФормыПокупателя");
			Заголовок    = "Введите запрос для получения полей формы покупателя";
			Имя = "ГруппаПокупатель";
			
		ИначеЕсли ТекЭлемент.ТипОбмена = "ЭТРН" Тогда	
			
			ТекстЗапроса = ИнтерфейсНастройкаТабличнойЧастиНаСервере("СлужебныйЗапросДляФормыЭТРН");
			Заголовок    = "Введите запрос для получения полей формы ЭТРН";
			Имя = "ГруппаЭТРН";
			
		ИначеЕсли ТекЭлемент.ТипОбмена = "Неструкт. докум." Тогда	
			
			ТекстЗапроса = ИнтерфейсНастройкаТабличнойЧастиНаСервере("СлужебныйЗапросДляФормыCondra");
			Заголовок    = "Введите запрос для получения полей формы неструктурированных документов";
			Имя = "ГруппаCondra";	
			
		ИначеЕсли ТекЭлемент.ТипОбмена = "Прайс-лист" Тогда	
			
			ЭтоУправляемаяФорма = Истина;
			ТекстЗапроса = ИнтерфейсНастройкаТабличнойЧастиНаСервере("СлужебныйЗапросДляФормыПрайсЛист");
			Заголовок    = "Введите запрос для получения полей формы прайс-лист";
			Имя = "ГруппаПрайсЛист";	
			
		КонецЕсли;
		
		ЗаписатьЗапрос = Ложь;
		Если НЕ ЗначениеЗаполнено(ТекстЗапроса) Тогда
		     ТекстЗапроса = ЗапросПоУмолчанию;
			 ЗаписатьЗапрос = Истина;
		КонецЕсли;
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ИмяФормы"        , "УФ_ФормаКонсольЗапросов");
		ДопПараметры.Вставить("ИмяЭлементаФормы", Имя);
		
		ДопПараметры.Вставить("ЭКОМ_ОбменCondra"    , ЭтаФорма.ЭКОМ_ОбменCondra);
		ДопПараметры.Вставить("ЭКОМ_ОбменСеть"      , ЭтаФорма.ЭКОМ_ОбменСеть);
		ДопПараметры.Вставить("ЭКОМ_ОбменЭТРН"      , ЭтаФорма.ЭКОМ_ОбменЭТРН);
		ДопПараметры.Вставить("ЭКОМ_ОбменПоставщик" , ЭтаФорма.ЭКОМ_ОбменПоставщик);
		ДопПараметры.Вставить("ЭКОМ_ОбменПрайсЛист" , ЭтаФорма.ЭКОМ_ОбменПрайсЛист);
		ДопПараметры.Вставить("ЗаписатьЗапрос"      , ЗаписатьЗапрос);

		ОповещениеОЗакрытии = Новый ОписаниеОповещения("ОбработкаЗакрытия", ЭтаФорма, ДопПараметры);
		
		ПараметрыФормы = Новый Структура;
		
		ПараметрыФормы.Вставить("Заголовок"     , Заголовок);
		ПараметрыФормы.Вставить("ТекстНачальный", ТекстЗапроса);
		ПараметрыФормы.Вставить("СправкаКФорме" , "Пример кода:
		|ТекстЗапроса = ""Здесь текст запроса"";");
		
		ПараметрыФормы.Вставить("ДопПараметры", ДопПараметры);
		
		ОткрытьФорму(ЭтаФорма.СлужебныйПолноеИмяФормы + ".Форма.УФ_ФормаКонсольЗапросов", ПараметрыФормы,,,,,ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	ИначеЕсли Поле.Имя = "ЭКОМ_ПрочиеНастройкиПодпискаДляДокументов" Тогда

		Если ТекЭлемент.ТипОбмена = "Поставщик" Тогда			
			Имя = "ПодпискаДляДокументовПоставщик";
			ТекстЗапроса = ИнтерфейсНастройкаТабличнойЧастиНаСервере("СлужебныйЗапросДляПодпискиДокументовПоставщик");
			
		ИначеЕсли ТекЭлемент.ТипОбмена = "Сеть" Тогда			
			Имя = "ПодпискаДляДокументовСеть";
			ТекстЗапроса = ИнтерфейсНастройкаТабличнойЧастиНаСервере("СлужебныйЗапросДляПодпискиДокументовСеть");
			
		ИначеЕсли ТекЭлемент.ТипОбмена = "ЭТРН" Тогда					
			Имя = "ПодпискаДляДокументовЭТРН";
			ТекстЗапроса = ИнтерфейсНастройкаТабличнойЧастиНаСервере("СлужебныйЗапросДляПодпискиДокументовЭТРН");
			
		ИначеЕсли ТекЭлемент.ТипОбмена = "Неструкт. докум." Тогда					
			Имя = "ПодпискаДляДокументовCondra";
			ТекстЗапроса = ИнтерфейсНастройкаТабличнойЧастиНаСервере("СлужебныйЗапросДляПодпискиДокументовCondra");
			
		ИначеЕсли ТекЭлемент.ТипОбмена = "Прайс-лист" Тогда				
			Имя = "ПодпискаДляДокументовПрайсЛист";
			ТекстЗапроса = ИнтерфейсНастройкаТабличнойЧастиНаСервере("СлужебныйЗапросДляПодпискиДокументовПрайсЛист");

		КонецЕсли;
											
		Заголовок = "Введите алгоритм для заполнения подписки на документы - " + ТекЭлемент.ТипОбмена;
							
		ИмяОткрываемойФормы = ЭтаФорма.СлужебныйПолноеИмяФормы + ".Форма.УФ_ФормаКонсольЗапросов";
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ИмяТабличнойЧасти", "СтруктураФайлаXMLИсходящие");
		ДопПараметры.Вставить("ИмяФормы"         , "УФ_ФормаКонсольЗапросов");
		ДопПараметры.Вставить("ИмяЭлементаФормы" , Имя);
		
		ОповещениеОЗакрытии = Новый ОписаниеОповещения("ОбработкаЗакрытия", ЭтаФорма, ДопПараметры);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Заголовок"     , Заголовок);
		ПараметрыФормы.Вставить("ТекстНачальный", ТекстЗапроса);
        ПараметрыФормы.Вставить("СправкаКФорме" , "Пример кода:
		|ТекстЗапроса = ""Здесь текст запроса"";");

        ПараметрыФормы.Вставить("ДопПараметры", ДопПараметры);
		
		ОткрытьФорму(ИмяОткрываемойФормы, ПараметрыФормы,,,,, ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
		
	ИначеЕсли Поле.Имя = "ЭКОМ_ПрочиеНастройкиСохранитьЗапросТЧ" Тогда
		
		ПараметрыСохранения = Новый Структура;
		ПараметрыСохранения.Вставить("НачалоКонстанты", "СлужебныйЗапросДляФормы");
        ПараметрыСохранения.Вставить("ВидНастройки", "Запрос");
		
		СохранитьТекстЗапросаПодпискиXML(Элемент, ПараметрыСохранения);
		
	ИначеЕсли Поле.Имя = "ЭКОМ_ПрочиеНастройкиЗагрузитьЗапросТЧ" Тогда
		
		ПараметрыВосстановления = Новый Структура;
		ПараметрыВосстановления.Вставить("НачалоКонстанты", "СлужебныйЗапросДляФормы");
        ПараметрыВосстановления.Вставить("ВидНастройки", "Запрос");
		
		ВосстановитьТекстЗапросаПодписки(Элемент, ПараметрыВосстановления);
		
	ИначеЕсли Поле.Имя = "ЭКОМ_ПрочиеНастройкиСохранитьАлгоритмПодписки" Тогда
		
		ПараметрыСохранения = Новый Структура;
		ПараметрыСохранения.Вставить("НачалоКонстанты", "СлужебныйЗапросДляПодписки");
        ПараметрыСохранения.Вставить("ВидНастройки", "Подписка");
		
		СохранитьТекстЗапросаПодпискиXML(Элемент, ПараметрыСохранения);
		
	ИначеЕсли Поле.Имя = "ЭКОМ_ПрочиеНастройкиЗагрузитьАлгоритмПодписки" Тогда
		
		ПараметрыВосстановления = Новый Структура;
		ПараметрыВосстановления.Вставить("НачалоКонстанты", "СлужебныйЗапросДляПодписки");
        ПараметрыВосстановления.Вставить("ВидНастройки", "Подписка");
		
		ВосстановитьТекстЗапросаПодписки(Элемент, ПараметрыВосстановления);
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьТекстЗапросаПодпискиXML(ТабличоеПоле, ПараметрыСохранения)
	
	ДанныеОС 		  = ЭКОМ_ОбщегоНазначенияКлиент.ЭКОМ_ПолучитьРазделительПутиОСКлиента();
	РазделительПути   = ДанныеОС.Получить("РазделительПути");
	ВерсияОбработки   = ПолучитьВерсиюОбработкиНаСервере();
	ТекущиеДанные = ТабличоеПоле.ТекущиеДанные;
	МассивКонстант = Новый Массив;
	ВыбранныеТипы = Новый Массив;
	
	ИменаПрочихНастроек = Новый Соответствие;
	ИменаПрочихНастроек.Вставить("СетьПодписка", "ДокументовСеть");
	ИменаПрочихНастроек.Вставить("СетьЗапрос", "Покупателя");
	ИменаПрочихНастроек.Вставить("ПоставщикПодписка", "ДокументовПоставщик");
	ИменаПрочихНастроек.Вставить("ПоставщикЗапрос", "Поставщика");
	ИменаПрочихНастроек.Вставить("Прайс-листЗапрос", "ПрайсЛист");
	ИменаПрочихНастроек.Вставить("Прайс-листПодписка", "ПрайсЛист");
	ИменаПрочихНастроек.Вставить("Неструкт. докум.Запрос", "Condra");
	ИменаПрочихНастроек.Вставить("Неструкт. докум.Подписка", "ДокументовCondra");
	ИменаПрочихНастроек.Вставить("ЭТРНЗапрос", "ЭТРН");
	ИменаПрочихНастроек.Вставить("ЭТРНПодписка", "ДокументовЭТРН");	
	
	ИмяФайлаПоУмолчанию = ПараметрыСохранения.НачалоКонстанты + ИменаПрочихНастроек.Получить(ТекущиеДанные.ТипОбмена  + ПараметрыСохранения.ВидНастройки);
	
	МассивКонстант.Добавить(ИмяФайлаПоУмолчанию);	
	ФайлыНастроек = ПолучитьФайлыНастроекЗапросПодписка(ВыбранныеТипы, МассивКонстант);
		
	Если ФайлыНастроек = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Сохранение пустого текста настроек невозможно";
		Сообщение.Сообщить();
	Иначе
		Для Каждого ЭлементОсновной Из ФайлыНастроек Цикл	
			Для Каждого Элемент Из ЭлементОсновной.Значение Цикл			
				АдресВоВременномХранилище = Элемент.Значение;				
				СохранениеФайла(АдресВоВременномХранилище,Вычислить("ЭКОМ_ОбщегоНазначенияКлиент.ПолучитьИмяСохраняемогоФайла(ВерсияОбработки, ИмяФайлаПоУмолчанию, ""СлужебныйЗапрос"")"));			
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьТекстЗапросаПодписки(ТабличоеПоле, ПараметрыВосстановления)
	
	ТекущиеДанные = ТабличоеПоле.ТекущиеДанные;
	
	ИменаПрочихНастроек = Новый Соответствие;
	ИменаПрочихНастроек.Вставить("СетьПодписка", "ДокументовСеть");
	ИменаПрочихНастроек.Вставить("СетьЗапрос", "Покупателя");
	ИменаПрочихНастроек.Вставить("ПоставщикПодписка", "ДокументовПоставщик");
	ИменаПрочихНастроек.Вставить("ПоставщикЗапрос", "Поставщика");
	ИменаПрочихНастроек.Вставить("Прайс-листЗапрос", "ПрайсЛист");
	ИменаПрочихНастроек.Вставить("Прайс-листПодписка", "ПрайсЛист");
	ИменаПрочихНастроек.Вставить("Неструкт. докум.Запрос", "Condra");
	ИменаПрочихНастроек.Вставить("Неструкт. докум.Подписка", "ДокументовCondra");
	ИменаПрочихНастроек.Вставить("ЭТРНЗапрос", "ЭТРН");
	ИменаПрочихНастроек.Вставить("ЭТРНПодписка", "ДокументовЭТРН");	
	
	ИмяТекстаЗапроса = ПараметрыВосстановления.НачалоКонстанты + ИменаПрочихНастроек.Получить(ТекущиеДанные.ТипОбмена  + ПараметрыВосстановления.ВидНастройки);	
	     
	ОбработкаОкончанияПомещения = Новый ОписаниеОповещения("ОповещениеВыборФайлаНастройки", ЭтаФорма, ИмяТекстаЗапроса);
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.Фильтр             = "Настройка по документу (*.xml)|*.xml|Текстовый документ(*.txt)|*.txt";
	ДиалогОткрытияФайла.ИндексФильтра      = 0; 
	НачатьПомещениеФайлов(ОбработкаОкончанияПомещения, , ДиалогОткрытияФайла, Истина, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ОповещениеВыборФайлаНастройки(ВыбранныеФайлы, ИмяТекстаЗапроса) Экспорт
	
    Если ВыбранныеФайлы = Неопределено Тогда
        Возврат;
    КонецЕсли;    
	
	Если ВыбранныеФайлы.Количество() = 1 Тогда	
		
		ВыбФайл  = ВыбранныеФайлы[0];
		ПолноеИмяФайла = ВыбФайл.ПолноеИмя;
		ИмяФайла = ВыбФайл.Имя;
		
		Файл = Новый Файл(ПолноеИмяФайла);
		Если НЕ Файл.Существует() Тогда
			Сообщить("Найстройки не загружены. Выбранного файла не существует.");
			Возврат;
		КонецЕсли;
		
		Если НРег(Файл.Расширение) = ".1ct" Тогда
			ФайлТЗ = Новый ТекстовыйДокумент;
			ФайлТЗ.Прочитать(ПолноеИмяФайла); 
			ТекстЗапроса = XMLЗначение(Тип("ХранилищеЗначения"), ФайлТЗ.ПолучитьТекст()).Получить();
		ИначеЕсли НРег(Файл.Расширение) = ".xml" Тогда
			НовоеЧтениеXML = Новый ЧтениеXML;
			НовоеЧтениеXML.ОткрытьФайл(ПолноеИмяФайла);
			НовыйСериализаторXDTO = Новый СериализаторXDTO(ФабрикаXDTO);
			ТекстЗапроса = НовыйСериализаторXDTO.ПрочитатьXML(НовоеЧтениеXML);
		ИначеЕсли НРег(Файл.Расширение) = ".txt" Тогда
			Файл =  Новый ЧтениеТекста(ПолноеИмяФайла, КодировкаТекста.UTF8);
			ТекстЗапроса = Файл.Прочитать();
		Иначе
			Предупреждение("Формат <" + НРег(Файл.Расширение) + "> не поддерживается!", СтатусСообщения.Информация);
			Возврат;
		КонецЕсли;
		
		
		ПараметрыФункции = Новый Массив;
		ПараметрыФункции.Добавить("_" +ИмяТекстаЗапроса);		
		ПараметрыФункции.Добавить(ТекстЗапроса);
		ПараметрыФункции.Добавить("Служебный");
		НастройкаЗаписана = ВернутьРезультатИзМодуляОбъекта("Настройка_Параметр_Записать", ПараметрыФункции);
		ОбновитьВсеРолиНаСервере();

	КонецЕсли;
	
	Если НастройкаЗаписана = 1 Или НастройкаЗаписана = Истина Тогда  
		Состояние("Настройки загружены!",100, ИмяФайла, БиблиотекаКартинок.ЭКОМ_ОбщаяКартинка);
		ОбновитьВсеРолиНаСервере();
	КонецЕсли;
КонецПроцедуры 


&НаКлиенте
Процедура ЭКОМ_ПрочиеНастройкиПриАктивизацииСтроки(Элемент)
	
	Если Элемент.ТекущиеДанные = Неопределено 
		ИЛИ Элемент.ТекущаяСтрока = Неопределено Тогда
    	Возврат;
	КонецЕсли;
	
	Элементы.ГруппаРольЭТРН.Видимость = Ложь;
	Если Элемент.ТекущиеДанные.ТипОбмена = "ЭТРН" Тогда		 
		 Элементы.ГруппаРольЭТРН.Видимость = Истина;
		 
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЭКОМ_ПрочиеНастройкиПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если Элемент.ТекущиеДанные = Неопределено 
		ИЛИ Элемент.ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Элемент.ТекущиеДанные.ТипОбмена = "Сеть" Тогда
		ЭтаФорма.ЭКОМ_ОбменСеть = Элемент.ТекущиеДанные.Использовать;
		ЗаполнитьСписокДляИзменения(ЭтаФорма.ЭКОМ_ОбменСеть, "ЭКОМ_ОбменСеть");
		
	ИначеЕсли Элемент.ТекущиеДанные.ТипОбмена = "Поставщик" Тогда
		ЭтаФорма.ЭКОМ_ОбменПоставщик = Элемент.ТекущиеДанные.Использовать;
		ЗаполнитьСписокДляИзменения(ЭтаФорма.ЭКОМ_ОбменПоставщик, "ЭКОМ_ОбменПоставщик");
		
	ИначеЕсли Элемент.ТекущиеДанные.ТипОбмена = "ЭТРН" Тогда
		ЭтаФорма.ЭКОМ_ОбменЭТРН = Элемент.ТекущиеДанные.Использовать;
		ЗаполнитьСписокДляИзменения(ЭтаФорма.ЭКОМ_ОбменЭТРН, "ЭКОМ_ОбменЭТРН");
		
		Если ЭтаФорма.ЭКОМ_ТипОбменаЭТРН_Отправитель = Ложь
			И ЭтаФорма.ЭКОМ_ТипОбменаЭТРН_Получатель = Ложь
			И ЭтаФорма.ЭКОМ_ТипОбменаЭТРН_Перевозчик = Ложь Тогда
			  ЭтаФорма.ЭКОМ_ТипОбменаЭТРН_Отправитель = Истина;
			  ЗаполнитьСписокДляИзменения(ЭтаФорма.ЭКОМ_ТипОбменаЭТРН_Отправитель, "ЭКОМ_ТипОбменаЭТРН_Отправитель");
		КонецЕсли;
		
	ИначеЕсли Элемент.ТекущиеДанные.ТипОбмена = "Неструкт. докум." Тогда
		ЭтаФорма.ЭКОМ_ОбменCondra = Элемент.ТекущиеДанные.Использовать;
		ЗаполнитьСписокДляИзменения(ЭтаФорма.ЭКОМ_ОбменCondra, "ЭКОМ_ОбменCondra");
		
	ИначеЕсли Элемент.ТекущиеДанные.ТипОбмена = "Прайс-лист" Тогда
		ЭтаФорма.ЭКОМ_ОбменПрайсЛист = Элемент.ТекущиеДанные.Использовать;
		ЗаполнитьСписокДляИзменения(ЭтаФорма.ЭКОМ_ОбменПрайсЛист, "ЭКОМ_ОбменПрайсЛист");
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИсточникДляИсходящихДокументов(АлгоритмЗаполненияСписка, СписокВыбора)
	
	ТекстЗапроса = "";
	
	Попытка
		
		Выполнить(АлгоритмЗаполненияСписка);
		Запрос = Новый Запрос;		               
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("ДатаНач", ТекущаяДата());
		Запрос.УстановитьПараметр("ДатаКон", ТекущаяДата());	
		Запрос.УстановитьПараметр("масПомеченныхДоков", Новый Массив);
		Запрос.УстановитьПараметр("НаправлениеОбмена" , Перечисления.ЭКОМ_НаправлениеОбмена.ПустаяСсылка());
		
		РезультатЗапроса = Запрос.Выполнить();
		КолонкиЗапроса = РезультатЗапроса.Колонки;				
		Для каждого ТекКолонка Из КолонкиЗапроса Цикл
			СписокВыбора.Добавить(ТекКолонка.Имя);			
		КонецЦикла;
		
	Исключение				
	КонецПопытки;
	     
КонецПроцедуры

&НаКлиенте
Процедура ФильтрПоСоответствиямНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СписокФильтров = Новый СписокЗначений;
	СписокФильтров.Добавить("Организация_"   , "Организация");
    СписокФильтров.Добавить("Контрагент_"    , "Контрагент");
	СписокФильтров.Добавить("ТочкаДоставки_" , "Точка доставки");
	СписокФильтров.Добавить("Номенклатура_"  , "Номенклатура");
	
	НачальноеЗначение = 0;
	Если НЕ ЭтаФорма.ФильтрПоСоответствиям.Количество() = 0  Тогда
		НайденноеЗначение = СписокФильтров.НайтиПоЗначению(ЭтаФорма.ФильтрПоСоответствиям[0].Значение);
		Если НЕ НайденноеЗначение = Неопределено Тогда
			НачальноеЗначение = СписокФильтров.Индекс(НайденноеЗначение);
		КонецЕсли;
	КонецЕсли;
		
	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("ДанныеВыбора", ДанныеВыбора);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьПослеВыбораФильтра", ЭтаФорма, ПараметрыОповещения);
	ПоказатьВыборИзСписка(ОписаниеОповещения, СписокФильтров, Элемент, НачальноеЗначение);

КонецПроцедуры

