// Аналог метода НайтиСтроки коллекции строк дерева значений, используемый в случае использования дерева значений в управляемых формах.
//
//Параметры:
// КоллекцияСтрок – ДанныеФормыКоллекцияЭлементовДерева – Коллекция подчиненных строк элемента дерева значений, используемого в управляемых формах.
// ПараметрыОтбора - Структура - Структура с критериями поиска.
//                               Задает условия поиска: ключ структуры определяет имя колонки, по которой будет осуществляться поиск,
//                               а значение структуры - искомое значение.
//                               Структура без полей означает "выбрать все подчиненные строки".
// ВключатьПодчиненные - Булево - Определяет, будет ли производиться поиск также в подчиненных коллекциях (если таковые имеются).
//                                Истина - поиск будет произведен.
//
//Возвращаемое значение:
// Массив(ДанныеФормыЭлементДерева) – Массив из строк дерева значений, соответствующих заданному условию поиска.
&НаКлиенте
Функция ДанныеФормыКоллекцияЭлементовДереваНайтиСтроки(КоллекцияСтрок, ПараметрыОтбора, ВключатьПодчиненные = Ложь) Экспорт
	Результат = Новый Массив;
	Для Каждого СтрокаТекущая Из КоллекцияСтрок Цикл
		СтрокаНайдена = Истина;
		Для Каждого КлючИЗначение Из ПараметрыОтбора Цикл
			Если СтрокаТекущая[КлючИЗначение.Ключ] <> КлючИЗначение.Значение Тогда
				СтрокаНайдена = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если СтрокаНайдена Тогда
			Результат.Добавить(СтрокаТекущая);
		КонецЕсли;
		Если ВключатьПодчиненные Тогда
			ПодчиненныеСтроки = ДанныеФормыКоллекцияЭлементовДереваНайтиСтроки(СтрокаТекущая.ПолучитьЭлементы(), ПараметрыОтбора, ВключатьПодчиненные);
			Для Каждого НайденнаяСтрока Из ПодчиненныеСтроки Цикл
				Результат.Добавить(НайденнаяСтрока);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Если Результат.Количество() = 0 Тогда
	     Результат.Добавить(Неопределено);	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура СтруктураФайлаXMLВходящиеПриАктивизацииЯчейки(Элемент)
    
	Если Элементы[Элемент.Имя].ТекущиеДанные = Неопределено
		ИЛИ НЕ Элемент.ТекущийЭлемент.Вид = ВидПоляФормы.ПолеВвода Тогда
		Возврат;
	КонецЕсли;
	
	ПолеВвода 	= Элемент.ТекущийЭлемент;
	Родитель 	= Элементы[Элемент.Имя].ТекущиеДанные.ПолучитьРодителя();
	Строки 		= Элементы[Элемент.Имя].ТекущиеДанные.ПолучитьЭлементы();
	СписокВыбора = Новый Массив;
		
	ПолеВвода.СписокВыбора.Очистить();
	
	// Запрещаем активацию строки для "Входящий ORDER" и "Входящий RECADV", кроме пунктов "СлужебныеТекст",
	// "Сохранение" и "Загрузка". Запрещаем активацию строки любого пункта для неопределенного типа транзакции.
	ЭтоВходящийEDI = Ложь;
	Если Строки.Количество() > 0  Тогда
		Если Уровень(Элементы[Элемент.Имя].ТекущиеДанные) = 0 И
			(((НЕ Элемент.Имя = "СтруктураФайлаXMLДокументы" И Найти(Элементы[Элемент.Имя].ТекущиеДанные.ТипТранзакции, "Входящий") = 1)
			И НЕ (Элемент.ТекущийЭлемент.Имя = "СтруктураФайлаXMLВходящиеСлужебныеТекст" 
			ИЛИ Элемент.ТекущийЭлемент.Имя = "СтруктураФайлаXMLВходящиеСохранение"
			ИЛИ Элемент.ТекущийЭлемент.Имя = "СтруктураФайлаXMLВходящиеЗагрузка"))
			ИЛИ (НЕ Элемент.Имя = "СтруктураФайлаXMLДокументы" И ПустаяСтрока(Элементы[Элемент.Имя].ТекущиеДанные.ТипТранзакции))) Тогда
			
			ЭтоВходящийEDI = Истина;
		
		КонецЕсли;	
	КонецЕсли;
	
	Если Элемент.Имя = "СтруктураФайлаXMLДокументы"  Тогда
		Элементы[Элемент.Имя + "Формула"].ТолькоПросмотр = ЭтоВходящийEDI ИЛИ Элементы[Элемент.Имя].ТекущиеДанные.ПолучитьЭлементы().Количество() > 0;
	КонецЕсли;
	
	Если Элемент.ТекущийЭлемент.Имя = "СтруктураФайлаXMLВходящиеТипТранзакции" Тогда
		
		Если Родитель = Неопределено Тогда
			СписокВыбора = Вычислить("ЭКОМ_ОбщегоНазначения.ДокументыСписокВыбораПолучить(""ТипТразакцийВходящий"")");
		КонецЕсли;
		
	ИначеЕсли Элемент.ТекущийЭлемент.Имя = "СтруктураФайлаXMLДокументыКолонкаИсточника" 
		И Родитель = Неопределено Тогда
		
		ДанныеПоКолонкам = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьДанныеПоКолонкамИсточника()");
		Для каждого Данные Из ДанныеПоКолонкам Цикл
			СписокВыбора.Добавить(Данные.Ключ);
		КонецЦикла;
		
	ИначеЕсли НЕ ЭтоВходящийEDI И (Элемент.ТекущийЭлемент.Имя = Элемент.Имя + "Приемник"
		ИЛИ Элемент.ТекущийЭлемент.Имя = Элемент.Имя + "Источник") Тогда

		ТекущийЭлементИмя = СтрЗаменить(Элемент.ТекущийЭлемент.Имя, Элемент.Имя, "");
		
		Если Родитель = Неопределено Тогда // Выбор документа
			
			Для Каждого ДокументКонфигурации Из ЭтаФорма.СлужебныйДеревоКонфигурации.ПолучитьЭлементы() Цикл
				СписокВыбора.Добавить(ДокументКонфигурации.Имя);
			КонецЦикла;
			
		КонецЕсли;				
	КонецЕсли;
	
	ПолеВвода.СписокВыбора.ЗагрузитьЗначения(СписокВыбора);
    ПолеВвода.СписокВыбора.СортироватьПоЗначению();
	
КонецПроцедуры

&НаКлиенте
Процедура СтруктураФайлаXMLВходящиеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если ВыбраннаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Запрещаем выбор для "Входящий ORDER" и "Входящий RECADV", кроме пунктов "СлужебныеТекст",
	// "Сохранение" и "Загрузка". Запрещаем выбор любого пункта для неопределенного типа транзакции.
    ТекДанныеСтруктурыФайла = Элементы[Элемент.Имя].ТекущиеДанные;
	
	Если ((НЕ Элемент.Имя = "СтруктураФайлаXMLДокументы" 
		И Найти(ТекДанныеСтруктурыФайла.ТипТранзакции, "Входящий") = 1)
        И НЕ (Поле.Имя = "СтруктураФайлаXMLВходящиеСлужебныеТекст" 
		ИЛИ Поле.Имя = "СтруктураФайлаXMLВходящиеСохранение"
        ИЛИ Поле.Имя = "СтруктураФайлаXMLВходящиеЗагрузка"
		ИЛИ Поле.Имя = "СтруктураФайлаXMLВходящиеКнопка"))
        ИЛИ (НЕ Элемент.Имя = "СтруктураФайлаXMLДокументы" 
		И  ПустаяСтрока(ТекДанныеСтруктурыФайла.ТипТранзакции)) Тогда
		Если (НЕ Элемент.Имя = "СтруктураФайлаXMLДокументы" 
			И  ПустаяСтрока(ТекДанныеСтруктурыФайла.ТипТранзакции)) 
			И (Поле.Имя = "СтруктураФайлаXMLВходящиеЗагрузка") Тогда
            ПоказатьПредупреждение(Новый ОписаниеОповещения, "Выберите тип транзакции для загружаемых настроек", , "Загрузка настроек из файла");
        	Возврат;
        КонецЕсли;
	КонецЕсли;
	
	Если (Поле.Имя = "СтруктураФайлаXMLВходящиеСлужебныеТекст" 
		ИЛИ Поле.Имя = "СтруктураФайлаXMLДокументыСлужебныеТекст")
		И Уровень(ТекДанныеСтруктурыФайла) = 0 Тогда
			
		СтандартнаяОбработка 	= Ложь;
		СлужебныеДо = ТекДанныеСтруктурыФайла.Служебные; // лишняя переменная?
						
		ИмяОткрываемойФормы = ЭтаФорма.СлужебныйПолноеИмяФормы + ".Форма.УФ_ФормаКонсольЗапросов";
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ИмяТабличнойЧасти", Элемент.Имя);
		ДопПараметры.Вставить("ИмяЭлементаФормы" , Поле.Имя);	
		ДопПараметры.Вставить("ИмяФормы"         , "УФ_ФормаКонсольЗапросов");
			
		ОповещениеОЗакрытии = Новый ОписаниеОповещения("ОбработкаЗакрытия", ЭтаФорма, ДопПараметры);
		
		Если ТекДанныеСтруктурыФайла.Свойство("Приемник") Тогда
			ТипДокументаПриемника = ТекДанныеСтруктурыФайла.Приемник;
		Иначе	
			ТипДокументаПриемника = Неопределено;
		КонецЕсли;

		Если ТекДанныеСтруктурыФайла.Свойство("КолонкаИсточника") Тогда
			ТипДокументаИсточника = ТекДанныеСтруктурыФайла.КолонкаИсточника;
		Иначе	
			ТипДокументаИсточника = Неопределено;
		КонецЕсли;

		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Заголовок"            , "Обработка записи документа");
		ПараметрыФормы.Вставить("ТипДокументаПриемника", ТипДокументаПриемника);
		ПараметрыФормы.Вставить("ТипДокументаИсточника", ТипДокументаИсточника);
		ПараметрыФормы.Вставить("ТекстНачальный", ТекДанныеСтруктурыФайла.Служебные);
		Если ТекДанныеСтруктурыФайла.Свойство("ТипТранзакции") = Истина Тогда				
			ПараметрыФормы.Вставить("СправкаКФорме", "Источник, пример кода:
				|Источник.Комментарий = ""Тест"";");
		КонецЕсли;

        ПараметрыФормы.Вставить("ДопПараметры", ДопПараметры); 
		ОткрытьФорму(ИмяОткрываемойФормы, ПараметрыФормы,,,,,ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
		
		ЗаполнитьСписокДляИзменения(Элемент.Имя, "_" + Элемент.Имя);

	ИначеЕсли Поле.Имя	= Элемент.Имя + "Сохранение" И Уровень(ТекДанныеСтруктурыФайла) = 0 Тогда
		Если ПроверитьЗаполнениеТекстаНастроекСтруктурыФайлаXML(ТекДанныеСтруктурыФайла) Тогда //DocRobot 1.21.0 20220207 MOD-1562 [отключить сохранение пустого шаблона]
			СохранитьНастройкуXML(Элемент.Имя);
		КонецЕсли;
		
	ИначеЕсли Поле.Имя	= Элемент.Имя + "Загрузка" И Уровень(ТекДанныеСтруктурыФайла) = 0 Тогда
		ВосстановитьНастройкуXML(Элемент.Имя);
		
	ИначеЕсли Поле.Имя	= Элемент.Имя + "Кнопка" 
		И Уровень(ТекДанныеСтруктурыФайла) = 0 Тогда
		
		Если Элемент.Имя = "СтруктураФайлаXMLДокументы" Тогда
			ИмяКнопкиПоУмолчнию = "для создания документов";
		Иначе	
			ИмяКнопкиПоУмолчнию = ТекДанныеСтруктурыФайла.ТипТранзакции;
		КонецЕсли;
		
		СформироватьНастройкиКнопки(ИмяКнопкиПоУмолчнию, ТекДанныеСтруктурыФайла, СтандартнаяОбработка, Поле.Имя, Элемент.Имя);
		
		ЗаполнитьСписокДляИзменения(Элемент.Имя, "_" + Элемент.Имя);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ПроверитьЗаполнениеТекстаНастроекСтруктурыФайлаXML(ВыбраннаяСтрока)
	
	Если ПустаяСтрока(ВыбраннаяСтрока.Служебные) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Сохранение пустого текста настроек невозможно";
		Сообщение.Сообщить();
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Функция Уровень(СтрокаДерева)
   Родитель = СтрокаДерева.ПолучитьРодителя();
   Возврат ?(Родитель=Неопределено, 0, 1+Уровень(Родитель));
КонецФункции

#Область СохранениеНастроек

&НаСервере
Функция СохранитьНастройкуXMLСервер(ТабличоеПолеИмя, Значение, ИмяКолонки)
	
	// создаем на клиенте текстовый файл
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");

	ДеревоОбъект    = РеквизитФормыВЗначение(ТабличоеПолеИмя);
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Колонки = Новый Массив;
	Для Каждого Колонка Из ДеревоОбъект.Колонки Цикл
		Колонки.Добавить(Колонка.Имя);
	КонецЦикла;
		
	Дерево = Новый ДеревоЗначений;
	Для Каждого Колонка Из Колонки Цикл
		Дерево.Колонки.Добавить(Колонка);
	КонецЦикла;

	НайденнаяСтрока = ДеревоОбъект.Строки.Найти(Значение, ИмяКолонки); 

	ОбработкаОбъект.СкопироватьСтрокуДереваЗначений(НайденнаяСтрока, Дерево.Строки.Добавить(), Колонки);
	
	Запись = Новый ЗаписьXML;
	Запись.ОткрытьФайл(ИмяВременногоФайла);    
	
	НовыйСериализаторXDTO = Новый СериализаторXDTO(ФабрикаXDTO);
	НовыйСериализаторXDTO.ЗаписатьXML(Запись, Дерево, НазначениеТипаXML.Явное);
	
	Запись.Закрыть();
	
	АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяВременногоФайла));

	Возврат АдресВоВременномХранилище;
	
КонецФункции

&НаКлиенте
Процедура СохранитьНастройкуXML(ТабличоеПолеИмя) 
	
	Если ТабличоеПолеИмя = "СтруктураФайлаXMLВходящие"
		ИЛИ ТабличоеПолеИмя = "СтруктураФайлаXMLИсходящие" Тогда
		Реквизит = "ТипТранзакции";
	ИначеЕсли ТабличоеПолеИмя = "СтруктураФайлаXMLДокументы" Тогда
		Реквизит = "Кнопка";
	КонецЕсли;
	
	ВерсияОбработки = ПолучитьВерсиюОбработкиНаСервере();
	Значение = Элементы[ТабличоеПолеИмя].ТекущиеДанные[Реквизит];
    ИмяФайлаПоУмолчанию = Вычислить("ЭКОМ_ОбщегоНазначенияКлиент.ПолучитьИмяСохраняемогоФайла(ВерсияОбработки, Значение, ТабличоеПолеИмя)");

	АдресВоВременномХранилище = СохранитьНастройкуXMLСервер(ТабличоеПолеИмя, Значение, Реквизит);		
	
	СохранениеФайла(АдресВоВременномХранилище, ИмяФайлаПоУмолчанию);
					
КонецПроцедуры

&НаСервере
Функция ПолучитьВерсиюОбработкиНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаОбъект.ПолучитьВерсиюОбработки();
	
КонецФункции

#КонецОбласти

#Область ВосстановлениеНастроек

&НаКлиенте
Процедура ВосстановитьНастройкуXML(ТабличоеПолеИмя)
	     
	ОбработкаОкончанияПомещения = Новый ОписаниеОповещения("ОповещениеВыборФайла", ЭтаФорма, ТабличоеПолеИмя);
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.Фильтр             = "Настройка по документу (*.xml)|*.xml|Таблица значений 1С (*.1ct)|*.1ct";
	ДиалогОткрытияФайла.ИндексФильтра      = 0; 
	НачатьПомещениеФайлов(ОбработкаОкончанияПомещения, , ДиалогОткрытияФайла, Истина, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеВыборФайла(ВыбранныеФайлы, ТабличоеПолеИмя) Экспорт
	
    Если ВыбранныеФайлы = Неопределено Тогда
        Возврат;
    КонецЕсли;    
	
	Если ВыбранныеФайлы.Количество() = 1 Тогда	
		// Запоминаем текущий выделенный элемент дерева
		ТекущиеДанные       = Элементы[ТабличоеПолеИмя].ТекущиеДанные;
		ИндексСтроки        = ЭтаФорма[ТабличоеПолеИмя].ПолучитьЭлементы().Индекс(ТекущиеДанные);
		ИдентификаторСтроки = Элементы[ТабличоеПолеИмя].ТекущаяСтрока;
		
		ВыбФайл                   = ВыбранныеФайлы[0];
		АдресВоВременномХранилище = ВыбФайл.Хранение;
        ПутьКФайлу                = ВыбФайл.Имя;
		
		ВыборФайлаНаСервере(ПутьКФайлу, ИндексСтроки, ТабличоеПолеИмя, АдресВоВременномХранилище);
		
		// Выделяем ранее запомненный элемент
		ТекущиеДанные = ЭтаФорма[ТабличоеПолеИмя].ПолучитьЭлементы().Получить(ИндексСтроки);
		Если ТекущиеДанные.Свойство("ТипТранзакции") И НастройкаДанногоТипаУжеИспользуется(ЭтаФорма[ТабличоеПолеИмя].ПолучитьЭлементы(), ТекущиеДанные.ТипТранзакции) Тогда
			ТекущиеДанные.Использовать = Ложь;
			ЭКОМ_ОбщегоНазначения.СообщитьПользователю("Шаблон настроек с типом транзакции " + ТекущиеДанные.ТипТранзакции + " уже используется, " 
			+ "загружаемый шаблон " + ТекущиеДанные.Кнопка + " добавлен без флажка ""Использовать""");
		КонецЕсли;      

		ИдентификаторСтроки = ТекущиеДанные.ПолучитьИдентификатор();
		Элементы[ТабличоеПолеИмя].ТекущаяСтрока = ИдентификаторСтроки;
	КонецЕсли;	
    Состояние("Настройки загружены!",100, ПутьКФайлу, БиблиотекаКартинок.ЭКОМ_ОбщаяКартинка);

КонецПроцедуры  

&НаСервере
Процедура ВыборФайлаНаСервере(Знач ПутьКФайлу, ИндексСтроки, ТабличоеПолеИмя, АдресВоВременномХранилище = Неопределено) Экспорт
	
	ДеревоОбъект    = РеквизитФормыВЗначение(ТабличоеПолеИмя);
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    
    Файл            = Новый Файл(ПутьКФайлу);
    РасширениеФайла = Файл.Расширение;
    
    Если АдресВоВременномХранилище <> Неопределено Тогда
        ФайлИзХранилища         = ПолучитьИзВременногоХранилища(АдресВоВременномХранилище);
        ПолноеИмяФайлаНаСервере = ПолучитьИмяВременногоФайла(РасширениеФайла);
        
        ФайлИзХранилища.Записать(ПолноеИмяФайлаНаСервере);    
    Иначе
        ПолноеИмяФайлаНаСервере = ПутьКФайлу;
    КонецЕсли;

	Если НРег(РасширениеФайла) = ".1ct" Тогда // Старый формат
		
		ФайлТЗ = Новый ТекстовыйДокумент;
		ФайлТЗ.Прочитать(ПолноеИмяФайлаНаСервере);
		
		ДанныеТЗ = XMLЗначение(Тип("ХранилищеЗначения"), ФайлТЗ.ПолучитьТекст()).Получить();
						
	ИначеЕсли НРег(РасширениеФайла) = ".xml" Тогда // Новый формат
		
		НовоеЧтениеXML = Новый ЧтениеXML;
		НовоеЧтениеXML.ОткрытьФайл(ПолноеИмяФайлаНаСервере);
		НовыйСериализаторXDTO = Новый СериализаторXDTO(ФабрикаXDTO);
		ДанныеТЗ = НовыйСериализаторXDTO.ПрочитатьXML(НовоеЧтениеXML);

	Иначе
		Сообщить("Формат [" + НРег(Файл.Расширение) + "] не поддерживается!", СтатусСообщения.Информация);
	КонецЕсли;
	
	Колонки = Новый Массив;	
	Для Каждого Колонка Из ДанныеТЗ.Колонки Цикл
		Колонки.Добавить(Колонка.Имя);
	КонецЦикла;

	ДеревоОбъект.Строки.Удалить(ИндексСтроки);
		
	// Коопируем строку в новое место.
	НоваяСтрока = ДеревоОбъект.Строки.Добавить();
	ОбработкаОбъект.СкопироватьСтрокуДереваЗначений(ДанныеТЗ.Строки.Получить(0), НоваяСтрока, Колонки, ТабличоеПолеИмя); //Docrobot 1.21.0 MOD-280 [Добавлено ТабличоеПолеИмя]
	ДеревоОбъект.Строки.Сдвинуть(ДеревоОбъект.Строки.Индекс(НоваяСтрока), ИндексСтроки - ДеревоОбъект.Строки.Индекс(НоваяСтрока));
	
	ЗначениеВРеквизитФормы(ДеревоОбъект, ТабличоеПолеИмя);
	
КонецПроцедуры // ОповещениеВыборФайлаНаСервере() 

#КонецОбласти

&НаКлиенте
Процедура НастройкаДокументовЗагрузитьНастройкиВсе(Команда)
	Если Модифицированность Тогда
		 Оповещение = Новый ОписаниеОповещения("ПередЗагрузкойВсехНастроек", ЭтаФорма);
		 ПоказатьВопрос(Оповещение, "Имеются несохраненные изменения, для продолжения требуется запись настроек. Сохранить?", РежимДиалогаВопрос.ОКОтмена);
	 Иначе
		 ПередЗагрузкойВсехНастроек();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗагрузкойВсехНастроек(Результат = Неопределено, Параметры = Неопределено) Экспорт
	Если ТипЗнч(Результат) = Тип("КодВозвратаДиалога") И Результат = КодВозвратаДиалога.ОК Тогда
		ВызватьДиалог = Ложь;
		СохранитьИзмененныеНастройки(, ВызватьДиалог);
	ИначеЕсли ТипЗнч(Результат) = Тип("КодВозвратаДиалога") И Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;	
	
	ОбработкаОкончанияПомещения = Новый ОписаниеОповещения("ОповещениеЗагрузитьНастройкиВсе", ЭтаФорма);
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.Фильтр             = "Файл гибких настроек документов XML (*.xml)|*.xml|Таблица значений 1С (*.1ct)|*.1ct";
	ДиалогОткрытияФайла.ИндексФильтра      = 0; 
	НачатьПомещениеФайлов(ОбработкаОкончанияПомещения, , ДиалогОткрытияФайла, Истина, УникальныйИдентификатор);  	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеЗагрузитьНастройкиВсе(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;    
	
	Если ВыбранныеФайлы.Количество() = 1 Тогда			
		ВыбФайл = ВыбранныеФайлы[0];
		ИмяФайла = ВыбФайл.Имя;
		АдресВоВременномХранилище = ВыбФайл.Хранение;
		РезультатЧтенияФайла = ПолучитьЗагружаемыеНастройки(ИмяФайла, АдресВоВременномХранилище);
		
		Если РезультатЧтенияФайла.Свойство("Получены") Тогда   			
			ПараметрыОткрываемойФормы = Новый Структура;
			ПараметрыОткрываемойФормы.Вставить("ТипОперации", "Загрузка");
			ПараметрыОткрываемойФормы.Вставить("ТипыТранзакций", РезультатЧтенияФайла.ЗагружаемыеНастройки);
			
			ДополнительныеПараметры = Новый Структура("ТаблицаНастроек", РезультатЧтенияФайла.ТаблицаНастроек);
			
			ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПослеПолученияЗагружаемыНастроек", ЭтаФорма, ДополнительныеПараметры);
			ОткрытьФорму(ЭтаФорма.СлужебныйПолноеИмяФормы + ".Форма.УФ_ВыборСохраняемыхНастроек", ПараметрыОткрываемойФормы,,,,, ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);  			
		КонецЕсли; 		
	КонецЕсли;	
	
КонецПроцедуры  

&НаКлиенте
Процедура ПослеПолученияЗагружаемыНастроек(Результат, ДополнительныеПараметры) Экспорт
	АдресТаблицы    = Неопределено;
	МассивКонстант  = Неопределено;
	МассивНастроек  = Неопределено;
	
	Если Результат.Свойство("МассивКонстант", МассивКонстант) = Ложь 
		ИЛИ Результат.Свойство("ВыбранныеТипы", МассивНастроек) = Ложь
		ИЛИ ДополнительныеПараметры.Свойство("ТаблицаНастроек", АдресТаблицы) = Ложь Тогда
		
		Если Не Результат.Свойство("Отменить") Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Сохранение настроек не может быть выполнено, не выбран каталог сохранения или не удалось передать структуру сохраняемых настроек";
			Сообщение.Сообщить();
		КонецЕсли;
		Возврат;
		
	КонецЕсли;
	
	ПослеПолученияЗагружаемыхНастроекНаСервере(АдресТаблицы, МассивКонстант, МассивНастроек);
	
	СтраницаПриОткрытии = "ГруппаНастройкиДокументов"; //Docrobot 1.20.0 MOD-1343 [Иначе при вызове ПриОткрытии меняется на последнюю сохраненную страницу]
	ПриОткрытии(Ложь);                                 //Docrobot 1.20.0 MOD-1343 []
КонецПроцедуры

&НаСервере
Процедура ПослеПолученияЗагружаемыхНастроекНаСервере(АдресТаблицы, МассивКонстант, МассивНастроек)
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ЗагрузитьНастройкиПоДокументам(АдресТаблицы, МассивКонстант, МассивНастроек);
	
	МассивЛогаСобытий = Новый Массив;
	ПараметрыФункции  = Новый Массив;
	ПараметрыФункции.Добавить(Ложь);
	ПараметрыФункции.Добавить(МассивЛогаСобытий);
	БекапНастроек = ВернутьРезультатИзМодуляОбъекта("ИзменитьФорматПользовательскихНастроек", ПараметрыФункции);
	
	// обновление загруженных настроек
	ПриСозданииНаСервере(Ложь, Истина);
	Элементы.ГруппаПанельНастроек.ТекущаяСтраница = Элементы.ГруппаНастройкиДокументов;
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = "Выбранные настройки загружены.";
	Сообщение.Сообщить();
КонецПроцедуры

&НаСервере
Функция ПолучитьЗагружаемыеНастройки(ПутьКФайлу, АдресВоВременномХранилище)  	
	
	ИмяСобытия = "Загрузить все гибкие настройки";
	Результат  = Новый Структура;
	Результат.Вставить("Получены", Ложь);
	Результат.Вставить("СтарыйФормат", Ложь);
	МассивЛогаСобытий = Новый Массив;

	
	Файл = Новый Файл(ПутьКФайлу);
	Если НРег(Файл.Расширение) = ".1ct" Тогда // Старый формат
		ФайлТЗ = Новый ТекстовыйДокумент;
		ФайлТЗ.Прочитать(ПутьКФайлу); 
		Данные = ФайлТЗ.ПолучитьТекст();	
		
		ДанныеТЗ = XMLЗначение(Тип("ХранилищеЗначения"), Данные).Получить();		
		Для Каждого Элемент Из ДанныеТЗ Цикл
			УстановитьЗначениеРеквизитаФормы(Элемент.Ключ, Элемент.Значение);
		КонецЦикла; 
		
		ТекстЛогаСобытий = "Для данного формата недоступен выбор загружаемых настроек, будут загружены все. " + Символы.ПС  
		+ "Настройки загружены на форму - перехожу к сохранению в регистр без подтверждений..." + Символы.ПС
		+ "Настройки сохранены.";	
		ЗаписьСтруктурыЛога = ЭКОМ_ОбщегоНазначения.ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Информация, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
		ПараметрыФункции = Новый Массив;
		ПараметрыФункции.Добавить(Ложь);
		ПараметрыФункции.Добавить(МассивЛогаСобытий);
		БекапНастроек = ВернутьРезультатИзМодуляОбъекта("ИзменитьФорматПользовательскихНастроек", ПараметрыФункции);
		
		// обновление загруженных настроек
		ПриСозданииНаСервере(Ложь, Истина);

		Результат.СтарыйФормат = Истина;
		
	ИначеЕсли НРег(Файл.Расширение) = ".xml" Тогда // Новый формат
		ОбработкаОбъект 	 = РеквизитФормыВЗначение("Объект");
		РезультатЧтенияФайла = ОбработкаОбъект.ПолучитьСоставЗагружаемыхНастроек(АдресВоВременномХранилище);
		
		НастройкиПолучены = Ложь;
		Если РезультатЧтенияФайла.Свойство("Получены", НастройкиПолучены) И НастройкиПолучены Тогда
			Результат = РезультатЧтенияФайла;
			Результат.Вставить("СтарыйФормат", Ложь);
		КонецЕсли; 
	Иначе
		ТекстЛогаСобытий = "Формат [" + НРег(Файл.Расширение) + "] не поддерживается!";	
		ЗаписьСтруктурыЛога = ЭКОМ_ОбщегоНазначения.ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
	КонецЕсли;
	
	Если МассивЛогаСобытий.Количество() > 0  Тогда
		Попытка
			Выполнить("ЭКОМ_ОбщегоНазначения.ЗаписатьЛогСобытийвРегистрЛогирование(МассивЛогаСобытий);");
		Исключение
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий)");
			Сообщение.Сообщить();
		КонецПопытки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗагрузитьГибкиеНастройкиДокументовВсе(ПутьКФайлу, АдресВоВременномХранилище)
	
	ИмяСобытия = "Загрузить все гибкие настройки";
	МассивЛогаСобытий = Новый Массив;
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Файл = Новый Файл(ПутьКФайлу);
	Загружены = Ложь;
	Если НРег(Файл.Расширение) = ".1ct" Тогда // Старый формат
		ФайлТЗ = Новый ТекстовыйДокумент;
		ФайлТЗ.Прочитать(ПутьКФайлу); 
		Данные = ФайлТЗ.ПолучитьТекст();	
		
		ДанныеТЗ = XMLЗначение(Тип("ХранилищеЗначения"), Данные).Получить();		
		Для Каждого Элемент Из ДанныеТЗ Цикл
            УстановитьЗначениеРеквизитаФормы(Элемент.Ключ, Элемент.Значение);
		КонецЦикла;
		
		ТекстЛогаСобытий = "Настройки загружены на форму - перехожу к сохранению в регистр без подтверждений..." + Символы.ПС
			+ "Настройки сохранены.";	
		ЗаписьСтруктурыЛога = Вычислить("ЭКОМ_ОбщегоНазначения.ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Информация, ИмяСобытия)");
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);
		
		Загружены = Истина;
		
	ИначеЕсли НРег(Файл.Расширение) = ".xml" Тогда // Новый формат
		Загружены = ОбработкаОбъект.ЗагрузитьНастройки(АдресВоВременномХранилище, МассивЛогаСобытий);
	Иначе
		ТекстЛогаСобытий = "Формат [" + НРег(Файл.Расширение) + "] не поддерживается!";	
		ЗаписьСтруктурыЛога = Вычислить("ЭКОМ_ОбщегоНазначения.ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Предупреждение, ИмяСобытия)");
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

	КонецЕсли;
	
	Сообщение = Новый СообщениеПользователю;
	
	Если Загружены Тогда
		ПараметрыФункции = Новый Массив;
		ПараметрыФункции.Добавить(Ложь);
		ПараметрыФункции.Добавить(МассивЛогаСобытий);
		БекапНастроек = ВернутьРезультатИзМодуляОбъекта("ИзменитьФорматПользовательскихНастроек", ПараметрыФункции);
		
		// Обновим загруженные настройки
    	ПриСозданииНаСервере(Ложь, Истина);
		
		Сообщение.Текст = "Настройки загружены";
		
	Иначе
		Сообщение.Текст = "Настройки не загружены. Причину смотрите в логе событий.";
	КонецЕсли;
	
	Сообщение.Сообщить();
	
	Если МассивЛогаСобытий.Количество() > 0  Тогда
		Попытка
			Выполнить("ЭКОМ_ОбщегоНазначения.ЗаписатьЛогСобытийвРегистрЛогирование(МассивЛогаСобытий);");
		Исключение
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий)");
			Сообщение.Сообщить();
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаДокументовСохранитьНастройкиВсе(Команда)
	
	Массив = Новый Массив;
	Массив.Добавить("СтруктураФайлаXMLВходящие");
	Массив.Добавить("СтруктураФайлаXMLИсходящие");
	Массив.Добавить("СтруктураФайлаXMLДокументы");
	
	Структура = Новый Структура;
	Структура.Вставить("ЭКОМ_ЗначениеДополнительныхКонстант", Истина);

	МассивЛогаСобытий = Новый Массив;
	АдресВоВременномХранилище = ВыгрузкаНаСервере(Структура, Массив, МассивЛогаСобытий);
	
	КраткаяИнформация = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьКраткуюИнформацияОКонфигурации()");
	ДатаЗаписи        = Формат(ТекущаяДата(), "ДФ=dd.MM.yy");
	ИмяСохранения     = "Настройки по документам_" + ДатаЗаписи + "_" + КраткаяИнформация;
	
	СохранениеФайла(АдресВоВременномХранилище, ИмяСохранения);
	
	Если МассивЛогаСобытий.Количество() > 0  Тогда
		Попытка
			Выполнить("ЭКОМ_ОбщегоНазначения.ЗаписатьЛогСобытийвРегистрЛогирование(МассивЛогаСобытий);");
		Исключение
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий)");
			Сообщение.Сообщить();
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВыгрузкаНаСервере(Структура, Массив, МассивЛогаСобытий, ВыгружатьТолькоВыбранные = Ложь, НастройкиКВыгрузке = Неопределено)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
    АдресВоВременномХранилище = ОбработкаОбъект.ВыгрузитьНастройки(Структура, Массив, МассивЛогаСобытий, ВыгружатьТолькоВыбранные, НастройкиКВыгрузке);	
	
	Возврат  АдресВоВременномХранилище;
	
КонецФункции

&НаСервере
Функция ПолучитьДанныеТЗ_В_XMLСтрока(ИменаЭлементов)
	
	Значения = Новый Структура;
	Для Каждого Элемент Из ИменаЭлементов Цикл
		Значения.Вставить(Элемент, ДанныеФормыВЗначение(ЭтаФорма[Элемент], Тип("ДеревоЗначений"))); 
	КонецЦикла;
	ДанныеТЗ = Новый ХранилищеЗначения(Значения);
	
	Возврат XMLСтрока(ДанныеТЗ);
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ИСХОДЯЩИЕ 

// Функция получает из текущей строки и всех строк уровнями выше наименования реквизитов, доступных для выбора в текущей строке
//
// Параметры:
//  Данные  - СтрокаДереваЗначений - строка дерева, для которй нужно получить список доступных реквизитов
//  ТолькоТекущая - Булево - установка признака указывает на необходимость выводить список реквизитов только из текущей строки (не учитывая реквизиты строк-родителей)
//
// Возвращаемое значение:
//   СписокЗначений   - коллекция реквизитов, доступных для выбора
//
&НаКлиенте
Функция ПолучитьКоллекциюДоступныхРеквизитов(Знач Данные, ТолькоТекущая = Ложь)

	СписокВыбора = Новый СписокЗначений;
	
	Корень = Данные;
	Пока НЕ Корень.ПолучитьРодителя()	= Неопределено Цикл
		Корень 				= Корень.ПолучитьРодителя();
	КонецЦикла;
	
	Если Найти(Корень.ТипТранзакции, "Исходящий") > 0 Тогда
		НаправлениеТранзакции	= "исход";
	ИначеЕсли Найти(Корень.ТипТранзакции, "Входящий") > 0 Тогда
		НаправлениеТранзакции	= "вход";
	Иначе
		НаправлениеТранзакции	= "";
	КонецЕсли;
	
	Если ПустаяСтрока(НаправлениеТранзакции) Тогда
		Возврат СписокВыбора;
	КонецЕсли;
	
	// Перебор строк.
	Пока НЕ Данные	= Неопределено Цикл
		Если ТипЗнч(Данные.ДоступныеЗначения) 	= Тип("СписокЗначений") Тогда
			Если Уровень(Данные) = 0 Тогда
				ИмяПриемника 	= "Документ";
			Иначе
				ИмяПриемника	= Данные.Приемник;
			КонецЕсли;
			
			Для Каждого Значение Из Данные.ДоступныеЗначения Цикл
				СписокВыбора.Добавить(ИмяПриемника + "." + Значение);
			КонецЦикла;
		КонецЕсли;
		Если ТолькоТекущая Тогда
			Данные				= Неопределено;
		Иначе
			Данные				= Данные.ПолучитьРодителя();
		КонецЕсли;
	КонецЦикла;
	
	СписокВыбора.СортироватьПоЗначению(НаправлениеСортировки.Возр);

	Возврат СписокВыбора;
	
КонецФункции // ПолучитьКоллекциюДоступныхРеквизитов()

// Заполняет массив-приемник уникальными значениями из массива-источника.
// Если элемент в массиве-приемнике уже существует, то добавления нового элемента не происходит.
//
// Параметры:
//  МассивПриемник – Массив – массив, который заполняется уникальными значениями
//  МассивИсточник – Массив – массив, из которого подбираются элементы в массив-приемник.
// 
&НаКлиенте
Процедура ЗаполнитьМассивУникальнымиЗначениями(МассивПриемник, МассивИсточник)
	
	УникальныеЗначения = Новый Соответствие;
	
	Для каждого Значение Из МассивПриемник Цикл
		УникальныеЗначения.Вставить(Значение, Истина);
	КонецЦикла;
	
	Для каждого Значение Из МассивИсточник Цикл
		Если УникальныеЗначения[Значение] = Неопределено Тогда
			МассивПриемник.Добавить(Значение);
			УникальныеЗначения.Вставить(Значение, Истина);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СтруктураФайлаXMLИсходящиеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	// Определение направления транзакции.
	Корень    = Элементы.СтруктураФайлаXMLИсходящие.ТекущиеДанные;
	Пока НЕ Корень.ПолучитьРодителя() = Неопределено Цикл
		Корень = Корень.ПолучитьРодителя();
	КонецЦикла;
	
	Если Поле.Имя = "СтруктураФайлаXMLИсходящиеДанные" 
		И (Уровень(Элементы.СтруктураФайлаXMLИсходящие.ТекущиеДанные) = 0
		ИЛИ НЕ Элемент.ТекущиеДанные.ПолучитьЭлементы().Количество() = 0) Тогда
		
		СтандартнаяОбработка 	= Ложь;
		
		Если Элементы.СтруктураФайлаXMLИсходящие.ТекущиеДанные.ПолучитьЭлементы().Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		Заголовок = ?(ПустаяСтрока(Элементы.СтруктураФайлаXMLИсходящие.ТекущиеДанные.Приемник), "", "Введите алгоритм для заполнения поля """ 
		             + Элементы.СтруктураФайлаXMLИсходящие.ТекущиеДанные.Приемник + """");
		
		ТипДокументаИсточник = ПолучитьТипДокумента(Элементы.СтруктураФайлаXMLИсходящие.ТекущиеДанные, "СтруктураФайлаXMLИсходящие", "Источник");
		
		ИмяОткрываемойФормы = ЭтаФорма.СлужебныйПолноеИмяФормы + ".Форма.УФ_ФормаКонсольЗапросов";
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ИмяТабличнойЧасти", "СтруктураФайлаXMLИсходящие");
		ДопПараметры.Вставить("ИмяФормы"         , "УФ_ФормаКонсольЗапросов");
		ДопПараметры.Вставить("ИмяЭлементаФормы" , "СтруктураФайлаXMLИсходящиеДанные");
		
		ОповещениеОЗакрытии = Новый ОписаниеОповещения("ОбработкаЗакрытия", ЭтаФорма, ДопПараметры);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Заголовок"            , Заголовок);
		ПараметрыФормы.Вставить("ТипДокументаИсточника", ТипДокументаИсточник);
		ПараметрыФормы.Вставить("ТекстНачальный"       , Элементы.СтруктураФайлаXMLИсходящие.ТекущиеДанные.Данные);
		
        ПараметрыФормы.Вставить("ДопПараметры", ДопПараметры);
		
		ОткрытьФорму(ИмяОткрываемойФормы, ПараметрыФормы,,,,, ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
		
		ЗаполнитьСписокДляИзменения(Элемент.Имя, "_" + Элемент.Имя);
		
	ИначеЕсли Поле.Имя = "СтруктураФайлаXMLИсходящиеСвязи" И НЕ Уровень(Элементы.СтруктураФайлаXMLИсходящие.ТекущиеДанные) = 0
		И НЕ Элемент.ТекущиеДанные.ПолучитьЭлементы().Количество() = 0 И ЗначениеЗаполнено(Элемент.ТекущиеДанные.Данные) Тогда // Здесь должно быть все по другому. Возможно стоит сделать новую форму.
		
		СтандартнаяОбработка 	= Ложь;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Заголовок"                  , "Редактирование набора связей для тега");
		
		ПараметрыФормы.Вставить("ЛевоеПолеДоступныеЗначения" , ПолучитьКоллекциюДоступныхРеквизитов(Элемент.ТекущиеДанные));
		ПараметрыФормы.Вставить("ПравоеПолеДоступныеЗначения", ПолучитьКоллекциюДоступныхРеквизитов(Элемент.ТекущиеДанные));
		
		МассивСтрок = Новый Массив;
		Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.Связи) Тогда		
			
			Для Каждого Строка Из Элемент.ТекущиеДанные.Связи Цикл
				СтрокаТЧ = Новый Структура;
				СтрокаТЧ.Вставить("ЛевоеПоле" , Строка.Значение);
				СтрокаТЧ.Вставить("ПравоеПоле", Строка.Представление);
				МассивСтрок.Добавить(СтрокаТЧ);
			КонецЦикла;
			
		КонецЕсли;	
		ПараметрыФормы.Вставить("ТабличноеПоле", МассивСтрок);
		
		ДопПараметры = Новый Структура;
        ДопПараметры.Вставить("ИмяТабличнойЧасти"   , "СтруктураФайлаXMLИсходящие");
		ДопПараметры.Вставить("ЭлементТекущиеДанные", Элемент.ТекущиеДанные.Связи);
		ДопПараметры.Вставить("ИмяФормы"            , "УФ_ФормаСвязи");
		ДопПараметры.Вставить("ИмяЭлементаФормы"    , Поле.Имя);	
		
		ОповещениеОЗакрытии = Новый ОписаниеОповещения("ОбработкаЗакрытия", ЭтаФорма, ДопПараметры);
		ПараметрыФормы.Вставить("ДопПараметры", ДопПараметры);
        
		ОткрытьФорму(ЭтаФорма.СлужебныйПолноеИмяФормы + ".Форма.УФ_ФормаСвязи", ПараметрыФормы, ЭтаФорма,,,, ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);					
		
		ЗаполнитьСписокДляИзменения(Элемент.Имя, "_" + Элемент.Имя);
		
	ИначеЕсли Поле.Имя	= "СтруктураФайлаXMLИсходящиеАтрибуты" Тогда
		
		СтандартнаяОбработка 	= Ложь;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Заголовок"     , "Редактирование набора атрибутов для тега " + Элемент.ТекущиеДанные.Приемник);
		ПараметрыФормы.Вставить("Редактирование", Истина);
		
		МассивСтрок = Новый Массив;
		Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.Атрибуты) Тогда
			Для Каждого Строка Из Элемент.ТекущиеДанные.Атрибуты Цикл
				СтрокаТЧ = Новый Структура;
				СтрокаТЧ.Вставить("Реквизит"         , Строка.Значение);
				СтрокаТЧ.Вставить("Формула"          , Строка.Представление);
				СтрокаТЧ.Вставить("Обязательный"     , Строка.Пометка);
				СтрокаТЧ.Вставить("ДоступныеЗначения", ПолучитьКоллекциюДоступныхРеквизитов(Элемент.ТекущиеДанные));
				МассивСтрок.Добавить(СтрокаТЧ);
			КонецЦикла;
		Иначе
			СтрокаТЧ = Новый Структура;
			СтрокаТЧ.Вставить("Реквизит"         , "");
			СтрокаТЧ.Вставить("Формула"          , "");
			СтрокаТЧ.Вставить("Обязательный"     , "");
			СтрокаТЧ.Вставить("ДоступныеЗначения", ПолучитьКоллекциюДоступныхРеквизитов(Элемент.ТекущиеДанные));
			МассивСтрок.Добавить(СтрокаТЧ);
		КонецЕсли;	
		ПараметрыФормы.Вставить("ТабличноеПоле", МассивСтрок);
		
		ДопПараметры = Новый Структура;
        ДопПараметры.Вставить("ИмяТабличнойЧасти"   , "СтруктураФайлаXMLИсходящие");
		ДопПараметры.Вставить("ЭлементТекущиеДанные", Элемент.ТекущиеДанные.Атрибуты);
		ДопПараметры.Вставить("ИмяФормы"            , "УФ_ФормаНастройкиСлужебные");
		ДопПараметры.Вставить("ИмяЭлементаФормы"    , Поле.Имя);	
		
		ОповещениеОЗакрытии = Новый ОписаниеОповещения("ОбработкаЗакрытия", ЭтаФорма, ДопПараметры);
        ПараметрыФормы.Вставить("ДопПараметры", ДопПараметры);
        
		ОткрытьФорму(ЭтаФорма.СлужебныйПолноеИмяФормы + ".Форма.УФ_ФормаНастройкиСлужебные", ПараметрыФормы, ЭтаФорма,,,, ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);					
		
		ЗаполнитьСписокДляИзменения(Элемент.Имя, "_" + Элемент.Имя);
		
	ИначеЕсли Поле.Имя	= "СтруктураФайлаXMLИсходящиеСлужебные" 
		И Уровень(Элементы.СтруктураФайлаXMLИсходящие.ТекущиеДанные) = 0 Тогда
		
		СтандартнаяОбработка 	= Ложь;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Заголовок"     , "Редактирование дополнительных настроек для тега " + Элемент.ТекущиеДанные.Приемник);
		ПараметрыФормы.Вставить("Редактирование", Истина);
		
		МассивСтрок = Новый Массив;
		Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.Служебные) Тогда
			Для Каждого Строка Из Элемент.ТекущиеДанные.Служебные Цикл
				СтрокаТЧ = Новый Структура;
				СтрокаТЧ.Вставить("Реквизит"         , Строка.Ключ);
				СтрокаТЧ.Вставить("Формула"          , Строка.Значение);
				СтрокаТЧ.Вставить("ДоступныеЗначения", ПолучитьКоллекциюДоступныхРеквизитов(Элемент.ТекущиеДанные));
				МассивСтрок.Добавить(СтрокаТЧ);
			КонецЦикла;
		Иначе
			СтрокаТЧ = Новый Структура;
			СтрокаТЧ.Вставить("Реквизит"         , "");
			СтрокаТЧ.Вставить("Формула"          , "");
			СтрокаТЧ.Вставить("ДоступныеЗначения", ПолучитьКоллекциюДоступныхРеквизитов(Элемент.ТекущиеДанные));
			МассивСтрок.Добавить(СтрокаТЧ);
		КонецЕсли;
		ПараметрыФормы.Вставить("ТабличноеПоле", МассивСтрок);

		ДопПараметры = Новый Структура;
        ДопПараметры.Вставить("ИмяТабличнойЧасти"   , "СтруктураФайлаXMLИсходящие");
		ДопПараметры.Вставить("ЭлементТекущиеДанные", Элемент.ТекущиеДанные.Служебные);
		ДопПараметры.Вставить("ИмяФормы"            , "УФ_ФормаНастройкиСлужебные");
		ДопПараметры.Вставить("ИмяЭлементаФормы"    , Поле.Имя);	
		
		ОповещениеОЗакрытии = Новый ОписаниеОповещения("ОбработкаЗакрытия", ЭтаФорма, ДопПараметры);
        ПараметрыФормы.Вставить("ДопПараметры", ДопПараметры);
        
		ОткрытьФорму(ЭтаФорма.СлужебныйПолноеИмяФормы + ".Форма.УФ_ФормаНастройкиСлужебные", ПараметрыФормы, ЭтаФорма,,,, ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);	
		
		ЗаполнитьСписокДляИзменения(Элемент.Имя, "_" + Элемент.Имя);
		
	ИначеЕсли Поле.Имя	= "СтруктураФайлаXMLИсходящиеСлужебные" 
		И НЕ Уровень(Элементы.СтруктураФайлаXMLИсходящие.ТекущиеДанные) = 0 Тогда
		
		СтандартнаяОбработка 	= Ложь;
		
		Заголовок 		= ?(ПустаяСтрока(Элемент.ТекущиеДанные.Приемник), "", "Введите алгоритм условий отбора тега """ + Элемент.ТекущиеДанные.Приемник + """");
		
        ТипДокументаИсточник = ПолучитьТипДокумента(Элементы.СтруктураФайлаXMLИсходящие.ТекущиеДанные, "СтруктураФайлаXMLИсходящие", "Источник");
	
		ИмяОткрываемойФормы = ЭтаФорма.СлужебныйПолноеИмяФормы + ".Форма.УФ_ФормаКонсольЗапросов";
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Заголовок"            , Заголовок);
		ПараметрыФормы.Вставить("ТипДокументаИсточника", ТипДокументаИсточник);
		ПараметрыФормы.Вставить("ТекстНачальный"       , Элемент.ТекущиеДанные.Служебные);
		
		ДопПараметры = Новый Структура;
        ДопПараметры.Вставить("ИмяТабличнойЧасти", "СтруктураФайлаXMLИсходящие");
		ДопПараметры.Вставить("ИмяФормы"         , "УФ_ФормаКонсольЗапросов");
		ДопПараметры.Вставить("ИмяЭлементаФормы" , Поле.Имя);
				
		ОповещениеОЗакрытии = Новый ОписаниеОповещения("ОбработкаЗакрытия", ЭтаФорма, ДопПараметры);
		
        ПараметрыФормы.Вставить("ДопПараметры", ДопПараметры);
        
        ОткрытьФорму(ИмяОткрываемойФормы, ПараметрыФормы,,,,,ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
        ПараметрыФормы.Вставить("ДопПараметры", ДопПараметры);
        
		Данные  = Новый Структура;
		Данные.Вставить("Имя"    , "СтруктураФайлаXMLИсходящие");
		Данные.Вставить("Колонка", "Служебные");
		ПослеВводаАлгоритмаЗаполнения(СокрЛП(Элемент.ТекущиеДанные.Служебные), Данные);		
		
		ЗаполнитьСписокДляИзменения(Элемент.Имя, "_" + Элемент.Имя);
		
	ИначеЕсли Поле.Имя	= "СтруктураФайлаXMLИсходящиеСохранение" И Уровень(Элементы.СтруктураФайлаXMLИсходящие.ТекущиеДанные) = 0 Тогда
		СтандартнаяОбработка 	= Ложь;
		
		Если ПроверитьЗаполнениеТекстаНастроекСтруктурыФайлаXML(Элементы.СтруктураФайлаXMLИсходящие.ТекущиеДанные) Тогда //DocRobot 1.21.0 20220207 MOD-1562 [отключить сохранение пустого шаблона]
			СохранитьНастройкуXML(Элемент.Имя);
		КонецЕсли;
		
	ИначеЕсли Поле.Имя	= "СтруктураФайлаXMLИсходящиеЗагрузка" И Уровень(Элементы.СтруктураФайлаXMLИсходящие.ТекущиеДанные) = 0 Тогда
		СтандартнаяОбработка 	= Ложь;
		
		ВосстановитьНастройкуXML(Элемент.Имя);
	ИначеЕсли Поле.Имя	= "СтруктураФайлаXMLИсходящиеКнопка" 
		И Уровень(Элементы.СтруктураФайлаXMLИсходящие.ТекущиеДанные) = 0 Тогда
		
		СформироватьНастройкиКнопки(Элемент.ТекущиеДанные.ТипТранзакции, Элемент.ТекущиеДанные, СтандартнаяОбработка, Поле.Имя, "СтруктураФайлаXMLИсходящие");
		ЗаполнитьСписокДляИзменения(Элемент.Имя, "_" + Элемент.Имя);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СформироватьНастройкиКнопки(ИмяКнопкиПоУмолчнию, ВыбраннаяСтрока, СтандартнаяОбработка, ИмяЭлементаФормы, ИмяТабличнойЧасти)
	
	СтандартнаяОбработка 	= Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок"     , "Кнопка - " + ИмяКнопкиПоУмолчнию);
	ПараметрыФормы.Вставить("Редактирование", Истина);
	
	СтруктураРеквизитов = Новый Соответствие;
	СтруктураРеквизитов.Вставить("ИмяКнопки" , ИмяКнопкиПоУмолчнию);
	СтруктураРеквизитов.Вставить("Покупатель", ЭтаФорма.ЭКОМ_ОбменСеть);
	СтруктураРеквизитов.Вставить("Поставщик" , ЭтаФорма.ЭКОМ_ОбменПоставщик);
	СтруктураРеквизитов.Вставить("ЭТРН"      , ЭтаФорма.ЭКОМ_ОбменЭТРН);
	СтруктураРеквизитов.Вставить("Прайс-лист" , ЭтаФорма.ЭКОМ_ОбменПрайсЛист);
	
	МассивСтрок = Новый Массив;
	Для Каждого СтруктураСтрока Из СтруктураРеквизитов Цикл
		
		Формула = "";	
		Если СтруктураСтрока.Ключ = "ИмяКнопки" Тогда
			Формула = ?(ЗначениеЗаполнено(ВыбраннаяСтрока.Кнопка),ВыбраннаяСтрока.Кнопка, СтруктураСтрока.Значение);	
			Использовать = Истина;
		Иначе
			Использовать = СтруктураСтрока.Значение;
		КонецЕсли;
		
		СтрокаКоллекцияТЧ = ВыбраннаяСтрока.КоллекцияТЧ.НайтиПоЗначению(СтруктураСтрока.Ключ); 
		Если НЕ СтрокаКоллекцияТЧ = Неопределено Тогда
			Если СтруктураСтрока.Ключ = "ИмяКнопки" Тогда
				Формула = СтрокаКоллекцияТЧ.Представление;
			КонецЕсли;				
			Использовать = СтрокаКоллекцияТЧ.Пометка;
		КонецЕсли; 
		
		СтрокаТЧ = Новый Структура;
		СтрокаТЧ.Вставить("Реквизит"    , СтруктураСтрока.Ключ);
		СтрокаТЧ.Вставить("Формула"     , Формула);
		СтрокаТЧ.Вставить("Использовать", Использовать);
		МассивСтрок.Добавить(СтрокаТЧ);
		
	КонецЦикла;
	
	ПараметрыФормы.Вставить("ТабличноеПолеДляКнопки", МассивСтрок);
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ИмяТабличнойЧасти"   , ИмяТабличнойЧасти);
	ДопПараметры.Вставить("ЭлементТекущиеДанные", ВыбраннаяСтрока.Кнопка);
	ДопПараметры.Вставить("ИмяФормы"            , "УФ_ФормаНастройкиСлужебные");
	ДопПараметры.Вставить("ИмяЭлементаФормы"    , ИмяЭлементаФормы);	
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ОбработкаЗакрытия", ЭтаФорма, ДопПараметры);
	ПараметрыФормы.Вставить("ДопПараметры", ДопПараметры);
	
	ОткрытьФорму(ЭтаФорма.СлужебныйПолноеИмяФормы + ".Форма.УФ_ФормаНастройкиСлужебные", ПараметрыФормы, ЭтаФорма,,,, ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);					
	
КонецПроцедуры

&НаКлиенте
Процедура СтруктураФайлаXMLИсходящиеПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	СтандартнаяОбработка 			= Ложь;
	СтрокаПриемникПриПеретаскивании = Строка;
КонецПроцедуры

&НаКлиенте
Процедура СтруктураФайлаXMLИсходящиеОкончаниеПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка)
	Если НЕ СтрокаПриемникПриПеретаскивании = Неопределено Тогда
		
		СтрокаПриемникПриПеретаскиванииТек = ЭтаФорма.СтруктураФайлаXMLИсходящие.НайтиПоИдентификатору(СтрокаПриемникПриПеретаскивании);
		
		Если Уровень(ПараметрыПеретаскивания.Значение[0]) = 0 Тогда
			СтрокаПриемникПриПеретаскивании = Неопределено;
			Возврат;
		КонецЕсли;
				
		// Коопируем строку в новое место.
		СкопироватьСтрокуДереваЗначенийНаСервере(ПараметрыПеретаскивания.Значение[0], СтрокаПриемникПриПеретаскиванииТек.ПолучитьЭлементы().Добавить(), Элемент.Имя);
		// Удаляем исходную строку.
		ПараметрыПеретаскивания.Значение[0].ПолучитьРодителя().ПолучитьЭлементы().Удалить(ПараметрыПеретаскивания.Значение[0]);
		
		СтрокаПриемникПриПеретаскивании = Неопределено;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СкопироватьСтрокуДереваЗначенийНаСервере(Значение, СтрокаПриемникПриПеретаскивании, ТабличоеПолеИмя) Экспорт
		
	ДеревоОбъект    = РеквизитФормыВЗначение(ТабличоеПолеИмя);
	Колонки = Новый Массив;	
	Для Каждого Колонка Из ДеревоОбъект.Колонки Цикл
		Колонки.Добавить(Колонка.Имя);
	КонецЦикла;
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.СкопироватьСтрокуДереваЗначений(Значение, СтрокаПриемникПриПеретаскивании, Колонки);
	
КонецПроцедуры 


&НаКлиенте
Процедура НастройкаДокументовНовыйДокументИсходящий(Команда)
	ЭтаФорма.СтруктураФайлаXMLИсходящие.ПолучитьЭлементы().Добавить();	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьСтруктуру_из_XML(ИмяКоллекции, ИмяЭлемента)
 
	ИмяФайла = ПолучитьИмяФайлаСтруктуры(РежимДиалогаВыбораФайла.Открытие, ИмяЭлемента);
	Если ПустаяСтрока(ИмяФайла) Тогда
		Возврат;
	КонецЕсли;
    
    ЗагрузитьДанныеСтруктуры_из_XML(ИмяФайла, ИмяКоллекции); 
    
КонецПроцедуры

&НаКлиенте
Функция ПолучитьИмяФайлаСтруктуры(Режим, ИмяКратко = "")
    
	ВыборФайла = Новый ДиалогВыбораФайла(Режим);
	ВыборФайла.ПолноеИмяФайла = "" + ИмяКратко;
	Фильтр = "(*.xml)|*.xml";
	ВыборФайла.Фильтр = Фильтр;
	ВыборФайла.МножественныйВыбор = Ложь;
	ВыборФайла.Выбрать();
	
	Возврат ВыборФайла.ПолноеИмяФайла;
	
КонецФункции

&НаСервере
Процедура ЗагрузитьДанныеСтруктуры_из_XML(ИмяФайла, ИмяКоллекции)
	
	ДеревоОбъект = РеквизитФормыВЗначение(ИмяКоллекции);
	
    МассивКолонок = Новый Массив;
	
	Для каждого СтрЭлемент Из Элементы[ИмяКоллекции].ПодчиненныеЭлементы Цикл
		МассивКолонок.Добавить(СтрЗаменить(СтрЭлемент.Имя, ИмяКоллекции, ""));
	КонецЦикла;
	
	Если МассивКолонок.Найти("Атрибуты") = Неопределено Тогда
    	МассивКолонок.Добавить("Атрибуты");
 	КонецЕсли;
	
    Дерево = Вычислить("ЭКОМ_ОбщегоНазначения.ДеревоЗначенийИзФайлаXML(ИмяФайла, МассивКолонок, ДеревоОбъект)");
    СтрКолонок = Новый Структура("Использовать", Истина);
	
	УстановитьЗначТолькоВКорне = Новый Массив;
	УстановитьЗначТолькоВКорне.Добавить(Ложь);
	
    УстановитьЗначенияДерево(Дерево.Строки.Получить(Дерево.Строки.Количество() - 1), "Структура", СтрКолонок, УстановитьЗначТолькоВКорне);

	Если ТипЗнч(Дерево) = Тип("ДеревоЗначений") Тогда
		ЗначениеВРеквизитФормы(Дерево, ИмяКоллекции);
    КонецЕсли;
	
КонецПроцедуры

// Процедура устанавливает передаваемые значения в строку дерева знчаений
//
// Параметры:
//  Дерево  - СтрокаДереваЗначений - объект, в котором нужно обновить значения
//  ИмяКолонки  - Строка - имя колонки дерева значений для установки значения.
//		Если в параметр передается строка "Структура", то установка требуется
//		для нескольких значений, которые передаются в структуре, где ключ - имя
//		колонки, а значение - значение строки дерева значений.
//  Значение  - AnyType - значение для подстановки в указанную колонку. Если в
//		параметр ИмяКолонки передается строка "Структура", то установка требуется
//		для нескольких значений, которые передаются в структуре, где ключ - имя
//		колонки, а значение - значение строки дерева значений.
//  УстановитьЗначТолькоВКорне  - Массив - коллекция флагов ограничения установки
//		значений только в корне дерева. Флаги расположены в той же последовательности,
//		что и значения в параметре Значение.
//
&НаСервере
Процедура УстановитьЗначенияДерево(Дерево, ИмяКолонки, Значение, УстановитьЗначТолькоВКорне)
	
	// Обход реквизитов в корне дерева.
	Индекс = 0;
	
	Для Каждого Стр Из Значение Цикл
		
		Попытка
			Дерево[Стр.Ключ] = Стр.Значение;
		Исключение КонецПопытки;
		
		Индекс = Индекс + 1;
		
	КонецЦикла;
	
	// Обход реквизитов подчиненных элементов.
    ОбойтиУровеньДерева(Дерево.Строки, ИмяКолонки, Значение, УстановитьЗначТолькоВКорне);
    
КонецПроцедуры

&НаСервере
Процедура ОбойтиУровеньДерева(Строки, ИмяКолонки, Значение, УстановитьЗначТолькоВКорне, ИмяТэга = "", ИмяРодитель = "")
	
	Для Каждого Строка из Строки Цикл
		
		Родитель = Строка.Родитель;
		Попытка
			ИмяТега = Строка.Тег; // Старый вариант
		Исключение
			ИмяТега = Строка.Приемник;
		КонецПопытки;
		
		Пока Родитель <> Неопределено Цикл
			Попытка
				ИмяРодитель = Родитель.Тег; // Старый вариант
			Исключение
				ИмяРодитель = Родитель.Приемник;
			КонецПопытки;
			ИмяТега = ИмяРодитель + "_" + ИмяТега;
			Родитель = Родитель.Родитель;
		КонецЦикла;
			
		Если ИмяКолонки = "Структура" И ТипЗнч(Значение) = Тип("Структура") Тогда
			
			Индекс = 0;
			
			Для Каждого Стр Из Значение Цикл
				
				Попытка
					Если НЕ УстановитьЗначТолькоВКорне.Получить(Индекс) Тогда
						Строка[Стр.Ключ] = Стр.Значение;
					ИначеЕсли Строка.Уровень() = 0 Тогда
						Строка[Стр.Ключ] = Стр.Значение;
					КонецЕсли;
				Исключение КонецПопытки;
				
				Индекс = Индекс + 1;
				
			КонецЦикла;
		Иначе
			Строка[ИмяКолонки] = Значение;
		КонецЕсли;
		ОбойтиУровеньДерева(Строка.Строки, ИмяКолонки, Значение, УстановитьЗначТолькоВКорне, ИмяТэга, ИмяРодитель);
		
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаДокументовЗагрузитьНовыйФормат(Команда)
	ЗагрузитьСтруктуру_из_XML("СтруктураФайлаXMLИсходящие", "");
