&НаКлиенте
Процедура СохранитьИзмененныеНастройки(ЗакрытьФорму = Ложь, ВызватьДиалог = Истина)
	
	МассивЛогаСобытий = Новый Массив;
	
	Если ЭтаФорма.СписокЗначенийИзмененныхНастроек.Количество() = 0 Тогда
	     Сообщить("Изменения настроек отсутствуют!");
		 ЭтаФорма.Модифицированность = Ложь;
		 
		 Если ЗакрытьФорму = Истина Тогда
			 ИмяТекущейСтраницы = Элементы.ГруппаПанельНастроек.ТекущаяСтраница.Имя;
			 ЗаписатьТекущуюСтраницуНаСервере(ИмяТекущейСтраницы, МассивЛогаСобытий);
			 Закрыть();
		 КонецЕсли;

	 Иначе
		 ОписаниеИзменений = "";
		 СоответствиеЗначений = ЭтаФорма.СписокЗначенийИзмененныхНастроек.Получить(0).Значение;
		 Для каждого Стр Из СоответствиеЗначений Цикл
			 ОписаниеИзменений = ОписаниеИзменений + ?(ЗначениеЗаполнено(ОписаниеИзменений), Символы.ПС, "") + Стр.Ключ;	 
		 КонецЦикла;
		 
		 Если ВызватьДиалог Тогда
			 ВызватьДиалогПодтвержденияЗаписи(СоответствиеЗначений, ОписаниеИзменений, ЗакрытьФорму);
		 Иначе
			 ВызватьДиалогПодтвержденияЗаписиЗавершение(Истина, Новый Структура("ЗакрытьФорму, ИзмененныеНастройки", Ложь, СоответствиеЗначений));
		 КонецЕсли;
         ЭтаФорма.Модифицированность = Ложь;
	КонецЕсли;
	
	Если МассивЛогаСобытий.Количество() > 0  Тогда
		Попытка
			Выполнить("ЭКОМ_ОбщегоНазначения.ЗаписатьЛогСобытийвРегистрЛогирование(МассивЛогаСобытий);");
		Исключение
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий)");
			Сообщение.Сообщить();
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ИзмененныеРеквизитыПрочитатьНастройкуИзФормы(ИмяНастройки)
    Перем Результат;
    
    РеквизитНастройки = ЭтаФорма[ИмяНастройки];
    ТипСтрокой = Строка(ТипЗнч(ЭтаФорма[ИмяНастройки]));
    Если Лев(ТипСтрокой, 11) = "ДанныеФормы" Тогда
        Результат = РеквизитФормыВЗначение(ИмяНастройки);
    Иначе
        Результат = РеквизитНастройки;
    КонецЕсли;
    Возврат Результат;
КонецФункции

&НаСервере
Процедура ДобавитьИсточникВПриемникСтрокой(Источник, Приемник, Разделитель = ",", ПробелПослеРазделителя = Истина) Экспорт 
    Приемник = Приемник + ?(Приемник = "", "", Разделитель + ?(ПробелПослеРазделителя = Истина, " ", "")) + Строка(Источник);
КонецПроцедуры
&НаСервере
Функция ОписаниеИзмененияСтрокой(Было, Стало, Описание = "", ОписаниеПослеОписанияПередБыло = "поле", ОписаниеБыло = "было", ОписаниеСтало = "стало", ДобавитьСправаКОписанию = ":", ДлинныеСтрокиОбрезатьДо = 100) Экспорт
    
    БылоСтрокой  = ПредставитьЗначениеСтрокой(Было ,, ДлинныеСтрокиОбрезатьДо);
    СталоСтрокой = ПредставитьЗначениеСтрокой(Стало,, ДлинныеСтрокиОбрезатьДо);
    
    Результат = ОписаниеПослеОписанияПередБыло + ДобавитьСправаКОписанию + " " + Строка(Описание) + ", " + ОписаниеБыло + ДобавитьСправаКОписанию + " " + БылоСтрокой + ", " + ОписаниеСтало + ДобавитьСправаКОписанию + " " + СталоСтрокой;
    Возврат Результат;
КонецФункции 
&НаСервере
Функция ПредставитьЗначениеСтрокой(ЗначениеДляПредставления, УбратьПереносыСтрок = Истина, ДлинныеСтрокиОбрезатьДо = 100, ДобавитьТипЗначения = Истина) Экспорт 
    Перем Результат;    
    
    Если ЗначениеДляПредставления = NULL Тогда
        Результат = "NULL";
    ИначеЕсли ЗначениеДляПредставления = Неопределено Тогда
        Результат = "Неопределено";
    ИначеЕсли ТипЗнч(ЗначениеДляПредставления) = Тип("ЭлементСпискаЗначений") Тогда
        Результат = "Пометка " + ?(ЗначениеДляПредставления.Пометка, "✅ ","нет ")
                  + "Представление [" + Строка(ЗначениеДляПредставления.Представление) + "]"
                  + ", " 
                  + "Значение [" + Строка(ЗначениеДляПредставления.Значение) + "], тип " + Строка(ТипЗнч(ЗначениеДляПредставления))
                  ;
    ИначеЕсли ТипЗнч(ЗначениеДляПредставления) = Тип("КлючИЗначение") Тогда
        Результат = "Ключ [" + Строка(ЗначениеДляПредставления.Ключ) + "]"
                  + ", " 
                  + "Значение [" + Строка(ЗначениеДляПредставления.Значение) + "]"
                  ;
    Иначе
        Результат = Строка(ЗначениеДляПредставления);
        Результат = ?(ПустаяСтрока(Результат), "[]", Результат);
        Если ДобавитьТипЗначения = Истина Тогда
            Результат = Результат + ". Тип: " + Строка(ТипЗнч(ЗначениеДляПредставления));
        КонецЕсли;
    КонецЕсли;
    
    Если ДлинныеСтрокиОбрезатьДо = Неопределено Или ДлинныеСтрокиОбрезатьДо = 0 Тогда
    Иначе
        Результат = Лев(Результат, ДлинныеСтрокиОбрезатьДо) + ?(СтрДлина(Результат) > ДлинныеСтрокиОбрезатьДо, "...(длинный текст)", "");
    КонецЕсли;
    
    Если УбратьПереносыСтрок = Истина Тогда
        Результат = СтрЗаменить(Результат, Символы.ПС, " ");;    
    КонецЕсли;
    
    Возврат  Результат;
КонецФункции
&НаСервере
Функция ОписаниеЭлементаКоллекции(Элемент)
    Если ТипЗнч(Элемент) <> Тип("КлючИЗначение") Тогда
        Возврат "";    
    КонецЕсли;
    
    Результат = "Ключ: [" + ПредставитьЗначениеСтрокой(Элемент.Ключ,,, Ложь) + "], значение: " + ПредставитьЗначениеСтрокой(Элемент.Значение);
    Возврат Результат;
КонецФункции

&НаСервере
Функция РезультатПоТекущемуРезультату(Знач ТекущийРезультат, Знач РезультатДо, ЗначениеТекущийРезультатДляЗаменыРезультат = Ложь)
    Перем Результат;
    
    Результат = ?(ТекущийРезультат = ЗначениеТекущийРезультатДляЗаменыРезультат, ТекущийРезультат, РезультатДо); 
    
    Возврат Результат;
КонецФункции

