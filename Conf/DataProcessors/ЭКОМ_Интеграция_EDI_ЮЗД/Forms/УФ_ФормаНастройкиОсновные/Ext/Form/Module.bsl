//Docrobot 1.19.0 MOD-1511 [Добавлена процедура КомандаЗапросНаАвтоОбменПокупательУточнения]
&НаКлиенте
Процедура КомандаЗапросНаАвтоОбменПокупательУточнения(Команда)
		
    ПараметрыФункции = Новый Массив;
	ПараметрыФункции.Добавить("ЗапросНаАвтоОбменПокупательУточнения");		
	ПараметрыФункции.Добавить("");
    ПараметрыФункции.Добавить("Служебный");
	ПараметрыФункции.Добавить(Ложь);
	
	ТекстЗапроса = ВернутьРезультатИзМодуляОбъекта("Настройка_Параметр_Прочитать", ПараметрыФункции);
			
	ИмяОткрываемойФормы = ЭтаФорма.СлужебныйПолноеИмяФормы + ".Форма.УФ_ФормаКонсольЗапросов";
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ИмяФормы"         , "УФ_ФормаКонсольЗапросов");
	ДопПараметры.Вставить("ИмяЭлементаФормы" , "АвтоОбмен");
	ДопПараметры.Вставить("ИмяЗапроса"       , "_ЗапросНаАвтоОбменПокупательУточнения");

	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ОбработкаЗакрытия", ЭтаФорма, ДопПараметры);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок"            , "Введите запрос на получение документов для отправки Уточнения регламентным заданием");
	ПараметрыФормы.Вставить("ТекстНачальный"       , ТекстЗапроса);  
    ПараметрыФормы.Вставить("ДопПараметры"         , ДопПараметры);
    
	ОткрытьФорму(ИмяОткрываемойФормы, ПараметрыФормы,,,,,ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

