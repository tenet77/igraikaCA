// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ (НА СЕРВЕРЕ)
Процедура ВыгрузитьСтрокиЭлементаДереваЗначений(Источник, Приемник, ИменаКолонокДляКопирования) Экспорт
    ВложенныеСтроки = Источник.Строки;
    
    Если ТипЗнч(Приемник) = Тип("ДеревоЗначений") Тогда
        Для каждого ИмяКолонки Из ИменаКолонокДляКопирования Цикл
            Если Приемник.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
                Приемник.Колонки.Добавить(ИмяКолонки, Источник.Колонки[ИмяКолонки].ТипЗначения);
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    
    Для каждого СтрокаИсточник Из ВложенныеСтроки Цикл
        СтрокаПриемник = Приемник.Строки.Добавить();
        Для каждого ИмяКолонки Из ИменаКолонокДляКопирования Цикл
            СтрокаПриемник[ИмяКолонки] = СтрокаИсточник[ИмяКолонки];
        КонецЦикла;
        //ЗаполнитьЗначенияСвойств(СтрокаПриемник, СтрокаИсточник, ИменаКолонокДляКопирования);
        ВыгрузитьСтрокиЭлементаДереваЗначений(СтрокаИсточник, СтрокаПриемник, ИменаКолонокДляКопирования);
    КонецЦикла;
    
КонецПроцедуры

Процедура СкопироватьСовпадающиеКолонкиВРезультат(Источник, Приемник) Экспорт
	
	Если НЕ (ТипЗнч(Источник) = Тип("ДеревоЗначений") 
		И ТипЗнч(Приемник) = Тип("ДеревоЗначений")) Тогда
        Возврат;	
    КонецЕсли;
    
    ВсеКолонкиИсточника = Источник.Колонки;
    ВсеКолонкиПриемника = Приемник.Колонки;
    
    КолонкиДляКопирования = Новый Массив;
    Для каждого КолонкаИсточник Из ВсеКолонкиИсточника Цикл
        ИмяКолонки = КолонкаИсточник.Имя;
        ТипКолонки = КолонкаИсточник.ТипЗначения;
        
        ТакаяЖеКолонкаПриемник = ВсеКолонкиПриемника.Найти(ИмяКолонки);
        
        Если ТакаяЖеКолонкаПриемник <> Неопределено И ТипЗнч(КолонкаИсточник.ТипЗначения) = ТипЗнч(ТакаяЖеКолонкаПриемник.ТипЗначения) Тогда
        	КолонкиДляКопирования.Добавить(ИмяКолонки);
        КонецЕсли;
    КонецЦикла;
    Если КолонкиДляКопирования.Количество() = 0 Тогда
    	Источник = Приемник.Скопировать();
        Источник.Строки.Очистить();
    Иначе
        ВыгрузитьСтрокиЭлементаДереваЗначений(Источник, Приемник, КолонкиДляКопирования);
	КонецЕсли;
	
КонецПроцедуры //СкопироватьСовпадающиеКолонкиВРезультат() 

&НаСервере
Процедура УстановитьЗначениеРеквизитаФормы(ИмяРеквизита, Знач Значение)
    
	ТипРеквизита = ТипЗнч(ЭтаФорма[ИмяРеквизита]);	
	Если Значение = Неопределено Тогда								
		Если ТипРеквизита = Тип("Булево") Тогда
			Значение = Ложь;			 			 
		ИначеЕсли ТипРеквизита = Тип("Строка") Тогда
			Значение = "";
		ИначеЕсли ТипРеквизита = Тип("Число") Тогда
			Значение = 0;	
		ИначеЕсли ТипРеквизита = Тип("ДанныеФормыКоллекция") Тогда
			Попытка
				Значение = ЭтаФорма[ИмяРеквизита].Выгрузить(); // Попытка получить пустое значение из реквизита формы
			Исключение КонецПопытки;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипРеквизита = Тип("ДанныеФормыКоллекция") 
		Или ТипРеквизита = Тип("ДанныеФормыСтруктура")
		Или ТипРеквизита = Тип("ДанныеФормыСтруктураСКоллекцией") Тогда
		
		Если ТипЗнч(Значение) = Тип("Строка") Тогда
			 Возврат;
		КонецЕсли;
		
		Попытка
			ЗначениеВРеквизитФормы(Значение, ИмяРеквизита);
							
		Исключение
			ПриемникРезультат = РеквизитФормыВЗначение(ИмяРеквизита, Тип("ДеревоЗначений"));
            СкопироватьСовпадающиеКолонкиВРезультат(Значение, ПриемникРезультат);
            Если ТипЗнч(Элементы[ИмяРеквизита]) = Тип("ТаблицаФормы") Тогда
                Попытка
                    ЗначениеВРеквизитФормы(ПриемникРезультат, ИмяРеквизита);
                Исключение
                    Если ТипЗнч(ИмяРеквизита) = Тип("ТаблицаЗначений") Тогда
                        ЭтаФорма[ИмяРеквизита].Загрузить(ПриемникРезультат);
                    КонецЕсли;
                КонецПопытки;
            Иначе
                ЗначениеВРеквизитФормы(ПриемникРезультат, ИмяРеквизита);
            КонецЕсли;
		КонецПопытки;
		
	ИначеЕсли ТипРеквизита = Тип("ДанныеФормыДерево") Тогда
		
		Попытка			
			// Очищаем
			ЛокальныйОбъект = ДанныеФормыВЗначение(ЭтаФорма[ИмяРеквизита], Тип("ДеревоЗначений"));
			ЛокальныйОбъект.Строки.Очистить();
			ЗначениеВРеквизитФормы(ЛокальныйОбъект, ИмяРеквизита);
			
			// Заполняем новыми данными
			ЗначениеВРеквизитФормы(Значение, ИмяРеквизита);
		Исключение
			ПриемникРезультат = РеквизитФормыВЗначение(ИмяРеквизита, Тип("ДеревоЗначений"));
            СкопироватьСовпадающиеКолонкиВРезультат(Значение, ПриемникРезультат);
            Если ТипЗнч(Элементы[ИмяРеквизита]) = Тип("ТаблицаФормы") Тогда
                Попытка
                    ЗначениеВРеквизитФормы(ПриемникРезультат, ИмяРеквизита);
                Исключение
                    Если ТипЗнч(ИмяРеквизита) = Тип("ТаблицаЗначений") Тогда
                        ЭтаФорма[ИмяРеквизита].Загрузить(ПриемникРезультат);
                    КонецЕсли;
                КонецПопытки;
            Иначе
                ЗначениеВРеквизитФормы(ПриемникРезультат, ИмяРеквизита);
            КонецЕсли;
		КонецПопытки;	
		
	Иначе
		ЭтаФорма[ИмяРеквизита] = Значение; 
	КонецЕсли;
    
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокНастроекНаСервере(МассивНастроек = Неопределено)
	
	ОбъектЭтаОбработка = РеквизитФормыВЗначение("Объект");
    Результат          = ОбъектЭтаОбработка.ПолучитьСписокНастроек(МассивНастроек);

    Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗагрузитьНастройкиНаФорму()
	
	ОбъектЭтаОбработка = РеквизитФормыВЗначение("Объект");
 	
	СоответствиеРеквизитовФормы = Новый Соответствие;
	РеквизитыФормы = ЭтаФорма.ПолучитьРеквизиты();
	Для каждого Стр Из РеквизитыФормы Цикл
	    СоответствиеРеквизитовФормы.Вставить(Стр.Имя, Стр);			
	КонецЦикла;
	
	НастройкиЭКОМ = ПолучитьСписокНастроекНаСервере();
	Для каждого Настройка Из НастройкиЭКОМ Цикл
		СоответствиеРеквизитаФормы = СоответствиеРеквизитовФормы.Получить(Настройка.Ключ);
		Если НЕ СоответствиеРеквизитаФормы = Неопределено Тогда
			УстановитьЗначениеРеквизитаФормы(Настройка.Ключ, Настройка.Значение); 
		Иначе
			Если Прав(Настройка.Ключ, 9) = "Служебный" Тогда
				ИмяРеквизитаФормы = Лев(Настройка.Ключ, СтрДлина(Настройка.Ключ)-9);
				СоответствиеРеквизитаФормы = СоответствиеРеквизитовФормы.Получить(ИмяРеквизитаФормы);
				Если НЕ СоответствиеРеквизитаФормы = Неопределено Тогда
					УстановитьЗначениеРеквизитаФормы(ИмяРеквизитаФормы, Настройка.Значение); 
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;   	
	КонецЦикла;
	
	Если СлужебныйДеревоКонфигурации.ПолучитьЭлементы().Количество() = 0 Тогда
        СлужебныйДеревоКонфигурации = ОбъектЭтаОбработка.ЗаполнитьДеревоКонфигурации(Истина);
    КонецЕсли;
	
    ЭтаФорма.СтраницаПриОткрытии = НастройкиЭКОМ.Получить("СлужебныйСтраницаНастроекМодуляПриЗакрытии" + "Служебный"); 

	ЭтаФорма.ЭКОМ_ПрочиеНастройки.Очистить();
	НоваяСтрока = ЭтаФорма.ЭКОМ_ПрочиеНастройки.Добавить();
	НоваяСтрока.Использовать = ЭтаФорма.ЭКОМ_ОбменСеть;
	НоваяСтрока.ЗапросДляТабличнойЧастиТекст = ИнтерфейсНастройкаТабличнойЧастиНаСервере("СлужебныйЗапросДляФормыПокупателя");
	НоваяСтрока.ТипОбмена = "Сеть";
	НоваяСтрока.ПодпискаДляДокументов = "";
	
	НоваяСтрока = ЭтаФорма.ЭКОМ_ПрочиеНастройки.Добавить();
	НоваяСтрока.Использовать = ЭтаФорма.ЭКОМ_ОбменПоставщик;
	НоваяСтрока.ЗапросДляТабличнойЧастиТекст = ИнтерфейсНастройкаТабличнойЧастиНаСервере("СлужебныйЗапросДляФормыПоставщика");
	НоваяСтрока.ТипОбмена = "Поставщик";
	НоваяСтрока.ПодпискаДляДокументов = "";
	
	НоваяСтрока = ЭтаФорма.ЭКОМ_ПрочиеНастройки.Добавить();
	НоваяСтрока.Использовать = ЭтаФорма.ЭКОМ_ОбменЭТРН;
	НоваяСтрока.ЗапросДляТабличнойЧастиТекст = ИнтерфейсНастройкаТабличнойЧастиНаСервере("СлужебныйЗапросДляФормыЭТРН");
	НоваяСтрока.ТипОбмена = "ЭТРН";
	НоваяСтрока.ПодпискаДляДокументов = "";
	
	НоваяСтрока = ЭтаФорма.ЭКОМ_ПрочиеНастройки.Добавить();
	НоваяСтрока.Использовать = ЭтаФорма.ЭКОМ_ОбменCondra;
	НоваяСтрока.ЗапросДляТабличнойЧастиТекст = ИнтерфейсНастройкаТабличнойЧастиНаСервере("СлужебныйЗапросДляФормыCondra");
	НоваяСтрока.ТипОбмена = "Неструкт. докум.";
	НоваяСтрока.ПодпискаДляДокументов = "";
	
	НоваяСтрока = ЭтаФорма.ЭКОМ_ПрочиеНастройки.Добавить();
	НоваяСтрока.Использовать = ЭтаФорма.ЭКОМ_ОбменПрайсЛист;
	НоваяСтрока.ЗапросДляТабличнойЧастиТекст = ИнтерфейсНастройкаТабличнойЧастиНаСервере("СлужебныйЗапросДляФормыПрайсЛист");
	НоваяСтрока.ТипОбмена = "Прайс-лист";
	НоваяСтрока.ПодпискаДляДокументов = "";
	
    ЗначениеВРеквизитФормы(ОбъектЭтаОбработка, "Объект");
КонецПроцедуры

&НаСервере
Процедура ИнициализацияТогоЧтоНеСохраняется()
    
    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    СлужебныйПолноеИмяФормы = ОбработкаОбъект.Метаданные().ПолноеИмя();
    
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбработкаОбъект 	= РеквизитФормыВЗначение("Объект");
    ПолноеИмяОбработки	= ОбработкаОбъект.Метаданные().ПолноеИмя();
	
	ПараметрыОткрытия = ЭтаФорма.Параметры;
    ПараметрыОткрытия.Свойство("НеЗапрашиватьПароль", 	ЭтаФорма.НеЗапрашиватьПароль);
	ПараметрыОткрытия.Свойство("ЭКОМОбъектыАктуальны", 	ЭтаФорма.ЭКОМОбъектыАктуальны);
	
    ЗагрузитьНастройкиНаФорму();
    ИнициализацияТогоЧтоНеСохраняется();
	
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	
	// Зададим отбор (условия при которых будет выполнено оформление)
	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение     = Новый ПолеКомпоновкиДанных("СписокОбновлений.СтатусОбработки");
	ЭлементОтбора.ВидСравнения      = ВидСравненияКомпоновкиДанных.НеРавно;
	ЭлементОтбора.ПравоеЗначение    = "Установлена";
	ЭлементОтбора.Использование     = Истина;
	
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Роса);
	
	// Укажем какие поля (колонки) оформлять
	ПолеОформления      = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("СписокОбновлений");
	ПолеОформления.Использование = Истина; 
	
	ЭлементОформления.Использование = Истина;
    
    Если Элементы.ГруппаПанельНастроек.ТекущаяСтраница = Элементы.ГруппаОбновления Тогда
    	ЗаполнитьИсториюТаблицыОбновлений();
    КонецЕсли;
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
    Элементы.ИнфоОбновления.Заголовок = "Проверка наличия новой версии не произведена.";
    
	Параметры.Свойство("ДополнительнаяОбработкаСсылка", ЭтаФорма.ОбъектСсылка);
	
	//+Лысковец 20220126 / MOD-922 / MOD-570
	ЭтаФорма.ЗакрыватьПриЗакрытииВладельца = Истина;
	//-
	ДоступностьAPI = ОбработкаОбъект.ПолучитьДоступностьApiПоСтране();
	Если Не ДоступностьAPI Тогда 
		Элементы.КомандаДанныеКонтрагентаПоAPI.Видимость = Ложь;	
	КонецЕсли;
	
КонецПроцедуры

// Выполняется вызов функции из модуля объекта обарботки
//
// Параметры:
//  ИмяФункции  - Строка - наименование функции в модуле объекта
//  ПараметрыФункции  - Массив - парамеры функции в последовательности их заполнения 
//
// Возвращаемое значение:
//   Any   - результат выполнения функции
//
&НаСервере                             
Функция ВернутьРезультатИзМодуляОбъекта(ИмяФункции, ПараметрыФункции = Неопределено)	
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Если ПараметрыФункции = Неопределено Тогда	
		ПараметрыФункции = Новый Массив;	
	ИначеЕсли ТипЗнч(ПараметрыФункции) <> Тип("Массив") Тогда	
		ВызватьИсключение "Ошибка валидации входного параметра";		
	КонецЕсли;
	
	Результат = Неопределено;
	
	СтрокаФункции = "ОбработкаОбъект." + ИмяФункции + "(";
	Индекс = 0;
	
	ПараметрыФункцииСтруктура = Новый Структура;
	Пока Индекс < ПараметрыФункции.Количество() Цикл
		ПараметрыФункцииСтруктура.Вставить("Ключ_" + Индекс, ПараметрыФункции.Получить(Индекс));
		СтрокаФункции 	= СтрокаФункции + ?(Индекс = 0, "", ", ") + "ПараметрыФункцииСтруктура.Ключ_" + Индекс; 
		Индекс 			= Индекс + 1;
	КонецЦикла;
	
	СтрокаФункции = СтрокаФункции + ")";
	Результат = Вычислить(СтрокаФункции);
	
	Для Каждого ЭлементСтруктуры Из ПараметрыФункцииСтруктура Цикл
		Индекс = Число(СтрЗаменить(ЭлементСтруктуры.Ключ, "Ключ_", ""));
	    ПараметрыФункции.Вставить(Индекс, ЭлементСтруктуры.Значение);	
	КонецЦикла;
	
	Возврат Результат;

КонецФункции // ВернутьРезультатИзМодуляОбъекта()


