&НаСервере
Функция ВернутьТемЖеЗначениемИлиМассивомИзЭтогоЗначения(ЗначениеДляАнализаВозврата, Разделитель = ",", ОбязательноМассивом = Ложь, ДобавитьВМассивНеопределено = Ложь) Экспорт
    Результат = Неопределено;
    
    Если ТипЗнч(ЗначениеДляАнализаВозврата) = Тип("Строка") Тогда
        Если Найти(ЗначениеДляАнализаВозврата, Разделитель) > 0 Тогда
            ЗначениеМассивом = ЭКОМ_РазложитьСтрокуВМассивПодстрок(ЗначениеДляАнализаВозврата, Разделитель, Истина);
            Результат = Новый Массив;
            Для Каждого ЗначениеРезультата Из ЗначениеМассивом Цикл
                Результат.Добавить(СокрЛП(ЗначениеРезультата));
            КонецЦикла;
            Если ДобавитьВМассивНеопределено = Истина Тогда
                Результат.Добавить(Неопределено);
            КонецЕсли;
        Иначе
            Если ОбязательноМассивом = Истина Или ДобавитьВМассивНеопределено = Истина Тогда
                Результат = Новый Массив;
                Результат.Добавить(ЗначениеДляАнализаВозврата);
                Результат.Добавить(Неопределено);
            Иначе
                Результат = ЗначениеДляАнализаВозврата;
            КонецЕсли;
        КонецЕсли;
    Иначе
        Результат = ЗначениеДляАнализаВозврата;
    КонецЕсли;
    
    Возврат Результат;
КонецФункции

// Функция "расщепляет" строку на подстроки, используя заданный 
//		разделитель. Разделитель может иметь любую длину. 
//		Если в качестве разделителя задан пробел, рядом стоящие пробелы 
//		считаются одним разделителем, а ведущие и хвостовые пробелы параметра Стр
//		игнорируются.
//		Например, 
//		Эком_РазложитьСтрокуВМассивПодстрок(",строка 1,,,строка 2", ",") возвратит массив значений из пяти элементов, 
//		три из которых - пустые строки, а 
//		Эком_РазложитьСтрокуВМассивПодстрок(" строка1   строка 2", " ") возвратит массив значений из двух элементов
//
//	Параметры: 
//		Стр - 			строка, которую необходимо разложить на подстроки. 
//						Параметр передается по значению.
//		Разделитель - 	строка-разделитель, по умолчанию - запятая.
//
//
//	Возвращаемое значение:
//		массив значений, элементы которого - подстроки
//
Функция Эком_РазложитьСтрокуВМассивПодстрок(Знач Стр, Разделитель = ",", ДелатьСокрЛП = Истина, ПропускатьПустыеЗначения = Истина) Экспорт
	
	МассивСтрок = Новый Массив();
	Если Разделитель = " " Тогда
		Стр = СокрЛП(Стр);
		Пока Истина Цикл
			Поз = Найти(Стр,Разделитель);
			Если Поз=0 Тогда
                ТекущееЗначение = ?(ДелатьСокрЛП = Истина, СокрЛП(Стр), Стр);
				МассивСтрок.Добавить(ТекущееЗначение);
				Возврат МассивСтрок;
			КонецЕсли;
            ТекущееЗначение = Лев(Стр,Поз-1);
            ТекущееЗначение = ?(ДелатьСокрЛП = Истина, СокрЛП(ТекущееЗначение), ТекущееЗначение);
            МассивСтрок.Добавить(ТекущееЗначение);
			Стр = СокрЛ(Сред(Стр,Поз));
		КонецЦикла;
	ИначеЕсли Разделитель = "" Тогда
		Для Поз = 1 По СтрДлина(Стр) Цикл
			МассивСтрок.Добавить(Сред(Стр, Поз, 1));
		КонецЦикла;
		Возврат МассивСтрок;
	Иначе
		ДлинаРазделителя = СтрДлина(Разделитель);
		Пока Истина Цикл
			Поз = Найти(Стр,Разделитель);
            Если Поз=0 Тогда
                ТекущееЗначение = ?(ДелатьСокрЛП = Истина, СокрЛП(Стр), Стр);
				МассивСтрок.Добавить(ТекущееЗначение);
				Возврат МассивСтрок;
			КонецЕсли;
            ТекущееЗначение = Лев(Стр,Поз-1);
            ТекущееЗначение = ?(ДелатьСокрЛП = Истина, СокрЛП(ТекущееЗначение), ТекущееЗначение);
            МассивСтрок.Добавить(ТекущееЗначение);
			Стр = Сред(Стр,Поз+ДлинаРазделителя);
		КонецЦикла;
	КонецЕсли;
	Результат = МассивСтрок;
КонецФункции

&НаСервереБезКонтекста
Процедура УдалитьИзРегистраСведенийЗаписьПоТекущимДаннымТабличногоПоляНаСервере(ИмяРегистраСведений, ЗначениеОтбора)
    Перем Результат;
    
    МенеджерЗаписи = РегистрыСведений[ИмяРегистраСведений].СоздатьМенеджерЗаписи();
    МенеджерЗаписи.Объект = ЗначениеОтбора;
    МенеджерЗаписи.Прочитать();
    Если МенеджерЗаписи.Выбран() Тогда
        МенеджерЗаписи.Удалить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьИзРегистраСведенийЗаписьПоТекущимДаннымТабличногоПоля(ЭлементФормыТабличноеПоле, ИмяКолонки = "Контрагент", ИмяРегистраСведений = "ЭКОМ_GLN")
    
    ЗначениеОтбора = ЗначениеТабличногоПоляПоИмениКолонки(ИмяКолонки);
    
    Если ЗначениеОтбора = Неопределено Тогда
        Возврат;
    КонецЕсли;
	
	ОповещениеВопроса = Новый ОписаниеОповещения("УдалитьИзРегистраСведенийЗаписьПоТекущимДаннымТабличногоПоляЗавершение", ЭтаФорма,
		Новый Структура("ИмяКолонки, ИмяРегистраСведений, ЗначениеОтбора", ИмяКолонки, ИмяРегистраСведений, ЗначениеОтбора));
    ПоказатьВопрос(ОповещениеВопроса, "Удалить сведения о [" + Строка(ЗначениеОтбора) + "] из настроек модуля Docrobot?",
		РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Нет, "Удаление настройки (регистр сведений " + ИмяРегистраСведений + ")");
				  
КонецПроцедуры

&НаКлиенте
Процедура УдалитьИзРегистраСведенийЗаписьПоТекущимДаннымТабличногоПоляЗавершение(РезультатВопроса, ДопПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		УдалитьИзРегистраСведенийЗаписьПоТекущимДаннымТабличногоПоляНаСервере(ДопПараметры.ИмяРегистраСведений, ДопПараметры.ЗначениеОтбора);
		ИмяСтраницы = СтраницаФормыПоИмениКолонкиТаблицы(ДопПараметры.ИмяКолонки);
    	ОбновитьСписокПоИмениСтраницы(ИмяСтраницы);
    КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СтраницаФормыПоИмениКолонкиТаблицы(ИмяКолонки)
    Перем Результат;
    
    Если ИмяКолонки = "Организация" Тогда
        Результат = "ГруппаОрганизации";
    ИначеЕсли ИмяКолонки = "Контрагент" Тогда
    	Результат = "ГруппаКонтрагенты";
    ИначеЕсли ИмяКолонки = "ТочкаДоставки" Тогда
    	Результат = "ГруппаТочкиДоставки";
    КонецЕсли;		
    
    Возврат Результат;
КонецФункции
//Создание/редактирование строк регистров сведений ЭКОМ
&НаКлиенте
Процедура ОткрытьФормуПоИмениКолонкиТабличногоПоля(ИмяКолонки = "Организация", ЗначениеДляОткрытия = Неопределено, Копирование = Ложь)
    Если ИмяКолонки = "Организация" Тогда
    	ИмяФормыДляОткрытия = "УФ_ФормаОрганизации";
    ИначеЕсли ИмяКолонки = "Контрагент" Тогда
    	ИмяФормыДляОткрытия = "УФ_ФормаКонтрагента";
    ИначеЕсли ИмяКолонки = "ТочкаДоставки" Тогда
    	ИмяФормыДляОткрытия = "УФ_ФормаТочкиДоставки";
    КонецЕсли;		
    
    ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить(ИмяКолонки, ЗначениеДляОткрытия);	
    ПараметрыФормы.Вставить("Копирование", Копирование);	
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ИмяФормы", ИмяФормыДляОткрытия);
    
    ПараметрыФормы.Вставить("ДопПараметры", ДопПараметры);
    
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ОбработкаЗакрытия", ЭтаФорма, ДопПараметры);	
	ОткрытьФорму(ЭтаФорма.СлужебныйПолноеИмяФормы + ".Форма." + ИмяФормыДляОткрытия, ПараметрыФормы, ЭтаФорма,,,, ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
    
КонецПроцедуры

&НаКлиенте
Функция ЗначениеТабличногоПоляПоИмениКолонки(ИмяКолонки = "Организация")
    
    Если ИмяКолонки = "Организация" Тогда
    	ОбрабатываемыйСписок = Элементы.СписокОрганизаций;
    ИначеЕсли ИмяКолонки = "Контрагент" Тогда
    	ОбрабатываемыйСписок = Элементы.СписокКонтрагентов;
    ИначеЕсли ИмяКолонки = "ТочкаДоставки" Тогда
    	ОбрабатываемыйСписок = Элементы.СписокТочекДоставок;
    КонецЕсли;		
    
    ТекущиеДанныеСписка = ОбрабатываемыйСписок.ТекущиеДанные;
    Если ТекущиеДанныеСписка = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    Результат = ТекущиеДанныеСписка[ИмяКолонки];
    
    Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуЗаписиРегистраСведенийЭКОМ(ИмяКолонки = "Организация", СтандартнаяОбработка, Копирование = Ложь, ПередаватьЗначениеОбъекта = Истина)
    Перем ЗначениеПоискаДанныхВРегистре;
    
    Если ПередаватьЗначениеОбъекта = Истина Тогда
        ЗначениеПоискаДанныхВРегистре = ЗначениеТабличногоПоляПоИмениКолонки(ИмяКолонки);
    КонецЕсли;
    
    СтандартнаяОбработка = Ложь;
    ОткрытьФормуПоИмениКолонкиТабличногоПоля(ИмяКолонки, ЗначениеПоискаДанныхВРегистре, Копирование);
    
КонецПроцедуры


