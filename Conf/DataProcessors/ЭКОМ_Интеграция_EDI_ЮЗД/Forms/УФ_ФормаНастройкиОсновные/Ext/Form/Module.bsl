	МетаданныеОбработки = Метаданные.Обработки.Найти("РегламентныеИФоновыеЗадания");
	Если МетаданныеОбработки = Неопределено Тогда
	     ЕстьОбработка = Ложь;
	КонецЕсли;
	 
	Возврат ЕстьОбработка;

