&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЭтаФорма.Модифицированность
		И ЗавершениеРаботы = Истина Тогда 
		              
		Если ТипЗнч(ВладелецФормы) = Тип("ФормаКлиентскогоПриложения") И ВладелецФормы.Открыта() Тогда
			Возврат;
		КонецЕсли;
		
		ТекстПредупреждения = "Docrobot: перед закрытием необходимо сохранить настройки!";
	    Отказ = Истина;
		Возврат;     
	КонецЕсли;
	
	Если НЕ ЗавершениеРаботы = Истина Тогда
		МассивЛогаСобытий = Новый Массив;
		ИмяТекущейСтраницы = Элементы.ГруппаПанельНастроек.ТекущаяСтраница.Имя;
	    ЗаписатьТекущуюСтраницуНаСервере(ИмяТекущейСтраницы, МассивЛогаСобытий);
	    Если ЭтаФорма.Модифицированность Тогда
			
			Если ЗавершениеРаботы = Истина Тогда
				ТекстПредупреждения = "Настройки изменены и не сохранены. Необходимо закрыть форму настроек!";
				Отказ = Истина;
			Иначе
				Отказ = Истина;
				СохранитьИзмененныеНастройки(Истина);
			КонецЕсли;

	    КонецЕсли;
		
		Если МассивЛогаСобытий.Количество() > 0  Тогда
			Попытка
				Выполнить("ЭКОМ_ОбщегоНазначения.ЗаписатьЛогСобытийвРегистрЛогирование(МассивЛогаСобытий);");
			Исключение
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий)");
				Сообщение.Сообщить();
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры


&НаСервереБезКонтекста
Функция ИнтерфейсНастройкаТабличнойЧастиНаСервере(ИмяЗапроса, ЗапросПоУмолчанию = "")
