Функция ПолучитьКлючЭКОМ_НоменклатураКонтрагентов(Отбор)
	
	Рег = РегистрыСведений.ЭКОМ_НоменклатураКонтрагентов;
	КлючЗаписи = Рег.СоздатьКлючЗаписи(Отбор);
	
	Возврат КлючЗаписи;
	
