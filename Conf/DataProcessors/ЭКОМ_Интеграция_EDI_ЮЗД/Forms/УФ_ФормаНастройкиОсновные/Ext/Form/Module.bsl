// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ (НА КЛИЕНТЕ)

// Процедура обрабатывает выбор файла с заполнением реквзиита объекта
//
// Параметры:
//  ПомещенныеФайлы  - Массив - массив выбранных файлов. Предполагается, что будет выбран только один файл
//  ДополнительныеПараметры  - Строка - предполагается, что содержит имя реквизита обработки
//
&НаКлиенте
Процедура КаталогНачалоВыбораФайлаЗавершение(ПомещенныеФайлы, ДополнительныеПараметры) Экспорт

    Если ПомещенныеФайлы = Неопределено Тогда
        Возврат;
    КонецЕсли;

	Для каждого ПереданныйФайл Из ПомещенныеФайлы Цикл
		Если НЕ Элементы.Найти(ДополнительныеПараметры) = Неопределено Тогда
			ЭтаФорма[ДополнительныеПараметры] = ПереданныйФайл;
			ЗаполнитьСписокДляИзменения(ПереданныйФайл, ДополнительныеПараметры);
			УстановитьМодифицированность();
		КонецЕсли;
    КонецЦикла;
    
КонецПроцедуры // КаталогНачалоВыбораФайлаЗавершение()

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Восстановление текущей страницы
    СменитьТекущуюСтраницу(СтраницаПриОткрытии); 

	// Скрываем элементы
	Элементы.ГруппаСтруктураСохранения.Видимость = Ложь; // становится видимой при нажатии кнопки сохранить
	
	Если ЭтаФорма.ЭКОМ_ИспПарольДляНастроек Тогда   
		
		Если НеЗапрашиватьПароль = Ложь Тогда
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("УстановитьПароль", Ложь);
			
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("ИмяФормы", "УФ_ФормаВводаПароля");
			
			ОповещениеОЗакрытии = Новый ОписаниеОповещения("ОбработкаЗакрытия", ЭтаФорма, ДопПараметры);	
			ОткрытьФорму(ЭтаФорма.СлужебныйПолноеИмяФормы + ".Форма.УФ_ФормаВводаПароля", ПараметрыФормы, ЭтаФорма,,,, ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
			
		КонецЕсли;
	Иначе
		ПарольВведенВерно = Истина;
	КонецЕсли;

	УправлениеВидимостью();
	
КонецПроцедуры

