&НаКлиенте
Процедура КомандаДанныеКонтрагентаПоAPI(Команда)	
	
	МассивЛогаСобытий = Новый Массив;

	Массив_GLN = Новый Массив;
	ВыделенныеСтроки = Элементы.СписокТочекДоставок.ВыделенныеСтроки;
	Для Каждого ТекущаяСтрока Из ВыделенныеСтроки Цикл
		Массив_GLN.Добавить(Элементы.СписокТочекДоставок.ДанныеСтроки(ТекущаяСтрока));
	КонецЦикла;
	КомандаДанныеКонтрагентаПоAPIНаСервере(Массив_GLN, МассивЛогаСобытий);
	Элементы.СписокТочекДоставок.Обновить();
	
	Если МассивЛогаСобытий.Количество() > 0 Тогда
		Попытка
			Выполнить("ЭКОМ_ОбщегоНазначения.ЗаписатьЛогСобытийвРегистрЛогирование(МассивЛогаСобытий);");
		Исключение
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий)");
			Сообщение.Сообщить();
		КонецПопытки;		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура КомандаДанныеКонтрагентаПоAPIНаСервере(ВыделенныеСтроки, МассивЛогаСобытий)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Для Каждого ТекущаяСтрока Из ВыделенныеСтроки Цикл 
		МЗ = РегистрыСведений.ЭКОМ_ТочкиДоставки.СоздатьМенеджерЗаписи();
		МЗ.Объект = ТекущаяСтрока.ТочкаДоставки;
		МЗ.Прочитать();
		
		Данные = ОбработкаОбъект.ДанныеКонтрагентаПоAPI(МЗ.GLN, МассивЛогаСобытий);
		Если ТипЗнч(Данные) = Тип("Массив") Тогда
			Адрес  = "";	
			Индекс = "";
			Индекс = Данные[0].Индекс;
			Если ЗначениеЗаполнено(Индекс) Тогда
				МЗ.Адр_Индекс = Индекс;
				Адрес = Индекс + ", ";
			КонецЕсли;
			
			КодРегион  = "";
			КодРегион = Данные[0].Регион;
			Если ЗначениеЗаполнено(КодРегион) Тогда
				МЗ.Адр_КодРегиона = КодРегион;
				Адрес = Адрес + КодРегион + ", ";
			КонецЕсли;
			
			Район  = "";
			Район = Данные[0].Район;
			Если ЗначениеЗаполнено(Район) Тогда
				МЗ.Адр_Район = Район;
				Адрес = Адрес + Район + ", ";
			КонецЕсли;
			
			Город  = "";
			Город = Данные[0].Город;
			Если ЗначениеЗаполнено(Город) Тогда
				МЗ.Адр_Город = Город;
				Адрес = Адрес + Город + ", ";
			КонецЕсли;
			
			Население  = "";
			Население = Данные[0].Население;
			Если ЗначениеЗаполнено(Население) Тогда
				МЗ.Адр_НаселПункт = Население;
				Адрес = Адрес + Население + ", ";
			КонецЕсли;
			
			Улица  = "";
			Улица = Данные[0].Улица;
			Если ЗначениеЗаполнено(Улица) Тогда
				МЗ.Адр_Улица = Улица;
				Адрес = Адрес + Улица + ", ";
			КонецЕсли;
			
			НомерДома  = "";
			НомерДома = Данные[0].НомерДома;
			Если ЗначениеЗаполнено(НомерДома) Тогда
				МЗ.Адр_Дом = НомерДома;
				Адрес = Адрес + НомерДома + ", ";
			КонецЕсли;
			
			Корпус  = "";
			Корпус = Данные[0].Корпус;
			Если ЗначениеЗаполнено(Корпус) Тогда
				МЗ.Адр_Корпус = Корпус;
				Адрес = Адрес + Корпус + ", ";
			КонецЕсли;
			
			Квартира  = "";
			Квартира = Данные[0].Квартира;
			Если ЗначениеЗаполнено(Квартира) Тогда
				МЗ.Адр_Кварт = Квартира;
				Адрес = Адрес + Квартира + ", ";
			КонецЕсли;
			
			МЗ.ИНН = Данные[0].ИНН;
			МЗ.КПП = Данные[0].КПП;
			МЗ.Наименование = Данные[0].Наименование;
			МЗ.Адрес = Адрес;
			МЗ.Записать();
			
			СсылкаОбъект = ТекущаяСтрока.ТочкаДоставки.ПолучитьОбъект();
			Если НЕ ТекущаяСтрока.ТочкаДоставки.Метаданные().Реквизиты.Найти("ИНН")= Неопределено Тогда
				СсылкаОбъект.ИНН = Данные[0].ИНН;		
			КонецЕсли;
			
			Если НЕ ТекущаяСтрока.ТочкаДоставки.Метаданные().Реквизиты.Найти("КПП") = Неопределено Тогда
				СсылкаОбъект.КПП = Данные[0].КПП;		
			КонецЕсли;
			
			СсылкаОбъект.Записать();
			
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

&НаКлиенте
Процедура КомандаПродолжитьВыгрузку(Команда)
					
	Массив = Новый Массив;
	
	Структура = Новый Структура;
	Структура.Вставить("ЭКОМ_ЗначениеДополнительныхКонстант", ЭтаФорма.РС_ЭКОМ_ЗначениеДополнительныхКонстант);
	Структура.Вставить("ЭКОМ_GLN"                           , ЭтаФорма.РС_ЭКОМ_ЭКОМ_GLN);
	Структура.Вставить("ЭКОМ_ТочкиДоставки"                 , ЭтаФорма.РС_ЭКОМ_ТочкиДоставки);
	Структура.Вставить("ЭКОМ_НоменклатураКонтрагентов"      , ЭтаФорма.РС_ЭКОМ_НоменклатураКонтрагентов);

	МассивЛогаСобытий = Новый Массив;
	АдресВоВременномХранилище = ВыгрузкаНаСервере(Структура, Массив, МассивЛогаСобытий);	
	ИмяСохранения = "Настройки из регистров";
	
	СохранениеФайла(АдресВоВременномХранилище, ИмяСохранения);
	
	Элементы.ГруппаСтруктураСохранения.Видимость = Ложь;
	
	Если МассивЛогаСобытий.Количество() > 0  Тогда
		Попытка
			Выполнить("ЭКОМ_ОбщегоНазначения.ЗаписатьЛогСобытийвРегистрЛогирование(МассивЛогаСобытий);");
		Исключение
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = Вычислить("ЭКОМ_ОбщегоНазначения.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий)");
			Сообщение.Сообщить();
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранениеФайла(АдресВоВременномХранилище, ИмяСохранения)
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресВоВременномХранилище);
	// создаем на клиенте текстовый файл
	ИмяВременногоФайлаXML = ПолучитьИмяВременногоФайла("xml");
	
    Если ДвоичныеДанные = Неопределено Тогда
        ПоказатьПредупреждение(Новый ОписаниеОповещения, "Не удалось получить данные настроек из временного хранилища", , "Сохранение в файл");
        Возврат;
    КонецЕсли;
	// создаем диалог сохранения файла
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДиалогОткрытияФайла.Заголовок          = "Сохраните файл";
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.Расширение         = "xml";
    ДиалогОткрытияФайла.Фильтр             = "Настройка по документу(*.xml)|*.xml";
	ДиалогОткрытияФайла.ИндексФильтра      = 0; //укажем фильтр по умолчанию (нумерация с нуля)
	
	ДиалогОткрытияФайла.ПолноеИмяФайла = ИмяСохранения + ".xml";;
	
	ДиалогОткрытияФайла.Показать(Новый ОписаниеОповещения("ЗавершениеДиалогаВыбораФайлаСохранение", ЭтаФорма, ДвоичныеДанные));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеДиалогаВыбораФайлаСохранение(ВыбранныеФайлы, ДвоичныеДанные) Экспорт
    
    Если ВыбранныеФайлы = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    ВсегоФайлов = ВыбранныеФайлы.Количество();
    Прогресс = 0;
    ТекущийНомерФайла = 0;
	Если ВыбранныеФайлы <> Неопределено Или ТипЗнч(ВыбранныеФайлы) = Тип("Массив") Тогда
        Для каждого ИмяФайла Из ВыбранныеФайлы Цикл
            ТекущийНомерФайла = ТекущийНомерФайла + 1;
            Попытка
                Прогресс = Окр(ТекущийНомерФайла * 100 / ВсегоФайлов, 0);
                ДвоичныеДанные.Записать(ИмяФайла);
            Исключение
                Сообщить("Ошибка записи в файл [" + "] " + ИмяФайла);
            КонецПопытки;
            Состояние("Сохранено в " + ИмяФайла, Прогресс,, БиблиотекаКартинок.ЭКОМ_Информация);		
        КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗапросНаАвтоОбменПоставщикORDRSPИсходящий(Команда)
		
	ПараметрыФункции = Новый Массив;
	ПараметрыФункции.Добавить("ЗапросНаАвтоОбменПоставщикORDRSPИсходящий");		
	ПараметрыФункции.Добавить("");
    ПараметрыФункции.Добавить("Служебный");
	ПараметрыФункции.Добавить(Ложь);
	
	ТекстЗапроса = ВернутьРезультатИзМодуляОбъекта("Настройка_Параметр_Прочитать", ПараметрыФункции);
			
	ИмяОткрываемойФормы = ЭтаФорма.СлужебныйПолноеИмяФормы + ".Форма.УФ_ФормаКонсольЗапросов";
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ИмяФормы"         , "УФ_ФормаКонсольЗапросов");
	ДопПараметры.Вставить("ИмяЭлементаФормы" , "АвтоОбмен");
	ДопПараметры.Вставить("ИмяЗапроса"       , "_ЗапросНаАвтоОбменПоставщикORDRSPИсходящий");

	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ОбработкаЗакрытия", ЭтаФорма, ДопПараметры);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок"            , "Введите запрос на получение документов для отправки ORDRSP регламентным заданием");
	ПараметрыФормы.Вставить("ТекстНачальный"       , ТекстЗапроса);  
    ПараметрыФормы.Вставить("ДопПараметры"         , ДопПараметры);
    
	ОткрытьФорму(ИмяОткрываемойФормы, ПараметрыФормы,,,,,ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
		
КонецПроцедуры

