&НаСервере
Функция КомандаСохранитьНаСервере(ПомещенныеФайлы)
	
	ТабличноеПолеТЗ = ТабличноеПоле.Выгрузить();
	
	Данные = ТабличноеПолеТЗ.СкопироватьКолонки();
	Для Каждого Строка Из ТабличноеПолеТЗ.НайтиСтроки(Новый Структура("Записан", Ложь)) Цикл
		ЗаполнитьЗначенияСвойств(Данные.Добавить(), Строка);
	КонецЦикла;
	ТабличноеПолеТЗ = Неопределено;
	
	Данные.Колонки.Добавить("Адрес", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(100)));
	
	Для Каждого Элемент Из ПомещенныеФайлы Цикл
		Строка = Данные.Найти(Элемент.Ключ, "Путь");
		Если НЕ Строка = Неопределено Тогда
			Строка.Адрес = Элемент.Значение;
		КонецЕсли;
	КонецЦикла;
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.СоздатьЗаписи_ЭКОМ_ЦепочкиНеструктурированныхДокументов(Данные, НомерДатаПоУмолчанию);
	
	Записаны = Новый СписокЗначений;
	СОшибкой = Новый СписокЗначений;
	Результат = Новый Массив;
	
	Для Каждого Строка Из Данные Цикл
		Если Строка.Записан Тогда
			Результат.Добавить(Строка.TRANSGUID);
			СтрокиПоПути = ТабличноеПоле.НайтиСтроки(Новый Структура("Путь", Строка.FILENAME));
			Если НЕ СтрокиПоПути.Количество() = 0 Тогда
				СтрокиПоПути.Получить(0).Записан = Истина;
				СтрокиПоПути.Получить(0).Номер = Строка.NUMBER;
				СтрокиПоПути.Получить(0).Дата = Строка.DATE;
			КонецЕсли;
			Записаны.Добавить(Строка.FILENAME);
		Иначе
			СОшибкой.Добавить(Строка.FILENAME);
		КонецЕсли;
	КонецЦикла;
	
	// Подсветка строк.
	Для Счетчик = 1 По 2 Цикл
		
		ПравоеЗначение = ?(Счетчик = 1, СОшибкой, Записаны);
		Если ПравоеЗначение.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НовыйЭлементУсловногоОформления	= УсловноеОформление.Элементы.Добавить();
	    ЭлементыПолейНовогоЭлемента		= НовыйЭлементУсловногоОформления.Поля.Элементы;
	    ЭлементыОтбораНовогоЭлемента	= НовыйЭлементУсловногоОформления.Отбор.Элементы;
		
		Для Каждого Колонка Из Элементы.ТабличноеПоле.ПодчиненныеЭлементы Цикл
		    НовоеПолеОформления = ЭлементыПолейНовогоЭлемента.Добавить();
		    НовоеПолеОформления.Использование	= Истина;
		    НовоеПолеОформления.Поле            = Новый ПолеКомпоновкиДанных(Колонка.Имя);
		КонецЦикла;
	    
	    ЭлементОтбора = ЭлементыОтбораНовогоЭлемента.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	    ЭлементОтбора.ВидСравнения		= ВидСравненияКомпоновкиДанных.ВСписке;
	    ЭлементОтбора.ЛевоеЗначение		= Новый ПолеКомпоновкиДанных("ТабличноеПоле.Путь");
	    ЭлементОтбора.ПравоеЗначение	= ПравоеЗначение;
	    ЭлементОтбора.Использование		= Истина;
	    
	    НовыйЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ?(Счетчик = 1, WebЦвета.Красный, WebЦвета.Серый));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

