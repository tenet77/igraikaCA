&НаКлиенте
Процедура ТоварыНаПалетахПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		Если ЗначениеЗаполнено(Элементы.ТоварыНаПалетах.ТекущиеДанные.НомерПалета) Тогда
			НомерПаллеты = ЭКОМ_ОбщегоНазначенияКлиент.ЭКОМ_ПреобразоватьВЧислоОбщегоНазначения(Элементы.ТоварыНаПалетах.ТекущиеДанные.НомерПалета) + 1;
			Количество = ПолучитьСвободноеКоличествоПоПаллетам(Элементы.ТоварыНаПалетах.ТекущиеДанные, НоваяСтрока);
			ДобавитьСтрокуВТоварыНаПалетах(Элемент.ТекущиеДанные, Элементы.ТоварыНаПалетах.ТекущиеДанные, Количество, НомерПаллеты);
		КонецЕсли;
	КонецЕсли;

	ОбновитьОтображениеДанных(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыНаПалетахПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	Если Элемент.ТекущиеДанные = Неопределено 
		ИЛИ Элемент.ТекущаяСтрока = Неопределено Тогда
    	Возврат;
	КонецЕсли;

	ТекСтрокаНоменклатура = Элемент.ТекущиеДанные;
	
	КоличествоОстаток = ПолучитьСвободноеКоличествоПоПаллетам(ТекСтрокаНоменклатура);
	Если КоличествоОстаток <= 0 Тогда
		ТекСтрокаНоменклатура.Количество = ТекСтрокаНоменклатура.Количество + КоличествоОстаток;
	КонецЕсли;
	
	ТекСтрокаНоменклатура.SSCC = ПолучитьТекСтрокаНоменклатура_SSCC(ТекСтрокаНоменклатура.НомерПалета);
	
	ОбновитьТЧПалеты();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТекСтрокаНоменклатура_SSCC(НомерПалета)

	ТЧПалеты = ЭтаФорма.ТаблицаПалеты.Выгрузить();
	НайденнаяСтрока_НомераПалет = ТЧПалеты.Найти(НомерПалета, "НомерПалета");
	
	Если НайденнаяСтрока_НомераПалет <> Неопределено Тогда
		Результат = НайденнаяСтрока_НомераПалет.SSCC;
	Иначе
		Результат = "";
	КонецЕсли;	

	Возврат Результат;
	
КонецФункции 

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗавершениеРаботы = Ложь 
		ИЛИ ЗавершениеРаботы = Неопределено Тогда
	     ЗаписатьПалеттыНаСервере();
		 
		 ПараметрыОповещения = Новый Структура;
		 ПараметрыОповещения.Вставить("ФормаДляОповещения", "Обработка.УФ_Форма");
		 Оповестить("ОбновитьСписокЭТРН", ПараметрыОповещения);
		 
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьПалеттыНаСервере()
	
	ОбщаяТаблицаПаллет = ЭтаФорма.ТаблицаПалеты.Выгрузить();
	ПаллетыПоТоварам   = ЭтаФорма.ТоварыНаПалетах.Выгрузить();
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ЗаписатьПалетты(ОбщаяТаблицаПаллет, ПаллетыПоТоварам, ЭтаФорма.ДокументСсылка);	
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("НомерТТН", ЭтаФорма.НомерТТН);
    ОбработкаОбъект.ЭКОМ_ТранспортнаяИнформация_РегСв_Записать(ЭтаФорма.ДокументСсылка, СтруктураДанных);
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьSSCCНаСервере()
    тзПаллеты = ТаблицаПалеты.Выгрузить();
    тзПаллеты.ЗаполнитьЗначения("", "SSCC");
    ТаблицаПалеты.Загрузить(тзПаллеты);
    
    тзПаллеты = ТоварыНаПалетах.Выгрузить();
    тзПаллеты.ЗаполнитьЗначения("", "SSCC");
    ТоварыНаПалетах.Загрузить(тзПаллеты);
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьSSCC(Команда)
    ОчиститьSSCCНаСервере();
КонецПроцедуры

