&НаКлиенте
Процедура ДобавитьПаллеты(Команда)
	
	СписокДокументов = ПолучитьВыбранныеСтроки();
	
	СписокНомеровПаллет = Новый СписокЗначений;
	Для каждого Стр Из ЭтаФорма.ТоварыНаПалетах Цикл
		СписокНомеровПаллет.Добавить(ЭКОМ_ОбщегоНазначенияКлиент.ЭКОМ_ПреобразоватьВЧислоОбщегоНазначения(Стр.НомерПалета), Стр.НомерПалета);	
	КонецЦикла;
	
	Если СписокНомеровПаллет.Количество() = 0 Тогда
	     НомерПаллета = 1;
		
	Иначе	
	     СписокНомеровПаллет.СортироватьПоЗначению(НаправлениеСортировки.Убыв);
		 ТекущийНомерПаллета = СписокНомеровПаллет.Получить(0).Значение;
		 НомерПаллета        = ТекущийНомерПаллета + 1;

	КонецЕсли;
	
	Для Каждого СтрТЧ Из СписокДокументов Цикл 		
	
			Количество = ПолучитьСвободноеКоличествоПоПаллетам(СтрТЧ);
			Если Количество > 0 Тогда
							 
			     ДобавитьСтрокуВТоварыНаПалетах(ЭтаФорма.ТоварыНаПалетах.Добавить(), СтрТЧ, Количество, НомерПаллета);
                 НомерПаллета = НомерПаллета + 1;
				 
			КонецЕсли;
			СтрТЧ.КоличествоОстаток = СтрТЧ.КоличествоОстаток - Количество;
			
	КонецЦикла;
	
	ОбновитьТЧПалеты();

КонецПроцедуры

&НаКлиенте
Процедура УстановитьВсеСнятьВсе(Команда)
	
	Если Элементы.СписокТовары.ВыделенныеСтроки.Количество() > 1 Тогда
		Для Каждого СтрТЧ Из Элементы.СписокТовары.ВыделенныеСтроки Цикл 		
			
			СтрТЧ.Отметка = Команда.Имя = "УстановитьВсе";	
			
		КонецЦикла;	
	Иначе	
		Для Каждого СтрТЧ Из СписокТовары Цикл 		
			
			СтрТЧ.Отметка = Команда.Имя = "УстановитьВсе";	
			
		КонецЦикла;
	КонецЕсли;
    
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСвободноеКоличествоПоПаллетам(ТекущаяСтрока, НоваяСтрока = Ложь)
	
	СтруктураОтбор = Новый Структура;
	СтруктураОтбор.Вставить("Номенклатура"     , ТекущаяСтрока.Номенклатура);
	//Docrobot 1.20.0 MOD-1481 [Добавлены Характеристика и Серия]
	СтруктураОтбор.Вставить("Характеристика"     , ТекущаяСтрока.Характеристика);
	СтруктураОтбор.Вставить("Серия"     , ТекущаяСтрока.Серия);
	СтруктураОтбор.Вставить("Ключ_Строки"      , ТекущаяСтрока.Ключ_Строки);
	СтруктураОтбор.Вставить("Единица_Измерения", ТекущаяСтрока.Единица_Измерения);
	
	ТекущаяСтрокаНоменклатуры = Неопределено;
	КоличествоНоменклатурыВсего = 0;
	Для каждого Строка Из ЭтаФорма.СписокТовары Цикл
	            Если Строка.Ключ_Строки = ТекущаяСтрока.Ключ_Строки Тогда
				     КоличествоНоменклатурыВсего = КоличествоНоменклатурыВсего + Строка.Количество;
					 ТекущаяСтрокаНоменклатуры   = Строка;
		        КонецЕсли;
	КонецЦикла;
	
	КоличествоОстатокДляРазмещения = 0;
	Если НоваяСтрока Тогда	
		Если НЕ ТекущаяСтрокаНоменклатуры = Неопределено Тогда
			КоличествоОстатокДляРазмещения = ТекущаяСтрокаНоменклатуры.КоличествоОстаток;
		КонецЕсли;
		
	Иначе
		НайденныеСтроки_НаПалетах = ЭтаФорма.ТоварыНаПалетах.НайтиСтроки(СтруктураОтбор);	
		КоличествоРазмещено = 0;
		Для каждого стр_НаПалетах из НайденныеСтроки_НаПалетах Цикл
			КоличествоРазмещено = КоличествоРазмещено + стр_НаПалетах.Количество;
		КонецЦикла;	
		
		// Количество остаток которое можно разместить
		КоличествоОстатокДляРазмещения = КоличествоНоменклатурыВсего - КоличествоРазмещено;
		//ИзменитьСтрокуСпискаТоваров();
		Если НЕ ТекущаяСтрокаНоменклатуры = Неопределено Тогда
			// Если разместить то останется
			ТекущаяСтрокаНоменклатуры.КоличествоОстаток = КоличествоОстатокДляРазмещения;	
		КонецЕсли;
		
	КонецЕсли;
		
	Возврат КоличествоОстатокДляРазмещения;
	
КонецФункции	

&НаКлиенте
Процедура ДобавитьСтрокуВТоварыНаПалетах(НоваяСтрока, ТекущаяСтрока, Количество, НомерПаллета = Неопределено)
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
	НоваяСтрока.Количество = Макс(Количество, 0);
	
	Если НЕ НомерПаллета = Неопределено Тогда
	     НоваяСтрока.НомерПалета = Строка(НомерПаллета);
	КонецЕсли;
	
КонецПроцедуры

// Функция возвращает выбранные пользователем строки табличной части. В качестве метода выбора 
// приоритетом является установка флажков в необходимых строках. Если флажки не установлены,
// функция возвращает выделенные строки.
//
// Параметры:
//  ИмяТабличнойЧасти  - Строка - имя таблицы, с которой работает пользователь
//
// Возвращаемое значение:
//   Массив, ВыделенныеСтрокиТабличногоПоля   - коллекция выбранных пользователем строк табличной части
//
&НаКлиенте
Функция ПолучитьВыбранныеСтроки()
	
	ВыгружаемыеДанныеВыделения = Новый Массив;
	ВыбранныеСтроки = ЭтаФорма.СписокТовары.НайтиСтроки(Новый Структура("Отметка", Истина));
	
	Если ВыбранныеСтроки.Количество() = 0 Тогда
		
		Для каждого текВыделеннаяСтрока Из Элементы.СписокТовары.ВыделенныеСтроки Цикл
			ВыбраннаяСтрока = Элементы.СписокТовары.ДанныеСтроки(текВыделеннаяСтрока);
			ВыгружаемыеДанныеВыделения.Добавить(ВыбраннаяСтрока);
		КонецЦикла;
		
	Иначе
		ВыгружаемыеДанныеВыделения = ВыбранныеСтроки;
	КонецЕсли;
	
	Возврат ВыгружаемыеДанныеВыделения;
	
КонецФункции

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы = Истина Тогда
		ТекстПредупреждения = "Необходимо закрыть форму паллет";
		Отказ = Истина;
	Иначе
		
		Если ЭтаФорма.ЗакрытьФормуПринудительно = Ложь Тогда
			
			ПустойКодПаллета = Ложь;
			Для каждого Стр Из ЭтаФорма.ТаблицаПалеты Цикл
				Если НЕ ЗначениеЗаполнено(Стр.SSCC) Тогда
					ПустойКодПаллета = Истина;
				КонецЕсли;
			КонецЦикла;
			
			Если ПустойКодПаллета = Истина Тогда
				
				Данные     = Новый Структура;
				Данные.Вставить("Отказ", Отказ);
				Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопрос", ЭтаФорма, Данные); 		
				ПоказатьВопрос(Оповещение, "Не сформирован код для паллет. Закрыть форму?", РежимДиалогаВопрос.ДаНетОтмена, 0);
				Отказ = Истина;
				
			КонецЕсли;		
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаНаВопрос(Результат, Данные) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да  Тогда
		ЭтаФорма.ЗакрытьФормуПринудительно = Истина;
		ЭтаФорма.Закрыть();	   
	ИначеЕсли  Результат = КодВозвратаДиалога.Нет Тогда
		Данные.Отказ = Истина;
		Возврат;
	Иначе
		Данные.Отказ = Истина;
		Возврат;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КомандаДобавитьНаОднуПаллету(Команда)
	
	СписокДокументов = ПолучитьВыбранныеСтроки();
	
	Если ФормированиеМикспалетыЗапрещено И СписокДокументов.Количество() > 1 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Формирование микспаллеты запрещено!");
		Возврат;
	КонецЕсли;
	
	СписокНомеровПаллет = Новый СписокЗначений;
	Для каждого Стр Из ЭтаФорма.ТоварыНаПалетах Цикл
		СписокНомеровПаллет.Добавить(ЭКОМ_ОбщегоНазначенияКлиент.ЭКОМ_ПреобразоватьВЧислоОбщегоНазначения(Стр.НомерПалета), Стр.НомерПалета);	
	КонецЦикла;
	
	Если СписокНомеровПаллет.Количество() = 0 Тогда
		НомерПаллета = 1;
	Иначе	
		СписокНомеровПаллет.СортироватьПоЗначению(НаправлениеСортировки.Убыв);
		ТекущийНомерПаллета = СписокНомеровПаллет.Получить(0).Значение;
		НомерПаллета        = ТекущийНомерПаллета + 1;
	КонецЕсли;
	
	Для Каждого СтрТЧ Из СписокДокументов Цикл 		
		
		Количество = ПолучитьСвободноеКоличествоПоПаллетам(СтрТЧ);
		Если Количество > 0 Тогда
			
			ДобавитьСтрокуВТоварыНаПалетах(ЭтаФорма.ТоварыНаПалетах.Добавить(), СтрТЧ, Количество, НомерПаллета);
			
		КонецЕсли;
		СтрТЧ.КоличествоОстаток = СтрТЧ.КоличествоОстаток - Количество;
		
	КонецЦикла;
	
	ОбновитьТЧПалеты();
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыНаПалетахПередУдалением(Элемент, Отказ)
	
	Если НЕ Элемент.ТекущиеДанные = Неопределено Тогда
		
		ТекСтрПаллеты = Элемент.ТекущиеДанные;
		
		//СтруктураОтбор = Новый Структура;
		//СтруктураОтбор.Вставить("Номенклатура"     , ТекСтрПаллеты.Номенклатура);
		//СтруктураОтбор.Вставить("Ключ_Строки"      , ТекСтрПаллеты.Ключ_Строки);
		//СтруктураОтбор.Вставить("Единица_Измерения", ТекСтрПаллеты.Единица_Измерения);
		//
		//НайденныеСтроки_НаПалетах = ЭтаФорма.ТоварыНаПалетах.НайтиСтроки(СтруктураОтбор);	
		//КоличествоРазмещеноОсвободившееся = 0;
		//Для каждого стр_НаПалетах из НайденныеСтроки_НаПалетах Цикл
		//	КоличествоРазмещеноОсвободившееся = КоличествоРазмещеноОсвободившееся + стр_НаПалетах.Количество;
		//КонецЦикла;
		
		ТекСтрНоменклатурыСписка = Неопределено;
		Для каждого СтрокаСписка Из ЭтаФорма.СписокТовары Цикл
			Если СтрокаСписка.Ключ_Строки = ТекСтрПаллеты.Ключ_Строки Тогда
				ТекСтрНоменклатурыСписка = СтрокаСписка;
			КонецЕсли;
		КонецЦикла;

		Если НЕ ТекСтрНоменклатурыСписка = Неопределено Тогда
			ТекСтрНоменклатурыСписка.КоличествоОстаток = ТекСтрНоменклатурыСписка.КоличествоОстаток + ТекСтрПаллеты.Количество;	
		КонецЕсли;
				
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПалетыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НЕ Элемент.ТекущиеДанные = Неопределено Тогда
	     СтарыйКодSSCC = Элемент.ТекущиеДанные.SSCC;	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПалетыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если НЕ Элемент.ТекущиеДанные = Неопределено Тогда
	 
	     НовыйКодSSCC = Элемент.ТекущиеДанные.SSCC;	
		 
		 ПараметрыОтбора = Новый Структура;
		 ПараметрыОтбора.Вставить("SSCC", СтарыйКодSSCC);
		 
		 НайденныеСтроки_НаПалетах = ЭтаФорма.ТоварыНаПалетах.НайтиСтроки(ПараметрыОтбора);	
		 Для каждого Стр Из НайденныеСтроки_НаПалетах Цикл
		      Стр.SSCC = НовыйКодSSCC;
		 КонецЦикла;
		 		 
	 КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РаспределитьПоКоличеству(Команда)
	
	ТекСтрокаПаллеты = Элементы.ТоварыНаПалетах.ТекущиеДанные;
	Если ТекСтрокаПаллеты = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не выбрана строка для распределения";
		Сообщение.Сообщить();
	Иначе
		КоличествоОстаток = ПолучитьСвободноеКоличествоПоПаллетам(ТекСтрокаПаллеты);
		КоличествоРаспределений = Цел(КоличествоОстаток/ТекСтрокаПаллеты.Количество); 
		Пакеты = Новый Массив;
		Для н=1 По КоличествоРаспределений Цикл
			Пакеты.Добавить(ТекСтрокаПаллеты.Количество);
		КонецЦикла;	
		ОстатокОтЧасти = КоличествоОстаток%ТекСтрокаПаллеты.Количество;
		Если НЕ ОстатокОтЧасти = 0 Тогда
			Пакеты.Добавить(ОстатокОтЧасти);
		КонецЕсли;
		
		НомерПалета = ЭКОМ_ОбщегоНазначенияКлиент.ЭКОМ_ПреобразоватьВЧислоОбщегоНазначения(ТекСтрокаПаллеты.НомерПалета);
		Для каждого СтрПакета Из Пакеты Цикл
			НомерПалета = НомерПалета + 1;
			ПакетРаспределен = Ложь;
			Пока Не ПакетРаспределен Цикл
				Если ФормированиеМикспалетыЗапрещено Тогда
					СтрокиПалета = ТоварыНаПалетах.НайтиСтроки(Новый Структура("НомерПалета", Строка(НомерПалета)));
					Если СтрокиПалета.Количество() > 0 Тогда
						НомерПалета = НомерПалета + 1;
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				
				Элементы.ТоварыНаПалетах.ДобавитьСтроку();
				ДобавитьСтрокуВТоварыНаПалетах(Элементы.ТоварыНаПалетах.ТекущиеДанные, ТекСтрокаПаллеты, СтрПакета, НомерПалета);
				ПакетРаспределен = Истина;
			КонецЦикла;	
		КонецЦикла;
		
		ОбновитьОтображениеДанных();
		
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура СортироватьТаблицаПалеты()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	ТабЧасть = ТаблицаПалеты.Выгрузить(); // создаем временную таблицу
	ТабЧасть.Колонки.Добавить("НомерПалетаЧисло"); // добавляем в нее нужную колонку
	
	Для каждого Стр из ТабЧасть цикл
		Стр.НомерПалетаЧисло = ОбработкаОбъект.ЭКОМ_ПреобразоватьВЧисло(Стр.НомерПалета); // переписываем информацию из расчетной колонки во временную таблицу
	КонецЦикла;
	
	ТабЧасть.Сортировать("НомерПалетаЧисло"); // Сортируем временную таблицу по нужной колонке
	ТаблицаПалеты.Загрузить(ТабЧасть); // Загружаем временную таблицу в табличную часть

КонецПроцедуры

&НаСервере
Функция ЗаполнитьМакетШК_ПаллетыНаСервере(МассивЛогаСобытий)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаОбъект.ЗаполнитьМакетШК_Паллеты(ДокументСсылка, ТаблицаПалеты, МассивЛогаСобытий);
	
КонецФункции

&НаКлиенте
Процедура Печать(Команда)
	
	Если Модифицированность Тогда
		ЗаписатьПалеттыНаСервере();
		Модифицированность = Ложь;
	КонецЕсли;
	
	МассивЛогаСобытий = Новый Массив;
	
	ТабДок = ЗаполнитьМакетШК_ПаллетыНаСервере(МассивЛогаСобытий);
	Если НЕ ТабДок = Неопределено Тогда
		ТабДок.Показать("Этикетка палет");
	КонецЕсли;
	
	Если НЕ ЭтаФорма.ВладелецФормы = Неопределено Тогда
		ЭтаФорма.ВладелецФормы.ОтобразитьЛогСобытий(МассивЛогаСобытий);
	КонецЕсли;
	
КонецПроцедуры