&НаКлиенте
Перем СтарыйКодSSCC;


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	Параметры.Свойство("ДокументСсылка", ДокументСсылка);
	
	ЭКОМ_Документ_ORDER = Неопределено;
	Параметры.Свойство("ЭКОМ_Документ_ORDER", ЭКОМ_Документ_ORDER);
	Если ЗначениеЗаполнено(ЭКОМ_Документ_ORDER) Тогда
	     ЭтаФорма.МестоДоставкиУпаковки = ЭКОМ_Документ_ORDER.xmlТочкаДоставки; // По умолчанию точка доставки GLN
	КонецЕсли;
	
	// Паллеты по номенклатуре (POSITION)
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ТЧТоварыНаПалетах = ОбработкаОбъект.ПолучитьДанныеПаллетах(ЭтаФорма.ДокументСсылка);	
	Для каждого СтрТЧ Из ТЧТоварыНаПалетах Цикл
		
		НоваяСтрока = ТоварыНаПалетах.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрТЧ);
	    НоваяСтрока.ВесНеттоШтуки  = ?(СтрТЧ.Количество = 0, 0, СтрТЧ.ВесНетто  / СтрТЧ.Количество);
	    НоваяСтрока.ВесБруттоШтуки = ?(СтрТЧ.Количество = 0, 0, СтрТЧ.ВесБрутто / СтрТЧ.Количество);
		
	КонецЦикла;

    Если ЗначениеЗаполнено(ДокументСсылка) Тогда
		
		ЭтаФорма.Заголовок = "Разбивка по паллетам для: " + Строка(ДокументСсылка);
		ЭтаФорма.Контрагент = ДокументСсылка.Контрагент; 
		
		// Номенклатура из документа
		//Docrobot 1.19.0 MOD-1357
		МетаданныеДокумент = ДокументСсылка.Метаданные();
		
		Если Не МетаданныеДокумент.ТабличныеЧасти.Найти("Товары") = Неопределено Тогда
			ИмяТЧ = "Товары";
		ИначеЕсли Не МетаданныеДокумент.ТабличныеЧасти.Найти("Запасы") = Неопределено Тогда //Для УНФ
			ИмяТЧ = "Запасы";
		Иначе
			ИмяТЧ = "";	
		КонецЕсли;
		//КОНЕЦ Docrobot 1.19.0 MOD-1357
		МД_ДокументСсылка = ДокументСсылка.Метаданные();
		МД_Товары         = МД_ДокументСсылка.ТабличныеЧасти.Найти(ИмяТЧ);
		ДокументСсылкаИмя = МД_ДокументСсылка.Имя;
		
		Если МД_Товары = Неопределено Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		РеквизитыТЧ = МД_Товары.Реквизиты;		
		
		КолонкиТЧ = Новый Соответствие;
		//Docrobot 1.20.0 MOD-1481 [Добавлены Характеристика и Серия]
		КолонкиТЧ.Вставить("Характеристика"  , "Характеристика");
		КолонкиТЧ.Вставить("Серия"     		 , "Серия");
		КолонкиТЧ.Вставить("НомерСтроки"     , "НомерСтроки");
		КолонкиТЧ.Вставить("Количество"      , "Количество");
		КолонкиТЧ.Вставить("КоличествоМест"  , "КоличествоМест");
		КолонкиТЧ.Вставить("Коэффициент"     , "Коэффициент");
		КолонкиТЧ.Вставить("Цена"            , "Цена");
		КолонкиТЧ.Вставить("Сумма"           , "Сумма");
		КолонкиТЧ.Вставить("СтавкаНДС"       , "СтавкаНДС");
		КолонкиТЧ.Вставить("СуммаНДС"        , "СуммаНДС");
		КолонкиТЧ.Вставить("СуммаСНДС"       , "СуммаСНДС");
		
		Если НЕ РеквизитыТЧ.Найти("ЕдиницаИзмерения") = Неопределено Тогда
			КолонкиТЧ.Вставить("ЕдиницаИзмерения", "Единица_Измерения");
		ИначеЕсли НЕ РеквизитыТЧ.Найти("Упаковка") = Неопределено Тогда
			КолонкиТЧ.Вставить("Упаковка", "Единица_Измерения");
		КонецЕсли;
				
		ИмяДинамическогоСписка = "СписокТовары";
		ТекстЗапросаРеквизитов = "";
		НовыеКолонкиТЧ = Новый Соответствие; 
		Для каждого ЭлементКолонкиТЧ Из КолонкиТЧ Цикл
			
			ИмяКолонки = ЭлементКолонкиТЧ.Ключ;
			Если НЕ РеквизитыТЧ.Найти(ИмяКолонки) = Неопределено Тогда
								
				ИмяПредставлениеКолонки = ЭлементКолонкиТЧ.Значение;	
				НайденнаяКолонкаДинамическогоСписка = Элементы.Найти(ИмяДинамическогоСписка + ИмяПредставлениеКолонки); 				
				Если НайденнаяКолонкаДинамическогоСписка = Неопределено	 Тогда
					 НовыеКолонкиТЧ.Вставить(ИмяКолонки, ИмяПредставлениеКолонки);               				
				КонецЕсли;

			    ТекстЗапросаРеквизитов = ТекстЗапросаРеквизитов + ?(ТекстЗапросаРеквизитов = "", "", ",")  + "
				                     |	РеализацияТЧ." + ИмяКолонки + " КАК " + ИмяПредставлениеКолонки;		 
			КонецЕсли;
			
        КонецЦикла;
						
		ТекстЗапроса = "ВЫБРАТЬ
		               |	РеализацияТЧ.НомерСтроки КАК Ключ_Строки,
		               |	РеализацияТЧ.Номенклатура КАК Номенклатура,
					   |    ЛОЖЬ как Отметка, 
		               |	0 КАК ДругиеРеквизиты
		               |ИЗ
		               |	&ДокументРеализацииТЧ КАК РеализацияТЧ
		               |ГДЕ
		               |	РеализацияТЧ.Ссылка = &ДокументСсылка";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "0 КАК ДругиеРеквизиты", ТекстЗапросаРеквизитов);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДокументРеализацииТЧ", "Документ." + ДокументСсылкаИмя + "." + ИмяТЧ);

		// Товары из документа
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = СписокТовары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
			СтруктураОтбор = Новый Структура;
			СтруктураОтбор.Вставить("Номенклатура"     , НоваяСтрока.Номенклатура);
			СтруктураОтбор.Вставить("Ключ_Строки"      , НоваяСтрока.Ключ_Строки);
			СтруктураОтбор.Вставить("Единица_Измерения", НоваяСтрока.Единица_Измерения);
			//Docrobot 1.20.0 MOD-1481 [Добавлены Характеристика и Серия]
			СтруктураОтбор.Вставить("Характеристика"	, НоваяСтрока.Характеристика); 
			СтруктураОтбор.Вставить("Серия"				, НоваяСтрока.Серия);
			
			НайденныеСтроки_НаПалетах = ЭтаФорма.ТоварыНаПалетах.НайтиСтроки(СтруктураОтбор);	
			КоличествоРазмещено = 0;
			Для каждого стр_НаПалетах из НайденныеСтроки_НаПалетах Цикл
				КоличествоРазмещено = КоличествоРазмещено + стр_НаПалетах.Количество;
			КонецЦикла;	
			
			НоваяСтрока.КоличествоОстаток = НоваяСтрока.Количество - КоличествоРазмещено;

		КонецЦикла;

		ДанныеФормированияМиксПалеты = ОбработкаОбъект.ФормированиеМикспалетыЗапрещено(ДокументСсылка.Контрагент, ЭКОМ_Документ_ORDER);
		Если ДанныеФормированияМиксПалеты.Тандер И ДанныеФормированияМиксПалеты.ФормированиеЗапрещено Тогда
			ФормированиеМикспалетыЗапрещено = Истина;
		КонецЕсли;
		Элементы.ГруппаПредупреждение.Видимость = ФормированиеМикспалетыЗапрещено;
		Элементы.ТоварыНаПалетахНомерПалета.ТолькоПросмотр = ФормированиеМикспалетыЗапрещено;
		
	КонецЕсли;
				
	ДанныеПоТранспорту = ОбработкаОбъект.ЭКОМ_ТранспортнаяИнформация_РегСв_Прочитать(ЭтаФорма.ДокументСсылка);
	Если ДанныеПоТранспорту.СведенияЕсть = Истина Тогда
		ЭтаФорма.НомерТТН = ДанныеПоТранспорту.НомерТТН;
	КонецЕсли;	
		 
	Если НЕ ЗначениеЗаполнено(ЭтаФорма.НомерТТН) Тогда		
		ЭтаФорма.НомерТТН = СокрЛП(ДокументСсылка.Номер);		
	КонецЕсли;
	
	// Итоговая таблица (PACKINGSEQUENCE)
	ТЗ_Палеты = ТЧТоварыНаПалетах.Скопировать();
	ТЗ_Палеты.Свернуть("НомерПалета,SSCC,Объем,Европаллета,Высота,МестоДоставкиУпаковки", "Количество,ВесНетто,ВесБрутто");
	ТЗ_Палеты.Колонки.Добавить("НомерПалетаЧисло");
	Для каждого Стр из ТЗ_Палеты цикл
		Стр.НомерПалетаЧисло = ОбработкаОбъект.ЭКОМ_ПреобразоватьВЧисло(Стр.НомерПалета); // переписываем информацию из расчетной колонки во временную таблицу
	КонецЦикла;
	ТЗ_Палеты.Сортировать("НомерПалетаЧисло");
	ЗначениеВРеквизитФормы(ТЗ_Палеты, "ТаблицаПалеты");
	
	Если НЕ ОбработкаОбъект.ПолучитьДоступностьApiПоСтране() Тогда 
		Элементы.SSCC_ПолучатьОнлайн.Видимость = Ложь;	
	Иначе	
		SSCC_ПолучатьОнлайн = Истина; 
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура КомандаСгенерироватьНомераПалетНаСервере(ТекстПредупреждения)

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    Если ЗначениеЗаполнено(ДокументСсылка) Тогда
   
        Если ЗначениеЗаполнено(ДокументСсылка.Организация) = Ложь Тогда
        	ТекстПредупреждения = "Не заполнен Организация в документе";
            Возврат;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДокументСсылка.Контрагент) = Ложь Тогда
        	ТекстПредупреждения = "Не заполнен Контрагент в документе";
            Возврат;
		КонецЕсли;
		
    Иначе
        ТекстПредупреждения = "Не заполнен документ";
        Возврат;
    КонецЕсли;
	
	СведенияОбОрганизации = ОбработкаОбъект.ЭКОМ_GLN_Прочитать(ДокументСсылка.Организация);	
	Если СведенияОбОрганизации.СведенияЕсть Тогда
	    GLN_Организации = СведенияОбОрганизации.GLN;
	Иначе
        ТекстПредупреждения = "Не заполнен GLN для организации: " + Строка(ДокументСсылка.Организация) + ". Он требуется для генерации SSCC кодов";
        Возврат;
	КонецЕсли;
	
	СведенияОКонтрагенте = ОбработкаОбъект.ЭКОМ_GLN_Прочитать(ДокументСсылка.Контрагент);	
	Если СведенияОКонтрагенте.СведенияЕсть Тогда
	    GLN_Контрагента = СведенияОКонтрагенте.GLN;
	Иначе
        ТекстПредупреждения = "Не заполнен GLN для контрагента: " + Строка(ДокументСсылка.Контрагент) + ". Он требуется для генерации SSCC кодов";
        Возврат;
	КонецЕсли;
	
	ТЧПалеты     = ЭтаФорма.ТаблицаПалеты; 
    Если ТЧПалеты.Количество() = 0 Тогда
        ОбновитьТЧПалеты();
	КонецЕсли;
	
	Если ПустаяСтрока(GLN_Организации) Тогда
        ТекстПредупреждения = "Не заполнен GLN для организации: " + Строка(ДокументСсылка.Организация) + ". Он требуется для генерации SSCC кодов";
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(GLN_Контрагента) Тогда
        ТекстПредупреждения = "Не заполнен GLN для контрагента: " + Строка(ДокументСсылка.Контрагент) + ". Он требуется для генерации SSCC кодов";
		Возврат;
	КонецЕсли;
	
	Если ФормированиеМикспалетыЗапрещено Тогда // Тандер
		Для Каждого Палета Из ТаблицаПалеты Цикл
			СтруктураПоиска = Новый Структура("НомерПалета", Палета.НомерПалета);
			СтрокиПоНомеруПалеты = ТоварыНаПалетах.НайтиСтроки(СтруктураПоиска);
			Если СтрокиПоНомеруПалеты.Количество() > 1 Тогда
				ТекстПредупреждения = "Формирование микспалеты запрещено. Распределите товар по одному на палете.";
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ТЧПалетыПром = ЭтаФорма.ТаблицаПалеты.Выгрузить();	
	ОбработкаОбъект.ЗаполнитьТалицуНовымиSSCC(ДокументСсылка, GLN_Организации, GLN_Контрагента, ТЧПалетыПром, SSCC_ПолучатьОнлайн, ДокументСсылка.Организация);
    ЭтаФорма.ТаблицаПалеты.Загрузить(ТЧПалетыПром);
			
	Для Каждого стрТекПалет Из ЭтаФорма.ТоварыНаПалетах Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("НомерПалета",стрТекПалет.НомерПалета);
		
		НайденныеСуществующиеНомера = ТЧПалеты.НайтиСтроки(Отбор);
		Для Каждого найденная из НайденныеСуществующиеНомера Цикл
			стрТекПалет.SSCC = найденная.SSCC;
		КонецЦикла;
		
	КонецЦикла;	
	
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСгенерироватьКодыПаллет(Команда)
	
	ТекстПредупреждения = "";
	КомандаСгенерироватьНомераПалетНаСервере(ТекстПредупреждения);
    Если НЕ ПустаяСтрока(ТекстПредупреждения) Тогда
        Сообщить(ТекстПредупреждения);
    КонецЕсли;
	ЗаписатьПалеттыНаСервере();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьНовыйSSCC_Сервер(Организация, ДатаДок, GLN_SUPPLIER, МассивПалеты)
	
	ТЧПалеты = Новый ТаблицаЗначений;
	
	Для каждого СтрМ Из МассивПалеты Цикл
		
		ТЧПалеты.Колонки.Добавить(СтрМ.Ключ);
		
		ТЧПалеты[СтрМ.Ключ] = СтрМ.Значение;
	
	КонецЦикла;

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Результат = ОбработкаОбъект.НовыйSSCC(ДокументСсылка.Организация, Год(ДокументСсылка.Дата), GLN_SUPPLIER, ТЧПалеты);

    ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");	

	Возврат Результат;
	
КонецФункции 

&НаКлиенте
Процедура ТоварыНаПалетахПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
		
	Если Копирование Тогда
		ТекСтрока = Элементы.ТоварыНаПалетах.ТекущиеДанные;
		Если ТекСтрока = Неопределено Тогда
			Сообщить("Не выбрана строка копирования");
		КонецЕсли;
	Иначе	
		ТекСтрока = Элементы.СписокТовары.ТекущиеДанные;
		Если ТекСтрока = Неопределено Тогда
			Сообщить("Выберите номенклатуру, которою необходимо закрепить за палетом");
		КонецЕсли;	
	КонецЕсли;
		
	КоличествоОстаток = ПолучитьСвободноеКоличествоПоПаллетам(ТекСтрока);
	Если КоличествоОстаток <= 0 Тогда
		Отказ = Истина;
		Сообщить("Номенклатура " + СокрЛП(ТекСтрока.Номенклатура) + " по ключевой строке " + СокрЛП(ТекСтрока.Ключ_Строки) + " полностью размещена на палетах");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТоварыНаПалетахПослеУдаления(Элемент)
	
	ОбновитьТЧПалеты();
	
КонецПроцедуры

