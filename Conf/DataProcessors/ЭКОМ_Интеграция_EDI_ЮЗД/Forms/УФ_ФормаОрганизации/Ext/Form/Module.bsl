&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	ДоступностьAPI = ОбработкаОбъект.ПолучитьДоступностьApiПоСтране();
	Если Не ДоступностьAPI Тогда 
		Элементы.ФормаЗаполнитьИзВебПлатформы.Видимость = Ложь;	
	КонецЕсли;
	
    ЗаполнитьЗначенияСвойств(ЭтаФорма, ЭтаФорма.Параметры, "Организация, Копирование");
    
    ЭлементДляОтбораВРегистре = "Организация";
    ЭтаФорма.Заголовок = ?(ЭтаФорма.Копирование = Истина Или ЗначениеЗаполнено(Организация), "Редактирование организации", "Новая организация");
    Если НЕ ЗначениеЗаполнено(ЭтаФорма[ЭлементДляОтбораВРегистре]) Тогда
        Элементы[ЭлементДляОтбораВРегистре].ТолькоПросмотр = Ложь;
        Элементы[ЭлементДляОтбораВРегистре].Доступность    = Истина;
        Элементы[ЭлементДляОтбораВРегистре].ЦветФона       = WebЦвета.Роса;
	    Возврат;
	КонецЕсли;
    
	ЭтаФорма.Организация = ЭтаФорма.Параметры.Организация;
	ДанныеОрганизации = ОбработкаОбъект.ЭКОМ_GLN_Прочитать(ЭтаФорма.Организация);	
	Если ДанныеОрганизации.СведенияЕсть Тогда					
		    ЭтаФорма.GLN                = ДанныеОрганизации.GLN;
			ЭтаФорма.GLN_субассортимент = ДанныеОрганизации.GLN_суб;
			ЭтаФорма.Ид_ОЭД             = ДанныеОрганизации.Ид_ОЭД;					
			ЭтаФорма.ОператорЭДО        = ДанныеОрганизации.Партнер;
			ЭтаФорма.Сертификат         = ДанныеОрганизации.Сертификат;
			ЭтаФорма.Комментарий        = ДанныеОрганизации.Комментарий;
			ЭтаФорма.ПрофильОбмена      = ДанныеОрганизации.ПрофильОбмена;

			ЭтаФорма.АдресКодРегиона      = ДанныеОрганизации.eXiteАдр_КодРегиона;
			ЭтаФорма.АдресИндекс          = ДанныеОрганизации.eXiteАдр_Индекс;
			ЭтаФорма.АдресГород           = ДанныеОрганизации.eXiteАдр_Город;
			ЭтаФорма.АдресУлица           = ДанныеОрганизации.eXiteАдр_Улица;
			ЭтаФорма.АдресДом             = ДанныеОрганизации.eXiteАдр_Дом;
			ЭтаФорма.АдресКорпус          = ДанныеОрганизации.eXiteАдр_Корпус;
			ЭтаФорма.АдресКвартира        = ДанныеОрганизации.eXiteАдр_Кварт;
    КонецЕсли;	
		
	// Тип по умолчанию
	ТипОрганизации = ТипЗнч(ЭтаФорма.Организация);
	ИмяТипаОрганизации = СтрЗаменить(Метаданные.НайтиПоТипу(ТипОрганизации), "Справочник.", "");
	Если НЕ ЗначениеЗаполнено(ИмяТипаОрганизации) Тогда
	     ИмяТипаОрганизации = "Организации";
	КонецЕсли;	  
	
	МетаданныеОрганизацииКПП = Метаданные.Справочники[ИмяТипаОрганизации].Реквизиты.Найти("КПП");
	Если НЕ МетаданныеОрганизацииКПП = Неопределено Тогда
	        ЭтаФорма.КПП = ЭтаФорма.Организация.КПП; 
	Иначе
			ЭтаФорма.КПП = ОбработкаОбъект.Настройка_Параметр_Прочитать("ЭКОМ_КПП_Организации", "", "РеквизитДляОрганизации");
	КонецЕсли;
	
	МетаданныеОрганизацииИНН = Метаданные.Справочники[ИмяТипаОрганизации].Реквизиты.Найти("ИНН");
	Если НЕ МетаданныеОрганизацииИНН = Неопределено Тогда
	        ЭтаФорма.ИНН = ЭтаФорма.Организация.ИНН; 
	Иначе
			ЭтаФорма.ИНН = ОбработкаОбъект.Настройка_Параметр_Прочитать("ЭКОМ_ИНН_Организации", "", "РеквизитДляОрганизации");
	КонецЕсли;
		
    Если ЭтаФорма.Копирование Тогда
        Элементы[ЭлементДляОтбораВРегистре].ЦветФона       = WebЦвета.Роса;
        Элементы[ЭлементДляОтбораВРегистре].ТолькоПросмотр = Ложь;
        Элементы[ЭлементДляОтбораВРегистре].Доступность    = Истина;
        ЭтаФорма.Заголовок = "Новая организация (скопирована) из " + Строка(ЭтаФорма[ЭлементДляОтбораВРегистре]);
        ЭтаФорма[ЭлементДляОтбораВРегистре] = "";
    КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.ЭКОМ_ЗначениеДополнительныхКонстант.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ДополнительнаяКонстанта = "ЭКОМ_ИспользоватьАдресаИзРегистраGLN";
	МенеджерЗаписи.Измерение = Неопределено; 
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.ЗначениеДополнительнойКонстанты = Истина Тогда
		Элементы.ГруппаАдрес.Видимость = Истина;
	Иначе	
		Элементы.ГруппаАдрес.Видимость = Ложь;
	КонецЕсли;	
	 
КонецПроцедуры

&НаСервере
Процедура СохранитьНаСервере(ВсеЗначенияЗаполнены)
    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");	
	Если Не ЗначениеЗаполнено(ЭтаФорма.Организация) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Выберите организацию! Организация не выбрана.";
		Сообщение.Сообщить();
		ВсеЗначенияЗаполнены = Ложь;
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.ПрофильОбмена) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Выберите профиль обмена! Профиль обмена не выбран.";
		Сообщение.Сообщить();
		ВсеЗначенияЗаполнены = Ложь;
		Возврат;
	КонецЕсли;

	СтруктураЭКОМ_GLN = Новый Структура;
	СтруктураЭКОМ_GLN.Вставить("GLN"                , ЭтаФорма.GLN);
	СтруктураЭКОМ_GLN.Вставить("GLN_суб"            , ЭтаФорма.GLN_субассортимент);
	СтруктураЭКОМ_GLN.Вставить("SAPкод"				, ЭтаФорма.SAPкод);
	СтруктураЭКОМ_GLN.Вставить("Ид_ОЭД"             , ЭтаФорма.Ид_ОЭД);
	СтруктураЭКОМ_GLN.Вставить("Партнер"            , ЭтаФорма.ОператорЭДО);
	СтруктураЭКОМ_GLN.Вставить("Сертификат"         , ЭтаФорма.Сертификат);
	СтруктураЭКОМ_GLN.Вставить("Комментарий"        , ЭтаФорма.Комментарий);
    СтруктураЭКОМ_GLN.Вставить("ПрофильОбмена"      , ЭтаФорма.ПрофильОбмена);
	
	СтруктураЭКОМ_GLN.Вставить("eXiteАдр_КодРегиона", СокрЛП(ЭтаФорма.АдресКодРегиона));
	СтруктураЭКОМ_GLN.Вставить("eXiteАдр_Индекс"    , СокрЛП(ЭтаФорма.АдресИндекс));
	СтруктураЭКОМ_GLN.Вставить("eXiteАдр_Город"     , СокрЛП(ЭтаФорма.АдресГород));
	СтруктураЭКОМ_GLN.Вставить("eXiteАдр_Улица"     , СокрЛП(ЭтаФорма.АдресУлица));
	СтруктураЭКОМ_GLN.Вставить("eXiteАдр_Дом"       , СокрЛП(ЭтаФорма.АдресДом));
	СтруктураЭКОМ_GLN.Вставить("eXiteАдр_Корпус"    , СокрЛП(ЭтаФорма.АдресКорпус));
	СтруктураЭКОМ_GLN.Вставить("eXiteАдр_Кварт"     , СокрЛП(ЭтаФорма.АдресКвартира));
	
	ОбработкаОбъект.ЭКОМ_GLN_Запись(ЭтаФорма.Организация, СтруктураЭКОМ_GLN);
	
	ОбработкаОбъект.Настройка_Параметр_Записать("ЭКОМ_КПП_Организации", СокрЛП(ЭтаФорма.КПП), "РеквизитДляОрганизации"); 
	ОбработкаОбъект.Настройка_Параметр_Записать("ЭКОМ_ИНН_Организации", СокрЛП(ЭтаФорма.ИНН), "РеквизитДляОрганизации");

КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)
	
	ВсеЗначенияЗаполнены = Истина;
	СохранитьНаСервере(ВсеЗначенияЗаполнены);
	Если ВсеЗначенияЗаполнены Тогда
	     Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	ВсеЗначенияЗаполнены = Истина;
	СохранитьНаСервере(ВсеЗначенияЗаполнены);		
КонецПроцедуры

&НаСервере
Функция ЗаполнитьИзВебПлатформыНаСервере(ГЛН, МассивЛогаСобытий)
		
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаОбъект.ДанныеКонтрагентаПоAPI(ГЛН, МассивЛогаСобытий);
		
КонецФункции


&НаКлиенте
Процедура ЗаполнитьИзВебПлатформы(Команда)
	
	ИмяСобытия = "Заполнение данных по API";
	МассивЛогаСобытий = Новый Массив;
	Если Не ЗначениеЗаполнено(ЭтаФорма.ПрофильОбмена) Тогда
		ТекстЛогаСобытий = "Не заполнен профиль обмена!";
		ЗаписьСтруктурыЛога = ЭКОМ_ОбщегоНазначенияКлиент.ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Ошибка"), ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

	КонецЕсли;
	Если Не ЗначениеЗаполнено(ЭтаФорма.GLN) Тогда
		ТекстЛогаСобытий = "Не заполнен GLN организации!";
		ЗаписьСтруктурыЛога = ЭКОМ_ОбщегоНазначенияКлиент.ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Ошибка"), ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

	КонецЕсли;
	                                                       
	Если МассивЛогаСобытий.Количество() = 0 Тогда
		ДанныеМассив = ЗаполнитьИзВебПлатформыНаСервере(СокрЛП(ЭтаФорма.GLN), МассивЛогаСобытий);
		Если ТипЗнч(ДанныеМассив) = Тип("Массив") Тогда
			Для Каждого Данные Из ДанныеМассив Цикл			
				
				ЭтаФорма.АдресКодРегиона      = ?(Данные.Регион       = "null", "", Данные.Регион);
				ЭтаФорма.АдресИндекс          = ?(Данные.Индекс       = "null", "", Данные.Индекс);
				ЭтаФорма.АдресГород           = ?(Данные.Город        = "null", "", Данные.Город);
				ЭтаФорма.АдресУлица           = ?(Данные.Улица        = "null", "", Данные.Улица);
				ЭтаФорма.АдресДом             = ?(Данные.НомерДома    = "null", "", Данные.НомерДома);
				ЭтаФорма.АдресКорпус          = ?(Данные.Корпус       = "null", "", Данные.Корпус);
				ЭтаФорма.АдресКвартира        = ?(Данные.Квартира     = "null", "", Данные.Квартира);
				
				Если ЗначениеЗаполнено(Данные.GUID) Тогда
					ЭтаФорма.Ид_ОЭД      = Данные.GUID;
					ЭтаФорма.ОператорЭДО = Данные.Оператор;
					ЭтаФорма.SAPкод		 = Данные.SAPкод;
				Иначе
					Если ЗначениеЗаполнено(ЭтаФорма.ОператорЭДО) Тогда
						Для каждого Стр Из Данные.МассивGUIDS Цикл
							Если Стр.varPrefix = ЭтаФорма.ОператорЭДО.Идентификатор Тогда
								ЭтаФорма.Ид_ОЭД = Стр.varGUID;
								Прервать;
							КонецЕсли;				
						КонецЦикла;	
					Иначе
						ТекстЛогаСобытий = "Заполните оператора ЭДО!";
						ЗаписьСтруктурыЛога = ЭКОМ_ОбщегоНазначенияКлиент.ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, ПредопределенноеЗначение("Перечисление.ЭКОМ_УровниЛогирования.Ошибка"), ИмяСобытия);
						МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

					КонецЕсли;						
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Если МассивЛогаСобытий.Количество() > 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ЭКОМ_ОбщегоНазначенияКлиент.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий);
		Сообщение.Сообщить();		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура GLNОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	СтрокаРазрешенных = "0123456789";
	Для Сч = 1 По СтрДлина(Текст) Цикл 
		Символ = Сред(Текст,Сч,1);
		Если Найти(СтрокаРазрешенных,Символ) <= 0 Тогда
			ЭтаФорма.GLN = "";
			Сообщить("Введен некорректный GLN! Введите GLN состоящий из 13 чисел без пробелов");
			Прервать;
		КонецЕсли;	 
	КонецЦикла;
КонецПроцедуры



