&НаКлиенте
Процедура КаталогСохраненияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок          = "Выберите папку сохранения файлов";
	Диалог.МножественныйВыбор = Ложь;
	
	
	Диалог.Показать(Новый ОписаниеОповещения("СохранениеНастроекСВыбором", ЭтаФорма));   	
КонецПроцедуры

&НаКлиенте
Процедура СохранениеНастроекСВыбором(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Или ТипЗнч(ВыбранныеФайлы) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	КаталогСохранения = ВыбранныеФайлы[0]; 	
 
КонецПроцедуры

&НаКлиенте
Процедура НастройкиДляСохраненияПриИзменении(Элемент)
	 СтрокаДерева	   = Элемент.ТекущиеДанные;
	 СтрокаРодитель    = СтрокаДерева.ПолучитьРодителя();
	 Если Не СтрокаРодитель = Неопределено И СтрокаРодитель.Сохранить И Не СтрокаДерева.Сохранить Тогда
		 СтрокаРодитель.Сохранить = Ложь;
	 КонецЕсли;
	 
	 ПодчиненныеСтроки = СтрокаДерева.ПолучитьЭлементы();
	 Для Каждого Строка Из ПодчиненныеСтроки Цикл
		Строка.Сохранить = СтрокаДерева.Сохранить; 
	 КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Если Не ЗакрытьПоУмолчанию Тогда
		Если ТипОперации = "Загрузка" Тогда
			Результат = Новый Структура("Отменить", Истина);
			ЗакрытьПоУмолчанию = Истина;
			Закрыть(Результат);
		Иначе
			СтандартнаяОбработка = Ложь;
			Отказ = Истина;
			ОписаниеОповещения = Новый ОписаниеОповещения("ПослеОтветаОЗакрытии", ЭтаФорма);
			ПоказатьВопрос(ОписаниеОповещения, "Сохранить выбранные настройки?", РежимДиалогаВопрос.ДаНетОтмена,, КодВозвратаДиалога.Отмена); 
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаОЗакрытии(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗакрытьСПараметром();
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
		Результат = Новый Структура("Отменить", Истина);
		ЗакрытьПоУмолчанию = Истина;
		Закрыть(Результат);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НастройкиДляСохраненияПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьПометкуВДереве(Флажок)
	ДанныеДерева 	   		 = НастройкиДляСохранения.ПолучитьЭлементы();  	
	Для Каждого Элемент Из ДанныеДерева Цикл
		Элемент.Сохранить = Флажок;
		МассивПодчиненных = Элемент.ПолучитьЭлементы();
		Для Каждого ПодчиненныйЭлемент Из МассивПодчиненных Цикл
			ПодчиненныйЭлемент.Сохранить = Флажок;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура НастройкиДляСохраненияСнятьВсеФлажки(Команда)
	ИзменитьПометкуВДереве(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура НастройкиДляСохраненияУстановитьВсеФлажки(Команда)
	ИзменитьПометкуВДереве(Истина);
КонецПроцедуры


