&НаКлиенте
Процедура ЗаполнитьДерево(Команда)
	ЗакрытьСПараметром();
КонецПроцедуры

&НаКлиенте 
Процедура ЗакрытьСПараметром()
	Если ТипОперации = "Сохранение" Тогда
		Если ЗначениеЗаполнено(КаталогСохранения) Тогда
			КаталогДоступенНаЗапись = ЭКОМ_ОбщегоНазначенияКлиент.КаталогДоступенНаЗапись(КаталогСохранения, Новый Массив);
			Если Не КаталогДоступенНаЗапись Тогда
				ТексСообщения = "Отсутствуют права на запись файлов в указанный каталог или каталог указан не верно.";
			КонецЕсли;
		Иначе
			ТексСообщения = "Не указан каталог для сохранения настроек";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТексСообщения) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ТексСообщения;
			Сообщение.Сообщить();
			
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ДанныеДерева 	   		 = НастройкиДляСохранения.ПолучитьЭлементы();
	СоответствиеИменНастроек = ЭКОМ_ОбщегоНазначения.ПолучитьСоответствиеИменНастроек();	

	МассивНастроек = Новый Массив;
	МассивКонстант = Новый Массив;
	ВсегоФайлов	   = 0;
	
	Для Каждого Элемент Из ДанныеДерева Цикл
		НастройкиВыбраны = Ложь;
		
		МассивПодчиненных = Элемент.ПолучитьЭлементы();
		Если МассивПодчиненных.Количество() Тогда
			// сведения о прочих настройках записываются в отбор как константы
			Если Найти(Элемент.Имя, "Прочие настройки") Тогда
				Для Каждого ПодчиненныйЭлемент Из МассивПодчиненных Цикл
					Если ПодчиненныйЭлемент.Сохранить Тогда
						ИмяКонстанты = СоответствиеИменНастроек.СинонимКИмени.Получить(ПодчиненныйЭлемент.Имя);
						
						ВсегоФайлов = ВсегоФайлов + 1;
						МассивКонстант.Добавить(?(ИмяКонстанты = Неопределено, ПодчиненныйЭлемент.Имя, ИмяКонстанты));
					КонецЕсли;
				КонецЦикла;
			Иначе
				// сведения о гибких настройках документов
				// родитель - записывается в отбор как константа
				// подчиненные элементы - в отбор настроек
				Для Каждого ПодчиненныйЭлемент Из МассивПодчиненных Цикл
					Если ПодчиненныйЭлемент.Сохранить Тогда
						ВсегоФайлов = ВсегоФайлов + 1;
						МассивНастроек.Добавить(ПодчиненныйЭлемент.Имя);
						НастройкиВыбраны = Истина;
					КонецЕсли;
				КонецЦикла;
				Если НастройкиВыбраны Тогда
					ИмяКонстанты = СоответствиеИменНастроек.СинонимКИмени.Получить(Элемент.Имя);
					МассивКонстант.Добавить(?(ИмяКонстанты = Неопределено, Элемент.Имя, ИмяКонстанты));  				
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Если МассивКонстант.Количество() = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не выбрано ни одной настройки.";
		Сообщение.Сообщить();
		
		Возврат;
	КонецЕсли;    
	
	СтруктураРезультат = Новый Структура("ВыбранныеТипы, МассивКонстант, КаталогСохранения, СохранятьПоОтдельности, ВсегоФайлов",
												МассивНастроек, МассивКонстант, КаталогСохранения, СохранятьПоОтдельности, ВсегоФайлов); 
	ЗакрытьПоУмолчанию = Истина;
	Закрыть(СтруктураРезультат);
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ТипыТранзакций = Неопределено;
	Если Параметры.Свойство("ТипОперации", ТипОперации) = Ложь
		ИЛИ Параметры.Свойство("ТипыТранзакций", ТипыТранзакций) = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	СоответствиеИменНастроек = ЭКОМ_ОбщегоНазначения.ПолучитьСоответствиеИменНастроек();	
	ДанныеДерева  			 = НастройкиДляСохранения.ПолучитьЭлементы();
	
	Для Каждого Элемент Из ТипыТранзакций Цикл
		Если Не ТипЗнч(Элемент.Значение) = Тип("Массив") 
			ИЛИ ТипЗнч(Элемент.Значение) = Тип("Массив") И Элемент.Значение.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		ИмяНастройки = СоответствиеИменНастроек.ИмяКСинониму.Получить(Элемент.Ключ);
		
		НовСтрДерева = ДанныеДерева.Добавить();
		НовСтрДерева.Имя = ?(ИмяНастройки = Неопределено,Элемент.Ключ, ИмяНастройки);
		
		Для Каждого Транзакция Из Элемент.Значение Цикл
			ИмяТранзакции = СоответствиеИменНастроек.ИмяКСинониму.Получить(Транзакция);
			
			ЭнементыНовойСтроки   = НовСтрДерева.ПолучитьЭлементы();
			ПодчиненнаяСтрока	  = ЭнементыНовойСтроки.Добавить();
			ПодчиненнаяСтрока.Имя = ?(ИмяТранзакции = Неопределено, Транзакция, ИмяТранзакции);
		КонецЦикла;             
	КонецЦикла;  
	
	Если ТипОперации = "Загрузка" Тогда
		Элементы.КаталогСохранения.Видимость = Ложь;
		Элементы.СохранятьПоОтдельности.Видимость = Ложь;
		Элементы.ФормаЗаполнитьДерево.Заголовок = "Загрузить настройки";
		Элементы.НастройкиДляСохраненияСохранить.Заголовок = "Загрузить";
	КонецЕсли;
	
КонецПроцедуры   

