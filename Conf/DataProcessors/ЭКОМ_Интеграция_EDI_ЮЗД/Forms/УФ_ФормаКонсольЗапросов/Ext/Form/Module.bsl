&НаКлиенте
Функция ВыделенныйКод()
	
	Выделение = ПолучитьВыделение();
	
	ТекстовыйДок = Новый ТекстовыйДокумент;
    ВесьКод = ЭтаФорма.ПолеТекст.ПолучитьТекст();
    ТекстовыйДок.УстановитьТекст(ВесьКод);
    
    МассивСтрок = ИзСтрокиСРазделителямиИПозициямиСимвола(ЭтаФорма.ПолеТекст.ПолучитьТекст(), Символы.ПС);

    Буфер = "";
    
	Старт = Ложь;
	ПродолжитьОбработку = Ложь;
	Финиш = Ложь;
	
	Счетчик = 1;
	Для каждого Стр Из МассивСтрок Цикл
		
		Старт = Выделение.Начало >= Стр.ПозицияНачала И Выделение.Начало <= Стр.ПозицияКонец;
		Если Старт Тогда
			ПродолжитьОбработку = Истина;
		КонецЕсли;
		
		Если ПродолжитьОбработку Тогда
			
			ТекущийТекстСтроки = ТекстовыйДок.ПолучитьСтроку(Счетчик);
			
			Буфер = Буфер 
			+ ?(ПустаяСтрока(Буфер), "", Символы.ПС) 
			+ ТекущийТекстСтроки;	
				 		
			Финиш = Выделение.Окончание >= Стр.ПозицияНачала И Выделение.Окончание <= Стр.ПозицияКонец;
			Если Финиш Тогда
				ПродолжитьОбработку = Ложь;	 
			КонецЕсли;
			
		КонецЕсли;
		
		Счетчик = Счетчик + 1;
	КонецЦикла;

    Возврат Буфер;
	
КонецФункции

