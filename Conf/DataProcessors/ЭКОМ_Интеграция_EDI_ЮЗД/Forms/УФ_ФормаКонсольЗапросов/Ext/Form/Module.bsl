Функция ПолучитьТекстЗапросаИзПеременнойКода(МассивЛогаСобытий)
    //КодДляКонсолиЗапросов = ВыделенныйКод();
    ТекстКода = ЭтаФорма.ПолеТекст.ПолучитьТекст();
    
    Попытка
        ОбъектЭтаОбработка = РеквизитФормыВЗначение("Объект");
        
        ПеременныеЗапросовСТекстомЗапроса = ОбъектЭтаОбработка.НайтиТекстыЗапросовВКоде(ТекстКода, МассивЛогаСобытий, Источник, НомерИсправленияНаФорме, Приемник);
        
        Если ПеременныеЗапросовСТекстомЗапроса = Неопределено Или ТипЗнч(ПеременныеЗапросовСТекстомЗапроса) <> Тип("СписокЗначений") Тогда
        	Возврат Неопределено;
        КонецЕсли;
        Если ПеременныеЗапросовСТекстомЗапроса.Количество() > 1 Тогда
            РезультатВыбора = ПеременныеЗапросовСТекстомЗапроса.ВыбратьЭлемент("Из какой переменной использовать текст запроса?");
            Если РезультатВыбора = Неопределено Тогда
                ТекстЗапроса = РезультатВыбора.Значение;
            КонецЕсли;
        Иначе
            ТекстЗапроса = ПеременныеЗапросовСТекстомЗапроса.Получить(0).Значение;
        КонецЕсли;
    Исключение
        Ошибка = ОписаниеОшибки();
        Попытка
            ОбъектЭтаОбработка.НайтиТекстыЗапросовВКоде(ТекстКода, МассивЛогаСобытий, Источник, НомерИсправленияНаФорме, Приемник);
        Исключение
            Ошибка = ОписаниеОшибки();
            ВызватьИсключение(Ошибка);
        КонецПопытки;
        
    КонецПопытки;
    Возврат ТекстЗапроса;
КонецФункции

