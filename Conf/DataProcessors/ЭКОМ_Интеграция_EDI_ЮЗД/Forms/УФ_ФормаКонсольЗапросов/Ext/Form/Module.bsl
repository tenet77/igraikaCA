////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ПолноеИмяОбработки = ОбработкаОбъект.Метаданные().ПолноеИмя();
	
	ЭКОМ_ДеревоКонфигурации = Неопределено;
    
    ПараметрыОткрытия = ЭтаФорма.Параметры;
	Если ПараметрыОткрытия.Свойство("ДопПараметры") = Истина Тогда
		ПараметрыОткрытия.ДопПараметры.Свойство("ИмяЭлементаФормы",    ИмяЭлементаФормы);	
		ПараметрыОткрытия.ДопПараметры.Свойство("ЭКОМ_ОбменCondra",    ЭтаФорма.ЭКОМ_ОбменCondra);
		ПараметрыОткрытия.ДопПараметры.Свойство("ЭКОМ_ОбменСеть",      ЭтаФорма.ЭКОМ_ОбменСеть);
		ПараметрыОткрытия.ДопПараметры.Свойство("ЭКОМ_ОбменЭТРН",      ЭтаФорма.ЭКОМ_ОбменЭТРН);
		ПараметрыОткрытия.ДопПараметры.Свойство("ЭКОМ_ОбменПоставщик", ЭтаФорма.ЭКОМ_ОбменПоставщик);
	КонецЕсли;

    ПроверятьНаФорме = ?(ИмяЭлементаФормы = "ГруппаПоставщик" Или ИмяЭлементаФормы = "ГруппаПокупатель", Истина, Ложь); //этот реквизит передается при вызове формы по нему определяю это код для запроса динамического списка на основной форме АРМа или код вычисляемый в модуле обработки
    Элементы.ТестированиеКодаВМодулеФормы.Видимость     = ПроверятьНаФорме;
    Элементы.ТестированиеКодаВМодулеОбработки.Видимость = НЕ ПроверятьНаФорме;
    
	ТипДокументаИсточник = "";
	ПараметрыОткрытия.Свойство("ТипДокументаИсточника", ТипДокументаИсточник);
	Если ЗначениеЗаполнено(ТипДокументаИсточник) Тогда
		ЭКОМ_ДеревоКонфигурации = ОбработкаОбъект.Настройка_Параметр_Прочитать("СлужебныйДеревоКонфигурации", , "Служебный");
		Если НЕ ЭКОМ_ДеревоКонфигурации = Неопределено Тогда
			СтрокаДерева = ЭКОМ_ДеревоКонфигурации.Строки.Найти(ТипДокументаИсточник, "Синоним");
			Если НЕ СтрокаДерева = Неопределено Тогда
				ЭтаФорма.Источник = Документы[СтрокаДерева.Имя].ПустаяСсылка();
			Иначе
				ДанныеПоКолонкам = ЭКОМ_ОбщегоНазначения.ПолучитьДанныеПоКолонкамИсточника();
				Типы = ДанныеПоКолонкам.Получить(ТипДокументаИсточник);
				Если НЕ Типы = Неопределено Тогда
				     Элементы.Источник.ОграничениеТипа = Типы;
				КонецЕсли;	
				ДанныеПоТипам    = ОбработкаОбъект.ПолучитьТипДокументаКолонки(ТипДокументаИсточник, ДанныеПоКолонкам);
				СтрокаДерева     = ЭКОМ_ДеревоКонфигурации.Строки.Найти(ДанныеПоТипам.ИмяДокументаВКонфигурации, "Имя");
				Если НЕ СтрокаДерева = Неопределено Тогда
					ЭтаФорма.Источник = Документы[СтрокаДерева.Имя].ПустаяСсылка();
				КонецЕсли;
			КонецЕсли;		
		КонецЕсли;
	Иначе
		Элементы.Источник.Видимость = Ложь; 
	КонецЕсли;
	ТипыИсточника = Элементы.Источник.ОграничениеТипа.Типы();
	Если ТипыИсточника.Количество() = 0 
		 И НЕ ЭтаФорма.Источник = Неопределено Тогда
		 МассивТипов = Новый Массив;
		 МассивТипов.Добавить(ТипЗнч(ЭтаФорма.Источник));
	     Элементы.Источник.ОграничениеТипа = Новый ОписаниеТипов(МассивТипов);
	КонецЕсли;	
	Если ЭтаФорма.Источник = Неопределено
		И НЕ ТипыИсточника.Количество() = 0 Тогда
		Для каждого Стр Из ТипыИсточника Цикл
			Если НЕ Стр = Тип("Null") Тогда
				ОбъектМетаданных = Метаданные.НайтиПоТипу(Стр);
				Если НЕ ОбъектМетаданных = Неопределено Тогда
					ПолноеИмяОбъекта    = ОбъектМетаданных.ПолноеИмя();
					ЭтаФорма.Источник = ПредопределенноеЗначение(ПолноеИмяОбъекта + ".ПустаяСсылка");		
					Прервать;
				КонецЕсли;				  
			КонецЕсли;
		КонецЦикла;		
	КонецЕсли;
	Элементы.Источник.ВыбиратьТип = Истина;
	
	ТипДокументаПриемник = "";
	ПараметрыОткрытия.Свойство("ТипДокументаПриемника", ТипДокументаПриемник);
	Если ЗначениеЗаполнено(ТипДокументаПриемник) Тогда
		
		Если ЭКОМ_ДеревоКонфигурации = Неопределено Тогда
			ЭКОМ_ДеревоКонфигурации = ОбработкаОбъект.Настройка_Параметр_Прочитать("СлужебныйДеревоКонфигурации", , "Служебный");
		КонецЕсли;
		
		Если НЕ ЭКОМ_ДеревоКонфигурации = Неопределено Тогда
			СтрокаДерева = ЭКОМ_ДеревоКонфигурации.Строки.Найти(ТипДокументаПриемник, "Синоним");
			Если НЕ СтрокаДерева = Неопределено Тогда
				ЭтаФорма.Приемник = Документы[СтрокаДерева.Имя].ПустаяСсылка();
			Иначе
				СтрокаДерева = ЭКОМ_ДеревоКонфигурации.Строки.Найти(ТипДокументаПриемник, "Имя");
				Если НЕ СтрокаДерева = Неопределено Тогда
					ЭтаФорма.Приемник = Документы[СтрокаДерева.Имя].ПустаяСсылка();
				КонецЕсли;			
			КонецЕсли;
		КонецЕсли;

	Иначе
		Элементы.Приемник.Видимость = Ложь;
	КонецЕсли;
	Если НЕ ЭтаФорма.Приемник = Неопределено Тогда
		 МассивТипов = Новый Массив;
		 МассивТипов.Добавить(ТипЗнч(ЭтаФорма.Приемник));
	     Элементы.Приемник.ОграничениеТипа = Новый ОписаниеТипов(МассивТипов);
	КонецЕсли;	
	Элементы.Приемник.ВыбиратьТип = Истина;
	
	ПараметрыОткрытия.Свойство("СправкаКФорме" , ЭтаФорма.Справка);	
	ПараметрыОткрытия.Свойство("ТекстНачальный", ЭтаФорма.ТекстНачальный);
	ПараметрыОткрытия.Свойство("Заголовок"     , ЭтаФорма.Заголовок);
    
    ДопПараметрыИзПараметровФормы = Неопределено;
    ПараметрыОткрытия.Свойство("ДопПараметры", ДопПараметрыИзПараметровФормы);
    ЭтаФорма.ДопПараметры = ЗначениеВСтрокуВнутр(ДопПараметрыИзПараметровФормы);
    
    ДопПараметрыСтрокой   = Неопределено;
    РежимСовместимости = Строка(Метаданные.РежимСовместимости); // Метаданные.СвойстваОбъектов.РежимСовместимости.Версия8_3_5
    ОшибкиВЗапросе = Ложь;
    Элементы.КомментарийКТекстуЗапроса.Видимость = ОшибкиВЗапросе;
			
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Элементы.Источник.ОграничениеТипа.СодержитТип(ТипЗнч(ЭтаФорма.Источник)) = Ложь Тогда
	     ЭтаФорма.Источник = Неопределено;
	КонецЕсли;

	ЭтаФорма.Заголовок = ЭтаФорма.Заголовок;
    ТекстДляПоляЗапроса = СтрЗаменить(ЭтаФорма.ТекстНачальный, "¶", Символы.ПС);
	ЭтаФорма.ПолеТекст.УстановитьТекст(ТекстДляПоляЗапроса);

КонецПроцедуры   

&НаСервере
Функция ПолучитьСтруктуруДопПараметрыЗакрытия()
    ДопПараметрыСтрокой = ЭтаФорма.ДопПараметры;
    Возврат ЗначениеИзСтрокиВнутр(ДопПараметрыСтрокой);
КонецФункции

#КонецОбласти


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

#Область ОбработчикиКомандФормы 

&НаКлиенте
Процедура КомментироватьУстановить(Команда)
	
	КомментироватьУстановитьСнять(Истина);

КонецПроцедуры

&НаКлиенте
Процедура КомментироватьСнять(Команда)
	
	КомментироватьУстановитьСнять(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура КомментироватьУстановитьСнять(УстановитьКомментарий)
	
	НачалоСтроки = 0;
	НачалоКолонки = 0;
	КонецСтроки = 0;
	КонецКолонки = 0;
	
	ТекстовыйДок = Новый ТекстовыйДокумент;
	Если ТекущийЭлемент.Имя = "ПолеЗапроса" Тогда
		Выделение = ПолучитьВыделение();
		НачалоСтроки = Выделение.Начало;
		КонецСтроки  = Выделение.Окончание;
		
		НачалоСтрокиСимвола = НачалоСтроки;
		КонецСтрокиСимвола = КонецСтроки;
		ПреобразуемВТекст = ЭтаФорма.ПолеЗапроса.ПолучитьТекст();
	Иначе
		ПреобразуемВТекст = ЭтаФорма.ПолеТекст.ПолучитьТекст();
		Элементы.ПолеТекст.ПолучитьГраницыВыделения(НачалоСтроки, НачалоКолонки, КонецСтроки, КонецКолонки);	
	КонецЕсли;	
	
	ТекстовыйДок = Новый ТекстовыйДокумент;
	ТекстовыйДок.УстановитьТекст(ПреобразуемВТекст);

	МассивСтрок = ИзСтрокиСРазделителямиИПозициямиСимвола(ПреобразуемВТекст, Символы.ПС);	
	Если ТекущийЭлемент.Имя = "ПолеТекст" Тогда
	     НачалоСтрокиСимвола = МассивСтрок[НачалоСтроки-1].ПозицияНачала;
		 Если МассивСтрок.Количество() > КонецСтроки-1 Тогда
		     КонецСтрокиСимвола  = МассивСтрок[КонецСтроки-1].ПозицияКонец;
		 Иначе	
		     КонецСтрокиСимвола  = МассивСтрок[МассивСтрок.Количество()-1].ПозицияКонец;
		 КонецЕсли;	 	
	КонецЕсли;
	
	Если НачалоСтрокиСимвола = 0 Тогда
		НачалоСтрокиСимвола = 1;
	КонецЕсли;
	Если КонецСтрокиСимвола = 0 Тогда
		КонецСтрокиСимвола = 1;
	КонецЕсли;

	Старт = Ложь;
	ПродолжитьОбработку = Ложь;
	Финиш = Ложь;
	
	Счетчик = 1;
	Для каждого Стр Из МассивСтрок Цикл
		
		Старт = НачалоСтрокиСимвола >= Стр.ПозицияНачала И НачалоСтрокиСимвола <= Стр.ПозицияКонец;
		Если Старт Тогда
			ПродолжитьОбработку = Истина;
		КонецЕсли;
		
		Если ПродолжитьОбработку Тогда
			
			ПредыдущийТекст = ТекстовыйДок.ПолучитьСтроку(Счетчик);
			Если УстановитьКомментарий Тогда
				НовСтрока = "//" + ПредыдущийТекст;
			Иначе
				Если Не Лев(ПредыдущийТекст,2) = "//" Тогда 
					Продолжить; 
				КонецЕсли; 
				
				НовСтрока = Сред(ПредыдущийТекст, 3, СтрДлина(ПредыдущийТекст));
			КонецЕсли;
			
			ТекстовыйДок.ЗаменитьСтроку(Счетчик, НовСтрока);		 
			
			Финиш = КонецСтрокиСимвола >= Стр.ПозицияНачала И КонецСтрокиСимвола <= Стр.ПозицияКонец;
			Если Финиш Тогда
				ПродолжитьОбработку = Ложь;	 
			КонецЕсли;
			
		КонецЕсли;
		
		Счетчик = Счетчик + 1;
	КонецЦикла;

	Если ТекущийЭлемент.Имя = "ПолеЗапроса" Тогда
		ЭтаФорма.ПолеЗапроса.УстановитьФорматированнуюСтроку(ПолучитьРаскрашенныйТекст(ТекстовыйДок.ПолучитьТекст()));
	    УстановитьВыделение(Выделение.Начало, Выделение.Окончание);
	Иначе			
		ЭтаФорма.ПолеТекст.УстановитьТекст(ТекстовыйДок.ПолучитьТекст());
		Элементы.ПолеТекст.УстановитьГраницыВыделения(НачалоСтроки, НачалоКолонки, КонецСтроки, КонецКолонки);
	КонецЕсли;
	
	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКонструкторЗапроса(Команда)
	
	Перем ОписаниеОповещения;

	//#Если НЕ ТолстыйКлиент И НЕ ТолстыйКлиентУправляемоеПриложение Тогда
	//	Сообщить("Конструктор запроса можно вызывать только в толстом клиенте");
	//	Возврат;
	//#КонецЕсли
		
	//БЛОК №1 - ИНИЦИАЛИЗАЦИЯ ПЕРЕМЕННЫХ
	Кавычка = """";
	ДвойнаяКавычка = """""";   
	ЗаменаДляДвойнойКавычки = Строка(Новый УникальныйИдентификатор);	
	КоличествоСтрок = ПолучитьСтрЧислоСтрокСервер(ЭтаФорма.ПолеЗапроса.ПолучитьТекст());  
	
	ЗакладкаНачалоТекста    = ЭтаФорма.ПолеЗапроса.ПолучитьЗакладкуПоПозиции(0);
	ЗакладкаКонецТекста     = ЭтаФорма.ПолеЗапроса.ПолучитьЗакладкуКонца();
		
	ЗакладкаНачалаВыделения = ЭтаФорма.ПолеЗапроса.ПолучитьЗакладкуНачала();
	ЗакладкаКонцаВыделения  = ЭтаФорма.ПолеЗапроса.ПолучитьЗакладкуКонца();
	Элементы.ПолеЗапроса.ПолучитьГраницыВыделения(ЗакладкаНачалаВыделения, ЗакладкаКонцаВыделения);
	//----------------------------------------------
		
	//БЛОК №2 - ОПРЕДЕЛЕНИЕ ТЕКСТА ДО КУРСОРА И ПОСЛЕ КУРСОРА
	Элементы.ПолеЗапроса.УстановитьГраницыВыделения(ЗакладкаНачалоТекста, ЗакладкаНачалаВыделения);
	ТекстДоКурсора = Элементы.ПолеЗапроса.ВыделенныйТекст;			
	Элементы.ПолеЗапроса.УстановитьГраницыВыделения(ЗакладкаКонцаВыделения, ЗакладкаКонецТекста);
	ТекстПослеКурсора = Элементы.ПолеЗапроса.ВыделенныйТекст;
	
	Элементы.ПолеЗапроса.УстановитьГраницыВыделения(ЗакладкаНачалаВыделения, ЗакладкаКонцаВыделения);	
	
	//гарантируем отсутствие в тексте двойных кавычек
	ТекстДоКурсора = СтрЗаменить(ТекстДоКурсора, ДвойнаяКавычка, ЗаменаДляДвойнойКавычки); 	
	//в тексте после курсора необходимо оставить первую кавычку, если сразу после нее идет двойная
	//случай подряд идущих кавычек в количестве более 5-ти штук обрабатывать не будем
	ТекстПослеКурсора =  СтрЗаменить(Лев(ТекстПослеКурсора, 1) + 
				СтрЗаменить(Сред(ТекстПослеКурсора, 2), ДвойнаяКавычка, ЗаменаДляДвойнойКавычки) , ДвойнаяКавычка, ЗаменаДляДвойнойКавычки) ; 
	//----------------------------------------------
	
	
	//БЛОК №3 - ИЩЕМ ПОЗИЦИЮ ОТКРВАЮЩЕЙ И ЗАКРЫВАЮЩЕЙ КАВЫЧКИ ДЛЯ СТРОКИ ЗАПРОСА
	
	ПозицияОткрывающейКавычки = 0;
	ПозицияЗакрывающейКавычки = 0;
		
	ВСтроке = Ложь;
	КавычкиЕсть = Ложь;
	ПозицияПредыдущейКавычки = 0;
	ПоизцияПоследнейКавычки = 0;	
	
	Позиция = 1;
	ДлинаТекстаДоКурсора = СтрДлина(ТекстДоКурсора);
	
	//ИЩЕМ ОТКРЫВАЮЩУЮ КАВЫЧКУ
	Пока Позиция <= ДлинаТекстаДоКурсора Цикл
		
		ТекущийСимвол = Сред(ТекстДоКурсора, Позиция, 1);
		
		ПредыдущийСимвол = " "; 
		Если Позиция > 1 Тогда
			ПредыдущийСимвол = Сред(ТекстДоКурсора, Позиция-1, 1);
		КонецЕсли;						
		
		Если ТекущийСимвол = Кавычка Тогда
			ВСтроке = НЕ ВСтроке;
			ПозицияПредыдущейКавычки = ПоизцияПоследнейКавычки;
			ПоизцияПоследнейКавычки = Позиция;
			КавычкиЕсть = Истина;
		КонецЕсли;
				
		//Обработка комментария - начало
		Если НЕ ВСтроке И ПредыдущийСимвол = "/" И ТекущийСимвол = "/" Тогда 
			//это комментарий, пропускаем символы до конца строки
			Пока ТекущийСимвол <> Символы.LF И ТекущийСимвол <> Символы.CR Цикл				
                Позиция = Позиция +1;
				Если Позиция > ДлинаТекстаДоКурсора Тогда
					Прервать;
				КонецЕсли;				
				ТекущийСимвол = Сред(ТекстДоКурсора, Позиция, 1);
			КонецЦикла;
			
			Продолжить; 
		КонецЕсли;
		//Обработка комментария - конец
			
		Позиция = Позиция + 1;				
	КонецЦикла;
	
	//ОСОБЫМ ОБРАЗОМ ОБРАБОТАЕМ СЛУЧАЙ НАХОЖДЕНИЯ КУРСОРА В 
	//ДВОЙНОЙ КАВЫЧКЕ ВНУТРИ СТРОКИ ЗАПРОСА
	Если НЕ ВСтроке И КавычкиЕсть И СтрДлина(ТекстПослеКурсора) > 0 Тогда
		Если  Сред(ТекстДоКурсора, ДлинаТекстаДоКурсора, 1) = Кавычка И Лев(ТекстПослеКурсора,1) = Кавычка Тогда
			ВСтроке = Истина;
			ПоизцияПоследнейКавычки = ПозицияПредыдущейКавычки;			
			ТекстДоКурсора = Лев(ТекстДоКурсора, ДлинаТекстаДоКурсора-1);
			ТекстПослеКурсора = ЗаменаДляДвойнойКавычки + Сред(ТекстПослеКурсора, 2);
		КонецЕсли;
	КонецЕсли;			
	
	//ЕСЛИ НАШИЛИ ОТКРЫВАЮЩУЮ КАВЫЧКУ, ТО ИЩЕМ ЗАКРЫВАЮЩУЮ
	Если ВСтроке Тогда
		ПозицияОткрывающейКавычки = ПоизцияПоследнейКавычки;
		ПозицияЗакрывающейКавычки = Найти(ТекстПослеКурсора, Кавычка);		
	КонецЕсли;
				
	//----------------------------------------------
		
	//БЛОК №4 - ОПРЕДЕЛЯЕМ ТЕКСТ ДО ЗАПРОСА, ТЕКСТ ЗАПРОСА И ТЕКСТ ПОСЛЕ ЗАПРОСА
	//ПОСЛЕ ЧЕГО ВОЗРАЩАЕМ ДВОЙНЫЕ КАВЫЧКИ В КОД, НЕ ЯВЛЯЮЩИЙСЯ ЧАСТЬЮ ЗАПРОСА
	
	Конструктор = Новый КонструкторЗапроса;
	ГраницыЗапросаНайдены = ПозицияОткрывающейКавычки <> 0 И ПозицияЗакрывающейКавычки <> 0;
		
	Если НЕ ГраницыЗапросаНайдены Тогда		
		Сообщение = "ЗАПРОС НЕ ОБНАРУЖЕН, БУДЕТ СОЗДАН НОВЫЙ ЗАПРОС";
		ПоказатьОповещениеПользователя(Сообщение, , Сообщение);
		ТекстДоНачалаЗапроса = ТекстДоКурсора + Кавычка;
		ТекстПослеКонцаЗапроса = Кавычка + ТекстПослеКурсора ;					
	Иначе
		
		ТекстДоНачалаЗапроса = Лев(ТекстДоКурсора, ПозицияОткрывающейКавычки);		
		ТекстПослеКонцаЗапроса = Сред(ТекстПослеКурсора, ПозицияЗакрывающейКавычки);		
		
		ТекстЗапросаССимвовамиВертикальнойЧерты = Сред(ТекстДоКурсора, ПозицияОткрывающейКавычки + 1) + Лев(ТекстПослеКурсора, ПозицияЗакрывающейКавычки -1);	
		//для конструктора запроса вместо двойной кавычки будем подставлять одинарную
		ТекстЗапросаССимвовамиВертикальнойЧерты = СтрЗаменить(ТекстЗапросаССимвовамиВертикальнойЧерты, ЗаменаДляДвойнойКавычки, Кавычка); 
		
		КоличествоСтрокВТексте = СтрЧислоСтрок(ТекстЗапросаССимвовамиВертикальнойЧерты);
		ТекстЗапроса = "";	
		Для К = 1 To КоличествоСтрокВТексте Цикл
			СтрокаИзТекстаЗапроса = СокрЛП(СтрПолучитьСтроку(ТекстЗапросаССимвовамиВертикальнойЧерты, К));
			Если Лев(СтрокаИзТекстаЗапроса, 1) = "|" Тогда
				//для конструктора запроса убираем вертикальную черту в начале строки
				СтрокаИзТекстаЗапроса = Сред(СтрокаИзТекстаЗапроса, 2); 
			КонецЕсли;
			                                            
			ТекстЗапроса = ТекстЗапроса + СтрокаИзТекстаЗапроса + Символы.LF;
		КонецЦикла;
		
		Конструктор.Текст = ТекстЗапроса;
	КонецЕсли;
		
	//возвращаем двойные кавычки
	ТекстДоНачалаЗапроса = СтрЗаменить(ТекстДоНачалаЗапроса, ЗаменаДляДвойнойКавычки, ДвойнаяКавычка); 
	ТекстПослеКонцаЗапроса = СтрЗаменить(ТекстПослеКонцаЗапроса, ЗаменаДляДвойнойКавычки, ДвойнаяКавычка); 
		
	
	//БЛОК №5 - ОТКРЫВАЕМ КОНСТРУКТОР ЗАПРОСА С ПОЛУЧЕННОЙ СТРОКОЙ ЗАПРОСА И В СЛУЧАЕ УСПЕШНОГО
	//РЕЗУЛЬТАТА ВЫЧИСЛЯЕМ ОТСТУП, КОТОРЫЙ БУДЕМ ДОБАВЛЯТЬ К КАЖДОЙ СТРОКЕ ЗАПРОСА	
	
	#Если ТолстыйКлиентУправляемоеПриложение Тогда
		Попытка
			Если НЕ Конструктор.ОткрытьМодально() Тогда
				Возврат;
			КонецЕсли;	
		Исключение
			Сообщить(ОписаниеОшибки());
		КонецПопытки;
	#КонецЕсли
	
	ТекстЗапроса = Конструктор.Текст;	
	Если ПустаяСтрока(ТекстЗапроса) Тогда
		Возврат;
	КонецЕсли;
	
	ДлинаТекстаДоНачалаЗапроса = СтрДлина(ТекстДоНачалаЗапроса);
	Позиция = ДлинаТекстаДоНачалаЗапроса-1; 

	Пока Позиция >= 1 Цикл		
		Если Сред(ТекстДоНачалаЗапроса, Позиция, 1) = Символы.LF Тогда			
			Прервать;
		КонецЕсли;		
		Позиция = Позиция - 1;
	КонецЦикла;
	                     
	СтрокаОтступа = Сред(ТекстДоНачалаЗапроса, Позиция+1, ДлинаТекстаДоНачалаЗапроса - Позиция -1);
	ДлинаСтрокиОтступа = СтрДлина(СтрокаОтступа);
	СтрокаОтступаИзПробеловИТабуляций = "";
	

	Для К = 1 To ДлинаСтрокиОтступа Цикл
		Если Сред(СтрокаОтступа, К, 1) = Символы.Tab Тогда
			СтрокаОтступаИзПробеловИТабуляций = СтрокаОтступаИзПробеловИТабуляций + Символы.Tab;
		Иначе 
			СтрокаОтступаИзПробеловИТабуляций = СтрокаОтступаИзПробеловИТабуляций + " ";
		КонецЕсли;
	КонецЦикла;	

	Дополнительно = Новый Структура;
    Дополнительно.Вставить("Кавычка", Кавычка);
	Дополнительно.Вставить("ДвойнаяКавычка", ДвойнаяКавычка);
	Дополнительно.Вставить("СтрокаОтступаИзПробеловИТабуляций", СтрокаОтступаИзПробеловИТабуляций);
	Дополнительно.Вставить("ТекстДоНачалаЗапроса", ТекстДоНачалаЗапроса);
	Дополнительно.Вставить("ТекстПослеКонцаЗапроса", ТекстПослеКонцаЗапроса);
	
	#Если ТолстыйКлиентУправляемоеПриложение Тогда
    СконструированЗапрос(ТекстЗапроса, Дополнительно);
	Возврат;
	#КонецЕсли

	// Для тонкого клиента
	Попытка	
		Выполнить("ОписаниеОповещения = Новый ОписаниеОповещения(""СконструированЗапрос"", ЭтаФорма, Дополнительно)");
		// попытаемся создать конструктор для 8.3.5
		Конструктор = Неопределено;
		Если ЗначениеЗаполнено(ТекстЗапроса) Тогда
			Выполнить("Конструктор = Новый КонструкторЗапроса(ТекстЗапроса);");
		Иначе
			Выполнить("Конструктор = Новый КонструкторЗапроса();");
		КонецЕсли;
		Выполнить("Конструктор.Показать(ОписаниеОповещения)");
		Возврат;
	Исключение
		Ошибка = ОписаниеОшибки();
		Если Найти(Ошибка,"Тип не определен")>0 Тогда
			ПоказатьОповещениеПользователя("Конструктор",,"Конструктор запроса для тонкого клиента доступен с версии 8.3.5!");
		Иначе
			Сообщить(Ошибка);
		КонецЕсли;
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)
    ВызватьПроверку(Ложь, Истина);
КонецПроцедуры

&НаКлиенте
Процедура КомандаОК(Команда)
	
	ЗакрытьПослеПроверки = Истина;	
	Записать = Истина;

    ВызватьПроверку(ЗакрытьПослеПроверки, Записать);
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьТекстЗапроса(Команда)
	
	Если ТекущийЭлемент.Имя = "ПолеЗапроса" Тогда
		Если НЕ ПустаяСтрока(Элементы.ПолеЗапроса) Тогда 
			ЭтаФорма.ПолеЗапроса.Удалить();
			Модифицированность 	= Истина;
		КонецЕсли;				
	Иначе
		Если НЕ ПустаяСтрока(Элементы.ПолеТекст) Тогда 
			ЭтаФорма.ПолеТекст.Очистить();
			Модифицированность 	= Истина;
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Проверить(Команда)
	
    ОчиститьСообщения();
	ВызватьПроверку();
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");	
	ОбъектТЗ = РеквизитФормыВЗначение("ТабличноеПоле");
	
	МассивЛогаСобытий = Новый Массив;
	Результат = ОбработкаОбъект.ПроверитьФормулу(ЭтаФорма.ПолеТекст.ПолучитьТекст(), МассивЛогаСобытий, ЭтаФорма.Источник, НомерИсправленияНаФорме, ЭтаФорма.Приемник);
	Если МассивЛогаСобытий.Количество() > 0  Тогда
		ТекстОшибки = ЭКОМ_ОбщегоНазначения.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекстОшибки)
		И ТипЗнч(Результат) = Тип("ТаблицаЗначений") Тогда
		
		Если Результат.Количество() = 0 Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Результат неопределен!";
			Сообщение.Сообщить();
		КонецЕсли;
		
		МассивРеквизитов = Новый Массив;
		
		// Количесвто строк
		Результат.Колонки.Добавить("НомерПоПорядку");
		НомерПоПорядку = 1;
		Для Каждого Стр Из Результат Цикл
			Стр.НомерПоПорядку = НомерПоПорядку;
			НомерПоПорядку = НомерПоПорядку + 1;	       
		КонецЦикла;
		
		//Удалим ранее созданные колонки в ТЗ    
		Для Каждого Колонка Из ОбъектТЗ.Колонки Цикл
			Если НЕ Колонка.Имя = "НомерПоПорядку" Тогда
				МассивРеквизитов.Добавить("ТабличноеПоле." + Колонка.Имя); 
			КонецЕсли;		       
		КонецЦикла;
		ИзменитьРеквизиты( , МассивРеквизитов);
		
		//Создадим реквизиты ТЗ
		МассивРеквизитов.Очистить();
		Для Каждого Колонка ИЗ Результат.Колонки Цикл
			Если НЕ Колонка.Имя = "НомерПоПорядку" Тогда
				МассивТипов = Новый Массив;
				МассивТипов.Добавить(Колонка.ТипЗначения);
				НоваяКолонка = Новый РеквизитФормы(Колонка.Имя, Новый ОписаниеТипов(МассивТипов), "ТабличноеПоле");
				МассивРеквизитов.Добавить(НоваяКолонка);			
			КонецЕсли;
		КонецЦикла;      
		ИзменитьРеквизиты(МассивРеквизитов);  
		ЗначениеВРеквизитФормы(Результат, "ТабличноеПоле");
		
		//Создаем элементы на форме для отображения колонок
		ЭлементТЗ = Элементы.ТабличноеПоле;
		Для Каждого Колонка ИЗ Результат.Колонки Цикл
			Если НЕ Колонка.Имя = "НомерПоПорядку" Тогда
				Если Элементы.Найти("ТабличноеПоле" + Колонка.Имя) = Неопределено Тогда
					НовыйЭлементФормы = Элементы.Добавить("ТабличноеПоле" + Колонка.Имя, Тип("ПолеФормы"), ЭлементТЗ);
					НовыйЭлементФормы.Вид = ВидПоляФормы.ПолеВвода;
					НовыйЭлементФормы.ПутьКДанным = "ТабличноеПоле." + Колонка.Имя;
					НовыйЭлементФормы.ВыбиратьТип = Ложь;
				КонецЕсли;
			КонецЕсли;		
        КонецЦикла;	
        ОшибкиВЗапросе = Ложь;
	Иначе
        ОшибкиВЗапросе = Истина;
        Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "ОШИБКА: " + ТекстОшибки + Символы.ПС +
		                  "Результат = " + Строка(Результат) + "(Тип - " + ТипЗнч(Результат) + ")";
		Сообщение.Сообщить();
	КонецЕсли;
    ВывестиИнформациюОбОшибке(ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти


////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

#Область СлужебныеПроцедурыИФункции
&НаСервере
Функция УстановитьПараметрДинамическогоСписка(ИмяПараметра, МассивЛогаСобытий)
	
	ИмяСобытия = "Установить параметры";
    Попытка //попытка нужна чтобы предприятие не закрывалось при ошибке
        Если ДинамическийСписокДляТестирования.Параметры.Элементы.Найти(ИмяПараметра) = Неопределено Тогда //проверка на существование параметра запроса
            Возврат Ложь;
	    КонецЕсли;
    Исключение
		ТекстЛогаСобытий = "Ошибка в процессе отображения запроса как динамического списка в консоли кода на вкладке Тестирование: " + ОписаниеОшибки();
		ЗаписьСтруктурыЛога = ЭКОМ_ОбщегоНазначения.ЗаполненнаяЗаписьЛога(ТекстЛогаСобытий, Перечисления.ЭКОМ_УровниЛогирования.Ошибка, ИмяСобытия);
		МассивЛогаСобытий.Добавить(ЗаписьСтруктурыЛога);

		Возврат Ложь;
    КонецПопытки;
    
    Если ИмяПараметра = "масПомеченныхДоков" Тогда
        ЗначениеПараметра = Новый Массив;
    ИначеЕсли ИмяПараметра = "ДатаНач" Тогда
        ЗначениеПараметра = ДатаНач;
    ИначеЕсли ИмяПараметра = "ДатаКон" Тогда
        ЗначениеПараметра = ДатаКон;
	ИначеЕсли ИмяПараметра = "НаправлениеОбмена" Тогда
		ЗначениеПараметра = Перечисления.ЭКОМ_НаправлениеОбмена.ПустаяСсылка();
    КонецЕсли;
        
    ДинамическийСписокДляТестирования.Параметры.УстановитьЗначениеПараметра(ИмяПараметра, ЗначениеПараметра);
    Возврат Истина;
КонецФункции
&НаСервере
Процедура СформироватьДинаминическийСписокДляТестированияНаОснованииТекстаЗапроса(РезультатПроверки)
    Попытка
	    Запрос = Новый Запрос;
	    Запрос.Текст = РезультатПроверки.ТекстЗапроса;
	    Запрос.НайтиПараметры();
    Исключение
	    Возврат;
    КонецПопытки;    
    ДинамическийСписокДляТестирования.ТекстЗапроса  = РезультатПроверки.ТекстЗапроса;
    
    КорректностьДатНаФорме();
	
	МассивЛогаСобытий = Новый Массив;
	УстановитьПараметрДинамическогоСписка("НаправлениеОбмена", МассивЛогаСобытий);
    УстановитьПараметрДинамическогоСписка("масПомеченныхДоков", МассивЛогаСобытий);
    УстановитьПараметрДинамическогоСписка("ДатаНач", МассивЛогаСобытий);
    УстановитьПараметрДинамическогоСписка("ДатаКон", МассивЛогаСобытий);
	    
    ИмяДинамическогоСписка = "ДинамическийСписокДляТестирования";
    
    Колонки = РезультатПроверки.Колонки;
    
    Для Каждого ИмяКолонки Из Колонки Цикл
        
        ЭлементыСписка = Элементы.Найти(ИмяДинамическогоСписка + ИмяКолонки); 				
        Если ЭлементыСписка = Неопределено	 Тогда
            НоваяКолонкаТаблицы = Элементы.Добавить(ИмяДинамическогоСписка + ИмяКолонки, Тип("ПолеФормы"), Элементы[ИмяДинамическогоСписка]);
            НоваяКолонкаТаблицы.Заголовок = ИмяКолонки;
            НоваяКолонкаТаблицы.ПутьКДанным = ИмяДинамическогоСписка + "." + ИмяКолонки;							
        КонецЕсли;
    КонецЦикла;
	
	Если МассивЛогаСобытий.Количество() > 0  Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ЭКОМ_ОбщегоНазначения.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий);
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	ФормаДляОповещения = Неопределено;
	Если ТипЗнч(Параметр) = Тип("Структура") Тогда
	     Параметр.Свойство("ФормаДляОповещения", ФормаДляОповещения);
	КонецЕсли;
	
	Если ФормаДляОповещения = "Обработка.УФ_ФормаКонсольЗапросов" Тогда
		
		Если ИмяСобытия = "ЭКОМ_КонецПроверкиФормулыНаФорме" Тогда
			ПроверкаКодаНаФормеАРМЗавершение(Параметр);
		КонецЕсли;

	КонецЕсли;
	    
КонецПроцедуры

&НаКлиенте
Процедура ПроверкаКодаНаФормеАРМЗавершение(Параметры)
    
    ЗакрытьПослеПроверки = Параметры.ЗакрытьПослеПроверки;
    
    Результат = Неопределено;
    Если Параметры.Свойство("Результат", Результат) Тогда
        Если ТипЗнч(Результат) = Тип("Структура") Тогда
            СформироватьДинаминическийСписокДляТестированияНаОснованииТекстаЗапроса(Результат);
        КонецЕсли;
    КонецЕсли;

    ЗакрытьПослеПроверки = Ложь;
    Если Параметры.Свойство("ЗакрытьПослеПроверки", ЗакрытьПослеПроверки) = Ложь Тогда
        ЗакрытьПослеПроверки = Ложь;
    КонецЕсли;
    
    Результат = Новый Структура;
    
    Результат.Вставить("Текст", Параметры.Текст);
    КодИзменен = КодОбновленПроверкой(Параметры.Текст);
    
    Результат.Вставить("Изменен", КодИзменен);
    Результат.Вставить("Колонки", Параметры.Результат.Колонки);
    
    Результат.Вставить("ДопПараметры", ПолучитьСтруктуруДопПараметрыЗакрытия());
    Если ЗакрытьПослеПроверки = Истина Тогда
        Закрыть(Результат);
    Иначе
		Если Параметры.Записать = Истина Тогда
	        Результат.Вставить("ФормаДляОповещения", "Обработка.УФ_ФормаНастройкиОсновные");
            Оповестить("ОбработкаЗакрытия", Результат);
        КонецЕсли;
    КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЕстьОператорыЯзыкаЗапросов(ТекстДляПроверки)
    Перем Результат;
    
    Результат = Ложь;
    
    ТекстДляПроверкиВРег = ВРег(ТекстДляПроверки);
    
    Если Найти(ТекстДляПроверкиВРег, "ВЫБРАТЬ ") > 0
     Или Найти(ТекстДляПроверкиВРег, "ИЗ ") > 0
     Или Найти(ТекстДляПроверкиВРег, "ПОМЕСТИТЬ ") > 0
     Или Найти(ТекстДляПроверкиВРег, "ВЫБОР ") > 0
     Или Найти(ТекстДляПроверкиВРег, "ЛЕВОЕ СОЕДИНЕНИЕ ") > 0
     Или Найти(ТекстДляПроверкиВРег, "ВНУТРЕННЕЕ СОЕДИНЕНИЕ ") > 0
     Или Найти(ТекстДляПроверкиВРег, "ВНЕШНЕЕ СОЕДИНЕНИЕ ") > 0
     Или Найти(ТекстДляПроверкиВРег, "СГРУППИРОВАТЬ ПО ") > 0
     Или Найти(ТекстДляПроверкиВРег, " ЕСТЬ NULL ") > 0
     Или Найти(ТекстДляПроверкиВРег, " ЕСТЬNULL(") > 0
     Или Найти(ТекстДляПроверкиВРег, "|ТОГДА ") > 0
     Или Найти(ТекстДляПроверкиВРег, " ТОГДА ") > 0
     Или Найти(ТекстДляПроверкиВРег, " КАК ") > 0
     Или Найти(ТекстДляПроверкиВРег, "НАЧАЛОПЕРИОДА(") > 0  
        Тогда
        Результат = Истина;
    КонецЕсли;
    
    Возврат Результат;
КонецФункции
&НаСервере
Функция ВернутьКодДляВыполнить(ТекстЗапроса = Неопределено)
    Если ТекстЗапроса = Неопределено Тогда
        ТекстЗапроса = ЭтаФорма.ПолеТекст.ПолучитьТекст();
    КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, Символы.НПП, " ");
	
	// Не нужно менять запрос
	Если ЭтаФорма.ИмяЭлементаФормы = "АвтоОбмен"
		ИЛИ ЭтаФорма.ИмяЭлементаФормы = "ПодпискаДляДокументовСеть"
		ИЛИ ЭтаФорма.ИмяЭлементаФормы = "ПодпискаДляДокументовПоставщик"
		ИЛИ ЭтаФорма.ИмяЭлементаФормы = "ПодпискаДляДокументовЭТРН" 
		ИЛИ Найти(ЭтаФорма.ИмяЭлементаФормы, "СтруктураФайлаXML") > 0 Тогда
		Возврат ТекстЗапроса;
	КонецЕсли;

    НРегТекстЗапроса = НРег(ТекстЗапроса);
    ЕстьТекстЗапроса = Найти(НРегТекстЗапроса, ".текст =") > 0 Или Найти(НРегТекстЗапроса, ".текст=") > 0 Или Найти(НРегТекстЗапроса, "текстзапроса =") > 0  Или Найти(НРегТекстЗапроса, "текстзапроса=") > 0;
    
    Если ЕстьТекстЗапроса Тогда
        Возврат ТекстЗапроса; //это уже готовый код
    ИначеЕсли ЕстьТекстЗапроса = Ложь И ЕстьОператорыЯзыкаЗапросов(ТекстЗапроса) Тогда //нужно преобразовывать это чистый текст запроса
        //просто идти дальше
    Иначе
        Возврат ТекстЗапроса;
    КонецЕсли;
    
	//одинарные кавычки надо заменить на двойные
	Строка2Кавычки = Символ(34) + Символ(34);
	Строка1Кавычка = Символ(34);
    Результат	=	СтрЗаменить(ТекстЗапроса,Строка1Кавычка,Строка2Кавычки);
	
	//открывающие и закрывающие 
	Результат = Символ(34) + Результат + Символ(34) + ";";
	
	
	ТекстДок = Новый ТекстовыйДокумент; 
	ТекстДок.УстановитьТекст(Результат);
	
	Для сч = 2 по ТекстДок.КоличествоСтрок() Цикл
		Строка = ТекстДок.ПолучитьСтроку(сч);
		ТекстДок.ЗаменитьСтроку(сч,"|"+Строка);
	КонецЦикла;  
    
    Результат = "ТекстЗапроса =  " + Символы.ПС + ТекстДок.ПолучитьТекст();
    
    Возврат Результат;
КонецФункции

&НаКлиенте
Функция КодОбновленПроверкой(КодПослеПроверки = Неопределено)
	
	КодДляВыполнить = ВернутьКодДляВыполнить();
    КодИзменен = НЕ (ЭтаФорма.ТекстНачальный = КодДляВыполнить);    
	Если КодИзменен Тогда
		ЭтаФорма.ПолеТекст.УстановитьТекст(КодДляВыполнить);
        //ЭтаФорма.ПолеЗапроса.УстановитьФорматированнуюСтроку(ПолучитьРаскрашенныйТекст(КодДляВыполнить)); 
    КонецЕсли;
    
    Возврат КодИзменен;
	
КонецФункции

&НаКлиенте
Функция НачатьПроверкуФормулыНаФорме(ЗакрытьПослеПроверки = Ложь, Записать = Ложь)
    
    ТекстКода = ВернутьКодДляВыполнить();
	
	МассивЛогаСобытий = Новый Массив;	
	
	ПараметрыПроверки = Новый Структура;
	ПараметрыПроверки.Вставить("Текст"           , ТекстКода);
	ПараметрыПроверки.Вставить("ИмяЭлементаФормы", ИмяЭлементаФормы);
	ПараметрыПроверки.Вставить("МассивЛогаСобытий"   , МассивЛогаСобытий);
	ПараметрыПроверки.Вставить("ЗакрытьПослеПроверки", ЗакрытьПослеПроверки);
	ПараметрыПроверки.Вставить("Записать"            , Записать);
	ПараметрыПроверки.Вставить("ФормаДляОповещения"  , "Обработка.УФ_Форма");
	
	ПараметрыПроверки.Вставить("ЭКОМ_ОбменCondra"    , ЭтаФорма.ЭКОМ_ОбменCondra);
	ПараметрыПроверки.Вставить("ЭКОМ_ОбменПоставщик" , ЭтаФорма.ЭКОМ_ОбменПоставщик);
	ПараметрыПроверки.Вставить("ЭКОМ_ОбменСеть"      , ЭтаФорма.ЭКОМ_ОбменСеть);
	ПараметрыПроверки.Вставить("ЭКОМ_ОбменЭТРН"      , ЭтаФорма.ЭКОМ_ОбменЭТРН);
	
    Оповестить("ЭКОМ_ПроверитьФормулуНаФорме", ПараметрыПроверки);
    
КонецФункции

&НаКлиенте
Функция ВызватьПроверку(ЗакрытьПослеПроверки = Ложь, Записать = Ложь)
    
    ПроверятьНаФорме = ?(ИмяЭлементаФормы = "ГруппаПоставщик" 
	                     ИЛИ ИмяЭлементаФормы = "ГруппаПокупатель"
						 ИЛИ ИмяЭлементаФормы = "ГруппаЭТРН"
						 ИЛИ ИмяЭлементаФормы = "ГруппаПрайсЛист"
						 ИЛИ ИмяЭлементаФормы = "ГруппаCondra", Истина, Ложь); //этот реквизит передается при вызове формы по нему определяю это код для запроса динамического списка на основной форме АРМа или код вычисляемый в модуле обработки
    
    Если ПроверятьНаФорме = Истина Тогда
        НачатьПроверкуФормулыНаФорме(ЗакрытьПослеПроверки, Записать);
    Иначе
        ЗначениеРезультат = ПроверитьФормулуНаСервере();
        
        Если Записать = Истина Тогда
            Результат = Новый Структура;
            Результат.Вставить("Текст",   ВернутьКодДляВыполнить());
            Результат.Вставить("Изменен", НЕ ЭтаФорма.ТекстНачальный = ЭтаФорма.ПолеТекст.ПолучитьТекст());
            
            локДопПараметры = ПолучитьСтруктуруДопПараметрыЗакрытия();
            Результат.Вставить("ДопПараметры", локДопПараметры);
            Результат.Вставить("Значение"    , ЗначениеРезультат);
            
			Если локДопПараметры <> Неопределено Тогда
	            Результат.Вставить("ФормаДляОповещения", "Обработка.УФ_ФормаНастройкиОсновные");
                Оповестить("ОбработкаЗакрытия", Результат);
				ЭтаФорма.ТекстНачальный = Результат.Текст;
            КонецЕсли;
        КонецЕсли;
        
        Если ЗакрытьПослеПроверки = Истина Тогда
            ЭтаФорма.Закрыть();
        КонецЕсли;
    КонецЕсли;    
    
КонецФункции



// Функция проверяет корректность введенной формулы и возвращает результат ее выполнения.
//
// Параметры:
//  Текст – Строка - текст на встроенном языке 1С
//  Отказ – Булево - признак прерывания выполнения обработки
//
// Возвращаемое значение:
//   ТаблицаЗначений   - результат выполнения кода
&НаСервере
Функция ПроверитьФормулуНаСервере() Экспорт
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект"); 
    МассивЛогаСобытий = Новый Массив;
    Код = ЭтаФорма.ПолеТекст.ПолучитьТекст();
	
	// Не нужно проверять
	Если ЭтаФорма.ИмяЭлементаФормы = "ПодпискаДляДокументовСеть"
		 ИЛИ ЭтаФорма.ИмяЭлементаФормы = "ПодпискаДляДокументовПоставщик"
		 ИЛИ ЭтаФорма.ИмяЭлементаФормы = "ПодпискаДляДокументовCondra"    
		 ИЛИ ЭтаФорма.ИмяЭлементаФормы = "ПодпискаДляДокументовПрайсЛист"
		 ИЛИ ЭтаФорма.ИмяЭлементаФормы = "ПодпискаДляДокументовЭТРН" Тогда
		Значение = Неопределено;
	Иначе
		// Входящие
		Если Найти(ЭтаФорма.ИмяЭлементаФормы, "Входящие") > 0 Тогда
			ПриемникОбъект = Документы.ЭКОМ_Документы.СоздатьДокумент();
			ПриемникОбъект.НеЗагружатьДокумент = Истина;
		    Значение = ОбработкаОбъект.ПроверитьФормулу(Код, МассивЛогаСобытий, Неопределено, "", ПриемникОбъект);
			
		// Исходящие	
		ИначеЕсли Найти(ЭтаФорма.ИмяЭлементаФормы, "Исходящие") > 0 Тогда
	        Значение = ОбработкаОбъект.ПроверитьФормулу(Код, МассивЛогаСобытий, ЭтаФорма.Источник, ЭтаФорма.НомерИсправленияНаФорме, ЭтаФорма.Приемник);
			
		// Документы
		ИначеЕсли Найти(ЭтаФорма.ИмяЭлементаФормы, "Документы") > 0 Тогда
            Значение = Неопределено;
			
		Иначе
			Значение = ОбработкаОбъект.ПроверитьФормулу(Код, МассивЛогаСобытий, ЭтаФорма.Источник, ЭтаФорма.НомерИсправленияНаФорме, ЭтаФорма.Приемник);
			
		КонецЕсли;							
	КонецЕсли;

   	Если МассивЛогаСобытий.Количество() > 0  Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ЭКОМ_ОбщегоНазначения.ПолучитьТекстовыйЛогСобытий(МассивЛогаСобытий);
		Сообщение.Сообщить();
	КонецЕсли;
    
    Если ТипЗнч(Значение) = Тип("ТаблицаЗначений") Тогда
		
		Сообщить("Количество строк в таблице результата: " + Строка(Значение.Количество()));
        Элементы.ТабличноеПоле.Видимость = Истина;
		
		ОбъектТЗ = РеквизитФормыВЗначение("ТабличноеПоле");
		МассивРеквизитов = Новый Массив;
		
		// Количесвто строк
		Значение.Колонки.Добавить("НомерПоПорядку");
		НомерПоПорядку = 1;
		Для Каждого Стр Из Значение Цикл
			Стр.НомерПоПорядку = НомерПоПорядку;
			НомерПоПорядку = НомерПоПорядку + 1;	       
		КонецЦикла;
		
		// Удалим ранее созданные колонки в ТЗ    
		Для Каждого Колонка Из ОбъектТЗ.Колонки Цикл
			Если НЕ Колонка.Имя = "НомерПоПорядку" Тогда
				МассивРеквизитов.Добавить("ТабличноеПоле." + Колонка.Имя); 
			КонецЕсли;		       
		КонецЦикла;
		ИзменитьРеквизиты( , МассивРеквизитов);
		
		// Сортируем 
		СписокКолонок = Новый СписокЗначений;
		Для Каждого Колонка ИЗ Значение.Колонки Цикл
			СписокКолонок.Добавить(Колонка.ТипЗначения, Колонка.Имя);
		КонецЦикла;
		СписокКолонок.СортироватьПоПредставлению();
		
		// Создадим реквизиты ТЗ
		МассивРеквизитов.Очистить();
		Для Каждого Колонка ИЗ СписокКолонок Цикл
			Если НЕ Колонка.Представление = "НомерПоПорядку" Тогда
				МассивТипов = Новый Массив;
				МассивТипов.Добавить(Колонка.Значение);
				НоваяКолонка = Новый РеквизитФормы(Колонка.Представление, Новый ОписаниеТипов(МассивТипов), "ТабличноеПоле");
				МассивРеквизитов.Добавить(НоваяКолонка);			
			КонецЕсли;
		КонецЦикла;      
		ИзменитьРеквизиты(МассивРеквизитов);  
		ЗначениеВРеквизитФормы(Значение, "ТабличноеПоле");
		
		// Создаем элементы на форме для отображения колонок
		ЭлементТЗ = Элементы.ТабличноеПоле;
		Для Каждого Колонка ИЗ СписокКолонок Цикл
			Если НЕ Колонка.Представление = "НомерПоПорядку" Тогда
				Если Элементы.Найти("ТабличноеПоле" + Колонка.Представление) = Неопределено Тогда
					НовыйЭлементФормы = Элементы.Добавить("ТабличноеПоле" + Колонка.Представление, Тип("ПолеФормы"), ЭлементТЗ);
					НовыйЭлементФормы.Вид = ВидПоляФормы.ПолеВвода;
					НовыйЭлементФормы.ПутьКДанным = "ТабличноеПоле." + Колонка.Представление;
					НовыйЭлементФормы.ВыбиратьТип = Ложь;
				КонецЕсли;
			КонецЕсли;		
		КонецЦикла;		
		
    Иначе
        Элементы.ТабличноеПоле.Видимость = Ложь;
    КонецЕсли;
    
	Если Найти(НРег(Код), "возврат ") > 0 Тогда
		Инфо = ?(Значение = Неопределено, "Возвращено значение Неопределено", "Возвращено: [" + Строка(Значение) + "], тип " + Строка(ТипЗнч(Значение)));
		Сообщить(Инфо);	 
	КонецЕсли;
	    
 	ИтоговоеЗначение = Новый Массив;
	Если НЕ Значение = Неопределено Тогда  
		// Преобразование типа ТаблицаЗначений		
		
		Если ТипЗнч(Значение) = Тип("ТаблицаЗначений") Тогда
			Для каждого ЭлКолнки Из Значение.Колонки Цикл
				СтрокаТЧ = Новый Структура;
				СтрокаТЧ.Вставить("КолонкаКлюч", СокрЛП(ЭлКолнки.Имя));
				ИтоговоеЗначение.Добавить(СтрокаТЧ);
			КонецЦикла;
		КонецЕсли;		
	КонецЕсли;
    
	Возврат ИтоговоеЗначение;
	
КонецФункции

&НаКлиенте
Процедура СконструированЗапрос(ТекстЗапроса, Дополнительно) Экспорт
	
	Если ТекстЗапроса = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	//БЛОК №6 - ОБРАБАТЫВАЕМ РЕЗУЛЬТАТ, ЗАМЕНЯЕМ ОДИНАРНЫЕ КАВЫЧКИ НА ДВОЙНЫЕ, 
	//ДОБАВЛЯЕМ ОТСТУП И ВЕРТИКАЛЬНУЮ ЧЕРТУ СТРОКАМ ЗАПРОСА НАЧИНАЯ СО ВТОРОЙ	
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, Дополнительно.Кавычка, Дополнительно.ДвойнаяКавычка); 		
	КоличествоСтрокВТексте = СтрЧислоСтрок(ТекстЗапроса);	
	ТекстЗапросаССимвовамиВертикальнойЧерты = СтрПолучитьСтроку(ТекстЗапроса, 1);
	
	Для К = 2 To КоличествоСтрокВТексте Цикл
		ТекстЗапросаССимвовамиВертикальнойЧерты = ТекстЗапросаССимвовамиВертикальнойЧерты + Символы.LF 
		+ Дополнительно.СтрокаОтступаИзПробеловИТабуляций + "|" + СтрПолучитьСтроку(ТекстЗапроса, К);
	КонецЦикла;
	
	//ЗАГРУЖАЕМ НОВЫЙ КОД В ТЕКСТОВОЕ ПОЛЕ И УСТАНАВЛИВАЕМ КУРСОР НА ПРЕЖНЮЮ ПОЗИЦИЮ
	ИтоговыйКод = Дополнительно.ТекстДоНачалаЗапроса + ТекстЗапросаССимвовамиВертикальнойЧерты + Дополнительно.ТекстПослеКонцаЗапроса;
	ЭтаФорма.ПолеЗапроса.УстановитьФорматированнуюСтроку(ПолучитьРаскрашенныйТекст(ИтоговыйКод));
		
КонецПроцедуры

&НаКлиенте
Процедура СконструированЗапросТекст(ТекстЗапроса, Дополнительно) Экспорт
	
	Если ТекстЗапроса = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	//БЛОК №6 - ОБРАБАТЫВАЕМ РЕЗУЛЬТАТ, ЗАМЕНЯЕМ ОДИНАРНЫЕ КАВЫЧКИ НА ДВОЙНЫЕ, 
	//ДОБАВЛЯЕМ ОТСТУП И ВЕРТИКАЛЬНУЮ ЧЕРТУ СТРОКАМ ЗАПРОСА НАЧИНАЯ СО ВТОРОЙ	
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, Дополнительно.Кавычка, Дополнительно.ДвойнаяКавычка); 		
	КоличествоСтрокВТексте = СтрЧислоСтрок(ТекстЗапроса);	
	ТекстЗапросаССимвовамиВертикальнойЧерты = СтрПолучитьСтроку(ТекстЗапроса, 1);
	
	Для К = 2 To КоличествоСтрокВТексте Цикл
		ТекстЗапросаССимвовамиВертикальнойЧерты = ТекстЗапросаССимвовамиВертикальнойЧерты + Символы.LF 
		+ Дополнительно.СтрокаОтступаИзПробеловИТабуляций + "|" + СтрПолучитьСтроку(ТекстЗапроса, К);
	КонецЦикла;
	
	//ЗАГРУЖАЕМ НОВЫЙ КОД В ТЕКСТОВОЕ ПОЛЕ И УСТАНАВЛИВАЕМ КУРСОР НА ПРЕЖНЮЮ ПОЗИЦИЮ
	ИтоговыйКод = Дополнительно.ТекстДоНачалаЗапроса + ТекстЗапросаССимвовамиВертикальнойЧерты + Дополнительно.ТекстПослеКонцаЗапроса;
	ЭтаФорма.ПолеТекст.УстановитьТекст(ИтоговыйКод);	
		
КонецПроцедуры

