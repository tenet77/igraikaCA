&НаСервереБезКонтекста
Функция РазбитьСтрокуВМассивПодстрок(Знач Строка, Разделитель = ".", УдалятьРазделитель = Истина)

	Массив = Новый Массив;
	
	ПозицияРазделителя = Найти(Строка, Разделитель);
    
    ДлинаРазделителя = ?(УдалятьРазделитель = Истина, СтрДлина(Разделитель), -1);
    ДлинаРазделителяДляУдаления = СтрДлина(Разделитель);
    Пока ПозицияРазделителя > 0 Цикл
		Массив.Добавить(Лев(Строка, ПозицияРазделителя - ДлинаРазделителя));
		Строка = Сред(Строка, ПозицияРазделителя + ДлинаРазделителяДляУдаления);
		ПозицияРазделителя = Найти(Строка, Разделитель);
	КонецЦикла;
		
	Если СтрДлина(Строка) > 0 Тогда
		Массив.Добавить(Строка);
	КонецЕсли;
	
	Возврат Массив;
	

КонецФункции

