    КомментарийКТекстуЗапроса = ТекстОшибки;
    ОшибкиВЗапросе = НЕ ПустаяСтрока(ТекстОшибки);
    
    Если ОшибкиВЗапросе Тогда
        Элементы.ГруппаШапка.ТекущаяСтраница = Элементы.ГруппаЗапрос;
    КонецЕсли;
