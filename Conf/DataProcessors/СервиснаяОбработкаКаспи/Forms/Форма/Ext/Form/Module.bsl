&НаСервере
Функция получитьХарКасп(кат,о)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДопСвойстваТоваровКаспи.Свойство КАК Характеристика,
		|	ДопСвойстваТоваровКаспи.Обязательный КАК Обязательный,
		|	ДопСвойстваТоваровКаспи.Тип КАК Тип,
		|	ДопСвойстваТоваровКаспи.СвойствоКаспи КАК ХарактеристикаКаспи
		|ИЗ
		|	РегистрСведений.ДопСвойстваТоваровКаспи КАК ДопСвойстваТоваровКаспи
		|ГДЕ
		|	ДопСвойстваТоваровКаспи.Категория = &Категория
		|
		|СГРУППИРОВАТЬ ПО
		|	ДопСвойстваТоваровКаспи.Свойство,
		|	ДопСвойстваТоваровКаспи.Обязательный,
		|	ДопСвойстваТоваровКаспи.Тип,
		|	ДопСвойстваТоваровКаспи.СвойствоКаспи";
	
	Запрос.УстановитьПараметр("Категория", кат);
	
	тзСвойства = Запрос.Выполнить().Выгрузить(); 
	
	о.ХарактеристикиТовараКаспи.загрузить(тзСвойства);
	
