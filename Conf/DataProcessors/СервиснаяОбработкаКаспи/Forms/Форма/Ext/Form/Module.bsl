&НаСервере
Процедура СоздатьJSONДляОтправкиНаСервере()   
	Запрос = Новый Запрос;
	Запрос.Текст = 
	
	"ВЫБРАТЬ
	|	НоменклатураХарактеристикиТовараКаспи.Ссылка КАК Ссылка,
	|	КОЛИЧЕСТВО(ЕСТЬNULL(НоменклатураХарактеристикиТовараКаспи.Значение, 0)) КАК ЕстьДанные,
	|	СУММА(ВЫБОР
	|			КОГДА ЕСТЬNULL(НоменклатураХарактеристикиТовараКаспи.Значение, 0) <> """"
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК заполн
	|ПОМЕСТИТЬ втДанные
	|ИЗ
	|	Справочник.Номенклатура.ХарактеристикиТовараКаспи КАК НоменклатураХарактеристикиТовараКаспи
	|ГДЕ
	|	НоменклатураХарактеристикиТовараКаспи.Обязательный
	|	И НЕ НоменклатураХарактеристикиТовараКаспи.Ссылка.ВыгруженНаКаспи
	|
	|СГРУППИРОВАТЬ ПО
	|	НоменклатураХарактеристикиТовараКаспи.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втДанные.Ссылка КАК Номенклатура
	|ПОМЕСТИТЬ втЗаполненаяНоменклатура
	|ИЗ
	|	втДанные КАК втДанные
	|ГДЕ
	|	втДанные.ЕстьДанные - втДанные.заполн = 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыНаСкладахОстатки.Номенклатура.ВидНоменклатуры.КатегорияКаспи КАК КатегорияКаспи,
	|	ТоварыНаСкладахОстатки.Номенклатура.Артикул КАК артикул,
	|	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
	|	ТоварыНаСкладахОстатки.Характеристика КАК Характеристика1,
	|	ПОДСТРОКА(ТоварыНаСкладахОстатки.Номенклатура.Описание, 1, 200) КАК описание,
	|	ПОДСТРОКА(ТоварыНаСкладахОстатки.Номенклатура.ZM_Описание, 1, 1024) КАК описаниеZM,
	|	цвет.Значение.Наименование КАК цвет,
	|	размер.Значение.Наименование КАК размер,
	|	ПОДСТРОКА(линкиФото.Линк, 1, 1024) КАК фото,
	|	ЦветаКаспи.ЦветКаспи КАК ЦветКаспи,
	|	РазмерыКаспи.РазмерКаспи КАК РазмерКаспи
	|ИЗ
	|	втЗаполненаяНоменклатура КАК втЗаполненаяНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки КАК ТоварыНаСкладахОстатки
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры.ДополнительныеРеквизиты КАК цвет
	|			ПО ТоварыНаСкладахОстатки.Характеристика = цвет.Ссылка
	|				И (цвет.Свойство = &Свойство)
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры.ДополнительныеРеквизиты КАК размер
	|			ПО ТоварыНаСкладахОстатки.Характеристика = размер.Ссылка
	|				И (размер.Свойство = &Свойство2)
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.TRP_ЛинкиКартинокИнтернетМагазина КАК линкиФото
	|			ПО ТоварыНаСкладахОстатки.Номенклатура = линкиФото.Номенклатура
	|				И ТоварыНаСкладахОстатки.Характеристика = линкиФото.Характеристика
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.TRP_S_НастройкиМаркетплейса.МаппингЦветов КАК ЦветаКаспи
	|			ПО (цвет.Значение.Наименование = ЦветаКаспи.Цвет1с)
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.TRP_S_НастройкиМаркетплейса.МаппингРазмеров КАК РазмерыКаспи
	|			ПО (размер.Значение.Наименование = РазмерыКаспи.Размер1с)
	|		ПО (ТоварыНаСкладахОстатки.Номенклатура = втЗаполненаяНоменклатура.Номенклатура)
	|ГДЕ
	|	ТоварыНаСкладахОстатки.Склад В (&Склад)
	|	И НЕ ТоварыНаСкладахОстатки.Номенклатура.ВидНоменклатуры В (&ВидНоменклатуры)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыНаСкладахОстатки.Номенклатура,
	|	размер.Значение.Наименование,
	|	цвет.Значение.Наименование,
	|	ТоварыНаСкладахОстатки.Характеристика,
	|	ТоварыНаСкладахОстатки.Номенклатура.ВидНоменклатуры.КатегорияКаспи,
	|	ТоварыНаСкладахОстатки.Номенклатура.Артикул,
	|	ПОДСТРОКА(ТоварыНаСкладахОстатки.Номенклатура.Описание, 1, 200),
	|	ПОДСТРОКА(ТоварыНаСкладахОстатки.Номенклатура.ZM_Описание, 1, 1024),
	|	ПОДСТРОКА(линкиФото.Линк, 1, 1024),
	|	ЦветаКаспи.ЦветКаспи,
	|	РазмерыКаспи.РазмерКаспи
	|ИТОГИ ПО
	|	Номенклатура,
	|	Характеристика1";    
	
	настр=Справочники.TRP_S_НастройкиМаркетплейса.НастройкиКаспи;
	
