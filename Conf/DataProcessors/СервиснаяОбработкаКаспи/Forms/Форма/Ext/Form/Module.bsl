&НаСервере
Процедура СоздатьМаппингВидНомНаСервере()
	о=РеквизитФормыВЗначение("Объект");
	
	мак=о.получитьМакет("МаппингВидНоменклатуры"); 
	
	для к=1 по мак.высотаТаблицы цикл
		вид1с=мак.область(к,1).текст;
		видКс=мак.область(к,2).текст;
		спр=Справочники.ВидыНоменклатуры.НайтиПоНаименованию(вид1с);
		если ЗначениеЗаполнено(спр) тогда   
			если не ЗначениеЗаполнено(спр.игр_КатегорияКаспи) тогда
				о=спр.ПолучитьОбъект();
				о.игр_КатегорияКаспи=Справочники.КатегорииТовараКаспи.НайтиПоНаименованию(видКс);
				о.Записать();
				сообщить(о);                 
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура загрузкаСкладыРазмерыЦветыНаСервере()
	
	о=РеквизитФормыВЗначение("Объект");
	макСкл=о.получитьМакет("склады");
	макРазм=о.получитьМакет("размеры");
	макЦвет=о.получитьМакет("цвет");
	
	настр=Справочники.TRP_S_НастройкиМаркетплейса.НастройкиКаспи;

	о=настр.ПолучитьОбъект();
	
	о.Наименование="Настройки Каспи";
	о.ВидЦены=Справочники.ВидыЦен.НайтиПоНаименованию("Розничная РК");
	о.ВидЦеныСоСкидкой=Справочники.ВидыЦен.НайтиПоНаименованию("Розничная со скидкой РК");
	
	о.АдресСервера="45.86.81.198";  
	о.Порт=21;
	о.ИмяПользователя="1cftp1";
	о.Пароль="bZAFYQzLvOS1";    
	о.АдресРесурса="kaspi.kz";
	
	
	о.СкладыКаспи.Очистить();
	для к=1 по макСкл.ВысотаТаблицы цикл
		скл=Справочники.Склады.НайтиПоНаименованию(макСкл.Область(к,2).Текст);
		с=о.СкладыКаспи.Добавить();
		с.Склад=скл;
		с.КодКаспи=макСкл.Область(к,1).Текст;
	КонецЦикла;
	
	о.МаппингЦветов.Очистить();
	для к=1 по макЦвет.ВысотаТаблицы цикл
		с=о.МаппингЦветов.Добавить();
		с.Цвет1с=макЦвет.Область(к,2).Текст;
		с.ЦветКаспи=макЦвет.Область(к,3).Текст;
	КонецЦикла;
	
	о.МаппингРазмеров.Очистить();
	для к=1 по макРазм.ВысотаТаблицы цикл
		с=о.МаппингРазмеров.Добавить();
		с.Размер1с=макРазм.Область(к,2).Текст;
		с.РазмерКаспи=макРазм.Область(к,3).Текст;
	КонецЦикла;   
	
	с=о.НеВыгружатьКатегории.Добавить();
	с.ВидНоменклатуры=Справочники.ВидыНоменклатуры.НайтиПоНаименованию("нижнее белье");   
	
	о.ХарактеристикаРазмер=ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Размер");
	о.ХарактеристикаЦвет=ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Цвет");

	
	о.Записать();
	
КонецПроцедуры

