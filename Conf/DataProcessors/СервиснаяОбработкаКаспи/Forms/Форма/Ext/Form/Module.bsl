			спр.НаименованиеКаспи=наимК;
			спр.ВидНоменклатуры=ПолучитьВидНом(наим);
			//сообщить(спр);
			спр.Записать(); 
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры  

