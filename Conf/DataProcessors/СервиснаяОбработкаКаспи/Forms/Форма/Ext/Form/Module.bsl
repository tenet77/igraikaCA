&НаСервере
Процедура ЗаолнитьРегистрСвойствКаспиНаСервере()     
	о=РеквизитФормыВЗначение("Объект");

	
	мкат=ПолучитьКатегории();   
	
	тз0=РеквизитФормыВЗначение("тз");
	
	для к=0 по мкат.количество()-1 цикл
		с=тз0.Добавить();
		с.код=мкат[к].code;
		с.назв=мкат[к].title;
	КонецЦикла;    
	
	
	тз20=РеквизитФормыВЗначение("тз2");;
	
	мак=о.ПолучитьМакет("КатеорииИграйка");
	
	для к0=1 по мак.ВысотаТаблицы цикл   
		
		катт=мак.Область(к0,1).Текст; 
		
		сс=тз0.Найти(катт,"назв");  
		
		если сс=Неопределено тогда сообщить("----ОШ-----"+катт); Продолжить; КонецЕсли;
		
		мхар=ПолучитьХарактеристикиКатегории(сс.код);    
		
		с=тз20.Добавить();
		с.колонка1=катт;
		
		
		для к=0 по мхар.количество()-1 цикл  
			м=СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(мхар[к].code,"*");
			с=тз20.Добавить();
			с.колонка1=катт;
			с.колонка2=м[2];  
			с.колонка22=мхар[к].code;  
			с.колонка3=мхар[к].mandatory;  
			с.колонка4=мхар[к].type;
			
			если мхар[к].type="enum" тогда
				менум=ПолучитьЗначенияЕнум(сс.код,мхар[к].code);
				для кк=0 по менум.количество()-1 цикл
					с=тз20.Добавить();
					с.колонка1=катт;
					с.колонка2=м[2];  
					с.колонка22=мхар[к].code;  
					с.колонка3=менум[кк].name;   
					с.колонка4=мхар[к].type;
				КонецЦикла;                   
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;      
	
	обяз=ложь;
	для каждого ст из тз20 цикл   
		если ст.колонка3="" тогда Продолжить; КонецЕсли;
		рег=РегистрыСведений.ДопСвойстваТоваровКаспи.СоздатьМенеджерЗаписи(); 
		кат=Справочники.КатегорииТовараКаспи.НайтиПоНаименованию(ст.колонка1);
		если ЗначениеЗаполнено(кат) тогда
			рег.Категория=кат;
		иначе     
			сообщить("Не найден ---"+ст.колонка1);
		КонецЕсли;
		рег.Свойство=ст.колонка2;
		рег.СвойствоКаспи=ст.колонка22;  
		рег.Тип=ст.колонка4;
		если ст.колонка3="Да" или ст.колонка3="Нет" тогда
			рег.Обязательный=?(ст.колонка3="Да",истина,ложь);   
			обяз=рег.Обязательный;
		иначе
			рег.Обязательный=обяз;
			рег.значение=ст.колонка3;
		КонецЕсли;
		рег.Записать();
	КонецЦикла;
	
	
	
	
	ЗначениеВРеквизитФормы(тз0,"тз");
	ЗначениеВРеквизитФормы(тз20,"тз2");
	
КонецПроцедуры

