&НаСервере
Функция обновитьХарКасп(кат,о)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДопСвойстваТоваровКаспи.Свойство КАК Характеристика,
		|	ДопСвойстваТоваровКаспи.Значение КАК Значение,
		|	ДопСвойстваТоваровКаспи.Обязательный КАК Обязательный,
		|	ДопСвойстваТоваровКаспи.Тип КАК Тип,
		|	ДопСвойстваТоваровКаспи.СвойствоКаспи КАК ХарактеристикаКаспи
		|ИЗ
		|	РегистрСведений.ДопСвойстваТоваровКаспи КАК ДопСвойстваТоваровКаспи
		|ГДЕ
		|	ДопСвойстваТоваровКаспи.Категория = &Категория";
	
	Запрос.УстановитьПараметр("Категория", кат);
	
	тз1 = Запрос.Выполнить().Выгрузить(); 
	
	тзСвойства=тз1.Скопировать();
	
	тзСвойства.Свернуть("Характеристика,Обязательный,тип,ХарактеристикаКаспи",""); 
	
	если тзСвойства.Количество()<>о.ХарактеристикиТовараКаспи.Количество() тогда
		для каждого ст из тзСвойства цикл
			с=о.ХарактеристикиТовараКаспи.Найти(ст.характеристика);
			если не ЗначениеЗаполнено(с) тогда
				сс=о.ХарактеристикиТовараКаспи.добавить();
				ЗаполнитьЗначенияСвойств(сс,ст);
			КонецЕсли;
		КонецЦикла;  
		о.КатегорияТовара=кат;
		о.записать();   
	КонецЕсли;
	
КонецФункции

