&НаСервере
Функция  сформДерев(текст)   
	Чтение = Новый ЧтениеJSON;   
	///ТекстОтвета=СтрЗаменить(ТекстОтвета,"$","");
	чтение.УстановитьСтроку(текст);
	//Структура = ПрочитатьJSON(Чтение); 
	д=Неопределено;
	СформироватьДерево(Чтение,д);
	Чтение.Закрыть(); 
	
	
	возврат д;
КонецФункции
&НаСервере
Процедура СформироватьДерево(ЧтениеJSON, Дерево)
    
    ИмяСвойства = Неопределено;
    
    Пока ЧтениеJSON.Прочитать() Цикл
        TипJSON = ЧтениеJSON.ТипТекущегоЗначения;
        
        Если TипJSON = ТипЗначенияJSON.НачалоОбъекта 
        ИЛИ TипJSON = ТипЗначенияJSON.НачалоМассива Тогда
            НовыйОбъект = ?(TипJSON = ТипЗначенияJSON.НачалоОбъекта, Новый Соответствие, Новый Массив);
            
            Если ТипЗнч(Дерево) = Тип("Массив") Тогда
                Дерево.Добавить(НовыйОбъект);
            ИначеЕсли ТипЗнч(Дерево) = Тип("Соответствие") И ЗначениеЗаполнено(ИмяСвойства) Тогда
                Дерево.Вставить(ИмяСвойства, НовыйОбъект);
            КонецЕсли;
            
            СформироватьДерево(ЧтениеJSON, НовыйОбъект);
            
            Если Дерево = Неопределено Тогда
                Дерево = НовыйОбъект;
            КонецЕсли;
        ИначеЕсли TипJSON = ТипЗначенияJSON.ИмяСвойства Тогда
            ИмяСвойства = ЧтениеJSON.ТекущееЗначение;
        ИначеЕсли TипJSON = ТипЗначенияJSON.Число 
        ИЛИ TипJSON = ТипЗначенияJSON.Строка 
        ИЛИ TипJSON = ТипЗначенияJSON.Булево 
        ИЛИ TипJSON = ТипЗначенияJSON.Null Тогда
            Если ТипЗнч(Дерево) = Тип("Массив") Тогда
                Дерево.Добавить(ЧтениеJSON.ТекущееЗначение);
            ИначеЕсли ТипЗнч(Дерево) = Тип("Соответствие") Тогда
                Дерево.Вставить(ИмяСвойства, ЧтениеJSON.ТекущееЗначение);
            КонецЕсли;
        Иначе
            Возврат;
        КонецЕсли;
    КонецЦикла;
    
КонецПроцедуры

&НаСервере
Процедура ОтправитьПрайсНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст = 
	
	"ВЫБРАТЬ
	|	ТоварыНаСкладахОстатки.Номенклатура.ВидНоменклатуры.КатегорияКаспи КАК КатегорияКаспи,
	|	ТоварыНаСкладахОстатки.Номенклатура.Артикул КАК артикул,
	|	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
	|	ТоварыНаСкладахОстатки.Характеристика КАК Характеристика,
	|	ТоварыНаСкладахОстатки.Склад КАК Склад,
	|	ТоварыНаСкладахОстатки.ВНаличииОстаток КАК ост,
	|	ценаСкидка.Цена КАК ЦенаСкидка,
	|	ценаРозн2.Цена КАК ЦенаРозн
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки КАК ТоварыНаСкладахОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, ) КАК ценаСкидка
	|		ПО ТоварыНаСкладахОстатки.Номенклатура = ценаСкидка.Номенклатура
	|			И ТоварыНаСкладахОстатки.Характеристика = ценаСкидка.Характеристика
	|			И (ценаСкидка.ВидЦены = &ВидЦены)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, ) КАК ценаРозн2
	|		ПО ТоварыНаСкладахОстатки.Номенклатура = ценаРозн2.Номенклатура
	|			И ТоварыНаСкладахОстатки.Характеристика = ценаРозн2.Характеристика
	|			И (ценаРозн2.ВидЦены = &ВидЦены2)
	|ГДЕ
	|	ТоварыНаСкладахОстатки.Склад В ИЕРАРХИИ(&Склад)
	|	И НЕ ТоварыНаСкладахОстатки.Номенклатура.ВидНоменклатуры В (&ВидНоменклатуры)
	|ИТОГИ ПО
	|	артикул,
	|	Характеристика";
	
	
	настр=Справочники.TRP_S_НастройкиМаркетплейса.НастройкиКаспи;
	
	списВидНом=настр.НеВыгружатьКатегории.ВыгрузитьКолонку("ВидНоменклатуры");
	списСклад=настр.СкладыКаспи.ВыгрузитьКолонку("Склад");
	
	Запрос.УстановитьПараметр("ВидНоменклатуры", списВидНом);
	Запрос.УстановитьПараметр("ВидЦены", настр.ВидЦеныСоСкидкой);
	Запрос.УстановитьПараметр("ВидЦены2", настр.ВидЦены);
	Запрос.УстановитьПараметр("Склад",списСклад);
	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	рез = РезультатЗапроса.выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	
	ЗаписьXML = Новый ЗаписьXML;  
	ф=ПолучитьИмяВременногоФайла("xml");
	
	ЗаписьXML.ОткрытьФайл(ф);
	
	
	тзСклады=ПолучитьСписСкладов();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("kaspi_catalog");
	ЗаписьXML.ЗаписатьАтрибут("xmlns", "kaspiShopping");
	ЗаписьXML.ЗаписатьАтрибут("xmlns:xsi", "http://www.w3.org/2001/XMLSchema-instance");
	ЗаписьXML.ЗаписатьАтрибут("date", "string");
	ЗаписьXML.ЗаписатьАтрибут("xsi:schemaLocation", "kaspiShopping http://kaspi.kz/kaspishopping.xsd");
	
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("company");
	ЗаписьXML.ЗаписатьТекст("TerraPro");
	ЗаписьXML.ЗаписатьКонецЭлемента(); //company
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("merchantid");
	ЗаписьXML.ЗаписатьТекст("12286008");
	ЗаписьXML.ЗаписатьКонецЭлемента(); //company
	
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("offers");
	
	для каждого ст из рез.Строки цикл
		если  сокрлп(ст.артикул)="" тогда Продолжить; КонецЕсли;
		для каждого ст1 из ст.строки Цикл
			к=1;   
			для каждого ст2 из ст1.строки Цикл
				если к=1 тогда
					ЗаписьXML.ЗаписатьНачалоЭлемента("offer");
					ЗаписьXML.ЗаписатьАтрибут("sku", ст2.артикул+"_"+ст2.Характеристика.уникальныйИдентификатор());
					
					ЗаписьXML.ЗаписатьНачалоЭлемента("model");
					ЗаписьXML.ЗаписатьТекст(строка(""+ст2.номенклатура+" "+ст2.Характеристика));
					ЗаписьXML.ЗаписатьКонецЭлемента(); //model
					ЗаписьXML.ЗаписатьНачалоЭлемента("brand");
					ЗаписьXML.ЗаписатьТекст(строка("TERRA PRO"));
					ЗаписьXML.ЗаписатьКонецЭлемента(); //brand
					
					ЗаписьXML.ЗаписатьНачалоЭлемента("availabilities");
					к=2;
				КонецЕсли;
				
				кодСклад=ПолучитьКодСклада(ст2.склад);				
				стр=тзСклады.Найти(сокрлп(кодСклад));
				если стр<>Неопределено тогда
					стр.уже=1;
				КонецЕсли;
				
				если ст2.склад<>null тогда
					ЗаписьXML.ЗаписатьНачалоЭлемента("availability");
					ЗаписьXML.ЗаписатьАтрибут("available", ?(ст2.ост>0,"yes","no"));
					ЗаписьXML.ЗаписатьАтрибут("storeId", кодСклад);
					ЗаписьXML.ЗаписатьКонецЭлемента();//availability
				КонецЕсли;
				ц=?(ст2.ценаСкидка=null,ст2.ценаРозн,ст2.ценаСкидка);
				цена=формат(ц,"ЧГ=");
			КонецЦикла;   
			
			
			
			для каждого сстт из тзСклады цикл
				если сстт.уже<>1 тогда
					ЗаписьXML.ЗаписатьНачалоЭлемента("availability");
					ЗаписьXML.ЗаписатьАтрибут("available", "no");
					ЗаписьXML.ЗаписатьАтрибут("storeId", сстт.код);
					ЗаписьXML.ЗаписатьКонецЭлемента();//availability
				КонецЕсли;
			КонецЦикла;
			
			для каждого сстт из тзСклады цикл сстт.уже=0 КонецЦикла;
			
			ЗаписьXML.ЗаписатьКонецЭлемента(); //availabilities
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("price");
			ЗаписьXML.ЗаписатьТекст(цена);
			ЗаписьXML.ЗаписатьКонецЭлемента(); //price
			
			ЗаписьXML.ЗаписатьКонецЭлемента(); //offer
		КонецЦикла;
	КонецЦикла;
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); //offers

	
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); //kaspi_catalog    
	
	ЗаписьXML.Закрыть();
	
	ОтправитьНаФТП(ф);
	
	УдалитьФайлы(ф);

КонецПроцедуры    

Процедура ОтправитьНаФТП(фф)  
	спр=Справочники.TRP_S_НастройкиМаркетплейса.НастройкиКаспи; 
	
	АдресСайта = спр.АдресСервера;
	Порт = спр.Порт;
	Логин = спр.ИмяПользователя;
	Пароль = спр.Пароль;
	ИмяКаталога = "/";
	FTPСоединение = Новый FTPСоединение(АдресСайта,Порт,Логин,Пароль,,истина);
	FTPСоединение.УстановитьТекущийКаталог(ИмяКаталога);
	
	FTPСоединение.Записать(фф,"Kaspy/KaspiFeed.xml");  
КонецПроцедуры

Функция  ПолучитьСписСкладов()  
	спр=Справочники.TRP_S_НастройкиМаркетплейса.НастройкиКаспи; 
	
	тз1=новый ТаблицаЗначений;
	тз1.Колонки.Добавить("код");
	тз1.Колонки.Добавить("уже");
	
	для каждого ст из спр.СкладыКаспи цикл  
		с=тз1.Добавить();
		с.код=ст.КодКаспи;
		с.уже=0;
	КонецЦикла;
	
	возврат тз1;
КонецФункции


Функция ПолучитьКодСклада(скл)
	спр=Справочники.TRP_S_НастройкиМаркетплейса.НастройкиКаспи; 
	с=спр.СкладыКаспи.Найти(скл);
	
	возврат с.КодКаспи;
КонецФункции

&НаКлиенте
Процедура ОтправитьПрайс(Команда)
	ОтправитьПрайсНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьКатегорииКаспиИграйка(Команда)
	ПолучитьКатегорииКаспиИграйкаФрагмент();

КонецПроцедуры

&НаСервере
Процедура ПолучитьКатегорииКаспиИграйкаФрагмент()
	
	//Перем к, мак, мкат, получитьма, с;
	
	мкат=ПолучитьКатегории();   
	
	о=РеквизитФормыВЗначение("Объект");
	тз0=РеквизитФормыВЗначение("тз");
	
	для к=0 по мкат.количество()-1 цикл
		с=тз0.Добавить();
		с.код=мкат[к].code;
		с.назв=нрег(мкат[к].title);
	КонецЦикла;   
	
	мак=о.получитьмакет("КатеорииИграйка"); 
	
	для к=1 по мак.высотаТаблицы цикл
		кат=мак.область(к,1).текст;  
		найдКат=тз0.найти(НРег(кат));  
		если найдКат=Неопределено тогда
			сообщить(""+кат);
		иначе
			сообщить(""+кат+"/"+найдКат.код+"/"+найдКат.назв);
		КонецЕсли;
	КонецЦикла;
	
	
	ЗначениеВРеквизитФормы(тз0,"тз");
	
КонецПроцедуры

